// A closed union: a value is exactly one of its cases. Nested constructs,
// enums, and functions (methods) are listed among the cases but are not
// cases; generics are C-backed and have no field adapter yet. Inside the
// enum's own functions, a bare case name tests the current value:
// `switch { north: …, default: {} }`; no function of the enum takes a
// case's name.
@nominal
construct Enum {
    let name: String
    let cases: Array<EnumCase>
    let functions: Array<Function>
    let macros: Array<Macro>
}
