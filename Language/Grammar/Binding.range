// value is C's: a macro reading `.value` gets the declaration's initializer
// evaluated at macro time (a generic's `bits.value` is 64, not an
// Expression), so its type is known only then, from the value it holds. It is
// a @builtin member without a type; C warns that it provides it.
@member
construct Binding {
    let name: String
    @builtin let value
}
