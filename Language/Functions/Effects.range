// Write the message and a newline. Called at macro time, it writes to the
// compiler's output; in a program it writes to standard output. Interpolated
// parts are written in order: integers of any width in decimal, enum values
// without payloads (booleans among them) as their case names, strings as
// their bytes.
@builtin
function print(let message: String)

// Report the message. Called at macro time, it fails validation; in a
// program it writes the located message to standard error and exits with
// status 134. It never returns, so its result type is Never, and a call of
// it diverges as return does: it can end an arm of a switch expression.
@builtin
function diagnostic(let message: String): Never

// Report the message as a warning and continue. Called at macro time, it
// reports it at the application, and a law run per specialization does not
// repeat it; in a program it writes the message to standard error, located
// at the call and marked a warning, as in "File.range:3:5: warning: low".
@builtin
function warning(let message: String)
