@literal("true|false")
macro boolean(): Enum {
  let no: #target.cases.first(where: { entry in entry.name = "false" })
  let yes: #target.cases.first(where: { entry in entry.name = "true" })
  switch {
    no.present & yes.present: {},
    no.absent: @diagnostic("Enum must declare case false"),
    yes.absent: @diagnostic("Enum must declare case true")
  }

  // Layout: an enum without payloads is its tag, so the tag is the storage.
  // A literal names the case spelled like it. Conditions branch on the tag
  // and comparisons produce it, so C requires case false to be tag 0 and
  // case true tag 1, and checks that where it finds the condition type.
  //
  // `!a` calls the function `!` declared here, a C primitive on the tag.
  // `a & b` (and) and `a | b` (or) short-circuit: b is evaluated only when a
  // does not decide the result. A call evaluates its argument first, and
  // `a & b` writes no closure that could delay b, so these two stay C
  // control-flow primitives. They are declared here so the operators exist only on this
  // type, and C writes the branch. No other type may declare `&` or `|`:
  // they also join the case tests of a switch arm's condition.
  #graph {
    extension #target.name {
      @builtin function !(): #target.name
      @builtin function &(let other: #target.name): #target.name
      @builtin function |(let other: #target.name): #target.name
    }
  }
}
