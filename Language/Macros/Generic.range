// Generic kinds apply @generic, so @generic names any of them: a value
// generic such as <let bits: 64> is a Let; <Element> is a TypeParameter.
macro generic(): Construct {
  let name: #target.members.first(where: { member in member.name = "name" })
  switch {
    name.absent: diagnostic(message: "Generic kind must declare name"),
    name.present: {}
  }
}
