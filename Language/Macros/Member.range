// Member kinds apply @member, so @member names any of them as a type or a
// macro target. Each kind declares its own fields; every kind has a name.
macro member(): Construct {
  let name: #target.members.first(where: { member in member.name = "name" })
  switch {
    name.absent: diagnostic(message: "Member kind must declare name"),
    name.present: {}
  }
}
