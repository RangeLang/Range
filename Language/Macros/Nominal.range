// Type kinds apply @nominal, so @nominal names any declaration that is a
// type: a construct or an enum. Function.output, Function.receiver, and
// Parameter.type hold one. Each kind declares its own fields; every kind has
// a name.
macro nominal(): Construct {
  switch #members.first(named: "name") {
    .absent: @diagnostic("Type kind must declare name"),
    .present: {}
  }
}
