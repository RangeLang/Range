// Selects String for quoted literals. C's lexer recognizes the literal itself,
// including escapes and \( ) interpolation; this pattern only picks the construct.
@literal("\".*\"")
macro string(): Construct {
  let value: #target.members.first(where: { member in member.name = "value" })
  switch {
    value.absent: @diagnostic("Construct must specify value"),
    value.present: {}
  }

  // Layout: UTF-8 bytes held by C, as an address, a byte count, and the
  // reference-counted block that owns them (none for a literal, whose bytes
  // are in the executable). C reads the bytes primitive; it never names String.
  //
  // The byte primitives are C builtins selected by name: count is the byte
  // count the bytes primitive holds, and byte(at:) reads one byte, checking
  // the index against that count. `a + b` calls `+`, which joins the two
  // values' bytes into a new block. `=` is the built-in structural
  // comparison, which compares the bytes.
  #graph {
    extension #target.name {
      @builtin let bytes
      @builtin let count: Int
      @builtin function byte(let at: Int): Int<bits: 8, signed: false>
      @builtin function +(let other: #target.name): #target.name
    }
  }
}
