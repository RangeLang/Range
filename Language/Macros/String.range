// Selects String for quoted literals. C's lexer recognizes the literal itself,
// including escapes and \( ) interpolation; this pattern only picks the construct.
@literal("\".*\"")
macro string(): Construct {
  let value: #members.filter(named: "value").first

  if !value.isTarget {
    @diagnostic("Construct must specify value")
  }

  // Layout: UTF-8 bytes held by C, as an address and a byte count. C reads
  // the bytes primitive; it never names String.
  #graph {
    extension #name {
      @builtin let bytes
    }
  }
}
