// `a = b` compares two values of one type; `a != b` is `!(a = b)`, and a
// case test's value argument compares the same way. An optional operand is
// promoted first, so `maybe = 5` compares two Int? values.
//
// Every construct and enum has `=` built in: C compares a construct's stored
// members in order, or an enum's case and then that case's payload fields,
// each with its own type's `=`; an enum that contains itself is compared
// recursively. Its code is generated only for the types, per specialization,
// that a program compares, and for the field and payload types those reach.
//
// A type never writes `=` itself; C reports one written in the type or in an
// extension of it. Writing @equatable makes `=` call the type's own
// `function equals(let other: <Type>): Bool` instead, through the `=` this
// macro emits. Without @equatable, an equals is an ordinary function.
// `@equatable extension Type { … }` writes it as well: it applies to Type, as
// written there, and sees the equals declared in that extension. That is how
// @collection makes every collection compare by the equals it emits.
macro equatable(): Construct {
    let equals: #functions.first { candidate in candidate.name = "equals" }

    switch {
        equals.present: {
            switch {
                equals.parameters.count != 1:
                    @diagnostic("\(#name).equals must take exactly one parameter, as in 'function equals(let other: \(#name)): Bool'; it takes \(equals.parameters.count)"),
                default: {}
            }
            let parameter: equals.parameters.first()
            switch {
                parameter.present & parameter.name != "other":
                    @diagnostic("the parameter of \(#name).equals must be labeled 'other', as in 'function equals(let other: \(#name)): Bool'; it is labeled '\(parameter.name)'"),

                parameter.present & parameter.type != equals.receiver:
                    @diagnostic("the parameter of \(#name).equals must be of type \(#name), the type it compares"),

                default: {}
            }
            switch {
                equals.output != Bool: @diagnostic("\(#name).equals must return Bool"),
                default: {}
            }
            #graph {
                extension #name {
                    function =(let other: #name): Bool { return equals(other: other) }
                }
            }
        },

        equals.absent:
            @warning("\(#name) applies @equatable but declares no equals; the default structural equality is used")
    }
}

// The same for an enum: writing @equatable makes `=` call its equals.
macro equatable(): Enum {
    let equals: #functions.first { candidate in candidate.name = "equals" }

    switch {
        equals.present: {
            switch {
                equals.parameters.count != 1:
                    @diagnostic("\(#name).equals must take exactly one parameter, as in 'function equals(let other: \(#name)): Bool'; it takes \(equals.parameters.count)"),
                default: {}
            }
            let parameter: equals.parameters.first()
            switch {
                parameter.present & parameter.name != "other":
                    @diagnostic("the parameter of \(#name).equals must be labeled 'other', as in 'function equals(let other: \(#name)): Bool'; it is labeled '\(parameter.name)'"),

                parameter.present & parameter.type != equals.receiver:
                    @diagnostic("the parameter of \(#name).equals must be of type \(#name), the type it compares"),

                default: {}
            }
            switch {
                equals.output != Bool: @diagnostic("\(#name).equals must return Bool"),
                default: {}
            }
            #graph {
                extension #name {
                    function =(let other: #name): Bool { return equals(other: other) }
                }
            }
        },

        equals.absent:
            @warning("\(#name) applies @equatable but declares no equals; the default structural equality is used")
    }
}
