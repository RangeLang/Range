// `a = b` compares two values of one type; `a != b` is `!(a = b)`, and a
// case test's value argument compares the same way. An optional operand is
// promoted first, so `maybe = 5` compares two Int? values.
//
// Every construct and enum has `=` built in: C compares a construct's stored
// members in order, or an enum's case and then that case's payload fields,
// each with its own type's `=`; an enum that contains itself is compared
// recursively. Its code is generated only for the types, per specialization,
// that a program compares, and for the field and payload types those reach.
//
// A type replaces it by writing `function =(let other: <Type>): Bool`, in the
// type or an extension of it. @equatable checks that written `=`: it emits
// nothing, and a type may write `=` without it. The operator rules check the
// rest: `=` takes one parameter and is declared on the type it compares.
// `@equatable extension Type { … }` applies to Type, as written there, and
// sees the `=` declared in that extension. That is how @collection checks the
// `=` it emits for every collection.
macro equatable(): Construct {
    let written: #target.functions.first { candidate in candidate.name = "=" }

    switch {
        written.present: {
            let parameter: written.parameters.first()
            switch {
                parameter.present & parameter.name != "other":
                    @diagnostic("the parameter of \(#target.name)'s '=' must be labeled 'other', as in 'function =(let other: \(#target.name)): Bool'; it is labeled '\(parameter.name)'"),

                parameter.present & parameter.type != written.receiver:
                    @diagnostic("the parameter of \(#target.name)'s '=' must be of type \(#target.name), the type it compares"),

                default: {}
            }
            switch {
                written.output != Bool: @diagnostic("\(#target.name)'s '=' must return Bool"),
                default: {}
            }
        },

        written.absent:
            @warning("\(#target.name) applies @equatable but declares no '='; the built-in structural '=' is used")
    }
}

// The same for an enum.
macro equatable(): Enum {
    let written: #target.functions.first { candidate in candidate.name = "=" }

    switch {
        written.present: {
            let parameter: written.parameters.first()
            switch {
                parameter.present & parameter.name != "other":
                    @diagnostic("the parameter of \(#target.name)'s '=' must be labeled 'other', as in 'function =(let other: \(#target.name)): Bool'; it is labeled '\(parameter.name)'"),

                parameter.present & parameter.type != written.receiver:
                    @diagnostic("the parameter of \(#target.name)'s '=' must be of type \(#target.name), the type it compares"),

                default: {}
            }
            switch {
                written.output != Bool: @diagnostic("\(#target.name)'s '=' must return Bool"),
                default: {}
            }
        },

        written.absent:
            @warning("\(#target.name) applies @equatable but declares no '='; the built-in structural '=' is used")
    }
}
