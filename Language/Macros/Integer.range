@literal("[0-9]+")
macro integer(): Construct {
  let value: #members.filter(named: "value").first
  let bits: #generics.filter(named: "bits").first
  let signed: #generics.filter(named: "signed").first

  if !value.isTarget {
    @diagnostic("Construct must specify value")
  }

  if !bits.isTarget {
    @diagnostic(
      "Construct must specify bits"
    )
  }

  if !signed.isTarget {
    @diagnostic(
      "Construct must specify signed"
    )
  }

  // The law runs per specialization and per supplied literal, so value and
  // bits are the specialized ones here.
  if value.isTarget && bits.isTarget && signed.isTarget {
    if bits.value <= 0 {
      @diagnostic("Integer bits must be positive")
    } else {
      if !integerValueFits(value: value.value, bits: bits.value, signed: signed.value) {
        @diagnostic("Integer value does not fit the declared bits and signedness")
      }
    }
  }

  // Layout: the construct is a scalar exactly bits wide. C reads the storage
  // primitive from the specialization; it never names Int or bits.
  #graph {
    extension #name {
      @builtin let storage: bits
    }
  }
}

// Bounds are language rules. C evaluates the arithmetic and control flow.
function integerValueFits(let value: Int, let bits: Int, let signed: Bool): Bool {
  if bits <= 0 { return false }
  state remaining: value
  state available: bits
  if signed {
    available: available - 1
    // -1 - value maps negatives to their required magnitude bits without
    // negating the minimum signed integer or computing overflowing powers.
    if remaining < 0 { remaining: -1 - remaining }
  } else {
    if remaining < 0 { return false }
  }
  while remaining > 0 && available > 0 {
    remaining: remaining / 2
    available: available - 1
  }
  return remaining == 0
}
