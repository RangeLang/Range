@literal("[0-9]+")
macro integer(): Construct {
  // The law runs per specialization and per supplied literal, so the stored
  // value and bits are the specialized ones here. Each `.present` test narrows its
  // value to the declaration it holds, for the rest of the arm. An arm with a
  // guard covers nothing for the arms after it, so the third arm accepts
  // every value that passed.
  let stored: #target.members.first(where: { member in member.name = "value" })
  let bits: #target.generics.first(where: { generic in generic.name = "bits" })
  let signed: #target.generics.first(where: { generic in generic.name = "signed" })
  switch {
      stored.present & bits.present & signed.present & bits.value <= 0:
          @diagnostic("Integer bits must be positive"),

      stored.present & bits.present & signed.present &
      !integerValueFits(value: stored.value, bits: bits.value, signed: signed.value):
          @diagnostic("Integer value does not fit the declared bits and signedness"),

      stored.present & bits.present & signed.present: {},
      default: @diagnostic("Construct must specify value, bits and signed")
  }

  // Layout and arithmetic: the construct is a scalar exactly bits wide, signed
  // or not. C reads these primitives from the specialization; it never names
  // Int, bits, or signed.
  //
  // `a + b` calls the function `+` that a's type declares, with b as its
  // argument; `-a` calls `-` without one. These are C primitives on the
  // storage: each traps when its result does not fit the specialization's bits
  // and signedness, and `/` and `%` trap on division by zero. Inside the
  // construct `#target.name` is the specialization itself, so Int<bits: 8> adds only
  // Int<bits: 8> values: mixed widths are rejected.
  //
  // Precedence and associativity are fixed in the C parser, tightest first:
  // prefix `!` and `-`, `* / %`, `+ -`, `..<`, the comparisons, `&`, then
  // `|`, each left-associative except `..<`, which does not chain. Declaring
  // precedence in Range is future work; C warns that it holds the table.
  #graph {
    extension #target.name {
      @builtin let storage: bits
      @builtin let signed: signed
      @builtin function +(let other: #target.name): #target.name
      @builtin function -(let other: #target.name): #target.name
      @builtin function *(let other: #target.name): #target.name
      @builtin function /(let other: #target.name): #target.name
      @builtin function %(let other: #target.name): #target.name
      @builtin function -(): #target.name
      @builtin function <(let other: #target.name): Bool
      @builtin function >(let other: #target.name): Bool
      @builtin function <=(let other: #target.name): Bool
      @builtin function >=(let other: #target.name): Bool
    }
  }
}

// Bounds are language rules. C evaluates the arithmetic and control flow.
function integerValueFits(let value: Int, let bits: Int, let signed: Bool): Bool {
  switch { bits <= 0: return false, default: {} }
  state remaining: value
  state available: bits
  switch {
    signed: {
      available: available - 1
      // -1 - value maps negatives to their required magnitude bits without
      // negating the minimum signed integer or computing overflowing powers.
      switch { remaining < 0: remaining: -1 - remaining, default: {} }
    },

    default: switch { remaining < 0: return false, default: {} }
  }
  while remaining > 0 & available > 0 {
    remaining: remaining / 2
    available: available - 1
  }
  return remaining = 0
}
