// Effect: report the message. Inside a macro body it fails validation at
// compile time; in a program it writes the located message to standard error
// and exits with status 134, so it diverges as return does: it can end an arm
// of a switch expression.
@builtin
macro diagnostic(let message: String)

// Effect: inside a macro body, report the message as a warning at the
// application and continue; a law run per specialization does not repeat it.
@builtin
macro warning(let message: String)
