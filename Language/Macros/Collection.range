// Emits Array's header members and operations into its target. The slot
// primitives resize, read, and write are C builtins without a runtime yet;
// the compiler reports that where the emitted code lands.
macro collection(): Construct {
    // A collection names its element type Element: the code emitted below
    // refers to it, and the type checker reports a target without one. This
    // macro cannot inspect #generics to say so earlier: reflection lists are
    // collections, and their functions are the ones this macro is emitting.

    // The construct itself holds the header; count and capacity are ordinary
    // members, and only the element slots use the @many primitive. The slot
    // operations belong to the construct too: C implements them on its single
    // @many member. Bare names such as Element resolve in the target once this
    // code lands there.
    //
    // @equatable on the extension applies to the target as if the target
    // wrote it, so every collection compares by the equals emitted beside it.
    #graph {
        @equatable
        extension #name {
            state count: 0
            state capacity: 0
            @many
            state elements: Element

            @builtin function resize(let to: Int)
            @builtin function read(let at: Int): Element
            @builtin function write(let at: Int, let value: Element)

            function isEmpty(): Bool {
                return count = 0
            }

            // `for element in collection { }` calls this at positions 0, 1, 2, …
            @iteration
            function element(let at: Int): Element? {
                switch at < count { .true: return read(at: at), .false: {} }
                return .absent
            }

            // Two collections are equal when they hold equal elements in the
            // same order, each pair compared with Element's own `=`; capacity
            // is storage, not value, so it never takes part. The @equatable
            // on this extension makes `=` call this.
            function equals(let other: #name): Bool {
                switch count != other.count { .true: return false, .false: {} }
                for index in 0..<count {
                    switch read(at: index) != other.read(at: index) { .true: return false, .false: {} }
                }
                return true
            }

            // C builds reflection lists through this function: it applies
            // @insertion, and C finds it by that role, not by its name.
            @insertion
            function append(let value: Element) {
                switch count = capacity {
                    .true: {
                        switch capacity = 0 {
                            .true: capacity: 1,
                            .false: capacity: capacity * 2
                        }
                        resize(to: capacity)
                    },
                    .false: {}
                }
                write(at: count, value: value)
                count: count + 1
            }

            // The first element, or absence when there is none. A function, not
            // a property: `derived` members are not compiled yet.
            function first(): Element? {
                switch count > 0 { .true: return read(at: 0), .false: {} }
                return .absent
            }

            // The elements for which `where` is true, in order, as a new
            // collection. Like every function that takes a closure, it is
            // compiled inline where it is called.
            function filter(let where: (Element) -> Bool): #name {
                state result: #name()
                state index: 0
                while index < count {
                    let element: read(at: index)
                    switch where(element) { .true: result.append(value: element), .false: {} }
                    index: index + 1
                }
                return result
            }

            // The first element for which `where` is true, or absence.
            function first(let where: (Element) -> Bool): Element? {
                state index: 0
                while index < count {
                    let element: read(at: index)
                    switch where(element) { .true: return element, .false: {} }
                    index: index + 1
                }
                return .absent
            }

            // Whether any element makes `where` true.
            function contains(let where: (Element) -> Bool): Bool {
                return switch first(where: where) { .present: true, .absent: false }
            }

            // Each element transformed, in order, as an Array of the results.
            function map<Result>(let transform: (Element) -> Result): Array<Result> {
                state result: Array<Result>()
                state index: 0
                while index < count {
                    result.append(value: transform(read(at: index)))
                    index: index + 1
                }
                return result
            }

            // `initial` combined with each element in order, as in
            // combine(combine(initial, first), second).
            function reduce<Result>(let initial: Result, let combine: (Result, Element) -> Result): Result {
                state result: initial
                state index: 0
                while index < count {
                    result: combine(result, read(at: index))
                    index: index + 1
                }
                return result
            }
        }
    }

    // capacity is the source of truth for slot count; elements is resized
    // only to capacity. count never exceeds capacity.

    // `for element in collection { }` iterates any construct applying this
    // macro through the element(at:) function it emits, which applies
    // @iteration: C finds that function by its role, not by this macro's name
    // or the names of the members it emits.

    // Open: restricting writes to count, capacity, and elements to these
    // operations (a later macro); copy semantics when an Array value is
    // assigned; element lifetime for elements that own storage.
}
