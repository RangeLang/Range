// Emits Array's header members and operations into its target. The @many
// primitive, method calls such as resize and write, and Bool are not
// implemented yet; the compiler reports each where the emitted code lands.
macro collection(): Construct {
    let element: #generics.filter(named: "Element").first

    if !element.isTarget {
        @diagnostic("Collection must declare generic Element")
    }

    // Require element to be a type parameter, not only a generic spelled
    // Element.

    // The construct itself holds the header; count and capacity are ordinary
    // members, and only the element slots use the @many primitive. Bare names
    // such as Element resolve in the target once this code lands there.
    #graph {
        extension #name {
            state count: 0
            state capacity: 0
            @many
            state elements: Element

            function isEmpty(): Bool {
                return count == 0
            }

            function append(let value: Element) {
                if count == capacity {
                    if capacity == 0 {
                        capacity: 1
                    } else {
                        capacity: capacity * 2
                    }
                    elements.resize(to: capacity)
                }
                elements.write(at: count, value: value)
                count: count + 1
            }

            // Proposed, not written yet:
            // - first: elements.read(at: 0), or absence when count is 0.
            // - filter(predicate): build the same collection specialization from
            //   matching elements in order, retaining any graph-node identities.
        }
    }

    // capacity is the source of truth for slot count; elements is resized
    // only to capacity. count never exceeds capacity.

    // Open: restricting writes to count, capacity, and elements to these
    // operations (a later macro); copy semantics when an Array value is
    // assigned; element lifetime for elements that own storage.
}
