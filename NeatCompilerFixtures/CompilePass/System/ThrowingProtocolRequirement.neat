protocol ThrowingLoadable {
    init(from source: String) throws
    function load() throws -> String
}

construct ThrowingProtocolRequirementFixture: ThrowingLoadable {
    init(from source: String) throws {
        throw source
    }

    function load() throws -> String {
        return try throwingValue()
    }
}

function throwingValue() throws -> String {
    throw "value"
}
