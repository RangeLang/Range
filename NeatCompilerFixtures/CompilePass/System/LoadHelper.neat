enum LoadError {
    case missing
    case network
}

construct User {
    value id: Int
    value name: String
}

enum Loadable<Value, Failure> {
    case idle
    case loading
    case loaded(item: Value)
    case failed(reason: Failure)
}

function fetchUser(id: Int) -> Result<User, LoadError> {
    if id == 0 {
        return .failure(cause: .missing)
    }

    return .success(result: User(id: id, name: "George"))
}

function load<Value, Failure>(
    target _: binding Loadable<Value, Failure>,
    #autoclosure task: Result<Value, Failure>
) {
    target = .loading

    @background {
        switch task() {
        case .success(value item):
            target = .loaded(item: item)

        case .failure(value reason):
            target = .failed(reason: reason)
        }
    }
}

construct UserView {
    value id: Int
    state user: Loadable<User, LoadError> = .idle

    init(id: Int) {
        self.id = id
        load($self.user, fetchUser(id: id))
    }

    function reload() {
        load($self.user, fetchUser(id: id))
    }
}

@main {
    value view = UserView(id: 1)
}
