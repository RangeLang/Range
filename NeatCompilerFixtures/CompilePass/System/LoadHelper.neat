enum LoadError {
    case missing
    case network
}

construct User {
    value id: Int
    value name: String
}

enum Loadable<Value, Failure> {
    case idle
    case loading
    case loaded(item: Value)
    case failed(reason: Failure)
}

function fetchUser(id: Int) -> Loadable<User, LoadError> {
    if id == 0 {
        return .failed(reason: .missing)
    }

    return .loaded(item: User(id: id, name: "George"))
}

function load<Value, Failure>(
    target _: binding Loadable<Value, Failure>,
    #autoclosure task: Loadable<Value, Failure>
) {
    target = .loading

    @background {
        target = task()
    }
}

construct UserView {
    state user: Loadable<User, LoadError> = .idle

    init(id: Int) {
        load($self.user, fetchUser(id: id))
    }

    function reload() {
        load($self.user, fetchUser(id: user.id))
    }
}

@main {
    value view = UserView(id: 1)
}
