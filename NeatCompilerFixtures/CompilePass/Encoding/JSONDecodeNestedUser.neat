construct NestedAddress {
    let city: String
}

construct NestedAddressCodingKey: CodingKey {
    let value: String

    function stringValue() -> String {
        return value
    }
}

extension NestedAddress: Decodable {
    init(from decoder: Decoder<JSONValue>) -> Result<Self, DecodingError> {
        let container = decoder.container(keyedBy: NestedAddressCodingKey.self)

        switch container.decode(String.self, forKey: NestedAddressCodingKey(value: "city")) {
        case .success(let city):
            self.city = city
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

construct NestedDecodedUser {
    let id: Int
    let address: NestedAddress
}

construct NestedDecodedUserCodingKey: CodingKey {
    let value: String

    function stringValue() -> String {
        return value
    }
}

extension NestedDecodedUser: Decodable {
    init(from decoder: Decoder<JSONValue>) -> Result<Self, DecodingError> {
        let container = decoder.container(keyedBy: NestedDecodedUserCodingKey.self)

        switch container.decode(Int.self, forKey: NestedDecodedUserCodingKey(value: "id")) {
        case .success(let id):
            self.id = id
        case .failure(let error):
            return .failure(cause: error)
        }

        switch container.decode(NestedAddress.self, forKey: NestedDecodedUserCodingKey(value: "address")) {
        case .success(let address):
            self.address = address
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

function decodeNestedUser() -> Result<NestedDecodedUser, DecodingError> {
    let addressFields: [JSONField] = [
        JSONField(key: "city", value: .string(value: "Tbilisi")),
    ]
    let fields: [JSONField] = [
        JSONField(key: "id", value: .int(value: 42)),
        JSONField(key: "address", value: .object(fields: addressFields)),
    ]
    let decoder = JSONDecoder(value: .object(fields: fields))
    return NestedDecodedUser(from: decoder)
}

@main {
    switch decodeNestedUser() {
    case .success(let user):
        Logger.info(user.address.city)
    case .failure:
        Logger.error("decoding failed")
    }
}
