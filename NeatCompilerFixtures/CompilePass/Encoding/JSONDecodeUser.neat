construct DecodedUser {
    let id: Int
    let name: String
}

construct DecodedUserCodingKey: CodingKey {
    let value: String

    function stringValue() -> String {
        return value
    }
}

extension DecodedUser: Decodable {
    init(from decoder: Decoder<JSONValue>) -> Result<Self, DecodingError> {
        let container = decoder.container(keyedBy: DecodedUserCodingKey.self)

        switch container.decode(Int.self, forKey: DecodedUserCodingKey(value: "id")) {
        case .success(let id):
            self.id = id
        case .failure(let error):
            return .failure(cause: error)
        }

        switch container.decode(String.self, forKey: DecodedUserCodingKey(value: "name")) {
        case .success(let name):
            self.name = name
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

function decodeUser() -> Result<DecodedUser, DecodingError> {
    let fields: [JSONField] = [
        JSONField(key: "id", value: .int(value: 42)),
        JSONField(key: "name", value: .string(value: "George")),
    ]
    let decoder = JSONDecoder(value: .object(fields: fields))
    return DecodedUser(from: decoder)
}

@main {
    switch decodeUser() {
    case .success(let user):
        Logger.info(user.name)
    case .failure:
        Logger.error("decoding failed")
    }
}
