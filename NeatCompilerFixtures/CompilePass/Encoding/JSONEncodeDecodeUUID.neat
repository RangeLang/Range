function encodeUUID() -> Result<String, EncodingError> {
    let encoder = JSONEncoder()
    switch UUID(uuidString: "123e4567-e89b-12d3-a456-426614174000") {
    case .success(let value):
        return encoder.encode(value)
    case .failure:
        return .failure(cause: .failed)
    }
}

function decodeUUID() -> Result<UUID, DecodingError> {
    let decoder = JSONDecoder(value: .string(value: "123e4567-e89b-12d3-a456-426614174000"))
    return UUID(from: decoder)
}

@main {
}
