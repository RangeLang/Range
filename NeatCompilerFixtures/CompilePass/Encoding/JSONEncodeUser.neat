construct User {
    let id: Int
    let name: String
}

construct UserCodingKey: CodingKey {
    let value: String

    function stringValue() -> String {
        return value
    }
}

extension User: Encodable {
    function encode(to encoder: Encoder) -> Result<Void, EncodingError> {
        state container = encoder.container(
            keyedBy: UserCodingKey.self
        )
        let idKey = UserCodingKey(value: "id")
        state nameKey = UserCodingKey(value: "name")
        container.encode(id, forKey: idKey)
        return container.encode(name, forKey: nameKey)
    }
}

function encodeUser() -> Result<String, EncodingError> {
    state encoder = JSONEncoder()
    let user = User(id: 1, name: "George")
    return encoder.encode(user)
}

@main {
    switch encodeUser() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }
}
