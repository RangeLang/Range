construct CodableManualUser {
    let id: Int
    let name: String
}

construct CodableManualUserCodingKey: CodingKey {
    let value: String

    function stringValue() -> String {
        return value
    }
}

extension CodableManualUser: Codable {
    function encode<Output>(to encoder: Encoder<Output>) -> Result<Void, EncodingError> {
        state container = encoder.container(keyedBy: CodableManualUserCodingKey.self)
        container.encode(id, forKey: CodableManualUserCodingKey(value: "id"))
        return container.encode(name, forKey: CodableManualUserCodingKey(value: "name"))
    }

    init(from decoder: Decoder<JSONValue>) -> Result<Self, DecodingError> {
        let container = decoder.container(keyedBy: CodableManualUserCodingKey.self)

        switch container.decode(Int.self, forKey: CodableManualUserCodingKey(value: "id")) {
        case .success(let id):
            self.id = id
        case .failure(let error):
            return .failure(cause: error)
        }

        switch container.decode(String.self, forKey: CodableManualUserCodingKey(value: "name")) {
        case .success(let name):
            self.name = name
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

function roundTripCodableManualUser() -> Result<CodableManualUser, DecodingError> {
    let fields: [JSONField] = [
        JSONField(key: "id", value: .int(value: 42)),
        JSONField(key: "name", value: .string(value: "George")),
    ]
    let decoder = JSONDecoder(value: .object(fields: fields))
    return CodableManualUser(from: decoder)
}

@main {
    switch roundTripCodableManualUser() {
    case .success(let user):
        Logger.info(user.name)
    case .failure:
        Logger.error("decoding failed")
    }
}
