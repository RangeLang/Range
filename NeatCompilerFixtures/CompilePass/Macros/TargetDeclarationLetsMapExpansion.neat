macro codingKeysFromLets(): Construct { target, diagnostics in
    let codingKeys: Enum.Declaration = Enum.Declaration(
        self: NamedTypeReference(name: "CodingKeys"),
        cases: target.declaration.lets.map { property in
            Enum.Case(name: property.name, associatedValues: [])
        }
    )
    let compactCodingKeys: Enum.Declaration = Enum.Declaration(
        self: NamedTypeReference(name: "CompactCodingKeys"),
        cases: target.declaration.lets.compactMap { property in
            Enum.Case(name: property.name, associatedValues: [])
        }
    )
    let flatCodingKeys: Enum.Declaration = Enum.Declaration(
        self: NamedTypeReference(name: "FlatCodingKeys"),
        cases: target.declaration.lets.flatMap { property in
            [Enum.Case(name: property.name, associatedValues: [])]
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            #(codingKeys)
            #(compactCodingKeys)
            #(flatCodingKeys)
        }
    }
}

#codingKeysFromLets
construct TargetDeclarationLetsMapFixture {
    let id: Int
    let name: String
}
