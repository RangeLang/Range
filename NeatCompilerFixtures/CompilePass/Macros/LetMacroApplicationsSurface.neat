macro codingKeyCases(): Construct { target, diagnostics in
    let codingKeys: Enum.Declaration = Enum.Declaration(
        self: NamedTypeReference(name: "CodingKeys"),
        cases: target.declaration.lets.flatMap { property in
            property.markers.map { marker in
                Enum.Case(name: marker.value, associatedValues: [])
            }
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            #(codingKeys)
        }
    }
}

#codingKeyCases
construct LetMacroApplicationsSurfaceFixture {
    #codingKey("user_id")
    let id: Int

    let name: String
}
