macro codingKeyCases(): Construct { target, diagnostics in
    let generatedKeys: Enum.Declaration = Enum.Declaration(
        self: NamedTypeReference(name: "GeneratedKeys"),
        generics: [],
        cases: target.declaration.lets.flatMap { property in
            property.markers.map { marker in
                Enum.Case(identifier: Identifier(name: marker.value), associatedValues: [])
            }
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            #(generatedKeys)
        }
    }
}

#codingKeyCases
construct LetMacroApplicationsSurfaceFixture {
    #codingKey("user_id")
    let id: Int

    let name: String
}
