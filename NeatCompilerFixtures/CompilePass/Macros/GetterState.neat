macro incremented(by amount: Int): State<Int> { target, diagnostics in
    target.getter { value in
        value + amount
    }
}

construct Reader {
    #incremented(by: 1)
    state age: Int = 10

    function current() -> Int {
        return age
    }

    function total(value: Int) -> Int {
        return age + value
    }
}
