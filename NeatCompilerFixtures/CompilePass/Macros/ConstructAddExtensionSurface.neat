protocol Greetable {
    function greet() -> String
}

macro extendConstructSurface(): Construct { target, diagnostics in
    @expand {
        extension #(target.declaration.self): Greetable {
            function greet() -> String {
                return "Hello"
            }
        }
    }
}

#extendConstructSurface
construct ExtendableFixture {
    let number: Int
}

@main {
    let result: ExtendableFixture = ExtendableFixture(number: 1)

    result.greet()
}
