protocol AdditionalTypedExpandProtocol {
}

macro typedExpandAdditionalSlots(): Construct { target, diagnostics in
    target.declaration.expand {
        protocol #("GeneratedTypedExpandProtocol"): #(AdditionalTypedExpandProtocol) {
        }

        enum #("GeneratedTypedExpandEnum"): #(AdditionalTypedExpandProtocol) {
            case #("payload")(value: #(Int))
        }

        namespace #("GeneratedTypedExpandNamespace") {
            function #("message")() -> #(String) {
                let local: #(String) = "ok"
                return local
            }
        }

        construct #("GeneratedTypedExpandConstruct")<Wrapped: #(AdditionalTypedExpandProtocol), let count: #(Int)>: #(AdditionalTypedExpandProtocol) {
            let label: #(String)
            binding amount: #(Int)
            environment externalText: #(String)
        }

        extension #(target.declaration.self) {
            #(target.declaration.self) function #("typedTargetFunction")(input: #(Int)) -> #(target.declaration.self) {
                return self
            }
        }
    }
}

#typedExpandAdditionalSlots
construct AdditionalTypedExpandFixture {
}

@main {
    let fixture = AdditionalTypedExpandFixture()
    fixture.typedTargetFunction(input: 1)
    GeneratedTypedExpandNamespace.message()
}
