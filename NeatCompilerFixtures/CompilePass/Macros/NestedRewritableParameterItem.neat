macro nestedArgumentRewrite(): Parameter { target, diagnostics in
    if !target.application.arguments.isEmpty {
        target.application.arguments[0].rewrite(
            target.application.arguments[0].expression
        )
    }
}

function passthrough(#nestedArgumentRewrite value: Int) -> Int {
    return value
}

@main {
    value output: Int = passthrough(42)
}
