protocol TypedExpandSpliceProtocol {
}

macro typedExpandSpliceSlots(): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self): #(TypedExpandSpliceProtocol) {
            function #(Identifier(name: "generatedName"))() -> #(target.declaration.self) {
                return self
            }
        }
    }
}

@typedExpandSpliceSlots
construct TypedExpandSpliceFixture {
}

#main {
    let value = TypedExpandSpliceFixture()
    value.generatedName()
}
