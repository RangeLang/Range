function enqueueBufferedValues(queue: Channel<Int>) {
    @background {
        queue.send(1)
        queue.send(2)
        queue.close()
        Logger.info("buffered queue filled")
    }
}

@main {
    value queue = Channel<Int>(capacity: 2)

    enqueueBufferedValues(queue: queue)

    value first = queue.receive()
    value second = queue.receive()

    Logger.info(first)
    Logger.info(second)
}
