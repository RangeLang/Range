enum FetchError {
    case missing
    case network
}

@background fetchUsername(id: Int) -> Promise<String, FetchError> {
    if id == 0 {
        return "system"
    }

    return "george"
}

function usePromise(request: Promise<String, FetchError>) {
    Logger.info("promise typed")
}

function useResult(result: Result<String, FetchError>) {
    Logger.info("result typed")
}

function mixedBindings(id: Int) {
    state liveRequest: Promise<String, FetchError> = fetchUsername(id: id)
    usePromise(request: liveRequest)
    Logger.info("live request started")

    value settledResult: Result<String, FetchError> = fetchUsername(id: id)
    useResult(result: settledResult)
    Logger.info("settled result finished")
}

@main {
    mixedBindings(id: 1)
}
