function double(value: Int) -> Int {
    return value * 2
}

function worker(jobs: Channel<Int>, results: Channel<Int>) {
    @background {
        value job: Int = jobs.receive()
        value result: Int = double(value: job)
        results.send(result)
    }
}

@main {
    value jobs = Channel<Int>(capacity: 2)
    value results = Channel<Int>(capacity: 2)

    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)

    jobs.send(1)
    jobs.send(2)

    value first: Int = results.receive()
    value second: Int = results.receive()

    Logger.info(first)
    Logger.info(second)
}
