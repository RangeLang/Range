function process(value: Int) -> Int {
    return value * 10
}

function worker(jobs: Channel<Int>, results: Channel<Int>) {
    @background {
        value job: Int = jobs.receive()
        value result: Int = process(value: job)
        results.send(result)
    }
}

@main {
    value jobs = Channel<Int>(capacity: 3)
    value results = Channel<Int>(capacity: 3)

    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)

    jobs.send(1)
    jobs.send(2)
    jobs.send(3)

    value first: Int = results.receive()
    value second: Int = results.receive()
    value third: Int = results.receive()

    Logger.info(first)
    Logger.info(second)
    Logger.info(third)
}
