@main {
    let sourceA = Channel<String>(capacity: 1)
    let sourceB = Channel<String>(capacity: 1)
    let merged = Channel<String>(capacity: 2)

    @background {
        merged.send(sourceA.receive())
    }

    @background {
        merged.send(sourceB.receive())
    }

    sourceA.send("from A")
    sourceB.send("from B")

    Logger.info(merged.receive())
    Logger.info(merged.receive())
}
