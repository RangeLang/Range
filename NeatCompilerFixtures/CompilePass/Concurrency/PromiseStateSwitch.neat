@background workerA(count: Int) -> Promise<String, String> {
    if count == 0 {
        return "zero"
    }

    return "done"
}

function useResult(result: Result<String, String>) {
    Logger.info("result typed")
}

function usePromise(promise: Promise<String, String>) {
    Logger.info("promise typed")
}

function useStream(stream: Stream<String, String>) {
    Logger.info("stream typed")
}

@main {
    value promise: Promise<String, String> = workerA(count: 2)
    usePromise(promise: promise)
    Logger.info("flat async core types")
}
