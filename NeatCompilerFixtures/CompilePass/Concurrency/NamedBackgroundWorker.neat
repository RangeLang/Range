enum FetchError {
    case missing
    case network
}

@background fetchUsername(id: Int) -> Promise<String, FetchError> {
    if id == 0 {
        return "system"
    }

    return "george"
}

function useLiveRequest(request: Promise<String, FetchError>) {
    Logger.info("live request typed")
}

function useSettledResult(result: Result<String, FetchError>) {
    Logger.info("settled result typed")
}

@main {
    state liveRequest: Promise<String, FetchError> = fetchUsername(id: 1)
    useLiveRequest(request: liveRequest)
    Logger.info("request started")

    value settledResult: Result<String, FetchError> = fetchUsername(id: 1)
    useSettledResult(result: settledResult)
    Logger.info("request finished")
}
