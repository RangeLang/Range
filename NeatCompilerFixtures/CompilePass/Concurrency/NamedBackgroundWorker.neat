@background workerA(count: Int) -> Promise<String, String> {
    if count == 0 {
        return "zero"
    }

    return "done"
}

@main {
    value promise = workerA(count: 2)
    value loading = promise.isLoading()
    value currentValue = promise.value()
    value currentError = promise.error()

    Logger.info("checked promise state")
}
