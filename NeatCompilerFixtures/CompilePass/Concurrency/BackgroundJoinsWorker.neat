enum FetchError {
    case missing
    case network
}

@background fetchUsername(id: Int) -> Promise<String, FetchError> {
    if id == 0 {
        return "system"
    }

    return "george"
}

function useResult(result: Result<String, FetchError>) {
    Logger.info("nested background joined result")
}

function refreshLater(id: Int) {
    @background {
        value result: Result<String, FetchError> = fetchUsername(id: id)
        useResult(result: result)
        Logger.info("background worker join finished")
    }

    Logger.info("outer function returned")
}

@main {
    refreshLater(id: 1)
}
