@main {
    let intSum = 1 + 2
    let intDifference = 5 - 2
    let intProduct = 3 * 4
    let intQuotient = 8 / 2
    let intRemainder = 7 % 3

    let floatSum = 1.5 + 2.0
    let floatDifference = 5.5 - 2.0
    let floatProduct = 1.5 * 2.0
    let floatQuotient = 9.0 / 2.0

    let mixedSum = 1 + 2.5
    let mixedDifference = 5 - 2.5
    let mixedProduct = 3 * 2.5
    let mixedQuotient = 9 / 2.0

    let count = 3
    let lessThan = count < 10
    let lessOrEqual = count <= 3
    let greaterThan = 10 > count
    let greaterOrEqual = count >= 3
}
