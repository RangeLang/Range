macro firstArgument(): Function { target, diagnostics in
    if !target.application.arguments.isEmpty {
        target.application.rewrite(
            target.application.arguments[0].expression
        )
    }
}

#firstArgument
function select(text text: String, number number: Int) -> String {
    return text
}

@main {
    value result: Int = select(text: "Hello", number: 27)
}
