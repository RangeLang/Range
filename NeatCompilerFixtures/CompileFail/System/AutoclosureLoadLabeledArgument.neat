enum LoadError {
    case missing
}

construct User {
    value id: Int
}

enum Loadable<Value, Failure> {
    case idle
    case loading
    case loaded(item: Value)
    case failed(reason: Failure)
}

function fetchUser(id: Int) -> Loadable<User, LoadError> {
    return .loaded(item: User(id: id))
}

function load<Value, Failure>(
    target _: binding Loadable<Value, Failure>,
    #autoclosure task: Loadable<Value, Failure>
) {
    target = .loading

    @background {
        target = task()
    }
}

construct UserView {
    state user: Loadable<User, LoadError>

    init(id: Int) {
        load($self.user, task: fetchUser(id: id))
    }
}

@main {
    value view = UserView(id: 1)
}
