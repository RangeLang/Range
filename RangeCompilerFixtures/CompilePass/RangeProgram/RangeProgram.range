function emptyRangeProgram(): RangeProgram {
    return RangeProgram(
        graph: ProgramGraph(
            files: [],
            sources: [],
            lexedSources: [],
            artifacts: [],
            rangeGraph: RangeGraph(nodes: [], relationships: []),
            syntax: []
        )
    )
}

function rangeProgram(files: [FileTreeNode], sources: [ProgramSourceFile], lexedSources: [ProgramLexedSource], artifacts: [ProgramArtifact], rangeGraph: RangeGraph, syntax: [GraphSyntax]): RangeProgram {
    return RangeProgram(
        graph: ProgramGraph(
            files: files,
            sources: sources,
            lexedSources: lexedSources,
            artifacts: artifacts,
            rangeGraph: rangeGraph,
            syntax: syntax
        )
    )
}

function gatherProgramFiles(path: String, program: RangeProgram): Result<RangeProgram, FileReadError> {
    state files: [FileTreeNode](program.graph.files)
    state sources: [ProgramSourceFile](program.graph.sources)

    switch FileTree.read(path: path) {
    case .success(let tree):
        files.append(element: tree)

        switch gatherProgramSources(node: tree, sources: sources) {
        case .success(let gatheredSources):
            return .success(result: rangeProgram(files: files, sources: gatheredSources, lexedSources: program.graph.lexedSources, artifacts: program.graph.artifacts, rangeGraph: program.graph.rangeGraph, syntax: program.graph.syntax))
        case .failure(let error):
            return .failure(cause: error)
        }
    case .failure(let error):
        return .failure(cause: error)
    }

    return .failure(cause: .unreadable)
}

function lexProgramSources(program: RangeProgram): Result<RangeProgram, LexingError> {
    state lexedSources: [ProgramLexedSource](program.graph.lexedSources)
    let lexer: Lexer(rangeLexer())
    state index   0

    while index < program.graph.sources.count {
        let source: ProgramSourceFile(program.graph.sources.element(index: index))

        switch lexer.tokenize(source: source.text) {
        case .success(let tokens):
            lexedSources.append(element: ProgramLexedSource(path: source.path, tokens: tokens))
        case .failure(let error):
            return .failure(cause: error)
        }

        index += 1
    }

    return .success(
        result: rangeProgram(
            files: program.graph.files,
            sources: program.graph.sources,
            lexedSources: lexedSources,
            artifacts: program.graph.artifacts,
            rangeGraph: program.graph.rangeGraph,
            syntax: program.graph.syntax
        )
    )
}

function gatherProgramSources(node: FileTreeNode, sources: [ProgramSourceFile]): Result<[ProgramSourceFile], FileReadError> {
    state gathered: [ProgramSourceFile](sources)

    switch node.kind {
    case .file:
        if isRangeSourceFile(name: node.name) {
            switch FileManager.readFile(path: node.path) {
            case .success(let text):
                gathered.append(element: ProgramSourceFile(path: node.path, text: text))
            case .failure(let error):
                return .failure(cause: error)
            }
        }
    case .directory:
        state index   0

        while index < node.children.count {
            let child: FileTreeNode(node.children.element(index: index))

            switch gatherProgramSources(node: child, sources: []) {
            case .success(let childSources):
                state childIndex   0

                while childIndex < childSources.count {
                    gathered.append(element: childSources.element(index: childIndex))
                    childIndex += 1
                }
            case .failure(let error):
                return .failure(cause: error)
            }

            index += 1
        }
    }

    return .success(result: gathered)
}

function isRangeSourceFile(name: String): Bool {
    let suffix   ".range"

    if name.count < suffix.count {
        return false
    }

    return name.substring(start: name.count - suffix.count, end: name.count) == suffix
}

function artifactRelativePath(path: String): String {
    let pathPrefix   "../../../../../../"

    if startsWith(text: path, leadingText: pathPrefix) {
        return path.substring(start: pathPrefix.count, end: path.count)
    }

    return path
}

function startsWith(text: String, leadingText: String): Bool {
    if text.count < leadingText.count {
        return false
    }

    return text.substring(start: 0, end: leadingText.count) == leadingText
}

function buildProgramArtifacts(program: RangeProgram): RangeProgram {
    state artifacts: [ProgramArtifact](program.graph.artifacts)
    state sourceIndex   0

    while sourceIndex < program.graph.sources.count {
        let source: ProgramSourceFile(program.graph.sources.element(index: sourceIndex))
        let relativePath: String(artifactRelativePath(path: source.path))
        artifacts.append(
            element: ProgramArtifact(
                path: "../../../RangeProgramArtifacts/sources/\(relativePath).txt",
                text: source.text
            )
        )
        sourceIndex += 1
    }

    state lexedIndex   0

    while lexedIndex < program.graph.lexedSources.count {
        let source: ProgramLexedSource(program.graph.lexedSources.element(index: lexedIndex))
        let relativePath: String(artifactRelativePath(path: source.path))
        artifacts.append(
            element: ProgramArtifact(
                path: "../../../RangeProgramArtifacts/lexed/\(relativePath).tokens.txt",
                text: renderTokens(tokens: source.tokens)
            )
        )
        lexedIndex += 1
    }

    artifacts.append(
        element: ProgramArtifact(
            path: "../../../RangeProgram.txt",
            text: renderRangeProgramSummary(
                program: program,
                artifactCount: artifacts.count + 1
            )
        )
    )

    return rangeProgram(
        files: program.graph.files,
        sources: program.graph.sources,
        lexedSources: program.graph.lexedSources,
        artifacts: artifacts,
        rangeGraph: program.graph.rangeGraph,
        syntax: program.graph.syntax
    )
}

function emitProgramArtifacts(artifacts: [ProgramArtifact]): Result<Void, FileWriteError> {
    state index   0

    while index < artifacts.count {
        let artifact: ProgramArtifact(artifacts.element(index: index))

        switch FileManager.createFile(path: artifact.path, text: artifact.text) {
        case .success:
            Logger.info("wrote \(artifact.path)")
        case .failure(let error):
            return .failure(cause: error)
        }

        index += 1
    }

    return .success(result: Void())
}

function renderRangeProgramSummary(program: RangeProgram, artifactCount: Int): String {
    return "RangeProgram\nfiles: \(program.graph.files.count)\nsources: \(program.graph.sources.count)\nlexed sources: \(program.graph.lexedSources.count)\nartifacts: \(artifactCount)\ngraph nodes: \(program.graph.rangeGraph.nodes.count)\ngraph relationships: \(program.graph.rangeGraph.relationships.count)\nsyntax: \(program.graph.syntax.count)\n"
}

function renderRangeProgram(program: RangeProgram): String {
    return "\(renderRangeProgramSummary(program: program, artifactCount: program.graph.artifacts.count))\(renderProgramFiles(files: program.graph.files))\(renderProgramSources(sources: program.graph.sources))\(renderProgramLexedSources(lexedSources: program.graph.lexedSources))"
}

function renderProgramFiles(files: [FileTreeNode]): String {
    state output   ""
    state index   0

    while index < files.count {
        let file: FileTreeNode(files.element(index: index))
        output += "- \(file.path) children: \(file.children.count)\n"
        index += 1
    }

    return output
}

function renderProgramSources(sources: [ProgramSourceFile]): String {
    state output   ""
    state index   0

    while index < sources.count {
        let source: ProgramSourceFile(sources.element(index: index))
        output += "- \(source.path) characters: \(source.text.count)\n"
        index += 1
    }

    return output
}

function renderProgramLexedSources(lexedSources: [ProgramLexedSource]): String {
    state output   ""
    state index   0

    while index < lexedSources.count {
        let source: ProgramLexedSource(lexedSources.element(index: index))
        output += "- \(source.path) tokens: \(source.tokens.count)\n"
        index += 1
    }

    return output
}

function tokenKindName(kind: TokenKind): String {
    switch kind {
    case .hash:
        return "hash"
    case .identifier:
        return "identifier"
    case .markerAttribute:
        return "markerAttribute"
    case .foreignBody:
        return "foreignBody"
    case .stringLiteral:
        return "stringLiteral"
    case .integer:
        return "integer"
    case .double:
        return "double"
    case .keyword:
        return "keyword"
    case .macroAttribute:
        return "macroAttribute"
    case .leftBrace:
        return "leftBrace"
    case .rightBrace:
        return "rightBrace"
    case .leftParen:
        return "leftParen"
    case .rightParen:
        return "rightParen"
    case .leftBracket:
        return "leftBracket"
    case .rightBracket:
        return "rightBracket"
    case .asterisk:
        return "asterisk"
    case .dot:
        return "dot"
    case .ellipsis:
        return "ellipsis"
    case .colon:
        return "colon"
    case .arrow:
        return "arrow"
    case .bang:
        return "bang"
    case .equal:
        return "equal"
    case .equalEqual:
        return "equalEqual"
    case .bangEqual:
        return "bangEqual"
    case .minus:
        return "minus"
    case .less:
        return "less"
    case .lessEqual:
        return "lessEqual"
    case .greater:
        return "greater"
    case .greaterEqual:
        return "greaterEqual"
    case .plus:
        return "plus"
    case .plusEqual:
        return "plusEqual"
    case .slash:
        return "slash"
    case .ampersand:
        return "ampersand"
    case .andAnd:
        return "andAnd"
    case .pipe:
        return "pipe"
    case .orOr:
        return "orOr"
    case .question:
        return "question"
    case .questionQuestion:
        return "questionQuestion"
    case .dollar:
        return "dollar"
    case .percent:
        return "percent"
    case .comma:
        return "comma"
    case .eof:
        return "eof"
    }
}

function renderTokens(tokens: [LexicalToken]): String {
    state output   ""
    state index   0

    while index < tokens.count {
        let token: LexicalToken(tokens.element(index: index))
        output += "\(index): \(tokenKindName(kind: token.kind)) \"\(token.source)\" @ \(token.range.start.line):\(token.range.start.character)-\(token.range.end.line):\(token.range.end.character)\n"
        index += 1
    }

    return output
}

@main {
    let program: RangeProgram(emptyRangeProgram())

    switch gatherProgramFiles(path: "../../../../../../RangeCore", program: program) {
    case .success(let program):
        switch lexProgramSources(program: program) {
        case .success(let program):
            let artifactProgram: RangeProgram(buildProgramArtifacts(program: program))
            Logger.info(renderRangeProgramSummary(program: artifactProgram, artifactCount: artifactProgram.graph.artifacts.count))

            switch emitProgramArtifacts(artifacts: artifactProgram.graph.artifacts) {
            case .success:
                Logger.info("wrote \(artifactProgram.graph.artifacts.count) RangeProgram artifacts")
            case .failure:
                Logger.error("failed to write RangeProgram artifacts")
            }
        case .failure(let error):
            Logger.error(error.message)
        }
    case .failure:
        Logger.error("failed to read RangeProgram")
    }
}
