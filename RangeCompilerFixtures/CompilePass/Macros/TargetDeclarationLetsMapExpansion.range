macro enumCasesFromLets(): Construct { target, diagnostics in
    let generatedFields: Enum.Declaration := Enum.Declaration(
        self: NamedTypeReference(name: "GeneratedFields"),
        generics: [],
        cases: target.declaration.lets.map { property in
            Enum.Case(identifier: property.identifier, associatedValues: [])
        }
    )
    let compactGeneratedFields: Enum.Declaration := Enum.Declaration(
        self: NamedTypeReference(name: "CompactGeneratedFields"),
        generics: [],
        cases: target.declaration.lets.compactMap { property in
            Enum.Case(identifier: property.identifier, associatedValues: [])
        }
    )
    let flatGeneratedFields: Enum.Declaration := Enum.Declaration(
        self: NamedTypeReference(name: "FlatGeneratedFields"),
        generics: [],
        cases: target.declaration.lets.flatMap { property in
            [Enum.Case(identifier: property.identifier, associatedValues: [])]
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            #(generatedFields)
            #(compactGeneratedFields)
            #(flatGeneratedFields)
        }
    }
}

@enumCasesFromLets
construct TargetDeclarationLetsMapFixture {
    let id: Int
    let name: String
}
