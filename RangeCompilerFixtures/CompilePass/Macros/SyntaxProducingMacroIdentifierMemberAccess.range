macro identifierContainerSwitch(container: Identifier, value: Identifier, key: String) -> Switch {
    switch #(container).encode(#(value), forKey: key) {
    case .success:
        break
    case .failure(let error):
        return .failure(cause: error)
    }
}

macro emitIdentifierContainerSwitch(): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self): Encodable {
            function encode(to encoder: Encoder) -> Result<Void, EncodingError> {
                let container: KeyedEncodingContainer(encoder.keyedContainer())
                @identifierContainerSwitch(
                    container: Identifier(name: "container"),
                    value: Identifier(name: "id"),
                    key: "id"
                )
                return .success(result: Void())
            }
        }
    }
}

@emitIdentifierContainerSwitch
construct SyntaxProducingMacroIdentifierMemberAccessFixture {
    let id: Int
}
