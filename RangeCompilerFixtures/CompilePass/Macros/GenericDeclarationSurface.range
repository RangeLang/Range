macro exposeGenericCount(): Construct { target, diagnostics in
    let generatedGenerics: Enum.Declaration := Enum.Declaration(
        self: NamedTypeReference(name: "GeneratedGenerics"),
        generics: [],
        cases: target.declaration.generics.map { item in
            Enum.Case(
                identifier: item.identifier,
                associatedValues: [
                    Enum.AssociatedValue(
                        label: "generic",
                        type: NamedTypeReference(name: "Generic")
                    )
                ]
            )
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            #(generatedGenerics)
        }
    }
}

@exposeGenericCount
construct GenericDeclarationSurfaceFixture<T, let count: Int, Scalar = Float> {}

#main {}
