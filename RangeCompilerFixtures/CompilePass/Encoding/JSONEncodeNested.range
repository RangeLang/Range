construct Address {
    let city: String
    let zip: Int
}

extension Address: Encodable {
    function encode(to encoder: Encoder) -> Result<Void, EncodingError> {
        state container := encoder.keyedContainer()

        switch container.encode(city, forKey: "city") {
        case .success:
            return container.encode(zip, forKey: "zip")
        case .failure(let error):
            return .failure(cause: error)
        }

        return .failure(cause: .failed)
    }
}

construct User {
    let name: String
    let address: Address
    let scores: [Int]
}

extension User: Encodable {
    function encode(to encoder: Encoder) -> Result<Void, EncodingError> {
        state container := encoder.keyedContainer()

        switch container.encode(name, forKey: "name") {
        case .success:
            switch container.encode(address, forKey: "address") {
            case .success:
                return container.encode(scores, forKey: "scores")
            case .failure(let error):
                return .failure(cause: error)
            }
        case .failure(let error):
            return .failure(cause: error)
        }

        return .failure(cause: .failed)
    }
}

function encodeNested() -> Result<String, EncodingError> {
    let encoder := JSONEncoder()
    let address := Address(city: "Tbilisi", zip: 1000)
    let user := User(name: "George", address: address, scores: [1, 2, 3])
    return encoder.encode(user)
}

#main {
    switch encodeNested() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }
}
