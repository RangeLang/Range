function encodeNilOptional() -> Result<String, EncodingError> {
    let encoder   JSONEncoder()
    let value: Int?   nil
    return encoder.encode(value)
}

function encodeSomeOptional() -> Result<String, EncodingError> {
    let encoder   JSONEncoder()
    let value: Int?   42
    return encoder.encode(value)
}

@main {
    switch encodeNilOptional() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }

    switch encodeSomeOptional() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }
}
