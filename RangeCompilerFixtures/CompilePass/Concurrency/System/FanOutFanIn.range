function process(value: Int) -> Int {
    return value * 10
}

function worker(jobs: Channel<Int>, results: Channel<Int>) {
    @background {
        let job: Int(jobs.receive())
        let result: Int(process(value: job))
        results.send(result)
    }
}

@main {
    let jobs   Channel<Int>(storage: ChannelStorage<Int>(capacity: 3))
    let results   Channel<Int>(storage: ChannelStorage<Int>(capacity: 3))

    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)

    jobs.send(1)
    jobs.send(2)
    jobs.send(3)

    let first: Int(results.receive())
    let second: Int(results.receive())
    let third: Int(results.receive())

    Logger.info(first)
    Logger.info(second)
    Logger.info(third)
}
