#main {
    let sourceA := Channel<String>(storage: ChannelStorage<String>(capacity: 1))
    let sourceB := Channel<String>(storage: ChannelStorage<String>(capacity: 1))
    let merged := Channel<String>(storage: ChannelStorage<String>(capacity: 2))

    @background {
        merged.send(sourceA.receive())
    }

    @background {
        merged.send(sourceB.receive())
    }

    sourceA.send("from A")
    sourceB.send("from B")

    Logger.info(merged.receive())
    Logger.info(merged.receive())
}
