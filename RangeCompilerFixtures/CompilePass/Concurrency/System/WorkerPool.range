function process(value: Int) -> Int {
    return value * 100
}

function worker(jobs: Channel<Int>, results: Channel<Int>) {
    @background {
        let first: Int(jobs.receive())
        let firstResult: Int(process(value: first))
        results.send(firstResult)

        let second: Int(jobs.receive())
        let secondResult: Int(process(value: second))
        results.send(secondResult)
    }
}

@main {
    let jobs   Channel<Int>(storage: ChannelStorage<Int>(capacity: 4))
    let results   Channel<Int>(storage: ChannelStorage<Int>(capacity: 4))

    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)

    jobs.send(1)
    jobs.send(2)
    jobs.send(3)
    jobs.send(4)

    let a: Int(results.receive())
    let b: Int(results.receive())
    let c: Int(results.receive())
    let d: Int(results.receive())

    Logger.info(a)
    Logger.info(b)
    Logger.info(c)
    Logger.info(d)
}
