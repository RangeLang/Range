function logIncoming(messages: Channel<String>) {
    @background {
        Logger.info(messages.receive())
        Logger.info(messages.receive())
        Logger.info(messages.receive())
    }
}

@main {
    let messages   Channel<String>(storage: ChannelStorage<String>(capacity: 3))

    logIncoming(messages: messages)

    messages.send("connected")
    messages.send("message")
    messages.send("disconnected")
}
