function parse(value: Int) -> Int {
    return value + 1
}

function transform(value: Int) -> Int {
    return value * 10
}

function stageOne(input: Channel<Int>, parsed: Channel<Int>) {
    @background {
        parsed.send(parse(value: input.receive()))
        parsed.send(parse(value: input.receive()))
    }
}

function stageTwo(parsed: Channel<Int>, output: Channel<Int>) {
    @background {
        output.send(transform(value: parsed.receive()))
        output.send(transform(value: parsed.receive()))
    }
}

#main {
    let input := Channel<Int>(storage: ChannelStorage<Int>(capacity: 2))
    let parsed := Channel<Int>(storage: ChannelStorage<Int>(capacity: 2))
    let output := Channel<Int>(storage: ChannelStorage<Int>(capacity: 2))

    stageOne(input: input, parsed: parsed)
    stageTwo(parsed: parsed, output: output)

    input.send(1)
    input.send(2)

    Logger.info(output.receive())
    Logger.info(output.receive())
}
