function fetchUserName(id: Int) -> String {
    if id == 0 {
        return "system"
    }

    return "george"
}

@main {
    let output   Channel<String>()

    @background {
        let name: String   fetchUserName(id: 1)
        output.send(name)
    }

    let received: String   output.receive()
    Logger.info(received)
}
