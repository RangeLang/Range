function enqueueBufferedValues(queue: Channel<Int>) {
    @background {
        queue.send(1)
        queue.send(2)
        queue.close()
        Logger.info("buffered queue filled")
    }
}

@main {
    let queue   Channel<Int>(storage: ChannelStorage<Int>(capacity: 2))

    enqueueBufferedValues(queue: queue)

    let first   queue.receive()
    let second   queue.receive()

    Logger.info(first)
    Logger.info(second)
}
