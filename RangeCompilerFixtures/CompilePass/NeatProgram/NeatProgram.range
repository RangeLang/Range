function emptyRangeProgram(): RangeProgram {
    return RangeProgram(
        graph: ProgramGraph(
            files: [],
            syntax: []
        )
    )
}

function rangeProgram(files: [FileTreeNode], syntax: [GraphSyntax]): RangeProgram {
    return RangeProgram(
        graph: ProgramGraph(
            files: files,
            syntax: syntax
        )
    )
}

function gatherProgramFiles(path: String, program: RangeProgram): Result<RangeProgram, FileReadError> {
    state files: [FileTreeNode](program.graph.files)

    switch FileTree.read(path: path) {
    case .success(let tree):
        files.append(element: tree)
        return .success(result: rangeProgram(files: files, syntax: program.graph.syntax))
    case .failure(let error):
        return .failure(cause: error)
    }

    return .failure(cause: .unreadable)
}

function renderNeatProgram(program: RangeProgram): String {
    return "NeatProgram\nfiles: \(program.graph.files.count)\n\(renderNeatFiles(files: program.graph.files))syntax: \(program.graph.syntax.count)\n"
}

function renderNeatFiles(files: [FileTreeNode]): String {
    state output   ""
    state index   0

    while index < files.count {
        let file: FileTreeNode(files.element(index: index))
        output += "- \(file.path) children: \(file.children.count)\n"
        index += 1
    }

    return output
}

@main {
    let program: RangeProgram(emptyRangeProgram())

    switch gatherProgramFiles(path: "../../../", program: program) {
    case .success(let program):
        let output: String(renderNeatProgram(program: program))
        Logger.info(output)

        switch FileSystem.writeText(path: "../../../NeatProgram.txt", text: output) {
        case .success:
            Logger.info("wrote NeatProgram.txt")
        case .failure:
            Logger.error("failed to write NeatProgram.txt")
        }
    case .failure:
        Logger.error("failed to read NeatProgram")
    }
}
