function decodeNumber() -> Result<Int, DecodingError> {
    let decoder = JSONDecoder(value: .int(value: 42))
    return Int.decode(from: decoder)
}

#main {
    switch decodeNumber() {
    case .success(let value):
        Logger.info(value)
    case .failure:
        Logger.error("decoding failed")
    }
}
