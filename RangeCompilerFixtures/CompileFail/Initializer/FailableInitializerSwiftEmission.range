enum DecodeError {
    case failed
}

construct DecodedUser {
    let name: String

    init(name: String) -> Result<Self, DecodeError> {
        if name == "" {
            return .failure(cause: .failed)
        }

        set self.name   name
        return .success(result: self)
    }
}

function decodeUser() -> Result<DecodedUser, DecodeError> {
    return DecodedUser(name: "George")
}

@main {
    switch decodeUser() {
    case .success(let user):
        Logger.info(user.name)
    case .failure(let error):
        Logger.error(error)
    }
}
