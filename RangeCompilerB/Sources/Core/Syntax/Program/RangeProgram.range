@builtin
construct RangeProgram {
    let graph: RangeGraph
}

@builtin
construct RangeGraph {
    let files: Array<FileTreeNode>
    let sources: Array<ProgramSourceFile>
    let lexedSources: Array<ProgramLexedSource>
    let artifacts: Array<ProgramArtifact>
    let topology: RangeGraphTopology
    state main: Optional<@main>
    state syntax: Array<@syntax>
}

@builtin
construct ProgramSourceFile {
    let path: String
    let text: String
}

@builtin
construct ProgramLexedSource {
    let path: String
    let tokens: Array<LexicalToken>
}

@builtin
construct ProgramArtifact {
    let path: String
    let text: String
}

@builtin
construct RangeGraphTopology {
    let compositions: Array<Composition>
    let nodes: Array<RangeGraphNode>
    let relationships: Array<RangeGraphRelationship>
}

@builtin
construct RangeGraphNode {
    let identity: Identity
    let sourcePath: String
    let labels: Array<String>
}

@builtin
construct RangeGraphRelationship {
    let origin: Identity
    let role: Identity
    let destination: Identity
    let registration: RelationshipRegistration
}

construct RangeGraphDelta {
    let identity: Identity
    let parentRevision: Identity?
    let origin: Identity
    let ordinal: Int
    let changes: Array<Change>
    let observations: Array<Observation>
    let writes: Array<Write>
    let interactions: Array<Interaction>
    let diagnostics: Array<Diagnostic>

    enum Change {
        case insert(value: @syntax, parent: Identity?, ordinal: Int)
        case replace(target: Identity, value: @syntax)
        case remove(target: Identity)
        case relate(relationship: RangeGraphRelationship)
    }

    construct Observation {
        let observer: Identity
        let observed: Identity
        let version: Identity
        let kind: String
    }

    construct Write {
        let target: Identity
        let relationship: Identity?
        let kind: String
    }

    // A rooted graph walk is the local tree seen by one reducer. Requirement
    // and provision meet along this path and produce only this delta's writes.
    construct Interaction {
        let root: Identity
        let path: Array<Identity>
        let requirement: Identity
        let provision: Identity
    }

    construct Diagnostic {
        let severity: Severity
        let message: String
        let source: @syntax?
    }

    enum Severity {
        case error
        case warning
        case information
        case hint
    }
}

// Deltas in a batch share one parent and have pairwise-disjoint write sets.
// Their ordinal is the deterministic commit order; allocation order is never
// part of the resulting revision identity.
construct RangeGraphDeltaBatch {
    let identity: Identity
    let parentRevision: Identity?
    let deltas: Array<RangeGraphDelta>
}

// A checkpoint is a disposable materialization of the graph after replaying
// through revision. The committed RangeGraphDelta history remains authority.
construct RangeGraphCheckpoint {
    let revision: Identity
    let topology: RangeGraphTopology
    let derivations: Array<RangeGraphDerivation>
}

construct RangeGraphDerivation {
    let identity: Identity
    let input: Identity
    let output: Identity
    let closure: Identity
    let root: Identity
    let path: Array<Identity>
}
