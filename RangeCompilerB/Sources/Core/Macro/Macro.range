@graph(.declaration, .application)
construct Macro {
    construct Environment<Target> {
        state target: Target
        state diagnostics: MacroDiagnostics
        state graph: RangeGraph

        function information(_ message: String) {
            diagnostics.information(message)
        }

        function warning(_ message: String) {
            diagnostics.warning(message)
        }

        function hint(_ message: String) {
            diagnostics.hint(message)
        }

        function error(_ message: String) {
            diagnostics.error(message)
        }

        function expand(_ syntax: @syntax): RangeGraphDelta
        function omit(): RangeGraphDelta
    }

    construct Execution<Value> {
        @value
        let value: Value
        let delta: RangeGraphDelta
    }

    construct Target {
        let kind: String
        let name: String
        let type: TypeReference?
        let elements: Array<Target>
    }

    @syntax
    construct Declaration {
        let macros: Array<Macro.Application>
        let identity: Identity
        let packageVisibility: String
        let generics: Array<Parameter.Declaration>
        let parameters: Array<Parameter.Declaration>
        let target: String
        let targetSyntax: Target?
        let expansionType: TypeReference?
        let parsedBody: Parsed<Block>
    }

    @syntax
    construct Application<Value = Nil> {
        let identity: Identity
        let target: Identity
        let genericArguments: Array<TypeReference>
        let argumentClause: String
        let arguments: Array<Expression>
        let declaration: Declaration?
        let packageVisibility: String
        let valueType: TypeReference
        @value
        let value: Value
    }
}
