construct PhaseRegistration {
    let function: Function
}

construct CompilerRegistration {
    let compiler: Construct.Declaration
    let phases: Array<@phase>
}

macro phase(): Function -> PhaseRegistration {
    return PhaseRegistration(function: #environment.target)
}

macro compiler(): Construct -> CompilerRegistration {
    let phaseFunctions: Array<@phase>(
        #environment.target.Declaration.members.filter(all: @phase)
    )

    if phaseFunctions.count == 0 {
        #environment.error("@compiler requires at least one @phase function.")
    }

    return CompilerRegistration(
        compiler: #environment.target.Declaration,
        phases: phaseFunctions
    )
}
