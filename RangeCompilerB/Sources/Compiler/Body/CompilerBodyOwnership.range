function compilerBodyArenaOwnedPathOpaqueLeafCanDeactivateAt(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathID: Int, blockID: Int, pathCount: Int): Bool {
    if pathID < 0 || pathID >= pathCount
