function compilerBodyArenaOwnedPathApplyLocalBindingMove(arena: CompilerBodyArena, statementNodeID: Int, states: Buffer<Int>, origins: Buffer<Int>, effectPaths: CompilerIntTable, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, returnSummaries: CompilerIntTable, recordFacts: Bool): Int {
