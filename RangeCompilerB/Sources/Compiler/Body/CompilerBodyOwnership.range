        if projection.update(element: compilerBodyOwnedPathProjectionRetain(), index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: pathID, column: compilerBodyOwnedPathProjectionDecisionColumn())) != 0
            || projection.update(element: 1, index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: pathID, column: compilerBodyOwnedPathProjectionAllAbsentColumn())) != 0
            || projection.update(element: 0, index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: pathID, column: compilerBodyOwnedPathProjectionDeactivationColumn())) != 0 { return 0 - 1 }
