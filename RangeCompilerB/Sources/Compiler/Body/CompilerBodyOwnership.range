            && compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID) == compilerBodyOwnedPathActivationEvaluationTemporary() {
            let evaluationNodeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
            state decision: Int(compilerBodyOwnedPathProjectionRetain())
            if evaluationProducers.element(index: rootPathID) == blockID {
