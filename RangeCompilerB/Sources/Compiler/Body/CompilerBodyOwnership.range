                                let constructMoveStatus: Int(compilerBodyArenaOwnedPathApplyConstructMove(arena: arena, applicationNodeID: nodeID, states: states, origins: origins, effectPaths: effectPaths, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, recordFacts: recordFacts))
                                compilerProbeEnd(probe: constructMoveProbe, status: constructMoveStatus, resultCount: targetKind)
                                if constructMoveStatus != 0 {
