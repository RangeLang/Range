    let originPathID: Int(compilerBodyArenaOwnedPathOriginAt(origins: origins, pathID: pathID, blockID: blockID, pathCount: pathCount))
    if policy == compilerBodyOwnedPathPolicyOwned() {
        if originPathID == compilerBodyOwnedOriginLocal() { return stateValue == compilerBodyOwnedPathMoved() || stateValue == compilerBodyOwnedPathConsumed() }
        if compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID) { return stateValue == compilerBodyOwnedPathLive() || stateValue == compilerBodyOwnedPathMoved() }
        return false
    }
    if policy == compilerBodyOwnedPathPolicyAlias() {
