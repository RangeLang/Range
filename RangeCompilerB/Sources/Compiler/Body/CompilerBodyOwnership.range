function compilerBodyArenaValidateOwnedPaths(arena: CompilerBodyArena, preparation: CompilerOwnedPathPreparation, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effects: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable, returnLeaves: CompilerIntTable, applyInstanceEffects: Bool, recordFacts: Bool): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
