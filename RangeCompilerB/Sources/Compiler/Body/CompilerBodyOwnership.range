            } else {
                let predecessorCount: Int(relationships.predecessorCounts.element(index: nextBlockID))
                let firstPredecessorEdgeID: Int(compilerBodyArenaCFGPredecessorEdgeID(relationships: relationships, blockID: nextBlockID, ordinal: 0))
                let firstPredecessorID: Int(compilerBodyArenaCFGRelationshipSourceBlockID(arena: arena, relationships: relationships, edgeID: firstPredecessorEdgeID))
                if predecessorCount < 1 || firstPredecessorID < 0
