function compilerBodyMemoryAppendFact(arena: CompilerBodyArena, phase: Int, kind: Int, sourceNodeID: Int, subjectKind: Int, subjectID: Int, auxID: Int): Int {
    let factID: Int(compilerIntTableRowCount(table: arena.memoryFacts))
    if compilerIntTableAppend(table: arena.memoryFacts, value: factID) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: phase) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: kind) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: sourceNodeID) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: subjectKind) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: subjectID) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: auxID) != 0 { return 0 - 1 }
    return factID
}

function compilerBodyMemoryBeginPhase(arena: CompilerBodyArena, phase: Int): Bool {
    return arena.memoryState.element(index: compilerBodyMemoryStateValid()) == 1
        && arena.memoryState.element(index: compilerBodyMemoryStateDerived()) == 0
        && arena.memoryState.element(index: compilerBodyMemoryStateCompletedPhase()) == phase - 1
}

function compilerBodyMemoryCompletePhase(arena: CompilerBodyArena, phase: Int): Int {
    return arena.memoryState.update(element: phase, index: compilerBodyMemoryStateCompletedPhase())
}

function compilerBodyMemoryBuildValuePhase(arena: CompilerBodyArena): Int {
    let phase: Int(compilerBodyMemoryPhaseValue())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 0 - 1 }
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolKindColumn()))
        state symbolFactKind: Int(compilerBodyMemoryFactOwnedImmutableValue())
        if symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver() || symbolKind == compilerBodySymbolEnumPayloadBinding() || symbolKind == compilerBodySymbolClosureParameter() { symbolFactKind: compilerBodyMemoryFactBorrowedParameterValue() }
        if symbolKind == compilerBodySymbolState() { symbolFactKind: compilerBodyMemoryFactOwnedMutableValue() }
        let symbolTypeKind: Int(compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: symbolRow))
        if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: symbolFactKind, sourceNodeID: compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolDeclarationColumn()), subjectKind: compilerBodyMemorySubjectSymbol(), subjectID: symbolRow, auxID: symbolTypeKind) < 0 { return 0 - 1 }
        symbolRow: symbolRow + 1
    }
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1))
        state nodeFactKind: Int(0)
        state nodeTypeKind: Int(compilerBodyTypeUnknown())
        if nodeKind == compilerSyntaxKindIntegerLiteral() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeInt()
        }
        if nodeKind == compilerSyntaxKindStringLiteral() || nodeKind == compilerSyntaxKindStringSegment() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeString()
        }
        if nodeKind == compilerSyntaxKindInterpolatedString() {
            nodeFactKind: compilerBodyMemoryFactBinaryValue()
            nodeTypeKind: compilerBodyTypeString()
        }
        if nodeKind == compilerSyntaxKindBoolLiteral() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeBool()
        }
        if nodeKind == compilerSyntaxKindEnumCaseValue() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeEnum()
        }
        if nodeKind == compilerSyntaxKindArrayLiteral() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeConstruct()
        }
        if nodeKind == compilerSyntaxKindIndex() || nodeKind == compilerSyntaxKindMemberRead() {
            nodeFactKind: compilerBodyMemoryFactRead()
            nodeTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeRow)
        }
        if nodeKind == compilerSyntaxKindApplication() { nodeFactKind: compilerBodyMemoryFactCallValue() }
        if nodeKind == compilerSyntaxKindEquality() || nodeKind == compilerSyntaxKindBooleanAnd() || nodeKind == compilerSyntaxKindBooleanOr() || nodeKind == compilerSyntaxKindOptionalCoalescing() {
            nodeFactKind: compilerBodyMemoryFactBinaryValue()
            if nodeKind == compilerSyntaxKindOptionalCoalescing() {
                nodeTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeRow)
            } else {
                nodeTypeKind: compilerBodyTypeBool()
            }
        }
        if nodeKind == compilerSyntaxKindAddition() || nodeKind == compilerSyntaxKindSubtraction() || nodeKind == compilerSyntaxKindMultiplication() || nodeKind == compilerSyntaxKindDivision() || nodeKind == compilerSyntaxKindRemainder()
            || nodeKind == compilerSyntaxKindLessThan() || nodeKind == compilerSyntaxKindLessEqual() || nodeKind == compilerSyntaxKindGreaterThan() || nodeKind == compilerSyntaxKindGreaterEqual()
            || nodeKind == compilerSyntaxKindPrefixNot() || nodeKind == compilerSyntaxKindPrefixNegate() {
            nodeFactKind: compilerBodyMemoryFactBinaryValue()
            nodeTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeRow)
        }
        if nodeFactKind != 0 {
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: nodeFactKind, sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectNode(), subjectID: nodeRow, auxID: nodeTypeKind) < 0 { return 0 - 1 }
        }
        nodeRow: nodeRow + 1
    }
    return compilerBodyMemoryCompletePhase(arena: arena, phase: phase)
}

function compilerBodyStorageAppend(arena: CompilerBodyArena, ownerNodeID: Int, typeID: Int, regionNodeID: Int, placement: Int, mutable: Bool): Int {
    let storageID: Int(compilerIntTableRowCount(table: arena.storages))
    state mutableValue: Int(0)
    if mutable { mutableValue: 1 }
    if compilerIntTableAppend(table: arena.storages, value: storageID) != 0
        || compilerIntTableAppend(table: arena.storages, value: ownerNodeID) != 0
        || compilerIntTableAppend(table: arena.storages, value: typeID) != 0
        || compilerIntTableAppend(table: arena.storages, value: regionNodeID) != 0
        || compilerIntTableAppend(table: arena.storages, value: placement) != 0
        || compilerIntTableAppend(table: arena.storages, value: mutableValue) != 0 { return 0 - 1 }
    return storageID
}

function compilerBodyStorageForSymbol(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStorageOwnerNodeColumn()) == declarationNodeID
            && compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCaller() { return storageRow }
        storageRow: storageRow + 1
    }
    return 0 - 1
}

function compilerBodyStorageForCall(arena: CompilerBodyArena, callNodeID: Int): Int {
    if callNodeID < 0 || callNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: callNodeID, column: 1) != compilerSyntaxKindApplication() { return 0 - 1 }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.storages) {
        let ownerNodeID: Int(compilerIntTableValue(table: arena.storages, row: row, column: compilerBodyStorageOwnerNodeColumn()))
        if ownerNodeID == callNodeID
            && compilerBodyMemoryHasFact(arena: arena, kind: compilerBodyMemoryFactPlacement(), sourceNodeID: callNodeID, subjectID: row) { return row }
        if compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0) == callNodeID { return row }
        row: row + 1
    }
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == callNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleReturnValue() {
            let returnStorageID: Int(compilerBodyCalleeReturnStorage(arena: arena))
            if returnStorageID >= 0
                && compilerBodyArenaExpressionTypeID(arena: arena, nodeID: callNodeID) == compilerIntTableValue(table: arena.storages, row: returnStorageID, column: compilerBodyStorageTypeIDColumn()) { return returnStorageID }
        }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeIDHasNativeNominalLayout(arena: CompilerBodyArena, typeID: Int): Bool {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return false }
    if compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: typeID) { return false }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if nominalSyntaxID == compilerBodyBuiltinArraySyntaxID() { return compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID) == 1 }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: nominalSyntaxID))
    if declarationRow < 0 { return false }
    let declarationKind: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 2))
    if declarationKind == compilerSyntaxKindConstruct() { return compilerNominalLLVMTypeName(tables: arena.tables, declarationRow: declarationRow) != String("") }
    if declarationKind == compilerSyntaxKindEnum() { return compilerEnumLLVMTypeName(tables: arena.tables, declarationRow: declarationRow) != String("") }
    return false
}

function compilerBodyArenaInitializerResolutionNode(arena: CompilerBodyArena, initializerNodeID: Int): Int {
    if initializerNodeID < 0 || initializerNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    if compilerIntTableValue(table: arena.nodes, row: initializerNodeID, column: 1) == compilerSyntaxKindEnumCaseValue()
        || compilerIntTableValue(table: arena.nodes, row: initializerNodeID, column: 1) == compilerSyntaxKindArrayLiteral() { return initializerNodeID }
    return compilerBodyArenaChild(arena: arena, ownerNodeID: initializerNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0)
}

function compilerBodyStorageIsConstructInitialized(arena: CompilerBodyArena, storageID: Int): Bool {
    if storageID < 0 || storageID >= compilerIntTableRowCount(table: arena.storages) { return false }
    let ownerNodeID: Int(compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageOwnerNodeColumn()))
    let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
    let resolutionNodeID: Int(compilerBodyArenaInitializerResolutionNode(arena: arena, initializerNodeID: initializerNodeID))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: resolutionNodeID))
    if ownerNodeID < 0 || initializerNodeID < 0 || resolutionNodeID < 0 || resolutionRow < 0 { return false }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    return targetKind == compilerBodyResolutionConstruct() || targetKind == compilerBodyResolutionEnum() || targetKind == compilerBodyResolutionEnumCase()
}

function compilerBodyArenaReturnOwnerForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == valueNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleReturnValue() { return compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0) }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyMemoryBuildPlacementForSymbol(arena: CompilerBodyArena, symbolID: Int, phase: Int, boundaryPlan: CompilerCallBoundaryPlan): Int {
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if !compilerBodySymbolOwnsLocalStorage(kind: symbolKind) { return 0 }
    let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if declarationNodeID < 0 || declarationNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 }
    let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
    if initializerNodeID < 0 { return 0 }
    let resolutionNodeID: Int(compilerBodyArenaInitializerResolutionNode(arena: arena, initializerNodeID: initializerNodeID))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: resolutionNodeID))
    if resolutionRow < 0 { return 0 }
    let localTypeKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()))
    if localTypeKind != compilerBodyTypeConstruct() && localTypeKind != compilerBodyTypeEnum() { return 0 }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    if targetKind != compilerBodyResolutionConstruct() && targetKind != compilerBodyResolutionEnum() && targetKind != compilerBodyResolutionEnumCase() && targetKind != compilerBodyResolutionFunction() { return 0 }
    let localTypeID: Int(compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolID))
    let callTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
    if localTypeID < 0 || localTypeID != callTypeID { return 0 - 1 }
    if targetKind == compilerBodyResolutionConstruct() || targetKind == compilerBodyResolutionEnum() || targetKind == compilerBodyResolutionEnumCase() {
        if !compilerBodyArenaTypeIDHasNativeNominalLayout(arena: arena, typeID: localTypeID) { return 0 }
    } else if targetKind == compilerBodyResolutionFunction() {
        let targetFunctionID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
        if compilerCallBoundaryReturnMode(plan: boundaryPlan, tables: arena.tables, index: arena.declarationIndex, functionRow: targetFunctionID) != compilerFunctionReturnABIIndirect() { return 0 }
    } else { return 0 }
    let mutable: Bool(symbolKind == compilerBodySymbolState())
    let storageID: Int(compilerBodyStorageAppend(arena: arena, ownerNodeID: declarationNodeID, typeID: localTypeID, regionNodeID: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolRegionColumn()), placement: compilerBodyStorageCaller(), mutable: mutable))
    if storageID < 0
        || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactPlacement(), sourceNodeID: initializerNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: localTypeID) < 0
        || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: initializerNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: callTypeID) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyMemoryBuildPlacementForCall(arena: CompilerBodyArena, callNodeID: Int, phase: Int, boundaryPlan: CompilerCallBoundaryPlan): Int {
    if compilerIntTableValue(table: arena.nodes, row: callNodeID, column: 1) != compilerSyntaxKindApplication() { return 0 }
    if compilerBodyStorageForCall(arena: arena, callNodeID: callNodeID) >= 0 { return 0 }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: callNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
    if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionFunction()
        || (compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) != compilerBodyTypeConstruct()
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) != compilerBodyTypeEnum()) { return 0 }
    let targetFunctionID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if compilerCallBoundaryReturnMode(plan: boundaryPlan, tables: arena.tables, index: arena.declarationIndex, functionRow: targetFunctionID) != compilerFunctionReturnABIIndirect() { return 0 }
    let callTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
    let regionNodeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionRegionColumn()))
    let storageID: Int(compilerBodyStorageAppend(arena: arena, ownerNodeID: callNodeID, typeID: callTypeID, regionNodeID: regionNodeID, placement: compilerBodyStorageCaller(), mutable: false))
    if storageID < 0 { return 0 - 1 }
    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactPlacement(), sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: callTypeID) < 0 { return 0 - 1 }
    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: callTypeID) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyCalleeReturnStorage(arena: CompilerBodyArena): Int {
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCalleeReturn() { return storageRow }
        storageRow: storageRow + 1
    }
    return 0 - 1
}

function compilerBodyMemoryBuildCalleeReturnDestination(arena: CompilerBodyArena, phase: Int, boundaryPlan: CompilerCallBoundaryPlan): Int {
    if compilerBodyArenaOwnerReturnMode(arena: arena, plan: boundaryPlan) != compilerFunctionReturnABIIndirect() { return 0 }
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
    let returnTypeID: Int(compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: compilerBodyArenaReceiverTypeID(arena: arena), ownerSyntaxID: compilerBodyArenaReceiverConstructSyntaxID(arena: arena), fileID: returnFileID, start: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6), end: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7)))
    if returnTypeID < 0 { return 0 - 1 }
    let storageID: Int(compilerBodyStorageAppend(arena: arena, ownerNodeID: arena.rootNodeID, typeID: returnTypeID, regionNodeID: arena.rootNodeID, placement: compilerBodyStorageCalleeReturn(), mutable: true))
    if storageID < 0 || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactReturnDestination(), sourceNodeID: arena.rootNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: returnTypeID) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyMemoryBuildPlacementPhase(arena: CompilerBodyArena, boundaryPlan: CompilerCallBoundaryPlan): Int {
    let phase: Int(compilerBodyMemoryPhasePlacement())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 1 }
    if compilerBodyMemoryBuildCalleeReturnDestination(arena: arena, phase: phase, boundaryPlan: boundaryPlan) != 0 { return 2 }
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        if compilerBodyMemoryBuildPlacementForSymbol(arena: arena, symbolID: symbolRow, phase: phase, boundaryPlan: boundaryPlan) != 0 { return 1000 + symbolRow }
        symbolRow: symbolRow + 1
    }
    state callNodeRow: Int(0)
    while callNodeRow < compilerIntTableRowCount(table: arena.nodes) {
        if compilerBodyMemoryBuildPlacementForCall(arena: arena, callNodeID: callNodeRow, phase: phase, boundaryPlan: boundaryPlan) != 0 { return 2000 + callNodeRow }
        callNodeRow: callNodeRow + 1
    }
    if compilerBodyMemoryCompletePhase(arena: arena, phase: phase) != 0 { return 3 }
    return 0
}

function compilerBodyArenaNodeIsAssignmentTarget(arena: CompilerBodyArena, nodeID: Int): Bool {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == nodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleAssignmentTarget() { return true }
        edgeRow: edgeRow + 1
    }
    return false
}

function compilerBodyMemoryBuildAccessPhase(arena: CompilerBodyArena): Int {
    let phase: Int(compilerBodyMemoryPhaseAccess())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 0 - 1 }
    state resolutionRow: Int(0)
    while resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
        let sourceNodeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionSourceColumn()))
        if targetKind == compilerBodyResolutionLocalSymbol() {
            state accessKind: Int(compilerBodyMemoryFactRead())
            if compilerBodyArenaNodeIsAssignmentTarget(arena: arena, nodeID: sourceNodeID) { accessKind: compilerBodyMemoryFactWriteUnique() }
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: accessKind, sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectSymbol(), subjectID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()), auxID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn())) < 0 { return 0 - 1 }
        }
        if targetKind == compilerBodyResolutionMember() {
            state memberAccessKind: Int(compilerBodyMemoryFactMemberRead())
            if sourceNodeID >= 0 && sourceNodeID < compilerIntTableRowCount(table: arena.nodes)
                && compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 10) == compilerBodyEnumPatternBindingAux() {
                memberAccessKind: compilerBodyMemoryFactEnumPayloadBorrow()
            } else if compilerBodyArenaNodeIsAssignmentTarget(arena: arena, nodeID: sourceNodeID) {
                memberAccessKind: compilerBodyMemoryFactMemberWrite()
            }
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: memberAccessKind, sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: sourceNodeID, auxID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn())) < 0 { return 0 - 1 }
        }
        if targetKind == compilerBodyResolutionOperator()
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()) == compilerSyntaxKindIndex()
            && compilerBodyArenaNodeIsAssignmentTarget(arena: arena, nodeID: sourceNodeID) {
            let mutableArraySymbolID: Int(compilerBodyArenaMutableArraySymbolForTarget(arena: arena, targetNodeID: sourceNodeID))
            if mutableArraySymbolID < 0
                || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactWriteUnique(), sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectSymbol(), subjectID: mutableArraySymbolID, auxID: compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: mutableArraySymbolID)) < 0 { return 0 - 1 }
        }
        resolutionRow: resolutionRow + 1
    }
    return compilerBodyMemoryCompletePhase(arena: arena, phase: phase)
}

function compilerBodyArenaResolutionForSource(arena: CompilerBodyArena, sourceNodeID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: row, column: compilerBodyResolutionSourceColumn()) == sourceNodeID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyMemoryBuildPassEscapePhase(arena: CompilerBodyArena, boundaryPlan: CompilerCallBoundaryPlan): Int {
    let phase: Int(compilerBodyMemoryPhasePassEscape())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 1 }
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1))
        if nodeKind == compilerSyntaxKindApplication() {
            let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleCallee(), ordinal: 0))
            let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
            if resolutionRow < 0 { return 10000 + nodeRow }
            let targetID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            let resolvedTargetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
            let ordinaryMemberFunction: Bool(resolvedTargetKind == compilerBodyResolutionFunction() && compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindMemberRead())
            if resolvedTargetKind == compilerBodyResolutionMemberRuntimeBuiltin() || ordinaryMemberFunction {
                let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
                if receiverNodeID < 0
                    || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactArgumentPass(), sourceNodeID: calleeNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: receiverNodeID, auxID: targetID) < 0 { return 11000 + nodeRow }
            }
            state ordinal: Int(0)
            let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeRow))
            while ordinal < argumentCount {
                let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
                let argumentValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
                if argumentNodeID < 0 || argumentValueNodeID < 0 { return 20000 + nodeRow }
                if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactArgumentPass(), sourceNodeID: argumentNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: argumentValueNodeID, auxID: targetID) < 0 { return 21000 + nodeRow }
                let expectedArgumentTypeID: Int(compilerBodyArenaExpectedApplicationArgumentTypeID(
                    arena: arena,
                    applicationNodeID: nodeRow,
                    argumentNodeID: argumentNodeID
                ))
                let actualArgumentTypeID: Int(compilerBodyArenaExpressionTypeID(
                    arena: arena,
                    nodeID: argumentValueNodeID
                ))
                if arena.ownerKind == compilerBodyArenaOwnerFunction()
                    && expectedArgumentTypeID >= 0
                    && actualArgumentTypeID >= 0
                    && expectedArgumentTypeID != actualArgumentTypeID
                    && compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: expectedArgumentTypeID) == 1
                    && compilerBodyOptionalPayloadMatches(
                        arena: arena,
                        optionalTypeID: expectedArgumentTypeID,
                        payloadTypeID: actualArgumentTypeID
                    )
                    && compilerBodyMemoryAppendFact(
                        arena: arena,
                        phase: phase,
                        kind: compilerBodyMemoryFactOptionalInjection(),
                        sourceNodeID: argumentValueNodeID,
                        subjectKind: compilerBodyMemorySubjectNode(),
                        subjectID: argumentValueNodeID,
                        auxID: expectedArgumentTypeID
                    ) < 0 { return 22000 + nodeRow }
                ordinal: ordinal + 1
            }
            if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction()
                && (compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeConstruct()
                    || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeEnum())
                && compilerCallBoundaryReturnMode(plan: boundaryPlan, tables: arena.tables, index: arena.declarationIndex, functionRow: targetID) == compilerFunctionReturnABIIndirect() {
                let storageID: Int(compilerBodyStorageForCall(arena: arena, callNodeID: nodeRow))
                if storageID < 0 { return 30000 + nodeRow }
                if compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCaller() {
                    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactReturnTransfer(), sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: targetID) < 0 { return 31000 + nodeRow }
                }
            }
        }
        if nodeKind == compilerSyntaxKindReturn() {
            let returnValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
            if returnValueNodeID < 0 { return 40000 + nodeRow }
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactReturnEscape(), sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectNode(), subjectID: returnValueNodeID, auxID: compilerBodyArenaOwnerAuxID(arena: arena)) < 0 { return 41000 + nodeRow }
            let returnStorageID: Int(compilerBodyCalleeReturnStorage(arena: arena))
            if returnStorageID >= 0 {
                let returnTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: returnValueNodeID))
                let destinationTypeID: Int(compilerIntTableValue(table: arena.storages, row: returnStorageID, column: compilerBodyStorageTypeIDColumn()))
                if returnTypeID < 0 { return 42000 + nodeRow }
                if returnTypeID != destinationTypeID {
                    if compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: destinationTypeID) != 1
                        || !compilerBodyOptionalPayloadMatches(arena: arena, optionalTypeID: destinationTypeID, payloadTypeID: returnTypeID) { return 43000 + nodeRow }
                    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactOptionalInjection(), sourceNodeID: returnValueNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: returnValueNodeID, auxID: destinationTypeID) < 0 { return 44000 + nodeRow }
                }
                if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: returnStorageID, auxID: destinationTypeID) < 0 { return 45000 + nodeRow }
            }
        }
        nodeRow: nodeRow + 1
    }
    if compilerBodyMemoryCompletePhase(arena: arena, phase: phase) != 0 { return 50000 }
    return 0
}

function compilerBodyMemoryBuildLifetimePhase(arena: CompilerBodyArena): Int {
    let phase: Int(compilerBodyMemoryPhaseLifetime())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 0 - 1 }
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCaller() {
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactDestruction(), sourceNodeID: compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStorageOwnerNodeColumn()), subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageRow, auxID: compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStorageRegionColumn())) < 0 { return 0 - 1 }
        }
        storageRow: storageRow + 1
    }
    return compilerBodyMemoryCompletePhase(arena: arena, phase: phase)
}

function compilerBodyMemoryFactCountForStorage(arena: CompilerBodyArena, storageID: Int, kind: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectKindColumn()) == compilerBodyMemorySubjectStorage()
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()) == storageID
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()) == kind { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyStorageIsValid(arena: CompilerBodyArena, storageID: Int): Bool {
    if storageID < 0 || storageID >= compilerIntTableRowCount(table: arena.storages) { return false }
    let placement: Int(compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStoragePlacementColumn()))
    return compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageIDColumn()) == storageID
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageOwnerNodeColumn()) >= 0
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageOwnerNodeColumn()) < compilerIntTableRowCount(table: arena.nodes)
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageTypeIDColumn()) >= 0
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageTypeIDColumn()) < compilerIntTableRowCount(table: arena.typeInstances)
        && (placement == compilerBodyStorageCaller() || placement == compilerBodyStorageCalleeReturn())
}

function compilerBodyStorageFactsAreValid(arena: CompilerBodyArena, storageID: Int): Bool {
    if compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCalleeReturn() {
        return compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnDestination()) == 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactInitialize()) >= 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactPlacement()) == 0
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnTransfer()) == 0
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactDestruction()) == 0
    }
    if compilerBodyStorageIsConstructInitialized(arena: arena, storageID: storageID) {
        return compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactPlacement()) == 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactInitialize()) == 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnTransfer()) == 0
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactDestruction()) == 1
    }
    return compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactPlacement()) == 1
        && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactInitialize()) == 1
        && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnTransfer()) == 1
        && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactDestruction()) == 1
}

function compilerBodyAggregateMemoryValidationCode(arena: CompilerBodyArena): Int {
    if !compilerIntTableIsComplete(table: arena.memoryFacts) || !compilerIntTableIsComplete(table: arena.storages)
        || arena.memoryState.element(index: compilerBodyMemoryStateCompletedPhase()) != compilerBodyMemoryPhaseLifetime()
        || arena.memoryState.element(index: compilerBodyMemoryStateValid()) != 1 { return 1 }
    state row: Int(0)
    state priorPhase: Int(compilerBodyMemoryPhaseValue())
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        let phase: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactPhaseColumn()))
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactIDColumn()) != row
            || phase < priorPhase || phase < compilerBodyMemoryPhaseValue() || phase > compilerBodyMemoryPhaseLifetime() { return 2000 + row }
        priorPhase: phase
        row: row + 1
    }
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if !compilerBodyStorageIsValid(arena: arena, storageID: storageRow) { return 3000 + storageRow }
        if !compilerBodyStorageFactsAreValid(arena: arena, storageID: storageRow) { return 4000 + storageRow }
        storageRow: storageRow + 1
    }
    return 0
}

function compilerBodyAggregateMemoryFactsAreValid(arena: CompilerBodyArena): Bool {
    return compilerBodyAggregateMemoryValidationCode(arena: arena) == 0
}

function compilerBodyScalarMemoryFactsAreValid(arena: CompilerBodyArena): Bool {
    if !compilerIntTableIsComplete(table: arena.memoryFacts)
        || arena.memoryState.element(index: compilerBodyMemoryStateCompletedPhase()) != compilerBodyMemoryPhaseLifetime()
        || arena.memoryState.element(index: compilerBodyMemoryStateValid()) != 1 { return false }
    state row: Int(0)
    state priorPhase: Int(compilerBodyMemoryPhaseValue())
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        let phase: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactPhaseColumn()))
        let kind: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()))
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactIDColumn()) != row
            || phase < priorPhase || phase < compilerBodyMemoryPhaseValue() || phase > compilerBodyMemoryPhaseLifetime()
            || kind == compilerBodyMemoryFactPlacement() || kind == compilerBodyMemoryFactDestruction() || kind == compilerBodyMemoryFactReturnTransfer() || kind == compilerBodyMemoryFactInitialize() { return false }
        priorPhase: phase
        row: row + 1
    }
    return true
}

function compilerBodyOwnedSemanticFactsAreValid(arena: CompilerBodyArena): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        let kind: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()))
        if kind == compilerBodyMemoryFactResourceCreate() || kind == compilerBodyMemoryFactMove()
            || kind == compilerBodyMemoryFactBindingAlias() || kind == compilerBodyMemoryFactResourceDestroy() {
            let sourceNodeID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()))
            let subjectPathID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()))
            let auxID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactAuxColumn()))
            if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactPhaseColumn()) != compilerBodyMemoryPhasePassEscape()
                || compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectKindColumn()) != compilerBodyMemorySubjectOwnedPath()
                || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
                || subjectPathID < 0 || subjectPathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return false }
            let subjectPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: subjectPathID, column: compilerBodyOwnedPathPolicyColumn()))
            let subjectTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: subjectPathID, column: compilerBodyOwnedPathTypeColumn()))
            if kind == compilerBodyMemoryFactResourceCreate() {
                if subjectPolicy != compilerBodyOwnedPathPolicyOwned()
                    || !compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: subjectTypeID)
                    || auxID != subjectTypeID { return false }
            }
            if kind == compilerBodyMemoryFactMove() {
                let movePolicyIsValid: Bool(subjectPolicy == compilerBodyOwnedPathPolicyOwned()
                    || (subjectPolicy == compilerBodyOwnedPathPolicyBorrowed()
                        && compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: subjectPathID) == compilerBodyOwnedSummaryRootBoundary()))
                if !movePolicyIsValid
                    || (auxID >= 0 && auxID >= compilerIntTableRowCount(table: arena.ownedPaths)) { return false }
            }
            if kind == compilerBodyMemoryFactBindingAlias() {
                let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: subjectPathID))
                if subjectPolicy != compilerBodyOwnedPathPolicyAlias()
                    || canonicalPathID < 0 || auxID != canonicalPathID
                    || compilerIntTableValue(table: arena.ownedPaths, row: canonicalPathID, column: compilerBodyOwnedPathTypeColumn()) != subjectTypeID { return false }
            }
            if kind == compilerBodyMemoryFactResourceDestroy() {
                if subjectPolicy != compilerBodyOwnedPathPolicyOwned()
                    || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: subjectTypeID) != compilerBodyTypeString()
                    || auxID < 0 || auxID >= compilerIntTableRowCount(table: arena.cfgBlocks) { return false }
            }
        }
        row: row + 1
    }
    return true
}

function compilerBodyOwnedReturnTransfersAreValid(arena: CompilerBodyArena): Bool {
    if !compilerIntTableIsComplete(table: arena.ownedReturnTransfers) { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.ownedReturnTransfers) {
        let returnNodeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferReturnNodeColumn()))
        let returnPathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferReturnPathColumn()))
        let sourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
        let transferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferKindColumn()))
        let sourceTypeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferTypeColumn()))
        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferIDColumn()) != row
            || returnNodeID < 0 || returnNodeID >= compilerIntTableRowCount(table: arena.nodes)
            || compilerIntTableValue(table: arena.nodes, row: returnNodeID, column: 1) != compilerSyntaxKindReturn()
            || returnPathID < 0 - 1
            || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferStorageKeyColumn()) < 0
            || sourceTypeID != compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathTypeColumn())
            || !compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: sourceTypeID) { return false }
        let sourceRootClass: Int(compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: sourcePathID))
        if transferKind == compilerBodyOwnedReturnTransferMove() {
            if sourceRootClass != compilerBodyOwnedSummaryRootLocalCreate()
                || compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned() { return false }
        } else if transferKind == compilerBodyOwnedReturnTransferAlias() {
            if sourceRootClass != compilerBodyOwnedSummaryRootBoundary() { return false }
        } else if transferKind == compilerBodyOwnedReturnTransferForward() {
            if sourceRootClass != compilerBodyOwnedSummaryRootBoundary()
                || compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyBorrowed() { return false }
        } else { return false }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: arena.ownedReturnTransfers, row: priorRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
                && compilerIntTableValue(table: arena.ownedReturnTransfers, row: priorRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == returnPathID { return false }
            priorRow: priorRow + 1
        }
        row: row + 1
    }
    return true
}

function compilerBodyOwnedReturnTransferCountValidationCode(arena: CompilerBodyArena, returnSummaries: CompilerIntTable): Int {
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1) == compilerSyntaxKindReturn() {
            let returnValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
            if returnValueNodeID < 0 { return 100 + nodeRow }
            state expectedTransferCount: Int(0)
            if !compilerBodyArenaValueIsNil(arena: arena, valueNodeID: returnValueNodeID)
                && !compilerBodyArenaValueIsNonOwningStringView(arena: arena, valueNodeID: returnValueNodeID)
                && !compilerBodyArenaValueHasNoTrackedFunctionReturn(arena: arena, valueNodeID: returnValueNodeID, returnSummaries: returnSummaries) {
                let returnValueTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: returnValueNodeID))
                if returnValueTypeKind == compilerBodyTypeConstruct() || returnValueTypeKind == compilerBodyTypeString() {
                    let returnTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: returnValueNodeID))
                    let trackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: returnTypeID))
                    if trackedStatus < 0 { return 200 + nodeRow }
                    if trackedStatus == 1 {
                        let sourceRootPathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: returnValueNodeID))
                        if sourceRootPathID < 0 { return 300 + nodeRow }
                        expectedTransferCount: compilerBodyArenaOwnedPathOpaqueLeafCount(arena: arena, rootPathID: sourceRootPathID)
                        if expectedTransferCount <= 0 { return 400 + nodeRow }
                    }
                }
            }
            let actualTransferCount: Int(compilerBodyOwnedReturnTransferCountForReturnNode(transfers: arena.ownedReturnTransfers, returnNodeID: nodeRow))
            if actualTransferCount != expectedTransferCount { return 1000 + nodeRow * 100 + expectedTransferCount * 10 + actualTransferCount }
        }
        nodeRow: nodeRow + 1
    }
    return 0
}

function compilerBodyOwnedReturnTransferContractValidationCode(arena: CompilerBodyArena, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable): Int {
    if !compilerBodyOwnedReturnTransfersAreValid(arena: arena) { return 1 }
    let countValidationCode: Int(compilerBodyOwnedReturnTransferCountValidationCode(arena: arena, returnSummaries: returnSummaries))
    if countValidationCode != 0 { return countValidationCode }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.ownedReturnTransfers) {
        let sourceTypeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferTypeColumn()))
        let storageKeyID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferStorageKeyColumn()))
        if !compilerBodyFunctionInstanceEffectPathIsValid(paths: effectPaths, pathID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferReturnPathColumn())) { return 100 + row * 10 }
        if storageKeyID != compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: sourceTypeID) { return 101 + row * 10 }
        row: row + 1
    }
    return 0
}

function compilerBodyOwnedReturnTransferContractsAreValid(arena: CompilerBodyArena, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable): Bool {
    return compilerBodyOwnedReturnTransferContractValidationCode(arena: arena, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, effectPaths: effectPaths, returnSummaries: returnSummaries) == 0
}

function compilerBodyMemoryFactsAreValid(arena: CompilerBodyArena): Bool {
    if !compilerBodyArenaBindingAliasesAreValid(arena: arena)
        || !compilerBodyOwnedSemanticFactsAreValid(arena: arena)
        || !compilerBodyOwnedReturnTransfersAreValid(arena: arena) { return false }
    if compilerIntTableRowCount(table: arena.storages) == 0 { return compilerBodyScalarMemoryFactsAreValid(arena: arena) }
    return compilerBodyAggregateMemoryFactsAreValid(arena: arena)
}

function compilerBodyMemoryDerive(arena: CompilerBodyArena, boundaryPlan: CompilerCallBoundaryPlan, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effects: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable, returnLeaves: CompilerIntTable, applyInstanceEffects: Bool, recordOwnedFacts: Bool): Int {
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.ownedPaths")
    let ownedPathBuildStatus: Int(compilerBodyArenaBuildOwnedPathTables(arena: arena))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.ownedPaths")
    if ownedPathBuildStatus != 0 { return 8000 + (0 - ownedPathBuildStatus) }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.returnedAliasTopology")
    let preparation: CompilerOwnedPathPreparation(compilerBodyArenaPrepareOwnedPaths(arena: arena, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, returnLeaves: returnLeaves, effectPaths: effectPaths, applyInstanceEffects: applyInstanceEffects))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.returnedAliasTopology")
    if preparation.status != 0 { return 8050 }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.bindingAlias")
    let bindingAliasTopologyStatus: Int(compilerBodyArenaBindingAliasValidationCode(arena: arena))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.bindingAlias")
    if bindingAliasTopologyStatus != 0 { return 9000 + bindingAliasTopologyStatus }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.value")
    let valueStatus: Int(compilerBodyMemoryBuildValuePhase(arena: arena))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.value")
    if valueStatus != 0 { return 1 }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.placement")
    let placementStatus: Int(compilerBodyMemoryBuildPlacementPhase(arena: arena, boundaryPlan: boundaryPlan))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.placement")
    if placementStatus != 0 { return 2000 + placementStatus }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.access")
    let accessStatus: Int(compilerBodyMemoryBuildAccessPhase(arena: arena))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.access")
    if accessStatus != 0 { return 3 }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.passEscape")
    let passEscapeStatus: Int(compilerBodyMemoryBuildPassEscapePhase(arena: arena, boundaryPlan: boundaryPlan))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.passEscape")
    if passEscapeStatus != 0 { return 4000 + passEscapeStatus }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.ownedValidation")
    let ownedPathValidationStatus: Int(compilerBodyArenaValidateOwnedPaths(arena: arena, preparation: preparation, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, effects: effects, effectPaths: effectPaths, returnSummaries: returnSummaries, returnLeaves: returnLeaves, applyInstanceEffects: applyInstanceEffects, recordFacts: recordOwnedFacts))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.ownedValidation")
    if ownedPathValidationStatus != 0 { return 8100 + (0 - ownedPathValidationStatus) }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.returnContract")
    let returnContractValidationCode: Int(compilerBodyOwnedReturnTransferContractValidationCode(arena: arena, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, effectPaths: effectPaths, returnSummaries: returnSummaries))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.returnContract")
    if returnContractValidationCode != 0 { return 8200 + returnContractValidationCode }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.lifetime")
    let lifetimeStatus: Int(compilerBodyMemoryBuildLifetimePhase(arena: arena))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.lifetime")
    if lifetimeStatus != 0 { return 5 }
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.begin.finalValidation")
    let bindingAliasFinalStatus: Int(compilerBodyArenaBindingAliasValidationCode(arena: arena))
    let factsValid: Bool(compilerBodyMemoryFactsAreValid(arena: arena))
    compilerMetricsFunctionBegin(functionID: -1, name: "memoryStage.end.finalValidation")
    if bindingAliasFinalStatus != 0 { return 9000 + bindingAliasFinalStatus }
    if !factsValid { return 6 }
    if arena.memoryState.update(element: 1, index: compilerBodyMemoryStateDerived()) != 0 { return 7 }
    return 0
}

function compilerBodyMemoryIsDerivedAndValid(arena: CompilerBodyArena): Bool {
    return arena.memoryState.element(index: compilerBodyMemoryStateDerived()) == 1
        && compilerBodyMemoryFactsAreValid(arena: arena)
}

function compilerBodyMIRAppendValue(arena: CompilerBodyArena, kind: Int, typeKind: Int, typeID: Int, sourceNodeID: Int, provenanceKind: Int, provenanceID: Int): Int {
    let valueID: Int(compilerIntTableRowCount(table: arena.mirValues))
    if compilerIntTableAppend(table: arena.mirValues, value: valueID) != 0
        || compilerIntTableAppend(table: arena.mirValues, value: kind) != 0
        || compilerIntTableAppend(table: arena.mirValues, value: typeKind) != 0
        || compilerIntTableAppend(table: arena.mirValues, value: sourceNodeID) != 0
        || compilerIntTableAppend(table: arena.mirValues, value: provenanceKind) != 0
        || compilerIntTableAppend(table: arena.mirValues, value: provenanceID) != 0
        || compilerIntTableAppend(table: arena.mirValues, value: typeID) != 0 { return 0 - 1 }
    return valueID
}

function compilerBodyMIRAppendOperand(arena: CompilerBodyArena, operationID: Int, ordinal: Int, valueID: Int, role: Int): Int {
    if arena.graphZeroState.element(index: compilerBodyGraphZeroStateComplete()) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperands, value: operationID) != 0
        || compilerIntTableAppend(table: arena.mirOperands, value: ordinal) != 0
        || compilerIntTableAppend(table: arena.mirOperands, value: valueID) != 0
        || compilerIntTableAppend(table: arena.mirOperands, value: role) != 0 { return 0 - 1 }
    let producer: Int(compilerBodyMIRValueProducerOperationAny(arena: arena, valueID: valueID))
    if producer == 0 - 2 { return 0 - 1 }
    if producer >= 0 {
        let dependencyID: Int(compilerIntTableRowCount(table: arena.graphZeroMIRDependencies))
        state dependencyKind: Int(compilerBodyGraphZeroMIRDependencyData())
        if producer >= operationID { dependencyKind: compilerBodyGraphZeroMIRDependencyLoopCarried() }
        if compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: dependencyID) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: producer) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: operationID) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: valueID) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: dependencyKind) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: ordinal) != 0 { return 0 - 1 }
    }
    return 0
}

function compilerBodyMIROperationOperandValue(arena: CompilerBodyArena, operationID: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirOperands) {
        if compilerIntTableValue(table: arena.mirOperands, row: row, column: compilerBodyMIROperandOperationColumn()) == operationID
            && compilerIntTableValue(table: arena.mirOperands, row: row, column: compilerBodyMIROperandOrdinalColumn()) == ordinal {
            return compilerIntTableValue(table: arena.mirOperands, row: row, column: compilerBodyMIROperandValueColumn())
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyMIRValueProducerOperation(arena: CompilerBodyArena, valueID: Int, operationKind: Int): Int {
    state producerOperationID: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: row, column: compilerBodyMIROperationResultColumn()) == valueID
            && compilerIntTableValue(table: arena.mirOperations, row: row, column: compilerBodyMIROperationKindColumn()) == operationKind {
            if producerOperationID >= 0 { return 0 - 2 }
            producerOperationID: row
        }
        row: row + 1
    }
    return producerOperationID
}

function compilerBodyMIRValueIsProducedBy(arena: CompilerBodyArena, valueID: Int, operationKind: Int): Bool {
    return compilerBodyMIRValueProducerOperation(arena: arena, valueID: valueID, operationKind: operationKind) >= 0
}

function compilerBodyMIROperationIsOwnershipOrEffectBarrier(kind: Int): Bool {
    return kind == compilerBodyMIROperationAssignVersion()
        || kind == compilerBodyMIROperationMemberRead()
        || kind == compilerBodyMIROperationConstruct()
        || kind == compilerBodyMIROperationOptionalSome()
        || kind == compilerBodyMIROperationOptionalPayload()
        || kind == compilerBodyMIROperationStringConcat()
        || kind == compilerBodyMIROperationStringOwnedCopy()
        || kind == compilerBodyMIROperationStringAppendOwned()
        || kind == compilerBodyMIROperationStringFromInt()
        || kind == compilerBodyMIROperationStringFromBool()
        || kind == compilerBodyMIROperationMemberAssign()
        || kind == compilerBodyMIROperationEnumConstruct()
        || kind == compilerBodyMIROperationEnumPayload()
        || kind == compilerBodyMIROperationArrayLiteral()
        || kind == compilerBodyMIROperationArrayIndex()
        || kind == compilerBodyMIROperationArrayCount()
        || kind == compilerBodyMIROperationArrayStore()
}

function compilerBodyGraphZeroSourceHasOwnershipOrEffectBarrier(arena: CompilerBodyArena, sourceNodeID: Int): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()) == sourceNodeID {
            let kind: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()))
            if kind == compilerBodyMemoryFactWriteUnique()
                || kind == compilerBodyMemoryFactMemberWrite()
                || kind == compilerBodyMemoryFactMove()
                || kind == compilerBodyMemoryFactSharedBorrow()
                || kind == compilerBodyMemoryFactUniqueBorrow()
                || kind == compilerBodyMemoryFactConsume()
                || kind == compilerBodyMemoryFactResourceDestroy()
                || kind == compilerBodyMemoryFactDestruction() { return true }
        }
        row: row + 1
    }
    return false
}

function compilerBodyMIROperationRequiresOrder(arena: CompilerBodyArena, kind: Int, sourceNodeID: Int): Bool {
    return compilerBodyMIROperationIsOwnershipOrEffectBarrier(kind: kind)
        || compilerBodyGraphZeroSourceHasOwnershipOrEffectBarrier(arena: arena, sourceNodeID: sourceNodeID)
        || kind == compilerBodyMIROperationCondBranch()
        || kind == compilerBodyMIROperationBranch()
        || kind == compilerBodyMIROperationReturn()
        || kind == compilerBodyMIROperationPhi()
}

function compilerBodyMIRValueProducerOperationAny(arena: CompilerBodyArena, valueID: Int): Int {
    state producer: Int(0 - 1)
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()) == valueID {
            if producer >= 0 { return 0 - 2 }
            producer: operationRow
        }
        operationRow: operationRow + 1
    }
    return producer
}

function compilerBodyMIRAppendOperation(arena: CompilerBodyArena, blockID: Int, kind: Int, resultValueID: Int, sourceNodeID: Int, firstOperand: Int, operandCount: Int, targetKind: Int, targetID: Int): Int {
    if arena.graphZeroState.element(index: compilerBodyGraphZeroStateComplete()) != 0 { return 0 - 1 }
    let operationID: Int(compilerIntTableRowCount(table: arena.mirOperations))
    state storageID: Int(0 - 1)
    if kind == compilerBodyMIROperationDirectCall() && targetKind == compilerBodyMIROperationTargetFunction() {
        storageID: compilerBodyStorageForCall(arena: arena, callNodeID: sourceNodeID)
    }
    if kind == compilerBodyMIROperationLocalValue() { storageID: compilerBodyStorageForSymbol(arena: arena, symbolID: targetID) }
    if kind == compilerBodyMIROperationReturn() { storageID: compilerBodyCalleeReturnStorage(arena: arena) }
    if compilerIntTableAppend(table: arena.mirOperations, value: operationID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: blockID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: kind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: resultValueID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: sourceNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: firstOperand) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: operandCount) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: targetKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: targetID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: storageID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: 0 - 1) != 0 { return 0 - 1 }
    if compilerBodyMIROperationRequiresOrder(arena: arena, kind: kind, sourceNodeID: sourceNodeID) {
        state priorOperation: Int(operationID - 1)
        state orderProducer: Int(0 - 1)
        while priorOperation >= 0 && orderProducer < 0 {
            if compilerIntTableValue(table: arena.mirOperations, row: priorOperation, column: compilerBodyMIROperationBlockColumn()) == blockID
                && compilerBodyMIROperationRequiresOrder(arena: arena, kind: compilerIntTableValue(table: arena.mirOperations, row: priorOperation, column: compilerBodyMIROperationKindColumn()), sourceNodeID: compilerIntTableValue(table: arena.mirOperations, row: priorOperation, column: compilerBodyMIROperationSourceColumn())) { orderProducer: priorOperation }
            priorOperation: priorOperation - 1
        }
        if orderProducer >= 0 {
            let dependencyID: Int(compilerIntTableRowCount(table: arena.graphZeroMIRDependencies))
            if compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: dependencyID) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: orderProducer) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: operationID) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: 0 - 1) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: compilerBodyGraphZeroMIRDependencyOrder()) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: 0) != 0 { return 0 - 1 }
        }
    }
    return operationID
}

function compilerBodyMIRSetOperationInstanceID(arena: CompilerBodyArena, operationID: Int, instanceID: Int): Int {
    if operationID < 0 || operationID >= compilerIntTableRowCount(table: arena.mirOperations) { return 0 - 1 }
    return arena.mirOperations.values.update(element: instanceID, index: operationID * compilerBodyMIROperationColumnCount() + compilerBodyMIROperationInstanceIDColumn())
}

function compilerBodyMIRAppendVersion(arena: CompilerBodyArena, symbolID: Int, blockID: Int, valueID: Int): Int {
    state ordinal: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirVersions) {
        if compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionSymbolColumn()) == symbolID
            && compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionBlockColumn()) == blockID { ordinal: ordinal + 1 }
        row: row + 1
    }
    if compilerIntTableAppend(table: arena.mirVersions, value: symbolID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirVersions, value: blockID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirVersions, value: valueID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirVersions, value: ordinal) != 0 { return 0 - 1 }
    return ordinal
}

function compilerBodyMIRExpressionValue(arena: CompilerBodyArena, nodeID: Int, action: Int): Int {
