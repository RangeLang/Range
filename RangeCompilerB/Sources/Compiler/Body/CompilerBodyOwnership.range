    let scheduleProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationScheduleIndex(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: 0 - 1, nodeID: arena.rootNodeID, ordinal: 0, itemCount: compilerIntTableRowCount(table: arena.cfgSchedule)))
    state scheduleStatus: Int(0)
    if status == 0 { scheduleStatus: compilerBodyArenaCFGScheduleBuildBlockIndex(arena: arena, blockStarts: scheduleStarts, blockCounts: scheduleCounts, scheduleRows: scheduleRows) }
