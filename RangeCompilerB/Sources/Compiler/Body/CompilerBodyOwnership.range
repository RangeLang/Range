function compilerBodyArenaOwnedPathBuildEdgeProjection(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, sourceBlockID: Int, targetBlockID: Int, pathRoots: Buffer<Int>, canonicalPaths: Buffer<Int>, projection: Buffer<Int>, pathCount: Int): Int {
