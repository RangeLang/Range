                        let referenceProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationReferenceCheck(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: nodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
