function compilerBodyArenaOwnedPathExpireEvaluationTemporaries(arena: CompilerBodyArena, blockID: Int, states: Buffer<Int>, origins: Buffer<Int>, pathRoots: Buffer<Int>, canonicalPaths: Buffer<Int>, evaluationProducers: Buffer<Int>, projection: Buffer<Int>, returnSummaries: CompilerIntTable, recordFacts: Bool): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    if pathRoots.count != pathCount || canonicalPaths.count != pathCount
