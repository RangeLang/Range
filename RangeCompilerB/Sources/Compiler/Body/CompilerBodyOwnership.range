                    let statementKind: Int(compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 1))
                    if statementKind == compilerSyntaxKindLocalBinding() {
                        let localBindingProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationLocalBinding(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: statementNodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
                        let bindingStatus: Int(compilerBodyArenaOwnedPathApplyLocalBindingMove(arena: arena, statementNodeID: statementNodeID, states: states, origins: origins, effectPaths: effectPaths, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, recordFacts: recordFacts))
                        compilerProbeEnd(probe: localBindingProbe, status: bindingStatus, resultCount: statementKind)
                        if bindingStatus != 0 {
                            status: 0 - (300000000
                                + compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 4) * 100
                                + (0 - bindingStatus))
                        }
                    }
                    if status == 0 && statementKind == compilerSyntaxKindAssignment() {
                        let assignmentProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationAssignment(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: statementNodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
                        let assignmentStatus: Int(compilerBodyArenaOwnedPathApplyAssignmentMove(arena: arena, statementNodeID: statementNodeID, states: states, origins: origins, effectPaths: effectPaths, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, recordFacts: recordFacts))
                        compilerProbeEnd(probe: assignmentProbe, status: assignmentStatus, resultCount: statementKind)
                        if assignmentStatus != 0 {
                            status: 0 - (320000000
                                + compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 4) * 100
                                + (0 - assignmentStatus))
                        }
                    }
                    if status == 0 && statementKind == compilerSyntaxKindReturn() {
                        let returnExitProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationReturnExit(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: statementNodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
                        let returnExitStatus: Int(compilerBodyArenaOwnedPathApplyReturnExit(arena: arena, returnNodeID: statementNodeID, states: states, origins: origins, effectPaths: effectPaths, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, recordFacts: recordFacts))
                        compilerProbeEnd(probe: returnExitProbe, status: returnExitStatus, resultCount: statementKind)
                        if returnExitStatus != 0 { status: 0 - 32 }
