                                let runtimeContractProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationRuntimeContract(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: nodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
