}

function compilerBodyMIRAppendExpressionValue(arena: CompilerBodyArena, nodeID: Int, action: Int, valueID: Int, blockID: Int): Int {
    if compilerBodyMIRExpressionValue(arena: arena, nodeID: nodeID, action: action) >= 0 { return 0 - 1 }
    let row: Int(compilerIntTableRowCount(table: arena.mirExpressionValues))
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: nodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: action) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: valueID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: blockID) != 0 { return 0 - 1 }
    return row
}

function compilerBodyMIRLatestVersionInBlock(arena: CompilerBodyArena, symbolID: Int, blockID: Int): Int {
    state result: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirVersions) {
        if compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionSymbolColumn()) == symbolID
            && compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionBlockColumn()) == blockID { result: compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionValueColumn()) }
        row: row + 1
    }
    return result
}

function compilerBodyMIRUniqueVersionForSymbol(arena: CompilerBodyArena, symbolID: Int): Int {
    state valueID: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirVersions) {
        if compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionSymbolColumn()) == symbolID {
            if valueID >= 0 { return 0 - 2 }
            valueID: compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionValueColumn())
        }
        row: row + 1
    }
    return valueID
}

function compilerBodyMIRValueForSymbolAtBlockMemo(arena: CompilerBodyArena, symbolID: Int, blockID: Int, memo: Buffer<Int>): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: arena.cfgBlocks) { return 0 - 1 }
    let memoizedValueID: Int(memo.element(index: blockID))
    if memoizedValueID == 0 - 3 { return 0 - 1 }
    if memoizedValueID != 0 - 2 { return memoizedValueID }
    if memo.update(element: 0 - 3, index: blockID) != 0 { return 0 - 1 }
    let localValueID: Int(compilerBodyMIRLatestVersionInBlock(arena: arena, symbolID: symbolID, blockID: blockID))
    if localValueID >= 0 {
        memo.update(element: localValueID, index: blockID)
        return localValueID
    }
    state inheritedValueID: Int(0 - 1)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
            && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) != compilerBodyCFGEdgeBackedge() {
            let predecessorID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()))
            let predecessorValueID: Int(compilerBodyMIRValueForSymbolAtBlockMemo(arena: arena, symbolID: symbolID, blockID: predecessorID, memo: memo))
            if predecessorValueID < 0 {
                memo.update(element: 0 - 1, index: blockID)
                return 0 - 1
            }
            if inheritedValueID >= 0 && inheritedValueID != predecessorValueID {
                memo.update(element: 0 - 1, index: blockID)
                return 0 - 1
            }
            inheritedValueID: predecessorValueID
        }
        edgeRow: edgeRow + 1
    }
    memo.update(element: inheritedValueID, index: blockID)
    return inheritedValueID
}

function compilerBodyMIRValueForSymbolAtBlock(arena: CompilerBodyArena, symbolID: Int, blockID: Int): Int {
    let memo: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.cfgBlocks)))
    while memo.count < compilerIntTableRowCount(table: arena.cfgBlocks) { memo.append(element: 0 - 2) }
    let valueID: Int(compilerBodyMIRValueForSymbolAtBlockMemo(arena: arena, symbolID: symbolID, blockID: blockID, memo: memo))
    memo.destroy()
    return valueID
}

function compilerBodyMemoryHasFact(arena: CompilerBodyArena, kind: Int, sourceNodeID: Int, subjectID: Int): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()) == kind
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()) == sourceNodeID
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()) == subjectID { return true }
        row: row + 1
    }
    return false
}

function compilerBodyArenaTypeIDIsOpaqueStorage(arena: CompilerBodyArena, typeID: Int): Bool {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return false }
    let typeKind: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()))
    if typeKind == compilerBodyTypeString() {
        return compilerBodyArenaStringDeclarationSyntaxID(arena: arena) < 0
    }
    if typeKind != compilerBodyTypeConstruct() { return false }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    return nominalSyntaxID >= 0 && compilerRuntimeABIConstructKind(tables: arena.tables, constructNodeID: nominalSyntaxID) == compilerRuntimeABIOpaqueStorage()
}

function compilerBodyArenaStorageCacheEnsure(cache: Buffer<Int>, typeID: Int, unknown: Int): Int {
    if typeID < 0 { return 0 - 1 }
    while cache.count <= typeID {
        if cache.append(element: unknown) != 0 { return 0 - 1 }
    }
    return 0
}

function compilerBodyArenaTransparentStorageBaseTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if compilerBodyArenaStorageCacheEnsure(cache: arena.transparentStorageBaseTypeIDs, typeID: typeID, unknown: 0 - 2) != 0 { return 0 - 1 }
    let cachedBaseTypeID: Int(arena.transparentStorageBaseTypeIDs.element(index: typeID))
    if cachedBaseTypeID != 0 - 2 { return cachedBaseTypeID }
    state currentTypeID: Int(typeID)
    state depth: Int(0)
    let maximumDepth: Int(compilerIntTableRowCount(table: arena.typeInstances) + 1)
    while depth < maximumDepth
        && currentTypeID >= 0
        && currentTypeID < compilerIntTableRowCount(table: arena.typeInstances)
        && (compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: currentTypeID) == compilerBodyTypeConstruct()
            || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: currentTypeID) == compilerBodyTypeString()) {
        let transparentMemberRow: Int(compilerBodyArenaTransparentStorageMemberRowForType(arena: arena, typeKind: compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: currentTypeID), typeID: currentTypeID))
        if transparentMemberRow < 0 {
            if arena.transparentStorageBaseTypeIDs.update(element: currentTypeID, index: typeID) != 0 { return 0 - 1 }
            return currentTypeID
        }
        let nextTypeID: Int(compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: currentTypeID, memberRow: transparentMemberRow))
        if nextTypeID < 0 || nextTypeID == currentTypeID { return 0 - 1 }
        currentTypeID: nextTypeID
        depth: depth + 1
    }
    if depth >= maximumDepth { currentTypeID: 0 - 1 }
    if arena.transparentStorageBaseTypeIDs.update(element: currentTypeID, index: typeID) != 0 { return 0 - 1 }
    return currentTypeID
}

function compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: CompilerBodyArena, typeID: Int): Bool {
    if compilerBodyArenaStorageCacheEnsure(cache: arena.opaqueStorageRepresentationStatuses, typeID: typeID, unknown: 0 - 1) != 0 { return false }
    let cachedStatus: Int(arena.opaqueStorageRepresentationStatuses.element(index: typeID))
    if cachedStatus >= 0 { return cachedStatus == 1 }
    let baseTypeID: Int(compilerBodyArenaTransparentStorageBaseTypeID(arena: arena, typeID: typeID))
    let hasOpaqueStorage: Bool(baseTypeID >= 0 && compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: baseTypeID))
    state status: Int(0)
    if hasOpaqueStorage { status: 1 }
    if arena.opaqueStorageRepresentationStatuses.update(element: status, index: typeID) != 0 { return false }
    return hasOpaqueStorage
}

function compilerBodyArenaStorageRepresentationsMatch(arena: CompilerBodyArena, leftTypeID: Int, rightTypeID: Int, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable): Bool {
    let leftBaseTypeID: Int(compilerBodyArenaTransparentStorageBaseTypeID(arena: arena, typeID: leftTypeID))
    let rightBaseTypeID: Int(compilerBodyArenaTransparentStorageBaseTypeID(arena: arena, typeID: rightTypeID))
    if leftBaseTypeID < 0 || rightBaseTypeID < 0 { return false }
    let leftKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: leftBaseTypeID))
    let rightKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: rightBaseTypeID))
    return leftKeyID >= 0 && leftKeyID == rightKeyID
}

function compilerBodyArenaOwnedFieldTypeID(arena: CompilerBodyArena, receiverTypeID: Int, memberRow: Int): Int {
    if receiverTypeID < 0 || receiverTypeID >= compilerIntTableRowCount(table: arena.typeInstances)
        || memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    let receiverSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: receiverTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    let memberOwnerSyntaxID: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2))
    let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
    if receiverSyntaxID < 0 || receiverSyntaxID != memberOwnerSyntaxID
        || (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState()) { return 0 - 1 }
    return compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: receiverTypeID, memberRow: memberRow)
}

function compilerBodyArenaRuntimeBuiltinRoleForApplication(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionRuntimeBuiltin()
        || compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindIdentifier() { return compilerRuntimeABIFunctionNone() }
    let runtimeBuiltinID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    let functionName: String(compilerBodyRuntimeBuiltinName(id: runtimeBuiltinID))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: functionName, kindTag: compilerSyntaxKindFunction()))
    if declarationRow < 0 { return compilerRuntimeABIFunctionNone() }
    let functionSyntaxID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0))
    return compilerRuntimeABIFunctionRole(tables: arena.tables, functionNodeID: functionSyntaxID)
}

function compilerBodyArenaSymbolForDeclaration(arena: CompilerBodyArena, declarationNodeID: Int): Int {
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        if compilerBodySymbolOwnsLocalStorage(kind: compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolKindColumn()))
            && compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolDeclarationColumn()) == declarationNodeID { return symbolRow }
        symbolRow: symbolRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaParameterOrdinalForSymbol(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolParameter() { return 0 - 1 }
    let parameterRow: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: arena.tables.parameters) { return 0 - 1 }
    return compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 3)
}

function compilerBodyArenaValueCarriesBindingReference(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    state currentNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        let currentKind: Int(compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1))
        if currentKind == compilerSyntaxKindBindingReference() { return true }
        state nextNodeID: Int(0 - 1)
        if currentKind == compilerSyntaxKindGrouping() {
            nextNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0)
        } else if currentKind == compilerSyntaxKindMemberRead() {
            nextNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
        } else {
            return false
        }
        if nextNodeID < 0 || nextNodeID >= compilerIntTableRowCount(table: arena.nodes) || nextNodeID == currentNodeID { return false }
        currentNodeID: nextNodeID
        step: step + 1
    }
    return false
}

function compilerBodyArenaValueLocalSymbolID(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let valueKind: Int(compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1))
    if valueKind == compilerSyntaxKindGrouping() {
        return compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
    }
    if valueKind != compilerSyntaxKindIdentifier() && valueKind != compilerSyntaxKindBindingReference() { return 0 - 1 }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: valueNodeID))
    if resolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn())
}

function compilerBodyArenaMemberReceiverSymbolForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: valueNodeID))
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    let receiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: receiverNodeID))
    if memberResolutionRow < 0 || receiverNodeID < 0 || receiverResolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember()
        || compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTargetIDColumn())
}

function compilerBodyArenaMemberRowForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: valueNodeID))
    if memberResolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetIDColumn())
}

function compilerBodyArenaFirstArgumentValue(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
    if argumentNodeID < 0 { return 0 - 1 }
    return compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0)
}

function compilerBodyOwnedPathFind(paths: CompilerIntTable, rootKind: Int, rootID: Int, memberRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: paths) {
        if compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathRootKindColumn()) == rootKind
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathRootIDColumn()) == rootID
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathParentColumn()) == 0 - 1
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathMemberColumn()) == memberRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyOwnedPathFindChild(paths: CompilerIntTable, parentPathID: Int, memberRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: paths) {
        if compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathParentColumn()) == parentPathID
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathMemberColumn()) == memberRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyOwnedPathAppend(paths: CompilerIntTable, rootKind: Int, rootID: Int, parentPathID: Int, memberRow: Int, typeID: Int, policy: Int): Int {
    let pathID: Int(compilerIntTableRowCount(table: paths))
    if parentPathID < 0 {
        if compilerBodyOwnedPathFind(paths: paths, rootKind: rootKind, rootID: rootID, memberRow: memberRow) >= 0 { return 0 - 1 }
    } else if compilerBodyOwnedPathFindChild(paths: paths, parentPathID: parentPathID, memberRow: memberRow) >= 0 {
        return 0 - 1
    }
    if compilerIntTableAppend(table: paths, value: pathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: rootKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: rootID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: parentPathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: memberRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: typeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: policy) != 0 { return 0 - 1 }
    return pathID
}

function compilerBodyBindingAliasFind(aliases: CompilerIntTable, destinationPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: aliases) {
        if compilerIntTableValue(table: aliases, row: row, column: compilerBodyBindingAliasDestinationPathColumn()) == destinationPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaBindingAliasCanonicalPath(arena: CompilerBodyArena, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    state currentPathID: Int(pathID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.bindingAliases) + 1)
    while step < maximumSteps {
        let aliasRow: Int(compilerBodyBindingAliasFind(aliases: arena.bindingAliases, destinationPathID: currentPathID))
        if aliasRow < 0 { return currentPathID }
        let sourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: aliasRow, column: compilerBodyBindingAliasSourcePathColumn()))
        if sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths) || sourcePathID == currentPathID { return 0 - 1 }
        currentPathID: sourcePathID
        step: step + 1
    }
    return 0 - 1
}

function compilerBodyArenaOwnedPathStorageID(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 { return 0 - 1 }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
    let rootID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if rootKind == compilerBodyOwnedPathRootSymbol() { return compilerBodyStorageForSymbol(arena: arena, symbolID: rootID) }
    if rootKind == compilerBodyOwnedPathRootEvaluation() { return compilerBodyStorageForCall(arena: arena, callNodeID: rootID) }
    return 0 - 1
}

function compilerBodyBindingAliasAppendWithProvenance(arena: CompilerBodyArena, destinationPathID: Int, sourcePathID: Int, sourceNodeID: Int, provenanceKind: Int): Int {
    if destinationPathID < 0 || destinationPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || (provenanceKind != compilerBodyBindingAliasProvenanceExplicit()
            && provenanceKind != compilerBodyBindingAliasProvenanceReturnedCall()
            && provenanceKind != compilerBodyBindingAliasProvenanceNestedCarrier())
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyAlias() { return 0 - 1 }
    let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
    if canonicalSourcePathID < 0 || canonicalSourcePathID == destinationPathID
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: canonicalSourcePathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
    let sourceStorageID: Int(compilerBodyArenaOwnedPathStorageID(arena: arena, pathID: canonicalSourcePathID))
    let existingRow: Int(compilerBodyBindingAliasFind(aliases: arena.bindingAliases, destinationPathID: destinationPathID))
    if existingRow >= 0 {
        let existingSourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: existingRow, column: compilerBodyBindingAliasSourcePathColumn()))
        let canonicalExistingSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: existingSourcePathID))
        if canonicalExistingSourcePathID < 0 || canonicalExistingSourcePathID != canonicalSourcePathID
            || compilerIntTableValue(table: arena.bindingAliases, row: existingRow, column: compilerBodyBindingAliasSourceNodeColumn()) != sourceNodeID
            || compilerIntTableValue(table: arena.bindingAliases, row: existingRow, column: compilerBodyBindingAliasProvenanceColumn()) != provenanceKind { return 0 - 1 }
        if arena.bindingAliases.values.update(element: canonicalSourcePathID, index: existingRow * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourcePathColumn()) != 0
            || arena.bindingAliases.values.update(element: sourceStorageID, index: existingRow * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourceStorageColumn()) != 0 { return 0 - 1 }
        return existingRow
    }
    let aliasID: Int(compilerIntTableRowCount(table: arena.bindingAliases))
    if compilerIntTableAppend(table: arena.bindingAliases, value: aliasID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: destinationPathID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: canonicalSourcePathID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: sourceStorageID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: sourceNodeID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: provenanceKind) != 0 { return 0 - 1 }
    return aliasID
}

function compilerBodyBindingAliasAppend(arena: CompilerBodyArena, destinationPathID: Int, sourcePathID: Int, sourceNodeID: Int): Int {
    return compilerBodyBindingAliasAppendWithProvenance(arena: arena, destinationPathID: destinationPathID, sourcePathID: sourcePathID, sourceNodeID: sourceNodeID, provenanceKind: compilerBodyBindingAliasProvenanceExplicit())
}

function compilerBodyArenaBindingAliasNormalize(arena: CompilerBodyArena): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.bindingAliases) {
        let destinationPathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasDestinationPathColumn()))
        let sourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourcePathColumn()))
        let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
        if destinationPathID < 0 || destinationPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || canonicalSourcePathID < 0 || canonicalSourcePathID == destinationPathID
            || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: canonicalSourcePathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
        let sourceStorageID: Int(compilerBodyArenaOwnedPathStorageID(arena: arena, pathID: canonicalSourcePathID))
        if arena.bindingAliases.values.update(element: canonicalSourcePathID, index: row * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourcePathColumn()) != 0
            || arena.bindingAliases.values.update(element: sourceStorageID, index: row * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourceStorageColumn()) != 0 { return 0 - 1 }
        row: row + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathRelativeTarget(arena: CompilerBodyArena, sourceRootPathID: Int, destinationRootPathID: Int, destinationPathID: Int): Int {
    if sourceRootPathID < 0 || destinationRootPathID < 0 || destinationPathID < 0
        || !compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: destinationPathID, ancestorPathID: destinationRootPathID) { return 0 - 1 }
    let members: Buffer<Int>(bufferCreateInt(capacity: 8))
    state currentPathID: Int(destinationPathID)
    state status: Int(0)
    while currentPathID != destinationRootPathID && status == 0 {
        if currentPathID < 0 || currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) {
            status: 0 - 1
        } else {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn()))
            if memberRow < 0 || members.append(element: memberRow) != 0 { status: 0 - 1 }
            currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
        }
    }
    state sourcePathID: Int(sourceRootPathID)
    state reverseOrdinal: Int(members.count - 1)
    while reverseOrdinal >= 0 && status == 0 {
        sourcePathID: compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: sourcePathID, memberRow: members.element(index: reverseOrdinal))
        if sourcePathID < 0 { status: 0 - 1 }
        reverseOrdinal: reverseOrdinal - 1
    }
    members.destroy()
    if status != 0 { return 0 - 1 }
    return sourcePathID
}

function compilerBodyArenaBindingAliasAppendSubtree(arena: CompilerBodyArena, destinationRootPathID: Int, sourceRootPathID: Int, sourceNodeID: Int): Int {
    if destinationRootPathID < 0 || sourceRootPathID < 0
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationRootPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: sourceRootPathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathRow, ancestorPathID: destinationRootPathID) {
            let sourcePathID: Int(compilerBodyArenaOwnedPathRelativeTarget(arena: arena, sourceRootPathID: sourceRootPathID, destinationRootPathID: destinationRootPathID, destinationPathID: pathRow))
            if sourcePathID < 0 || compilerBodyBindingAliasAppend(arena: arena, destinationPathID: pathRow, sourcePathID: sourcePathID, sourceNodeID: sourceNodeID) < 0 { return 0 - 1 }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaBindingAliasAppendNestedDescendants(arena: CompilerBodyArena, destinationRootPathID: Int, sourceRootPathID: Int, sourceNodeID: Int): Int {
    if destinationRootPathID < 0 || sourceRootPathID < 0
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationRootPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: sourceRootPathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if pathRow != destinationRootPathID
            && compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathRow, ancestorPathID: destinationRootPathID)
            && compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyAlias() {
            let sourcePathID: Int(compilerBodyArenaOwnedPathRelativeTarget(arena: arena, sourceRootPathID: sourceRootPathID, destinationRootPathID: destinationRootPathID, destinationPathID: pathRow))
            if sourcePathID < 0
                || compilerBodyBindingAliasAppendWithProvenance(arena: arena, destinationPathID: pathRow, sourcePathID: sourcePathID, sourceNodeID: sourceNodeID, provenanceKind: compilerBodyBindingAliasProvenanceNestedCarrier()) < 0 { return 0 - 1 }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathHasNestedAlias(arena: CompilerBodyArena, rootPathID: Int): Bool {
    if rootPathID < 0 { return false }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if pathRow != rootPathID
            && compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathRow, ancestorPathID: rootPathID)
            && compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyAlias() { return true }
        pathRow: pathRow + 1
    }
    return false
}

function compilerBodyArenaBindingAliasReturnedCallNodeIsValid(arena: CompilerBodyArena, sourceNodeID: Int): Bool {
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 1) != compilerSyntaxKindApplication() { return false }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    return calleeNodeID >= 0 && resolutionRow >= 0
        && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction()
}

function compilerBodyArenaBindingAliasValidationCode(arena: CompilerBodyArena): Int {
    if !compilerIntTableIsComplete(table: arena.bindingAliases) { return 1 }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.bindingAliases) {
        let destinationPathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasDestinationPathColumn()))
        let sourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourcePathColumn()))
        let sourceStorageID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourceStorageColumn()))
        let sourceNodeID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourceNodeColumn()))
        let provenanceKind: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasProvenanceColumn()))
        state provenanceIsValid: Bool(false)
        if provenanceKind == compilerBodyBindingAliasProvenanceExplicit() {
            provenanceIsValid: compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: sourceNodeID)
        } else if provenanceKind == compilerBodyBindingAliasProvenanceReturnedCall() {
            provenanceIsValid: compilerBodyArenaBindingAliasReturnedCallNodeIsValid(arena: arena, sourceNodeID: sourceNodeID)
        } else if provenanceKind == compilerBodyBindingAliasProvenanceNestedCarrier() {
            let sourceRootPathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: sourceNodeID))
            provenanceIsValid: sourceRootPathID >= 0
                && compilerBodyArenaOwnedPathHasNestedAlias(arena: arena, rootPathID: sourceRootPathID)
        }
        if compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasIDColumn()) != row
            || destinationPathID < 0 || destinationPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
            || !provenanceIsValid
            || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyAlias()
            || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathTypeColumn())
            || compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: destinationPathID) < 0 { return 1000 + row }
        if sourceStorageID >= 0 {
            let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
            if sourceStorageID >= compilerIntTableRowCount(table: arena.storages)
                || canonicalSourcePathID < 0
                || compilerBodyArenaOwnedPathStorageID(arena: arena, pathID: canonicalSourcePathID) != sourceStorageID { return 2000 + row }
        }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: arena.bindingAliases, row: priorRow, column: compilerBodyBindingAliasDestinationPathColumn()) == destinationPathID { return 3000 + row }
            priorRow: priorRow + 1
        }
        row: row + 1
    }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyAlias()
            && compilerBodyBindingAliasFind(aliases: arena.bindingAliases, destinationPathID: pathRow) < 0 {
            let rootSymbolKind: Int(compilerBodyArenaOwnedPathRootSymbolKind(arena: arena, pathID: pathRow))
            if rootSymbolKind != compilerBodySymbolParameter() && rootSymbolKind != compilerBodySymbolReceiver() { return 4000 + pathRow }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaBindingAliasesAreValid(arena: CompilerBodyArena): Bool {
    return compilerBodyArenaBindingAliasValidationCode(arena: arena) == 0
}

function compilerBodyOwnedReturnTransferFind(transfers: CompilerIntTable, returnNodeID: Int, returnPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: transfers) {
        if compilerIntTableValue(table: transfers, row: row, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
            && compilerIntTableValue(table: transfers, row: row, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == returnPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyOwnedReturnTransferCountForReturnNode(transfers: CompilerIntTable, returnNodeID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: transfers) {
        if compilerIntTableValue(table: transfers, row: row, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyOwnedReturnTransferAppend(arena: CompilerBodyArena, effectPaths: CompilerIntTable, returnNodeID: Int, returnPathID: Int, sourcePathID: Int, transferKind: Int, storageKeyID: Int, sourceTypeID: Int): Int {
    if returnNodeID < 0 || returnNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || (transferKind != compilerBodyOwnedReturnTransferMove() && transferKind != compilerBodyOwnedReturnTransferAlias() && transferKind != compilerBodyOwnedReturnTransferForward()) || storageKeyID < 0 || sourceTypeID < 0
        || !compilerBodyFunctionInstanceEffectPathIsValid(paths: effectPaths, pathID: returnPathID) { return 0 - 1 }
    if compilerBodyOwnedReturnTransferFind(transfers: arena.ownedReturnTransfers, returnNodeID: returnNodeID, returnPathID: returnPathID) >= 0 { return 0 - 1 }
    let transferID: Int(compilerIntTableRowCount(table: arena.ownedReturnTransfers))
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: transferID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: returnNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: returnPathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: sourcePathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: transferKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: storageKeyID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: sourceTypeID) != 0 { return 0 - 1 }
    return transferID
}

function compilerBodyRuntimeCallContractFind(contracts: CompilerIntTable, callNodeID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: contracts) {
        if compilerIntTableValue(table: contracts, row: row, column: compilerBodyRuntimeCallContractCallNodeColumn()) == callNodeID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyRuntimeCallContractAppend(contracts: CompilerIntTable, callNodeID: Int, functionID: Int, role: Int, storageArgumentOrdinal: Int, storageTypeID: Int): Int {
    if compilerBodyRuntimeCallContractFind(contracts: contracts, callNodeID: callNodeID) >= 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: callNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: functionID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: role) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: storageArgumentOrdinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: storageTypeID) != 0 { return 0 - 1 }
    return compilerIntTableRowCount(table: contracts) - 1
}

function compilerBodyFunctionInstanceEffectPathFind(paths: CompilerIntTable, parentPathID: Int, memberRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: paths) {
        if compilerIntTableValue(table: paths, row: row, column: compilerBodyFunctionInstanceEffectPathParentColumn()) == parentPathID
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyFunctionInstanceEffectPathMemberColumn()) == memberRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyFunctionInstanceEffectPathAppend(paths: CompilerIntTable, parentPathID: Int, memberRow: Int): Int {
    if memberRow < 0 || (parentPathID < 0 && parentPathID != 0 - 1) { return 0 - 1 }
    if parentPathID >= 0 && !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: parentPathID) { return 0 - 1 }
    let existing: Int(compilerBodyFunctionInstanceEffectPathFind(paths: paths, parentPathID: parentPathID, memberRow: memberRow))
    if existing >= 0 { return existing }
    let pathID: Int(compilerIntTableRowCount(table: paths))
    state parentDepth: Int(0)
    if parentPathID >= 0 {
        if parentPathID >= pathID { return 0 - 1 }
        parentDepth: compilerIntTableValue(table: paths, row: parentPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn())
    }
    if compilerIntTableAppend(table: paths, value: pathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: parentPathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: memberRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: parentDepth + 1) != 0 { return 0 - 1 }
    return pathID
}

function compilerBodyFunctionInstanceEffectPathLeaf(paths: CompilerIntTable, pathID: Int): Int {
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: pathID) || pathID < 0 { return 0 - 1 }
    return compilerIntTableValue(table: paths, row: pathID, column: compilerBodyFunctionInstanceEffectPathMemberColumn())
}

function compilerBodyFunctionInstanceEffectPathIsValid(paths: CompilerIntTable, pathID: Int): Bool {
    if pathID == 0 - 1 { return true }
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: paths) { return false }
    state currentPathID: Int(pathID)
    state step: Int(0)
    let pathCount: Int(compilerIntTableRowCount(table: paths))
    while currentPathID >= 0 && step <= pathCount {
        if currentPathID >= pathCount { return false }
        let memberRow: Int(compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathMemberColumn()))
        let parentPathID: Int(compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathParentColumn()))
        let depth: Int(compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn()))
        if memberRow < 0 || depth <= 0 || (parentPathID < 0 && parentPathID != 0 - 1) { return false }
        if parentPathID < 0 {
            if depth != 1 { return false }
        } else {
            if parentPathID >= currentPathID || parentPathID >= pathCount { return false }
            let parentDepth: Int(compilerIntTableValue(table: paths, row: parentPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn()))
            if parentDepth <= 0 || depth != parentDepth + 1 { return false }
        }
        currentPathID: parentPathID
        step: step + 1
    }
    return currentPathID == 0 - 1
}

function compilerBodyFunctionInstanceEffectPathMaterialize(paths: CompilerIntTable, pathID: Int): Buffer<Int> {
    let result: Buffer<Int>(bufferCreateInt(capacity: 8))
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: pathID) { return result }
    state currentPathID: Int(pathID)
    while currentPathID >= 0 {
        if result.append(element: compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathMemberColumn())) != 0 { return result }
        currentPathID: compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathParentColumn())
    }
    return result
}

function compilerBodyFunctionInstanceEffectPathMaterializedIsComplete(paths: CompilerIntTable, pathID: Int, members: Buffer<Int>): Bool {
    if pathID == 0 - 1 { return members.count == 0 }
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: pathID) { return false }
    return members.count == compilerIntTableValue(table: paths, row: pathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn())
}

function compilerBodyFunctionInstanceEffectPathConcat(paths: CompilerIntTable, prefixPathID: Int, suffixPathID: Int): Int {
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: prefixPathID) || !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: suffixPathID) { return 0 - 2 }
    if prefixPathID < 0 && suffixPathID < 0 { return 0 - 1 }
    if suffixPathID < 0 { return prefixPathID }
    if suffixPathID >= compilerIntTableRowCount(table: paths) { return 0 - 2 }
    let suffixMembers: Buffer<Int>(compilerBodyFunctionInstanceEffectPathMaterialize(paths: paths, pathID: suffixPathID))
    if !compilerBodyFunctionInstanceEffectPathMaterializedIsComplete(paths: paths, pathID: suffixPathID, members: suffixMembers) {
        suffixMembers.destroy()
        return 0 - 2
    }
    state currentPathID: Int(prefixPathID)
    let suffixCount: Int(suffixMembers.count)
    state reverseOrdinal: Int(suffixCount - 1)
    while reverseOrdinal >= 0 {
        let nextPathID: Int(compilerBodyFunctionInstanceEffectPathAppend(paths: paths, parentPathID: currentPathID, memberRow: suffixMembers.element(index: reverseOrdinal)))
        if nextPathID < 0 {
            suffixMembers.destroy()
            return 0 - 2
        }
        currentPathID: nextPathID
        reverseOrdinal: reverseOrdinal - 1
    }
    suffixMembers.destroy()
    return currentPathID
}

function compilerBodyArenaOwnedPathFollowEffectPath(arena: CompilerBodyArena, basePathID: Int, effectPaths: CompilerIntTable, effectPathID: Int): Int {
    if basePathID < 0 || basePathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: effectPaths, pathID: effectPathID) { return 0 - 1 }
    if effectPathID < 0 { return basePathID }
    let members: Buffer<Int>(compilerBodyFunctionInstanceEffectPathMaterialize(paths: effectPaths, pathID: effectPathID))
    if !compilerBodyFunctionInstanceEffectPathMaterializedIsComplete(paths: effectPaths, pathID: effectPathID, members: members) {
        members.destroy()
        return 0 - 1
    }
    state pathID: Int(basePathID)
    state reverseOrdinal: Int(members.count - 1)
    while reverseOrdinal >= 0 {
        let memberRow: Int(members.element(index: reverseOrdinal))
        pathID: compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: pathID, memberRow: memberRow)
        if pathID < 0 {
            members.destroy()
            return 0 - 1
        }
        reverseOrdinal: reverseOrdinal - 1
    }
    members.destroy()
    return pathID
}

function compilerBodyFunctionInstanceEffectFind(effects: CompilerIntTable, instanceID: Int, baseKind: Int, ordinal: Int, memberPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: effects) {
        if compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectInstanceColumn()) == instanceID
            && compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectBaseKindColumn()) == baseKind
            && compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectOrdinalColumn()) == ordinal
            && compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectPathColumn()) == memberPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyFunctionInstanceEffectAppend(effects: CompilerIntTable, paths: CompilerIntTable, instanceID: Int, baseKind: Int, ordinal: Int, memberPathID: Int, storageKeyID: Int, effectKind: Int): Int {
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: memberPathID) { return 0 - 1 }
    let row: Int(compilerIntTableRowCount(table: effects))
    let existing: Int(compilerBodyFunctionInstanceEffectFind(effects: effects, instanceID: instanceID, baseKind: baseKind, ordinal: ordinal, memberPathID: memberPathID))
    if existing >= 0 {
        if compilerIntTableValue(table: effects, row: existing, column: compilerBodyFunctionInstanceEffectStorageKeyColumn()) != storageKeyID { return 0 - 1 }
        let priorEffect: Int(compilerIntTableValue(table: effects, row: existing, column: compilerBodyFunctionInstanceEffectKindColumn()))
        if effectKind > priorEffect {
            if effects.values.update(element: effectKind, index: existing * effects.columnCount + compilerBodyFunctionInstanceEffectKindColumn()) != 0 { return 0 - 1 }
            return 1
        }
        return 0
    }
    state memberRow: Int(0 - 1)
    if memberPathID >= 0 {
        memberRow: compilerBodyFunctionInstanceEffectPathLeaf(paths: paths, pathID: memberPathID)
        if memberRow < 0 { return 0 - 1 }
    }
    if compilerIntTableAppend(table: effects, value: instanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: baseKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: ordinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: memberRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: storageKeyID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: effectKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: memberPathID) != 0 { return 0 - 1 }
    return 1
}

function compilerBodyFunctionInstanceEffectCallFind(calls: CompilerIntTable, callerInstanceID: Int, targetInstanceID: Int, calleeBaseKind: Int, calleeOrdinal: Int, callerBaseKind: Int, callerOrdinal: Int, prefixPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: calls) {
        if compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCallerColumn()) == callerInstanceID
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallTargetColumn()) == targetInstanceID
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCalleeBaseKindColumn()) == calleeBaseKind
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCalleeOrdinalColumn()) == calleeOrdinal
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCallerBaseKindColumn()) == callerBaseKind
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCallerOrdinalColumn()) == callerOrdinal
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallPrefixPathColumn()) == prefixPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyFunctionInstanceEffectCallAppend(calls: CompilerIntTable, paths: CompilerIntTable, callerInstanceID: Int, targetInstanceID: Int, calleeBaseKind: Int, calleeOrdinal: Int, callerBaseKind: Int, callerOrdinal: Int, prefixPathID: Int): Int {
    if callerInstanceID < 0 || targetInstanceID < 0 || calleeOrdinal < 0 || callerOrdinal < 0
        || (calleeBaseKind != compilerBodyOwnedBaseReceiver() && calleeBaseKind != compilerBodyOwnedBaseParameter())
        || (callerBaseKind != compilerBodyOwnedBaseReceiver() && callerBaseKind != compilerBodyOwnedBaseParameter())
        || !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: prefixPathID) { return 0 - 1 }
    let existing: Int(compilerBodyFunctionInstanceEffectCallFind(calls: calls, callerInstanceID: callerInstanceID, targetInstanceID: targetInstanceID, calleeBaseKind: calleeBaseKind, calleeOrdinal: calleeOrdinal, callerBaseKind: callerBaseKind, callerOrdinal: callerOrdinal, prefixPathID: prefixPathID))
    if existing >= 0 { return existing }
    if compilerIntTableAppend(table: calls, value: callerInstanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: targetInstanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: calleeBaseKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: calleeOrdinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: callerBaseKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: callerOrdinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: prefixPathID) != 0 { return 0 - 1 }
    return compilerIntTableRowCount(table: calls) - 1
}

function compilerBodyArenaRuntimeBuiltinFunctionIDForApplication(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionRuntimeBuiltin() { return 0 - 1 }
    let runtimeBuiltinID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    let functionName: String(compilerBodyRuntimeBuiltinName(id: runtimeBuiltinID))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: functionName, kindTag: compilerSyntaxKindFunction()))
    if declarationRow < 0 { return 0 - 1 }
    let functionSyntaxID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0))
    return compilerSemanticFunctionRowForSyntaxID(tables: arena.tables, functionSyntaxID: functionSyntaxID)
}

function compilerBodyArenaRuntimeStorageArgumentOrdinal(arena: CompilerBodyArena, functionRow: Int): Int {
    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - 1 }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterTypeID: Int(compilerBodyArenaTypeIDForSpan(arena: arena, fileID: parameterFileID, start: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8), end: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9)))
        if compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: parameterTypeID) { return ordinal }
        ordinal: ordinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaInitializerDeclarationForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    state currentNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        state groupingOwnerNodeID: Int(0 - 1)
        state initializerOwnerNodeID: Int(0 - 1)
        state edgeRow: Int(0)
        while edgeRow < compilerIntTableRowCount(table: arena.edges) {
            if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == currentNodeID {
                let edgeOwnerNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0))
                let edgeRole: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2))
                if edgeRole == compilerSyntaxRoleInitializer()
                    && edgeOwnerNodeID >= 0 && edgeOwnerNodeID < compilerIntTableRowCount(table: arena.nodes)
                    && compilerIntTableValue(table: arena.nodes, row: edgeOwnerNodeID, column: 1) == compilerSyntaxKindLocalBinding() { initializerOwnerNodeID: edgeOwnerNodeID }
                if edgeRole == compilerSyntaxRoleGroupedValue()
                    && edgeOwnerNodeID >= 0 && edgeOwnerNodeID < compilerIntTableRowCount(table: arena.nodes)
                    && compilerIntTableValue(table: arena.nodes, row: edgeOwnerNodeID, column: 1) == compilerSyntaxKindGrouping() { groupingOwnerNodeID: edgeOwnerNodeID }
            }
            edgeRow: edgeRow + 1
        }
        if initializerOwnerNodeID >= 0 { return initializerOwnerNodeID }
        if groupingOwnerNodeID < 0 || groupingOwnerNodeID == currentNodeID { return 0 - 1 }
        currentNodeID: groupingOwnerNodeID
        step: step + 1
    }
    return 0 - 1
}

function compilerBodyArenaSymbolForInitializerValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    let declarationNodeID: Int(compilerBodyArenaInitializerDeclarationForValue(arena: arena, valueNodeID: valueNodeID))
    if declarationNodeID < 0 { return 0 - 1 }
    return compilerBodyArenaSymbolForDeclaration(arena: arena, declarationNodeID: declarationNodeID)
}

function compilerBodyArenaConstructArgumentValueForMember(arena: CompilerBodyArena, applicationNodeID: Int, memberRow: Int): Int {
    state ordinal: Int(0)
    let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID))
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
    let constructSyntaxID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    while ordinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: argumentNodeID) == memberRow {
            return compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0)
        }
        ordinal: ordinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeListContains(values: Buffer<Int>, value: Int): Bool {
    state row: Int(0)
    while row < values.count {
        if values.element(index: row) == value { return true }
        row: row + 1
    }
    return false
}

function compilerBodyArenaTypeIDIsOptional(arena: CompilerBodyArena, typeID: Int): Bool {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return false }
    if compilerBodyArenaStorageCacheEnsure(cache: arena.optionalTypeStatuses, typeID: typeID, unknown: 0 - 1) != 0 { return false }
    let cachedStatus: Int(arena.optionalTypeStatuses.element(index: typeID))
    if cachedStatus >= 0 { return cachedStatus == 1 }
    let typeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: typeID))
    state isOptional: Bool(false)
    if typeKind != compilerBodyTypeConstruct() && typeKind != compilerBodyTypeEnum() {
        if arena.optionalTypeStatuses.update(element: 0, index: typeID) != 0 { return false }
        return false
    }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    state mayUseOuterName: Bool(nominalSyntaxID != compilerBodyBuiltinArraySyntaxID())
    if nominalSyntaxID == compilerBodyBuiltinOptionalSyntaxID() {
        isOptional: true
    } else if nominalSyntaxID != compilerBodyBuiltinArraySyntaxID() && nominalSyntaxID >= 0 {
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: nominalSyntaxID))
        if declarationRow >= 0 {
            let declarationFileID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 1))
            if compilerSemanticLocalRangeEqualsText(
                tables: arena.tables,
                fileID: declarationFileID,
                start: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 7),
                end: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 8),
                text: String("Optional")
            ) { isOptional: true }
        }
        if !isOptional && compilerBodyArenaIsCompileTime(arena: arena)
            && arena.ownerKind == compilerBodyArenaOwnerFunction() {
            mayUseOuterName: false
        }
    }
    if !isOptional && mayUseOuterName {
        isOptional: compilerBodyArenaTypeOuterName(typeName: compilerBodyArenaTypeNameForTypeID(arena: arena, typeID: typeID)) == String("Optional")
    }
    state result: Int(0)
    if isOptional { result: 1 }
    if arena.optionalTypeStatuses.update(element: result, index: typeID) != 0 { return false }
    return isOptional
}

function compilerBodyOwnedPathOptionalPayloadMember(arena: CompilerBodyArena): Int {
    return compilerIntTableRowCount(table: arena.tables.members)
}

function compilerBodyArenaTypeOwnedStorageStatus(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    let pending: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.typeInstances) + 1))
    let visited: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.typeInstances) + 1))
    state found: Bool(false)
    state status: Int(0)
    state pendingCount: Int(0)
    if pending.append(element: typeID) != 0 {
        status: 0 - 1
    } else {
        pendingCount: 1
    }
    while pendingCount > 0 && !found && status == 0 {
        pendingCount: pendingCount - 1
        let candidate: Int(pending.element(index: pendingCount))
        if candidate < 0 || candidate >= compilerIntTableRowCount(table: arena.typeInstances) {
            status: 0 - 1
        } else if !compilerBodyArenaTypeListContains(values: visited, value: candidate) {
            if visited.append(element: candidate) != 0 { status: 0 - 1 }
            else if compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: candidate) { found: true }
            else if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: candidate)
                || compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: candidate) {
                let elementTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: candidate, ordinal: 0))
                if elementTypeID < 0 {
                    status: 0 - 1
                } else if !compilerBodyArenaTypeListContains(values: visited, value: elementTypeID) {
                    if pendingCount < pending.count {
                        if pending.update(element: elementTypeID, index: pendingCount) != 0 { status: 0 - 1 }
                    } else if pending.append(element: elementTypeID) != 0 { status: 0 - 1 }
                    if status == 0 { pendingCount: pendingCount + 1 }
                }
            }
            else if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeConstruct()
                || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeString() {
                state receiverSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: candidate, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
                if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeString() {
                    receiverSyntaxID: compilerBodyArenaStringDeclarationSyntaxID(arena: arena)
                }
                state memberRow: Int(0)
                if receiverSyntaxID < 0 { status: 0 - 1 }
                while memberRow < compilerIntTableRowCount(table: arena.tables.members) && status == 0 {
                    if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == receiverSyntaxID {
                        let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
                        if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() {
                            let fieldTypeID: Int(compilerBodyArenaOwnedFieldTypeID(arena: arena, receiverTypeID: candidate, memberRow: memberRow))
                            if fieldTypeID < 0 {
                                status: 0 - 1
                            } else if !compilerBodyArenaTypeListContains(values: visited, value: fieldTypeID) {
                                if pendingCount < pending.count {
                                    if pending.update(element: fieldTypeID, index: pendingCount) != 0 { status: 0 - 1 }
                                } else if pending.append(element: fieldTypeID) != 0 { status: 0 - 1 }
                                if status == 0 { pendingCount: pendingCount + 1 }
                            }
                        }
                    }
                    memberRow: memberRow + 1
                }
            }
        }
    }
    if pending.destroy() != 0 { status: 0 - 1 }
    if visited.destroy() != 0 { status: 0 - 1 }
    if status != 0 { return status }
    if found { return 1 }
    return 0
}

function compilerBodyArenaTypeContainsOwnedStorage(arena: CompilerBodyArena, typeID: Int): Bool {
    return compilerBodyArenaTypeOwnedStorageStatus(arena: arena, typeID: typeID) == 1
}

function compilerBodyArenaTypeTrackedStorageStatus(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    if compilerBodyArenaIsCompileTime(arena: arena) { return 0 }
    if compilerBodyArenaStorageCacheEnsure(cache: arena.trackedStorageStatuses, typeID: typeID, unknown: 0 - 2) != 0 { return 0 - 1 }
    let cachedStatus: Int(arena.trackedStorageStatuses.element(index: typeID))
    if cachedStatus != 0 - 2 { return cachedStatus }
    let pending: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.typeInstances) + 1))
    let visited: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.typeInstances) + 1))
    state found: Bool(false)
    state status: Int(0)
    state pendingCount: Int(0)
    if pending.append(element: typeID) != 0 {
        status: 0 - 1
    } else {
        pendingCount: 1
    }
    while pendingCount > 0 && !found && status == 0 {
        pendingCount: pendingCount - 1
        let candidate: Int(pending.element(index: pendingCount))
        if candidate < 0 || candidate >= compilerIntTableRowCount(table: arena.typeInstances) {
            status: 0 - 1
        } else if !compilerBodyArenaTypeListContains(values: visited, value: candidate) {
            if visited.append(element: candidate) != 0 { status: 0 - 1 }
            else if compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: candidate) { found: true }
            else if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: candidate)
                || compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: candidate) {
                let elementTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: candidate, ordinal: 0))
                if elementTypeID < 0 {
                    status: 0 - 1
                } else if !compilerBodyArenaTypeListContains(values: visited, value: elementTypeID) {
                    if pendingCount < pending.count {
                        if pending.update(element: elementTypeID, index: pendingCount) != 0 { status: 0 - 1 }
                    } else if pending.append(element: elementTypeID) != 0 { status: 0 - 1 }
                    if status == 0 { pendingCount: pendingCount + 1 }
                }
            }
            else if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeConstruct()
                || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeString() {
                state receiverSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: candidate, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
                if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeString() {
                    receiverSyntaxID: compilerBodyArenaStringDeclarationSyntaxID(arena: arena)
                }
                state memberRow: Int(0)
                if receiverSyntaxID < 0 { status: 0 - 1 }
                while memberRow < compilerIntTableRowCount(table: arena.tables.members) && status == 0 {
                    if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == receiverSyntaxID {
                        let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
                        if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() || memberKind == compilerSyntaxMemberKindBinding() {
                            let fieldTypeID: Int(compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: candidate, memberRow: memberRow))
                            if fieldTypeID < 0 {
                                status: 0 - 1
                            } else if !compilerBodyArenaTypeListContains(values: visited, value: fieldTypeID) {
                                if pendingCount < pending.count {
                                    if pending.update(element: fieldTypeID, index: pendingCount) != 0 { status: 0 - 1 }
                                } else if pending.append(element: fieldTypeID) != 0 { status: 0 - 1 }
                                if status == 0 { pendingCount: pendingCount + 1 }
                            }
                        }
                    }
                    memberRow: memberRow + 1
                }
            }
        }
    }
    if pending.destroy() != 0 { status: 0 - 1 }
    if visited.destroy() != 0 { status: 0 - 1 }
    if status != 0 { return status }
    state result: Int(0)
    if found { result: 1 }
    if arena.trackedStorageStatuses.update(element: result, index: typeID) != 0 { return 0 - 1 }
    return result
}

function compilerBodyArenaAppendOwnedPathDescendants(arena: CompilerBodyArena, rootKind: Int, rootID: Int, parentPathID: Int, typeID: Int, policy: Int, depth: Int): Int {
    if depth > compilerIntTableRowCount(table: arena.typeInstances) + 1 { return 0 - 1 }
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    let typeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: typeID))
    if typeKind != compilerBodyTypeConstruct() && typeKind != compilerBodyTypeString() { return 0 }
    if compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: typeID) { return 0 }
    if compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: typeID) {
        let payloadTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: typeID, ordinal: 0))
        let payloadTrackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: payloadTypeID))
        if payloadTypeID < 0 || payloadTrackedStatus < 0 { return 0 - 1 }
        if payloadTrackedStatus == 1 {
            let payloadPathID: Int(compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: rootKind, rootID: rootID, parentPathID: parentPathID, memberRow: compilerBodyOwnedPathOptionalPayloadMember(arena: arena), typeID: payloadTypeID, policy: policy))
            if payloadPathID < 0
                || compilerBodyArenaAppendOwnedPathDescendants(arena: arena, rootKind: rootKind, rootID: rootID, parentPathID: payloadPathID, typeID: payloadTypeID, policy: policy, depth: depth + 1) != 0 { return 0 - 1 }
        }
        return 0
    }
    state receiverSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if typeKind == compilerBodyTypeString() {
        receiverSyntaxID: compilerBodyArenaStringDeclarationSyntaxID(arena: arena)
    }
    if receiverSyntaxID < 0 { return 0 - 1 }
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == receiverSyntaxID {
            let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
            if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() || memberKind == compilerSyntaxMemberKindBinding() {
                let fieldTypeID: Int(compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: typeID, memberRow: memberRow))
                let fieldTrackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: fieldTypeID))
                if fieldTrackedStatus < 0 { return 0 - 1 }
                if fieldTrackedStatus == 1
                    && memberRow != compilerBodyArenaTransparentStorageMemberRowForType(arena: arena, typeKind: typeKind, typeID: typeID) {
                    state childPolicy: Int(policy)
                    if memberKind == compilerSyntaxMemberKindBinding() { childPolicy: compilerBodyOwnedPathPolicyAlias() }
                    let childPathID: Int(compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: rootKind, rootID: rootID, parentPathID: parentPathID, memberRow: memberRow, typeID: fieldTypeID, policy: childPolicy))
                    if childPathID < 0 { return 0 - 1 }
                    if compilerBodyArenaAppendOwnedPathDescendants(arena: arena, rootKind: rootKind, rootID: rootID, parentPathID: childPathID, typeID: fieldTypeID, policy: childPolicy, depth: depth + 1) != 0 { return 0 - 1 }
                }
            }
        }
        memberRow: memberRow + 1
    }
    return 0
}

function compilerBodyArenaBuildBindingAliasTopologyForConstruct(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
    if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionConstruct() { return 0 }
    let resultTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
    let resultTrackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: resultTypeID))
    if resultTrackedStatus < 0 { return 0 - 1 }
    if resultTrackedStatus == 0 { return 0 }
    let resultRootPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: applicationNodeID, memberRow: 0 - 1))
    if resultRootPathID < 0 { return 0 - 1 }
    let destinationSymbolID: Int(compilerBodyArenaSymbolForInitializerValue(arena: arena, valueNodeID: applicationNodeID))
    state localRootPathID: Int(0 - 1)
    if destinationSymbolID >= 0 {
        localRootPathID: compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: destinationSymbolID, memberRow: 0 - 1)
        if localRootPathID < 0 { return 0 - 1 }
    }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathParentColumn()) == resultRootPathID {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathMemberColumn()))
            let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
            if memberKind == compilerSyntaxMemberKindBinding() {
                let valueNodeID: Int(compilerBodyArenaConstructArgumentValueForMember(arena: arena, applicationNodeID: applicationNodeID, memberRow: memberRow))
                let sourcePathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: valueNodeID))
                if valueNodeID < 0 || sourcePathID < 0
                    || compilerBodyArenaBindingAliasAppendSubtree(arena: arena, destinationRootPathID: pathRow, sourceRootPathID: sourcePathID, sourceNodeID: valueNodeID) != 0 { return 0 - 1 }
                if localRootPathID >= 0 {
                    let localMemberPathID: Int(compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: localRootPathID, memberRow: memberRow))
                    if localMemberPathID < 0
                        || compilerBodyArenaBindingAliasAppendSubtree(arena: arena, destinationRootPathID: localMemberPathID, sourceRootPathID: sourcePathID, sourceNodeID: valueNodeID) != 0 { return 0 - 1 }
                }
            } else if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() {
                if compilerBodyArenaOwnedPathHasNestedAlias(arena: arena, rootPathID: pathRow) {
                    let valueNodeID: Int(compilerBodyArenaConstructArgumentValueForMember(arena: arena, applicationNodeID: applicationNodeID, memberRow: memberRow))
                    let sourcePathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: valueNodeID))
                    if valueNodeID < 0 || sourcePathID < 0
                        || compilerBodyArenaBindingAliasAppendNestedDescendants(arena: arena, destinationRootPathID: pathRow, sourceRootPathID: sourcePathID, sourceNodeID: valueNodeID) != 0 { return 0 - 1 }
                    if localRootPathID >= 0 {
                        let localMemberPathID: Int(compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: localRootPathID, memberRow: memberRow))
                        if localMemberPathID < 0
                            || compilerBodyArenaBindingAliasAppendNestedDescendants(arena: arena, destinationRootPathID: localMemberPathID, sourceRootPathID: sourcePathID, sourceNodeID: valueNodeID) != 0 { return 0 - 1 }
                    }
                }
            } else {
                return 0 - 1
            }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaNodeHasScheduledEvaluation(arena: CompilerBodyArena, nodeID: Int): Bool {
    state scheduleRow: Int(0)
    while scheduleRow < compilerIntTableRowCount(table: arena.cfgSchedule) {
        if compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleNodeColumn()) == nodeID
            && (compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleActionColumn()) == compilerBodyCFGScheduleEvaluateNode()
                || compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleActionColumn()) == compilerBodyCFGScheduleOptionalJoin()) { return true }
        scheduleRow: scheduleRow + 1
    }
    return false
}

function compilerBodyArenaApplicationHasResolvedCallee(arena: CompilerBodyArena, applicationNodeID: Int): Bool {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    return calleeNodeID >= 0
        && compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID) >= 0
}

function compilerBodyArenaBuildOwnedPathTables(arena: CompilerBodyArena): Int {
    if compilerIntTableRowCount(table: arena.ownedPaths) != 0 || compilerIntTableRowCount(table: arena.runtimeCallContracts) != 0 { return 0 }
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        let symbolTypeID: Int(compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolRow))
        let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolKindColumn()))
        let symbolIsMacroParameter: Bool((arena.ownerKind == compilerBodyArenaOwnerMacro() && symbolKind == compilerBodySymbolParameter()) || symbolKind == compilerBodySymbolClosureParameter())
        if !symbolIsMacroParameter {
            let symbolIsOpaqueStorage: Bool(compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: symbolTypeID))
            if symbolIsOpaqueStorage
                && (symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver()) {
                if compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: symbolRow, parentPathID: 0 - 1, memberRow: 0 - 1, typeID: symbolTypeID, policy: compilerBodyOwnedPathPolicyBorrowed()) < 0 { return 0 - 1 }
            }
            let symbolIsBorrowedAggregate: Bool(symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver())
            let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolDeclarationColumn()))
            let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
            let initializerIsNonOwningStringView: Bool(
                initializerNodeID >= 0
                    && compilerBodyArenaValueIsNonOwningStringView(arena: arena, valueNodeID: initializerNodeID)
            )
            let initializerIsSyntaxQueryProjection: Bool(
                initializerNodeID >= 0
                    && compilerBodyArenaValueIsDerivedSyntaxQueryProjection(arena: arena, valueNodeID: initializerNodeID)
            )
            let symbolNeedsTrackedStorage: Bool(
                symbolIsBorrowedAggregate
                    || (initializerNodeID >= 0
                        && !initializerIsNonOwningStringView
                        && !initializerIsSyntaxQueryProjection)
            )
            state symbolTrackedStatus: Int(0)
            if symbolTypeID >= 0 && !symbolIsOpaqueStorage && symbolNeedsTrackedStorage {
                symbolTrackedStatus: compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: symbolTypeID)
                if symbolTrackedStatus < 0 { return 0 - 1 }
            }
            if symbolTypeID >= 0
                && (compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: symbolTypeID) == compilerBodyTypeConstruct()
                    || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: symbolTypeID) == compilerBodyTypeString())
                && !symbolIsOpaqueStorage
                && symbolTrackedStatus == 1 {
                if symbolNeedsTrackedStorage {
                    let rootPolicy: Int(compilerBodyOwnedPathPolicyForBorrowed(borrowed: symbolIsBorrowedAggregate))
                    let rootPathID: Int(compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: symbolRow, parentPathID: 0 - 1, memberRow: 0 - 1, typeID: symbolTypeID, policy: rootPolicy))
                    if rootPathID < 0 { return 0 - 1 }
                    if compilerBodyArenaAppendOwnedPathDescendants(arena: arena, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: symbolRow, parentPathID: rootPathID, typeID: symbolTypeID, policy: rootPolicy, depth: 0) != 0 { return 0 - 1 }
                }
            }
            if symbolKind != compilerBodySymbolParameter() && symbolKind != compilerBodySymbolReceiver() && symbolIsOpaqueStorage {
                let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolDeclarationColumn()))
                let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
                if initializerNodeID >= 0
                    && (!compilerBodyArenaValueIsNonOwningStringView(arena: arena, valueNodeID: initializerNodeID)
                        && !compilerBodyArenaValueIsDerivedSyntaxQueryProjection(arena: arena, valueNodeID: initializerNodeID)
                        || symbolKind == compilerBodySymbolState()) {
                    if compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: symbolRow, parentPathID: 0 - 1, memberRow: 0 - 1, typeID: symbolTypeID, policy: compilerBodyOwnedPathPolicyOwned()) < 0 { return 0 - 1 }
                }
            }
        }
        symbolRow: symbolRow + 1
    }
    state applicationNodeID: Int(0)
    while applicationNodeID < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: applicationNodeID, column: 1) == compilerSyntaxKindApplication()
            && compilerBodyArenaNodeHasScheduledEvaluation(arena: arena, nodeID: applicationNodeID)
            && compilerBodyArenaApplicationHasResolvedCallee(arena: arena, applicationNodeID: applicationNodeID) {
            let applicationCalleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
            let applicationResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: applicationCalleeNodeID))
            if applicationCalleeNodeID < 0 || applicationResolutionRow < 0 { return 0 - 1 }
            let applicationTargetKind: Int(compilerIntTableValue(table: arena.resolutions, row: applicationResolutionRow, column: compilerBodyResolutionTargetKindColumn()))
            let role: Int(compilerBodyArenaRuntimeBuiltinRoleForApplication(arena: arena, applicationNodeID: applicationNodeID))
            if applicationTargetKind == compilerBodyResolutionFunction() || applicationTargetKind == compilerBodyResolutionConstruct() || role == compilerRuntimeABIFunctionCreate() {
                let resultTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: applicationResolutionRow, column: compilerBodyResolutionTypeIDColumn()))
                let resultTrackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: resultTypeID))
                if resultTrackedStatus < 0 { return 0 - 1 }
                if resultTrackedStatus == 1 {
                    let resultRootPathID: Int(compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: applicationNodeID, parentPathID: 0 - 1, memberRow: 0 - 1, typeID: resultTypeID, policy: compilerBodyOwnedPathPolicyOwned()))
                    if resultRootPathID < 0 { return 0 - 1 }
                    if compilerBodyArenaAppendOwnedPathDescendants(arena: arena, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: applicationNodeID, parentPathID: resultRootPathID, typeID: resultTypeID, policy: compilerBodyOwnedPathPolicyOwned(), depth: 0) != 0 { return 0 - 1 }
                }
            }
            if role != compilerRuntimeABIFunctionNone() {
                let functionID: Int(compilerBodyArenaRuntimeBuiltinFunctionIDForApplication(arena: arena, applicationNodeID: applicationNodeID))
                let storageOrdinal: Int(compilerBodyArenaRuntimeStorageArgumentOrdinal(arena: arena, functionRow: functionID))
                let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
                let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
                if functionID < 0 || calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
                let resultTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
                state storageTypeID: Int(0 - 1)
                if role == compilerRuntimeABIFunctionCreate() {
                    storageTypeID: resultTypeID
                } else if storageOrdinal >= 0 {
                    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 2) + storageOrdinal)
                    let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: firstParameterRow, column: 1))
                    storageTypeID: compilerBodyArenaTypeIDForSpan(arena: arena, fileID: parameterFileID, start: compilerIntTableValue(table: arena.tables.parameters, row: firstParameterRow, column: 8), end: compilerIntTableValue(table: arena.tables.parameters, row: firstParameterRow, column: 9))
                }
                if functionID < 0 || storageTypeID < 0 || !compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: storageTypeID)
                    || (role != compilerRuntimeABIFunctionCreate() && storageOrdinal < 0) { return 0 - 1 }
                if compilerBodyRuntimeCallContractAppend(contracts: arena.runtimeCallContracts, callNodeID: applicationNodeID, functionID: functionID, role: role, storageArgumentOrdinal: storageOrdinal, storageTypeID: storageTypeID) < 0 { return 0 - 1 }
            }
        }
        applicationNodeID: applicationNodeID + 1
    }
    state coalescingNodeID: Int(0)
    while coalescingNodeID < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: coalescingNodeID, column: 1) == compilerSyntaxKindOptionalCoalescing()
            && compilerBodyArenaNodeHasScheduledEvaluation(arena: arena, nodeID: coalescingNodeID) {
            let resultTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: coalescingNodeID))
            let resultTrackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: resultTypeID))
            if resultTypeID < 0 || resultTrackedStatus < 0 { return 0 - 1 }
            if resultTrackedStatus == 1 {
                let resultRootPathID: Int(compilerBodyOwnedPathAppend(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: coalescingNodeID, parentPathID: 0 - 1, memberRow: 0 - 1, typeID: resultTypeID, policy: compilerBodyOwnedPathPolicyOwned()))
                if resultRootPathID < 0
                    || compilerBodyArenaAppendOwnedPathDescendants(arena: arena, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: coalescingNodeID, parentPathID: resultRootPathID, typeID: resultTypeID, policy: compilerBodyOwnedPathPolicyOwned(), depth: 0) != 0 { return 0 - 1 }
            }
        }
        coalescingNodeID: coalescingNodeID + 1
    }
    applicationNodeID: 0
    while applicationNodeID < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: applicationNodeID, column: 1) == compilerSyntaxKindApplication()
            && compilerBodyArenaNodeHasScheduledEvaluation(arena: arena, nodeID: applicationNodeID)
            && compilerBodyArenaApplicationHasResolvedCallee(arena: arena, applicationNodeID: applicationNodeID)
            && compilerBodyArenaBuildBindingAliasTopologyForConstruct(arena: arena, applicationNodeID: applicationNodeID) != 0 { return 0 - 1 }
        applicationNodeID: applicationNodeID + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID >= 0 && valueNodeID < compilerIntTableRowCount(table: arena.nodes)
        && compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) == compilerSyntaxKindGrouping() {
        let groupedValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        if groupedValueNodeID < 0 || groupedValueNodeID == valueNodeID { return 0 - 1 }
        return compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: groupedValueNodeID)
    }
    let localSymbolID: Int(compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: valueNodeID))
    if localSymbolID >= 0 { return compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: localSymbolID, memberRow: 0 - 1) }
    if valueNodeID >= 0 && valueNodeID < compilerIntTableRowCount(table: arena.nodes)
        && compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) == compilerSyntaxKindOptionalCoalescing() {
        return compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: valueNodeID, memberRow: 0 - 1)
    }
    if valueNodeID >= 0 && valueNodeID < compilerIntTableRowCount(table: arena.nodes)
        && compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
        if calleeNodeID >= 0 && resolutionRow >= 0
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionBuiltin()
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()) == compilerBodyBuiltinString() {
            let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
            let argumentValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if argumentNodeID >= 0 && argumentValueNodeID >= 0
                && compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: argumentValueNodeID) == compilerBodyTypeString() {
                return compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: argumentValueNodeID)
            }
        }
        let callPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: valueNodeID, memberRow: 0 - 1))
        if callPathID >= 0 { return callPathID }
    }
    let memberRow: Int(compilerBodyArenaMemberRowForValue(arena: arena, valueNodeID: valueNodeID))
    if memberRow < 0 { return 0 - 1 }
    let receiverSymbolID: Int(compilerBodyArenaMemberReceiverSymbolForValue(arena: arena, valueNodeID: valueNodeID))
    if receiverSymbolID >= 0 {
        let directPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: receiverSymbolID, memberRow: memberRow))
        if directPathID >= 0 { return directPathID }
    }
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    if receiverNodeID < 0 || receiverNodeID == valueNodeID { return 0 - 1 }
    let receiverPathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: receiverNodeID))
    if receiverPathID >= 0 {
        let receiverTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: receiverNodeID))
        let receiverTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: receiverNodeID))
        let transparentMemberRow: Int(compilerBodyArenaTransparentStorageMemberRowForType(arena: arena, typeKind: receiverTypeKind, typeID: receiverTypeID))
        if memberRow == transparentMemberRow { return receiverPathID }
        return compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: receiverPathID, memberRow: memberRow)
    }
    return 0 - 1
}

function compilerBodyArenaValueIsStaticStringLiteral(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    let localSymbolID: Int(compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: valueNodeID))
    if localSymbolID >= 0 {
        if compilerIntTableValue(table: arena.symbols, row: localSymbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState() { return false }
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: localSymbolID, column: compilerBodySymbolDeclarationColumn()))
        let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
        return initializerNodeID >= 0
            && initializerNodeID != valueNodeID
            && compilerBodyArenaValueIsStaticStringLiteral(arena: arena, valueNodeID: initializerNodeID)
    }
    if compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) == compilerSyntaxKindStringLiteral() { return true }
    if compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindApplication() { return false }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionBuiltin()
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()) != compilerBodyBuiltinString() { return false }
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
    let argumentValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
    return argumentNodeID >= 0 && argumentValueNodeID >= 0
        && compilerIntTableValue(table: arena.nodes, row: argumentValueNodeID, column: 1) == compilerSyntaxKindStringLiteral()
}

function compilerBodyArenaValueIsEphemeralString(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    let localSymbolID: Int(compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: valueNodeID))
    if localSymbolID >= 0 {
        if compilerIntTableValue(table: arena.symbols, row: localSymbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState() { return false }
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: localSymbolID, column: compilerBodySymbolDeclarationColumn()))
        let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
        return initializerNodeID >= 0
            && initializerNodeID != valueNodeID
            && compilerBodyArenaValueIsEphemeralString(arena: arena, valueNodeID: initializerNodeID)
    }
    let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1))
    if nodeKind == compilerSyntaxKindInterpolatedString() { return true }
    if nodeKind != compilerSyntaxKindApplication()
        || compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID) != compilerBodyTypeString() { return false }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0 { return false }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    if targetKind == compilerBodyResolutionBuiltin()
        && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()) == compilerBodyBuiltinString() {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
        let argumentValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
        return argumentNodeID >= 0
            && argumentValueNodeID >= 0
            && compilerBodyArenaValueIsEphemeralString(arena: arena, valueNodeID: argumentValueNodeID)
    }
    return calleeNodeID >= 0
        && (targetKind == compilerBodyResolutionRuntimeBuiltin()
            || targetKind == compilerBodyResolutionMemberRuntimeBuiltin()
            || targetKind == compilerBodyResolutionExtern())
}

function compilerBodyArenaValueIsNonOwningStringView(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    return compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID) == compilerBodyTypeString()
        && (compilerBodyArenaValueIsStaticStringLiteral(arena: arena, valueNodeID: valueNodeID)
            || compilerBodyArenaValueIsEphemeralString(arena: arena, valueNodeID: valueNodeID))
}

function compilerBodyArenaValueIsSyntaxQueryProjection(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    if arena.ownerKind != compilerBodyArenaOwnerClosure()
        || valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    state rootNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps
        && compilerIntTableValue(table: arena.nodes, row: rootNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        rootNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: rootNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
        if rootNodeID < 0 || rootNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
        step: step + 1
    }
    if step == 0 || step >= maximumSteps { return false }
    let symbolID: Int(compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: rootNodeID))
    return symbolID >= 0
        && symbolID < compilerIntTableRowCount(table: arena.symbols)
        && compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolClosureParameter()
}

function compilerBodyArenaSyntaxQueryDerivedSource(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let valueKind: Int(compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1))
    if valueKind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        if calleeNodeID < 0 { return 0 - 1 }
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
        if resolutionRow < 0 { return 0 - 1 }
        let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
        if targetKind != compilerBodyResolutionMacroSyntaxFilter()
            && targetKind != compilerBodyResolutionMacroCollectionTransform() { return 0 - 1 }
        return compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
    }
    if valueKind != compilerSyntaxKindIdentifier() { return 0 - 1 }
    let symbolID: Int(compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: valueNodeID))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolLet() { return 0 - 1 }
    let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    return compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0)
}

function compilerBodyArenaValueIsDerivedSyntaxQueryProjection(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    state sourceNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        if compilerBodyArenaValueIsSyntaxQueryProjection(arena: arena, valueNodeID: sourceNodeID) { return true }
        let nextSourceNodeID: Int(compilerBodyArenaSyntaxQueryDerivedSource(arena: arena, valueNodeID: sourceNodeID))
        if nextSourceNodeID < 0 || nextSourceNodeID == sourceNodeID { return false }
        sourceNodeID: nextSourceNodeID
        step: step + 1
    }
    return false
}

function compilerBodyArenaValueHasNoTrackedFunctionReturn(arena: CompilerBodyArena, valueNodeID: Int, returnSummaries: CompilerIntTable): Bool {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    if compilerBodyArenaValueIsSyntaxQueryProjection(arena: arena, valueNodeID: valueNodeID) { return true }
    let localSymbolID: Int(compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: valueNodeID))
    if localSymbolID >= 0 {
        if compilerIntTableValue(table: arena.symbols, row: localSymbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState() { return false }
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: localSymbolID, column: compilerBodySymbolDeclarationColumn()))
        let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
        return initializerNodeID >= 0
            && initializerNodeID != valueNodeID
            && compilerBodyArenaValueHasNoTrackedFunctionReturn(arena: arena, valueNodeID: initializerNodeID, returnSummaries: returnSummaries)
    }
    let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1))
    if nodeKind == compilerSyntaxKindGrouping() {
        let groupedValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        return groupedValueNodeID >= 0
            && compilerBodyArenaValueHasNoTrackedFunctionReturn(arena: arena, valueNodeID: groupedValueNodeID, returnSummaries: returnSummaries)
    }
    if nodeKind != compilerSyntaxKindApplication()
        || compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID) != compilerBodyTypeString() { return false }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionFunction() { return false }
    let targetInstanceID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionInstanceIDColumn()))
    return targetInstanceID >= 0
        && targetInstanceID < compilerIntTableRowCount(table: returnSummaries)
        && compilerIntTableValue(table: returnSummaries, row: targetInstanceID, column: compilerReachableFunctionInstanceReturnSummaryStatusColumn()) == compilerReachableFunctionInstanceReturnSummaryNoTrackedStorage()
}

function compilerBodyArenaTransparentStorageMemberRowForType(arena: CompilerBodyArena, typeKind: Int, typeID: Int): Int {
    state constructSyntaxID: Int(0 - 1)
    if typeKind == compilerBodyTypeString() {
        constructSyntaxID: compilerBodyArenaStringDeclarationSyntaxID(arena: arena)
    } else if typeKind == compilerBodyTypeConstruct()
        && typeID >= 0
        && typeID < compilerIntTableRowCount(table: arena.typeInstances) {
        constructSyntaxID: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn())
    }
    if constructSyntaxID < 0 { return 0 - 1 }
    return compilerRuntimeABITransparentStorageMemberRow(tables: arena.tables, constructNodeID: constructSyntaxID)
}

function compilerBodyArenaMemberProjectionIsTransparent(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    if valueNodeID < 0
        || valueNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindMemberRead() { return false }
    let memberRow: Int(compilerBodyArenaMemberRowForValue(arena: arena, valueNodeID: valueNodeID))
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    if memberRow < 0 || receiverNodeID < 0 { return false }
    return memberRow == compilerBodyArenaTransparentStorageMemberRowForType(
        arena: arena,
        typeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: receiverNodeID),
        typeID: compilerBodyArenaExpressionTypeID(arena: arena, nodeID: receiverNodeID)
    )
}

function compilerBodyArenaUngroupedValueNodeID(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    state currentNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps && compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1) == compilerSyntaxKindGrouping() {
        let groupedValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        if groupedValueNodeID < 0 || groupedValueNodeID >= compilerIntTableRowCount(table: arena.nodes) || groupedValueNodeID == currentNodeID { return 0 - 1 }
        currentNodeID: groupedValueNodeID
        step: step + 1
    }
    if step >= maximumSteps { return 0 - 1 }
    return currentNodeID
}

function compilerBodyArenaOwnedPathSetState(states: Buffer<Int>, pathID: Int, stateValue: Int): Int {
    if pathID < 0 || pathID >= states.count { return 0 - 1 }
    return states.update(element: stateValue, index: pathID)
}

function compilerBodyArenaOwnedPathState(states: Buffer<Int>, pathID: Int): Int {
    if pathID < 0 || pathID >= states.count { return 0 - 1 }
    return states.element(index: pathID)
}

function compilerBodyArenaOwnedPathSetOrigin(origins: Buffer<Int>, pathID: Int, originPathID: Int): Int {
    if pathID < 0 || pathID >= origins.count { return 0 - 1 }
    return origins.update(element: originPathID, index: pathID)
}

function compilerBodyArenaOwnedPathSetLocalOrigin(arena: CompilerBodyArena, origins: Buffer<Int>, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned() { return 0 - 1 }
    return compilerBodyArenaOwnedPathSetOrigin(origins: origins, pathID: pathID, originPathID: compilerBodyOwnedOriginLocal())
}

function compilerBodyArenaOwnedPathOrigin(origins: Buffer<Int>, pathID: Int): Int {
    if pathID < 0 || pathID >= origins.count { return compilerBodyOwnedOriginInvalid() }
    return origins.element(index: pathID)
}

function compilerBodyArenaOwnedPathOriginIsBoundary(arena: CompilerBodyArena, originPathID: Int): Bool {
    return originPathID >= 0 && originPathID < compilerIntTableRowCount(table: arena.ownedPaths)
        && compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: originPathID) == compilerBodyOwnedSummaryRootBoundary()
        && compilerIntTableValue(table: arena.ownedPaths, row: originPathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyBorrowed()
        && compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: originPathID, column: compilerBodyOwnedPathTypeColumn()))
}

function compilerBodyArenaOwnedPathApplyEffect(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathID: Int, effectKind: Int): Int {
    if compilerBodyArenaOwnedPathState(states: states, pathID: pathID) != compilerBodyOwnedPathLive() { return 0 - 1 }
    if effectKind == compilerBodyOwnedEffectConsume() {
        let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
        let originPathID: Int(compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: pathID))
        if pathPolicy == compilerBodyOwnedPathPolicyAlias()
            || (pathPolicy == compilerBodyOwnedPathPolicyOwned() && originPathID != compilerBodyOwnedOriginLocal())
            || (pathPolicy == compilerBodyOwnedPathPolicyBorrowed() && !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID)) { return 0 - 1 }
        return compilerBodyArenaOwnedPathSetState(states: states, pathID: pathID, stateValue: compilerBodyOwnedPathConsumed())
    }
    if effectKind == compilerBodyOwnedEffectShared() || effectKind == compilerBodyOwnedEffectUnique() { return 0 }
    return 0 - 1
}

function compilerBodyArenaOwnedPathApplyEffectThroughAlias(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathID: Int, effectKind: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    if compilerBodyArenaOwnedPathState(states: states, pathID: pathID) != compilerBodyOwnedPathLive() { return 0 - 1 }
    let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
    if pathPolicy == compilerBodyOwnedPathPolicyAlias() && effectKind == compilerBodyOwnedEffectConsume() { return 0 - 1 }
    let targetPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
    if targetPathID < 0 || compilerBodyArenaOwnedPathApplyEffect(arena: arena, states: states, origins: origins, pathID: targetPathID, effectKind: effectKind) != 0 { return 0 - 1 }
    return targetPathID
}

function compilerBodyArenaOwnedEffectForRuntimeRole(role: Int): Int {
    if role == compilerRuntimeABIFunctionSharedRead() { return compilerBodyOwnedEffectShared() }
    if role == compilerRuntimeABIFunctionUniqueWrite() { return compilerBodyOwnedEffectUnique() }
    if role == compilerRuntimeABIFunctionDestroy() { return compilerBodyOwnedEffectConsume() }
    return compilerBodyOwnedEffectNone()
}

function compilerBodyArenaOwnedMemoryFactForEffect(effectKind: Int): Int {
    if effectKind == compilerBodyOwnedEffectShared() { return compilerBodyMemoryFactSharedBorrow() }
    if effectKind == compilerBodyOwnedEffectUnique() { return compilerBodyMemoryFactUniqueBorrow() }
    if effectKind == compilerBodyOwnedEffectConsume() { return compilerBodyMemoryFactConsume() }
    return 0 - 1
}

function compilerBodyArenaOwnedPathApplyRuntimeContract(arena: CompilerBodyArena, contractRow: Int, states: Buffer<Int>, origins: Buffer<Int>, recordFacts: Bool): Int {
    let callNodeID: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractCallNodeColumn()))
    let role: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractRoleColumn()))
    if role == compilerRuntimeABIFunctionCreate() {
        let resultPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootEvaluation(), rootID: callNodeID, memberRow: 0 - 1))
        let storageTypeID: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractStorageTypeColumn()))
        if resultPathID < 0
            || compilerIntTableValue(table: arena.ownedPaths, row: resultPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned()
            || compilerIntTableValue(table: arena.ownedPaths, row: resultPathID, column: compilerBodyOwnedPathTypeColumn()) != storageTypeID
            || !compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: storageTypeID)
            || !compilerBodyArenaOwnedPathSubtreeIsAbsentAt(arena: arena, states: states, origins: origins, rootPathID: resultPathID, blockID: 0 - 1, pathCount: compilerIntTableRowCount(table: arena.ownedPaths)) { return 0 - 1 }
        if compilerBodyArenaOwnedPathSetState(states: states, pathID: resultPathID, stateValue: compilerBodyOwnedPathLive()) != 0
            || compilerBodyArenaOwnedPathSetLocalOrigin(arena: arena, origins: origins, pathID: resultPathID) != 0 { return 0 - 1 }
        if recordFacts {
            if compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: compilerBodyMemoryFactResourceCreate(), sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: resultPathID, auxID: storageTypeID) < 0 { return 0 - 1 }
        }
        return 0
    }
    let storageArgumentOrdinal: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractStorageArgumentColumn()))
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: callNodeID, role: compilerSyntaxRoleArgument(), ordinal: storageArgumentOrdinal))
    if argumentNodeID < 0 { return 0 - 1 }
    let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
    if valueNodeID < 0 { return 0 - 1 }
    let pathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: valueNodeID))
    if pathID < 0 { return 0 - 1 }
    let effectKind: Int(compilerBodyArenaOwnedEffectForRuntimeRole(role: role))
    if effectKind == compilerBodyOwnedEffectNone() { return 0 - 1 }
    if effectKind == compilerBodyOwnedEffectConsume() && compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: valueNodeID) { return 0 - 1 }
    let effectTargetPathID: Int(compilerBodyArenaOwnedPathApplyEffectThroughAlias(arena: arena, states: states, origins: origins, pathID: pathID, effectKind: effectKind))
    if effectTargetPathID < 0 { return 0 - 1 }
    let factKind: Int(compilerBodyArenaOwnedMemoryFactForEffect(effectKind: effectKind))
    if recordFacts && factKind >= 0 {
        if compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: factKind, sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: effectTargetPathID, auxID: compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractStorageTypeColumn())) < 0 { return 0 - 1 }
    }
    return 0
}

function compilerBodyArenaOwnedPathIsDescendant(arena: CompilerBodyArena, pathID: Int, ancestorPathID: Int): Bool {
    state currentPathID: Int(pathID)
    while currentPathID >= 0 {
        if currentPathID == ancestorPathID { return true }
        if currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return false }
        currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
    }
    return false
}

function compilerBodyArenaOwnedPathSetSubtreeState(arena: CompilerBodyArena, states: Buffer<Int>, rootPathID: Int, expectedState: Int, nextState: Int): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    if rootPathID < 0 || rootPathID >= pathCount || states.count < pathCount { return 0 - 1 }
    state pathRow: Int(0)
    while pathRow < pathCount {
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathRow, ancestorPathID: rootPathID) {
            if compilerBodyArenaOwnedPathState(states: states, pathID: pathRow) != expectedState { return 0 - 1 }
        }
        pathRow: pathRow + 1
    }
    pathRow: 0
    while pathRow < pathCount {
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathRow, ancestorPathID: rootPathID) {
            if compilerBodyArenaOwnedPathSetState(states: states, pathID: pathRow, stateValue: nextState) != 0 { return 0 - 1 }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathRootPathID(arena: CompilerBodyArena, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    state rootPathID: Int(pathID)
    state parentPathID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathParentColumn()))
    while parentPathID >= 0 {
        if parentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
        rootPathID: parentPathID
        parentPathID: compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathParentColumn())
    }
    return rootPathID
}

function compilerBodyArenaOwnedPathActivationKindForRoot(arena: CompilerBodyArena, rootPathID: Int): Int {
    if rootPathID < 0 || rootPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathParentColumn()) >= 0 { return compilerBodyOwnedPathActivationInvalid() }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
    if rootKind == compilerBodyOwnedPathRootEvaluation() { return compilerBodyOwnedPathActivationEvaluationTemporary() }
    if rootKind != compilerBodyOwnedPathRootSymbol() { return compilerBodyOwnedPathActivationInvalid() }
    let symbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return compilerBodyOwnedPathActivationInvalid() }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver() { return compilerBodyOwnedPathActivationBoundary() }
    if symbolKind == compilerBodySymbolLet() || symbolKind == compilerBodySymbolState() { return compilerBodyOwnedPathActivationLexicalSymbol() }
    return compilerBodyOwnedPathActivationInvalid()
}

function compilerBodyArenaOwnedPathActivationKind(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    return compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID)
}

function compilerBodyArenaOwnedPathActivationRegionForRoot(arena: CompilerBodyArena, rootPathID: Int): Int {
    if compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID) != compilerBodyOwnedPathActivationLexicalSymbol()
        || compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()) != compilerBodyOwnedPathRootSymbol() { return 0 - 1 }
    let symbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    return compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolRegionColumn())
}

function compilerBodyArenaOwnedPathActivationRegion(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    return compilerBodyArenaOwnedPathActivationRegionForRoot(arena: arena, rootPathID: rootPathID)
}

function compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: Buffer<Int>, pathID: Int, pathCount: Int): Int {
    if pathID < 0 || pathID >= pathCount || pathRoots.count != pathCount { return 0 - 1 }
    let rootPathID: Int(pathRoots.element(index: pathID))
    if rootPathID < 0 || rootPathID >= pathCount { return 0 - 1 }
    return rootPathID
}

function compilerBodyArenaOwnedPathInitializeDescriptorCaches(arena: CompilerBodyArena, pathRoots: Buffer<Int>, canonicalPaths: Buffer<Int>, evaluationProducers: Buffer<Int>, nodeEvaluationRoots: Buffer<Int>, producerCounts: Buffer<Int>): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    let nodeCount: Int(compilerIntTableRowCount(table: arena.nodes))
    if pathRoots.count != 0 || canonicalPaths.count != 0
        || evaluationProducers.count != 0 || nodeEvaluationRoots.count != 0
        || producerCounts.count != 0 { return 0 - 1 }
    state nodeID: Int(0)
    while nodeID < nodeCount {
        if nodeEvaluationRoots.append(element: 0 - 1) != 0 { return 0 - 1 }
        nodeID: nodeID + 1
    }
    state pathID: Int(0)
    while pathID < pathCount {
        let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
        let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
        if rootPathID < 0 || canonicalPathID < 0
            || pathRoots.append(element: rootPathID) != 0
            || canonicalPaths.append(element: canonicalPathID) != 0
            || evaluationProducers.append(element: 0 - 1) != 0
            || producerCounts.append(element: 0) != 0 { return 0 - 1 }
        pathID: pathID + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathIndexEvaluationRoots(arena: CompilerBodyArena, pathRoots: Buffer<Int>, nodeEvaluationRoots: Buffer<Int>): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    let nodeCount: Int(compilerIntTableRowCount(table: arena.nodes))
    if pathRoots.count != pathCount || nodeEvaluationRoots.count != nodeCount { return 0 - 1 }
    state rootPathID: Int(0)
    while rootPathID < pathCount {
        if compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: rootPathID, pathCount: pathCount) == rootPathID
            && compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID) == compilerBodyOwnedPathActivationEvaluationTemporary() {
            let applicationNodeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
            if applicationNodeID < 0 || applicationNodeID >= nodeCount
                || (compilerIntTableValue(table: arena.nodes, row: applicationNodeID, column: 1) != compilerSyntaxKindApplication()
                    && compilerIntTableValue(table: arena.nodes, row: applicationNodeID, column: 1) != compilerSyntaxKindOptionalCoalescing())
                || nodeEvaluationRoots.element(index: applicationNodeID) >= 0
                || nodeEvaluationRoots.update(element: rootPathID, index: applicationNodeID) != 0 { return 0 - 1 }
        }
        rootPathID: rootPathID + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathCollectEvaluationProducers(arena: CompilerBodyArena, pathRoots: Buffer<Int>, evaluationProducers: Buffer<Int>, nodeEvaluationRoots: Buffer<Int>, producerCounts: Buffer<Int>): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    let nodeCount: Int(compilerIntTableRowCount(table: arena.nodes))
    if pathRoots.count != pathCount || evaluationProducers.count != pathCount
        || producerCounts.count != pathCount || nodeEvaluationRoots.count != nodeCount { return 0 - 1 }
    state scheduleRow: Int(0)
    while scheduleRow < compilerIntTableRowCount(table: arena.cfgSchedule) {
        let scheduleAction: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleActionColumn()))
        if scheduleAction == compilerBodyCFGScheduleEvaluateNode() || scheduleAction == compilerBodyCFGScheduleOptionalJoin() {
            let scheduleNodeID: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleNodeColumn()))
            if scheduleNodeID < 0 || scheduleNodeID >= nodeCount {
                return 0 - 1
            } else {
                let scheduledRootPathID: Int(nodeEvaluationRoots.element(index: scheduleNodeID))
                if scheduledRootPathID >= 0 {
                    let producerCount: Int(producerCounts.element(index: scheduledRootPathID))
                    if producerCounts.update(element: producerCount + 1, index: scheduledRootPathID) != 0
                        || evaluationProducers.update(element: compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleBlockColumn()), index: scheduledRootPathID) != 0 { return 0 - 1 }
                }
            }
        }
        scheduleRow: scheduleRow + 1
    }
    state rootPathID: Int(0)
    while rootPathID < pathCount {
        if compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: rootPathID, pathCount: pathCount) == rootPathID
            && compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID) == compilerBodyOwnedPathActivationEvaluationTemporary() {
            let producerBlockID: Int(evaluationProducers.element(index: rootPathID))
            if producerCounts.element(index: rootPathID) != 1
                || producerBlockID < 0 || producerBlockID >= compilerIntTableRowCount(table: arena.cfgBlocks) { return 0 - 1 }
        }
        rootPathID: rootPathID + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathBuildDescriptorCaches(arena: CompilerBodyArena, pathRoots: Buffer<Int>, canonicalPaths: Buffer<Int>, evaluationProducers: Buffer<Int>): Int {
    let nodeEvaluationRoots: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.nodes)))
    let producerCounts: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.ownedPaths)))
    state status: Int(compilerBodyArenaOwnedPathInitializeDescriptorCaches(arena: arena, pathRoots: pathRoots, canonicalPaths: canonicalPaths, evaluationProducers: evaluationProducers, nodeEvaluationRoots: nodeEvaluationRoots, producerCounts: producerCounts))
    if status == 0 { status: compilerBodyArenaOwnedPathIndexEvaluationRoots(arena: arena, pathRoots: pathRoots, nodeEvaluationRoots: nodeEvaluationRoots) }
    if status == 0 { status: compilerBodyArenaOwnedPathCollectEvaluationProducers(arena: arena, pathRoots: pathRoots, evaluationProducers: evaluationProducers, nodeEvaluationRoots: nodeEvaluationRoots, producerCounts: producerCounts) }
    if nodeEvaluationRoots.destroy() != 0 { status: 0 - 1 }
    if producerCounts.destroy() != 0 { status: 0 - 1 }
    return status
}

