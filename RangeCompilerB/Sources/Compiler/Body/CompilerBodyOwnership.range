                                let instanceEffectStatus: Int(compilerBodyArenaOwnedPathApplyInstanceEffects(arena: arena, applicationNodeID: nodeID, states: states, origins: origins, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, effects: effects, effectPaths: effectPaths, recordFacts: recordFacts))
                                compilerProbeEnd(probe: instanceEffectsProbe, status: instanceEffectStatus, resultCount: targetKind)
                                if instanceEffectStatus != 0 { status: 0 - 22 }
                            }
                            if status == 0 && targetKind == compilerBodyResolutionFunction() {
                                let returnTransferProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationReturnTransfer(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: nodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
                                let returnTransferStatus: Int(compilerBodyArenaOwnedPathApplyReturnTransfer(arena: arena, applicationNodeID: nodeID, states: states, origins: origins, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, returnLeaves: returnLeaves, effectPaths: effectPaths, recordFacts: recordFacts))
                                compilerProbeEnd(probe: returnTransferProbe, status: returnTransferStatus, resultCount: targetKind)
                                if returnTransferStatus != 0 {
