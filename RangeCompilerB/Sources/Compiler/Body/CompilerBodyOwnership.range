            if compilerBodyArenaOwnedPathRootEdgeRefinesOptionalPayloadAbsent(arena: arena, sourceBlockID: sourceBlockID, targetBlockID: targetBlockID, rootPathID: rootPathID) {
                if projection.update(element: compilerBodyOwnedPathProjectionAbsent(), index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: rootPathID, column: compilerBodyOwnedPathProjectionDecisionColumn())) != 0 { return 0 - 1 }
            } else if compilerBodyArenaOwnedPathRootEdgeExitsLexicalActivation(arena: arena, sourceBlockID: sourceBlockID, targetBlockID: targetBlockID, rootPathID: rootPathID) {
                if projection.update(element: compilerBodyOwnedPathProjectionCandidate(), index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: rootPathID, column: compilerBodyOwnedPathProjectionDecisionColumn())) != 0 { return 0 - 1 }
            }
        }
        rootPathID: rootPathID + 1
    }
    pathID: 0
    while pathID < pathCount {
        rootPathID: compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: pathID, pathCount: pathCount)
        if rootPathID < 0 { return 0 - 1 }
        if projection.element(index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: rootPathID, column: compilerBodyOwnedPathProjectionDecisionColumn())) == compilerBodyOwnedPathProjectionCandidate() {
            let stateValue: Int(compilerBodyArenaOwnedPathStateAt(states: states, pathID: pathID, blockID: sourceBlockID, pathCount: pathCount))
            if stateValue != compilerBodyOwnedPathAbsent() {
                if projection.update(element: 0, index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: rootPathID, column: compilerBodyOwnedPathProjectionAllAbsentColumn())) != 0 { return 0 - 1 }
            }
            if stateValue != compilerBodyOwnedPathAbsent()
                && compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn())) {
                state leafStatus: Int(1)
                if !compilerBodyArenaOwnedPathOpaqueLeafCanDeactivateCachedAt(arena: arena, states: states, origins: origins, pathRoots: pathRoots, canonicalPaths: canonicalPaths, pathID: pathID, blockID: sourceBlockID, pathCount: pathCount) {
                    let pathState: Int(compilerBodyArenaOwnedPathStateAt(states: states, pathID: pathID, blockID: sourceBlockID, pathCount: pathCount))
                    let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
                    let originPathID: Int(compilerBodyArenaOwnedPathOriginAt(origins: origins, pathID: pathID, blockID: sourceBlockID, pathCount: pathCount))
                    state hasImplicitLexicalStringDestroy: Bool(false)
