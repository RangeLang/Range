                            }
                        }
                    }
                }
            } else if action == compilerBodyCFGScheduleOptionalPayload() || action == compilerBodyCFGScheduleOptionalFallback() {
                let nodeID: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleNodeColumn()))
                let optionalBranchProbe: CompilerProbe(compilerProbeBegin(kind: compilerProbeKindOwnedValidationOptionalBranch(), functionID: arena.ownerFunctionRow, instanceID: arena.ownerFunctionInstanceID, blockID: blockID, nodeID: nodeID, ordinal: scheduleOrdinal, itemCount: blockScheduleCount))
                let coalescingStatus: Int(compilerBodyArenaOwnedPathApplyOptionalCoalescingBranch(arena: arena, nodeID: nodeID, action: action, blockID: blockID, states: states, origins: origins, effectPaths: effectPaths, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, recordFacts: recordFacts))
                compilerProbeEnd(probe: optionalBranchProbe, status: coalescingStatus, resultCount: action)
                if coalescingStatus != 0 {
                    status: 0 - (24000000 + nodeID * 1000 + (0 - coalescingStatus))
