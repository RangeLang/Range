function compilerBodyArenaOwnedPathRelativeEffectPath(arena: CompilerBodyArena, basePathID: Int, leafPathID: Int, effectPaths: CompilerIntTable): Int {
    if basePathID < 0 || leafPathID < 0 || !compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: leafPathID, ancestorPathID: basePathID) { return 0 - 2 }
    if basePathID == leafPathID { return 0 - 1 }
    let members: Buffer<Int>(bufferCreateInt(capacity: 8))
    state currentPathID: Int(leafPathID)
    state status: Int(0)
    while currentPathID != basePathID && status == 0 {
        if currentPathID < 0 || currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) {
            status: 0 - 1
        } else {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn()))
            if memberRow < 0 || members.append(element: memberRow) != 0 { status: 0 - 1 }
            currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
        }
