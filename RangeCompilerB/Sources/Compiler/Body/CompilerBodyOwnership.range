                        && originPathID == compilerBodyOwnedOriginLocal()
                        && compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn())) == compilerBodyTypeString()
                        && compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()) == compilerBodyOwnedPathRootSymbol() {
                        let symbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
                        if symbolID >= 0 && symbolID < compilerIntTableRowCount(table: arena.symbols) {
                            let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
                            if symbolKind == compilerBodySymbolLet() || symbolKind == compilerBodySymbolState() {
                                hasImplicitLexicalStringDestroy: true
                            }
                        }
                    }
                    if !hasImplicitLexicalStringDestroy {
                        return 0 - (100000 + pathID * 1000 + pathState * 100 + pathPolicy * 10)
                    }
                } else if projection.element(index: compilerBodyArenaOwnedPathProjectionIndex(rootPathID: rootPathID, column: compilerBodyOwnedPathProjectionDeactivationColumn())) < 0 {
                    leafStatus: 0 - 1
