function compilerBodyArenaOwnedPathRootEdgeRefinesOptionalPayloadAbsent(arena: CompilerBodyArena, sourceBlockID: Int, targetBlockID: Int, rootPathID: Int): Bool {
    if sourceBlockID < 0 || sourceBlockID >= compilerIntTableRowCount(table: arena.cfgBlocks)
        || targetBlockID < 0 || targetBlockID >= compilerIntTableRowCount(table: arena.cfgBlocks)
        || rootPathID < 0 || rootPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || !compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathTypeColumn()))
        || compilerIntTableValue(table: arena.cfgBlocks, row: sourceBlockID, column: compilerBodyCFGBlockTerminatorKindColumn()) != compilerBodyCFGTerminatorCondition() { return false }
    let terminatorSourceNodeID: Int(compilerIntTableValue(table: arena.cfgBlocks, row: sourceBlockID, column: compilerBodyCFGBlockTerminatorSourceColumn()))
    state edgeRole: Int(0 - 1)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) == sourceBlockID
            && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == targetBlockID {
            edgeRole: compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn())
        }
        edgeRow: edgeRow + 1
    }
    if terminatorSourceNodeID >= 0
        && compilerIntTableValue(table: arena.nodes, row: terminatorSourceNodeID, column: 1) == compilerSyntaxKindOptionalCoalescing() {
        let coalescingOptionalNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: terminatorSourceNodeID, role: compilerSyntaxRoleLeftOperand(), ordinal: 0))
        let coalescingOptionalPathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: coalescingOptionalNodeID))
        if coalescingOptionalPathID < 0 || compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: coalescingOptionalPathID) != rootPathID { return false }
        return edgeRole == compilerBodyCFGEdgeFalse()
    }
    let conditionNodeID: Int(compilerBodyArenaStatementExpression(arena: arena, statementNodeID: terminatorSourceNodeID))
    if conditionNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: conditionNodeID, column: 1) != compilerSyntaxKindEquality() { return false }
    let leftNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: conditionNodeID, role: compilerSyntaxRoleLeftOperand(), ordinal: 0))
    let rightNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: conditionNodeID, role: compilerSyntaxRoleRightOperand(), ordinal: 0))
    state optionalNodeID: Int(0 - 1)
    if compilerBodyArenaValueIsNil(arena: arena, valueNodeID: leftNodeID) {
        optionalNodeID: rightNodeID
    } else if compilerBodyArenaValueIsNil(arena: arena, valueNodeID: rightNodeID) {
        optionalNodeID: leftNodeID
    }
    if optionalNodeID < 0 { return false }
    let optionalPathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: optionalNodeID))
    if optionalPathID < 0 || compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: optionalPathID) != rootPathID { return false }
    let operatorText: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: compilerIntTableValue(table: arena.nodes, row: conditionNodeID, column: 6), localEnd: compilerIntTableValue(table: arena.nodes, row: conditionNodeID, column: 7)))
    if operatorText == String("!=") { return edgeRole == compilerBodyCFGEdgeFalse() }
    if operatorText == String("==") { return edgeRole == compilerBodyCFGEdgeTrue() }
    return false
}

