            } else if action == compilerBodyCFGScheduleStatementCommit() {
                let statementNodeID: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleNodeColumn()))
                if statementNodeID < 0 || statementNodeID >= compilerIntTableRowCount(table: arena.nodes) {
                    status: 0 - 1
