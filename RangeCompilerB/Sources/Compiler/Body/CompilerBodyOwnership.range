function compilerBodyArenaOwnedPathApplyEffectPath(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, basePathID: Int, effectPaths: CompilerIntTable, effectPathID: Int, effectKind: Int): Int {
