                    let canonicalStorageKeyID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()))
                    let canonicalTransferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferKindColumn()))
                    let canonicalSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
                    state canonicalSourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
                    state canonicalBaseKind: Int(0 - 1)
                    state canonicalOrdinal: Int(0 - 1)
                    state canonicalSourceEffectPathID: Int(0 - 1)
                    if canonicalTransferKind == compilerBodyOwnedReturnTransferAlias() || canonicalTransferKind == compilerBodyOwnedReturnTransferForward() {
                        if canonicalTransferKind == compilerBodyOwnedReturnTransferAlias() {
                            canonicalSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                        } else {
                            canonicalSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                        }
                        canonicalBaseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: canonicalSourcePathID)
                        canonicalOrdinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: canonicalSourcePathID)
                        canonicalSourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: canonicalSourcePathID, effectPaths: reachability.functionBehaviorFacts.paths)
                    }
                    if canonicalBaseKind < 0
                        && (canonicalSourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                            || canonicalSourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward()) { return 0 - 1 }
                    state matchingCount: Int(0)
                    state branchRow: Int(0)
                    while branchRow < transferCount {
                        let branchTransferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferKindColumn()))
                        let branchSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
                        state branchSourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
                        state branchBaseKind: Int(0 - 1)
                        state branchOrdinal: Int(0 - 1)
                        state branchSourceEffectPathID: Int(0 - 1)
                        if branchTransferKind == compilerBodyOwnedReturnTransferAlias() || branchTransferKind == compilerBodyOwnedReturnTransferForward() {
                            if branchTransferKind == compilerBodyOwnedReturnTransferAlias() {
                                branchSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                            } else {
                                branchSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                            }
                            branchBaseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: branchSourcePathID)
                            branchOrdinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: branchSourcePathID)
                            branchSourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: branchSourcePathID, effectPaths: reachability.functionBehaviorFacts.paths)
                        }
                        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
                            && compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == canonicalPathID
                            && compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()) == canonicalStorageKeyID
                            && branchTransferKind == canonicalTransferKind
                            && branchSourceKind == canonicalSourceKind
                            && branchBaseKind == canonicalBaseKind
                            && branchOrdinal == canonicalOrdinal
                            && branchSourceEffectPathID == canonicalSourceEffectPathID { matchingCount: matchingCount + 1 }
                        branchRow: branchRow + 1
                    }
                    if matchingCount != 1 {
                        state mismatchMask: Int(0)
                        state candidateRow: Int(0)
                        while candidateRow < transferCount {
                            if compilerIntTableValue(table: arena.ownedReturnTransfers, row: candidateRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
                                && compilerIntTableValue(table: arena.ownedReturnTransfers, row: candidateRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == canonicalPathID {
                                let candidateTransferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: candidateRow, column: compilerBodyOwnedReturnTransferKindColumn()))
                                let candidateSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: candidateRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
                                state candidateSourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
                                state candidateBaseKind: Int(0 - 1)
                                state candidateOrdinal: Int(0 - 1)
                                state candidateSourceEffectPathID: Int(0 - 1)
                                if candidateTransferKind == compilerBodyOwnedReturnTransferAlias() || candidateTransferKind == compilerBodyOwnedReturnTransferForward() {
                                    if candidateTransferKind == compilerBodyOwnedReturnTransferAlias() {
                                        candidateSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                                    } else {
                                        candidateSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                                    }
                                    candidateBaseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: candidateSourcePathID)
                                    candidateOrdinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: candidateSourcePathID)
                                    candidateSourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: candidateSourcePathID, effectPaths: reachability.functionBehaviorFacts.paths)
                                }
                                if compilerIntTableValue(table: arena.ownedReturnTransfers, row: candidateRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()) != canonicalStorageKeyID { mismatchMask: mismatchMask + 1 }
                                if candidateTransferKind != canonicalTransferKind { mismatchMask: mismatchMask + 2 }
                                if candidateSourceKind != canonicalSourceKind { mismatchMask: mismatchMask + 4 }
                                if candidateBaseKind != canonicalBaseKind { mismatchMask: mismatchMask + 8 }
                                if candidateOrdinal != canonicalOrdinal { mismatchMask: mismatchMask + 16 }
                                if candidateSourceEffectPathID != canonicalSourceEffectPathID { mismatchMask: mismatchMask + 32 }
                            }
                            candidateRow: candidateRow + 1
                        }
                        return 0 - (250000 + returnNodeID * 1000 + transferRow * 100 + mismatchMask)
                    }
                }
                transferRow: transferRow + 1
            }
        }
        returnNodeScanRow: returnNodeScanRow + 1
    }
    let firstLeaf: Int(compilerIntTableRowCount(table: reachability.functionBehaviorFacts.returnLeaves))
    transferRow: 0
    while transferRow < transferCount {
        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == canonicalReturnNodeID {
            let transferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferKindColumn()))
            let transferSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
            state sourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
            state baseKind: Int(0 - 1)
            state ordinal: Int(0 - 1)
            state sourceEffectPathID: Int(0 - 1)
            if transferKind == compilerBodyOwnedReturnTransferAlias() || transferKind == compilerBodyOwnedReturnTransferForward() {
                if transferKind == compilerBodyOwnedReturnTransferAlias() {
                    sourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                } else {
                    sourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                }
                baseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: transferSourcePathID)
                ordinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: transferSourcePathID)
                sourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: transferSourcePathID, effectPaths: reachability.functionBehaviorFacts.paths)
                if baseKind < 0 || ordinal < 0 || sourceEffectPathID == 0 - 2 { return 0 - 1 }
            }
            if compilerReachableLLVMStateAppendReturnLeaf(output: reachability.functionBehaviorFacts.returnLeaves, instanceID: instanceID, returnPathID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()), sourceKind: sourceKind, baseKind: baseKind, ordinal: ordinal, sourcePathID: sourceEffectPathID, storageKeyID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn())) != 0 { return 0 - 1 }
        }
        transferRow: transferRow + 1
    }
    let setStatus: Int(compilerReachableLLVMStateSetReturnSummary(reachability: reachability, instanceID: instanceID, status: compilerReachableFunctionInstanceReturnSummarySupported(), typeKeyID: returnTypeKeyID, typeKind: returnTypeKind, firstLeaf: firstLeaf, leafCount: canonicalCount))
    if setStatus != 0 { return 0 - 1 }
    return 1
}

function compilerBodyArenaOwnedPathRootSymbolKind(arena: CompilerBodyArena, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 || compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()) != compilerBodyOwnedPathRootSymbol() { return 0 - 1 }
    let rootSymbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if rootSymbolID < 0 || rootSymbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    return compilerIntTableValue(table: arena.symbols, row: rootSymbolID, column: compilerBodySymbolKindColumn())
}

function compilerBodyArenaOwnedPathSummaryRootClass(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 { return compilerBodyOwnedSummaryRootInvalid() }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
    if rootKind == compilerBodyOwnedPathRootEvaluation() {
        if compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyOwned() { return compilerBodyOwnedSummaryRootLocalCreate() }
        return compilerBodyOwnedSummaryRootInvalid()
    }
    if rootKind != compilerBodyOwnedPathRootSymbol() { return compilerBodyOwnedSummaryRootInvalid() }
    let rootSymbolKind: Int(compilerBodyArenaOwnedPathRootSymbolKind(arena: arena, pathID: pathID))
    if rootSymbolKind < 0 { return compilerBodyOwnedSummaryRootInvalid() }
    if rootSymbolKind == compilerBodySymbolReceiver() || rootSymbolKind == compilerBodySymbolParameter() { return compilerBodyOwnedSummaryRootBoundary() }
    if (rootSymbolKind == compilerBodySymbolLet() || rootSymbolKind == compilerBodySymbolState())
        && compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyOwned() { return compilerBodyOwnedSummaryRootLocalCreate() }
    return compilerBodyOwnedSummaryRootUnsupported()
}

function compilerBodyArenaOwnedPathBaseKind(arena: CompilerBodyArena, pathID: Int): Int {
    let rootSymbolKind: Int(compilerBodyArenaOwnedPathRootSymbolKind(arena: arena, pathID: pathID))
    if rootSymbolKind == compilerBodySymbolReceiver() { return compilerBodyOwnedBaseReceiver() }
    if rootSymbolKind == compilerBodySymbolParameter() { return compilerBodyOwnedBaseParameter() }
    return 0 - 1
}

function compilerBodyArenaOwnedPathBaseOrdinal(arena: CompilerBodyArena, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    let rootSymbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathRootIDColumn()))
    if rootSymbolID < 0 || rootSymbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let rootSymbolKind: Int(compilerBodyArenaOwnedPathRootSymbolKind(arena: arena, pathID: pathID))
    if rootSymbolKind == compilerBodySymbolReceiver() { return 0 }
    if rootSymbolKind == compilerBodySymbolParameter() { return compilerBodyArenaParameterOrdinalForSymbol(arena: arena, symbolID: rootSymbolID) }
    return 0 - 1
}

function compilerBodyArenaOwnedPathBlockStateIndex(blockID: Int, pathID: Int, pathCount: Int): Int {
    return pathCount + blockID * pathCount + pathID
}

function compilerBodyArenaOwnedPathBlockProcessedIndex(blockID: Int, blockCount: Int, pathCount: Int): Int {
    return pathCount + blockCount * pathCount + blockID
}

function compilerBodyArenaOwnedPathBackedgeStatus(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathRoots: Buffer<Int>, canonicalPaths: Buffer<Int>, relationships: CompilerControlFlowRelationships, projectionA: Buffer<Int>, projectionB: Buffer<Int>, blockCount: Int, pathCount: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge() {
            let sourceBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()))
            let targetBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()))
            if sourceBlockID < 0 || sourceBlockID >= blockCount || targetBlockID < 0 || targetBlockID >= blockCount { return 0 - 1 }
            let predecessorCount: Int(relationships.predecessorCounts.element(index: targetBlockID))
            if predecessorCount < 1 { return 0 - 1 }
            let entryPredecessorEdgeID: Int(compilerBodyArenaCFGPredecessorEdgeID(relationships: relationships, blockID: targetBlockID, ordinal: 0))
            let entryPredecessorID: Int(compilerBodyArenaCFGRelationshipSourceBlockID(arena: arena, relationships: relationships, edgeID: entryPredecessorEdgeID))
            if entryPredecessorID < 0 || entryPredecessorID >= blockCount
                || states.element(index: compilerBodyArenaOwnedPathBlockProcessedIndex(blockID: sourceBlockID, blockCount: blockCount, pathCount: pathCount)) != 1
                || states.element(index: compilerBodyArenaOwnedPathBlockProcessedIndex(blockID: entryPredecessorID, blockCount: blockCount, pathCount: pathCount)) != 1 { return 0 - 1 }
            let entryProjectionStatus: Int(compilerBodyArenaOwnedPathBuildEdgeProjection(arena: arena, states: states, origins: origins, sourceBlockID: entryPredecessorID, targetBlockID: targetBlockID, pathRoots: pathRoots, canonicalPaths: canonicalPaths, projection: projectionA, pathCount: pathCount))
            if entryProjectionStatus != 0 { return 0 - (300000000 + (0 - entryProjectionStatus)) }
            let backedgeProjectionStatus: Int(compilerBodyArenaOwnedPathBuildEdgeProjection(arena: arena, states: states, origins: origins, sourceBlockID: sourceBlockID, targetBlockID: targetBlockID, pathRoots: pathRoots, canonicalPaths: canonicalPaths, projection: projectionB, pathCount: pathCount))
            if backedgeProjectionStatus != 0 { return 0 - (400000000 + (0 - backedgeProjectionStatus)) }
            state pathID: Int(0)
            while pathID < pathCount {
                let entryState: Int(compilerBodyArenaOwnedPathProjectedEdgeStateCached(states: states, sourceBlockID: entryPredecessorID, pathRoots: pathRoots, projection: projectionA, pathID: pathID, pathCount: pathCount))
                let backedgeState: Int(compilerBodyArenaOwnedPathProjectedEdgeStateCached(states: states, sourceBlockID: sourceBlockID, pathRoots: pathRoots, projection: projectionB, pathID: pathID, pathCount: pathCount))
                let entryOrigin: Int(compilerBodyArenaOwnedPathProjectedEdgeOriginCached(origins: origins, sourceBlockID: entryPredecessorID, pathRoots: pathRoots, projection: projectionA, pathID: pathID, pathCount: pathCount))
                let backedgeOrigin: Int(compilerBodyArenaOwnedPathProjectedEdgeOriginCached(origins: origins, sourceBlockID: sourceBlockID, pathRoots: pathRoots, projection: projectionB, pathID: pathID, pathCount: pathCount))
                if entryState == compilerBodyOwnedPathUnknown() || backedgeState == compilerBodyOwnedPathUnknown()
                    || entryOrigin == compilerBodyOwnedOriginInvalid() || backedgeOrigin == compilerBodyOwnedOriginInvalid() { return 0 - 1 }
                if backedgeState != entryState {
                    return 0 - (100000 + pathID * 1000 + entryState * 100 + backedgeState * 10)
                }
                if backedgeState != compilerBodyOwnedPathAbsent() && backedgeOrigin != entryOrigin {
                    return 0 - (200000 + pathID * 1000 + entryState * 100)
                }
                pathID: pathID + 1
            }
        }
        edgeRow: edgeRow + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathBlockIsTerminal(arena: CompilerBodyArena, blockID: Int): Bool {
    let terminatorKind: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorKindColumn()))
    if terminatorKind == compilerBodyCFGTerminatorReturn() { return true }
    state outgoingCount: Int(0)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) == blockID { outgoingCount: outgoingCount + 1 }
        edgeRow: edgeRow + 1
    }
    return outgoingCount == 0
}

function compilerBodyArenaOwnedPathTerminalFailure(arena: CompilerBodyArena, pathID: Int, pathState: Int, pathPolicy: Int, activationKind: Int, originPathID: Int): Int {
    state originClass: Int(3)
    if originPathID == compilerBodyOwnedOriginLocal() {
        originClass: 1
    } else if compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID) {
        originClass: 2
    }
    if pathID >= 0 && pathID < compilerIntTableRowCount(table: arena.ownedPaths) {
        let pathTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn()))
        let pathTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: pathTypeID))
        let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
        if rootPathID >= 0 {
            let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
            let rootID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
            return 0 - (900000000 + pathID * 10000000 + pathTypeKind * 100000 + rootKind * 10000 + rootID * 10 + pathState)
        }
    }
    return 0 - (100000000 + pathID * 100000 + pathState * 1000 + pathPolicy * 100 + activationKind * 10 + originClass)
}

function compilerBodyArenaOwnedPathCurrentStateTerminalStatus(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathRoots: Buffer<Int>): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    state pathRow: Int(0)
    while pathRow < pathCount {
        let pathTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathTypeColumn()))
        if !compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: pathTypeID) {
            pathRow: pathRow + 1
        } else {
        let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathPolicyColumn()))
        let pathState: Int(compilerBodyArenaOwnedPathState(states: states, pathID: pathRow))
        let originPathID: Int(compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: pathRow))
        let rootPathID: Int(compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: pathRow, pathCount: pathCount))
        let activationKind: Int(compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID))
        if pathState == compilerBodyOwnedPathAbsent() {
            if activationKind != compilerBodyOwnedPathActivationLexicalSymbol() && activationKind != compilerBodyOwnedPathActivationEvaluationTemporary() {
                return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
            }
        } else if pathState == compilerBodyOwnedPathUnknown() {
            return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
        } else if pathPolicy == compilerBodyOwnedPathPolicyOwned() {
            if originPathID == compilerBodyOwnedOriginLocal() {
                if pathState != compilerBodyOwnedPathMoved() && pathState != compilerBodyOwnedPathConsumed() {
                    return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
                }
            } else if compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID) {
                if pathState != compilerBodyOwnedPathLive() && pathState != compilerBodyOwnedPathMoved() {
                    return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
                }
            } else {
                return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
            }
        } else if pathPolicy == compilerBodyOwnedPathPolicyBorrowed() {
            if !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID)
                || (pathState != compilerBodyOwnedPathLive() && pathState != compilerBodyOwnedPathMoved() && pathState != compilerBodyOwnedPathConsumed()) {
                return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
            }
        } else if pathPolicy == compilerBodyOwnedPathPolicyAlias() {
            if originPathID != compilerBodyOwnedOriginUnknown() || pathState != compilerBodyOwnedPathLive() {
                return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
            }
        } else {
            return compilerBodyArenaOwnedPathTerminalFailure(arena: arena, pathID: pathRow, pathState: pathState, pathPolicy: pathPolicy, activationKind: activationKind, originPathID: originPathID)
        }
        pathRow: pathRow + 1
        }
    }
    return 0
}

function compilerBodyArenaOwnedPathApplyImplicitTerminalDestructions(arena: CompilerBodyArena, blockID: Int, states: Buffer<Int>, origins: Buffer<Int>, pathRoots: Buffer<Int>, recordFacts: Bool): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    state pathID: Int(0)
    while pathID < pathCount {
        let rootPathID: Int(compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: pathID, pathCount: pathCount))
        if rootPathID < 0 { return 0 - 1 }
        if compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()) == compilerBodyOwnedPathRootSymbol() {
            let symbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
            if symbolID >= 0 && symbolID < compilerIntTableRowCount(table: arena.symbols)
                && (compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolLet()
                    || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState())
                && compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyOwned()
                && compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn())) == compilerBodyTypeString()
                && compilerBodyArenaOwnedPathState(states: states, pathID: pathID) == compilerBodyOwnedPathLive()
                && compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: pathID) == compilerBodyOwnedOriginLocal() {
                if compilerBodyArenaOwnedPathSetState(states: states, pathID: pathID, stateValue: compilerBodyOwnedPathConsumed()) != 0 { return 0 - 1 }
                if recordFacts {
                    state sourceNodeID: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorSourceColumn()))
                    if sourceNodeID < 0 { sourceNodeID: arena.rootNodeID }
                    if compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: compilerBodyMemoryFactResourceDestroy(), sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: pathID, auxID: blockID) < 0 { return 0 - 1 }
                }
            }
        }
        pathID: pathID + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathTerminalStatesAreConsistent(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathRoots: Buffer<Int>, blockCount: Int, pathCount: Int): Bool {
    state pathID: Int(0)
    while pathID < pathCount {
        let pathTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn()))
        let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
        if compilerBodyArenaTypeIDHasOpaqueStorageRepresentation(arena: arena, typeID: pathTypeID) {
            state hasTerminalState: Bool(false)
            state hasTerminalBlock: Bool(false)
            state canonicalTerminalState: Int(compilerBodyOwnedPathUnknown())
            state canonicalTerminalOrigin: Int(compilerBodyOwnedOriginUnknown())
            state blockID: Int(0)
            while blockID < blockCount {
                if compilerBodyArenaOwnedPathBlockIsTerminal(arena: arena, blockID: blockID) {
                    hasTerminalBlock: true
                    if states.element(index: compilerBodyArenaOwnedPathBlockProcessedIndex(blockID: blockID, blockCount: blockCount, pathCount: pathCount)) != 1 { return false }
                    let terminalState: Int(states.element(index: compilerBodyArenaOwnedPathBlockStateIndex(blockID: blockID, pathID: pathID, pathCount: pathCount)))
                    let terminalOrigin: Int(origins.element(index: compilerBodyArenaOwnedPathBlockStateIndex(blockID: blockID, pathID: pathID, pathCount: pathCount)))
                    if terminalState == compilerBodyOwnedPathAbsent() {
                        let rootPathID: Int(compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: pathID, pathCount: pathCount))
                        let activationKind: Int(compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID))
                        if activationKind != compilerBodyOwnedPathActivationLexicalSymbol()
                            && activationKind != compilerBodyOwnedPathActivationEvaluationTemporary() { return false }
                    } else {
                        if terminalState == compilerBodyOwnedPathUnknown() { return false }
                        if pathPolicy == compilerBodyOwnedPathPolicyBorrowed()
                            && terminalState != compilerBodyOwnedPathLive() && terminalState != compilerBodyOwnedPathMoved() && terminalState != compilerBodyOwnedPathConsumed() { return false }
                        if pathPolicy == compilerBodyOwnedPathPolicyAlias() && terminalState != compilerBodyOwnedPathLive() { return false }
                        if !hasTerminalState {
                            canonicalTerminalState: terminalState
                            canonicalTerminalOrigin: terminalOrigin
                            hasTerminalState: true
                        } else if terminalOrigin != canonicalTerminalOrigin
                            || (pathPolicy == compilerBodyOwnedPathPolicyAlias() && terminalState != canonicalTerminalState) {
                            return false
                        }
                    }
                }
                blockID: blockID + 1
            }
            if !hasTerminalBlock { return false }
        }
        pathID: pathID + 1
    }
    return true
}

function compilerBodyArenaOwnedPathEvaluateBlock(arena: CompilerBodyArena, blockID: Int, states: Buffer<Int>, origins: Buffer<Int>, scheduleStarts: Buffer<Int>, scheduleCounts: Buffer<Int>, scheduleRows: Buffer<Int>, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effects: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable, returnLeaves: CompilerIntTable, applyInstanceEffects: Bool, recordFacts: Bool): Int {
    if blockID < 0 || blockID >= scheduleStarts.count || scheduleCounts.count != scheduleStarts.count { return 0 - 1 }
    let blockScheduleStart: Int(scheduleStarts.element(index: blockID))
    let blockScheduleCount: Int(scheduleCounts.element(index: blockID))
    if blockScheduleStart < 0 || blockScheduleCount < 0 || blockScheduleStart + blockScheduleCount > scheduleRows.count { return 0 - 1 }
    state scheduleOrdinal: Int(0)
    state status: Int(0)
    while scheduleOrdinal < blockScheduleCount && status == 0 {
        let scheduleRow: Int(scheduleRows.element(index: blockScheduleStart + scheduleOrdinal))
