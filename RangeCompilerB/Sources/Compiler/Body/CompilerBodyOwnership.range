function compilerBodyArenaOwnedPathOpaqueLeafCanDeactivateCachedAt(arena: CompilerBodyArena, states: Buffer<Int>, origins: Buffer<Int>, pathRoots: Buffer<Int>, canonicalPaths: Buffer<Int>, pathID: Int, blockID: Int, pathCount: Int): Bool {
