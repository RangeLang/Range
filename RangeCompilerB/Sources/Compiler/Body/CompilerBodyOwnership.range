        let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
        return stateValue == compilerBodyOwnedPathLive() && originPathID == compilerBodyOwnedOriginUnknown()
            && canonicalPathID >= 0 && canonicalPathID != pathID
