compilerSourceFile\trole=core\tpath=Core/Macro/CanonicalTargetMembers.range
open macro member(): Declaration | Member -> Void {}

construct Construct {
    let declaration: ConstructDeclaration
}

construct ConstructDeclaration {
    let members: [@member]
}

construct Let {}
construct State {}

macro canonicalTargetMembers(): Construct { environment in
    let memberCount: Int(environment.target.declaration.members.filter(all: Let).count)
    if memberCount == 2 {
        @expand {
            extension #(environment.target.declaration.self) {
                let canonicalTargetMembersWorked: Int
            }
        }
    }
}
