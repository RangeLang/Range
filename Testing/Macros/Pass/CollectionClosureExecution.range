compilerSourceFile\trole=core\tpath=Core/Macro/CollectionClosureExecution.range
macro member(): Declaration | Member -> Void {}
macro syntax(): Declaration -> Void {}

construct Identifier {
    let name: String
}

construct Construct {
    construct Declaration {
        let identifier: Identifier
        let members: Array<@member>
    }
}

@syntax
construct Let {
    let identifier: Identifier
}

macro collectionClosureExecution(): Construct { environment in
    let expected: String("first")
    let lets: Array<Let>(
        environment.target.Declaration.members.filter(all: Let)
    )
    let selected: Array<Let>(
        lets.filter { property in
            return property.identifier.name == expected
        }
    )
    let names: Array<String>(
        selected.map { property in
            return property.identifier.name
        }
    )
    if names.count == 1 {
        #environment {
            extension #environment.target.Declaration.identifier {
                let collectionClosureExecutionWorked: Int
            }
        }
    }
}

compilerSourceFile\trole=project\tpath=Project/Value.range
@collectionClosureExecution
construct Value {
    let first: Int
    let second: Bool
}
