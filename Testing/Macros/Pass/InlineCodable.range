enum Result<Value, Failure> {
    case success(result: Value)
    case failure(cause: Failure)
}

construct EncodingError {}
construct DecodingError {}

construct Encoder<Format> {
    function keyedContainer(): KeyedEncodingContainer<Format>
}

construct KeyedEncodingContainer<Format> {
    function encode<Value>(_ value: Value, forKey key: String): Result<Void, EncodingError>
}

construct Decoder<Format> {
    function keyedContainer(): KeyedDecodingContainer<Format>
}

construct KeyedDecodingContainer<Format> {
    function decode<Value>(_ type: Value, forKey key: String, default defaultValue: Value?): Result<Value, DecodingError>
}

