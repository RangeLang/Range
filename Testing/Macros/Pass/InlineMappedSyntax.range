compilerSourceFile\trole=core\tpath=Core/Macro/InlineMappedSyntax.range
open macro member(): Declaration | Member -> Void {}
open macro syntax(): Declaration -> Void {}

construct Identifier {}

construct Construct {
    construct Declaration {
        let identifier: Identifier
        let members: [@member]
    }
}

@syntax
construct Let {}

macro inlineMappedSyntax(): Construct { environment in
    let fields: [Let](
        environment.target.Declaration.members.filter(all: Let)
    )

    environment.expand {
        extension #environment.target.Declaration.identifier {
            function mappedValue(): Int {
                #fields.map { property in
                    return #property.value
                }
            }
        }
    }
}

