compilerSourceFile\trole=core\tpath=Core/Macro/CodableConstructCollection.range
macro member(): Declaration | Member -> Void {}
macro syntax(): Declaration -> Void {}
macro stored(): Construct -> Void {}

construct Identifier {
    let name: String
}

construct Construct {
    construct Declaration {
        let identifier: Identifier
        let members: [@member]
    }
}

@syntax
@stored
construct Let {
    let identifier: Identifier
}

@syntax
@stored
construct State {
    let identifier: Identifier
}

construct Binding {}

macro codableEncodeBody(properties: [@stored]) -> Int { environment in
    if properties.count == 2 {
        #environment {
            let encodedProperties: Int(2)
        }
    }
    return properties.count
}

macro codableDecodeBody(properties: [@stored]) -> Int { environment in
    if properties.count == 2 {
        #environment {
            let decodedProperties: Int(2)
        }
    }
    return properties.count
}

macro codable(): Construct { environment in
    let properties: [@stored](
        environment.target.Declaration.members.filter(all: @stored)
    )

    if properties.count == 2 {
        #environment {
            extension #environment.target.Declaration.identifier {
                function encode(to encoder: Encoder): Int {
                    @codableEncodeBody(properties: #properties)
                    return 0
                }

                function decode(from decoder: Decoder): Int {
                    @codableDecodeBody(properties: #properties)
                    return 0
                }
            }
        }
    }
}

