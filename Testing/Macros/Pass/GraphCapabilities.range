compilerSourceFile\trole=core\tpath=Core/Macro/Graph.range
enum GraphRole {
    case declaration
    case application
}
open macro syntax(): Declaration -> Void {}
@shared
macro graph(
    _ role: GraphRole,
    _ additionalRole: GraphRole?
): Construct -> Void { environment in
    environment.graph.addNode(role: role, additionalRole: additionalRole)
}

compilerSourceFile\trole=project\tpath=Project/SyntaxFamily.range
@graph(.declaration, .application)
construct SyntaxFamily {
    @syntax
    construct Declaration {}

    @syntax
    construct Application {}
}

@graph(.declaration)
construct SyntaxlessFamily {
    construct Declaration {}
}
