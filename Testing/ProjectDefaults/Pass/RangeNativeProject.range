compilerSourceFile\trole=core\tpath=Core/Macro/Project.range
macro project(): Construct { environment in
    let integerCount: Int(environment.target.memberCount("integer"))
    let boolCount: Int(environment.target.memberCount("bool"))
    if integerCount == 0 && boolCount == 0 {
        @expand {
            extension #(environment.target.declaration.self) {
                state integer: Int
                state bool: Bool
            }
        }
    }
    if integerCount == 0 {
        @expand {
            extension #(environment.target.declaration.self) {
                state integer: Int
            }
        }
    }
    if boolCount == 0 {
        @expand {
            extension #(environment.target.declaration.self) {
                state bool: Bool
            }
        }
    }
}
