function entryKindName(kind: FileSystemEntryKind): String {
    switch kind {
    case .file:
        return "file"
    case .directory:
        return "directory"
    }
}

function renderTree(node: FileTreeNode, indent: String): String {
    state output: "\(indent)\(entryKindName(kind: node.kind)) \(node.path)\n"
    state index: 0

    while index < node.children.count {
        state output: output + renderTree(node: node.children.element(index: index), indent: "\(indent)  ")
        state index: index + 1
    }

    return output
}

@main {
    switch FileTree.read(path: "../../../") {
    case .success(let tree):
        Logger.info(renderTree(node: tree, indent: ""))
    case .failure:
        Logger.error("failed to read file tree")
    }
}
