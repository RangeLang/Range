construct UserCard {
    let name: String
    let subtitle: String
    let isSelected: Bool

    @view
    function body(): Layout {
        return Padding(
            insets: EdgeInsets(top: 8.0, leading: 12.0, bottom: 8.0, trailing: 12.0),
            child: FixedLayout(size: Size(width: 120.0, height: 40.0))
        )
    }
}

@main {
    let card: UserCard(name: "George", subtitle: "Range layout", isSelected: true)
    let measured: card.body().measure(SizeProposal(width: 200.0, height: 100.0))
}
