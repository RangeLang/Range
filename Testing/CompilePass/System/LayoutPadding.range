function paddedLayoutMeasuresAsContainer(): Bool {
    let content: FixedLayout(size: Size(width: 40.0, height: 12.0))
    let layout: Padding(
        insets: EdgeInsets(top: 2.0, leading: 4.0, bottom: 6.0, trailing: 8.0),
        child: content
    )
    let measured: layout.measure(SizeProposal(width: 100.0, height: 100.0))

    return measured.width == 52.0 && measured.height == 20.0
}

function paddedLayoutPlacesChildInsideInsets(): Bool {
    let content: FixedLayout(size: Size(width: 40.0, height: 12.0))
    let layout: Padding(
        insets: EdgeInsets(top: 2.0, leading: 4.0, bottom: 6.0, trailing: 8.0),
        child: content
    )
    let childBounds: layout.childBounds(in: Rect(x: 0.0, y: 0.0, width: 52.0, height: 20.0))

    return childBounds.x == 4.0
        && childBounds.y == 2.0
        && childBounds.width == 40.0
        && childBounds.height == 12.0
}

