protocol Greetable {
    function greet(): String
}

macro extendConstructSurface(): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self): Greetable {
            function greet(): String {
                return "Hello"
            }

            function clone(): #(target.declaration.self) {
                return self
            }

            construct ChildConstruct {
                function doThing(): String {
                    return "Thing"
                }
            }
        }

        construct SiblingConstruct {
            function doThing(): String {
                return "Thing"
            }
        }
    }
}

@extendConstructSurface
construct ExtendableFixture {
    let number: Int
}

@main {
    let result: ExtendableFixture(number: 1)

    result.greet()
}
