macro codingCases(): Construct { target, diagnostics in
    let generatedKeys: Array<String>(
        target.declaration.lets.flatMap { property in
            property.macros.compactMap { application in
                application.value.key
            }
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            function generatedCodingKeyCount(): Int {
                return #(generatedKeys.count)
            }
        }
    }
}

@codingCases
construct LetMacroApplicationsSurfaceFixture {
    @coding("user_id")
    let id: Int

    let name: String
}
