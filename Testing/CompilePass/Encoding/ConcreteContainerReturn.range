construct FixtureSingleValueEncodingContainer {
    function encodeNil(): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Bool): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Data): Result<Void, EncodingError> {
        return .failure(cause: .failed)
    }

    function encode(_ value: Date): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: DateTime): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Float): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Int): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: UUID): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode<T>(_ value: T): Result<Void, EncodingError> {
        return .failure(cause: .failed)
    }
}

construct FixtureKeyedEncodingContainer {
    function encode(_ value: Bool, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Data, forKey key: String): Result<Void, EncodingError> {
        return .failure(cause: .failed)
    }

    function encode(_ value: Date, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: DateTime, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Float, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: Int, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: String, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode(_ value: UUID, forKey key: String): Result<Void, EncodingError> {
        return .success(result: Void())
    }

    function encode<T>(_ value: T, forKey key: String): Result<Void, EncodingError> {
        return .failure(cause: .failed)
    }
}

function makeSingleValueContainer(): SingleValueEncodingContainer {
    return FixtureSingleValueEncodingContainer()
}

function makeKeyedContainer(): KeyedEncodingContainer {
    return FixtureKeyedEncodingContainer()
}

@main {
}
