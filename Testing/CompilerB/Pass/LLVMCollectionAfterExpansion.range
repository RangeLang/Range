macro llvm(): Let {
    let value: String(#environment.target.value)
    let parent: #environment.target.parent
}

macro scalar(): Construct {
    #environment {
        extension #environment.target.Declaration {
            @llvm
            let layout: String("declaration")

            let ignored: String("not marked")
        }

        extension #environment.target.Application {
            @llvm
            let value: String("application")
        }
    }
}

@scalar
construct Int {}
