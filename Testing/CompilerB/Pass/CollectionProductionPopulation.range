construct LLVM {}

macro member(): Let | State | Derived | Binding -> Void {}
macro many(): @member {}

macro scalar(): Construct {
    @diagnostic
    let bits: #environment.target.Declaration.members.filter(named: "bits").first ? "Construct must specify bits"
    @diagnostic
    let signed: #environment.target.Declaration.members.filter(named: "signed").first ? "Construct must specify signed"

    #environment {
        extension #environment.target.Declaration {
            LLVM(type: "%Range.\(#environment.target.identity) = type { i\(bits) }")
        }
        extension #environment.target.Application {
            LLVM(value: "%Range.\(#environment.target.identity) { i\(bits) \(#environment.target.Application.value) }")
        }
    }
}

macro diagnostic(): @member -> Void {}

@scalar
construct Tiny {
    let bits: Int(8)
    let signed: Bool(false)
}

@scalar
construct Word {
    let bits: Int(16)
    let signed: Bool(false)
}

@many
state scalars: @scalar

@many
derived commands: scalars -> LLVM

function answer(): Tiny {
    return 42
}
