construct LLVM {}

macro member(): Let | State | Derived | Binding -> Void {}
macro many(): @member {}

macro scalar(width: Int): Construct {
    let bits: #environment.target.Declaration.members.filter(named: "bits").first
    let signed: #environment.target.Declaration.members.filter(named: "signed").first

    if !bits.isTarget {
        @diagnostic("Construct must specify bits")
    }
    if !signed.isTarget {
        @diagnostic("Construct must specify signed")
    }

    #environment {
        extension #environment.target.Declaration {
            LLVM(type: "%Range.\(#environment.target.identity) = type { i\(width) }")
        }
        extension #environment.target.Application {
            LLVM(value: "%Range.\(#environment.target.identity) { i\(width) \(#environment.target.Application.value) }")
        }
    }
}

@scalar(width: 8)
construct Tiny {
    let bits: Int(8)
    let signed: Bool(false)
}

@many
state scalars: @scalar

@many
derived commands: scalars -> LLVM

function answer(): Tiny {
    return 42
}
