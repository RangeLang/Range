function compilerBProjectRevisionEntry(): Int {
    if commandLineArgumentCount() != 1 { return 64 }
    let route: String(commandLineArgument(index: 0))
    let sourcePaths: String(compilerBDiscoverSourcePaths(route: route))
    let sourceCount: Int(compilerBSourceSetLineCount(lines: sourcePaths))
    let declarations: CompilerBProjectDeclarationStore(
        compilerBProjectDeclarationStoreCreate(capacity: sourceCount * 32)
    )
    let applications: CompilerBProjectMacroApplicationStore(
        compilerBProjectMacroApplicationStoreCreate(capacity: sourceCount * 32)
    )
    let populateStatus: Int(compilerBPopulateProjectRevision(
        sourcePaths: sourcePaths,
        declarations: declarations,
        applications: applications
    ))
    let revision: CompilerBProjectRevision(
        sourcePaths: sourcePaths,
        sourceCount: sourceCount,
        declarations: declarations,
        macroApplications: applications,
        valid: populateStatus == 0,
        diagnosticSourceID: compilerBProjectPopulationDiagnosticSourceID(
            status: populateStatus
        ),
        diagnostic: compilerBProjectPopulationDiagnostic(status: populateStatus)
    )
    print(value: compilerBRenderProjectRevision(revision: revision))
    state status: Int(0)
    if !revision.valid { status: 65 }
    if compilerBProjectRevisionDestroy(revision: revision) != 0 { status: 70 }
    return status
}

@main {
    return compilerBProjectRevisionEntry()
}
