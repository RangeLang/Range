function compilerBDirectMetalLLVMEntry(): Int {
    if commandLineArgumentCount() != 1 { return 64 }
    let route: String(commandLineArgument(index: 0))
    let llvmPath: String(fileManagerChildPath(path: route, name: "MetalDevice.ll"))
    let executablePath: String(fileManagerChildPath(path: route, name: "MetalDevice"))
    state llvm: String("")
    llvm.append(text: "; range-link-v1 kind=framework id=Metal\n")
    llvm.append(text: "declare ptr @MTLCreateSystemDefaultDevice()\n")
    llvm.append(text: "define i32 @main() {\n")
    llvm.append(text: "entry:\n")
    llvm.append(text: "  %device = call ptr @MTLCreateSystemDefaultDevice()\n")
    llvm.append(text: "  %missing = icmp eq ptr %device, null\n")
    llvm.append(text: "  %result = select i1 %missing, i32 1, i32 0\n")
    llvm.append(text: "  ret i32 %result\n")
    llvm.append(text: "}\n")
    if fileManagerWriteFile(path: llvmPath, text: llvm, mode: 1) != 0 { return 73 }
    state linker: ProcessPlan(processPlan(executable: "clang"))
    linker: processPlanAppendingArgument(plan: linker, argument: "-O2")
    linker: processPlanAppendingArgument(plan: linker, argument: "-fno-lto")
    linker: processPlanAppendingArgument(plan: linker, argument: "-Wno-override-module")
    linker: processPlanAppendingArgument(plan: linker, argument: llvmPath)
    linker: processPlanAppendingArgument(plan: linker, argument: "-framework")
    linker: processPlanAppendingArgument(plan: linker, argument: "Metal")
    linker: processPlanAppendingArgument(plan: linker, argument: "-o")
    linker: processPlanAppendingArgument(plan: linker, argument: executablePath)
    let linkStatus: Int(processPlanRun(plan: linker))
    if linkStatus != 0 { return linkStatus }
    return runProcess(executable: executablePath, argumentRecords: "")
}

@main {
    return compilerBDirectMetalLLVMEntry()
}
