construct LLVM {}

macro member(): Let | State | Derived | Binding -> Void {}
macro many(): @member {}

macro scalar(): Construct {
    LLVM(
        type: "%Range.Legacy = type { i8 }",
        value: "%Range.Legacy { i8 42 }"
    )
}

@scalar
construct Legacy {
    let bits: Int(8)
    let signed: Bool(false)
}

@many
state scalars: @scalar

@many
derived commands: scalars -> LLVM

function answer(): Legacy {
    42
}
