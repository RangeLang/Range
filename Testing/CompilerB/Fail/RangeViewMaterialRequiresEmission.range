macro app(): Construct -> Void {}
macro shape(): Construct -> Void {}
macro many(count: Int): Let -> Void {}
macro material(): Construct -> Void {}
macro shader(): Construct -> Void {}

construct Point {
    let x: Int
    let y: Int
}

@shader
@gpui(kind: 3)
construct LinearGradient {
    let firstColor: Int
    let secondColor: Int
    let angle: Int
}

@material
construct BrokenMaterial {
    derived output: @shader {
        LinearGradient(
            firstColor: 2584305,
            secondColor: 3003583,
            angle: 135
        )
    }
}

@shape
construct Rectangle {
    @many(4)
    let points: Point(
        Point(x: 120, y: 90),
        Point(x: 680, y: 90),
        Point(x: 680, y: 430),
        Point(x: 120, y: 430)
    )
}

@app
construct InvalidRangeViewMaterial {
    derived body: @view {
        Rectangle(material: BrokenMaterial())
    }
}
