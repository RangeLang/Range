construct Point {
    state x: Int
    state y: Int
    let label: 3

    function sum(): Int {
        return x + y + label
    }

    function shift(let by: Int) {
        x: x + by
        bump()
    }

    function bump() {
        y: y + 1
    }
}

construct Line {
    state from: Point(x: 0, y: 0)
    state to: Point
    let narrow: Int(7)
}

function mirror(let p: Point): Point {
    return Point(x: p.y, y: p.x)
}

function length(let line: Line): Int {
    return (line.to.x - line.from.x) + (line.to.y - line.from.y) + line.narrow
}

{
    state p: Point(x: 1, y: 2)
    p.shift(by: 10)
    switch { p.x != 11: return 1, default: {} }
    switch { p.y != 3: return 2, default: {} }
    p.y: 20
    let m: mirror(p: p)
    switch { m.x != 20: return 3, default: {} }
    switch { m.y != 11: return 4, default: {} }
    switch { m.sum() != 34: return 5, default: {} }
    state line: Line(to: Point(x: 4, y: 6))
    line.from.x: 1
    switch { length(line: line) != 16: return 6, default: {} }
    let copy: line
    line.to.y: 100
    switch { copy.to.y != 6: return 7, default: {} }
    return 42
}
