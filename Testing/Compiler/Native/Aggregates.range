construct Point {
    state x: Int
    state y: Int
    let label: 3

    function sum(): Int {
        return x + y + label
    }

    function shift(let by: Int) {
        x: x + by
        bump()
    }

    function bump() {
        y: y + 1
    }
}

construct Line {
    state from: Point(x: 0, y: 0)
    state to: Point
    let narrow: Int(7)
}

function mirror(let p: Point): Point {
    return Point(x: p.y, y: p.x)
}

function length(let line: Line): Int {
    return (line.to.x - line.from.x) + (line.to.y - line.from.y) + line.narrow
}

{
    state p: Point(x: 1, y: 2)
    p.shift(by: 10)
    switch p.x != 11 { .true: return 1, .false: {} }
    switch p.y != 3 { .true: return 2, .false: {} }
    p.y: 20
    let m: mirror(p: p)
    switch m.x != 20 { .true: return 3, .false: {} }
    switch m.y != 11 { .true: return 4, .false: {} }
    switch m.sum() != 34 { .true: return 5, .false: {} }
    state line: Line(to: Point(x: 4, y: 6))
    line.from.x: 1
    switch length(line: line) != 16 { .true: return 6, .false: {} }
    let copy: line
    line.to.y: 100
    switch copy.to.y != 6 { .true: return 7, .false: {} }
    return 42
}
