// Optional is an enum: `T?` is Optional<T>, and a switch over its cases
// unwraps the present one, as a statement or nested in another arm.
construct Person {
    let age: Int
    let manager: Int?
}

function find(let xs: Array<Int>, let wanted: Int): Int? {
    state i: 0
    while i < xs.count {
        switch xs.read(at: i) = wanted { .true: return .present(i), .false: {} }
        i: i + 1
    }
    return .absent
}

function describe(let maybe: Int?): Int {
    switch maybe {
        .present(let value): return value,
        .absent: return -1
    }
    return -2
}

{
    state xs: Array<Int>()
    xs.append(value: 5)
    xs.append(value: 9)
    switch find(xs: xs, wanted: 9) {
        .present(let index): switch index != 1 { .true: return 1, .false: {} },
        .absent: return 2
    }
    switch find(xs: xs, wanted: 4) { .present(let index): return 3, .absent: {} }
    let boss: Person(age: 40, manager: .absent)
    let worker: Person(age: 30, manager: .present(1))
    switch describe(maybe: boss.manager) != -1 { .true: return 4, .false: {} }
    switch describe(maybe: worker.manager) != 1 { .true: return 5, .false: {} }
    let found: find(xs: xs, wanted: 5)
    switch found {
        .present(let found): switch found != 0 { .true: return 6, .false: {} },
        .absent: return 7
    }
    state names: Array<String?>()
    names.append(value: .present("Ada"))
    names.append(value: .absent)
    switch names.read(at: 1) {
    .present(let name): return 8,
    .absent: return 42
    }
}
