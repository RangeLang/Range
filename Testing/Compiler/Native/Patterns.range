// Patterns: shared bindings, guards, nested cases, generic enums, and
// payloads that hold @many storage, copied on write.
enum Shape {
    case circle(radius: Int)
    case square(side: Int)
    case group(Array<Int>)
    case nothing
}

enum Either<Left, Right> {
    case left(Left)
    case right(Right)
}

enum Tree {
    case leaf(value: Int)
    case node(left: Tree, right: Tree)
}

function size(let s: Shape): Int {
    switch s {
    .circle(let n) | .square(let n): return n,
    .group(let xs) where xs.count > 2: return 1000,
    .group(let xs): {
        state copy: xs
        copy.append(value: 1)
        return copy.count
    },
    .nothing: return 0
    }
}

function shallow(let t: Tree): Int {
    switch t {
    .node(.leaf(let a), .leaf(let b)): return a * b,
    .node(.node(_, _), _) | .node(_, .node(_, _)): return -1,
    .leaf(let v): return v
    }
}

function pick(let e: Either<Int, Bool>): Int {
    switch e {
    .left(let n): return n,
    .right(.true): return 1,
    .right(.false): return 0
    }
}

{
    state round: 0
    while round < 100 {
        state xs: Array<Int>()
        xs.append(value: 1)
        let g: Shape.group(xs)
        switch size(s: g) != 2 { .true: return 1, .false: {} }
        switch xs.count != 1 { .true: return 2, .false: {} }
        xs.append(value: 2)
        xs.append(value: 3)
        switch size(s: .group(xs)) != 1000 { .true: return 3, .false: {} }
        switch size(s: g) != 2 { .true: return 4, .false: {} }
        round: round + 1
    }
    switch size(s: .circle(radius: 4)) + size(s: .square(side: 5)) != 9 { .true: return 5, .false: {} }
    switch shallow(t: .node(left: .leaf(value: 6), right: .leaf(value: 7))) != 42 { .true: return 6, .false: {} }
    switch shallow(t: .node(left: .leaf(value: 6), right: .node(left: .leaf(value: 1), right: .leaf(value: 2)))) != -1 { .true: return 7, .false: {} }
    switch pick(e: .left(9)) + pick(e: .right(true)) != 10 { .true: return 8, .false: {} }
    let either: Either<Int, Bool>.right(false)
    switch pick(e: either) != 0 { .true: return 9, .false: {} }
    return 42
}
