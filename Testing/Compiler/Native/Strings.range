// String in native code: count (bytes), byte(at:), =, + into a new
// reference-counted block, construction from a literal, and print.
enum Token { case word(String), end }
construct Named { let name: String }
function greet(let name: String): String {
    return "hello, " + name
}
function vowels(let s: String): Int {
    state found: 0
    state i: 0
    while i < s.count {
        let b: s.byte(at: i)
        switch { b = 97 | b = 101 | b = 105 | b = 111 | b = 117: found: found + 1, default: {} }
        i: i + 1
    }
    return found
}
function kind(let s: String): Int {
    switch {
    s = "yes": return 1,
    s = "no": return 0,
    default: return -1
    }
}
{
    let s: String("hi")
    print(message: "local: \(s)")
    let empty: String()
    switch { empty.count != 0 | empty != "": return 1, default: {} }
    switch { s.count != 2 | s != "hi" | s = "ho": return 2, default: {} }
    let g: greet(name: "world")
    print(message: g)
    switch { g.count != 12 | g != "hello, world": return 3, default: {} }
    switch { vowels(s: g) != 3: return 4, default: {} }
    switch { s.byte(at: 0) != 104: return 5, default: {} }
    state words: Array<String>()
    state round: 0
    state joined: ""
    while round < 3 {
        joined: joined + "ab"
        words.append(value: joined + "!")
        round: round + 1
    }
    switch { joined != "ababab" | words.read(at: 1) != "abab!": return 6, default: {} }
    state total: 0
    for w in words { total: total + w.count }
    switch { total != 3 + 5 + 7: return 7, default: {} }
    switch { Token.word("a" + "b") != .word("ab") | Token.word("x") = .end: return 8, default: {} }
    let n: Named(name: joined + "?")
    switch { n.name.count != 7: return 9, default: {} }
    switch { kind(s: "yes") != 1 | kind(s: "n" + "o") != 0 | kind(s: "maybe") != -1: return 10, default: {} }
    let maybe: String?.present("z")
    switch { maybe != "z": return 11, default: {} }
    print(message: "\(joined) \(words.read(at: 0)) \(n.name)")
    return 42
}
