// String in native code: count (bytes), byte(at:), =, + into a new
// reference-counted block, construction from a literal, and @print.
enum Token { case word(String), end }
construct Named { let name: String }
function greet(let name: String): String {
    return "hello, " + name
}
function vowels(let s: String): Int {
    state found: 0
    state i: 0
    while i < s.count {
        let b: s.byte(at: i)
        switch b = 97 || b = 101 || b = 105 || b = 111 || b = 117 { .true: found: found + 1, .false: {} }
        i: i + 1
    }
    return found
}
function kind(let s: String): Int {
    switch s {
    "yes": return 1,
    "no": return 0,
    default: return -1
    }
}
{
    let s: String("hi")
    @print("local: \(s)")
    let empty: String()
    switch empty.count != 0 || empty != "" { .true: return 1, .false: {} }
    switch s.count != 2 || s != "hi" || s = "ho" { .true: return 2, .false: {} }
    let g: greet(name: "world")
    @print(g)
    switch g.count != 12 || g != "hello, world" { .true: return 3, .false: {} }
    switch vowels(s: g) != 3 { .true: return 4, .false: {} }
    switch s.byte(at: 0) != 104 { .true: return 5, .false: {} }
    state words: Array<String>()
    state round: 0
    state joined: ""
    while round < 3 {
        joined: joined + "ab"
        words.append(value: joined + "!")
        round: round + 1
    }
    switch joined != "ababab" || words.read(at: 1) != "abab!" { .true: return 6, .false: {} }
    state total: 0
    for w in words { total: total + w.count }
    switch total != 3 + 5 + 7 { .true: return 7, .false: {} }
    switch Token.word("a" + "b") != .word("ab") || Token.word("x") = .end { .true: return 8, .false: {} }
    let n: Named(name: joined + "?")
    switch n.name.count != 7 { .true: return 9, .false: {} }
    switch kind(s: "yes") != 1 || kind(s: "n" + "o") != 0 || kind(s: "maybe") != -1 { .true: return 10, .false: {} }
    let maybe: String?("z")
    switch maybe != "z" { .true: return 11, .false: {} }
    @print("\(joined) \(words.read(at: 0)) \(n.name)")
    return 42
}
