function total(let xs: Array<Int>): Int {
    state sum: 0
    state i: 0
    while i < xs.count {
        sum: sum + xs.read(at: i)
        i: i + 1
    }
    return sum
}

{
    state xs: Array<Int>()
    if !xs.isEmpty() { return 1 }
    state i: 1
    while i <= 100 {
        xs.append(value: i)
        i: i + 1
    }
    if xs.count != 100 { return 2 }
    if xs.capacity != 128 { return 3 }
    if xs.read(at: 41) != 42 { return 4 }
    if total(xs: xs) != 5050 { return 5 }
    state bytes: Array<Int<bits: 8>>()
    bytes.append(value: -128)
    bytes.append(value: 127)
    if (bytes.read(at: 0) + bytes.read(at: 1)) != -1 { return 6 }
    return 42
}
