function total(let xs: Array<Int>): Int {
    state sum: 0
    state i: 0
    while i < xs.count {
        sum: sum + xs.read(at: i)
        i: i + 1
    }
    return sum
}

{
    state xs: Array<Int>()
    switch xs.isEmpty() { .false: return 1, .true: {} }
    state i: 1
    while i <= 100 {
        xs.append(value: i)
        i: i + 1
    }
    switch xs.count != 100 { .true: return 2, .false: {} }
    switch xs.capacity != 128 { .true: return 3, .false: {} }
    switch xs.read(at: 41) != 42 { .true: return 4, .false: {} }
    switch total(xs: xs) != 5050 { .true: return 5, .false: {} }
    state bytes: Array<Int<bits: 8>>()
    bytes.append(value: -128)
    bytes.append(value: 127)
    switch (bytes.read(at: 0) + bytes.read(at: 1)) != -1 { .true: return 6, .false: {} }
    return 42
}
