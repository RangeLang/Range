// for-in over Array, through the @iteration function @collection emits,
// over a copy taken when the loop begins; break and continue in for and
// while, releasing the values that end when they leave.
enum Shape {
    case group(Array<Int>)
    case nothing
}

function make(let n: Int): Array<Int> {
    state xs: Array<Int>()
    state i: 0
    while i < n {
        xs.append(value: i)
        i: i + 1
    }
    return xs
}

function sum(let xs: Array<Int>): Int {
    state total: 0
    for x in xs { total: total + x }
    return total
}

{
    let xs: make(n: 11)
    switch sum(xs: xs) != 55 { .true: return 1, .false: {} }
    state evens: 0
    for x in xs & x % 2 = 0 { evens: evens + x }
    switch evens != 30 { .true: return 2, .false: {} }
    state count: 0
    for _ in xs { count: count + 1 }
    switch count != 11 { .true: return 3, .false: {} }

    state rows: Array<Array<Int>>()
    state i: 0
    while i < 6 {
        rows.append(value: make(n: i))
        i: i + 1
    }
    state total: 0
    state round: 0
    while round < 20 {
        for row in rows {
            let copy: row
            switch copy.count = 1 { .true: continue, .false: {} }
            for x in row {
                switch x = 3 { .true: break, .false: {} }
                total: total + x
            }
            switch row.count = 5 { .true: break, .false: {} }
        }
        state shapes: Array<Shape>()
        shapes.append(value: .group(make(n: 3)))
        shapes.append(value: .nothing)
        shapes.append(value: .group(make(n: 4)))
        for s in shapes {
            switch s {
            .group(let items): {
                switch items.count = 3 { .true: continue, .false: {} }
                total: total + items.count
            },
            .nothing: {}
            }
        }
        for .group(let items) in shapes & items.count > 3 { total: total + 100 }
        round: round + 1
    }
    // Each round: rows 1 + 3 + 3 + 3, shapes 4, matched groups 100.
    switch total != 20 * 114 { .true: return 4, .false: {} }

    state maybes: Array<Int?>()
    maybes.append(value: .present(1))
    maybes.append(value: .absent)
    maybes.append(value: .present(4))
    maybes.append(value: .present(9))
    state found: 0
    for m in maybes {
        switch m {
            .present(let v): {
                switch v = 9 { .true: break, .false: {} } // a switch is not a break target: this ends the loop
                found: found + v
            },
            .absent: continue
        }
    }
    switch found != 5 { .true: return 5, .false: {} }

    // Changing the collection in the body does not change the iteration.
    state ys: Array<Int>()
    ys.append(value: 1)
    ys.append(value: 2)
    state visits: 0
    for y in ys {
        ys.append(value: y)
        visits: visits + 1
    }
    switch visits != 2 | ys.count != 4 { .true: return 6, .false: {} }

    state k: 0
    while true {
        k: k + 1
        switch k < 5 { .true: continue, .false: {} }
        break
    }
    switch k != 5 { .true: return 7, .false: {} }
    return 42
}
