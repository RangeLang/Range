// After let/state, Name(...) is a typed construction unless an operator
// follows: then the whole value is an expression, so `Int(2) + 1` is a
// construction plus one. Positional generics such as Array<Int>() parse in
// expressions and as arguments.
function f(let n: Int): Int { return n * 2 }

{
    let a: Int(2) + 1
    switch { a != 3: return 1, default: {} }
    let b: f(n: 1) = 2
    switch { !b: return 2, default: {} }
    let c: f(n: 3) + 1
    switch { c != 7: return 3, default: {} }
    state xs: Array<Int>()
    xs.append(value: 4)
    let d: xs.count = 1
    switch { !d: return 4, default: {} }
    let e: Int(5)
    switch { e != 5: return 5, default: {} }
    let g: 1 < 2
    switch { !g: return 6, default: {} }
    let h: Array<Int>().count + 1
    switch { h != 1: return 7, default: {} }
    state ys: Array<Array<Int>>()
    ys.append(value: Array<Int>())
    switch { ys.count != 1: return 8, default: {} }
    let k: 3 < 4 = true
    switch { !k: return 9, default: {} }
    return 42
}
