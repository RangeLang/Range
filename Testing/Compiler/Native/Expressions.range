// After let/state, Name(...) is a typed construction unless an operator
// follows: then the whole value is an expression, so `Int(2) + 1` is a
// construction plus one. Positional generics such as Array<Int>() parse in
// expressions and as arguments.
function f(let n: Int): Int { return n * 2 }

{
    let a: Int(2) + 1
    switch a != 3 { .true: return 1, .false: {} }
    let b: f(n: 1) = 2
    switch b { .false: return 2, .true: {} }
    let c: f(n: 3) + 1
    switch c != 7 { .true: return 3, .false: {} }
    state xs: Array<Int>()
    xs.append(value: 4)
    let d: xs.count = 1
    switch d { .false: return 4, .true: {} }
    let e: Int(5)
    switch e != 5 { .true: return 5, .false: {} }
    let g: 1 < 2
    switch g { .false: return 6, .true: {} }
    let h: Array<Int>().count + 1
    switch h != 1 { .true: return 7, .false: {} }
    state ys: Array<Array<Int>>()
    ys.append(value: Array<Int>())
    switch ys.count != 1 { .true: return 8, .false: {} }
    let k: 3 < 4 = true
    switch k { .false: return 9, .true: {} }
    return 42
}
