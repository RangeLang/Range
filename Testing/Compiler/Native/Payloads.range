// Payload cases: a tag plus the largest payload, inline. Construction labels
// the fields as declared; patterns bind them by position.
enum Token {
    case value(number: Int)
    case pair(Int, Int)
    case word(text: String, count: Int)
    case end
}

construct Lexer {
    state last: Token.end
    state seen: Array<Token>()

    function push(let token: Token) {
        last: token
        seen.append(value: token)
    }
}

function weigh(let t: Token): Int {
    switch {
    t.value(let number) & number > 100: return 100,
    t.value(let number): return number,
    t.pair(let a, let b): return a + b,
    t.word(text: _, let count): return count,
    t.end: return 0
    }
}

function make(let n: Int): Token {
    switch { n = 0: return .end, default: {} }
    switch { n < 0: return Token.pair(n, 3), default: {} }
    return .value(number: n)
}

{
    let t: Token.value(number: 7)
    switch { weigh(t: t) != 7: return 1, default: {} }
    switch { weigh(t: .value(number: 700)) != 100: return 2, default: {} }
    switch { weigh(t: .pair(4, -2)) != 2: return 3, default: {} }
    switch { weigh(t: Token.word(text: "hi", count: 5)) != 5: return 4, default: {} }
    switch { weigh(t: make(n: 0)) != 0: return 5, default: {} }
    switch { weigh(t: make(n: -10)) != -7: return 6, default: {} }
    state lexer: Lexer()
    lexer.push(token: make(n: 9))
    lexer.push(token: .word(text: "x", count: 2))
    switch { weigh(t: lexer.last) != 2: return 7, default: {} }
    switch { weigh(t: lexer.seen.read(at: 0)) != 9: return 8, default: {} }
    switch {
        lexer.seen.read(at: 0).value(let n): switch { n != 9: return 9, default: {} },
        default: return 10
    }
    switch { t.end: return 11, default: switch { t.value(number: 7): {}, default: return 12 } }
    return 42
}
