// Payload cases: a tag plus the largest payload, inline. Construction labels
// the fields as declared; patterns bind them by position.
enum Token {
    case value(number: Int)
    case pair(Int, Int)
    case word(text: String, count: Int)
    case end
}

construct Lexer {
    state last: Token.end
    state seen: Array<Token>()

    function push(let token: Token) {
        last: token
        seen.append(value: token)
    }
}

function weigh(let t: Token): Int {
    switch t {
    .value(let number) & number > 100: return 100,
    .value(let number): return number,
    .pair(let a, let b): return a + b,
    .word(text: _, let count): return count,
    .end: return 0
    }
}

function make(let n: Int): Token {
    switch n = 0 { .true: return .end, .false: {} }
    switch n < 0 { .true: return Token.pair(n, 3), .false: {} }
    return .value(number: n)
}

{
    let t: Token.value(number: 7)
    switch weigh(t: t) != 7 { .true: return 1, .false: {} }
    switch weigh(t: .value(number: 700)) != 100 { .true: return 2, .false: {} }
    switch weigh(t: .pair(4, -2)) != 2 { .true: return 3, .false: {} }
    switch weigh(t: Token.word(text: "hi", count: 5)) != 5 { .true: return 4, .false: {} }
    switch weigh(t: make(n: 0)) != 0 { .true: return 5, .false: {} }
    switch weigh(t: make(n: -10)) != -7 { .true: return 6, .false: {} }
    state lexer: Lexer()
    lexer.push(token: make(n: 9))
    lexer.push(token: .word(text: "x", count: 2))
    switch weigh(t: lexer.last) != 2 { .true: return 7, .false: {} }
    switch weigh(t: lexer.seen.read(at: 0)) != 9 { .true: return 8, .false: {} }
    switch lexer.seen.read(at: 0) {
        .value(let n): switch n != 9 { .true: return 9, .false: {} },
        default: return 10
    }
    switch t { .end: return 11, default: switch t { .value(number: 7): {}, default: return 12 } }
    return 42
}
