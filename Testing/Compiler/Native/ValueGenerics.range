// Value generics with defaults on a construct, and integer widths written in
// member, local, and parameter types.
construct Box<let width: 64> { let value: 3 }
construct Holder { let value: Int<bits: 32>(value: 3) }

function wide(let value: Int<bits: 64>): Int { return value }

{
    let box: Box()
    switch box.value != 3 { .true: return 1, .false: {} }
    let holder: Holder()
    switch holder.value != 3 { .true: return 2, .false: {} }
    switch false {
        .true: { let unused: Int<bits: 32>(value: 3) },
        .false: {}
    }
    switch wide(value: 3) != 3 { .true: return 3, .false: {} }
    return 42
}
