// = on enums with payloads is structural: equal cases, then equal fields,
// recursively. A case test's value argument of such a type compares with =.
enum Token {
    case value(number: Int)
    case pair(Int, Int)
    case flag(Bool)
    case end
}
enum Tree {
    case leaf(value: Int)
    case node(left: Tree, right: Tree)
}
enum Wrapper { case token(Token), none }
function classify(let t: Token): Int {
    switch {
    t.pair(1, 2): return 12,
    t.end: return 0,
    default: return -1
    }
}
{
    let a: Token.value(number: 7)
    switch { a != .value(number: 7): return 1, default: {} }
    switch { a = .value(number: 8): return 2, default: {} }
    switch { a = .end | Token.end != .end: return 3, default: {} }
    switch { Token.pair(1, 2) = .pair(2, 1): return 4, default: {} }
    switch { !((Token.flag(true) = .flag(true))): return 5, default: {} }
    let t: Tree.node(left: .leaf(value: 1), right: .node(left: .leaf(value: 2), right: .leaf(value: 3)))
    let u: Tree.node(left: .leaf(value: 1), right: .node(left: .leaf(value: 2), right: .leaf(value: 3)))
    switch { t != u: return 6, default: {} }
    switch { t = .node(left: .leaf(value: 1), right: .leaf(value: 5)): return 7, default: {} }
    switch { Wrapper.token(.pair(3, 4)) != .token(.pair(3, 4)): return 8, default: {} }
    switch { classify(t: .pair(1, 2)) != 12 | classify(t: .pair(2, 2)) != -1: return 9, default: {} }
    return 42
}
