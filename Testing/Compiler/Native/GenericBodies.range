// A generic body is checked once, against the constraints its type
// parameters write, whether or not anything uses it. With T: @integer, T has
// what @integer emits into every type applying it, so `a + b` adds two T
// values; a T without a constraint has only the built-in `=`. Code is still
// generated per use: Box<Int> adds Ints, Box<Int<bits: 8>> 8-bit ones.
construct Box<T: @integer> {
    let a: T
    let b: T
    function total(): T { return a + b }
    function both(): T { return total() }
    function same(): Bool { return a = b }
    // A generic method called from the construct's own body runs in the
    // receiver's specialization.
    function picked(): Bool { return pick(other: a, mine: true) }
    function pick<U>(let other: U, let mine: Bool): Bool { return mine }
}

construct Pair<T> {
    let a: T
    let b: T
    function same(): Bool { return a = b }
}

enum Either<L: @integer, R> {
    case left(L), right(R)
    function sum(let other: L): L {
        return switch { Either = .left(let v): v + other, default: other }
    }
}

{
    let ints: Box<Int>(a: 1, b: 2)
    switch { ints.total() != 3: return 1, default: {} }
    let small: Box<Int<bits: 8>>(a: 10, b: 20)
    switch { small.both() != 30: return 2, default: {} }
    switch { !ints.picked() | ints.same(): return 3, default: {} }
    let flags: Pair<Bool>(a: true, b: true)
    switch { !flags.same(): return 4, default: {} }
    let either: Either<Int, Bool>.left(4)
    switch { either.sum(other: 1) != 5: return 5, default: {} }
    return 42
}
