// Array applies @equatable with the equals @collection emits: equal counts,
// then equal elements in order, each pair compared with the element type's
// own `=`. Capacity is storage, not value.
construct Point { let x: Int  let y: Int }
construct Bag { let label: String  let items: Array<Int> }
enum Holding { case some(Array<Point>), none }

function ints(let values: Array<Int>, let extra: Int): Array<Int> {
    state xs: Array<Int>()
    for value in values { xs.append(value: value) }
    if extra > 0 { xs.append(value: extra) }
    return xs
}

function points(let n: Int): Array<Point> {
    state ps: Array<Point>()
    for i in 0..<n { ps.append(value: Point(x: i, y: i * 2)) }
    return ps
}

{
    state a: Array<Int>()
    state b: Array<Int>()
    if a != b { return 1 }
    a.append(value: 1) a.append(value: 2) a.append(value: 3)
    if a = b { return 2 }
    b.append(value: 1) b.append(value: 2) b.append(value: 3)
    if a != b { return 3 }
    b.append(value: 4)
    if a = b || b = a { return 4 }

    // Equal contents with different capacities: 4 slots against 3.
    state c: Array<Int>()
    c.resize(to: 3)
    c.capacity: 3
    c.write(at: 0, value: 1) c.write(at: 1, value: 2) c.write(at: 2, value: 3)
    c.count: 3
    if a.capacity = c.capacity || a != c { return 5 }
    state d: Array<Int>()
    d.append(value: 1) d.append(value: 2) d.append(value: 9)
    if a = d { return 6 }

    if points(n: 3) != points(n: 3) || points(n: 3) = points(n: 2) { return 7 }
    state moved: points(n: 2)
    moved.write(at: 1, value: Point(x: 1, y: 3))
    if moved = points(n: 2) { return 8 }

    // Nested: each inner array compares with Array<Int>'s own `=`.
    state grid: Array<Array<Int>>()
    grid.append(value: a)
    grid.append(value: ints(values: a, extra: 4))
    state same: Array<Array<Int>>()
    same.append(value: ints(values: a, extra: 0))
    same.append(value: b)
    if grid != same { return 9 }
    same.write(at: 1, value: a)
    if grid = same { return 10 }

    // A construct with an Array field compares it with Array's `=`.
    if Bag(label: "x", items: a) != Bag(label: "x", items: c) { return 11 }
    if Bag(label: "x", items: a) = Bag(label: "x", items: d) || Bag(label: "x", items: a) = Bag(label: "y", items: a) { return 12 }

    // An enum payload holding an Array.
    if Holding.some(points(n: 2)) != .some(points(n: 2)) || Holding.some(points(n: 2)) = .some(points(n: 1)) { return 13 }
    if Holding.some(points(n: 0)) = .none || Holding.none != .none { return 14 }
    return 42
}
