// One symbol per gate: `&` is and, `|` is or, `!` is not, on Bool only.
// Tightest first: `!`, arithmetic, comparisons, `&`, then `|`; parentheses
// only override it. `&` and `|` short-circuit.

function gate(let ready: Bool, let blocked: Bool, let forced: Bool): Bool {
    // (ready & !blocked) | forced
    return ready & !blocked | forced
}

// Each call counts, so a skipped right operand is visible.
function touched(let count: Int, let result: Bool): Bool {
    print(message: "touched \(count)")
    return result
}

{
    switch { !gate(ready: true, blocked: false, forced: false): return 1, default: {} }
    switch { gate(ready: true, blocked: true, forced: false): return 2, default: {} }
    switch { !gate(ready: false, blocked: true, forced: true): return 3, default: {} }
    // `|` is looser than `&`: true | false & false is true | (false & false).
    switch { !(true | false & false): return 4, default: {} }
    switch { (true | false) & false: return 5, default: {} }
    // Comparisons bind tighter than `&`: (a = b) & (c < d).
    let a: 2
    let b: 2
    let c: 1
    let d: 3
    switch { !(a = b & c < d): return 6, default: {} }
    // Arithmetic binds tighter than comparisons, `!` tighter than all.
    switch { !(a + 1 = d & !(c * 2 > d)): return 7, default: {} }
    switch { !(!(a = c) & a * c = b | false): return 8, default: {} }
    // Short circuit: the right operand runs only when the left one does not
    // decide the result.
    switch { false & touched(count: 1, result: true): return 9, default: {} }
    switch { !(true | touched(count: 2, result: false)): return 10, default: {} }
    switch { !(true & touched(count: 3, result: true)): return 11, default: {} }
    switch { !(false | touched(count: 4, result: true)): return 12, default: {} }
    return 42
}
