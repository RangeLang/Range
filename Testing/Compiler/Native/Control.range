// A switch over an enum covers its cases; one over an integer uses relations,
// values, and a default.
enum Direction { case north, south }

function classify(let direction: Direction): Int {
    switch direction {
    case .north: return 40
    case .south: return 9
    }
}

function small(let value: Int): Int {
    switch value {
    case < 0: return 8
    case 0: return 2
    default: return 5
    }
}

{
    let direction: Direction(.north)
    state values: Array<Int>()
    values.append(value: 10)
    if values.count != 1 || small(value: -1) != 8 || small(value: 3) != 5 { return 1 }
    return classify(direction: direction) + small(value: 0)
}
