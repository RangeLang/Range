// A method changes its construct's state through bare member names; values
// are copies, so changing one never changes another. && and || short-circuit.
construct Store {
    state values: Array<Int>()
    state revision: 0

    function replace(let index: Int, let value: Int): Int {
        values.write(at: index, value: value)
        revision: revision + 1
        return values.read(at: index)
    }
}

construct Envelope { let store: Store }

enum Outcome {
    case success(value: Envelope)
    case failure(code: Int)
}

function mutate(let store: Store): Envelope {
    state changed: store
    changed.values.append(value: 4294967297)
    changed.values.append(value: 5)
    let replaced: changed.replace(index: 1, value: 42)
    switch replaced != 42 { .true: return Envelope(store: store), .false: {} }
    return Envelope(store: changed)
}

function choose(let store: Store): Outcome {
    return .success(value: mutate(store: store))
}

function identity(let value: Int): Int { return value }

function early(let value: Int): Int {
    state index: 0
    while index < 4 {
        switch index = value { .true: return index, .false: {} }
        index: index + 1
    }
    return 9
}

{
    state original: 7
    let copied: original
    original: 8
    switch copied != 7 { .true: return 16, .false: {} }
    let store: Store()
    let result: choose(store: store)
    let nested: switch result { .success(let nested): nested, default: { return 1 } }
    switch store.revision != 0 || nested.store.revision != 1 { .true: return 2, .false: {} }
    switch nested.store.values.read(at: 0) != 4294967297 || nested.store.values.read(at: 1) != 42 { .true: return 3, .false: {} }
    switch store.values.count != 0 { .true: return 4, .false: {} }
    state total: 0
    state index: 0
    while index < 4 {
        total: total + early(value: index)
        index: index + 1
    }
    switch total != 6 { .true: return 7, .false: {} }
    // The right side would read outside the storage; it never runs.
    switch false && store.values.read(at: 999) = 0 { .true: return 8, .false: {} }
    switch (true || store.values.read(at: 999) = 0) { .false: return 9, .true: {} }
    switch identity(value: 42) != 42 { .true: return 11, .false: {} }
    return nested.store.values.read(at: 1)
}
