// switch is the only selector: every arm form, switch as a statement and as
// an expression, and the conditions its arms are written with.
enum Shape {
    case circle(radius: Int)
    case square(side: Int)
    case group(Array<Int>)
    case nothing
}

enum Light {
    case red, amber, green
}

// Every arm form of a statement switch: an expression (a call), a block, `{}`,
// return, an assignment, a call that writes, and a nested switch.
function forms(let n: Int): Int {
    state total: 0
    switch {
        n = 0: return 100,
        n = 1: total: 1,
        n = 2: {
            total: 20
            total: total + 2
        },
        n = 3: print(message: "three"),
        n = 4: switch { n > 3: total: 4, default: {} },
        n = 5: note(total: total),
        default: {}
    }
    return total
}

function note(let total: Int): Int {
    return total
}

// break and continue in arms leave the loop; a switch is not their target.
function loop(let xs: Array<Int>): Int {
    state sum: 0
    for x in xs {
        switch {
            x = 2: continue,
            x = 5: break,
            default: sum: sum + x
        }
    }
    return sum
}

// An expression switch in a return, with `|` alternatives that bind, a guard
// for both, and a payload binding.
function measure(let s: Shape): Int {
    return switch {
        (s.circle(radius: let n) | s.square(side: let n)) & n > 10: 1000,
        s.circle(let n) | s.square(let n): n,
        s.group(let items): items.count,
        s.nothing: 0
    }
}

// Arms comparing Int and String values.
function classify(let n: Int): Int {
    return switch {
        n = 0: 1,
        n = -1: 2,
        n < 0: 3,
        n >= 100: 4,
        n = 7: 5,
        default: 6
    }
}

function command(let word: String): Int {
    return switch {
        word = "quit": 1,
        word = "go": 2,
        default: 0
    }
}

// An arm that diverges with return: the value is bound for the rest.
function first(let xs: Array<Int>): Int {
    let value: switch {
        xs.count = 0: { return -1 },
        default: xs.read(at: 0)
    }
    return value + 1
}

function twice(let n: Int): Int {
    return n * 2
}

function next(let l: Light): Light {
    return switch { l.red: .green, l.amber: .red, l.green: .amber }
}

function lookup(let found: Bool): Int? {
    return switch { found: 5, default: Int?.absent }
}

// An aggregate value: the chosen arm's value moves or is retained into place.
function pick(let left: Bool, let a: Array<Int>, let b: Array<Int>): Array<Int> {
    return switch { left: a, default: b }
}

function made(let n: Int): Array<Int> {
    state xs: Array<Int>()
    for i in 0..<n { xs.append(value: i) }
    return xs
}

// Nested switches, as statements and as expressions.
function nested(let a: Bool, let b: Bool): Int {
    switch { a: switch { b: return 1, default: return 2 }, default: {} }
    return switch { b: 3, default: switch { a: 9, default: 4 } }
}

// break and continue inside a switch expression's arm, with the left operand
// of `+` already evaluated: the loop leaves it behind.
function partial(let xs: Array<Int>): Int {
    state sum: 0
    for x in xs {
        sum: sum + switch {
            x = 3: continue,
            x = 9: { break },
            default: x
        }
    }
    return sum
}

{
    switch { forms(n: 0) != 100 | forms(n: 1) != 1 | forms(n: 2) != 22: return 1, default: {} }
    switch { forms(n: 3) != 0 | forms(n: 4) != 4 | forms(n: 5) != 0 | forms(n: 6) != 0: return 2, default: {} }
    state xs: Array<Int>()
    for i in 1..<8 { xs.append(value: i) }
    switch { loop(xs: xs) != 1 + 3 + 4: return 3, default: {} }
    switch { measure(s: .circle(radius: 4)) + measure(s: .square(side: 11)) != 1004: return 4, default: {} }
    switch { measure(s: .group(xs)) != 7 | measure(s: .nothing) != 0: return 5, default: {} }
    switch { classify(n: 0) != 1 | classify(n: -1) != 2 | classify(n: -5) != 3: return 6, default: {} }
    switch { classify(n: 100) != 4 | classify(n: 7) != 5 | classify(n: 8) != 6: return 7, default: {} }
    switch { command(word: "quit") + command(word: "go") + command(word: "stay") != 3: return 8, default: {} }
    state empty: Array<Int>()
    switch { first(xs: empty) != -1 | first(xs: xs) != 2: return 9, default: {} }
    // In a let, an argument, and an operand.
    let light: switch { xs.count > 3: Light.red, default: .green }
    switch { next(l: light) != .green: return 10, default: {} }
    let doubled: twice(n: switch { light.red: 21, light.amber | light.green: 0 })
    switch { doubled != 42: return 11, default: {} }
    let sum: 1 + switch { light.red: 2, default: 0 } * 10
    switch { sum != 21: return 12, default: {} }
    // Optional promotion across arms, and Type?.case.
    switch { lookup(found: true) != Int?.present(5) | lookup(found: false) != .absent: return 13, default: {} }
    let none: Int?.absent
    switch { none.present: return 14, none.absent: {} }
    let chosen: pick(left: false, a: xs, b: made(n: 3))
    switch { chosen.count != 3 | pick(left: true, a: made(n: 2), b: xs).count != 2: return 15, default: {} }
    let text: switch { chosen.count = 3: "three", default: "other" }
    switch { text != "three": return 16, default: {} }
    switch { nested(a: true, b: true) != 1 | nested(a: true, b: false) != 2: return 17, default: {} }
    switch { nested(a: false, b: true) != 3 | nested(a: false, b: false) != 4: return 18, default: {} }
    state ys: Array<Int>()
    for i in 1..<12 { ys.append(value: i) }
    switch { partial(xs: ys) != 1 + 2 + 4 + 5 + 6 + 7 + 8: return 19, default: {} }
    // for with a case test and a filter in its condition.
    state shapes: Array<Shape>()
    shapes.append(value: .group(made(n: 2)))
    shapes.append(value: .nothing)
    shapes.append(value: .group(made(n: 5)))
    shapes.append(value: .circle(radius: 1))
    state counted: 0
    for s in shapes & s.group(let items) & items.count > 3 { counted: counted + items.count }
    for s in shapes & s.group { counted: counted + 100 }
    switch { counted != 205: return 20, default: {} }
    return 42
}
