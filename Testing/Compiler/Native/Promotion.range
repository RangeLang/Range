// A value of T where T? is expected is promoted to .present(value): returns,
// construction, arguments, assignments, members, and either side of =.
enum Direction { case north, south }
construct Person {
    let age: Int
    state manager: Int?.absent
}
function find(let xs: Array<Int>, let wanted: Int): Int? {
    for x in xs { switch x = wanted { .true: return x, .false: {} } }
    return .absent
}
function small(let n: Int): Int<bits: 8>? {
    switch n > 100 { .true: return .absent, .false: {} }
    return 5
}
function heading(let up: Bool): Direction? {
    switch up { .true: return .north, .false: {} }
    return .absent
}
function describe(let maybe: Int?): Int {
    let value: switch maybe { .present(let value): value, .absent: { return -1 } }
    return value
}
{
    state xs: Array<Int>()
    xs.append(value: 3) xs.append(value: 9)
    switch describe(maybe: find(xs: xs, wanted: 9)) != 9 { .true: return 1, .false: {} }
    switch describe(maybe: find(xs: xs, wanted: 4)) != -1 { .true: return 2, .false: {} }
    switch describe(maybe: 12) != 12 { .true: return 3, .false: {} }
    let x: Int?.present(5)
    switch x != 5 || x = 6 || x = .absent { .true: return 4, .false: {} }
    state y: Int?.absent
    y: 7
    switch describe(maybe: y) != 7 { .true: return 5, .false: {} }
    state p: Person(age: 30, manager: 2)
    switch p.manager != 2 { .true: return 6, .false: {} }
    p.manager: .absent
    switch p.manager != .absent { .true: return 7, .false: {} }
    let s: switch small(n: 1) { .present(let s): s, .absent: { return 8 } }
    switch s != 5 { .true: return 9, .false: {} }
    switch heading(up: true) != .north || heading(up: false) != .absent { .true: return 10, .false: {} }
    state names: Array<String?>()
    names.append(value: "Ada")
    names.append(value: .absent)
    state count: 0
    for .present(let name) in names { count: count + 1 }
    switch count != 1 { .true: return 11, .false: {} }
    return 42
}
