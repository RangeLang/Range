// Nested enums: declared in constructs and in other enums, named Outer.Inner,
// and by their bare name inside Outer. Payloads hold other enums and
// constructs, recursion through a construct included.
construct Light {
    enum Color {
        case red, amber, green

        enum Shade {
            case dim, bright
        }
    }

    state color: Color.red
    let shade: Color.Shade

    function next(): Color {
        switch color {
        .red: return .green,
        .green: return Color.amber,
        .amber: return .red
        }
    }

    function advance() {
        color: next()
    }
}

construct Holder {
    let inner: Light.Color
}

function name(let c: Light.Color): Int {
    switch c {
    .red: return 1,
    .amber: return 2,
    .green: return 3
    }
}

function bright(let s: Light.Color.Shade): Bool {
    return s = .bright
}

function lights(): Int {
    state light: Light(shade: .bright)
    light.advance()
    switch name(c: light.color) != 3 { .true: return 1, .false: {} }
    light.advance()
    switch light.color != Light.Color.amber { .true: return 2, .false: {} }
    let h: Holder(inner: .green)
    switch name(c: h.inner) != 3 { .true: return 3, .false: {} }
    switch bright(s: light.shade) { .false: return 4, .true: {} }
    let c: Light.Color.amber
    switch name(c: c) != 2 { .true: return 5, .false: {} }
    return 42
}

construct Pair {
    let left: Expr
    let right: Expr
}

enum Expr {
    case number(Int)
    case add(Pair)
    case negate(Expr)
    case scaled(by: Factor, of: Expr)

    enum Factor {
        case double, triple
    }
}

enum Statement {
    case print(Expr)
    case block(Array<Statement>)
}

function evaluate(let e: Expr): Int {
    switch e {
    .number(let n): return n,
    .add(let pair): return evaluate(e: pair.left) + evaluate(e: pair.right),
    .negate(let inner): return -evaluate(e: inner),
    .scaled(by: .double, let inner): return 2 * evaluate(e: inner),
    .scaled(by: .triple, let inner): return 3 * evaluate(e: inner)
    }
}

function run(let s: Statement): Int {
    switch s {
    .print(let e): return evaluate(e: e),
    .block(let statements): {
        state total: 0
        state i: 0
        while i < statements.count {
            total: total + run(s: statements.read(at: i))
            i: i + 1
        }
        return total
    }
    }
}

function expressions(): Int {
    let one: Expr.number(1)
    let sum: Expr.add(Pair(left: one, right: .negate(.number(5))))
    switch evaluate(e: sum) != -4 { .true: return 1, .false: {} }
    let f: Expr.Factor.triple
    let scaled: Expr.scaled(by: f, of: sum)
    switch evaluate(e: scaled) != -12 { .true: return 2, .false: {} }
    switch evaluate(e: .scaled(by: Expr.Factor.double, of: .number(21))) != 42 { .true: return 3, .false: {} }
    state body: Array<Statement>()
    body.append(value: .print(scaled))
    body.append(value: .print(.number(50)))
    state inner: Array<Statement>()
    inner.append(value: .print(one))
    body.append(value: .block(inner))
    switch run(s: .block(body)) != 39 { .true: return 4, .false: {} }
    return 42
}

{
    switch lights() != 42 { .true: return 1, .false: {} }
    switch expressions() != 42 { .true: return 2, .false: {} }
    return 42
}
