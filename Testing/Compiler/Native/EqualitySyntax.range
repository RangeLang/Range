// Equality is a single `=`; `:` assigns, binds, labels, and annotates. Each
// `:` below sits next to an `=` comparison, which needs no parentheses.
enum Shade { case light, dark(level: Int) }
construct Box { let size: Int }
function flagged(let flag: Bool): Int {
    switch { flag: return 1, default: {} }
    return 0
}
function same(let a: Int, let b: Int): Bool { return a = b }
function width(let n: Int<bits: 8>): Bool { return n = 8 }
function bucket(let n: Int): Int {
    switch {
    n = 0: return 0,
    n = 1: return 1,
    n % 2 = 0: return 2,
    default: return 3
    }
}
function level(let s: Shade): Int {
    let l: switch { s.dark(let l): l, default: { return -1 } }
    return l
}
{
    let a: 3
    let b: 3
    // Assignment and construction take a comparison as their value.
    state x: false
    x: a = b
    switch { !x: return 1, default: {} }
    x: a = b + 1
    switch { x: return 2, default: {} }
    let direct: a = b
    let typed: (a = b)
    state held: a + 1 = b
    switch { !direct | !typed | held: return 3, default: {} }
    let member: Box(size: 4)
    let measured: member.size = 4
    switch { !measured: return 4, default: {} }
    // A named argument whose value is a comparison.
    switch { flagged(flag: a = b) != 1 | flagged(flag: a != b) != 0: return 5, default: {} }
    switch { !same(a: a, b: 3) | same(a: 1, b: 2): return 6, default: {} }
    // Generic `<bits: 8>` and return types `): T` beside `=`.
    let small: Int<bits: 8>(8)
    switch { !width(n: small) | small = 9: return 7, default: {} }
    // Precedence: arithmetic binds tighter, `&` and `|` looser.
    switch { !((a + 1 = b * 2 - 2)): return 8, default: {} }
    switch { !(a = 3 & b = 3) | (a = 4 | b = 4): return 9, default: {} }
    switch { a < b = true: return 10, default: {} }
    // Case tests, payload bindings, and arm bodies next to `=`.
    let maybe: Int?.present(3)
    switch { maybe.present(let m): switch { !((m = a)): return 11, default: {} }, maybe.absent: return 12 }
    switch { maybe.present(let m): x: m = 3, default: return 13 }
    switch { !x: return 14, default: {} }
    switch { level(s: .dark(level: 2)) != 2 | level(s: .light) != -1: return 15, default: {} }
    switch { bucket(n: 0) != 0 | bucket(n: 1) != 1 | bucket(n: 4) != 2 | bucket(n: 5) != 3: return 16, default: {} }
    // Optional promotion, enums with payloads, and strings.
    switch { maybe = .absent | !(maybe = 3): return 17, default: {} }
    switch { !(Shade.dark(level: 1) = .dark(level: 1)) | Shade.light = .dark(level: 0): return 18, default: {} }
    let word: String("hi")
    switch { !(word = "hi") | word = "ho": return 19, default: {} }
    // while conditions and for-in filters.
    state i: 0
    while !(i = 3) { i: i + 1 }
    switch { i != 3: return 20, default: {} }
    state evens: 0
    for n in 0..<6 & n % 2 = 0 { evens: evens + 1 }
    switch { evens != 3: return 21, default: {} }
    return 42
}
