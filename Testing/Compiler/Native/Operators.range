// `a + b` calls the function `+` declared on a's type, and `-a` the `-` that
// takes no parameter. Int, Bool, and String declare theirs as builtins; a
// construct or enum declares its own with a body.
construct Vector {
    let x: Int
    let y: Int

    function +(let other: Vector): Vector { return Vector(x: x + other.x, y: y + other.y) }
    function -(let other: Vector): Vector { return Vector(x: x - other.x, y: y - other.y) }
    function *(let other: Int): Vector { return Vector(x: x * other, y: y * other) }
    function -(): Vector { return Vector(x: -x, y: -y) }
    function <(let other: Vector): Bool { return x * x + y * y < other.x * other.x + other.y * other.y }
}

enum Level {
    case low, high

    function <(let other: Level): Bool {
        switch Level {
        case .low: return other = .high
        case .high: return false
        }
    }
    function !(): Level {
        switch Level {
        case .low: return .high
        case .high: return .low
        }
    }
}

// An operator whose operand owns storage: the result is a new value.
construct Tally {
    state items: Array<Int>()

    function +(let other: Int): Tally {
        state next: Array<Int>()
        for item in items { next.append(value: item) }
        next.append(value: other)
        return Tally(items: next)
    }
}

function ranked(let v: Vector): Int {
    switch v {
    case < Vector(x: 1, y: 1): return 0
    default: return 1
    }
}

function width(let n: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> { return n * 2 + 1 }

{
    let a: Vector(x: 1, y: 2)
    let b: Vector(x: 3, y: 4)
    if a + b != Vector(x: 4, y: 6) { return 1 }
    if b - a != Vector(x: 2, y: 2) { return 2 }
    if a * 3 != Vector(x: 3, y: 6) { return 3 }
    if -a != Vector(x: -1, y: -2) { return 4 }
    if !(a < b) || b < a { return 5 }
    // Precedence stays Swift's: `*` binds tighter than `+`, `+` than `<`.
    if a + b * 2 != Vector(x: 7, y: 10) || !(a < a + b) { return 6 }
    if ranked(v: Vector(x: 0, y: 0)) != 0 || ranked(v: b) != 1 { return 7 }
    if !(Level.low < .high) || Level.high < .low || !Level.low != .high { return 8 }
    let t: Tally() + 1 + 2 + 3
    if t.items.count != 3 || t.items.read(at: 2) != 3 { return 9 }
    if width(n: 20) != 41 { return 10 }
    if !(1 < 2) || 2 <= 1 || !(3 >= 3) || 7 % 4 != 3 || -(2 - 5) != 3 { return 11 }
    if "ab" + "cd" != "abcd" { return 12 }
    return 42
}
