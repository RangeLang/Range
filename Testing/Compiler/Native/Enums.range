// Enums without payloads: a value is its tag. Cases are written Type.case,
// or .case wherever the context names the enum.
enum Direction {
    case north
    case east, south
    case west
}

construct Heading {
    state facing: Direction.north
    let fallback: Direction
}

function turn(let d: Direction): Direction {
    switch { d = .north: return .east, default: {} }
    switch { d = Direction.east: return .south, default: {} }
    switch { .south = d: return Direction.west, default: {} }
    return .north
}

{
    let a: Direction.north
    let b: turn(d: a)
    switch { b != .east: return 1, default: {} }
    switch { a = b: return 2, default: {} }
    state h: Heading(fallback: .west)
    h.facing: turn(d: h.facing)
    switch { h.facing != Direction.east | h.fallback != .west: return 3, default: {} }
    let copy: h
    h.facing: .south
    switch { copy.facing != .east: return 4, default: {} }
    state xs: Array<Direction>()
    xs.append(value: .south)
    xs.append(value: turn(d: .south))
    xs.append(value: turn(d: xs.read(at: 1)))
    switch { xs.read(at: 1) != .west | xs.read(at: 2) != .north: return 5, default: {} }
    state d: Direction.west
    d: turn(d: d)
    switch { d != .north: return 6, default: {} }
    @print("\(a) \(b) \(xs.read(at: 1)) \(h.fallback)")
    return 42
}
