// Enums without payloads: a value is its tag. Cases are written Type.case,
// or .case wherever the context names the enum.
enum Direction {
    case north
    case east, south
    case west
}

construct Heading {
    state facing: Direction.north
    let fallback: Direction
}

function turn(let d: Direction): Direction {
    switch d = .north { .true: return .east, .false: {} }
    switch d = Direction.east { .true: return .south, .false: {} }
    switch .south = d { .true: return Direction.west, .false: {} }
    return .north
}

{
    let a: Direction.north
    let b: turn(d: a)
    switch b != .east { .true: return 1, .false: {} }
    switch a = b { .true: return 2, .false: {} }
    state h: Heading(fallback: .west)
    h.facing: turn(d: h.facing)
    switch h.facing != Direction.east | h.fallback != .west { .true: return 3, .false: {} }
    let copy: h
    h.facing: .south
    switch copy.facing != .east { .true: return 4, .false: {} }
    state xs: Array<Direction>()
    xs.append(value: .south)
    xs.append(value: turn(d: .south))
    xs.append(value: turn(d: xs.read(at: 1)))
    switch xs.read(at: 1) != .west | xs.read(at: 2) != .north { .true: return 5, .false: {} }
    state d: Direction.west
    d: turn(d: d)
    switch d != .north { .true: return 6, .false: {} }
    @print("\(a) \(b) \(xs.read(at: 1)) \(h.fallback)")
    return 42
}
