construct Bag {
    state items: Array<Int>()

    function add(let value: Int) {
        items.append(value: value)
    }

    function snapshot(): Array<Int> {
        return items
    }
}

function filled(let n: Int): Array<Int> {
    state xs: Array<Int>()
    state i: 0
    while i < n {
        xs.append(value: i)
        i: i + 1
    }
    return xs
}

function mutateCopy(let xs: Array<Int>): Int {
    state local: xs
    local.append(value: 99)
    return local.count
}

{
    state a: filled(n: 3)
    state b: a
    b.append(value: 10)
    switch { a.count != 3: return 1, default: {} }
    switch { b.count != 4: return 2, default: {} }
    a.write(at: 0, value: 50)
    switch { b.read(at: 0) != 0: return 3, default: {} }
    switch { a.read(at: 0) != 50: return 4, default: {} }
    switch { mutateCopy(xs: a) != 4: return 5, default: {} }
    switch { a.count != 3: return 6, default: {} }

    state bag: Bag()
    bag.add(value: 1)
    state snap: bag.snapshot()
    bag.add(value: 2)
    switch { snap.count != 1: return 7, default: {} }
    snap.write(at: 0, value: 7)
    switch { bag.items.read(at: 0) != 1: return 8, default: {} }

    state grid: Array<Array<Int>>()
    grid.append(value: filled(n: 2))
    state other: grid
    state row: other.read(at: 0)
    row.write(at: 1, value: 42)
    switch { grid.read(at: 0).read(at: 1) != 1: return 9, default: {} }
    other.write(at: 0, value: row)
    switch { grid.read(at: 0).read(at: 1) != 1: return 10, default: {} }
    switch { other.read(at: 0).read(at: 1) != 42: return 11, default: {} }
    return 42
}
