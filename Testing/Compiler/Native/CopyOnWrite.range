construct Bag {
    state items: Array<Int>()

    function add(let value: Int) {
        items.append(value: value)
    }

    function snapshot(): Array<Int> {
        return items
    }
}

function filled(let n: Int): Array<Int> {
    state xs: Array<Int>()
    state i: 0
    while i < n {
        xs.append(value: i)
        i: i + 1
    }
    return xs
}

function mutateCopy(let xs: Array<Int>): Int {
    state local: xs
    local.append(value: 99)
    return local.count
}

{
    state a: filled(n: 3)
    state b: a
    b.append(value: 10)
    switch a.count != 3 { .true: return 1, .false: {} }
    switch b.count != 4 { .true: return 2, .false: {} }
    a.write(at: 0, value: 50)
    switch b.read(at: 0) != 0 { .true: return 3, .false: {} }
    switch a.read(at: 0) != 50 { .true: return 4, .false: {} }
    switch mutateCopy(xs: a) != 4 { .true: return 5, .false: {} }
    switch a.count != 3 { .true: return 6, .false: {} }

    state bag: Bag()
    bag.add(value: 1)
    state snap: bag.snapshot()
    bag.add(value: 2)
    switch snap.count != 1 { .true: return 7, .false: {} }
    snap.write(at: 0, value: 7)
    switch bag.items.read(at: 0) != 1 { .true: return 8, .false: {} }

    state grid: Array<Array<Int>>()
    grid.append(value: filled(n: 2))
    state other: grid
    state row: other.read(at: 0)
    row.write(at: 1, value: 42)
    switch grid.read(at: 0).read(at: 1) != 1 { .true: return 9, .false: {} }
    other.write(at: 0, value: row)
    switch grid.read(at: 0).read(at: 1) != 1 { .true: return 10, .false: {} }
    switch other.read(at: 0).read(at: 1) != 42 { .true: return 11, .false: {} }
    return 42
}
