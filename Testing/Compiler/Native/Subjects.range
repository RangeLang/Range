// A switch's conditions read cases off several subjects: `&` joins case
// tests, `|` joins alternatives, parentheses group them, and any other part
// of a condition guards the alternative it joins, or every alternative of a
// parenthesized group it follows.

enum Direction { case north, east, south, west }
enum Power { case on, off }
enum Shape { case circle(Int), square(Int), group(Array<Int>), nothing }

// Two subjects, alternatives joined by `|`.
function same(let a: Power, let b: Power): Int {
    switch {
        a.on & b.on | a.off & b.off: return 1,
        a.on & b.off: return 2,
        a.off & b.on: return 3
    }
}

// A group: (d.north | d.south) & p.on is two alternatives.
function axis(let d: Direction, let p: Power): Int {
    return switch {
        (d.north | d.south) & p.on: 1,
        (d.east | d.west) & p.on: 2,
        p.off: 0
    }
}

// Three subjects, some untested in an arm, and bindings from several.
function mix(let a: Int?, let b: Int?, let c: Power): Int {
    return switch {
        a.present(let x) & b.present(let y) & c.on: x + y,
        a.present(let x) & c.off: x,
        a.absent & b.present(let y): 100 + y,
        default: -1
    }
}

// A guard narrows only its own alternative: in
// `d.north & p.on | d.south & p.off & ready` it guards the second.
function perRow(let d: Direction, let p: Power, let ready: Bool): Int {
    switch {
        d.north & p.on | d.south & p.off & ready: return 1,
        default: return 0
    }
}

// Parenthesized alternatives share the guard after them.
function wholeArm(let d: Direction, let p: Power, let ready: Bool): Int {
    switch {
        (d.north & p.on | d.south & p.off) & ready: return 1,
        default: return 0
    }
}

// One subject takes guards the same way; a guard reads the bindings to its
// left, and guards join with `&`.
function single(let o: Int?): Int {
    return switch {
        o.present(let x) & x > 3 & x < 10: 1,
        o.present(let x) & (x = 0 | x = 1): 2,
        o.present: 3,
        o.absent: 4
    }
}

// Alternatives that bind the same names, with a guard on each.
function measure(let s: Shape, let limit: Int): Int {
    return switch {
        s.circle(let n) & limit < 10 | s.square(let n) & limit < 10 & n > 0: n,
        s.group(let items) & items.count > 2: 1000,
        default: 0
    }
}

// Comparisons with arithmetic operands, and a parenthesized operand.
function bounded(let n: Int, let limit: Int, let open: Bool): Int {
    return switch {
        n < limit + 1 & open: 1,
        n = limit * 2 | n = limit * 3: 2,
        default: 0
    }
}

function agrees(let flag: Bool, let a: Bool, let b: Bool): Int {
    return switch {
        flag = (a & b): 1,
        default: 0
    }
}

// Exhaustive over combinations without a default.
function both(let a: Bool, let b: Bool): Int {
    return switch {
        a.true & b.true: 3,
        a.true & b.false: 2,
        a.false: 0
    }
}

{
    switch {
        same(a: .on, b: .on) != 1 | same(a: .off, b: .off) != 1 | same(a: .on, b: .off) != 2 | same(a: .off, b: .on) != 3: return 1, default: {}
    }
    switch { axis(d: .south, p: .on) != 1 | axis(d: .west, p: .on) != 2 | axis(d: .north, p: .off) != 0: return 2, default: {} }
    switch { mix(a: .present(2), b: .present(3), c: .on) != 5 | mix(a: .present(2), b: .absent, c: .off) != 2: return 3, default: {} }
    switch { mix(a: .absent, b: .present(7), c: .on) != 107 | mix(a: .present(2), b: .absent, c: .on) != -1: return 4, default: {} }
    // perRow: the first alternative is unguarded.
    switch { perRow(d: .north, p: .on, ready: false) != 1 | perRow(d: .south, p: .off, ready: false) != 0: return 5, default: {} }
    switch { perRow(d: .south, p: .off, ready: true) != 1: return 6, default: {} }
    // wholeArm: both alternatives are guarded.
    switch { wholeArm(d: .north, p: .on, ready: false) != 0 | wholeArm(d: .north, p: .on, ready: true) != 1: return 7, default: {} }
    switch { wholeArm(d: .south, p: .off, ready: false) != 0 | wholeArm(d: .south, p: .off, ready: true) != 1: return 8, default: {} }
    switch { single(o: .present(5)) != 1 | single(o: .present(1)) != 2 | single(o: .present(12)) != 3 | single(o: .absent) != 4: return 9, default: {} }
    switch { measure(s: .circle(4), limit: 3) != 4 | measure(s: .square(0), limit: 3) != 0 | measure(s: .square(2), limit: 3) != 2: return 10, default: {} }
    state xs: Array<Int>()
    xs.append(value: 1)
    xs.append(value: 2)
    xs.append(value: 3)
    switch { measure(s: .group(xs), limit: 50) != 1000 | measure(s: .circle(4), limit: 50) != 0: return 11, default: {} }
    switch { both(a: true, b: true) != 3 | both(a: true, b: false) != 2 | both(a: false, b: true) != 0: return 12, default: {} }
    switch { bounded(n: 3, limit: 3, open: true) != 1 | bounded(n: 3, limit: 3, open: false) != 0: return 16, default: {} }
    switch { bounded(n: 6, limit: 3, open: false) != 2 | bounded(n: 9, limit: 3, open: true) != 2: return 17, default: {} }
    switch { agrees(flag: true, a: true, b: true) != 1 | agrees(flag: true, a: true, b: false) != 0: return 18, default: {} }
    switch { agrees(flag: false, a: true, b: false) != 1: return 19, default: {} }
    // A for-in condition filters; it never ends the loop.
    state shapes: Array<Shape>()
    shapes.append(value: .group(xs))
    shapes.append(value: .circle(1))
    shapes.append(value: .group(Array<Int>()))
    shapes.append(value: .group(xs))
    state counted: 0
    for .group(let items) in shapes & items.count > 2 & counted < 100 { counted: counted + items.count }
    switch { counted != 6: return 13, default: {} }
    state odd: 0
    for x in xs & (x = 1 | x = 3) { odd: odd + x }
    switch { odd != 4: return 14, default: {} }
    // Conditions in order, the first that holds runs, and a body block.
    state seen: 0
    for x in xs {
        switch {
            x > 1 & x != 2: { seen: seen + x },
            x > 1: seen: seen + 10,
            default: {}
        }
    }
    switch { seen != 13: return 15, default: {} }
    return 42
}
