// A bare name that resolves to a value copies it; one that resolves to a
// construct is a requirement. A value of the same spelling as a construct
// wins, and an inner block's name shadows an outer one.
construct User {
    let score: Int(42)
}

construct RequiredUser {
    let user: User
}

{
    let original: User()
    let user: original
    let required: RequiredUser(user: user)
    if required.user.score != 42 { return 1 }
    state number: Int(42)
    let snapshot: number
    number: 9
    if snapshot != 42 { return 2 }
    let User: Int(42)
    let selected: User
    if selected != 42 { return 3 }
    if true {
        let number: Int(7)
        let nested: number
        if nested != 7 { return 4 }
    }
    return snapshot
}
