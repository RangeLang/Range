// A bare name that resolves to a value copies it; one that resolves to a
// construct is a requirement. A value of the same spelling as a construct
// wins, and an inner block's name shadows an outer one.
construct User {
    let score: Int(42)
}

construct RequiredUser {
    let user: User
}

{
    let original: User()
    let user: original
    let required: RequiredUser(user: user)
    switch required.user.score != 42 { .true: return 1, .false: {} }
    state number: Int(42)
    let snapshot: number
    number: 9
    switch snapshot != 42 { .true: return 2, .false: {} }
    let User: Int(42)
    let selected: User
    switch selected != 42 { .true: return 3, .false: {} }
    switch true {
        .true: {
            let number: Int(7)
            let nested: number
            switch nested != 7 { .true: return 4, .false: {} }
        },
        .false: {}
    }
    return snapshot
}
