// A bare name that resolves to a value copies it; one that resolves to a
// construct is a requirement. A value of the same spelling as a construct
// wins, and an inner block's name shadows an outer one.
construct User {
    let score: Int(42)
}

construct RequiredUser {
    let user: User
}

{
    let original: User()
    let user: original
    let required: RequiredUser(user: user)
    switch { required.user.score != 42: return 1, default: {} }
    state number: Int(42)
    let snapshot: number
    number: 9
    switch { snapshot != 42: return 2, default: {} }
    let User: Int(42)
    let selected: User
    switch { selected != 42: return 3, default: {} }
    switch {
        true: {
            let number: Int(7)
            let nested: number
            switch { nested != 7: return 4, default: {} }
        },
        default: {}
    }
    return snapshot
}
