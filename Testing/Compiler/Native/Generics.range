// Generic functions are specialized per instantiation, as constructs are.
// Type arguments are inferred from the arguments, then from the expected
// result, or written: first<Int>(xs: …).
construct Point { let x: Int  let y: Int }
enum Shade { case light, dark }

function first<Element>(let xs: Array<Element>): Element? {
    for x in xs { return x }
    return .absent
}

function pick<Value>(let a: Value, let b: Value, let flag: Bool): Value {
    switch flag { .true: return a, .false: {} }
    return b
}

// Generic functions calling generic functions, and recursion.
function second<Element>(let xs: Array<Element>): Element? {
    state rest: Array<Element>()
    state skipped: false
    for x in xs {
        switch skipped { .true: rest.append(value: x), .false: {} }
        skipped: true
    }
    return first(xs: rest)
}

function count<Element>(let xs: Array<Element>, let value: Element): Int {
    state n: 0
    for x in xs where x = value { n: n + 1 }
    return n
}

function repeated<Element>(let value: Element, let times: Int): Array<Element> {
    state xs: Array<Element>()
    switch times > 0 {
        .true: {
            xs: repeated(value: value, times: times - 1)
            xs.append(value: value)
        },
        .false: {}
    }
    return xs
}

function orDefault<Value>(let maybe: Value?, let fallback: Value): Value {
    switch maybe { .present(let v): return v, .absent: {} }
    return fallback
}

// The type comes only from the expected result.
function nothing<Value>(): Value? { return .absent }

// Inside a generic construct, arguments mention its type parameter: the call
// is checked with T, and each specialization calls the instance for its type.
construct Box<T> {
    state items: Array<T>()
    function head(): T? { return first(xs: items) }
    function written(): T? { return first<T>(xs: items) }
    function tally(let value: T): Int { return count(xs: items, value: value) }
}

// Value generics are constants per instantiation: a default, or a value
// written at the call; `<let n: Int>` has no default and is always written.
function scaled<let factor: 2>(let n: Int): Int { return n * factor }
function times<let n: Int>(let value: Int): Int { return value * n }
function filled<Element, let size: Int>(let value: Element): Array<Element> {
    state xs: Array<Element>()
    for i in 0..<size { xs.append(value: value) }
    return xs
}
function chosen<let flag: Bool, let small: Int<bits: 8>>(): Int<bits: 8> {
    switch flag { .true: return small, .false: {} }
    return -small
}

// A construct's required value generic, read in its methods.
construct Grid<let width: Int> {
    let cells: 0
    function size(let rows: Int): Int { return width * rows }
}

{
    state numbers: Array<Int>()
    numbers.append(value: 7)
    numbers.append(value: 8)
    switch first(xs: numbers) != 7 | second(xs: numbers) != 8 { .true: return 1, .false: {} }
    switch first(xs: Array<Int>()) != .absent { .true: return 2, .false: {} }
    switch pick(a: 1, b: 2, flag: true) != 1 | pick(a: 1, b: 2, flag: false) != 2 { .true: return 3, .false: {} }
    let p: pick(a: Point(x: 1, y: 2), b: Point(x: 3, y: 4), flag: false)
    switch p.x != 3 { .true: return 4, .false: {} }
    switch pick(a: Shade.light, b: .dark, flag: false) != .dark { .true: return 5, .false: {} }
    let narrow: Int<bits: 8>(5)
    switch pick(a: narrow, b: 6, flag: false) != 6 { .true: return 6, .false: {} }
    switch pick<Int>(a: 1, b: 2, flag: true) != 1 { .true: return 7, .false: {} }
    let words: repeated(value: "ab", times: 3)
    switch words.count != 3 | first(xs: words) != "ab" | count(xs: words, value: "ab") != 3 { .true: return 8, .false: {} }
    switch count(xs: numbers, value: 8) != 1 { .true: return 9, .false: {} }
    switch orDefault(maybe: first(xs: Array<Point>()), fallback: p) != Point(x: 3, y: 4) { .true: return 10, .false: {} }
    let none: nothing<Int>()
    switch none != .absent { .true: return 11, .false: {} }
    state box: Box<Int>()
    box.items.append(value: 5)
    box.items.append(value: 5)
    switch box.head() != 5 | box.written() != 5 | box.tally(value: 5) != 2 { .true: return 12, .false: {} }
    state named: Box<String>()
    switch named.head() != .absent { .true: return 13, .false: {} }
    named.items.append(value: "x")
    switch named.written() != "x" { .true: return 14, .false: {} }
    switch scaled(n: 5) != 10 | scaled<factor: 3>(n: 5) != 15 | scaled<factor: -1>(n: 5) != -5 { .true: return 15, .false: {} }
    switch times<n: 4>(value: 2) != 8 { .true: return 16, .false: {} }
    let three: filled<size: 3>(value: "ab")
    switch three.count != 3 | first(xs: three) != "ab" | filled<size: 0>(value: 1).count != 0 { .true: return 17, .false: {} }
    switch chosen<flag: true, small: 7>() != 7 | chosen<flag: false, small: 7>() != -7 { .true: return 18, .false: {} }
    switch Grid<width: 3>().size(rows: 2) != 6 | Grid<width: 5>().size(rows: 2) != 10 { .true: return 19, .false: {} }
    return 42
}
