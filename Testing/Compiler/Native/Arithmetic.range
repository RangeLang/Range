function square(let x: Int): Int {
    return x * x
}

function sumTo(let n: Int): Int {
    state total: 0
    state i: 1
    while i <= n {
        total: total + i
        i: i + 1
    }
    return total
}

function fib(let n: Int): Int {
    switch n < 2 {
        .true: return n,
        .false: {}
    }
    return fib(n: n - 1) + fib(n: n - 2)
}

function check(let n: Int): Bool {
    return n != 0 && 10 / n = 5
}

function step(let x: Int<bits: 8>): Int<bits: 8> {
    return x + 100
}

function down(let a: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> {
    return a - 1
}

{
    switch (square(x: 6) + sumTo(n: 4)) != 46 { .true: return 1, .false: {} }
    switch fib(n: 20) != 6765 { .true: return 2, .false: {} }
    switch check(n: 0) { .true: return 3, .false: {} }
    switch check(n: 2) { .false: return 4, .true: {} }
    switch (17 % 5 + -3 * -2) != 8 { .true: return 5, .false: {} }
    let r: step(x: 20)
    switch r != 120 { .true: return 6, .false: {} }
    let z: down(a: 255)
    switch z != 254 { .true: return 7, .false: {} }
    return 42
}
