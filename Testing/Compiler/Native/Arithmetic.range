function square(let x: Int): Int {
    return x * x
}

function sumTo(let n: Int): Int {
    state total: 0
    state i: 1
    while i <= n {
        total: total + i
        i: i + 1
    }
    return total
}

function fib(let n: Int): Int {
    switch { n < 2: return n, default: {} }
    return fib(n: n - 1) + fib(n: n - 2)
}

function check(let n: Int): Bool {
    return n != 0 & 10 / n = 5
}

function step(let x: Int<bits: 8>): Int<bits: 8> {
    return x + 100
}

function down(let a: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> {
    return a - 1
}

{
    switch { (square(x: 6) + sumTo(n: 4)) != 46: return 1, default: {} }
    switch { fib(n: 20) != 6765: return 2, default: {} }
    switch { check(n: 0): return 3, default: {} }
    switch { !check(n: 2): return 4, default: {} }
    switch { (17 % 5 + -3 * -2) != 8: return 5, default: {} }
    let r: step(x: 20)
    switch { r != 120: return 6, default: {} }
    let z: down(a: 255)
    switch { z != 254: return 7, default: {} }
    return 42
}
