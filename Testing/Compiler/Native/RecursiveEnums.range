// Recursive enums need no marker: a field whose type contains its own enum
// is stored out of line in a reference-counted block, released when its last
// value ends. Other fields stay inline.
enum Tree {
    case leaf(value: Int)
    case node(left: Tree, right: Tree)
}

enum List {
    case end
    case link(value: Int, next: List)
}

function build(let depth: Int, let start: Int): Tree {
    switch depth = 0 { .true: return .leaf(value: start), .false: {} }
    return .node(left: build(depth: depth - 1, start: start), right: build(depth: depth - 1, start: start + 1))
}

function sum(let tree: Tree): Int {
    switch tree {
    .leaf(let value): return value,
    .node(let left, let right): return sum(tree: left) + sum(tree: right)
    }
}

function count(let list: List): Int {
    state total: 0
    state rest: list
    state going: true
    while going {
        switch rest {
        .end: going: false,
        .link(let value, let next): {
            total: total + value
            rest: next
        }
        }
    }
    return total
}

function range(let n: Int): List {
    state list: List.end
    state i: n
    while i > 0 {
        list: .link(value: i, next: list)
        i: i - 1
    }
    return list
}

{
    state round: 0
    state checksum: 0
    while round < 50 {
        let t: build(depth: 6, start: 1)
        state copy: t
        copy: .node(left: copy, right: .leaf(value: 100))
        checksum: checksum + sum(tree: t) + sum(tree: copy)
        let xs: range(n: 100)
        state ys: xs
        ys: .link(value: 1000, next: ys)
        checksum: checksum + count(list: xs) + count(list: ys)
        round: round + 1
    }
    switch sum(tree: build(depth: 1, start: 1)) != 3 { .true: return 1, .false: {} }
    switch count(list: range(n: 4)) != 10 { .true: return 2, .false: {} }
    // Per round: trees 256 + 356, lists 5050 + 6050.
    switch checksum != 50 * (256 + 356 + 5050 + 6050) { .true: return 3, .false: {} }
    return 42
}
