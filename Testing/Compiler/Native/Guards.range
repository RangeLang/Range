// Early exits: an arm diverges with return, break, continue, or @diagnostic.
// A switch expression whose other arms diverge binds the value that one yields,
// in scope for the rest of the block.
enum Token {
    case value(number: Int)
    case end
}

function first(let xs: Array<Int>): Int? {
    switch xs.count > 0 { .false: return .absent, .true: {} }
    return .present(xs.read(at: 0))
}

function double(let maybe: Int?): Int {
    let n: switch maybe { .present(let n): n, .absent: { return -1 } }
    return n * 2
}

function unwrap(let maybe: Int?): Int {
    let value: switch maybe { .present(let value): value, .absent: { return 0 } }
    return value
}

function number(let t: Token): Int {
    let n: switch t { .value(let n): n, default: { return -1 } }
    let twice: n + n
    return twice
}

function filtered(let xs: Array<Int>): Int {
    state total: 0
    for x in xs {
        switch x != 2 { .false: continue, .true: {} }
        switch x < 4 { .false: break, .true: {} }
        total: total + x
    }
    return total
}

function strict(let n: Int): Int {
    switch n > 0 { .false: @diagnostic("n must be positive"), .true: {} }
    switch n {
    1: {
        switch n = 1 { .false: return 0, .true: {} }
        return 10
    },
    default: return n
    }
    return 0
}

function longest(let groups: Array<Array<Int>>): Int {
    state best: 0
    for group in groups {
        switch group.count > best { .false: continue, .true: {} }
        best: group.count
    }
    return best
}

{
    state xs: Array<Int>()
    switch first(xs: xs) { .present(let f): return 1, .absent: {} }
    xs.append(value: 1)
    xs.append(value: 2)
    xs.append(value: 3)
    xs.append(value: 4)
    xs.append(value: 5)
    let f: switch first(xs: xs) { .present(let f): f, .absent: { return 2 } }
    switch f != 1 { .true: return 3, .false: {} }
    switch double(maybe: .present(4)) != 8 || double(maybe: .absent) != -1 { .true: return 4, .false: {} }
    switch unwrap(maybe: .present(7)) != 7 || unwrap(maybe: .absent) != 0 { .true: return 5, .false: {} }
    switch number(t: .value(number: 6)) != 12 || number(t: .end) != -1 { .true: return 6, .false: {} }
    switch filtered(xs: xs) != 4 { .true: return 7, .false: {} }
    switch strict(n: 1) != 10 || strict(n: 3) != 3 { .true: return 8, .false: {} }
    state groups: Array<Array<Int>>()
    groups.append(value: xs)
    state empty: Array<Int>()
    groups.append(value: empty)
    switch longest(groups: groups) != 5 { .true: return 9, .false: {} }
    return 42
}
