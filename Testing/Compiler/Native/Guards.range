// Early exits: an arm diverges with return, break, continue, or diagnostic.
// A switch expression whose other arms diverge binds the value that one yields,
// in scope for the rest of the block.
enum Token {
    case value(number: Int)
    case end
}

function first(let xs: Array<Int>): Int? {
    switch { xs.count <= 0: return .absent, default: {} }
    return .present(xs.read(at: 0))
}

function double(let maybe: Int?): Int {
    let n: switch { maybe.present(let n): n, maybe.absent: { return -1 } }
    return n * 2
}

function unwrap(let maybe: Int?): Int {
    let value: switch { maybe.present(let value): value, maybe.absent: { return 0 } }
    return value
}

function number(let t: Token): Int {
    let n: switch { t.value(let n): n, default: { return -1 } }
    let twice: n + n
    return twice
}

function filtered(let xs: Array<Int>): Int {
    state total: 0
    for x in xs {
        switch { x = 2: continue, default: {} }
        switch { x >= 4: break, default: {} }
        total: total + x
    }
    return total
}

function strict(let n: Int): Int {
    switch { n <= 0: diagnostic(message: "n must be positive"), default: {} }
    switch {
    n = 1: {
        switch { n != 1: return 0, default: {} }
        return 10
    },
    default: return n
    }
    return 0
}

function longest(let groups: Array<Array<Int>>): Int {
    state best: 0
    for group in groups {
        switch { group.count <= best: continue, default: {} }
        best: group.count
    }
    return best
}

{
    state xs: Array<Int>()
    switch { first(xs: xs).present: return 1, default: {} }
    xs.append(value: 1)
    xs.append(value: 2)
    xs.append(value: 3)
    xs.append(value: 4)
    xs.append(value: 5)
    let f: switch { first(xs: xs).present(let f): f, default: { return 2 } }
    switch { f != 1: return 3, default: {} }
    switch { double(maybe: .present(4)) != 8 | double(maybe: .absent) != -1: return 4, default: {} }
    switch { unwrap(maybe: .present(7)) != 7 | unwrap(maybe: .absent) != 0: return 5, default: {} }
    switch { number(t: .value(number: 6)) != 12 | number(t: .end) != -1: return 6, default: {} }
    switch { filtered(xs: xs) != 4: return 7, default: {} }
    switch { strict(n: 1) != 10 | strict(n: 3) != 3: return 8, default: {} }
    state groups: Array<Array<Int>>()
    groups.append(value: xs)
    state empty: Array<Int>()
    groups.append(value: empty)
    switch { longest(groups: groups) != 5: return 9, default: {} }
    return 42
}
