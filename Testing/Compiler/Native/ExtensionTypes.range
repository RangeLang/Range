// Declarations whose equality is written through extensions in
// ExtensionEquality.range, a separate file.
construct Fraction {
    let numerator: Int
    let denominator: Int
}

enum Parity { case even, odd }

construct Plain { let n: Int }

// Written on the declaration and again through an extension: one application.
@equatable
construct Twice {
    let n: Int
    function =(let other: Twice): Bool { return true }
}

// Reports whether @equatable is written, through an extension too.
macro reportsEquatable(): Construct {
    let written: #target.macros.first(where: { applied in applied.name = "equatable" })
    switch {
        written.present: @warning("\(#target.name) writes @equatable"),
        written.absent: @warning("\(#target.name) does not write @equatable")
    }
}

@reportsEquatable
construct Written { let n: Int }

// Compared by the built-in structural '='.
construct Defaulted { let n: Int }

// Emitted through #graph: the application's extension carries @equatable.
macro alwaysEqual(): Enum {
    #graph {
        @equatable
        extension #target.name {
            function =(let other: #target.name): Bool { return true }
        }
    }
}

@alwaysEqual
enum Coin { case heads, tails }
