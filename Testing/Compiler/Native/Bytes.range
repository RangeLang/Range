// A string holds any bytes, NUL among them; count is its byte count and
// byte(at:) reads one, and `=` compares the bytes.
{
    let text: String("A\0B")
    switch { text.count != 3: return 1, default: {} }
    switch { text.byte(at: 1) != 0 | text.byte(at: 2) != 66: return 2, default: {} }
    let copy: text
    switch { copy != "A\0B" | copy = "A": return 3, default: {} }
    return 42
}
