// A string holds any bytes, NUL among them; count is its byte count and
// byte(at:) reads one, and `=` compares the bytes.
{
    let text: String("A\0B")
    switch text.count != 3 { .true: return 1, .false: {} }
    switch text.byte(at: 1) != 0 | text.byte(at: 2) != 66 { .true: return 2, .false: {} }
    let copy: text
    switch copy != "A\0B" | copy = "A" { .true: return 3, .false: {} }
    return 42
}
