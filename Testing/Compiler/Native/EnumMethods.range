// Methods in an enum body and in an extension. Range has no self: inside an
// enum's own functions a bare case name tests the current value, and the
// enum's name is the type.
// Calls are value.method().
enum Direction {
    case north, east, south, west

    function turned(): Direction {
        switch {
        north: return .east,
        east: return .south,
        south: return .west,
        west: return .north
        }
    }

    function opposite(): Direction {
        return turned().turned()
    }
}

extension Direction {
    function vertical(): Bool {
        switch {
        north | south: return true,
        default: return false
        }
    }

    // The enum's name is the type: Direction.north makes a value.
    function isStart(): Bool {
        switch { north: return Direction.north = .north, default: {} }
        return false
    }
}

enum Tree {
    case leaf(value: Int)
    case node(left: Tree, right: Tree)

    function sum(): Int {
        switch {
        leaf(let value): return value,
        node(let left, let right): return left.sum() + right.sum()
        }
    }
}

// A generic enum uses its bare name.
enum Either<Left, Right> {
    case left(Left)
    case right(Right)
}

extension Either {
    function isLeft(): Bool {
        switch { left(_): return true, default: {} }
        return false
    }

    function leftOr(let fallback: Left): Left {
        let value: switch { left(let value): value, default: { return fallback } }
        return value
    }
}

extension Optional {
    function isPresent(): Bool {
        switch { present(_): return true, default: {} }
        return false
    }
}

// With nesting, the innermost name wins.
enum Light {
    case on(Color), off

    enum Color {
        case red, green

        function swapped(): Color {
            switch {
            red: return .green,
            green: return .red
            }
        }
    }

    function color(): Color {
        switch {
        on(let c): return c,
        off: return .red
        }
    }
}

// A construct's own functions reach its members by their bare names.
construct Walker {
    state facing: Direction.north
    function step() { facing: facing.turned() }
    function current(): Direction { return facing }
}

{
    let d: Direction.north
    switch { d.turned() != .east: return 1, default: {} }
    switch { d.opposite() != .south: return 2, default: {} }
    switch { !d.vertical() | Direction.east.vertical(): return 3, default: {} }
    switch { d.turned().turned().turned().vertical(): return 4, default: {} }
    let t: Tree.node(left: .leaf(value: 4), right: .node(left: .leaf(value: 5), right: .leaf(value: 6)))
    switch { t.sum() != 15: return 5, default: {} }
    let e: Either<Int, Bool>.left(3)
    switch { !e.isLeft() | e.leftOr(fallback: 9) != 3: return 6, default: {} }
    let r: Either<Int, Bool>.right(true)
    switch { r.isLeft() | r.leftOr(fallback: 9) != 9: return 7, default: {} }
    state w: Walker()
    w.step()
    switch { w.current() != .east: return 8, default: {} }
    switch { !d.isStart() | Direction.west.isStart(): return 9, default: {} }
    let maybe: Int?.present(4)
    let none: Int?.absent
    switch { !maybe.isPresent() | none.isPresent(): return 10, default: {} }
    let lit: Light.on(.green)
    switch { lit.color() != .green | lit.color().swapped() != .red | Light.off.color() != .red: return 11, default: {} }
    @print("\(d.opposite()) \(t.sum())")
    return 42
}
