// Methods in an enum body and in an extension. Range has no self: inside an
// enum's own functions the enum's name, as a switch subject, is the current
// value; everywhere else it is the type.
// Calls are value.method().
enum Direction {
    case north, east, south, west

    function turned(): Direction {
        switch Direction {
        .north: return .east,
        .east: return .south,
        .south: return .west,
        .west: return .north
        }
    }

    function opposite(): Direction {
        return turned().turned()
    }
}

extension Direction {
    function vertical(): Bool {
        switch Direction {
        .north | .south: return true,
        default: return false
        }
    }

    // The name is still the type outside a subject position.
    function isStart(): Bool {
        switch Direction { .north: return Direction.north = .north, default: {} }
        return false
    }
}

enum Tree {
    case leaf(value: Int)
    case node(left: Tree, right: Tree)

    function sum(): Int {
        switch Tree {
        .leaf(let value): return value,
        .node(let left, let right): return left.sum() + right.sum()
        }
    }
}

// A generic enum uses its bare name.
enum Either<Left, Right> {
    case left(Left)
    case right(Right)
}

extension Either {
    function isLeft(): Bool {
        switch Either { .left(_): return true, default: {} }
        return false
    }

    function leftOr(let fallback: Left): Left {
        let value: switch Either { .left(let value): value, default: { return fallback } }
        return value
    }
}

extension Optional {
    function isPresent(): Bool {
        switch Optional { .present(_): return true, default: {} }
        return false
    }
}

// With nesting, the innermost name wins.
enum Light {
    case on(Color), off

    enum Color {
        case red, green

        function swapped(): Color {
            switch Color {
            .red: return .green,
            .green: return .red
            }
        }
    }

    function color(): Color {
        switch Light {
        .on(let c): return c,
        .off: return .red
        }
    }
}

// A construct's own functions reach its members by their bare names.
construct Walker {
    state facing: Direction.north
    function step() { facing: facing.turned() }
    function current(): Direction { return facing }
}

{
    let d: Direction.north
    switch d.turned() != .east { .true: return 1, .false: {} }
    switch d.opposite() != .south { .true: return 2, .false: {} }
    switch !d.vertical() || Direction.east.vertical() { .true: return 3, .false: {} }
    switch d.turned().turned().turned().vertical() { .true: return 4, .false: {} }
    let t: Tree.node(left: .leaf(value: 4), right: .node(left: .leaf(value: 5), right: .leaf(value: 6)))
    switch t.sum() != 15 { .true: return 5, .false: {} }
    let e: Either<Int, Bool>.left(3)
    switch !e.isLeft() || e.leftOr(fallback: 9) != 3 { .true: return 6, .false: {} }
    let r: Either<Int, Bool>.right(true)
    switch r.isLeft() || r.leftOr(fallback: 9) != 9 { .true: return 7, .false: {} }
    state w: Walker()
    w.step()
    switch w.current() != .east { .true: return 8, .false: {} }
    switch !d.isStart() || Direction.west.isStart() { .true: return 9, .false: {} }
    let maybe: Int?(4)
    let none: Int?.absent
    switch !maybe.isPresent() || none.isPresent() { .true: return 10, .false: {} }
    let lit: Light.on(.green)
    switch lit.color() != .green || lit.color().swapped() != .red || Light.off.color() != .red { .true: return 11, .false: {} }
    @print("\(d.opposite()) \(t.sum())")
    return 42
}
