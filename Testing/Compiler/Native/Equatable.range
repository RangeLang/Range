// `a = b` calls the function `=` declared on a's type. Every construct and
// enum has a built-in structural `=`: a construct member by member, an enum
// by case, then payload, recursively. A type that writes `=` compares with
// it; @equatable checks a written `=`.
construct Point { let x: Int  let y: Int }
construct Segment { let from: Point  let to: Point }
enum Shape { case dot(Point), line(Segment), none }
enum Tree { case leaf(Int), node(left: Tree, right: Tree) }
construct Box<Value> { let value: Value }

// In a generic body, `=` on a type parameter compares through each
// specialization's own equality.
construct Pair<Value> {
    let first: Value
    let second: Value
    function same(): Bool { return first = second }
}

// 1/2 = 2/4: equality is its own, not member by member.
@equatable
construct Fraction {
    let numerator: Int
    let denominator: Int

    function =(let other: Fraction): Bool {
        return numerator * other.denominator = other.numerator * denominator
    }
}

// Default equality cascades into a field with its own `=`.
construct Measure { let amount: Fraction  let unit: String }
enum Reading { case exact(Fraction), unknown }

// Every parity is equal to every other: the custom equality is used.
@equatable
enum Parity {
    case even, odd

    function =(let other: Parity): Bool { return true }
}

// Warned: @equatable without `=` keeps the built-in equality.
@equatable
construct Plain { let n: Int }

// A function named equals is an ordinary function: `=` stays structural, so
// 1/2 and 2/4 differ here.
construct LooseFraction {
    let numerator: Int
    let denominator: Int

    function equals(let other: LooseFraction): Bool {
        return numerator * other.denominator = other.numerator * denominator
    }
}

// Without @equatable, a written `=` is used all the same; nothing checks it.
construct Unmarked {
    let n: Int
    function =(let other: Unmarked): Bool { return true }
}

function classify(let p: Point): Int {
    let origin: Point(x: 0, y: 0)
    switch {
    p = origin: return 0,
    p = Point(x: 1, y: 1): return 1,
    default: return 2
    }
}

function half(let f: Fraction): Bool {
    switch {
    f = Fraction(numerator: 1, denominator: 2): return true,
    default: return false
    }
}

{
    let a: Point(x: 1, y: 2)
    switch { a != Point(x: 1, y: 2) | a = Point(x: 2, y: 1): return 1, default: {} }
    let s: Segment(from: a, to: Point(x: 3, y: 4))
    switch { s != Segment(from: Point(x: 1, y: 2), to: Point(x: 3, y: 4)): return 2, default: {} }
    switch { Shape.line(s) != .line(s) | Shape.dot(a) = .dot(Point(x: 0, y: 0)) | Shape.none != .none: return 3, default: {} }
    let t: Tree.node(left: .leaf(1), right: .node(left: .leaf(2), right: .leaf(3)))
    switch { t != .node(left: .leaf(1), right: .node(left: .leaf(2), right: .leaf(3))): return 4, default: {} }
    switch { t = .node(left: .leaf(1), right: .leaf(5)): return 5, default: {} }
    switch { Box<Point>(value: a) != Box<Point>(value: Point(x: 1, y: 2)): return 6, default: {} }
    let half1: Fraction(numerator: 1, denominator: 2)
    let half2: Fraction(numerator: 2, denominator: 4)
    switch { half1 != half2 | half1 = Fraction(numerator: 1, denominator: 3): return 7, default: {} }
    switch { Measure(amount: half1, unit: "kg") != Measure(amount: half2, unit: "kg"): return 8, default: {} }
    switch { Measure(amount: half1, unit: "kg") = Measure(amount: half2, unit: "lb"): return 9, default: {} }
    switch { Reading.exact(half1) != .exact(half2) | Reading.exact(half1) = .unknown: return 10, default: {} }
    switch { Parity.even != .odd: return 11, default: {} }
    switch { Plain(n: 1) = Plain(n: 2) | Plain(n: 3) != Plain(n: 3): return 12, default: {} }
    let loose: LooseFraction(numerator: 1, denominator: 2)
    switch { loose = LooseFraction(numerator: 2, denominator: 4) | loose != LooseFraction(numerator: 1, denominator: 2): return 13, default: {} }
    switch { !loose.equals(other: LooseFraction(numerator: 2, denominator: 4)): return 20, default: {} }
    switch { Unmarked(n: 1) != Unmarked(n: 2): return 21, default: {} }
    switch { classify(p: Point(x: 0, y: 0)) != 0 | classify(p: Point(x: 1, y: 1)) != 1 | classify(p: a) != 2: return 14, default: {} }
    switch { !half(f: half2) | half(f: Fraction(numerator: 2, denominator: 3)): return 15, default: {} }
    let maybe: Point?.present(a)
    switch { maybe != a | maybe = .absent: return 16, default: {} }
    switch { !Pair<Point>(first: a, second: Point(x: 1, y: 2)).same() | Pair<Int>(first: 1, second: 2).same(): return 18, default: {} }
    switch { !Pair<Fraction>(first: half1, second: half2).same(): return 19, default: {} }
    return 42
}
