macro example(): Construct {
    let ignored: "#graph is only text here"
    switch #members.first() {
        .present: {
            #graph {
                // Keep the emitted declarations, including nested code.
                construct Message {
                    let text: "hello"
                    function show() {
                        switch true {
                            .true: @diagnostic(text),
                            .false: {}
                        }
                    }
                }
            }
        },
        .absent: {}
    }
    #graph {}
}

macro plain(): Construct {
    let ignored: 5
}
