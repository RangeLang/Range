macro probe(): Construct {
    let targetName: #name
    let selected: #members.filter(named: "payload").first
    let width: #generics.filter(named: "width").first.value
    let evaluated: #members.filter(named: "payload").first.value
    let missing: #members.filter(named: "absent").first
    switch false {
        .true: @diagnostic("Hidden control flow must remain parsed but not displayed"),
        .false: {}
    }
    #graph {
        extension #name {
            let probed: #width
        }
    }
}
