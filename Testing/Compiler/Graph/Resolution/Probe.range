macro probe(): Construct {
    let targetName: #name
    let selected: #members.first(named: "payload")
    let width: #generics.first(named: "width")
    let evaluated: #members.first(named: "payload")
    let missing: #members.first(named: "absent")
    switch false {
        .true: @diagnostic("Hidden control flow must remain parsed but not displayed"),
        .false: {}
    }
    #graph {
        extension #name {
            let probed: #width
        }
    }
}
