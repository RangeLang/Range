macro probe(): Construct {
    let targetName: #target.name
    let selected: #target.members.first { member in member.name = "payload" }
    let width: #target.generics.first { generic in generic.name = "width" }
    let evaluated: #target.members.first { member in member.name = "payload" }
    let missing: #target.members.first { member in member.name = "absent" }
    switch {
        false: diagnostic(message: "Hidden control flow must remain parsed but not displayed"),
        default: {}
    }
    #graph {
        extension #target.name {
            let probed: #width
        }
    }
}
