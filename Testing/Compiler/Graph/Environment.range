macro example(): Construct {
    let member: #members.first
    let ignored: "#environment is only text here"
    if member.isTarget {
        #environment {
            // Keep the emitted recipe, including nested code.
            let message: "hello"
            if true {
                @diagnostic(message)
            }
        }
    }
    #environment {}
}

macro plain(): Construct {
    let ignored: 5
}
