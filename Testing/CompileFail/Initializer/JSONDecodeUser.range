construct DecodedUser {
    let id: Int
    let name: String
}

extension DecodedUser {
    init(from decoder: Decoder) -> Result<Self, DecodingError> {
        let container: decoder.keyedContainer()

        switch container.decode(Int.self, forKey: "id") {
        case .success(let id):
            set self.id   id
        case .failure(let error):
            return .failure(cause: error)
        }

        switch container.decode(String.self, forKey: "name") {
        case .success(let name):
            set self.name   name
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

function decodeUser(): Result<DecodedUser, DecodingError> {
    let fields: [
        JSONField(key: "id", value: .int(value: 42)),
        JSONField(key: "name", value: .string(value: "George")),
    ]
    let decoder: JSONDecoder(value: .object(fields: fields))
    return DecodedUser.decode(from: decoder)
}

@main {
    switch decodeUser() {
    case .success(let user):
        Logger.info(user.name)
    case .failure:
        Logger.error("decoding failed")
    }
}
