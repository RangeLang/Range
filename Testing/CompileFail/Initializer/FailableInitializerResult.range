enum ParseError {
    case failed
}

construct StringDecodable {
    init(value: String) -> Result<Self, ParseError>
}

construct User {
    let name: String

    init(value: String) -> Result<Self, ParseError> {
        set self.name   value
    }
}

function makeUser(): Result<User, ParseError> {
    return User(value: "George")
}
