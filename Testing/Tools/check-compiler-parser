#!/usr/bin/env bash
# Checks source loading and the current C parser surface.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-parser.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT

fail() { echo "compiler parser: $*" >&2; exit 1; }
compiler="$work_root/range-compiler"
"$REPO_ROOT/Language/Compiler/Tools/build-range-compiler" "$compiler"

language_sources=("$REPO_ROOT/Language/Grammar" "$REPO_ROOT/Language/Macros" "$REPO_ROOT/Language/Types")
structure="$("$compiler" --tree "${language_sources[@]}")"
[[ "$("$compiler" --tree "${language_sources[2]}" "${language_sources[0]}" "${language_sources[1]}")" == "$structure" ]] \
    || fail "language folder order changed parsing"

(cd "$REPO_ROOT" && "$compiler" --tree Language/Types/Int.range) > "$work_root/int-tree"
grep -q 'construct name=Int ' "$work_root/int-tree" || fail "Int construct is missing"
grep -q 'member name=value ' "$work_root/int-tree" || fail "Int payload member is missing"
grep -q 'attribute name=integer' "$work_root/int-tree" || fail "Int integer macro application is missing"

"$compiler" --tree "$REPO_ROOT/Testing/Compiler/Graph/Environment.range" > "$work_root/environment-tree"
grep -Eq '^[[:space:]]+emission($| )' "$work_root/environment-tree" || fail "environment block was skipped"

probe="$work_root/malformed.range"
printf 'construct Broken<let bits: > {}\n' > "$probe"
if "$compiler" "$probe" > /dev/null 2> "$work_root/error"; then
    fail "malformed generic was accepted"
fi
grep -Eq ':[0-9]+:[0-9]+:' "$work_root/error" || fail "diagnostic lacks a source location"

# Type parameters are bare names; value generics keep explicit let.
printf 'construct Pair<First, let size: 2, Second> { let first: First }\n' > "$probe"
"$compiler" --tree "$probe" > "$work_root/generic-tree"
grep -Eq '^ +member name=First$' "$work_root/generic-tree" || fail "type parameter is missing"
grep -Eq '^ +member name=size rhs=' "$work_root/generic-tree" || fail "value generic beside type parameter is missing"
grep -Eq '^ +member name=Second$' "$work_root/generic-tree" || fail "trailing type parameter is missing"
printf 'construct Broken<T: Int> {}\n' > "$probe"
if "$compiler" "$probe" > /dev/null 2> "$work_root/error"; then
    fail "value generic without let was accepted"
fi
grep -q 'value generics require explicit let' "$work_root/error" || fail "missing let diagnostic changed"
printf 'construct Broken<let bits: > {}\n' > "$probe"

directory="$work_root/source directory"
mkdir -p "$directory/nested" "$work_root/empty"
cp -R "$REPO_ROOT/Testing/Compiler/Directory/." "$directory/"
ln -s .. "$directory/nested/cycle"
ln -s nested/Value.range "$directory/alias.range"
directory_tree="$("$compiler" --tree "$directory")"
[[ "$(grep -c '^unit ' <<<"$directory_tree")" == 2 ]] || fail "directory sources were skipped or duplicated"
[[ "$("$compiler" --tree "$directory/nested/Value.range" "$directory" "$directory/Start.range")" == "$directory_tree" ]] \
    || fail "overlapping inputs changed parsing"
grep -Eq 'function name=start($| )' <<<"$directory_tree" || fail "cross-file function missing"
for invalid in "$work_root/empty" "$work_root/missing"; do
    result=0
    "$compiler" "$invalid" > /dev/null 2> "$work_root/error" || result=$?
    [[ "$result" == 66 ]] || fail "invalid directory input exited $result, expected 66"
done
cp "$probe" "$directory/nested/Broken.range"
result=0
"$compiler" "$directory" > /dev/null 2> "$work_root/error" || result=$?
[[ "$result" == 65 ]] || fail "malformed nested source exited $result, expected 65"
grep -Eq 'Broken.range:[0-9]+:[0-9]+:' "$work_root/error" || fail "nested diagnostic lacks source location"

echo "compiler parser: sources=$(grep -c '^unit ' <<<"$structure") int-structure=pass malformed=pass directory=pass"
