#!/usr/bin/env bash
# Resolves macro contexts without destroying definitions or running expansions.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-graph.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "compiler graph: $*" >&2; exit 1; }
for mode in ordinary sanitized; do
    compiler="$work_root/$mode"
    options=()
    if [[ "$mode" == sanitized ]]; then options=(--sanitize); fi
    Language/Compiler/Tools/build-range-compiler "$compiler" ${options[@]+"${options[@]}"}
    link_options=()
    if [[ "$mode" == sanitized ]]; then link_options=(-fsanitize=address,undefined -fno-omit-frame-pointer -g); fi
    clang -std=c17 -Wall -Wextra -Werror -O1 ${link_options[@]+"${link_options[@]}"} \
        Testing/Compiler/Graph/OutputLinks.c Language/Compiler/Source/{lexer,parser,model,graph}.c \
        -o "$work_root/$mode-output-links"
    "$work_root/$mode-output-links"
    clang -std=c17 -Wall -Wextra -Werror -O1 ${link_options[@]+"${link_options[@]}"} \
        Testing/Compiler/Graph/GrammarLinks.c Language/Compiler/Source/{lexer,parser,model,graph}.c \
        -o "$work_root/$mode-grammar-links"
    "$work_root/$mode-grammar-links"
    clang -std=c17 -Wall -Wextra -Werror -O1 ${link_options[@]+"${link_options[@]}"} \
        Testing/Compiler/Graph/MacroTargets.c Language/Compiler/Source/{lexer,parser,model,graph}.c \
        -o "$work_root/$mode-macro-targets"
    "$work_root/$mode-macro-targets"
    clang -std=c17 -Wall -Wextra -Werror -O1 ${link_options[@]+"${link_options[@]}"} \
        Testing/Compiler/Graph/Emission.c Language/Compiler/Source/{lexer,parser,model,graph}.c \
        -o "$work_root/$mode-emission"
    "$work_root/$mode-emission"
    for fixture in Unknown UnknownBody Cycle; do
        status=0
        "$compiler" "Testing/Compiler/Graph/ResolutionFail/$fixture.range" > "$work_root/log" 2> "$work_root/error" || status=$?
        [[ "$status" == 65 ]] || fail "$mode $fixture exited $status"
        grep -Eq ':[0-9]+:[0-9]+:' "$work_root/error" || fail "$mode $fixture lacks source location"
        [[ ! -s "$work_root/log" ]] || fail "$mode $fixture claimed success"
        if [[ "$fixture" == Cycle ]]; then
            grep -Fq 'cyclic graph member' "$work_root/error" || fail "$mode cycle failed for wrong reason"
        elif [[ "$fixture" == UnknownBody ]]; then
            grep -Fq "field 'unknown' is not declared by @type Macro.body" "$work_root/error" || fail "$mode unknown body field failed for wrong reason"
        else
            grep -Fq "field 'unknown' is not declared by @type Construct" "$work_root/error" || fail "$mode unknown field failed for wrong reason"
        fi
    done
    # Normal compilation resolves the graph and reports missing language support.
    status=0
    "$compiler" Testing/Compiler/Graph/Resolution > "$work_root/log" 2> "$work_root/error" || status=$?
    [[ "$status" == 65 && ! -s "$work_root/log" ]] || fail "$mode incomplete compilation claimed success"
    grep -Fq 'hard-coded in C' "$work_root/error" || fail "$mode normal path concealed bootstrap behavior"
    if grep -Fq 'error[resolution]' "$work_root/error"; then fail "$mode graph resolution failed"; fi
    status=0
    "$compiler" --run start Language/Types > "$work_root/log" 2> "$work_root/error" || status=$?
    [[ "$status" == 64 ]] || fail "$mode retired interpreter command was accepted"
    echo "compiler graph: $mode contexts=2 reflection=pass deferred=pass normal-resolution=pass rejections=4"
done
