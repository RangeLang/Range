#!/usr/bin/env bash
# Compilation exposes missing language definitions and remaining C implementations.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-diagnostics.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
for mode in ordinary sanitized; do
    options=()
    link_options=()
    if [[ "$mode" == sanitized ]]; then
        options=(--sanitize)
        link_options=(-fsanitize=address,undefined -fno-omit-frame-pointer -g)
    fi
    compiler="$work_root/$mode"
    Language/Compiler/Tools/build-range-compiler "$compiler" ${options[@]+"${options[@]}"}
    clang -std=c17 -Wall -Wextra -Werror -O1 ${link_options[@]+"${link_options[@]}"} \
        Testing/Compiler/Graph/Diagnostics.c Language/Compiler/Source/{lexer,parser,model,graph,native}.c \
        -o "$work_root/$mode-diagnostics"
    "$work_root/$mode-diagnostics"
    python3 - "$compiler" "$work_root" <<'PY'
from pathlib import Path
import subprocess
import sys

compiler, folder = sys.argv[1], Path(sys.argv[2])

def compile_sources(*paths):
    result = subprocess.run([compiler, *map(str, paths)], capture_output=True, text=True)
    assert result.returncode == 65 and not result.stdout, result.stdout + result.stderr
    assert 'compilation failed:' in result.stderr, result.stderr
    return result.stderr

active = compile_sources('Language/Grammar', 'Language/Macros', 'Language/Types')
# Array<Element> declares a type parameter, so Array<Member> resolves;
# @boolean and @string declare Bool and String the way @integer declares Int;
# generics are @generic kinds, and every C graph shape has a grammar declaration.
# value fields are left undeclared until expressions have a Range type.
for declared in ('Array', 'Bool', 'String', 'Generic', 'Parameter', 'Any'):
    assert f"no declaration for '{declared}'" not in active, active
assert "has a C graph shape but no Range declaration" not in active, active
# The language sources type-check; laws run per specialization without failing.
assert 'error[type]' not in active and 'error[law]' not in active, active
assert 'String has no layout: it contains itself' in active, active
assert 'optional types are not implemented' in active, active
for shortcut in ('filter(named:)', '.first', '.isTarget'):
    assert f"'{shortcut}' is hard-coded in C" in active, active
assert 'uses in this source' in active, active

first, second = folder/'First.range', folder/'Second.range'
first.write_text('@absent construct Broken {}\n')
second.write_text('construct Independent { let member: NotDefined }\n')
errors = compile_sources(first, second)
assert "macro 'absent'" in errors and "'NotDefined'" in errors, errors
first.write_text('construct Broken { let missing: }\n')
errors = compile_sources(first, second)
assert 'First.range:' in errors and "'NotDefined'" in errors, errors
first.write_text('construct TooLarge { let value: 9223372036854775808 }\n')
assert "C parser's signed 64-bit storage" in compile_sources(first, second)

# Defining a previously missing type removes that error without inventing support.
first.write_text('construct Holder { let item: NotDefined }\n')
second.write_text('construct NotDefined {}\n')
# With nothing missing and no entry block, the sources check cleanly and no
# executable is claimed.
result = subprocess.run([compiler, str(first), str(second)], capture_output=True, text=True)
assert result.returncode == 0 and not result.stdout, result.stdout + result.stderr
assert "no declaration for 'NotDefined'" not in result.stderr, result.stderr
assert 'no entry block, so no executable was written' in result.stderr, result.stderr

# Normal compilation invokes the evaluator and reports independent macro failures.
first.write_text('''construct Construct {}
construct Text {}
@builtin macro diagnostic(let message: Text)
macro first(): Construct { @diagnostic("first application failed") }
macro second(): Construct { @diagnostic("second application failed") }
@first construct First {}
@second construct Second {}
''')
errors = compile_sources(first)
assert 'first application failed' in errors and 'second application failed' in errors, errors
assert 'error[undeclared]' not in errors, errors
assert 'error[macro-validation]' in errors, errors

# The retired text export is rejected and creates no output directory.
output = folder/'graphs'
retired = subprocess.run([compiler, '--emit-graph', str(output),
    'Language/Types'], capture_output=True, text=True)
assert retired.returncode == 64 and not retired.stdout, retired.stdout + retired.stderr
assert 'unsupported option: --emit-graph' in retired.stderr, retired.stderr
assert not output.exists()
PY
    echo "compiler diagnostics: $mode missing-declarations=pass C-ownership=pass normal-validation=pass no-false-success=pass"
done
