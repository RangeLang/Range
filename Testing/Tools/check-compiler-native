{ return F(b: 1).a }'
reject default-self "the default of 'a' refers to 'a' itself" \
    'construct F { let a: a }
{ return 0 }'
reject default-cycle "the type of 'a' depends on itself" \
    'construct F { let a: b + 1  let b: a + 1 }
{ return F().a }'
reject template-execution "@syntax is deferred; structural syntax is defined in C" '{ @syntax($value) return 0 }'
reject trailing-interpolation "trailing tokens in interpolation" '{ let value: String("\(1 2)") return value.count }'
reject immutable "cannot assign to let 'value'" '{ let value: Int(1) value: 2 return value }'
reject missing-label "argument 1 of 'identity' requires label 'value'" \
    'function identity(let value: Int): Int { return value }
{ return identity(42) }'
reject wrong-label "argument 1 of 'f' requires label 'value'" \
    'function f(let value: Int): Int { return value }
{ return f(other: 1) }'
reject type-mismatch "argument 'value' of 'f' requires Bool; found Int<bits: 64, signed: true>" \
    'function f(let value: Bool): Int { return 1 }
{ return f(value: 3) }'
reject undefined-unreached "no declaration for 'missing' in the loaded sources" \
    '{ switch false { .true: return missing(value: 1), .false: {} } return 0 }'
reject unknown-reference "no declaration for 'missing' in the loaded sources" '{ let user: missing return 0 }'
reject union-type "union types are not part of Range; declare an enum with one case per alternative" \
    'function f(let value: Int | Bool): Int { return 1 }
{ return f(value: 3) }'
reject defaults-different "@defaults is applied to 'Construct' twice with different arguments, at" \
    '@defaults(collection)
extension Construct {}
{ return 0 }'
reject macro-target "unknown macro target type 'Int'" \
    'macro transform(): Int { return 3 }
{ @transform return 0 }'
# Without a construct applying @interval, `..<` has no meaning.
full=("${core[@]}")
core=(Language/Grammar Language/Types/{Array,Bool,Int,Optional,String}.range)
for macro in Language/Macros/*.range; do [[ "$macro" == */Interval.range ]] || core+=("$macro"); done
reject interval-undeclared "'..<' needs exactly one construct applying @interval; found 0" \
    '{ let r: 0..<3 return 0 }'
grep -Fq "interval-undeclared.range:1:11: error" "$work_root/log" || fail "interval-undeclared was not reported at its use"
core=("${full[@]}")
# name(of:) reads a declaration's name at compile time; compiled code has no
# declarations to read, so calling it through first(named:) is refused.
reject name-at-runtime "native calls to builtin function 'name' are not implemented" \
    '{ state xs: Array<Int>() xs.append(value: 3) switch xs.first(named: "a") { .absent: return 0, .present(let v): return v } }'
# @defaults written through an extension reaches every declaration of its
# kind. The language's Enum already writes @defaults, so this grammar kind is
# the project's own, without one.
full=("${core[@]}")
core=(Language/Macros Language/Types)
for grammar in Language/Grammar/*.range; do [[ "$grammar" == */Enum.range ]] || core+=("$grammar"); done
run defaults-extension 0 "" "$(case_file defaults-extension 'construct Enum {
    let name: String
    let cases: Array<EnumCase>
    let functions: Array<Function>
    let macros: Array<Macro>
}
macro announce(): Enum { @warning("\(#name) is announced") }
@defaults(announce)
extension Enum {}
enum Light { case on, off }
{ return 0 }')"
grep -Fq "defaults-extension.range:10:1: warning[macro]: Light is announced" "$work_root/log" \
    || fail "@defaults through an extension did not apply"
core=("${full[@]}")

echo "compiler native: programs=59 rejections=167 closures=pass collections=pass logic=pass subjects=pass signatures=pass traps=pass literal-law=pass aggregates=pass arrays=pass copy-on-write=pass lifetimes=pass output=pass enums=pass switches=pass payloads=pass recursive-enums=pass optionals=pass loops=pass intervals=pass guards=pass switch-expressions=pass enum-methods=pass equality=pass equatable=pass equality-on-demand=pass equality-syntax=pass operators=pass array-equality=pass extension-macros=pass member-defaults=pass expressions=pass generics=pass promotion=pass unused-bindings=pass strings=pass converted=pass"
