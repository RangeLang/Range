#!/usr/bin/env bash
# Compiles Range programs to signed ARM64 Mach-O executables and runs them.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-native.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "compiler native: $*" >&2; exit 1; }
[[ "$(uname -sm)" == "Darwin arm64" ]] || { echo "compiler native: skipped (needs Apple silicon)"; exit 0; }
compiler="$work_root/range-compiler"
Language/Compiler/Tools/build-range-compiler "$compiler"
core=(Language/Macros/Integer.range Language/Macros/Literal.range Language/Macros/Diagnostic.range
      Language/Macros/Boolean.range Language/Types/Int.range Language/Types/Bool.range Testing/Compiler/Native/Core.range)

# run NAME EXPECTED-STATUS EXPECTED-STDERR SOURCE-FILE
run() {
    local name="$1" status="$2" message="$3" source="$4" program="$work_root/$1"
    "$compiler" -o "$program" "${core[@]}" "$source" > "$work_root/out" 2> "$work_root/log" \
        || fail "$name did not compile: $(grep -v 'warning\[' "$work_root/log")"
    grep -q "^wrote $program" "$work_root/log" || fail "$name claimed no executable"
    codesign -v "$program" 2> /dev/null || fail "$name signature does not verify"
    local actual=0
    perl -e 'alarm 10; exec @ARGV' "$program" > "$work_root/stdout" 2> "$work_root/stderr" || actual=$?
    [[ "$actual" == "$status" ]] || fail "$name exited $actual, expected $status: $(cat "$work_root/stderr")"
    if [[ -n "$message" ]]; then grep -Fq "$message" "$work_root/stderr" || fail "$name wrong message: $(cat "$work_root/stderr")"
    else [[ ! -s "$work_root/stderr" ]] || fail "$name wrote to stderr: $(cat "$work_root/stderr")"; fi
}
case_file() { printf '%s\n' "$2" > "$work_root/$1.range"; echo "$work_root/$1.range"; }

run arithmetic 42 "" Testing/Compiler/Native/Arithmetic.range
run aggregates 42 "" Testing/Compiler/Native/Aggregates.range

# The full language sources: Array's emitted methods over @many storage.
core=(Language/Grammar Language/Macros Language/Types)
run arrays 42 "" Testing/Compiler/Native/Arrays.range
grep -q "copying Array<Element: Int<bits: 64, signed: true>> shares its @many storage" "$work_root/log" \
    || fail "shared @many storage copy was not reported"
run slot-bounds 134 "slot index is outside the @many storage" "$(case_file slot-bounds \
    '{ state xs: Array<Int>() xs.append(value: 1) return xs.read(at: 1) }')"
run strings 7 "" "$(case_file strings '{ let greeting: "hello" return 7 }')"
run narrow-overflow 134 "result of '+' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-overflow \
    'function step(let x: Int<bits: 8>): Int<bits: 8> { return x + 100 }
{ let r: step(x: 100) return 0 }')"
run unsigned-underflow 134 "result of '-' does not fit Int<bits: 8, signed: false>" "$(case_file unsigned-underflow \
    'function down(let a: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> { return a - 1 }
{ let z: down(a: 0) return 0 }')"
run division-by-zero 134 "division by zero in '/'" "$(case_file division-by-zero \
    'function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: 7, b: 0) }')"
run wide-overflow 134 "result of '*' does not fit Int<bits: 64, signed: true>" "$(case_file wide-overflow \
    'function big(let a: Int): Int { return a * a }
{ return big(a: 4294967296) }')"
run minimum-quotient 134 "result of '/' does not fit Int<bits: 64, signed: true>" "$(case_file minimum-quotient \
    'function min(): Int { return -9223372036854775807 - 1 }
function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: min(), b: -1) }')"
run narrow-negation 134 "result of '-' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-negation \
    'function flip(let a: Int<bits: 8>): Int<bits: 8> { return -a }
{ if flip(a: -127) != 127 { return 1 } let z: flip(a: -128) return 0 }')"
locals="{ $(for i in $(seq 1 40); do printf 'let v%s: %s ' "$i" "$i"; done) return (v40 - v1) }"
run large-frame 39 "" "$(case_file large-frame "$locals")"

# The law rejects a literal at compile time; nothing is written.
source="$(case_file literal-law 'function id(let a: Int<bits: 8>): Int<bits: 8> { return a }
{ if id(a: -129) == 0 { return 1 } return 0 }')"
status=0
"$compiler" -o "$work_root/literal-law" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
[[ "$status" == 65 && ! -e "$work_root/literal-law" ]] || fail "literal law violation compiled"
grep -q "does not satisfy @integer" "$work_root/log" || fail "literal law reported wrongly"

echo "compiler native: programs=13 signatures=pass traps=pass literal-law=pass aggregates=pass arrays=pass"
