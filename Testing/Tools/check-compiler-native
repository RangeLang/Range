#!/usr/bin/env bash
# Compiles Range programs to signed ARM64 Mach-O executables and runs them.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-native.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "compiler native: $*" >&2; exit 1; }
[[ "$(uname -sm)" == "Darwin arm64" ]] || { echo "compiler native: skipped (needs Apple silicon)"; exit 0; }
compiler="$work_root/range-compiler"
Language/Compiler/Tools/build-range-compiler "$compiler"
core=(Language/Macros/Integer.range Language/Macros/Literal.range Language/Macros/Diagnostic.range
      Language/Macros/Boolean.range Language/Types/Int.range Language/Types/Bool.range Testing/Compiler/Native/Core.range)

# run NAME EXPECTED-STATUS EXPECTED-STDERR SOURCE-FILE
run() {
    local name="$1" status="$2" message="$3" source="$4" program="$work_root/$1"
    "$compiler" -o "$program" "${core[@]}" "$source" > "$work_root/out" 2> "$work_root/log" \
        || fail "$name did not compile: $(grep -v 'warning\[' "$work_root/log")"
    grep -q "^wrote $program" "$work_root/log" || fail "$name claimed no executable"
    codesign -v "$program" 2> /dev/null || fail "$name signature does not verify"
    local actual=0
    perl -e 'alarm 10; exec @ARGV' "$program" > "$work_root/stdout" 2> "$work_root/stderr" || actual=$?
    [[ "$actual" == "$status" ]] || fail "$name exited $actual, expected $status: $(cat "$work_root/stderr")"
    if [[ -n "$message" ]]; then grep -Fq "$message" "$work_root/stderr" || fail "$name wrong message: $(cat "$work_root/stderr")"
    else [[ ! -s "$work_root/stderr" ]] || fail "$name wrote to stderr: $(cat "$work_root/stderr")"; fi
}
case_file() { printf '%s\n' "$2" > "$work_root/$1.range"; echo "$work_root/$1.range"; }

run arithmetic 42 "" Testing/Compiler/Native/Arithmetic.range
run aggregates 42 "" Testing/Compiler/Native/Aggregates.range

# The full language sources: Array's emitted methods over @many storage.
core=(Language/Grammar Language/Macros Language/Types)
run arrays 42 "" Testing/Compiler/Native/Arrays.range
run copy-on-write 42 "" Testing/Compiler/Native/CopyOnWrite.range
run lifetimes 42 "" Testing/Compiler/Native/Lifetimes.range
run output 134 "Output.range:22:9: count is 5, expected at most 3" Testing/Compiler/Native/Output.range
printf '%s\n' "Hello from Range!" "hello, world" "count: 5, last: 25, empty: false, capacity: 8" \
    "-128 4294967295 -9223372036854775808 0 true" "done" | cmp -s - "$work_root/stdout" \
    || fail "@print wrote: $(cat "$work_root/stdout")"
run enums 42 "" Testing/Compiler/Native/Enums.range
[[ "$(cat "$work_root/stdout")" == "north east west west" ]] || fail "enum cases printed: $(cat "$work_root/stdout")"
run switches 42 "" Testing/Compiler/Native/Switches.range
run payloads 42 "" Testing/Compiler/Native/Payloads.range
run patterns 42 "" Testing/Compiler/Native/Patterns.range
run recursive-enums 42 "" Testing/Compiler/Native/RecursiveEnums.range
run nested-enums 42 "" Testing/Compiler/Native/NestedEnums.range
run optionals 42 "" Testing/Compiler/Native/Optionals.range
run loops 42 "" Testing/Compiler/Native/Loops.range
run intervals 42 "" Testing/Compiler/Native/Intervals.range
run guards 42 "" Testing/Compiler/Native/Guards.range
run enum-methods 42 "" Testing/Compiler/Native/EnumMethods.range
[[ "$(cat "$work_root/stdout")" == "south 15" ]] || fail "enum methods printed: $(cat "$work_root/stdout")"
run equality 42 "" Testing/Compiler/Native/Equality.range
run equality-syntax 42 "" Testing/Compiler/Native/EqualitySyntax.range
run expressions 42 "" Testing/Compiler/Native/Expressions.range
run promotion 42 "" Testing/Compiler/Native/Promotion.range
run strings-native 42 "" Testing/Compiler/Native/Strings.range
printf '%s\n' "local: hi" "hello, world" "ababab ab! ababab?" | cmp -s - "$work_root/stdout" \
    || fail "strings printed: $(cat "$work_root/stdout")"
# Every block is freed when its last reference ends, and none twice.
if command -v leaks > /dev/null; then
    for program in arrays copy-on-write lifetimes payloads patterns recursive-enums nested-enums optionals \
                   loops intervals guards enum-methods equality equality-syntax expressions promotion strings-native; do
        MallocScribble=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 "$work_root/$program" > /dev/null 2>&1 \
            || [[ $? == 42 ]] || fail "$program failed under heap checking"
        leaks --atExit -- "$work_root/$program" 2>&1 | grep -q ": 0 leaks for 0 total leaked bytes" \
            || fail "$program leaks heap storage"
    done
fi
run slot-bounds 134 "slot index is outside the @many storage" "$(case_file slot-bounds \
    '{ state xs: Array<Int>() xs.append(value: 1) return xs.read(at: 1) }')"
run strings 7 "" "$(case_file strings '{ let greeting: "hello" return 7 }')"
run byte-bounds 134 "byte index is outside the bytes" "$(case_file byte-bounds \
    '{ let s: String("hi") let b: s.byte(at: 2) return 0 }')"
run narrow-overflow 134 "result of '+' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-overflow \
    'function step(let x: Int<bits: 8>): Int<bits: 8> { return x + 100 }
{ let r: step(x: 100) return 0 }')"
run unsigned-underflow 134 "result of '-' does not fit Int<bits: 8, signed: false>" "$(case_file unsigned-underflow \
    'function down(let a: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> { return a - 1 }
{ let z: down(a: 0) return 0 }')"
run division-by-zero 134 "division by zero in '/'" "$(case_file division-by-zero \
    'function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: 7, b: 0) }')"
run wide-overflow 134 "result of '*' does not fit Int<bits: 64, signed: true>" "$(case_file wide-overflow \
    'function big(let a: Int): Int { return a * a }
{ return big(a: 4294967296) }')"
run minimum-quotient 134 "result of '/' does not fit Int<bits: 64, signed: true>" "$(case_file minimum-quotient \
    'function min(): Int { return -9223372036854775807 - 1 }
function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: min(), b: -1) }')"
run narrow-negation 134 "result of '-' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-negation \
    'function flip(let a: Int<bits: 8>): Int<bits: 8> { return -a }
{ if flip(a: -127) != 127 { return 1 } let z: flip(a: -128) return 0 }')"
locals="{ $(for i in $(seq 1 40); do printf 'let v%s: %s ' "$i" "$i"; done) return (v40 - v1) }"
run large-frame 39 "" "$(case_file large-frame "$locals")"

# The law rejects a literal at compile time; nothing is written.
source="$(case_file literal-law 'function id(let a: Int<bits: 8>): Int<bits: 8> { return a }
{ if id(a: -129) = 0 { return 1 } return 0 }')"
status=0
"$compiler" -o "$work_root/literal-law" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
[[ "$status" == 65 && ! -e "$work_root/literal-law" ]] || fail "literal law violation compiled"
grep -q "does not satisfy @integer" "$work_root/log" || fail "literal law reported wrongly"

# Matching is checked before code is generated: nothing is written.
# reject NAME EXPECTED-ERROR SOURCE
reject() {
    local status=0 source
    source="$(case_file "$1" "$3")"
    "$compiler" -o "$work_root/$1" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
    [[ "$status" == 65 && ! -e "$work_root/$1" ]] || fail "$1 compiled"
    grep -Fq "$2" "$work_root/log" || fail "$1 reported wrongly: $(grep 'error\[' "$work_root/log")"
}
reject non-exhaustive "switch over Direction must be exhaustive: '.west' is not handled" \
    'enum Direction { case north, east, south, west }
function f(let d: Direction): Int { switch d { case .north, .south: return 1 case .east: return 2 } }
{ return f(d: .east) }'
reject integer-default "switch over Int<bits: 64, signed: true> must be exhaustive; add a default" \
    'function f(let n: Int): Int { switch n { case 0: return 1 case < 0: return 2 } }
{ return f(n: 1) }'
reject unknown-case "Direction has no case 'up'" \
    'enum Direction { case north, south }
function f(let d: Direction): Int { switch d { case .north: return 1 case .up: return 2 default: return 3 } }
{ return f(d: .north) }'
reject unknown-construction "Direction has no case 'up'" \
    'enum Direction { case north, south }
{ let d: Direction(.up) return 0 }'
reject duplicate-case "this pattern is already handled by earlier cases" \
    'enum Direction { case north, south }
function f(let d: Direction): Int { switch d { case .north: return 1 case .south, .north: return 2 } }
{ return f(d: .north) }'
reject unreachable-default "'default' is never reached" \
    'function f(let b: Bool): Int { switch b { case true: return 1 case false: return 0 default: return 2 } }
{ return f(b: true) }'
reject duplicate-declaration "'north' is declared more than once in Direction" \
    'enum Direction { case north, south, north }
{ return 0 }'
reject binding-outside "no declaration for 'n' in the loaded sources" \
    'enum Token { case value(Int), end }
function f(let t: Token): Int { switch t { case .value(let n): return n case .end: return 0 } return n }
{ return f(t: .end) }'
reject binding-outside-if "no declaration for 'n' in the loaded sources" \
    'function f(let o: Int?): Int { if let n: o { return n } return n }
{ return f(o: .absent) }'
reject unshared-binding "'b' must be bound by every pattern of this case" \
    'enum Pair { case one(Int), two(Int, Int) }
function f(let p: Pair): Int { switch p { case .one(let a), .two(let a, let b): return a } }
{ return f(p: .one(1)) }'
reject missing-payload "case 'value' carries a payload" \
    'enum Token { case value(Int), end }
{ let t: Token(.value) return 0 }'
reject not-optional "'if let' unwraps an optional value" \
    '{ let n: 3 if let m: n { return m } return 0 }'
reject break-outside "'break' is only allowed inside a loop or a switch" \
    '{ break return 0 }'
reject continue-outside "'continue' is only allowed inside a loop" \
    'function f(let b: Bool): Int { switch b { case true: continue case false: return 0 } }
{ return f(b: true) }'
reject guard-falls-through "the else block of 'guard' must not fall through" \
    'function f(let n: Int): Int { guard n > 0 else { @print("no") } return n }
{ return f(n: 1) }'
reject guard-break-ends-switch "the else block of 'guard' must not fall through" \
    'function f(let xs: Array<Int>): Int { for x in xs { guard x > 0 else { switch x { case 0: break default: return 0 } } } return 1 }
{ return 0 }'
reject guard-binding-in-else "no declaration for 'v' in the loaded sources" \
    'function f(let o: Int?): Int { guard let v: o else { return v } return v }
{ return f(o: .absent) }'
reject for-non-iterable "'for … in' cannot iterate Int<bits: 64, signed: true>: it declares no @iteration function" \
    '{ let n: 5 for x in n { } return 0 }'
reject two-iterations "construct 'Twice' declares 2 @iteration functions; a type declares exactly one" \
    'construct Twice {
    let n: Int
    @iteration function first(let at: Int): Int? { return .absent }
    @iteration function second(let at: Int): Int? { return .absent }
}
{ for x in Twice(n: 1) { } return 0 }'
reject iteration-signature "@iteration function 'next' of 'Bad' must take one Int position and return an optional" \
    'construct Bad { @iteration function next(let at: Int): Int { return at } }
{ return 0 }'
reject iteration-not-method "@iteration function 'next' must be a method of the type it iterates" \
    '@iteration function next(let at: Int): Int? { return .absent }
{ return 0 }'
reject interval-loop-variable "cannot assign to let 'i'" \
    '{ for i in 0..<3 { i: 2 } return 0 }'
reject interval-chain "'..<' does not chain; parenthesize one interval" \
    '{ let r: 0..<3..<4 return 0 }'
reject loop-variable "cannot assign to let 'x'" \
    '{ state xs: Array<Int>() for x in xs { x: 3 } return 0 }'
reject enum-extension-member "an extension of enum 'Direction' cannot add stored member 'speed'" \
    'enum Direction { case north, south }
extension Direction { let speed: 1 }
{ return 0 }'
reject payload-equality "payload field '0' of case 'at' is Point, which '=' does not compare" \
    'construct Point { let x: Int }
enum Place { case at(Point), nowhere }
{ let p: Place(.nowhere) if p = .nowhere { return 1 } return 0 }'
# Equality is a single `=`; `==` is never an alternative spelling.
reject double-equals "double-equals.range:1:17: use '=' for equality" \
    '{ let a: 1 if a == 1 { return 1 } return 0 }'
reject double-equals-pattern "double-equals-pattern.range:1:47: use '=' for equality" \
    'function f(let n: Int): Int { switch n { case == 1: return 1 default: return 0 } }
{ return f(n: 1) }'
# Without a construct applying @interval, as in the minimal core, `..<` has no meaning.
full=("${core[@]}")
core=(Language/Macros/Integer.range Language/Macros/Literal.range Language/Macros/Diagnostic.range
      Language/Macros/Boolean.range Language/Types/Int.range Language/Types/Bool.range Testing/Compiler/Native/Core.range)
reject interval-undeclared "'..<' needs exactly one construct applying @interval; found 0" \
    '{ let r: 0..<3 return 0 }'
core=("${full[@]}")

echo "compiler native: programs=33 rejections=29 signatures=pass traps=pass literal-law=pass aggregates=pass arrays=pass copy-on-write=pass lifetimes=pass output=pass enums=pass switches=pass payloads=pass recursive-enums=pass optionals=pass loops=pass intervals=pass guards=pass enum-methods=pass equality=pass equality-syntax=pass expressions=pass promotion=pass strings=pass"
