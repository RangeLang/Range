#!/usr/bin/env bash
# Compiles Range programs to signed ARM64 Mach-O executables and runs them.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-native.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "compiler native: $*" >&2; exit 1; }
[[ "$(uname -sm)" == "Darwin arm64" ]] || { echo "compiler native: skipped (needs Apple silicon)"; exit 0; }
compiler="$work_root/range-compiler"
Language/Compiler/Tools/build-range-compiler "$compiler"
# The language sources: macros reflect through Array and Optional, so even
# the integer and boolean checks need the grammar and the collection.
core=(Language/Functions Language/Grammar Language/Macros Language/Types)

# run NAME EXPECTED-STATUS EXPECTED-STDERR SOURCE-FILE...
# Each program is compiled as written, then with every value known before
# run filled in; both executables must report, write, and exit the same.
run() {
    local name="$1" status="$2" message="$3" program="$work_root/$1" mode actual
    shift 3
    for mode in --as-written ""; do
        "$compiler" $mode -o "$program" "${core[@]}" "$@" > "$work_root/out" 2> "$work_root/log" \
            || fail "$name $mode did not compile: $(grep -v 'warning\[' "$work_root/log")"
        grep -q "^wrote $program" "$work_root/log" || fail "$name $mode claimed no executable"
        codesign -v "$program" 2> /dev/null || fail "$name $mode signature does not verify"
        actual=0
        perl -e 'alarm 10; exec @ARGV' "$program" > "$work_root/stdout" 2> "$work_root/stderr" || actual=$?
        [[ "$actual" == "$status" ]] || fail "$name $mode exited $actual, expected $status: $(cat "$work_root/stderr")"
        if [[ -n "$message" ]]; then grep -Fq "$message" "$work_root/stderr" || fail "$name $mode wrong message: $(cat "$work_root/stderr")"
        else [[ ! -s "$work_root/stderr" ]] || fail "$name $mode wrote to stderr: $(cat "$work_root/stderr")"; fi
        [[ -z "$mode" ]] || for file in log stdout stderr; do cp "$work_root/$file" "$work_root/written-$file"; done
    done
    for file in log stdout stderr; do
        cmp -s "$work_root/$file" "$work_root/written-$file" || fail "$name $file differs from the program compiled as written"
    done
}
case_file() { printf '%s\n' "$2" > "$work_root/$1.range"; echo "$work_root/$1.range"; }

run arithmetic 42 "" Testing/Compiler/Native/Arithmetic.range
run aggregates 42 "" Testing/Compiler/Native/Aggregates.range

# Array's emitted methods over @many storage.
run arrays 42 "" Testing/Compiler/Native/Arrays.range
run copy-on-write 42 "" Testing/Compiler/Native/CopyOnWrite.range
run lifetimes 42 "" Testing/Compiler/Native/Lifetimes.range
run output 134 "Output.range:21:28: count is 5, expected at most 3" Testing/Compiler/Native/Output.range
printf '%s\n' "Hello from Range!" "hello, world" "count: 5, last: 25, empty: false, capacity: 8" \
    "-128 4294967295 -9223372036854775808 0 true" "done" | cmp -s - "$work_root/stdout" \
    || fail "print wrote: $(cat "$work_root/stdout")"
run enums 42 "" Testing/Compiler/Native/Enums.range
[[ "$(cat "$work_root/stdout")" == "north east west west" ]] || fail "enum cases printed: $(cat "$work_root/stdout")"
run switches 42 "" Testing/Compiler/Native/Switches.range
run payloads 42 "" Testing/Compiler/Native/Payloads.range
run patterns 42 "" Testing/Compiler/Native/Patterns.range
run recursive-enums 42 "" Testing/Compiler/Native/RecursiveEnums.range
run nested-enums 42 "" Testing/Compiler/Native/NestedEnums.range
run optionals 42 "" Testing/Compiler/Native/Optionals.range
run loops 42 "" Testing/Compiler/Native/Loops.range
run intervals 42 "" Testing/Compiler/Native/Intervals.range
run guards 42 "" Testing/Compiler/Native/Guards.range
run switch-expressions 42 "" Testing/Compiler/Native/SwitchExpressions.range
[[ "$(cat "$work_root/stdout")" == "three" ]] || fail "switch arms printed: $(cat "$work_root/stdout")"
run enum-methods 42 "" Testing/Compiler/Native/EnumMethods.range
[[ "$(cat "$work_root/stdout")" == "south 15" ]] || fail "enum methods printed: $(cat "$work_root/stdout")"
run subjects 42 "" Testing/Compiler/Native/Subjects.range
run case-tests 42 "" Testing/Compiler/Native/CaseTests.range
run logic 42 "" Testing/Compiler/Native/Logic.range
printf '%s\n' "touched 3" "touched 4" | cmp -s - "$work_root/stdout" || fail "logic short-circuit printed: $(cat "$work_root/stdout")"
run equality 42 "" Testing/Compiler/Native/Equality.range
run equatable 42 "" Testing/Compiler/Native/Equatable.range
grep -Fq "Equatable.range:43:1: warning[macro]: Plain applies @equatable but declares no '='; the built-in structural '=' is used" \
    "$work_root/log" || fail "explicit @equatable without '=' was not warned"
! grep -Eq "LooseFraction|Unmarked" "$work_root/log" || fail "a type without @equatable was warned"
run equality-syntax 42 "" Testing/Compiler/Native/EqualitySyntax.range
run operators 42 "" Testing/Compiler/Native/Operators.range
run array-equality 42 "" Testing/Compiler/Native/ArrayEquality.range
# A macro written on an extension applies to the extended declaration, here
# from another file than the declaration, on constructs, enums, and #graph.
run extension-equality 42 "" Testing/Compiler/Native/ExtensionTypes.range Testing/Compiler/Native/ExtensionEquality.range
grep -Fq "ExtensionEquality.range:19:1: warning[macro]: Plain applies @equatable but declares no '='; the built-in structural '=' is used" \
    "$work_root/log" || fail "@equatable extension without '=' was not warned"
grep -Fq "ExtensionEquality.range:23:1: note[macro]: @equatable is already applied to 'Twice' at" "$work_root/log" \
    || fail "a second application of @equatable was not noted"
grep -Fq "ExtensionTypes.range:28:1: warning[macro]: Written writes @equatable" "$work_root/log" \
    || fail "#target.macros does not list an application written through an extension"
! grep -Eq "(Fraction|Parity|Coin|Twice) applies @equatable but declares no" "$work_root/log" \
    || fail "@equatable on an extension missed the '=' beside it"
! grep -Fq "Array applies @equatable" "$work_root/log" || fail "@collection's @equatable missed its '='"
run member-defaults 42 "" Testing/Compiler/Native/MemberDefaults.range
run expressions 42 "" Testing/Compiler/Native/Expressions.range
run generics 42 "" Testing/Compiler/Native/Generics.range
run bytes 42 "" Testing/Compiler/Native/Bytes.range
run control 42 "" Testing/Compiler/Native/Control.range
run evaluation 42 "" Testing/Compiler/Native/Evaluation.range
run identity-references 42 "" Testing/Compiler/Native/IdentityReferences.range
run value-generics 42 "" Testing/Compiler/Native/ValueGenerics.range
run macro-applications 42 "" Testing/Compiler/Native/MacroApplications.range
run promotion 42 "" Testing/Compiler/Native/Promotion.range
# A name a pattern binds and nothing reads is a warning, in native code and
# in macros alike; a read in the arm's condition or body uses it.
run unused-bindings 1 "" "$(case_file unused-bindings 'enum Pair { case one(Int), two(Int, Int) }
function f(let p: Pair): Int {
    switch { p.one(let v): return 1, p.two(let a, let b) & a > 2: return a, p.two: return 0 }
}
function g(let o: Int?, let p: Int?): Int {
    switch { o.present(let x) & x > 0 | p.present(let x): return 1, default: return 0 }
}
macro checked(): Enum {
    let on: #target.cases.first(where: { c in c.name = "on" })
    switch { on.present(let c): {}, on.absent: diagnostic(message: "\(#target.name) has no case on") }
}
@checked
enum Light { case on, off }
{ return f(p: .one(1)) + g(o: .absent, p: .absent) }')"
for unused in "3:24: warning[unused]: 'v' is bound but never used; write the pattern without 'let v'" \
    "3:55: warning[unused]: 'b' is bound but never used; write the pattern without 'let b'" \
    "10:29: warning[unused]: 'c' is bound but never used; write the pattern without 'let c'"; do
    grep -Fq "unused-bindings.range:$unused" "$work_root/log" || fail "unused binding was not warned: $unused"
done
! grep -Eq "'(a|x)' is bound but never used" "$work_root/log" || fail "a binding read in a condition or body was warned"
! grep -Fq "warning[unused]" <(grep -v "unused-bindings.range" "$work_root/log") || fail "the language sources bind names they never use"
run generic-methods 42 "" Testing/Compiler/Native/GenericMethods.range
run generic-bodies 42 "" Testing/Compiler/Native/GenericBodies.range
# Closures: functions that take them are compiled inline, and so are they.
run closures 42 "" Testing/Compiler/Native/Closures.range
[[ "$(cat "$work_root/stdout")" == "calls: 4, pairs: 3" ]] || fail "closures printed: $(cat "$work_root/stdout")"
grep -Fq "warning[C-implementation]: a closure is compiled by C inline, where the call it is passed to is made" "$work_root/log" \
    || fail "closures are not reported as C's"
run collections 42 "" Testing/Compiler/Native/Collections.range
[[ "$(cat "$work_root/stdout")" == "new read 3" ]] || fail "collections printed: $(cat "$work_root/stdout")"
# Macros run closures at compile time: a Range function's closure parameter
# holds one, which sees and changes the macro's own values.
run compile-time-closures 0 "" "$(case_file compile-time-closures 'function count(let cases: Array<EnumCase>, let where: (EnumCase) -> Bool): Int {
    state found: 0
    state index: 0
    while index < cases.count {
        switch { where(cases.read(at: index)): found: found + 1, default: {} }
        index: index + 1
    }
    return found
}
macro counted(): Enum {
    state seen: 0
    let others: count(cases: #target.cases) { c in
        seen: seen + 1
        switch { c.name = "on": return false, default: {} }
        return true
    }
    warning(message: "\(#target.name) has \(others) other cases of \(seen)")
}
@counted
enum Light { case on, off, dim }
{ return 0 }')"
grep -Fq "compile-time-closures.range:19:1: warning[macro]: Light has 2 other cases of 3" "$work_root/log" \
    || fail "a compile-time closure did not run: $(grep 'error\[' "$work_root/log")"
# Array's functions take closures at compile time too, on reflection lists.
run compile-time-collections 0 "" "$(case_file compile-time-collections 'macro checked(): Enum {
    let wanted: "on"
    switch {
        #target.cases.first(where: { c in c.name = wanted }).present(let c): warning(message: "\(#target.name) has \(c.name)"),
        default: diagnostic(message: "\(#target.name) has no case on")
    }
    state seen: 0
    let others: #target.cases.filter { c in
        seen: seen + 1
        return c.name != "on"
    }
    let total: #target.cases.reduce(initial: 0) { sum, c in sum + 1 }
    let names: #target.cases.map { c in c.name }
    switch {
        names.first().present(let n): warning(message: "\(#target.name) has \(others.count) other cases of \(seen), \(total) in all, first \(n)"),
        default: {}
    }
    switch {
        #target.cases.contains(where: { c in #target.cases.contains(where: { d in d.name = c.name & c.name = "dim" }) }): warning(message: "\(#target.name) dims"),
        default: {}
    }
}
@checked
enum Light { case on, off, dim }
{ return 0 }')"
for expected in "warning[macro]: Light has on" "warning[macro]: Light has 2 other cases of 3, 3 in all, first on" \
    "warning[macro]: Light dims"; do
    grep -Fq "compile-time-collections.range:23:1: $expected" "$work_root/log" || fail "compile-time collections did not report: $expected"
done
run strings-native 42 "" Testing/Compiler/Native/Strings.range
printf '%s\n' "local: hi" "hello, world" "ababab ab! ababab?" | cmp -s - "$work_root/stdout" \
    || fail "strings printed: $(cat "$work_root/stdout")"
# A known value holding blocks is built from its image where it is used: an
# array and a recursive enum; a let holding one is built once and read in place.
run known-blocks 0 "" "$(case_file known-blocks 'enum Tree { case leaf(Int), node(Tree, Tree) }
function sum(let t: Tree): Int { switch { t.leaf(let v): return v, t.node(let a, let b): return sum(t: a) + sum(t: b) } }
function words(): Array<String> { state ws: Array<String>()  ws.append(value: "one")  ws.append(value: "two")  return ws }
{
    let ws: words()
    state copy: ws
    copy.write(at: 0, value: "three")
    let tree: Tree.node(.leaf(ws.count), .node(.leaf(3), .leaf(4)))
    print(message: "\(ws.read(at: 0)) \(copy.read(at: 0)) \(words().count) \(sum(t: tree))")
    return 0
}')"
[[ "$(cat "$work_root/stdout")" == "one three 2 9" ]] || fail "known blocks printed: $(cat "$work_root/stdout")"
# Every block is freed when its last reference ends, and none twice.
if command -v leaks > /dev/null; then
    for program in arrays copy-on-write lifetimes known-blocks payloads patterns recursive-enums nested-enums optionals \
                   loops intervals guards switch-expressions enum-methods equality equatable equality-syntax operators array-equality extension-equality member-defaults expressions generics promotion strings-native \
                   bytes control evaluation identity-references subjects case-tests closures collections generic-methods generic-bodies; do
        MallocScribble=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 "$work_root/$program" > /dev/null 2>&1 \
            || [[ $? == 42 ]] || fail "$program failed under heap checking"
        leaks --atExit -- "$work_root/$program" 2>&1 | grep -q ": 0 leaks for 0 total leaked bytes" \
            || fail "$program leaks heap storage"
    done
fi
run slot-bounds 134 "slot index is outside the @many storage" "$(case_file slot-bounds \
    '{ state xs: Array<Int>() xs.append(value: 1) return xs.read(at: 1) }')"
run strings 7 "" "$(case_file strings '{ let greeting: "hello" return 7 }')"
run byte-bounds 134 "byte index is outside the bytes" "$(case_file byte-bounds \
    '{ let s: String("hi") let b: s.byte(at: 2) return 0 }')"
run narrow-overflow 134 "result of '+' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-overflow \
    'function step(let x: Int<bits: 8>): Int<bits: 8> { return x + 100 }
{ let r: step(x: 100) return 0 }')"
run unsigned-underflow 134 "result of '-' does not fit Int<bits: 8, signed: false>" "$(case_file unsigned-underflow \
    'function down(let a: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> { return a - 1 }
{ let z: down(a: 0) return 0 }')"
run division-by-zero 134 "division by zero in '/'" "$(case_file division-by-zero \
    'function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: 7, b: 0) }')"
run wide-overflow 134 "result of '*' does not fit Int<bits: 64, signed: true>" "$(case_file wide-overflow \
    'function big(let a: Int): Int { return a * a }
{ return big(a: 4294967296) }')"
run minimum-quotient 134 "result of '/' does not fit Int<bits: 64, signed: true>" "$(case_file minimum-quotient \
    'function min(): Int { return -9223372036854775807 - 1 }
function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: min(), b: -1) }')"
run narrow-negation 134 "result of '-' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-negation \
    'function flip(let a: Int<bits: 8>): Int<bits: 8> { return -a }
{ switch { flip(a: -127) != 127: return 1, default: {} } let z: flip(a: -128) return 0 }')"
run unsigned-negation 134 "result of '-' does not fit Int<bits: 64, signed: false>" "$(case_file unsigned-negation \
    'function flip(let a: Int<bits: 64, signed: false>): Int<bits: 64, signed: false> { return -a }
{ switch { flip(a: 0) != 0: return 1, default: {} } let z: flip(a: 1) return 0 }')"
run constant-overflow 134 "result of '+' does not fit Int<bits: 64, signed: true>" "$(case_file constant-overflow \
    '{ return 9223372036854775807 + 1 }')"
run constant-division 134 "division by zero in '/'" "$(case_file constant-division '{ return 4 / 0 }')"
# States are cells at run, so each takes a frame slot.
locals="{ $(for i in $(seq 1 40); do printf 'state v%s: %s ' "$i" "$i"; done) return (v40 - v1) }"
run large-frame 39 "" "$(case_file large-frame "$locals")"

# The law rejects a literal at compile time; nothing is written.
source="$(case_file literal-law 'function id(let a: Int<bits: 8>): Int<bits: 8> { return a }
{ switch { id(a: -129) = 0: return 1, default: {} } return 0 }')"
status=0
"$compiler" -o "$work_root/literal-law" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
[[ "$status" == 65 && ! -e "$work_root/literal-law" ]] || fail "literal law violation compiled"
grep -q "does not satisfy @integer" "$work_root/log" || fail "literal law reported wrongly"

# Matching is checked before code is generated: nothing is written.
# reject NAME EXPECTED-ERROR SOURCE
reject() {
    local status source mode
    source="$(case_file "$1" "$3")"
    for mode in --as-written ""; do
        status=0
        "$compiler" $mode -o "$work_root/$1" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
        [[ "$status" == 65 && ! -e "$work_root/$1" ]] || fail "$1 $mode compiled"
        grep -Fq "$2" "$work_root/log" || fail "$1 $mode reported wrongly: $(grep 'error\[' "$work_root/log")"
    done
}
reject non-exhaustive "switch must be exhaustive: 'd.west' is not handled; add an arm for it or a default" \
    'enum Direction { case north, east, south, west }
function f(let d: Direction): Int { switch { d.north | d.south: return 1, d.east: return 2 } }
{ return f(d: .east) }'
reject integer-default "switch must be exhaustive; add a default" \
    'function f(let n: Int): Int { switch { n = 0: return 1, n < 0: return 2 } }
{ return f(n: 1) }'
reject unknown-case "Direction has no case 'up'" \
    'enum Direction { case north, south }
function f(let d: Direction): Int { switch { d.north: return 1, d.up: return 2, default: return 3 } }
{ return f(d: .north) }'
reject unknown-case-value "Direction has no case 'up'" \
    'enum Direction { case north, south }
{ let d: Direction.up return 0 }'
reject duplicate-case "this condition is already handled by earlier arms" \
    'enum Direction { case north, south }
function f(let d: Direction): Int { switch { d.north: return 1, d.south | d.north: return 2 } }
{ return f(d: .north) }'
reject unreachable-default "'default' is never reached" \
    'function f(let b: Bool): Int { switch { b.true: return 1, b.false: return 0, default: return 2 } }
{ return f(b: true) }'
reject duplicate-declaration "'north' is declared more than once in Direction" \
    'enum Direction { case north, south, north }
{ return 0 }'
reject binding-outside "no declaration for 'n' in the loaded sources" \
    'enum Token { case value(Int), end }
function f(let t: Token): Int { switch { t.value(let n): return n, t.end: return 0 } return n }
{ return f(t: .end) }'
reject binding-outside-arm "no declaration for 'n' in the loaded sources" \
    'function f(let o: Int?): Int { switch { o.present(let n): return n, o.absent: {} } return n }
{ return f(o: .absent) }'
reject unshared-binding "'b' is bound on one side of '|' only; both sides bind the same names" \
    'enum Pair { case one(Int), two(Int, Int) }
function f(let p: Pair): Int { switch { p.one(let a) | p.two(let a, let b): return a } }
{ return f(p: .one(1)) }'
reject missing-payload "case 'value' carries a payload" \
    'enum Token { case value(Int), end }
{ let t: Token.value return 0 }'
reject case-of-integer "Int<bits: 64, signed: true> has no function 'present'" \
    '{ let n: 3 switch { n.present(let m): return m, default: {} } return 0 }'
reject break-outside "'break' is only allowed inside a loop" \
    '{ break return 0 }'
reject continue-outside "'continue' is only allowed inside a loop" \
    'function f(let b: Bool): Int { switch { b: continue, default: return 0 } }
{ return f(b: true) }'
reject arm-falls-through "an arm of a switch expression yields a value or diverges; this block ends without return, break, continue, or diagnostic" \
    'function f(let n: Int): Int { let m: switch { n > 0: n, default: { print(message: "no") } } return m }
{ return f(n: 1) }'
# print, diagnostic, and warning are ordinary builtin functions: calls with
# labels, typed as any call is. A call of diagnostic diverges, so it can be
# an arm of a switch expression; a call of print yields nothing, so it cannot.
run diagnostic-arm 134 "diagnostic-arm.range:1:66: n must be positive" "$(case_file diagnostic-arm \
    'function f(let n: Int): Int { let m: switch { n > 0: n, default: diagnostic(message: "n must be positive") } return m }
{ print(message: "\(f(n: 2))") return f(n: 0) }')"
[[ "$(cat "$work_root/stdout")" == "2" ]] || fail "diagnostic arm printed: $(cat "$work_root/stdout")"
reject print-arm "an arm of a switch expression yields a value or diverges; 'print' returns no value" \
    'function f(let n: Int): Int { let m: switch { n > 0: n, default: print(message: "no") } return m }
{ return f(n: 1) }'
reject print-label "argument 1 of 'print' requires label 'message'" '{ print(text: "hi") return 0 }'
reject print-arguments "'print' takes 1 arguments; 2 supplied" '{ print(message: "hi", message: "again") return 0 }'
reject print-interpolation "an interpolated value is an integer, a case without payloads, or a string; this one is Array<Element: Int<bits: 64, signed: true>>" \
    '{ let xs: Array<Int>() print(message: "\(xs)") return 0 }'
reject warning-run "native calls to builtin function 'warning' are not implemented" '{ warning(message: "at run") return 0 }'
reject effect-attribute "'@print' applies to the declaration written after it, and none follows" '{ @print("hi") return 0 }'
reject binding-in-other-arm "no declaration for 'v' in the loaded sources" \
    'function f(let o: Int?): Int { let w: switch { o.present(let v): v, o.absent: { return v } } return w }
{ return f(o: .absent) }'
# switch is the only selector: if, else, and guard are ordinary names, so
# these do not parse.
reject removed-if "removed-if.range:1:20: unexpected '{' in expression" \
    '{ let c: true if c { return 1 } return 0 }'
reject removed-else "removed-else.range:1:8: unexpected '{' in expression" '{ else { return 1 } return 0 }'
reject removed-if-let "unexpected '{' in expression" \
    'function f(let o: Int?): Int { if let n: o { return n } return 0 }
{ return f(o: .absent) }'
reject removed-if-case "unexpected '{' in expression" \
    'function f(let o: Int?): Int { if case .absent: o { return 1 } return 0 }
{ return f(o: .absent) }'
reject removed-guard "the result of this comparison is unused" \
    'function f(let n: Int): Int { guard n > 0 else { return 0 } return n }
{ return f(n: 1) }'
reject removed-guard-let "unexpected '{' in expression" \
    'function f(let o: Int?): Int { guard let n: o else { return 0 } return n }
{ return f(o: .absent) }'
reject removed-guard-case "'let n' binds a name only in a switch arm's condition or a 'for' filter" \
    'function f(let o: Int?): Int { guard case .present(let n): o else { return 0 } return n }
{ return f(o: .absent) }'
# The subject forms are gone: each arm is a condition.
reject removed-subject "expected '{' after 'switch', found 'n'" \
    'function f(let n: Int): Int { switch n { 0: return 1, default: return 0 } }
{ return f(n: 0) }'
reject removed-subjects "expected '{' after 'switch', found 'a'" \
    'function f(let a: Int, let b: Int): Int { switch a, b { default: return 0 } }
{ return f(a: 0, b: 1) }'
reject removed-for-case "expected 'in', found '.'" \
    '{ state xs: Array<Int?>() for case .present(let x) in xs { } return 0 }'
# Arms are separated by commas, with none after the last; so are arguments.
reject trailing-arm-comma "no ',' after the last switch arm" \
    'function f(let b: Bool): Int { switch { b: return 1, default: return 0, } }
{ return f(b: true) }'
reject missing-arm-comma "expected ',' between switch arms or '}', found 'default'" \
    'function f(let b: Bool): Int { switch { b: { return 1 } default: { return 0 } } }
{ return f(b: true) }'
reject trailing-argument-comma "no ',' after the last of the arguments" \
    'function f(let a: Int, let b: Int): Int { return a }
{ return f(a: 1, b: 2,) }'
reject missing-argument-comma "expected ',' between arguments or ')', found 'b'" \
    'function f(let a: Int, let b: Int): Int { return a }
{ return f(a: 1 b: 2) }'
reject declaration-arm "'let' is not an arm body by itself; write the arm as a block, { let … }" \
    'function f(let b: Bool): Int { switch { b: let x: 1, default: {} } return 0 }
{ return f(b: true) }'
reject default-not-last "'default' must be the last arm of a switch" \
    'function f(let n: Int): Int { switch { default: return 0, n = 1: return 1 } }
