#!/usr/bin/env bash
# Compiles Range programs to signed ARM64 Mach-O executables and runs them.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-native.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "compiler native: $*" >&2; exit 1; }
[[ "$(uname -sm)" == "Darwin arm64" ]] || { echo "compiler native: skipped (needs Apple silicon)"; exit 0; }
compiler="$work_root/range-compiler"
Language/Compiler/Tools/build-range-compiler "$compiler"
core=(Language/Macros/Integer.range Language/Macros/Literal.range Language/Macros/Diagnostic.range
      Language/Macros/Boolean.range Language/Macros/Equatable.range Language/Macros/Defaults.range
      Language/Types/Int.range Language/Types/Bool.range Testing/Compiler/Native/Core.range)

# run NAME EXPECTED-STATUS EXPECTED-STDERR SOURCE-FILE
run() {
    local name="$1" status="$2" message="$3" source="$4" program="$work_root/$1"
    "$compiler" -o "$program" "${core[@]}" "$source" > "$work_root/out" 2> "$work_root/log" \
        || fail "$name did not compile: $(grep -v 'warning\[' "$work_root/log")"
    grep -q "^wrote $program" "$work_root/log" || fail "$name claimed no executable"
    codesign -v "$program" 2> /dev/null || fail "$name signature does not verify"
    local actual=0
    perl -e 'alarm 10; exec @ARGV' "$program" > "$work_root/stdout" 2> "$work_root/stderr" || actual=$?
    [[ "$actual" == "$status" ]] || fail "$name exited $actual, expected $status: $(cat "$work_root/stderr")"
    if [[ -n "$message" ]]; then grep -Fq "$message" "$work_root/stderr" || fail "$name wrong message: $(cat "$work_root/stderr")"
    else [[ ! -s "$work_root/stderr" ]] || fail "$name wrote to stderr: $(cat "$work_root/stderr")"; fi
}
case_file() { printf '%s\n' "$2" > "$work_root/$1.range"; echo "$work_root/$1.range"; }

run arithmetic 42 "" Testing/Compiler/Native/Arithmetic.range
run aggregates 42 "" Testing/Compiler/Native/Aggregates.range

# The full language sources: Array's emitted methods over @many storage.
core=(Language/Grammar Language/Macros Language/Types)
run arrays 42 "" Testing/Compiler/Native/Arrays.range
run copy-on-write 42 "" Testing/Compiler/Native/CopyOnWrite.range
run lifetimes 42 "" Testing/Compiler/Native/Lifetimes.range
run output 134 "Output.range:22:9: count is 5, expected at most 3" Testing/Compiler/Native/Output.range
printf '%s\n' "Hello from Range!" "hello, world" "count: 5, last: 25, empty: false, capacity: 8" \
    "-128 4294967295 -9223372036854775808 0 true" "done" | cmp -s - "$work_root/stdout" \
    || fail "@print wrote: $(cat "$work_root/stdout")"
run enums 42 "" Testing/Compiler/Native/Enums.range
[[ "$(cat "$work_root/stdout")" == "north east west west" ]] || fail "enum cases printed: $(cat "$work_root/stdout")"
run switches 42 "" Testing/Compiler/Native/Switches.range
run payloads 42 "" Testing/Compiler/Native/Payloads.range
run patterns 42 "" Testing/Compiler/Native/Patterns.range
run recursive-enums 42 "" Testing/Compiler/Native/RecursiveEnums.range
run nested-enums 42 "" Testing/Compiler/Native/NestedEnums.range
run optionals 42 "" Testing/Compiler/Native/Optionals.range
run loops 42 "" Testing/Compiler/Native/Loops.range
run intervals 42 "" Testing/Compiler/Native/Intervals.range
run guards 42 "" Testing/Compiler/Native/Guards.range
run enum-methods 42 "" Testing/Compiler/Native/EnumMethods.range
[[ "$(cat "$work_root/stdout")" == "south 15" ]] || fail "enum methods printed: $(cat "$work_root/stdout")"
run equality 42 "" Testing/Compiler/Native/Equality.range
run equatable 42 "" Testing/Compiler/Native/Equatable.range
grep -Fq "Equatable.range:43:1: warning[macro]: Plain applies @equatable but declares no equals; the default structural equality is used" \
    "$work_root/log" || fail "explicit @equatable without equals was not warned"
! grep -Fq "LooseFraction" "$work_root/log" || fail "equals without @equatable was warned"
run equality-syntax 42 "" Testing/Compiler/Native/EqualitySyntax.range
run operators 42 "" Testing/Compiler/Native/Operators.range
run array-equality 42 "" Testing/Compiler/Native/ArrayEquality.range
run member-defaults 42 "" Testing/Compiler/Native/MemberDefaults.range
run expressions 42 "" Testing/Compiler/Native/Expressions.range
run generics 42 "" Testing/Compiler/Native/Generics.range
run bytes 42 "" Testing/Compiler/Native/Bytes.range
run control 42 "" Testing/Compiler/Native/Control.range
run evaluation 42 "" Testing/Compiler/Native/Evaluation.range
run identity-references 42 "" Testing/Compiler/Native/IdentityReferences.range
run value-generics 42 "" Testing/Compiler/Native/ValueGenerics.range
run macro-applications 42 "" Testing/Compiler/Native/MacroApplications.range
run promotion 42 "" Testing/Compiler/Native/Promotion.range
run strings-native 42 "" Testing/Compiler/Native/Strings.range
printf '%s\n' "local: hi" "hello, world" "ababab ab! ababab?" | cmp -s - "$work_root/stdout" \
    || fail "strings printed: $(cat "$work_root/stdout")"
# Every block is freed when its last reference ends, and none twice.
if command -v leaks > /dev/null; then
    for program in arrays copy-on-write lifetimes payloads patterns recursive-enums nested-enums optionals \
                   loops intervals guards enum-methods equality equatable equality-syntax operators array-equality member-defaults expressions generics promotion strings-native \
                   bytes control evaluation identity-references; do
        MallocScribble=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 "$work_root/$program" > /dev/null 2>&1 \
            || [[ $? == 42 ]] || fail "$program failed under heap checking"
        leaks --atExit -- "$work_root/$program" 2>&1 | grep -q ": 0 leaks for 0 total leaked bytes" \
            || fail "$program leaks heap storage"
    done
fi
run slot-bounds 134 "slot index is outside the @many storage" "$(case_file slot-bounds \
    '{ state xs: Array<Int>() xs.append(value: 1) return xs.read(at: 1) }')"
run strings 7 "" "$(case_file strings '{ let greeting: "hello" return 7 }')"
run byte-bounds 134 "byte index is outside the bytes" "$(case_file byte-bounds \
    '{ let s: String("hi") let b: s.byte(at: 2) return 0 }')"
run narrow-overflow 134 "result of '+' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-overflow \
    'function step(let x: Int<bits: 8>): Int<bits: 8> { return x + 100 }
{ let r: step(x: 100) return 0 }')"
run unsigned-underflow 134 "result of '-' does not fit Int<bits: 8, signed: false>" "$(case_file unsigned-underflow \
    'function down(let a: Int<bits: 8, signed: false>): Int<bits: 8, signed: false> { return a - 1 }
{ let z: down(a: 0) return 0 }')"
run division-by-zero 134 "division by zero in '/'" "$(case_file division-by-zero \
    'function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: 7, b: 0) }')"
run wide-overflow 134 "result of '*' does not fit Int<bits: 64, signed: true>" "$(case_file wide-overflow \
    'function big(let a: Int): Int { return a * a }
{ return big(a: 4294967296) }')"
run minimum-quotient 134 "result of '/' does not fit Int<bits: 64, signed: true>" "$(case_file minimum-quotient \
    'function min(): Int { return -9223372036854775807 - 1 }
function divide(let a: Int, let b: Int): Int { return a / b }
{ return divide(a: min(), b: -1) }')"
run narrow-negation 134 "result of '-' does not fit Int<bits: 8, signed: true>" "$(case_file narrow-negation \
    'function flip(let a: Int<bits: 8>): Int<bits: 8> { return -a }
{ if flip(a: -127) != 127 { return 1 } let z: flip(a: -128) return 0 }')"
run constant-overflow 134 "result of '+' does not fit Int<bits: 64, signed: true>" "$(case_file constant-overflow \
    '{ return 9223372036854775807 + 1 }')"
run constant-division 134 "division by zero in '/'" "$(case_file constant-division '{ return 4 / 0 }')"
locals="{ $(for i in $(seq 1 40); do printf 'let v%s: %s ' "$i" "$i"; done) return (v40 - v1) }"
run large-frame 39 "" "$(case_file large-frame "$locals")"

# The law rejects a literal at compile time; nothing is written.
source="$(case_file literal-law 'function id(let a: Int<bits: 8>): Int<bits: 8> { return a }
{ if id(a: -129) = 0 { return 1 } return 0 }')"
status=0
"$compiler" -o "$work_root/literal-law" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
[[ "$status" == 65 && ! -e "$work_root/literal-law" ]] || fail "literal law violation compiled"
grep -q "does not satisfy @integer" "$work_root/log" || fail "literal law reported wrongly"

# Matching is checked before code is generated: nothing is written.
# reject NAME EXPECTED-ERROR SOURCE
reject() {
    local status=0 source
    source="$(case_file "$1" "$3")"
    "$compiler" -o "$work_root/$1" "${core[@]}" "$source" > /dev/null 2> "$work_root/log" || status=$?
    [[ "$status" == 65 && ! -e "$work_root/$1" ]] || fail "$1 compiled"
    grep -Fq "$2" "$work_root/log" || fail "$1 reported wrongly: $(grep 'error\[' "$work_root/log")"
}
reject non-exhaustive "switch over Direction must be exhaustive: '.west' is not handled" \
    'enum Direction { case north, east, south, west }
function f(let d: Direction): Int { switch d { case .north, .south: return 1 case .east: return 2 } }
{ return f(d: .east) }'
reject integer-default "switch over Int<bits: 64, signed: true> must be exhaustive; add a default" \
    'function f(let n: Int): Int { switch n { case 0: return 1 case < 0: return 2 } }
{ return f(n: 1) }'
reject unknown-case "Direction has no case 'up'" \
    'enum Direction { case north, south }
function f(let d: Direction): Int { switch d { case .north: return 1 case .up: return 2 default: return 3 } }
{ return f(d: .north) }'
reject unknown-construction "Direction has no case 'up'" \
    'enum Direction { case north, south }
{ let d: Direction(.up) return 0 }'
reject duplicate-case "this pattern is already handled by earlier cases" \
    'enum Direction { case north, south }
function f(let d: Direction): Int { switch d { case .north: return 1 case .south, .north: return 2 } }
{ return f(d: .north) }'
reject unreachable-default "'default' is never reached" \
    'function f(let b: Bool): Int { switch b { case true: return 1 case false: return 0 default: return 2 } }
{ return f(b: true) }'
reject duplicate-declaration "'north' is declared more than once in Direction" \
    'enum Direction { case north, south, north }
{ return 0 }'
reject binding-outside "no declaration for 'n' in the loaded sources" \
    'enum Token { case value(Int), end }
function f(let t: Token): Int { switch t { case .value(let n): return n case .end: return 0 } return n }
{ return f(t: .end) }'
reject binding-outside-if "no declaration for 'n' in the loaded sources" \
    'function f(let o: Int?): Int { if let n: o { return n } return n }
{ return f(o: .absent) }'
reject unshared-binding "'b' must be bound by every pattern of this case" \
    'enum Pair { case one(Int), two(Int, Int) }
function f(let p: Pair): Int { switch p { case .one(let a), .two(let a, let b): return a } }
{ return f(p: .one(1)) }'
reject missing-payload "case 'value' carries a payload" \
    'enum Token { case value(Int), end }
{ let t: Token(.value) return 0 }'
reject not-optional "'if let' unwraps an optional value" \
    '{ let n: 3 if let m: n { return m } return 0 }'
reject break-outside "'break' is only allowed inside a loop or a switch" \
    '{ break return 0 }'
reject continue-outside "'continue' is only allowed inside a loop" \
    'function f(let b: Bool): Int { switch b { case true: continue case false: return 0 } }
{ return f(b: true) }'
reject guard-falls-through "the else block of 'guard' must not fall through" \
    'function f(let n: Int): Int { guard n > 0 else { @print("no") } return n }
{ return f(n: 1) }'
reject guard-break-ends-switch "the else block of 'guard' must not fall through" \
    'function f(let xs: Array<Int>): Int { for x in xs { guard x > 0 else { switch x { case 0: break default: return 0 } } } return 1 }
{ return 0 }'
reject guard-binding-in-else "no declaration for 'v' in the loaded sources" \
    'function f(let o: Int?): Int { guard let v: o else { return v } return v }
{ return f(o: .absent) }'
reject for-non-iterable "'for … in' cannot iterate Int<bits: 64, signed: true>: it declares no @iteration function" \
    '{ let n: 5 for x in n { } return 0 }'
reject two-iterations "construct 'Twice' declares 2 @iteration functions; a type declares exactly one" \
    'construct Twice {
    let n: Int
    @iteration function first(let at: Int): Int? { return .absent }
    @iteration function second(let at: Int): Int? { return .absent }
}
{ for x in Twice(n: 1) { } return 0 }'
reject iteration-signature "@iteration function 'next' of 'Bad' must take one Int position and return an optional" \
    'construct Bad { @iteration function next(let at: Int): Int { return at } }
{ return 0 }'
reject iteration-not-method "@iteration function 'next' must be a method of the type it iterates" \
    '@iteration function next(let at: Int): Int? { return .absent }
{ return 0 }'
reject interval-loop-variable "cannot assign to let 'i'" \
    '{ for i in 0..<3 { i: 2 } return 0 }'
reject interval-chain "'..<' does not chain; parenthesize one interval" \
    '{ let r: 0..<3..<4 return 0 }'
reject loop-variable "cannot assign to let 'x'" \
    '{ state xs: Array<Int>() for x in xs { x: 3 } return 0 }'
reject enum-extension-member "an extension of enum 'Direction' cannot add stored member 'speed'" \
    'enum Direction { case north, south }
extension Direction { let speed: 1 }
{ return 0 }'
# A type compares only when every field it reaches compares. Array compares
# through its own equals; raw @many storage has no '=' of its own.
raw='construct Raw { @many state slots: Int }
construct Bag { let items: Raw }'
reject uncomparable-field "'=' cannot compare Bag: field 'items' is Raw, and field 'slots' of Raw is @many storage, which the structural '=' does not compare" \
    "$raw
{ let a: Bag(items: Raw()) if a = a { return 1 } return 0 }"
reject uncomparable-payload "'=' cannot compare Place: payload field '0' of case 'at' is Bag, and field 'items' is Raw" \
    "$raw
enum Place { case at(Bag), nowhere }
function f(let p: Place): Int { switch p { case Place.nowhere: return 0 default: return 1 } }
{ let p: Place(.nowhere) if p = .nowhere { return 1 } return 0 }"
reject uncomparable-specialization "'=' cannot compare Bag: field 'items' is Raw, and field 'slots' of Raw is @many storage, which the structural '=' does not compare (in Pair<Value: Bag>)" \
    "$raw
construct Pair<Value> { let first: Value  let second: Value  function same(): Bool { return first = second } }
{ let a: Bag(items: Raw()) if Pair<Bag>(first: a, second: a).same() { return 1 } return 0 }"
reject uncomparable-element "'=' cannot compare Bag: field 'items' is Raw, and field 'slots' of Raw is @many storage, which the structural '=' does not compare (in Array<Element: Bag>)" \
    "$raw
{ state xs: Array<Bag>() if xs = xs { return 1 } return 0 }"
# Demand-driven: an Array's equals, and its element's '=', exist only when
# such arrays are compared, so an array of an uncomparable type compiles.
run uncompared-element 7 "" "$(case_file uncompared-element "$raw
{ state xs: Array<Bag>() xs.append(value: Bag(items: Raw())) return 6 + xs.count }")"
# @equatable checks equals in Range before it emits '=' calling it.
reject equals-label "the parameter of Bad.equals must be labeled 'other', as in 'function equals(let other: Bad): Bool'; it is labeled 'value'" \
    '@equatable
construct Bad { let n: Int  function equals(let value: Bad): Bool { return true } }
{ return 0 }'
reject equals-type "the parameter of Bad.equals must be of type Bad, the type it compares" \
    '@equatable
construct Bad { let n: Int  function equals(let other: Int): Bool { return true } }
{ return 0 }'
reject equals-result "Bad.equals must return Bool" \
    '@equatable
construct Bad { let n: Int  function equals(let other: Bad): Int { return 1 } }
{ return 0 }'
reject equals-count "Bad.equals must take exactly one parameter, as in 'function equals(let other: Bad): Bool'; it takes 2" \
    '@equatable
enum Bad { case one, two  function equals(let other: Bad, let again: Bad): Bool { return true } }
{ return 0 }'
reject equals-enum-type "the parameter of Bad.equals must be of type Bad, the type it compares" \
    '@equatable
enum Bad { case one, two  function equals(let other: Bool): Bool { return true } }
{ return 0 }'
# One way to define equality: a type never writes '=' itself.
reject user-equality "Own declares '=' itself; apply @equatable and declare 'function equals(let other: Own): Bool' instead" \
    'construct Own { let n: Int  function =(let other: Own): Bool { return true } }
{ if Own(n: 1) = Own(n: 2) { return 1 } return 0 }'
reject user-equality-extension "Own declares '=' itself; apply @equatable and declare 'function equals(let other: Own): Bool' instead" \
    'enum Own { case one, two }
extension Own { function =(let other: Own): Bool { return true } }
{ return 0 }'
reject top-level-equality "'=' must be declared on the type it compares, in the type or an extension of it" \
    'function =(let other: Int): Bool { return true }
{ return 0 }'
# Every other operator is the function its left operand's type declares.
reject undeclared-operator "'<' is not declared on Point" \
    'construct Point { let x: Int }
{ if Point(x: 1) < Point(x: 2) { return 1 } return 0 }'
reject undeclared-prefix "'-' is not declared on Point" \
    'construct Point { let x: Int }
{ let p: -Point(x: 1) return 0 }'
reject undeclared-relation "'<' is not declared on Point" \
    'construct Point { let x: Int }
function f(let p: Point): Int { switch p { case < Point(x: 0): return 1 default: return 0 } }
{ return f(p: Point(x: 1)) }'
reject mixed-widths "operator '+' requires matching types; found Int<bits: 8, signed: true> and Int<bits: 64, signed: true>" \
    'function f(let a: Int<bits: 8>, let b: Int): Int<bits: 8> { return a + b }
{ return 0 }'
reject not-equal-declared "operator '!=' cannot be declared: it is the negation of '='" \
    'construct N { let n: Int  function !=(let other: N): Bool { return true } }
{ return 0 }'
reject top-level-operator "'+' must be declared on the type of its left operand, in the type or an extension of it" \
    'function +(let other: Int): Int { return other }
{ return 0 }'
reject operator-arity "operator '+' takes one parameter, the right operand; N.+ takes 2" \
    'construct N { let n: Int  function +(let a: N, let b: N): N { return a } }
{ return 0 }'
reject builtin-logical "builtin '!' is a C primitive of the condition type only; Flag declares it" \
    'enum Flag { case up, down  @builtin function !(): Flag }
{ let f: Flag(.up) let g: !f return 0 }'
# Overloads differ in labels or parameter types; identical ones are ambiguous.
reject duplicate-method "ambiguous: f is declared twice with the same signature; first declared at" \
    'construct Twice { let n: Int  function f(let x: Int): Int { return x }  function f(let x: Int): Bool { return true } }
{ return Twice(n: 1).f(x: 1) }'
reject duplicate-function "ambiguous: g is declared twice with the same signature; first declared at" \
    'function g(let x: Int<bits: 8>): Int { return 1 }
function g(let y: Int<bits: 8>): Int { return 2 }
function g(let x: Int<bits: 8>): Int { return 3 }
{ return g(x: 1) }'
# Range has no self: members are bare names, and an enum's name is its value
# only as a subject inside its own functions.
reject self-rejected "Range has no self; use member names, or the enum's name as a switch subject" \
    'construct Counter { let n: Int  function get(): Int { return self.n } }
{ return 0 }'
reject subject-outside-enum "'Direction' names a type; as a subject it is the current value only inside Direction's own functions" \
    'enum Direction { case north, south }
function f(): Int { switch Direction { case .north: return 1 default: return 0 } }
{ return f() }'
reject subject-other-enum "'Light' names a type; as a subject it is the current value only inside Light's own functions" \
    'enum Light { case on, off
    enum Color { case red  function f(): Int { switch Light { case .on: return 1 default: return 0 } } } }
{ return 0 }'
# Equality is a single `=`; `==` is never an alternative spelling.
reject double-equals "double-equals.range:1:17: use '=' for equality" \
    '{ let a: 1 if a == 1 { return 1 } return 0 }'
reject double-equals-pattern "double-equals-pattern.range:1:47: use '=' for equality" \
    'function f(let n: Int): Int { switch n { case == 1: return 1 default: return 0 } }
{ return f(n: 1) }'
# Equality code is emitted on demand: only for the types a program compares
# (here Point), never for types it only declares or constructs.
text_size() { size -m "$1" | awk '/Section __text:/ { print $3 }'; }
base='construct Point { let x: Int  let y: Int }
function make(let n: Int): Point { return Point(x: n, y: n) }'
compare='{ let p: make(n: 1) let q: make(n: 2) if p = q { return 1 } return 0 }'
ignore='{ let p: make(n: 1) let q: make(n: 2) if p.x = q.x { return 1 } return 0 }'
unused='construct Unused { let a: Int  let b: Point }
enum Shape { case dot(Point), line(Point, Point), none }
@equatable
construct Custom { let n: Int  function equals(let other: Custom): Bool { return n = other.n } }'
loose='construct Custom { let n: Int  function equals(let other: Custom): Bool { return n = other.n } }'
for variant in compared:"$base
$compare" ignored:"$base
$ignore" unused:"$base
$unused
$ignore" loose:"$base
$loose
$ignore"; do
    name="demand-${variant%%:*}"
    "$compiler" -o "$work_root/$name" "${core[@]}" "$(case_file "$name" "${variant#*:}")" > /dev/null 2> "$work_root/log" \
        || fail "$name did not compile: $(grep 'error\[' "$work_root/log")"
done
[[ "$(text_size "$work_root/demand-compared")" -gt "$(text_size "$work_root/demand-ignored")" ]] \
    || fail "comparing Point emitted no equality code"
[[ "$(text_size "$work_root/demand-unused")" == "$(text_size "$work_root/demand-loose")" ]] \
    || fail "types that are never compared emitted equality code"
loose_size="$(text_size "$work_root/demand-loose")"; ignored_size="$(text_size "$work_root/demand-ignored")"
[[ "$loose_size" -gt "$ignored_size" ]] || fail "Custom's own equals method was not compiled"
# Generic functions: a body is checked per instantiation, which the error names.
reject generic-operation "'+' is not declared on Bool; in sum<T: Bool>, specialized at" \
    'function sum<T>(let a: T, let b: T): T { return a + b }
{ if sum(a: true, b: false) { return 1 } return sum(a: 1, b: 2) }'
reject generic-equality "'=' cannot compare Bag: field 'items' is Raw, and field 'slots' of Raw is @many storage, which the structural '=' does not compare; in same<T: Bag>" \
    "$raw
function same<T>(let a: T, let b: T): Bool { return a = b }
{ let b: Bag(items: Raw()) if same(a: b, b: b) { return 1 } return 0 }"
reject generic-uninferred "cannot infer type parameter Value of 'nothing'; write it, as in nothing<…>(…)" \
    'function nothing<Value>(): Value? { return .absent }
{ let x: nothing() return 0 }'
reject generic-conflict "type parameter Value of 'pick' is Int<bits: 64, signed: true> from an earlier argument, but argument 'b' is Bool" \
    'function pick<Value>(let a: Value, let b: Value): Value { return a }
{ let x: pick(a: 1, b: true) return 0 }'
reject generic-arity "'id' takes 1 type argument" \
    'function id<T>(let a: T): T { return a }
{ return id<Bool, Int>(a: 1) }'
# Value generics on functions: a literal per instantiation, required unless defaulted.
reject value-generic-missing "'times' requires generic n; write it, as in times<n: …>(…)" \
    'function times<let n: Int>(let value: Int): Int { return value * n }
{ return times(value: 2) }'
reject value-generic-literal "generic n of 'times' requires a literal value" \
    'function times<let n: Int>(let value: Int): Int { return value * n }
{ let k: 3 return times<n: k>(value: 2) }'
reject value-generic-type "generic n of 'times' requires Int<bits: 64, signed: true>; found Bool" \
    'function times<let n: Int>(let value: Int): Int { return value * n }
{ return times<n: true>(value: 2) }'
reject value-generic-law "Int<bits: 8, signed: true> does not satisfy @integer" \
    'function small<let n: Int<bits: 8>>(): Int<bits: 8> { return n }
{ let x: small<n: 300>() return 0 }'
reject value-generic-unknown "'f' has no generic 'm'" \
    'function f<let n: 2>(): Int { return n }
{ return f<m: 3>() }'
reject construct-value-required "'Grid' requires generic width" \
    'construct Grid<let width: Int> { let cells: 0 }
{ let g: Grid() return 0 }'
reject generic-method "generic methods are not implemented; declare 'get' as a top-level generic function" \
    'construct Box { let n: Int  function get<T>(let t: T): T { return t } }
{ return 0 }'
# Declarations and calls the parser and type checker refuse.
reject colon-function-default "parameter defaults require construction syntax, not a second colon" \
    'function sample(let value: Int: 3): Int { return value }
{ return 0 }'
reject colon-macro-default "parameter defaults require construction syntax, not a second colon" \
    'macro sample(let value: Int: 3): Construct {}
{ return 0 }'
for keyword in derived state; do
    reject "$keyword-function-input" "inputs require explicit let or binding" "function identity($keyword value: Int): Int { return value }
{ return 0 }"
    reject "$keyword-macro-input" "inputs require explicit let or binding" "macro sample($keyword value: Int): Construct {}
{ return 0 }"
done
reject implicit-function-input "inputs require explicit let or binding" \
    'function identity(value: Int): Int { return value }
{ return 0 }'
reject implicit-macro-input "inputs require explicit let or binding" \
    'macro sample(value: Int): Construct {}
{ return 0 }'
for alias in external _; do
    reject "parameter-alias-$alias" "parameters require a single name used as the argument label" "function identity(let $alias value: Int): Int { return value }
{ return 0 }"
    reject "macro-parameter-alias-$alias" "parameters require a single name used as the argument label" "macro sample(let $alias value: Int): Construct {}
{ return 0 }"
done
# A local states its value; only construct members leave it to construction.
reject local-let-value "'v' needs an initial value" '{ let v: Int return 0 }'
reject local-state-value "'v' needs an initial value" '{ state v: Int v: 3 return v }'
reject local-array-value "'xs' needs an initial value" '{ state xs: Array<Int> return xs.count }'
# A member default sees only the members declared before it.
reject default-forward "the default of 'a' refers to 'b', which is declared after it; a default sees only the members before it" \
    'construct F { let a: b * 2  let b: Int }
{ return F(b: 1).a }'
reject default-self "the default of 'a' refers to 'a' itself" \
    'construct F { let a: a }
{ return 0 }'
reject default-cycle "the type of 'a' depends on itself" \
    'construct F { let a: b + 1  let b: a + 1 }
{ return F().a }'
reject template-execution "@syntax is deferred; structural syntax is defined in C" '{ @syntax($value) return 0 }'
reject trailing-interpolation "trailing tokens in interpolation" '{ let value: String("\(1 2)") return value.count }'
reject immutable "cannot assign to let 'value'" '{ let value: Int(1) value: 2 return value }'
reject missing-label "argument 1 of 'identity' requires label 'value'" \
    'function identity(let value: Int): Int { return value }
{ return identity(42) }'
reject wrong-label "argument 1 of 'f' requires label 'value'" \
    'function f(let value: Int): Int { return value }
{ return f(other: 1) }'
reject type-mismatch "argument 'value' of 'f' requires Bool; found Int<bits: 64, signed: true>" \
    'function f(let value: Bool): Int { return 1 }
{ return f(value: 3) }'
reject undefined-unreached "no declaration for 'missing' in the loaded sources" \
    '{ if false { return missing(value: 1) } return 0 }'
reject unknown-reference "no declaration for 'missing' in the loaded sources" '{ let user: missing return 0 }'
reject union-type "union type resolution is not implemented" \
    'function f(let value: Int | Bool): Int { return 1 }
{ return f(value: 3) }'
reject macro-target "unknown macro target type 'Int'" \
    'macro transform(): Int { return 3 }
{ @transform return 0 }'
# Without a construct applying @interval, as in the minimal core, `..<` has no meaning.
full=("${core[@]}")
core=(Language/Macros/Integer.range Language/Macros/Literal.range Language/Macros/Diagnostic.range
      Language/Macros/Boolean.range Language/Macros/Equatable.range Language/Macros/Defaults.range
      Language/Types/Int.range Language/Types/Bool.range Testing/Compiler/Native/Core.range)
reject interval-undeclared "'..<' needs exactly one construct applying @interval; found 0" \
    '{ let r: 0..<3 return 0 }'
core=("${full[@]}")

echo "compiler native: programs=47 rejections=95 signatures=pass traps=pass literal-law=pass aggregates=pass arrays=pass copy-on-write=pass lifetimes=pass output=pass enums=pass switches=pass payloads=pass recursive-enums=pass optionals=pass loops=pass intervals=pass guards=pass enum-methods=pass equality=pass equatable=pass equality-on-demand=pass equality-syntax=pass operators=pass array-equality=pass member-defaults=pass expressions=pass generics=pass promotion=pass strings=pass converted=pass"
