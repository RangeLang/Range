#!/usr/bin/env bash
# Compile-time macro behavior comes from Range bodies, not concrete C type rules.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-validation.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "compiler validation: $*" >&2; exit 1; }
for mode in ordinary sanitized; do
    options=()
    link_options=()
    if [[ "$mode" == sanitized ]]; then
        options=(--sanitize)
        link_options=(-fsanitize=address,undefined -fno-omit-frame-pointer -g)
    fi
    compiler="$work_root/$mode"
    Language/Compiler/Tools/build-range-compiler "$compiler" ${options[@]+"${options[@]}"}
    clang -std=c17 -Wall -Wextra -Werror -O1 ${link_options[@]+"${link_options[@]}"} \
        Testing/Compiler/Graph/Validation.c Language/Compiler/Source/{lexer,parser,model,graph}.c \
        -o "$work_root/$mode-validation"
    "$work_root/$mode-validation"
    for option in --validate-macros --check-return; do
        status=0
        "$compiler" "$option" Language/Macros Language/Types > "$work_root/out" 2> "$work_root/error" || status=$?
        [[ "$status" == 64 ]] || fail "$mode removed specialized checker still accepted"
    done
    echo "compiler validation: $mode internal-evaluator=pass Range-integer-rules=pass specialized-entry-removed=pass"
done
