@main {
    state numbers   [1, 2, 3]
    numbers.append(element: 4)
    numbers.update(element: 10, index: 0)

    let first   numbers.element(index: 0)
    let firstLarge   numbers.first(where: { value in value > 2 })
    let largeNumbers   numbers.filter(include: { value in value > 2 })
    let numberCount   numbers.count
    let numbersAreEmpty   numbers.isEmpty

    state counts   ["a": 1]
    counts.updateValue(value: 2, key: "b")

    let hasA   counts.contains(key: "a")
    let valueA   counts.value(key: "a")
    let positiveEntries   counts.filter(include: { entry in entry.value > 0 })
    let firstPositiveEntry   counts.first(where: { entry in entry.value > 0 })

    state unique: Set<Int>([1, 2])
    unique.insert(element: 3)

    let hasOne   unique.contains(element: 1)
    let largeUniqueValues   unique.filter(include: { value in value > 1 })
    let firstLargeUniqueValue   unique.first(where: { value in value > 1 })
    let uniqueCount   unique.count
}
