function decodePair(): Result<String, DecodingError> {
    let values: Array<JSONValue>([
        .int(value: 42),
        .string(value: "George"),
    ])
    let decoder   JSONDecoder(value: .array(values: values))
    state container   decoder.unkeyedContainer()

    switch container.decode(Int.self) {
    case .success:
        break
    case .failure(let error):
        return .failure(cause: error)
    }

    switch container.decode(String.self) {
    case .success(let name):
        return .success(result: name)
    case .failure(let error):
        return .failure(cause: error)
    }
}

@main {
    switch decodePair() {
    case .success(let name):
        Logger.info(name)
    case .failure:
        Logger.error("decoding failed")
    }
}
