macro emitIdentifierConstruct(): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self) {
            function #(Identifier(generatedName))(): String {
                return "ok"
            }
        }
    }
}

@emitIdentifierConstruct
construct IdentifierInitMacroFixture {
}

@main {
    let fixture: IdentifierInitMacroFixture()
    let value: String(fixture.generatedName())
}
