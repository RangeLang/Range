@main {
    let source   Channel<String>()
    let listenerA   Channel<String>()
    let listenerB   Channel<String>()

    @background {
        let message   source.receive()
        listenerA.send(message)
        listenerB.send(message)
    }

    @background {
        Logger.info(listenerA.receive())
    }

    @background {
        Logger.info(listenerB.receive())
    }

    source.send("update")
}
