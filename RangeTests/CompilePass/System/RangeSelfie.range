function tokenKindName(kind: TokenKind): String {
    switch kind {
    case .hash:
        return "hash"
    case .identifier:
        return "identifier"
    case .markerAttribute:
        return "markerAttribute"
    case .foreignBody:
        return "foreignBody"
    case .stringLiteral:
        return "stringLiteral"
    case .integer:
        return "integer"
    case .double:
        return "double"
    case .keyword:
        return "keyword"
    case .macroAttribute:
        return "macroAttribute"
    case .leftBrace:
        return "leftBrace"
    case .rightBrace:
        return "rightBrace"
    case .leftParen:
        return "leftParen"
    case .rightParen:
        return "rightParen"
    case .leftBracket:
        return "leftBracket"
    case .rightBracket:
        return "rightBracket"
    case .asterisk:
        return "asterisk"
    case .dot:
        return "dot"
    case .ellipsis:
        return "ellipsis"
    case .colon:
        return "colon"
    case .arrow:
        return "arrow"
    case .bang:
        return "bang"
    case .equal:
        return "equal"
    case .equalEqual:
        return "equalEqual"
    case .bangEqual:
        return "bangEqual"
    case .minus:
        return "minus"
    case .less:
        return "less"
    case .lessEqual:
        return "lessEqual"
    case .greater:
        return "greater"
    case .greaterEqual:
        return "greaterEqual"
    case .plus:
        return "plus"
    case .plusEqual:
        return "plusEqual"
    case .slash:
        return "slash"
    case .ampersand:
        return "ampersand"
    case .andAnd:
        return "andAnd"
    case .pipe:
        return "pipe"
    case .orOr:
        return "orOr"
    case .question:
        return "question"
    case .questionQuestion:
        return "questionQuestion"
    case .dollar:
        return "dollar"
    case .percent:
        return "percent"
    case .comma:
        return "comma"
    case .eof:
        return "eof"
    }
}

function renderTokens(tokens: [LexicalToken]): String {
    state output   ""
    state index   0

    while index < tokens.count {
        let token: LexicalToken(tokens.element(index: index))
        output += "\(index): \(tokenKindName(kind: token.kind)) \"\(token.source)\" @ \(token.range.start.line):\(token.range.start.character)-\(token.range.end.line):\(token.range.end.character)\n"
        index += 1
    }

    return output
}

@main {
    switch FileManager.readFile(path: "../../../RangeSelfie.range") {
    case .success(let source):
        Logger.info(source)
        switch FileManager.createFile(path: "../../../RangeSelfie.txt", text: source) {
        case .success:
            Logger.info("wrote RangeSelfie.txt")
        case .failure:
            Logger.error("failed to write selfie")
        }

        let lexer: Lexer(rangeLexer())
        switch lexer.tokenize(source: source) {
        case .success(let tokens):
            Logger.info("tokens: \(tokens.count)")
            switch FileManager.createFile(path: "../../../RangeSelfie.tokens.txt", text: renderTokens(tokens: tokens)) {
            case .success:
                Logger.info("wrote RangeSelfie.tokens.txt")
            case .failure:
                Logger.error("failed to write selfie tokens")
            }
        case .failure(let error):
            Logger.error(error.message)
        }
    case .failure:
        Logger.error("failed to read selfie")
    }
}
