#GraphDeclaration
construct ProgramFileGraphNode { }

function renderProgram(program: RangeProgram): String {
    return "RangeProgram\nfiles: \(program.graph.files.count)\n\(renderFiles(files: program.graph.files))graph nodes: \(program.graph.rangeGraph.nodes.count)\ngraph relationships: \(program.graph.rangeGraph.relationships.count)\n\(renderRangeGraph(graph: program.graph.rangeGraph))syntax: \(program.graph.syntax.count)\ndeclarations: \(countDeclarations(graph: program.graph))\napplications: \(countApplications(graph: program.graph))\n\(renderSyntaxItems(items: program.graph.syntax))"
}

function renderIdentity(identity: RangeGraphIdentity): String {
    return "\(identity.kind) \(identity.name) [\(identity.id)]"
}

function renderFiles(files: [FileTreeNode]): String {
    state output   ""
    state index   0

    while index < files.count {
        let file: FileTreeNode(files.element(index: index))
        output += "- \(file.path) children: \(file.children.count)\n"
        index += 1
    }

    return output
}

function renderRangeGraph(graph: RangeGraph): String {
    return "\(renderRangeGraphNodes(nodes: graph.nodes))\(renderRangeGraphRelationships(relationships: graph.relationships))"
}

function renderRangeGraphNodes(nodes: [RangeGraphNode]): String {
    state output   ""
    state index   0

    while index < nodes.count {
        let node: RangeGraphNode(nodes.element(index: index))
        output += "- node \(renderIdentity(identity: node.identity)) source: \(node.sourcePath) labels: \(node.labels.count)\n"
        index += 1
    }

    return output
}

function renderRangeGraphRelationships(relationships: [RangeGraphRelationship]): String {
    state output   ""
    state index   0

    while index < relationships.count {
        let relationship: RangeGraphRelationship(relationships.element(index: index))
        output += "- relationship \(relationship.kind) \(relationship.origin.id) -> \(relationship.destination.id)\n"
        index += 1
    }

    return output
}

function renderSyntaxItems(items: [GraphSyntax]): String {
    state output   ""
    state index   0

    while index < items.count {
        let item: GraphSyntax(items.element(index: index))
        output += "- syntax \(renderIdentity(identity: item.identity))\n"
        output += "  declarations: \(item.declarations.count)\n"
        output += "  applications: \(item.applications.count)\n"
        index += 1
    }

    return output
}

function countDeclarations(graph: ProgramGraph): Int {
    state count   0
    state index   0

    while index < graph.syntax.count {
        let syntax: GraphSyntax(graph.syntax.element(index: index))
        count += syntax.declarations.count
        index += 1
    }

    return count
}

function countApplications(graph: ProgramGraph): Int {
    state count   0
    state index   0

    while index < graph.syntax.count {
        let syntax: GraphSyntax(graph.syntax.element(index: index))
        count += syntax.applications.count
        index += 1
    }

    return count
}

@main {
    switch FileTree.read(path: "../../../") {
    case .success(let tree):
        let program: RangeProgram(
            graph: ProgramGraph(
                files: [tree],
                sources: [],
                lexedSources: [],
                artifacts: [],
                rangeGraph: RangeGraph(
                    nodes: [
                        RangeGraphNode(
                            identity: RangeGraphIdentity(
                                id: "ProgramFileGraphNode",
                                kind: "construct",
                                name: "ProgramFileGraphNode"
                            ),
                            sourcePath: "../../../RangeProgramFileGraph.range",
                            labels: ["declaration", "file-graph"]
                        ),
                        RangeGraphNode(
                            identity: RangeGraphIdentity(
                                id: "FileTree.read",
                                kind: "function",
                                name: "FileTree.read"
                            ),
                            sourcePath: "../../../RangeProgramFileGraph.range",
                            labels: ["application", "file-graph"]
                        )
                    ],
                    relationships: [
                        RangeGraphRelationship(
                            origin: RangeGraphIdentity(
                                id: "ProgramFileGraphNode",
                                kind: "construct",
                                name: "ProgramFileGraphNode"
                            ),
                            destination: RangeGraphIdentity(
                                id: "FileTree.read",
                                kind: "function",
                                name: "FileTree.read"
                            ),
                            kind: "uses"
                        )
                    ]
                ),
                syntax: [
                    GraphSyntax(
                        identity: RangeGraphIdentity(
                            id: "ProgramFileGraphNode",
                            kind: "construct",
                            name: "ProgramFileGraphNode"
                        ),
                        declarations: [
                            GraphDeclaration(
                                identity: RangeGraphIdentity(
                                    id: "ProgramFileGraphNode",
                                    kind: "construct",
                                    name: "ProgramFileGraphNode"
                                )
                            )
                        ],
                        applications: [
                            GraphApplication(
                                identity: RangeGraphIdentity(
                                    id: "FileTree.read",
                                    kind: "function",
                                    name: "FileTree.read"
                                )
                            )
                        ]
                    )
                ]
            )
        )
        let output: String(renderProgram(program: program))
        Logger.info(output)
        switch FileManager.createFile(path: "../../../RangeProgramFileGraph.txt", text: output) {
        case .success:
            Logger.info("wrote RangeProgramFileGraph.txt")
        case .failure:
            Logger.error("failed to write RangeProgramFileGraph.txt")
        }
    case .failure:
        Logger.error("failed to read program file graph")
    }
}
