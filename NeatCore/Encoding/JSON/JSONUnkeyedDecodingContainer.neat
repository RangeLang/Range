construct JSONUnkeyedDecodingContainer: UnkeyedDecodingContainer {
    let values: [JSONValue]
    state index: Int = 0

    init(values: [JSONValue]) {
        self.values = values
    }

    function isAtEnd() -> Bool {
        return index >= values.count
    }

    function decode(_ type: Bool.Type) -> Result<Bool, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(Bool.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: Float.Type) -> Result<Float, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(Float.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: Int.Type) -> Result<Int, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(Int.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: String.Type) -> Result<String, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(String.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: UUID.Type) -> Result<UUID, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(UUID.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode<T: Decodable>(_ type: T.Type) -> Result<T, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let decoder = JSONDecoder(value: value)
            return T(from: decoder)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function nextValue() -> Result<JSONValue, DecodingError> {
        if index >= self.values.count {
            return .failure(cause: .failed)
        }

        index += 1
        return .success(result: self.values.element(index: index - 1))
    }
}
