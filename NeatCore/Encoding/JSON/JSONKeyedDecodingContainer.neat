construct JSONKeyedDecodingContainer<Key: CodingKey>: KeyedDecodingContainer<Key> {
    let fields: [JSONField]

    function decode(_ type: Bool.Type, forKey key: Key) -> Result<Bool, DecodingError> {
        switch value(forKey: key) {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(Bool.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: Float.Type, forKey key: Key) -> Result<Float, DecodingError> {
        switch value(forKey: key) {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(Float.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: Int.Type, forKey key: Key) -> Result<Int, DecodingError> {
        switch value(forKey: key) {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(Int.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(_ type: String.Type, forKey key: Key) -> Result<String, DecodingError> {
        switch value(forKey: key) {
        case .success(let value):
            let container = JSONSingleValueDecodingContainer(value: value)
            return container.decode(String.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode<T: Decodable>(_ type: T.Type, forKey key: Key) -> Result<T, DecodingError> {
        switch value(forKey: key) {
        case .success(let value):
            let decoder = JSONDecoder(value: value)
            return T(from: decoder)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function value(forKey key: Key) -> Result<JSONValue, DecodingError> {
        for field in fields {
            if field.key == key.stringValue() {
                return .success(result: field.value)
            }
        }

        return .failure(cause: .failed)
    }
}
