construct JSONDecoder: Decoder<JSONValue> {
    let value: JSONValue

    function decode(_ type: Bool.Type, from value: JSONValue) -> Result<Bool, DecodingError> {
        let decoder = JSONDecoder(value: value)
        return Bool(from: decoder)
    }

    function decode(_ type: Float.Type, from value: JSONValue) -> Result<Float, DecodingError> {
        let decoder = JSONDecoder(value: value)
        return Float(from: decoder)
    }

    function decode(_ type: Int.Type, from value: JSONValue) -> Result<Int, DecodingError> {
        let decoder = JSONDecoder(value: value)
        return Int(from: decoder)
    }

    function decode(_ type: String.Type, from value: JSONValue) -> Result<String, DecodingError> {
        let decoder = JSONDecoder(value: value)
        return String(from: decoder)
    }

    function keyedContainer() -> KeyedDecodingContainer {
        switch value {
        case .object(let fields):
            return JSONKeyedDecodingContainer(fields: fields)
        case .array, .bool, .float, .int, .null, .string:
            return JSONKeyedDecodingContainer(fields: [])
        }
    }

    function singleValueContainer() -> SingleValueDecodingContainer {
        return JSONSingleValueDecodingContainer(value: value)
    }

    function unkeyedContainer() -> UnkeyedDecodingContainer {
        switch value {
        case .array(let values):
            return JSONUnkeyedDecodingContainer(values: values)
        case .bool, .float, .int, .null, .object, .string:
            return JSONUnkeyedDecodingContainer(values: [])
        }
    }
}
