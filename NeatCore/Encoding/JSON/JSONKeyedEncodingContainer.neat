construct JSONKeyedEncodingContainer<Key: CodingKey>: KeyedEncodingContainer<Key> {
    binding output: String
    binding isObject: Bool
    state wroteField: Bool = false

    init(output: binding String, isObject: binding Bool) {
        self.output = output
        self.isObject = isObject
        self.isObject = true
    }

    function encode(_ value: Bool, forKey key: Key) -> Result<Void, EncodingError> {
        appendField(key: key, value: "\(value)")
        return .success(result: Void())
    }

    function encode(_ value: Data, forKey key: Key) -> Result<Void, EncodingError> {
        return .failure(cause: .failed)
    }

    function encode(_ value: Float, forKey key: Key) -> Result<Void, EncodingError> {
        appendField(key: key, value: "\(value)")
        return .success(result: Void())
    }

    function encode(_ value: Int, forKey key: Key) -> Result<Void, EncodingError> {
        appendField(key: key, value: "\(value)")
        return .success(result: Void())
    }

    function encode(_ value: String, forKey key: Key) -> Result<Void, EncodingError> {
        appendField(key: key, value: "\"\(value)\"")
        return .success(result: Void())
    }

    function encode<T: Encodable>(_ value: T, forKey key: Key) -> Result<Void, EncodingError> {
        let encoder = JSONEncoder()

        switch encoder.encode(value) {
        case .success(let encoded):
            appendField(key: key, value: encoded)
            return .success(result: Void())
        case .failure(let error):
            return .failure(cause: error)
        }

        return .failure(cause: .failed)
    }

    function appendField(key: Key, value: String) {
        if wroteField {
            output = output + ","
        } else {
            wroteField = true
        }

        output = output + "\"" + key.stringValue() + "\":" + value
    }
}
