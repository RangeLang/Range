@core
construct Construct: Syntax, SupportsExtension {
    value declaration: Declaration
    value application: Application

    @core
    construct Declaration {
        value self: TypeReference
        value inits: [Init.Declaration]
        value functions: [Function.Declaration]
        value constructs: [Construct.Declaration]
    }

    @core
    construct Application {
      value init: Init.Application
    }
}
