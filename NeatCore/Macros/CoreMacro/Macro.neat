@language
construct Macro: Syntax {
    @language
    construct Declaration: Syntax {
        let identifier: Identifier
        let parameters: [Parameter.Declaration]
        let target: TypeReference
        let expansionType: Optional<TypeReference>
    }

    @language
    construct Application: Syntax {
        let identifier: Identifier
        let genericArguments: [TypeReference]
        let argumentClause: String
        let arguments: [Expression]
    }
}
