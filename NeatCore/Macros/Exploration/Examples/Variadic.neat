// Exploratory variadic macro example.
// This file is for design iteration only.

macro variadic(): Parameter { target, diagnostics in
    if !target.application.arguments.isEmpty {
        target.application.arguments[0].expression.rewrite(
            ArrayExpression(
                elements: target.application.arguments.map { $0.expression }
            )
        )
    }
}

function sum(#variadic _ values: Int) -> Int { }

sum(1, 2, 3)
