// Manual smoke case for protocol-carried init macros.
// This is not executable yet because Attached<Init> execution is not implemented.

protocol ExpressableByIntLiteral {
    #literal<IntLiteral>
    init(literal _: Int)
}

construct Number: ExpressableByIntLiteral {
    init(literal _: Int) { }
}

@main {
  state count = 5
}
