macro autoclosure(): Parameter { target, diagnostics in
    target.declaration.type.rewrite(
        TypeReference.function(
            parameters: [],
            returnType: target.declaration.type
        )
    )

    if !target.application.arguments.isEmpty {
        target.application.arguments.rewrite(
            Closure(
                body: {
                    target.application.arguments[0].expression
                }
            )
        )
    }
}
