macro autoclosure(): Parameter { target, diagnostics in
    target.declaration.type.rewrite(
        FunctionTypeReference(
            parameters: [],
            returnType: target.declaration.type
        )
    )

    if target.application.argument != nil {
        target.application.argument.expression.rewrite(
            Closure(
                body: {
                    target.application.argument.expression
                }
            )
        )
    }
}
