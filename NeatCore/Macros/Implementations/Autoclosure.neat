macro autoclosure: Attached<Parameter> { target, diagnostics in
    target.parameter.type.rewrite(
        FunctionType(
            parameters: [],
            returnType: target.parameter.type
        )
    )

    if !target.arguments.isEmpty {
        target.arguments.rewrite(
            Closure(
                body: {
                    target.arguments.expression
                }
            )
        )
    }
}
