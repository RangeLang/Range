macro codable(_ strategy: CodingKeyStrategy = .identity): Construct { target, diagnostics in
    let encodeBody: Block = Block(
        statements: target.declaration.lets.map { property in
            let defaultKey: String = strategy == .snakeCase ? property.name.snakeCase() : property.name
            let codingKeyMarkers: [Marker.Application] = property.markers.filter { application in
                application.name == "codingKey"
            }
            let codingKeyValues: [String] = codingKeyMarkers.map { application in
                application.value
            }
            let key: String = codingKeyValues.first(default: defaultKey)

            Switch(
                expression: "container.encode(\(property.name), forKey: \"\(key)\")",
                cases: [
                    SwitchCase(
                        pattern: ".success",
                        body: Block(statements: [
                            Break()
                        ])
                    ),
                    SwitchCase(
                        pattern: ".failure(let error)",
                        body: Block(statements: [
                            Return(expression: ".failure(cause: error)")
                        ])
                    )
                ]
            )
        }
    )

    let decodeBody: Block = Block(
        statements: target.declaration.lets.map { property in
            let defaultKey: String = strategy == .snakeCase ? property.name.snakeCase() : property.name
            let codingKeyMarkers: [Marker.Application] = property.markers.filter { application in
                application.name == "codingKey"
            }
            let codingKeyValues: [String] = codingKeyMarkers.map { application in
                application.value
            }
            let key: String = codingKeyValues.first(default: defaultKey)

            Switch(
                expression: "container.decode(\(property.typeName).self, forKey: \"\(key)\")",
                cases: [
                    SwitchCase(
                        pattern: ".success(let " + property.name + ")",
                        body: Block(statements: [
                            Assignment(
                                target: "self." + property.name,
                                expression: property.name
                            )
                        ])
                    ),
                    SwitchCase(
                        pattern: ".failure(let error)",
                        body: Block(statements: [
                            Return(expression: ".failure(cause: error)")
                        ])
                    )
                ]
            )
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self): Codable {
            function encode(to encoder: Encoder) -> Result<Void, EncodingError> {
                let container: KeyedEncodingContainer = encoder.keyedContainer()
                #(encodeBody)
                return .success(result: Void())
            }

            init(from decoder: Decoder) -> Result<Self, DecodingError> {
                let container: KeyedDecodingContainer = decoder.keyedContainer()
                #(decodeBody)
                return .success(result: self)
            }
        }
    }
}
