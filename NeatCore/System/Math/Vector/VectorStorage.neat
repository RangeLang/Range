construct VectorStorage<Scalar> {
    let components: [Scalar] = []

    derived count: Int {
        components.count
    }

    derived isEmpty: Bool {
        components.isEmpty
    }

    function component(index: Int) -> Scalar {
        return components.element(index: index)
    }

    function map<Output>(_ transform: (Scalar) -> Output) -> VectorStorage<Output> {
        return VectorStorage<Output>(components: components.map(transform))
    }
}
