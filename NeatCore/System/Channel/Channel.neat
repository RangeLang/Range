@core
construct Channel<Element, Failure = Never> {
    value storage: ChannelStorage<Promise<Element, Failure>>

    init() {
        self.storage = ChannelStorage(capacity: 0)
    }

    init(capacity: Int) {
        self.storage = ChannelStorage(capacity: capacity)
    }

    function send(element _: Element) {
        storage.send(element: .success(result: element))
    }

    function send(promise _: Promise<Element, Failure>) {
        storage.send(element: promise)
    }

    function receive() -> Promise<Element, Failure> {
        return storage.receive()
    }

    function close() {
        storage.close()
    }
}
