@core
enum Result<Success, Failure> {
    case success(result: Success)
    case failure(cause: Failure)
}

@core
enum Promise<Success, Failure> {
    case loading
    case success(result: Success)
    case failure(cause: Failure)
}

@core
enum Stream<Element, Failure> {
    case loading
    case value(item: Element)
    case failure(cause: Failure)
    case completed
}
