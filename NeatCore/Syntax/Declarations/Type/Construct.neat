@core
construct Construct: Syntax {
    let declaration: Declaration
    let application: Application

    @core
    construct Declaration<SelfType: NominalTypeReference>: SyntaxExpandable<SelfType>, SyntaxEmittable {
        let self: SelfType
        let conformances: [NominalTypeReference]
        let inits: [Init.Declaration]
        let lets: [Let]
        let states: [State]
        let bindings: [Binding]
        let deriveds: [Derived]
        let functions: [Function.Declaration]
        let constructs: [Construct.Declaration]
        let extensions: [Extension<SelfType>]

        function expand(_ expansion: () -> [Syntax])
    }

    @core
    construct Application {
        let init: Init.Application
    }
}
