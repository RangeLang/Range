@core
construct Enum: Syntax {
    let declaration: Declaration
    let cases: [Case]

    @core
    construct Declaration<SelfType: NominalTypeReference>: SyntaxExpandable<SelfType> {
        let self: SelfType
    }

    @core
    construct Case {
        let name: String
        let associatedValues: [AssociatedValue]
    }

    @core
    construct AssociatedValue {
        let label: String?
        let type: TypeReference
    }
}
