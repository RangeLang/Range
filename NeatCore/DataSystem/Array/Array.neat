@core
construct Array<Element>: ExpressableByArrayLiteral {
    state storage: ArrayStorage<Element>

    init()

    init(literal: ArrayLiteral) {
        self.storage = literal.storage()
    }

    derived count: Int {
        storage.count
    }

    derived isEmpty: Bool {
        storage.isEmpty
    }

    function append(element: Element) {
        storage.append(element: element)
    }

    function element(index: Int) -> Element {
        storage.element(index: index)
    }

    function first() -> Element? {
        storage.first()
    }

    function last() -> Element? {
        storage.last()
    }

    function update(element: Element, index: Int) {
        storage.update(element: element, index: index)
    }

    function insert(element: Element, index: Int) {
        storage.insert(element: element, index: index)
    }

    function remove(index: Int) -> Element {
        storage.remove(index: index)
    }

    function removeLast() -> Element? {
        storage.removeLast()
    }

    function clear() {
        storage.clear()
    }

    // Collection transforms belong on Array semantics, not on ArrayLiteral.
    function map<Result>(_ transform: (Element) -> Result) -> Array<Result>
    function filter(_ include: (Element) -> Bool) -> Array<Element>
    function compactMap<Result>(_ transform: (Element) -> Result?) -> Array<Result>
}
