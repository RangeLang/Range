@core
construct Bool: ExpressibleByBoolLiteral, Equatable, Hashable {
    let storage: BoolStorage

    init(literal: BoolLiteral) {
        self.storage = literal.storage()
    }
}

extension Bool: Decodable {
    init(from decoder: Decoder<JSONValue>) -> Result<Self, DecodingError> {
        let container = decoder.singleValueContainer()
        switch container.decode(Bool.self) {
        case .success(let value):
            self.storage = value.storage
            return .success(result: self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }
}

extension Bool: Encodable {
    function encode<Output>(to encoder: Encoder<Output>) -> Result<Void, EncodingError> {
        let container = encoder.singleValueContainer()
        return container.encode(self)
    }
}
