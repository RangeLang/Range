@core
construct Dictionary<Key: Hashable, Value>: ExpressibleByDictionaryLiteral {
    state storage: DictionaryStorage<Key, Value>

    init()
    init(literal: DictionaryLiteral) {
        self.storage = literal.storage()
    }

    derived count: Int {
        storage.count
    }

    derived isEmpty: Bool {
        storage.isEmpty
    }

    function value(key: Key) -> Value? {
        return storage.value(key: key)
    }

    function updateValue(value: Value, key: Key) {
        storage.updateValue(value: value, key: key)
    }

    function removeValue(key: Key) -> Value? {
        return storage.removeValue(key: key)
    }

    function contains(key: Key) -> Bool {
        return storage.contains(key: key)
    }

    function entries() -> [DictionaryEntry<Key, Value>] {
        return storage.entries()
    }

    function clear() {
        storage.clear()
    }
}

extension Dictionary<String, Value: Encodable>: Encodable {
    function encode<Output>(to encoder: Encoder<Output>) -> Result<Void, EncodingError> {
        state container = encoder.container(keyedBy: StringCodingKey.self)
        let values: [DictionaryEntry<String, Value>] = entries()
        state index = 0

        while index < values.count {
            let entry: DictionaryEntry<String, Value> = values.element(index: index)
            let key = StringCodingKey(value: entry.key)

            switch container.encode(entry.value, forKey: key) {
            case .success:
                index += 1
            case .failure(let error):
                return .failure(cause: error)
            }
        }

        return .success(result: Void())
    }
}
