@language
construct DictionaryStorage<Key: Hashable, Value> {
    init()
    init(literal: DictionaryLiteral)
    derived count: Int
    derived isEmpty: Bool
    function value(key: Key) -> Optional<Value>
    function updateValue(value: Value, key: Key)
    function removeValue(key: Key) -> Optional<Value>
    function contains(key: Key) -> Bool
    function entries() -> [DictionaryEntry<Key, Value>]
    function filter(include: (DictionaryEntry<Key, Value>) -> Bool) -> [DictionaryEntry<Key, Value>]
    function first(where include: (DictionaryEntry<Key, Value>) -> Bool) -> Optional<DictionaryEntry<Key, Value>>
    function clear()
}
