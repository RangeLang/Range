@language
construct Hasher {
    state storage: HasherStorage = HasherStorage()

    function combine<T: Hashable>(_ value: T) {
        value.hash(into: self)
    }

    function combineStorage(_ value: IntStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: StringStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: BoolStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: DateStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: DateTimeStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: FloatStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: DataStorage) {
        storage.combine(value)
    }

    function combineStorage(_ value: UUIDStorage) {
        storage.combine(value)
    }

    function finalize() -> Int {
        return storage.finalize()
    }
}
