@core
construct Int<let bits: IntLiteral, let signedness: Signedness = .signed>: ExpressibleByIntLiteral, Equatable, Hashable, Comparable {
    let storage: IntStorage

    init(literal: IntLiteral) {
        self.storage = literal.storage()
    }
}

extension Int: Encodable {
    function encode<Output>(to encoder: Encoder<Output>) -> Result<Void, EncodingError> {
        let container = encoder.singleValueContainer()
        return container.encode(self)
    }
}
