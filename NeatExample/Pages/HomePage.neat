@Page HomePage {
  Meta {
    Title("Home")
    Description("The home page for NeatExample.")
  }

  @State var count = 0

  VStack {
    HomePageHeader()
    CoreHero()
    CoreCard().surface.background(.rgba(255, 255, 255, "0.72"))
    Text("Count: \(count)")
    Button("Add") {
      count += 1
    }
  }
}
