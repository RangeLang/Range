protocol Renderable {
  function renderTitle(): String
}

enum PanelKind {
  case overview
  case board
  case graph
  case settings
}

enum NodeVisualState {
  case idle
  case selected
  case warning
}

enum EdgeDirection {
  case incoming
  case outgoing
  case bidirectional
}

construct SidebarItem: Renderable, Identified {
  let id: Int
  let title: String
  let panel: PanelKind

  function renderTitle(): String {
    return title
  }
}

construct ToolbarAction: Renderable, Identified {
  let id: Int
  let title: String
  let shortcut: String
  state isEnabled: Bool

  function renderTitle(): String {
    return "\(title) \(shortcut)"
  }
}

construct NodeCard: Renderable, Identified {
  let id: Int
  let title: String
  let subtitle: String
  state visualState: NodeVisualState
  binding theme: Theme

  function renderTitle(): String {
    return "\(title) / \(subtitle)"
  }
}

construct EdgeBadge: Renderable, Identified {
  let id: Int
  let title: String
  let direction: EdgeDirection
  binding source: NodeCard
  binding target: NodeCard

  function renderTitle(): String {
    return "\(source.title) -> \(target.title)"
  }
}

construct InspectorSection: Renderable, Identified {
  let id: Int
  let title: String
  binding node: NodeCard
  binding theme: Theme

  function renderTitle(): String {
    return "\(title): \(node.title)"
  }
}

construct CanvasViewport {
  state x: Int
  state y: Int
  state zoom: Int
  let guide: LayoutGuide

  function zoomIn() {
    zoom += 1
  }
}

construct GraphSurface: Renderable {
  binding viewport: CanvasViewport
  binding selectedNode: NodeCard
  binding inspector: InspectorSection
  binding theme: Theme

  function renderTitle(): String {
    return selectedNode.renderTitle()
  }
}
