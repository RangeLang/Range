protocol Named {
  let name: String
}

protocol Identified {
  let id: Int
}

enum UserRole {
  case owner
  case editor
  case viewer
}

enum ProjectStatus {
  case draft
  case active
  case paused
  case archived
}

enum TaskPriority {
  case low
  case medium
  case high
  case critical
}

enum ActivityKind {
  case created
  case updated
  case commented
  case linked
}

construct User: Named, Identified {
  let id: Int
  let name: String
  let role: UserRole
  state isOnline: Bool

  derived badge: String {
    "\(name) / \(role)"
  }
}

construct Team: Named, Identified {
  let id: Int
  let name: String
  state lead: User
  state memberCount: Int

  function addMember() {
    memberCount += 1
  }
}

construct Project: Named, Identified {
  let id: Int
  let name: String
  state status: ProjectStatus
  state owner: User

  derived headline: String {
    "\(name) is \(status)"
  }

  function statusLabel(): String {
    return "\(name) is \(status)"
  }
}

construct Milestone: Named, Identified {
  let id: Int
  let name: String
  state progress: Int
  binding project: Project

  derived label: String {
    "\(project.name) / \(name)"
  }
}

construct WorkItem: Named, Identified {
  let id: Int
  let name: String
  state priority: TaskPriority
  state assignee: User
  binding milestone: Milestone

  function escalationScore(): Int {
    return id + 100
  }
}

construct ActivityEvent: Identified {
  let id: Int
  let kind: ActivityKind
  let message: String
  binding actor: User
  binding project: Project

  derived summary: String {
    "\(actor.name) \(message)"
  }
}

construct Workspace: Named, Identified {
  let id: Int
  let name: String
  state team: Team
  state project: Project
  state activeMilestone: Milestone
  state selectedItem: WorkItem

  derived title: String {
    "\(team.name) / \(project.name)"
  }
}
