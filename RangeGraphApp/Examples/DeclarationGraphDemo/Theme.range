enum ThemeMode {
  case system
  case light
  case dark
}

enum Density {
  case compact
  case regular
  case spacious
}

enum AccentColor {
  case blue
  case teal
  case rose
  case amber
}

construct ColorToken: Named {
  let name: String
  let hex: String
}

construct TypographyToken: Named {
  let name: String
  let size: Int
  let weight: String
}

construct SpacingScale: Named {
  let name: String
  let unit: Int

  function doubled(): Int {
    return unit * 2
  }
}

construct Theme: Named {
  let name: String
  state mode: ThemeMode
  state density: Density
  state accent: AccentColor
  let background: ColorToken
  let foreground: ColorToken
  let titleFont: TypographyToken
  let bodyFont: TypographyToken
  let spacing: SpacingScale

  function modeLabel(): String {
    return "\(name) uses \(mode)"
  }
}

construct LayoutGuide: Named {
  let name: String
  let spacing: SpacingScale
  let minWidth: Int
  let maxWidth: Int

  derived midpoint: Int {
    (minWidth + maxWidth) / 2
  }
}
