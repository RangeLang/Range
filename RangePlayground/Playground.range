function add(lhs: Int, rhs: Int): Int {
    return lhs + rhs
}

function sum3(x: Int, y: Int, z: Int): Int {
    let partial: Int(add(lhs: x, rhs: y))
    return add(lhs: partial, rhs: z)
}

function chooseLower(lhs: Int, rhs: Int): Int {
    let fallback: Int(lhs)

    if lhs < rhs {
        return lhs
    } else {
        return fallback
    }
}

function nestedSum(limit: Int): Int {
    state outer: Int(0)
    state total: Int(0)

    while outer < limit {
        state inner: Int(0)

        while inner < limit {
            state total: total + outer + inner
            state inner: inner + 1
        }

        state outer: outer + 1
    }

    return total
}

function describe(value: Int): String {
    return "Range playground result: \(value)"
}

@main {
    let scalar: Int(sum3(x: 1, y: 2, z: 3))
    let loop: Int(nestedSum(limit: 10))
    let chosen: Int(chooseLower(lhs: scalar, rhs: loop))

    Logger.info(describe(value: scalar + chosen + loop))
}
