@main {
    state numbers   [1, 2, 3]
    numbers.append(element: 4)
    numbers.update(element: 10, index: 0)
    numbers.insert(element: 5, index: 1)

    let first   numbers.element(index: 0)
    let count   numbers.count
    let empty   numbers.isEmpty
    let removed   numbers.remove(index: 1)
}
