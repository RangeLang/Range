enum Result<Success, Failure> {
    case success(result: Success)
    case failure(cause: Failure)
}

enum ParseError {
    case invalid
}

function parse(): Result<[Int], ParseError> {
    return .success(result: [4, 8, 12])
}

@main {
    switch parse() {
    case .success(let values):
        return values[1]
    case .failure(let error):
        return 0
    }
}
