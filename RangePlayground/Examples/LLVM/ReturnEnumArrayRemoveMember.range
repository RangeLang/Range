enum NumberToken {
    case value(value: Int)
    case eof
}

@main {
    let tokens: [NumberToken]([.value(value: 4), .value(value: 6)])
    let removed: NumberToken(tokens.remove(index: 0))
    switch removed {
    case .value(let number):
        return number == 4 && tokens.count == 1 ? 0 : 1
    case .eof:
        return 1
    }
}
