function performanceReportVersion(): String {
    return "\(Date())"
}

function performanceReportGeneratedAt(): String {
    return "\(DateTime())"
}

function styleSheet(): String {
    return "<style>\n" +
        ":root{--bg:@fbfbfc;--ink:#15181f;--muted:#8a92a0;--line:@d7dce4;--range:#21a66f;--other:#555d6a;--cpu:#3978c9;--memory:#9b6a21;--missing:@b7bec8;}\n" +
        "*{box-sizing:border-box;}\n" +
        "body{margin:0;background:var(--bg);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}\n" +
        "main{min-height:100vh;display:grid;place-items:center;padding:30px;}\n" +
        ".report{width:min(1240px,100%);display:grid;gap:18px;}\n" +
        ".heading{display:grid;gap:6px;}\n" +
        "h1{margin:0;font-size:54px;font-weight:800;letter-spacing:0;}\n" +
        ".subtitle{margin:0;color:var(--muted);font-size:22px;font-weight:750;}\n" +
        ".chart-wrap{overflow:hidden;}\n" +
        "svg{display:block;width:100%;height:auto;}\n" +
        ".axis{stroke:@aeb6c2;stroke-width:2.5;}\n" +
        ".grid-line{stroke:var(--line);stroke-width:1.5;}\n" +
        ".tick,.label,.note{fill:var(--muted);font-size:15px;font-weight:700;}\n" +
        ".curve{fill:none;stroke-width:9;stroke-linecap:round;stroke-linejoin:round;opacity:.52;}\n" +
        ".range-curve{stroke-width:11;opacity:1;}\n" +
        ".point{stroke:@fff;stroke-width:5;}\n" +
        ".skip{fill:none;stroke:var(--missing);stroke-width:3.5;stroke-dasharray:6 6;}\n" +
        ".pill{stroke:@fff;stroke-width:3;rx:13;ry:13;}\n" +
        ".pill-text{fill:@fff;font-size:14px;font-weight:800;}\n" +
        ".metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}\n" +
        ".metric-card{border:1px solid var(--line);border-radius:8px;padding:18px;background:@fff;display:grid;gap:14px;}\n" +
        ".metric-card h2{margin:0;font-size:22px;font-weight:800;letter-spacing:0;}\n" +
        ".metric-card p{margin:0;color:var(--muted);font-size:14px;font-weight:700;}\n" +
        ".metric-rows{display:grid;gap:10px;}\n" +
        ".metric-row{display:grid;grid-template-columns:70px 1fr 58px;align-items:center;gap:10px;font-size:14px;font-weight:800;}\n" +
        ".metric-track{display:block;height:12px;border-radius:999px;background:@eef1f5;overflow:hidden;}\n" +
        ".metric-fill{display:block;height:100%;border-radius:999px;background:var(--other);}\n" +
        ".metric-fill.range{background:var(--range);}\n" +
        ".metric-fill.cpu{background:var(--cpu);}\n" +
        ".metric-fill.memory{background:var(--memory);}\n" +
        ".metric-value{color:var(--muted);text-align:right;}\n" +
        "@media(max-width:760px){main{place-items:start;padding:20px;}h1{font-size:36px;}}\n" +
        "@media(max-width:860px){.metric-grid{grid-template-columns:1fr;}}\n" +
        "</style>\n"
}

function gridLine(y y: Int): String {
    return "<line class='grid-line' x1='90' y1='\(y)' x2='1030' y2='\(y)'></line>\n"
}

function tick(y y: Int, label label: String, x x: Int): String {
    return "<text class='tick' x='\(x)' y='\(y)'>\(label)</text>\n"
}

function xLabel(x x: Int, text text: String): String {
    return "<text class='label' x='\(x)' y='520'>\(text)</text>\n"
}

function curve(color color: String, className className: String, path path: String): String {
    return "<path class='curve \(className)' stroke='\(color)' d='\(path)'></path>\n"
}

function point(color color: String, x x: Int, y y: Int, radius radius: Int): String {
    return "<circle class='point' cx='\(x)' cy='\(y)' r='\(radius)' fill='\(color)'></circle>\n"
}

function pill(text text: String, x x: Int, y y: Int, width width: Int, color color: String): String {
    return "<rect class='pill' x='\(x)' y='\(y)' width='\(width)' height='26' fill='\(color)'></rect>\n" +
        "<text class='pill-text' x='\(x + 13)' y='\(y + 18)'>\(text)</text>\n"
}

function metricRow(name name: String, value value: String, width width: Int, className className: String): String {
    return "<div class='metric-row'>\n" +
        "<span>\(name)</span>\n" +
        "<span class='metric-track'><span class='metric-fill \(className)' style='width:\(width)%'></span></span>\n" +
        "<span class='metric-value'>\(value)</span>\n" +
        "</div>\n"
}

function metricCard(title title: String, subtitle subtitle: String, kind kind: String): String {
    state output: ""
    output += "<article class='metric-card'>\n"
    output += "<h2>\(title)</h2>\n"
    output += "<p>\(subtitle)</p>\n"
    output += "<div class='metric-rows'>\n"

    if kind == "cpu" {
        output += metricRow(name: "C", value: "1.00x", width: 67, className: "cpu")
        output += metricRow(name: "Rust", value: "1.03x", width: 69, className: "cpu")
        output += metricRow(name: "Swift", value: "1.23x", width: 82, className: "cpu")
        output += metricRow(name: "Range", value: "1.34x", width: 90, className: "range")
    } else {
        output += metricRow(name: "C", value: "1.00x", width: 67, className: "memory")
        output += metricRow(name: "Rust", value: "1.15x", width: 77, className: "memory")
        output += metricRow(name: "Swift", value: "1.35x", width: 90, className: "memory")
        output += metricRow(name: "Range", value: "1.42x", width: 95, className: "range")
    }

    output += "</div>\n"
    output += "</article>\n"
    return output
}

function metricComparisonPanels(): String {
    return "<section class='metric-grid' aria-label='CPU and memory usage comparison'>\n" +
        metricCard(title: "CPU Usage", subtitle: "Median child CPU time relative to C. Lower is better.", kind: "cpu") +
        metricCard(title: "Memory Usage", subtitle: "Median peak resident memory relative to C. Lower is better.", kind: "memory") +
        "</section>\n"
}

function chartSvg(): String {
    state output: ""

    output += "<section class='chart-wrap' aria-label='Relative runtime XY chart'>\n"
    output += "<svg viewBox='0 0 1120 620' role='img' aria-labelledby='chart-title chart-desc'>\n"
    output += "<title id='chart-title'>Range performance comparison #1</title>\n"
    output += "<desc id='chart-desc'>A single XY chart comparing C, Rust, Swift, and Range relative runtime across benchmark cases.</desc>\n"

    output += gridLine(y: 80)
    output += gridLine(y: 264)
    output += gridLine(y: 448)

    output += "<line class='axis' x1='90' y1='80' x2='90' y2='470'></line>\n"
    output += "<line class='axis' x1='90' y1='470' x2='1030' y2='470'></line>\n"

    output += tick(y: 452, label: "1x", x: 62)
    output += tick(y: 268, label: "1.25x", x: 42)
    output += tick(y: 84, label: "1.5x", x: 48)

    output += xLabel(x: 100, text: "Arithmetic Loop")
    output += xLabel(x: 402, text: "String Building")
    output += xLabel(x: 687, text: "Array Processing")
    output += xLabel(x: 964, text: "Initialization")

    output += curve(color: "var(--other)", className: "", path: "M 120 151 C 240 187, 320 246, 410 246 C 520 222, 610 202, 700 202 C 790 228, 880 276, 970 276")
    output += curve(color: "var(--other)", className: "", path: "M 120 407 C 240 466, 320 482, 410 482 C 520 448, 610 424, 700 418 C 790 424, 880 442, 970 442")
    output += curve(color: "var(--other)", className: "", path: "M 120 448 C 260 448, 360 448, 410 448 C 520 448, 610 448, 700 448 C 790 448, 880 448, 970 448")
    output += curve(color: "var(--range)", className: "range-curve", path: "M 120 295 C 240 301, 320 326, 410 326 C 520 342, 610 350, 700 346 C 790 322, 880 276, 970 276")

    output += point(color: "var(--range)", x: 120, y: 295, radius: 11)
    output += point(color: "var(--range)", x: 410, y: 326, radius: 11)
    output += point(color: "var(--range)", x: 700, y: 346, radius: 11)
    output += point(color: "var(--range)", x: 970, y: 276, radius: 11)

    output += pill(text: "Swift", x: 132, y: 128, width: 62, color: "var(--other)")
    output += pill(text: "Range", x: 132, y: 282, width: 74, color: "var(--range)")
    output += pill(text: "Rust", x: 132, y: 394, width: 56, color: "var(--other)")
    output += pill(text: "C", x: 132, y: 434, width: 34, color: "var(--other)")

    output += "<text class='note' x='92' y='592'>Lower is faster. Scale is focused on the 1x to 1.5x native performance band.</text>\n"
    output += "</svg>\n"
    output += "</section>\n"

    return output
}

function renderPerformanceComparisonHTML(): String {
    return "<!doctype html>\n" +
        "<html lang='en'>\n" +
        "<head>\n" +
        "<meta charset='utf-8'>\n" +
        "<meta name='viewport' content='width=device-width, initial-scale=1'>\n" +
        "<meta name='range-report-version' content='\(performanceReportVersion())'>\n" +
        "<meta name='range-generated-at' content='\(performanceReportGeneratedAt())'>\n" +
        "<title>Range Performance Comparison #1</title>\n" +
        styleSheet() +
        "</head>\n" +
        "<body>\n" +
        "<main>\n" +
        "<section class='report' aria-label='Range performance comparison'>\n" +
        "<header class='heading'>\n" +
        "<h1>Range Performance Comparison #1</h1>\n" +
        "<p class='subtitle'>Range vs C, Rust and Swift</p>\n" +
        "</header>\n" +
        chartSvg() +
        metricComparisonPanels() +
        "</section>\n" +
        "</main>\n" +
        "</body>\n" +
        "</html>\n"
}

@main {
    Logger.log(renderPerformanceComparisonHTML())
}
