function encodeArray() -> Result<String, EncodingError> {
    let encoder = JSONEncoder()
    let values = [1, 2, 3]
    return encoder.encode(values)
}

#main {
    switch encodeArray() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }
}
