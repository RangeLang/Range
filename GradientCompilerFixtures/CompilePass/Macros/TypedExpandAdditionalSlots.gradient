protocol AdditionalTypedExpandProtocol {
}

macro typedExpandAdditionalSlots(): Construct { target, diagnostics in
    target.declaration.expand {
        protocol #(Identifier(name: "GeneratedTypedExpandProtocol")): #(AdditionalTypedExpandProtocol) {
        }

        enum #(Identifier(name: "GeneratedTypedExpandEnum")): #(AdditionalTypedExpandProtocol) {
            case #(Identifier(name: "payload"))(value: #(Int))
        }

        construct #(Identifier(name: "GeneratedTypedExpandNamespace")) {
            function #(Identifier(name: "message"))() -> #(String) {
                let local: #(String) = "ok"
                return local
            }
        }

        construct #(Identifier(name: "GeneratedTypedExpandConstruct"))<Wrapped: #(AdditionalTypedExpandProtocol), let count: #(Int)>: #(AdditionalTypedExpandProtocol) {
            let label: #(String)
            binding amount: #(Int)
            let externalText: #(String)
        }

        extension #(target.declaration.self) {
            #(target.declaration.self) function #(Identifier(name: "typedTargetFunction"))(input: #(Int)) -> #(target.declaration.self) {
                return self
            }
        }
    }
}

@typedExpandAdditionalSlots
