function double(value: Int) -> Int {
    return value * 2
}

function worker(jobs: Channel<Int>, results: Channel<Int>) {
    @background {
        let job: Int = jobs.receive()
        let result: Int = double(value: job)
        results.send(result)
    }
}

#main {
    let jobs = Channel<Int>(storage: ChannelStorage<Int>(capacity: 2))
    let results = Channel<Int>(storage: ChannelStorage<Int>(capacity: 2))

    worker(jobs: jobs, results: results)
    worker(jobs: jobs, results: results)

    jobs.send(1)
    jobs.send(2)

    let first: Int = results.receive()
    let second: Int = results.receive()

    Logger.info(first)
    Logger.info(second)
}
