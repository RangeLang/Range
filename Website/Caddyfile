{
	admin off
}

{$SITE_ALIAS_ADDRESS:http://www.localhost} {
	redir {$SITE_ADDRESS:http://localhost}{uri} permanent
}

{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	@geistFonts path /fonts/geist/*
	header @geistFonts Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy website:3000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
