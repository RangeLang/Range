# The canonical public URL. Caddy obtains and renews its HTTPS certificate,
# while SvelteKit uses the same value when resolving request origins.
SITE_ADDRESS=https://your-domain.example

# Optional alternate hostname. Requests permanently redirect to SITE_ADDRESS.
SITE_ALIAS_ADDRESS=https://www.your-domain.example

# Optional immutable image label, such as a commit SHA.
RANGE_WEBSITE_TAG=latest

# Change these only when ports 80 or 443 are already mapped elsewhere.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
