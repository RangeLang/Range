{
  "name": "range-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "vite dev",
    "performance": "vite dev --host 127.0.0.1 --open /performance",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate:og": "bun run build && bun scripts/generate-post-og-images.ts",
    "sync:sources": "bun scripts/sync-source-snapshots.ts",
    "start": "bun build/index.js",
    "test": "bun run build && bun test tests"
  },
  "dependencies": {
    "@lucide/svelte": "^0.563.1",
    "d3-hierarchy": "3.1.2",
    "d3-voronoi-map": "2.1.1",
    "drizzle-orm": "0.45.2",
    "sveltely": "file:src/lib/frameworks/sveltely"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.7",
    "svelte": "5.56.7",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "type": "module"
}
