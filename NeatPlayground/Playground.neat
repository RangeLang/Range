@main {
  state person: Person = Person(name: "George", age: 26)

  person.age += 1

  derived personString: String {
    "Person: \(person.name), Age: \(person.age)"
  }
  Logger.info(personString)

  state user: User = User(person: $person)
  user.incrementAge()
  Logger.info("After increment: \(person.age)")
}

construct Person {
    value name: String
    value age: Int
}

construct User {
  binding person: Person

  function incrementAge() {
    person.age += 1
  }
}
