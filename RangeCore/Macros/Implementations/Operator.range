marker Operator<let fixity: OperatorFixity>(
    binding: OperatorBindingRange,
    associativity: OperatorAssociativity = .none
): Construct -> OperatorBinding { target, diagnostics in
    return OperatorBinding(
        token: Identifier(name: target.declaration.self.name),
        fixity: fixity,
        binding: binding,
        associativity: associativity
    )
}
