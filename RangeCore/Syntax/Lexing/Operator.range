@syntax
enum OperatorFixity {
    case prefix
    case infix
    case postfix
}

@syntax
enum OperatorAssociativity {
    case none
    case left
    case right
}

@syntax
construct OperatorBindingRange {
    let lower: Int
    let upper: Int
}

@syntax
#Polarity
construct Negativity {
}

@syntax
#Polarity
construct Neutrality {
}

@syntax
#Polarity
construct Positivity {
}

@syntax
construct Signage {
    let polarity: #Polarity
}

@syntax
construct OperatorBindingMetric {
    let step: Int
    let delta: Int
    let signage: Signage
}

@syntax
construct OperatorBinding {
    let token: Identifier
    let fixity: OperatorFixity
    let binding: OperatorBindingRange
    let metric: OperatorBindingMetric
    let associativity: OperatorAssociativity
}
