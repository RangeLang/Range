@token("*")
construct Asterisk {
}

@syntax
@token("/")
construct Slash {
}

@syntax
@token("$")
construct Dollar {
}

@syntax
@token("%")
construct Percent {
}

@syntax
@token("#")
construct Hash {
}

@syntax
@token("...")
construct Ellipsis {
}

@syntax
@token("->")
construct Arrow {
}

@syntax
@token("-")
construct Minus {
}

@syntax
@token("!")
construct Bang {
}

@syntax
@token("!=")
construct BangEqual {
}

@syntax
@token("=")
construct Equal {
}

