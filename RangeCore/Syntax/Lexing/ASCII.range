@token("??")
construct QuestionQuestion {
}

@syntax
@token("identifier")
construct IdentifierToken {
    let value: String
}

@syntax
@token("keywordIdentifier")
construct Keyword {
    let value: String
}

@syntax
@token("`identifier`")
construct EscapedIdentifier {
    let value: String
}

@syntax
@token("quotedString")
construct StringLiteralToken {
    let value: String
}

@syntax
@token("digits")
construct IntegerLiteral {
    let value: String
}

@syntax
@token("digits.digits")
construct DoubleLiteral {
    let value: String
}

@syntax
@token("#identifier")
construct HashDirective {
    let value: String
}

@syntax
@token("@identifier")
construct AtAttribute {
    let name: String
}

@syntax
@token("foreignBody")
construct ForeignBody {
    let language: String
    let text: String
}

@syntax
@token("end")
construct EOF {
}

@syntax
@token("//")
construct LineComment {
}

@syntax
construct ASCIISymbol {
    let value: String
}

@syntax
construct ASCIIIdentifierCharacter {
    let value: String
}
@syntax
construct ASCII {
    let value: ASCIILiteral
