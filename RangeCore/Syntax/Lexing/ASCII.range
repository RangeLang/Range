@token("+")
construct Plus {
}

@syntax
@token("+=")
construct PlusEqual {
}

@syntax
@token("&")
construct Ampersand {
}

@syntax
@token("&&")
construct AndAnd {
}

@syntax
@token("|")
construct Pipe {
}

@syntax
@token("||")
construct OrOr {
}

@syntax
@token("?")
construct Question {
}

