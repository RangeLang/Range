construct MathFunction<Input, Output> {
    let signature: FunctionTypeReference
    let body: Closure
    let source: WrittenSyntax?
}

construct MathField<Sample, Output> {
    let value: MathFunction<Sample, Output>
}

construct MathPair<A, B> {
    let first: A
    let second: B
}

construct MathRelation<Domain, Codomain> {
    let from: Domain
    let to: Codomain
}

construct MathLine<Point> {
    let start: Point
    let end: Point
}

construct MathEdge<Node> {
    let start: Node
    let end: Node
}

construct MathAxis<Edge> {
    let edges: [Edge]
}

construct MathSample<Domain> {
    let domain: Domain
}

construct Math {
    function abs(value: Int): Int {
        if value < 0 {
            return 0 - value
        }

        return value
    }

    function abs(value: Float): Float {
        if value < 0.0 {
            return 0.0 - value
        }

        return value
    }

    function min<T: Comparable>(lhs: T, rhs: T): T {
        if lhs < rhs {
            return lhs
        }

        return rhs
    }

    function max<T: Comparable>(lhs: T, rhs: T): T {
        if lhs < rhs {
            return rhs
        }

        return lhs
    }

    function clamp<T: Comparable>(value: T, min lower: T, max upper: T): T {
        return Math.min(lhs: Math.max(lhs: value, rhs: lower), rhs: upper)
    }
}
