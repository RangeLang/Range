construct ComponentStorage<Component> {
    let components: [Component]   []

    derived count: Int {
        components.count
    }

    derived isEmpty: Bool {
        components.isEmpty
    }

    function component(index: Int) -> Component {
        return components.element(index: index)
    }

    function map<Output>(_ transform: (Component) -> Output) -> ComponentStorage<Output> {
        return ComponentStorage<Output>(components: components.map(transform))
    }
}
