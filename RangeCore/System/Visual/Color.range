enum ColorSpace {
    case rgb
    case hsl
    case hsv
    case cmyk
    case oklch
}

construct ColorAxis {
    let name: Identifier
}

construct ColorSpaceModel<let space: ColorSpace> {
    let axes: [ColorAxis]
    let light: MathFunction<Color<space>, Color<.rgb>>
}

construct Color<let space: ColorSpace> {
    let storage: ComponentStorage<Float>
}

construct ColorLibrary {
    function rgb(red: Float, green: Float, blue: Float, alpha: Float): Color<.rgb> {
        return Color<.rgb>(storage: ComponentStorage<Float>(components: [red, green, blue, alpha]))
    }

    function hsl(hue: Float, saturation: Float, lightness: Float, alpha: Float): Color<.hsl> {
        return Color<.hsl>(storage: ComponentStorage<Float>(components: [hue, saturation, lightness, alpha]))
    }

    function hsv(hue: Float, saturation: Float, value: Float, alpha: Float): Color<.hsv> {
        return Color<.hsv>(storage: ComponentStorage<Float>(components: [hue, saturation, value, alpha]))
    }

    function cmyk(cyan: Float, magenta: Float, yellow: Float, black: Float, alpha: Float): Color<.cmyk> {
        return Color<.cmyk>(storage: ComponentStorage<Float>(components: [cyan, magenta, yellow, black, alpha]))
    }

    function oklch(lightness: Float, chroma: Float, hue: Float, alpha: Float): Color<.oklch> {
        return Color<.oklch>(storage: ComponentStorage<Float>(components: [lightness, chroma, hue, alpha]))
    }

    function light(_ value: Color<.rgb>): Color<.rgb> {
        return value
    }

    function light<let space: ColorSpace>(_ value: Color<space>): Color<.rgb>
}
