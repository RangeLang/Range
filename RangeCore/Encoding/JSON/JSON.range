#encoding
construct JSON {
    function encode<T: Encodable>(_ value: T) -> Result<String, EncodingError> {
        state encoder   JSONEncoder()
        return encoder.encode(value)
    }

    function decode(_ type: Bool.Type, from value: JSONValue) -> Result<Bool, DecodingError> {
        let decoder   JSONDecoder(value: value)
        return Bool.decode(from: decoder)
    }

    function decode(_ type: Float.Type, from value: JSONValue) -> Result<Float, DecodingError> {
        let decoder   JSONDecoder(value: value)
        return Float.decode(from: decoder)
    }

    function decode(_ type: Int.Type, from value: JSONValue) -> Result<Int, DecodingError> {
        let decoder   JSONDecoder(value: value)
        return Int.decode(from: decoder)
    }

    function decode(_ type: String.Type, from value: JSONValue) -> Result<String, DecodingError> {
        let decoder   JSONDecoder(value: value)
        return String.decode(from: decoder)
    }
}
