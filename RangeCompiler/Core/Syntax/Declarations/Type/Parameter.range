@syntax(.chained, { #name: #type }, separator: ", ")
@graph(.declaration)
construct Parameter {
    @description {
        ## The parameter's name and hashed identity.
    }
    @hidden
    let identity: Identifier
    let macros: [@macro]
    let syntax: @syntax
}

@syntax(.chained, { #name: #type }, separator: ", ")
@graph(.application)
construct Parameter {
    @description {
        ## The parameter's name and hashed identity.
    }
    @hidden
    let identity: Identifier
    let type: @type
    let syntax: @syntax
}
