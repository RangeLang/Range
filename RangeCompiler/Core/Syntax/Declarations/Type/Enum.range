@syntax
construct Enum {
    let declaration: Declaration

    @graph(.declaration)
    construct Declaration: SyntaxExpandable<NominalTypeReference>, SyntaxEmittable {
        let self: NominalTypeReference
        let generics: [Generic]
        let cases: [Case]

        function expand(_ expansion: () -> [Syntax])
    }

    @graph(.declaration)
    construct Case: SyntaxEmittable {
        let identifier: Identifier
        let associatedValues: [AssociatedValue]
    }

    construct AssociatedValue {
        let label: String?
        let type: TypeReference
    }
}
