@syntax
construct State<T> {
    let identity: GraphIdentity
    let parent: GraphIdentity?
    let macros: [Macro.Application]
    let identifier: Identifier
    let type: TypeReference
    let value: Expression?

    function initializer(transform: (T) -> T)
    function getter(transform: (T) -> T)
    function setter(transform: (T) -> T)
}
