@language
construct ArrayStorage<Element> {
    derived count: Int
    derived isEmpty: Bool
    function append(element: Element)
    function element(index: Int): Element
    function first(): Element?
    function first(include: (Element) -> Bool): Element?
    function last(): Element?
    function update(element: Element, index: Int)
    function insert(element: Element, index: Int)
    function remove(index: Int): Element
    function removeLast(): Element?
    function clear()
    function filter(include: (Element) -> Bool): ArrayStorage<Element>
    function map<Output>(transform: (Element) -> Output): ArrayStorage<Output>
    function compactMap<Output>(transform: (Element) -> Output?): ArrayStorage<Output>
    function flatMap<Output>(transform: (Element) -> Array<Output>): ArrayStorage<Output>
    function forEach(body: (Element) -> Void)
}
