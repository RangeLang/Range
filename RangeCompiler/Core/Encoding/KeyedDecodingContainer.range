construct KeyedDecodingContainer {
    function decode(type: Bool.Type, key: String): Result<Bool, DecodingError>
    function decode(type: Date.Type, key: String): Result<Date, DecodingError>
    function decode(type: DateTime.Type, key: String): Result<DateTime, DecodingError>
    function decode(type: Float.Type, key: String): Result<Float, DecodingError>
    function decode(type: Int.Type, key: String): Result<Int, DecodingError>
    function decode(type: String.Type, key: String): Result<String, DecodingError>
    function decode(type: UUID.Type, key: String): Result<UUID, DecodingError>
    function decode<T>(type: T.Type, key: String): Result<T, DecodingError>
}
