construct SingleValueDecodingContainer {
    function decode(type: Bool.Type): Result<Bool, DecodingError>
    function decode(type: Date.Type): Result<Date, DecodingError>
    function decode(type: DateTime.Type): Result<DateTime, DecodingError>
    function decode(type: Float.Type): Result<Float, DecodingError>
    function decode(type: Int.Type): Result<Int, DecodingError>
    function decode(type: String.Type): Result<String, DecodingError>
    function decode(type: UUID.Type): Result<UUID, DecodingError>
}
