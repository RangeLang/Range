construct JSONSingleValueDecodingContainer {
    let value: JSONValue

    function decode(_ type: Bool.Type): Result<Bool, DecodingError> {
        switch value {
        case .bool(let decoded):
            return .success(result: decoded)
        case .int(let decoded):
            return .success(result: decoded != 0)
        case .string(let decoded):
            if decoded == "true" {
                return .success(result: true)
            }

            if decoded == "false" {
                return .success(result: false)
            }

            return .failure(cause: .failed)
        case .array, .float, .null, .object:
            return .failure(cause: .failed)
        }
    }

    function decode(_ type: Date.Type): Result<Date, DecodingError> {
        switch value {
        case .string(let decoded):
            return Date.parse(iso8601String: decoded)
        case .array, .bool, .float, .int, .null, .object:
            return .failure(cause: .failed)
        }
    }

    function decode(_ type: DateTime.Type): Result<DateTime, DecodingError> {
        switch value {
        case .string(let decoded):
            return DateTime.parse(iso8601String: decoded)
        case .array, .bool, .float, .int, .null, .object:
            return .failure(cause: .failed)
        }
    }

    function decode(_ type: Float.Type): Result<Float, DecodingError> {
        switch value {
        case .float(let decoded):
            return .success(result: decoded)
        case .array, .bool, .int, .null, .object, .string:
            return .failure(cause: .failed)
        }
    }

    function decode(_ type: Int.Type): Result<Int, DecodingError> {
        switch value {
        case .int(let decoded):
            return .success(result: decoded)
        case .array, .bool, .float, .null, .object, .string:
            return .failure(cause: .failed)
        }
    }

    function decode(_ type: String.Type): Result<String, DecodingError> {
        switch value {
        case .string(let decoded):
            return .success(result: decoded)
        case .array, .bool, .float, .int, .null, .object:
            return .failure(cause: .failed)
        }
    }

    function decode(_ type: UUID.Type): Result<UUID, DecodingError> {
        switch value {
        case .string(let decoded):
            return UUID.parse(uuidString: decoded)
        case .array, .bool, .float, .int, .null, .object:
            return .failure(cause: .failed)
        }
    }
}
