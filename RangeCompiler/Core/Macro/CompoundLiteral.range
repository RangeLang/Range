open marker CompoundLiteral<let value: TypeReference, let delimiter: String?>(@capture _ pattern: Expression): Construct { target, diagnostics in
    let source: String(pattern.written.text)
    state index: Int(0)
    state delimiterCount: Int(0)
    state previousWasDelimiter: Bool(false)

    if delimiter == nil {
        diagnostics.error("#CompoundLiteral delimiter is required.")
    }

    if source.count == 0 {
        diagnostics.error("#CompoundLiteral pattern must use dot-delimited slots.")
    }

    while index < source.count {
        let character: String(source.character(index: index))
        state isDelimiter: Bool(true)

        if character != delimiter {
            set isDelimiter   false
        }

        if isDelimiter {
            delimiterCount += 1

            if index == 0 {
                diagnostics.error("#CompoundLiteral pattern must not start with '.'.")
            }

            if previousWasDelimiter {
                diagnostics.error("#CompoundLiteral pattern must contain non-empty dot-delimited slots.")
            }
        }

        set previousWasDelimiter   isDelimiter
        index += 1
    }

    if delimiterCount == 0 {
        diagnostics.error("#CompoundLiteral pattern must contain at least one dot delimiter.")
    }

    if previousWasDelimiter {
        diagnostics.error("#CompoundLiteral pattern must not end with delimiter.")
    }

    let fields: Array<State>(target.declaration.states)
    let slotCount: Int(delimiterCount + 1)

    if fields.count != slotCount {
        diagnostics.error("#CompoundLiteral pattern slot count must match the construct's stored state count.")
    }

    state fieldIndex: Int(0)
    while fieldIndex < fields.count {
        let field: State(fields.element(index: fieldIndex))

        if field.type != value {
            diagnostics.error("#CompoundLiteral stored state type must match the literal value type.")
        }

        fieldIndex += 1
    }
}
