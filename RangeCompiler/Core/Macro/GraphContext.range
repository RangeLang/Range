construct GraphContext {
    let macros: [Macro.Application<Void>]

    function declaration(identity: GraphIdentity): GraphEntry
    function parent(identity: GraphIdentity): GraphIdentity?
    function members(identity: GraphIdentity): [GraphIdentity]
    function sourcePath(identity: GraphIdentity): String
    function sourceDirectory(identity: GraphIdentity): String
    function macros(identity: GraphIdentity): [Macro.Application<Void>]
    function macros(named: String): [Macro.Application<Void>]
}
