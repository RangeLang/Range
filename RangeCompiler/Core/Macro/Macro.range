@syntax {
    #self.keyword #self.identifier.lowercased <#self.generics>(#self.properties)#(: #self.conformances)? { #self.target, #self.diagnostics, #self.graph
        #self.body
    }
}
@graph(.declaration)
construct Macro {
    let keyword: Keyword("macro")
    let identifier: Identifier
    let conformances: [@type]
    let parameters: [@parameter]

    let target: @syntax?
    let diagnostics: [Diagnostic]
    let graph: @graph
    let body: @syntax
}

@syntax(.plural) {
    #(@prefix(@))?
    #target
}
@graph(.declaration)
construct Macro {

    let identifier: Identifier(prefix: @)
    let genericArguments: [TypeReference]
    let argumentClause: String
    let arguments: [Expression]
    let declaration: Declaration?
    let packageVisibility: String
    let valueType: TypeReference
    let value: Value
}
