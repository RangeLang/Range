@language
construct Rect {
    let x: Float
    let y: Float
    let width: Float
    let height: Float

    derived size: Size {
        return Size(width: self.width, height: self.height)
    }

    function inset(by insets: EdgeInsets): Rect {
        return Rect(
            x: self.x + insets.leading,
            y: self.y + insets.top,
            width: Math.max(lhs: 0.0, rhs: self.width - insets.horizontal),
            height: Math.max(lhs: 0.0, rhs: self.height - insets.vertical)
        )
    }
}
