construct Math {
    function abs(value: Int): Int {
        if value < 0 {
            return 0 - value
        }

        return value
    }

    function abs(value: Float): Float {
        if value < 0.0 {
            return 0.0 - value
        }

        return value
    }

    function min<T>(lhs: T, rhs: T): T {
        if lhs < rhs {
            return lhs
        }

        return rhs
    }

    function max<T>(lhs: T, rhs: T): T {
        if lhs < rhs {
            return rhs
        }

        return lhs
    }

    function clamp<T>(value: T, lower: T, upper: T): T {
        return Math.min(lhs: Math.max(lhs: value, rhs: lower), rhs: upper)
    }
}
