@language
construct Padding: Layout {
    let insets: EdgeInsets
    let child: Layout

    function measure(_ proposal: SizeProposal): Size {
        return LayoutMetrics.outset(
            size: self.child.measure(proposal.inset(by: self.insets)),
            by: self.insets
        )
    }

    function childBounds(in bounds: Rect): Rect {
        return bounds.inset(by: self.insets)
    }

    function place(in bounds: Rect): LayoutPlacement {
        return LayoutPlacement(bounds: bounds, children: [self.child.place(in: self.childBounds(in: bounds))])
    }
}
