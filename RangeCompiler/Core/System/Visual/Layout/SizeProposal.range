@language
construct SizeProposal {
    let width: Float
    let height: Float

    function inset(by insets: EdgeInsets): SizeProposal {
        return SizeProposal(
            width: Math.max(lhs: 0.0, rhs: self.width - insets.horizontal),
            height: Math.max(lhs: 0.0, rhs: self.height - insets.vertical)
        )
    }
}
