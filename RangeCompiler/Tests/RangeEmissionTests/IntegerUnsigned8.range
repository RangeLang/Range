@builtin(.write)
function rawBufferAppendUnsigned8(buffer: RawBuffer, value: Int<8, .unsigned>): Int

@builtin(.read)
function rawBufferLoadUnsigned8(buffer: RawBuffer, index: Int): Int<8, .unsigned>

@builtin(.write)
function rawBufferStoreUnsigned8(buffer: RawBuffer, index: Int, value: Int<8, .unsigned>): Int

@main {
    let buffer: RawBuffer(rawBufferCreate(capacity: 2, stride: 1))
    let maximum: Int<8, .unsigned>(255)
    rawBufferAppendUnsigned8(buffer: buffer, value: maximum)
    let loaded: Int<8, .unsigned>(rawBufferLoadUnsigned8(buffer: buffer, index: 0))
    rawBufferStoreUnsigned8(buffer: buffer, index: 0, value: loaded)
    let result: Bool(loaded == maximum)
    rawBufferDestroy(buffer: buffer)
    return result
}
