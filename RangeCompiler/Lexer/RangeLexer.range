
function rangeLexer(): Lexer {
    return Lexer(
        rules: [
            LexerRule(name: "whitespace", pattern: "whitespace+", token: "skip", priority: 0),
            LexerRule(name: "leftBrace", pattern: "{", token: "leftBrace", priority: 20),
            LexerRule(name: "rightBrace", pattern: "}", token: "rightBrace", priority: 20),
            LexerRule(name: "leftParen", pattern: "(", token: "leftParen", priority: 20),
            LexerRule(name: "rightParen", pattern: ")", token: "rightParen", priority: 20),
            LexerRule(name: "leftBracket", pattern: "[", token: "leftBracket", priority: 20),
            LexerRule(name: "rightBracket", pattern: "]", token: "rightBracket", priority: 20),
            LexerRule(name: "ellipsis", pattern: "...", token: "ellipsis", priority: 30),
            LexerRule(name: "dot", pattern: ".", token: "dot", priority: 20),
            LexerRule(name: "arrow", pattern: "->", token: "arrow", priority: 30),
            LexerRule(name: "minus", pattern: "-", token: "minus", priority: 20),
            LexerRule(name: "bangEqual", pattern: "!=", token: "bangEqual", priority: 30),
            LexerRule(name: "bang", pattern: "!", token: "bang", priority: 20),
            LexerRule(name: "equalEqual", pattern: "==", token: "equalEqual", priority: 30),
            LexerRule(name: "equal", pattern: "=", token: "equal", priority: 20),
            LexerRule(name: "lessEqual", pattern: "<=", token: "lessEqual", priority: 30),
            LexerRule(name: "less", pattern: "<", token: "less", priority: 20),
            LexerRule(name: "greaterEqual", pattern: ">=", token: "greaterEqual", priority: 30),
            LexerRule(name: "greater", pattern: ">", token: "greater", priority: 20),
            LexerRule(name: "plusEqual", pattern: "+=", token: "plusEqual", priority: 30),
            LexerRule(name: "plus", pattern: "+", token: "plus", priority: 20),
            LexerRule(name: "questionQuestion", pattern: "??", token: "questionQuestion", priority: 30),
            LexerRule(name: "question", pattern: "?", token: "question", priority: 20),
            LexerRule(name: "andAnd", pattern: "&&", token: "andAnd", priority: 30),
            LexerRule(name: "orOr", pattern: "||", token: "orOr", priority: 30),
            LexerRule(name: "asterisk", pattern: "*", token: "asterisk", priority: 20),
            LexerRule(name: "colon", pattern: ":", token: "colon", priority: 20),
            LexerRule(name: "comma", pattern: ",", token: "comma", priority: 20),
            LexerRule(name: "slash", pattern: "/", token: "slash", priority: 20),
            LexerRule(name: "ampersand", pattern: "&", token: "ampersand", priority: 20),
            LexerRule(name: "dollar", pattern: "$", token: "dollar", priority: 20),
            LexerRule(name: "percent", pattern: "%", token: "percent", priority: 20),
            LexerRule(name: "pipe", pattern: "|", token: "pipe", priority: 20),
            LexerRule(name: "stringLiteral", pattern: "quotedString", token: "stringLiteral", priority: 40),
            LexerRule(name: "hashAttribute", pattern: "@identifier", token: "hashAttribute", priority: 40),
            LexerRule(name: "hash", pattern: "#(", token: "hash", priority: 50),
            LexerRule(name: "macroAttribute", pattern: "@identifier", token: "macroAttribute", priority: 40),
            LexerRule(name: "escapedIdentifier", pattern: "`identifier`", token: "identifier", priority: 40),
            LexerRule(name: "double", pattern: "digits.digits", token: "double", priority: 40),
            LexerRule(name: "integer", pattern: "digits", token: "integer", priority: 30),
            LexerRule(name: "keyword", pattern: "keywordIdentifier", token: "keyword", priority: 40),
            LexerRule(name: "identifier", pattern: "identifier", token: "identifier", priority: 30),
            LexerRule(name: "eof", pattern: "end", token: "eof", priority: 0)
        ]
    )
}
