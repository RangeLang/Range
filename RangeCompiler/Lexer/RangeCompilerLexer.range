construct RangeCompilerLexing {
    function lexer(): Lexer {
        return rangeLexer()
    }

    function tokenize(source: String): Result<[LexicalToken], LexingError> {
        let lexer: Lexer(rangeLexer())
        return lexer.tokenize(source: source)
    }

    function tokenizeFile(path: String): Result<[LexicalToken], LexingError> {
        switch FileManager.readFile(path: path) {
        case .success(let source):
            return tokenize(source: source)
        case .failure:
            return .failure(cause: fileReadFailure())
        }

        return .failure(cause: fileReadFailure())
    }

    function fileReadFailure(): LexingError {
        return LexingError(
            message: "Failed to read Range compiler source file.",
            range: SourceRange(
                start: SourceLocation(line: 0, character: 0),
                end: SourceLocation(line: 0, character: 0)
            )
        )
    }
}
