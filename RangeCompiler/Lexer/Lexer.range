@syntax
construct Lexer {
    let rules: [LexerRule]
    binding tokens: Array<@lexer>

    function tokenize(source: String): Result<[LexicalToken], LexingError> {
        state cursor: LexerCursor(source: source, foreignBodies: [], rules: rules)
        return cursor.tokenize()
    }

    function tokenize(
        source: String,
        foreignBodies: [LexerForeignBody]
    ): Result<[LexicalToken], LexingError> {
        state cursor: LexerCursor(source: source, foreignBodies: foreignBodies, rules: rules)
        return cursor.tokenize()
    }
}

@syntax
construct LexerForeignBody {
    let directive: String
    let language: String
}

@syntax
construct LexingError {
    let message: String
    let range: SourceRange
}

construct LexerPosition {
    let index: Int
    let location: SourceLocation
}

construct LexerCursor {
    let source: String
    let foreignBodies: [LexerForeignBody]
    let rules: [LexerRule]
    state index: Int(0)
    state line: Int(0)
    state column: Int(0)
    state tokens: [LexicalToken]([])

    function tokenize(): Result<[LexicalToken], LexingError> {
        while !isAtEnd() {
            if isWhitespace(currentCharacter()) {
                advance()
                continue
            }

            let start: currentPosition()
            let character: currentCharacter()

            if matchLexerRuleLiteral(start: start) {
                continue
            } else if character == "\"" {
                switch readString(start: start) {
                case .success(let value):
                    emit(kind: .stringLiteral(value: value), start: start)
                case .failure(let error):
                    return .failure(cause: error)
                }
            } else if character == "#" {
                if hasCharacter(offset: 1, value: "(") {
                    advance()
                    emit(kind: .hash, start: start)
                } else if hasHexDigit(offset: 1) {
                    switch readHexColorLiteral(start: start) {
                    case .success(let value):
                        emit(kind: .colorLiteral(value: value), start: start)
                    case .failure(let error):
                        return .failure(cause: error)
                    }
                } else {
                    advance()
                    emit(kind: .hash, start: start)
                }
            } else if character == "@" {
                switch readSigilIdentifier(start: start) {
                case .success(let identifier):
                    emit(kind: .macroAttribute(name: identifier, argument: nil), start: start)
                    let language: String(foreignBodyLanguage(directive: identifier))
                    if language != "" {
                        skipWhitespace()
                        if !isAtEnd() && currentCharacter() == "{" {
                            let braceStart: currentPosition()
                            advance()
                            emit(kind: .leftBrace, start: braceStart)

                            let bodyStart: currentPosition()
                            switch readForeignBodyBlock(language: language, start: bodyStart) {
                            case .success(let body):
                                emit(kind: .foreignBody(language: language, text: body), start: bodyStart)
                            case .failure(let error):
                                return .failure(cause: error)
                            }

                            let closeStart: currentPosition()
                            if !match("}") {
                                return failure(
                                    message: "Unterminated @\(identifier) \(language) block.",
                                    start: start
                                )
                            }
                            emit(kind: .rightBrace, start: closeStart)
                        }
                    }
                case .failure(let error):
                    return .failure(cause: error)
                }
            } else if character == "`" {
                switch readEscapedIdentifier(start: start) {
                case .success(let identifier):
                    emit(kind: .identifier(value: identifier), start: start)
                case .failure(let error):
                    return .failure(cause: error)
                }
            } else if isDigit(character) {
                let token: readNumberLiteral(start: start)
                emit(kind: token, start: start)
            } else if isIdentifierStart(character) {
                let identifier: readIdentifier()
                if isKeyword(identifier) {
                    emit(kind: .keyword(value: identifier), start: start)
                } else {
                    emit(kind: .identifier(value: identifier), start: start)
                }
            } else {
                return failure(message: "Unexpected character \(character).", start: start)
            }
        }

        let eof: currentPosition()
        emit(kind: .eof, start: eof)
        return .success(result: tokens)
    }

    function matchLexerRuleLiteral(start: LexerPosition): Bool {
        state ruleIndex: 0
        while ruleIndex < rules.count {
            let rule: LexerRule(rules.element(index: ruleIndex))
            if isLiteralLexerRule(rule) && hasPrefix(rule.pattern) {
                advancePattern(rule.pattern)
                return emitRuleToken(token: rule.token, start: start)
            }
            ruleIndex += 1
        }
        return false
    }

    function isLiteralLexerRule(_ rule: LexerRule): Bool {
        return isLiteralLexerToken(rule.token)
    }

    function isLiteralLexerToken(_ token: String): Bool {
        return token == "leftBrace"
            || token == "rightBrace"
            || token == "leftParen"
            || token == "rightParen"
            || token == "leftBracket"
            || token == "rightBracket"
            || token == "asterisk"
            || token == "dot"
            || token == "ellipsis"
            || token == "colon"
            || token == "arrow"
            || token == "bang"
            || token == "equal"
            || token == "equalEqual"
            || token == "bangEqual"
            || token == "minus"
            || token == "less"
            || token == "lessEqual"
            || token == "greater"
            || token == "greaterEqual"
            || token == "plus"
            || token == "plusEqual"
            || token == "slash"
            || token == "ampersand"
            || token == "andAnd"
            || token == "pipe"
            || token == "orOr"
            || token == "question"
            || token == "questionQuestion"
            || token == "dollar"
            || token == "percent"
            || token == "comma"
    }

    function emitRuleToken(token: String, start: LexerPosition): Bool {
        if token == "leftBrace" {
            emit(kind: .leftBrace, start: start)
        } else if token == "rightBrace" {
            emit(kind: .rightBrace, start: start)
        } else if token == "leftParen" {
            emit(kind: .leftParen, start: start)
        } else if token == "rightParen" {
            emit(kind: .rightParen, start: start)
        } else if token == "leftBracket" {
            emit(kind: .leftBracket, start: start)
        } else if token == "rightBracket" {
            emit(kind: .rightBracket, start: start)
        } else if token == "asterisk" {
            emit(kind: .asterisk, start: start)
        } else if token == "dot" {
            emit(kind: .dot, start: start)
        } else if token == "ellipsis" {
            emit(kind: .ellipsis, start: start)
        } else if token == "colon" {
            emit(kind: .colon, start: start)
        } else if token == "arrow" {
            emit(kind: .arrow, start: start)
        } else if token == "bang" {
            emit(kind: .bang, start: start)
        } else if token == "equal" {
            emit(kind: .equal, start: start)
        } else if token == "equalEqual" {
            emit(kind: .equalEqual, start: start)
        } else if token == "bangEqual" {
            emit(kind: .bangEqual, start: start)
        } else if token == "minus" {
            emit(kind: .minus, start: start)
        } else if token == "less" {
            emit(kind: .less, start: start)
        } else if token == "lessEqual" {
            emit(kind: .lessEqual, start: start)
        } else if token == "greater" {
            emit(kind: .greater, start: start)
        } else if token == "greaterEqual" {
            emit(kind: .greaterEqual, start: start)
        } else if token == "plus" {
            emit(kind: .plus, start: start)
        } else if token == "plusEqual" {
            emit(kind: .plusEqual, start: start)
        } else if token == "slash" {
            emit(kind: .slash, start: start)
        } else if token == "ampersand" {
            emit(kind: .ampersand, start: start)
        } else if token == "andAnd" {
            emit(kind: .andAnd, start: start)
        } else if token == "pipe" {
            emit(kind: .pipe, start: start)
        } else if token == "orOr" {
            emit(kind: .orOr, start: start)
        } else if token == "question" {
            emit(kind: .question, start: start)
        } else if token == "questionQuestion" {
            emit(kind: .questionQuestion, start: start)
        } else if token == "dollar" {
            emit(kind: .dollar, start: start)
        } else if token == "percent" {
            emit(kind: .percent, start: start)
        } else if token == "comma" {
            emit(kind: .comma, start: start)
        } else {
            return false
        }
        return true
    }

    function hasPrefix(_ pattern: String): Bool {
        if index + pattern.count > source.count {
            return false
        }
        let value: String(source.substring(start: index, end: index + pattern.count))
        return value == pattern
    }

    function advancePattern(_ pattern: String) {
        state remaining: pattern.count
        while remaining > 0 {
            advance()
            set remaining   remaining - 1
        }
    }

    function isAtEnd(): Bool {
        return index >= source.count
    }

    function currentCharacter(): String {
        let value: String(source.character(index: index))
        return value
    }

    function hasCharacter(offset: Int, value: String): Bool {
        let position: index + offset
        if position >= source.count {
            return false
        }
        let current: String(source.character(index: position))
        return current == value
    }

    function advance(): String {
        let value: currentCharacter()
        index += 1
        if value == "\n" {
            line += 1
            set column   0
        } else {
            column += 1
        }
        return value
    }

    function currentLocation(): SourceLocation {
        return SourceLocation(line: line, character: column)
    }

    function currentPosition(): LexerPosition {
        return LexerPosition(index: index, location: currentLocation())
    }

    function range(from start: LexerPosition): SourceRange {
        return SourceRange(start: start.location, end: currentLocation())
    }

    function sourceSlice(from start: LexerPosition): String {
        let value: String(source.substring(start: start.index, end: index))
        return value
    }

    function emit(kind: TokenKind, start: LexerPosition) {
        tokens.append(
            element: LexicalToken(
                kind: kind,
                range: range(from: start),
                source: sourceSlice(from: start)
            )
        )
    }

    function failure(message: String, start: LexerPosition): Result<[LexicalToken], LexingError> {
        return .failure(cause: LexingError(message: message, range: range(from: start)))
    }

    function lexicalFailure(message: String, start: LexerPosition): LexingError {
        return LexingError(message: message, range: range(from: start))
    }

    function match(_ expected: String): Bool {
        if isAtEnd() || currentCharacter() != expected {
            return false
        }
        advance()
        return true
    }

    function skipWhitespace() {
        while !isAtEnd() && isWhitespace(currentCharacter()) {
            advance()
        }
    }

    function readIdentifier(): String {
        let start: index
        while !isAtEnd() && isIdentifierPart(currentCharacter()) {
            advance()
        }
        let identifier: String(source.substring(start: start, end: index))
        return identifier
    }

    function readEscapedIdentifier(start: LexerPosition): Result<String, LexingError> {
        advance()
        if isAtEnd() || !isIdentifierStart(currentCharacter()) {
            return .failure(cause: lexicalFailure(message: "Expected identifier after `.", start: start))
        }

        let identifier: readIdentifier()

        if !match("`") {
            return .failure(cause: lexicalFailure(message: "Unterminated escaped identifier.", start: start))
        }

        return .success(result: identifier)
    }

    function readSigilIdentifier(start: LexerPosition): Result<String, LexingError> {
        advance()
        if isAtEnd() {
            return .failure(cause: lexicalFailure(message: "Expected identifier after @.", start: start))
        }

        if currentCharacter() == "`" {
            return readEscapedIdentifier(start: start)
        }

        if !isASCIILetter(currentCharacter()) {
            return .failure(cause: lexicalFailure(message: "Expected identifier after @.", start: start))
        }

        return .success(result: readIdentifier())
    }

    function readHexColorLiteral(start: LexerPosition): Result<String, LexingError> {
        advance()
        state digits: ""
        while !isAtEnd() && isIdentifierPart(currentCharacter()) {
            digits += advance()
        }

        if digits.count != 6 || !isHexDigits(digits) {
            return .failure(
                cause: lexicalFailure(
                    message: "Invalid hex color literal '#\(digits)'. Expected 6 hexadecimal digits.",
                    start: start
                )
            )
        }

        return .success(result: digits)
    }

    function readNumberLiteral(start: LexerPosition): TokenKind {
        while !isAtEnd() && isDigit(currentCharacter()) {
            advance()
        }

        if isAtEnd() || currentCharacter() != "." || !hasDigit(offset: 1) {
            let integerLiteral: String(source.substring(start: start.index, end: index))
            return .integer(value: integerLiteral)
        }

        advance()
        while !isAtEnd() && isDigit(currentCharacter()) {
            advance()
        }

        let raw: String(source.substring(start: start.index, end: index))

        if !isAtEnd() && currentCharacter() == "." && hasDigit(offset: 1) {
            advance()
            while !isAtEnd() && isDigit(currentCharacter()) {
                advance()
            }
            let versionLiteral: String(source.substring(start: start.index, end: index))
            return .stringLiteral(value: versionLiteral)
        }

        return .double(value: raw)
    }

    function readString(start: LexerPosition): Result<String, LexingError> {
        advance()
        state result: ""
        state interpolationDepth: 0

        while !isAtEnd() {
            let character: currentCharacter()

            if character == "\"" && interpolationDepth == 0 {
                advance()
                return .success(result: result)
            }

            if character == "\\" {
                advance()
                if isAtEnd() {
                    return .failure(
                        cause: lexicalFailure(
                            message: "Unterminated escape sequence in string literal.",
                            start: start
                        )
                    )
                }
                let escaped: advance()
                set result   result + "\\" + escaped
                if escaped == "(" {
                    interpolationDepth += 1
                }
                continue
            }

            if interpolationDepth > 0 {
                if character == "\"" {
                    switch readInterpolatedStringLiteral(start: start) {
                    case .success(let value):
                        set result   result + value
                    case .failure(let error):
                        return .failure(cause: error)
                    }
                    continue
                }

                if character == "(" {
                    interpolationDepth += 1
                } else if character == ")" {
                    set interpolationDepth   interpolationDepth - 1
                }
            }

            set result   result + character
            advance()
        }

        return .failure(cause: lexicalFailure(message: "Unterminated string literal.", start: start))
    }

    function readInterpolatedStringLiteral(start: LexerPosition): Result<String, LexingError> {
        state result: "\""
        advance()

        while !isAtEnd() {
            let character: currentCharacter()
            set result   result + character
            advance()

            if character == "\\" {
                if isAtEnd() {
                    return .failure(
                        cause: lexicalFailure(
                            message: "Unterminated escape sequence in string literal.",
                            start: start
                        )
                    )
                }
                let escaped: advance()
                set result   result + escaped
                continue
            }

            if character == "\"" {
                return .success(result: result)
            }
        }

        return .failure(
            cause: lexicalFailure(message: "Unterminated string literal inside interpolation.", start: start)
        )
    }

    function readForeignBodyBlock(
        language: String,
        start: LexerPosition
    ): Result<String, LexingError> {
        state result: ""

        if !isAtEnd() && currentCharacter() == "\n" {
            advance()
        }

        while !isAtEnd() {
            if currentCharacter() == "}" && isOnlyWhitespaceBeforeCurrentPositionOnLine() {
                return .success(result: trimNewlines(result))
            }

            set result   result + currentCharacter()
            advance()
        }

        return .failure(cause: lexicalFailure(message: "Unterminated \(language) block.", start: start))
    }

    function isOnlyWhitespaceBeforeCurrentPositionOnLine(): Bool {
        state position: index - 1
        while position >= 0 {
            let character: String(source.character(index: position))
            if character == "\n" {
                return true
            }
            if !isWhitespace(character) {
                return false
            }
            set position   position - 1
        }
        return true
    }

    function trimNewlines(_ text: String): String {
        state start: 0
        state end: text.count

        while start < end && isNewlineAt(text: text, index: start) {
            start += 1
        }

        while end > start && isNewlineAt(text: text, index: end - 1) {
            set end   end - 1
        }

        return text.substring(start: start, end: end)
    }

    function foreignBodyLanguage(directive: String): String {
        state bodyIndex: 0
        while bodyIndex < foreignBodies.count {
            let body: LexerForeignBody(foreignBodies.element(index: bodyIndex))
            if body.directive == directive {
                return body.language
            }
            bodyIndex += 1
        }
        return ""
    }

    function hasDigit(offset: Int): Bool {
        let position: index + offset
        if position >= source.count {
            return false
        }
        let value: String(source.character(index: position))
        return isDigit(value)
    }

    function hasHexDigit(offset: Int): Bool {
        let position: index + offset
        if position >= source.count {
            return false
        }
        let value: String(source.character(index: position))
        return isHexDigit(value)
    }

    function isWhitespace(_ value: String): Bool {
        return value == " " || value == "\n" || value == "\r" || value == "\t"
    }

    function isNewline(_ value: String): Bool {
        return value == "\n" || value == "\r"
    }

    function isNewlineAt(text: String, index: Int): Bool {
        let value: String(text.character(index: index))
        return isNewline(value)
    }

    function isDigit(_ value: String): Bool {
        return value >= "0" && value <= "9"
    }

    function isHexDigit(_ value: String): Bool {
        return isDigit(value) || value >= "a" && value <= "f" || value >= "A" && value <= "F"
    }

    function isHexDigits(_ value: String): Bool {
        state position: 0
        while position < value.count {
            let character: String(value.character(index: position))
            if !isHexDigit(character) {
                return false
            }
            position += 1
        }
        return true
    }

    function isASCIILetter(_ value: String): Bool {
        return value >= "a" && value <= "z" || value >= "A" && value <= "Z"
    }

    function isIdentifierStart(_ value: String): Bool {
        return isASCIILetter(value) || value == "_"
    }

    function isIdentifierPart(_ value: String): Bool {
        return isIdentifierStart(value) || isDigit(value)
    }

    function isKeyword(_ value: String): Bool {
        return value == "let"
            || value == "state"
            || value == "binding"
            || value == "derived"
            || value == "extension"
            || value == "for"
            || value == "in"
            || value == "case"
            || value == "if"
            || value == "else"
            || value == "while"
            || value == "return"
            || value == "break"
            || value == "continue"
            || value == "switch"
            || value == "default"
            || value == "enum"
                        || value == "construct"
            || value == "macro"
            || value == "open"
            || value == "closed"
            || value == "function"
            || value == "get"
            || value == "set"
            || value == "precedencegroup"
            || value == "infix"
            || value == "prefix"
            || value == "postfix"
            || value == "operator"
    }
}
