construct JSONUnkeyedDecodingContainer {
    @let values: Array<JSONValue>
    state index: Int(0)

    function isAtEnd(): Bool {
        return index >= values.count
    }

    function decode(type: Bool.Type): Result<Bool, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Bool.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: Date.Type): Result<Date, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Date.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: DateTime.Type): Result<DateTime, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(DateTime.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: Float.Type): Result<Float, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Float.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: Int.Type): Result<Int, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Int.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: String.Type): Result<String, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(String.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: UUID.Type): Result<UUID, DecodingError> {
        switch nextValue() {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(UUID.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode<T>(type: T.Type): Result<T, DecodingError> {
        return .failure(cause: .failed)
    }

    function nextValue(): Result<JSONValue, DecodingError> {
        if index >= self.values.count {
            return .failure(cause: .failed)
        }

        state index: index + 1
        return .success(result: self.values.element(index: index - 1))
    }
}
