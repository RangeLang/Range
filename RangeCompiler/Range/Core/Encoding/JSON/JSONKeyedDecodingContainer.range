construct JSONKeyedDecodingContainer {
    let fields: Array<JSONField>

    function decode(type: Bool.Type, key: String): Result<Bool, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Bool.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: Date.Type, key: String): Result<Date, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Date.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: DateTime.Type, key: String): Result<DateTime, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(DateTime.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: Float.Type, key: String): Result<Float, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Float.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: Int.Type, key: String): Result<Int, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(Int.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: String.Type, key: String): Result<String, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(String.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode(type: UUID.Type, key: String): Result<UUID, DecodingError> {
        switch value(key: key) {
        case .success(let value):
            let container: JSONSingleValueDecodingContainer(value: value)
            return container.decode(UUID.self)
        case .failure(let error):
            return .failure(cause: error)
        }
    }

    function decode<T>(type: T.Type, key: String): Result<T, DecodingError> {
        return .failure(cause: .failed)
    }

    function value(key: String): Result<JSONValue, DecodingError> {
        for field in fields {
            if field.key == key {
                return .success(result: field.value)
            }
        }

        return .failure(cause: .failed)
    }
}
