construct JSONDecoder {
    let value: JSONValue

    function decode(type: Bool.Type, value: JSONValue): Result<Bool, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(Bool.self)
    }

    function decode(type: Float.Type, value: JSONValue): Result<Float, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(Float.self)
    }

    function decode(type: Int.Type, value: JSONValue): Result<Int, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(Int.self)
    }

    function decode(type: String.Type, value: JSONValue): Result<String, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(String.self)
    }

    function keyedContainer(): JSONKeyedDecodingContainer {
        switch value {
        case .object(let fields):
            return JSONKeyedDecodingContainer(fields: fields)
        case .array, .bool, .float, .int, .null, .string:
            return JSONKeyedDecodingContainer(fields: [])
        }
    }

    function singleValueContainer(): JSONSingleValueDecodingContainer {
        return JSONSingleValueDecodingContainer(value: value)
    }

    function unkeyedContainer(): JSONUnkeyedDecodingContainer {
        switch value {
        case .array(let values):
            return JSONUnkeyedDecodingContainer(values: values)
        case .bool, .float, .int, .null, .object, .string:
            return JSONUnkeyedDecodingContainer(values: [])
        }
    }
}
