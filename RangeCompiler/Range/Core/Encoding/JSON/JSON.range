@encoding
construct JSON {
    function encode<T>(value: T): Result<String, EncodingError> {
        state encoder: JSONEncoder()
        return encoder.encode(value)
    }

    function decode(type: Bool.Type, value: JSONValue): Result<Bool, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(Bool.self)
    }

    function decode(type: Float.Type, value: JSONValue): Result<Float, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(Float.self)
    }

    function decode(type: Int.Type, value: JSONValue): Result<Int, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(Int.self)
    }

    function decode(type: String.Type, value: JSONValue): Result<String, DecodingError> {
        let container: JSONSingleValueDecodingContainer(value: value)
        return container.decode(String.self)
    }
}
