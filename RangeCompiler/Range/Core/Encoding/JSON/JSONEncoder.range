construct JSONEncoder {
    state output: String("")
    state isObject: Bool(false)
    state isArray: Bool(false)

    function encode<T>(_ value: T): Result<String, EncodingError> {
        return .failure(cause: .failed)
    }

    function keyedContainer(): JSONKeyedEncodingContainer {
        set isObject   true
        return JSONKeyedEncodingContainer(output: $self.output, isObject: $self.isObject)
    }

    function unkeyedContainer(): JSONUnkeyedEncodingContainer {
        set isArray   true
        return JSONUnkeyedEncodingContainer(output: $self.output, isArray: $self.isArray)
    }

    function singleValueContainer(): JSONSingleValueEncodingContainer {
        return JSONSingleValueEncodingContainer(output: $self.output)
    }
}
