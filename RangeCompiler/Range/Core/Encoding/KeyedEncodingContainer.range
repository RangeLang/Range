construct KeyedEncodingContainer {
    function encode(value: Bool, key: String): Result<Void, EncodingError>
    function encode(value: Data, key: String): Result<Void, EncodingError>
    function encode(value: Date, key: String): Result<Void, EncodingError>
    function encode(value: DateTime, key: String): Result<Void, EncodingError>
    function encode(value: Float, key: String): Result<Void, EncodingError>
    function encode(value: Int, key: String): Result<Void, EncodingError>
    function encode(value: String, key: String): Result<Void, EncodingError>
    function encode(value: UUID, key: String): Result<Void, EncodingError>
    function encode<T>(value: T, key: String): Result<Void, EncodingError>
}
