enum FileReadError {
    case missing
    case unreadable
}

enum FileWriteError {
    case unwritable
}

enum FileSystemEntryKind {
    case file
    case directory
}

construct FileSystemEntry {
    let path: String
    let name: String
    let kind: FileSystemEntryKind
}

construct FileTreeNode {
    let path: String
    let name: String
    let kind: FileSystemEntryKind
    let children: Array<FileTreeNode>
}

construct FileManager {
    function readData(path: String): Result<Data, FileReadError>
    function readFile(path: String): Result<String, FileReadError>
    function writeData(path: String, data: Data): Result<Void, FileWriteError>
    function createFile(path: String, text: String): Result<Void, FileWriteError>
    function createFolder(path: String): Result<Void, FileWriteError>
    function listEntries(path: String): Result<Array<FileSystemEntry>, FileReadError>
}

construct FileTree {
    function sourceFiles(path: String): Array<ProgramSourceFile> {
        let paths: Array<String>(rangeFiles(path: path))
        state files: Array<ProgramSourceFile>([])
        state index: 0

        while index < paths.count {
            let filePath: String(paths.element(index: index))

            switch FileManager.readFile(path: filePath) {
            case .success(let text):
                files.append(element: ProgramSourceFile(path: filePath, text: text))
            case .failure:
                state index: index
            }

            state index: index + 1
        }

        return files
    }

    function rangeFiles(path: String): Array<String> {
        switch read(path: path) {
        case .success(let tree):
            return collectRangeFiles(node: tree)
        case .failure:
            return []
        }
    }

    function collectRangeFiles(node: FileTreeNode): Array<String> {
        state files: Array<String>([])

        switch node.kind {
        case .file:
            if node.name.count >= 6 && node.name.substring(start: node.name.count - 6, end: node.name.count) == ".range" {
                files.append(element: node.path)
            }
        case .directory:
            state index: 0
            while index < node.children.count {
                let childFiles: Array<String>(collectRangeFiles(node: node.children.element(index: index)))
                state childIndex: 0
                while childIndex < childFiles.count {
                    files.append(element: childFiles.element(index: childIndex))
                    state childIndex: childIndex + 1
                }
                state index: index + 1
            }
        }

        return files
    }

    function read(path: String): Result<FileTreeNode, FileReadError> {
        switch FileManager.listEntries(path: path) {
        case .success(let entries):
            state children: Array<FileTreeNode>([])
            state index: 0

            while index < entries.count {
                let entry: FileSystemEntry(entries.element(index: index))

                if !entry.name.isEmpty && entry.name.character(index: 0) == "." {
                    state index: index + 1
                    continue
                }

                switch entry.kind {
                case .directory:
                    switch read(path: entry.path) {
                    case .success(let child):
                        children.append(element: child)
                    case .failure(let error):
                        return .failure(cause: error)
                    }
                case .file:
                    children.append(
                        element: FileTreeNode(
                            path: entry.path,
                            name: entry.name,
                            kind: entry.kind,
                            children: []
                        )
                    )
                }

                state index: index + 1
            }

            return .success(
                result: FileTreeNode(
                    path: path,
                    name: path,
                    kind: .directory,
                    children: children
                )
            )
        case .failure(let error):
            return .failure(cause: error)
        }

        return .failure(cause: .unreadable)
    }
}
