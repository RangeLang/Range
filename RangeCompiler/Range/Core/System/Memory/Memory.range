enum MemoryAccessError {
    case invalid
    case outOfMemory
}

construct MemoryAddress {
    @let raw: Int
}

construct MemoryRegion {
    @let address: MemoryAddress
    @let byteCount: Int
    @let alignment: Int
}

construct POSIXMemory {
    function allocate(byteCount: Int, alignment: Int): Result<MemoryRegion, MemoryAccessError>
    function deallocate(region: MemoryRegion): Result<Void, MemoryAccessError>
    function zero(region: MemoryRegion): Result<Void, MemoryAccessError>
    function fill(region: MemoryRegion, byte: Int<8, .unsigned>): Result<Void, MemoryAccessError>
    function copy(source: MemoryRegion, destination: MemoryRegion): Result<Void, MemoryAccessError>
    function readByte(address: MemoryAddress): Result<Int<8, .unsigned>, MemoryAccessError>
    function writeByte(address: MemoryAddress, byte: Int<8, .unsigned>): Result<Void, MemoryAccessError>
    function pageSize(): Int
}

construct Memory {
    function allocate(byteCount: Int, alignment: Int): Result<MemoryRegion, MemoryAccessError>
    function deallocate(region: MemoryRegion): Result<Void, MemoryAccessError>
    function zero(region: MemoryRegion): Result<Void, MemoryAccessError>
    function fill(region: MemoryRegion, byte: Int<8, .unsigned>): Result<Void, MemoryAccessError>
    function copy(source: MemoryRegion, destination: MemoryRegion): Result<Void, MemoryAccessError>
    function readByte(address: MemoryAddress): Result<Int<8, .unsigned>, MemoryAccessError>
    function writeByte(address: MemoryAddress, byte: Int<8, .unsigned>): Result<Void, MemoryAccessError>
    function pageSize(): Int
}

construct CPU {
    function logicalCoreCount(): Int
    function cacheLineSize(): Int
}
