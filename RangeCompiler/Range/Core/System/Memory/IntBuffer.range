@builtin
construct IntBuffer {}

@builtin
function intBufferCreate(capacity: Int): IntBuffer

@builtin
function intBufferAppend(buffer: IntBuffer, value: Int): Int

@builtin
function intBufferCount(buffer: IntBuffer): Int

@builtin
function intBufferElement(buffer: IntBuffer, index: Int): Int

@builtin
function intBufferSet(buffer: IntBuffer, index: Int, value: Int): Int

@builtin
function intBufferDestroy(buffer: IntBuffer): Int
