enum ThreadError {
    case invalid
    case unavailable
}

construct ThreadHandle {
    let raw: Int
}

construct POSIXThread {
    function spawn(body: () -> Void): Result<ThreadHandle, ThreadError>
    function join(handle: ThreadHandle): Result<Void, ThreadError>
    function detach(handle: ThreadHandle): Result<Void, ThreadError>
    function current(): ThreadHandle
    function yield()
    function sleep(milliseconds: Int)
}

construct Thread {
    function spawn(body: () -> Void): Result<ThreadHandle, ThreadError>
    function join(handle: ThreadHandle): Result<Void, ThreadError>
    function detach(handle: ThreadHandle): Result<Void, ThreadError>
    function current(): ThreadHandle
    function yield()
    function sleep(milliseconds: Int)
}
