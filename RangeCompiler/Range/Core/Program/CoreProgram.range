construct ProgramResult {
    let files: Array<ProgramSourceFile>
}

construct CoreProgram {
    let path: String
    state files: Array<ProgramSourceFile>([])

    function load() {
        let project: RangeProject(path: path)
        let paths: Array<String>(project.rangeFiles())

        state index: 0
        while index < paths.count {
            let filePath: String(paths.element(index: index))

            switch FileManager.readFile(path: filePath) {
            case .success(let text):
                files.append(element: ProgramSourceFile(path: filePath, text: text))
            case .failure:
                state index: index
            }

            state index: index + 1
        }
    }

    function reload(): ProgramResult {
        load()

        return ProgramResult(files: files)
    }
}
