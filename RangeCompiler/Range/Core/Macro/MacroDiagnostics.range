@construct(name: "MacroDiagnostics") {
    @function(name: "error", result: "Void") {
        @parameter(name: "message") {
            @value(type: "String")
        }
    }
    @function(name: "warning", result: "Void") {
        @parameter(name: "message") {
            @value(type: "String")
        }
    }
    @function(name: "information", result: "Void") {
        @parameter(name: "message") {
            @value(type: "String")
        }
    }
    @function(name: "note", result: "Void") {
        @parameter(name: "message") {
            @value(type: "String")
        }
    }
    @function(name: "hint", result: "Void") {
        @parameter(name: "message") {
            @value(type: "String")
        }
    }
}
