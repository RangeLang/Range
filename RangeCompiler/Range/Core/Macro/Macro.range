@syntax
construct Macro {
    construct Target {
        let kind: String
        let name: String
        let type: TypeReference?
        let elements: [Target]
        let written: WrittenSyntax

        function declarationMemberCount(kind: String): Int
        function declarationMemberName(kind: String, index: Int): String
        function declarationMemberTypeMatches(kind: String, index: Int, generic: String): Bool
    }

    @graph(.declaration)
    construct Declaration {
        let name: String
        let identifier: Identifier
        let packageVisibility: String
        let generics: [Generic]
        let parameters: [Parameter.Declaration]
        let target: String
        let targetSyntax: Target?
        let expansionType: TypeReference?
        let writtenBody: WrittenSyntax
        let parsedBody: Parsed<Block>
        let body: String
        let syntaxBody: String
    }

    @graph(.application)
    construct Application<Value> {
        let name: String
        let identifier: Identifier
        let genericArguments: [TypeReference]
        let argumentClause: String
        let arguments: [Expression]
        let rawBody: WrittenSyntax
        let declaration: Declaration?
        let packageVisibility: String
        let valueType: TypeReference
        let value: Value
    }
}
