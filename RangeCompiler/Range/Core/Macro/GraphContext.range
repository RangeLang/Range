construct GraphContext {
    @let macros: Array<Macro<Void>>

    function declaration(identity: GraphIdentity): GraphEntry
    function parent(identity: GraphIdentity): Optional<GraphIdentity>
    function members(identity: GraphIdentity): Array<GraphIdentity>
    function sourcePath(identity: GraphIdentity): String
    function sourceDirectory(identity: GraphIdentity): String
    function macros(identity: GraphIdentity): Array<Macro<Void>>
    function macros(named: String): Array<Macro<Void>>
}
