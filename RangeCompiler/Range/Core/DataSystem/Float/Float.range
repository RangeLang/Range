@language
construct Float<let width: IntLiteral> {
    let storage: FloatStorage

    function literal(literal: FloatLiteral): Self {
        return Self(storage: literal.storage())
    }
}

extension Float {
    function ==(lhs: Self, rhs: Self): Bool
}

extension Float {
    function <(lhs: Self, rhs: Self): Bool
}

extension Float {
    function decode(from decoder: Decoder): Result<Self, DecodingError> {
        let container: decoder.singleValueContainer()
        switch container.decode(Float.self) {
        case .success(let value):
            return .success(result: value)
        case .failure(let error):
            return .failure(cause: error)
        }
    }
}

extension Float {
    function encode(to encoder: Encoder): Result<Void, EncodingError> {
        let container: encoder.singleValueContainer()
        return container.encode(self)
    }
}

extension Float {
    function hash(into hasher: Hasher) {
        hasher.combineStorage(storage)
    }
}
