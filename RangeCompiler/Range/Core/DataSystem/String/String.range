@init<Expression, wrapper: "\"">
construct String {
    let storage: StringStorage

    function literal(literal: StringLiteral): Self {
        return Self(storage: literal.storage())
    }

    derived count: Int {
        storage.count
    }

    derived byteCount: Int {
        storage.byteCount
    }

    derived isEmpty: Bool {
        storage.isEmpty
    }

    function character(index: Int): String {
        return storage.character(index: index)
    }

    function substring(start: Int, end: Int): String {
        return storage.substring(start: start, end: end)
    }

    function replacingOccurrences(of: String, with: String): String {
        return storage.replacingOccurrences(of: of, with: with)
    }

    function snakeCase(): String {
        return storage.snakeCase()
    }
}

extension String {
    function +(lhs: Self, rhs: Self): Self
}

extension String {
    function ==(lhs: Self, rhs: Self): Bool
}

extension String {
    function <(lhs: Self, rhs: Self): Bool
}

extension String {
    function decode(decoder: Decoder): Result<Self, DecodingError> {
        let container: decoder.singleValueContainer()
        switch container.decode(String.self) {
        case .success(let value):
            return .success(result: value)
        case .failure(let error):
            return .failure(cause: error)
        }
    }
}

extension String {
    function encode(encoder: Encoder): Result<Void, EncodingError> {
        let container: encoder.singleValueContainer()
        return container.encode(self)
    }
}

extension String {
    function hash(hasher: Hasher) {
        hasher.combineStorage(storage)
    }
}
