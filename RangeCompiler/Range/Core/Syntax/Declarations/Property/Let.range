@syntax
@property
@member
@graph(role: .declaration)
@construct(name: "Let<T>") {
  @let(name: "identity") {
      @value(type: "GraphIdentity")
  }
  @let(name: "parent") {
      @value(type: "Optional<GraphIdentity>")
  }
  @let(name: "macros") {
      @value(type: "Array<Macro>")
  }
  @let(name: "identifier") {
      @value(type: "Identifier")
  }
  @let(name: "type") {
      @value(type: "TypeReference")
  }
  @let(name: "value") {
      @value(type: "Optional<Expression>")
  }

  @function(name: "initializer", result: "Void", body: "")
  @function(name: "getter", result: "Void", body: "")
}
