@syntax
@property
@member
@graph(role: .declaration)
@construct(name: "Binding") {
    @generic(name: "T")
    @let(name: "identity") {
        @value(type: "GraphIdentity")
    }
    @let(name: "parent") {
        @value(type: "Optional") {
            @generic(name: "GraphIdentity")
        }
    }
    @let(name: "macros") {
        @value(type: "Array") {
            @generic(name: "Macro")
        }
    }
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "type") {
        @value(type: "TypeReference")
    }
    @let(name: "getterBody") {
        @value(type: "Optional") {
            @generic(name: "Block")
        }
    }
    @let(name: "setterBody") {
        @value(type: "Optional") {
            @generic(name: "Block")
        }
    }

    @function(name: "getter", result: "Void", body: "")
    @function(name: "setter", result: "Void", body: "")
}
