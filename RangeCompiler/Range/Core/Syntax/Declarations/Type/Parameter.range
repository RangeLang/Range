@graph(role: .declaration)
@syntax
@construct(name: "Parameter") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "macros") {
        @value(type: "Array<@macro>")
    }
    @let(name: "syntax") {
        @value(type: "WrittenSyntax")
    }
}

@graph(role: .application)
@syntax
@construct(name: "Parameter") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "type") {
        @value(type: "TypeReference")
    }
    @let(name: "syntax") {
        @value(type: "WrittenSyntax")
    }
}
