@graph(role: .declaration)
@syntax
@construct(name: "Enum") {
    @let(name: "self") {
        @value(type: "NominalTypeReference")
    }
    @let(name: "generics") {
        @value(type: "Array") {
            @generic(name: "Generic")
        }
    }
    @let(name: "cases") {
        @value(type: "Array") {
            @generic(name: "EnumCase")
        }
    }

    @function(name: "expand", result: "Void", body: "")
}

@graph(role: .declaration)
@syntax
@construct(name: "EnumCase") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "associatedValues") {
        @value(type: "Array") {
            @generic(name: "EnumAssociatedValue")
        }
    }
}

@syntax
@construct(name: "EnumAssociatedValue") {
    @let(name: "label") {
        @value(type: "Optional") {
            @generic(name: "String")
        }
    }
    @let(name: "type") {
        @value(type: "TypeReference")
    }
}
