@graph(role: .declaration)
@syntax
@construct(name: "Enum") {
    @let(name: "self", value: "NominalTypeReference")
    @let(name: "generics", value: "Array<Generic>")
    @let(name: "cases", value: "Array<EnumCase>")

    @function(name: "expand", result: "Void", body: "")
}

@graph(role: .declaration)
@syntax
@construct(name: "EnumCase") {
    @let(name: "identifier", value: "Identifier")
    @let(name: "associatedValues", value: "Array<EnumAssociatedValue>")
}

@syntax
@construct(name: "EnumAssociatedValue") {
    @let(name: "label", value: "Optional<String>")
    @let(name: "type", value: "TypeReference")
}
