@graph(role: .declaration)
@syntax
@construct(name: "Enum") {
    @let(name: "self") {
        @value(type: "NominalTypeReference")
    }
    @let(name: "generics") {
        @value(type: "Array<Generic>")
    }
    @let(name: "cases") {
        @value(type: "Array<EnumCase>")
    }

    @function(name: "expand", result: "Void", body: "")
}

@graph(role: .declaration)
@syntax
@construct(name: "EnumCase") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "associatedValues") {
        @value(type: "Array<EnumAssociatedValue>")
    }
}

@syntax
@construct(name: "EnumAssociatedValue") {
    @let(name: "label") {
        @value(type: "Optional<String>")
    }
    @let(name: "type") {
        @value(type: "TypeReference")
    }
}
