@graph(role: .declaration)
@syntax
@construct(name: "Construct") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "self") {
        @value(type: "NominalTypeReference")
    }
    @let(name: "macros") {
        @value(type: "Array<Macro>")
    }
    @let(name: "generics") {
        @value(type: "Array<Generic>")
    }
    @let(name: "conformances") {
        @value(type: "Array<NominalTypeReference>")
    }
    @let(name: "lets") {
        @value(type: "Array<Let>")
    }
    @let(name: "states") {
        @value(type: "Array<State>")
    }
    @let(name: "bindings") {
        @value(type: "Array<Binding>")
    }
    @let(name: "deriveds") {
        @value(type: "Array<Derived>")
    }
    @let(name: "members") {
        @value(type: "Array<GraphIdentity>")
    }
    @let(name: "functions") {
        @value(type: "Array<Function>")
    }
    @let(name: "constructs") {
        @value(type: "Array<Construct>")
    }
    @let(name: "extensions") {
        @value(type: "Array<Extension>")
    }

    @function(name: "expand", result: "Void", body: "")
}

@graph(role: .application)
@syntax
@construct(name: "Construct") {
    @let(name: "type") {
        @value(type: "TypeReference")
    }
    @let(name: "arguments") {
        @value(type: "Array<Parameter>")
    }
    @let(name: "generics") {
        @value(type: "Array<Parameter>")
    }

    @function(name: "replace", result: "Expression", body: "")
}
