@syntax
construct Construct {
    let declaration: Declaration
    let application: Application

    @graph(role: .declaration)
    construct Declaration {
        let identifier: Identifier
        let self: NominalTypeReference
        let macros: [Macro.Application]
        let generics: [Generic]
        let conformances: [NominalTypeReference]
        let lets: [Let]
        let states: [State]
        let bindings: [Binding]
        let deriveds: [Derived]
        let members: [GraphIdentity]
        let functions: [Function.Declaration]
        let constructs: [Construct.Declaration]
        let extensions: [Extension]

        function expand(expansion: () -> [@syntax])
    }

    @graph(role: .application)
    construct Application {
        let type: TypeReference
        let arguments: [Parameter.Application]

        function replace(replacement: Expression): Expression
    }
}
