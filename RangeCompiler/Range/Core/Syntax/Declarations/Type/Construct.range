@graph(role: .declaration)
@syntax
@construct(name: "Construct") {
    @let(name: "identifier", value: "Identifier")
    @let(name: "self", value: "NominalTypeReference")
    @let(name: "macros", value: "Array<Macro>")
    @let(name: "generics", value: "Array<Generic>")
    @let(name: "conformances", value: "Array<NominalTypeReference>")
    @let(name: "lets", value: "Array<Let>")
    @let(name: "states", value: "Array<State>")
    @let(name: "bindings", value: "Array<Binding>")
    @let(name: "deriveds", value: "Array<Derived>")
    @let(name: "members", value: "Array<GraphIdentity>")
    @let(name: "functions", value: "Array<Function>")
    @let(name: "constructs", value: "Array<Construct>")
    @let(name: "extensions", value: "Array<Extension>")

    @function(name: "expand", result: "Void", body: "")
}

@graph(role: .application)
@syntax
@construct(name: "Construct") {
    @let(name: "type", value: "TypeReference")
    @let(name: "arguments", value: "Array<Parameter>")
    @let(name: "generics", value: "Array<Parameter>")

    @function(name: "replace", result: "Expression", body: "")
}
