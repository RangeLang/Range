@graph(role: .declaration)
@syntax
@construct(name: "Construct") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "self") {
        @value(type: "NominalTypeReference")
    }
    @let(name: "macros") {
        @value(type: "Array") {
            @generic(name: "Macro")
        }
    }
    @let(name: "generics") {
        @value(type: "Array") {
            @generic(name: "Generic")
        }
    }
    @let(name: "conformances") {
        @value(type: "Array") {
            @generic(name: "NominalTypeReference")
        }
    }
    @let(name: "lets") {
        @value(type: "Array") {
            @generic(name: "Let")
        }
    }
    @let(name: "states") {
        @value(type: "Array") {
            @generic(name: "State")
        }
    }
    @let(name: "bindings") {
        @value(type: "Array") {
            @generic(name: "Binding")
        }
    }
    @let(name: "deriveds") {
        @value(type: "Array") {
            @generic(name: "Derived")
        }
    }
    @let(name: "members") {
        @value(type: "Array") {
            @generic(name: "GraphIdentity")
        }
    }
    @let(name: "functions") {
        @value(type: "Array") {
            @generic(name: "Function")
        }
    }
    @let(name: "constructs") {
        @value(type: "Array") {
            @generic(name: "Construct")
        }
    }
    @let(name: "extensions") {
        @value(type: "Array") {
            @generic(name: "Extension")
        }
    }

    @function(name: "expand", result: "Void", body: "")
}

@graph(role: .application)
@syntax
@construct(name: "Construct") {
    @let(name: "type") {
        @value(type: "TypeReference")
    }
    @let(name: "arguments") {
        @value(type: "Array") {
            @generic(name: "Parameter")
        }
    }
    @let(name: "generics") {
        @value(type: "Array") {
            @generic(name: "Parameter")
        }
    }

    @function(name: "replace", result: "Expression", body: "")
}
