@graph(role: .declaration)
@syntax
@construct(name: "Function") {
    @let(name: "identity") {
        @value(type: "GraphIdentity")
    }
    @let(name: "parent") {
        @value(type: "Optional") {
            @generic(name: "GraphIdentity")
        }
    }
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "generics") {
        @value(type: "Array") {
            @generic(name: "Generic")
        }
    }
    @let(name: "parameters") {
        @value(type: "Array") {
            @generic(name: "Parameter")
        }
    }
    @let(name: "returnType") {
        @value(type: "Optional") {
            @generic(name: "TypeReference")
        }
    }
    @let(name: "body") {
        @value(type: "Block")
    }
}

@graph(role: .application)
@syntax
@construct(name: "Function") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "arguments") {
        @value(type: "Array") {
            @generic(name: "Parameter")
        }
    }

    @function(name: "replace", result: "Expression", body: "")
}
