@graph(role: .declaration)
@syntax
@construct(name: "Function") {
    @let(name: "identity", value: "GraphIdentity")
    @let(name: "parent", value: "Optional<GraphIdentity>")
    @let(name: "identifier", value: "Identifier")
    @let(name: "generics", value: "Array<Generic>")
    @let(name: "parameters", value: "Array<Parameter>")
    @let(name: "returnType", value: "Optional<TypeReference>")
    @let(name: "body", value: "Block")
}

@graph(role: .application)
@syntax
@construct(name: "Function") {
    @let(name: "identifier", value: "Identifier")
    @let(name: "arguments", value: "Array<Parameter>")

    @function(name: "replace", result: "Expression", body: "")
}
