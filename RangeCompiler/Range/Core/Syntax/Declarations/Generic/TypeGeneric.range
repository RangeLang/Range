@syntax
@construct(name: "TypeGeneric") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "constraint") {
        @value(type: "Optional") {
            @generic(name: "TypeReference")
        }
    }
    @let(name: "default") {
        @value(type: "Optional") {
            @generic(name: "TypeReference")
        }
    }
}

