@syntax
@construct(name: "ValueGeneric") {
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "type") {
        @value(type: "TypeReference")
    }
    @let(name: "value") {
        @value(type: "String")
    }
    @let(name: "default") {
        @value(type: "Optional<String>")
    }
}
