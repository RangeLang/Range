@statement
@syntax
@construct(name: "LocalBinding") {
    @let(name: "mutable") {
        @value(type: "Bool")
    }
    @let(name: "identifier") {
        @value(type: "Identifier")
    }
    @let(name: "type") {
        @value(type: "TypeReference")
    }
    @let(name: "expression") {
        @value(type: "WrittenSyntax")
    }
}
