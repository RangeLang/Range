@expression
macro statement() -> String { target, diagnostics in
    return "statement|kind=expression|projection=target.declaration"
}

macro statement.bodyText -> String { target, diagnostics in
    @return(value: target.declaration.bodyText)
}

macro statement.ordinal -> String { target, diagnostics in
    @return(value: "\(target.ordinal)")
}

macro statement.projection -> String { target, diagnostics in
    @return(value: "target.declaration.statements")
}

macro statement.declarationProjection -> String { target, diagnostics in
    @return(value: "target.declaration")
}
