@expression
macro statement() -> String {
    return "statement|kind=expression|projection=target.declaration"
}

macro statement.bodyText -> String {
    @return(value: declaration.bodyText)
}

macro statement.ordinal -> String {
    @return(value: "\(ordinal)")
}

macro statement.projection -> String {
    @return(value: "target.declaration.statements")
}

macro statement.declarationProjection -> String {
    @return(value: "target.declaration")
}
