@construct(name: "RangeProgram") {
    @let(name: "graph") {
        @value(type: "RangeGraph")
    }
}

@construct(name: "RangeGraph") {
    @let(name: "files") {
        @value(type: "Array<FileTreeNode>")
    }
    @let(name: "sources") {
        @value(type: "Array<ProgramSourceFile>")
    }
    @let(name: "artifacts") {
        @value(type: "Array<ProgramArtifact>")
    }
    @let(name: "topology") {
        @value(type: "RangeGraphTopology")
    }
    @state(name: "main") {
        @value(type: "Optional<@main>")
    }
    @state(name: "syntax") {
        @value(type: "Array<@syntax>")
    }
}

@construct(name: "ProgramSourceFile") {
    @let(name: "path") {
        @value(type: "String")
    }
    @let(name: "text") {
        @value(type: "String")
    }
}

@construct(name: "ProgramArtifact") {
    @let(name: "path") {
        @value(type: "String")
    }
    @let(name: "text") {
        @value(type: "String")
    }
}

@construct(name: "RangeGraphTopology") {
    @let(name: "nodes") {
        @value(type: "Array<RangeGraphNode>")
    }
    @let(name: "relationships") {
        @value(type: "Array<RangeGraphRelationship>")
    }
}

@construct(name: "RangeGraphNode") {
    @let(name: "identity") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "sourcePath") {
        @value(type: "String")
    }
    @let(name: "labels") {
        @value(type: "Array<String>")
    }
}

@construct(name: "RangeGraphRelationship") {
    @let(name: "origin") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "destination") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "kind") {
        @value(type: "String")
    }
}

@construct(name: "GraphSyntax") {
    @let(name: "identity") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "declarations") {
        @value(type: "Array<GraphEntry>")
    }
    @let(name: "applications") {
        @value(type: "Array<GraphEntry>")
    }
}

enum GraphRole {
    case declaration
    case application
}

@construct(name: "RangeGraphIdentity") {
    @let(name: "id") {
        @value(type: "String")
    }
    @let(name: "kind") {
        @value(type: "String")
    }
    @let(name: "name") {
        @value(type: "String")
    }
}

@construct(name: "GraphEntry") {
    @let(name: "identity") {
        @value(type: "RangeGraphIdentity")
    }
}
