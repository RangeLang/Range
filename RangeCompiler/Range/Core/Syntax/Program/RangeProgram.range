@construct(name: "RangeProgram") {
    @let(name: "graph") {
        @value(type: "RangeGraph")
    }
}

@construct(name: "RangeGraph") {
    @let(name: "files") {
        @value(type: "Array") {
            @generic(name: "FileTreeNode")
        }
    }
    @let(name: "sources") {
        @value(type: "Array") {
            @generic(name: "ProgramSourceFile")
        }
    }
    @let(name: "artifacts") {
        @value(type: "Array") {
            @generic(name: "ProgramArtifact")
        }
    }
    @let(name: "topology") {
        @value(type: "RangeGraphTopology")
    }
    @state(name: "main") {
        @value(type: "Optional") {
            @generic(name: "@main")
        }
    }
    @state(name: "syntax") {
        @value(type: "Array") {
            @generic(name: "@syntax")
        }
    }
}

@construct(name: "ProgramSourceFile") {
    @let(name: "path") {
        @value(type: "String")
    }
    @let(name: "text") {
        @value(type: "String")
    }
}

@construct(name: "ProgramArtifact") {
    @let(name: "path") {
        @value(type: "String")
    }
    @let(name: "text") {
        @value(type: "String")
    }
}

@construct(name: "RangeGraphTopology") {
    @let(name: "nodes") {
        @value(type: "Array") {
            @generic(name: "RangeGraphNode")
        }
    }
    @let(name: "relationships") {
        @value(type: "Array") {
            @generic(name: "RangeGraphRelationship")
        }
    }
}

@construct(name: "RangeGraphNode") {
    @let(name: "identity") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "sourcePath") {
        @value(type: "String")
    }
    @let(name: "labels") {
        @value(type: "Array") {
            @generic(name: "String")
        }
    }
}

@construct(name: "RangeGraphRelationship") {
    @let(name: "origin") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "destination") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "kind") {
        @value(type: "String")
    }
}

@construct(name: "GraphSyntax") {
    @let(name: "identity") {
        @value(type: "RangeGraphIdentity")
    }
    @let(name: "declarations") {
        @value(type: "Array") {
            @generic(name: "GraphEntry")
        }
    }
    @let(name: "applications") {
        @value(type: "Array") {
            @generic(name: "GraphEntry")
        }
    }
}

@enum(name: "GraphRole") {
    @case(name: "declaration")
    @case(name: "application")
}

@construct(name: "RangeGraphIdentity") {
    @let(name: "id") {
        @value(type: "String")
    }
    @let(name: "kind") {
        @value(type: "String")
    }
    @let(name: "name") {
        @value(type: "String")
    }
}

@construct(name: "GraphEntry") {
    @let(name: "identity") {
        @value(type: "RangeGraphIdentity")
    }
}
