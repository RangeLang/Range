@construct(name: "RangeProgram") {
    @let(name: "graph", value: "RangeGraph")
}

@construct(name: "RangeGraph") {
    @let(name: "files", value: "Array<FileTreeNode>")
    @let(name: "sources", value: "Array<ProgramSourceFile>")
    @let(name: "artifacts", value: "Array<ProgramArtifact>")
    @let(name: "topology", value: "RangeGraphTopology")
    @state(name: "main", value: "Optional<@main>")
    @state(name: "syntax", value: "Array<@syntax>")
}

@construct(name: "ProgramSourceFile") {
    @let(name: "path", value: "String")
    @let(name: "text", value: "String")
}

@construct(name: "ProgramArtifact") {
    @let(name: "path", value: "String")
    @let(name: "text", value: "String")
}

@construct(name: "RangeGraphTopology") {
    @let(name: "nodes", value: "Array<RangeGraphNode>")
    @let(name: "relationships", value: "Array<RangeGraphRelationship>")
}

@construct(name: "RangeGraphNode") {
    @let(name: "identity", value: "RangeGraphIdentity")
    @let(name: "sourcePath", value: "String")
    @let(name: "labels", value: "Array<String>")
}

@construct(name: "RangeGraphRelationship") {
    @let(name: "origin", value: "RangeGraphIdentity")
    @let(name: "destination", value: "RangeGraphIdentity")
    @let(name: "kind", value: "String")
}

@construct(name: "GraphSyntax") {
    @let(name: "identity", value: "RangeGraphIdentity")
    @let(name: "declarations", value: "Array<GraphEntry>")
    @let(name: "applications", value: "Array<GraphEntry>")
}

enum GraphRole {
    case declaration
    case application
}

@construct(name: "RangeGraphIdentity") {
    @let(name: "id", value: "String")
    @let(name: "kind", value: "String")
    @let(name: "name", value: "String")
}

@construct(name: "GraphEntry") {
    @let(name: "identity", value: "RangeGraphIdentity")
}
