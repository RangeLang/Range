@macro(name: "identifierSyntaxName"): Init { target, diagnostics in
    target.application.replace(replacement:
        target.declaration.expression(arguments: [
            String(target.application.arguments[0].expression)
        ])
    )
}

@syntax
@identifierSyntaxName
@construct(name: "Identifier") {
    @let(name: "name") {
        @value(type: "String")
    }
}
