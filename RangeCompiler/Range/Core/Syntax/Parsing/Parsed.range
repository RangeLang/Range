@syntax
@construct(name: "Parsed") {
    @generic(name: "Value")
    @let(name: "written") {
        @value(type: "WrittenSyntax")
    }
    @let(name: "value") {
        @value(type: "Optional") {
            @generic(name: "Value")
        }
    }
    @let(name: "diagnostics") {
        @value(type: "Array") {
            @generic(name: "String")
        }
    }
}
