@syntax
@construct(name: "ArrayExpression") {
    @let(name: "type") {
        @value(type: "Optional") {
            @generic(name: "TypeReference")
        }
    }
    @let(name: "elements") {
        @value(type: "Array") {
            @generic(name: "Expression")
        }
    }

    @function(name: "replace", result: "Expression", body: "")
}
