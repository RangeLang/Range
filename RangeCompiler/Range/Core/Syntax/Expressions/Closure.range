@syntax
@construct(name: "Closure") {
    @let(name: "type") {
        @value(type: "Optional") {
            @generic(name: "TypeReference")
        }
    }
    @let(name: "parameters") {
        @value(type: "Array", current: "Array()") {
            @generic(name: "Parameter")
        }
    }
    @let(name: "body") {
        @value(type: "Block")
    }

    @function(name: "replace", result: "Expression", body: "")
}
