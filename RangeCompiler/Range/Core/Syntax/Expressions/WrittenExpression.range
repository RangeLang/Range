@syntax
@construct(name: "WrittenExpression") {
    @let(name: "type") {
        @value(type: "Optional") {
            @generic(name: "TypeReference")
        }
    }
    @let(name: "written") {
        @value(type: "WrittenSyntax")
    }

    @function(name: "replace", result: "Expression", body: "")
}
