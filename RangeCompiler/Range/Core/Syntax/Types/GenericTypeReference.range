@syntax
@construct(name: "GenericTypeReference") {
    @let(name: "base") {
        @value(type: "NominalTypeReference")
    }
    @let(name: "arguments") {
        @value(type: "Array") {
            @generic(name: "TypeReference")
        }
    }

    @function(name: "replace", result: "TypeReference", body: "")
}
