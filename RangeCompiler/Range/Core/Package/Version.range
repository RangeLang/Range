@construct(name: "Version") {
    @state(name: "major") {
        @value(type: "Int") {
            @generic(name: ".unsigned")
        }
    }
    @state(name: "minor") {
        @value(type: "Int") {
            @generic(name: ".unsigned")
        }
    }
    @state(name: "patch") {
        @value(type: "Int") {
            @generic(name: ".unsigned")
        }
    }
}
