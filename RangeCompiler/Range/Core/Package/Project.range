@construct
@macro(name: "project", result: "Void"){ target, diagnostics, graph in
    @let(
        name: "projectMacros",
        value: "Array<Macro>(graph.macros.where { entry in @return(value: entry.identifier.name == \"project\") })"
    )

    @if(projectMacros.count > 1) {
        diagnostics.error("A second @project conflicts with the project already declared in this Range project.")
    }
}
