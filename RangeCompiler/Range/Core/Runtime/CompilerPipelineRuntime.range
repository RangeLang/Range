@syntax
enum CompilerPipelineRuntimeStage {
    case coreDeclarationsDiscovered
    case coreParsed
    case projectDeclarationsDiscovered
    case projectParsed
    case macrosExpanded
    case declarationGraphBuilt
}

@syntax
construct CompilerPipelineRuntimeContext {
    @let stage: CompilerPipelineRuntimeStage
}

@syntax
construct CompilerPipelineRuntimeResult {
    @let hookName: String
    @let stage: CompilerPipelineRuntimeStage
    @let diagnostics: Array<String>
    @let artifacts: Array<String>
}

@syntax
construct CompilerPipelineRuntimeHook {
    @let name: String
    @let stages: Array<CompilerPipelineRuntimeStage>
}
