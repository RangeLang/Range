function compilerTypedSyntaxCaptureMacroGenericParameters(source: String, tables: CompilerSyntaxTables, macroDeclarationRow: Int, start: Int, end: Int, ordinalStart: Int, baseFingerprint: CompilerFingerprint): CompilerMacroParameterCapture {
    if start < 0 && end < 0 { return CompilerMacroParameterCapture(count: 0, fingerprint: baseFingerprint, isValid: true) }
