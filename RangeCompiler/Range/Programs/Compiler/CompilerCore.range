function compilerBodyArenaSeedParameterSymbols(arena: CompilerBodyArena): Int {
    if compilerBodyArenaIsEntry(arena: arena) { return 0 }
    if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        let capabilityCount: Int(compilerIntTableRowCount(table: arena.tables.macroCapabilities))
        state row: Int(0)
        while row < capabilityCount {
            if compilerIntTableValue(table: arena.tables.macroCapabilities, row: row, column: 1) == arena.ownerDeclarationSyntaxID {
                let nameStart: Int(compilerIntTableValue(table: arena.tables.macroCapabilities, row: row, column: 4))
                let nameEnd: Int(compilerIntTableValue(table: arena.tables.macroCapabilities, row: row, column: 5))
                if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolParameter(), declarationRef: row, regionNodeID: arena.rootNodeID, nameStart: nameStart, nameEnd: nameEnd, typeStart: nameStart, typeEnd: nameEnd) < 0 { return 0 - 1 }
            }
            row: row + 1
        }
        return 0
    }
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return 0 - 1 }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolParameter(), declarationRef: parameterRow, regionNodeID: arena.rootNodeID, nameStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 6), nameEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 7), typeStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8), typeEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9)) < 0 { return 0 - 1 }
        ordinal: ordinal + 1
    }
    return 0
}

function compilerBodyArenaBuildRegionSymbols(arena: CompilerBodyArena, index: CompilerDeclarationIndex, regionNodeID: Int): Int {
    state ordinal: Int(0)
    state keepScanning: Bool(true)
    while keepScanning {
        let statementNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: regionNodeID, role: compilerSyntaxRoleStatement(), ordinal: ordinal))
        if statementNodeID < 0 { keepScanning: false } else {
            let kind: Int(compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 1))
            if kind == compilerSyntaxKindLocalBinding() {
                let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
                if initializerNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: initializerNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                state symbolKind: Int(compilerBodySymbolLet())
                if compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 10) == compilerSyntaxLocalKindState() { symbolKind: compilerBodySymbolState() }
                if compilerBodyArenaAppendSymbol(arena: arena, kind: symbolKind, declarationRef: statementNodeID, regionNodeID: regionNodeID, nameStart: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 6), nameEnd: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 7), typeStart: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 8), typeEnd: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 9)) < 0 { return 0 - 1 }
            } else if kind == compilerSyntaxKindIf() {
                let conditionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleCondition(), ordinal: 0))
                let thenRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleThenRegion(), ordinal: 0))
                if conditionNodeID < 0 || thenRegionNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: conditionNodeID, regionNodeID: regionNodeID) != 0 || compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: thenRegionNodeID) != 0 { return 0 - 1 }
                let elseRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleElseRegion(), ordinal: 0))
                if elseRegionNodeID >= 0 {
                    if compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: elseRegionNodeID) != 0 { return 0 - 1 }
                }
            } else if kind == compilerSyntaxKindWhile() {
                let whileConditionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleCondition(), ordinal: 0))
                let whileBodyRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleWhileBody(), ordinal: 0))
                if whileConditionNodeID < 0 || whileBodyRegionNodeID < 0
                    || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: whileConditionNodeID, regionNodeID: regionNodeID) != 0
                    || compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: whileBodyRegionNodeID) != 0 { return 0 - 1 }
            } else if kind == compilerSyntaxKindAssignment() {
