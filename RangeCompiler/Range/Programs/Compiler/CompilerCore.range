    let runtimeFunctionFileID: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 1))
    let runtimeParameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 1))
    let runtimeParameterIsInt: Bool(compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeParameterFileID, start: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 8), end: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 9), text: String("Int")))
