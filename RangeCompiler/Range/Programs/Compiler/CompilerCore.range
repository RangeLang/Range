                memoryBorrowFunctionRole: compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: compilerIntTableValue(table: semantics.parameterEffects, row: memoryBorrowEffectRow, column: 0))
            }
            if memoryBorrowFunctionRole != compilerRuntimeABIFunctionDestroy() {
            let memoryBorrowValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: memoryBorrowArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            let memoryBorrowLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryBorrowValueNodeID))
            let memoryBorrowStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: memoryBorrowLocalNodeID))
            let memoryBorrowTypeNodeID: Int(compilerIntTableValue(table: semantics.nodeTypes, row: memoryBorrowParameterNodeID, column: 2))
            if memoryBorrowStorageID < 0 || memoryBorrowEffectRow < 0
                || (memoryBorrowFunctionRole != compilerRuntimeABIFunctionSharedRead()
                    && compilerIntTableValue(table: semantics.parameterEffects, row: memoryBorrowEffectRow, column: 2) != 1)
                || compilerIntTableValue(table: semantics.parameterEffects, row: memoryBorrowEffectRow, column: 3) != 0
                || compilerIntTableValue(table: semantics.parameterEffects, row: memoryBorrowEffectRow, column: 4) != 0 {
                compilerMemoryGraphPoison(memory: memory)
