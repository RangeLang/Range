    let runtimeReturnIsInt: Bool(compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeFunctionFileID, start: compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 6), end: compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 7), text: String("Int")))
