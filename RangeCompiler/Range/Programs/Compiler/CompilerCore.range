                    if intBufferElement(buffer: sensitiveFunctions, index: componentTarget) == 1 {
                        state componentNeighbor: Int(0 - 1)
                        if componentOwner == componentMember { componentNeighbor: componentTarget }
                        if componentTarget == componentMember { componentNeighbor: componentOwner }
                        if componentNeighbor >= 0 {
                            if intBufferElement(buffer: reachability.abiParticipants, index: componentNeighbor) == 0 {
                                if intBufferSet(buffer: reachability.abiParticipants, index: componentNeighbor, value: 3) != 0
                                    || intBufferAppend(buffer: componentQueue, value: componentNeighbor) != 0 {
                                    intBufferDestroy(buffer: componentQueue)
                                    return 0 - 1
                                }
                            }
                        }
                    }
                    componentEdge: componentEdge + 1
                }
                componentCursor: componentCursor + 1
            }
            let componentEnd: Int(intBufferCount(buffer: componentQueue))
            state componentKnownFailure: Int(componentStart)
            while componentKnownFailure < componentEnd {
                let knownFailureMember: Int(intBufferElement(buffer: componentQueue, index: componentKnownFailure))
                if intBufferElement(buffer: reachability.abiCapabilities, index: knownFailureMember) < 0 {
                    componentBlocked: true
                    if firstBlockedFunction < 0 { firstBlockedFunction: knownFailureMember }
                }
                componentKnownFailure: componentKnownFailure + 1
            }
            state componentPrepare: Int(componentStart)
            while componentPrepare < componentEnd {
                if intBufferSet(buffer: reachability.abiParticipants, index: intBufferElement(buffer: componentQueue, index: componentPrepare), value: 1) != 0 {
                    intBufferDestroy(buffer: sensitiveFunctions)
                    intBufferDestroy(buffer: componentQueue)
                    return 0 - 1
                }
                componentPrepare: componentPrepare + 1
            }
            state componentProbe: Int(componentEnd - 1)
            while !componentBlocked && !componentRequiresRestart && componentProbe >= componentStart {
                let probeMember: Int(intBufferElement(buffer: componentQueue, index: componentProbe))
                if intBufferElement(buffer: reachability.abiCapabilities, index: probeMember) == 0 {
                    let sensitiveCountBeforeProbe: Int(compilerReachableLLVMStateSensitiveCount(reachability: reachability))
                    if compilerReachableLLVMStateProbeCandidateFunction(reachability: reachability, functionRow: probeMember) != 0 {
                        intBufferDestroy(buffer: sensitiveFunctions)
                        intBufferDestroy(buffer: componentQueue)
                        return 0 - 1
                    }
                    if compilerReachableLLVMStateSensitiveCount(reachability: reachability) != sensitiveCountBeforeProbe { componentRequiresRestart: true }
                }
                if !componentRequiresRestart && intBufferElement(buffer: reachability.abiCapabilities, index: probeMember) != 1 {
                    componentBlocked: true
