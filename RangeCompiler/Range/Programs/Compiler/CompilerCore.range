        if kind == compilerSyntaxKindAddition() || kind == compilerSyntaxKindSubtraction() || kind == compilerSyntaxKindMultiplication() || kind == compilerSyntaxKindDivision() || kind == compilerSyntaxKindRemainder() {
            if leftType != rightType || (leftType != compilerBodyTypeInt() && leftType != compilerBodyTypeFloat() && leftType != compilerBodyTypeFloat32()) { return 0 - 1 }
