function compilerSourceSetProgramAppendingFile(program: CompilerProgram, fileProgram: CompilerProgram): CompilerProgram {
    let declarationRecords: String("\(program.declarationRecords)\(fileProgram.declarationRecords)")
    return compilerSourceSetProgramAppendingFileDeclarations(program: program, fileProgram: fileProgram, declarationRecords: declarationRecords)
}

function compilerSourceSetProgramAppendingFileDeclarations(program: CompilerProgram, fileProgram: CompilerProgram, declarationRecords: String): CompilerProgram {
    if program.hasMainBlock {
        return compilerSourceSetProgramAppendingFileExisting(program: program, declarationRecords: declarationRecords)
    }

    return compilerSourceSetProgramAppendingFileWithoutProgramMain(program: program, fileProgram: fileProgram, declarationRecords: declarationRecords)
}

function compilerSourceSetProgramAppendingFileWithoutProgramMain(program: CompilerProgram, fileProgram: CompilerProgram, declarationRecords: String): CompilerProgram {
    if fileProgram.hasMainBlock {
        return compilerSourceSetProgramAppendingFileMain(fileProgram: fileProgram, declarationRecords: declarationRecords)
    }

    return compilerSourceSetProgramAppendingFileExisting(program: program, declarationRecords: declarationRecords)
}

function compilerSourceSetProgramAppendingFileExisting(program: CompilerProgram, declarationRecords: String): CompilerProgram {
    return CompilerProgram(source: program.source, hasMainBlock: program.hasMainBlock, mainAttributeStart: program.mainAttributeStart, mainBlock: program.mainBlock, mainStatementRecords: program.mainStatementRecords, mainStatementSummary: program.mainStatementSummary, declarationRecords: declarationRecords, declarationSummary: String(""), functionSummary: String(""))
}

function compilerSourceSetProgramAppendingFileMain(fileProgram: CompilerProgram, declarationRecords: String): CompilerProgram {
    return CompilerProgram(source: fileProgram.source, hasMainBlock: true, mainAttributeStart: fileProgram.mainAttributeStart, mainBlock: fileProgram.mainBlock, mainStatementRecords: fileProgram.mainStatementRecords, mainStatementSummary: fileProgram.mainStatementSummary, declarationRecords: declarationRecords, declarationSummary: String(""), functionSummary: String(""))
}

function compilerSourceSetProgramSource(source: String): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let firstMarker: Int(compilerSourceNextFileMarker(source: source, start: 0))
    let sourceLength: Int(stringLength(value: source))
    if firstMarker >= sourceLength {
        return source
    }

    return compilerSourceSetProgramSourceFromIndex(source: source, sourceIndex: firstMarker, marker: marker, output: String(""))
}

function compilerSourceSetProgramSourceFromIndex(source: String, sourceIndex: Int, marker: String, output: String): String {
    let sourceLength: Int(stringLength(value: source))
    let markerStart: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if markerStart >= sourceLength {
        return output
    }

    let markerLength: Int(stringLength(value: marker))
    let pathStart: Int(markerStart + markerLength)
    let pathEnd: Int(compilerSourceFilePathEnd(source: source, start: pathStart))
    let fileStart: Int(pathEnd + 1)
    let nextMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
    let fileSource: String(stringSubstring(source: source, start: fileStart, end: nextMarker))
    let nextOutput: String("\(output)\(fileSource)\n")
    return compilerSourceSetProgramSourceFromIndex(source: source, sourceIndex: nextMarker, marker: marker, output: nextOutput)
}

function compilerNativeMainSource(): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let atSign: String("@")
    let mainAttribute: String("\(atSign)main")
    return "\(marker)NativeMain.range\n\(mainAttribute) {\n    if commandLineArgumentCount() != 1 {\n        print(value: String(\"usage: Compiler <input.range>\"))\n        return 64\n    }\n\n    let argument: Optional<String>(commandLineArgument(index: 0))\n    let path: String(argument ?? String(\"\"))\n    let source: String(readFile(path: path))\n    print(value: compileRangeNativeSource(source: source))\n    return 0\n}\n"
}

function compilerSourceNextFileMarker(source: String, start: Int): Int {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let candidate: Int(stringIndexOf(source: source, needle: marker, start: start))
    return compilerSourceNextFileMarkerFromCandidate(source: source, marker: marker, candidate: candidate)
}

function compilerSourceNextFileMarkerFromCandidate(source: String, marker: String, candidate: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    if candidate >= sourceLength {
        return sourceLength
    }

    if candidate == 0 {
        return candidate
    }

    let newlineValue: String("
")
    let newline: String(newlineValue.substring(start: 0, end: 1))
    if source.character(index: candidate - 1) == newline {
        return candidate
    }

    let nextCandidate: Int(stringIndexOf(source: source, needle: marker, start: candidate + 1))
    return compilerSourceNextFileMarkerFromCandidate(source: source, marker: marker, candidate: nextCandidate)
}

function compilerCoreASTSummaryForProgram(program: CompilerProgram): String {
    let declarationBodySummary: String(compilerCoreDeclarationRecordsBodyASTSummary(records: program.declarationRecords))
    if !program.hasMainBlock {
        return "\(program.declarationSummary)\(declarationBodySummary)"
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    return "\(program.declarationSummary)\(declarationBodySummary)ast\tprogram\thasMainBlock=true\tdeclarationSummaryLength=\(stringLength(value: program.declarationSummary))\nast\tmainBlock\tbodyStart=\(program.mainBlock.start)\tbodyEnd=\(program.mainBlock.end)\nast\tblock\tkind=main\tstart=\(program.mainBlock.start)\tend=\(program.mainBlock.end)\n\(parsedBlock.statementSummary)"
}

function compilerCoreDeclarationRecordsBodyASTSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if declaration.kind == String("function") && declaration.statementRecords != String("") {
            output: "\(output)ast\tblock\tkind=function\tname=\(declaration.name)\tstart=\(declaration.bodyStart)\tend=\(declaration.bodyEnd)\n"
            output: "\(output)\(compilerCoreStatementRecordsASTSummary(records: declaration.statementRecords))"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function parseCompilerProgram(source: String): CompilerProgram {
    return parseCompilerProgramWithFunctionBodyMode(source: source, includeFunctionBodies: false)
}

function parseCompilerProgramForLLVM(source: String): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVM(source: source))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function parseCompilerProgramForLLVMNamedBodies(source: String, bodyFunctionNames: String): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: source, bodyFunctionNames: bodyFunctionNames))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function parseCompilerProgramWithFunctionBodies(source: String): CompilerProgram {
    return parseCompilerProgramWithFunctionBodyMode(source: source, includeFunctionBodies: true)
}

function parseCompilerProgramWithFunctionBodyMode(source: String, includeFunctionBodies: Bool): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: source, includeFunctionBodies: includeFunctionBodies))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function compilerCoreProgramFromParsedParts(source: String, maybeMainBlock: Optional<CompilerMainBlock>, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    if maybeMainBlock == nil {
        return compilerCoreProgramWithoutMain(source: source, parsedDeclarations: parsedDeclarations)
    }

    let mainBlockFallback: CompilerMainBlock(CompilerMainBlock(attributeStart: 0, bodyStart: 0, bodyEnd: 0))
    let mainBlock: CompilerMainBlock(maybeMainBlock ?? mainBlockFallback)
    return compilerCoreProgramWithMain(source: source, mainBlock: mainBlock, parsedDeclarations: parsedDeclarations)
}

function compilerCoreProgramWithoutMain(source: String, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    let blockFallback: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(
        source: source,
        hasMainBlock: false,
        mainAttributeStart: 0,
        mainBlock: blockFallback,
        mainStatementRecords: String(""),
        mainStatementSummary: String(""),
        declarationRecords: parsedDeclarations.records,
        declarationSummary: parsedDeclarations.declarationSummary,
        functionSummary: parsedDeclarations.functionSummary
    )
}

function compilerCoreProgramWithMain(source: String, mainBlock: CompilerMainBlock, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    let block: CompilerBlock(CompilerBlock(start: mainBlock.bodyStart, end: mainBlock.bodyEnd))
    let parsingProgram: CompilerProgram(compilerCoreProgramWithoutMain(source: source, parsedDeclarations: parsedDeclarations))
    return compilerCoreProgramWithMainBlock(source: source, mainBlock: mainBlock, block: block, parsedDeclarations: parsedDeclarations, parsingProgram: parsingProgram)
}

function compilerCoreProgramWithMainBlock(source: String, mainBlock: CompilerMainBlock, block: CompilerBlock, parsedDeclarations: CompilerParsedDeclarations, parsingProgram: CompilerProgram): CompilerProgram {
    let statements: CompilerParsedStatements(compilerCoreParseStatements(program: parsingProgram, block: block))
    return compilerCoreProgramWithMainStatements(source: source, mainBlock: mainBlock, block: block, parsedDeclarations: parsedDeclarations, statements: statements)
}

function compilerCoreProgramWithMainStatements(source: String, mainBlock: CompilerMainBlock, block: CompilerBlock, parsedDeclarations: CompilerParsedDeclarations, statements: CompilerParsedStatements): CompilerProgram {
    let statementSummary: String(compilerCoreStatementRecordsASTSummary(records: statements.records))
    return compilerCoreProgramWithMainSummary(source: source, mainBlock: mainBlock, block: block, parsedDeclarations: parsedDeclarations, statements: statements, statementSummary: statementSummary)
}

function compilerCoreProgramWithMainSummary(source: String, mainBlock: CompilerMainBlock, block: CompilerBlock, parsedDeclarations: CompilerParsedDeclarations, statements: CompilerParsedStatements, statementSummary: String): CompilerProgram {
    return CompilerProgram(
        source: source,
        hasMainBlock: true,
        mainAttributeStart: mainBlock.attributeStart,
        mainBlock: block,
        mainStatementRecords: statements.records,
        mainStatementSummary: statementSummary,
        declarationRecords: parsedDeclarations.records,
        declarationSummary: parsedDeclarations.declarationSummary,
        functionSummary: parsedDeclarations.functionSummary
    )
}

function compilerCoreSymbolSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreSymbolSummaryForProgram(program: program)
}

function compilerCoreSymbolSummaryForProgram(program: CompilerProgram): String {
    state output: String("symbols\tprogram\n")
    output: "\(output)\(compilerCoreTopLevelSymbolSummary(records: program.declarationRecords))"
    if program.hasMainBlock {
        let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
        output: "\(output)\(compilerCoreStatementRecordsSymbolSummary(statementRecords: parsedBlock.statementRecords, scopeName: String("main")))"
    }
    return output
}

function compilerCoreTopLevelSymbolSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if declaration.kind == String("construct") {
            output: "\(output)symbol\tkind=construct\tname=\(declaration.name)\tscope=program\tmembers=[\(declaration.memberSummary)]\n"
            output: "\(output)\(compilerCoreDeclarationRecordsConstructMemberSymbolSummary(records: records, constructName: declaration.name))"
        } else if declaration.kind == String("function") {
            output: "\(output)symbol\tkind=function\tname=\(declaration.name)\tscope=program\tparameters=[\(declaration.parameterSummary)]\treturnType=\(declaration.returnType)\n"
            output: "\(output)\(compilerCoreDeclarationRecordsFunctionParameterSymbolSummary(records: records, functionName: declaration.name))"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function compilerCoreDeclarationRecordsFunctionParameterSymbolSummary(records: String, functionName: String): String {
    let parameterSummary: String(compilerCoreDeclarationRecordsFunctionParameterSummary(records: records, name: functionName))
    return compilerCoreFunctionParameterSymbolSummary(functionName: functionName, parameterSummary: parameterSummary)
}

function compilerCoreFunctionParameterSymbolSummary(functionName: String, parameterSummary: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    state sourceLength: Int(0)
    sourceLength: stringLength(value: parameterSummary)

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
            let indexStart: Int(sourceIndex + 9)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
                    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
                    output: "\(output)symbol\tkind=parameter\tname=\(parameterName)\tscope=function:\(functionName)\ttype=\(parameterType)\n"
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return output
}

function compilerCoreDeclarationRecordsConstructMemberSymbolSummary(records: String, constructName: String): String {
    let memberSummary: String(compilerCoreDeclarationRecordsConstructMemberSummary(records: records, name: constructName))
    state output: String("")
    state sourceIndex: Int(0)
    state sourceLength: Int(0)
    sourceLength: stringLength(value: memberSummary)

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: memberSummary, start: sourceIndex, prefix: String("member")) {
            let indexStart: Int(sourceIndex + 6)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: memberSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: memberSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: memberSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    let memberName: String(memberSummary.substring(start: nameStart, end: nameEnd))
                    let memberType: String(memberSummary.substring(start: typeStart, end: typeEnd))
                    output: "\(output)symbol\tkind=member\tname=\(memberName)\tscope=construct:\(constructName)\ttype=\(memberType)\n"
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return output
}

function compilerCoreStatementRecordsSymbolSummary(statementRecords: String, scopeName: String): String {
    state output: String("")
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: statementRecords))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("let") || statement.kind == String("state") {
            output: "\(output)symbol\tkind=\(statement.kind)\tname=\(statement.name)\tscope=\(scopeName)\ttype=\(statement.typeName)\texpressionKind=\(statement.expressionKind)\n"
        } else if statement.kind == String("if") || statement.kind == String("while") {
            output: "\(output)\(compilerCoreStatementRecordsSymbolSummary(statementRecords: statement.bodyStatementRecords, scopeName: "\(scopeName).\(statement.kind)@\(statement.start)"))"
        }

        statementIndex: compilerCoreStatementRecordNextIndex(records: statementRecords, start: statementIndex)
    }

    return output
}

function compilerCoreTypeSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreTypeSummaryForProgram(program: program)
}

function compilerCoreTypeSummaryForProgram(program: CompilerProgram): String {
    state output: String("types\tprogram\n")
    output: "\(output)\(compilerCoreFunctionRecordsTypeSummary(program: program))"
    if program.hasMainBlock {
        let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
        output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: program.declarationRecords, statementRecords: parsedBlock.statementRecords, scopeName: String("main"), incomingLocals: String(""), expectedReturnType: String("Int")))"
    }
    return output
}

function compilerCoreFunctionRecordsTypeSummary(program: CompilerProgram): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if declaration.kind == String("function") {
            let parameterTypes: String(compilerCoreFunctionParameterLocalTypes(parameterSummary: declaration.parameterSummary))
            output: "\(output)type\tkind=function\tname=\(declaration.name)\tscope=program\treturnType=\(declaration.returnType)\n"
            output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: program.declarationRecords, statementRecords: declaration.statementRecords, scopeName: "function:\(declaration.name)", incomingLocals: parameterTypes, expectedReturnType: declaration.returnType))"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex)
    }

    return output
}

function compilerCoreStatementRecordsTypeSummary(declarationRecords: String, statementRecords: String, scopeName: String, incomingLocals: String, expectedReturnType: String): String {
    state output: String("")
    state localTypes: String("")
    localTypes: incomingLocals
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: statementRecords))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("let") || statement.kind == String("state") {
            let inferredType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: statement.expressionSummary, expectedType: statement.typeName))
            output: "\(output)type\tkind=\(statement.kind)\tname=\(statement.name)\tscope=\(scopeName)\tdeclared=\(statement.typeName)\tinferred=\(inferredType)\tstatus=\(compilerCoreTypeStatus(declaredType: statement.typeName, inferredType: inferredType))\n"
            localTypes: "\(localTypes)\(statement.name):\(statement.typeName);"
        } else if statement.kind == String("return") {
            let returnType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: statement.expressionSummary, expectedType: expectedReturnType))
            output: "\(output)type\tkind=return\tscope=\(scopeName)\tinferred=\(returnType)\tdeclared=\(expectedReturnType)\tstatus=\(compilerCoreTypeStatus(declaredType: expectedReturnType, inferredType: returnType))\n"
        } else if statement.kind == String("if") || statement.kind == String("while") {
            let conditionType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: statement.expressionSummary, expectedType: String("Bool")))
            output: "\(output)type\tkind=\(statement.kind)\tscope=\(scopeName)\tcondition=\(conditionType)\tstatus=\(compilerCoreTypeStatus(declaredType: String("Bool"), inferredType: conditionType))\n"
            output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: declarationRecords, statementRecords: statement.bodyStatementRecords, scopeName: "\(scopeName).\(statement.kind)@\(statement.start)", incomingLocals: localTypes, expectedReturnType: expectedReturnType))"
        }

        statementIndex: compilerCoreStatementRecordNextIndex(records: statementRecords, start: statementIndex)
    }

    return output
}

function compilerCoreFunctionParameterLocalTypes(parameterSummary: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: parameterSummary))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
            let indexStart: Int(sourceIndex + 9)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
                    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
                    output: "\(output)\(parameterName):\(parameterType);"
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return output
}

function compilerCoreTypeStatus(declaredType: String, inferredType: String): String {
    if inferredType == String("Unknown") {
        return String("unknown")
    }

    if declaredType == String("") || declaredType == inferredType {
        return String("ok")
    }

    if compilerCoreTypeIsOptionalOf(optionalType: declaredType, valueType: inferredType) {
        return String("ok")
    }

    return String("mismatch")
}

function compilerCoreTypeIsOptionalOf(optionalType: String, valueType: String): Bool {
    return optionalType == "Optional<\(valueType)>"
        || optionalType == "\(valueType)?"
}

function compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: String, localValues: String, expressionSummary: String, expectedType: String): String {
    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("integerLiteral(")) {
        return String("Int")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("stringLiteral(")) {
        return String("String")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("boolLiteral(")) {
        return String("Bool")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("identifier(")) {
        let identifierName: String(compilerCoreIdentifierExpressionName(summary: expressionSummary))
        let localType: String(compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: identifierName))
        if localType != String("") {
            return localType
        }
        return String("Unknown")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("prefix(")) {
        let prefixOperatorText: String(compilerCorePrefixExpressionOperator(summary: expressionSummary))
        if prefixOperatorText == String("!") {
            return String("Bool")
        }
        if prefixOperatorText == String("-") {
            return String("Int")
        }

        let operandSummary: String(compilerCorePrefixExpressionOperand(summary: expressionSummary))
        return compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: operandSummary, expectedType: expectedType)
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("binary(")) {
        let binaryOperatorText: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 1))
        if binaryOperatorText == String("plus")
            || binaryOperatorText == String("+")
            || binaryOperatorText == String("minus")
            || binaryOperatorText == String("-")
            || binaryOperatorText == String("asterisk")
            || binaryOperatorText == String("*")
            || binaryOperatorText == String("slash")
            || binaryOperatorText == String("/")
            || binaryOperatorText == String("percent")
            || binaryOperatorText == String("%")
        {
            return String("Int")
        }

        if binaryOperatorText == String("equalEqual")
            || binaryOperatorText == String("==")
            || binaryOperatorText == String("bangEqual")
            || binaryOperatorText == String("!=")
            || binaryOperatorText == String("less")
            || binaryOperatorText == String("<")
            || binaryOperatorText == String("lessEqual")
            || binaryOperatorText == String("<=")
            || binaryOperatorText == String("greater")
            || binaryOperatorText == String(">")
            || binaryOperatorText == String("greaterEqual")
            || binaryOperatorText == String(">=")
            || binaryOperatorText == String("andAnd")
            || binaryOperatorText == String("&&")
            || binaryOperatorText == String("orOr")
            || binaryOperatorText == String("||")
        {
            return String("Bool")
        }

        if binaryOperatorText == String("questionQuestion") || binaryOperatorText == String("??") {
            if expectedType != String("") {
                return expectedType
            }

            let leftSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 0))
            let leftType: String(compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: leftSummary, expectedType: String("")))
            if leftType != String("Unknown") {
                return leftType
            }

            let rightSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 2))
            return compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: rightSummary, expectedType: String(""))
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: expressionSummary))
        let functionReturnType: String(compilerCoreDeclarationRecordsFunctionReturnType(records: declarationRecords, name: functionName))
        if functionReturnType != String("") {
            return functionReturnType
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("member(")) {
        let baseSummary: String(compilerCoreMemberExpressionBase(summary: expressionSummary))
        let baseType: String(compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: baseSummary, expectedType: String("")))
        let memberName: String(compilerCoreMemberExpressionName(summary: expressionSummary))
        if baseType != String("Unknown") && baseType != String("") {
            let memberType: String(compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: baseType, memberName: memberName))
            if memberType != String("") {
                return memberType
            }
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    return String("Unknown")
}

function compilerCoreInferExpressionSummaryType(declarationRecords: String, localTypes: String, expressionSummary: String, expectedType: String): String {
    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("integerLiteral(")) {
        return String("Int")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("stringLiteral(")) {
        return String("String")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("boolLiteral(")) {
        return String("Bool")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("identifier(")) {
        let identifierName: String(compilerCoreIdentifierExpressionName(summary: expressionSummary))
        let localType: String(compilerCoreLookupLocalType(localTypes: localTypes, name: identifierName))
        if localType != String("") {
            return localType
        }
        return String("Unknown")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("prefix(")) {
        let prefixOperatorText: String(compilerCorePrefixExpressionOperator(summary: expressionSummary))
        if prefixOperatorText == String("!") {
            return String("Bool")
        }
        if prefixOperatorText == String("-") {
            return String("Int")
        }

        let operandSummary: String(compilerCorePrefixExpressionOperand(summary: expressionSummary))
        return compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: operandSummary, expectedType: expectedType)
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("binary(")) {
        let binaryOperatorText: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 1))
        if binaryOperatorText == String("plus")
            || binaryOperatorText == String("+")
            || binaryOperatorText == String("minus")
            || binaryOperatorText == String("-")
            || binaryOperatorText == String("asterisk")
            || binaryOperatorText == String("*")
            || binaryOperatorText == String("slash")
            || binaryOperatorText == String("/")
            || binaryOperatorText == String("percent")
            || binaryOperatorText == String("%")
        {
            return String("Int")
        }

        if binaryOperatorText == String("equalEqual")
            || binaryOperatorText == String("==")
            || binaryOperatorText == String("bangEqual")
            || binaryOperatorText == String("!=")
            || binaryOperatorText == String("less")
            || binaryOperatorText == String("<")
            || binaryOperatorText == String("lessEqual")
            || binaryOperatorText == String("<=")
            || binaryOperatorText == String("greater")
            || binaryOperatorText == String(">")
            || binaryOperatorText == String("greaterEqual")
            || binaryOperatorText == String(">=")
            || binaryOperatorText == String("andAnd")
            || binaryOperatorText == String("&&")
            || binaryOperatorText == String("orOr")
            || binaryOperatorText == String("||")
        {
            return String("Bool")
        }

        if binaryOperatorText == String("questionQuestion") || binaryOperatorText == String("??") {
            if expectedType != String("") {
                return expectedType
            }

            let leftSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 0))
            let leftType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: leftSummary, expectedType: String("")))
            if leftType != String("Unknown") {
                return leftType
            }

            let rightSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 2))
            return compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: rightSummary, expectedType: String(""))
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: expressionSummary))
        let functionReturnType: String(compilerCoreDeclarationRecordsFunctionReturnType(records: declarationRecords, name: functionName))
        if functionReturnType != String("") {
            return functionReturnType
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("member(")) {
        let baseSummary: String(compilerCoreMemberExpressionBase(summary: expressionSummary))
        let baseType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: baseSummary, expectedType: String("")))
        let memberName: String(compilerCoreMemberExpressionName(summary: expressionSummary))
        if baseType != String("Unknown") {
            let memberType: String(compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: baseType, memberName: memberName))
            if memberType != String("") {
                return memberType
            }
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    return String("Unknown")
}

function compilerCoreLookupLocalType(localTypes: String, name: String): String {
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: localTypes))
    let namePrefix: String("\(name):")
    let namePrefixLength: Int(stringLength(value: namePrefix))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: localTypes, start: sourceIndex, prefix: namePrefix) {
            let typeStart: Int(sourceIndex + namePrefixLength)
            state typeEnd: Int(0)
            typeEnd: typeStart
            while typeEnd < sourceLength && !hasRangePrefix(source: localTypes, start: typeEnd, prefix: String(";")) {
                typeEnd: typeEnd + 1
            }
            return localTypes.substring(start: typeStart, end: typeEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function parseCompilerTopLevelDeclarations(source: String): CompilerParsedDeclarations {
    return parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: source, includeFunctionBodies: false)
}

function parseCompilerTopLevelDeclarationsForLLVM(source: String): CompilerParsedDeclarations {
    return parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: source, bodyFunctionNames: String(""))
}

function parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: String, bodyFunctionNames: String): CompilerParsedDeclarations {
    state parsedDeclarations: CompilerParsedDeclarations(CompilerParsedDeclarations(records: String(""), declarationSummary: String(""), functionSummary: String(""), count: 0))
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))
        if maybeToken == nil {
            return parsedDeclarations
        }
        let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        let step: CompilerTopLevelDeclarationParseStep(compilerCoreParseTopLevelDeclarationStepForLLVM(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, token: token))
        parsedDeclarations: step.parsedDeclarations
        sourceIndex: step.nextIndex
    }

    return parsedDeclarations
}

function parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: String, includeFunctionBodies: Bool): CompilerParsedDeclarations {
    state parsedDeclarations: CompilerParsedDeclarations(CompilerParsedDeclarations(records: String(""), declarationSummary: String(""), functionSummary: String(""), count: 0))
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))
        if maybeToken == nil {
            return parsedDeclarations
        }
        let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        let step: CompilerTopLevelDeclarationParseStep(compilerCoreParseTopLevelDeclarationStep(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, token: token))
        parsedDeclarations: step.parsedDeclarations
        sourceIndex: step.nextIndex
    }

    return parsedDeclarations
}

function compilerCoreParseTopLevelDeclarationStepForLLVM(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    state tokenKind: String("")
    tokenKind: token.kind
    if tokenKind == String("keyword") {
        state tokenText: String("")
        tokenText: token.text
        if tokenText == String("construct") {
            return compilerCoreParseConstructDeclarationStepForLLVM(source: source, parsedDeclarations: parsedDeclarations, token: token)
        }

        if tokenText == String("function") {
            return compilerCoreParseFunctionDeclarationStepForLLVM(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, token: token)
        }
    }

    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
}

function compilerCoreParseConstructDeclarationStepForLLVM(source: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeConstruct: Optional<CompilerConstructDeclaration>(parseCompilerConstructDeclaration(source: source, keyword: token))
    if maybeConstruct == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let constructFallback: CompilerConstructDeclaration(CompilerConstructDeclaration(name: String(""), memberSummary: String(""), bodyStart: 0, bodyEnd: token.end))
    let constructDeclaration: CompilerConstructDeclaration(maybeConstruct ?? constructFallback)
    return compilerCoreParseConstructDeclarationStepForLLVMFromDeclaration(parsedDeclarations: parsedDeclarations, declaration: constructDeclaration)
}

function compilerCoreParseConstructDeclarationStepForLLVMFromDeclaration(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerConstructDeclaration): CompilerTopLevelDeclarationParseStep {
    let constructTopLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreConstructTopLevelDeclaration(declaration: declaration))
    let nextConstructDeclarations: CompilerParsedDeclarations(compilerCoreAppendDeclarationRecordOnly(parsedDeclarations: parsedDeclarations, declaration: constructTopLevelDeclaration))
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextConstructDeclarations, nextIndex: compilerCoreNextInt(value: declaration.bodyEnd))
}

function compilerCoreParseFunctionDeclarationStepForLLVM(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeFunction: Optional<CompilerFunctionDeclaration>(parseCompilerFunctionDeclaration(source: source, keyword: token))
    return compilerCoreParseFunctionDeclarationStepForLLVMMaybe(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, token: token, maybeFunction: maybeFunction)
}

function compilerCoreParseFunctionDeclarationStepForLLVMMaybe(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken, maybeFunction: Optional<CompilerFunctionDeclaration>): CompilerTopLevelDeclarationParseStep {
    if maybeFunction == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let functionFallback: CompilerFunctionDeclaration(CompilerFunctionDeclaration(name: String(""), parameterStart: 0, parameterEnd: 0, parameterSummary: String(""), returnType: String(""), bodyStart: 0, bodyEnd: token.end))
    let functionDeclaration: CompilerFunctionDeclaration(maybeFunction ?? functionFallback)
    return compilerCoreParseFunctionDeclarationStepForLLVMFromDeclaration(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, declaration: functionDeclaration)
}

function compilerCoreParseFunctionDeclarationStepForLLVMFromDeclaration(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclarationParseStep {
    let includeBody: Bool(compilerCoreNameListContains(names: bodyFunctionNames, name: declaration.name))
    return compilerCoreParseFunctionDeclarationStepForLLVMWithBodyMode(source: source, includeBody: includeBody, parsedDeclarations: parsedDeclarations, declaration: declaration)
}

function compilerCoreParseFunctionDeclarationStepForLLVMWithBodyMode(source: String, includeBody: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclarationParseStep {
    let topLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreFunctionTopLevelDeclaration(source: source, includeFunctionBodies: includeBody, parsedDeclarations: parsedDeclarations, declaration: declaration))
    let nextFunctionDeclarations: CompilerParsedDeclarations(compilerCoreAppendDeclarationRecordOnly(parsedDeclarations: parsedDeclarations, declaration: topLevelDeclaration))
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextFunctionDeclarations, nextIndex: compilerCoreNextInt(value: declaration.bodyEnd))
}

function compilerCoreAppendDeclarationRecordOnly(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerTopLevelDeclaration): CompilerParsedDeclarations {
    let declarationRecord: String(compilerCoreTopLevelDeclarationRecord(declaration: declaration))
    return CompilerParsedDeclarations(
        records: compilerCoreTextBufferConcat(left: parsedDeclarations.records, right: declarationRecord),
        declarationSummary: parsedDeclarations.declarationSummary,
        functionSummary: parsedDeclarations.functionSummary,
        count: compilerCoreNextInt(value: parsedDeclarations.count)
    )
}

function compilerCoreNextInt(value: Int): Int {
    return value + 1
}

function compilerCoreParseTopLevelDeclarationStep(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    state tokenKind: String("")
    tokenKind: token.kind
    state tokenText: String("")
    tokenText: token.text
    if tokenKind == String("keyword") {
        if tokenText == String("construct") {
            return compilerCoreParseConstructDeclarationStep(source: source, parsedDeclarations: parsedDeclarations, token: token)
        }

        if tokenText == String("function") {
            return compilerCoreParseFunctionDeclarationStep(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, token: token)
        }
    }

    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
}

function compilerCoreParseConstructDeclarationStep(source: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeConstruct: Optional<CompilerConstructDeclaration>(parseCompilerConstructDeclaration(source: source, keyword: token))
    if maybeConstruct == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let constructFallback: CompilerConstructDeclaration(CompilerConstructDeclaration(name: String(""), memberSummary: String(""), bodyStart: 0, bodyEnd: token.end))
    let constructDeclaration: CompilerConstructDeclaration(maybeConstruct ?? constructFallback)
    let constructTopLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreConstructTopLevelDeclaration(declaration: constructDeclaration))
    let nextParsedDeclarations: CompilerParsedDeclarations(compilerCoreAppendConstructDeclaration(parsedDeclarations: parsedDeclarations, declaration: constructTopLevelDeclaration))
    state nextIndex: Int(0)
    nextIndex: constructDeclaration.bodyEnd
    nextIndex: nextIndex + 1
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextParsedDeclarations, nextIndex: nextIndex)
}

function compilerCoreParseFunctionDeclarationStep(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeFunction: Optional<CompilerFunctionDeclaration>(parseCompilerFunctionDeclaration(source: source, keyword: token))
    if maybeFunction == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let functionFallback: CompilerFunctionDeclaration(CompilerFunctionDeclaration(name: String(""), parameterStart: 0, parameterEnd: 0, parameterSummary: String(""), returnType: String(""), bodyStart: 0, bodyEnd: token.end))
    let functionDeclaration: CompilerFunctionDeclaration(maybeFunction ?? functionFallback)
    return compilerCoreParseFunctionDeclarationStepFromDeclaration(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, declaration: functionDeclaration)
}

function compilerCoreParseFunctionDeclarationStepFromDeclaration(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclarationParseStep {
    let functionTopLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreFunctionTopLevelDeclaration(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, declaration: declaration))
    let nextParsedDeclarations: CompilerParsedDeclarations(compilerCoreAppendFunctionDeclaration(parsedDeclarations: parsedDeclarations, declaration: functionTopLevelDeclaration))
    state nextIndex: Int(0)
    nextIndex: declaration.bodyEnd
    nextIndex: nextIndex + 1
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextParsedDeclarations, nextIndex: nextIndex)
}

function compilerCoreConstructTopLevelDeclaration(declaration: CompilerConstructDeclaration): CompilerTopLevelDeclaration {
    return CompilerTopLevelDeclaration(
        kind: String("construct"),
        name: declaration.name,
        parameterStart: 0,
        parameterEnd: 0,
        parameterSummary: String(""),
        returnType: String(""),
        memberSummary: declaration.memberSummary,
        statementRecords: String(""),
        statementSummary: String(""),
        bodyStart: declaration.bodyStart,
        bodyEnd: declaration.bodyEnd
    )
}

function compilerCoreAppendConstructDeclaration(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerTopLevelDeclaration): CompilerParsedDeclarations {
    let declarationText: String(compilerCoreTopLevelDeclarationSummary(declaration: declaration))
    state nextCount: Int(0)
    nextCount: parsedDeclarations.count
    nextCount: nextCount + 1
    let declarationRecord: String(compilerCoreTopLevelDeclarationRecord(declaration: declaration))
    return CompilerParsedDeclarations(
        records: compilerCoreTextBufferConcat(left: parsedDeclarations.records, right: declarationRecord),
        declarationSummary: compilerCoreTextBufferConcat(left: parsedDeclarations.declarationSummary, right: declarationText),
        functionSummary: parsedDeclarations.functionSummary,
        count: nextCount
    )
}

function compilerCoreFunctionTopLevelDeclaration(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclaration {
    let parsedFunctionBody: CompilerParsedStatements(compilerCoreParseFunctionBodyStatements(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, declaration: declaration))
    return compilerCoreFunctionTopLevelDeclarationWithParsedBody(declaration: declaration, parsedFunctionBody: parsedFunctionBody)
}

function compilerCoreFunctionTopLevelDeclarationWithParsedBody(declaration: CompilerFunctionDeclaration, parsedFunctionBody: CompilerParsedStatements): CompilerTopLevelDeclaration {
    return CompilerTopLevelDeclaration(
        kind: String("function"),
        name: declaration.name,
        parameterStart: declaration.parameterStart,
        parameterEnd: declaration.parameterEnd,
        parameterSummary: declaration.parameterSummary,
        returnType: declaration.returnType,
        memberSummary: String(""),
        statementRecords: parsedFunctionBody.records,
        statementSummary: String(""),
        bodyStart: declaration.bodyStart,
        bodyEnd: declaration.bodyEnd
    )
}

function compilerCoreAppendFunctionDeclaration(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerTopLevelDeclaration): CompilerParsedDeclarations {
    let declarationText: String(compilerCoreTopLevelDeclarationSummary(declaration: declaration))
    state nextCount: Int(0)
    nextCount: parsedDeclarations.count
    nextCount: nextCount + 1
    let declarationRecord: String(compilerCoreTopLevelDeclarationRecord(declaration: declaration))
    return CompilerParsedDeclarations(
        records: compilerCoreTextBufferConcat(left: parsedDeclarations.records, right: declarationRecord),
        declarationSummary: compilerCoreTextBufferConcat(left: parsedDeclarations.declarationSummary, right: declarationText),
        functionSummary: compilerCoreTextBufferConcat(left: parsedDeclarations.functionSummary, right: declarationText),
        count: nextCount
    )
}

function compilerCoreParseFunctionBodyStatements(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerParsedStatements {
    state bodyStart: Int(0)
    bodyStart: declaration.bodyStart
    state bodyEnd: Int(0)
    bodyEnd: declaration.bodyEnd
    if !includeFunctionBodies {
        return compilerCoreEmptyParsedStatements(start: bodyStart, end: bodyEnd)
    }

    return compilerCoreParseIncludedFunctionBodyStatements(source: source, parsedDeclarations: parsedDeclarations, bodyStart: bodyStart, bodyEnd: bodyEnd)
}

function compilerCoreParseIncludedFunctionBodyStatements(source: String, parsedDeclarations: CompilerParsedDeclarations, bodyStart: Int, bodyEnd: Int): CompilerParsedStatements {
    let functionBlock: CompilerBlock(CompilerBlock(start: bodyStart, end: bodyEnd))
    let emptyParsedDeclarations: CompilerParsedDeclarations(CompilerParsedDeclarations(records: String(""), declarationSummary: String(""), functionSummary: String(""), count: 0))
    let functionProgram: CompilerProgram(compilerCoreProgramWithoutMain(source: source, parsedDeclarations: emptyParsedDeclarations))
    return compilerCoreParseStatements(program: functionProgram, block: functionBlock)
}

function compilerCoreEmptyParsedStatements(start: Int, end: Int): CompilerParsedStatements {
    return CompilerParsedStatements(records: String(""), summary: String(""), count: 0, start: start, end: end)
}

function compilerCoreTopLevelDeclarationRecord(declaration: CompilerTopLevelDeclaration): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    textBufferAppend(buffer: outputBuffer, text: "kind=\(declaration.kind)|name=\(declaration.name)|parameterStart=")
    textBufferAppendInt(buffer: outputBuffer, value: declaration.parameterStart)
    textBufferAppend(buffer: outputBuffer, text: String("|parameterEnd="))
    textBufferAppendInt(buffer: outputBuffer, value: declaration.parameterEnd)
    textBufferAppend(buffer: outputBuffer, text: "|parameters=\(declaration.parameterSummary)|returnType=\(declaration.returnType)|members=\(declaration.memberSummary)|statementRecords=")
    textBufferAppend(buffer: outputBuffer, text: compilerCoreStatementRecordEncodeValue(value: declaration.statementRecords))
    textBufferAppend(buffer: outputBuffer, text: String("|statementSummary=|bodyStart="))
    textBufferAppendInt(buffer: outputBuffer, value: declaration.bodyStart)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyEnd="))
    textBufferAppendInt(buffer: outputBuffer, value: declaration.bodyEnd)
    textBufferAppend(buffer: outputBuffer, text: compilerCoreTopLevelDeclarationRecordTerminator())
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreTopLevelDeclarationRecordTerminator(): String {
    return compilerCoreStatementRecordDecodeValue(value: String("@TILDE@"))
}

function compilerCoreTopLevelDeclarationRecordAt(records: String, start: Int): String {
    let terminator: String(compilerCoreTopLevelDeclarationRecordTerminator())
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: terminator))
    if recordEnd < 0 {
        return String("")
    }
    return stringViewFrom(source: records, start: start)
}

function compilerCoreTopLevelDeclarationRecordNextIndex(records: String, start: Int): Int {
    let terminator: String(compilerCoreTopLevelDeclarationRecordTerminator())
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: terminator))
    if recordEnd < 0 {
        return stringLength(value: records)
    }
    return recordEnd + 1
}

function compilerCoreTopLevelDeclarationFromRecord(record: String): CompilerTopLevelDeclaration {
    return CompilerTopLevelDeclaration(
        kind: compilerCoreRecordField(record: record, prefix: String("kind=")),
        name: compilerCoreRecordField(record: record, prefix: String("name=")),
        parameterStart: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("parameterStart="))),
        parameterEnd: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("parameterEnd="))),
        parameterSummary: compilerCoreRecordField(record: record, prefix: String("parameters=")),
        returnType: compilerCoreRecordField(record: record, prefix: String("returnType=")),
        memberSummary: compilerCoreRecordField(record: record, prefix: String("members=")),
        statementRecords: compilerCoreStatementRecordDecodeValue(value: compilerCoreRecordField(record: record, prefix: String("statementRecords="))),
        statementSummary: compilerCoreStatementRecordDecodeValue(value: compilerCoreRecordField(record: record, prefix: String("statementSummary="))),
        bodyStart: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("bodyStart="))),
        bodyEnd: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("bodyEnd=")))
    )
}

function compilerCoreTopLevelDeclarationSummary(declaration: CompilerTopLevelDeclaration): String {
    state declarationKind: String("")
    declarationKind: declaration.kind
    if declarationKind == String("construct") {
        return "ast\tconstruct\tname=\(declaration.name)\tmembers=[\(declaration.memberSummary)]\tbodyStart=\(declaration.bodyStart)\tbodyEnd=\(declaration.bodyEnd)\n"
    }

    if declarationKind == String("function") {
        return "ast\tfunction\tname=\(declaration.name)\tparametersStart=\(declaration.parameterStart)\tparametersEnd=\(declaration.parameterEnd)\tparameters=[\(declaration.parameterSummary)]\treturnType=\(declaration.returnType)\tbodyStart=\(declaration.bodyStart)\tbodyEnd=\(declaration.bodyEnd)\n"
    }

    return String("")
}

function compilerCoreDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.declarationSummary
}

function compilerCoreFunctionDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.functionSummary
}

function compilerCursorPeek(cursor: CompilerTokenCursor): Optional<RangeLexedToken> {
    return lexNextRangeToken(source: cursor.source, start: cursor.index)
}

function compilerCursorAdvance(cursor: CompilerTokenCursor, token: RangeLexedToken): CompilerTokenCursor {
    return CompilerTokenCursor(source: cursor.source, index: token.end)
}

function compilerFallbackToken(cursor: CompilerTokenCursor): RangeLexedToken {
    return RangeLexedToken(kind: String("eof"), start: cursor.index, end: cursor.index, text: String(""))
}

function compilerCoreParseBalancedRange(cursor: CompilerTokenCursor, leftKind: String, rightKind: String): Optional<CompilerSourceRange> {
    let maybeLeftToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeftToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let leftToken: RangeLexedToken(maybeLeftToken ?? fallbackToken)
    if leftToken.kind != leftKind {
        return nil
    }

    return compilerCoreParseBalancedRangeAfterLeft(cursor: cursor, leftToken: leftToken, leftKind: leftKind, rightKind: rightKind)
}

function compilerCoreParseBalancedRangeAfterLeft(cursor: CompilerTokenCursor, leftToken: RangeLexedToken, leftKind: String, rightKind: String): Optional<CompilerSourceRange> {
    let bodyCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: leftToken))
    return compilerCoreParseBalancedRangeScanning(cursor: bodyCursor, rangeStart: leftToken.end, leftKind: leftKind, rightKind: rightKind, depth: 1)
}

function compilerCoreParseBalancedRangeScanning(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, depth: Int): Optional<CompilerSourceRange> {
    state scanCursor: CompilerTokenCursor(cursor)
    state scanDepth: Int(depth)

    while true {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanCursor))
        if maybeToken == nil {
            return nil
        }

        let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanCursor))
        let token: RangeLexedToken(maybeToken ?? tokenFallback)
        if compilerCoreTokenKindEquals(token: token, kind: leftKind) {
            scanDepth: scanDepth + 1
        } else if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
            scanDepth: scanDepth - 1
            if scanDepth == 0 {
                return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
            }
        }
        scanCursor: compilerCursorAdvance(cursor: scanCursor, token: token)
    }

    return nil
}

function compilerCoreParseBalancedRangeScanningToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, depth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextDepth: Int(compilerCoreBalancedRangeNextDepth(token: token, leftKind: leftKind, rightKind: rightKind, depth: depth))
    return compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
        return compilerCoreParseBalancedRangeClosingToken(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
    }

    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreTokenKindEquals(token: RangeLexedToken, kind: String): Bool {
    let tokenKind: String(compilerCoreRangeTokenKind(token: token))
    return tokenKind == kind
}

function compilerCoreRangeTokenKind(token: RangeLexedToken): String {
    return token.kind
}

function compilerCoreRangeTokenText(token: RangeLexedToken): String {
    return token.text
}

function compilerCoreRangeTokenStart(token: RangeLexedToken): Int {
    return token.start
}

function compilerCoreParseBalancedRangeClosingToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if nextDepth == 0 {
        return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
    }
    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeContinue(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
    return compilerCoreParseBalancedRangeScanning(cursor: nextCursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, depth: nextDepth)
}

function compilerCoreBalancedRangeNextDepth(token: RangeLexedToken, leftKind: String, rightKind: String, depth: Int): Int {
    let tokenKind: String(compilerCoreRangeTokenKind(token: token))
    if tokenKind == leftKind {
        return depth + 1
    }
    if tokenKind == rightKind {
        return depth - 1
    }
    return depth
}

function compilerCoreParseTypeReference(cursor: CompilerTokenCursor): Optional<CompilerTypeReference> {
    let maybeFirstToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeFirstToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let firstToken: RangeLexedToken(maybeFirstToken ?? fallbackToken)
    if firstToken.kind != String("identifier") && firstToken.kind != String("leftBracket") {
        return nil
    }

    let initialState: CompilerTypeReferenceParseState(compilerCoreTypeReferenceInitialState(cursor: cursor, firstToken: firstToken))
    let parsedState: CompilerTypeReferenceParseState(compilerCoreParseTypeReferenceScanning(parseState: initialState))
    return compilerCoreTypeReferenceFromState(firstToken: firstToken, parseState: parsedState)
}

function compilerCoreTypeReferenceInitialState(cursor: CompilerTokenCursor, firstToken: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: cursor.index))
    return CompilerTypeReferenceParseState(output: String(""), typeEnd: firstToken.start, cursor: cursorState, genericDepth: 0, arrayDepth: 0, consumedToken: false, keepScanning: true)
}

function compilerCoreParseTypeReferenceScanning(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    state scanState: CompilerTypeReferenceParseState(CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: parseState.keepScanning))
    while scanState.keepScanning {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanState.cursor))
        if maybeToken == nil {
            scanState: compilerCoreTypeReferenceStop(parseState: scanState)
        } else {
            let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanState.cursor))
            let token: RangeLexedToken(maybeToken ?? tokenFallback)
            scanState: compilerCoreParseTypeReferenceToken(parseState: scanState, token: token)
        }
    }
    return scanState
}

function compilerCoreTypeReferenceFromState(firstToken: RangeLexedToken, parseState: CompilerTypeReferenceParseState): Optional<CompilerTypeReference> {
    if !parseState.consumedToken {
        return nil
    }

    if parseState.genericDepth != 0 {
        return nil
    }

    if parseState.arrayDepth != 0 {
        return nil
    }

    return CompilerTypeReference(text: parseState.output, start: firstToken.start, end: parseState.typeEnd)
}

function compilerCoreParseTypeReferenceToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == String("identifier") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == String("dot") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("."), genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == String("less") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("<"), genericDelta: 1, arrayDelta: 0)
    }
    return compilerCoreParseTypeReferenceTokenPunctuation(parseState: parseState, token: token)
}

function compilerCoreParseTypeReferenceTokenPunctuation(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == String("greater") {
        return compilerCoreTypeReferenceCloseGeneric(parseState: parseState, token: token)
    }
    if token.kind == String("leftBracket") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("["), genericDelta: 0, arrayDelta: 1)
    }
    if token.kind == String("rightBracket") {
        return compilerCoreTypeReferenceCloseArray(parseState: parseState, token: token)
    }
    if token.kind == String("comma") {
        return compilerCoreTypeReferenceComma(parseState: parseState, token: token)
    }
    if token.kind == String("question") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("?"), genericDelta: 0, arrayDelta: 0)
    }
    return compilerCoreTypeReferenceStop(parseState: parseState)
}

function compilerCoreTypeReferenceAppend(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken, text: String, genericDelta: Int, arrayDelta: Int): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)\(text)", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth + genericDelta, arrayDepth: parseState.arrayDepth + arrayDelta, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseGeneric(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseGenericToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseArray(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseArrayToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseGenericToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)>", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth - 1, arrayDepth: parseState.arrayDepth, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseArrayToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)]", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth - 1, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceComma(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 && parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String(","), genericDelta: 0, arrayDelta: 0)
}

function compilerCoreTypeReferenceStop(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: false)
}

function parseCompilerCallArguments(source: String, start: Int, end: Int): CompilerCallArguments {
    state output: String("")
    state records: String("")
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    state argumentIndex: Int(0)

    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.start >= end {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        if token.kind == String("comma") {
            cursor: compilerCursorAdvance(cursor: cursor, token: token)
        } else {
            state label: String("")
            state expressionStart: Int(0)
            expressionStart: token.start
            if token.kind == String("identifier") || token.kind == String("keyword") {
                let afterLabelCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
                let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterLabelCursor))
                if maybeColon != nil {
                    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: afterLabelCursor))
                    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
                    if colonToken.kind == String("colon") {
                        label: token.text
                        expressionStart: colonToken.end
                    }
                }
            }

            let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: source, start: expressionStart, limit: end))
            if maybeExpression == nil {
                return CompilerCallArguments(summary: output, records: records, start: start, end: end)
            }
            let expressionFallback: CompilerExpression(compilerCoreMissingExpression(start: expressionStart))
            let expression: CompilerExpression(maybeExpression ?? expressionFallback)
            if label == String("") {
                output: "\(output)argument\(argumentIndex)=\(expression.summary);"
            } else {
                output: "\(output)argument\(argumentIndex).\(label)=\(expression.summary);"
            }
            records: "\(records)\(compilerCoreCallArgumentRecord(index: argumentIndex, label: label, expressionRecord: expression.record, expressionSummary: expression.summary))"
            argumentIndex: argumentIndex + 1
            cursor: CompilerTokenCursor(source: source, index: expression.end)
        }
    }

    return CompilerCallArguments(summary: output, records: records, start: start, end: end)
}

function parseCompilerFunctionParameters(source: String, start: Int, end: Int): CompilerFunctionParameters {
    let initialCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let initialState: CompilerFunctionParameterParseState(CompilerFunctionParameterParseState(output: String(""), cursor: initialCursor, parameterIndex: 0, keepScanning: true, start: start, end: end))
    let parsedState: CompilerFunctionParameterParseState(parseCompilerFunctionParametersScanning(parseState: initialState))
    return CompilerFunctionParameters(summary: parsedState.output, start: start, end: end)
}

function parseCompilerFunctionParametersScanning(parseState: CompilerFunctionParameterParseState): CompilerFunctionParameterParseState {
    state scanState: CompilerFunctionParameterParseState(CompilerFunctionParameterParseState(output: parseState.output, cursor: parseState.cursor, parameterIndex: parseState.parameterIndex, keepScanning: parseState.keepScanning, start: parseState.start, end: parseState.end))
    while scanState.keepScanning && scanState.cursor.index < scanState.end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanState.cursor))
        if maybeToken == nil {
            scanState: parseCompilerFunctionParametersDone(parseState: scanState)
        } else {
            let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: scanState.cursor))
            let token: RangeLexedToken(maybeToken ?? fallbackToken)
            scanState: parseCompilerFunctionParametersToken(parseState: scanState, token: token)
        }
    }
    return scanState
}

function parseCompilerFunctionParametersToken(parseState: CompilerFunctionParameterParseState, token: RangeLexedToken): CompilerFunctionParameterParseState {
    if token.start >= parseState.end {
        return parseCompilerFunctionParametersDone(parseState: parseState)
    }
    if token.kind == String("comma") {
        let nextCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
        return parseCompilerFunctionParametersWithCursor(parseState: parseState, cursor: nextCursor)
    }
    if token.kind == String("identifier") || token.kind == String("keyword") {
        return parseCompilerFunctionParameterNamed(parseState: parseState, nameToken: token)
    }
    let fallbackCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return parseCompilerFunctionParametersWithCursor(parseState: parseState, cursor: fallbackCursor)
}

function parseCompilerFunctionParameterNamed(parseState: CompilerFunctionParameterParseState, nameToken: RangeLexedToken): CompilerFunctionParameterParseState {
    let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: nameToken))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return parseCompilerFunctionParametersDone(parseState: parseState)
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    return parseCompilerFunctionParameterColon(parseState: parseState, nameToken: nameToken, colonCursor: colonCursor, colonToken: colonToken)
}

function parseCompilerFunctionParameterColon(parseState: CompilerFunctionParameterParseState, nameToken: RangeLexedToken, colonCursor: CompilerTokenCursor, colonToken: RangeLexedToken): CompilerFunctionParameterParseState {
    if colonToken.kind != String("colon") {
        return parseCompilerFunctionParametersDone(parseState: parseState)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return parseCompilerFunctionParametersDone(parseState: parseState)
    }

    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    return parseCompilerFunctionParameterAppending(parseState: parseState, nameToken: nameToken, typeReference: typeReference)
}

function parseCompilerFunctionParameterAppending(parseState: CompilerFunctionParameterParseState, nameToken: RangeLexedToken, typeReference: CompilerTypeReference): CompilerFunctionParameterParseState {
    let output: String("\(parseState.output)parameter\(parseState.parameterIndex).name=\(nameToken.text),type=\(typeReference.text);")
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: parseState.cursor.source, index: typeReference.end))
    return CompilerFunctionParameterParseState(output: output, cursor: cursor, parameterIndex: parseState.parameterIndex + 1, keepScanning: true, start: parseState.start, end: parseState.end)
}

function parseCompilerFunctionParametersWithCursor(parseState: CompilerFunctionParameterParseState, cursor: CompilerTokenCursor): CompilerFunctionParameterParseState {
    return CompilerFunctionParameterParseState(output: parseState.output, cursor: cursor, parameterIndex: parseState.parameterIndex, keepScanning: parseState.keepScanning, start: parseState.start, end: parseState.end)
}

function parseCompilerFunctionParametersDone(parseState: CompilerFunctionParameterParseState): CompilerFunctionParameterParseState {
    return CompilerFunctionParameterParseState(output: parseState.output, cursor: parseState.cursor, parameterIndex: parseState.parameterIndex, keepScanning: false, start: parseState.start, end: parseState.end)
}

function parseCompilerConstructMembers(source: String, start: Int, end: Int): CompilerConstructMembers {
    state output: String("")
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    state memberIndex: Int(0)

    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            return CompilerConstructMembers(summary: output, start: start, end: end)
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.start >= end {
            return CompilerConstructMembers(summary: output, start: start, end: end)
        }

        if token.kind == String("keyword") && token.text == String("let") {
            let nameCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
            let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: nameCursor))
            if maybeName == nil {
                return CompilerConstructMembers(summary: output, start: start, end: end)
            }

            let nameFallback: RangeLexedToken(compilerFallbackToken(cursor: nameCursor))
            let nameToken: RangeLexedToken(maybeName ?? nameFallback)
            if nameToken.kind != String("identifier") {
                cursor: compilerCursorAdvance(cursor: cursor, token: token)
            } else {
                let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: nameCursor, token: nameToken))
                let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
                if maybeColon == nil {
                    return CompilerConstructMembers(summary: output, start: start, end: end)
                }

                let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
                let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
                if colonToken.kind != String("colon") {
                    cursor: compilerCursorAdvance(cursor: cursor, token: token)
                } else {
                    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
                    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
                    if maybeType == nil {
                        return CompilerConstructMembers(summary: output, start: start, end: end)
                    }

                    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
                    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
                    output: "\(output)member\(memberIndex).name=\(nameToken.text),type=\(typeReference.text);"
                    memberIndex: memberIndex + 1
                    cursor: CompilerTokenCursor(source: source, index: typeReference.end)
                }
            }
        } else {
            cursor: compilerCursorAdvance(cursor: cursor, token: token)
        }
    }

    return CompilerConstructMembers(summary: output, start: start, end: end)
}

function compilerCoreParseDeclarationNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.start))
    cursor: CompilerTokenCursor(source: source, index: keyword.end)
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    state nameKind: String("")
    nameKind: nameToken.kind
    if nameKind != String("identifier") {
        return nil
    }

    return nameToken
}

function compilerCoreParseBodyRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: String("leftBrace"), rightKind: String("rightBrace"))
}

function compilerCoreParseParameterRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: String("leftParen"), rightKind: String("rightParen"))
}

function compilerCoreParseReturnTypeAfterParameters(source: String, parameterRange: CompilerSourceRange): Optional<CompilerTypeReference> {
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterRange.start))
    cursor: CompilerTokenCursor(source: source, index: parameterRange.next)
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeColon == nil {
        return nil
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    state colonKind: String("")
    colonKind: colonToken.kind
    if colonKind != String("colon") {
        return nil
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: colonToken))
    return compilerCoreParseTypeReference(cursor: typeCursor)
}

function compilerCoreParseFunctionBodyAfterReturnType(source: String, returnType: CompilerTypeReference): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: returnType.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: String("leftBrace"), rightKind: String("rightBrace"))
}

function compilerCoreFunctionDeclarationFromParts(nameToken: RangeLexedToken, parameterRange: CompilerSourceRange, parameters: CompilerFunctionParameters, returnType: CompilerTypeReference, bodyRange: CompilerSourceRange): CompilerFunctionDeclaration {
    return CompilerFunctionDeclaration(
        name: nameToken.text,
        parameterStart: parameterRange.start,
        parameterEnd: parameterRange.end,
        parameterSummary: parameters.summary,
        returnType: returnType.text,
        bodyStart: bodyRange.start,
        bodyEnd: bodyRange.end
    )
}

function compilerCoreParseFunctionDeclarationAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerFunctionDeclaration> {
    let maybeParameters: Optional<CompilerSourceRange>(compilerCoreParseParameterRangeAfterName(source: source, nameToken: nameToken))
    if maybeParameters == nil {
        return nil
    }

    let parameterFallback: CompilerSourceRange(CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end))
    let parameterRange: CompilerSourceRange(maybeParameters ?? parameterFallback)
    let parameters: CompilerFunctionParameters(parseCompilerFunctionParameters(source: source, start: parameterRange.start, end: parameterRange.end))
    return compilerCoreParseFunctionDeclarationAfterParameters(source: source, nameToken: nameToken, parameterRange: parameterRange, parameters: parameters)
}

function compilerCoreParseFunctionDeclarationAfterParameters(source: String, nameToken: RangeLexedToken, parameterRange: CompilerSourceRange, parameters: CompilerFunctionParameters): Optional<CompilerFunctionDeclaration> {
    let maybeReturnType: Optional<CompilerTypeReference>(compilerCoreParseReturnTypeAfterParameters(source: source, parameterRange: parameterRange))
    if maybeReturnType == nil {
        return nil
    }

    let returnTypeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: parameterRange.next, end: parameterRange.next))
    let returnType: CompilerTypeReference(maybeReturnType ?? returnTypeFallback)
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseFunctionBodyAfterReturnType(source: source, returnType: returnType))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: returnType.end, end: returnType.end, next: returnType.end))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    return compilerCoreFunctionDeclarationFromParts(nameToken: nameToken, parameterRange: parameterRange, parameters: parameters, returnType: returnType, bodyRange: bodyRange)
}

function parseCompilerConstructDeclaration(source: String, keyword: RangeLexedToken): Optional<CompilerConstructDeclaration> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBodyRangeAfterName(source: source, nameToken: nameToken))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    let members: CompilerConstructMembers(parseCompilerConstructMembers(source: source, start: bodyRange.start, end: bodyRange.end))
    return CompilerConstructDeclaration(
        name: nameToken.text,
        memberSummary: members.summary,
        bodyStart: bodyRange.start,
        bodyEnd: bodyRange.end
    )
}

function parseCompilerFunctionDeclaration(source: String, keyword: RangeLexedToken): Optional<CompilerFunctionDeclaration> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    return compilerCoreParseFunctionDeclarationAfterName(source: source, nameToken: nameToken)
}

function compilerCoreLLVM(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreLLVMForProgram(program: program)
}

function compilerCoreLLVMForProgram(program: CompilerProgram): String {
    let moduleText: String(compilerCoreLLVMTextForProgram(program: program))
    if moduleText == String("") {
        return String("")
    }

    return "compilerCoreLLVM\tmain\ncompilerCoreLLVMText\t\(moduleText)\n"
}

function compilerCoreLLVMTextForProgram(program: CompilerProgram): String {
    if !program.hasMainBlock {
        return String("")
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlock(program: program, parsedBlock: parsedBlock))
    let module: CompilerLLVMModule(compilerCoreLLVMModule(program: program, block: loweredBlock))
    let renderedText: String(compilerCoreRenderLLVMModule(module: module))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: renderedText))
    if placeholderCount > 0 {
        return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: renderedText)
    }
    return compilerCoreMaterializeLLVMText(text: renderedText)
}

function compilerCoreLLVMEntryTextForProgram(program: CompilerProgram): String {
    if !program.hasMainBlock {
        return String("")
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    return compilerCoreLLVMEntryTextForParsedBlock(program: program, parsedBlock: parsedBlock)
}

function compilerCoreLLVMSourceSetEntryTextForProgram(program: CompilerProgram): String {
    if !program.hasMainBlock {
        return String("")
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    let text: String(compilerCoreLLVMSourceSetEntryTextForParsedBlock(program: program, parsedBlock: parsedBlock))
    return compilerCoreMaterializeLLVMText(text: text)
}

function compilerCoreLLVMSourceSetEntryTextForParsedBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock): String {
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlock(program: program, parsedBlock: parsedBlock))
    let reachableFunctions: String(compilerCoreLLVMSourceSetExplicitReachableFunctions(program: program, parsedBlock: parsedBlock))
    return compilerCoreLLVMEntryTextForLoweredBlock(program: program, loweredBlock: loweredBlock, reachableFunctions: reachableFunctions)
}

function compilerCoreLLVMSourceSetExplicitReachableFunctions(program: CompilerProgram, parsedBlock: CompilerParsedBlock): String {
    let directlyCalledFunctions: String(compilerCoreStatementRecordsCalledFunctionNames(records: parsedBlock.statementRecords))
    let directLoweringFunctions: String("\(compilerSourceSetBodyFunctionNamesMainASTLoweringDirect())\(compilerSourceSetBodyFunctionNamesMainASTLoweringLinear())\(compilerSourceSetBodyFunctionNamesMainASTLoweringLinearKinds())")
    let roots: String(compilerCoreNameListAppendingMissing(names: directlyCalledFunctions, additionalNames: directLoweringFunctions))
    return compilerCoreReachableFunctionNames(program: program, roots: roots)
}

function compilerNativeSourceSetParseStats(source: String): String {
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    return "nativeSourceSetStats\tphase=parse\tdeclarationRecordsLength=\(stringLength(value: program.declarationRecords))\thasMainBlock=\(program.hasMainBlock)\n"
}

function compilerNativeSourceSetReachableStats(source: String): String {
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let names: String(compilerCoreLLVMNativeEntryReachableFunctions(program: program))
    return "nativeSourceSetStats\tphase=reachable\tnamesLength=\(stringLength(value: names))\tdeclarationRecordsLength=\(stringLength(value: program.declarationRecords))\n"
}

function compilerNativeSourceSetSelectedStats(source: String): String {
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let names: String(compilerCoreLLVMNativeEntryReachableFunctions(program: program))
    let selected: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctions(program: program, names: names))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: selected.renderedFunctions))
    return "nativeSourceSetStats\tphase=selected\trenderedLength=\(stringLength(value: selected.renderedFunctions))\tinstructionRecordsLength=\(stringLength(value: selected.instructionRecords))\tplaceholderCount=\(placeholderCount)\tnamesLength=\(stringLength(value: names))\tdeclarationRecordsLength=\(stringLength(value: program.declarationRecords))\n"
}

function compilerNativeSourceSetSelectedScanStats(source: String): String {
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let names: String(compilerCoreLLVMNativeEntryReachableFunctions(program: program))
    let audit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAudit(program: program, names: names))
    let selected: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctions(program: program, names: names))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: selected.renderedFunctions))
    let recordsLength: Int(stringLength(value: program.declarationRecords))
    return "nativeSourceSetStats\tphase=selectedScan\tselectedCount=\(audit.selectedCount)\tlowerableCount=\(audit.lowerableCount)\texcludedCount=\(audit.excludedCount)\tplaceholderCount=\(placeholderCount)\tmaxBodyLength=\(audit.maxBodyLength)\tmaxBodyName=\(audit.maxBodyName)\tnamesLength=\(stringLength(value: names))\tdeclarationRecordsLength=\(recordsLength)\n\(audit.details)"
}

function compilerCoreLLVMSelectedHelperAudit(program: CompilerProgram, names: String): CompilerLLVMHelperAudit {
    let empty: CompilerLLVMHelperAudit(CompilerLLVMHelperAudit(selectedCount: 0, lowerableCount: 0, excludedCount: 0, maxBodyLength: 0, maxBodyName: String(""), details: String("")))
    return compilerCoreLLVMSelectedHelperAuditFromIndex(program: program, names: names, sourceIndex: 0, recordsLength: stringLength(value: program.declarationRecords), audit: empty)
}

function compilerCoreLLVMSelectedHelperAuditFromIndex(program: CompilerProgram, names: String, sourceIndex: Int, recordsLength: Int, audit: CompilerLLVMHelperAudit): CompilerLLVMHelperAudit {
    if sourceIndex >= recordsLength {
        return audit
    }
    let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
    if record == String("") {
        return audit
    }
    let nextAudit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAuditAppendingRecord(audit: audit, names: names, record: record))
    let nextIndex: Int(compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex))
    return compilerCoreLLVMSelectedHelperAuditFromIndex(program: program, names: names, sourceIndex: nextIndex, recordsLength: recordsLength, audit: nextAudit)
}

function compilerCoreLLVMSelectedHelperAuditAppendingRecord(audit: CompilerLLVMHelperAudit, names: String, record: String): CompilerLLVMHelperAudit {
    let kind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let name: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if kind != String("function") || !compilerCoreNameListContains(names: names, name: name) {
        return audit
    }
    return compilerCoreLLVMSelectedHelperAuditAppendingDeclaration(audit: audit, declaration: compilerCoreTopLevelDeclarationFromRecord(record: record))
}

function compilerCoreLLVMSelectedHelperAuditAppendingDeclaration(audit: CompilerLLVMHelperAudit, declaration: CompilerTopLevelDeclaration): CompilerLLVMHelperAudit {
    state bodyEnd: Int(0)
    bodyEnd: declaration.bodyEnd
    state bodyStart: Int(0)
    bodyStart: declaration.bodyStart
    let bodyLength: Int(bodyEnd - bodyStart)
    let reason: String(compilerCoreSelectedHelperExclusionReason(declaration: declaration))
    state maxLength: Int(0)
    maxLength: audit.maxBodyLength
    state maxName: String("")
    maxName: audit.maxBodyName
    if bodyLength > maxLength {
        maxLength: bodyLength
        maxName: declaration.name
    }
    if reason == String("") {
        return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount + 1, excludedCount: audit.excludedCount, maxBodyLength: maxLength, maxBodyName: maxName, details: audit.details)
    }
    let detail: String("excluded\tname=\(declaration.name)\treason=\(reason)\tbodyLength=\(bodyLength)\n")
    return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount, excludedCount: audit.excludedCount + 1, maxBodyLength: maxLength, maxBodyName: maxName, details: "\(audit.details)\(detail)")
}

function compilerCoreLLVMHelperAuditFailure(audit: CompilerLLVMHelperAudit): String {
    return "compilerError\tkind=unsupportedReachableHelpers\tselectedCount=\(audit.selectedCount)\tlowerableCount=\(audit.lowerableCount)\texcludedCount=\(audit.excludedCount)\n\(audit.details)"
}

function compilerCoreLLVMPlaceholderCount(text: String): Int {
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    state sourceIndex: Int(0)
    state count: Int(0)

    while sourceIndex >= 0 {
        let matchIndex: Int(stringFindFrom(source: text, start: sourceIndex, needle: marker))
        if matchIndex < 0 {
            return count
        }
        count: count + 1
        sourceIndex: matchIndex + markerLength
    }

    return count
}

function compilerCoreLLVMPlaceholderDetails(text: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 4096))
    let materializedText: String(compilerCoreMaterializeLLVMText(text: text))
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    let textLength: Int(stringLength(value: materializedText))
    state sourceIndex: Int(0)
    state currentFunction: String("")

    while sourceIndex < textLength {
        state lineEnd: Int(stringFindFirstOf(source: materializedText, start: sourceIndex, characters: compilerCoreNewlineCharacter()))
        if lineEnd < 0 {
            lineEnd: textLength
        }
        let line: String(materializedText.substring(start: sourceIndex, end: lineEnd))
        if stringHasPrefix(source: line, start: 0, prefix: String("define ")) {
            let nameStart: Int(stringFindFrom(source: line, start: 0, needle: String("@")))
            let nameEnd: Int(stringFindFrom(source: line, start: nameStart + 1, needle: String("(")))
            if nameStart >= 0 && nameEnd > nameStart {
                currentFunction: line.substring(start: nameStart + 1, end: nameEnd)
            }
        }
        let markerStart: Int(stringFindFrom(source: line, start: 0, needle: marker))
        if markerStart >= 0 {
            state reasonStart: Int(markerStart + markerLength)
            while reasonStart < stringLength(value: line) && stringHasPrefix(source: line, start: reasonStart, prefix: String(" ")) {
                reasonStart: reasonStart + 1
            }
            let reason: String(line.substring(start: reasonStart, end: stringLength(value: line)))
            textBufferAppend(buffer: outputBuffer, text: "placeholder\tfunction=\(currentFunction)\treason=\(reason)")
            textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
        }
        sourceIndex: lineEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMPlaceholderFailure(placeholderCount: Int, renderedText: String): String {
    let details: String(compilerCoreLLVMPlaceholderDetails(text: renderedText))
    return "compilerError\tkind=unsupportedReachableLowering\tplaceholderCount=\(placeholderCount)\(compilerCoreNewlineCharacter())\(details)"
}

function compilerCoreLLVMNativeEntryTextForProgram(program: CompilerProgram): String {
    let reachableFunctions: String(compilerCoreLLVMNativeEntryReachableFunctions(program: program))
    let audit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAudit(program: program, names: reachableFunctions))
    if audit.excludedCount > 0 {
        return compilerCoreLLVMHelperAuditFailure(audit: audit)
    }
    let selectedHelperFunctions: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctions(program: program, names: reachableFunctions))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: selectedHelperFunctions.renderedFunctions))
    if placeholderCount > 0 {
        return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: selectedHelperFunctions.renderedFunctions)
    }
    let globalText: String(compilerCoreRenderLLVMGlobalRecords(records: selectedHelperFunctions.instructionRecords))
    let runtimeDeclarations: String(compilerCoreRenderLLVMRuntimeDeclarations(records: selectedHelperFunctions.instructionRecords))
    let declarations: String(compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: reachableFunctions))
    let text: String(compilerCoreLLVMNativeEntryTextFromParts(usage: compilerCoreNativeMainUsageGlobalLLVMText(), globals: globalText, runtime: runtimeDeclarations, helpers: selectedHelperFunctions.renderedFunctions, declarations: declarations, main: compilerCoreNativeMainLLVMText()))
    return compilerCoreMaterializeLLVMText(text: text)
}

function compilerCoreLLVMNativeEntryTextFromParts(usage: String, globals: String, runtime: String, helpers: String, declarations: String, main: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    textBufferAppend(buffer: outputBuffer, text: usage)
    textBufferAppend(buffer: outputBuffer, text: globals)
    textBufferAppend(buffer: outputBuffer, text: runtime)
    textBufferAppend(buffer: outputBuffer, text: helpers)
    textBufferAppend(buffer: outputBuffer, text: declarations)
    textBufferAppend(buffer: outputBuffer, text: main)
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMNativeEntryReachableFunctions(program: CompilerProgram): String {
    let nativeRenderFunctions: String("compilerCoreLLVMFunctionParameterText;compilerCoreTopLevelDeclarationRecordAt;compilerCoreTopLevelDeclarationRecordNextIndex;")
    let roots: String(compilerCoreNameListAppendingMissing(names: String("compileRangeNativeSource;"), additionalNames: nativeRenderFunctions))
    return compilerCoreNameListAppendingMissing(names: roots, additionalNames: compilerSourceSetBodyFunctionNames())
}

function compilerCoreNativeMainUsageGlobalLLVMText(): String {
    return String("")
}

function compilerCoreNativeMainLLVMText(): String {
    let newlineValue: String("
")
    let newline: String(newlineValue.substring(start: 0, end: 1))
    let atSign: String("@")
    state output: String("")
    output: "define i32 \(atSign)main() {\(newline)"
    output: "\(output)entry:\(newline)"
    output: "\(output)  %r0 = call i32 \(atSign)commandLineArgumentCount()\(newline)"
    output: "\(output)  %r1 = icmp ne i32 %r0, 1\(newline)"
    output: "\(output)  br i1 %r1, label %if0, label %after0\(newline)"
    output: "\(output)if0:\(newline)"
    output: "\(output)  ret i32 64\(newline)"
    output: "\(output)after0:\(newline)"
    output: "\(output)  %r3 = call ptr \(atSign)commandLineArgument(i32 0)\(newline)"
    output: "\(output)  %r4 = call ptr \(atSign)readFile(ptr %r3)\(newline)"
    output: "\(output)  %r5 = call ptr \(atSign)compileRangeNativeSource(ptr %r4)\(newline)"
    output: "\(output)  %r6 = call i32 \(atSign)puts(ptr %r5)\(newline)"
    output: "\(output)  ret i32 0\(newline)"
    output: "\(output)}\(newline)"
    return output
}

function compilerCoreLLVMEntryTextForParsedBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock): String {
    let reachableFunctions: String(compilerCoreLLVMEntryReachableFunctions(program: program, parsedBlock: parsedBlock))
    let audit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAudit(program: program, names: reachableFunctions))
    if audit.excludedCount > 0 {
        return compilerCoreLLVMHelperAuditFailure(audit: audit)
    }
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlock(program: program, parsedBlock: parsedBlock))
    let text: String(compilerCoreLLVMEntryTextForLoweredBlock(program: program, loweredBlock: loweredBlock, reachableFunctions: reachableFunctions))
    return compilerCoreMaterializeLLVMText(text: text)
}

function compilerCoreLLVMEntryReachableFunctions(program: CompilerProgram, parsedBlock: CompilerParsedBlock): String {
    let directlyCalledFunctions: String(compilerCoreStatementRecordsCalledFunctionNames(records: parsedBlock.statementRecords))
    let directLoweringFunctions: String("\(compilerSourceSetBodyFunctionNamesMainASTLoweringDirect())\(compilerSourceSetBodyFunctionNamesMainASTLoweringLinear())\(compilerSourceSetBodyFunctionNamesMainASTLoweringLinearKinds())")
    let roots: String(compilerCoreNameListAppendingMissing(names: directlyCalledFunctions, additionalNames: directLoweringFunctions))
    return compilerCoreReachableFunctionNames(program: program, roots: roots)
}

function compilerCoreLLVMEntryTextForLoweredBlock(program: CompilerProgram, loweredBlock: CompilerLLVMLoweredBlock, reachableFunctions: String): String {
    let selectedHelperFunctions: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctions(program: program, names: reachableFunctions))
    let module: CompilerLLVMModule(compilerCoreLLVMEntryModule(program: program, block: loweredBlock, selectedHelperFunctions: selectedHelperFunctions, reachableFunctions: reachableFunctions))
    let renderedText: String(compilerCoreRenderLLVMModule(module: module))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: renderedText))
    if placeholderCount > 0 {
        return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: renderedText)
    }
    return renderedText
}

function compilerCoreLLVMEntryModule(program: CompilerProgram, block: CompilerLLVMLoweredBlock, selectedHelperFunctions: CompilerLLVMHelperFunctions, reachableFunctions: String): CompilerLLVMModule {
    let mainBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    let mainFunction: CompilerLLVMFunction(CompilerLLVMFunction(
        name: String("main"),
        returnType: String("i32"),
        parameterText: String(""),
        renderedBlocks: block.renderedBlocks,
        block: mainBlock
    ))
    return CompilerLLVMModule(
        helperFunctions: "\(selectedHelperFunctions.renderedFunctions)\(compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: reachableFunctions))",
        instructionRecords: "\(selectedHelperFunctions.instructionRecords)\(block.instructionRecords)",
        mainFunction: mainFunction
    )
}

function compilerCoreLLVMModule(program: CompilerProgram, block: CompilerLLVMLoweredBlock): CompilerLLVMModule {
    let helperFunctions: CompilerLLVMHelperFunctions(compilerCoreLLVMHelperFunctions(program: program))
    let mainBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    let mainFunction: CompilerLLVMFunction(CompilerLLVMFunction(
        name: String("main"),
        returnType: String("i32"),
        parameterText: String(""),
        renderedBlocks: block.renderedBlocks,
        block: mainBlock
    ))
    return CompilerLLVMModule(
        helperFunctions: helperFunctions.renderedFunctions,
        instructionRecords: "\(helperFunctions.instructionRecords)\(block.instructionRecords)",
        mainFunction: mainFunction
    )
}

function compilerCoreMainLLVM(block: CompilerLLVMLoweredBlock): String {
    let fallbackProgram: CompilerProgram(CompilerProgram(source: String(""), hasMainBlock: false, mainAttributeStart: 0, mainBlock: block.block, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: block.declarationRecords, declarationSummary: String(""), functionSummary: block.functionSummary))
    let module: CompilerLLVMModule(compilerCoreLLVMModule(program: fallbackProgram, block: block))
    return compilerCoreRenderLLVMModule(module: module)
}

function compilerCoreLLVMHelperFunctions(program: CompilerProgram): CompilerLLVMHelperFunctions {
    state renderedFunctions: String("")
    state instructionRecords: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
        if record == String("") {
            return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords)
        }

            let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
            if declaration.kind == String("function") {
                let loweredFunction: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerHelperFunction(program: program, declaration: declaration, initialTemporaryIndex: sourceIndex))
                let renderedFunction: String(compilerCoreRenderLLVMHelperFunction(declaration: declaration, block: loweredFunction))
                renderedFunctions: "\(renderedFunctions)\(renderedFunction)"
                instructionRecords: "\(instructionRecords)\(compilerCoreLLVMGlobalRecords(records: loweredFunction.instructionRecords))"
            }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex)
    }

    return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords)
}

function compilerCoreDeclarationLookupRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    state sourceIndex: Int(0)

    while sourceIndex >= 0 {
        let recordEnd: Int(stringFindFirstOf(source: records, start: sourceIndex, characters: String("~")))
        if recordEnd < 0 {
            return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
        }
        let record: String(stringViewFrom(source: records, start: sourceIndex))
        textBufferAppend(buffer: outputBuffer, text: compilerCoreDeclarationLookupRecord(record: record))
        sourceIndex: recordEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreDeclarationLookupRecord(record: String): String {
    let declaration: CompilerTopLevelDeclaration(CompilerTopLevelDeclaration(
        kind: compilerCoreRecordField(record: record, prefix: String("kind=")),
        name: compilerCoreRecordField(record: record, prefix: String("name=")),
        parameterStart: 0,
        parameterEnd: 0,
        parameterSummary: compilerCoreRecordField(record: record, prefix: String("parameters=")),
        returnType: compilerCoreRecordField(record: record, prefix: String("returnType=")),
        memberSummary: compilerCoreRecordField(record: record, prefix: String("members=")),
        statementRecords: String(""),
        statementSummary: String(""),
        bodyStart: 0,
        bodyEnd: 0
    ))
    return compilerCoreTopLevelDeclarationRecord(declaration: declaration)
}

function compilerCoreProgramWithDeclarationLookupRecords(program: CompilerProgram, declarationRecords: String): CompilerProgram {
    return CompilerProgram(
        source: program.source,
        hasMainBlock: program.hasMainBlock,
        mainAttributeStart: program.mainAttributeStart,
        mainBlock: program.mainBlock,
        mainStatementRecords: program.mainStatementRecords,
        mainStatementSummary: program.mainStatementSummary,
        declarationRecords: declarationRecords,
        declarationSummary: program.declarationSummary,
        functionSummary: program.functionSummary
    )
}

function compilerCoreLLVMSelectedHelperFunctions(program: CompilerProgram, names: String): CompilerLLVMHelperFunctions {
    let lookupRecords: String(compilerCoreDeclarationLookupRecords(records: program.declarationRecords))
    let loweringProgram: CompilerProgram(compilerCoreProgramWithDeclarationLookupRecords(program: program, declarationRecords: lookupRecords))
    let functionsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    let recordsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))
    let chunkLength: Int(100000)

    while sourceIndex < recordsLength {
        let chunkEnd: Int(sourceIndex + chunkLength)
        let chunk: CompilerLLVMHelperFunctionChunk(compilerCoreLLVMSelectedHelperFunctionsChunk(program: program, loweringProgram: loweringProgram, names: names, sourceIndex: sourceIndex, chunkEnd: chunkEnd, recordsLength: recordsLength))
        textBufferAppend(buffer: functionsBuffer, text: chunk.renderedFunctions)
        textBufferAppend(buffer: recordsBuffer, text: chunk.instructionRecords)
        if chunk.nextIndex <= sourceIndex {
            return compilerCoreLLVMHelperFunctionsFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer)
        }
        sourceIndex: chunk.nextIndex
    }

    return compilerCoreLLVMHelperFunctionsFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer)
}

function compilerCoreLLVMSelectedHelperFunctionsChunk(program: CompilerProgram, loweringProgram: CompilerProgram, names: String, sourceIndex: Int, chunkEnd: Int, recordsLength: Int): CompilerLLVMHelperFunctionChunk {
    let functionsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    let recordsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    state nextSourceIndex: Int(sourceIndex)

    while nextSourceIndex < recordsLength && nextSourceIndex < chunkEnd {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: nextSourceIndex))
        if record == String("") {
            return compilerCoreLLVMHelperFunctionChunkFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer, nextIndex: recordsLength)
        }

        let selectedFunction: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctionForRecord(loweringProgram: loweringProgram, names: names, sourceIndex: nextSourceIndex, record: record))
        textBufferAppend(buffer: functionsBuffer, text: selectedFunction.renderedFunctions)
        textBufferAppend(buffer: recordsBuffer, text: selectedFunction.instructionRecords)
        nextSourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: nextSourceIndex)
    }

    return compilerCoreLLVMHelperFunctionChunkFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer, nextIndex: nextSourceIndex)
}

function compilerCoreLLVMHelperFunctionsFromTextBuffers(functionsBuffer: TextBuffer, recordsBuffer: TextBuffer): CompilerLLVMHelperFunctions {
    let renderedFunctions: String(textBufferMaterialize(buffer: functionsBuffer))
    let instructionRecords: String(textBufferMaterialize(buffer: recordsBuffer))
    textBufferDestroy(buffer: functionsBuffer)
    textBufferDestroy(buffer: recordsBuffer)
    return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords)
}

function compilerCoreLLVMHelperFunctionChunkFromTextBuffers(functionsBuffer: TextBuffer, recordsBuffer: TextBuffer, nextIndex: Int): CompilerLLVMHelperFunctionChunk {
    let renderedFunctions: String(textBufferMaterialize(buffer: functionsBuffer))
    let instructionRecords: String(textBufferMaterialize(buffer: recordsBuffer))
    textBufferDestroy(buffer: functionsBuffer)
    textBufferDestroy(buffer: recordsBuffer)
    return CompilerLLVMHelperFunctionChunk(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords, nextIndex: nextIndex)
}

function compilerCoreLLVMSelectedHelperFunctionForRecord(loweringProgram: CompilerProgram, names: String, sourceIndex: Int, record: String): CompilerLLVMHelperFunctions {
    let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if declarationKind == String("function") && compilerCoreNameListContains(names: names, name: declarationName) {
        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        return compilerCoreLLVMSelectedHelperFunctionForDeclaration(loweringProgram: loweringProgram, declaration: declaration, sourceIndex: sourceIndex)
    }

    return CompilerLLVMHelperFunctions(renderedFunctions: String(""), instructionRecords: String(""))
}

function compilerCoreLLVMSelectedHelperFunctionForDeclaration(loweringProgram: CompilerProgram, declaration: CompilerTopLevelDeclaration, sourceIndex: Int): CompilerLLVMHelperFunctions {
    if compilerCoreShouldLowerSelectedHelperFunction(declaration: declaration) {
        let loweredFunction: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerHelperFunction(program: loweringProgram, declaration: declaration, initialTemporaryIndex: sourceIndex))
        let renderedFunction: String(compilerCoreRenderLLVMHelperFunction(declaration: declaration, block: loweredFunction))
        let globalRecords: String(compilerCoreLLVMGlobalRecords(records: loweredFunction.instructionRecords))
        return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunction, instructionRecords: globalRecords)
    }

    let declarationText: String(compilerCoreRenderLLVMHelperFunctionDeclaration(declaration: declaration))
    return CompilerLLVMHelperFunctions(renderedFunctions: declarationText, instructionRecords: String(""))
}

function compilerCoreRenderLLVMFunctionDeclarations(program: CompilerProgram): String {
    return compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: String(""))
}

function compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: CompilerProgram, names: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    let declarationCount: Int(compilerCoreAppendLLVMFunctionDeclarations(program: program, names: names, outputBuffer: outputBuffer))
    if declarationCount > 0 {
        textBufferAppend(buffer: outputBuffer, text: String("\n"))
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreAppendLLVMFunctionDeclarations(program: CompilerProgram, names: String, outputBuffer: TextBuffer): Int {
    state sourceIndex: Int(0)
    state declarationCount: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
        if record == String("") {
            return declarationCount
        }

        declarationCount: declarationCount + compilerCoreAppendLLVMFunctionDeclarationRecord(record: record, names: names, outputBuffer: outputBuffer)
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex)
    }

    return declarationCount
}

function compilerCoreAppendLLVMFunctionDeclarationRecord(record: String, names: String, outputBuffer: TextBuffer): Int {
    let kind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let name: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if kind != String("function") || compilerCoreNameListContains(names: names, name: name) {
        return 0
    }
    let returnType: String(compilerCoreRecordField(record: record, prefix: String("returnType=")))
    let parameters: String(compilerCoreRecordField(record: record, prefix: String("parameters=")))
    let declaration: String("declare \(compilerCoreLLVMTypeNameForRangeType(typeName: returnType)) @\(name)(\(compilerCoreLLVMFunctionParameterText(parameterSummary: parameters)))\n")
    textBufferAppend(buffer: outputBuffer, text: declaration)
    return 1
}

function compilerCoreLLVMLowerHelperFunction(program: CompilerProgram, declaration: CompilerTopLevelDeclaration, initialTemporaryIndex: Int): CompilerLLVMLoweredBlock {
    let functionBlock: CompilerBlock(CompilerBlock(start: declaration.bodyStart, end: declaration.bodyEnd))
    let statementRecords: String(compilerCoreFunctionDeclarationStatementRecords(program: program, declaration: declaration))
    let parsedFunctionBlock: CompilerParsedBlock(CompilerParsedBlock(block: functionBlock, statementRecords: statementRecords, statementSummary: String("")))
    let parameterLocals: String(compilerCoreLLVMFunctionParameterLocalValues(parameterSummary: declaration.parameterSummary))
    return compilerCoreLLVMLowerBlockWithLocals(program: program, parsedBlock: parsedFunctionBlock, initialLocalValues: parameterLocals, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: declaration.returnType)
}

function compilerCoreRenderLLVMHelperFunction(declaration: CompilerTopLevelDeclaration, block: CompilerLLVMLoweredBlock): String {
    let functionBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    let llvmFunction: CompilerLLVMFunction(CompilerLLVMFunction(
        name: declaration.name,
        returnType: compilerCoreLLVMTypeNameForRangeType(typeName: declaration.returnType),
        parameterText: compilerCoreLLVMFunctionParameterText(parameterSummary: declaration.parameterSummary),
        renderedBlocks: block.renderedBlocks,
        block: functionBlock
    ))
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreRenderLLVMHelperFunctionDeclaration(declaration: CompilerTopLevelDeclaration): String {
    let llvmReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: declaration.returnType))
    return "declare \(llvmReturnType) @\(declaration.name)(\(compilerCoreLLVMFunctionParameterText(parameterSummary: declaration.parameterSummary)))\n"
}

function compilerCoreShouldLowerSelectedHelperFunction(declaration: CompilerTopLevelDeclaration): Bool {
    return compilerCoreSelectedHelperExclusionReason(declaration: declaration) == String("")
}

function compilerCoreSelectedHelperExclusionReason(declaration: CompilerTopLevelDeclaration): String {
    if declaration.statementRecords == String("") {
        return String("missingStatementRecords")
    }
    if !compilerCoreFunctionSignatureUsesOnlyLLVMPrimitiveTypes(declaration: declaration) {
        return String("unsupportedSignature")
    }
    return String("")
}

function compilerCoreFunctionSignatureUsesOnlyLLVMPrimitiveTypes(declaration: CompilerTopLevelDeclaration): Bool {
    if compilerCoreLLVMTypeNameForRangeType(typeName: declaration.returnType) == String("") {
        return false
    }

    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypes(parameterSummary: declaration.parameterSummary)
}

function compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypes(parameterSummary: String): Bool {
    let sourceLength: Int(stringLength(value: parameterSummary))
    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: parameterSummary, sourceIndex: 0, sourceLength: sourceLength)
}

function compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: String, sourceIndex: Int, sourceLength: Int): Bool {
    if sourceIndex >= sourceLength {
        return true
    }

    if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
        return compilerCoreFunctionParameterSummaryTypeMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, scanIndex: sourceIndex)
    }

    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: parameterSummary, sourceIndex: sourceIndex + 1, sourceLength: sourceLength)
}

function compilerCoreFunctionParameterSummaryTypeMarker(parameterSummary: String, sourceIndex: Int, sourceLength: Int, scanIndex: Int): Bool {
    if scanIndex >= sourceLength {
        return false
    }

    if hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(",type=")) {
        let typeStart: Int(scanIndex + 6)
        return compilerCoreFunctionParameterSummaryTypeEnd(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeStart)
    }

    return compilerCoreFunctionParameterSummaryTypeMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, scanIndex: scanIndex + 1)
}

function compilerCoreFunctionParameterSummaryTypeEnd(parameterSummary: String, sourceIndex: Int, sourceLength: Int, typeStart: Int, typeEnd: Int): Bool {
    if typeEnd >= sourceLength {
        return compilerCoreFunctionParameterSummaryCheckType(parameterSummary: parameterSummary, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeEnd)
    }

    if hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
        return compilerCoreFunctionParameterSummaryCheckType(parameterSummary: parameterSummary, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeEnd)
    }

    return compilerCoreFunctionParameterSummaryTypeEnd(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeEnd + 1)
}

function compilerCoreFunctionParameterSummaryCheckType(parameterSummary: String, sourceLength: Int, typeStart: Int, typeEnd: Int): Bool {
    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
    if compilerCoreLLVMTypeNameForRangeType(typeName: parameterType) == String("") {
        return false
    }

    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: parameterSummary, sourceIndex: typeEnd, sourceLength: sourceLength)
}

function compilerCoreLLVMDefaultReturnValue(typeName: String): String {
    if typeName == String("ptr") {
        return String("null")
    }

    if typeName == String("i1") {
        return String("false")
    }

    return String("0")
}

function compilerCoreLLVMFunctionParameterText(parameterSummary: String): String {
    let sourceLength: Int(stringLength(value: parameterSummary))
    return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: 0, sourceLength: sourceLength, parameterOrdinal: 0, output: String(""))
}

function compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: String, sourceIndex: Int, sourceLength: Int, parameterOrdinal: Int, output: String): String {
    if sourceIndex >= sourceLength {
        return output
    }

    if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
        return compilerCoreLLVMFunctionParameterTextNameMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, scanIndex: sourceIndex + 9)
    }

    return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: sourceIndex + 1, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output)
}

function compilerCoreLLVMFunctionParameterTextNameMarker(parameterSummary: String, sourceIndex: Int, sourceLength: Int, parameterOrdinal: Int, output: String, scanIndex: Int): String {
    if scanIndex >= sourceLength {
        return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: scanIndex, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output)
    }

    if hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
        let nameStart: Int(scanIndex + 6)
        return compilerCoreLLVMFunctionParameterTextNameEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameStart)
    }

    return compilerCoreLLVMFunctionParameterTextNameMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, scanIndex: scanIndex + 1)
}

function compilerCoreLLVMFunctionParameterTextNameEnd(parameterSummary: String, sourceLength: Int, parameterOrdinal: Int, output: String, nameStart: Int, nameEnd: Int): String {
    if nameEnd >= sourceLength {
        return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: nameEnd, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output)
    }

    if hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
        let typeStart: Int(nameEnd + 6)
        return compilerCoreLLVMFunctionParameterTextTypeEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeStart)
    }

    return compilerCoreLLVMFunctionParameterTextNameEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd + 1)
}

function compilerCoreLLVMFunctionParameterTextTypeEnd(parameterSummary: String, sourceLength: Int, parameterOrdinal: Int, output: String, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): String {
    if typeEnd >= sourceLength {
        return compilerCoreLLVMFunctionParameterTextAppend(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd)
    }

    if hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
        return compilerCoreLLVMFunctionParameterTextAppend(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd)
    }

    return compilerCoreLLVMFunctionParameterTextTypeEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd + 1)
}

function compilerCoreLLVMFunctionParameterTextAppend(parameterSummary: String, sourceLength: Int, parameterOrdinal: Int, output: String, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): String {
    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
    let parameterText: String("\(compilerCoreLLVMTypeNameForRangeType(typeName: parameterType)) %\(parameterName)")
    if parameterOrdinal == 0 {
        return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: typeEnd, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal + 1, output: parameterText)
    }

    return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: typeEnd, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal + 1, output: "\(output), \(parameterText)")
}

function compilerCoreLLVMFunctionParameterLocalValues(parameterSummary: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: parameterSummary))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
            let indexStart: Int(sourceIndex + 9)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
                    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
                    output: "\(output)\(compilerCoreLLVMLocalRecordWithRangeType(name: parameterName, operand: "%\(parameterName)", typeName: compilerCoreLLVMTypeNameForRangeType(typeName: parameterType), rangeTypeName: parameterType))"
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return output
}

function compilerCoreMainLLVMBasicBlock(block: CompilerLLVMLoweredBlock): CompilerLLVMBasicBlock {
    state instructionRecords: String("")
    instructionRecords: block.instructionRecords
    state terminal: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
    if block.hasEntryBranch {
        terminal: CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: block.entryBranchCondition, trueLabel: block.entryBranchThenLabel, falseLabel: block.entryBranchElseLabel)
    } else if block.hasReturn {
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    }

    if !block.hasReturn && !block.hasEntryBranch {
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    }

    return CompilerLLVMBasicBlock(
        name: String("entry"),
        instructionRecords: instructionRecords,
        terminal: terminal
    )
}

function compilerCoreRenderLLVMModule(module: CompilerLLVMModule): String {
    let globalText: String(compilerCoreRenderLLVMGlobalRecords(records: module.instructionRecords))
    let runtimeDeclarations: String(compilerCoreRenderLLVMRuntimeDeclarations(records: module.instructionRecords))
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    textBufferAppend(buffer: outputBuffer, text: globalText)
    textBufferAppend(buffer: outputBuffer, text: runtimeDeclarations)
    textBufferAppend(buffer: outputBuffer, text: module.helperFunctions)
    textBufferAppend(buffer: outputBuffer, text: compilerCoreRenderLLVMFunction(llvmFunction: module.mainFunction))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMFunction(llvmFunction: CompilerLLVMFunction): String {
    if llvmFunction.renderedBlocks != String("") {
        return "define \(llvmFunction.returnType) @\(llvmFunction.name)(\(llvmFunction.parameterText)) {\n\(llvmFunction.renderedBlocks)}\n"
    }

    let blockText: String(compilerCoreRenderLLVMBasicBlock(block: llvmFunction.block))
    return "define \(llvmFunction.returnType) @\(llvmFunction.name)(\(llvmFunction.parameterText)) {\n\(blockText)}\n"
}

function compilerCoreRenderLLVMBasicBlock(block: CompilerLLVMBasicBlock): String {
    let instructionsText: String(compilerCoreRenderLLVMInstructionRecords(records: block.instructionRecords))
    let terminalText: String(compilerCoreRenderLLVMTerminator(terminal: block.terminal))
    return "\(block.name):\n\(instructionsText)  \(terminalText)\n"
}

function compilerCoreRenderLLVMNamedBlock(label: String, instructionRecords: String, terminal: CompilerLLVMTerminator): String {
    let instructionsText: String(compilerCoreRenderLLVMInstructionRecords(records: instructionRecords))
    let terminalText: String(compilerCoreRenderLLVMTerminator(terminal: terminal))
    return "\(label):\n\(instructionsText)  \(terminalText)\n"
}

function compilerCoreRenderLLVMInstructionRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    state recordsLength: Int(0)
    recordsLength: stringLength(value: records)

    while sourceIndex < recordsLength {
        state lineEnd: Int(0)
        lineEnd: sourceIndex
        while lineEnd < recordsLength && records.substring(start: lineEnd, end: lineEnd + 1) != String(";") {
            lineEnd: lineEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: lineEnd))
        if record != String("") {
            let rendered: String(compilerCoreRenderLLVMInstructionRecord(record: record))
            if rendered != String("") {
                textBufferAppend(buffer: outputBuffer, text: "  \(rendered)\n")
            }
        }

        sourceIndex: lineEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMInstructionRecord(record: String): String {
    if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
        return String("")
    }
    if hasRangePrefix(source: record, start: 0, prefix: String("llvmPlaceholder|")) {
        let encodedReason: String(compilerCoreRecordField(record: record, prefix: String("reason=")))
        let reason: String(compilerCoreStatementRecordDecodeValue(value: encodedReason))
        return "; RANGE_LOWERING_PLACEHOLDER \(reason)"
    }

    let result: String(compilerCoreRecordField(record: record, prefix: String("result=")))
    let operation: String(compilerCoreRecordField(record: record, prefix: String("op=")))
    let typeName: String(compilerCoreRecordField(record: record, prefix: String("type=")))
    let left: String(compilerCoreRecordField(record: record, prefix: String("left=")))
    let right: String(compilerCoreRecordField(record: record, prefix: String("right=")))
    if result == String("") && operation == String("") {
        return String("")
    }

    if operation == String("call") {
        return "\(result) = call \(typeName) @\(left)(\(right))"
    }

    if operation == String("puts") {
        return "\(result) = call i32 @puts(ptr \(left))"
    }

    if operation == String("phi") {
        return "\(result) = phi \(typeName) \(left), \(right)"
    }

    return "\(result) = \(operation) \(typeName) \(left), \(right)"
}

function compilerCoreRenderLLVMGlobalRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        state recordEnd: Int(0)
        recordEnd: sourceIndex
        while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
            recordEnd: recordEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: recordEnd))
        if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
            let name: String(compilerCoreRecordField(record: record, prefix: String("name=")))
            let byteCount: String(compilerCoreRecordField(record: record, prefix: String("bytes=")))
            let text: String(compilerCoreRecordField(record: record, prefix: String("text=")))
            let renderedText: String(compilerCoreLLVMGlobalStringRenderedText(text: text))
            textBufferAppend(buffer: outputBuffer, text: "@\(name) = private unnamed_addr constant [\(byteCount) x i8] c\"\(renderedText)\\00\"\n")
        }

        sourceIndex: recordEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMGlobalRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        state recordEnd: Int(0)
        recordEnd: sourceIndex
        while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
            recordEnd: recordEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: recordEnd))
        if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
            textBufferAppend(buffer: outputBuffer, text: "\(record);")
        }

        sourceIndex: recordEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreTextBufferMaterializeAndDestroy(buffer: TextBuffer): String {
    let text: String(textBufferMaterialize(buffer: buffer))
    textBufferDestroy(buffer: buffer)
    return text
}

function compilerCoreTextBufferConcat(left: String, right: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    textBufferAppend(buffer: outputBuffer, text: left)
    textBufferAppend(buffer: outputBuffer, text: right)
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMRuntimeDeclarations(records: String): String {
    return "declare i32 @puts(ptr)\ndeclare i32 @stringLength(ptr)\ndeclare i32 @stringIndexOf(ptr, ptr, i32)\ndeclare i32 @stringEqual(ptr, ptr)\ndeclare i32 @stringCompare(ptr, ptr)\ndeclare i1 @stringHasPrefix(ptr, i32, ptr)\ndeclare i32 @stringFindFrom(ptr, i32, ptr)\ndeclare i32 @stringFindFirstOf(ptr, i32, ptr)\ndeclare ptr @stringViewFrom(ptr, i32)\ndeclare ptr @stringCharacterAt(ptr, i32)\ndeclare i32 @stringByteAt(ptr, i32)\ndeclare i32 @stringFindByteOf(ptr, i32, i32, i32, i32)\ndeclare ptr @commandLineArgument(i32)\ndeclare i32 @commandLineArgumentCount()\ndeclare ptr @readFile(ptr)\ndeclare ptr @stringCharacter(ptr, i32)\ndeclare ptr @stringSubstring(ptr, i32, i32)\ndeclare ptr @stringConcat(ptr, ptr)\ndeclare ptr @stringFromInt(i32)\ndeclare ptr @stringFromBool(i1)\ndeclare ptr @rangeConstructCreate(ptr)\ndeclare ptr @rangeConstructSetPtr(ptr, ptr, ptr)\ndeclare ptr @rangeConstructSetInt(ptr, ptr, i32)\ndeclare ptr @rangeConstructSetBool(ptr, ptr, i1)\ndeclare ptr @rangeConstructGetPtr(ptr, ptr)\ndeclare i32 @rangeConstructGetInt(ptr, ptr)\ndeclare i1 @rangeConstructGetBool(ptr, ptr)\ndeclare ptr @textBufferCreate(i32)\ndeclare i32 @textBufferAppend(ptr, ptr)\ndeclare i32 @textBufferAppendInt(ptr, i32)\ndeclare i32 @textBufferAppendCharacter(ptr, ptr, i32)\ndeclare ptr @textBufferMaterialize(ptr)\ndeclare i32 @textBufferDestroy(ptr)\n\n"
}

function compilerCoreLLVMRecordsContainOperation(records: String, operation: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    let operationField: String("op=\(operation)")

    while sourceIndex < recordsLength {
        if hasRangePrefix(source: records, start: sourceIndex, prefix: operationField) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreLLVMRecordsContainCall(records: String, name: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    let callField: String("op=call|type=")
    let nameField: String("|left=\(name)|")

    while sourceIndex < recordsLength {
        if hasRangePrefix(source: records, start: sourceIndex, prefix: callField) {
            state recordEnd: Int(0)
            recordEnd: sourceIndex
            while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
                recordEnd: recordEnd + 1
            }
            let record: String(records.substring(start: sourceIndex, end: recordEnd))
            if compilerCoreRecordContains(record: record, text: nameField) {
                return true
            }
            sourceIndex: recordEnd
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return false
}

function compilerCoreRecordContains(record: String, text: String): Bool {
    state sourceIndex: Int(0)
    let recordLength: Int(stringLength(value: record))

    while sourceIndex < recordLength {
        if hasRangePrefix(source: record, start: sourceIndex, prefix: text) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreRenderLLVMTerminator(terminal: CompilerLLVMTerminator): String {
    if terminal.kind == String("return") {
        return "ret \(terminal.typeName) \(terminal.value)"
    }

    if terminal.kind == String("branch") {
        return "br \(terminal.typeName) \(terminal.value), label %\(terminal.trueLabel), label %\(terminal.falseLabel)"
    }

    if terminal.kind == String("jump") {
        return "br label %\(terminal.trueLabel)"
    }

    return String("ret i32 0")
}

function compilerCoreRecordField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreExpressionRecord(kind: String, value: String, left: String, right: String, arguments: String, start: Int, end: Int): String {
    return "kind=\(kind)|value=\(compilerCoreStatementRecordEncodeValue(value: value))|left=\(compilerCoreStatementRecordEncodeValue(value: left))|right=\(compilerCoreStatementRecordEncodeValue(value: right))|arguments=\(compilerCoreStatementRecordEncodeValue(value: arguments))|start=\(start)|end=\(end)~"
}

function compilerCoreMissingExpression(start: Int): CompilerExpression {
    let record: String(compilerCoreExpressionRecord(kind: String("missing"), value: String(""), left: String(""), right: String(""), arguments: String(""), start: start, end: start))
    return CompilerExpression(kind: String("missing"), value: String(""), summary: String("missing"), record: record, start: start, end: start)
}

function compilerCoreExpressionRecordField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreDelimitedRecordField(record: String, prefix: String): String {
    let prefixLength: Int(stringLength(value: prefix))
    let separators: String("|~")
    state fieldStart: Int(0)
    fieldStart: 0 - 1
    if stringHasPrefix(source: record, start: 0, prefix: prefix) {
        fieldStart: 0
    } else {
        state scanIndex: Int(0)
        while fieldStart < 0 {
            let separatorIndex: Int(stringFindFirstOf(source: record, start: scanIndex, characters: separators))
            if separatorIndex < 0 || stringHasPrefix(source: record, start: separatorIndex, prefix: String("~")) {
                return String("")
            }
            let candidateStart: Int(separatorIndex + 1)
            if stringHasPrefix(source: record, start: candidateStart, prefix: prefix) {
                fieldStart: candidateStart
            } else {
                scanIndex: candidateStart
            }
        }
    }
    let valueStart: Int(fieldStart + prefixLength)
    state valueEnd: Int(stringFindFirstOf(source: record, start: valueStart, characters: separators))
    if valueEnd < 0 {
        valueEnd: stringLength(value: record)
    }
    return record.substring(start: valueStart, end: valueEnd)
}

function compilerCoreExpressionRecordKind(record: String): String {
    return compilerCoreExpressionRecordField(record: record, prefix: String("kind="))
}

function compilerCoreExpressionRecordValue(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("value=")))
}

function compilerCoreExpressionRecordLeft(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("left=")))
}

function compilerCoreExpressionRecordRight(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("right=")))
}

function compilerCoreExpressionRecordArguments(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("arguments=")))
}

function compilerCoreExpressionRecordSummary(record: String): String {
    if record == String("") {
        return String("")
    }

    let kind: String(compilerCoreExpressionRecordKind(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))

    if kind == String("missing") {
        return String("missing")
    }

    if kind == String("integerLiteral") {
        return "integerLiteral(\(value))"
    }

    if kind == String("stringLiteral") {
        return "stringLiteral(\(value))"
    }

    if kind == String("boolLiteral") {
        return "boolLiteral(\(value))"
    }

    if kind == String("identifier") {
        return "identifier(\(value))"
    }

    if kind == String("member") {
        let baseSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        return "member(\(baseSummary),\(value))"
    }

    if kind == String("prefix") {
        let operandSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        return "prefix(\(value),\(operandSummary))"
    }

    if kind == String("binary") {
        let leftSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        let rightSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordRight(record: record)))
        return "binary(\(leftSummary),\(value),\(rightSummary))"
    }

    if kind == String("call") {
        let calleeSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        let argumentSummary: String(compilerCoreCallArgumentRecordsSummary(records: compilerCoreExpressionRecordArguments(record: record)))
        return "call(\(calleeSummary),arguments=[\(argumentSummary)])"
    }

    return String("")
}

function compilerCoreCallArgumentRecordsSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    state argumentIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreCallArgumentRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let label: String(compilerCoreCallArgumentLabel(record: record))
        let expressionSummary: String(compilerCoreCallArgumentExpressionSummary(record: record))
        if label == String("") {
            output: "\(output)argument\(argumentIndex)=\(expressionSummary);"
        } else {
            output: "\(output)argument\(argumentIndex).\(label)=\(expressionSummary);"
        }
        argumentIndex: argumentIndex + 1
        sourceIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function compilerCoreCallArgumentRecord(index: Int, label: String, expressionRecord: String, expressionSummary: String): String {
    state storedSummary: String("")
    storedSummary: expressionSummary
    if expressionRecord != String("") {
        storedSummary: String("")
    }
    return "index=\(index)|label=\(compilerCoreStatementRecordEncodeValue(value: label))|expression=\(compilerCoreStatementRecordEncodeValue(value: expressionRecord))|summary=\(compilerCoreStatementRecordEncodeValue(value: storedSummary))~"
}

function compilerCoreCallArgumentRecordAt(records: String, start: Int): String {
    let recordsLength: Int(stringLength(value: records))
    state recordEnd: Int(0)
    recordEnd: start

    while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String("~") {
        recordEnd: recordEnd + 1
    }

    return records.substring(start: start, end: recordEnd)
}

function compilerCoreCallArgumentRecordNextIndex(records: String, start: Int): Int {
    let recordsLength: Int(stringLength(value: records))
    state sourceIndex: Int(0)
    sourceIndex: start

    while sourceIndex < recordsLength {
        if records.substring(start: sourceIndex, end: sourceIndex + 1) == String("~") {
            return sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    return recordsLength
}

function compilerCoreCallArgumentExpressionRecord(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreDelimitedRecordField(record: record, prefix: String("expression=")))
}

function compilerCoreCallArgumentLabel(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreDelimitedRecordField(record: record, prefix: String("label=")))
}

function compilerCoreCallArgumentExpressionSummary(record: String): String {
    let summary: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreDelimitedRecordField(record: record, prefix: String("summary="))))
    if summary != String("") {
        return summary
    }

    return compilerCoreExpressionRecordSummary(record: compilerCoreCallArgumentExpressionRecord(record: record))
}

function compilerCoreLLVMLowerIntegerExpression(declarationRecords: String, localValues: String, expressionSummary: String, expectedTypeName: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("integerLiteral(")) {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: compilerCoreWrappedExpressionValue(summary: expressionSummary, prefixLength: 15),
            typeName: String("i32"),
            nextTemporary: temporaryIndex
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("stringLiteral(")) {
        let literalText: String(compilerCoreStringLiteralText(summary: expressionSummary))
        let literalContent: String(compilerCoreStringLiteralContent(text: literalText))
        let literalContentLength: Int(stringLength(value: literalContent))
        let literalByteCount: Int(literalContentLength + 1)
        let literalGlobalName: String(".str.\(temporaryIndex)")
        let literalGlobalRecord: String(compilerCoreLLVMGlobalStringRecord(name: literalGlobalName, byteCount: literalByteCount, text: literalContent))
        return CompilerLLVMLoweredExpression(
            instructionRecords: literalGlobalRecord,
            operand: "getelementptr inbounds ([\(literalByteCount) x i8], ptr @\(literalGlobalName), i32 0, i32 0)",
            typeName: String("ptr"),
            nextTemporary: temporaryIndex + 1
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("boolLiteral(")) {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: compilerCoreWrappedExpressionValue(summary: expressionSummary, prefixLength: 12),
            typeName: String("i1"),
            nextTemporary: temporaryIndex
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("identifier(")) {
        let identifierName: String(compilerCoreWrappedExpressionValue(summary: expressionSummary, prefixLength: 11))
        if identifierName == String("nil") {
            return CompilerLLVMLoweredExpression(instructionRecords: String(""), operand: String("null"), typeName: String("ptr"), nextTemporary: temporaryIndex)
        }
        let identifierValue: String(compilerCoreLookupLLVMLocalOperand(localValues: localValues, name: identifierName))
        if identifierValue != String("") {
            let identifierType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: identifierName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: String(""),
                operand: identifierValue,
                typeName: identifierType,
                nextTemporary: temporaryIndex
            )
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: expressionSummary))
        let callArgumentSummary: String(compilerCoreCallArgumentsSummary(summary: expressionSummary))
        if functionName == String("String") || functionName == String("Int") || functionName == String("Bool") {
            let wrappedArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: callArgumentSummary, start: 0))
            return compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: wrappedArgumentExpression, expectedTypeName: functionName, temporaryIndex: temporaryIndex)
        }

        if functionName == String("print") {
            let printArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: callArgumentSummary, start: 0))
            let loweredPrintArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: printArgumentExpression, expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
            state printTemporaryIndex: Int(0)
            printTemporaryIndex: loweredPrintArgument.nextTemporary
            let printResultOperand: String("%r\(printTemporaryIndex)")
            let printInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: printResultOperand,
                operation: String("puts"),
                typeName: String("i32"),
                left: loweredPrintArgument.operand,
                right: String("")
            ))
            let printInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: printInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredPrintArgument.instructionRecords)\(printInstructionRecord)",
                operand: printResultOperand,
                typeName: String("i32"),
                nextTemporary: printTemporaryIndex + 1
            )
        }

        if compilerCoreDeclarationRecordsContainsConstruct(records: declarationRecords, name: functionName) {
            let constructLLVMTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: functionName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "constructSummary:\(functionName)"),
                operand: compilerCoreLLVMDefaultReturnValue(typeName: constructLLVMTypeName),
                typeName: constructLLVMTypeName,
                nextTemporary: temporaryIndex
            )
        }

        if compilerCoreLLVMBuiltinFunctionReturnType(name: functionName) == String("") && !compilerCoreDeclarationRecordsContainsFunction(records: declarationRecords, name: functionName) {
            let unresolvedCallTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unresolvedCall:\(functionName)"),
                operand: compilerCoreLLVMDefaultReturnValue(typeName: unresolvedCallTypeName),
                typeName: unresolvedCallTypeName,
                nextTemporary: temporaryIndex
            )
        }

        let loweredCallArguments: CompilerLLVMCallArguments(compilerCoreLLVMLowerIntegerCallArguments(declarationRecords: declarationRecords, localValues: localValues, argumentsSummary: callArgumentSummary, temporaryIndex: temporaryIndex))
        state callTemporaryIndex: Int(0)
        callTemporaryIndex: loweredCallArguments.nextTemporary
        let callResultOperand: String("%r\(callTemporaryIndex)")
        let callReturnType: String(compilerCoreLLVMCallReturnType(declarationRecords: declarationRecords, name: functionName, expectedTypeName: expectedTypeName))
        let callInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: callResultOperand,
            operation: String("call"),
            typeName: callReturnType,
            left: functionName,
            right: loweredCallArguments.renderedArguments
        ))
        let callInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: callInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredCallArguments.instructionRecords)\(callInstructionRecord)",
            operand: callResultOperand,
            typeName: callReturnType,
            nextTemporary: callTemporaryIndex + 1
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(member(")) {
        let memberCalleeSummary: String(compilerCoreCallCalleeSummary(summary: expressionSummary))
        let memberName: String(compilerCoreMemberExpressionName(summary: memberCalleeSummary))
        let memberBaseSummary: String(compilerCoreMemberExpressionBase(summary: memberCalleeSummary))
        let memberCallArgumentSummary: String(compilerCoreCallArgumentsSummary(summary: expressionSummary))
        let loweredSummaryMemberBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: memberBaseSummary, expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
        if memberName == String("character") {
            let summaryIndexArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: memberCallArgumentSummary, start: 0))
            let loweredSummaryIndexArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: summaryIndexArgumentExpression, expectedTypeName: String("Int"), temporaryIndex: loweredSummaryMemberBase.nextTemporary))
            let summaryMemberCallResultOperand: String("%r\(loweredSummaryIndexArgument.nextTemporary)")
            let summaryMemberCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: summaryMemberCallResultOperand,
                operation: String("call"),
                typeName: String("ptr"),
                left: String("stringCharacter"),
                right: "\(loweredSummaryMemberBase.typeName) \(loweredSummaryMemberBase.operand), \(loweredSummaryIndexArgument.typeName) \(loweredSummaryIndexArgument.operand)"
            ))
            let summaryMemberCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: summaryMemberCallInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredSummaryMemberBase.instructionRecords)\(loweredSummaryIndexArgument.instructionRecords)\(summaryMemberCallInstructionRecord)",
                operand: summaryMemberCallResultOperand,
                typeName: String("ptr"),
                nextTemporary: loweredSummaryIndexArgument.nextTemporary + 1
            )
        }

        if memberName == String("substring") {
            let summaryStartArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: memberCallArgumentSummary, start: 0))
            let loweredSummaryStartArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: summaryStartArgumentExpression, expectedTypeName: String("Int"), temporaryIndex: loweredSummaryMemberBase.nextTemporary))
            let summaryEndArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: memberCallArgumentSummary, start: compilerCoreCallArgumentNextIndex(argumentsSummary: memberCallArgumentSummary, start: 0)))
            let loweredSummaryEndArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: summaryEndArgumentExpression, expectedTypeName: String("Int"), temporaryIndex: loweredSummaryStartArgument.nextTemporary))
            let summarySubstringCallResultOperand: String("%r\(loweredSummaryEndArgument.nextTemporary)")
            let summarySubstringCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: summarySubstringCallResultOperand,
                operation: String("call"),
                typeName: String("ptr"),
                left: String("stringSubstring"),
                right: "\(loweredSummaryMemberBase.typeName) \(loweredSummaryMemberBase.operand), \(loweredSummaryStartArgument.typeName) \(loweredSummaryStartArgument.operand), \(loweredSummaryEndArgument.typeName) \(loweredSummaryEndArgument.operand)"
            ))
            let summarySubstringCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: summarySubstringCallInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredSummaryMemberBase.instructionRecords)\(loweredSummaryStartArgument.instructionRecords)\(loweredSummaryEndArgument.instructionRecords)\(summarySubstringCallInstructionRecord)",
                operand: summarySubstringCallResultOperand,
                typeName: String("ptr"),
                nextTemporary: loweredSummaryEndArgument.nextTemporary + 1
            )
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("member(")) {
        let constructMemberName: String(compilerCoreMemberExpressionName(summary: expressionSummary))
        let constructMemberBaseSummary: String(compilerCoreMemberExpressionBase(summary: expressionSummary))
        let loweredConstructMemberBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: constructMemberBaseSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
        let constructMemberBaseRangeType: String(compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: constructMemberBaseSummary, expectedType: String("")))
        state constructMemberRangeType: String("")
        constructMemberRangeType: compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: constructMemberBaseRangeType, memberName: constructMemberName)
        if constructMemberRangeType == String("") {
            constructMemberRangeType: expectedTypeName
        }
        if constructMemberRangeType != String("") {
            return compilerCoreLLVMLowerConstructMemberAccess(base: loweredConstructMemberBase, memberName: constructMemberName, memberType: constructMemberRangeType)
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("prefix(")) {
        let prefixOperatorText: String(compilerCorePrefixExpressionOperator(summary: expressionSummary))
        let operandSummary: String(compilerCorePrefixExpressionOperand(summary: expressionSummary))
        state prefixExpectedTypeName: String("")
        prefixExpectedTypeName: expectedTypeName
        if prefixOperatorText == String("!") {
            prefixExpectedTypeName: String("Bool")
        } else if prefixOperatorText == String("-") {
            prefixExpectedTypeName: String("Int")
        }
        let loweredOperand: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: operandSummary, expectedTypeName: prefixExpectedTypeName, temporaryIndex: temporaryIndex))
        let prefixResultOperand: String("%r\(loweredOperand.nextTemporary)")
        let prefixInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: prefixResultOperand,
            operation: compilerCoreLLVMInstructionForPrefixOperator(operatorText: prefixOperatorText),
            typeName: compilerCoreLLVMTypeForPrefixOperator(operatorText: prefixOperatorText, operandType: loweredOperand.typeName),
            left: compilerCoreLLVMLeftValueForPrefixOperator(operatorText: prefixOperatorText, operand: loweredOperand.operand),
            right: compilerCoreLLVMRightValueForPrefixOperator(operatorText: prefixOperatorText, operand: loweredOperand.operand)
        ))
        let prefixInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: prefixInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredOperand.instructionRecords)\(prefixInstructionRecord)",
            operand: prefixResultOperand,
            typeName: prefixInstruction.typeName,
            nextTemporary: loweredOperand.nextTemporary + 1
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("binary(")) {
        let leftSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 0))
        let operatorText: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 1))
        let rightSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 2))
        if operatorText == String("??") || operatorText == String("questionQuestion") {
            let loweredOptional: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex))
            if loweredOptional.operand != String("0") || loweredOptional.typeName != String("i32") {
                return CompilerLLVMLoweredExpression(
                    instructionRecords: loweredOptional.instructionRecords,
                    operand: loweredOptional.operand,
                    typeName: loweredOptional.typeName,
                    nextTemporary: loweredOptional.nextTemporary
                )
            }

            let loweredFallback: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex))
            return CompilerLLVMLoweredExpression(
                instructionRecords: loweredFallback.instructionRecords,
                operand: loweredFallback.operand,
                typeName: loweredFallback.typeName,
                nextTemporary: loweredFallback.nextTemporary
            )
        }

        state initialLeftExpectedTypeName: String("")
        state initialRightExpectedTypeName: String("")
        if compilerCoreLLVMResultTypeForOperator(operatorText: operatorText) == String("i1") {
            initialLeftExpectedTypeName: compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: rightSummary, expectedType: String(""))
            initialRightExpectedTypeName: compilerCoreExpressionSummaryRangeTypeForLLVM(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: leftSummary, expectedType: String(""))
        }
        let initialLoweredLeft: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: initialLeftExpectedTypeName, temporaryIndex: temporaryIndex))
        let initialLoweredRight: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: initialRightExpectedTypeName, temporaryIndex: initialLoweredLeft.nextTemporary))
        state loweredLeft: CompilerLLVMLoweredExpression(initialLoweredLeft)
        state loweredRight: CompilerLLVMLoweredExpression(initialLoweredRight)
        if compilerCoreLLVMResultTypeForOperator(operatorText: operatorText) == String("i1") && initialLoweredLeft.typeName != initialLoweredRight.typeName {
            if initialLoweredRight.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            } else if initialLoweredLeft.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            }
        }
        let resultOperand: String("%r\(loweredRight.nextTemporary)")
        let instructionName: String(compilerCoreLLVMInstructionForOperator(operatorText: operatorText))
        let resultType: String(compilerCoreLLVMResultTypeForOperator(operatorText: operatorText))
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (operatorText == String("==") || operatorText == String("!=") || operatorText == String("bangEqual")) {
            let stringEqualInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringEqual"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let stringEqualRecord: String(compilerCoreLLVMInstructionRecord(instruction: stringEqualInstruction))
            let comparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state comparisonOperation: String("icmp ne")
            if operatorText == String("!=") || operatorText == String("bangEqual") {
                comparisonOperation: String("icmp eq")
            }
            let comparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: comparisonResultOperand,
                operation: comparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let comparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: comparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(stringEqualRecord)\(comparisonRecord)",
                operand: comparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (operatorText == String(">") || operatorText == String("<") || operatorText == String(">=") || operatorText == String("<=") || operatorText == String("greater") || operatorText == String("less") || operatorText == String("greaterEqual") || operatorText == String("lessEqual")) {
            let summaryStringCompareInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringCompare"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let summaryStringCompareRecord: String(compilerCoreLLVMInstructionRecord(instruction: summaryStringCompareInstruction))
            let summaryRelationalComparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state summaryRelationalComparisonOperation: String("icmp sgt")
            if operatorText == String("<") || operatorText == String("less") {
                summaryRelationalComparisonOperation: String("icmp slt")
            } else if operatorText == String(">=") || operatorText == String("greaterEqual") {
                summaryRelationalComparisonOperation: String("icmp sge")
            } else if operatorText == String("<=") || operatorText == String("lessEqual") {
                summaryRelationalComparisonOperation: String("icmp sle")
            }
            let summaryRelationalComparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: summaryRelationalComparisonResultOperand,
                operation: summaryRelationalComparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let summaryRelationalComparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: summaryRelationalComparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(summaryStringCompareRecord)\(summaryRelationalComparisonRecord)",
                operand: summaryRelationalComparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        let instruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: resultOperand,
            operation: instructionName,
            typeName: loweredLeft.typeName,
            left: loweredLeft.operand,
            right: loweredRight.operand
        ))
        let instructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: instruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(instructionRecord)",
            operand: resultOperand,
            typeName: resultType,
            nextTemporary: loweredRight.nextTemporary + 1
        )
    }

    let fallbackTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
    return CompilerLLVMLoweredExpression(
        instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unsupportedExpressionSummary:\(expressionSummary)"),
        operand: compilerCoreLLVMDefaultReturnValue(typeName: fallbackTypeName),
        typeName: fallbackTypeName,
        nextTemporary: temporaryIndex
    )
}

function compilerCoreLLVMInstructionRecord(instruction: CompilerLLVMInstruction): String {
    return "llvmInstruction|result=\(instruction.result)|op=\(instruction.operation)|type=\(instruction.typeName)|left=\(instruction.left)|right=\(instruction.right);"
}

function compilerCoreLLVMPlaceholderRecord(reason: String): String {
    return "llvmPlaceholder|reason=\(compilerCoreStatementRecordEncodeValue(value: reason));"
}

function compilerCoreLLVMGlobalStringRecord(name: String, byteCount: Int, text: String): String {
    return "llvmGlobalString|name=\(name)|bytes=\(byteCount)|text=\(compilerCoreLLVMGlobalStringRecordText(text: text));"
}

function compilerCoreLLVMGlobalStringRecordText(text: String): String {
    return compilerCoreStatementRecordEncodeValue(value: text)
}

function compilerCoreLLVMGlobalStringRenderedText(text: String): String {
    let decodedText: String(compilerCoreStatementRecordDecodeValue(value: text))
    return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: decodedText, sourceIndex: 0, output: String(""))
}

function compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: String, sourceIndex: Int, output: String): String {
    let textLength: Int(stringLength(value: text))
    if sourceIndex >= textLength {
        return output
    }

    let character: String(text.character(index: sourceIndex))
    if character == compilerCoreNewlineCharacter() {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\0A")
    }
    if character == compilerCoreTabCharacter() {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\09")
    }
    if isRangeQuote(character: character) {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\22")
    }
    if character == compilerCoreSingleBackslash() {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\5C")
    }

    return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\(character)")
}

function compilerCoreLLVMLocalRecord(name: String, operand: String, typeName: String): String {
    return "\(name):\(operand)@TYPE@\(typeName);"
}

function compilerCoreLLVMLocalRecordWithRangeType(name: String, operand: String, typeName: String, rangeTypeName: String): String {
    return "\(name):\(operand)@TYPE@\(typeName)@RANGE@\(rangeTypeName);"
}

function compilerCoreLLVMLocalNames(localValues: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: localValues))

    while sourceIndex < sourceLength {
        state nameEnd: Int(0)
        nameEnd: sourceIndex
        while nameEnd < sourceLength && localValues.substring(start: nameEnd, end: nameEnd + 1) != String(":") {
            nameEnd: nameEnd + 1
        }

        let name: String(localValues.substring(start: sourceIndex, end: nameEnd))
        if name != String("") && !compilerCoreNameListContains(names: output, name: name) {
            output: "\(output)\(name);"
        }

        while sourceIndex < sourceLength && localValues.substring(start: sourceIndex, end: sourceIndex + 1) != String(";") {
            sourceIndex: sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    return output
}

function compilerCoreLookupLLVMLocalRecord(localValues: String, name: String): String {
    let sourceLength: Int(stringLength(value: localValues))
    let namePrefix: String("\(name):")
    let namePrefixLength: Int(stringLength(value: namePrefix))
    return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: 0, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: String(""))
}

function compilerCoreLookupLLVMLocalRecordFromIndex(localValues: String, sourceIndex: Int, sourceLength: Int, namePrefix: String, namePrefixLength: Int, foundRecord: String): String {
    if sourceIndex >= sourceLength {
        return foundRecord
    }

    if hasRangePrefix(source: localValues, start: sourceIndex, prefix: namePrefix) {
        let recordStart: Int(sourceIndex + namePrefixLength)
        return compilerCoreLookupLLVMLocalRecordEnd(localValues: localValues, recordStart: recordStart, recordEnd: recordStart, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: foundRecord)
    }

    return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: sourceIndex + 1, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: foundRecord)
}

function compilerCoreLookupLLVMLocalRecordEnd(localValues: String, recordStart: Int, recordEnd: Int, sourceLength: Int, namePrefix: String, namePrefixLength: Int, foundRecord: String): String {
    if recordEnd >= sourceLength {
        let nextFoundRecordAtEnd: String(localValues.substring(start: recordStart, end: recordEnd))
        return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: recordEnd, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: nextFoundRecordAtEnd)
    }

    if hasRangePrefix(source: localValues, start: recordEnd, prefix: String(";")) {
        let nextFoundRecordAtTerminator: String(localValues.substring(start: recordStart, end: recordEnd))
        return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: recordEnd, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: nextFoundRecordAtTerminator)
    }

    return compilerCoreLookupLLVMLocalRecordEnd(localValues: localValues, recordStart: recordStart, recordEnd: recordEnd + 1, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: foundRecord)
}

function compilerCoreLookupLLVMLocalOperand(localValues: String, name: String): String {
    let localRecord: String(compilerCoreLookupLLVMLocalRecord(localValues: localValues, name: name))
    let localRecordLength: Int(stringLength(value: localRecord))
    state sourceIndex: Int(0)

    while sourceIndex < localRecordLength {
        if hasRangePrefix(source: localRecord, start: sourceIndex, prefix: String("@TYPE@")) {
            return localRecord.substring(start: 0, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return localRecord
}

function compilerCoreLookupLLVMLocalType(localValues: String, name: String): String {
    let localRecord: String(compilerCoreLookupLLVMLocalRecord(localValues: localValues, name: name))
    let localRecordLength: Int(stringLength(value: localRecord))
    state sourceIndex: Int(0)

    while sourceIndex < localRecordLength {
        if hasRangePrefix(source: localRecord, start: sourceIndex, prefix: String("@TYPE@")) {
            let typeStart: Int(sourceIndex + 6)
            state typeEnd: Int(0)
            typeEnd: typeStart
            while typeEnd < localRecordLength && !hasRangePrefix(source: localRecord, start: typeEnd, prefix: String("@RANGE@")) {
                typeEnd: typeEnd + 1
            }
            return localRecord.substring(start: typeStart, end: typeEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("i32")
}

function compilerCoreLookupLLVMLocalRangeType(localValues: String, name: String): String {
    let localRecord: String(compilerCoreLookupLLVMLocalRecord(localValues: localValues, name: name))
    let localRecordLength: Int(stringLength(value: localRecord))
    state sourceIndex: Int(0)

    while sourceIndex < localRecordLength {
        if hasRangePrefix(source: localRecord, start: sourceIndex, prefix: String("@RANGE@")) {
            return localRecord.substring(start: sourceIndex + 7, end: localRecordLength)
        }
        sourceIndex: sourceIndex + 1
    }

    return compilerCoreRangeTypeNameForLLVMType(typeName: compilerCoreLookupLLVMLocalType(localValues: localValues, name: name))
}

function compilerCoreRangeTypeNameForLLVMType(typeName: String): String {
    if typeName == String("i1") {
        return String("Bool")
    }

    if typeName == String("ptr") {
        return String("String")
    }

    return String("Int")
}

function compilerCoreLLVMLowerIntegerCallArguments(declarationRecords: String, localValues: String, argumentsSummary: String, temporaryIndex: Int): CompilerLLVMCallArguments {
    state callArgumentRecords: String("")
    state renderedCallArguments: String("")
    state callArgumentTemporaryIndex: Int(0)
    callArgumentTemporaryIndex: temporaryIndex
    state callArgumentSourceIndex: Int(0)
    let callArgumentsLength: Int(stringLength(value: argumentsSummary))
    state callArgumentOrdinal: Int(0)

    while callArgumentSourceIndex < callArgumentsLength {
        let callArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: argumentsSummary, start: callArgumentSourceIndex))
        if callArgumentExpression == String("") {
            return CompilerLLVMCallArguments(
                instructionRecords: callArgumentRecords,
                renderedArguments: renderedCallArguments,
                nextTemporary: callArgumentTemporaryIndex
            )
        }

        let loweredCallArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: callArgumentExpression, expectedTypeName: String(""), temporaryIndex: callArgumentTemporaryIndex))
        callArgumentRecords: "\(callArgumentRecords)\(loweredCallArgument.instructionRecords)"
        if callArgumentOrdinal == 0 {
            renderedCallArguments: "\(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        } else {
            renderedCallArguments: "\(renderedCallArguments), \(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        }
        callArgumentTemporaryIndex: loweredCallArgument.nextTemporary
        callArgumentOrdinal: callArgumentOrdinal + 1
        callArgumentSourceIndex: compilerCoreCallArgumentNextIndex(argumentsSummary: argumentsSummary, start: callArgumentSourceIndex)
    }

    return CompilerLLVMCallArguments(
        instructionRecords: callArgumentRecords,
        renderedArguments: renderedCallArguments,
        nextTemporary: callArgumentTemporaryIndex
    )
}

function compilerCoreLLVMLowerExpressionRecord(declarationRecords: String, localValues: String, expressionRecord: String, fallbackSummary: String, expectedTypeName: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    if expressionRecord == String("") {
        return compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: fallbackSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
    }

    let kind: String(compilerCoreExpressionRecordKind(record: expressionRecord))
    let value: String(compilerCoreExpressionRecordValue(record: expressionRecord))

    if kind == String("integerLiteral") {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: value,
            typeName: String("i32"),
            nextTemporary: temporaryIndex
        )
    }

    if kind == String("stringLiteral") {
        let literalContent: String(compilerCoreStringLiteralContent(text: value))
        if compilerCoreStringContentHasInterpolation(content: literalContent) {
            return compilerCoreLLVMLowerInterpolatedStringContent(declarationRecords: declarationRecords, localValues: localValues, content: literalContent, temporaryIndex: temporaryIndex)
        }
        let literalContentLength: Int(stringLength(value: literalContent))
        let literalByteCount: Int(literalContentLength + 1)
        let literalGlobalName: String(".str.\(temporaryIndex)")
        let literalGlobalRecord: String(compilerCoreLLVMGlobalStringRecord(name: literalGlobalName, byteCount: literalByteCount, text: literalContent))
        return CompilerLLVMLoweredExpression(
            instructionRecords: literalGlobalRecord,
            operand: "getelementptr inbounds ([\(literalByteCount) x i8], ptr @\(literalGlobalName), i32 0, i32 0)",
            typeName: String("ptr"),
            nextTemporary: temporaryIndex + 1
        )
    }

    if kind == String("boolLiteral") {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: value,
            typeName: String("i1"),
            nextTemporary: temporaryIndex
        )
    }

    if kind == String("identifier") {
        if value == String("nil") {
            return CompilerLLVMLoweredExpression(instructionRecords: String(""), operand: String("null"), typeName: String("ptr"), nextTemporary: temporaryIndex)
        }
        let identifierValue: String(compilerCoreLookupLLVMLocalOperand(localValues: localValues, name: value))
        if identifierValue != String("") {
            let identifierType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: value))
            return CompilerLLVMLoweredExpression(
                instructionRecords: String(""),
                operand: identifierValue,
                typeName: identifierType,
                nextTemporary: temporaryIndex
            )
        }
        let unresolvedIdentifierTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
        return CompilerLLVMLoweredExpression(
            instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unresolvedIdentifier:\(value):localNames=\(compilerCoreLLVMLocalNames(localValues: localValues))"),
            operand: compilerCoreLLVMDefaultReturnValue(typeName: unresolvedIdentifierTypeName),
            typeName: unresolvedIdentifierTypeName,
            nextTemporary: temporaryIndex
        )
    }

    if kind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        state functionName: String("")
        functionName: compilerCoreExpressionRecordValue(record: calleeRecord)
        if functionName == String("") {
            functionName: value
        }
        let argumentRecords: String(compilerCoreExpressionRecordArguments(record: expressionRecord))
        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") && (functionName == String("String") || functionName == String("Int") || functionName == String("Bool")) {
            let wrappedArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
            return compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: wrappedArgumentRecord, fallbackSummary: String(""), expectedTypeName: functionName, temporaryIndex: temporaryIndex)
        }

        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") && functionName == String("print") {
            let printArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
            let loweredPrintArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: printArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
            state printTemporaryIndex: Int(0)
            printTemporaryIndex: loweredPrintArgument.nextTemporary
            let printResultOperand: String("%r\(printTemporaryIndex)")
            let printInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: printResultOperand,
                operation: String("puts"),
                typeName: String("i32"),
                left: loweredPrintArgument.operand,
                right: String("")
            ))
            let printInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: printInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredPrintArgument.instructionRecords)\(printInstructionRecord)",
                operand: printResultOperand,
                typeName: String("i32"),
                nextTemporary: printTemporaryIndex + 1
            )
        }

        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") && compilerCoreDeclarationRecordsContainsConstruct(records: declarationRecords, name: functionName) {
            return compilerCoreLLVMLowerConstructInitializer(declarationRecords: declarationRecords, localValues: localValues, constructName: functionName, argumentRecords: argumentRecords, temporaryIndex: temporaryIndex)
        }

        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("member") {
            let memberBaseRecord: String(compilerCoreExpressionRecordLeft(record: calleeRecord))
            let loweredBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: memberBaseRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
            if functionName == String("character") {
                let indexArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
                let loweredIndexArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: indexArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("Int"), temporaryIndex: loweredBase.nextTemporary))
                let memberCallResultOperand: String("%r\(loweredIndexArgument.nextTemporary)")
                let memberCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                    result: memberCallResultOperand,
                    operation: String("call"),
                    typeName: String("ptr"),
                    left: String("stringCharacter"),
                    right: "\(loweredBase.typeName) \(loweredBase.operand), \(loweredIndexArgument.typeName) \(loweredIndexArgument.operand)"
                ))
                let memberCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: memberCallInstruction))
                return CompilerLLVMLoweredExpression(
                    instructionRecords: "\(loweredBase.instructionRecords)\(loweredIndexArgument.instructionRecords)\(memberCallInstructionRecord)",
                    operand: memberCallResultOperand,
                    typeName: String("ptr"),
                    nextTemporary: loweredIndexArgument.nextTemporary + 1
                )
            }

            if functionName == String("substring") {
                let startArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
                let loweredStartArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: startArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("Int"), temporaryIndex: loweredBase.nextTemporary))
                let endArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 1))
                let loweredEndArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: endArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("Int"), temporaryIndex: loweredStartArgument.nextTemporary))
                let substringCallResultOperand: String("%r\(loweredEndArgument.nextTemporary)")
                let substringCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                    result: substringCallResultOperand,
                    operation: String("call"),
                    typeName: String("ptr"),
                    left: String("stringSubstring"),
                    right: "\(loweredBase.typeName) \(loweredBase.operand), \(loweredStartArgument.typeName) \(loweredStartArgument.operand), \(loweredEndArgument.typeName) \(loweredEndArgument.operand)"
                ))
                let substringCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: substringCallInstruction))
                return CompilerLLVMLoweredExpression(
                    instructionRecords: "\(loweredBase.instructionRecords)\(loweredStartArgument.instructionRecords)\(loweredEndArgument.instructionRecords)\(substringCallInstructionRecord)",
                    operand: substringCallResultOperand,
                    typeName: String("ptr"),
                    nextTemporary: loweredEndArgument.nextTemporary + 1
                )
            }
        }

        if compilerCoreLLVMBuiltinFunctionReturnType(name: functionName) == String("") && !compilerCoreDeclarationRecordsContainsFunction(records: declarationRecords, name: functionName) {
            let unresolvedCallTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unresolvedCall:\(functionName)"),
                operand: compilerCoreLLVMDefaultReturnValue(typeName: unresolvedCallTypeName),
                typeName: unresolvedCallTypeName,
                nextTemporary: temporaryIndex
            )
        }

        let loweredCallArguments: CompilerLLVMCallArguments(compilerCoreLLVMLowerCallArgumentRecords(declarationRecords: declarationRecords, localValues: localValues, argumentRecords: argumentRecords, temporaryIndex: temporaryIndex))
        state callTemporaryIndex: Int(0)
        callTemporaryIndex: loweredCallArguments.nextTemporary
        let callResultOperand: String("%r\(callTemporaryIndex)")
        let callReturnType: String(compilerCoreLLVMCallReturnType(declarationRecords: declarationRecords, name: functionName, expectedTypeName: expectedTypeName))
        let callInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: callResultOperand,
            operation: String("call"),
            typeName: callReturnType,
            left: functionName,
            right: loweredCallArguments.renderedArguments
        ))
        let callInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: callInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredCallArguments.instructionRecords)\(callInstructionRecord)",
            operand: callResultOperand,
            typeName: callReturnType,
            nextTemporary: callTemporaryIndex + 1
        )
    }

    if kind == String("member") {
        let constructMemberBaseRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        let loweredConstructMemberBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: constructMemberBaseRecord, fallbackSummary: String(""), expectedTypeName: String(""), temporaryIndex: temporaryIndex))
        let constructMemberBaseRangeType: String(compilerCoreExpressionRecordRangeType(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: constructMemberBaseRecord))
        state constructMemberRangeType: String("")
        constructMemberRangeType: compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: constructMemberBaseRangeType, memberName: value)
        if constructMemberRangeType == String("") {
            constructMemberRangeType: expectedTypeName
        }
        if constructMemberRangeType != String("") {
            return compilerCoreLLVMLowerConstructMemberAccess(base: loweredConstructMemberBase, memberName: value, memberType: constructMemberRangeType)
        }
    }

    if kind == String("prefix") {
        let operandRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        if operandRecord == String("") {
            return compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: fallbackSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
        }
        state prefixExpectedTypeName: String("")
        prefixExpectedTypeName: expectedTypeName
        if value == String("!") {
            prefixExpectedTypeName: String("Bool")
        } else if value == String("-") {
            prefixExpectedTypeName: String("Int")
        }
        let loweredOperand: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: operandRecord, fallbackSummary: String(""), expectedTypeName: prefixExpectedTypeName, temporaryIndex: temporaryIndex))
        let prefixResultOperand: String("%r\(loweredOperand.nextTemporary)")
        let prefixInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: prefixResultOperand,
            operation: compilerCoreLLVMInstructionForPrefixOperator(operatorText: value),
            typeName: compilerCoreLLVMTypeForPrefixOperator(operatorText: value, operandType: loweredOperand.typeName),
            left: compilerCoreLLVMLeftValueForPrefixOperator(operatorText: value, operand: loweredOperand.operand),
            right: compilerCoreLLVMRightValueForPrefixOperator(operatorText: value, operand: loweredOperand.operand)
        ))
        let prefixInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: prefixInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredOperand.instructionRecords)\(prefixInstructionRecord)",
            operand: prefixResultOperand,
            typeName: prefixInstruction.typeName,
            nextTemporary: loweredOperand.nextTemporary + 1
        )
    }

    if kind == String("binary") {
        let leftRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        let rightRecord: String(compilerCoreExpressionRecordRight(record: expressionRecord))
        if leftRecord == String("") || rightRecord == String("") {
            return compilerCoreLLVMLowerIntegerExpression(declarationRecords: declarationRecords, localValues: localValues, expressionSummary: fallbackSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
        }
        if value == String("??") || value == String("questionQuestion") {
            let loweredOptional: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex))
            if loweredOptional.operand != String("0") || loweredOptional.typeName != String("i32") {
                return CompilerLLVMLoweredExpression(
                    instructionRecords: loweredOptional.instructionRecords,
                    operand: loweredOptional.operand,
                    typeName: loweredOptional.typeName,
                    nextTemporary: loweredOptional.nextTemporary
                )
            }

            return compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
        }

        state initialLeftExpectedTypeName: String("")
        state initialRightExpectedTypeName: String("")
        if compilerCoreLLVMResultTypeForOperator(operatorText: value) == String("i1") {
            initialLeftExpectedTypeName: compilerCoreExpressionRecordRangeType(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: rightRecord)
            initialRightExpectedTypeName: compilerCoreExpressionRecordRangeType(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: leftRecord)
        }
        let initialLoweredLeft: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: initialLeftExpectedTypeName, temporaryIndex: temporaryIndex))
        let initialLoweredRight: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: initialRightExpectedTypeName, temporaryIndex: initialLoweredLeft.nextTemporary))
        state loweredLeft: CompilerLLVMLoweredExpression(initialLoweredLeft)
        state loweredRight: CompilerLLVMLoweredExpression(initialLoweredRight)
        if compilerCoreLLVMResultTypeForOperator(operatorText: value) == String("i1") && initialLoweredLeft.typeName != initialLoweredRight.typeName {
            if initialLoweredRight.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            } else if initialLoweredLeft.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            }
        }
        let resultOperand: String("%r\(loweredRight.nextTemporary)")
        let instructionName: String(compilerCoreLLVMInstructionForOperator(operatorText: value))
        let resultType: String(compilerCoreLLVMResultTypeForOperator(operatorText: value))
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (value == String("==") || value == String("!=") || value == String("bangEqual")) {
            let stringEqualInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringEqual"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let stringEqualRecord: String(compilerCoreLLVMInstructionRecord(instruction: stringEqualInstruction))
            let comparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state comparisonOperation: String("icmp ne")
            if value == String("!=") || value == String("bangEqual") {
                comparisonOperation: String("icmp eq")
            }
            let comparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: comparisonResultOperand,
                operation: comparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let comparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: comparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(stringEqualRecord)\(comparisonRecord)",
                operand: comparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (value == String(">") || value == String("<") || value == String(">=") || value == String("<=") || value == String("greater") || value == String("less") || value == String("greaterEqual") || value == String("lessEqual")) {
            let stringCompareInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringCompare"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let stringCompareRecord: String(compilerCoreLLVMInstructionRecord(instruction: stringCompareInstruction))
            let relationalComparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state relationalComparisonOperation: String("icmp sgt")
            if value == String("<") || value == String("less") {
                relationalComparisonOperation: String("icmp slt")
            } else if value == String(">=") || value == String("greaterEqual") {
                relationalComparisonOperation: String("icmp sge")
            } else if value == String("<=") || value == String("lessEqual") {
                relationalComparisonOperation: String("icmp sle")
            }
            let relationalComparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: relationalComparisonResultOperand,
                operation: relationalComparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let relationalComparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: relationalComparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(stringCompareRecord)\(relationalComparisonRecord)",
                operand: relationalComparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        let instruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: resultOperand,
            operation: instructionName,
            typeName: loweredLeft.typeName,
            left: loweredLeft.operand,
            right: loweredRight.operand
        ))
        let instructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: instruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(instructionRecord)",
            operand: resultOperand,
            typeName: resultType,
            nextTemporary: loweredRight.nextTemporary + 1
        )
    }

    let unsupportedTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
    return CompilerLLVMLoweredExpression(
        instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unsupportedExpressionRecord:\(kind):\(value)"),
        operand: compilerCoreLLVMDefaultReturnValue(typeName: unsupportedTypeName),
        typeName: unsupportedTypeName,
        nextTemporary: temporaryIndex
    )
}

function compilerCoreSingleBackslash(): String {
    let pair: String("\\")
    return pair.substring(start: 0, end: 1)
}

function compilerCoreNewlineCharacter(): String {
    let value: String("
")
    return value.substring(start: 0, end: 1)
}

function compilerCoreTabCharacter(): String {
    let value: String("	")
    return value.substring(start: 0, end: 1)
}

function compilerCoreMaterializeLLVMText(text: String): String {
    let textLength: Int(stringLength(value: text))
    let backslash: String(compilerCoreSingleBackslash())
    let outputBuffer: TextBuffer(textBufferCreate(capacity: textLength))
    state sourceIndex: Int(0)

    while sourceIndex < textLength {
        if stringHasPrefix(source: text, start: sourceIndex, prefix: backslash) && sourceIndex + 1 < textLength {
            let escaped: String(text.character(index: sourceIndex + 1))
            if escaped == String("n") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
                sourceIndex: sourceIndex + 2
            } else if escaped == String("t") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreTabCharacter())
                sourceIndex: sourceIndex + 2
            } else if isRangeQuote(character: escaped) {
                textBufferAppend(buffer: outputBuffer, text: escaped)
                sourceIndex: sourceIndex + 2
            } else if escaped == backslash {
                textBufferAppend(buffer: outputBuffer, text: backslash)
                sourceIndex: sourceIndex + 2
            } else {
                textBufferAppendCharacter(buffer: outputBuffer, source: text, index: sourceIndex)
                sourceIndex: sourceIndex + 1
            }
        } else {
            textBufferAppendCharacter(buffer: outputBuffer, source: text, index: sourceIndex)
            sourceIndex: sourceIndex + 1
        }
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStringContentHasInterpolation(content: String): Bool {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state sourceIndex: Int(0)

    while sourceIndex + 1 < contentLength {
        if content.character(index: sourceIndex) == backslash && content.character(index: sourceIndex + 1) == String("(") {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreLLVMLowerPlainStringContent(content: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let literalContentLength: Int(stringLength(value: content))
    let literalByteCount: Int(literalContentLength + 1)
    let literalGlobalName: String(".str.\(temporaryIndex)")
    let literalGlobalRecord: String(compilerCoreLLVMGlobalStringRecord(name: literalGlobalName, byteCount: literalByteCount, text: content))
    return CompilerLLVMLoweredExpression(
        instructionRecords: literalGlobalRecord,
        operand: "getelementptr inbounds ([\(literalByteCount) x i8], ptr @\(literalGlobalName), i32 0, i32 0)",
        typeName: String("ptr"),
        nextTemporary: temporaryIndex + 1
    )
}

function compilerCoreLLVMLowerStringValueFromExpression(loweredExpression: CompilerLLVMLoweredExpression): CompilerLLVMLoweredExpression {
    if loweredExpression.typeName == String("ptr") {
        return loweredExpression
    }

    if loweredExpression.typeName == String("i32") {
        let intStringOperand: String("%r\(loweredExpression.nextTemporary)")
        let intStringInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: intStringOperand,
            operation: String("call"),
            typeName: String("ptr"),
            left: String("stringFromInt"),
            right: "i32 \(loweredExpression.operand)"
        ))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredExpression.instructionRecords)\(compilerCoreLLVMInstructionRecord(instruction: intStringInstruction))",
            operand: intStringOperand,
            typeName: String("ptr"),
            nextTemporary: loweredExpression.nextTemporary + 1
        )
    }

    if loweredExpression.typeName == String("i1") {
        let boolStringOperand: String("%r\(loweredExpression.nextTemporary)")
        let boolStringInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: boolStringOperand,
            operation: String("call"),
            typeName: String("ptr"),
            left: String("stringFromBool"),
            right: "i1 \(loweredExpression.operand)"
        ))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredExpression.instructionRecords)\(compilerCoreLLVMInstructionRecord(instruction: boolStringInstruction))",
            operand: boolStringOperand,
            typeName: String("ptr"),
            nextTemporary: loweredExpression.nextTemporary + 1
        )
    }

    return compilerCoreLLVMLowerPlainStringContent(content: String(""), temporaryIndex: loweredExpression.nextTemporary)
}

function compilerCoreLLVMLowerInterpolatedExpression(declarationRecords: String, localValues: String, expressionText: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let expressionLength: Int(stringLength(value: expressionText))
    let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: expressionText, start: 0, limit: expressionLength))
    if maybeExpression == nil {
        return compilerCoreLLVMLowerPlainStringContent(content: String(""), temporaryIndex: temporaryIndex)
    }

    let fallbackExpression: CompilerExpression(compilerCoreMissingExpression(start: 0))
    let expression: CompilerExpression(maybeExpression ?? fallbackExpression)
    let loweredExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: expression.record, fallbackSummary: expression.summary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
    return compilerCoreLLVMLowerStringValueFromExpression(loweredExpression: loweredExpression)
}

function compilerCoreInterpolatedExpressionEnd(content: String, start: Int): Int {
    let contentLength: Int(stringLength(value: content))
    state sourceIndex: Int(0)
    sourceIndex: start
    state parenDepth: Int(0)

    while sourceIndex < contentLength {
        let character: String(content.character(index: sourceIndex))
        if character == String("(") {
            parenDepth: parenDepth + 1
        } else if character == String(")") {
            if parenDepth == 0 {
                return sourceIndex
            }
            parenDepth: parenDepth - 1
        }
        sourceIndex: sourceIndex + 1
    }

    return contentLength
}

function compilerCoreLLVMAppendStringPart(instructionRecords: String, currentOperand: String, part: CompilerLLVMLoweredExpression, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    if currentOperand == String("") {
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(instructionRecords)\(part.instructionRecords)",
            operand: part.operand,
            typeName: String("ptr"),
            nextTemporary: part.nextTemporary
        )
    }

    let concatOperand: String("%r\(part.nextTemporary)")
    let concatInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
        result: concatOperand,
        operation: String("call"),
        typeName: String("ptr"),
        left: String("stringConcat"),
        right: "ptr \(currentOperand), ptr \(part.operand)"
    ))
    return CompilerLLVMLoweredExpression(
        instructionRecords: "\(instructionRecords)\(part.instructionRecords)\(compilerCoreLLVMInstructionRecord(instruction: concatInstruction))",
        operand: concatOperand,
        typeName: String("ptr"),
        nextTemporary: part.nextTemporary + 1
    )
}

function compilerCoreLLVMLowerInterpolatedStringContent(declarationRecords: String, localValues: String, content: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state sourceIndex: Int(0)
    state segmentStart: Int(0)
    state instructionRecords: String("")
    state currentOperand: String("")
    state nextTemporary: Int(0)
    nextTemporary: temporaryIndex

    while sourceIndex + 1 < contentLength {
        if content.character(index: sourceIndex) == backslash && content.character(index: sourceIndex + 1) == String("(") {
            let segment: String(content.substring(start: segmentStart, end: sourceIndex))
            if segment != String("") {
                let loweredSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerPlainStringContent(content: segment, temporaryIndex: nextTemporary))
                let appendedSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMAppendStringPart(instructionRecords: instructionRecords, currentOperand: currentOperand, part: loweredSegment, temporaryIndex: nextTemporary))
                instructionRecords: appendedSegment.instructionRecords
                currentOperand: appendedSegment.operand
                nextTemporary: appendedSegment.nextTemporary
            }

            let expressionEnd: Int(compilerCoreInterpolatedExpressionEnd(content: content, start: sourceIndex + 2))
            if expressionEnd < contentLength {
                let expressionText: String(content.substring(start: sourceIndex + 2, end: expressionEnd))
                let loweredInterpolation: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerInterpolatedExpression(declarationRecords: declarationRecords, localValues: localValues, expressionText: expressionText, temporaryIndex: nextTemporary))
                let appendedInterpolation: CompilerLLVMLoweredExpression(compilerCoreLLVMAppendStringPart(instructionRecords: instructionRecords, currentOperand: currentOperand, part: loweredInterpolation, temporaryIndex: nextTemporary))
                instructionRecords: appendedInterpolation.instructionRecords
                currentOperand: appendedInterpolation.operand
                nextTemporary: appendedInterpolation.nextTemporary
                sourceIndex: expressionEnd + 1
                segmentStart: sourceIndex
            } else {
                sourceIndex: sourceIndex + 1
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    if segmentStart < contentLength {
        let trailingSegment: String(content.substring(start: segmentStart, end: contentLength))
        if trailingSegment != String("") {
            let loweredTrailingSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerPlainStringContent(content: trailingSegment, temporaryIndex: nextTemporary))
            let appendedTrailingSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMAppendStringPart(instructionRecords: instructionRecords, currentOperand: currentOperand, part: loweredTrailingSegment, temporaryIndex: nextTemporary))
            instructionRecords: appendedTrailingSegment.instructionRecords
            currentOperand: appendedTrailingSegment.operand
            nextTemporary: appendedTrailingSegment.nextTemporary
        }
    }

    if currentOperand == String("") {
        return compilerCoreLLVMLowerPlainStringContent(content: String(""), temporaryIndex: nextTemporary)
    }

    return CompilerLLVMLoweredExpression(
        instructionRecords: instructionRecords,
        operand: currentOperand,
        typeName: String("ptr"),
        nextTemporary: nextTemporary
    )
}

function compilerCoreLLVMLowerConstructInitializer(declarationRecords: String, localValues: String, constructName: String, argumentRecords: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let constructNameLength: Int(stringLength(value: constructName))
    let constructNameBytes: Int(constructNameLength + 1)
    let constructNameGlobal: String(".str.\(temporaryIndex)")
    let constructNameRecord: String(compilerCoreLLVMGlobalStringRecord(name: constructNameGlobal, byteCount: constructNameBytes, text: constructName))
    let objectOperand: String("%r\(temporaryIndex + 1)")
    let createInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
        result: objectOperand,
        operation: String("call"),
        typeName: String("ptr"),
        left: String("rangeConstructCreate"),
        right: "ptr getelementptr inbounds ([\(constructNameBytes) x i8], ptr @\(constructNameGlobal), i32 0, i32 0)"
    ))
    state instructionRecords: String("\(constructNameRecord)\(compilerCoreLLVMInstructionRecord(instruction: createInstruction))")
    state currentObjectOperand: String(objectOperand)
    state nextTemporary: Int(temporaryIndex + 2)
    state argumentIndex: Int(0)
    let argumentsLength: Int(stringLength(value: argumentRecords))

    while argumentIndex < argumentsLength {
        let argumentRecord: String(compilerCoreCallArgumentRecordAt(records: argumentRecords, start: argumentIndex))
        if argumentRecord == String("") {
            return CompilerLLVMLoweredExpression(
                instructionRecords: instructionRecords,
                operand: currentObjectOperand,
                typeName: String("ptr"),
                nextTemporary: nextTemporary
            )
        }
        let fieldName: String(compilerCoreCallArgumentLabel(record: argumentRecord))
        let fieldType: String(compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: constructName, memberName: fieldName))
        let argumentExpressionRecord: String(compilerCoreCallArgumentExpressionRecord(record: argumentRecord))
        let argumentExpressionSummary: String(compilerCoreCallArgumentExpressionSummary(record: argumentRecord))
        let loweredArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: argumentExpressionRecord, fallbackSummary: argumentExpressionSummary, expectedTypeName: fieldType, temporaryIndex: nextTemporary))
        let fieldNameLength: Int(stringLength(value: fieldName))
        let fieldNameBytes: Int(fieldNameLength + 1)
        let fieldNameGlobal: String(".str.\(loweredArgument.nextTemporary)")
        let fieldNameRecord: String(compilerCoreLLVMGlobalStringRecord(name: fieldNameGlobal, byteCount: fieldNameBytes, text: fieldName))
        let setResultOperand: String("%r\(loweredArgument.nextTemporary + 1)")
        state setterName: String("rangeConstructSetPtr")
        if loweredArgument.typeName == String("i1") {
            setterName: String("rangeConstructSetBool")
        } else if loweredArgument.typeName == String("i32") {
            setterName: String("rangeConstructSetInt")
        }
        let setInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: setResultOperand,
            operation: String("call"),
            typeName: String("ptr"),
            left: setterName,
            right: "ptr \(currentObjectOperand), ptr getelementptr inbounds ([\(fieldNameBytes) x i8], ptr @\(fieldNameGlobal), i32 0, i32 0), \(loweredArgument.typeName) \(loweredArgument.operand)"
        ))
        instructionRecords: "\(instructionRecords)\(loweredArgument.instructionRecords)\(fieldNameRecord)\(compilerCoreLLVMInstructionRecord(instruction: setInstruction))"
        currentObjectOperand: setResultOperand
        nextTemporary: loweredArgument.nextTemporary + 2
        argumentIndex: compilerCoreCallArgumentRecordNextIndex(records: argumentRecords, start: argumentIndex)
    }

    return CompilerLLVMLoweredExpression(
        instructionRecords: instructionRecords,
        operand: currentObjectOperand,
        typeName: String("ptr"),
        nextTemporary: nextTemporary
    )
}

function compilerCoreLLVMLowerConstructMemberAccess(base: CompilerLLVMLoweredExpression, memberName: String, memberType: String): CompilerLLVMLoweredExpression {
    let memberNameLength: Int(stringLength(value: memberName))
    let memberNameBytes: Int(memberNameLength + 1)
    let memberNameGlobal: String(".str.\(base.nextTemporary)")
    let memberNameRecord: String(compilerCoreLLVMGlobalStringRecord(name: memberNameGlobal, byteCount: memberNameBytes, text: memberName))
    let resultOperand: String("%r\(base.nextTemporary + 1)")
    let resultType: String(compilerCoreLLVMTypeNameForRangeType(typeName: memberType))
    state getterName: String("rangeConstructGetPtr")
    if resultType == String("i1") {
        getterName: String("rangeConstructGetBool")
    } else if resultType == String("i32") {
        getterName: String("rangeConstructGetInt")
    }
    let getInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
        result: resultOperand,
        operation: String("call"),
        typeName: resultType,
        left: getterName,
        right: "ptr \(base.operand), ptr getelementptr inbounds ([\(memberNameBytes) x i8], ptr @\(memberNameGlobal), i32 0, i32 0)"
    ))
    return CompilerLLVMLoweredExpression(
        instructionRecords: "\(base.instructionRecords)\(memberNameRecord)\(compilerCoreLLVMInstructionRecord(instruction: getInstruction))",
        operand: resultOperand,
        typeName: resultType,
        nextTemporary: base.nextTemporary + 2
    )
}

function compilerCoreExpressionRecordRangeType(declarationRecords: String, localValues: String, expressionRecord: String): String {
    let kind: String(compilerCoreExpressionRecordKind(record: expressionRecord))
    let value: String(compilerCoreExpressionRecordValue(record: expressionRecord))

    if kind == String("identifier") {
        return compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: value)
    }

    if kind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") {
            let functionName: String(compilerCoreExpressionRecordValue(record: calleeRecord))
            if compilerCoreDeclarationRecordsContainsConstruct(records: declarationRecords, name: functionName) {
                return functionName
            }
            let returnType: String(compilerCoreDeclarationRecordsFunctionReturnType(records: declarationRecords, name: functionName))
            if returnType != String("") {
                return returnType
            }
        }
    }

    if kind == String("member") {
        let baseRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        let baseType: String(compilerCoreExpressionRecordRangeType(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: baseRecord))
        return compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: baseType, memberName: value)
    }

    if kind == String("integerLiteral") {
        return String("Int")
    }

    if kind == String("boolLiteral") {
        return String("Bool")
    }

    if kind == String("stringLiteral") {
        return String("String")
    }

    return String("")
}

function compilerCoreLLVMLowerCallArgumentRecords(declarationRecords: String, localValues: String, argumentRecords: String, temporaryIndex: Int): CompilerLLVMCallArguments {
    state callArgumentInstructionRecords: String("")
    state renderedCallArguments: String("")
    state callArgumentTemporaryIndex: Int(0)
    callArgumentTemporaryIndex: temporaryIndex
    state callArgumentSourceIndex: Int(0)
    let callArgumentsLength: Int(stringLength(value: argumentRecords))
    state callArgumentOrdinal: Int(0)

    while callArgumentSourceIndex < callArgumentsLength {
        let argumentRecord: String(compilerCoreCallArgumentRecordAt(records: argumentRecords, start: callArgumentSourceIndex))
        if argumentRecord == String("") {
            return CompilerLLVMCallArguments(
                instructionRecords: callArgumentInstructionRecords,
                renderedArguments: renderedCallArguments,
                nextTemporary: callArgumentTemporaryIndex
            )
        }

        let argumentExpressionRecord: String(compilerCoreCallArgumentExpressionRecord(record: argumentRecord))
        let argumentExpressionSummary: String(compilerCoreCallArgumentExpressionSummary(record: argumentRecord))
        let loweredCallArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: declarationRecords, localValues: localValues, expressionRecord: argumentExpressionRecord, fallbackSummary: argumentExpressionSummary, expectedTypeName: String(""), temporaryIndex: callArgumentTemporaryIndex))
        callArgumentInstructionRecords: "\(callArgumentInstructionRecords)\(loweredCallArgument.instructionRecords)"
        if callArgumentOrdinal == 0 {
            renderedCallArguments: "\(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        } else {
            renderedCallArguments: "\(renderedCallArguments), \(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        }
        callArgumentTemporaryIndex: loweredCallArgument.nextTemporary
        callArgumentOrdinal: callArgumentOrdinal + 1
        callArgumentSourceIndex: compilerCoreCallArgumentRecordNextIndex(records: argumentRecords, start: callArgumentSourceIndex)
    }

    return CompilerLLVMCallArguments(
        instructionRecords: callArgumentInstructionRecords,
        renderedArguments: renderedCallArguments,
        nextTemporary: callArgumentTemporaryIndex
    )
}

function compilerCoreCallArgumentExpressionRecordAtOrdinal(records: String, ordinal: Int): String {
    state sourceIndex: Int(0)
    state currentOrdinal: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreCallArgumentRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        if currentOrdinal == ordinal {
            return compilerCoreCallArgumentExpressionRecord(record: record)
        }

        currentOrdinal: currentOrdinal + 1
        sourceIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreCallArgumentExpression(argumentsSummary: String, start: Int): String {
    let argumentsSummaryLength: Int(stringLength(value: argumentsSummary))
    state sourceIndex: Int(0)
    sourceIndex: start
    while sourceIndex < argumentsSummaryLength {
        let character: String(argumentsSummary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("=") {
            let expressionStart: Int(sourceIndex + 1)
            let expressionEnd: Int(compilerCoreCallArgumentEndIndex(argumentsSummary: argumentsSummary, start: expressionStart))
            return argumentsSummary.substring(start: expressionStart, end: expressionEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreCallArgumentNextIndex(argumentsSummary: String, start: Int): Int {
    let argumentsSummaryLength: Int(stringLength(value: argumentsSummary))
    let argumentEnd: Int(compilerCoreCallArgumentEndIndex(argumentsSummary: argumentsSummary, start: start))
    if argumentEnd < argumentsSummaryLength {
        return argumentEnd + 1
    }

    return argumentsSummaryLength
}

function compilerCoreCallArgumentEndIndex(argumentsSummary: String, start: Int): Int {
    let argumentsSummaryLength: Int(stringLength(value: argumentsSummary))
    state sourceIndex: Int(0)
    sourceIndex: start
    state parenDepth: Int(0)
    state bracketDepth: Int(0)

    while sourceIndex < argumentsSummaryLength {
        let character: String(argumentsSummary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            parenDepth: parenDepth + 1
        } else if character == String(")") {
            parenDepth: parenDepth - 1
        } else if character == String("[") {
            bracketDepth: bracketDepth + 1
        } else if character == String("]") {
            bracketDepth: bracketDepth - 1
        } else if character == String(";") && parenDepth == 0 && bracketDepth == 0 {
            return sourceIndex
        }
        sourceIndex: sourceIndex + 1
    }

    return argumentsSummaryLength
}

function compilerCoreWrappedExpressionValue(summary: String, prefixLength: Int): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= prefixLength {
        return String("")
    }

    return summary.substring(start: prefixLength, end: summaryLength - 1)
}

function compilerCoreStringLiteralText(summary: String): String {
    if hasRangePrefix(source: summary, start: 0, prefix: String("stringLiteral(")) {
        return compilerCoreWrappedExpressionValue(summary: summary, prefixLength: 14)
    }

    return String("")
}

function compilerCoreStringLiteralContent(text: String): String {
    let textLength: Int(stringLength(value: text))
    if textLength >= 2 {
        state contentEnd: Int(0)
        contentEnd: textLength - 1
        let lastCharacter: String(text.substring(start: textLength - 1, end: textLength))
        if textLength >= 3 && lastCharacter == String(")") {
            let beforeLastCharacter: String(text.substring(start: textLength - 2, end: textLength - 1))
            if isRangeQuote(character: beforeLastCharacter) {
                contentEnd: textLength - 2
            }
        }
        return compilerCoreDecodeStringLiteralContent(content: text.substring(start: 1, end: contentEnd))
    }

    return String("")
}

function compilerCoreDecodeStringLiteralContent(content: String): String {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    let outputBuffer: TextBuffer(textBufferCreate(capacity: contentLength))
    state sourceIndex: Int(0)

    while sourceIndex < contentLength {
        if stringHasPrefix(source: content, start: sourceIndex, prefix: backslash) && sourceIndex + 1 < contentLength {
            let escaped: String(content.character(index: sourceIndex + 1))
            if escaped == String("n") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
                sourceIndex: sourceIndex + 2
            } else if escaped == String("t") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreTabCharacter())
                sourceIndex: sourceIndex + 2
            } else if isRangeQuote(character: escaped) {
                textBufferAppend(buffer: outputBuffer, text: escaped)
                sourceIndex: sourceIndex + 2
            } else if escaped == backslash {
                textBufferAppend(buffer: outputBuffer, text: backslash)
                sourceIndex: sourceIndex + 2
            } else {
                textBufferAppendCharacter(buffer: outputBuffer, source: content, index: sourceIndex)
                sourceIndex: sourceIndex + 1
            }
        } else {
            textBufferAppendCharacter(buffer: outputBuffer, source: content, index: sourceIndex)
            sourceIndex: sourceIndex + 1
        }
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreIdentifierExpressionName(summary: String): String {
    if hasRangePrefix(source: summary, start: 0, prefix: String("identifier(")) {
        return compilerCoreWrappedExpressionValue(summary: summary, prefixLength: 11)
    }

    return String("")
}

function compilerCoreIdentifierExpressionRecordName(record: String, fallbackSummary: String): String {
    if record != String("") && compilerCoreExpressionRecordKind(record: record) == String("identifier") {
        return compilerCoreExpressionRecordValue(record: record)
    }

    return compilerCoreIdentifierExpressionName(summary: fallbackSummary)
}

function compilerCoreCallIdentifierName(summary: String): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    state sourceIndex: Int(16)

    while sourceIndex < summaryLength {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String(")") {
            return summary.substring(start: 16, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreCallCalleeSummary(summary: String): String {
    let summaryLength: Int(stringLength(value: summary))
    if summaryLength <= 5 {
        return String("")
    }

    state sourceIndex: Int(5)
    state depth: Int(0)
    while sourceIndex < summaryLength {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            return summary.substring(start: 5, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreCallArgumentsSummary(summary: String): String {
    let summaryLength: Int(stringLength(value: summary))
    let argumentsPrefix: String("arguments=[")
    let argumentsPrefixLength: Int(stringLength(value: argumentsPrefix))
    state sourceIndex: Int(0)

    while sourceIndex < summaryLength {
        if hasRangePrefix(source: summary, start: sourceIndex, prefix: argumentsPrefix) {
            let argumentsStart: Int(sourceIndex + argumentsPrefixLength)
            state argumentsEnd: Int(0)
            argumentsEnd: summaryLength - 2
            if argumentsEnd < argumentsStart {
                return String("")
            }
            return summary.substring(start: argumentsStart, end: argumentsEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreMemberExpressionBase(summary: String): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            return summary.substring(start: 7, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreMemberExpressionName(summary: String): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            return summary.substring(start: sourceIndex + 1, end: contentEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCorePrefixExpressionOperator(summary: String): String {
    return compilerCorePrefixExpressionPart(summary: summary, partIndex: 0)
}

function compilerCorePrefixExpressionOperand(summary: String): String {
    return compilerCorePrefixExpressionPart(summary: summary, partIndex: 1)
}

function compilerCorePrefixExpressionPart(summary: String, partIndex: Int): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)
    state squareDepth: Int(0)
    state currentPart: Int(0)
    state partStart: Int(7)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String("[") {
            squareDepth: squareDepth + 1
        } else if character == String("]") {
            squareDepth: squareDepth - 1
        } else if character == String(",") && depth == 0 && squareDepth == 0 {
            if currentPart == partIndex {
                return summary.substring(start: partStart, end: sourceIndex)
            }
            currentPart: currentPart + 1
            partStart: sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    if currentPart == partIndex {
        return summary.substring(start: partStart, end: contentEnd)
    }

    return String("")
}

function compilerCoreLLVMInstructionForPrefixOperator(operatorText: String): String {
    if operatorText == String("!") {
        return String("xor")
    }

    if operatorText == String("-") {
        return String("sub")
    }

    return String("add")
}

function compilerCoreLLVMTypeForPrefixOperator(operatorText: String, operandType: String): String {
    if operatorText == String("!") {
        return String("i1")
    }

    if operatorText == String("-") {
        return String("i32")
    }

    return operandType
}

function compilerCoreLLVMLeftValueForPrefixOperator(operatorText: String, operand: String): String {
    if operatorText == String("-") {
        return String("0")
    }

    return operand
}

function compilerCoreLLVMRightValueForPrefixOperator(operatorText: String, operand: String): String {
    if operatorText == String("!") {
        return String("true")
    }

    return operand
}

function compilerCoreLLVMFunctionReturnType(declarationRecords: String, name: String): String {
    let builtinReturnType: String(compilerCoreLLVMBuiltinFunctionReturnType(name: name))
    if builtinReturnType != String("") {
        return builtinReturnType
    }

    let rangeReturnType: String(compilerCoreDeclarationRecordsFunctionReturnType(records: declarationRecords, name: name))
    if rangeReturnType != String("") {
        return compilerCoreLLVMTypeNameForRangeType(typeName: rangeReturnType)
    }

    return String("i32")
}

function compilerCoreLLVMBuiltinFunctionReturnType(name: String): String {
    if name == String("stringHasPrefix") {
        return String("i1")
    }

    if name == String("stringFindFrom") {
        return String("i32")
    }

    if name == String("stringFindFirstOf") {
        return String("i32")
    }

    if name == String("stringViewFrom") {
        return String("ptr")
    }

    if name == String("stringCharacterAt") {
        return String("ptr")
    }

    if name == String("stringByteAt") {
        return String("i32")
    }

    if name == String("stringFindByteOf") {
        return String("i32")
    }

    if name == String("textBufferCreate") {
        return String("ptr")
    }

    if name == String("textBufferAppend") || name == String("textBufferAppendInt") || name == String("textBufferAppendCharacter") || name == String("textBufferDestroy") {
        return String("i32")
    }

    if name == String("textBufferMaterialize") {
        return String("ptr")
    }

    if name == String("stringLength") {
        return String("i32")
    }

    if name == String("stringIndexOf") {
        return String("i32")
    }

    if name == String("stringSubstring") {
        return String("ptr")
    }

    if name == String("stringEqual") {
        return String("i32")
    }

    if name == String("commandLineArgument") {
        return String("ptr")
    }

    if name == String("commandLineArgumentCount") {
        return String("i32")
    }

    if name == String("readFile") {
        return String("ptr")
    }

    return String("")
}

function compilerCoreLLVMCallReturnType(declarationRecords: String, name: String, expectedTypeName: String): String {
    if expectedTypeName != String("") {
        return compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName)
    }

    return compilerCoreLLVMFunctionReturnType(declarationRecords: declarationRecords, name: name)
}

function compilerCoreDeclarationRecordsFunctionReturnType(records: String, name: String): String {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("function") && declarationName == name {
            return compilerCoreRecordField(record: record, prefix: String("returnType="))
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreDeclarationRecordsContainsFunction(records: String, name: String): Bool {
    return compilerCoreDeclarationRecordsFunctionReturnType(records: records, name: name) != String("")
}

function compilerCoreDeclarationRecordsContainsConstruct(records: String, name: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return false
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("construct") && declarationName == name {
            return true
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return false
}

function compilerCoreDeclarationRecordsFunctionParameterSummary(records: String, name: String): String {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("function") && declarationName == name {
            return compilerCoreRecordField(record: record, prefix: String("parameters="))
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreDeclarationRecordsConstructMemberSummary(records: String, name: String): String {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("construct") && declarationName == name {
            return compilerCoreRecordField(record: record, prefix: String("members="))
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreDeclarationRecordsConstructMemberType(records: String, constructName: String, memberName: String): String {
    let memberSummary: String(compilerCoreDeclarationRecordsConstructMemberSummary(records: records, name: constructName))
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: memberSummary))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: memberSummary, start: sourceIndex, prefix: String("member")) {
            let indexStart: Int(sourceIndex + 6)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: memberSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: memberSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let candidateName: String(memberSummary.substring(start: nameStart, end: nameEnd))
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: memberSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    if candidateName == memberName {
                        return memberSummary.substring(start: typeStart, end: typeEnd)
                    }
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return String("")
}

function compilerCoreLLVMTypeNameForRangeType(typeName: String): String {
    if typeName == String("Bool") {
        return String("i1")
    }

    if typeName == String("Optional<String>") {
        return String("ptr")
    }

    if typeName == String("TextBuffer") {
        return String("ptr")
    }

    if typeName == String("String") {
        return String("ptr")
    }

    if typeName == String("Int") {
        return String("i32")
    }

    return String("ptr")
}

function compilerCoreBinaryExpressionPart(summary: String, partIndex: Int): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)
    state currentPart: Int(0)
    state partStart: Int(7)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            if currentPart == partIndex {
                return summary.substring(start: partStart, end: sourceIndex)
            }
            currentPart: currentPart + 1
            partStart: sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    if currentPart == partIndex {
        return summary.substring(start: partStart, end: contentEnd)
    }

    return String("")
}

function compilerCoreLLVMInstructionForOperator(operatorText: String): String {
    if operatorText == String("==") {
        return String("icmp eq")
    }

    if operatorText == String("!=") || operatorText == String("bangEqual") {
        return String("icmp ne")
    }

    if operatorText == String("<") || operatorText == String("less") {
        return String("icmp slt")
    }

    if operatorText == String("<=") || operatorText == String("lessEqual") {
        return String("icmp sle")
    }

    if operatorText == String(">") || operatorText == String("greater") {
        return String("icmp sgt")
    }

    if operatorText == String(">=") || operatorText == String("greaterEqual") {
        return String("icmp sge")
    }

    if operatorText == String("&&") || operatorText == String("andAnd") {
        return String("and")
    }

    if operatorText == String("||") || operatorText == String("orOr") {
        return String("or")
    }

    if operatorText == String("+") || operatorText == String("plus") {
        return String("add")
    }

    if operatorText == String("-") || operatorText == String("minus") {
        return String("sub")
    }

    if operatorText == String("*") || operatorText == String("asterisk") {
        return String("mul")
    }

    if operatorText == String("/") || operatorText == String("slash") {
        return String("sdiv")
    }

    if operatorText == String("%") || operatorText == String("percent") {
        return String("srem")
    }

    return String("add")
}

function compilerCoreLLVMResultTypeForOperator(operatorText: String): String {
    if operatorText == String("==")
        || operatorText == String("!=")
        || operatorText == String("bangEqual")
        || operatorText == String("<")
        || operatorText == String("<=")
        || operatorText == String(">")
        || operatorText == String(">=")
        || operatorText == String("less")
        || operatorText == String("lessEqual")
        || operatorText == String("greater")
        || operatorText == String("greaterEqual")
        || operatorText == String("&&")
        || operatorText == String("andAnd")
        || operatorText == String("||")
        || operatorText == String("orOr")
    {
        return String("i1")
    }

    return String("i32")
}

function compilerCoreParseMainBlock(source: String): Optional<CompilerMainBlock> {
    let maybeToken: Optional<RangeLexedToken>(compilerCoreFindMainAttributeToken(source: source))
    if maybeToken == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: 0))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    return compilerCoreParseMainBlockBody(source: source, token: token)
}

function compilerCoreFindMainAttributeToken(source: String): Optional<RangeLexedToken> {
    let sourceLength: Int(stringLength(value: source))
    let attributeStart: Int(compilerCoreFindMainAttributeStart(source: source))
    if attributeStart >= sourceLength {
        return nil
    }

    return RangeLexedToken(kind: String("macroAttribute"), start: attributeStart, end: attributeStart + 5, text: compilerCoreMainAttributeText())
}

function compilerCoreFindMainAttributeStart(source: String): Int {
    return stringIndexOf(source: source, needle: compilerCoreMainAttributeText(), start: 0)
}

function compilerCoreMainAttributeText(): String {
    let atSign: String("@")
    return "\(atSign)main"
}

function compilerCoreTokenIsMainAttribute(token: RangeLexedToken): Bool {
    if token.kind != String("macroAttribute") {
        return false
    }
    return token.text == compilerCoreMainAttributeText()
}

function compilerCoreParseMainBlockBody(source: String, token: RangeLexedToken): Optional<CompilerMainBlock> {
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseMainBraceRange(source: source, start: token.end))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: token.end, end: token.end, next: token.end))
    let body: CompilerSourceRange(maybeBody ?? bodyFallback)
    return compilerCoreMainBlockFromRange(attributeStart: token.start, body: body)
}

function compilerCoreParseMainBraceRange(source: String, start: Int): Optional<CompilerSourceRange> {
    let sourceLength: Int(stringLength(value: source))
    let leftBrace: Int(stringIndexOf(source: source, needle: String("{"), start: start))
    if leftBrace >= sourceLength {
        return nil
    }

    return compilerCoreParseBraceRangeFromDepth(source: source, bodyStart: leftBrace + 1, searchStart: leftBrace + 1, depth: 1)
}

function compilerCoreParseBraceRangeFromDepth(source: String, bodyStart: Int, searchStart: Int, depth: Int): Optional<CompilerSourceRange> {
    let sourceLength: Int(stringLength(value: source))
    let nextLeft: Int(stringIndexOf(source: source, needle: String("{"), start: searchStart))
    let nextRight: Int(stringIndexOf(source: source, needle: String("}"), start: searchStart))
    if nextRight >= sourceLength {
        return nil
    }

    if nextLeft < nextRight {
        return compilerCoreParseBraceRangeFromDepth(source: source, bodyStart: bodyStart, searchStart: nextLeft + 1, depth: depth + 1)
    }

    return compilerCoreParseBraceRangeClosing(source: source, bodyStart: bodyStart, closingBrace: nextRight, depth: depth)
}

function compilerCoreParseBraceRangeClosing(source: String, bodyStart: Int, closingBrace: Int, depth: Int): Optional<CompilerSourceRange> {
    if depth == 1 {
        return CompilerSourceRange(start: bodyStart, end: closingBrace, next: closingBrace + 1)
    }

    return compilerCoreParseBraceRangeFromDepth(source: source, bodyStart: bodyStart, searchStart: closingBrace + 1, depth: depth - 1)
}

function compilerCoreMainBlockFromRange(attributeStart: Int, body: CompilerSourceRange): CompilerMainBlock {
    return CompilerMainBlock(
        attributeStart: attributeStart,
        bodyStart: body.start,
        bodyEnd: body.end
    )
}

function compilerCoreBlockStatementSummary(program: CompilerProgram, block: CompilerBlock): String {
    let parsedBlock: CompilerParsedBlock(parseCompilerBlock(program: program, block: block))
    return parsedBlock.statementSummary
}

function compilerCoreMainParsedBlock(program: CompilerProgram): CompilerParsedBlock {
    return CompilerParsedBlock(
        block: program.mainBlock,
        statementRecords: program.mainStatementRecords,
        statementSummary: program.mainStatementSummary
    )
}

function compilerCoreStatementRecordsASTSummary(records: String): String {
    state output: String("")
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: records))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        output: "\(output)ast\tstatement\t\(compilerCoreStatementSummary(statement: statement))\n"
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return output
}

function compilerCoreLLVMLowerLinearStatement(program: CompilerProgram, statement: CompilerStatement, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if (statement.kind == String("let") || statement.kind == String("state")) && compilerCoreCanLowerLocalType(declarationRecords: program.declarationRecords, typeName: statement.typeName) {
        let loweredLinearLocal: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: statement.typeName, temporaryIndex: temporaryIndex))
        return CompilerLLVMLoweredLinearStatement(
            handled: true,
            instructionRecords: loweredLinearLocal.instructionRecords,
            localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: statement.name, operand: loweredLinearLocal.operand, typeName: loweredLinearLocal.typeName, rangeTypeName: statement.typeName))",
            nextTemporary: loweredLinearLocal.nextTemporary,
            hasReturn: false,
            returnLLVMType: String(""),
            returnLLVMValue: String("")
        )
    }

    if statement.kind == String("expression") {
        let loweredLinearExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
        return CompilerLLVMLoweredLinearStatement(
            handled: true,
            instructionRecords: loweredLinearExpression.instructionRecords,
            localValues: localValues,
            nextTemporary: loweredLinearExpression.nextTemporary,
            hasReturn: false,
            returnLLVMType: String(""),
            returnLLVMValue: String("")
        )
    }

    if statement.kind == String("assignment") {
        state linearAssignmentName: String("")
        linearAssignmentName: statement.name
        if linearAssignmentName == String("") {
            linearAssignmentName: compilerCoreIdentifierExpressionRecordName(record: statement.targetRecord, fallbackSummary: statement.targetSummary)
        }
        return compilerCoreLLVMLowerLinearStatementRecordAssignmentName(program: program, assignmentName: linearAssignmentName, expressionSummary: statement.expressionSummary, expressionRecord: statement.expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statement.kind == String("return") {
        let loweredLinearReturn: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: expectedReturnType, temporaryIndex: temporaryIndex))
        return CompilerLLVMLoweredLinearStatement(
            handled: true,
            instructionRecords: loweredLinearReturn.instructionRecords,
            localValues: localValues,
            nextTemporary: loweredLinearReturn.nextTemporary,
            hasReturn: true,
            returnLLVMType: compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType),
            returnLLVMValue: loweredLinearReturn.operand
        )
    }

    return CompilerLLVMLoweredLinearStatement(
        handled: false,
        instructionRecords: String(""),
        localValues: localValues,
        nextTemporary: temporaryIndex,
        hasReturn: false,
        returnLLVMType: String(""),
        returnLLVMValue: String("")
    )
}

function compilerCoreCanLowerLocalType(declarationRecords: String, typeName: String): Bool {
    if typeName == String("Int") {
        return true
    }
    if typeName == String("Bool") {
        return true
    }
    if typeName == String("String") {
        return true
    }
    if typeName == String("TextBuffer") {
        return true
    }
    if compilerCoreTypeIsOptionalPointer(typeName: typeName) {
        return true
    }
    if compilerCoreDeclarationRecordsContainsConstruct(records: declarationRecords, name: typeName) {
        return true
    }
    return false
}

function compilerCoreTypeIsOptionalPointer(typeName: String): Bool {
    return hasRangePrefix(source: typeName, start: 0, prefix: String("Optional<"))
}

function compilerCoreLLVMLowerReturnStatementRecords(program: CompilerProgram, statementRecords: String, localValues: String, temporaryIndex: Int, breakLabel: String, continueLabel: String, expectedReturnType: String): CompilerLLVMLoweredReturnBlock {
    state llvmInstructionRecords: String("")
    state llvmLocalValues: String("")
    llvmLocalValues: localValues
    state llvmTemporaryIndex: Int(0)
    llvmTemporaryIndex: temporaryIndex
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: statementRecords))
    let expectedLLVMReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
    let defaultReturnValue: String(compilerCoreLLVMDefaultReturnValue(typeName: expectedLLVMReturnType))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return CompilerLLVMLoweredReturnBlock(
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                hasReturn: false,
                returnLLVMType: expectedLLVMReturnType,
                returnValue: defaultReturnValue,
                hasJump: false,
                jumpLabel: String("")
            )
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        let loweredLinearNestedStatement: CompilerLLVMLoweredLinearStatement(compilerCoreLLVMLowerLinearStatement(program: program, statement: statement, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType))
        if loweredLinearNestedStatement.handled {
            if loweredLinearNestedStatement.hasReturn {
                return CompilerLLVMLoweredReturnBlock(
                    instructionRecords: "\(llvmInstructionRecords)\(loweredLinearNestedStatement.instructionRecords)",
                    localValues: loweredLinearNestedStatement.localValues,
                    nextTemporary: loweredLinearNestedStatement.nextTemporary,
                    hasReturn: true,
                    returnLLVMType: loweredLinearNestedStatement.returnLLVMType,
                    returnValue: loweredLinearNestedStatement.returnLLVMValue,
                    hasJump: false,
                    jumpLabel: String("")
                )
            }

            llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearNestedStatement.instructionRecords)"
            llvmLocalValues: loweredLinearNestedStatement.localValues
            llvmTemporaryIndex: loweredLinearNestedStatement.nextTemporary
        } else if statement.kind == String("break") && breakLabel != String("") {
            return CompilerLLVMLoweredReturnBlock(
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                hasReturn: false,
                returnLLVMType: expectedLLVMReturnType,
                returnValue: defaultReturnValue,
                hasJump: true,
                jumpLabel: breakLabel
            )
        } else if statement.kind == String("continue") && continueLabel != String("") {
            return CompilerLLVMLoweredReturnBlock(
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                hasReturn: false,
                returnLLVMType: expectedLLVMReturnType,
                returnValue: defaultReturnValue,
                hasJump: true,
                jumpLabel: continueLabel
            )
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: statementRecords, start: statementIndex)
    }

    return CompilerLLVMLoweredReturnBlock(
        instructionRecords: llvmInstructionRecords,
        localValues: llvmLocalValues,
        nextTemporary: llvmTemporaryIndex,
        hasReturn: false,
        returnLLVMType: expectedLLVMReturnType,
        returnValue: defaultReturnValue,
        hasJump: false,
        jumpLabel: String("")
    )
}

function compilerCoreParseStatements(program: CompilerProgram, block: CompilerBlock): CompilerParsedStatements {
    let recordsBuffer: TextBuffer(textBufferCreate(capacity: 4096))
    let summaryBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    return compilerCoreParseStatementsIntoTextBuffers(program: program, block: block, recordsBuffer: recordsBuffer, summaryBuffer: summaryBuffer)
}

function compilerCoreParseStatementsIntoTextBuffers(program: CompilerProgram, block: CompilerBlock, recordsBuffer: TextBuffer, summaryBuffer: TextBuffer): CompilerParsedStatements {
    state sourceIndex: Int(compilerCoreBlockStart(block: block))
    state statementCount: Int(0)
    let blockEnd: Int(compilerCoreBlockEnd(block: block))
    while sourceIndex < blockEnd {
        sourceIndex: compilerCoreFirstNonWhitespaceIndex(source: program.source, start: sourceIndex, end: blockEnd)
        if sourceIndex < blockEnd {
            let maybeStatement: Optional<CompilerStatement>(parseCompilerStatement(program: program, start: sourceIndex, bodyEnd: blockEnd))
            if maybeStatement == nil {
                sourceIndex: sourceIndex + 1
            } else {
                let fallback: CompilerStatement(compilerCoreMissingStatement(start: sourceIndex, end: sourceIndex + 1))
                let statement: CompilerStatement(maybeStatement ?? fallback)
                textBufferAppend(buffer: recordsBuffer, text: compilerCoreStatementRecord(statement: statement))
                textBufferAppend(buffer: summaryBuffer, text: "statement\(statementCount)=\(statement.summary);")
                sourceIndex: statement.end
                statementCount: statementCount + 1
            }
        }
    }
    return compilerCoreParsedStatementsFromTextBuffers(block: block, recordsBuffer: recordsBuffer, summaryBuffer: summaryBuffer, statementCount: statementCount)
}

function compilerCoreParsedStatementsFromTextBuffers(block: CompilerBlock, recordsBuffer: TextBuffer, summaryBuffer: TextBuffer, statementCount: Int): CompilerParsedStatements {
    let records: String(textBufferMaterialize(buffer: recordsBuffer))
    let summary: String(textBufferMaterialize(buffer: summaryBuffer))
    textBufferDestroy(buffer: recordsBuffer)
    textBufferDestroy(buffer: summaryBuffer)
    return CompilerParsedStatements(records: records, summary: summary, count: statementCount, start: compilerCoreBlockStart(block: block), end: compilerCoreBlockEnd(block: block))
}

function compilerCoreBlockStart(block: CompilerBlock): Int {
    return block.start
}

function compilerCoreBlockEnd(block: CompilerBlock): Int {
    return block.end
}

function compilerCoreFirstNonWhitespaceIndex(source: String, start: Int, end: Int): Int {
    if start >= end {
        return end
    }
    if isRangeLexerWhitespace(character: source.character(index: start)) {
        return compilerCoreFirstNonWhitespaceIndex(source: source, start: start + 1, end: end)
    }
    return start
}

function compilerCoreMissingStatement(start: Int, end: Int): CompilerStatement {
    let missingExpression: CompilerExpression(compilerCoreMissingExpression(start: start))
    return CompilerStatement(kind: String("missing"), name: String(""), typeName: String(""), targetSummary: String(""), targetRecord: String(""), expressionKind: String("missing"), expressionValue: String(""), expressionSummary: String("missing"), expressionRecord: missingExpression.record, bodyStart: 0, bodyEnd: 0, elseBodyStart: 0, elseBodyEnd: 0, bodyStatementRecords: String(""), elseStatementRecords: String(""), summary: String(""), start: start, end: end)
}

function compilerCoreStatementRecord(statement: CompilerStatement): String {
    let head: String(compilerCoreStatementRecordHead(statement: statement))
    let expression: String(compilerCoreStatementRecordExpression(statement: statement))
    let ranges: String(compilerCoreStatementRecordRanges(statement: statement))
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    textBufferAppend(buffer: outputBuffer, text: head)
    textBufferAppend(buffer: outputBuffer, text: expression)
    textBufferAppend(buffer: outputBuffer, text: ranges)
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordHead(statement: CompilerStatement): String {
    let targetRecord: String(compilerCoreStatementRecordEncodeValue(value: statement.targetRecord))
    let expressionValue: String(compilerCoreStatementRecordEncodeValue(value: statement.expressionValue))
    state targetSummary: String("")
    targetSummary: statement.targetSummary
    if statement.targetRecord != String("") {
        targetSummary: String("")
    }
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    textBufferAppend(buffer: outputBuffer, text: "kind=\(statement.kind)|name=\(statement.name)|type=\(statement.typeName)|target=\(targetSummary)|targetRecord=")
    textBufferAppend(buffer: outputBuffer, text: targetRecord)
    textBufferAppend(buffer: outputBuffer, text: "|expressionKind=\(statement.expressionKind)|expressionValue=\(expressionValue)|")
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordExpression(statement: CompilerStatement): String {
    let expressionRecord: String(compilerCoreStatementRecordEncodeValue(value: statement.expressionRecord))
    state expressionSummary: String("")
    expressionSummary: statement.expressionSummary
    if statement.expressionRecord != String("") {
        expressionSummary: String("")
    }
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    textBufferAppend(buffer: outputBuffer, text: "expression=\(expressionSummary)|expressionRecord=")
    textBufferAppend(buffer: outputBuffer, text: expressionRecord)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyStart="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.bodyStart)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyEnd="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.bodyEnd)
    textBufferAppend(buffer: outputBuffer, text: String("|elseBodyStart="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.elseBodyStart)
    textBufferAppend(buffer: outputBuffer, text: String("|elseBodyEnd="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.elseBodyEnd)
    textBufferAppend(buffer: outputBuffer, text: String("|"))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordRanges(statement: CompilerStatement): String {
    let bodyRecords: String(compilerCoreStatementRecordEncodeValue(value: statement.bodyStatementRecords))
    let elseRecords: String(compilerCoreStatementRecordEncodeValue(value: statement.elseStatementRecords))
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    textBufferAppend(buffer: outputBuffer, text: String("start="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.start)
    textBufferAppend(buffer: outputBuffer, text: String("|end="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.end)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyRecords="))
    textBufferAppend(buffer: outputBuffer, text: bodyRecords)
    textBufferAppend(buffer: outputBuffer, text: String("|elseRecords="))
    textBufferAppend(buffer: outputBuffer, text: elseRecords)
    textBufferAppend(buffer: outputBuffer, text: String("|summary=~"))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordAt(records: String, start: Int): String {
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: String("~")))
    if recordEnd < 0 {
        return String("")
    }
    return stringViewFrom(source: records, start: start)
}

function compilerCoreStatementRecordNextIndex(records: String, start: Int): Int {
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: String("~")))
    if recordEnd < 0 {
        return stringLength(value: records)
    }
    return recordEnd + 1
}

function compilerCoreStatementRecordField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreStatementRecordTrailingField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreStatementRecordEncodeValue(value: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    let valueLength: Int(stringLength(value: value))

    while sourceIndex < valueLength {
        if stringHasPrefix(source: value, start: sourceIndex, prefix: String("@")) {
            textBufferAppend(buffer: outputBuffer, text: String("@AT@"))
        } else if stringHasPrefix(source: value, start: sourceIndex, prefix: String("|")) {
            textBufferAppend(buffer: outputBuffer, text: String("@PIPE@"))
        } else if stringHasPrefix(source: value, start: sourceIndex, prefix: String("~")) {
            textBufferAppend(buffer: outputBuffer, text: String("@TILDE@"))
        } else if stringHasPrefix(source: value, start: sourceIndex, prefix: compilerCoreNewlineCharacter()) {
            textBufferAppend(buffer: outputBuffer, text: String("@NEWLINE@"))
        } else if stringHasPrefix(source: value, start: sourceIndex, prefix: String(";")) {
            textBufferAppend(buffer: outputBuffer, text: String("@SEMICOLON@"))
        } else {
            textBufferAppendCharacter(buffer: outputBuffer, source: value, index: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordDecodeValue(value: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    let valueLength: Int(stringLength(value: value))

    while sourceIndex < valueLength {
        if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@PIPE@")) {
            textBufferAppend(buffer: outputBuffer, text: String("|"))
            sourceIndex: sourceIndex + 6
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@TILDE@")) {
            textBufferAppend(buffer: outputBuffer, text: String("~"))
            sourceIndex: sourceIndex + 7
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@NEWLINE@")) {
            textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
            sourceIndex: sourceIndex + 9
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@SEMICOLON@")) {
            textBufferAppend(buffer: outputBuffer, text: String(";"))
            sourceIndex: sourceIndex + 11
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@AT@")) {
            textBufferAppend(buffer: outputBuffer, text: String("@"))
            sourceIndex: sourceIndex + 4
        } else {
            textBufferAppendCharacter(buffer: outputBuffer, source: value, index: sourceIndex)
            sourceIndex: sourceIndex + 1
        }
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreParseDecimalInt(value: String): Int {
    state result: Int(0)
    state sourceIndex: Int(0)
    let valueLength: Int(stringLength(value: value))

    while sourceIndex < valueLength {
        let character: String(value.substring(start: sourceIndex, end: sourceIndex + 1))
        result: (result * 10) + compilerCoreDecimalDigitValue(character: character)
        sourceIndex: sourceIndex + 1
    }

    return result
}

function compilerCoreDecimalDigitValue(character: String): Int {
    if character == String("1") {
        return 1
    }
    if character == String("2") {
        return 2
    }
    if character == String("3") {
        return 3
    }
    if character == String("4") {
        return 4
    }
    if character == String("5") {
        return 5
    }
    if character == String("6") {
        return 6
    }
    if character == String("7") {
        return 7
    }
    if character == String("8") {
        return 8
    }
    if character == String("9") {
        return 9
    }

    return 0
}

function compilerCoreStatementFromRecord(record: String): CompilerStatement {
    let kind: String(compilerCoreStatementRecordField(record: record, prefix: String("kind=")))
    let name: String(compilerCoreStatementRecordField(record: record, prefix: String("name=")))
    let typeName: String(compilerCoreStatementRecordField(record: record, prefix: String("type=")))
    let targetRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("targetRecord="))))
    let expressionKind: String(compilerCoreStatementRecordField(record: record, prefix: String("expressionKind=")))
    let expressionValue: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("expressionValue="))))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("expressionRecord="))))
    state targetSummary: String("")
    targetSummary: compilerCoreStatementRecordField(record: record, prefix: String("target="))
    if targetSummary == String("") && targetRecord != String("") {
        targetSummary: compilerCoreExpressionRecordSummary(record: targetRecord)
    }
    state expressionSummary: String("")
    expressionSummary: compilerCoreStatementRecordField(record: record, prefix: String("expression="))
    if expressionSummary == String("") && expressionRecord != String("") {
        expressionSummary: compilerCoreExpressionRecordSummary(record: expressionRecord)
    }
    let bodyStart: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("bodyStart="))))
    let bodyEnd: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("bodyEnd="))))
    let elseBodyStart: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("elseBodyStart="))))
    let elseBodyEnd: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("elseBodyEnd="))))
    let start: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("start="))))
    let end: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("end="))))
    let bodyStatementRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("bodyRecords="))))
    let elseStatementRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("elseRecords="))))
    let summary: String(compilerCoreStatementRecordTrailingField(record: record, prefix: String("summary=")))

    return CompilerStatement(
        kind: kind,
        name: name,
        typeName: typeName,
        targetSummary: targetSummary,
        targetRecord: targetRecord,
        expressionKind: expressionKind,
        expressionValue: expressionValue,
        expressionSummary: expressionSummary,
        expressionRecord: expressionRecord,
        bodyStart: bodyStart,
        bodyEnd: bodyEnd,
        elseBodyStart: elseBodyStart,
        elseBodyEnd: elseBodyEnd,
        bodyStatementRecords: bodyStatementRecords,
        elseStatementRecords: elseStatementRecords,
        summary: summary,
        start: start,
        end: end
    )
}

function compilerCoreNameListContains(names: String, name: String): Bool {
    let namesLength: Int(stringLength(value: names))
    let nameRecord: String("\(name);")
    let nameRecordLength: Int(stringLength(value: nameRecord))
    state sourceIndex: Int(0)

    while sourceIndex < namesLength {
        if hasRangePrefix(source: names, start: sourceIndex, prefix: nameRecord) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreNameListNameAt(names: String, start: Int): String {
    let namesLength: Int(stringLength(value: names))
    state sourceIndex: Int(0)
    sourceIndex: start

    while sourceIndex < namesLength {
        if names.substring(start: sourceIndex, end: sourceIndex + 1) == String(";") {
            return names.substring(start: start, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreNameListNextIndex(names: String, start: Int): Int {
    let namesLength: Int(stringLength(value: names))
    state sourceIndex: Int(0)
    sourceIndex: start

    while sourceIndex < namesLength {
        if names.substring(start: sourceIndex, end: sourceIndex + 1) == String(";") {
            return sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    return namesLength
}

function compilerCoreNameListAppendingMissing(names: String, additionalNames: String): String {
    state output: String("")
    output: names
    state sourceIndex: Int(0)
    let additionalNamesLength: Int(stringLength(value: additionalNames))

    while sourceIndex < additionalNamesLength {
        let name: String(compilerCoreNameListNameAt(names: additionalNames, start: sourceIndex))
        if name != String("") && !compilerCoreNameListContains(names: output, name: name) {
            output: "\(output)\(name);"
        }
        sourceIndex: compilerCoreNameListNextIndex(names: additionalNames, start: sourceIndex)
    }

    return output
}

function compilerCoreStatementRecordsAssignmentNames(records: String): String {
    state assignmentNames: String("")
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return assignmentNames
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("assignment") {
            state assignmentName: String("")
            assignmentName: statement.name
            if assignmentName == String("") {
                assignmentName: compilerCoreIdentifierExpressionRecordName(record: statement.targetRecord, fallbackSummary: statement.targetSummary)
            }
            if assignmentName != String("") && !compilerCoreNameListContains(names: assignmentNames, name: assignmentName) {
                assignmentNames: "\(assignmentNames)\(assignmentName);"
            }
        }
        assignmentNames: compilerCoreNameListAppendingMissing(names: assignmentNames, additionalNames: compilerCoreStatementRecordsAssignmentNames(records: statement.bodyStatementRecords))
        assignmentNames: compilerCoreNameListAppendingMissing(names: assignmentNames, additionalNames: compilerCoreStatementRecordsAssignmentNames(records: statement.elseStatementRecords))
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return assignmentNames
}

function compilerCoreStatementRecordsContainReturn(records: String): Bool {
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return false
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("return") {
            return true
        }
        if compilerCoreStatementRecordsContainReturn(records: statement.bodyStatementRecords) {
            return true
        }
        if compilerCoreStatementRecordsContainReturn(records: statement.elseStatementRecords) {
            return true
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return false
}

function compilerCoreStatementRecordsContainControl(records: String): Bool {
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return false
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("if") || statement.kind == String("while") {
            return true
        }
        if compilerCoreStatementRecordsContainControl(records: statement.bodyStatementRecords) {
            return true
        }
        if compilerCoreStatementRecordsContainControl(records: statement.elseStatementRecords) {
            return true
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return false
}

function compilerCoreStatementRecordsCalledFunctionNames(records: String): String {
    state calledNames: String("")
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return calledNames
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: statement.expressionRecord, fallbackSummary: statement.expressionSummary))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: statement.targetRecord, fallbackSummary: statement.targetSummary))
        if statement.kind == String("if") || statement.kind == String("while") {
            calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreStatementRecordsCalledFunctionNames(records: statement.bodyStatementRecords))
            calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreStatementRecordsCalledFunctionNames(records: statement.elseStatementRecords))
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return calledNames
}

function compilerCoreReachableFunctionNames(program: CompilerProgram, roots: String): String {
    let recordsLength: Int(stringLength(value: program.declarationRecords))
    let rootedNames: String(compilerCoreReachableFunctionRootNames(program: program, roots: roots, sourceIndex: 0, recordsLength: recordsLength, reachableNames: roots))
    return compilerCoreReachableFunctionNamesExpanding(program: program, reachableNames: rootedNames, previouslyExpandedNames: roots, recordsLength: recordsLength)
}

function compilerCoreReachableFunctionRootNames(program: CompilerProgram, roots: String, sourceIndex: Int, recordsLength: Int, reachableNames: String): String {
    if sourceIndex >= recordsLength {
        return reachableNames
    }

    let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
    if record == String("") {
        return reachableNames
    }

    let nextReachableNames: String(compilerCoreReachableFunctionRootNamesAppendingRecord(program: program, roots: roots, record: record, reachableNames: reachableNames))
    let nextSourceIndex: Int(compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex))
    return compilerCoreReachableFunctionRootNames(program: program, roots: roots, sourceIndex: nextSourceIndex, recordsLength: recordsLength, reachableNames: nextReachableNames)
}

function compilerCoreReachableFunctionRootNamesAppendingRecord(program: CompilerProgram, roots: String, record: String, reachableNames: String): String {
    let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if declarationKind == String("function") && compilerCoreNameListContains(names: roots, name: declarationName) {
        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        let bodyCalledNames: String(compilerCoreFunctionDeclarationCalledFunctionNames(program: program, declaration: declaration))
        return compilerCoreNameListAppendingMissing(names: reachableNames, additionalNames: bodyCalledNames)
    }

    return reachableNames
}

function compilerCoreReachableFunctionNamesExpanding(program: CompilerProgram, reachableNames: String, previouslyExpandedNames: String, recordsLength: Int): String {
    let expandedNames: String(compilerCoreReachableFunctionNamesExpansionPass(program: program, reachableNames: reachableNames, previouslyExpandedNames: previouslyExpandedNames, sourceIndex: 0, recordsLength: recordsLength))
    if stringLength(value: expandedNames) > stringLength(value: reachableNames) {
        return compilerCoreReachableFunctionNamesExpanding(program: program, reachableNames: expandedNames, previouslyExpandedNames: reachableNames, recordsLength: recordsLength)
    }

    return expandedNames
}

function compilerCoreReachableFunctionNamesExpansionPass(program: CompilerProgram, reachableNames: String, previouslyExpandedNames: String, sourceIndex: Int, recordsLength: Int): String {
    if sourceIndex >= recordsLength {
        return reachableNames
    }

    let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
    if record == String("") {
        return reachableNames
    }

    let nextReachableNames: String(compilerCoreReachableFunctionNamesAppendingRecord(program: program, reachableNames: reachableNames, previouslyExpandedNames: previouslyExpandedNames, record: record))
    let nextSourceIndex: Int(compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex))
    return compilerCoreReachableFunctionNamesExpansionPass(program: program, reachableNames: nextReachableNames, previouslyExpandedNames: previouslyExpandedNames, sourceIndex: nextSourceIndex, recordsLength: recordsLength)
}

function compilerCoreReachableFunctionNamesAppendingRecord(program: CompilerProgram, reachableNames: String, previouslyExpandedNames: String, record: String): String {
    let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if declarationKind == String("function") && compilerCoreNameListContains(names: reachableNames, name: declarationName) && !compilerCoreNameListContains(names: previouslyExpandedNames, name: declarationName) {
        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if compilerCoreShouldExpandReachableFunction(declaration: declaration) {
            let bodyCalledNames: String(compilerCoreFunctionDeclarationCalledFunctionNames(program: program, declaration: declaration))
            return compilerCoreNameListAppendingMissing(names: reachableNames, additionalNames: bodyCalledNames)
        }
    }

    return reachableNames
}

function compilerCoreShouldExpandReachableFunction(declaration: CompilerTopLevelDeclaration): Bool {
    return compilerCoreSelectedHelperExclusionReason(declaration: declaration) == String("")
}

function compilerCoreFunctionDeclarationCalledFunctionNames(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): String {
    if declaration.statementRecords == String("") {
        return String("")
    }

    return compilerCoreStatementRecordsCalledFunctionNames(records: compilerCoreFunctionDeclarationStatementRecords(program: program, declaration: declaration))
}

function compilerCoreFunctionDeclarationStatementRecords(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): String {
    if declaration.statementRecords != String("") {
        return declaration.statementRecords
    }

    let functionBlock: CompilerBlock(CompilerBlock(start: declaration.bodyStart, end: declaration.bodyEnd))
    let parsedFunctionBlock: CompilerParsedBlock(parseCompilerBlock(program: program, block: functionBlock))
    return parsedFunctionBlock.statementRecords
}

function compilerCoreStatementRecordsWithoutExpressionRecords(records: String): String {
    state output: String("")
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        let strippedBodyRecords: String(compilerCoreStatementRecordsWithoutExpressionRecords(records: statement.bodyStatementRecords))
        let strippedElseRecords: String(compilerCoreStatementRecordsWithoutExpressionRecords(records: statement.elseStatementRecords))
        let strippedStatement: CompilerStatement(CompilerStatement(
            kind: statement.kind,
            name: statement.name,
            typeName: statement.typeName,
            targetSummary: statement.targetSummary,
            targetRecord: String(""),
            expressionKind: statement.expressionKind,
            expressionValue: statement.expressionValue,
            expressionSummary: statement.expressionSummary,
            expressionRecord: String(""),
            bodyStart: statement.bodyStart,
            bodyEnd: statement.bodyEnd,
            elseBodyStart: statement.elseBodyStart,
            elseBodyEnd: statement.elseBodyEnd,
            bodyStatementRecords: strippedBodyRecords,
            elseStatementRecords: strippedElseRecords,
            summary: statement.summary,
            start: statement.start,
            end: statement.end
        ))
        output: "\(output)\(compilerCoreStatementRecord(statement: strippedStatement))"
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return output
}

function compilerCoreExpressionSummaryCalledFunctionNames(summary: String): String {
    state calledNames: String("")

    if hasRangePrefix(source: summary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: summary))
        if functionName != String("") {
            calledNames: "\(calledNames)\(functionName);"
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreCallArgumentsCalledFunctionNames(argumentsSummary: compilerCoreCallArgumentsSummary(summary: summary)))
        return calledNames
    }

    if hasRangePrefix(source: summary, start: 0, prefix: String("binary(")) {
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCoreBinaryExpressionPart(summary: summary, partIndex: 0)))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCoreBinaryExpressionPart(summary: summary, partIndex: 2)))
        return calledNames
    }

    if hasRangePrefix(source: summary, start: 0, prefix: String("prefix(")) {
        return compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCorePrefixExpressionOperand(summary: summary))
    }

    if hasRangePrefix(source: summary, start: 0, prefix: String("member(")) {
        return compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCoreMemberExpressionBase(summary: summary))
    }

    return calledNames
}

function compilerCoreExpressionRecordCalledFunctionNames(record: String, fallbackSummary: String): String {
    if record == String("") {
        return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
    }

    state calledNames: String("")
    let kind: String(compilerCoreExpressionRecordKind(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))

    if kind == String("stringLiteral") {
        let literalContent: String(compilerCoreStringLiteralContent(text: value))
        return compilerCoreInterpolatedStringContentCalledFunctionNames(content: literalContent)
    }

    if kind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: record))
        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") {
            let calleeFunctionName: String(compilerCoreExpressionRecordValue(record: calleeRecord))
            if calleeFunctionName != String("") {
                calledNames: "\(calledNames)\(calleeFunctionName);"
            }
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreCallArgumentRecordsCalledFunctionNames(records: compilerCoreExpressionRecordArguments(record: record)))
        return calledNames
    }

    if kind == String("binary") {
        if compilerCoreExpressionRecordLeft(record: record) == String("") || compilerCoreExpressionRecordRight(record: record) == String("") {
            return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordLeft(record: record), fallbackSummary: String("")))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordRight(record: record), fallbackSummary: String("")))
        return calledNames
    }

    if kind == String("prefix") || kind == String("member") {
        if compilerCoreExpressionRecordLeft(record: record) == String("") {
            return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
        }
        return compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordLeft(record: record), fallbackSummary: String(""))
    }

    if kind == String("index") {
        if compilerCoreExpressionRecordLeft(record: record) == String("") || compilerCoreExpressionRecordRight(record: record) == String("") {
            return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordLeft(record: record), fallbackSummary: String("")))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordRight(record: record), fallbackSummary: String("")))
        return calledNames
    }

    return calledNames
}

function compilerCoreInterpolatedStringContentCalledFunctionNames(content: String): String {
    state calledNames: String("")
    if !compilerCoreStringContentHasInterpolation(content: content) {
        return calledNames
    }

    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state sourceIndex: Int(0)

    while sourceIndex + 1 < contentLength {
        if content.character(index: sourceIndex) == backslash && content.character(index: sourceIndex + 1) == String("(") {
            let expressionEnd: Int(compilerCoreInterpolatedExpressionEnd(content: content, start: sourceIndex + 2))
            if expressionEnd < contentLength {
                let expressionText: String(content.substring(start: sourceIndex + 2, end: expressionEnd))
                let expressionLength: Int(stringLength(value: expressionText))
                let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: expressionText, start: 0, limit: expressionLength))
                if maybeExpression != nil {
                    let fallbackExpression: CompilerExpression(compilerCoreMissingExpression(start: 0))
                    let expression: CompilerExpression(maybeExpression ?? fallbackExpression)
                    calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: expression.record, fallbackSummary: expression.summary))
                }
                sourceIndex: expressionEnd + 1
            } else {
                sourceIndex: sourceIndex + 1
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return calledNames
}

function compilerCoreCallArgumentRecordsCalledFunctionNames(records: String): String {
    state calledNames: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreCallArgumentRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return calledNames
        }

        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreCallArgumentExpressionRecord(record: record), fallbackSummary: compilerCoreCallArgumentExpressionSummary(record: record)))
        sourceIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: sourceIndex)
    }

    return calledNames
}

function compilerCoreCallArgumentsCalledFunctionNames(argumentsSummary: String): String {
    state calledNames: String("")
    state sourceIndex: Int(0)
    let argumentsLength: Int(stringLength(value: argumentsSummary))

    while sourceIndex < argumentsLength {
        let argumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: argumentsSummary, start: sourceIndex))
        if argumentExpression == String("") {
            return calledNames
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionSummaryCalledFunctionNames(summary: argumentExpression))
        sourceIndex: compilerCoreCallArgumentNextIndex(argumentsSummary: argumentsSummary, start: sourceIndex)
    }

    return calledNames
}

function parseCompilerBlock(program: CompilerProgram, block: CompilerBlock): CompilerParsedBlock {
    let parsedStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: block))
    return CompilerParsedBlock(
        block: block,
        statementRecords: parsedStatements.records,
        statementSummary: compilerCoreStatementRecordsASTSummary(records: parsedStatements.records)
    )
}

function compilerCoreLLVMLowerBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock): CompilerLLVMLoweredBlock {
    state initialTemporaryIndex: Int(0)
    let declarationRecordsLength: Int(stringLength(value: program.declarationRecords))
    if declarationRecordsLength > 0 {
        initialTemporaryIndex: declarationRecordsLength + 1
    }
    return compilerCoreLLVMLowerBlockWithLocals(program: program, parsedBlock: parsedBlock, initialLocalValues: String(""), initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: String("Int"))
}

function compilerCoreLLVMLowerBlockWithLocals(program: CompilerProgram, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredBlock {
    return compilerCoreLLVMLowerBlockWithControl(program: program, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: String("entry"), fallthroughLabel: String(""), initialBranchIndex: 0)
}

function compilerCoreLLVMLowerBlockWithControl(program: CompilerProgram, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, fallthroughLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let directBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlock(program: program, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex))
    let directRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: directBlock))
    if directRenderedBlocks != String("") {
        return directBlock
    }
    if !compilerCoreStatementRecordsContainControl(records: parsedBlock.statementRecords) && (directBlock.instructionRecords != String("") || directBlock.localValues != initialLocalValues || directBlock.hasReturn) {
        if fallthroughLabel != String("") && !directBlock.hasReturn && directRenderedBlocks == String("") {
            let fallthroughTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: fallthroughLabel, falseLabel: String("")))
            let renderedFallthroughBlock: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: directBlock.instructionRecords, terminal: fallthroughTerminator))
            return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, functionSummary: program.functionSummary, renderedBlocks: renderedFallthroughBlock, instructionRecords: directBlock.instructionRecords, localValues: directBlock.localValues, nextTemporary: directBlock.nextTemporary, nextBranchIndex: directBlock.nextBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: directBlock.returnLLVMType, returnLLVMValue: directBlock.returnLLVMValue)
        }
        return directBlock
    }

    return compilerCoreLLVMLowerBlockWithControlLegacy(program: program, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, fallthroughLabel: fallthroughLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLoweredBlockRenderedBlocks(block: CompilerLLVMLoweredBlock): String {
    return block.renderedBlocks
}

function compilerCoreLLVMLowerDirectLinearRecordBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    return compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(program: program, parsedBlock: parsedBlock, statementIndex: 0, llvmInstructionRecords: String(""), llvmLocalValues: initialLocalValues, llvmTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let statementsLength: Int(stringLength(value: parsedBlock.statementRecords))
    if statementIndex >= statementsLength {
        let returnLLVMType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
        let returnLLVMValue: String(compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType))
        return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, functionSummary: program.functionSummary, renderedBlocks: String(""), instructionRecords: llvmInstructionRecords, localValues: llvmLocalValues, nextTemporary: llvmTemporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
    }

    let statementRecord: String(compilerCoreStatementRecordAt(records: parsedBlock.statementRecords, start: statementIndex))
    return compilerCoreLLVMLowerDirectLinearRecordBlockWithRecord(program: program, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockWithRecord(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if statementRecord == String("") {
        return compilerCoreEmptyDirectLoweredBlock(program: program, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let loweredStatement: CompilerLLVMLoweredLinearStatement(compilerCoreLLVMLowerLinearStatementRecord(program: program, statementRecord: statementRecord, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType))
    return compilerCoreLLVMLowerDirectLinearRecordBlockWithLowered(program: program, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, loweredStatement: loweredStatement, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockWithLowered(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, loweredStatement: CompilerLLVMLoweredLinearStatement, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if !loweredStatement.handled {
        return compilerCoreLLVMLowerDirectLinearRecordBlockWithIf(program: program, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let nextInstructionRecords: String("\(llvmInstructionRecords)\(loweredStatement.instructionRecords)")
    return compilerCoreLLVMLowerDirectLinearRecordBlockAfterLowered(program: program, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, loweredStatement: loweredStatement, llvmInstructionRecords: nextInstructionRecords, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockWithIf(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let statementKind: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("kind=")))
    if statementKind == String("if") {
        return compilerCoreLLVMLowerDirectIfStatementRecord(program: program, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    return compilerCoreEmptyDirectLoweredBlock(program: program, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectIfStatementRecord(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let expressionSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("expression=")))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("expressionRecord="))))
    let bodyRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("bodyRecords="))))
    let elseRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("elseRecords="))))
    if bodyRecords == String("") {
        return compilerCoreEmptyDirectLoweredBlock(program: program, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let loweredCondition: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: llvmLocalValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: String("Bool"), temporaryIndex: llvmTemporaryIndex))
    let thenLabel: String("if\(initialBranchIndex)")
    let thenBlock: CompilerParsedBlock(CompilerParsedBlock(block: parsedBlock.block, statementRecords: bodyRecords, statementSummary: String("")))
    let loweredThenBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlock(program: program, parsedBlock: thenBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: thenLabel, initialBranchIndex: initialBranchIndex + 1))
    return compilerCoreLLVMLowerDirectIfStatementRecordWithThen(program: program, parsedBlock: parsedBlock, statementIndex: statementIndex, bodyRecords: bodyRecords, elseRecords: elseRecords, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectIfStatementRecordWithThen(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, bodyRecords: String, elseRecords: String, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, llvmLocalValues: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if !loweredThenBlock.hasReturn {
        return compilerCoreEmptyDirectLoweredBlock(program: program, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: loweredCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    if elseRecords != String("") {
        return compilerCoreLLVMLowerDirectIfStatementRecordWithElse(program: program, parsedBlock: parsedBlock, elseRecords: elseRecords, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, initialBranchIndex: initialBranchIndex)
    }

    let afterLabel: String("after\(initialBranchIndex)")
    let nextStatementIndex: Int(compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex))
    let loweredAfterBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(program: program, parsedBlock: parsedBlock, statementIndex: nextStatementIndex, llvmInstructionRecords: String(""), llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: loweredThenBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: afterLabel, initialBranchIndex: loweredThenBlock.nextBranchIndex))
    return compilerCoreLLVMLowerDirectIfStatementRecordWithAfter(program: program, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredAfterBlock: loweredAfterBlock, llvmInstructionRecords: llvmInstructionRecords, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, afterLabel: afterLabel)
}

function compilerCoreLLVMLowerDirectIfStatementRecordWithElse(program: CompilerProgram, parsedBlock: CompilerParsedBlock, elseRecords: String, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, llvmLocalValues: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let elseLabel: String("else\(initialBranchIndex)")
    let elseBlock: CompilerParsedBlock(CompilerParsedBlock(block: parsedBlock.block, statementRecords: elseRecords, statementSummary: String("")))
    let loweredElseBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlock(program: program, parsedBlock: elseBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredThenBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: elseLabel, initialBranchIndex: loweredThenBlock.nextBranchIndex))
    return compilerCoreLoweredDirectIfElseBlock(program: program, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredElseBlock: loweredElseBlock, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, elseLabel: elseLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLoweredDirectIfElseBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredElseBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, llvmLocalValues: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, elseLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if !loweredElseBlock.hasReturn {
        return compilerCoreEmptyDirectLoweredBlock(program: program, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: loweredElseBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let branchInstructions: String("\(llvmInstructionRecords)\(loweredCondition.instructionRecords)")
    return compilerCoreRenderedDirectIfElseStatementRecord(program: program, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredElseBlock: loweredElseBlock, branchInstructions: branchInstructions, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, elseLabel: elseLabel)
}

function compilerCoreRenderedDirectIfElseStatementRecord(program: CompilerProgram, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredElseBlock: CompilerLLVMLoweredBlock, branchInstructions: String, initialBlockLabel: String, thenLabel: String, elseLabel: String): CompilerLLVMLoweredBlock {
    let branchTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: thenLabel, falseLabel: elseLabel))
    let renderedBranch: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: branchInstructions, terminal: branchTerminator))
    let thenRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredThenBlock))
    let elseRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredElseBlock))
    let renderedBlocks: String("\(renderedBranch)\(thenRenderedBlocks)\(elseRenderedBlocks)")
    let instructionRecords: String("\(branchInstructions)\(loweredThenBlock.instructionRecords)\(loweredElseBlock.instructionRecords)")
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, functionSummary: program.functionSummary, renderedBlocks: renderedBlocks, instructionRecords: instructionRecords, localValues: loweredElseBlock.localValues, nextTemporary: loweredElseBlock.nextTemporary, nextBranchIndex: loweredElseBlock.nextBranchIndex, exitLabel: elseLabel, hasEntryBranch: true, entryBranchCondition: loweredCondition.operand, entryBranchThenLabel: thenLabel, entryBranchElseLabel: elseLabel, hasReturn: true, returnLLVMType: loweredElseBlock.returnLLVMType, returnLLVMValue: loweredElseBlock.returnLLVMValue)
}

function compilerCoreLLVMLowerDirectIfStatementRecordWithAfter(program: CompilerProgram, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredAfterBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
    let afterRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredAfterBlock))
    if afterRenderedBlocks == String("") {
        return compilerCoreEmptyDirectLoweredBlock(program: program, parsedBlock: parsedBlock, localValues: loweredAfterBlock.localValues, temporaryIndex: loweredAfterBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: loweredAfterBlock.nextBranchIndex)
    }

    let branchInstructions: String("\(llvmInstructionRecords)\(loweredCondition.instructionRecords)")
    return compilerCoreRenderedDirectIfStatementRecord(program: program, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredAfterBlock: loweredAfterBlock, branchInstructions: branchInstructions, afterRenderedBlocks: afterRenderedBlocks, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, afterLabel: afterLabel)
}

function compilerCoreRenderedDirectIfStatementRecord(program: CompilerProgram, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredAfterBlock: CompilerLLVMLoweredBlock, branchInstructions: String, afterRenderedBlocks: String, initialBlockLabel: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
    let branchTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: thenLabel, falseLabel: afterLabel))
    let renderedBranch: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: branchInstructions, terminal: branchTerminator))
    let thenRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredThenBlock))
    let renderedBlocks: String("\(renderedBranch)\(thenRenderedBlocks)\(afterRenderedBlocks)")
    let instructionRecords: String("\(branchInstructions)\(loweredThenBlock.instructionRecords)\(loweredAfterBlock.instructionRecords)")
