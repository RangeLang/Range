        || rawBufferCount(buffer: arena.mirTraversal) != compilerIntTableRowCount(table: arena.cfgBlocks) { return 0 - 1 }
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolKindColumn()))
        if symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver() {
            let parameterTypeKind: Int(compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: symbolRow))
            let parameterTypeID: Int(compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolRow))
