function compilerBodyArenaOwnedPathOpaqueLeafCanDeactivateCachedAt(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathRoots: RawBuffer, canonicalPaths: RawBuffer, pathID: Int, blockID: Int, pathCount: Int): Bool {
    if pathID < 0 || pathID >= pathCount || rawBufferCount(buffer: canonicalPaths) != pathCount
        || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn())) { return false }
