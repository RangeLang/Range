function compilerCoreLLVMLowerDirectLinearRecordBlockAfterLowered(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, loweredStatement: CompilerLLVMLoweredLinearStatement, llvmInstructionRecords: String, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if loweredStatement.hasReturn {
        return compilerCoreRenderedDirectReturnBlock(program: program, parsedBlock: parsedBlock, renderedInstructionRecords: llvmInstructionRecords, localValues: loweredStatement.localValues, temporaryIndex: loweredStatement.nextTemporary, returnLLVMType: loweredStatement.returnLLVMType, returnLLVMValue: loweredStatement.returnLLVMValue, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let nextStatementIndex: Int(compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex))
    return compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(program: program, parsedBlock: parsedBlock, statementIndex: nextStatementIndex, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: loweredStatement.localValues, llvmTemporaryIndex: loweredStatement.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerLinearStatementRecord(program: CompilerProgram, statementRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    let statementKind: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("kind=")))
    let statementName: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("name=")))
    let statementTypeName: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("type=")))
    let expressionSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("expression=")))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("expressionRecord="))))
    return compilerCoreLLVMLowerLinearStatementRecordWithExpression(program: program, statementKind: statementKind, statementName: statementName, statementTypeName: statementTypeName, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
}

function compilerCoreLLVMLowerLinearStatementRecordWithExpression(program: CompilerProgram, statementKind: String, statementName: String, statementTypeName: String, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if statementKind == String("let") {
        return compilerCoreLLVMLowerLinearStatementRecordBinding(program: program, statementName: statementName, statementTypeName: statementTypeName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("state") {
        return compilerCoreLLVMLowerLinearStatementRecordBinding(program: program, statementName: statementName, statementTypeName: statementTypeName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    return compilerCoreLLVMLowerLinearStatementRecordNonBinding(program: program, statementKind: statementKind, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
}

function compilerCoreLLVMLowerLinearStatementRecordBinding(program: CompilerProgram, statementName: String, statementTypeName: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    if !compilerCoreCanLowerLocalType(declarationRecords: program.declarationRecords, typeName: statementTypeName) {
        return compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: localValues, temporaryIndex: temporaryIndex)
    }

    let loweredLocal: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: statementTypeName, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredLocal.instructionRecords, localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: statementName, operand: loweredLocal.operand, typeName: loweredLocal.typeName, rangeTypeName: statementTypeName))", nextTemporary: loweredLocal.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordNonBinding(program: CompilerProgram, statementKind: String, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if statementKind == String("expression") {
        return compilerCoreLLVMLowerLinearStatementRecordExpression(program: program, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("assignment") {
        return compilerCoreLLVMLowerLinearStatementRecordAssignment(program: program, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("return") {
        return compilerCoreLLVMLowerLinearStatementRecordReturn(program: program, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
    }

    return compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: localValues, temporaryIndex: temporaryIndex)
}

function compilerCoreLLVMLowerLinearStatementRecordExpression(program: CompilerProgram, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    let loweredExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredExpression.instructionRecords, localValues: localValues, nextTemporary: loweredExpression.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordAssignment(program: CompilerProgram, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    state assignmentName: String("")
    assignmentName: compilerCoreStatementRecordField(record: statementRecord, prefix: String("name="))
    let assignmentTargetSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("target=")))
    let assignmentTargetRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("targetRecord="))))
    if assignmentName == String("") {
        assignmentName: compilerCoreIdentifierExpressionRecordName(record: assignmentTargetRecord, fallbackSummary: assignmentTargetSummary)
    }
    return compilerCoreLLVMLowerLinearStatementRecordAssignmentName(program: program, assignmentName: assignmentName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
}

function compilerCoreLLVMLowerLinearStatementRecordAssignmentName(program: CompilerProgram, assignmentName: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    if assignmentName == String("") {
        return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
    }

    let assignmentLLVMType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: assignmentName))
    state assignmentRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: assignmentName))
    if assignmentRangeType == String("") {
        assignmentRangeType: compilerCoreRangeTypeNameForLLVMType(typeName: assignmentLLVMType)
    }
    let loweredAssignment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: assignmentRangeType, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredAssignment.instructionRecords, localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: assignmentName, operand: loweredAssignment.operand, typeName: loweredAssignment.typeName, rangeTypeName: assignmentRangeType))", nextTemporary: loweredAssignment.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordReturn(program: CompilerProgram, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    let loweredReturn: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: expectedReturnType, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredReturn.instructionRecords, localValues: localValues, nextTemporary: loweredReturn.nextTemporary, hasReturn: true, returnLLVMType: compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType), returnLLVMValue: loweredReturn.operand)
}

function compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    return CompilerLLVMLoweredLinearStatement(handled: false, instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreRenderedDirectReturnBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, renderedInstructionRecords: String, localValues: String, temporaryIndex: Int, returnLLVMType: String, returnLLVMValue: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let terminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
    let renderedBlocks: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: renderedInstructionRecords, terminal: terminator))
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, renderedBlocks: renderedBlocks, instructionRecords: renderedInstructionRecords, localValues: localValues, nextTemporary: temporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: true, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
}

function compilerCoreEmptyDirectLoweredBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, localValues: String, temporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let returnLLVMType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
    let returnLLVMValue: String(compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType))
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, renderedBlocks: String(""), instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
}

function compilerCoreLLVMLowerBlockWithControlLegacy(program: CompilerProgram, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, fallthroughLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: parsedBlock.statementRecords))
    state llvmRenderedBlocks: String("")
    state llvmInstructionRecords: String("")
    state currentBlockLabel: String("entry")
    currentBlockLabel: initialBlockLabel
    state currentBlockInstructionRecords: String("")
    state currentBlockHasTerminator: Bool(false)
    state llvmLocalValues: String("")
    llvmLocalValues: initialLocalValues
    state llvmTemporaryIndex: Int(0)
    llvmTemporaryIndex: initialTemporaryIndex
    state llvmBranchIndex: Int(0)
    llvmBranchIndex: initialBranchIndex
    state hasEntryBranch: Bool(false)
    state entryBranchCondition: String("")
    state entryBranchThenLabel: String("")
    state entryBranchElseLabel: String("")
    state hasReturn: Bool(false)
    state returnLLVMType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
    state returnLLVMValue: String(compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: parsedBlock.statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return CompilerLLVMLoweredBlock(
                block: parsedBlock.block,
                declarationRecords: program.declarationRecords,
                renderedBlocks: llvmRenderedBlocks,
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                nextBranchIndex: llvmBranchIndex,
                exitLabel: currentBlockLabel,
                hasEntryBranch: hasEntryBranch,
                entryBranchCondition: entryBranchCondition,
                entryBranchThenLabel: entryBranchThenLabel,
                entryBranchElseLabel: entryBranchElseLabel,
                hasReturn: hasReturn,
                returnLLVMType: returnLLVMType,
                returnLLVMValue: returnLLVMValue
            )
        }

            let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
            let loweredLinearBlockStatement: CompilerLLVMLoweredLinearStatement(compilerCoreLLVMLowerLinearStatement(program: program, statement: statement, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType))
            if loweredLinearBlockStatement.handled {
                if loweredLinearBlockStatement.hasReturn {
                    if !hasReturn {
                        if llvmRenderedBlocks != String("") {
                            let linearReturnTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: loweredLinearBlockStatement.returnLLVMType, value: loweredLinearBlockStatement.returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
                            llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: linearReturnTerminator))"
                            llvmTemporaryIndex: loweredLinearBlockStatement.nextTemporary
                            currentBlockHasTerminator: true
                            hasReturn: true
                        } else {
                            llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            llvmTemporaryIndex: loweredLinearBlockStatement.nextTemporary
                            hasReturn: true
                            returnLLVMType: loweredLinearBlockStatement.returnLLVMType
                            returnLLVMValue: loweredLinearBlockStatement.returnLLVMValue
                        }
                    }
                } else {
                    llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                    currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                    llvmLocalValues: loweredLinearBlockStatement.localValues
                    llvmTemporaryIndex: loweredLinearBlockStatement.nextTemporary
                }
            } else if statement.kind == String("if") {
                let loweredCondition: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: llvmLocalValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: String("Bool"), temporaryIndex: llvmTemporaryIndex))
                let loweredThenBlock: CompilerLLVMLoweredReturnBlock(compilerCoreLLVMLowerReturnStatementRecords(program: program, statementRecords: statement.bodyStatementRecords, localValues: llvmLocalValues, temporaryIndex: loweredCondition.nextTemporary, breakLabel: String(""), continueLabel: String(""), expectedReturnType: expectedReturnType))
                if loweredThenBlock.hasReturn && !compilerCoreStatementRecordsContainControl(records: statement.bodyStatementRecords) && !compilerCoreStatementRecordsContainControl(records: statement.elseStatementRecords) {
                    let thenLabel: String("if\(llvmBranchIndex)")
                    state falseLabel: String("")
                    falseLabel: "after\(llvmBranchIndex)"
                    state loweredReturningElseBlock: CompilerLLVMLoweredReturnBlock(CompilerLLVMLoweredReturnBlock(instructionRecords: String(""), localValues: llvmLocalValues, nextTemporary: loweredThenBlock.nextTemporary, hasReturn: false, returnLLVMType: loweredThenBlock.returnLLVMType, returnValue: String("0"), hasJump: false, jumpLabel: String("")))
                    if statement.elseBodyEnd > statement.elseBodyStart {
                        falseLabel: "else\(llvmBranchIndex)"
                        loweredReturningElseBlock: compilerCoreLLVMLowerReturnStatementRecords(program: program, statementRecords: statement.elseStatementRecords, localValues: llvmLocalValues, temporaryIndex: loweredThenBlock.nextTemporary, breakLabel: String(""), continueLabel: String(""), expectedReturnType: expectedReturnType)
                    }
                    let branchBlockTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: thenLabel, falseLabel: falseLabel))
                    let thenReturnTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: loweredThenBlock.returnLLVMType, value: loweredThenBlock.returnValue, trueLabel: String(""), falseLabel: String("")))
                    let thenInstructions: String(compilerCoreRenderLLVMInstructionRecords(records: loweredThenBlock.instructionRecords))
                    llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredCondition.instructionRecords)\(loweredThenBlock.instructionRecords)\(loweredReturningElseBlock.instructionRecords)"
                    currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredCondition.instructionRecords)"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: branchBlockTerminator))"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: thenLabel, instructionRecords: loweredThenBlock.instructionRecords, terminal: thenReturnTerminator))"
                    currentBlockLabel: "after\(llvmBranchIndex)"
                    currentBlockInstructionRecords: String("")
                    if loweredReturningElseBlock.hasReturn {
                        let elseReturnTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: loweredReturningElseBlock.returnLLVMType, value: loweredReturningElseBlock.returnValue, trueLabel: String(""), falseLabel: String("")))
                        let elseInstructions: String(compilerCoreRenderLLVMInstructionRecords(records: loweredReturningElseBlock.instructionRecords))
                        llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: falseLabel, instructionRecords: loweredReturningElseBlock.instructionRecords, terminal: elseReturnTerminator))"
                        currentBlockHasTerminator: true
                        llvmTemporaryIndex: loweredReturningElseBlock.nextTemporary
                        hasReturn: true
                    } else {
                        currentBlockLabel: falseLabel
                        currentBlockHasTerminator: false
                        llvmTemporaryIndex: loweredThenBlock.nextTemporary
                    }
                    if !hasEntryBranch {
                        hasEntryBranch: true
                        entryBranchCondition: loweredCondition.operand
                        entryBranchThenLabel: thenLabel
                        entryBranchElseLabel: falseLabel
                    }
                    llvmBranchIndex: llvmBranchIndex + 1
                } else {
                    let ifSourceLabel: String(currentBlockLabel)
                    let ifThenLabel: String("if\(llvmBranchIndex)")
                    let ifElseLabel: String("else\(llvmBranchIndex)")
                    let ifAfterLabel: String("after\(llvmBranchIndex)")
                    state ifFalseLabel: String("")
                    ifFalseLabel: ifAfterLabel
                    let ifThenSourceBlock: CompilerBlock(CompilerBlock(start: statement.bodyStart, end: statement.bodyEnd))
                    let ifThenParsedBlock: CompilerParsedBlock(CompilerParsedBlock(block: ifThenSourceBlock, statementRecords: statement.bodyStatementRecords, statementSummary: String("")))
                    let loweredNonReturningThenBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithControl(program: program, parsedBlock: ifThenParsedBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: ifThenLabel, fallthroughLabel: ifAfterLabel, initialBranchIndex: llvmBranchIndex + 1))
                    state ifElseInstructionRecords: String("")
                    state ifElseRenderedBlocks: String("")
                    state ifElseLocalValues: String("")
                    ifElseLocalValues: llvmLocalValues
                    state ifElseNextTemporary: Int(0)
                    ifElseNextTemporary: loweredNonReturningThenBlock.nextTemporary
                    state ifElseNextBranchIndex: Int(0)
                    ifElseNextBranchIndex: loweredNonReturningThenBlock.nextBranchIndex
                    state ifElseExitLabel: String("")
                    ifElseExitLabel: ifSourceLabel
                    state ifElseHasReturn: Bool(false)
                    if statement.elseBodyEnd > statement.elseBodyStart {
                        ifFalseLabel: ifElseLabel
                        let ifElseSourceBlock: CompilerBlock(CompilerBlock(start: statement.elseBodyStart, end: statement.elseBodyEnd))
                        let ifElseParsedBlock: CompilerParsedBlock(CompilerParsedBlock(block: ifElseSourceBlock, statementRecords: statement.elseStatementRecords, statementSummary: String("")))
                        let loweredNonReturningElseBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithControl(program: program, parsedBlock: ifElseParsedBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredNonReturningThenBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: ifElseLabel, fallthroughLabel: ifAfterLabel, initialBranchIndex: loweredNonReturningThenBlock.nextBranchIndex))
                        ifElseInstructionRecords: loweredNonReturningElseBlock.instructionRecords
                        ifElseRenderedBlocks: loweredNonReturningElseBlock.renderedBlocks
                        ifElseLocalValues: loweredNonReturningElseBlock.localValues
                        ifElseNextTemporary: loweredNonReturningElseBlock.nextTemporary
                        ifElseNextBranchIndex: loweredNonReturningElseBlock.nextBranchIndex
                        ifElseExitLabel: loweredNonReturningElseBlock.exitLabel
                        ifElseHasReturn: loweredNonReturningElseBlock.hasReturn
                    }
                    let ifBranchTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: ifThenLabel, falseLabel: ifFalseLabel))
                    let ifThenAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.bodyStatementRecords))
                    let ifElseAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.elseStatementRecords))
                    state ifAssignmentNames: String("")
                    ifAssignmentNames: compilerCoreLLVMLocalNames(localValues: llvmLocalValues)
                    ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: ifThenAssignmentNames)
                    ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: compilerCoreLLVMLocalNames(localValues: loweredNonReturningThenBlock.localValues))
                    if statement.elseBodyEnd > statement.elseBodyStart && !ifElseHasReturn {
                        ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: ifElseAssignmentNames)
                        ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: compilerCoreLLVMLocalNames(localValues: ifElseLocalValues))
                    }
                    state ifPhiRecords: String("")
                    state ifPhiTemporaryIndex: Int(0)
                    ifPhiTemporaryIndex: ifElseNextTemporary
                    state ifAssignmentIndex: Int(0)
                    let ifAssignmentNamesLength: Int(stringLength(value: ifAssignmentNames))
                    while ifAssignmentIndex < ifAssignmentNamesLength {
                        let ifPhiName: String(compilerCoreNameListNameAt(names: ifAssignmentNames, start: ifAssignmentIndex))
                        let ifPhiInitialOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: llvmLocalValues, name: ifPhiName))
                        let ifPhiInitialType: String(compilerCoreLookupLLVMLocalType(localValues: llvmLocalValues, name: ifPhiName))
                        let ifPhiInitialRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: llvmLocalValues, name: ifPhiName))
                        let ifPhiThenOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: loweredNonReturningThenBlock.localValues, name: ifPhiName))
                        state ifPhiElseOperand: String("")
                        ifPhiElseOperand: compilerCoreLookupLLVMLocalOperand(localValues: ifElseLocalValues, name: ifPhiName)
                        if statement.elseBodyEnd <= statement.elseBodyStart {
                            ifPhiElseOperand: ifPhiInitialOperand
                        }
                        if !loweredNonReturningThenBlock.hasReturn && !ifElseHasReturn && ifPhiName != String("") && ifPhiInitialOperand != String("") && ifPhiThenOperand != String("") && ifPhiElseOperand != String("") && (ifPhiThenOperand != ifPhiInitialOperand || ifPhiElseOperand != ifPhiInitialOperand) {
                            let ifPhiOperand: String("%r\(ifPhiTemporaryIndex)")
                            state ifPhiLeft: String("")
                            state ifPhiRight: String("")
                            if statement.elseBodyEnd > statement.elseBodyStart {
                                ifPhiLeft: "[\(ifPhiThenOperand), %\(loweredNonReturningThenBlock.exitLabel)]"
                                ifPhiRight: "[\(ifPhiElseOperand), %\(ifElseExitLabel)]"
                            } else {
                                ifPhiLeft: "[\(ifPhiInitialOperand), %\(ifSourceLabel)]"
                                ifPhiRight: "[\(ifPhiThenOperand), %\(loweredNonReturningThenBlock.exitLabel)]"
                            }
                            let ifPhiInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: ifPhiOperand, operation: String("phi"), typeName: ifPhiInitialType, left: ifPhiLeft, right: ifPhiRight))
                            ifPhiRecords: "\(ifPhiRecords)\(compilerCoreLLVMInstructionRecord(instruction: ifPhiInstruction))"
                            llvmLocalValues: "\(llvmLocalValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: ifPhiName, operand: ifPhiOperand, typeName: ifPhiInitialType, rangeTypeName: ifPhiInitialRangeType))"
                            ifPhiTemporaryIndex: ifPhiTemporaryIndex + 1
                        }
                        ifAssignmentIndex: compilerCoreNameListNextIndex(names: ifAssignmentNames, start: ifAssignmentIndex)
                    }
                    llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredCondition.instructionRecords)\(loweredNonReturningThenBlock.instructionRecords)\(ifElseInstructionRecords)"
                    currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredCondition.instructionRecords)"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: ifBranchTerminator))"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(loweredNonReturningThenBlock.renderedBlocks)\(ifElseRenderedBlocks)"
                    currentBlockLabel: ifAfterLabel
                    currentBlockInstructionRecords: ifPhiRecords
                    currentBlockHasTerminator: false
                    if statement.elseBodyEnd > statement.elseBodyStart && loweredNonReturningThenBlock.hasReturn && !ifElseHasReturn {
                        llvmLocalValues: ifElseLocalValues
                    } else if statement.elseBodyEnd > statement.elseBodyStart && ifElseHasReturn {
                        llvmLocalValues: loweredNonReturningThenBlock.localValues
                    }
                    llvmTemporaryIndex: ifPhiTemporaryIndex
                    if !hasEntryBranch {
                        hasEntryBranch: true
                        entryBranchCondition: loweredCondition.operand
                        entryBranchThenLabel: ifThenLabel
                        entryBranchElseLabel: ifFalseLabel
                    }
                    llvmBranchIndex: ifElseNextBranchIndex
                }
            } else if statement.kind == String("while") {
                let conditionLabel: String("while\(llvmBranchIndex)")
                let bodyLabel: String("whileBody\(llvmBranchIndex)")
                let afterLabel: String("afterWhile\(llvmBranchIndex)")
                let enterLoopTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: conditionLabel, falseLabel: String("")))
                state loopAssignmentNames: String("")
                loopAssignmentNames: compilerCoreLLVMLocalNames(localValues: llvmLocalValues)
                state loopLocalValues: String("")
                loopLocalValues: "\(llvmLocalValues)"
                state loopPhiRecords: String("")
                state loopConditionTemporaryIndex: Int(0)
                loopConditionTemporaryIndex: llvmTemporaryIndex
                let loopPhiFirstTemporaryIndex: Int(llvmTemporaryIndex)
                state loopAssignmentIndex: Int(0)
                let loopAssignmentNamesLength: Int(stringLength(value: loopAssignmentNames))
                while loopAssignmentIndex < loopAssignmentNamesLength {
                    let loopAssignmentName: String(compilerCoreNameListNameAt(names: loopAssignmentNames, start: loopAssignmentIndex))
                    let loopInitialOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: llvmLocalValues, name: loopAssignmentName))
                    let loopInitialType: String(compilerCoreLookupLLVMLocalType(localValues: llvmLocalValues, name: loopAssignmentName))
                    let loopInitialRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: llvmLocalValues, name: loopAssignmentName))
                    if loopAssignmentName != String("") && loopInitialOperand != String("") {
                        let loopPhiOperand: String("%r\(llvmTemporaryIndex)")
                        loopLocalValues: "\(loopLocalValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: loopAssignmentName, operand: loopPhiOperand, typeName: loopInitialType, rangeTypeName: loopInitialRangeType))"
                        llvmTemporaryIndex: llvmTemporaryIndex + 1
                        loopConditionTemporaryIndex: llvmTemporaryIndex
                    }
                    loopAssignmentIndex: compilerCoreNameListNextIndex(names: loopAssignmentNames, start: loopAssignmentIndex)
                }
                let loweredLoopCondition: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: loopLocalValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: String("Bool"), temporaryIndex: loopConditionTemporaryIndex))
                let loopConditionTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredLoopCondition.operand, trueLabel: bodyLabel, falseLabel: afterLabel))
                let loopBodySourceBlock: CompilerBlock(CompilerBlock(start: statement.bodyStart, end: statement.bodyEnd))
                let loopBodyParsedBlock: CompilerParsedBlock(CompilerParsedBlock(block: loopBodySourceBlock, statementRecords: statement.bodyStatementRecords, statementSummary: String("")))
                let loweredBodyBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithControl(program: program, parsedBlock: loopBodyParsedBlock, initialLocalValues: loopLocalValues, initialTemporaryIndex: loweredLoopCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: bodyLabel, fallthroughLabel: conditionLabel, initialBranchIndex: llvmBranchIndex + 1))
                state loopBackedgeLabel: String("")
                loopBackedgeLabel: loweredBodyBlock.exitLabel
                if loopBackedgeLabel == String("") {
                    loopBackedgeLabel: bodyLabel
                }
                state loopPhiRecordIndex: Int(0)
                state loopPhiTemporaryIndex: Int(0)
                loopPhiTemporaryIndex: loopPhiFirstTemporaryIndex
                while loopPhiRecordIndex < loopAssignmentNamesLength {
                    let loopPhiName: String(compilerCoreNameListNameAt(names: loopAssignmentNames, start: loopPhiRecordIndex))
                    let loopPhiInitialOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: llvmLocalValues, name: loopPhiName))
                    let loopPhiInitialType: String(compilerCoreLookupLLVMLocalType(localValues: llvmLocalValues, name: loopPhiName))
                    let loopPhiInitialRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: llvmLocalValues, name: loopPhiName))
                    let loopUpdatedOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: loweredBodyBlock.localValues, name: loopPhiName))
                    state loopBackedgeOperand: String("")
                    loopBackedgeOperand: loopUpdatedOperand
                    if loopBackedgeOperand == String("") {
                        loopBackedgeOperand: loopPhiInitialOperand
                    }
                    if loopPhiName != String("") && loopPhiInitialOperand != String("") {
                        let renderedLoopPhiOperand: String("%r\(loopPhiTemporaryIndex)")
                        let loopPhiInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                            result: renderedLoopPhiOperand,
                            operation: String("phi"),
                            typeName: loopPhiInitialType,
                            left: "[\(loopPhiInitialOperand), %\(currentBlockLabel)]",
                            right: "[\(loopBackedgeOperand), %\(loopBackedgeLabel)]"
                        ))
                        loopPhiRecords: "\(loopPhiRecords)\(compilerCoreLLVMInstructionRecord(instruction: loopPhiInstruction))"
                        llvmLocalValues: "\(llvmLocalValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: loopPhiName, operand: renderedLoopPhiOperand, typeName: loopPhiInitialType, rangeTypeName: loopPhiInitialRangeType))"
                        loopPhiTemporaryIndex: loopPhiTemporaryIndex + 1
                    }
                    loopPhiRecordIndex: compilerCoreNameListNextIndex(names: loopAssignmentNames, start: loopPhiRecordIndex)
                }
                llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: enterLoopTerminator))"
                llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: conditionLabel, instructionRecords: "\(loopPhiRecords)\(loweredLoopCondition.instructionRecords)", terminal: loopConditionTerminator))"
                llvmRenderedBlocks: "\(llvmRenderedBlocks)\(loweredBodyBlock.renderedBlocks)"
                currentBlockHasTerminator: false
                currentBlockLabel: afterLabel
                currentBlockInstructionRecords: String("")
                llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLoopCondition.instructionRecords)\(loweredBodyBlock.instructionRecords)"
                llvmTemporaryIndex: loweredBodyBlock.nextTemporary
                llvmBranchIndex: loweredBodyBlock.nextBranchIndex
            }
        statementIndex: compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex)
    }

    if (llvmRenderedBlocks != String("") || fallthroughLabel != String("")) && !currentBlockHasTerminator {
        state defaultBlockTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: String("0"), trueLabel: String(""), falseLabel: String("")))
        if fallthroughLabel != String("") && !hasReturn {
            defaultBlockTerminator: CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: fallthroughLabel, falseLabel: String(""))
        } else if hasReturn {
            defaultBlockTerminator: CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
        }
        llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: defaultBlockTerminator))"
    }

    return CompilerLLVMLoweredBlock(
        block: parsedBlock.block,
        declarationRecords: program.declarationRecords,
        renderedBlocks: llvmRenderedBlocks,
        instructionRecords: llvmInstructionRecords,
        localValues: llvmLocalValues,
        nextTemporary: llvmTemporaryIndex,
        nextBranchIndex: llvmBranchIndex,
        exitLabel: currentBlockLabel,
        hasEntryBranch: hasEntryBranch,
        entryBranchCondition: entryBranchCondition,
        entryBranchThenLabel: entryBranchThenLabel,
        entryBranchElseLabel: entryBranchElseLabel,
        hasReturn: hasReturn,
        returnLLVMType: returnLLVMType,
        returnLLVMValue: returnLLVMValue
    )
}

function compilerCoreStatementSummary(statement: CompilerStatement): String {
    if statement.summary != String("") {
        return statement.summary
    }

    if statement.kind == String("let") || statement.kind == String("state") {
        return "kind=\(statement.kind)\tname=\(statement.name)\ttype=\(statement.typeName)\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("expression") {
        return "kind=expression\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("assignment") {
        return "kind=assignment\ttarget=\(statement.targetSummary)\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("return") {
        return "kind=return\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("if") || statement.kind == String("while") {
        let bodyStatementSummary: String(compilerCoreStatementRecordsSummary(records: statement.bodyStatementRecords))
        let elseStatementSummary: String(compilerCoreStatementRecordsSummary(records: statement.elseStatementRecords))
        let bodyAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.bodyStatementRecords))
        let elseAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.elseStatementRecords))
        return "kind=\(statement.kind)\tcondition=\(statement.expressionSummary)\tbodyStart=\(statement.bodyStart)\tbodyEnd=\(statement.bodyEnd)\tbodyAssignments=[\(bodyAssignmentNames)]\tbodyStatements=[\(bodyStatementSummary)]\telseBodyStart=\(statement.elseBodyStart)\telseBodyEnd=\(statement.elseBodyEnd)\telseAssignments=[\(elseAssignmentNames)]\telseStatements=[\(elseStatementSummary)]"
    }

    return "kind=\(statement.kind)"
}

function compilerCoreStatementRecordsSummary(records: String): String {
    state output: String("")
    state statementIndex: Int(0)
    state statementOrdinal: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        output: "\(output)statement\(statementOrdinal)=\(compilerCoreStatementSummary(statement: statement));"
        statementOrdinal: statementOrdinal + 1
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return output
}

function parseCompilerStatement(program: CompilerProgram, start: Int, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: program.source))
    return parseCompilerStatementWithSink(program: program, start: start, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerStatementWithSink(program: CompilerProgram, start: Int, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: program.source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil { return nil }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= bodyEnd { return nil }
    if token.kind == String("keyword") {
        if token.text == String("return") {
            return parseCompilerReturnStatementWithSink(cursor: cursor, keyword: token, bodyEnd: bodyEnd, sink: sink)
        }
        if token.text == String("let") || token.text == String("state") {
            return parseCompilerLocalBindingStatementWithSink(cursor: cursor, keyword: token, bodyEnd: bodyEnd, sink: sink)
        }
        if token.text == String("if") && sink.enabled {
            return parseCompilerIfStatementWithSink(program: program, cursor: cursor, keyword: token, bodyEnd: bodyEnd, sink: sink)
        }
    }
    if token.kind == String("identifier") {
        if !sink.enabled {
            return parseCompilerStatementFromToken(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
        }
        return parseCompilerAssignmentStatementWithSink(cursor: cursor, token: token, bodyEnd: bodyEnd, sink: sink)
    }
    if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
    return parseCompilerStatementFromToken(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
}

function parseCompilerIfStatementWithSink(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let conditionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let maybeCondition: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: conditionCursor.index, limit: bodyEnd, sink: sink))
    if maybeCondition == nil { return nil }
    let conditionFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: conditionCursor.index))
    let parsedCondition: CompilerParsedExpression(maybeCondition ?? conditionFallback)
    let condition: CompilerExpression(compilerParsedExpressionValue(parsed: parsedCondition))
    let braceCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: condition.end))
    let maybeBrace: Optional<RangeLexedToken>(compilerCursorPeek(cursor: braceCursor))
    if maybeBrace == nil { return nil }
    let braceFallback: RangeLexedToken(compilerFallbackToken(cursor: braceCursor))
    let brace: RangeLexedToken(maybeBrace ?? braceFallback)
    if brace.kind != String("leftBrace") { return nil }
    let maybeRegionRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: braceCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
    if maybeRegionRange == nil { return nil }
    let regionFallback: CompilerSourceRange(CompilerSourceRange(start: brace.end, end: brace.end, next: brace.end))
    let regionRange: CompilerSourceRange(maybeRegionRange ?? regionFallback)
    let ifSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIf(), ordinal: sink.statementOrdinal, start: keyword.start, end: regionRange.next, firstStart: keyword.start, firstEnd: keyword.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    let regionSink: CompilerBodySyntaxSink(compilerBodySyntaxSinkEnabled(tables: sink.tables, fileID: sink.fileID, ownerSyntaxID: ifSyntaxID, statementOrdinal: 0))
    let regionSyntaxID: Int(compilerBodySyntaxAppendNode(sink: regionSink, kindTag: compilerSyntaxKindLexicalRegion(), ordinal: 0, start: regionRange.start, end: regionRange.end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if ifSyntaxID < 0 || regionSyntaxID < 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: ifSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedCondition), roleTag: compilerSyntaxRoleCondition(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: ifSyntaxID, childSyntaxID: regionSyntaxID, roleTag: compilerSyntaxRoleThenRegion(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: ifSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0
        || compilerTypedSyntaxCaptureBody(source: cursor.source, tables: sink.tables, fileID: sink.fileID, ownerSyntaxID: regionSyntaxID, start: regionRange.start, end: regionRange.end) != 0 {
        compilerSyntaxTablesPoison(tables: sink.tables)
        return nil
    }
    return CompilerStatement(
        kind: String("if"),
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: condition.kind,
        expressionValue: condition.value,
        expressionSummary: condition.summary,
        expressionRecord: condition.record,
        bodyStart: regionRange.start,
        bodyEnd: regionRange.end,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=if\tcondition=\(condition.summary)\tbodyStart=\(regionRange.start)\tbodyEnd=\(regionRange.end)",
        start: keyword.start,
        end: regionRange.next
    )
}

function parseCompilerAssignmentStatementWithSink(cursor: CompilerTokenCursor, token: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let maybeTarget: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: token.start, limit: bodyEnd, sink: sink))
    if maybeTarget == nil { return nil }
    let targetFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: token.start))
    let parsedTarget: CompilerParsedExpression(maybeTarget ?? targetFallback)
    let target: CompilerExpression(compilerParsedExpressionValue(parsed: parsedTarget))
    if target.kind != String("identifier") && target.kind != String("member") { return nil }
    let colonCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: target.end))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil { return nil }
    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != String("colon") { return nil }
    let valueCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeValue: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: valueCursor.index, limit: bodyEnd, sink: sink))
    if maybeValue == nil { return nil }
    let valueFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: valueCursor.index))
    let parsedValue: CompilerParsedExpression(maybeValue ?? valueFallback)
    let value: CompilerExpression(compilerParsedExpressionValue(parsed: parsedValue))
    let assignmentSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindAssignment(), ordinal: sink.statementOrdinal, start: token.start, end: value.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: assignmentSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedTarget), roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: assignmentSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedValue), roleTag: compilerSyntaxRoleAssignedValue(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: assignmentSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0 {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }
    return parseCompilerAssignmentStatement(token: token, target: target, value: value)
}

function parseCompilerStatementWithToken(program: CompilerProgram, cursor: CompilerTokenCursor, maybeToken: Optional<RangeLexedToken>, bodyEnd: Int): Optional<CompilerStatement> {
    if maybeToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    let tokenStart: Int(compilerCoreRangeTokenStart(token: token))
    if tokenStart >= bodyEnd {
        return nil
    }

    return parseCompilerStatementFromToken(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
}

function parseCompilerStatementFromToken(program: CompilerProgram, cursor: CompilerTokenCursor, token: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    if compilerCoreTokenKindEquals(token: token, kind: String("keyword")) {
        return parseCompilerKeywordStatement(program: program, cursor: cursor, keyword: token, bodyEnd: bodyEnd)
    }

    if compilerCoreTokenKindEquals(token: token, kind: String("identifier")) {
        return parseCompilerIdentifierStatement(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
    }

    return nil
}

function parseCompilerKeywordStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let keywordText: String(compilerCoreRangeTokenText(token: keyword))
    if keywordText == String("return") {
        return parseCompilerReturnStatement(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    return parseCompilerNonReturnKeywordStatement(program: program, cursor: cursor, keyword: keyword, keywordText: keywordText, bodyEnd: bodyEnd)
}

function parseCompilerNonReturnKeywordStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, keywordText: String, bodyEnd: Int): Optional<CompilerStatement> {
    if keywordText == String("if") {
        return parseCompilerControlKeywordStatement(program: program, cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    if keywordText == String("while") {
        return parseCompilerControlKeywordStatement(program: program, cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    return parseCompilerNonControlKeywordStatement(cursor: cursor, keyword: keyword, keywordText: keywordText, bodyEnd: bodyEnd)
}

function parseCompilerControlKeywordStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    return parseCompilerControlBlockStatement(program: program, cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
}

function parseCompilerNonControlKeywordStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, keywordText: String, bodyEnd: Int): Optional<CompilerStatement> {
    if keywordText == String("break") {
        return parseCompilerJumpStatement(keyword: keyword)
    }

    if keywordText == String("continue") {
        return parseCompilerJumpStatement(keyword: keyword)
    }

    return parseCompilerBindingKeywordStatement(cursor: cursor, keyword: keyword, keywordText: keywordText, bodyEnd: bodyEnd)
}

function parseCompilerBindingKeywordStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, keywordText: String, bodyEnd: Int): Optional<CompilerStatement> {
    if keywordText == String("let") {
        return parseCompilerLocalBindingStatement(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    if keywordText == String("state") {
        return parseCompilerLocalBindingStatement(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    return nil
}

function parseCompilerJumpStatement(keyword: RangeLexedToken): Optional<CompilerStatement> {
    return CompilerStatement(
        kind: keyword.text,
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: String(""),
        expressionValue: String(""),
        expressionSummary: String(""),
        expressionRecord: String(""),
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=\(keyword.text)",
        start: keyword.start,
        end: keyword.end
    )
}

function parseCompilerReturnStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: cursor.source))
    return parseCompilerReturnStatementWithSink(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerReturnStatementWithSink(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let expressionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let expressionStart: Int(compilerCoreFirstNonWhitespaceIndex(source: cursor.source, start: expressionCursor.index, end: bodyEnd))
    return parseCompilerReturnStatementExpressionWithSink(source: cursor.source, keyword: keyword, expressionStart: expressionStart, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerReturnStatementExpression(source: String, keyword: RangeLexedToken, expressionStart: Int, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    return parseCompilerReturnStatementExpressionWithSink(source: source, keyword: keyword, expressionStart: expressionStart, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerReturnStatementExpressionWithSink(source: String, keyword: RangeLexedToken, expressionStart: Int, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let maybeParsedReturnExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: expressionStart, limit: bodyEnd, sink: sink))
    if maybeParsedReturnExpression == nil {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }

    let parsedReturnFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: expressionStart))
    let parsedReturnExpression: CompilerParsedExpression(maybeParsedReturnExpression ?? parsedReturnFallback)
    let expression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedReturnExpression))
    let statement: CompilerStatement(compilerCoreReturnStatementFromExpression(keyword: keyword, expression: expression))
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindReturn(), ordinal: sink.statementOrdinal, start: keyword.start, end: expression.end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: statementSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedReturnExpression), roleTag: compilerSyntaxRoleReturnValue(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0 {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }
    return statement
}

function compilerCoreReturnStatementFromExpression(keyword: RangeLexedToken, expression: CompilerExpression): CompilerStatement {
    return CompilerStatement(
        kind: String("return"),
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: expression.kind,
        expressionValue: expression.value,
        expressionSummary: expression.summary,
        expressionRecord: expression.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=return\texpression=\(expression.summary)",
        start: keyword.start,
        end: expression.end
    )
}

function parseCompilerSimpleExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    return parseCompilerExpression(source: source, start: start, limit: limit)
}

function compilerCoreSimpleExpressionFromToken(token: RangeLexedToken): Optional<CompilerExpression> {
    let tokenKind: String(compilerCoreRangeTokenKind(token: token))
    if tokenKind == String("integer") {
        return compilerCoreTokenExpression(token: token, kind: String("integerLiteral"), value: token.text, summaryPrefix: String("integerLiteral"))
    }

    if tokenKind == String("stringLiteral") {
        return compilerCoreTokenExpression(token: token, kind: String("stringLiteral"), value: token.text, summaryPrefix: String("stringLiteral"))
    }

    return compilerCoreSimpleNameExpressionFromToken(token: token, tokenKind: tokenKind)
}

function compilerCoreSimpleNameExpressionFromToken(token: RangeLexedToken, tokenKind: String): Optional<CompilerExpression> {
    if tokenKind == String("identifier") {
        return compilerCoreIdentifierOrBoolExpressionFromToken(token: token)
    }

    if tokenKind == String("keyword") {
        return compilerCoreIdentifierOrBoolExpressionFromToken(token: token)
    }

    return nil
}

function compilerCoreIdentifierOrBoolExpressionFromToken(token: RangeLexedToken): Optional<CompilerExpression> {
    if token.text == String("true") {
        return compilerCoreTokenExpression(token: token, kind: String("boolLiteral"), value: token.text, summaryPrefix: String("boolLiteral"))
    }

    if token.text == String("false") {
        return compilerCoreTokenExpression(token: token, kind: String("boolLiteral"), value: token.text, summaryPrefix: String("boolLiteral"))
    }

    return compilerCoreTokenExpression(token: token, kind: String("identifier"), value: token.text, summaryPrefix: String("identifier"))
}

function compilerCoreTokenExpression(token: RangeLexedToken, kind: String, value: String, summaryPrefix: String): CompilerExpression {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: String("")))
    let parsedTokenExpression: CompilerParsedExpression(compilerCoreTokenExpressionWithSink(token: token, kind: kind, value: value, summaryPrefix: summaryPrefix, sink: sink))
    return compilerParsedExpressionValue(parsed: parsedTokenExpression)
}

function compilerCoreTokenExpressionWithSink(token: RangeLexedToken, kind: String, value: String, summaryPrefix: String, sink: CompilerBodySyntaxSink): CompilerParsedExpression {
    let record: String(compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end))
    state kindTag: Int(0 - 1)
    if kind == String("integerLiteral") {
        kindTag: compilerSyntaxKindIntegerLiteral()
    } else if kind == String("identifier") {
        kindTag: compilerSyntaxKindIdentifier()
    } else if sink.enabled {
        compilerSyntaxTablesPoison(tables: sink.tables)
    }
    state syntaxID: Int(0 - 1)
    if kindTag >= 0 {
        syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: kindTag, ordinal: 0, start: token.start, end: token.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
    }
    let tokenExpression: CompilerExpression(CompilerExpression(
        kind: kind,
        value: value,
        summary: "\(summaryPrefix)(\(value))",
        record: record,
        start: token.start,
        end: token.end
    ))
    return CompilerParsedExpression(expression: tokenExpression, syntaxID: syntaxID)
}

function parseCompilerIdentifierStatement(program: CompilerProgram, cursor: CompilerTokenCursor, token: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let tokenColonStart: Int(compilerCoreFirstNonWhitespaceIndex(source: cursor.source, start: token.end, end: bodyEnd))
    if tokenColonStart < bodyEnd && cursor.source.substring(start: tokenColonStart, end: tokenColonStart + 1) == String(":") {
        let tokenTarget: CompilerExpression(compilerCoreTokenExpression(token: token, kind: String("identifier"), value: token.text, summaryPrefix: String("identifier")))
        return parseCompilerIdentifierStatementWithTarget(cursor: cursor, token: token, target: tokenTarget, bodyEnd: bodyEnd)
    }

    let maybeTarget: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: token.start, limit: bodyEnd))
    if maybeTarget == nil {
        return nil
    }

    let targetFallback: CompilerExpression(compilerCoreMissingExpression(start: token.start))
    let target: CompilerExpression(maybeTarget ?? targetFallback)
    return parseCompilerIdentifierStatementWithTarget(cursor: cursor, token: token, target: target, bodyEnd: bodyEnd)
}

function parseCompilerIdentifierStatementWithTarget(cursor: CompilerTokenCursor, token: RangeLexedToken, target: CompilerExpression, bodyEnd: Int): Optional<CompilerStatement> {
    let colonStart: Int(compilerCoreFirstNonWhitespaceIndex(source: cursor.source, start: target.end, end: bodyEnd))
    if colonStart >= bodyEnd {
        return compilerCoreExpressionStatement(expression: target)
    }

    let colonText: String(cursor.source.substring(start: colonStart, end: colonStart + 1))
    if colonText != String(":") {
        return compilerCoreExpressionStatement(expression: target)
    }

    let valueStart: Int(colonStart + 1)
    let maybeValue: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: valueStart, limit: bodyEnd))
    if maybeValue == nil {
        return nil
    }
    let valueFallback: CompilerExpression(compilerCoreMissingExpression(start: valueStart))
    let value: CompilerExpression(maybeValue ?? valueFallback)
    return parseCompilerAssignmentStatement(token: token, target: target, value: value)
}

function parseCompilerAssignmentStatement(token: RangeLexedToken, target: CompilerExpression, value: CompilerExpression): CompilerStatement {
    let targetName: String(compilerCoreIdentifierExpressionRecordName(record: target.record, fallbackSummary: target.summary))
    return CompilerStatement(
        kind: String("assignment"),
        name: targetName,
        typeName: String(""),
        targetSummary: target.summary,
        targetRecord: target.record,
        expressionKind: value.kind,
        expressionValue: value.value,
        expressionSummary: value.summary,
        expressionRecord: value.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=assignment\ttarget=\(target.summary)\texpression=\(value.summary)",
        start: token.start,
        end: value.end
    )
}

function compilerCoreExpressionStatement(expression: CompilerExpression): CompilerStatement {
    return CompilerStatement(
        kind: String("expression"),
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: expression.kind,
        expressionValue: expression.value,
        expressionSummary: expression.summary,
        expressionRecord: expression.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=expression\texpression=\(expression.summary)",
        start: expression.start,
        end: expression.end
    )
}

function parseCompilerStatementLegacy(program: CompilerProgram, start: Int, bodyEnd: Int): Optional<CompilerStatement> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: program.source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= bodyEnd {
        return nil
    }

    if token.kind == String("keyword") && (token.text == String("if") || token.text == String("while")) {
        return parseCompilerControlBlockStatement(program: program, cursor: cursor, keyword: token, bodyEnd: bodyEnd)
    }

    if token.kind == String("keyword") && (token.text == String("break") || token.text == String("continue")) {
        return CompilerStatement(
            kind: token.text,
            name: String(""),
            typeName: String(""),
            targetSummary: String(""),
            targetRecord: String(""),
            expressionKind: String(""),
            expressionValue: String(""),
            expressionSummary: String(""),
            expressionRecord: String(""),
            bodyStart: 0,
            bodyEnd: 0,
            elseBodyStart: 0,
            elseBodyEnd: 0,
            bodyStatementRecords: String(""),
            elseStatementRecords: String(""),
            summary: "kind=\(token.text)",
            start: token.start,
            end: token.end
        )
    }

    if token.kind == String("keyword") && token.text == String("return") {
        let expressionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
        let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: expressionCursor.index, limit: bodyEnd))
        if maybeExpression == nil {
            return nil
        }
        let expressionFallback: CompilerExpression(compilerCoreMissingExpression(start: expressionCursor.index))
        let expression: CompilerExpression(maybeExpression ?? expressionFallback)
        return CompilerStatement(
            kind: String("return"),
            name: String(""),
            typeName: String(""),
            targetSummary: String(""),
            targetRecord: String(""),
            expressionKind: expression.kind,
            expressionValue: expression.value,
            expressionSummary: expression.summary,
            expressionRecord: expression.record,
            bodyStart: 0,
            bodyEnd: 0,
            elseBodyStart: 0,
            elseBodyEnd: 0,
            bodyStatementRecords: String(""),
            elseStatementRecords: String(""),
            summary: "kind=return\texpression=\(expression.summary)",
            start: token.start,
            end: expression.end
        )
    }

    if token.kind == String("keyword") && (token.text == String("let") || token.text == String("state")) {
        return parseCompilerLocalBindingStatement(cursor: cursor, keyword: token, bodyEnd: bodyEnd)
    }

    if token.kind == String("identifier") {
        let maybeTarget: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: token.start, limit: bodyEnd))
        if maybeTarget == nil {
            return nil
        }
        let targetFallback: CompilerExpression(compilerCoreMissingExpression(start: token.start))
        let target: CompilerExpression(maybeTarget ?? targetFallback)
        let colonCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: target.end))
        let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
        if maybeColon == nil {
            return CompilerStatement(
                kind: String("expression"),
                name: String(""),
                typeName: String(""),
                targetSummary: String(""),
                targetRecord: String(""),
                expressionKind: target.kind,
                expressionValue: target.value,
                expressionSummary: target.summary,
                expressionRecord: target.record,
                bodyStart: 0,
                bodyEnd: 0,
                elseBodyStart: 0,
                elseBodyEnd: 0,
                bodyStatementRecords: String(""),
                elseStatementRecords: String(""),
                summary: "kind=expression\texpression=\(target.summary)",
                start: token.start,
                end: target.end
            )
        }
        let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
        let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
        if colonToken.kind != String("colon") {
            return CompilerStatement(
                kind: String("expression"),
                name: String(""),
                typeName: String(""),
                targetSummary: String(""),
                targetRecord: String(""),
                expressionKind: target.kind,
                expressionValue: target.value,
                expressionSummary: target.summary,
                expressionRecord: target.record,
                bodyStart: 0,
                bodyEnd: 0,
                elseBodyStart: 0,
                elseBodyEnd: 0,
                bodyStatementRecords: String(""),
                elseStatementRecords: String(""),
                summary: "kind=expression\texpression=\(target.summary)",
                start: token.start,
                end: target.end
            )
        }
        let valueCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
        let maybeValue: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: valueCursor.index, limit: bodyEnd))
        if maybeValue == nil {
            return nil
        }
        let valueFallback: CompilerExpression(compilerCoreMissingExpression(start: valueCursor.index))
        let value: CompilerExpression(maybeValue ?? valueFallback)
        let targetName: String(compilerCoreIdentifierExpressionRecordName(record: target.record, fallbackSummary: target.summary))
        return CompilerStatement(
            kind: String("assignment"),
            name: targetName,
            typeName: String(""),
            targetSummary: target.summary,
            targetRecord: target.record,
            expressionKind: value.kind,
            expressionValue: value.value,
            expressionSummary: value.summary,
            expressionRecord: value.record,
            bodyStart: 0,
            bodyEnd: 0,
            elseBodyStart: 0,
            elseBodyEnd: 0,
            bodyStatementRecords: String(""),
            elseStatementRecords: String(""),
            summary: "kind=assignment\ttarget=\(target.summary)\texpression=\(value.summary)",
            start: token.start,
            end: value.end
        )
    }

    return nil
}

function parseCompilerControlBlockStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let conditionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let maybeCondition: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: conditionCursor.index, limit: bodyEnd))
    if maybeCondition == nil {
        return nil
    }

    let conditionFallback: CompilerExpression(compilerCoreMissingExpression(start: conditionCursor.index))
    let condition: CompilerExpression(maybeCondition ?? conditionFallback)
    state blockCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: condition.end))
    state sawLeftBrace: Bool(false)
    state blockStart: Int(0)
    state blockEnd: Int(0)
    state nextIndex: Int(0)
    state elseBlockStart: Int(0)
    state elseBlockEnd: Int(0)
    state nestedElseStatementRecords: String("")

    while blockCursor.index < bodyEnd && !sawLeftBrace {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: blockCursor))
        if maybeToken == nil {
            return nil
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: blockCursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.kind == String("leftBrace") {
            let maybeRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: blockCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
            if maybeRange == nil {
                return nil
            }
            let rangeFallback: CompilerSourceRange(CompilerSourceRange(start: token.end, end: token.end, next: token.end))
            let range: CompilerSourceRange(maybeRange ?? rangeFallback)
            blockStart: range.start
            blockEnd: range.end
            nextIndex: range.next
            sawLeftBrace: true
        } else {
            blockCursor: compilerCursorAdvance(cursor: blockCursor, token: token)
        }
    }

    if !sawLeftBrace {
        return nil
    }

    let elseCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: nextIndex))
    let maybeElseToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: elseCursor))
    if maybeElseToken != nil && keyword.text == String("if") {
        let elseTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: elseCursor))
        let elseToken: RangeLexedToken(maybeElseToken ?? elseTokenFallback)
        if elseToken.kind == String("keyword") && elseToken.text == String("else") {
            let elseBlockCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: elseCursor, token: elseToken))
            let maybeElseBodyToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: elseBlockCursor))
            if maybeElseBodyToken != nil {
                let elseBodyTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: elseBlockCursor))
                let elseBodyToken: RangeLexedToken(maybeElseBodyToken ?? elseBodyTokenFallback)
                if elseBodyToken.kind == String("leftBrace") {
                    let maybeElseRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: elseBlockCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
                    if maybeElseRange != nil {
                        let elseRangeFallback: CompilerSourceRange(CompilerSourceRange(start: elseToken.end, end: elseToken.end, next: elseToken.end))
                        let elseRange: CompilerSourceRange(maybeElseRange ?? elseRangeFallback)
                        elseBlockStart: elseRange.start
                        elseBlockEnd: elseRange.end
                        nextIndex: elseRange.next
                    }
                }
                if elseBodyToken.kind == String("keyword") && elseBodyToken.text == String("if") {
                    let maybeNestedIf: Optional<CompilerStatement>(parseCompilerControlBlockStatement(program: program, cursor: elseBlockCursor, keyword: elseBodyToken, bodyEnd: bodyEnd))
                    if maybeNestedIf != nil {
                        let nestedIfFallback: CompilerStatement(compilerCoreMissingStatement(start: elseBodyToken.start, end: elseBodyToken.end))
                        let nestedIf: CompilerStatement(maybeNestedIf ?? nestedIfFallback)
                        elseBlockStart: nestedIf.start
                        elseBlockEnd: nestedIf.end
                        nextIndex: nestedIf.end
                        nestedElseStatementRecords: compilerCoreStatementRecord(statement: nestedIf)
                    }
                }
            }
        }
    }

    let bodyStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: CompilerBlock(start: blockStart, end: blockEnd)))
    let elseStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: CompilerBlock(start: elseBlockStart, end: elseBlockEnd)))
    state elseStatementRecords: String("")
    elseStatementRecords: elseStatements.records
    if nestedElseStatementRecords != String("") {
        elseStatementRecords: nestedElseStatementRecords
    }
    return CompilerStatement(
        kind: keyword.text,
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: condition.kind,
        expressionValue: condition.value,
        expressionSummary: condition.summary,
        expressionRecord: condition.record,
        bodyStart: blockStart,
        bodyEnd: blockEnd,
        elseBodyStart: elseBlockStart,
        elseBodyEnd: elseBlockEnd,
        bodyStatementRecords: bodyStatements.records,
        elseStatementRecords: elseStatementRecords,
        summary: "kind=\(keyword.text)\tcondition=\(condition.summary)\tbodyStart=\(blockStart)\tbodyEnd=\(blockEnd)\tbodyStatements=[\(bodyStatements.summary)]\telseBodyStart=\(elseBlockStart)\telseBodyEnd=\(elseBlockEnd)\telseStatements=[\(elseStatements.summary)]",
        start: keyword.start,
        end: nextIndex
    )
}

function parseCompilerLocalBindingStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: cursor.source))
    return parseCompilerLocalBindingStatementWithSink(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd, sink: sink)
}

function compilerCoreCallArgumentsStartWithLabel(source: String, start: Int, end: Int): Bool {
    let labelCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let maybeLabelToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: labelCursor))
    if maybeLabelToken == nil { return false }
    let labelFallbackToken: RangeLexedToken(compilerFallbackToken(cursor: labelCursor))
    let labelToken: RangeLexedToken(maybeLabelToken ?? labelFallbackToken)
    if labelToken.start >= end || (labelToken.kind != String("identifier") && labelToken.kind != String("keyword")) { return false }
    let afterLabelCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: labelCursor, token: labelToken))
    let maybeLabelColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterLabelCursor))
    if maybeLabelColon == nil { return false }
    let labelColonFallback: RangeLexedToken(compilerFallbackToken(cursor: afterLabelCursor))
    let labelColon: RangeLexedToken(maybeLabelColon ?? labelColonFallback)
    return labelColon.start < end && labelColon.kind == String("colon")
}

function parseCompilerLocalBindingStatementWithSink(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    state cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
    if maybeName == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    if nameToken.kind != String("identifier") {
        return nil
    }
    cursorState: compilerCursorAdvance(cursor: cursorState, token: nameToken)

    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
    if maybeColon == nil {
        return nil
    }
    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != String("colon") {
        return nil
    }
    cursorState: compilerCursorAdvance(cursor: cursorState, token: colonToken)

    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: cursorState))
    if maybeType == nil {
        return nil
    }
    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: cursorState.index, end: cursorState.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    cursorState: CompilerTokenCursor(source: cursor.source, index: typeReference.end)

    let maybeLeftParen: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
    if maybeLeftParen == nil {
        return nil
    }
    let leftParenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
    let leftParenToken: RangeLexedToken(maybeLeftParen ?? leftParenFallback)
    if leftParenToken.kind != String("leftParen") {
        return nil
    }
    let initializerOpenCursor: CompilerTokenCursor(cursorState)
    let maybeInitializerRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: initializerOpenCursor, leftKind: String("leftParen"), rightKind: String("rightParen")))
    if maybeInitializerRange == nil { return nil }
    let initializerRangeFallback: CompilerSourceRange(CompilerSourceRange(start: leftParenToken.end, end: leftParenToken.end, next: leftParenToken.end))
    let initializerRange: CompilerSourceRange(maybeInitializerRange ?? initializerRangeFallback)
    cursorState: compilerCursorAdvance(cursor: cursorState, token: leftParenToken)

    state expression: CompilerExpression(compilerCoreMissingExpression(start: cursorState.index))
    state bindingExpressionSyntaxID: Int(0 - 1)
    state bindingEnd: Int(0)
    if compilerCoreCallArgumentsStartWithLabel(source: cursor.source, start: initializerRange.start, end: initializerRange.end) {
        let implicitCalleeRecord: String(compilerCoreExpressionRecord(kind: String("identifier"), value: typeReference.text, left: String(""), right: String(""), arguments: String(""), start: typeReference.start, end: typeReference.end))
        let implicitCalleeSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIdentifier(), ordinal: 0, start: typeReference.start, end: typeReference.end, firstStart: typeReference.start, firstEnd: typeReference.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        let implicitApplicationSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindApplication(), ordinal: 0, start: typeReference.start, end: initializerRange.next, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: implicitApplicationSyntaxID, childSyntaxID: implicitCalleeSyntaxID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0) != 0 {
            if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
            return nil
        }
        let implicitArguments: CompilerCallArguments(parseCompilerCallArgumentsWithSink(source: cursor.source, start: initializerRange.start, end: initializerRange.end, sink: sink, callSyntaxID: implicitApplicationSyntaxID))
        let implicitSummary: String("call(identifier(\(typeReference.text)),arguments=[\(implicitArguments.summary)])")
        let implicitRecord: String(compilerCoreExpressionRecord(kind: String("call"), value: typeReference.text, left: implicitCalleeRecord, right: String(""), arguments: implicitArguments.records, start: typeReference.start, end: initializerRange.next))
        expression: CompilerExpression(kind: String("call"), value: typeReference.text, summary: implicitSummary, record: implicitRecord, start: typeReference.start, end: initializerRange.next)
        bindingExpressionSyntaxID: implicitApplicationSyntaxID
        bindingEnd: initializerRange.next
    } else {
        let maybeBindingExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: cursorState.index, limit: bodyEnd, sink: sink))
        if maybeBindingExpression == nil {
            if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
            return nil
        }
        let bindingExpressionFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: cursorState.index))
        let parsedBindingExpression: CompilerParsedExpression(maybeBindingExpression ?? bindingExpressionFallback)
        expression: compilerParsedExpressionValue(parsed: parsedBindingExpression)
        bindingExpressionSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedBindingExpression)
        cursorState: CompilerTokenCursor(source: cursor.source, index: expression.end)
        let maybeBindingRightParen: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
        if maybeBindingRightParen == nil { return nil }
        let bindingRightParenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
        let bindingRightParenToken: RangeLexedToken(maybeBindingRightParen ?? bindingRightParenFallback)
        if bindingRightParenToken.kind != String("rightParen") { return nil }
        bindingEnd: bindingRightParenToken.end
    }

    state bindingKind: Int(compilerSyntaxLocalKindLet())
    if keyword.text == String("state") { bindingKind: compilerSyntaxLocalKindState() }
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindLocalBinding(), ordinal: sink.statementOrdinal, start: keyword.start, end: bindingEnd, firstStart: nameToken.start, firstEnd: nameToken.end, secondStart: typeReference.start, secondEnd: typeReference.end, aux: bindingKind))
    if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: statementSyntaxID, childSyntaxID: bindingExpressionSyntaxID, roleTag: compilerSyntaxRoleInitializer(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0 {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }
    return CompilerStatement(
        kind: keyword.text,
        name: nameToken.text,
        typeName: typeReference.text,
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: expression.kind,
        expressionValue: expression.value,
        expressionSummary: expression.summary,
        expressionRecord: expression.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=\(keyword.text)\tname=\(nameToken.text)\ttype=\(typeReference.text)\texpression=\(expression.summary)",
        start: keyword.start,
        end: bindingEnd
    )
}

function compilerCoreIsBinaryOperator(token: RangeLexedToken): Bool {
    return token.kind == String("equalEqual")
        || token.kind == String("bangEqual")
        || token.kind == String("less")
        || token.kind == String("lessEqual")
        || token.kind == String("greater")
        || token.kind == String("greaterEqual")
        || token.kind == String("plus")
        || token.kind == String("minus")
        || token.kind == String("asterisk")
        || token.kind == String("slash")
        || token.kind == String("percent")
        || token.kind == String("andAnd")
        || token.kind == String("orOr")
        || token.kind == String("questionQuestion")
}

function compilerCoreIsPrefixOperator(token: RangeLexedToken): Bool {
    return token.kind == String("bang")
        || token.kind == String("minus")
}

function compilerCoreBinaryPrecedence(token: RangeLexedToken): Int {
    if token.kind == String("orOr") {
        return 1
    }

    if token.kind == String("andAnd") {
        return 2
    }

    if token.kind == String("equalEqual")
        || token.kind == String("bangEqual")
        || token.kind == String("less")
        || token.kind == String("lessEqual")
        || token.kind == String("greater")
        || token.kind == String("greaterEqual")
    {
        return 3
    }

    if token.kind == String("questionQuestion") {
        return 4
    }

    if token.kind == String("plus") || token.kind == String("minus") {
        return 5
    }

    if token.kind == String("asterisk") || token.kind == String("slash") || token.kind == String("percent") {
        return 6
    }

    return 0
}

function compilerCoreBinaryIsRightAssociative(token: RangeLexedToken): Bool {
    return token.kind == String("questionQuestion")
}

function parseCompilerExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedExpression == nil { return nil }
    let parsedExpressionFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedExpression: CompilerParsedExpression(maybeParsedExpression ?? parsedExpressionFallback)
    return compilerParsedExpressionValue(parsed: parsedExpression)
}

function parseCompilerExpressionWithSink(source: String, start: Int, limit: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    return parseCompilerExpressionAtPrecedenceWithSink(source: source, start: start, limit: limit, minimumPrecedence: 0, sink: sink)
}

function parseCompilerExpressionAtPrecedence(source: String, start: Int, limit: Int, minimumPrecedence: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedPrecedenceExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: start, limit: limit, minimumPrecedence: minimumPrecedence, sink: sink))
    if maybeParsedPrecedenceExpression == nil { return nil }
    let parsedPrecedenceFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedPrecedenceExpression: CompilerParsedExpression(maybeParsedPrecedenceExpression ?? parsedPrecedenceFallback)
    return compilerParsedExpressionValue(parsed: parsedPrecedenceExpression)
}

function parseCompilerExpressionAtPrecedenceWithSink(source: String, start: Int, limit: Int, minimumPrecedence: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    let maybeParsedLeftExpression: Optional<CompilerParsedExpression>(parseCompilerPrefixExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedLeftExpression == nil {
        return nil
    }

    let parsedLeftFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let initialParsedLeftExpression: CompilerParsedExpression(maybeParsedLeftExpression ?? parsedLeftFallback)
    state leftExpression: CompilerExpression(compilerParsedExpressionValue(parsed: initialParsedLeftExpression))
    state leftExpressionSyntaxID: Int(compilerParsedExpressionSyntaxID(parsed: initialParsedLeftExpression))
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: leftExpression.end))

    while cursor.index < limit {
        let maybeOperator: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeOperator == nil {
            return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
        }

        let operatorFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let operatorToken: RangeLexedToken(maybeOperator ?? operatorFallback)
        if !compilerCoreIsBinaryOperator(token: operatorToken) {
            return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
        }

        let precedence: Int(compilerCoreBinaryPrecedence(token: operatorToken))
        if precedence < minimumPrecedence {
            return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
        }

        state rightMinimumPrecedence: Int(0)
        rightMinimumPrecedence: precedence + 1
        if compilerCoreBinaryIsRightAssociative(token: operatorToken) {
            rightMinimumPrecedence: precedence
        }

        let maybeParsedRightExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: operatorToken.end, limit: limit, minimumPrecedence: rightMinimumPrecedence, sink: sink))
        if maybeParsedRightExpression == nil {
            return nil
        }
        let parsedRightFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: operatorToken.end))
        let parsedRightExpression: CompilerParsedExpression(maybeParsedRightExpression ?? parsedRightFallback)
        let rightExpression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedRightExpression))
        let binaryRecord: String(compilerCoreExpressionRecord(kind: String("binary"), value: operatorToken.text, left: leftExpression.record, right: rightExpression.record, arguments: String(""), start: leftExpression.start, end: rightExpression.end))
        state binarySyntaxID: Int(0 - 1)
        if operatorToken.kind == String("plus") {
            binarySyntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindAddition(), ordinal: 0, start: leftExpression.start, end: rightExpression.end, firstStart: operatorToken.start, firstEnd: operatorToken.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: binarySyntaxID, childSyntaxID: leftExpressionSyntaxID, roleTag: compilerSyntaxRoleLeftOperand(), ordinal: 0) != 0
                || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: binarySyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedRightExpression), roleTag: compilerSyntaxRoleRightOperand(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return nil
            }
        } else if sink.enabled {
            compilerSyntaxTablesPoison(tables: sink.tables)
        }
        leftExpression: CompilerExpression(
            kind: String("binary"),
            value: operatorToken.text,
            summary: String("binary"),
            record: binaryRecord,
            start: leftExpression.start,
            end: rightExpression.end
        )
        leftExpressionSyntaxID: binarySyntaxID
        cursor: CompilerTokenCursor(source: source, index: rightExpression.end)
    }

    return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
}

function parseCompilerPrefixExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedPrefixExpression: Optional<CompilerParsedExpression>(parseCompilerPrefixExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedPrefixExpression == nil { return nil }
    let parsedPrefixFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedPrefixExpression: CompilerParsedExpression(maybeParsedPrefixExpression ?? parsedPrefixFallback)
    return compilerParsedExpressionValue(parsed: parsedPrefixExpression)
}

function parseCompilerPrefixExpressionWithSink(source: String, start: Int, limit: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= limit {
        return nil
    }

    if token.kind == String("leftParen") {
        let maybeParsedGroupedExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: token.end, limit: limit, minimumPrecedence: 0, sink: sink))
        if maybeParsedGroupedExpression == nil {
            return nil
        }
        let parsedGroupedFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: token.end))
        let parsedGroupedExpression: CompilerParsedExpression(maybeParsedGroupedExpression ?? parsedGroupedFallback)
        let groupedExpression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedGroupedExpression))
        let maybeRightParen: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: groupedExpression.end))
        if maybeRightParen == nil {
            return nil
        }
        let rightParenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let rightParenToken: RangeLexedToken(maybeRightParen ?? rightParenFallback)
        if rightParenToken.kind != String("rightParen") {
            return nil
        }
        let groupedLegacyExpression: CompilerExpression(CompilerExpression(kind: groupedExpression.kind, value: groupedExpression.value, summary: groupedExpression.summary, record: groupedExpression.record, start: token.start, end: rightParenToken.end))
        return CompilerParsedExpression(expression: groupedLegacyExpression, syntaxID: compilerParsedExpressionSyntaxID(parsed: parsedGroupedExpression))
    }

    if compilerCoreIsPrefixOperator(token: token) {
        let maybeParsedOperand: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: token.end, limit: limit, minimumPrecedence: 7, sink: sink))
        if maybeParsedOperand == nil {
            return nil
        }

        let parsedOperandFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: token.end))
        let parsedOperand: CompilerParsedExpression(maybeParsedOperand ?? parsedOperandFallback)
        let operand: CompilerExpression(compilerParsedExpressionValue(parsed: parsedOperand))
        let prefixRecord: String(compilerCoreExpressionRecord(kind: String("prefix"), value: token.text, left: operand.record, right: String(""), arguments: String(""), start: token.start, end: operand.end))
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        let prefixLegacyExpression: CompilerExpression(CompilerExpression(
            kind: String("prefix"),
            value: token.text,
            summary: "prefix(\(token.text),\(operand.summary))",
            record: prefixRecord,
            start: token.start,
            end: operand.end
        ))
        return CompilerParsedExpression(expression: prefixLegacyExpression, syntaxID: 0 - 1)
    }

    return parseCompilerPostfixExpressionWithSink(source: source, start: token.start, limit: limit, sink: sink)
}

function parseCompilerPostfixExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedPostfixExpression: Optional<CompilerParsedExpression>(parseCompilerPostfixExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedPostfixExpression == nil { return nil }
    let parsedPostfixFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedPostfixExpression: CompilerParsedExpression(maybeParsedPostfixExpression ?? parsedPostfixFallback)
    return compilerParsedExpressionValue(parsed: parsedPostfixExpression)
}

function parseCompilerPostfixExpressionWithSink(source: String, start: Int, limit: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= limit {
        return nil
    }

    if token.kind == String("dollar") {
        let nameCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
        let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: nameCursor))
        if maybeName == nil { return nil }
        let nameFallback: RangeLexedToken(compilerFallbackToken(cursor: nameCursor))
        let nameToken: RangeLexedToken(maybeName ?? nameFallback)
        if nameToken.kind != String("identifier") { return nil }
        let bindingSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindBindingReference(), ordinal: 0, start: token.start, end: nameToken.end, firstStart: nameToken.start, firstEnd: nameToken.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        let bindingRecord: String(compilerCoreExpressionRecord(kind: String("bindingReference"), value: nameToken.text, left: String(""), right: String(""), arguments: String(""), start: token.start, end: nameToken.end))
        return CompilerParsedExpression(
            expression: CompilerExpression(kind: String("bindingReference"), value: nameToken.text, summary: "bindingReference((nameToken.text))", record: bindingRecord, start: token.start, end: nameToken.end),
            syntaxID: bindingSyntaxID
        )
    }

    state summary: String("")
    state kind: String("")
    state value: String("")
    state record: String("")
    if token.kind == String("integer") {
        kind: String("integerLiteral")
        value: token.text
        summary: "integerLiteral(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else if token.kind == String("stringLiteral") {
        kind: String("stringLiteral")
        value: token.text
        summary: "stringLiteral(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else if (token.kind == String("identifier") || token.kind == String("keyword")) && (token.text == String("true") || token.text == String("false")) {
        kind: String("boolLiteral")
        value: token.text
        summary: "boolLiteral(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else if token.kind == String("identifier") || token.kind == String("keyword") {
        kind: String("identifier")
        value: token.text
        summary: "identifier(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else {
        return nil
    }

    state syntaxID: Int(0 - 1)
    if kind == String("integerLiteral") {
        syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIntegerLiteral(), ordinal: 0, start: token.start, end: token.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
    } else if kind == String("identifier") {
        syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIdentifier(), ordinal: 0, start: token.start, end: token.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
    } else if sink.enabled {
        compilerSyntaxTablesPoison(tables: sink.tables)
    }

    state expressionEnd: Int(0)
    expressionEnd: token.end
    state suffixCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))

    while suffixCursor.index < limit {
        let maybeSuffix: Optional<RangeLexedToken>(compilerCursorPeek(cursor: suffixCursor))
        if maybeSuffix == nil {
            let completedPostfixExpression: CompilerExpression(CompilerExpression(kind: kind, value: value, summary: summary, record: record, start: token.start, end: expressionEnd))
            return CompilerParsedExpression(expression: completedPostfixExpression, syntaxID: syntaxID)
        }
        let suffixFallback: RangeLexedToken(compilerFallbackToken(cursor: suffixCursor))
        let suffixToken: RangeLexedToken(maybeSuffix ?? suffixFallback)
        if suffixToken.kind == String("dot") {
            let memberCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: suffixCursor, token: suffixToken))
            let maybeMember: Optional<RangeLexedToken>(compilerCursorPeek(cursor: memberCursor))
            if maybeMember == nil {
                return nil
            }
            let memberFallback: RangeLexedToken(compilerFallbackToken(cursor: memberCursor))
            let memberToken: RangeLexedToken(maybeMember ?? memberFallback)
            if memberToken.kind != String("identifier") && memberToken.kind != String("keyword") {
                return nil
            }
            let baseRecord: String(record)
            let baseSyntaxID: Int(syntaxID)
            kind: String("member")
            value: memberToken.text
            summary: "member(\(summary),\(memberToken.text))"
            expressionEnd: memberToken.end
            record: compilerCoreExpressionRecord(kind: kind, value: value, left: baseRecord, right: String(""), arguments: String(""), start: token.start, end: expressionEnd)
            syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindMemberRead(), ordinal: 0, start: token.start, end: expressionEnd, firstStart: memberToken.start, firstEnd: memberToken.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: syntaxID, childSyntaxID: baseSyntaxID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return nil
            }
            suffixCursor: compilerCursorAdvance(cursor: memberCursor, token: memberToken)
        } else if suffixToken.kind == String("leftParen") {
            let maybeArguments: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: suffixCursor, leftKind: String("leftParen"), rightKind: String("rightParen")))
            if maybeArguments == nil {
                return nil
            }
            let argumentsFallback: CompilerSourceRange(CompilerSourceRange(start: suffixToken.end, end: suffixToken.end, next: suffixToken.end))
            let argumentsRange: CompilerSourceRange(maybeArguments ?? argumentsFallback)
            let calleeRecord: String(record)
            let calleeSyntaxID: Int(syntaxID)
            let callSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindApplication(), ordinal: 0, start: token.start, end: argumentsRange.next, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: callSyntaxID, childSyntaxID: calleeSyntaxID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return nil
            }
            let arguments: CompilerCallArguments(parseCompilerCallArgumentsWithSink(source: source, start: argumentsRange.start, end: argumentsRange.end, sink: sink, callSyntaxID: callSyntaxID))
            kind: String("call")
            summary: "call(\(summary),arguments=[\(arguments.summary)])"
            expressionEnd: argumentsRange.next
            record: compilerCoreExpressionRecord(kind: kind, value: value, left: calleeRecord, right: String(""), arguments: arguments.records, start: token.start, end: expressionEnd)
            syntaxID: callSyntaxID
            suffixCursor: CompilerTokenCursor(source: source, index: argumentsRange.next)
        } else if suffixToken.kind == String("leftBracket") {
            let maybeParsedIndex: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: suffixToken.end, limit: limit, sink: sink))
            if maybeParsedIndex == nil {
                return nil
            }
            let parsedIndexFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: suffixToken.end))
            let parsedIndex: CompilerParsedExpression(maybeParsedIndex ?? parsedIndexFallback)
            let index: CompilerExpression(compilerParsedExpressionValue(parsed: parsedIndex))
            let maybeRightBracket: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: index.end))
            if maybeRightBracket == nil {
                return nil
            }
            let rightBracketToken: RangeLexedToken(maybeRightBracket ?? fallbackToken)
            if rightBracketToken.kind != String("rightBracket") {
                return nil
            }
            kind: String("index")
            value: index.value
            summary: "index(\(summary),\(index.summary))"
            expressionEnd: rightBracketToken.end
            record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: expressionEnd)
            if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
            syntaxID: 0 - 1
            suffixCursor: CompilerTokenCursor(source: source, index: rightBracketToken.end)
        } else {
            let stoppedPostfixExpression: CompilerExpression(CompilerExpression(kind: kind, value: value, summary: summary, record: record, start: token.start, end: expressionEnd))
            return CompilerParsedExpression(expression: stoppedPostfixExpression, syntaxID: syntaxID)
        }
    }

    let finalPostfixExpression: CompilerExpression(CompilerExpression(kind: kind, value: value, summary: summary, record: record, start: token.start, end: expressionEnd))
    return CompilerParsedExpression(expression: finalPostfixExpression, syntaxID: syntaxID)
}
