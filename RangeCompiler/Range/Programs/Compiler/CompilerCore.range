        arenaDestroys: intBufferElement(buffer: reachability.counters, index: compilerReachableLLMArenaDestroys()),
        recordBytes: intBufferElement(buffer: reachability.counters, index: compilerReachableLLMRecordBytes()),
        committedFailures: intBufferElement(buffer: reachability.counters, index: compilerReachableLLMCommittedFailures())
