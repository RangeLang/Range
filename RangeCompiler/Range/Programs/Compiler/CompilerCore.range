    let typedIRTypeIdentitySecond: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 12))
    let typedIRTypeName: String("%Range.Fixed.\(compilerTypedIRIdentityText(value: typedIRTypeIdentityFirst)).\(compilerTypedIRIdentityText(value: typedIRTypeIdentitySecond))")
    let typedIRFunctionName: String("@range_fn_\(compilerTypedIRIdentityText(value: compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 1)))_\(compilerTypedIRIdentityText(value: compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 2)))")
    let typedIRLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIRTypeNodeID))
    if typedIRLayoutRow < 0 || compilerIntTableValue(table: memory.layouts, row: typedIRLayoutRow, column: 1) <= 0 { return compilerNativeDiagnostic(kind: String("unsupportedTypedIRLLVMLayout")) }
    if compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 3) < 0 {
        return compilerTypedIRFixedLLVMRenderReturned(tables: tables, memory: memory, ir: ir, entryNodeID: typedIREntryNodeID, typeName: typedIRTypeName, layoutRow: typedIRLayoutRow)
