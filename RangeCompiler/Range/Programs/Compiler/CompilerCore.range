function compilerCoreLoweredDirectIfBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredAfterBlock: CompilerLLVMLoweredBlock, renderedBlocks: String, instructionRecords: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, functionSummary: program.functionSummary, renderedBlocks: renderedBlocks, instructionRecords: instructionRecords, localValues: loweredAfterBlock.localValues, nextTemporary: loweredAfterBlock.nextTemporary, nextBranchIndex: loweredAfterBlock.nextBranchIndex, exitLabel: loweredAfterBlock.exitLabel, hasEntryBranch: true, entryBranchCondition: loweredCondition.operand, entryBranchThenLabel: thenLabel, entryBranchElseLabel: afterLabel, hasReturn: loweredAfterBlock.hasReturn, returnLLVMType: loweredAfterBlock.returnLLVMType, returnLLVMValue: loweredAfterBlock.returnLLVMValue)
