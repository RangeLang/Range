    let typedIRSecondInsertOrdinal: Int(compilerIntTableValue(table: ir.operations, row: typedIRSecondInsertRow, column: 5))
    let typedIRFirstInsertValue: Int(compilerIntTableValue(table: ir.operations, row: typedIRFirstInsertRow, column: 6))
    let typedIRSecondInsertValue: Int(compilerIntTableValue(table: ir.operations, row: typedIRSecondInsertRow, column: 6))
    let typedIRAlignment: Int(compilerIntTableValue(table: memory.layouts, row: typedIRLayoutRow, column: 3))
    let typedIRLLVMNewline: String(compilerCoreNewlineCharacter())
    return "\(typedIRTypeName) = type { i32, i32 }\(typedIRLLVMNewline)\(typedIRLLVMNewline)define i32 \(typedIRFunctionName)(\(typedIRTypeName) %argument) {\(typedIRLLVMNewline)entry:\(typedIRLLVMNewline)  %value\(typedIRFirstReadNodeID) = extractvalue \(typedIRTypeName) %argument, \(typedIRFirstFieldOrdinal)\(typedIRLLVMNewline)  %value\(typedIRSecondReadNodeID) = extractvalue \(typedIRTypeName) %argument, \(typedIRSecondFieldOrdinal)\(typedIRLLVMNewline)  %value\(typedIRAddNodeID) = add i32 %value\(typedIRFirstReadNodeID), %value\(typedIRSecondReadNodeID)\(typedIRLLVMNewline)  ret i32 %value\(typedIRAddNodeID)\(typedIRLLVMNewline)}\(typedIRLLVMNewline)\(typedIRLLVMNewline)define i32 @main() {\(typedIRLLVMNewline)entry:\(typedIRLLVMNewline)  %storage0 = alloca \(typedIRTypeName), align \(typedIRAlignment)\(typedIRLLVMNewline)  %aggregate0 = insertvalue \(typedIRTypeName) poison, i32 \(typedIRFirstInsertValue), \(typedIRFirstInsertOrdinal)\(typedIRLLVMNewline)  %aggregate1 = insertvalue \(typedIRTypeName) %aggregate0, i32 \(typedIRSecondInsertValue), \(typedIRSecondInsertOrdinal)\(typedIRLLVMNewline)  store \(typedIRTypeName) %aggregate1, ptr %storage0, align \(typedIRAlignment)\(typedIRLLVMNewline)  %borrow0 = load \(typedIRTypeName), ptr %storage0, align \(typedIRAlignment)\(typedIRLLVMNewline)  %value\(typedIRCallNodeID) = call i32 \(typedIRFunctionName)(\(typedIRTypeName) %borrow0)\(typedIRLLVMNewline)  ret i32 %value\(typedIRCallNodeID)\(typedIRLLVMNewline)}\(typedIRLLVMNewline)"
}

function compilerTypedIRProofCandidate(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Bool {
    state typedIRCandidateConstructCount: Int(0)
    state typedIRCandidateNodeID: Int(0)
    let typedIRCandidateNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while typedIRCandidateNodeID < typedIRCandidateNodeCount {
        let typedIRCandidateNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: typedIRCandidateNodeID, column: 1))
        if typedIRCandidateNodeKind == compilerSyntaxKindConstruct() { typedIRCandidateConstructCount: typedIRCandidateConstructCount + 1 }
        typedIRCandidateNodeID: typedIRCandidateNodeID + 1
    }
    return typedIRCandidateConstructCount > 0
}

function compilerTypedIRFixedLLVMTextWithPolicy(source: String, unsupportedIsEmpty: Bool): String {
    let typedIRLLVMTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let typedIRLLVMCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: typedIRLLVMTables))
    let typedIRLLVMDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let typedIRLLVMSemantics: CompilerSemanticGraph(compilerSemanticGraphCreate())
    let typedIRLLVMMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    let typedIRLLVMGraph: CompilerTypedIR(compilerTypedIRCreate())
    state typedIRLLVMText: String("")
    if typedIRLLVMCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: typedIRLLVMTables) {
        if unsupportedIsEmpty {
            typedIRLLVMText: String("")
        } else {
            typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidTypedSyntaxSnapshot"))
        }
    } else if compilerPlotterBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta) != 0 || !compilerGraphDeltaIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidGraphDelta"))
    } else if compilerSemanticBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) != 0 || !compilerSemanticGraphIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) {
        if unsupportedIsEmpty {
            typedIRLLVMText: String("")
        } else {
            typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidSemanticGraph"))
        }
    } else if unsupportedIsEmpty && !compilerTypedIRProofCandidate(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) {
        typedIRLLVMText: String("")
    } else if compilerMemoryBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory) != 0 || !compilerMemoryGraphIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidMemoryGraph"))
    } else if compilerTypedIRBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph) != 0 || !compilerTypedIRIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidTypedIR"))
    } else {
        typedIRLLVMText: compilerTypedIRFixedLLVMRender(tables: typedIRLLVMTables, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph)
    }
    let typedIRLLVMGraphDestroyStatus: Int(compilerTypedIRDestroy(ir: typedIRLLVMGraph))
    let typedIRLLVMMemoryDestroyStatus: Int(compilerMemoryGraphDestroy(memory: typedIRLLVMMemory))
    let typedIRLLVMSemanticsDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: typedIRLLVMSemantics))
    let typedIRLLVMDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: typedIRLLVMDelta))
    let typedIRLLVMTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: typedIRLLVMTables))
    if typedIRLLVMGraphDestroyStatus != 0 || typedIRLLVMMemoryDestroyStatus != 0 || typedIRLLVMSemanticsDestroyStatus != 0 || typedIRLLVMDeltaDestroyStatus != 0 || typedIRLLVMTablesDestroyStatus != 0 {
        return compilerNativeDiagnostic(kind: String("typedIRLLVMOwnershipFailure"))
    }
    return typedIRLLVMText
}

function compilerTypedIRFixedLLVMText(source: String): String {
    return compilerTypedIRFixedLLVMTextWithPolicy(source: source, unsupportedIsEmpty: false)
}

function compilerTypedIRFixedLLVMIfSupported(source: String): String {
    return compilerTypedIRFixedLLVMTextWithPolicy(source: source, unsupportedIsEmpty: true)
}

function compilerTypedSyntaxLocalText(tables: CompilerSyntaxTables, fileID: Int, localStart: Int, localEnd: Int): String {
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localStart))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localEnd))
    if globalStart < 0 || globalEnd < globalStart {
        return String("")
    }
    return tables.sourceStore.source.substring(start: globalStart, end: globalEnd)
}

function compilerTypedSyntaxRenderRawTable(name: String, table: CompilerIntTable): String {
    let rawOutputBuffer: TextBuffer(textBufferCreate(capacity: 2048))
    let rawTab: String(compilerCoreTabCharacter())
    let rawNewline: String(compilerCoreNewlineCharacter())
    let rawRowCount: Int(compilerIntTableRowCount(table: table))
    textBufferAppend(buffer: rawOutputBuffer, text: "typedTable\(rawTab)name=\(name)\(rawTab)version=1\(rawTab)columns=\(table.columnCount)\(rawTab)rows=\(rawRowCount)\(rawNewline)")
    state rawRow: Int(0)
    while rawRow < rawRowCount {
        textBufferAppend(buffer: rawOutputBuffer, text: "\(name)\(rawTab)row=\(rawRow)\(rawTab)values=")
        state rawColumn: Int(0)
        while rawColumn < table.columnCount {
            if rawColumn > 0 { textBufferAppend(buffer: rawOutputBuffer, text: String(",")) }
            textBufferAppend(buffer: rawOutputBuffer, text: "\(compilerIntTableValue(table: table, row: rawRow, column: rawColumn))")
            rawColumn: rawColumn + 1
        }
        textBufferAppend(buffer: rawOutputBuffer, text: rawNewline)
        rawRow: rawRow + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: rawOutputBuffer)
}

function compilerTypedSyntaxRenderSnapshot(tables: CompilerSyntaxTables): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 8192))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    let memberCount: Int(compilerIntTableRowCount(table: tables.members))
    let functionCount: Int(compilerIntTableRowCount(table: tables.functions))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
    let bodyNodeCount: Int(compilerIntTableRowCount(table: tables.bodyNodes))
    let bodyEdgeCount: Int(compilerIntTableRowCount(table: tables.bodyEdges))
    textBufferAppend(buffer: outputBuffer, text: "typedSyntax\(tab)valid=true\(tab)identityScope=pathStable,pathlessSnapshotLocal\(tab)fileCount=\(compilerSourceStoreFileCount(store: tables.sourceStore))\(tab)syntaxCount=\(syntaxCount)\(tab)declarationCount=\(declarationCount)\(tab)memberCount=\(memberCount)\(tab)functionCount=\(functionCount)\(tab)parameterCount=\(parameterCount)\(tab)bodyNodeCount=\(bodyNodeCount)\(tab)bodyEdgeCount=\(bodyEdgeCount)\(newline)")

    state row: Int(0)
    while row < syntaxCount {
        let syntaxKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: row, column: 0))
        let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: row, column: 1))
        textBufferAppend(buffer: outputBuffer, text: "syntax\(tab)id=\(row)\(tab)kind=\(compilerSyntaxKindName(kindTag: syntaxKindTag))\(tab)facetRow=\(facetRow)\(newline)")
        row: row + 1
    }

    row: 0
    while row < declarationCount {
        let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 0))
        let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
        let declarationKindTag: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 2))
        let declarationOrdinal: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 4))
        let declarationStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 5))
        let declarationEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 6))
        let declarationNameStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 7))
        let declarationNameEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 8))
        let declarationBodyStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 9))
        let declarationBodyEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 10))
        let declarationFingerprintFirst: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 11))
        let declarationFingerprintSecond: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 12))
        let declarationLanguageABI: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 13))
        let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: declarationNameStart, localEnd: declarationNameEnd))
        textBufferAppend(buffer: outputBuffer, text: "declaration\(tab)row=\(row)\(tab)syntaxID=\(declarationSyntaxID)\(tab)fileID=\(declarationFileID)\(tab)kind=\(compilerSyntaxKindName(kindTag: declarationKindTag))\(tab)ordinal=\(declarationOrdinal)\(tab)start=\(declarationStart)\(tab)end=\(declarationEnd)\(tab)name=\(declarationName)\(tab)nameStart=\(declarationNameStart)\(tab)nameEnd=\(declarationNameEnd)\(tab)bodyStart=\(declarationBodyStart)\(tab)bodyEnd=\(declarationBodyEnd)\(tab)fingerprint=\(declarationFingerprintFirst):\(declarationFingerprintSecond)\(tab)languageABI=\(declarationLanguageABI)\(newline)")
        row: row + 1
    }

    row: 0
    while row < memberCount {
        let memberSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 0))
        let memberFileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 2))
        let memberOrdinal: Int(compilerIntTableValue(table: tables.members, row: row, column: 3))
        let memberStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 4))
        let memberEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 5))
        let memberNameStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 6))
        let memberNameEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 7))
        let memberTypeStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 8))
        let memberTypeEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 9))
        let memberFingerprintFirst: Int(compilerIntTableValue(table: tables.members, row: row, column: 10))
        let memberFingerprintSecond: Int(compilerIntTableValue(table: tables.members, row: row, column: 11))
        let memberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberNameStart, localEnd: memberNameEnd))
        let memberTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberTypeStart, localEnd: memberTypeEnd))
        textBufferAppend(buffer: outputBuffer, text: "member\(tab)row=\(row)\(tab)syntaxID=\(memberSyntaxID)\(tab)fileID=\(memberFileID)\(tab)parentSyntaxID=\(parentSyntaxID)\(tab)ordinal=\(memberOrdinal)\(tab)start=\(memberStart)\(tab)end=\(memberEnd)\(tab)name=\(memberName)\(tab)nameStart=\(memberNameStart)\(tab)nameEnd=\(memberNameEnd)\(tab)type=\(memberTypeName)\(tab)typeStart=\(memberTypeStart)\(tab)typeEnd=\(memberTypeEnd)\(tab)fingerprint=\(memberFingerprintFirst):\(memberFingerprintSecond)\(newline)")
        row: row + 1
    }

    row: 0
    while row < functionCount {
        let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 0))
        let functionFileID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 1))
        let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: row, column: 2))
        let childCount: Int(compilerIntTableValue(table: tables.functions, row: row, column: 3))
        let parameterStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 4))
        let parameterEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 5))
        let returnStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 6))
        let returnEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 7))
        let functionBodyStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 8))
        let functionBodyEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 9))
        let signatureFirst: Int(compilerIntTableValue(table: tables.functions, row: row, column: 10))
        let signatureSecond: Int(compilerIntTableValue(table: tables.functions, row: row, column: 11))
        textBufferAppend(buffer: outputBuffer, text: "function\(tab)row=\(row)\(tab)syntaxID=\(functionSyntaxID)\(tab)fileID=\(functionFileID)\(tab)firstParameterRow=\(firstParameterRow)\(tab)parameterCount=\(childCount)\(tab)parameterStart=\(parameterStart)\(tab)parameterEnd=\(parameterEnd)\(tab)returnStart=\(returnStart)\(tab)returnEnd=\(returnEnd)\(tab)bodyStart=\(functionBodyStart)\(tab)bodyEnd=\(functionBodyEnd)\(tab)signature=\(signatureFirst):\(signatureSecond)\(newline)")
        row: row + 1
    }

    row: 0
    while row < parameterCount {
        let parameterSyntaxID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 0))
        let parameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 1))
        let functionID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 2))
        let parameterOrdinal: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 3))
        let parameterValueStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 4))
        let parameterValueEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 5))
        let parameterNameStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 6))
        let parameterNameEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 7))
        let parameterTypeStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 8))
        let parameterTypeEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 9))
        let parameterFingerprintFirst: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 10))
        let parameterFingerprintSecond: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 11))
        let parameterName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: parameterNameStart, localEnd: parameterNameEnd))
        let parameterTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: parameterTypeStart, localEnd: parameterTypeEnd))
        textBufferAppend(buffer: outputBuffer, text: "parameter\(tab)row=\(row)\(tab)syntaxID=\(parameterSyntaxID)\(tab)fileID=\(parameterFileID)\(tab)functionID=\(functionID)\(tab)ordinal=\(parameterOrdinal)\(tab)start=\(parameterValueStart)\(tab)end=\(parameterValueEnd)\(tab)name=\(parameterName)\(tab)nameStart=\(parameterNameStart)\(tab)nameEnd=\(parameterNameEnd)\(tab)type=\(parameterTypeName)\(tab)typeStart=\(parameterTypeStart)\(tab)typeEnd=\(parameterTypeEnd)\(tab)fingerprint=\(parameterFingerprintFirst):\(parameterFingerprintSecond)\(newline)")
        row: row + 1
    }
    textBufferAppend(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("bodyNode"), table: tables.bodyNodes))
    textBufferAppend(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("bodyEdge"), table: tables.bodyEdges))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerTypedSyntaxSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: tables))
    let typedSyntaxTab: String(compilerCoreTabCharacter())
    let typedSyntaxNewline: String(compilerCoreNewlineCharacter())
    state summary: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        summary: "compilerError\(typedSyntaxTab)kind=invalidTypedSyntaxSnapshot\(typedSyntaxNewline)"
    } else {
        summary: compilerTypedSyntaxRenderSnapshot(tables: tables)
    }
    let destroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if destroyStatus != 0 {
        return "compilerError\(typedSyntaxTab)kind=typedSyntaxOwnershipFailure\(typedSyntaxNewline)"
    }
    return summary
}

function compilerSourceIdentitySummary(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return String("compilerError\tkind=invalidSourceFileTable\n")
    }

    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    textBufferAppend(buffer: outputBuffer, text: "sourceIdentity\(tab)fileCount=\(fileCount)\(newline)")
    state fileID: Int(0)
    while fileID < fileCount {
        let role: Int(compilerSourceStoreFileRole(store: store, fileID: fileID))
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart {
            path: source.substring(start: pathStart, end: pathEnd)
        }
        let mappedFileID: Int(compilerSourceStoreFileIDAtGlobalOffset(store: store, globalOffset: contentStart))
        let localOffset: Int(compilerSourceStoreFileLocalOffset(store: store, globalOffset: contentStart))
        textBufferAppend(buffer: outputBuffer, text: "sourceFile\(tab)id=\(fileID)\(tab)role=\(compilerSourceRoleName(role: role))\(tab)path=\(path)\(tab)pathStart=\(pathStart)\(tab)pathEnd=\(pathEnd)\(tab)contentStart=\(contentStart)\(tab)contentEnd=\(contentEnd)\(newline)")
        textBufferAppend(buffer: outputBuffer, text: "sourceMap\(tab)global=\(contentStart)\(tab)fileID=\(mappedFileID)\(tab)local=\(localOffset)\(newline)")
        fileID: fileID + 1
    }

    let summary: String(compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer))
    compilerSourceStoreDestroy(store: store)
    return summary
}

function compilerSourceInventorySummary(source: String): String {
    let files: String(compilerSourceInventoryFileRecords(source: source))
    let count: Int(compilerSourceInventoryFileCount(source: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    return "sourceInventory\(tab)program\(newline)\(files)sourceFileCount\(tab)\(count)\(newline)"
}

function compilerSourceInventoryFileRecords(source: String): String {
    return compilerSourceInventoryFileRecordsFromIndex(source: source, sourceIndex: 0, output: String(""), fileCount: 0)
}

function compilerSourceInventoryFileRecordsFromIndex(source: String, sourceIndex: Int, output: String, fileCount: Int): String {
    let sourceLength: Int(stringLength(value: source))
    let nextMarkerIndex: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if nextMarkerIndex >= sourceLength {
        return output
    }

    let nextOutput: String(compilerSourceInventoryFileRecordsAppending(output: output, source: source, sourceIndex: nextMarkerIndex, fileCount: fileCount))
    let nextSourceIndex: Int(compilerSourceNextIndexAfterFileMarker(source: source, sourceIndex: nextMarkerIndex))
    return compilerSourceInventoryFileRecordsFromIndex(source: source, sourceIndex: nextSourceIndex, output: nextOutput, fileCount: fileCount + 1)
}

function compilerSourceInventoryFileRecordsAppending(output: String, source: String, sourceIndex: Int, fileCount: Int): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))
    let pathStart: Int(sourceIndex + markerLength)
    let pathEnd: Int(compilerSourceFilePathEnd(source: source, start: pathStart))
    let path: String(source.substring(start: pathStart, end: pathEnd))
    return "\(output)sourceFile\(tab)index=\(fileCount)\(tab)path=\(path)\(newline)"
}

function compilerSourceInventoryFileCount(source: String): Int {
    return compilerSourceInventoryFileCountFromIndex(source: source, sourceIndex: 0, fileCount: 0)
}

function compilerSourceInventoryFileCountFromIndex(source: String, sourceIndex: Int, fileCount: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    let nextMarkerIndex: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if nextMarkerIndex >= sourceLength {
        return fileCount
    }

    let nextSourceIndex: Int(compilerSourceNextIndexAfterFileMarker(source: source, sourceIndex: nextMarkerIndex))
    return compilerSourceInventoryFileCountFromIndex(source: source, sourceIndex: nextSourceIndex, fileCount: fileCount + 1)
}

function compilerSourceNextIndexAfterFileMarker(source: String, sourceIndex: Int): Int {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))
    return compilerSourceFilePathEnd(source: source, start: sourceIndex + markerLength)
}

function compilerSourceFileMarker(): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    return "compilerSourceFile\(slash)t"
}

function compilerSourceFilePathEnd(source: String, start: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    let suffixIndex: Int(stringIndexOf(source: source, needle: String(".range"), start: start))
    if suffixIndex >= sourceLength {
        return sourceLength
    }
    return suffixIndex + 6
}

function compilerSourceSetASTSummary(source: String): String {
    state output: String("sourceSetAST\tprogram\n")
    state sourceIndex: Int(0)
    state fileCount: Int(0)
    let sourceLength: Int(stringLength(value: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: source, start: sourceIndex, prefix: marker) {
            let pathStart: Int(sourceIndex + markerLength)
            state pathEnd: Int(0)
            pathEnd: pathStart
            while pathEnd < sourceLength && source.character(index: pathEnd) > String(" ") {
                pathEnd: pathEnd + 1
            }

            let path: String(source.substring(start: pathStart, end: pathEnd))
            let fileStart: Int(pathEnd + 1)
            let nextFileMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
            let fileSource: String(source.substring(start: fileStart, end: nextFileMarker))
            let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
            output: "\(output)sourceFileAST\tindex=\(fileCount)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\tdeclarationSummaryLength=\(stringLength(value: fileProgram.declarationSummary))\n"
            output: "\(output)\(fileProgram.declarationSummary)"
            fileCount: fileCount + 1
            sourceIndex: nextFileMarker
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    output: "\(output)sourceFileASTCount\t\(fileCount)\n"
    return output
}

function compilerSourceSetTypesSummary(source: String): String {
    state output: String("sourceSetTypes\tprogram\n")
    state sourceIndex: Int(0)
    state fileCount: Int(0)
    let sourceLength: Int(stringLength(value: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: source, start: sourceIndex, prefix: marker) {
            let pathStart: Int(sourceIndex + markerLength)
            state pathEnd: Int(0)
            pathEnd: pathStart
            while pathEnd < sourceLength && source.character(index: pathEnd) > String(" ") {
                pathEnd: pathEnd + 1
            }

            let path: String(source.substring(start: pathStart, end: pathEnd))
            let fileStart: Int(pathEnd + 1)
            let nextFileMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
            let fileSource: String(source.substring(start: fileStart, end: nextFileMarker))
            let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
            let declarationTypeSummary: String(compilerCoreTopLevelFunctionSymbolAndTypeSummary(records: fileProgram.declarationRecords))
            output: "\(output)sourceFileTypes\tindex=\(fileCount)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\tdeclarationSummaryLength=\(stringLength(value: fileProgram.declarationSummary))\ttypeSummaryLength=\(stringLength(value: declarationTypeSummary))\n"
            output: "\(output)\(declarationTypeSummary)"
            if fileProgram.hasMainBlock {
                let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: fileProgram))
                output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: fileProgram.declarationRecords, statementRecords: parsedBlock.statementRecords, scopeName: String("main"), incomingLocals: String(""), expectedReturnType: String("Int")))"
            }
            fileCount: fileCount + 1
            sourceIndex: nextFileMarker
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    output: "\(output)sourceFileTypesCount\t\(fileCount)\n"
    return output
}

function compilerCoreTopLevelFunctionSymbolAndTypeSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        if declarationKind == String("function") {
            let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
            let declarationParameters: String(compilerCoreRecordField(record: record, prefix: String("parameters=")))
            let declarationReturnType: String(compilerCoreRecordField(record: record, prefix: String("returnType=")))
            output: "\(output)symbol\tkind=function\tname=\(declarationName)\tscope=program\tparameters=[\(declarationParameters)]\treturnType=\(declarationReturnType)\n"
            output: "\(output)type\tkind=function\tname=\(declarationName)\tscope=program\treturnType=\(declarationReturnType)\n"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function compilerSourceSetLLVMSummary(source: String): String {
    state output: String("sourceSetLLVM\tprogram\n")
    state sourceIndex: Int(0)
    state fileCount: Int(0)
    let sourceLength: Int(stringLength(value: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: source, start: sourceIndex, prefix: marker) {
            let pathStart: Int(sourceIndex + markerLength)
            state pathEnd: Int(0)
            pathEnd: pathStart
            while pathEnd < sourceLength && source.character(index: pathEnd) > String(" ") {
                pathEnd: pathEnd + 1
            }

            let path: String(source.substring(start: pathStart, end: pathEnd))
            let fileStart: Int(pathEnd + 1)
            let nextFileMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
            let fileSource: String(source.substring(start: fileStart, end: nextFileMarker))
            let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
            output: "\(output)sourceFileLLVM\tindex=\(fileCount)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\n"
            if fileProgram.hasMainBlock {
                output: "\(output)sourceFileLLVMText\tpath=\(path)\n"
            }
            fileCount: fileCount + 1
            sourceIndex: nextFileMarker
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    let combinedProgram: CompilerProgram(compilerSourceSetProgramForLLVM(source: source))
    output: "\(output)sourceSetLLVMProgram\thasMainBlock=\(combinedProgram.hasMainBlock)\n"
    output: "\(output)sourceFileLLVMCount\t\(fileCount)\n"
    return output
}

