                let priorBoundaryPathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn()), ordinal: compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn())))
                let sourcePathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: sourceBoundaryPathID, effectPaths: effectPaths, effectPathID: compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn())))
                let priorSourcePathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: priorBoundaryPathID, effectPaths: effectPaths, effectPathID: compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn())))
                let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
                let canonicalPriorSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: priorSourcePathID))
                if sourceBoundaryPathID < 0 || priorBoundaryPathID < 0 || sourcePathID < 0 || priorSourcePathID < 0
                    || canonicalSourcePathID < 0 || canonicalPriorSourcePathID < 0 || canonicalSourcePathID == canonicalPriorSourcePathID { return 0 - 1 }
            }
            priorLeafOffset: priorLeafOffset + 1
        }
        leafOffset: leafOffset + 1
    }
    leafOffset: 0
    while leafOffset < leafCount {
        let leafRow: Int(firstLeaf + leafOffset)
        let destinationLeafPathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: destinationRootPathID, effectPaths: effectPaths, effectPathID: compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafPathColumn())))
        let sourceKind: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourceKindColumn()))
        if destinationLeafPathID < 0 { return 0 - 1 }
        if sourceKind == compilerReachableFunctionInstanceReturnSourceLocalCreate() {
            if compilerBodyArenaOwnedPathSetOrigin(origins: origins, pathID: destinationLeafPathID, originPathID: compilerBodyOwnedOriginLocal()) != 0 { return 0 - 1 }
        } else if sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward() {
            let baseKind: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn()))
            let ordinal: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn()))
            let boundaryPathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
            let sourcePathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: boundaryPathID, effectPaths: effectPaths, effectPathID: compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn())))
            if sourcePathID < 0
                || compilerBodyArenaOwnedPathSetState(states: states, pathID: sourcePathID, stateValue: compilerBodyOwnedPathMoved()) != 0
                || compilerBodyArenaOwnedPathSetOrigin(origins: origins, pathID: destinationLeafPathID, originPathID: compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: sourcePathID)) != 0 { return 0 - 1 }
        }
        if compilerBodyArenaOwnedPathMarkLeafAndAncestorsLive(arena: arena, states: states, leafPathID: destinationLeafPathID) != 0 { return 0 - 1 }
