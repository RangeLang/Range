            }
            if compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionBorrow(), nodeID: memoryBorrowArgumentNodeID, storageID: memoryBorrowStorageID, typeNodeID: memoryBorrowTypeNodeID, value: compilerMemoryBorrowShared(), originNodeID: memoryBorrowValueNodeID) != 0 {
                return 0 - 1
            }
            }
        }
        memoryBorrowResolutionRow: memoryBorrowResolutionRow + 1
    }
    return 0
}

