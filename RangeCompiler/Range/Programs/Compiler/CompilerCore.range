        let memberName: String(compilerMacroExecutionLiteralForValue(arena: arena, valueID: nameValueID))
        let targetIsConstruct: Bool(targetSyntaxID >= 0 && targetSyntaxID < compilerIntTableRowCount(table: tables.syntaxIndex)
            && compilerIntTableValue(table: tables.syntaxIndex, row: targetSyntaxID, column: 0) == compilerSyntaxKindConstruct())
        let targetQueryOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
        if !targetIsConstruct || targetQueryOperandCount != 2 || memberName == String("") {
