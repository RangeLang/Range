        if compilerIntTableValue(table: delta.facts, row: memoryTerminalFactRow, column: 0) == compilerGraphFactOwns()
            && compilerIntTableValue(table: delta.facts, row: memoryTerminalFactRow, column: 1) == regionNodeID
            && compilerIntTableValue(table: delta.facts, row: memoryTerminalFactRow, column: 3) == compilerSyntaxRoleStatement() {
            let memoryTerminalCandidate: Int(compilerIntTableValue(table: delta.facts, row: memoryTerminalFactRow, column: 2))
            let memoryTerminalCandidateOrdinal: Int(compilerIntTableValue(table: delta.facts, row: memoryTerminalFactRow, column: 4))
            if compilerIntTableValue(table: delta.nodes, row: memoryTerminalCandidate, column: 1) == compilerSyntaxKindReturn()
                && memoryTerminalCandidateOrdinal > memoryTerminalOrdinal {
                memoryTerminalReturnNodeID: memoryTerminalCandidate
                memoryTerminalOrdinal: memoryTerminalCandidateOrdinal
