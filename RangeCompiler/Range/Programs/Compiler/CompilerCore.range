        if validationCode != 0 {
            failureStage: 8000 + validationCode
            valid: false
        } else { failureStage: 9 }
    }
    if valid {
        if !compilerBodyArenaEntryReturnsInt(arena: arena) {
            failureStage: 10
            valid: false
        }
    }
    state emission: CompilerBodyLLVMEmissionResult(CompilerBodyLLVMEmissionResult(block: failureBlock, renderedGlobals: String(""), runtimeRequirements: 0, isValid: false))
    if valid { emission: compilerBodyLLVMEmit(arena: arena, initialTemporary: initialTemporaryIndex, initialBranch: 0, abiPlan: abiPlan) }
    if valid && !emission.isValid {
        failureStage: 11
        valid: false
    }
    state loweredBlock: CompilerLLVMLoweredBlock(failureBlock)
    state renderedGlobals: String("")
    state runtimeRequirements: Int(0)
    if valid {
        loweredBlock: emission.block
        renderedGlobals: emission.renderedGlobals
        runtimeRequirements: emission.runtimeRequirements
    }
    let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if destroyStatus != 0 {
        valid: false
        failureStage: 12
    }
    if !valid {
        return CompilerTypedBodyLowering(block: failureBlock, renderedGlobals: String(""), runtimeRequirements: 0, telemetry: CompilerBodyTelemetry(supportedCount: 0, typedParseAttempts: 1, typedParseSuccesses: 0, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: 1), failureStage: failureStage, isValid: false)
    }
    return CompilerTypedBodyLowering(block: loweredBlock, renderedGlobals: renderedGlobals, runtimeRequirements: runtimeRequirements, telemetry: CompilerBodyTelemetry(supportedCount: 1, typedParseAttempts: 1, typedParseSuccesses: 1, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: 0), failureStage: 0, isValid: true)
}

function compilerCoreLLVMLowerHelperFunctionTypedObserved(context: CompilerLLVMLoweringContext, functionRow: Int, initialTemporaryIndex: Int, edgeOwners: IntBuffer, edgeTargets: IntBuffer, abiPlan: CompilerModuleABIPlan): CompilerTypedBodyLowering {
    if functionRow >= 0 {
        let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreate(tables: context.tables, index: context.declarationIndex, functionRow: functionRow)))
        let parsedArenaValid: Bool(compilerBodyArenaIsValid(arena: arena))
        if !parsedArenaValid {
            let rejectedDestroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
            let rejectedBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMTypedBodyFailureBlock(context: context, functionRow: functionRow, initialTemporaryIndex: initialTemporaryIndex))
            state rejectedFailureStage: Int(1)
            if rejectedDestroyStatus != 0 { rejectedFailureStage: 12 }
            return CompilerTypedBodyLowering(block: rejectedBlock, renderedGlobals: String(""), runtimeRequirements: 0, telemetry: CompilerBodyTelemetry(supportedCount: 0, typedParseAttempts: 1, typedParseSuccesses: 0, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: 1), failureStage: rejectedFailureStage, isValid: false)
        }
        state typedValid: Bool(true)
        state typedFailureStage: Int(0)
        if typedValid {
            if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: context.declarationIndex) != 0 {
                typedFailureStage: 2
                typedValid: false
            }
        }
        if typedValid {
            if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) {
                typedFailureStage: 3
                typedValid: false
            }
        }
        if typedValid {
            if compilerBodyArenaHasUnplannedRepresentationSensitiveCall(arena: arena, abiPlan: abiPlan) {
                typedFailureStage: 11
                typedValid: false
            }
        }
        if typedValid {
            if compilerBodyArenaBuildCFG(arena: arena) != 0 {
                typedFailureStage: 4
                typedValid: false
            }
        }
        if typedValid {
            if !compilerBodyArenaCFGIsValid(arena: arena) {
                typedFailureStage: 5
                typedValid: false
            }
        }
        if typedValid {
            let typedMemoryBuildStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: abiPlan))
            if typedMemoryBuildStatus != 0 {
                typedFailureStage: 6000 + typedMemoryBuildStatus
                typedValid: false
            }
        }
        if typedValid {
            if compilerBodyMIRBuild(arena: arena) != 0 {
                typedFailureStage: 7
                typedValid: false
            }
        }
        if typedValid {
            let typedMIRValidationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: abiPlan))
            if typedMIRValidationCode != 0 {
                typedFailureStage: 8000 + typedMIRValidationCode
                typedValid: false
            }
        }
        state emission: CompilerBodyLLVMEmissionResult(CompilerBodyLLVMEmissionResult(block: compilerCoreLLVMTypedBodyFailureBlock(context: context, functionRow: functionRow, initialTemporaryIndex: initialTemporaryIndex), renderedGlobals: String(""), runtimeRequirements: 0, isValid: false))
        if typedValid { emission: compilerBodyLLVMEmit(arena: arena, initialTemporary: initialTemporaryIndex, initialBranch: 0, abiPlan: abiPlan) }
        if typedValid && !emission.isValid {
            typedFailureStage: 9
            typedValid: false
        }
        if typedValid {
            if compilerBodyArenaAppendFunctionEdges(arena: arena, edgeOwners: edgeOwners, edgeTargets: edgeTargets) != 0 {
                typedFailureStage: 10
                typedValid: false
            }
        }
        if typedValid {
            if compilerBodyMIRAppendFunctionEdges(arena: arena, edgeOwners: edgeOwners, edgeTargets: edgeTargets) != 0 {
                typedFailureStage: 10
                typedValid: false
            }
        }
        if typedValid {
            state loweredArena: CompilerLLVMLoweredBlock(compilerCoreLLVMTypedBodyFailureBlock(context: context, functionRow: functionRow, initialTemporaryIndex: initialTemporaryIndex))
            state renderedGlobals: String("")
            state runtimeRequirements: Int(0)
            loweredArena: emission.block
            renderedGlobals: emission.renderedGlobals
            runtimeRequirements: emission.runtimeRequirements
            let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
            state destroyFailures: Int(0)
            if destroyStatus != 0 { destroyFailures: 1 }
            return CompilerTypedBodyLowering(block: loweredArena, renderedGlobals: renderedGlobals, runtimeRequirements: runtimeRequirements, telemetry: CompilerBodyTelemetry(supportedCount: 1, typedParseAttempts: 1, typedParseSuccesses: 1, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: destroyFailures), failureStage: 0, isValid: destroyStatus == 0)
        }
        let failedDestroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
        if failedDestroyStatus != 0 { typedFailureStage: 12 }
        let invalidBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMTypedBodyFailureBlock(context: context, functionRow: functionRow, initialTemporaryIndex: initialTemporaryIndex))
        return CompilerTypedBodyLowering(block: invalidBlock, renderedGlobals: String(""), runtimeRequirements: 0, telemetry: CompilerBodyTelemetry(supportedCount: 0, typedParseAttempts: 1, typedParseSuccesses: 0, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: 1), failureStage: typedFailureStage, isValid: false)
    }
    let unreachableBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMTypedBodyFailureBlock(context: context, functionRow: functionRow, initialTemporaryIndex: initialTemporaryIndex))
    return CompilerTypedBodyLowering(block: unreachableBlock, renderedGlobals: String(""), runtimeRequirements: 0, telemetry: CompilerBodyTelemetry(supportedCount: 0, typedParseAttempts: 0, typedParseSuccesses: 0, legacyParses: 0, arenaCreates: 0, arenaDestroys: 0, recordBytes: 0, committedFailures: 1), failureStage: 13, isValid: false)
}

function compilerCoreRenderLLVMHelperFunctionTyped(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, declarationRow: Int, functionRow: Int, block: CompilerLLVMLoweredBlock, abiPlan: CompilerModuleABIPlan): String {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    let functionBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    state llvmReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: returnType))
    if compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
        llvmReturnType: compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: returnType)
    }
    state parameterText: String(compilerCoreLLVMFunctionParameterTextPlanned(tables: tables, index: index, functionRow: functionRow, abiPlan: abiPlan))
    if compilerModuleABIPlanReturnMode(plan: abiPlan, tables: tables, index: index, functionRow: functionRow) == compilerFunctionReturnABIIndirect() {
        llvmReturnType: String("void")
        if parameterText == String("") { parameterText: String("ptr %returnDestination") } else { parameterText: "ptr %returnDestination, \(parameterText)" }
    }
    let llvmFunction: CompilerLLVMFunction(CompilerLLVMFunction(name: name, returnType: llvmReturnType, parameterText: parameterText, renderedBlocks: block.renderedBlocks, block: functionBlock))
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreAppendLLVMFunctionDeclarations(program: CompilerProgram, names: String, outputBuffer: TextBuffer): Int {
    state sourceIndex: Int(0)
    state declarationCount: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
        if record == String("") {
            return declarationCount
        }

        declarationCount: declarationCount + compilerCoreAppendLLVMFunctionDeclarationRecord(record: record, names: names, outputBuffer: outputBuffer)
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex)
    }

    return declarationCount
}

function compilerCoreAppendLLVMFunctionDeclarationRecord(record: String, names: String, outputBuffer: TextBuffer): Int {
    let kind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let name: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if kind != String("function") || compilerCoreNameListContains(names: names, name: name) {
        return 0
    }
    let returnType: String(compilerCoreRecordField(record: record, prefix: String("returnType=")))
    let parameters: String(compilerCoreRecordField(record: record, prefix: String("parameters=")))
    let declaration: String("declare \(compilerCoreLLVMTypeNameForRangeType(typeName: returnType)) @\(name)(\(compilerCoreLLVMFunctionParameterText(parameterSummary: parameters)))\n")
    textBufferAppend(buffer: outputBuffer, text: declaration)
    return 1
}

function compilerCoreLLVMLowerHelperFunction(program: CompilerProgram, declaration: CompilerTopLevelDeclaration, initialTemporaryIndex: Int): CompilerLLVMLoweredBlock {
    let functionBlock: CompilerBlock(CompilerBlock(start: declaration.bodyStart, end: declaration.bodyEnd))
    let statementRecords: String(compilerCoreFunctionDeclarationStatementRecords(program: program, declaration: declaration))
    let parsedFunctionBlock: CompilerParsedBlock(CompilerParsedBlock(block: functionBlock, statementRecords: statementRecords, statementSummary: String("")))
    let parameterLocals: String(compilerCoreLLVMFunctionParameterLocalValues(parameterSummary: declaration.parameterSummary))
    return compilerCoreLLVMLowerBlockWithLocalsForProgram(program: program, parsedBlock: parsedFunctionBlock, initialLocalValues: parameterLocals, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: declaration.returnType)
}

function compilerCoreRenderLLVMHelperFunction(declaration: CompilerTopLevelDeclaration, block: CompilerLLVMLoweredBlock): String {
    let functionBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    let llvmFunction: CompilerLLVMFunction(CompilerLLVMFunction(
        name: declaration.name,
        returnType: compilerCoreLLVMTypeNameForRangeType(typeName: declaration.returnType),
        parameterText: compilerCoreLLVMFunctionParameterText(parameterSummary: declaration.parameterSummary),
        renderedBlocks: block.renderedBlocks,
        block: functionBlock
    ))
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreRenderLLVMHelperFunctionDeclaration(declaration: CompilerTopLevelDeclaration): String {
    let llvmReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: declaration.returnType))
    return "declare \(llvmReturnType) @\(declaration.name)(\(compilerCoreLLVMFunctionParameterText(parameterSummary: declaration.parameterSummary)))\n"
}

function compilerCoreShouldLowerSelectedHelperFunction(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): Bool {
    return compilerCoreSelectedHelperExclusionReason(program: program, declaration: declaration) == String("")
}

function compilerCoreSelectedHelperExclusionReason(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): String {
    if declaration.statementRecords == String("") && !compilerCoreFunctionDeclarationHasBodySource(program: program, declaration: declaration) {
        return String("missingStatementRecords")
    }
    if !compilerCoreFunctionSignatureUsesOnlyLLVMPrimitiveTypes(declaration: declaration) {
        return String("unsupportedSignature")
    }
    return String("")
}

function compilerCoreFunctionDeclarationHasBodySource(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): Bool {
    return declaration.bodyStart >= 0 && declaration.bodyEnd >= declaration.bodyStart && declaration.bodyEnd < stringLength(value: program.source)
}

function compilerCoreFunctionSignatureUsesOnlyLLVMPrimitiveTypes(declaration: CompilerTopLevelDeclaration): Bool {
    if compilerCoreLLVMTypeNameForRangeType(typeName: declaration.returnType) == String("") {
        return false
    }

    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypes(parameterSummary: declaration.parameterSummary)
}

function compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypes(parameterSummary: String): Bool {
    let sourceLength: Int(stringLength(value: parameterSummary))
    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: parameterSummary, sourceIndex: 0, sourceLength: sourceLength)
}

function compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: String, sourceIndex: Int, sourceLength: Int): Bool {
    if sourceIndex >= sourceLength {
        return true
    }

    if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
        return compilerCoreFunctionParameterSummaryTypeMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, scanIndex: sourceIndex)
    }

    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: parameterSummary, sourceIndex: sourceIndex + 1, sourceLength: sourceLength)
}

function compilerCoreFunctionParameterSummaryTypeMarker(parameterSummary: String, sourceIndex: Int, sourceLength: Int, scanIndex: Int): Bool {
    if scanIndex >= sourceLength {
        return false
    }

    if hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(",type=")) {
        let typeStart: Int(scanIndex + 6)
        return compilerCoreFunctionParameterSummaryTypeEnd(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeStart)
    }

    return compilerCoreFunctionParameterSummaryTypeMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, scanIndex: scanIndex + 1)
}

function compilerCoreFunctionParameterSummaryTypeEnd(parameterSummary: String, sourceIndex: Int, sourceLength: Int, typeStart: Int, typeEnd: Int): Bool {
    if typeEnd >= sourceLength {
        return compilerCoreFunctionParameterSummaryCheckType(parameterSummary: parameterSummary, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeEnd)
    }

    if hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
        return compilerCoreFunctionParameterSummaryCheckType(parameterSummary: parameterSummary, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeEnd)
    }

    return compilerCoreFunctionParameterSummaryTypeEnd(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, typeStart: typeStart, typeEnd: typeEnd + 1)
}

function compilerCoreFunctionParameterSummaryCheckType(parameterSummary: String, sourceLength: Int, typeStart: Int, typeEnd: Int): Bool {
    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
    if compilerCoreLLVMTypeNameForRangeType(typeName: parameterType) == String("") {
        return false
    }

    return compilerCoreFunctionParameterSummaryUsesOnlyLLVMPrimitiveTypesFromIndex(parameterSummary: parameterSummary, sourceIndex: typeEnd, sourceLength: sourceLength)
}

function compilerCoreLLVMDefaultReturnValue(typeName: String): String {
    if typeName == String("ptr") {
        return String("null")
    }

    if typeName == String("i1") {
        return String("false")
    }

    return String("0")
}

function compilerCoreLLVMFunctionParameterText(parameterSummary: String): String {
    let sourceLength: Int(stringLength(value: parameterSummary))
    return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: 0, sourceLength: sourceLength, parameterOrdinal: 0, output: String(""))
}

function compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: String, sourceIndex: Int, sourceLength: Int, parameterOrdinal: Int, output: String): String {
    if sourceIndex >= sourceLength {
        return output
    }

    if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
        return compilerCoreLLVMFunctionParameterTextNameMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, scanIndex: sourceIndex + 9)
    }

    return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: sourceIndex + 1, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output)
}

function compilerCoreLLVMFunctionParameterTextNameMarker(parameterSummary: String, sourceIndex: Int, sourceLength: Int, parameterOrdinal: Int, output: String, scanIndex: Int): String {
    if scanIndex >= sourceLength {
        return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: scanIndex, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output)
    }

    if hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
        let nameStart: Int(scanIndex + 6)
        return compilerCoreLLVMFunctionParameterTextNameEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameStart)
    }

    return compilerCoreLLVMFunctionParameterTextNameMarker(parameterSummary: parameterSummary, sourceIndex: sourceIndex, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, scanIndex: scanIndex + 1)
}

function compilerCoreLLVMFunctionParameterTextNameEnd(parameterSummary: String, sourceLength: Int, parameterOrdinal: Int, output: String, nameStart: Int, nameEnd: Int): String {
    if nameEnd >= sourceLength {
        return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: nameEnd, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output)
    }

    if hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
        let typeStart: Int(nameEnd + 6)
        return compilerCoreLLVMFunctionParameterTextTypeEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeStart)
    }

    return compilerCoreLLVMFunctionParameterTextNameEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd + 1)
}

function compilerCoreLLVMFunctionParameterTextTypeEnd(parameterSummary: String, sourceLength: Int, parameterOrdinal: Int, output: String, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): String {
    if typeEnd >= sourceLength {
        return compilerCoreLLVMFunctionParameterTextAppend(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd)
    }

    if hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
        return compilerCoreLLVMFunctionParameterTextAppend(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd)
    }

    return compilerCoreLLVMFunctionParameterTextTypeEnd(parameterSummary: parameterSummary, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal, output: output, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd + 1)
}

function compilerCoreLLVMFunctionParameterTextAppend(parameterSummary: String, sourceLength: Int, parameterOrdinal: Int, output: String, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): String {
    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
    let parameterText: String("\(compilerCoreLLVMTypeNameForRangeType(typeName: parameterType)) %\(parameterName)")
    if parameterOrdinal == 0 {
        return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: typeEnd, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal + 1, output: parameterText)
    }

    return compilerCoreLLVMFunctionParameterTextFromIndex(parameterSummary: parameterSummary, sourceIndex: typeEnd, sourceLength: sourceLength, parameterOrdinal: parameterOrdinal + 1, output: "\(output), \(parameterText)")
}

function compilerCoreLLVMFunctionParameterLocalValues(parameterSummary: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: parameterSummary))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
            let indexStart: Int(sourceIndex + 9)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
                    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
                    output: "\(output)\(compilerCoreLLVMLocalRecordWithRangeType(name: parameterName, operand: "%\(parameterName)", typeName: compilerCoreLLVMTypeNameForRangeType(typeName: parameterType), rangeTypeName: parameterType))"
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return output
}

function compilerCoreMainLLVMBasicBlock(block: CompilerLLVMLoweredBlock): CompilerLLVMBasicBlock {
    state instructionRecords: String("")
    instructionRecords: block.instructionRecords
    state terminal: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
    if block.hasEntryBranch {
        terminal: CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: block.entryBranchCondition, trueLabel: block.entryBranchThenLabel, falseLabel: block.entryBranchElseLabel)
    } else if block.hasReturn {
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    }

    if !block.hasReturn && !block.hasEntryBranch {
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    }

    return CompilerLLVMBasicBlock(
        name: String("entry"),
        instructionRecords: instructionRecords,
        terminal: terminal
    )
}

function compilerCoreRenderLLVMModule(module: CompilerLLVMModule): String {
    let globalText: String(compilerCoreRenderLLVMGlobalRecords(records: module.instructionRecords))
    let runtimeDeclarations: String(compilerCoreRenderLLVMRuntimeDeclarations(records: module.instructionRecords, renderedFunctions: module.helperFunctions))
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    textBufferAppend(buffer: outputBuffer, text: globalText)
    textBufferAppend(buffer: outputBuffer, text: runtimeDeclarations)
    textBufferAppend(buffer: outputBuffer, text: module.helperFunctions)
    textBufferAppend(buffer: outputBuffer, text: compilerCoreRenderLLVMFunction(llvmFunction: module.mainFunction))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMFunction(llvmFunction: CompilerLLVMFunction): String {
    if llvmFunction.renderedBlocks != String("") {
        return "define \(llvmFunction.returnType) @\(llvmFunction.name)(\(llvmFunction.parameterText)) {\n\(llvmFunction.renderedBlocks)}\n"
    }

    let blockText: String(compilerCoreRenderLLVMBasicBlock(block: llvmFunction.block))
    return "define \(llvmFunction.returnType) @\(llvmFunction.name)(\(llvmFunction.parameterText)) {\n\(blockText)}\n"
}

function compilerCoreRenderLLVMBasicBlock(block: CompilerLLVMBasicBlock): String {
    let instructionsText: String(compilerCoreRenderLLVMInstructionRecords(records: block.instructionRecords))
    let terminalText: String(compilerCoreRenderLLVMTerminator(terminal: block.terminal))
    return "\(block.name):\n\(instructionsText)  \(terminalText)\n"
}

function compilerCoreRenderLLVMNamedBlock(label: String, instructionRecords: String, terminal: CompilerLLVMTerminator): String {
    let instructionsText: String(compilerCoreRenderLLVMInstructionRecords(records: instructionRecords))
    let terminalText: String(compilerCoreRenderLLVMTerminator(terminal: terminal))
    return "\(label):\n\(instructionsText)  \(terminalText)\n"
}

function compilerCoreRenderLLVMInstructionRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    state recordsLength: Int(0)
    recordsLength: stringLength(value: records)

    while sourceIndex < recordsLength {
        state lineEnd: Int(0)
        lineEnd: sourceIndex
        while lineEnd < recordsLength && records.substring(start: lineEnd, end: lineEnd + 1) != String(";") {
            lineEnd: lineEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: lineEnd))
        if record != String("") {
            let rendered: String(compilerCoreRenderLLVMInstructionRecord(record: record))
            if rendered != String("") {
                textBufferAppend(buffer: outputBuffer, text: "  \(rendered)\n")
            }
        }

        sourceIndex: lineEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMInstructionRecord(record: String): String {
    if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
        return String("")
    }
    if hasRangePrefix(source: record, start: 0, prefix: String("llvmPlaceholder|")) {
        let encodedReason: String(compilerCoreRecordField(record: record, prefix: String("reason=")))
        let reason: String(compilerCoreStatementRecordDecodeValue(value: encodedReason))
        return "; RANGE_LOWERING_PLACEHOLDER \(reason)"
    }

    let result: String(compilerCoreRecordField(record: record, prefix: String("result=")))
    let operation: String(compilerCoreRecordField(record: record, prefix: String("op=")))
    let typeName: String(compilerCoreRecordField(record: record, prefix: String("type=")))
    let left: String(compilerCoreRecordField(record: record, prefix: String("left=")))
    let right: String(compilerCoreRecordField(record: record, prefix: String("right=")))
    if result == String("") && operation == String("") {
        return String("")
    }

    if operation == String("call") {
        return "\(result) = call \(typeName) @\(left)(\(right))"
    }

    if operation == String("puts") {
        return "\(result) = call i32 @puts(ptr \(left))"
    }

    if operation == String("phi") {
        return "\(result) = phi \(typeName) \(left), \(right)"
    }

    return "\(result) = \(operation) \(typeName) \(left), \(right)"
}

function compilerCoreRenderLLVMGlobalRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        state recordEnd: Int(0)
        recordEnd: sourceIndex
        while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
            recordEnd: recordEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: recordEnd))
        if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
            let name: String(compilerCoreRecordField(record: record, prefix: String("name=")))
            let byteCount: String(compilerCoreRecordField(record: record, prefix: String("bytes=")))
            let text: String(compilerCoreRecordField(record: record, prefix: String("text=")))
            let renderedText: String(compilerCoreLLVMGlobalStringRenderedText(text: text))
            textBufferAppend(buffer: outputBuffer, text: "@\(name) = private unnamed_addr constant [\(byteCount) x i8] c\"\(renderedText)\\00\"\n")
        }

        sourceIndex: recordEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMGlobalRecords(records: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        state recordEnd: Int(0)
        recordEnd: sourceIndex
        while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
            recordEnd: recordEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: recordEnd))
        if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
            textBufferAppend(buffer: outputBuffer, text: "\(record);")
        }

        sourceIndex: recordEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreTextBufferMaterializeAndDestroy(buffer: TextBuffer): String {
    let text: String(textBufferMaterialize(buffer: buffer))
    textBufferDestroy(buffer: buffer)
    return text
}

function compilerCoreTextBufferConcat(left: String, right: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    if textBufferAppend(buffer: outputBuffer, text: left) != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: right) != 0 { return String("") }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMRuntimeDeclarations(records: String, renderedFunctions: String): String {
    let baseDeclarations: String("declare i32 @puts(ptr)\ndeclare i32 @stringLength(ptr)\ndeclare i32 @stringIndexOf(ptr, ptr, i32)\ndeclare i32 @stringEqual(ptr, ptr)\ndeclare i32 @stringCompare(ptr, ptr)\ndeclare i1 @stringHasPrefix(ptr, i32, ptr)\ndeclare i32 @stringFindFrom(ptr, i32, ptr)\ndeclare i32 @stringFindFirstOf(ptr, i32, ptr)\ndeclare ptr @stringViewFrom(ptr, i32)\ndeclare ptr @stringSliceUnchecked(ptr, i32, i32)\ndeclare ptr @stringCharacterAt(ptr, i32)\ndeclare i32 @stringByteAt(ptr, i32)\ndeclare i32 @stringFindByteOf(ptr, i32, i32, i32, i32)\ndeclare i32 @stringTransientRegionMark()\ndeclare i32 @stringTransientRegionReset(i32)\ndeclare ptr @commandLineArgument(i32)\ndeclare i32 @commandLineArgumentCount()\ndeclare ptr @readFile(ptr)\ndeclare ptr @stringCharacter(ptr, i32)\ndeclare ptr @stringSubstring(ptr, i32, i32)\ndeclare ptr @stringConcat(ptr, ptr)\ndeclare ptr @stringFromInt(i32)\ndeclare ptr @stringFromBool(i1)\ndeclare ptr @textBufferCreate(i32)\ndeclare i32 @textBufferAppend(ptr, ptr)\ndeclare i32 @textBufferAppendInt(ptr, i32)\ndeclare i32 @textBufferAppendCharacter(ptr, ptr, i32)\ndeclare ptr @textBufferMaterialize(ptr)\ndeclare i32 @textBufferDestroy(ptr)\n")
    let dynamicConstructDeclarations: String(compilerCoreRenderLLVMDynamicConstructDeclarations(records: records, renderedFunctions: renderedFunctions))
    let metricsDeclarations: String(compilerCoreLLVMRuntimeMetricsDeclarations(records: records, renderedFunctions: renderedFunctions))
    if compilerCoreLLVMRecordsUseIntBuffer(records: records, renderedFunctions: renderedFunctions) {
        return "\(baseDeclarations)\(dynamicConstructDeclarations)\(metricsDeclarations)declare ptr @intBufferCreate(i32)\ndeclare i32 @intBufferAppend(ptr, i32)\ndeclare i32 @intBufferCount(ptr)\ndeclare i32 @intBufferElement(ptr, i32)\ndeclare i32 @intBufferSet(ptr, i32, i32)\ndeclare i32 @intBufferDestroy(ptr)\n\n"
    }
    return "\(baseDeclarations)\(dynamicConstructDeclarations)\(metricsDeclarations)\n"
}

function compilerCoreRenderLLVMDynamicConstructDeclarations(records: String, renderedFunctions: String): String {
    if compilerCoreRecordContains(record: renderedFunctions, text: String("@rangeConstruct"))
        || compilerCoreRecordContains(record: records, text: String("rangeConstruct")) {
        return String("declare ptr @rangeConstructCreate(ptr)\ndeclare ptr @rangeConstructSetPtr(ptr, ptr, ptr)\ndeclare ptr @rangeConstructSetInt(ptr, ptr, i32)\ndeclare ptr @rangeConstructSetBool(ptr, ptr, i1)\ndeclare ptr @rangeConstructGetPtr(ptr, ptr)\ndeclare i32 @rangeConstructGetInt(ptr, ptr)\ndeclare i1 @rangeConstructGetBool(ptr, ptr)\n")
    }
    return String("")
}

function compilerCoreRenderLLVMRuntimeDeclarationsTyped(records: String, renderedFunctions: String, runtimeRequirements: Int): String {
    if runtimeRequirements < 0 || runtimeRequirements > compilerBodyLLVMRuntimeStringCompare() { return String("") }
    return compilerCoreRenderLLVMRuntimeDeclarations(records: records, renderedFunctions: renderedFunctions)
}

function compilerCoreLLVMRuntimeMetricsDeclarations(records: String, renderedFunctions: String): String {
    if !compilerCoreRecordContains(record: renderedFunctions, text: String("@compilerMetrics"))
        && !compilerCoreRecordContains(record: records, text: String("@compilerMetrics")) { return String("") }
    return "declare i32 @compilerMetricsReset()\ndeclare i32 @compilerMetricsSetEnabled(i1)\ndeclare i32 @compilerMetricsFunctionBegin(i32, ptr)\ndeclare i32 @compilerMetricsFunctionEnd(i32, i32)\ndeclare ptr @compilerMetricsReport()\n"
}

function compilerCoreLLVMRecordsUseIntBuffer(records: String, renderedFunctions: String): Bool {
    if compilerCoreRecordContains(record: renderedFunctions, text: String("@intBuffer")) {
        return true
    }
    return compilerCoreLLVMRecordsContainCall(records: records, name: String("intBufferCreate"))
        || compilerCoreLLVMRecordsContainCall(records: records, name: String("intBufferAppend"))
        || compilerCoreLLVMRecordsContainCall(records: records, name: String("intBufferCount"))
        || compilerCoreLLVMRecordsContainCall(records: records, name: String("intBufferElement"))
        || compilerCoreLLVMRecordsContainCall(records: records, name: String("intBufferSet"))
        || compilerCoreLLVMRecordsContainCall(records: records, name: String("intBufferDestroy"))
}

function compilerCoreLLVMRecordsContainOperation(records: String, operation: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    let operationField: String("op=\(operation)")

    while sourceIndex < recordsLength {
        if hasRangePrefix(source: records, start: sourceIndex, prefix: operationField) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreLLVMRecordsContainCall(records: String, name: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    let callField: String("op=call|type=")
    let nameField: String("|left=\(name)|")

    while sourceIndex < recordsLength {
        if hasRangePrefix(source: records, start: sourceIndex, prefix: callField) {
            state recordEnd: Int(0)
            recordEnd: sourceIndex
            while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
                recordEnd: recordEnd + 1
            }
            let record: String(records.substring(start: sourceIndex, end: recordEnd))
            if compilerCoreRecordContains(record: record, text: nameField) {
                return true
            }
            sourceIndex: recordEnd
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return false
}

function compilerCoreRecordContains(record: String, text: String): Bool {
    state sourceIndex: Int(0)
    let recordLength: Int(stringLength(value: record))

    while sourceIndex < recordLength {
        if hasRangePrefix(source: record, start: sourceIndex, prefix: text) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreRenderLLVMTerminator(terminal: CompilerLLVMTerminator): String {
    if terminal.kind == String("return") {
        return "ret \(terminal.typeName) \(terminal.value)"
    }

    if terminal.kind == String("branch") {
        return "br \(terminal.typeName) \(terminal.value), label %\(terminal.trueLabel), label %\(terminal.falseLabel)"
    }

    if terminal.kind == String("jump") {
        return "br label %\(terminal.trueLabel)"
    }

    return String("ret i32 0")
}

function compilerCoreRecordField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreExpressionRecord(kind: String, value: String, left: String, right: String, arguments: String, start: Int, end: Int): String {
    return "kind=\(kind)|value=\(compilerCoreStatementRecordEncodeValue(value: value))|left=\(compilerCoreStatementRecordEncodeValue(value: left))|right=\(compilerCoreStatementRecordEncodeValue(value: right))|arguments=\(compilerCoreStatementRecordEncodeValue(value: arguments))|start=\(start)|end=\(end)~"
}

function compilerCoreMissingExpression(start: Int): CompilerExpression {
    let record: String(compilerCoreExpressionRecord(kind: String("missing"), value: String(""), left: String(""), right: String(""), arguments: String(""), start: start, end: start))
    return CompilerExpression(kind: String("missing"), value: String(""), summary: String("missing"), record: record, start: start, end: start)
}

function compilerCoreMissingParsedExpression(start: Int): CompilerParsedExpression {
    return CompilerParsedExpression(expression: compilerCoreMissingExpression(start: start), syntaxID: 0 - 1)
}

function compilerParsedExpressionValue(parsed: CompilerParsedExpression): CompilerExpression {
    return parsed.expression
}

function compilerParsedExpressionSyntaxID(parsed: CompilerParsedExpression): Int {
    return parsed.syntaxID
}

function compilerCoreExpressionRecordField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreDelimitedRecordField(record: String, prefix: String): String {
    let prefixLength: Int(stringLength(value: prefix))
    let separators: String("|~")
    state fieldStart: Int(0)
    fieldStart: 0 - 1
    if stringHasPrefix(source: record, start: 0, prefix: prefix) {
        fieldStart: 0
    } else {
        state scanIndex: Int(0)
        while fieldStart < 0 {
            let separatorIndex: Int(stringFindFirstOf(source: record, start: scanIndex, characters: separators))
            if separatorIndex < 0 || stringHasPrefix(source: record, start: separatorIndex, prefix: String("~")) {
                return String("")
            }
            let candidateStart: Int(separatorIndex + 1)
            if stringHasPrefix(source: record, start: candidateStart, prefix: prefix) {
                fieldStart: candidateStart
            } else {
                scanIndex: candidateStart
            }
        }
    }
    let valueStart: Int(fieldStart + prefixLength)
    state valueEnd: Int(stringFindFirstOf(source: record, start: valueStart, characters: separators))
    if valueEnd < 0 {
        valueEnd: stringLength(value: record)
    }
    return stringSliceUnchecked(source: record, start: valueStart, end: valueEnd)
}

function compilerCoreExpressionRecordKind(record: String): String {
    return compilerCoreExpressionRecordField(record: record, prefix: String("kind="))
}

function compilerCoreExpressionRecordValue(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("value=")))
}

function compilerCoreExpressionRecordLeft(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("left=")))
}

function compilerCoreExpressionRecordRight(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("right=")))
}

function compilerCoreExpressionRecordArguments(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreExpressionRecordField(record: record, prefix: String("arguments=")))
}

function compilerCoreExpressionRecordSummary(record: String): String {
    if record == String("") {
        return String("")
    }

    let kind: String(compilerCoreExpressionRecordKind(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))

    if kind == String("missing") {
        return String("missing")
    }

    if kind == String("integerLiteral") {
        return "integerLiteral(\(value))"
    }

    if kind == String("stringLiteral") {
        return "stringLiteral(\(value))"
    }

    if kind == String("boolLiteral") {
        return "boolLiteral(\(value))"
    }

    if kind == String("identifier") {
        return "identifier(\(value))"
    }

    if kind == String("member") {
        let baseSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        return "member(\(baseSummary),\(value))"
    }

    if kind == String("prefix") {
        let operandSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        return "prefix(\(value),\(operandSummary))"
    }

    if kind == String("binary") {
        let leftSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        let rightSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordRight(record: record)))
        return "binary(\(leftSummary),\(value),\(rightSummary))"
    }

    if kind == String("call") {
        let calleeSummary: String(compilerCoreExpressionRecordSummary(record: compilerCoreExpressionRecordLeft(record: record)))
        let argumentSummary: String(compilerCoreCallArgumentRecordsSummary(records: compilerCoreExpressionRecordArguments(record: record)))
        return "call(\(calleeSummary),arguments=[\(argumentSummary)])"
    }

    return String("")
}

function compilerCoreCallArgumentRecordsSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    state argumentIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreCallArgumentRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let label: String(compilerCoreCallArgumentLabel(record: record))
        let expressionSummary: String(compilerCoreCallArgumentExpressionSummary(record: record))
        if label == String("") {
            output: "\(output)argument\(argumentIndex)=\(expressionSummary);"
        } else {
            output: "\(output)argument\(argumentIndex).\(label)=\(expressionSummary);"
        }
        argumentIndex: argumentIndex + 1
        sourceIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function compilerCoreCallArgumentRecord(index: Int, label: String, expressionRecord: String, expressionSummary: String): String {
    state storedSummary: String("")
    storedSummary: expressionSummary
    if expressionRecord != String("") {
        storedSummary: String("")
    }
    return "index=\(index)|label=\(compilerCoreStatementRecordEncodeValue(value: label))|expression=\(compilerCoreStatementRecordEncodeValue(value: expressionRecord))|summary=\(compilerCoreStatementRecordEncodeValue(value: storedSummary))~"
}

function compilerCoreCallArgumentRecordAt(records: String, start: Int): String {
    let recordsLength: Int(stringLength(value: records))
    state recordEnd: Int(0)
    recordEnd: start

    while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String("~") {
        recordEnd: recordEnd + 1
    }

    return records.substring(start: start, end: recordEnd)
}

function compilerCoreCallArgumentRecordNextIndex(records: String, start: Int): Int {
    let recordsLength: Int(stringLength(value: records))
    state sourceIndex: Int(0)
    sourceIndex: start

    while sourceIndex < recordsLength {
        if records.substring(start: sourceIndex, end: sourceIndex + 1) == String("~") {
            return sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    return recordsLength
}

function compilerCoreCallArgumentExpressionRecord(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreDelimitedRecordField(record: record, prefix: String("expression=")))
}

function compilerCoreCallArgumentLabel(record: String): String {
    return compilerCoreStatementRecordDecodeValue(value: compilerCoreDelimitedRecordField(record: record, prefix: String("label=")))
}

function compilerCoreCallArgumentExpressionSummary(record: String): String {
    let summary: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreDelimitedRecordField(record: record, prefix: String("summary="))))
    if summary != String("") {
        return summary
    }

    return compilerCoreExpressionRecordSummary(record: compilerCoreCallArgumentExpressionRecord(record: record))
}

function compilerCoreLLVMLowerIntegerExpression(context: CompilerLLVMLoweringContext, localValues: String, expressionSummary: String, expectedTypeName: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("integerLiteral(")) {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: compilerCoreWrappedExpressionValue(summary: expressionSummary, prefixLength: 15),
            typeName: String("i32"),
            nextTemporary: temporaryIndex
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("stringLiteral(")) {
        let literalText: String(compilerCoreStringLiteralText(summary: expressionSummary))
        let literalContent: String(compilerCoreStringLiteralContent(text: literalText))
        let literalContentLength: Int(stringLength(value: literalContent))
        let literalByteCount: Int(literalContentLength + 1)
        let literalGlobalName: String(".str.\(temporaryIndex)")
        let literalGlobalRecord: String(compilerCoreLLVMGlobalStringRecord(name: literalGlobalName, byteCount: literalByteCount, text: literalContent))
        return CompilerLLVMLoweredExpression(
            instructionRecords: literalGlobalRecord,
            operand: "getelementptr inbounds ([\(literalByteCount) x i8], ptr @\(literalGlobalName), i32 0, i32 0)",
            typeName: String("ptr"),
            nextTemporary: temporaryIndex + 1
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("boolLiteral(")) {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: compilerCoreWrappedExpressionValue(summary: expressionSummary, prefixLength: 12),
            typeName: String("i1"),
            nextTemporary: temporaryIndex
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("identifier(")) {
        let identifierName: String(compilerCoreWrappedExpressionValue(summary: expressionSummary, prefixLength: 11))
        if identifierName == String("nil") {
            return CompilerLLVMLoweredExpression(instructionRecords: String(""), operand: String("null"), typeName: String("ptr"), nextTemporary: temporaryIndex)
        }
        let identifierValue: String(compilerCoreLookupLLVMLocalOperand(localValues: localValues, name: identifierName))
        if identifierValue != String("") {
            let identifierType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: identifierName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: String(""),
                operand: identifierValue,
                typeName: identifierType,
                nextTemporary: temporaryIndex
            )
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: expressionSummary))
        let callArgumentSummary: String(compilerCoreCallArgumentsSummary(summary: expressionSummary))
        if functionName == String("String") || functionName == String("Int") || functionName == String("Bool") {
            let wrappedArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: callArgumentSummary, start: 0))
            return compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: wrappedArgumentExpression, expectedTypeName: functionName, temporaryIndex: temporaryIndex)
        }

        if functionName == String("print") {
            let printArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: callArgumentSummary, start: 0))
            let loweredPrintArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: printArgumentExpression, expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
            state printTemporaryIndex: Int(0)
            printTemporaryIndex: loweredPrintArgument.nextTemporary
            let printResultOperand: String("%r\(printTemporaryIndex)")
            let printInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: printResultOperand,
                operation: String("puts"),
                typeName: String("i32"),
                left: loweredPrintArgument.operand,
                right: String("")
            ))
            let printInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: printInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredPrintArgument.instructionRecords)\(printInstructionRecord)",
                operand: printResultOperand,
                typeName: String("i32"),
                nextTemporary: printTemporaryIndex + 1
            )
        }

        if compilerLLVMLoweringContextContainsConstruct(context: context, name: functionName) {
            let constructLLVMTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: functionName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "constructSummary:\(functionName)"),
                operand: compilerCoreLLVMDefaultReturnValue(typeName: constructLLVMTypeName),
                typeName: constructLLVMTypeName,
                nextTemporary: temporaryIndex
            )
        }

        if compilerCoreLLVMBuiltinFunctionReturnType(name: functionName) == String("") && !compilerLLVMLoweringContextContainsFunction(context: context, name: functionName) {
            let unresolvedCallTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unresolvedCall:\(functionName)"),
                operand: compilerCoreLLVMDefaultReturnValue(typeName: unresolvedCallTypeName),
                typeName: unresolvedCallTypeName,
                nextTemporary: temporaryIndex
            )
        }

        let loweredCallArguments: CompilerLLVMCallArguments(compilerCoreLLVMLowerIntegerCallArguments(context: context, localValues: localValues, argumentsSummary: callArgumentSummary, temporaryIndex: temporaryIndex))
        state callTemporaryIndex: Int(0)
        callTemporaryIndex: loweredCallArguments.nextTemporary
        let callResultOperand: String("%r\(callTemporaryIndex)")
        let callReturnType: String(compilerCoreLLVMCallReturnType(context: context, name: functionName, expectedTypeName: expectedTypeName))
        let callInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: callResultOperand,
            operation: String("call"),
            typeName: callReturnType,
            left: functionName,
            right: loweredCallArguments.renderedArguments
        ))
        let callInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: callInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredCallArguments.instructionRecords)\(callInstructionRecord)",
            operand: callResultOperand,
            typeName: callReturnType,
            nextTemporary: callTemporaryIndex + 1
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(member(")) {
        let memberCalleeSummary: String(compilerCoreCallCalleeSummary(summary: expressionSummary))
        let memberName: String(compilerCoreMemberExpressionName(summary: memberCalleeSummary))
        let memberBaseSummary: String(compilerCoreMemberExpressionBase(summary: memberCalleeSummary))
        let memberCallArgumentSummary: String(compilerCoreCallArgumentsSummary(summary: expressionSummary))
        let loweredSummaryMemberBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: memberBaseSummary, expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
        if memberName == String("character") {
            let summaryIndexArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: memberCallArgumentSummary, start: 0))
            let loweredSummaryIndexArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: summaryIndexArgumentExpression, expectedTypeName: String("Int"), temporaryIndex: loweredSummaryMemberBase.nextTemporary))
            let summaryMemberCallResultOperand: String("%r\(loweredSummaryIndexArgument.nextTemporary)")
            let summaryMemberCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: summaryMemberCallResultOperand,
                operation: String("call"),
                typeName: String("ptr"),
                left: String("stringCharacter"),
                right: "\(loweredSummaryMemberBase.typeName) \(loweredSummaryMemberBase.operand), \(loweredSummaryIndexArgument.typeName) \(loweredSummaryIndexArgument.operand)"
            ))
            let summaryMemberCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: summaryMemberCallInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredSummaryMemberBase.instructionRecords)\(loweredSummaryIndexArgument.instructionRecords)\(summaryMemberCallInstructionRecord)",
                operand: summaryMemberCallResultOperand,
                typeName: String("ptr"),
                nextTemporary: loweredSummaryIndexArgument.nextTemporary + 1
            )
        }

        if memberName == String("substring") {
            let summaryStartArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: memberCallArgumentSummary, start: 0))
            let loweredSummaryStartArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: summaryStartArgumentExpression, expectedTypeName: String("Int"), temporaryIndex: loweredSummaryMemberBase.nextTemporary))
            let summaryEndArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: memberCallArgumentSummary, start: compilerCoreCallArgumentNextIndex(argumentsSummary: memberCallArgumentSummary, start: 0)))
            let loweredSummaryEndArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: summaryEndArgumentExpression, expectedTypeName: String("Int"), temporaryIndex: loweredSummaryStartArgument.nextTemporary))
            let summarySubstringCallResultOperand: String("%r\(loweredSummaryEndArgument.nextTemporary)")
            let summarySubstringCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: summarySubstringCallResultOperand,
                operation: String("call"),
                typeName: String("ptr"),
                left: String("stringSubstring"),
                right: "\(loweredSummaryMemberBase.typeName) \(loweredSummaryMemberBase.operand), \(loweredSummaryStartArgument.typeName) \(loweredSummaryStartArgument.operand), \(loweredSummaryEndArgument.typeName) \(loweredSummaryEndArgument.operand)"
            ))
            let summarySubstringCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: summarySubstringCallInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredSummaryMemberBase.instructionRecords)\(loweredSummaryStartArgument.instructionRecords)\(loweredSummaryEndArgument.instructionRecords)\(summarySubstringCallInstructionRecord)",
                operand: summarySubstringCallResultOperand,
                typeName: String("ptr"),
                nextTemporary: loweredSummaryEndArgument.nextTemporary + 1
            )
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("member(")) {
        let constructMemberName: String(compilerCoreMemberExpressionName(summary: expressionSummary))
        let constructMemberBaseSummary: String(compilerCoreMemberExpressionBase(summary: expressionSummary))
        let loweredConstructMemberBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: constructMemberBaseSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
        let constructMemberBaseRangeType: String(compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: constructMemberBaseSummary, expectedType: String("")))
        state constructMemberRangeType: String("")
        constructMemberRangeType: compilerLLVMLoweringContextConstructMemberType(context: context, constructName: constructMemberBaseRangeType, memberName: constructMemberName)
        if constructMemberRangeType == String("") {
            constructMemberRangeType: expectedTypeName
        }
        if constructMemberRangeType != String("") {
            return compilerCoreLLVMLowerConstructMemberAccess(base: loweredConstructMemberBase, memberName: constructMemberName, memberType: constructMemberRangeType)
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("prefix(")) {
        let prefixOperatorText: String(compilerCorePrefixExpressionOperator(summary: expressionSummary))
        let operandSummary: String(compilerCorePrefixExpressionOperand(summary: expressionSummary))
        state prefixExpectedTypeName: String("")
        prefixExpectedTypeName: expectedTypeName
        if prefixOperatorText == String("!") {
            prefixExpectedTypeName: String("Bool")
        } else if prefixOperatorText == String("-") {
            prefixExpectedTypeName: String("Int")
        }
        let loweredOperand: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: operandSummary, expectedTypeName: prefixExpectedTypeName, temporaryIndex: temporaryIndex))
        let prefixResultOperand: String("%r\(loweredOperand.nextTemporary)")
        let prefixInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: prefixResultOperand,
            operation: compilerCoreLLVMInstructionForPrefixOperator(operatorText: prefixOperatorText),
            typeName: compilerCoreLLVMTypeForPrefixOperator(operatorText: prefixOperatorText, operandType: loweredOperand.typeName),
            left: compilerCoreLLVMLeftValueForPrefixOperator(operatorText: prefixOperatorText, operand: loweredOperand.operand),
            right: compilerCoreLLVMRightValueForPrefixOperator(operatorText: prefixOperatorText, operand: loweredOperand.operand)
        ))
        let prefixInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: prefixInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredOperand.instructionRecords)\(prefixInstructionRecord)",
            operand: prefixResultOperand,
            typeName: prefixInstruction.typeName,
            nextTemporary: loweredOperand.nextTemporary + 1
        )
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("binary(")) {
        let leftSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 0))
        let operatorText: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 1))
        let rightSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 2))
        if operatorText == String("??") || operatorText == String("questionQuestion") {
            let loweredOptional: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex))
            if loweredOptional.operand != String("0") || loweredOptional.typeName != String("i32") {
                return CompilerLLVMLoweredExpression(
                    instructionRecords: loweredOptional.instructionRecords,
                    operand: loweredOptional.operand,
                    typeName: loweredOptional.typeName,
                    nextTemporary: loweredOptional.nextTemporary
                )
            }

            let loweredFallback: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex))
            return CompilerLLVMLoweredExpression(
                instructionRecords: loweredFallback.instructionRecords,
                operand: loweredFallback.operand,
                typeName: loweredFallback.typeName,
                nextTemporary: loweredFallback.nextTemporary
            )
        }

        state initialLeftExpectedTypeName: String("")
        state initialRightExpectedTypeName: String("")
        if compilerCoreLLVMResultTypeForOperator(operatorText: operatorText) == String("i1") {
            initialLeftExpectedTypeName: compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: rightSummary, expectedType: String(""))
            initialRightExpectedTypeName: compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: leftSummary, expectedType: String(""))
        }
        let initialLoweredLeft: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: initialLeftExpectedTypeName, temporaryIndex: temporaryIndex))
        let initialLoweredRight: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: initialRightExpectedTypeName, temporaryIndex: initialLoweredLeft.nextTemporary))
        state loweredLeft: CompilerLLVMLoweredExpression(initialLoweredLeft)
        state loweredRight: CompilerLLVMLoweredExpression(initialLoweredRight)
        if compilerCoreLLVMResultTypeForOperator(operatorText: operatorText) == String("i1") && initialLoweredLeft.typeName != initialLoweredRight.typeName {
            if initialLoweredRight.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            } else if initialLoweredLeft.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: leftSummary, expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: rightSummary, expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            }
        }
        let resultOperand: String("%r\(loweredRight.nextTemporary)")
        let instructionName: String(compilerCoreLLVMInstructionForOperator(operatorText: operatorText))
        let resultType: String(compilerCoreLLVMResultTypeForOperator(operatorText: operatorText))
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (operatorText == String("==") || operatorText == String("!=") || operatorText == String("bangEqual")) {
            let stringEqualInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringEqual"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let stringEqualRecord: String(compilerCoreLLVMInstructionRecord(instruction: stringEqualInstruction))
            let comparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state comparisonOperation: String("icmp ne")
            if operatorText == String("!=") || operatorText == String("bangEqual") {
                comparisonOperation: String("icmp eq")
            }
            let comparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: comparisonResultOperand,
                operation: comparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let comparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: comparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(stringEqualRecord)\(comparisonRecord)",
                operand: comparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (operatorText == String(">") || operatorText == String("<") || operatorText == String(">=") || operatorText == String("<=") || operatorText == String("greater") || operatorText == String("less") || operatorText == String("greaterEqual") || operatorText == String("lessEqual")) {
            let summaryStringCompareInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringCompare"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let summaryStringCompareRecord: String(compilerCoreLLVMInstructionRecord(instruction: summaryStringCompareInstruction))
            let summaryRelationalComparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state summaryRelationalComparisonOperation: String("icmp sgt")
            if operatorText == String("<") || operatorText == String("less") {
                summaryRelationalComparisonOperation: String("icmp slt")
            } else if operatorText == String(">=") || operatorText == String("greaterEqual") {
                summaryRelationalComparisonOperation: String("icmp sge")
            } else if operatorText == String("<=") || operatorText == String("lessEqual") {
                summaryRelationalComparisonOperation: String("icmp sle")
            }
            let summaryRelationalComparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: summaryRelationalComparisonResultOperand,
                operation: summaryRelationalComparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let summaryRelationalComparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: summaryRelationalComparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(summaryStringCompareRecord)\(summaryRelationalComparisonRecord)",
                operand: summaryRelationalComparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        let instruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: resultOperand,
            operation: instructionName,
            typeName: loweredLeft.typeName,
            left: loweredLeft.operand,
            right: loweredRight.operand
        ))
        let instructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: instruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(instructionRecord)",
            operand: resultOperand,
            typeName: resultType,
            nextTemporary: loweredRight.nextTemporary + 1
        )
    }

    let fallbackTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
    return CompilerLLVMLoweredExpression(
        instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unsupportedExpressionSummary:\(expressionSummary)"),
        operand: compilerCoreLLVMDefaultReturnValue(typeName: fallbackTypeName),
        typeName: fallbackTypeName,
        nextTemporary: temporaryIndex
    )
}

function compilerCoreLLVMInstructionRecord(instruction: CompilerLLVMInstruction): String {
    return "llvmInstruction|result=\(instruction.result)|op=\(instruction.operation)|type=\(instruction.typeName)|left=\(instruction.left)|right=\(instruction.right);"
}

function compilerCoreLLVMPlaceholderRecord(reason: String): String {
    return "llvmPlaceholder|reason=\(compilerCoreStatementRecordEncodeValue(value: reason));"
}

function compilerCoreLLVMGlobalStringRecord(name: String, byteCount: Int, text: String): String {
    return "llvmGlobalString|name=\(name)|bytes=\(byteCount)|text=\(compilerCoreLLVMGlobalStringRecordText(text: text));"
}

function compilerCoreLLVMGlobalStringRecordText(text: String): String {
    return compilerCoreStatementRecordEncodeValue(value: text)
}

function compilerCoreLLVMGlobalStringRenderedText(text: String): String {
    let decodedText: String(compilerCoreStatementRecordDecodeValue(value: text))
    return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: decodedText, sourceIndex: 0, output: String(""))
}

function compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: String, sourceIndex: Int, output: String): String {
    let textLength: Int(stringLength(value: text))
    if sourceIndex >= textLength {
        return output
    }

    let character: String(text.character(index: sourceIndex))
    if character == compilerCoreNewlineCharacter() {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\0A")
    }
    if character == compilerCoreTabCharacter() {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\09")
    }
    if isRangeQuote(character: character) {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\22")
    }
    if character == compilerCoreSingleBackslash() {
        return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\\5C")
    }

    return compilerCoreLLVMGlobalStringRenderedTextFromIndex(text: text, sourceIndex: sourceIndex + 1, output: "\(output)\(character)")
}

function compilerCoreLLVMLocalRecord(name: String, operand: String, typeName: String): String {
    return "\(name):\(operand)@TYPE@\(typeName);"
}

function compilerCoreLLVMLocalRecordWithRangeType(name: String, operand: String, typeName: String, rangeTypeName: String): String {
    return "\(name):\(operand)@TYPE@\(typeName)@RANGE@\(rangeTypeName);"
}

function compilerCoreLLVMLocalNames(localValues: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: localValues))

    while sourceIndex < sourceLength {
        state nameEnd: Int(0)
        nameEnd: sourceIndex
        while nameEnd < sourceLength && localValues.substring(start: nameEnd, end: nameEnd + 1) != String(":") {
            nameEnd: nameEnd + 1
        }

        let name: String(localValues.substring(start: sourceIndex, end: nameEnd))
        if name != String("") && !compilerCoreNameListContains(names: output, name: name) {
            output: "\(output)\(name);"
        }

        while sourceIndex < sourceLength && localValues.substring(start: sourceIndex, end: sourceIndex + 1) != String(";") {
            sourceIndex: sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    return output
}

function compilerCoreLookupLLVMLocalRecord(localValues: String, name: String): String {
    let sourceLength: Int(stringLength(value: localValues))
    let namePrefix: String("\(name):")
    let namePrefixLength: Int(stringLength(value: namePrefix))
    return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: 0, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: String(""))
}

function compilerCoreLookupLLVMLocalRecordFromIndex(localValues: String, sourceIndex: Int, sourceLength: Int, namePrefix: String, namePrefixLength: Int, foundRecord: String): String {
    if sourceIndex >= sourceLength {
        return foundRecord
    }

    if hasRangePrefix(source: localValues, start: sourceIndex, prefix: namePrefix) {
        let recordStart: Int(sourceIndex + namePrefixLength)
        return compilerCoreLookupLLVMLocalRecordEnd(localValues: localValues, recordStart: recordStart, recordEnd: recordStart, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: foundRecord)
    }

    return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: sourceIndex + 1, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: foundRecord)
}

function compilerCoreLookupLLVMLocalRecordEnd(localValues: String, recordStart: Int, recordEnd: Int, sourceLength: Int, namePrefix: String, namePrefixLength: Int, foundRecord: String): String {
    if recordEnd >= sourceLength {
        let nextFoundRecordAtEnd: String(localValues.substring(start: recordStart, end: recordEnd))
        return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: recordEnd, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: nextFoundRecordAtEnd)
    }

    if hasRangePrefix(source: localValues, start: recordEnd, prefix: String(";")) {
        let nextFoundRecordAtTerminator: String(localValues.substring(start: recordStart, end: recordEnd))
        return compilerCoreLookupLLVMLocalRecordFromIndex(localValues: localValues, sourceIndex: recordEnd, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: nextFoundRecordAtTerminator)
    }

    return compilerCoreLookupLLVMLocalRecordEnd(localValues: localValues, recordStart: recordStart, recordEnd: recordEnd + 1, sourceLength: sourceLength, namePrefix: namePrefix, namePrefixLength: namePrefixLength, foundRecord: foundRecord)
}

function compilerCoreLookupLLVMLocalOperand(localValues: String, name: String): String {
    let localRecord: String(compilerCoreLookupLLVMLocalRecord(localValues: localValues, name: name))
    let localRecordLength: Int(stringLength(value: localRecord))
    state sourceIndex: Int(0)

    while sourceIndex < localRecordLength {
        if hasRangePrefix(source: localRecord, start: sourceIndex, prefix: String("@TYPE@")) {
            return localRecord.substring(start: 0, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return localRecord
}

function compilerCoreLookupLLVMLocalType(localValues: String, name: String): String {
    let localRecord: String(compilerCoreLookupLLVMLocalRecord(localValues: localValues, name: name))
    let localRecordLength: Int(stringLength(value: localRecord))
    state sourceIndex: Int(0)

    while sourceIndex < localRecordLength {
        if hasRangePrefix(source: localRecord, start: sourceIndex, prefix: String("@TYPE@")) {
            let typeStart: Int(sourceIndex + 6)
            state typeEnd: Int(0)
            typeEnd: typeStart
            while typeEnd < localRecordLength && !hasRangePrefix(source: localRecord, start: typeEnd, prefix: String("@RANGE@")) {
                typeEnd: typeEnd + 1
            }
            return localRecord.substring(start: typeStart, end: typeEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("i32")
}

function compilerCoreLookupLLVMLocalRangeType(localValues: String, name: String): String {
    let localRecord: String(compilerCoreLookupLLVMLocalRecord(localValues: localValues, name: name))
    let localRecordLength: Int(stringLength(value: localRecord))
    state sourceIndex: Int(0)

    while sourceIndex < localRecordLength {
        if hasRangePrefix(source: localRecord, start: sourceIndex, prefix: String("@RANGE@")) {
            return localRecord.substring(start: sourceIndex + 7, end: localRecordLength)
        }
        sourceIndex: sourceIndex + 1
    }

    return compilerCoreRangeTypeNameForLLVMType(typeName: compilerCoreLookupLLVMLocalType(localValues: localValues, name: name))
}

function compilerCoreRangeTypeNameForLLVMType(typeName: String): String {
    if typeName == String("i1") {
        return String("Bool")
    }

    if typeName == String("ptr") {
        return String("String")
    }

    return String("Int")
}

function compilerCoreLLVMLowerIntegerCallArguments(context: CompilerLLVMLoweringContext, localValues: String, argumentsSummary: String, temporaryIndex: Int): CompilerLLVMCallArguments {
    state callArgumentRecords: String("")
    state renderedCallArguments: String("")
    state callArgumentTemporaryIndex: Int(0)
    callArgumentTemporaryIndex: temporaryIndex
    state callArgumentSourceIndex: Int(0)
    let callArgumentsLength: Int(stringLength(value: argumentsSummary))
    state callArgumentOrdinal: Int(0)

    while callArgumentSourceIndex < callArgumentsLength {
        let callArgumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: argumentsSummary, start: callArgumentSourceIndex))
        if callArgumentExpression == String("") {
            return CompilerLLVMCallArguments(
                instructionRecords: callArgumentRecords,
                renderedArguments: renderedCallArguments,
                nextTemporary: callArgumentTemporaryIndex
            )
        }

        let loweredCallArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: callArgumentExpression, expectedTypeName: String(""), temporaryIndex: callArgumentTemporaryIndex))
        callArgumentRecords: "\(callArgumentRecords)\(loweredCallArgument.instructionRecords)"
        if callArgumentOrdinal == 0 {
            renderedCallArguments: "\(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        } else {
            renderedCallArguments: "\(renderedCallArguments), \(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        }
        callArgumentTemporaryIndex: loweredCallArgument.nextTemporary
        callArgumentOrdinal: callArgumentOrdinal + 1
        callArgumentSourceIndex: compilerCoreCallArgumentNextIndex(argumentsSummary: argumentsSummary, start: callArgumentSourceIndex)
    }

    return CompilerLLVMCallArguments(
        instructionRecords: callArgumentRecords,
        renderedArguments: renderedCallArguments,
        nextTemporary: callArgumentTemporaryIndex
    )
}

function compilerCoreLLVMLowerExpressionRecord(context: CompilerLLVMLoweringContext, localValues: String, expressionRecord: String, fallbackSummary: String, expectedTypeName: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    if expressionRecord == String("") {
        return compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: fallbackSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
    }

    let kind: String(compilerCoreExpressionRecordKind(record: expressionRecord))
    let value: String(compilerCoreExpressionRecordValue(record: expressionRecord))

    if kind == String("integerLiteral") {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: value,
            typeName: String("i32"),
            nextTemporary: temporaryIndex
        )
    }

    if kind == String("stringLiteral") {
        let literalContent: String(compilerCoreStringLiteralContent(text: value))
        if compilerCoreStringContentHasInterpolation(content: literalContent) {
            return compilerCoreLLVMLowerInterpolatedStringContent(context: context, localValues: localValues, content: literalContent, temporaryIndex: temporaryIndex)
        }
        let literalContentLength: Int(stringLength(value: literalContent))
        let literalByteCount: Int(literalContentLength + 1)
        let literalGlobalName: String(".str.\(temporaryIndex)")
        let literalGlobalRecord: String(compilerCoreLLVMGlobalStringRecord(name: literalGlobalName, byteCount: literalByteCount, text: literalContent))
        return CompilerLLVMLoweredExpression(
            instructionRecords: literalGlobalRecord,
            operand: "getelementptr inbounds ([\(literalByteCount) x i8], ptr @\(literalGlobalName), i32 0, i32 0)",
            typeName: String("ptr"),
            nextTemporary: temporaryIndex + 1
        )
    }

    if kind == String("boolLiteral") {
        return CompilerLLVMLoweredExpression(
            instructionRecords: String(""),
            operand: value,
            typeName: String("i1"),
            nextTemporary: temporaryIndex
        )
    }

    if kind == String("identifier") {
        if value == String("nil") {
            return CompilerLLVMLoweredExpression(instructionRecords: String(""), operand: String("null"), typeName: String("ptr"), nextTemporary: temporaryIndex)
        }
        let identifierValue: String(compilerCoreLookupLLVMLocalOperand(localValues: localValues, name: value))
        if identifierValue != String("") {
            let identifierType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: value))
            return CompilerLLVMLoweredExpression(
                instructionRecords: String(""),
                operand: identifierValue,
                typeName: identifierType,
                nextTemporary: temporaryIndex
            )
        }
        let unresolvedIdentifierTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
        return CompilerLLVMLoweredExpression(
            instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unresolvedIdentifier:\(value):localNames=\(compilerCoreLLVMLocalNames(localValues: localValues))"),
            operand: compilerCoreLLVMDefaultReturnValue(typeName: unresolvedIdentifierTypeName),
            typeName: unresolvedIdentifierTypeName,
            nextTemporary: temporaryIndex
        )
    }

    if kind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        state functionName: String("")
        functionName: compilerCoreExpressionRecordValue(record: calleeRecord)
        if functionName == String("") {
            functionName: value
        }
        let argumentRecords: String(compilerCoreExpressionRecordArguments(record: expressionRecord))
        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") && (functionName == String("String") || functionName == String("Int") || functionName == String("Bool")) {
            let wrappedArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
            return compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: wrappedArgumentRecord, fallbackSummary: String(""), expectedTypeName: functionName, temporaryIndex: temporaryIndex)
        }

        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") && functionName == String("print") {
            let printArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
            let loweredPrintArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: printArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
            state printTemporaryIndex: Int(0)
            printTemporaryIndex: loweredPrintArgument.nextTemporary
            let printResultOperand: String("%r\(printTemporaryIndex)")
            let printInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: printResultOperand,
                operation: String("puts"),
                typeName: String("i32"),
                left: loweredPrintArgument.operand,
                right: String("")
            ))
            let printInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: printInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredPrintArgument.instructionRecords)\(printInstructionRecord)",
                operand: printResultOperand,
                typeName: String("i32"),
                nextTemporary: printTemporaryIndex + 1
            )
        }

        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") && compilerLLVMLoweringContextContainsConstruct(context: context, name: functionName) {
            return compilerCoreLLVMLowerConstructInitializer(context: context, localValues: localValues, constructName: functionName, argumentRecords: argumentRecords, temporaryIndex: temporaryIndex)
        }

        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("member") {
            let memberBaseRecord: String(compilerCoreExpressionRecordLeft(record: calleeRecord))
            let loweredBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: memberBaseRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex))
            if functionName == String("character") {
                let indexArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
                let loweredIndexArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: indexArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("Int"), temporaryIndex: loweredBase.nextTemporary))
                let memberCallResultOperand: String("%r\(loweredIndexArgument.nextTemporary)")
                let memberCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                    result: memberCallResultOperand,
                    operation: String("call"),
                    typeName: String("ptr"),
                    left: String("stringCharacter"),
                    right: "\(loweredBase.typeName) \(loweredBase.operand), \(loweredIndexArgument.typeName) \(loweredIndexArgument.operand)"
                ))
                let memberCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: memberCallInstruction))
                return CompilerLLVMLoweredExpression(
                    instructionRecords: "\(loweredBase.instructionRecords)\(loweredIndexArgument.instructionRecords)\(memberCallInstructionRecord)",
                    operand: memberCallResultOperand,
                    typeName: String("ptr"),
                    nextTemporary: loweredIndexArgument.nextTemporary + 1
                )
            }

            if functionName == String("substring") {
                let startArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 0))
                let loweredStartArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: startArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("Int"), temporaryIndex: loweredBase.nextTemporary))
                let endArgumentRecord: String(compilerCoreCallArgumentExpressionRecordAtOrdinal(records: argumentRecords, ordinal: 1))
                let loweredEndArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: endArgumentRecord, fallbackSummary: String(""), expectedTypeName: String("Int"), temporaryIndex: loweredStartArgument.nextTemporary))
                let substringCallResultOperand: String("%r\(loweredEndArgument.nextTemporary)")
                let substringCallInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                    result: substringCallResultOperand,
                    operation: String("call"),
                    typeName: String("ptr"),
                    left: String("stringSubstring"),
                    right: "\(loweredBase.typeName) \(loweredBase.operand), \(loweredStartArgument.typeName) \(loweredStartArgument.operand), \(loweredEndArgument.typeName) \(loweredEndArgument.operand)"
                ))
                let substringCallInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: substringCallInstruction))
                return CompilerLLVMLoweredExpression(
                    instructionRecords: "\(loweredBase.instructionRecords)\(loweredStartArgument.instructionRecords)\(loweredEndArgument.instructionRecords)\(substringCallInstructionRecord)",
                    operand: substringCallResultOperand,
                    typeName: String("ptr"),
                    nextTemporary: loweredEndArgument.nextTemporary + 1
                )
            }
        }

        if compilerCoreLLVMBuiltinFunctionReturnType(name: functionName) == String("") && !compilerLLVMLoweringContextContainsFunction(context: context, name: functionName) {
            let unresolvedCallTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
            return CompilerLLVMLoweredExpression(
                instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unresolvedCall:\(functionName)"),
                operand: compilerCoreLLVMDefaultReturnValue(typeName: unresolvedCallTypeName),
                typeName: unresolvedCallTypeName,
                nextTemporary: temporaryIndex
            )
        }

        let loweredCallArguments: CompilerLLVMCallArguments(compilerCoreLLVMLowerCallArgumentRecords(context: context, localValues: localValues, argumentRecords: argumentRecords, temporaryIndex: temporaryIndex))
        state callTemporaryIndex: Int(0)
        callTemporaryIndex: loweredCallArguments.nextTemporary
        let callResultOperand: String("%r\(callTemporaryIndex)")
        let callReturnType: String(compilerCoreLLVMCallReturnType(context: context, name: functionName, expectedTypeName: expectedTypeName))
        let callInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: callResultOperand,
            operation: String("call"),
            typeName: callReturnType,
            left: functionName,
            right: loweredCallArguments.renderedArguments
        ))
        let callInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: callInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredCallArguments.instructionRecords)\(callInstructionRecord)",
            operand: callResultOperand,
            typeName: callReturnType,
            nextTemporary: callTemporaryIndex + 1
        )
    }

    if kind == String("member") {
        let constructMemberBaseRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        let loweredConstructMemberBase: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: constructMemberBaseRecord, fallbackSummary: String(""), expectedTypeName: String(""), temporaryIndex: temporaryIndex))
        let constructMemberBaseRangeType: String(compilerCoreExpressionRecordRangeType(context: context, localValues: localValues, expressionRecord: constructMemberBaseRecord))
        state constructMemberRangeType: String("")
        constructMemberRangeType: compilerLLVMLoweringContextConstructMemberType(context: context, constructName: constructMemberBaseRangeType, memberName: value)
        if constructMemberRangeType == String("") {
            constructMemberRangeType: expectedTypeName
        }
        if constructMemberRangeType != String("") {
            return compilerCoreLLVMLowerConstructMemberAccess(base: loweredConstructMemberBase, memberName: value, memberType: constructMemberRangeType)
        }
    }

    if kind == String("prefix") {
        let operandRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        if operandRecord == String("") {
            return compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: fallbackSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
        }
        state prefixExpectedTypeName: String("")
        prefixExpectedTypeName: expectedTypeName
        if value == String("!") {
            prefixExpectedTypeName: String("Bool")
        } else if value == String("-") {
            prefixExpectedTypeName: String("Int")
        }
        let loweredOperand: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: operandRecord, fallbackSummary: String(""), expectedTypeName: prefixExpectedTypeName, temporaryIndex: temporaryIndex))
        let prefixResultOperand: String("%r\(loweredOperand.nextTemporary)")
        let prefixInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: prefixResultOperand,
            operation: compilerCoreLLVMInstructionForPrefixOperator(operatorText: value),
            typeName: compilerCoreLLVMTypeForPrefixOperator(operatorText: value, operandType: loweredOperand.typeName),
            left: compilerCoreLLVMLeftValueForPrefixOperator(operatorText: value, operand: loweredOperand.operand),
            right: compilerCoreLLVMRightValueForPrefixOperator(operatorText: value, operand: loweredOperand.operand)
        ))
        let prefixInstructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: prefixInstruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredOperand.instructionRecords)\(prefixInstructionRecord)",
            operand: prefixResultOperand,
            typeName: prefixInstruction.typeName,
            nextTemporary: loweredOperand.nextTemporary + 1
        )
    }

    if kind == String("binary") {
        let leftRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        let rightRecord: String(compilerCoreExpressionRecordRight(record: expressionRecord))
        if leftRecord == String("") || rightRecord == String("") {
            return compilerCoreLLVMLowerIntegerExpression(context: context, localValues: localValues, expressionSummary: fallbackSummary, expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
        }
        if value == String("??") || value == String("questionQuestion") {
            let loweredOptional: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex))
            if loweredOptional.operand != String("0") || loweredOptional.typeName != String("i32") {
                return CompilerLLVMLoweredExpression(
                    instructionRecords: loweredOptional.instructionRecords,
                    operand: loweredOptional.operand,
                    typeName: loweredOptional.typeName,
                    nextTemporary: loweredOptional.nextTemporary
                )
            }

            return compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: expectedTypeName, temporaryIndex: temporaryIndex)
        }

        state initialLeftExpectedTypeName: String("")
        state initialRightExpectedTypeName: String("")
        if compilerCoreLLVMResultTypeForOperator(operatorText: value) == String("i1") {
            initialLeftExpectedTypeName: compilerCoreExpressionRecordRangeType(context: context, localValues: localValues, expressionRecord: rightRecord)
            initialRightExpectedTypeName: compilerCoreExpressionRecordRangeType(context: context, localValues: localValues, expressionRecord: leftRecord)
        }
        let initialLoweredLeft: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: initialLeftExpectedTypeName, temporaryIndex: temporaryIndex))
        let initialLoweredRight: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: initialRightExpectedTypeName, temporaryIndex: initialLoweredLeft.nextTemporary))
        state loweredLeft: CompilerLLVMLoweredExpression(initialLoweredLeft)
        state loweredRight: CompilerLLVMLoweredExpression(initialLoweredRight)
        if compilerCoreLLVMResultTypeForOperator(operatorText: value) == String("i1") && initialLoweredLeft.typeName != initialLoweredRight.typeName {
            if initialLoweredRight.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            } else if initialLoweredLeft.typeName == String("ptr") {
                loweredLeft: compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: leftRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: temporaryIndex)
                loweredRight: compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: rightRecord, fallbackSummary: String(""), expectedTypeName: String("String"), temporaryIndex: loweredLeft.nextTemporary)
            }
        }
        let resultOperand: String("%r\(loweredRight.nextTemporary)")
        let instructionName: String(compilerCoreLLVMInstructionForOperator(operatorText: value))
        let resultType: String(compilerCoreLLVMResultTypeForOperator(operatorText: value))
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (value == String("==") || value == String("!=") || value == String("bangEqual")) {
            let stringEqualInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringEqual"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let stringEqualRecord: String(compilerCoreLLVMInstructionRecord(instruction: stringEqualInstruction))
            let comparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state comparisonOperation: String("icmp ne")
            if value == String("!=") || value == String("bangEqual") {
                comparisonOperation: String("icmp eq")
            }
            let comparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: comparisonResultOperand,
                operation: comparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let comparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: comparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(stringEqualRecord)\(comparisonRecord)",
                operand: comparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        if resultType == String("i1") && loweredLeft.typeName == String("ptr") && loweredRight.typeName == String("ptr") && (value == String(">") || value == String("<") || value == String(">=") || value == String("<=") || value == String("greater") || value == String("less") || value == String("greaterEqual") || value == String("lessEqual")) {
            let stringCompareInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: resultOperand,
                operation: String("call"),
                typeName: String("i32"),
                left: String("stringCompare"),
                right: "\(loweredLeft.typeName) \(loweredLeft.operand), \(loweredRight.typeName) \(loweredRight.operand)"
            ))
            let stringCompareRecord: String(compilerCoreLLVMInstructionRecord(instruction: stringCompareInstruction))
            let relationalComparisonResultOperand: String("%r\(loweredRight.nextTemporary + 1)")
            state relationalComparisonOperation: String("icmp sgt")
            if value == String("<") || value == String("less") {
                relationalComparisonOperation: String("icmp slt")
            } else if value == String(">=") || value == String("greaterEqual") {
                relationalComparisonOperation: String("icmp sge")
            } else if value == String("<=") || value == String("lessEqual") {
                relationalComparisonOperation: String("icmp sle")
            }
            let relationalComparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                result: relationalComparisonResultOperand,
                operation: relationalComparisonOperation,
                typeName: String("i32"),
                left: resultOperand,
                right: String("0")
            ))
            let relationalComparisonRecord: String(compilerCoreLLVMInstructionRecord(instruction: relationalComparisonInstruction))
            return CompilerLLVMLoweredExpression(
                instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(stringCompareRecord)\(relationalComparisonRecord)",
                operand: relationalComparisonResultOperand,
                typeName: resultType,
                nextTemporary: loweredRight.nextTemporary + 2
            )
        }
        let instruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: resultOperand,
            operation: instructionName,
            typeName: loweredLeft.typeName,
            left: loweredLeft.operand,
            right: loweredRight.operand
        ))
        let instructionRecord: String(compilerCoreLLVMInstructionRecord(instruction: instruction))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredLeft.instructionRecords)\(loweredRight.instructionRecords)\(instructionRecord)",
            operand: resultOperand,
            typeName: resultType,
            nextTemporary: loweredRight.nextTemporary + 1
        )
    }

    let unsupportedTypeName: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName))
    return CompilerLLVMLoweredExpression(
        instructionRecords: compilerCoreLLVMPlaceholderRecord(reason: "unsupportedExpressionRecord:\(kind):\(value)"),
        operand: compilerCoreLLVMDefaultReturnValue(typeName: unsupportedTypeName),
        typeName: unsupportedTypeName,
        nextTemporary: temporaryIndex
    )
}

function compilerCoreSingleBackslash(): String {
    let pair: String("\\")
    return pair.substring(start: 0, end: 1)
}

function compilerCoreNewlineCharacter(): String {
    let value: String("
")
    return value.substring(start: 0, end: 1)
}

function compilerCoreTabCharacter(): String {
    let value: String("	")
    return value.substring(start: 0, end: 1)
}

function compilerCoreMaterializeLLVMText(text: String): String {
    let textLength: Int(stringLength(value: text))
    let backslash: String(compilerCoreSingleBackslash())
    let outputBuffer: TextBuffer(textBufferCreate(capacity: textLength))
    state sourceIndex: Int(0)

    while sourceIndex < textLength {
        if stringHasPrefix(source: text, start: sourceIndex, prefix: backslash) && sourceIndex + 1 < textLength {
            let escaped: String(text.character(index: sourceIndex + 1))
            if escaped == String("n") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
                sourceIndex: sourceIndex + 2
            } else if escaped == String("t") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreTabCharacter())
                sourceIndex: sourceIndex + 2
            } else if isRangeQuote(character: escaped) {
                textBufferAppend(buffer: outputBuffer, text: escaped)
                sourceIndex: sourceIndex + 2
            } else if escaped == backslash {
                textBufferAppend(buffer: outputBuffer, text: backslash)
                sourceIndex: sourceIndex + 2
            } else {
                textBufferAppendCharacter(buffer: outputBuffer, source: text, index: sourceIndex)
                sourceIndex: sourceIndex + 1
            }
        } else {
            textBufferAppendCharacter(buffer: outputBuffer, source: text, index: sourceIndex)
            sourceIndex: sourceIndex + 1
        }
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStringContentHasInterpolation(content: String): Bool {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state sourceIndex: Int(0)

    while sourceIndex + 1 < contentLength {
        if content.character(index: sourceIndex) == backslash && content.character(index: sourceIndex + 1) == String("(") {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreLLVMLowerPlainStringContent(content: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let literalContentLength: Int(stringLength(value: content))
    let literalByteCount: Int(literalContentLength + 1)
    let literalGlobalName: String(".str.\(temporaryIndex)")
    let literalGlobalRecord: String(compilerCoreLLVMGlobalStringRecord(name: literalGlobalName, byteCount: literalByteCount, text: content))
    return CompilerLLVMLoweredExpression(
        instructionRecords: literalGlobalRecord,
        operand: "getelementptr inbounds ([\(literalByteCount) x i8], ptr @\(literalGlobalName), i32 0, i32 0)",
        typeName: String("ptr"),
        nextTemporary: temporaryIndex + 1
    )
}

function compilerCoreLLVMLowerStringValueFromExpression(loweredExpression: CompilerLLVMLoweredExpression): CompilerLLVMLoweredExpression {
    if loweredExpression.typeName == String("ptr") {
        return loweredExpression
    }

    if loweredExpression.typeName == String("i32") {
        let intStringOperand: String("%r\(loweredExpression.nextTemporary)")
        let intStringInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: intStringOperand,
            operation: String("call"),
            typeName: String("ptr"),
            left: String("stringFromInt"),
            right: "i32 \(loweredExpression.operand)"
        ))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredExpression.instructionRecords)\(compilerCoreLLVMInstructionRecord(instruction: intStringInstruction))",
            operand: intStringOperand,
            typeName: String("ptr"),
            nextTemporary: loweredExpression.nextTemporary + 1
        )
    }

    if loweredExpression.typeName == String("i1") {
        let boolStringOperand: String("%r\(loweredExpression.nextTemporary)")
        let boolStringInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: boolStringOperand,
            operation: String("call"),
            typeName: String("ptr"),
            left: String("stringFromBool"),
            right: "i1 \(loweredExpression.operand)"
        ))
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(loweredExpression.instructionRecords)\(compilerCoreLLVMInstructionRecord(instruction: boolStringInstruction))",
            operand: boolStringOperand,
            typeName: String("ptr"),
            nextTemporary: loweredExpression.nextTemporary + 1
        )
    }

    return compilerCoreLLVMLowerPlainStringContent(content: String(""), temporaryIndex: loweredExpression.nextTemporary)
}

function compilerCoreLLVMLowerInterpolatedExpression(context: CompilerLLVMLoweringContext, localValues: String, expressionText: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let expressionLength: Int(stringLength(value: expressionText))
    let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: expressionText, start: 0, limit: expressionLength))
    if maybeExpression == nil {
        return compilerCoreLLVMLowerPlainStringContent(content: String(""), temporaryIndex: temporaryIndex)
    }

    let fallbackExpression: CompilerExpression(compilerCoreMissingExpression(start: 0))
    let expression: CompilerExpression(maybeExpression ?? fallbackExpression)
    let loweredExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: expression.record, fallbackSummary: expression.summary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
    return compilerCoreLLVMLowerStringValueFromExpression(loweredExpression: loweredExpression)
}

function compilerCoreInterpolatedExpressionEnd(content: String, start: Int): Int {
    let contentLength: Int(stringLength(value: content))
    state sourceIndex: Int(0)
    sourceIndex: start
    state parenDepth: Int(0)

    while sourceIndex < contentLength {
        let character: String(content.character(index: sourceIndex))
        if character == String("(") {
            parenDepth: parenDepth + 1
        } else if character == String(")") {
            if parenDepth == 0 {
                return sourceIndex
            }
            parenDepth: parenDepth - 1
        }
        sourceIndex: sourceIndex + 1
    }

    return contentLength
}

function compilerCoreLLVMAppendStringPart(instructionRecords: String, currentOperand: String, part: CompilerLLVMLoweredExpression, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    if currentOperand == String("") {
        return CompilerLLVMLoweredExpression(
            instructionRecords: "\(instructionRecords)\(part.instructionRecords)",
            operand: part.operand,
            typeName: String("ptr"),
            nextTemporary: part.nextTemporary
        )
    }

    let concatOperand: String("%r\(part.nextTemporary)")
    let concatInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
        result: concatOperand,
        operation: String("call"),
        typeName: String("ptr"),
        left: String("stringConcat"),
        right: "ptr \(currentOperand), ptr \(part.operand)"
    ))
    return CompilerLLVMLoweredExpression(
        instructionRecords: "\(instructionRecords)\(part.instructionRecords)\(compilerCoreLLVMInstructionRecord(instruction: concatInstruction))",
        operand: concatOperand,
        typeName: String("ptr"),
        nextTemporary: part.nextTemporary + 1
    )
}

function compilerCoreLLVMLowerInterpolatedStringContent(context: CompilerLLVMLoweringContext, localValues: String, content: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state sourceIndex: Int(0)
    state segmentStart: Int(0)
    state instructionRecords: String("")
    state currentOperand: String("")
    state nextTemporary: Int(0)
    nextTemporary: temporaryIndex

    while sourceIndex + 1 < contentLength {
        if stringCharacterAt(source: content, index: sourceIndex) == backslash && stringCharacterAt(source: content, index: sourceIndex + 1) == String("(") {
            let segment: String(stringSubstring(source: content, start: segmentStart, end: sourceIndex))
            if segment != String("") {
                let loweredSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerPlainStringContent(content: segment, temporaryIndex: nextTemporary))
                let appendedSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMAppendStringPart(instructionRecords: instructionRecords, currentOperand: currentOperand, part: loweredSegment, temporaryIndex: nextTemporary))
                instructionRecords: appendedSegment.instructionRecords
                currentOperand: appendedSegment.operand
                nextTemporary: appendedSegment.nextTemporary
            }

            let expressionEnd: Int(compilerCoreInterpolatedExpressionEnd(content: content, start: sourceIndex + 2))
            if expressionEnd < contentLength {
                let expressionText: String(stringSubstring(source: content, start: sourceIndex + 2, end: expressionEnd))
                let loweredInterpolation: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerInterpolatedExpression(context: context, localValues: localValues, expressionText: expressionText, temporaryIndex: nextTemporary))
                let appendedInterpolation: CompilerLLVMLoweredExpression(compilerCoreLLVMAppendStringPart(instructionRecords: instructionRecords, currentOperand: currentOperand, part: loweredInterpolation, temporaryIndex: nextTemporary))
                instructionRecords: appendedInterpolation.instructionRecords
                currentOperand: appendedInterpolation.operand
                nextTemporary: appendedInterpolation.nextTemporary
                sourceIndex: expressionEnd + 1
                segmentStart: sourceIndex
            } else {
                sourceIndex: sourceIndex + 1
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    if segmentStart < contentLength {
        let trailingSegment: String(stringSubstring(source: content, start: segmentStart, end: contentLength))
        if trailingSegment != String("") {
            let loweredTrailingSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerPlainStringContent(content: trailingSegment, temporaryIndex: nextTemporary))
            let appendedTrailingSegment: CompilerLLVMLoweredExpression(compilerCoreLLVMAppendStringPart(instructionRecords: instructionRecords, currentOperand: currentOperand, part: loweredTrailingSegment, temporaryIndex: nextTemporary))
            instructionRecords: appendedTrailingSegment.instructionRecords
            currentOperand: appendedTrailingSegment.operand
            nextTemporary: appendedTrailingSegment.nextTemporary
        }
    }

    if currentOperand == String("") {
        return compilerCoreLLVMLowerPlainStringContent(content: String(""), temporaryIndex: nextTemporary)
    }

    return CompilerLLVMLoweredExpression(
        instructionRecords: instructionRecords,
        operand: currentOperand,
        typeName: String("ptr"),
        nextTemporary: nextTemporary
    )
}

function compilerCoreLLVMLowerConstructInitializer(context: CompilerLLVMLoweringContext, localValues: String, constructName: String, argumentRecords: String, temporaryIndex: Int): CompilerLLVMLoweredExpression {
    let constructNameLength: Int(stringLength(value: constructName))
    let constructNameBytes: Int(constructNameLength + 1)
    let constructNameGlobal: String(".str.\(temporaryIndex)")
    let constructNameRecord: String(compilerCoreLLVMGlobalStringRecord(name: constructNameGlobal, byteCount: constructNameBytes, text: constructName))
    let objectOperand: String("%r\(temporaryIndex + 1)")
    let createInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
        result: objectOperand,
        operation: String("call"),
        typeName: String("ptr"),
        left: String("rangeConstructCreate"),
        right: "ptr getelementptr inbounds ([\(constructNameBytes) x i8], ptr @\(constructNameGlobal), i32 0, i32 0)"
    ))
    state instructionRecords: String("\(constructNameRecord)\(compilerCoreLLVMInstructionRecord(instruction: createInstruction))")
    state currentObjectOperand: String(objectOperand)
    state nextTemporary: Int(temporaryIndex + 2)
    state argumentIndex: Int(0)
    let argumentsLength: Int(stringLength(value: argumentRecords))

    while argumentIndex < argumentsLength {
        let argumentRecord: String(compilerCoreCallArgumentRecordAt(records: argumentRecords, start: argumentIndex))
        if argumentRecord == String("") {
            return CompilerLLVMLoweredExpression(
                instructionRecords: instructionRecords,
                operand: currentObjectOperand,
                typeName: String("ptr"),
                nextTemporary: nextTemporary
            )
        }
        let fieldName: String(compilerCoreCallArgumentLabel(record: argumentRecord))
        let fieldType: String(compilerLLVMLoweringContextConstructMemberType(context: context, constructName: constructName, memberName: fieldName))
        let argumentExpressionRecord: String(compilerCoreCallArgumentExpressionRecord(record: argumentRecord))
        let argumentExpressionSummary: String(compilerCoreCallArgumentExpressionSummary(record: argumentRecord))
        let loweredArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: argumentExpressionRecord, fallbackSummary: argumentExpressionSummary, expectedTypeName: fieldType, temporaryIndex: nextTemporary))
        let fieldNameLength: Int(stringLength(value: fieldName))
        let fieldNameBytes: Int(fieldNameLength + 1)
        let fieldNameGlobal: String(".str.\(loweredArgument.nextTemporary)")
        let fieldNameRecord: String(compilerCoreLLVMGlobalStringRecord(name: fieldNameGlobal, byteCount: fieldNameBytes, text: fieldName))
        let setResultOperand: String("%r\(loweredArgument.nextTemporary + 1)")
        state setterName: String("rangeConstructSetPtr")
        if loweredArgument.typeName == String("i1") {
            setterName: String("rangeConstructSetBool")
        } else if loweredArgument.typeName == String("i32") {
            setterName: String("rangeConstructSetInt")
        }
        let setInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
            result: setResultOperand,
            operation: String("call"),
            typeName: String("ptr"),
            left: setterName,
            right: "ptr \(currentObjectOperand), ptr getelementptr inbounds ([\(fieldNameBytes) x i8], ptr @\(fieldNameGlobal), i32 0, i32 0), \(loweredArgument.typeName) \(loweredArgument.operand)"
        ))
        instructionRecords: "\(instructionRecords)\(loweredArgument.instructionRecords)\(fieldNameRecord)\(compilerCoreLLVMInstructionRecord(instruction: setInstruction))"
        currentObjectOperand: setResultOperand
        nextTemporary: loweredArgument.nextTemporary + 2
        argumentIndex: compilerCoreCallArgumentRecordNextIndex(records: argumentRecords, start: argumentIndex)
    }

    return CompilerLLVMLoweredExpression(
        instructionRecords: instructionRecords,
        operand: currentObjectOperand,
        typeName: String("ptr"),
        nextTemporary: nextTemporary
    )
}

function compilerCoreLLVMLowerConstructMemberAccess(base: CompilerLLVMLoweredExpression, memberName: String, memberType: String): CompilerLLVMLoweredExpression {
    let memberNameLength: Int(stringLength(value: memberName))
    let memberNameBytes: Int(memberNameLength + 1)
    let memberNameGlobal: String(".str.\(base.nextTemporary)")
    let memberNameRecord: String(compilerCoreLLVMGlobalStringRecord(name: memberNameGlobal, byteCount: memberNameBytes, text: memberName))
    let resultOperand: String("%r\(base.nextTemporary + 1)")
    let resultType: String(compilerCoreLLVMTypeNameForRangeType(typeName: memberType))
    state getterName: String("rangeConstructGetPtr")
    if resultType == String("i1") {
        getterName: String("rangeConstructGetBool")
    } else if resultType == String("i32") {
        getterName: String("rangeConstructGetInt")
    }
    let getInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
        result: resultOperand,
        operation: String("call"),
        typeName: resultType,
        left: getterName,
        right: "ptr \(base.operand), ptr getelementptr inbounds ([\(memberNameBytes) x i8], ptr @\(memberNameGlobal), i32 0, i32 0)"
    ))
    return CompilerLLVMLoweredExpression(
        instructionRecords: "\(base.instructionRecords)\(memberNameRecord)\(compilerCoreLLVMInstructionRecord(instruction: getInstruction))",
        operand: resultOperand,
        typeName: resultType,
        nextTemporary: base.nextTemporary + 2
    )
}

function compilerCoreExpressionRecordRangeType(context: CompilerLLVMLoweringContext, localValues: String, expressionRecord: String): String {
    let kind: String(compilerCoreExpressionRecordKind(record: expressionRecord))
    let value: String(compilerCoreExpressionRecordValue(record: expressionRecord))

    if kind == String("identifier") {
        return compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: value)
    }

    if kind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") {
            let functionName: String(compilerCoreExpressionRecordValue(record: calleeRecord))
            if compilerLLVMLoweringContextContainsConstruct(context: context, name: functionName) {
                return functionName
            }
            let returnType: String(compilerLLVMLoweringContextFunctionReturnType(context: context, name: functionName))
            if returnType != String("") {
                return returnType
            }
        }
    }

    if kind == String("member") {
        let baseRecord: String(compilerCoreExpressionRecordLeft(record: expressionRecord))
        let baseType: String(compilerCoreExpressionRecordRangeType(context: context, localValues: localValues, expressionRecord: baseRecord))
        return compilerLLVMLoweringContextConstructMemberType(context: context, constructName: baseType, memberName: value)
    }

    if kind == String("integerLiteral") {
        return String("Int")
    }

    if kind == String("boolLiteral") {
        return String("Bool")
    }

    if kind == String("stringLiteral") {
        return String("String")
    }

    return String("")
}

function compilerCoreLLVMLowerCallArgumentRecords(context: CompilerLLVMLoweringContext, localValues: String, argumentRecords: String, temporaryIndex: Int): CompilerLLVMCallArguments {
    state callArgumentInstructionRecords: String("")
    state renderedCallArguments: String("")
    state callArgumentTemporaryIndex: Int(0)
    callArgumentTemporaryIndex: temporaryIndex
    state callArgumentSourceIndex: Int(0)
    let callArgumentsLength: Int(stringLength(value: argumentRecords))
    state callArgumentOrdinal: Int(0)

    while callArgumentSourceIndex < callArgumentsLength {
        let argumentRecord: String(compilerCoreCallArgumentRecordAt(records: argumentRecords, start: callArgumentSourceIndex))
        if argumentRecord == String("") {
            return CompilerLLVMCallArguments(
                instructionRecords: callArgumentInstructionRecords,
                renderedArguments: renderedCallArguments,
                nextTemporary: callArgumentTemporaryIndex
            )
        }

        let argumentExpressionRecord: String(compilerCoreCallArgumentExpressionRecord(record: argumentRecord))
        let argumentExpressionSummary: String(compilerCoreCallArgumentExpressionSummary(record: argumentRecord))
        let loweredCallArgument: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: argumentExpressionRecord, fallbackSummary: argumentExpressionSummary, expectedTypeName: String(""), temporaryIndex: callArgumentTemporaryIndex))
        callArgumentInstructionRecords: "\(callArgumentInstructionRecords)\(loweredCallArgument.instructionRecords)"
        if callArgumentOrdinal == 0 {
            renderedCallArguments: "\(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        } else {
            renderedCallArguments: "\(renderedCallArguments), \(loweredCallArgument.typeName) \(loweredCallArgument.operand)"
        }
        callArgumentTemporaryIndex: loweredCallArgument.nextTemporary
        callArgumentOrdinal: callArgumentOrdinal + 1
        callArgumentSourceIndex: compilerCoreCallArgumentRecordNextIndex(records: argumentRecords, start: callArgumentSourceIndex)
    }

    return CompilerLLVMCallArguments(
        instructionRecords: callArgumentInstructionRecords,
        renderedArguments: renderedCallArguments,
        nextTemporary: callArgumentTemporaryIndex
    )
}

function compilerCoreCallArgumentExpressionRecordAtOrdinal(records: String, ordinal: Int): String {
    state sourceIndex: Int(0)
    state currentOrdinal: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreCallArgumentRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        if currentOrdinal == ordinal {
            return compilerCoreCallArgumentExpressionRecord(record: record)
        }

        currentOrdinal: currentOrdinal + 1
        sourceIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreCallArgumentExpression(argumentsSummary: String, start: Int): String {
    let argumentsSummaryLength: Int(stringLength(value: argumentsSummary))
    state sourceIndex: Int(0)
    sourceIndex: start
    while sourceIndex < argumentsSummaryLength {
        let character: String(argumentsSummary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("=") {
            let expressionStart: Int(sourceIndex + 1)
            let expressionEnd: Int(compilerCoreCallArgumentEndIndex(argumentsSummary: argumentsSummary, start: expressionStart))
            return argumentsSummary.substring(start: expressionStart, end: expressionEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreCallArgumentNextIndex(argumentsSummary: String, start: Int): Int {
    let argumentsSummaryLength: Int(stringLength(value: argumentsSummary))
    let argumentEnd: Int(compilerCoreCallArgumentEndIndex(argumentsSummary: argumentsSummary, start: start))
    if argumentEnd < argumentsSummaryLength {
        return argumentEnd + 1
    }

    return argumentsSummaryLength
}

function compilerCoreCallArgumentEndIndex(argumentsSummary: String, start: Int): Int {
    let argumentsSummaryLength: Int(stringLength(value: argumentsSummary))
    state sourceIndex: Int(0)
    sourceIndex: start
    state parenDepth: Int(0)
    state bracketDepth: Int(0)

    while sourceIndex < argumentsSummaryLength {
        let character: String(argumentsSummary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            parenDepth: parenDepth + 1
        } else if character == String(")") {
            parenDepth: parenDepth - 1
        } else if character == String("[") {
            bracketDepth: bracketDepth + 1
        } else if character == String("]") {
            bracketDepth: bracketDepth - 1
        } else if character == String(";") && parenDepth == 0 && bracketDepth == 0 {
            return sourceIndex
        }
        sourceIndex: sourceIndex + 1
    }

    return argumentsSummaryLength
}

function compilerCoreWrappedExpressionValue(summary: String, prefixLength: Int): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= prefixLength {
        return String("")
    }

    return summary.substring(start: prefixLength, end: summaryLength - 1)
}

function compilerCoreStringLiteralText(summary: String): String {
    if hasRangePrefix(source: summary, start: 0, prefix: String("stringLiteral(")) {
        return compilerCoreWrappedExpressionValue(summary: summary, prefixLength: 14)
    }

    return String("")
}

function compilerCoreStringLiteralContent(text: String): String {
    let textLength: Int(stringLength(value: text))
    if textLength >= 2 {
        state contentEnd: Int(0)
        contentEnd: textLength - 1
        let lastCharacter: String(text.substring(start: textLength - 1, end: textLength))
        if textLength >= 3 && lastCharacter == String(")") {
            let beforeLastCharacter: String(text.substring(start: textLength - 2, end: textLength - 1))
            if isRangeQuote(character: beforeLastCharacter) {
                contentEnd: textLength - 2
            }
        }
        return compilerCoreDecodeStringLiteralContent(content: text.substring(start: 1, end: contentEnd))
    }

    return String("")
}

function compilerCoreDecodeStringLiteralContent(content: String): String {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    let outputBuffer: TextBuffer(textBufferCreate(capacity: contentLength))
    state sourceIndex: Int(0)

    while sourceIndex < contentLength {
        if stringHasPrefix(source: content, start: sourceIndex, prefix: backslash) && sourceIndex + 1 < contentLength {
            let escaped: String(content.character(index: sourceIndex + 1))
            if escaped == String("n") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
                sourceIndex: sourceIndex + 2
            } else if escaped == String("t") {
                textBufferAppend(buffer: outputBuffer, text: compilerCoreTabCharacter())
                sourceIndex: sourceIndex + 2
            } else if isRangeQuote(character: escaped) {
                textBufferAppend(buffer: outputBuffer, text: escaped)
                sourceIndex: sourceIndex + 2
            } else if escaped == backslash {
                textBufferAppend(buffer: outputBuffer, text: backslash)
                sourceIndex: sourceIndex + 2
            } else {
                textBufferAppendCharacter(buffer: outputBuffer, source: content, index: sourceIndex)
                sourceIndex: sourceIndex + 1
            }
        } else {
            textBufferAppendCharacter(buffer: outputBuffer, source: content, index: sourceIndex)
            sourceIndex: sourceIndex + 1
        }
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreIdentifierExpressionName(summary: String): String {
    if hasRangePrefix(source: summary, start: 0, prefix: String("identifier(")) {
        return compilerCoreWrappedExpressionValue(summary: summary, prefixLength: 11)
    }

    return String("")
}

function compilerCoreIdentifierExpressionRecordName(record: String, fallbackSummary: String): String {
    if record != String("") && compilerCoreExpressionRecordKind(record: record) == String("identifier") {
        return compilerCoreExpressionRecordValue(record: record)
    }

    return compilerCoreIdentifierExpressionName(summary: fallbackSummary)
}

function compilerCoreCallIdentifierName(summary: String): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    state sourceIndex: Int(16)

    while sourceIndex < summaryLength {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String(")") {
            return summary.substring(start: 16, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreCallCalleeSummary(summary: String): String {
    let summaryLength: Int(stringLength(value: summary))
    if summaryLength <= 5 {
        return String("")
    }

    state sourceIndex: Int(5)
    state depth: Int(0)
    while sourceIndex < summaryLength {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            return summary.substring(start: 5, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreCallArgumentsSummary(summary: String): String {
    let summaryLength: Int(stringLength(value: summary))
    let argumentsPrefix: String("arguments=[")
    let argumentsPrefixLength: Int(stringLength(value: argumentsPrefix))
    state sourceIndex: Int(0)

    while sourceIndex < summaryLength {
        if hasRangePrefix(source: summary, start: sourceIndex, prefix: argumentsPrefix) {
            let argumentsStart: Int(sourceIndex + argumentsPrefixLength)
            state argumentsEnd: Int(0)
            argumentsEnd: summaryLength - 2
            if argumentsEnd < argumentsStart {
                return String("")
            }
            return summary.substring(start: argumentsStart, end: argumentsEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreMemberExpressionBase(summary: String): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            return summary.substring(start: 7, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreMemberExpressionName(summary: String): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            return summary.substring(start: sourceIndex + 1, end: contentEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCorePrefixExpressionOperator(summary: String): String {
    return compilerCorePrefixExpressionPart(summary: summary, partIndex: 0)
}

function compilerCorePrefixExpressionOperand(summary: String): String {
    return compilerCorePrefixExpressionPart(summary: summary, partIndex: 1)
}

function compilerCorePrefixExpressionPart(summary: String, partIndex: Int): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)
    state squareDepth: Int(0)
    state currentPart: Int(0)
    state partStart: Int(7)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String("[") {
            squareDepth: squareDepth + 1
        } else if character == String("]") {
            squareDepth: squareDepth - 1
        } else if character == String(",") && depth == 0 && squareDepth == 0 {
            if currentPart == partIndex {
                return summary.substring(start: partStart, end: sourceIndex)
            }
            currentPart: currentPart + 1
            partStart: sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    if currentPart == partIndex {
        return summary.substring(start: partStart, end: contentEnd)
    }

    return String("")
}

function compilerCoreLLVMInstructionForPrefixOperator(operatorText: String): String {
    if operatorText == String("!") {
        return String("xor")
    }

    if operatorText == String("-") {
        return String("sub")
    }

    return String("add")
}

function compilerCoreLLVMTypeForPrefixOperator(operatorText: String, operandType: String): String {
    if operatorText == String("!") {
        return String("i1")
    }

    if operatorText == String("-") {
        return String("i32")
    }

    return operandType
}

function compilerCoreLLVMLeftValueForPrefixOperator(operatorText: String, operand: String): String {
    if operatorText == String("-") {
        return String("0")
    }

    return operand
}

function compilerCoreLLVMRightValueForPrefixOperator(operatorText: String, operand: String): String {
    if operatorText == String("!") {
        return String("true")
    }

    return operand
}

function compilerCoreLLVMFunctionReturnType(context: CompilerLLVMLoweringContext, name: String): String {
    let builtinReturnType: String(compilerCoreLLVMBuiltinFunctionReturnType(name: name))
    if builtinReturnType != String("") {
        return builtinReturnType
    }

    let rangeReturnType: String(compilerLLVMLoweringContextFunctionReturnType(context: context, name: name))
    if rangeReturnType != String("") {
        return compilerCoreLLVMTypeNameForRangeType(typeName: rangeReturnType)
    }

    return String("i32")
}

function compilerCoreLLVMBuiltinFunctionReturnType(name: String): String {
    return compilerBodyRuntimeBuiltinReturnType(id: compilerBodyRuntimeBuiltinID(name: name))
}

function compilerCoreLLVMCallReturnType(context: CompilerLLVMLoweringContext, name: String, expectedTypeName: String): String {
    if expectedTypeName != String("") {
        return compilerCoreLLVMTypeNameForRangeType(typeName: expectedTypeName)
    }

    return compilerCoreLLVMFunctionReturnType(context: context, name: name)
}

function compilerCoreDeclarationRecordsFunctionReturnType(records: String, name: String): String {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("function") && declarationName == name {
            return compilerCoreRecordField(record: record, prefix: String("returnType="))
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreDeclarationRecordsContainsFunction(records: String, name: String): Bool {
    return compilerCoreDeclarationRecordsFunctionReturnType(records: records, name: name) != String("")
}

function compilerCoreDeclarationRecordsContainsConstruct(records: String, name: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return false
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("construct") && declarationName == name {
            return true
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return false
}

function compilerCoreDeclarationRecordsFunctionParameterSummary(records: String, name: String): String {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("function") && declarationName == name {
            return compilerCoreRecordField(record: record, prefix: String("parameters="))
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreDeclarationRecordsConstructMemberSummary(records: String, name: String): String {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return String("")
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
        if declarationKind == String("construct") && declarationName == name {
            return compilerCoreRecordField(record: record, prefix: String("members="))
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return String("")
}

function compilerCoreDeclarationRecordsConstructMemberType(records: String, constructName: String, memberName: String): String {
    let memberSummary: String(compilerCoreDeclarationRecordsConstructMemberSummary(records: records, name: constructName))
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: memberSummary))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: memberSummary, start: sourceIndex, prefix: String("member")) {
            let indexStart: Int(sourceIndex + 6)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: memberSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: memberSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let candidateName: String(memberSummary.substring(start: nameStart, end: nameEnd))
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: memberSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    if candidateName == memberName {
                        return memberSummary.substring(start: typeStart, end: typeEnd)
                    }
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return String("")
}

function compilerCoreLLVMTypeNameForRangeType(typeName: String): String {
    if typeName == String("Bool") {
        return String("i1")
    }

    if typeName == String("Optional<String>") {
        return String("ptr")
    }

    if typeName == String("TextBuffer") {
        return String("ptr")
    }

    if typeName == String("IntBuffer") {
        return String("ptr")
    }

    if typeName == String("String") {
        return String("ptr")
    }

    if typeName == String("Int") {
        return String("i32")
    }

    return String("ptr")
}

function compilerCoreBinaryExpressionPart(summary: String, partIndex: Int): String {
    state summaryLength: Int(0)
    summaryLength: stringLength(value: summary)
    if summaryLength <= 8 {
        return String("")
    }

    state contentEnd: Int(0)
    contentEnd: summaryLength - 1
    state sourceIndex: Int(7)
    state depth: Int(0)
    state currentPart: Int(0)
    state partStart: Int(7)

    while sourceIndex < contentEnd {
        let character: String(summary.substring(start: sourceIndex, end: sourceIndex + 1))
        if character == String("(") {
            depth: depth + 1
        } else if character == String(")") {
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            if currentPart == partIndex {
                return summary.substring(start: partStart, end: sourceIndex)
            }
            currentPart: currentPart + 1
            partStart: sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    if currentPart == partIndex {
        return summary.substring(start: partStart, end: contentEnd)
    }

    return String("")
}

function compilerCoreLLVMInstructionForOperator(operatorText: String): String {
    if operatorText == String("==") {
        return String("icmp eq")
    }

    if operatorText == String("!=") || operatorText == String("bangEqual") {
        return String("icmp ne")
    }

    if operatorText == String("<") || operatorText == String("less") {
        return String("icmp slt")
    }

    if operatorText == String("<=") || operatorText == String("lessEqual") {
        return String("icmp sle")
    }

    if operatorText == String(">") || operatorText == String("greater") {
        return String("icmp sgt")
    }

    if operatorText == String(">=") || operatorText == String("greaterEqual") {
        return String("icmp sge")
    }

    if operatorText == String("&&") || operatorText == String("andAnd") {
        return String("and")
    }

    if operatorText == String("||") || operatorText == String("orOr") {
        return String("or")
    }

    if operatorText == String("+") || operatorText == String("plus") {
        return String("add")
    }

    if operatorText == String("-") || operatorText == String("minus") {
        return String("sub")
    }

    if operatorText == String("*") || operatorText == String("asterisk") {
        return String("mul")
    }

    if operatorText == String("/") || operatorText == String("slash") {
        return String("sdiv")
    }

    if operatorText == String("%") || operatorText == String("percent") {
        return String("srem")
    }

    return String("add")
}

function compilerCoreLLVMResultTypeForOperator(operatorText: String): String {
    if operatorText == String("==")
        || operatorText == String("!=")
        || operatorText == String("bangEqual")
        || operatorText == String("<")
        || operatorText == String("<=")
        || operatorText == String(">")
        || operatorText == String(">=")
        || operatorText == String("less")
        || operatorText == String("lessEqual")
        || operatorText == String("greater")
        || operatorText == String("greaterEqual")
        || operatorText == String("&&")
        || operatorText == String("andAnd")
        || operatorText == String("||")
        || operatorText == String("orOr")
    {
        return String("i1")
    }

    return String("i32")
}

function compilerCoreParseMainBlock(source: String): Optional<CompilerMainBlock> {
    let maybeToken: Optional<RangeLexedToken>(compilerCoreFindMainAttributeToken(source: source))
    if maybeToken == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: 0))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    return compilerCoreParseMainBlockBody(source: source, token: token)
}

function compilerCoreFindMainAttributeToken(source: String): Optional<RangeLexedToken> {
    let sourceLength: Int(stringLength(value: source))
    let attributeStart: Int(compilerCoreFindMainAttributeStart(source: source))
    if attributeStart >= sourceLength {
        return nil
    }

    return RangeLexedToken(kind: String("macroAttribute"), start: attributeStart, end: attributeStart + 5, text: compilerCoreMainAttributeText())
}

function compilerCoreFindMainAttributeStart(source: String): Int {
    return stringIndexOf(source: source, needle: compilerCoreMainAttributeText(), start: 0)
}

function compilerCoreMainAttributeText(): String {
    let atSign: String("@")
    return "\(atSign)main"
}

function compilerCoreTokenIsMainAttribute(token: RangeLexedToken): Bool {
    if token.kind != String("macroAttribute") {
        return false
    }
    return token.text == compilerCoreMainAttributeText()
}

function compilerCoreParseMainBlockBody(source: String, token: RangeLexedToken): Optional<CompilerMainBlock> {
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseMainBraceRange(source: source, start: token.end))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: token.end, end: token.end, next: token.end))
    let body: CompilerSourceRange(maybeBody ?? bodyFallback)
    return compilerCoreMainBlockFromRange(attributeStart: token.start, body: body)
}

function compilerCoreParseMainBraceRange(source: String, start: Int): Optional<CompilerSourceRange> {
    let sourceLength: Int(stringLength(value: source))
    let leftBrace: Int(stringIndexOf(source: source, needle: String("{"), start: start))
    if leftBrace >= sourceLength {
        return nil
    }

    return compilerCoreParseBraceRangeFromDepth(source: source, bodyStart: leftBrace + 1, searchStart: leftBrace + 1, depth: 1)
}

function compilerCoreParseBraceRangeFromDepth(source: String, bodyStart: Int, searchStart: Int, depth: Int): Optional<CompilerSourceRange> {
    let sourceLength: Int(stringLength(value: source))
    let nextLeft: Int(stringIndexOf(source: source, needle: String("{"), start: searchStart))
    let nextRight: Int(stringIndexOf(source: source, needle: String("}"), start: searchStart))
    if nextRight >= sourceLength {
        return nil
    }

    if nextLeft < nextRight {
        return compilerCoreParseBraceRangeFromDepth(source: source, bodyStart: bodyStart, searchStart: nextLeft + 1, depth: depth + 1)
    }

    return compilerCoreParseBraceRangeClosing(source: source, bodyStart: bodyStart, closingBrace: nextRight, depth: depth)
}

function compilerCoreParseBraceRangeClosing(source: String, bodyStart: Int, closingBrace: Int, depth: Int): Optional<CompilerSourceRange> {
    if depth == 1 {
        return CompilerSourceRange(start: bodyStart, end: closingBrace, next: closingBrace + 1)
    }

    return compilerCoreParseBraceRangeFromDepth(source: source, bodyStart: bodyStart, searchStart: closingBrace + 1, depth: depth - 1)
}

function compilerCoreMainBlockFromRange(attributeStart: Int, body: CompilerSourceRange): CompilerMainBlock {
    return CompilerMainBlock(
        attributeStart: attributeStart,
        bodyStart: body.start,
        bodyEnd: body.end
    )
}

function compilerCoreBlockStatementSummary(program: CompilerProgram, block: CompilerBlock): String {
    let parsedBlock: CompilerParsedBlock(parseCompilerBlock(program: program, block: block))
    return parsedBlock.statementSummary
}

function compilerCoreMainParsedBlock(program: CompilerProgram): CompilerParsedBlock {
    return CompilerParsedBlock(
        block: program.mainBlock,
        statementRecords: program.mainStatementRecords,
        statementSummary: program.mainStatementSummary
    )
}

function compilerCoreStatementRecordsASTSummary(records: String): String {
    state output: String("")
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: records))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        output: "\(output)ast\tstatement\t\(compilerCoreStatementSummary(statement: statement))\n"
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return output
}

function compilerCoreLLVMLowerLinearStatement(context: CompilerLLVMLoweringContext, statement: CompilerStatement, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if (statement.kind == String("let") || statement.kind == String("state")) && compilerCoreCanLowerLocalType(context: context, typeName: statement.typeName) {
        let loweredLinearLocal: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: statement.typeName, temporaryIndex: temporaryIndex))
        return CompilerLLVMLoweredLinearStatement(
            handled: true,
            instructionRecords: loweredLinearLocal.instructionRecords,
            localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: statement.name, operand: loweredLinearLocal.operand, typeName: loweredLinearLocal.typeName, rangeTypeName: statement.typeName))",
            nextTemporary: loweredLinearLocal.nextTemporary,
            hasReturn: false,
            returnLLVMType: String(""),
            returnLLVMValue: String("")
        )
    }

    if statement.kind == String("expression") {
        let loweredLinearExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
        return CompilerLLVMLoweredLinearStatement(
            handled: true,
            instructionRecords: loweredLinearExpression.instructionRecords,
            localValues: localValues,
            nextTemporary: loweredLinearExpression.nextTemporary,
            hasReturn: false,
            returnLLVMType: String(""),
            returnLLVMValue: String("")
        )
    }

    if statement.kind == String("assignment") {
        state linearAssignmentName: String("")
        linearAssignmentName: statement.name
        if linearAssignmentName == String("") {
            linearAssignmentName: compilerCoreIdentifierExpressionRecordName(record: statement.targetRecord, fallbackSummary: statement.targetSummary)
        }
        return compilerCoreLLVMLowerLinearStatementRecordAssignmentName(context: context, assignmentName: linearAssignmentName, expressionSummary: statement.expressionSummary, expressionRecord: statement.expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statement.kind == String("return") {
        let loweredLinearReturn: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: expectedReturnType, temporaryIndex: temporaryIndex))
        return CompilerLLVMLoweredLinearStatement(
            handled: true,
            instructionRecords: loweredLinearReturn.instructionRecords,
            localValues: localValues,
            nextTemporary: loweredLinearReturn.nextTemporary,
            hasReturn: true,
            returnLLVMType: compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType),
            returnLLVMValue: loweredLinearReturn.operand
        )
    }

    return CompilerLLVMLoweredLinearStatement(
        handled: false,
        instructionRecords: String(""),
        localValues: localValues,
        nextTemporary: temporaryIndex,
        hasReturn: false,
        returnLLVMType: String(""),
        returnLLVMValue: String("")
    )
}

function compilerCoreCanLowerLocalType(context: CompilerLLVMLoweringContext, typeName: String): Bool {
    if typeName == String("Int") {
        return true
    }
    if typeName == String("Bool") {
        return true
    }
    if typeName == String("String") {
        return true
    }
    if typeName == String("TextBuffer") {
        return true
    }
    if typeName == String("IntBuffer") {
        return true
    }
    if compilerCoreTypeIsOptionalPointer(typeName: typeName) {
        return true
    }
    if compilerLLVMLoweringContextContainsConstruct(context: context, name: typeName) {
        return true
    }
    return false
}

function compilerCoreTypeIsOptionalPointer(typeName: String): Bool {
    return hasRangePrefix(source: typeName, start: 0, prefix: String("Optional<"))
}

function compilerCoreLLVMLowerReturnStatementRecords(context: CompilerLLVMLoweringContext, statementRecords: String, localValues: String, temporaryIndex: Int, breakLabel: String, continueLabel: String, expectedReturnType: String): CompilerLLVMLoweredReturnBlock {
    state llvmInstructionRecords: String("")
    state llvmLocalValues: String("")
    llvmLocalValues: localValues
    state llvmTemporaryIndex: Int(0)
    llvmTemporaryIndex: temporaryIndex
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: statementRecords))
    let expectedLLVMReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
    let defaultReturnValue: String(compilerCoreLLVMDefaultReturnValue(typeName: expectedLLVMReturnType))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return CompilerLLVMLoweredReturnBlock(
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                hasReturn: false,
                returnLLVMType: expectedLLVMReturnType,
                returnValue: defaultReturnValue,
                hasJump: false,
                jumpLabel: String("")
            )
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        let loweredLinearNestedStatement: CompilerLLVMLoweredLinearStatement(compilerCoreLLVMLowerLinearStatement(context: context, statement: statement, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType))
        if loweredLinearNestedStatement.handled {
            if loweredLinearNestedStatement.hasReturn {
                return CompilerLLVMLoweredReturnBlock(
                    instructionRecords: "\(llvmInstructionRecords)\(loweredLinearNestedStatement.instructionRecords)",
                    localValues: loweredLinearNestedStatement.localValues,
                    nextTemporary: loweredLinearNestedStatement.nextTemporary,
                    hasReturn: true,
                    returnLLVMType: loweredLinearNestedStatement.returnLLVMType,
                    returnValue: loweredLinearNestedStatement.returnLLVMValue,
                    hasJump: false,
                    jumpLabel: String("")
                )
            }

            llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearNestedStatement.instructionRecords)"
            llvmLocalValues: loweredLinearNestedStatement.localValues
            llvmTemporaryIndex: loweredLinearNestedStatement.nextTemporary
        } else if statement.kind == String("break") && breakLabel != String("") {
            return CompilerLLVMLoweredReturnBlock(
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                hasReturn: false,
                returnLLVMType: expectedLLVMReturnType,
                returnValue: defaultReturnValue,
                hasJump: true,
                jumpLabel: breakLabel
            )
        } else if statement.kind == String("continue") && continueLabel != String("") {
            return CompilerLLVMLoweredReturnBlock(
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                hasReturn: false,
                returnLLVMType: expectedLLVMReturnType,
                returnValue: defaultReturnValue,
                hasJump: true,
                jumpLabel: continueLabel
            )
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: statementRecords, start: statementIndex)
    }

    return CompilerLLVMLoweredReturnBlock(
        instructionRecords: llvmInstructionRecords,
        localValues: llvmLocalValues,
        nextTemporary: llvmTemporaryIndex,
        hasReturn: false,
        returnLLVMType: expectedLLVMReturnType,
        returnValue: defaultReturnValue,
        hasJump: false,
        jumpLabel: String("")
    )
}

function compilerCoreParseStatements(program: CompilerProgram, block: CompilerBlock): CompilerParsedStatements {
    let recordsBuffer: TextBuffer(textBufferCreate(capacity: 4096))
    let summaryBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    return compilerCoreParseStatementsIntoTextBuffers(program: program, block: block, recordsBuffer: recordsBuffer, summaryBuffer: summaryBuffer)
}

function compilerCoreParseStatementsIntoTextBuffers(program: CompilerProgram, block: CompilerBlock, recordsBuffer: TextBuffer, summaryBuffer: TextBuffer): CompilerParsedStatements {
    state sourceIndex: Int(compilerCoreBlockStart(block: block))
    state statementCount: Int(0)
    let blockEnd: Int(compilerCoreBlockEnd(block: block))
    while sourceIndex < blockEnd {
        sourceIndex: compilerCoreFirstNonWhitespaceIndex(source: program.source, start: sourceIndex, end: blockEnd)
        if sourceIndex < blockEnd {
            let maybeStatement: Optional<CompilerStatement>(parseCompilerStatement(program: program, start: sourceIndex, bodyEnd: blockEnd))
            if maybeStatement == nil {
                sourceIndex: sourceIndex + 1
            } else {
                let fallback: CompilerStatement(compilerCoreMissingStatement(start: sourceIndex, end: sourceIndex + 1))
                let statement: CompilerStatement(maybeStatement ?? fallback)
                textBufferAppend(buffer: recordsBuffer, text: compilerCoreStatementRecord(statement: statement))
                textBufferAppend(buffer: summaryBuffer, text: String("statement"))
                textBufferAppendInt(buffer: summaryBuffer, value: statementCount)
                textBufferAppend(buffer: summaryBuffer, text: String("="))
                textBufferAppend(buffer: summaryBuffer, text: statement.summary)
                textBufferAppend(buffer: summaryBuffer, text: String(";"))
                sourceIndex: statement.end
                statementCount: statementCount + 1
            }
        }
    }
    return compilerCoreParsedStatementsFromTextBuffers(block: block, recordsBuffer: recordsBuffer, summaryBuffer: summaryBuffer, statementCount: statementCount)
}

function compilerCoreParsedStatementsFromTextBuffers(block: CompilerBlock, recordsBuffer: TextBuffer, summaryBuffer: TextBuffer, statementCount: Int): CompilerParsedStatements {
    let records: String(textBufferMaterialize(buffer: recordsBuffer))
    let summary: String(textBufferMaterialize(buffer: summaryBuffer))
    textBufferDestroy(buffer: recordsBuffer)
    textBufferDestroy(buffer: summaryBuffer)
    return CompilerParsedStatements(records: records, summary: summary, count: statementCount, start: compilerCoreBlockStart(block: block), end: compilerCoreBlockEnd(block: block))
}

function compilerCoreBlockStart(block: CompilerBlock): Int {
    return block.start
}

function compilerCoreBlockEnd(block: CompilerBlock): Int {
    return block.end
}

function compilerCoreFirstNonWhitespaceIndex(source: String, start: Int, end: Int): Int {
    if start >= end {
        return end
    }
    if isRangeLexerWhitespace(character: source.character(index: start)) {
        return compilerCoreFirstNonWhitespaceIndex(source: source, start: start + 1, end: end)
    }
    return start
}

function compilerCoreMissingStatement(start: Int, end: Int): CompilerStatement {
    let missingExpression: CompilerExpression(compilerCoreMissingExpression(start: start))
    return CompilerStatement(kind: String("missing"), name: String(""), typeName: String(""), targetSummary: String(""), targetRecord: String(""), expressionKind: String("missing"), expressionValue: String(""), expressionSummary: String("missing"), expressionRecord: missingExpression.record, bodyStart: 0, bodyEnd: 0, elseBodyStart: 0, elseBodyEnd: 0, bodyStatementRecords: String(""), elseStatementRecords: String(""), summary: String(""), start: start, end: end)
}

function compilerCoreStatementRecord(statement: CompilerStatement): String {
    let head: String(compilerCoreStatementRecordHead(statement: statement))
    let expression: String(compilerCoreStatementRecordExpression(statement: statement))
    let ranges: String(compilerCoreStatementRecordRanges(statement: statement))
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    textBufferAppend(buffer: outputBuffer, text: head)
    textBufferAppend(buffer: outputBuffer, text: expression)
    textBufferAppend(buffer: outputBuffer, text: ranges)
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordHead(statement: CompilerStatement): String {
    let targetRecord: String(compilerCoreStatementRecordEncodeValue(value: statement.targetRecord))
    let expressionValue: String(compilerCoreStatementRecordEncodeValue(value: statement.expressionValue))
    state targetSummary: String("")
    targetSummary: statement.targetSummary
    if statement.targetRecord != String("") {
        targetSummary: String("")
    }
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    textBufferAppend(buffer: outputBuffer, text: "kind=\(statement.kind)|name=\(statement.name)|type=\(statement.typeName)|target=\(targetSummary)|targetRecord=")
    textBufferAppend(buffer: outputBuffer, text: targetRecord)
    textBufferAppend(buffer: outputBuffer, text: "|expressionKind=\(statement.expressionKind)|expressionValue=\(expressionValue)|")
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordExpression(statement: CompilerStatement): String {
    let expressionRecord: String(compilerCoreStatementRecordEncodeValue(value: statement.expressionRecord))
    state expressionSummary: String("")
    expressionSummary: statement.expressionSummary
    if statement.expressionRecord != String("") {
        expressionSummary: String("")
    }
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    textBufferAppend(buffer: outputBuffer, text: "expression=\(expressionSummary)|expressionRecord=")
    textBufferAppend(buffer: outputBuffer, text: expressionRecord)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyStart="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.bodyStart)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyEnd="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.bodyEnd)
    textBufferAppend(buffer: outputBuffer, text: String("|elseBodyStart="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.elseBodyStart)
    textBufferAppend(buffer: outputBuffer, text: String("|elseBodyEnd="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.elseBodyEnd)
    textBufferAppend(buffer: outputBuffer, text: String("|"))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordRanges(statement: CompilerStatement): String {
    let bodyRecords: String(compilerCoreStatementRecordEncodeValue(value: statement.bodyStatementRecords))
    let elseRecords: String(compilerCoreStatementRecordEncodeValue(value: statement.elseStatementRecords))
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    textBufferAppend(buffer: outputBuffer, text: String("start="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.start)
    textBufferAppend(buffer: outputBuffer, text: String("|end="))
    textBufferAppendInt(buffer: outputBuffer, value: statement.end)
    textBufferAppend(buffer: outputBuffer, text: String("|bodyRecords="))
    textBufferAppend(buffer: outputBuffer, text: bodyRecords)
    textBufferAppend(buffer: outputBuffer, text: String("|elseRecords="))
    textBufferAppend(buffer: outputBuffer, text: elseRecords)
    textBufferAppend(buffer: outputBuffer, text: String("|summary=~"))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordAt(records: String, start: Int): String {
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: String("~")))
    if recordEnd < 0 {
        return String("")
    }
    return stringViewFrom(source: records, start: start)
}

function compilerCoreStatementRecordNextIndex(records: String, start: Int): Int {
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: String("~")))
    if recordEnd < 0 {
        return stringLength(value: records)
    }
    return recordEnd + 1
}

function compilerCoreStatementRecordField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreStatementRecordTrailingField(record: String, prefix: String): String {
    return compilerCoreDelimitedRecordField(record: record, prefix: prefix)
}

function compilerCoreStatementRecordEncodeValue(value: String): String {
    let valueLength: Int(stringLength(value: value))
    state encodedLength: Int(valueLength)
    state sizingIndex: Int(0)
    while sizingIndex < valueLength {
        let sizingByte: Int(stringByteAt(source: value, index: sizingIndex))
        if sizingByte == 64 { encodedLength: encodedLength + 3 }
        if sizingByte == 124 { encodedLength: encodedLength + 5 }
        if sizingByte == 126 { encodedLength: encodedLength + 6 }
        if sizingByte == 10 { encodedLength: encodedLength + 8 }
        if sizingByte == 59 { encodedLength: encodedLength + 10 }
        sizingIndex: sizingIndex + 1
    }
    let outputBuffer: TextBuffer(textBufferCreate(capacity: encodedLength))
    state sourceIndex: Int(0)

    while sourceIndex < valueLength {
        let byte: Int(stringByteAt(source: value, index: sourceIndex))
        if byte == 64 {
            if textBufferAppend(buffer: outputBuffer, text: String("@AT@")) != 0 { return String("") }
        } else if byte == 124 {
            if textBufferAppend(buffer: outputBuffer, text: String("@PIPE@")) != 0 { return String("") }
        } else if byte == 126 {
            if textBufferAppend(buffer: outputBuffer, text: String("@TILDE@")) != 0 { return String("") }
        } else if byte == 10 {
            if textBufferAppend(buffer: outputBuffer, text: String("@NEWLINE@")) != 0 { return String("") }
        } else if byte == 59 {
            if textBufferAppend(buffer: outputBuffer, text: String("@SEMICOLON@")) != 0 { return String("") }
        } else {
            if textBufferAppendCharacter(buffer: outputBuffer, source: value, index: sourceIndex) != 0 { return String("") }
        }
        sourceIndex: sourceIndex + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreStatementRecordDecodeValue(value: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    state sourceIndex: Int(0)
    let valueLength: Int(stringLength(value: value))

    while sourceIndex < valueLength {
        let byte: Int(stringByteAt(source: value, index: sourceIndex))
        if byte != 64 {
            if textBufferAppendCharacter(buffer: outputBuffer, source: value, index: sourceIndex) != 0 { return String("") }
            sourceIndex: sourceIndex + 1
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@PIPE@")) {
            if textBufferAppend(buffer: outputBuffer, text: String("|")) != 0 { return String("") }
            sourceIndex: sourceIndex + 6
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@TILDE@")) {
            if textBufferAppend(buffer: outputBuffer, text: String("~")) != 0 { return String("") }
            sourceIndex: sourceIndex + 7
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@NEWLINE@")) {
            if textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter()) != 0 { return String("") }
            sourceIndex: sourceIndex + 9
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@SEMICOLON@")) {
            if textBufferAppend(buffer: outputBuffer, text: String(";")) != 0 { return String("") }
            sourceIndex: sourceIndex + 11
        } else if hasRangePrefix(source: value, start: sourceIndex, prefix: String("@AT@")) {
            if textBufferAppend(buffer: outputBuffer, text: String("@")) != 0 { return String("") }
            sourceIndex: sourceIndex + 4
        } else {
            if textBufferAppendCharacter(buffer: outputBuffer, source: value, index: sourceIndex) != 0 { return String("") }
            sourceIndex: sourceIndex + 1
        }
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreParseDecimalInt(value: String): Int {
    state result: Int(0)
    state sourceIndex: Int(0)
    let valueLength: Int(stringLength(value: value))

    while sourceIndex < valueLength {
        let character: String(value.substring(start: sourceIndex, end: sourceIndex + 1))
        result: (result * 10) + compilerCoreDecimalDigitValue(character: character)
        sourceIndex: sourceIndex + 1
    }

    return result
}

function compilerCoreDecimalDigitValue(character: String): Int {
    if character == String("1") {
        return 1
    }
    if character == String("2") {
        return 2
    }
    if character == String("3") {
        return 3
    }
    if character == String("4") {
        return 4
    }
    if character == String("5") {
        return 5
    }
    if character == String("6") {
        return 6
    }
    if character == String("7") {
        return 7
    }
    if character == String("8") {
        return 8
    }
    if character == String("9") {
        return 9
    }

    return 0
}

function compilerCoreStatementFromRecord(record: String): CompilerStatement {
    let kind: String(compilerCoreStatementRecordField(record: record, prefix: String("kind=")))
    let name: String(compilerCoreStatementRecordField(record: record, prefix: String("name=")))
    let typeName: String(compilerCoreStatementRecordField(record: record, prefix: String("type=")))
    let targetRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("targetRecord="))))
    let expressionKind: String(compilerCoreStatementRecordField(record: record, prefix: String("expressionKind=")))
    let expressionValue: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("expressionValue="))))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("expressionRecord="))))
    state targetSummary: String("")
    targetSummary: compilerCoreStatementRecordField(record: record, prefix: String("target="))
    if targetSummary == String("") && targetRecord != String("") {
        targetSummary: compilerCoreExpressionRecordSummary(record: targetRecord)
    }
    state expressionSummary: String("")
    expressionSummary: compilerCoreStatementRecordField(record: record, prefix: String("expression="))
    if expressionSummary == String("") && expressionRecord != String("") {
        expressionSummary: compilerCoreExpressionRecordSummary(record: expressionRecord)
    }
    let bodyStart: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("bodyStart="))))
    let bodyEnd: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("bodyEnd="))))
    let elseBodyStart: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("elseBodyStart="))))
    let elseBodyEnd: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("elseBodyEnd="))))
    let start: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("start="))))
    let end: Int(compilerCoreParseDecimalInt(value: compilerCoreStatementRecordField(record: record, prefix: String("end="))))
    let bodyStatementRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("bodyRecords="))))
    let elseStatementRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: record, prefix: String("elseRecords="))))
    let summary: String(compilerCoreStatementRecordTrailingField(record: record, prefix: String("summary=")))

    return CompilerStatement(
        kind: kind,
        name: name,
        typeName: typeName,
        targetSummary: targetSummary,
        targetRecord: targetRecord,
        expressionKind: expressionKind,
        expressionValue: expressionValue,
        expressionSummary: expressionSummary,
        expressionRecord: expressionRecord,
        bodyStart: bodyStart,
        bodyEnd: bodyEnd,
        elseBodyStart: elseBodyStart,
        elseBodyEnd: elseBodyEnd,
        bodyStatementRecords: bodyStatementRecords,
        elseStatementRecords: elseStatementRecords,
        summary: summary,
        start: start,
        end: end
    )
}

function compilerCoreNameListContains(names: String, name: String): Bool {
    let namesLength: Int(stringLength(value: names))
    let nameRecord: String("\(name);")
    let nameRecordLength: Int(stringLength(value: nameRecord))
    state sourceIndex: Int(0)

    while sourceIndex < namesLength {
        if hasRangePrefix(source: names, start: sourceIndex, prefix: nameRecord) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreNameListNameAt(names: String, start: Int): String {
    let namesLength: Int(stringLength(value: names))
    state sourceIndex: Int(0)
    sourceIndex: start

    while sourceIndex < namesLength {
        if names.substring(start: sourceIndex, end: sourceIndex + 1) == String(";") {
            return names.substring(start: start, end: sourceIndex)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function compilerCoreNameListNextIndex(names: String, start: Int): Int {
    let namesLength: Int(stringLength(value: names))
    state sourceIndex: Int(0)
    sourceIndex: start

    while sourceIndex < namesLength {
        if names.substring(start: sourceIndex, end: sourceIndex + 1) == String(";") {
            return sourceIndex + 1
        }
        sourceIndex: sourceIndex + 1
    }

    return namesLength
}

function compilerCoreNameListAppendingMissing(names: String, additionalNames: String): String {
    state output: String("")
    output: names
    state sourceIndex: Int(0)
    let additionalNamesLength: Int(stringLength(value: additionalNames))

    while sourceIndex < additionalNamesLength {
        let name: String(compilerCoreNameListNameAt(names: additionalNames, start: sourceIndex))
        if name != String("") && !compilerCoreNameListContains(names: output, name: name) {
            output: "\(output)\(name);"
        }
        sourceIndex: compilerCoreNameListNextIndex(names: additionalNames, start: sourceIndex)
    }

    return output
}

function compilerCoreStatementRecordsAssignmentNames(records: String): String {
    state assignmentNames: String("")
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return assignmentNames
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("assignment") {
            state assignmentName: String("")
            assignmentName: statement.name
            if assignmentName == String("") {
                assignmentName: compilerCoreIdentifierExpressionRecordName(record: statement.targetRecord, fallbackSummary: statement.targetSummary)
            }
            if assignmentName != String("") && !compilerCoreNameListContains(names: assignmentNames, name: assignmentName) {
                assignmentNames: "\(assignmentNames)\(assignmentName);"
            }
        }
        assignmentNames: compilerCoreNameListAppendingMissing(names: assignmentNames, additionalNames: compilerCoreStatementRecordsAssignmentNames(records: statement.bodyStatementRecords))
        assignmentNames: compilerCoreNameListAppendingMissing(names: assignmentNames, additionalNames: compilerCoreStatementRecordsAssignmentNames(records: statement.elseStatementRecords))
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return assignmentNames
}

function compilerCoreStatementRecordsContainReturn(records: String): Bool {
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return false
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("return") {
            return true
        }
        if compilerCoreStatementRecordsContainReturn(records: statement.bodyStatementRecords) {
            return true
        }
        if compilerCoreStatementRecordsContainReturn(records: statement.elseStatementRecords) {
            return true
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return false
}

function compilerCoreStatementRecordsContainControl(records: String): Bool {
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return false
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("if") || statement.kind == String("while") {
            return true
        }
        if compilerCoreStatementRecordsContainControl(records: statement.bodyStatementRecords) {
            return true
        }
        if compilerCoreStatementRecordsContainControl(records: statement.elseStatementRecords) {
            return true
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return false
}

function compilerCoreStatementRecordsCalledFunctionNames(records: String): String {
    state calledNames: String("")
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return calledNames
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: statement.expressionRecord, fallbackSummary: statement.expressionSummary))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: statement.targetRecord, fallbackSummary: statement.targetSummary))
        if statement.kind == String("if") || statement.kind == String("while") {
            calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreStatementRecordsCalledFunctionNames(records: statement.bodyStatementRecords))
            calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreStatementRecordsCalledFunctionNames(records: statement.elseStatementRecords))
        }
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return calledNames
}

function compilerCoreReachableFunctionNames(program: CompilerProgram, roots: String): String {
    let recordsLength: Int(stringLength(value: program.declarationRecords))
    let rootedNames: String(compilerCoreReachableFunctionRootNames(program: program, roots: roots, sourceIndex: 0, recordsLength: recordsLength, reachableNames: roots))
    return compilerCoreReachableFunctionNamesExpanding(program: program, reachableNames: rootedNames, previouslyExpandedNames: roots, recordsLength: recordsLength)
}

function compilerCoreReachableFunctionRootNames(program: CompilerProgram, roots: String, sourceIndex: Int, recordsLength: Int, reachableNames: String): String {
    if sourceIndex >= recordsLength {
        return reachableNames
    }

    let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
    if record == String("") {
        return reachableNames
    }

    let nextReachableNames: String(compilerCoreReachableFunctionRootNamesAppendingRecord(program: program, roots: roots, record: record, reachableNames: reachableNames))
    let nextSourceIndex: Int(compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex))
    return compilerCoreReachableFunctionRootNames(program: program, roots: roots, sourceIndex: nextSourceIndex, recordsLength: recordsLength, reachableNames: nextReachableNames)
}

function compilerCoreReachableFunctionRootNamesAppendingRecord(program: CompilerProgram, roots: String, record: String, reachableNames: String): String {
    let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if declarationKind == String("function") && compilerCoreNameListContains(names: roots, name: declarationName) {
        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if compilerCoreShouldExpandReachableFunction(program: program, declaration: declaration) {
            let bodyCalledNames: String(compilerCoreFunctionDeclarationCalledFunctionNames(program: program, declaration: declaration))
            return compilerCoreNameListAppendingMissing(names: reachableNames, additionalNames: bodyCalledNames)
        }
    }

    return reachableNames
}

function compilerCoreReachableFunctionNamesExpanding(program: CompilerProgram, reachableNames: String, previouslyExpandedNames: String, recordsLength: Int): String {
    let expandedNames: String(compilerCoreReachableFunctionNamesExpansionPass(program: program, reachableNames: reachableNames, previouslyExpandedNames: previouslyExpandedNames, sourceIndex: 0, recordsLength: recordsLength))
    if stringLength(value: expandedNames) > stringLength(value: reachableNames) {
        return compilerCoreReachableFunctionNamesExpanding(program: program, reachableNames: expandedNames, previouslyExpandedNames: reachableNames, recordsLength: recordsLength)
    }

    return expandedNames
}

function compilerCoreReachableFunctionNamesExpansionPass(program: CompilerProgram, reachableNames: String, previouslyExpandedNames: String, sourceIndex: Int, recordsLength: Int): String {
    if sourceIndex >= recordsLength {
        return reachableNames
    }

    let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
    if record == String("") {
        return reachableNames
    }

    let nextReachableNames: String(compilerCoreReachableFunctionNamesAppendingRecord(program: program, reachableNames: reachableNames, previouslyExpandedNames: previouslyExpandedNames, record: record))
    let nextSourceIndex: Int(compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex))
    return compilerCoreReachableFunctionNamesExpansionPass(program: program, reachableNames: nextReachableNames, previouslyExpandedNames: previouslyExpandedNames, sourceIndex: nextSourceIndex, recordsLength: recordsLength)
}

function compilerCoreReachableFunctionNamesAppendingRecord(program: CompilerProgram, reachableNames: String, previouslyExpandedNames: String, record: String): String {
    let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if declarationKind == String("function") && compilerCoreNameListContains(names: reachableNames, name: declarationName) && !compilerCoreNameListContains(names: previouslyExpandedNames, name: declarationName) {
        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if compilerCoreShouldExpandReachableFunction(program: program, declaration: declaration) {
            let bodyCalledNames: String(compilerCoreFunctionDeclarationCalledFunctionNames(program: program, declaration: declaration))
            return compilerCoreNameListAppendingMissing(names: reachableNames, additionalNames: bodyCalledNames)
        }
    }

    return reachableNames
}

function compilerCoreShouldExpandReachableFunction(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): Bool {
    return compilerCoreSelectedHelperExclusionReason(program: program, declaration: declaration) == String("")
}

function compilerCoreFunctionDeclarationCalledFunctionNames(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): String {
    return compilerCoreStatementRecordsCalledFunctionNames(records: compilerCoreFunctionDeclarationStatementRecords(program: program, declaration: declaration))
}

function compilerCoreFunctionDeclarationStatementRecords(program: CompilerProgram, declaration: CompilerTopLevelDeclaration): String {
    if declaration.statementRecords != String("") {
        return declaration.statementRecords
    }

    let functionBlock: CompilerBlock(CompilerBlock(start: declaration.bodyStart, end: declaration.bodyEnd))
    let parsedStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: functionBlock))
    return parsedStatements.records
}

function compilerCoreStatementRecordsWithoutExpressionRecords(records: String): String {
    state output: String("")
    state statementIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        let strippedBodyRecords: String(compilerCoreStatementRecordsWithoutExpressionRecords(records: statement.bodyStatementRecords))
        let strippedElseRecords: String(compilerCoreStatementRecordsWithoutExpressionRecords(records: statement.elseStatementRecords))
        let strippedStatement: CompilerStatement(CompilerStatement(
            kind: statement.kind,
            name: statement.name,
            typeName: statement.typeName,
            targetSummary: statement.targetSummary,
            targetRecord: String(""),
            expressionKind: statement.expressionKind,
            expressionValue: statement.expressionValue,
            expressionSummary: statement.expressionSummary,
            expressionRecord: String(""),
            bodyStart: statement.bodyStart,
            bodyEnd: statement.bodyEnd,
            elseBodyStart: statement.elseBodyStart,
            elseBodyEnd: statement.elseBodyEnd,
            bodyStatementRecords: strippedBodyRecords,
            elseStatementRecords: strippedElseRecords,
            summary: statement.summary,
            start: statement.start,
            end: statement.end
        ))
        output: "\(output)\(compilerCoreStatementRecord(statement: strippedStatement))"
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return output
}

function compilerCoreExpressionSummaryCalledFunctionNames(summary: String): String {
    state calledNames: String("")

    if hasRangePrefix(source: summary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: summary))
        if functionName != String("") {
            calledNames: "\(calledNames)\(functionName);"
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreCallArgumentsCalledFunctionNames(argumentsSummary: compilerCoreCallArgumentsSummary(summary: summary)))
        return calledNames
    }

    if hasRangePrefix(source: summary, start: 0, prefix: String("binary(")) {
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCoreBinaryExpressionPart(summary: summary, partIndex: 0)))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCoreBinaryExpressionPart(summary: summary, partIndex: 2)))
        return calledNames
    }

    if hasRangePrefix(source: summary, start: 0, prefix: String("prefix(")) {
        return compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCorePrefixExpressionOperand(summary: summary))
    }

    if hasRangePrefix(source: summary, start: 0, prefix: String("member(")) {
        return compilerCoreExpressionSummaryCalledFunctionNames(summary: compilerCoreMemberExpressionBase(summary: summary))
    }

    return calledNames
}

function compilerCoreExpressionRecordCalledFunctionNames(record: String, fallbackSummary: String): String {
    if record == String("") {
        return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
    }

    state calledNames: String("")
    let kind: String(compilerCoreExpressionRecordKind(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))

    if kind == String("stringLiteral") {
        let literalContent: String(compilerCoreStringLiteralContent(text: value))
        return compilerCoreInterpolatedStringContentCalledFunctionNames(content: literalContent)
    }

    if kind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: record))
        if compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") {
            let calleeFunctionName: String(compilerCoreExpressionRecordValue(record: calleeRecord))
            if calleeFunctionName != String("") {
                calledNames: "\(calledNames)\(calleeFunctionName);"
            }
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreCallArgumentRecordsCalledFunctionNames(records: compilerCoreExpressionRecordArguments(record: record)))
        return calledNames
    }

    if kind == String("binary") {
        if compilerCoreExpressionRecordLeft(record: record) == String("") || compilerCoreExpressionRecordRight(record: record) == String("") {
            return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordLeft(record: record), fallbackSummary: String("")))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordRight(record: record), fallbackSummary: String("")))
        return calledNames
    }

    if kind == String("prefix") || kind == String("member") {
        if compilerCoreExpressionRecordLeft(record: record) == String("") {
            return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
        }
        return compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordLeft(record: record), fallbackSummary: String(""))
    }

    if kind == String("index") {
        if compilerCoreExpressionRecordLeft(record: record) == String("") || compilerCoreExpressionRecordRight(record: record) == String("") {
            return compilerCoreExpressionSummaryCalledFunctionNames(summary: fallbackSummary)
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordLeft(record: record), fallbackSummary: String("")))
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreExpressionRecordRight(record: record), fallbackSummary: String("")))
        return calledNames
    }

    return calledNames
}

function compilerCoreInterpolatedStringContentCalledFunctionNames(content: String): String {
    state calledNames: String("")
    if !compilerCoreStringContentHasInterpolation(content: content) {
        return calledNames
    }

    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state sourceIndex: Int(0)

    while sourceIndex + 1 < contentLength {
        if stringCharacterAt(source: content, index: sourceIndex) == backslash && stringCharacterAt(source: content, index: sourceIndex + 1) == String("(") {
            let expressionEnd: Int(compilerCoreInterpolatedExpressionEnd(content: content, start: sourceIndex + 2))
            if expressionEnd < contentLength {
                let expressionText: String(stringSubstring(source: content, start: sourceIndex + 2, end: expressionEnd))
                let expressionLength: Int(stringLength(value: expressionText))
                let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: expressionText, start: 0, limit: expressionLength))
                if maybeExpression != nil {
                    let fallbackExpression: CompilerExpression(compilerCoreMissingExpression(start: 0))
                    let expression: CompilerExpression(maybeExpression ?? fallbackExpression)
                    calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: expression.record, fallbackSummary: expression.summary))
                }
                sourceIndex: expressionEnd + 1
            } else {
                sourceIndex: sourceIndex + 1
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return calledNames
}

function compilerCoreCallArgumentRecordsCalledFunctionNames(records: String): String {
    state calledNames: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreCallArgumentRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return calledNames
        }

        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionRecordCalledFunctionNames(record: compilerCoreCallArgumentExpressionRecord(record: record), fallbackSummary: compilerCoreCallArgumentExpressionSummary(record: record)))
        sourceIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: sourceIndex)
    }

    return calledNames
}

function compilerCoreCallArgumentsCalledFunctionNames(argumentsSummary: String): String {
    state calledNames: String("")
    state sourceIndex: Int(0)
    let argumentsLength: Int(stringLength(value: argumentsSummary))

    while sourceIndex < argumentsLength {
        let argumentExpression: String(compilerCoreCallArgumentExpression(argumentsSummary: argumentsSummary, start: sourceIndex))
        if argumentExpression == String("") {
            return calledNames
        }
        calledNames: compilerCoreNameListAppendingMissing(names: calledNames, additionalNames: compilerCoreExpressionSummaryCalledFunctionNames(summary: argumentExpression))
        sourceIndex: compilerCoreCallArgumentNextIndex(argumentsSummary: argumentsSummary, start: sourceIndex)
    }

    return calledNames
}

function parseCompilerBlock(program: CompilerProgram, block: CompilerBlock): CompilerParsedBlock {
    let parsedStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: block))
    return CompilerParsedBlock(
        block: block,
        statementRecords: parsedStatements.records,
        statementSummary: compilerCoreStatementRecordsASTSummary(records: parsedStatements.records)
    )
}

function compilerCoreLLVMLowerBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock): CompilerLLVMLoweredBlock {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: program.source))
    let captureStatus: Int(compilerTypedSyntaxCapture(source: program.source, tables: tables))
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    let context: CompilerLLVMLoweringContext(CompilerLLVMLoweringContext(program: program, tables: tables, declarationIndex: declarationIndex))
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithContext(context: context, parsedBlock: parsedBlock))
    compilerDeclarationIndexDestroy(index: declarationIndex)
    compilerSyntaxTablesDestroy(tables: tables)
    return loweredBlock
}

function compilerCoreLLVMLowerBlockWithContext(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock): CompilerLLVMLoweredBlock {
    state initialTemporaryIndex: Int(0)
    let declarationRecordsLength: Int(stringLength(value: context.program.declarationRecords))
    if declarationRecordsLength > 0 {
        initialTemporaryIndex: declarationRecordsLength + 1
    }
    return compilerCoreLLVMLowerBlockWithLocals(context: context, parsedBlock: parsedBlock, initialLocalValues: String(""), initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: String("Int"))
}

function compilerCoreLLVMLowerBlockWithLocalsForProgram(program: CompilerProgram, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredBlock {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: program.source))
    let captureStatus: Int(compilerTypedSyntaxCapture(source: program.source, tables: tables))
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    let context: CompilerLLVMLoweringContext(CompilerLLVMLoweringContext(program: program, tables: tables, declarationIndex: declarationIndex))
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithLocals(context: context, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType))
    compilerDeclarationIndexDestroy(index: declarationIndex)
    compilerSyntaxTablesDestroy(tables: tables)
    return loweredBlock
}

function compilerCoreLLVMLowerBlockWithLocals(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredBlock {
    return compilerCoreLLVMLowerBlockWithControl(context: context, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: String("entry"), fallthroughLabel: String(""), initialBranchIndex: 0)
}

function compilerCoreLLVMLowerBlockWithControl(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, fallthroughLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let directBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlock(context: context, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex))
    let directRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: directBlock))
    if directRenderedBlocks != String("") {
        return directBlock
    }
    if !compilerCoreStatementRecordsContainControl(records: parsedBlock.statementRecords) && (directBlock.instructionRecords != String("") || directBlock.localValues != initialLocalValues || directBlock.hasReturn) {
        if fallthroughLabel != String("") && !directBlock.hasReturn && directRenderedBlocks == String("") {
            let fallthroughTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: fallthroughLabel, falseLabel: String("")))
            let renderedFallthroughBlock: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: directBlock.instructionRecords, terminal: fallthroughTerminator))
            return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: context.program.declarationRecords, renderedBlocks: renderedFallthroughBlock, instructionRecords: directBlock.instructionRecords, localValues: directBlock.localValues, nextTemporary: directBlock.nextTemporary, nextBranchIndex: directBlock.nextBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: directBlock.returnLLVMType, returnLLVMValue: directBlock.returnLLVMValue)
        }
        return directBlock
    }

    return compilerCoreLLVMLowerBlockWithControlLegacy(context: context, parsedBlock: parsedBlock, initialLocalValues: initialLocalValues, initialTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, fallthroughLabel: fallthroughLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLoweredBlockRenderedBlocks(block: CompilerLLVMLoweredBlock): String {
    return block.renderedBlocks
}

function compilerCoreLLVMLowerDirectLinearRecordBlock(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    return compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(context: context, parsedBlock: parsedBlock, statementIndex: 0, llvmInstructionRecords: String(""), llvmLocalValues: initialLocalValues, llvmTemporaryIndex: initialTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let statementsLength: Int(stringLength(value: parsedBlock.statementRecords))
    if statementIndex >= statementsLength {
        let returnLLVMType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
        let returnLLVMValue: String(compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType))
        return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: context.program.declarationRecords, renderedBlocks: String(""), instructionRecords: llvmInstructionRecords, localValues: llvmLocalValues, nextTemporary: llvmTemporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
    }

    let statementRecord: String(compilerCoreStatementRecordAt(records: parsedBlock.statementRecords, start: statementIndex))
    return compilerCoreLLVMLowerDirectLinearRecordBlockWithRecord(context: context, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockWithRecord(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if statementRecord == String("") {
        return compilerCoreEmptyDirectLoweredBlock(context: context, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let loweredStatement: CompilerLLVMLoweredLinearStatement(compilerCoreLLVMLowerLinearStatementRecord(context: context, statementRecord: statementRecord, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType))
    return compilerCoreLLVMLowerDirectLinearRecordBlockWithLowered(context: context, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, loweredStatement: loweredStatement, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockWithLowered(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, loweredStatement: CompilerLLVMLoweredLinearStatement, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if !loweredStatement.handled {
        return compilerCoreLLVMLowerDirectLinearRecordBlockWithIf(context: context, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let nextInstructionRecords: String("\(llvmInstructionRecords)\(loweredStatement.instructionRecords)")
    return compilerCoreLLVMLowerDirectLinearRecordBlockAfterLowered(context: context, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, loweredStatement: loweredStatement, llvmInstructionRecords: nextInstructionRecords, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockWithIf(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let statementKind: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("kind=")))
    if statementKind == String("if") {
        return compilerCoreLLVMLowerDirectIfStatementRecord(context: context, parsedBlock: parsedBlock, statementIndex: statementIndex, statementRecord: statementRecord, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    return compilerCoreEmptyDirectLoweredBlock(context: context, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectIfStatementRecord(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, llvmInstructionRecords: String, llvmLocalValues: String, llvmTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let expressionSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("expression=")))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("expressionRecord="))))
    let bodyRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("bodyRecords="))))
    let elseRecords: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("elseRecords="))))
    if bodyRecords == String("") {
        return compilerCoreEmptyDirectLoweredBlock(context: context, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let loweredCondition: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: llvmLocalValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: String("Bool"), temporaryIndex: llvmTemporaryIndex))
    let thenLabel: String("if\(initialBranchIndex)")
    let thenBlock: CompilerParsedBlock(CompilerParsedBlock(block: parsedBlock.block, statementRecords: bodyRecords, statementSummary: String("")))
    let loweredThenBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlock(context: context, parsedBlock: thenBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: thenLabel, initialBranchIndex: initialBranchIndex + 1))
    return compilerCoreLLVMLowerDirectIfStatementRecordWithThen(context: context, parsedBlock: parsedBlock, statementIndex: statementIndex, bodyRecords: bodyRecords, elseRecords: elseRecords, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerDirectIfStatementRecordWithThen(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, bodyRecords: String, elseRecords: String, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, llvmLocalValues: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if !loweredThenBlock.hasReturn {
        return compilerCoreEmptyDirectLoweredBlock(context: context, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: loweredCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    if elseRecords != String("") {
        return compilerCoreLLVMLowerDirectIfStatementRecordWithElse(context: context, parsedBlock: parsedBlock, elseRecords: elseRecords, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, initialBranchIndex: initialBranchIndex)
    }

    let afterLabel: String("after\(initialBranchIndex)")
    let nextStatementIndex: Int(compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex))
    let loweredAfterBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(context: context, parsedBlock: parsedBlock, statementIndex: nextStatementIndex, llvmInstructionRecords: String(""), llvmLocalValues: llvmLocalValues, llvmTemporaryIndex: loweredThenBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: afterLabel, initialBranchIndex: loweredThenBlock.nextBranchIndex))
    return compilerCoreLLVMLowerDirectIfStatementRecordWithAfter(context: context, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredAfterBlock: loweredAfterBlock, llvmInstructionRecords: llvmInstructionRecords, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, afterLabel: afterLabel)
}

function compilerCoreLLVMLowerDirectIfStatementRecordWithElse(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, elseRecords: String, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, llvmLocalValues: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let elseLabel: String("else\(initialBranchIndex)")
    let elseBlock: CompilerParsedBlock(CompilerParsedBlock(block: parsedBlock.block, statementRecords: elseRecords, statementSummary: String("")))
    let loweredElseBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerDirectLinearRecordBlock(context: context, parsedBlock: elseBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredThenBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: elseLabel, initialBranchIndex: loweredThenBlock.nextBranchIndex))
    return compilerCoreLoweredDirectIfElseBlock(context: context, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredElseBlock: loweredElseBlock, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: llvmLocalValues, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, elseLabel: elseLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLoweredDirectIfElseBlock(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredElseBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, llvmLocalValues: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, elseLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if !loweredElseBlock.hasReturn {
        return compilerCoreEmptyDirectLoweredBlock(context: context, parsedBlock: parsedBlock, localValues: llvmLocalValues, temporaryIndex: loweredElseBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let branchInstructions: String("\(llvmInstructionRecords)\(loweredCondition.instructionRecords)")
    return compilerCoreRenderedDirectIfElseStatementRecord(context: context, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredElseBlock: loweredElseBlock, branchInstructions: branchInstructions, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, elseLabel: elseLabel)
}

function compilerCoreRenderedDirectIfElseStatementRecord(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredElseBlock: CompilerLLVMLoweredBlock, branchInstructions: String, initialBlockLabel: String, thenLabel: String, elseLabel: String): CompilerLLVMLoweredBlock {
    let branchTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: thenLabel, falseLabel: elseLabel))
    let renderedBranch: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: branchInstructions, terminal: branchTerminator))
    let thenRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredThenBlock))
    let elseRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredElseBlock))
    let renderedBlocks: String("\(renderedBranch)\(thenRenderedBlocks)\(elseRenderedBlocks)")
    let instructionRecords: String("\(branchInstructions)\(loweredThenBlock.instructionRecords)\(loweredElseBlock.instructionRecords)")
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: context.program.declarationRecords, renderedBlocks: renderedBlocks, instructionRecords: instructionRecords, localValues: loweredElseBlock.localValues, nextTemporary: loweredElseBlock.nextTemporary, nextBranchIndex: loweredElseBlock.nextBranchIndex, exitLabel: elseLabel, hasEntryBranch: true, entryBranchCondition: loweredCondition.operand, entryBranchThenLabel: thenLabel, entryBranchElseLabel: elseLabel, hasReturn: true, returnLLVMType: loweredElseBlock.returnLLVMType, returnLLVMValue: loweredElseBlock.returnLLVMValue)
}

function compilerCoreLLVMLowerDirectIfStatementRecordWithAfter(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredAfterBlock: CompilerLLVMLoweredBlock, llvmInstructionRecords: String, expectedReturnType: String, initialBlockLabel: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
    let afterRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredAfterBlock))
    if afterRenderedBlocks == String("") {
        return compilerCoreEmptyDirectLoweredBlock(context: context, parsedBlock: parsedBlock, localValues: loweredAfterBlock.localValues, temporaryIndex: loweredAfterBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: loweredAfterBlock.nextBranchIndex)
    }

    let branchInstructions: String("\(llvmInstructionRecords)\(loweredCondition.instructionRecords)")
    return compilerCoreRenderedDirectIfStatementRecord(context: context, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredThenBlock: loweredThenBlock, loweredAfterBlock: loweredAfterBlock, branchInstructions: branchInstructions, afterRenderedBlocks: afterRenderedBlocks, initialBlockLabel: initialBlockLabel, thenLabel: thenLabel, afterLabel: afterLabel)
}

function compilerCoreRenderedDirectIfStatementRecord(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredThenBlock: CompilerLLVMLoweredBlock, loweredAfterBlock: CompilerLLVMLoweredBlock, branchInstructions: String, afterRenderedBlocks: String, initialBlockLabel: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
    let branchTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: thenLabel, falseLabel: afterLabel))
    let renderedBranch: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: branchInstructions, terminal: branchTerminator))
    let thenRenderedBlocks: String(compilerCoreLLVMLoweredBlockRenderedBlocks(block: loweredThenBlock))
    let renderedBlocks: String("\(renderedBranch)\(thenRenderedBlocks)\(afterRenderedBlocks)")
    let instructionRecords: String("\(branchInstructions)\(loweredThenBlock.instructionRecords)\(loweredAfterBlock.instructionRecords)")
    return compilerCoreLoweredDirectIfBlock(context: context, parsedBlock: parsedBlock, loweredCondition: loweredCondition, loweredAfterBlock: loweredAfterBlock, renderedBlocks: renderedBlocks, instructionRecords: instructionRecords, thenLabel: thenLabel, afterLabel: afterLabel)
}

function compilerCoreLoweredDirectIfBlock(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredAfterBlock: CompilerLLVMLoweredBlock, renderedBlocks: String, instructionRecords: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: context.program.declarationRecords, renderedBlocks: renderedBlocks, instructionRecords: instructionRecords, localValues: loweredAfterBlock.localValues, nextTemporary: loweredAfterBlock.nextTemporary, nextBranchIndex: loweredAfterBlock.nextBranchIndex, exitLabel: loweredAfterBlock.exitLabel, hasEntryBranch: true, entryBranchCondition: loweredCondition.operand, entryBranchThenLabel: thenLabel, entryBranchElseLabel: afterLabel, hasReturn: loweredAfterBlock.hasReturn, returnLLVMType: loweredAfterBlock.returnLLVMType, returnLLVMValue: loweredAfterBlock.returnLLVMValue)
}

function compilerCoreLLVMLowerDirectLinearRecordBlockAfterLowered(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, loweredStatement: CompilerLLVMLoweredLinearStatement, llvmInstructionRecords: String, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if loweredStatement.hasReturn {
        return compilerCoreRenderedDirectReturnBlock(context: context, parsedBlock: parsedBlock, renderedInstructionRecords: llvmInstructionRecords, localValues: loweredStatement.localValues, temporaryIndex: loweredStatement.nextTemporary, returnLLVMType: loweredStatement.returnLLVMType, returnLLVMValue: loweredStatement.returnLLVMValue, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let nextStatementIndex: Int(compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex))
    return compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(context: context, parsedBlock: parsedBlock, statementIndex: nextStatementIndex, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: loweredStatement.localValues, llvmTemporaryIndex: loweredStatement.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerLinearStatementRecord(context: CompilerLLVMLoweringContext, statementRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    let statementKind: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("kind=")))
    let statementName: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("name=")))
    let statementTypeName: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("type=")))
    let expressionSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("expression=")))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("expressionRecord="))))
    return compilerCoreLLVMLowerLinearStatementRecordWithExpression(context: context, statementKind: statementKind, statementName: statementName, statementTypeName: statementTypeName, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
}

function compilerCoreLLVMLowerLinearStatementRecordWithExpression(context: CompilerLLVMLoweringContext, statementKind: String, statementName: String, statementTypeName: String, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if statementKind == String("let") {
        return compilerCoreLLVMLowerLinearStatementRecordBinding(context: context, statementName: statementName, statementTypeName: statementTypeName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("state") {
        return compilerCoreLLVMLowerLinearStatementRecordBinding(context: context, statementName: statementName, statementTypeName: statementTypeName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    return compilerCoreLLVMLowerLinearStatementRecordNonBinding(context: context, statementKind: statementKind, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
}

function compilerCoreLLVMLowerLinearStatementRecordBinding(context: CompilerLLVMLoweringContext, statementName: String, statementTypeName: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    if !compilerCoreCanLowerLocalType(context: context, typeName: statementTypeName) {
        return compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: localValues, temporaryIndex: temporaryIndex)
    }

    let loweredLocal: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: statementTypeName, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredLocal.instructionRecords, localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: statementName, operand: loweredLocal.operand, typeName: loweredLocal.typeName, rangeTypeName: statementTypeName))", nextTemporary: loweredLocal.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordNonBinding(context: CompilerLLVMLoweringContext, statementKind: String, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if statementKind == String("expression") {
        return compilerCoreLLVMLowerLinearStatementRecordExpression(context: context, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("assignment") {
        return compilerCoreLLVMLowerLinearStatementRecordAssignment(context: context, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("return") {
        return compilerCoreLLVMLowerLinearStatementRecordReturn(context: context, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
    }

    return compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: localValues, temporaryIndex: temporaryIndex)
}

function compilerCoreLLVMLowerLinearStatementRecordExpression(context: CompilerLLVMLoweringContext, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    let loweredExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredExpression.instructionRecords, localValues: localValues, nextTemporary: loweredExpression.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordAssignment(context: CompilerLLVMLoweringContext, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    state assignmentName: String("")
    assignmentName: compilerCoreStatementRecordField(record: statementRecord, prefix: String("name="))
    let assignmentTargetSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("target=")))
    let assignmentTargetRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("targetRecord="))))
    if assignmentName == String("") {
        assignmentName: compilerCoreIdentifierExpressionRecordName(record: assignmentTargetRecord, fallbackSummary: assignmentTargetSummary)
    }
    return compilerCoreLLVMLowerLinearStatementRecordAssignmentName(context: context, assignmentName: assignmentName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
}

function compilerCoreLLVMLowerLinearStatementRecordAssignmentName(context: CompilerLLVMLoweringContext, assignmentName: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    if assignmentName == String("") {
        return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
    }

    let assignmentLLVMType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: assignmentName))
    state assignmentRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: assignmentName))
    if assignmentRangeType == String("") {
        assignmentRangeType: compilerCoreRangeTypeNameForLLVMType(typeName: assignmentLLVMType)
    }
    let loweredAssignment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: assignmentRangeType, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredAssignment.instructionRecords, localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: assignmentName, operand: loweredAssignment.operand, typeName: loweredAssignment.typeName, rangeTypeName: assignmentRangeType))", nextTemporary: loweredAssignment.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordReturn(context: CompilerLLVMLoweringContext, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    let loweredReturn: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: expectedReturnType, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredReturn.instructionRecords, localValues: localValues, nextTemporary: loweredReturn.nextTemporary, hasReturn: true, returnLLVMType: compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType), returnLLVMValue: loweredReturn.operand)
}

function compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    return CompilerLLVMLoweredLinearStatement(handled: false, instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreRenderedDirectReturnBlock(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, renderedInstructionRecords: String, localValues: String, temporaryIndex: Int, returnLLVMType: String, returnLLVMValue: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let terminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
    let renderedBlocks: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: renderedInstructionRecords, terminal: terminator))
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: context.program.declarationRecords, renderedBlocks: renderedBlocks, instructionRecords: renderedInstructionRecords, localValues: localValues, nextTemporary: temporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: true, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
}

function compilerCoreEmptyDirectLoweredBlock(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, localValues: String, temporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let returnLLVMType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
    let returnLLVMValue: String(compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType))
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: context.program.declarationRecords, renderedBlocks: String(""), instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
}

function compilerCoreLLVMLowerBlockWithControlLegacy(context: CompilerLLVMLoweringContext, parsedBlock: CompilerParsedBlock, initialLocalValues: String, initialTemporaryIndex: Int, expectedReturnType: String, initialBlockLabel: String, fallthroughLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: parsedBlock.statementRecords))
    state llvmRenderedBlocks: String("")
    state llvmInstructionRecords: String("")
    state currentBlockLabel: String("entry")
    currentBlockLabel: initialBlockLabel
    state currentBlockInstructionRecords: String("")
    state currentBlockHasTerminator: Bool(false)
    state llvmLocalValues: String("")
    llvmLocalValues: initialLocalValues
    state llvmTemporaryIndex: Int(0)
    llvmTemporaryIndex: initialTemporaryIndex
    state llvmBranchIndex: Int(0)
    llvmBranchIndex: initialBranchIndex
    state hasEntryBranch: Bool(false)
    state entryBranchCondition: String("")
    state entryBranchThenLabel: String("")
    state entryBranchElseLabel: String("")
    state hasReturn: Bool(false)
    state returnLLVMType: String(compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType))
    state returnLLVMValue: String(compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: parsedBlock.statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return CompilerLLVMLoweredBlock(
                block: parsedBlock.block,
                declarationRecords: context.program.declarationRecords,
                renderedBlocks: llvmRenderedBlocks,
                instructionRecords: llvmInstructionRecords,
                localValues: llvmLocalValues,
                nextTemporary: llvmTemporaryIndex,
                nextBranchIndex: llvmBranchIndex,
                exitLabel: currentBlockLabel,
                hasEntryBranch: hasEntryBranch,
                entryBranchCondition: entryBranchCondition,
                entryBranchThenLabel: entryBranchThenLabel,
                entryBranchElseLabel: entryBranchElseLabel,
                hasReturn: hasReturn,
                returnLLVMType: returnLLVMType,
                returnLLVMValue: returnLLVMValue
            )
        }

            let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
            let loweredLinearBlockStatement: CompilerLLVMLoweredLinearStatement(compilerCoreLLVMLowerLinearStatement(context: context, statement: statement, localValues: llvmLocalValues, temporaryIndex: llvmTemporaryIndex, expectedReturnType: expectedReturnType))
            if loweredLinearBlockStatement.handled {
                if loweredLinearBlockStatement.hasReturn {
                    if !hasReturn {
                        if llvmRenderedBlocks != String("") {
                            let linearReturnTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: loweredLinearBlockStatement.returnLLVMType, value: loweredLinearBlockStatement.returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
                            llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: linearReturnTerminator))"
                            llvmTemporaryIndex: loweredLinearBlockStatement.nextTemporary
                            currentBlockHasTerminator: true
                            hasReturn: true
                        } else {
                            llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                            llvmTemporaryIndex: loweredLinearBlockStatement.nextTemporary
                            hasReturn: true
                            returnLLVMType: loweredLinearBlockStatement.returnLLVMType
                            returnLLVMValue: loweredLinearBlockStatement.returnLLVMValue
                        }
                    }
                } else {
                    llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                    currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredLinearBlockStatement.instructionRecords)"
                    llvmLocalValues: loweredLinearBlockStatement.localValues
                    llvmTemporaryIndex: loweredLinearBlockStatement.nextTemporary
                }
            } else if statement.kind == String("if") {
                let loweredCondition: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: llvmLocalValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: String("Bool"), temporaryIndex: llvmTemporaryIndex))
                let loweredThenBlock: CompilerLLVMLoweredReturnBlock(compilerCoreLLVMLowerReturnStatementRecords(context: context, statementRecords: statement.bodyStatementRecords, localValues: llvmLocalValues, temporaryIndex: loweredCondition.nextTemporary, breakLabel: String(""), continueLabel: String(""), expectedReturnType: expectedReturnType))
                if loweredThenBlock.hasReturn && !compilerCoreStatementRecordsContainControl(records: statement.bodyStatementRecords) && !compilerCoreStatementRecordsContainControl(records: statement.elseStatementRecords) {
                    let thenLabel: String("if\(llvmBranchIndex)")
                    state falseLabel: String("")
                    falseLabel: "after\(llvmBranchIndex)"
                    state loweredReturningElseBlock: CompilerLLVMLoweredReturnBlock(CompilerLLVMLoweredReturnBlock(instructionRecords: String(""), localValues: llvmLocalValues, nextTemporary: loweredThenBlock.nextTemporary, hasReturn: false, returnLLVMType: loweredThenBlock.returnLLVMType, returnValue: String("0"), hasJump: false, jumpLabel: String("")))
                    if statement.elseBodyEnd > statement.elseBodyStart {
                        falseLabel: "else\(llvmBranchIndex)"
                        loweredReturningElseBlock: compilerCoreLLVMLowerReturnStatementRecords(context: context, statementRecords: statement.elseStatementRecords, localValues: llvmLocalValues, temporaryIndex: loweredThenBlock.nextTemporary, breakLabel: String(""), continueLabel: String(""), expectedReturnType: expectedReturnType)
                    }
                    let branchBlockTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: thenLabel, falseLabel: falseLabel))
                    let thenReturnTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: loweredThenBlock.returnLLVMType, value: loweredThenBlock.returnValue, trueLabel: String(""), falseLabel: String("")))
                    let thenInstructions: String(compilerCoreRenderLLVMInstructionRecords(records: loweredThenBlock.instructionRecords))
                    llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredCondition.instructionRecords)\(loweredThenBlock.instructionRecords)\(loweredReturningElseBlock.instructionRecords)"
                    currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredCondition.instructionRecords)"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: branchBlockTerminator))"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: thenLabel, instructionRecords: loweredThenBlock.instructionRecords, terminal: thenReturnTerminator))"
                    currentBlockLabel: "after\(llvmBranchIndex)"
                    currentBlockInstructionRecords: String("")
                    if loweredReturningElseBlock.hasReturn {
                        let elseReturnTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: loweredReturningElseBlock.returnLLVMType, value: loweredReturningElseBlock.returnValue, trueLabel: String(""), falseLabel: String("")))
                        let elseInstructions: String(compilerCoreRenderLLVMInstructionRecords(records: loweredReturningElseBlock.instructionRecords))
                        llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: falseLabel, instructionRecords: loweredReturningElseBlock.instructionRecords, terminal: elseReturnTerminator))"
                        currentBlockHasTerminator: true
                        llvmTemporaryIndex: loweredReturningElseBlock.nextTemporary
                        hasReturn: true
                    } else {
                        currentBlockLabel: falseLabel
                        currentBlockHasTerminator: false
                        llvmTemporaryIndex: loweredThenBlock.nextTemporary
                    }
                    if !hasEntryBranch {
                        hasEntryBranch: true
                        entryBranchCondition: loweredCondition.operand
                        entryBranchThenLabel: thenLabel
                        entryBranchElseLabel: falseLabel
                    }
                    llvmBranchIndex: llvmBranchIndex + 1
                } else {
                    let ifSourceLabel: String(currentBlockLabel)
                    let ifThenLabel: String("if\(llvmBranchIndex)")
                    let ifElseLabel: String("else\(llvmBranchIndex)")
                    let ifAfterLabel: String("after\(llvmBranchIndex)")
                    state ifFalseLabel: String("")
                    ifFalseLabel: ifAfterLabel
                    let ifThenSourceBlock: CompilerBlock(CompilerBlock(start: statement.bodyStart, end: statement.bodyEnd))
                    let ifThenParsedBlock: CompilerParsedBlock(CompilerParsedBlock(block: ifThenSourceBlock, statementRecords: statement.bodyStatementRecords, statementSummary: String("")))
                    let loweredNonReturningThenBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithControl(context: context, parsedBlock: ifThenParsedBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: ifThenLabel, fallthroughLabel: ifAfterLabel, initialBranchIndex: llvmBranchIndex + 1))
                    state ifElseInstructionRecords: String("")
                    state ifElseRenderedBlocks: String("")
                    state ifElseLocalValues: String("")
                    ifElseLocalValues: llvmLocalValues
                    state ifElseNextTemporary: Int(0)
                    ifElseNextTemporary: loweredNonReturningThenBlock.nextTemporary
                    state ifElseNextBranchIndex: Int(0)
                    ifElseNextBranchIndex: loweredNonReturningThenBlock.nextBranchIndex
                    state ifElseExitLabel: String("")
                    ifElseExitLabel: ifSourceLabel
                    state ifElseHasReturn: Bool(false)
                    if statement.elseBodyEnd > statement.elseBodyStart {
                        ifFalseLabel: ifElseLabel
                        let ifElseSourceBlock: CompilerBlock(CompilerBlock(start: statement.elseBodyStart, end: statement.elseBodyEnd))
                        let ifElseParsedBlock: CompilerParsedBlock(CompilerParsedBlock(block: ifElseSourceBlock, statementRecords: statement.elseStatementRecords, statementSummary: String("")))
                        let loweredNonReturningElseBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithControl(context: context, parsedBlock: ifElseParsedBlock, initialLocalValues: llvmLocalValues, initialTemporaryIndex: loweredNonReturningThenBlock.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: ifElseLabel, fallthroughLabel: ifAfterLabel, initialBranchIndex: loweredNonReturningThenBlock.nextBranchIndex))
                        ifElseInstructionRecords: loweredNonReturningElseBlock.instructionRecords
                        ifElseRenderedBlocks: loweredNonReturningElseBlock.renderedBlocks
                        ifElseLocalValues: loweredNonReturningElseBlock.localValues
                        ifElseNextTemporary: loweredNonReturningElseBlock.nextTemporary
                        ifElseNextBranchIndex: loweredNonReturningElseBlock.nextBranchIndex
                        ifElseExitLabel: loweredNonReturningElseBlock.exitLabel
                        ifElseHasReturn: loweredNonReturningElseBlock.hasReturn
                    }
                    let ifBranchTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredCondition.operand, trueLabel: ifThenLabel, falseLabel: ifFalseLabel))
                    let ifThenAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.bodyStatementRecords))
                    let ifElseAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.elseStatementRecords))
                    state ifAssignmentNames: String("")
                    ifAssignmentNames: compilerCoreLLVMLocalNames(localValues: llvmLocalValues)
                    ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: ifThenAssignmentNames)
                    ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: compilerCoreLLVMLocalNames(localValues: loweredNonReturningThenBlock.localValues))
                    if statement.elseBodyEnd > statement.elseBodyStart && !ifElseHasReturn {
                        ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: ifElseAssignmentNames)
                        ifAssignmentNames: compilerCoreNameListAppendingMissing(names: ifAssignmentNames, additionalNames: compilerCoreLLVMLocalNames(localValues: ifElseLocalValues))
                    }
                    state ifPhiRecords: String("")
                    state ifPhiTemporaryIndex: Int(0)
                    ifPhiTemporaryIndex: ifElseNextTemporary
                    state ifAssignmentIndex: Int(0)
                    let ifAssignmentNamesLength: Int(stringLength(value: ifAssignmentNames))
                    while ifAssignmentIndex < ifAssignmentNamesLength {
                        let ifPhiName: String(compilerCoreNameListNameAt(names: ifAssignmentNames, start: ifAssignmentIndex))
                        let ifPhiInitialOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: llvmLocalValues, name: ifPhiName))
                        let ifPhiInitialType: String(compilerCoreLookupLLVMLocalType(localValues: llvmLocalValues, name: ifPhiName))
                        let ifPhiInitialRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: llvmLocalValues, name: ifPhiName))
                        let ifPhiThenOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: loweredNonReturningThenBlock.localValues, name: ifPhiName))
                        state ifPhiElseOperand: String("")
                        ifPhiElseOperand: compilerCoreLookupLLVMLocalOperand(localValues: ifElseLocalValues, name: ifPhiName)
                        if statement.elseBodyEnd <= statement.elseBodyStart {
                            ifPhiElseOperand: ifPhiInitialOperand
                        }
                        if !loweredNonReturningThenBlock.hasReturn && !ifElseHasReturn && ifPhiName != String("") && ifPhiInitialOperand != String("") && ifPhiThenOperand != String("") && ifPhiElseOperand != String("") && (ifPhiThenOperand != ifPhiInitialOperand || ifPhiElseOperand != ifPhiInitialOperand) {
                            let ifPhiOperand: String("%r\(ifPhiTemporaryIndex)")
                            state ifPhiLeft: String("")
                            state ifPhiRight: String("")
                            if statement.elseBodyEnd > statement.elseBodyStart {
                                ifPhiLeft: "[\(ifPhiThenOperand), %\(loweredNonReturningThenBlock.exitLabel)]"
                                ifPhiRight: "[\(ifPhiElseOperand), %\(ifElseExitLabel)]"
                            } else {
                                ifPhiLeft: "[\(ifPhiInitialOperand), %\(ifSourceLabel)]"
                                ifPhiRight: "[\(ifPhiThenOperand), %\(loweredNonReturningThenBlock.exitLabel)]"
                            }
                            let ifPhiInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: ifPhiOperand, operation: String("phi"), typeName: ifPhiInitialType, left: ifPhiLeft, right: ifPhiRight))
                            ifPhiRecords: "\(ifPhiRecords)\(compilerCoreLLVMInstructionRecord(instruction: ifPhiInstruction))"
                            llvmLocalValues: "\(llvmLocalValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: ifPhiName, operand: ifPhiOperand, typeName: ifPhiInitialType, rangeTypeName: ifPhiInitialRangeType))"
                            ifPhiTemporaryIndex: ifPhiTemporaryIndex + 1
                        }
                        ifAssignmentIndex: compilerCoreNameListNextIndex(names: ifAssignmentNames, start: ifAssignmentIndex)
                    }
                    llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredCondition.instructionRecords)\(loweredNonReturningThenBlock.instructionRecords)\(ifElseInstructionRecords)"
                    currentBlockInstructionRecords: "\(currentBlockInstructionRecords)\(loweredCondition.instructionRecords)"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: ifBranchTerminator))"
                    llvmRenderedBlocks: "\(llvmRenderedBlocks)\(loweredNonReturningThenBlock.renderedBlocks)\(ifElseRenderedBlocks)"
                    currentBlockLabel: ifAfterLabel
                    currentBlockInstructionRecords: ifPhiRecords
                    currentBlockHasTerminator: false
                    if statement.elseBodyEnd > statement.elseBodyStart && loweredNonReturningThenBlock.hasReturn && !ifElseHasReturn {
                        llvmLocalValues: ifElseLocalValues
                    } else if statement.elseBodyEnd > statement.elseBodyStart && ifElseHasReturn {
                        llvmLocalValues: loweredNonReturningThenBlock.localValues
                    }
                    llvmTemporaryIndex: ifPhiTemporaryIndex
                    if !hasEntryBranch {
                        hasEntryBranch: true
                        entryBranchCondition: loweredCondition.operand
                        entryBranchThenLabel: ifThenLabel
                        entryBranchElseLabel: ifFalseLabel
                    }
                    llvmBranchIndex: ifElseNextBranchIndex
                }
            } else if statement.kind == String("while") {
                let conditionLabel: String("while\(llvmBranchIndex)")
                let bodyLabel: String("whileBody\(llvmBranchIndex)")
                let afterLabel: String("afterWhile\(llvmBranchIndex)")
                let enterLoopTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: conditionLabel, falseLabel: String("")))
                state loopAssignmentNames: String("")
                loopAssignmentNames: compilerCoreLLVMLocalNames(localValues: llvmLocalValues)
                state loopLocalValues: String("")
                loopLocalValues: "\(llvmLocalValues)"
                state loopPhiRecords: String("")
                state loopConditionTemporaryIndex: Int(0)
                loopConditionTemporaryIndex: llvmTemporaryIndex
                let loopPhiFirstTemporaryIndex: Int(llvmTemporaryIndex)
                state loopAssignmentIndex: Int(0)
                let loopAssignmentNamesLength: Int(stringLength(value: loopAssignmentNames))
                while loopAssignmentIndex < loopAssignmentNamesLength {
                    let loopAssignmentName: String(compilerCoreNameListNameAt(names: loopAssignmentNames, start: loopAssignmentIndex))
                    let loopInitialOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: llvmLocalValues, name: loopAssignmentName))
                    let loopInitialType: String(compilerCoreLookupLLVMLocalType(localValues: llvmLocalValues, name: loopAssignmentName))
                    let loopInitialRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: llvmLocalValues, name: loopAssignmentName))
                    if loopAssignmentName != String("") && loopInitialOperand != String("") {
                        let loopPhiOperand: String("%r\(llvmTemporaryIndex)")
                        loopLocalValues: "\(loopLocalValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: loopAssignmentName, operand: loopPhiOperand, typeName: loopInitialType, rangeTypeName: loopInitialRangeType))"
                        llvmTemporaryIndex: llvmTemporaryIndex + 1
                        loopConditionTemporaryIndex: llvmTemporaryIndex
                    }
                    loopAssignmentIndex: compilerCoreNameListNextIndex(names: loopAssignmentNames, start: loopAssignmentIndex)
                }
                let loweredLoopCondition: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(context: context, localValues: loopLocalValues, expressionRecord: statement.expressionRecord, fallbackSummary: statement.expressionSummary, expectedTypeName: String("Bool"), temporaryIndex: loopConditionTemporaryIndex))
                let loopConditionTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: loweredLoopCondition.operand, trueLabel: bodyLabel, falseLabel: afterLabel))
                let loopBodySourceBlock: CompilerBlock(CompilerBlock(start: statement.bodyStart, end: statement.bodyEnd))
                let loopBodyParsedBlock: CompilerParsedBlock(CompilerParsedBlock(block: loopBodySourceBlock, statementRecords: statement.bodyStatementRecords, statementSummary: String("")))
                let loweredBodyBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlockWithControl(context: context, parsedBlock: loopBodyParsedBlock, initialLocalValues: loopLocalValues, initialTemporaryIndex: loweredLoopCondition.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: bodyLabel, fallthroughLabel: conditionLabel, initialBranchIndex: llvmBranchIndex + 1))
                state loopBackedgeLabel: String("")
                loopBackedgeLabel: loweredBodyBlock.exitLabel
                if loopBackedgeLabel == String("") {
                    loopBackedgeLabel: bodyLabel
                }
                state loopPhiRecordIndex: Int(0)
                state loopPhiTemporaryIndex: Int(0)
                loopPhiTemporaryIndex: loopPhiFirstTemporaryIndex
                while loopPhiRecordIndex < loopAssignmentNamesLength {
                    let loopPhiName: String(compilerCoreNameListNameAt(names: loopAssignmentNames, start: loopPhiRecordIndex))
                    let loopPhiInitialOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: llvmLocalValues, name: loopPhiName))
                    let loopPhiInitialType: String(compilerCoreLookupLLVMLocalType(localValues: llvmLocalValues, name: loopPhiName))
                    let loopPhiInitialRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: llvmLocalValues, name: loopPhiName))
                    let loopUpdatedOperand: String(compilerCoreLookupLLVMLocalOperand(localValues: loweredBodyBlock.localValues, name: loopPhiName))
                    state loopBackedgeOperand: String("")
                    loopBackedgeOperand: loopUpdatedOperand
                    if loopBackedgeOperand == String("") {
                        loopBackedgeOperand: loopPhiInitialOperand
                    }
                    if loopPhiName != String("") && loopPhiInitialOperand != String("") {
                        let renderedLoopPhiOperand: String("%r\(loopPhiTemporaryIndex)")
                        let loopPhiInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(
                            result: renderedLoopPhiOperand,
                            operation: String("phi"),
                            typeName: loopPhiInitialType,
                            left: "[\(loopPhiInitialOperand), %\(currentBlockLabel)]",
                            right: "[\(loopBackedgeOperand), %\(loopBackedgeLabel)]"
                        ))
                        loopPhiRecords: "\(loopPhiRecords)\(compilerCoreLLVMInstructionRecord(instruction: loopPhiInstruction))"
                        llvmLocalValues: "\(llvmLocalValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: loopPhiName, operand: renderedLoopPhiOperand, typeName: loopPhiInitialType, rangeTypeName: loopPhiInitialRangeType))"
                        loopPhiTemporaryIndex: loopPhiTemporaryIndex + 1
                    }
                    loopPhiRecordIndex: compilerCoreNameListNextIndex(names: loopAssignmentNames, start: loopPhiRecordIndex)
                }
                llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: enterLoopTerminator))"
                llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: conditionLabel, instructionRecords: "\(loopPhiRecords)\(loweredLoopCondition.instructionRecords)", terminal: loopConditionTerminator))"
                llvmRenderedBlocks: "\(llvmRenderedBlocks)\(loweredBodyBlock.renderedBlocks)"
                currentBlockHasTerminator: false
                currentBlockLabel: afterLabel
                currentBlockInstructionRecords: String("")
                llvmInstructionRecords: "\(llvmInstructionRecords)\(loweredLoopCondition.instructionRecords)\(loweredBodyBlock.instructionRecords)"
                llvmTemporaryIndex: loweredBodyBlock.nextTemporary
                llvmBranchIndex: loweredBodyBlock.nextBranchIndex
            }
        statementIndex: compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex)
    }

    if (llvmRenderedBlocks != String("") || fallthroughLabel != String("")) && !currentBlockHasTerminator {
        state defaultBlockTerminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: String("0"), trueLabel: String(""), falseLabel: String("")))
        if fallthroughLabel != String("") && !hasReturn {
            defaultBlockTerminator: CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: fallthroughLabel, falseLabel: String(""))
        } else if hasReturn {
            defaultBlockTerminator: CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
        }
        llvmRenderedBlocks: "\(llvmRenderedBlocks)\(compilerCoreRenderLLVMNamedBlock(label: currentBlockLabel, instructionRecords: currentBlockInstructionRecords, terminal: defaultBlockTerminator))"
    }

    return CompilerLLVMLoweredBlock(
        block: parsedBlock.block,
        declarationRecords: context.program.declarationRecords,
        renderedBlocks: llvmRenderedBlocks,
        instructionRecords: llvmInstructionRecords,
        localValues: llvmLocalValues,
        nextTemporary: llvmTemporaryIndex,
        nextBranchIndex: llvmBranchIndex,
        exitLabel: currentBlockLabel,
        hasEntryBranch: hasEntryBranch,
        entryBranchCondition: entryBranchCondition,
        entryBranchThenLabel: entryBranchThenLabel,
        entryBranchElseLabel: entryBranchElseLabel,
        hasReturn: hasReturn,
        returnLLVMType: returnLLVMType,
        returnLLVMValue: returnLLVMValue
    )
}

function compilerCoreStatementSummary(statement: CompilerStatement): String {
    if statement.summary != String("") {
        return statement.summary
    }

    if statement.kind == String("let") || statement.kind == String("state") {
        return "kind=\(statement.kind)\tname=\(statement.name)\ttype=\(statement.typeName)\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("expression") {
        return "kind=expression\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("assignment") {
        return "kind=assignment\ttarget=\(statement.targetSummary)\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("return") {
        return "kind=return\texpression=\(statement.expressionSummary)"
    }

    if statement.kind == String("if") || statement.kind == String("while") {
        let bodyStatementSummary: String(compilerCoreStatementRecordsSummary(records: statement.bodyStatementRecords))
        let elseStatementSummary: String(compilerCoreStatementRecordsSummary(records: statement.elseStatementRecords))
        let bodyAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.bodyStatementRecords))
        let elseAssignmentNames: String(compilerCoreStatementRecordsAssignmentNames(records: statement.elseStatementRecords))
        return "kind=\(statement.kind)\tcondition=\(statement.expressionSummary)\tbodyStart=\(statement.bodyStart)\tbodyEnd=\(statement.bodyEnd)\tbodyAssignments=[\(bodyAssignmentNames)]\tbodyStatements=[\(bodyStatementSummary)]\telseBodyStart=\(statement.elseBodyStart)\telseBodyEnd=\(statement.elseBodyEnd)\telseAssignments=[\(elseAssignmentNames)]\telseStatements=[\(elseStatementSummary)]"
    }

    return "kind=\(statement.kind)"
}

function compilerCoreStatementRecordsSummary(records: String): String {
    state output: String("")
    state statementIndex: Int(0)
    state statementOrdinal: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while statementIndex < recordsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: records, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        output: "\(output)statement\(statementOrdinal)=\(compilerCoreStatementSummary(statement: statement));"
        statementOrdinal: statementOrdinal + 1
        statementIndex: compilerCoreStatementRecordNextIndex(records: records, start: statementIndex)
    }

    return output
}

function parseCompilerStatement(program: CompilerProgram, start: Int, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: program.source))
    return parseCompilerStatementWithSink(program: program, start: start, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerStatementWithSink(program: CompilerProgram, start: Int, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: program.source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil { return nil }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= bodyEnd { return nil }
    if token.kind == String("keyword") {
        if token.text == String("return") {
            return parseCompilerReturnStatementWithSink(cursor: cursor, keyword: token, bodyEnd: bodyEnd, sink: sink)
        }
        if token.text == String("let") || token.text == String("state") {
            return parseCompilerLocalBindingStatementWithSink(cursor: cursor, keyword: token, bodyEnd: bodyEnd, sink: sink)
        }
        if token.text == String("if") && sink.enabled {
            return parseCompilerIfStatementWithSink(program: program, cursor: cursor, keyword: token, bodyEnd: bodyEnd, sink: sink)
        }
    }
    if token.kind == String("identifier") {
        if !sink.enabled {
            return parseCompilerStatementFromToken(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
        }
        return parseCompilerAssignmentStatementWithSink(cursor: cursor, token: token, bodyEnd: bodyEnd, sink: sink)
    }
    if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
    return parseCompilerStatementFromToken(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
}

function parseCompilerIfStatementWithSink(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let conditionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let maybeCondition: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: conditionCursor.index, limit: bodyEnd, sink: sink))
    if maybeCondition == nil { return nil }
    let conditionFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: conditionCursor.index))
    let parsedCondition: CompilerParsedExpression(maybeCondition ?? conditionFallback)
    let condition: CompilerExpression(compilerParsedExpressionValue(parsed: parsedCondition))
    let braceCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: condition.end))
    let maybeBrace: Optional<RangeLexedToken>(compilerCursorPeek(cursor: braceCursor))
    if maybeBrace == nil { return nil }
    let braceFallback: RangeLexedToken(compilerFallbackToken(cursor: braceCursor))
    let brace: RangeLexedToken(maybeBrace ?? braceFallback)
    if brace.kind != String("leftBrace") { return nil }
    let maybeRegionRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: braceCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
    if maybeRegionRange == nil { return nil }
    let regionFallback: CompilerSourceRange(CompilerSourceRange(start: brace.end, end: brace.end, next: brace.end))
    let regionRange: CompilerSourceRange(maybeRegionRange ?? regionFallback)
    let ifSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIf(), ordinal: sink.statementOrdinal, start: keyword.start, end: regionRange.next, firstStart: keyword.start, firstEnd: keyword.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    let regionSink: CompilerBodySyntaxSink(compilerBodySyntaxSinkEnabled(tables: sink.tables, fileID: sink.fileID, ownerSyntaxID: ifSyntaxID, statementOrdinal: 0))
    let regionSyntaxID: Int(compilerBodySyntaxAppendNode(sink: regionSink, kindTag: compilerSyntaxKindLexicalRegion(), ordinal: 0, start: regionRange.start, end: regionRange.end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if ifSyntaxID < 0 || regionSyntaxID < 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: ifSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedCondition), roleTag: compilerSyntaxRoleCondition(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: ifSyntaxID, childSyntaxID: regionSyntaxID, roleTag: compilerSyntaxRoleThenRegion(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: ifSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0
        || compilerTypedSyntaxCaptureBody(source: cursor.source, tables: sink.tables, fileID: sink.fileID, ownerSyntaxID: regionSyntaxID, start: regionRange.start, end: regionRange.end) != 0 {
        compilerSyntaxTablesPoison(tables: sink.tables)
        return nil
    }
    return CompilerStatement(
        kind: String("if"),
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: condition.kind,
        expressionValue: condition.value,
        expressionSummary: condition.summary,
        expressionRecord: condition.record,
        bodyStart: regionRange.start,
        bodyEnd: regionRange.end,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=if\tcondition=\(condition.summary)\tbodyStart=\(regionRange.start)\tbodyEnd=\(regionRange.end)",
        start: keyword.start,
        end: regionRange.next
    )
}

function parseCompilerAssignmentStatementWithSink(cursor: CompilerTokenCursor, token: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let maybeTarget: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: token.start, limit: bodyEnd, sink: sink))
    if maybeTarget == nil { return nil }
    let targetFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: token.start))
    let parsedTarget: CompilerParsedExpression(maybeTarget ?? targetFallback)
    let target: CompilerExpression(compilerParsedExpressionValue(parsed: parsedTarget))
    if target.kind != String("identifier") && target.kind != String("member") { return nil }
    let colonCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: target.end))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil { return nil }
    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != String("colon") { return nil }
    let valueCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeValue: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: valueCursor.index, limit: bodyEnd, sink: sink))
    if maybeValue == nil { return nil }
    let valueFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: valueCursor.index))
    let parsedValue: CompilerParsedExpression(maybeValue ?? valueFallback)
    let value: CompilerExpression(compilerParsedExpressionValue(parsed: parsedValue))
    let assignmentSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindAssignment(), ordinal: sink.statementOrdinal, start: token.start, end: value.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: assignmentSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedTarget), roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: assignmentSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedValue), roleTag: compilerSyntaxRoleAssignedValue(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: assignmentSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0 {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }
    return parseCompilerAssignmentStatement(token: token, target: target, value: value)
}

function parseCompilerStatementWithToken(program: CompilerProgram, cursor: CompilerTokenCursor, maybeToken: Optional<RangeLexedToken>, bodyEnd: Int): Optional<CompilerStatement> {
    if maybeToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    let tokenStart: Int(compilerCoreRangeTokenStart(token: token))
    if tokenStart >= bodyEnd {
        return nil
    }

    return parseCompilerStatementFromToken(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
}

function parseCompilerStatementFromToken(program: CompilerProgram, cursor: CompilerTokenCursor, token: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    if compilerCoreTokenKindEquals(token: token, kind: String("keyword")) {
        return parseCompilerKeywordStatement(program: program, cursor: cursor, keyword: token, bodyEnd: bodyEnd)
    }

    if compilerCoreTokenKindEquals(token: token, kind: String("identifier")) {
        return parseCompilerIdentifierStatement(program: program, cursor: cursor, token: token, bodyEnd: bodyEnd)
    }

    return nil
}

function parseCompilerKeywordStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let keywordText: String(compilerCoreRangeTokenText(token: keyword))
    if keywordText == String("return") {
        return parseCompilerReturnStatement(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    return parseCompilerNonReturnKeywordStatement(program: program, cursor: cursor, keyword: keyword, keywordText: keywordText, bodyEnd: bodyEnd)
}

function parseCompilerNonReturnKeywordStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, keywordText: String, bodyEnd: Int): Optional<CompilerStatement> {
    if keywordText == String("if") {
        return parseCompilerControlKeywordStatement(program: program, cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    if keywordText == String("while") {
        return parseCompilerControlKeywordStatement(program: program, cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    return parseCompilerNonControlKeywordStatement(cursor: cursor, keyword: keyword, keywordText: keywordText, bodyEnd: bodyEnd)
}

function parseCompilerControlKeywordStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    return parseCompilerControlBlockStatement(program: program, cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
}

function parseCompilerNonControlKeywordStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, keywordText: String, bodyEnd: Int): Optional<CompilerStatement> {
    if keywordText == String("break") {
        return parseCompilerJumpStatement(keyword: keyword)
    }

    if keywordText == String("continue") {
        return parseCompilerJumpStatement(keyword: keyword)
    }

    return parseCompilerBindingKeywordStatement(cursor: cursor, keyword: keyword, keywordText: keywordText, bodyEnd: bodyEnd)
}

function parseCompilerBindingKeywordStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, keywordText: String, bodyEnd: Int): Optional<CompilerStatement> {
    if keywordText == String("let") {
        return parseCompilerLocalBindingStatement(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    if keywordText == String("state") {
        return parseCompilerLocalBindingStatement(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd)
    }

    return nil
}

function parseCompilerJumpStatement(keyword: RangeLexedToken): Optional<CompilerStatement> {
    return CompilerStatement(
        kind: keyword.text,
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: String(""),
        expressionValue: String(""),
        expressionSummary: String(""),
        expressionRecord: String(""),
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=\(keyword.text)",
        start: keyword.start,
        end: keyword.end
    )
}

function parseCompilerReturnStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: cursor.source))
    return parseCompilerReturnStatementWithSink(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerReturnStatementWithSink(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let expressionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let expressionStart: Int(compilerCoreFirstNonWhitespaceIndex(source: cursor.source, start: expressionCursor.index, end: bodyEnd))
    return parseCompilerReturnStatementExpressionWithSink(source: cursor.source, keyword: keyword, expressionStart: expressionStart, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerReturnStatementExpression(source: String, keyword: RangeLexedToken, expressionStart: Int, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    return parseCompilerReturnStatementExpressionWithSink(source: source, keyword: keyword, expressionStart: expressionStart, bodyEnd: bodyEnd, sink: sink)
}

function parseCompilerReturnStatementExpressionWithSink(source: String, keyword: RangeLexedToken, expressionStart: Int, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    let maybeParsedReturnExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: expressionStart, limit: bodyEnd, sink: sink))
    if maybeParsedReturnExpression == nil {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }

    let parsedReturnFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: expressionStart))
    let parsedReturnExpression: CompilerParsedExpression(maybeParsedReturnExpression ?? parsedReturnFallback)
    let expression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedReturnExpression))
    let statement: CompilerStatement(compilerCoreReturnStatementFromExpression(keyword: keyword, expression: expression))
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindReturn(), ordinal: sink.statementOrdinal, start: keyword.start, end: expression.end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: statementSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedReturnExpression), roleTag: compilerSyntaxRoleReturnValue(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0 {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }
    return statement
}

function compilerCoreReturnStatementFromExpression(keyword: RangeLexedToken, expression: CompilerExpression): CompilerStatement {
    return CompilerStatement(
        kind: String("return"),
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: expression.kind,
        expressionValue: expression.value,
        expressionSummary: expression.summary,
        expressionRecord: expression.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=return\texpression=\(expression.summary)",
        start: keyword.start,
        end: expression.end
    )
}

function parseCompilerSimpleExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    return parseCompilerExpression(source: source, start: start, limit: limit)
}

function compilerCoreSimpleExpressionFromToken(token: RangeLexedToken): Optional<CompilerExpression> {
    let tokenKind: String(compilerCoreRangeTokenKind(token: token))
    if tokenKind == String("integer") {
        return compilerCoreTokenExpression(token: token, kind: String("integerLiteral"), value: token.text, summaryPrefix: String("integerLiteral"))
    }

    if tokenKind == String("stringLiteral") {
        return compilerCoreTokenExpression(token: token, kind: String("stringLiteral"), value: token.text, summaryPrefix: String("stringLiteral"))
    }

    return compilerCoreSimpleNameExpressionFromToken(token: token, tokenKind: tokenKind)
}

function compilerCoreSimpleNameExpressionFromToken(token: RangeLexedToken, tokenKind: String): Optional<CompilerExpression> {
    if tokenKind == String("identifier") {
        return compilerCoreIdentifierOrBoolExpressionFromToken(token: token)
    }

    if tokenKind == String("keyword") {
        return compilerCoreIdentifierOrBoolExpressionFromToken(token: token)
    }

    return nil
}

function compilerCoreIdentifierOrBoolExpressionFromToken(token: RangeLexedToken): Optional<CompilerExpression> {
    if token.text == String("true") {
        return compilerCoreTokenExpression(token: token, kind: String("boolLiteral"), value: token.text, summaryPrefix: String("boolLiteral"))
    }

    if token.text == String("false") {
        return compilerCoreTokenExpression(token: token, kind: String("boolLiteral"), value: token.text, summaryPrefix: String("boolLiteral"))
    }

    return compilerCoreTokenExpression(token: token, kind: String("identifier"), value: token.text, summaryPrefix: String("identifier"))
}

function compilerCoreTokenExpression(token: RangeLexedToken, kind: String, value: String, summaryPrefix: String): CompilerExpression {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: String("")))
    let parsedTokenExpression: CompilerParsedExpression(compilerCoreTokenExpressionWithSink(token: token, kind: kind, value: value, summaryPrefix: summaryPrefix, sink: sink))
    return compilerParsedExpressionValue(parsed: parsedTokenExpression)
}

function compilerCoreTokenExpressionWithSink(token: RangeLexedToken, kind: String, value: String, summaryPrefix: String, sink: CompilerBodySyntaxSink): CompilerParsedExpression {
    let record: String(compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end))
    state kindTag: Int(0 - 1)
    if kind == String("integerLiteral") {
        kindTag: compilerSyntaxKindIntegerLiteral()
    } else if kind == String("identifier") {
        kindTag: compilerSyntaxKindIdentifier()
    } else if sink.enabled {
        compilerSyntaxTablesPoison(tables: sink.tables)
    }
    state syntaxID: Int(0 - 1)
    if kindTag >= 0 {
        syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: kindTag, ordinal: 0, start: token.start, end: token.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
    }
    let tokenExpression: CompilerExpression(CompilerExpression(
        kind: kind,
        value: value,
        summary: "\(summaryPrefix)(\(value))",
        record: record,
        start: token.start,
        end: token.end
    ))
    return CompilerParsedExpression(expression: tokenExpression, syntaxID: syntaxID)
}

function parseCompilerIdentifierStatement(program: CompilerProgram, cursor: CompilerTokenCursor, token: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let tokenColonStart: Int(compilerCoreFirstNonWhitespaceIndex(source: cursor.source, start: token.end, end: bodyEnd))
    if tokenColonStart < bodyEnd && stringSubstring(source: cursor.source, start: tokenColonStart, end: tokenColonStart + 1) == String(":") {
        let tokenTarget: CompilerExpression(compilerCoreTokenExpression(token: token, kind: String("identifier"), value: token.text, summaryPrefix: String("identifier")))
        return parseCompilerIdentifierStatementWithTarget(cursor: cursor, token: token, target: tokenTarget, bodyEnd: bodyEnd)
    }

    let maybeTarget: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: token.start, limit: bodyEnd))
    if maybeTarget == nil {
        return nil
    }

    let targetFallback: CompilerExpression(compilerCoreMissingExpression(start: token.start))
    let target: CompilerExpression(maybeTarget ?? targetFallback)
    return parseCompilerIdentifierStatementWithTarget(cursor: cursor, token: token, target: target, bodyEnd: bodyEnd)
}

function parseCompilerIdentifierStatementWithTarget(cursor: CompilerTokenCursor, token: RangeLexedToken, target: CompilerExpression, bodyEnd: Int): Optional<CompilerStatement> {
    let colonStart: Int(compilerCoreFirstNonWhitespaceIndex(source: cursor.source, start: target.end, end: bodyEnd))
    if colonStart >= bodyEnd {
        return compilerCoreExpressionStatement(expression: target)
    }

    let colonText: String(stringSubstring(source: cursor.source, start: colonStart, end: colonStart + 1))
    if colonText != String(":") {
        return compilerCoreExpressionStatement(expression: target)
    }

    let valueStart: Int(colonStart + 1)
    let maybeValue: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: valueStart, limit: bodyEnd))
    if maybeValue == nil {
        return nil
    }
    let valueFallback: CompilerExpression(compilerCoreMissingExpression(start: valueStart))
    let value: CompilerExpression(maybeValue ?? valueFallback)
    return parseCompilerAssignmentStatement(token: token, target: target, value: value)
}

function parseCompilerAssignmentStatement(token: RangeLexedToken, target: CompilerExpression, value: CompilerExpression): CompilerStatement {
    let targetName: String(compilerCoreIdentifierExpressionRecordName(record: target.record, fallbackSummary: target.summary))
    return CompilerStatement(
        kind: String("assignment"),
        name: targetName,
        typeName: String(""),
        targetSummary: target.summary,
        targetRecord: target.record,
        expressionKind: value.kind,
        expressionValue: value.value,
        expressionSummary: value.summary,
        expressionRecord: value.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=assignment\ttarget=\(target.summary)\texpression=\(value.summary)",
        start: token.start,
        end: value.end
    )
}

function compilerCoreExpressionStatement(expression: CompilerExpression): CompilerStatement {
    return CompilerStatement(
        kind: String("expression"),
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: expression.kind,
        expressionValue: expression.value,
        expressionSummary: expression.summary,
        expressionRecord: expression.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=expression\texpression=\(expression.summary)",
        start: expression.start,
        end: expression.end
    )
}

function parseCompilerStatementLegacy(program: CompilerProgram, start: Int, bodyEnd: Int): Optional<CompilerStatement> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: program.source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= bodyEnd {
        return nil
    }

    if token.kind == String("keyword") && (token.text == String("if") || token.text == String("while")) {
        return parseCompilerControlBlockStatement(program: program, cursor: cursor, keyword: token, bodyEnd: bodyEnd)
    }

    if token.kind == String("keyword") && (token.text == String("break") || token.text == String("continue")) {
        return CompilerStatement(
            kind: token.text,
            name: String(""),
            typeName: String(""),
            targetSummary: String(""),
            targetRecord: String(""),
            expressionKind: String(""),
            expressionValue: String(""),
            expressionSummary: String(""),
            expressionRecord: String(""),
            bodyStart: 0,
            bodyEnd: 0,
            elseBodyStart: 0,
            elseBodyEnd: 0,
            bodyStatementRecords: String(""),
            elseStatementRecords: String(""),
            summary: "kind=\(token.text)",
            start: token.start,
            end: token.end
        )
    }

    if token.kind == String("keyword") && token.text == String("return") {
        let expressionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
        let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: expressionCursor.index, limit: bodyEnd))
        if maybeExpression == nil {
            return nil
        }
        let expressionFallback: CompilerExpression(compilerCoreMissingExpression(start: expressionCursor.index))
        let expression: CompilerExpression(maybeExpression ?? expressionFallback)
        return CompilerStatement(
            kind: String("return"),
            name: String(""),
            typeName: String(""),
            targetSummary: String(""),
            targetRecord: String(""),
            expressionKind: expression.kind,
            expressionValue: expression.value,
            expressionSummary: expression.summary,
            expressionRecord: expression.record,
            bodyStart: 0,
            bodyEnd: 0,
            elseBodyStart: 0,
            elseBodyEnd: 0,
            bodyStatementRecords: String(""),
            elseStatementRecords: String(""),
            summary: "kind=return\texpression=\(expression.summary)",
            start: token.start,
            end: expression.end
        )
    }

    if token.kind == String("keyword") && (token.text == String("let") || token.text == String("state")) {
        return parseCompilerLocalBindingStatement(cursor: cursor, keyword: token, bodyEnd: bodyEnd)
    }

    if token.kind == String("identifier") {
        let maybeTarget: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: token.start, limit: bodyEnd))
        if maybeTarget == nil {
            return nil
        }
        let targetFallback: CompilerExpression(compilerCoreMissingExpression(start: token.start))
        let target: CompilerExpression(maybeTarget ?? targetFallback)
        let colonCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: target.end))
        let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
        if maybeColon == nil {
            return CompilerStatement(
                kind: String("expression"),
                name: String(""),
                typeName: String(""),
                targetSummary: String(""),
                targetRecord: String(""),
                expressionKind: target.kind,
                expressionValue: target.value,
                expressionSummary: target.summary,
                expressionRecord: target.record,
                bodyStart: 0,
                bodyEnd: 0,
                elseBodyStart: 0,
                elseBodyEnd: 0,
                bodyStatementRecords: String(""),
                elseStatementRecords: String(""),
                summary: "kind=expression\texpression=\(target.summary)",
                start: token.start,
                end: target.end
            )
        }
        let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
        let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
        if colonToken.kind != String("colon") {
            return CompilerStatement(
                kind: String("expression"),
                name: String(""),
                typeName: String(""),
                targetSummary: String(""),
                targetRecord: String(""),
                expressionKind: target.kind,
                expressionValue: target.value,
                expressionSummary: target.summary,
                expressionRecord: target.record,
                bodyStart: 0,
                bodyEnd: 0,
                elseBodyStart: 0,
                elseBodyEnd: 0,
                bodyStatementRecords: String(""),
                elseStatementRecords: String(""),
                summary: "kind=expression\texpression=\(target.summary)",
                start: token.start,
                end: target.end
            )
        }
        let valueCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
        let maybeValue: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: valueCursor.index, limit: bodyEnd))
        if maybeValue == nil {
            return nil
        }
        let valueFallback: CompilerExpression(compilerCoreMissingExpression(start: valueCursor.index))
        let value: CompilerExpression(maybeValue ?? valueFallback)
        let targetName: String(compilerCoreIdentifierExpressionRecordName(record: target.record, fallbackSummary: target.summary))
        return CompilerStatement(
            kind: String("assignment"),
            name: targetName,
            typeName: String(""),
            targetSummary: target.summary,
            targetRecord: target.record,
            expressionKind: value.kind,
            expressionValue: value.value,
            expressionSummary: value.summary,
            expressionRecord: value.record,
            bodyStart: 0,
            bodyEnd: 0,
            elseBodyStart: 0,
            elseBodyEnd: 0,
            bodyStatementRecords: String(""),
            elseStatementRecords: String(""),
            summary: "kind=assignment\ttarget=\(target.summary)\texpression=\(value.summary)",
            start: token.start,
            end: value.end
        )
    }

    return nil
}

function parseCompilerControlBlockStatement(program: CompilerProgram, cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let conditionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let maybeCondition: Optional<CompilerExpression>(parseCompilerExpression(source: cursor.source, start: conditionCursor.index, limit: bodyEnd))
    if maybeCondition == nil {
        return nil
    }

    let conditionFallback: CompilerExpression(compilerCoreMissingExpression(start: conditionCursor.index))
    let condition: CompilerExpression(maybeCondition ?? conditionFallback)
    state blockCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: condition.end))
    state sawLeftBrace: Bool(false)
    state blockStart: Int(0)
    state blockEnd: Int(0)
    state nextIndex: Int(0)
    state elseBlockStart: Int(0)
    state elseBlockEnd: Int(0)
    state nestedElseStatementRecords: String("")

    while blockCursor.index < bodyEnd && !sawLeftBrace {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: blockCursor))
        if maybeToken == nil {
            return nil
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: blockCursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.kind == String("leftBrace") {
            let maybeRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: blockCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
            if maybeRange == nil {
                return nil
            }
            let rangeFallback: CompilerSourceRange(CompilerSourceRange(start: token.end, end: token.end, next: token.end))
            let range: CompilerSourceRange(maybeRange ?? rangeFallback)
            blockStart: range.start
            blockEnd: range.end
            nextIndex: range.next
            sawLeftBrace: true
        } else {
            blockCursor: compilerCursorAdvance(cursor: blockCursor, token: token)
        }
    }

    if !sawLeftBrace {
        return nil
    }

    let elseCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: nextIndex))
    let maybeElseToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: elseCursor))
    if maybeElseToken != nil && keyword.text == String("if") {
        let elseTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: elseCursor))
        let elseToken: RangeLexedToken(maybeElseToken ?? elseTokenFallback)
        if elseToken.kind == String("keyword") && elseToken.text == String("else") {
            let elseBlockCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: elseCursor, token: elseToken))
            let maybeElseBodyToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: elseBlockCursor))
            if maybeElseBodyToken != nil {
                let elseBodyTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: elseBlockCursor))
                let elseBodyToken: RangeLexedToken(maybeElseBodyToken ?? elseBodyTokenFallback)
                if elseBodyToken.kind == String("leftBrace") {
                    let maybeElseRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: elseBlockCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
                    if maybeElseRange != nil {
                        let elseRangeFallback: CompilerSourceRange(CompilerSourceRange(start: elseToken.end, end: elseToken.end, next: elseToken.end))
                        let elseRange: CompilerSourceRange(maybeElseRange ?? elseRangeFallback)
                        elseBlockStart: elseRange.start
                        elseBlockEnd: elseRange.end
                        nextIndex: elseRange.next
                    }
                }
                if elseBodyToken.kind == String("keyword") && elseBodyToken.text == String("if") {
                    let maybeNestedIf: Optional<CompilerStatement>(parseCompilerControlBlockStatement(program: program, cursor: elseBlockCursor, keyword: elseBodyToken, bodyEnd: bodyEnd))
                    if maybeNestedIf != nil {
                        let nestedIfFallback: CompilerStatement(compilerCoreMissingStatement(start: elseBodyToken.start, end: elseBodyToken.end))
                        let nestedIf: CompilerStatement(maybeNestedIf ?? nestedIfFallback)
                        elseBlockStart: nestedIf.start
                        elseBlockEnd: nestedIf.end
                        nextIndex: nestedIf.end
                        nestedElseStatementRecords: compilerCoreStatementRecord(statement: nestedIf)
                    }
                }
            }
        }
    }

    let bodyStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: CompilerBlock(start: blockStart, end: blockEnd)))
    let elseStatements: CompilerParsedStatements(compilerCoreParseStatements(program: program, block: CompilerBlock(start: elseBlockStart, end: elseBlockEnd)))
    state elseStatementRecords: String("")
    elseStatementRecords: elseStatements.records
    if nestedElseStatementRecords != String("") {
        elseStatementRecords: nestedElseStatementRecords
    }
    return CompilerStatement(
        kind: keyword.text,
        name: String(""),
        typeName: String(""),
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: condition.kind,
        expressionValue: condition.value,
        expressionSummary: condition.summary,
        expressionRecord: condition.record,
        bodyStart: blockStart,
        bodyEnd: blockEnd,
        elseBodyStart: elseBlockStart,
        elseBodyEnd: elseBlockEnd,
        bodyStatementRecords: bodyStatements.records,
        elseStatementRecords: elseStatementRecords,
        summary: "kind=\(keyword.text)\tcondition=\(condition.summary)\tbodyStart=\(blockStart)\tbodyEnd=\(blockEnd)\tbodyStatements=[\(bodyStatements.summary)]\telseBodyStart=\(elseBlockStart)\telseBodyEnd=\(elseBlockEnd)\telseStatements=[\(elseStatements.summary)]",
        start: keyword.start,
        end: nextIndex
    )
}

function parseCompilerLocalBindingStatement(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int): Optional<CompilerStatement> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: cursor.source))
    return parseCompilerLocalBindingStatementWithSink(cursor: cursor, keyword: keyword, bodyEnd: bodyEnd, sink: sink)
}

function compilerCoreCallArgumentsStartWithLabel(source: String, start: Int, end: Int): Bool {
    let labelCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let maybeLabelToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: labelCursor))
    if maybeLabelToken == nil { return false }
    let labelFallbackToken: RangeLexedToken(compilerFallbackToken(cursor: labelCursor))
    let labelToken: RangeLexedToken(maybeLabelToken ?? labelFallbackToken)
    if labelToken.start >= end || (labelToken.kind != String("identifier") && labelToken.kind != String("keyword")) { return false }
    let afterLabelCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: labelCursor, token: labelToken))
    let maybeLabelColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterLabelCursor))
    if maybeLabelColon == nil { return false }
    let labelColonFallback: RangeLexedToken(compilerFallbackToken(cursor: afterLabelCursor))
    let labelColon: RangeLexedToken(maybeLabelColon ?? labelColonFallback)
    return labelColon.start < end && labelColon.kind == String("colon")
}

function parseCompilerLocalBindingStatementWithSink(cursor: CompilerTokenCursor, keyword: RangeLexedToken, bodyEnd: Int, sink: CompilerBodySyntaxSink): Optional<CompilerStatement> {
    state cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: keyword))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
    if maybeName == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    if nameToken.kind != String("identifier") {
        return nil
    }
    cursorState: compilerCursorAdvance(cursor: cursorState, token: nameToken)

    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
    if maybeColon == nil {
        return nil
    }
    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != String("colon") {
        return nil
    }
    cursorState: compilerCursorAdvance(cursor: cursorState, token: colonToken)

    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: cursorState))
    if maybeType == nil {
        return nil
    }
    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: cursorState.index, end: cursorState.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    cursorState: CompilerTokenCursor(source: cursor.source, index: typeReference.end)

    let maybeLeftParen: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
    if maybeLeftParen == nil {
        return nil
    }
    let leftParenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
    let leftParenToken: RangeLexedToken(maybeLeftParen ?? leftParenFallback)
    if leftParenToken.kind != String("leftParen") {
        return nil
    }
    let initializerOpenCursor: CompilerTokenCursor(cursorState)
    let maybeInitializerRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: initializerOpenCursor, leftKind: String("leftParen"), rightKind: String("rightParen")))
    if maybeInitializerRange == nil { return nil }
    let initializerRangeFallback: CompilerSourceRange(CompilerSourceRange(start: leftParenToken.end, end: leftParenToken.end, next: leftParenToken.end))
    let initializerRange: CompilerSourceRange(maybeInitializerRange ?? initializerRangeFallback)
    cursorState: compilerCursorAdvance(cursor: cursorState, token: leftParenToken)

    state expression: CompilerExpression(compilerCoreMissingExpression(start: cursorState.index))
    state bindingExpressionSyntaxID: Int(0 - 1)
    state bindingEnd: Int(0)
    if compilerCoreCallArgumentsStartWithLabel(source: cursor.source, start: initializerRange.start, end: initializerRange.end) {
        let implicitCalleeRecord: String(compilerCoreExpressionRecord(kind: String("identifier"), value: typeReference.text, left: String(""), right: String(""), arguments: String(""), start: typeReference.start, end: typeReference.end))
        let implicitCalleeSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIdentifier(), ordinal: 0, start: typeReference.start, end: typeReference.end, firstStart: typeReference.start, firstEnd: typeReference.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        let implicitApplicationSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindApplication(), ordinal: 0, start: typeReference.start, end: initializerRange.next, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: implicitApplicationSyntaxID, childSyntaxID: implicitCalleeSyntaxID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0) != 0 {
            if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
            return nil
        }
        let implicitArguments: CompilerCallArguments(parseCompilerCallArgumentsWithSink(source: cursor.source, start: initializerRange.start, end: initializerRange.end, sink: sink, callSyntaxID: implicitApplicationSyntaxID))
        let implicitSummary: String("call(identifier(\(typeReference.text)),arguments=[\(implicitArguments.summary)])")
        let implicitRecord: String(compilerCoreExpressionRecord(kind: String("call"), value: typeReference.text, left: implicitCalleeRecord, right: String(""), arguments: implicitArguments.records, start: typeReference.start, end: initializerRange.next))
        expression: CompilerExpression(kind: String("call"), value: typeReference.text, summary: implicitSummary, record: implicitRecord, start: typeReference.start, end: initializerRange.next)
        bindingExpressionSyntaxID: implicitApplicationSyntaxID
        bindingEnd: initializerRange.next
    } else {
        let maybeBindingExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: cursor.source, start: cursorState.index, limit: bodyEnd, sink: sink))
        if maybeBindingExpression == nil {
            if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
            return nil
        }
        let bindingExpressionFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: cursorState.index))
        let parsedBindingExpression: CompilerParsedExpression(maybeBindingExpression ?? bindingExpressionFallback)
        expression: compilerParsedExpressionValue(parsed: parsedBindingExpression)
        bindingExpressionSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedBindingExpression)
        cursorState: CompilerTokenCursor(source: cursor.source, index: expression.end)
        let maybeBindingRightParen: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursorState))
        if maybeBindingRightParen == nil { return nil }
        let bindingRightParenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursorState))
        let bindingRightParenToken: RangeLexedToken(maybeBindingRightParen ?? bindingRightParenFallback)
        if bindingRightParenToken.kind != String("rightParen") { return nil }
        bindingEnd: bindingRightParenToken.end
    }

    state bindingKind: Int(compilerSyntaxLocalKindLet())
    if keyword.text == String("state") { bindingKind: compilerSyntaxLocalKindState() }
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindLocalBinding(), ordinal: sink.statementOrdinal, start: keyword.start, end: bindingEnd, firstStart: nameToken.start, firstEnd: nameToken.end, secondStart: typeReference.start, secondEnd: typeReference.end, aux: bindingKind))
    if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: statementSyntaxID, childSyntaxID: bindingExpressionSyntaxID, roleTag: compilerSyntaxRoleInitializer(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: sink.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: sink.statementOrdinal) != 0 {
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        return nil
    }
    return CompilerStatement(
        kind: keyword.text,
        name: nameToken.text,
        typeName: typeReference.text,
        targetSummary: String(""),
        targetRecord: String(""),
        expressionKind: expression.kind,
        expressionValue: expression.value,
        expressionSummary: expression.summary,
        expressionRecord: expression.record,
        bodyStart: 0,
        bodyEnd: 0,
        elseBodyStart: 0,
        elseBodyEnd: 0,
        bodyStatementRecords: String(""),
        elseStatementRecords: String(""),
        summary: "kind=\(keyword.text)\tname=\(nameToken.text)\ttype=\(typeReference.text)\texpression=\(expression.summary)",
        start: keyword.start,
        end: bindingEnd
    )
}

function compilerCoreIsBinaryOperator(token: RangeLexedToken): Bool {
    return token.kind == String("equalEqual")
        || token.kind == String("bangEqual")
        || token.kind == String("less")
        || token.kind == String("lessEqual")
        || token.kind == String("greater")
        || token.kind == String("greaterEqual")
        || token.kind == String("plus")
        || token.kind == String("minus")
        || token.kind == String("asterisk")
        || token.kind == String("slash")
        || token.kind == String("percent")
        || token.kind == String("andAnd")
        || token.kind == String("orOr")
        || token.kind == String("questionQuestion")
}

function compilerCoreIsPrefixOperator(token: RangeLexedToken): Bool {
    return token.kind == String("bang")
        || token.kind == String("minus")
}

function compilerCoreBinaryPrecedence(token: RangeLexedToken): Int {
    if token.kind == String("orOr") {
        return 1
    }

    if token.kind == String("andAnd") {
        return 2
    }

    if token.kind == String("equalEqual")
        || token.kind == String("bangEqual")
        || token.kind == String("less")
        || token.kind == String("lessEqual")
        || token.kind == String("greater")
        || token.kind == String("greaterEqual")
    {
        return 3
    }

    if token.kind == String("questionQuestion") {
        return 4
    }

    if token.kind == String("plus") || token.kind == String("minus") {
        return 5
    }

    if token.kind == String("asterisk") || token.kind == String("slash") || token.kind == String("percent") {
        return 6
    }

    return 0
}

function compilerCoreBinaryIsRightAssociative(token: RangeLexedToken): Bool {
    return token.kind == String("questionQuestion")
}

function parseCompilerExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedExpression == nil { return nil }
    let parsedExpressionFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedExpression: CompilerParsedExpression(maybeParsedExpression ?? parsedExpressionFallback)
    return compilerParsedExpressionValue(parsed: parsedExpression)
}

function parseCompilerExpressionWithSink(source: String, start: Int, limit: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    return parseCompilerExpressionAtPrecedenceWithSink(source: source, start: start, limit: limit, minimumPrecedence: 0, sink: sink)
}

function parseCompilerExpressionAtPrecedence(source: String, start: Int, limit: Int, minimumPrecedence: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedPrecedenceExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: start, limit: limit, minimumPrecedence: minimumPrecedence, sink: sink))
    if maybeParsedPrecedenceExpression == nil { return nil }
    let parsedPrecedenceFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedPrecedenceExpression: CompilerParsedExpression(maybeParsedPrecedenceExpression ?? parsedPrecedenceFallback)
    return compilerParsedExpressionValue(parsed: parsedPrecedenceExpression)
}

function parseCompilerExpressionAtPrecedenceWithSink(source: String, start: Int, limit: Int, minimumPrecedence: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    let maybeParsedLeftExpression: Optional<CompilerParsedExpression>(parseCompilerPrefixExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedLeftExpression == nil {
        return nil
    }

    let parsedLeftFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let initialParsedLeftExpression: CompilerParsedExpression(maybeParsedLeftExpression ?? parsedLeftFallback)
    state leftExpression: CompilerExpression(compilerParsedExpressionValue(parsed: initialParsedLeftExpression))
    state leftExpressionSyntaxID: Int(compilerParsedExpressionSyntaxID(parsed: initialParsedLeftExpression))
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: leftExpression.end))

    while cursor.index < limit {
        let maybeOperator: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeOperator == nil {
            return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
        }

        let operatorFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let operatorToken: RangeLexedToken(maybeOperator ?? operatorFallback)
        if !compilerCoreIsBinaryOperator(token: operatorToken) {
            return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
        }

        let precedence: Int(compilerCoreBinaryPrecedence(token: operatorToken))
        if precedence < minimumPrecedence {
            return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
        }

        state rightMinimumPrecedence: Int(0)
        rightMinimumPrecedence: precedence + 1
        if compilerCoreBinaryIsRightAssociative(token: operatorToken) {
            rightMinimumPrecedence: precedence
        }

        let maybeParsedRightExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: operatorToken.end, limit: limit, minimumPrecedence: rightMinimumPrecedence, sink: sink))
        if maybeParsedRightExpression == nil {
            return nil
        }
        let parsedRightFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: operatorToken.end))
        let parsedRightExpression: CompilerParsedExpression(maybeParsedRightExpression ?? parsedRightFallback)
        let rightExpression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedRightExpression))
        let binaryRecord: String(compilerCoreExpressionRecord(kind: String("binary"), value: operatorToken.text, left: leftExpression.record, right: rightExpression.record, arguments: String(""), start: leftExpression.start, end: rightExpression.end))
        state binarySyntaxID: Int(0 - 1)
        if operatorToken.kind == String("plus") {
            binarySyntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindAddition(), ordinal: 0, start: leftExpression.start, end: rightExpression.end, firstStart: operatorToken.start, firstEnd: operatorToken.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: binarySyntaxID, childSyntaxID: leftExpressionSyntaxID, roleTag: compilerSyntaxRoleLeftOperand(), ordinal: 0) != 0
                || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: binarySyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedRightExpression), roleTag: compilerSyntaxRoleRightOperand(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return nil
            }
        } else if sink.enabled {
            compilerSyntaxTablesPoison(tables: sink.tables)
        }
        leftExpression: CompilerExpression(
            kind: String("binary"),
            value: operatorToken.text,
            summary: String("binary"),
            record: binaryRecord,
            start: leftExpression.start,
            end: rightExpression.end
        )
        leftExpressionSyntaxID: binarySyntaxID
        cursor: CompilerTokenCursor(source: source, index: rightExpression.end)
    }

    return CompilerParsedExpression(expression: leftExpression, syntaxID: leftExpressionSyntaxID)
}

function parseCompilerPrefixExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedPrefixExpression: Optional<CompilerParsedExpression>(parseCompilerPrefixExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedPrefixExpression == nil { return nil }
    let parsedPrefixFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedPrefixExpression: CompilerParsedExpression(maybeParsedPrefixExpression ?? parsedPrefixFallback)
    return compilerParsedExpressionValue(parsed: parsedPrefixExpression)
}

function parseCompilerPrefixExpressionWithSink(source: String, start: Int, limit: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= limit {
        return nil
    }

    if token.kind == String("leftParen") {
        let maybeParsedGroupedExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: token.end, limit: limit, minimumPrecedence: 0, sink: sink))
        if maybeParsedGroupedExpression == nil {
            return nil
        }
        let parsedGroupedFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: token.end))
        let parsedGroupedExpression: CompilerParsedExpression(maybeParsedGroupedExpression ?? parsedGroupedFallback)
        let groupedExpression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedGroupedExpression))
        let maybeRightParen: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: groupedExpression.end))
        if maybeRightParen == nil {
            return nil
        }
        let rightParenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let rightParenToken: RangeLexedToken(maybeRightParen ?? rightParenFallback)
        if rightParenToken.kind != String("rightParen") {
            return nil
        }
        let groupedLegacyExpression: CompilerExpression(CompilerExpression(kind: groupedExpression.kind, value: groupedExpression.value, summary: groupedExpression.summary, record: groupedExpression.record, start: token.start, end: rightParenToken.end))
        return CompilerParsedExpression(expression: groupedLegacyExpression, syntaxID: compilerParsedExpressionSyntaxID(parsed: parsedGroupedExpression))
    }

    if compilerCoreIsPrefixOperator(token: token) {
        let maybeParsedOperand: Optional<CompilerParsedExpression>(parseCompilerExpressionAtPrecedenceWithSink(source: source, start: token.end, limit: limit, minimumPrecedence: 7, sink: sink))
        if maybeParsedOperand == nil {
            return nil
        }

        let parsedOperandFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: token.end))
        let parsedOperand: CompilerParsedExpression(maybeParsedOperand ?? parsedOperandFallback)
        let operand: CompilerExpression(compilerParsedExpressionValue(parsed: parsedOperand))
        let prefixRecord: String(compilerCoreExpressionRecord(kind: String("prefix"), value: token.text, left: operand.record, right: String(""), arguments: String(""), start: token.start, end: operand.end))
        if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
        let prefixLegacyExpression: CompilerExpression(CompilerExpression(
            kind: String("prefix"),
            value: token.text,
            summary: "prefix(\(token.text),\(operand.summary))",
            record: prefixRecord,
            start: token.start,
            end: operand.end
        ))
        return CompilerParsedExpression(expression: prefixLegacyExpression, syntaxID: 0 - 1)
    }

    return parseCompilerPostfixExpressionWithSink(source: source, start: token.start, limit: limit, sink: sink)
}

function parseCompilerPostfixExpression(source: String, start: Int, limit: Int): Optional<CompilerExpression> {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    let maybeParsedPostfixExpression: Optional<CompilerParsedExpression>(parseCompilerPostfixExpressionWithSink(source: source, start: start, limit: limit, sink: sink))
    if maybeParsedPostfixExpression == nil { return nil }
    let parsedPostfixFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: start))
    let parsedPostfixExpression: CompilerParsedExpression(maybeParsedPostfixExpression ?? parsedPostfixFallback)
    return compilerParsedExpressionValue(parsed: parsedPostfixExpression)
}

function parseCompilerPostfixExpressionWithSink(source: String, start: Int, limit: Int, sink: CompilerBodySyntaxSink): Optional<CompilerParsedExpression> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil {
        return nil
    }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let token: RangeLexedToken(maybeToken ?? fallbackToken)
    if token.start >= limit {
        return nil
    }

    if token.kind == String("dollar") {
        let nameCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
        let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: nameCursor))
        if maybeName == nil { return nil }
        let nameFallback: RangeLexedToken(compilerFallbackToken(cursor: nameCursor))
        let nameToken: RangeLexedToken(maybeName ?? nameFallback)
        if nameToken.kind != String("identifier") { return nil }
        let bindingSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindBindingReference(), ordinal: 0, start: token.start, end: nameToken.end, firstStart: nameToken.start, firstEnd: nameToken.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        let bindingRecord: String(compilerCoreExpressionRecord(kind: String("bindingReference"), value: nameToken.text, left: String(""), right: String(""), arguments: String(""), start: token.start, end: nameToken.end))
        return CompilerParsedExpression(
            expression: CompilerExpression(kind: String("bindingReference"), value: nameToken.text, summary: "bindingReference((nameToken.text))", record: bindingRecord, start: token.start, end: nameToken.end),
            syntaxID: bindingSyntaxID
        )
    }

    state summary: String("")
    state kind: String("")
    state value: String("")
    state record: String("")
    if token.kind == String("integer") {
        kind: String("integerLiteral")
        value: token.text
        summary: "integerLiteral(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else if token.kind == String("stringLiteral") {
        kind: String("stringLiteral")
        value: token.text
        summary: "stringLiteral(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else if (token.kind == String("identifier") || token.kind == String("keyword")) && (token.text == String("true") || token.text == String("false")) {
        kind: String("boolLiteral")
        value: token.text
        summary: "boolLiteral(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else if token.kind == String("identifier") || token.kind == String("keyword") {
        kind: String("identifier")
        value: token.text
        summary: "identifier(\(token.text))"
        record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: token.end)
    } else {
        return nil
    }

    state syntaxID: Int(0 - 1)
    if kind == String("integerLiteral") {
        syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIntegerLiteral(), ordinal: 0, start: token.start, end: token.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
    } else if kind == String("identifier") {
        syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindIdentifier(), ordinal: 0, start: token.start, end: token.end, firstStart: token.start, firstEnd: token.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
    } else if sink.enabled {
        compilerSyntaxTablesPoison(tables: sink.tables)
    }

    state expressionEnd: Int(0)
    expressionEnd: token.end
    state suffixCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))

    while suffixCursor.index < limit {
        let maybeSuffix: Optional<RangeLexedToken>(compilerCursorPeek(cursor: suffixCursor))
        if maybeSuffix == nil {
            let completedPostfixExpression: CompilerExpression(CompilerExpression(kind: kind, value: value, summary: summary, record: record, start: token.start, end: expressionEnd))
            return CompilerParsedExpression(expression: completedPostfixExpression, syntaxID: syntaxID)
        }
        let suffixFallback: RangeLexedToken(compilerFallbackToken(cursor: suffixCursor))
        let suffixToken: RangeLexedToken(maybeSuffix ?? suffixFallback)
        if suffixToken.kind == String("dot") {
            let memberCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: suffixCursor, token: suffixToken))
            let maybeMember: Optional<RangeLexedToken>(compilerCursorPeek(cursor: memberCursor))
            if maybeMember == nil {
                return nil
            }
            let memberFallback: RangeLexedToken(compilerFallbackToken(cursor: memberCursor))
            let memberToken: RangeLexedToken(maybeMember ?? memberFallback)
            if memberToken.kind != String("identifier") && memberToken.kind != String("keyword") {
                return nil
            }
            let baseRecord: String(record)
            let baseSyntaxID: Int(syntaxID)
            kind: String("member")
            value: memberToken.text
            summary: "member(\(summary),\(memberToken.text))"
            expressionEnd: memberToken.end
            record: compilerCoreExpressionRecord(kind: kind, value: value, left: baseRecord, right: String(""), arguments: String(""), start: token.start, end: expressionEnd)
            syntaxID: compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindMemberRead(), ordinal: 0, start: token.start, end: expressionEnd, firstStart: memberToken.start, firstEnd: memberToken.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: syntaxID, childSyntaxID: baseSyntaxID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return nil
            }
            suffixCursor: compilerCursorAdvance(cursor: memberCursor, token: memberToken)
        } else if suffixToken.kind == String("leftParen") {
            let maybeArguments: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: suffixCursor, leftKind: String("leftParen"), rightKind: String("rightParen")))
            if maybeArguments == nil {
                return nil
            }
            let argumentsFallback: CompilerSourceRange(CompilerSourceRange(start: suffixToken.end, end: suffixToken.end, next: suffixToken.end))
            let argumentsRange: CompilerSourceRange(maybeArguments ?? argumentsFallback)
            let calleeRecord: String(record)
            let calleeSyntaxID: Int(syntaxID)
            let callSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindApplication(), ordinal: 0, start: token.start, end: argumentsRange.next, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: callSyntaxID, childSyntaxID: calleeSyntaxID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return nil
            }
            let arguments: CompilerCallArguments(parseCompilerCallArgumentsWithSink(source: source, start: argumentsRange.start, end: argumentsRange.end, sink: sink, callSyntaxID: callSyntaxID))
            kind: String("call")
            summary: "call(\(summary),arguments=[\(arguments.summary)])"
            expressionEnd: argumentsRange.next
            record: compilerCoreExpressionRecord(kind: kind, value: value, left: calleeRecord, right: String(""), arguments: arguments.records, start: token.start, end: expressionEnd)
            syntaxID: callSyntaxID
            suffixCursor: CompilerTokenCursor(source: source, index: argumentsRange.next)
        } else if suffixToken.kind == String("leftBracket") {
            let maybeParsedIndex: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: suffixToken.end, limit: limit, sink: sink))
            if maybeParsedIndex == nil {
                return nil
            }
            let parsedIndexFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: suffixToken.end))
            let parsedIndex: CompilerParsedExpression(maybeParsedIndex ?? parsedIndexFallback)
            let index: CompilerExpression(compilerParsedExpressionValue(parsed: parsedIndex))
            let maybeRightBracket: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: index.end))
            if maybeRightBracket == nil {
                return nil
            }
            let rightBracketToken: RangeLexedToken(maybeRightBracket ?? fallbackToken)
            if rightBracketToken.kind != String("rightBracket") {
                return nil
            }
            kind: String("index")
            value: index.value
            summary: "index(\(summary),\(index.summary))"
            expressionEnd: rightBracketToken.end
            record: compilerCoreExpressionRecord(kind: kind, value: value, left: String(""), right: String(""), arguments: String(""), start: token.start, end: expressionEnd)
            if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
            syntaxID: 0 - 1
            suffixCursor: CompilerTokenCursor(source: source, index: rightBracketToken.end)
        } else {
            let stoppedPostfixExpression: CompilerExpression(CompilerExpression(kind: kind, value: value, summary: summary, record: record, start: token.start, end: expressionEnd))
            return CompilerParsedExpression(expression: stoppedPostfixExpression, syntaxID: syntaxID)
        }
    }

    let finalPostfixExpression: CompilerExpression(CompilerExpression(kind: kind, value: value, summary: summary, record: record, start: token.start, end: expressionEnd))
    return CompilerParsedExpression(expression: finalPostfixExpression, syntaxID: syntaxID)
}
