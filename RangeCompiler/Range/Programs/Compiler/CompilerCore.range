    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return String("") }
    let typeFileID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceFileColumn()))
    let typeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: typeFileID, localStart: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceStartColumn()), localEnd: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceEndColumn())))
    let optionalTypeName: String(compilerSpecializedOptionalLLVMTypeName(tables: arena.tables, index: arena.declarationIndex, typeName: typeName))
    if optionalTypeName != String("") { return optionalTypeName }
    let syntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: syntaxID))
    return compilerNominalLLVMTypeName(tables: arena.tables, declarationRow: declarationRow)
}

function compilerBodyLLVMStorageTypeName(arena: CompilerBodyArena, storageID: Int): String {
    if storageID < 0 || storageID >= compilerIntTableRowCount(table: arena.storages) { return String("") }
    return compilerBodyLLVMNominalTypeNameForTypeID(arena: arena, typeID: compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageTypeIDColumn()))
}

function compilerBodyLLVMValueTypeName(arena: CompilerBodyArena, valueID: Int): String {
    let typeKind: Int(compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeColumn()))
    if typeKind == compilerBodyTypeConstruct() {
        let nominalName: String(compilerBodyLLVMNominalTypeNameForTypeID(arena: arena, typeID: compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeIDColumn())))
        if nominalName != String("") { return nominalName }
    }
    return compilerBodyLLVMTypeName(typeKind: typeKind)
}

function compilerBodyLLVMValue(emitter: CompilerBodyLLVMEmitter, valueID: Int): CompilerLLVMValue {
    let row: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: valueID))
    if row < 0 { return CompilerLLVMValue(text: String(""), typeName: String("")) }
    let kind: Int(compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentKindColumn()))
    let number: Int(compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentNumberColumn()))
    let aux: Int(compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentAuxColumn()))
    state typeName: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: valueID))
    if kind == compilerBodyLLVMValueParameter()
        && !compilerBodyArenaOwnerIsParticipant(arena: emitter.arena, plan: emitter.abiPlan) {
        typeName: compilerBodyLLVMTypeName(typeKind: compilerIntTableValue(table: emitter.arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeColumn()))
    }
    if kind == compilerBodyLLVMValueImmediate() {
        let sourceNodeID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueID, column: compilerBodyMIRValueSourceColumn()))
        return CompilerLLVMValue(text: compilerBodyArenaNodeText(arena: emitter.arena, nodeID: sourceNodeID), typeName: typeName)
    }
    if kind == compilerBodyLLVMValueParameter() {
        let symbolID: Int(aux)
        let name: String(compilerTypedSyntaxLocalText(tables: emitter.arena.tables, fileID: emitter.arena.fileID, localStart: compilerIntTableValue(table: emitter.arena.symbols, row: symbolID, column: compilerBodySymbolNameStartColumn()), localEnd: compilerIntTableValue(table: emitter.arena.symbols, row: symbolID, column: compilerBodySymbolNameEndColumn())))
        return CompilerLLVMValue(text: "%\(name)", typeName: typeName)
    }
    if kind == compilerBodyLLVMValueTemporary() { return CompilerLLVMValue(text: "%r\(number)", typeName: typeName) }
    if kind == compilerBodyLLVMValueGlobalString() { return CompilerLLVMValue(text: "getelementptr inbounds ([\(aux) x i8], ptr @.str.\(number), i32 0, i32 0)", typeName: String("ptr")) }
    if kind == compilerBodyLLVMValueAlias() { return compilerBodyLLVMValue(emitter: emitter, valueID: aux) }
    return CompilerLLVMValue(text: String(""), typeName: String(""))
}

function compilerBodyLLVMEmitterAppendInstruction(emitter: CompilerBodyLLVMEmitter, instruction: CompilerLLVMInstruction): Int {
    state rendered: String("")
    if instruction.operation == String("call") {
        rendered: "\(instruction.result) = call \(instruction.typeName) @\(instruction.left)(\(instruction.right))"
    } else if instruction.operation == String("puts") {
        rendered: "\(instruction.result) = call i32 @puts(ptr \(instruction.left))"
    } else if instruction.operation == String("phi") {
        rendered: "\(instruction.result) = phi \(instruction.typeName) \(instruction.left), \(instruction.right)"
    } else {
        rendered: "\(instruction.result) = \(instruction.operation) \(instruction.typeName) \(instruction.left), \(instruction.right)"
    }
    return textBufferAppend(buffer: emitter.renderedBlocks, text: "  \(rendered)\n")
}

function compilerBodyLLVMFunctionName(arena: CompilerBodyArena, functionID: Int): String {
    let syntaxID: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: syntaxID))
    let fileID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 1))
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 8))
}

function compilerBodyLLVMEmitterSeedParameters(emitter: CompilerBodyLLVMEmitter): Int {
    state valueRow: Int(0)
    while valueRow < compilerIntTableRowCount(table: emitter.arena.mirValues) {
        if compilerIntTableValue(table: emitter.arena.mirValues, row: valueRow, column: compilerBodyMIRValueKindColumn()) == compilerBodyMIRValueParameter() {
            if compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: valueRow, kind: compilerBodyLLVMValueParameter(), number: 0 - 1, aux: compilerIntTableValue(table: emitter.arena.mirValues, row: valueRow, column: compilerBodyMIRValueProvenanceIDColumn())) != 0 { return 0 - 1 }
        }
        valueRow: valueRow + 1
    }
    return 0
}

function compilerBodyLLVMConditionContinuationBlock(arena: CompilerBodyArena, blockID: Int): Int {
    let regionNodeID: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockRegionColumn()))
    let continuationOrdinal: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockFirstStatementColumn())
        + compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockStatementCountColumn()))
    state candidateBlockID: Int(0)
    while candidateBlockID < compilerIntTableRowCount(table: arena.cfgBlocks) {
        if compilerIntTableValue(table: arena.cfgBlocks, row: candidateBlockID, column: compilerBodyCFGBlockRegionColumn()) == regionNodeID
            && compilerIntTableValue(table: arena.cfgBlocks, row: candidateBlockID, column: compilerBodyCFGBlockFirstStatementColumn()) == continuationOrdinal { return candidateBlockID }
        candidateBlockID: candidateBlockID + 1
    }
    return 0 - 1
}

function compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: CompilerBodyLLVMEmitter, blockID: Int, visited: IntBuffer): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: emitter.arena.cfgBlocks) { return 0 - 1 }
    if intBufferElement(buffer: visited, index: blockID) == 1 { return 0 }
    if blockID != 0 && !compilerBodyLLVMAllForwardPredecessorsVisited(arena: emitter.arena, blockID: blockID, visited: visited) { return 0 }
    if intBufferSet(buffer: visited, index: blockID, value: 1) != 0 { return 0 - 1 }
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorKindColumn()))
    if terminatorKind == compilerBodyCFGTerminatorCondition() {
        let branchNumber: Int(intBufferElement(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextBranch()))
        let trueBlockID: Int(compilerBodyLLVMFirstCFGTarget(arena: emitter.arena, blockID: blockID, role: compilerBodyCFGEdgeTrue()))
        let falseBlockID: Int(compilerBodyLLVMFirstCFGTarget(arena: emitter.arena, blockID: blockID, role: compilerBodyCFGEdgeFalse()))
        state isWhileHeader: Bool(false)
        state incomingEdgeRow: Int(0)
        while incomingEdgeRow < compilerIntTableRowCount(table: emitter.arena.cfgEdges) {
            if compilerIntTableValue(table: emitter.arena.cfgEdges, row: incomingEdgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
                && compilerIntTableValue(table: emitter.arena.cfgEdges, row: incomingEdgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge() { isWhileHeader: true }
            incomingEdgeRow: incomingEdgeRow + 1
        }
        state trueLabelKind: Int(compilerBodyLLVMBlockLabelThen())
        state falseLabelKind: Int(compilerBodyLLVMBlockLabelAfter())
        let hasExplicitElse: Bool(compilerIntTableValue(table: emitter.arena.cfgBlocks, row: falseBlockID, column: compilerBodyCFGBlockRegionColumn())
            != compilerIntTableValue(table: emitter.arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockRegionColumn()))
        if hasExplicitElse {
            falseLabelKind: compilerBodyLLVMBlockLabelElse()
            let continuationBlockID: Int(compilerBodyLLVMConditionContinuationBlock(arena: emitter.arena, blockID: blockID))
            if continuationBlockID >= 0
                && compilerIntTableValue(table: emitter.blockLabels, row: continuationBlockID, column: compilerBodyLLVMBlockLabelKindColumn()) == 0 {
                if intBufferSet(buffer: emitter.blockLabels.values, index: continuationBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn(), value: compilerBodyLLVMBlockLabelAfter()) != 0
                    || intBufferSet(buffer: emitter.blockLabels.values, index: continuationBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn(), value: branchNumber) != 0 { return 0 - 1 }
            }
        }
        if isWhileHeader {
            trueLabelKind: compilerBodyLLVMBlockLabelWhileBody()
            falseLabelKind: compilerBodyLLVMBlockLabelAfterWhile()
            if intBufferSet(buffer: emitter.blockLabels.values, index: blockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn(), value: compilerBodyLLVMBlockLabelWhile()) != 0
                || intBufferSet(buffer: emitter.blockLabels.values, index: blockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn(), value: branchNumber) != 0 { return 0 - 1 }
        }
        if intBufferSet(buffer: emitter.blockLabels.values, index: trueBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn(), value: trueLabelKind) != 0
            || intBufferSet(buffer: emitter.blockLabels.values, index: trueBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn(), value: branchNumber) != 0
            || intBufferSet(buffer: emitter.blockLabels.values, index: falseBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn(), value: falseLabelKind) != 0
            || intBufferSet(buffer: emitter.blockLabels.values, index: falseBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn(), value: branchNumber) != 0
            || intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextBranch(), value: branchNumber + 1) != 0 { return 0 - 1 }
        if compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: emitter, blockID: trueBlockID, visited: visited) != 0 { return 0 - 1 }
        return compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: emitter, blockID: falseBlockID, visited: visited)
    }
    if terminatorKind == compilerBodyCFGTerminatorFallthrough() {
        let targetBlockID: Int(compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: blockID))
        return compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: emitter, blockID: targetBlockID, visited: visited)
    }
    return 0
}

function compilerBodyLLVMEmitterInitializeLabels(emitter: CompilerBodyLLVMEmitter): Int {
    state blockRow: Int(0)
    let blockCount: Int(compilerIntTableRowCount(table: emitter.arena.cfgBlocks))
    while blockRow < blockCount {
        if compilerIntTableAppend(table: emitter.blockLabels, value: blockRow) != 0
            || compilerIntTableAppend(table: emitter.blockLabels, value: compilerBodyLLVMBlockLabelAfter()) != 0
            || compilerIntTableAppend(table: emitter.blockLabels, value: blockRow) != 0 { return 0 - 1 }
        blockRow: blockRow + 1
    }
    if intBufferSet(buffer: emitter.blockLabels.values, index: compilerBodyLLVMBlockLabelKindColumn(), value: compilerBodyLLVMBlockLabelEntry()) != 0 { return 0 - 1 }
    return 0
}

function compilerBodyLLVMBlockLabel(emitter: CompilerBodyLLVMEmitter, blockID: Int): String {
    if blockID == 0 { return String("entry") }
    return "bb\(blockID)"
}

function compilerBodyLLVMFirstCFGTarget(arena: CompilerBodyArena, blockID: Int, role: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) == blockID
            && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == role { return compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyLLVMBranchTarget(arena: CompilerBodyArena, blockID: Int): Int {
    let fallthroughTarget: Int(compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeFallthrough()))
    if fallthroughTarget >= 0 { return fallthroughTarget }
    return compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeBackedge())
}

function compilerBodyMIROperationOperandValueID(arena: CompilerBodyArena, operationID: Int, ordinal: Int): Int {
    state operandRow: Int(0)
    while operandRow < compilerIntTableRowCount(table: arena.mirOperands) {
        if compilerIntTableValue(table: arena.mirOperands, row: operandRow, column: compilerBodyMIROperandOperationColumn()) == operationID
            && compilerIntTableValue(table: arena.mirOperands, row: operandRow, column: compilerBodyMIROperandOrdinalColumn()) == ordinal { return compilerIntTableValue(table: arena.mirOperands, row: operandRow, column: compilerBodyMIROperandValueColumn()) }
        operandRow: operandRow + 1
    }
    return 0 - 1
}

function compilerBodyLLVMOperationOperandValueID(arena: CompilerBodyArena, operationID: Int, ordinal: Int): Int {
    return compilerBodyMIROperationOperandValueID(arena: arena, operationID: operationID, ordinal: ordinal)
}

function compilerBodyLLVMFirstCFGPredecessor(arena: CompilerBodyArena, blockID: Int, role: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
            && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == role { return compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyLLVMEmitterPlanOperation(emitter: CompilerBodyLLVMEmitter, operationID: Int): Int {
    let operationKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationKindColumn()))
    let resultValueID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationResultColumn()))
    if compilerBodyMIROperationIsTerminator(kind: operationKind) { return 0 }
    if compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID) >= 0 { return 0 }
    if operationKind == compilerBodyMIROperationConstant() {
        return compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueImmediate(), number: 0 - 1, aux: 0 - 1)
    }
    if operationKind == compilerBodyMIROperationLocalValue() || operationKind == compilerBodyMIROperationAssignVersion() {
        return compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueAlias(), number: 0 - 1, aux: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
    }
    if operationKind == compilerBodyMIROperationDirectCall()
        && compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationTargetKindColumn()) == compilerBodyMIROperationTargetBuiltin() {
        return compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueAlias(), number: 0 - 1, aux: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
    }
    let plannedTemporary: Int(intBufferElement(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary()))
    if operationKind == compilerBodyMIROperationStringGlobal() {
        let plannedStringSourceNodeID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: resultValueID, column: compilerBodyMIRValueSourceColumn()))
        let plannedLiteralText: String(compilerBodyArenaNodeText(arena: emitter.arena, nodeID: plannedStringSourceNodeID))
        state literalContent: String(compilerCoreStringLiteralContent(text: plannedLiteralText))
        state stringDescriptorKind: Int(compilerBodyLLVMGlobalDescriptorStringLiteral())
        if compilerIntTableValue(table: emitter.arena.nodes, row: plannedStringSourceNodeID, column: 1) == compilerSyntaxKindStringSegment() {
            literalContent: compilerCoreDecodeStringLiteralContent(content: plannedLiteralText)
            stringDescriptorKind: compilerBodyLLVMGlobalDescriptorStringSegment()
        }
        let literalLength: Int(stringLength(value: literalContent))
        let byteCount: Int(literalLength + 1)
        if compilerIntTableAppend(table: emitter.globalDescriptors, value: plannedTemporary) != 0
            || compilerIntTableAppend(table: emitter.globalDescriptors, value: plannedStringSourceNodeID) != 0
            || compilerIntTableAppend(table: emitter.globalDescriptors, value: byteCount) != 0
            || compilerIntTableAppend(table: emitter.globalDescriptors, value: stringDescriptorKind) != 0
            || compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueGlobalString(), number: plannedTemporary, aux: byteCount) != 0
            || intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary(), value: plannedTemporary + 1) != 0 { return 0 - 1 }
        return 0
    }
    if operationKind == compilerBodyMIROperationMemberRead() {
        let plannedMemberReceiverValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        let plannedMemberReceiverValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: plannedMemberReceiverValueID))
        if plannedMemberReceiverValue.typeName != String("ptr") {
            if compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueTemporary(), number: plannedTemporary, aux: 0 - 1) != 0
                || intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary(), value: plannedTemporary + 1) != 0 { return 0 - 1 }
            return 0
        }
        let plannedMemberSourceNodeID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationSourceColumn()))
        let memberText: String(compilerBodyArenaNodeText(arena: emitter.arena, nodeID: plannedMemberSourceNodeID))
        let memberTextLength: Int(stringLength(value: memberText))
        let memberByteCount: Int(memberTextLength + 1)
        if compilerIntTableAppend(table: emitter.globalDescriptors, value: plannedTemporary) != 0
            || compilerIntTableAppend(table: emitter.globalDescriptors, value: plannedMemberSourceNodeID) != 0
            || compilerIntTableAppend(table: emitter.globalDescriptors, value: memberByteCount) != 0
            || compilerIntTableAppend(table: emitter.globalDescriptors, value: compilerBodyLLVMGlobalDescriptorMemberName()) != 0
            || compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueTemporary(), number: plannedTemporary + 1, aux: 0 - 1) != 0
            || intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary(), value: plannedTemporary + 2) != 0 { return 0 - 1 }
        return 0
    }
    if operationKind == compilerBodyMIROperationConstruct() {
        let fieldCount: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationOperandCountColumn()))
        if fieldCount < 1
            || compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueTemporary(), number: plannedTemporary + fieldCount - 1, aux: 0 - 1) != 0
            || intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary(), value: plannedTemporary + fieldCount) != 0 { return 0 - 1 }
        return 0
    }
    if operationKind == compilerBodyMIROperationOptionalSome() {
        if compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueTemporary(), number: plannedTemporary + 1, aux: 0 - 1) != 0 { return 0 - 1 }
        return intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary(), value: plannedTemporary + 2)
    }
    state resultTemporary: Int(plannedTemporary)
    state consumedTemporaryCount: Int(1)
    if operationKind == compilerBodyMIROperationEqual() || operationKind == compilerBodyMIROperationNotEqual() {
        let leftValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        let rightValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1))
        let leftValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: leftValueID))
        let rightValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: rightValueID))
        let comparesOptionalNil: Bool(compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: leftValueID, operationKind: compilerBodyMIROperationOptionalNone()) || compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: rightValueID, operationKind: compilerBodyMIROperationOptionalNone()))
        if comparesOptionalNil {
            resultTemporary: plannedTemporary + 1
            consumedTemporaryCount: 2
        } else if leftValue.typeName == String("ptr") && rightValue.typeName == String("ptr") {
            resultTemporary: plannedTemporary + 1
            consumedTemporaryCount: 2
            if intBufferElement(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements()) < compilerBodyLLVMRuntimeStringEqual()
                && intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements(), value: compilerBodyLLVMRuntimeStringEqual()) != 0 { return 0 - 1 }
        }
    }
    if operationKind >= compilerBodyMIROperationLessThan() && operationKind <= compilerBodyMIROperationGreaterEqual() {
        let orderedLeftValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        let orderedRightValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1))
        let orderedLeftValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: orderedLeftValueID))
        let orderedRightValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: orderedRightValueID))
        if orderedLeftValue.typeName == String("ptr") && orderedRightValue.typeName == String("ptr") {
            resultTemporary: plannedTemporary + 1
            consumedTemporaryCount: 2
            if intBufferElement(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements()) < compilerBodyLLVMRuntimeStringCompare()
                && intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements(), value: compilerBodyLLVMRuntimeStringCompare()) != 0 { return 0 - 1 }
        }
    }
    if compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueTemporary(), number: resultTemporary, aux: 0 - 1) != 0
        || intBufferSet(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary(), value: plannedTemporary + consumedTemporaryCount) != 0 { return 0 - 1 }
    return 0
}

function compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: CompilerBodyLLVMEmitter, blockID: Int, visited: IntBuffer): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: emitter.arena.mirBlocks) { return 0 - 1 }
    if intBufferElement(buffer: visited, index: blockID) == 1 { return 0 }
    if blockID != 0 && !compilerBodyLLVMAllForwardPredecessorsVisited(arena: emitter.arena, blockID: blockID, visited: visited) { return 0 }
    if intBufferSet(buffer: visited, index: blockID, value: 1) != 0 { return 0 - 1 }
    let firstOperation: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: blockID, column: compilerBodyMIRBlockFirstOperationColumn()))
    let operationCount: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: blockID, column: compilerBodyMIRBlockOperationCountColumn()))
    state operationOffset: Int(0)
    while operationOffset + 1 < operationCount {
        if compilerBodyLLVMEmitterPlanOperation(emitter: emitter, operationID: firstOperation + operationOffset) != 0 { return 0 - 1 }
        operationOffset: operationOffset + 1
    }
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: firstOperation + operationCount - 1, column: compilerBodyMIROperationKindColumn()))
    if terminatorKind == compilerBodyMIROperationCondBranch() {
        let trueBlockID: Int(compilerBodyLLVMFirstCFGTarget(arena: emitter.arena, blockID: blockID, role: compilerBodyCFGEdgeTrue()))
        let falseBlockID: Int(compilerBodyLLVMFirstCFGTarget(arena: emitter.arena, blockID: blockID, role: compilerBodyCFGEdgeFalse()))
        if compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: trueBlockID, visited: visited) != 0 { return 0 - 1 }
        return compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: falseBlockID, visited: visited)
    }
    if terminatorKind == compilerBodyMIROperationBranch() {
        return compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: blockID), visited: visited)
    }
    return 0
}

function compilerBodyLLVMEmitterProcessOperation(emitter: CompilerBodyLLVMEmitter, operationID: Int): Int {
    let operationKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationKindColumn()))
    let resultValueID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationResultColumn()))
    if operationKind == compilerBodyMIROperationConstant()
        || operationKind == compilerBodyMIROperationStringGlobal()
        || operationKind == compilerBodyMIROperationLocalValue()
        || operationKind == compilerBodyMIROperationAssignVersion() { return 0 }
    if operationKind == compilerBodyMIROperationConstruct() {
        let constructAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let fieldCount: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationOperandCountColumn()))
        let constructTypeName: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: resultValueID))
        if constructAssignmentRow < 0 || fieldCount < 1 || constructTypeName == String("") { return 0 - 1 }
        let finalTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: constructAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        let firstTemporary: Int(finalTemporary - fieldCount + 1)
        state aggregateOperand: String("poison")
        state constructOrdinal: Int(0)
        while constructOrdinal < fieldCount {
            let fieldValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: constructOrdinal))
            let fieldValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: fieldValueID))
            if fieldValue.text == String("") { return 0 - 1 }
            let temporary: Int(firstTemporary + constructOrdinal)
            if textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(temporary) = insertvalue \(constructTypeName) \(aggregateOperand), \(fieldValue.typeName) \(fieldValue.text), \(constructOrdinal)\n") != 0 { return 0 - 1 }
            aggregateOperand: "%r\(temporary)"
            constructOrdinal: constructOrdinal + 1
        }
        return 0
    }
    if operationKind == compilerBodyMIROperationOptionalNone() {
        let noneAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let noneTypeName: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: resultValueID))
        if noneAssignmentRow < 0 || noneTypeName == String("") { return 0 - 1 }
        let noneTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: noneAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(noneTemporary) = insertvalue \(noneTypeName) poison, i1 false, 0\n")
    }
    if operationKind == compilerBodyMIROperationOptionalSome() {
        let someAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let someTypeName: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: resultValueID))
        let somePayloadValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        if someAssignmentRow < 0 || someTypeName == String("") || somePayloadValue.text == String("") { return 0 - 1 }
        let someFinalTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: someAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        let someTagTemporary: Int(someFinalTemporary - 1)
        if textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(someTagTemporary) = insertvalue \(someTypeName) poison, i1 true, 0\n") != 0 { return 0 - 1 }
        return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(someFinalTemporary) = insertvalue \(someTypeName) %r\(someTagTemporary), \(somePayloadValue.typeName) \(somePayloadValue.text), 1\n")
    }
    if operationKind == compilerBodyMIROperationDirectCall() {
        let targetKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationTargetKindColumn()))
        if targetKind == compilerBodyMIROperationTargetBuiltin() {
            let wrappedValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
            return compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: resultValueID, kind: compilerBodyLLVMValueAlias(), number: 0 - 1, aux: wrappedValueID)
        }
        let callTargetID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationTargetIDColumn()))
        let callIsIndirect: Bool(targetKind == compilerBodyMIROperationTargetFunction()
            && compilerModuleABIPlanReturnMode(plan: emitter.abiPlan, tables: emitter.arena.tables, index: emitter.arena.declarationIndex, functionRow: callTargetID) == compilerFunctionReturnABIIndirect())
        let callStorageID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationStorageIDColumn()))
        let argumentBuffer: TextBuffer(textBufferCreate(capacity: 256))
        state hasRenderedCallArgument: Bool(false)
        state callDestination: String("")
        if callIsIndirect {
            if callStorageID >= 0 && compilerIntTableValue(table: emitter.arena.storages, row: callStorageID, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCalleeReturn() {
                callDestination: String("%returnDestination")
            } else if callStorageID >= 0 {
                callDestination: "%storage\(callStorageID)"
            }
            if callDestination == String("") || textBufferAppend(buffer: argumentBuffer, text: "ptr \(callDestination)") != 0 {
                textBufferDestroy(buffer: argumentBuffer)
                return 0 - 1
            }
            hasRenderedCallArgument: true
        }
        state ordinal: Int(0)
        let operandCount: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationOperandCountColumn()))
        while ordinal < operandCount {
            let argumentValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: ordinal))
            let argumentValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: argumentValueID))
            if argumentValue.text == String("") {
                textBufferDestroy(buffer: argumentBuffer)
                return 0 - 1
            }
            if hasRenderedCallArgument { textBufferAppend(buffer: argumentBuffer, text: String(", ")) }
            textBufferAppend(buffer: argumentBuffer, text: "\(argumentValue.typeName) \(argumentValue.text)")
            hasRenderedCallArgument: true
            ordinal: ordinal + 1
        }
        let renderedArguments: String(textBufferMaterialize(buffer: argumentBuffer))
        textBufferDestroy(buffer: argumentBuffer)
        let callAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        if callAssignmentRow < 0 { return 0 - 1 }
        let callTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: callAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        state callTargetName: String("")
        if targetKind == compilerBodyMIROperationTargetFunction() { callTargetName: compilerBodyLLVMFunctionName(arena: emitter.arena, functionID: callTargetID) }
        if targetKind == compilerBodyMIROperationTargetRuntimeBuiltin() { callTargetName: compilerBodyRuntimeBuiltinName(id: callTargetID) }
        if callIsIndirect {
            let callResultTypeName: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: resultValueID))
            if callTargetName == String("") || callResultTypeName == String("") { return 0 - 1 }
            if textBufferAppend(buffer: emitter.renderedBlocks, text: "  call void @\(callTargetName)(\(renderedArguments))\n") != 0 { return 0 - 1 }
            return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(callTemporary) = load \(callResultTypeName), ptr \(callDestination)\n")
        }
        let callInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(callTemporary)", operation: String("call"), typeName: compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: resultValueID), left: callTargetName, right: renderedArguments))
        if callTargetName == String("") || compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: callInstruction) != 0 { return 0 - 1 }
        return 0
    }
    if operationKind == compilerBodyMIROperationOptionalHasValue() || operationKind == compilerBodyMIROperationOptionalPayload() {
        let optionalAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let optionalOperandValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        let optionalOperandValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: optionalOperandValueID))
        let optionalAggregateType: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: optionalOperandValueID))
        state optionalFieldOrdinal: Int(0)
        if operationKind == compilerBodyMIROperationOptionalPayload() { optionalFieldOrdinal: 1 }
        if optionalAssignmentRow < 0 || optionalOperandValue.text == String("") || optionalAggregateType == String("") { return 0 - 1 }
        let optionalTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: optionalAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(optionalTemporary) = extractvalue \(optionalAggregateType) \(optionalOperandValue.text), \(optionalFieldOrdinal)\n")
    }
    if operationKind == compilerBodyMIROperationStringConcat() {
        let concatAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let concatLeftValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        let concatRightValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1)))
        if concatAssignmentRow < 0 || concatLeftValue.typeName != String("ptr") || concatRightValue.typeName != String("ptr") { return 0 - 1 }
        let concatTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: concatAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(concatTemporary) = call ptr @stringConcat(ptr \(concatLeftValue.text), ptr \(concatRightValue.text))\n")
    }
    if operationKind == compilerBodyMIROperationStringFromInt() || operationKind == compilerBodyMIROperationStringFromBool() {
        let conversionAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let convertedValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        state conversionFunctionName: String("stringFromInt")
        state conversionOperandType: String("i32")
        if operationKind == compilerBodyMIROperationStringFromBool() {
            conversionFunctionName: String("stringFromBool")
            conversionOperandType: String("i1")
        }
        if conversionAssignmentRow < 0 || convertedValue.typeName != conversionOperandType { return 0 - 1 }
        let conversionTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: conversionAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(conversionTemporary) = call ptr @\(conversionFunctionName)(\(conversionOperandType) \(convertedValue.text))\n")
    }
    if operationKind == compilerBodyMIROperationPhi() {
        let phiAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let phiInitialValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        let phiBackedgeValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1)))
        let phiBlockID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationBlockColumn()))
        state phiInitialBlockID: Int(0 - 1)
        state phiSecondBlockID: Int(0 - 1)
        phiInitialBlockID: compilerBodyLLVMFirstCFGPredecessor(arena: emitter.arena, blockID: phiBlockID, role: compilerBodyCFGEdgeFallthrough())
        phiSecondBlockID: compilerBodyLLVMFirstCFGPredecessor(arena: emitter.arena, blockID: phiBlockID, role: compilerBodyCFGEdgeBackedge())
        if phiSecondBlockID < 0 {
            phiInitialBlockID: compilerBodyMIRForwardPredecessorAt(arena: emitter.arena, blockID: phiBlockID, ordinal: 0)
            phiSecondBlockID: compilerBodyMIRForwardPredecessorAt(arena: emitter.arena, blockID: phiBlockID, ordinal: 1)
        }
        if phiAssignmentRow < 0 || phiInitialValue.text == String("") || phiBackedgeValue.text == String("") || phiInitialBlockID < 0 || phiSecondBlockID < 0 { return 0 - 1 }
        let phiTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: phiAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        let phiInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(phiTemporary)", operation: String("phi"), typeName: phiInitialValue.typeName, left: "[\(phiInitialValue.text), %\(compilerBodyLLVMBlockLabel(emitter: emitter, blockID: phiInitialBlockID))]", right: "[\(phiBackedgeValue.text), %\(compilerBodyLLVMBlockLabel(emitter: emitter, blockID: phiSecondBlockID))]"))
        return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: phiInstruction)
    }
    if operationKind == compilerBodyMIROperationMemberRead() {
        let memberAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let memberReceiverValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        if memberAssignmentRow < 0 || memberReceiverValue.text == String("") { return 0 - 1 }
        let memberCallTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: memberAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        if memberReceiverValue.typeName != String("ptr") {
            let nativeMemberRow: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationTargetIDColumn()))
            if nativeMemberRow < 0 { return 0 - 1 }
            let nativeMemberOrdinal: Int(compilerIntTableValue(table: emitter.arena.tables.members, row: nativeMemberRow, column: 3))
            if nativeMemberOrdinal < 0 { return 0 - 1 }
            return textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(memberCallTemporary) = extractvalue \(memberReceiverValue.typeName) \(memberReceiverValue.text), \(nativeMemberOrdinal)\n")
        }
        let memberGlobalTemporary: Int(memberCallTemporary - 1)
        let memberNodeID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationSourceColumn()))
        let memberNameText: String(compilerBodyArenaNodeText(arena: emitter.arena, nodeID: memberNodeID))
        let emittedMemberNameLength: Int(stringLength(value: memberNameText))
        let emittedMemberByteCount: Int(emittedMemberNameLength + 1)
        let memberTypeName: String(compilerBodyLLVMTypeName(typeKind: compilerIntTableValue(table: emitter.arena.mirValues, row: resultValueID, column: compilerBodyMIRValueTypeColumn())))
        state memberGetterName: String("rangeConstructGetPtr")
        if memberTypeName == String("i32") { memberGetterName: String("rangeConstructGetInt") }
        if memberTypeName == String("i1") { memberGetterName: String("rangeConstructGetBool") }
        let memberArguments: String("ptr \(memberReceiverValue.text), ptr getelementptr inbounds ([\(emittedMemberByteCount) x i8], ptr @.str.\(memberGlobalTemporary), i32 0, i32 0)")
        let memberInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(memberCallTemporary)", operation: String("call"), typeName: memberTypeName, left: memberGetterName, right: memberArguments))
        return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: memberInstruction)
    }
    if operationKind == compilerBodyMIROperationPrefixNot() || operationKind == compilerBodyMIROperationPrefixNegate() {
        let prefixAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let prefixOperandValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        if prefixAssignmentRow < 0 || prefixOperandValue.text == String("") { return 0 - 1 }
        let prefixTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: prefixAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        state prefixInstructionName: String("xor")
        state prefixLeft: String("")
        state prefixRight: String("true")
        prefixLeft: prefixOperandValue.text
        if operationKind == compilerBodyMIROperationPrefixNegate() {
            prefixInstructionName: String("sub")
            prefixLeft: String("0")
            prefixRight: prefixOperandValue.text
        }
        let prefixInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(prefixTemporary)", operation: prefixInstructionName, typeName: prefixOperandValue.typeName, left: prefixLeft, right: prefixRight))
        return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: prefixInstruction)
    }
    if (operationKind >= compilerBodyMIROperationEqual() && operationKind <= compilerBodyMIROperationOr())
        || (operationKind >= compilerBodyMIROperationAdd() && operationKind <= compilerBodyMIROperationGreaterEqual())
        || operationKind == compilerBodyMIROperationDivide() || operationKind == compilerBodyMIROperationRemainder() {
        let leftValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        let rightValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1))
        let leftValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: leftValueID))
        let rightValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: rightValueID))
        let binaryAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        if binaryAssignmentRow < 0 { return 0 - 1 }
        state binaryTemporary: Int(0)
        binaryTemporary: compilerIntTableValue(table: emitter.valueAssignments, row: binaryAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn())
        let leftIsOptionalNone: Bool(compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: leftValueID, operationKind: compilerBodyMIROperationOptionalNone()))
        let rightIsOptionalNone: Bool(compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: rightValueID, operationKind: compilerBodyMIROperationOptionalNone()))
        if (operationKind == compilerBodyMIROperationEqual() || operationKind == compilerBodyMIROperationNotEqual()) && (leftIsOptionalNone || rightIsOptionalNone) {
            state comparedOptionalValueID: Int(leftValueID)
            state comparedOptionalValue: CompilerLLVMValue(leftValue)
            if leftIsOptionalNone {
                comparedOptionalValueID: rightValueID
                comparedOptionalValue: rightValue
            }
            let comparedOptionalType: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: comparedOptionalValueID))
            let optionalTagTemporary: Int(binaryTemporary - 1)
            if comparedOptionalType == String("") || comparedOptionalValue.text == String("") { return 0 - 1 }
            if textBufferAppend(buffer: emitter.renderedBlocks, text: "  %r\(optionalTagTemporary) = extractvalue \(comparedOptionalType) \(comparedOptionalValue.text), 0\n") != 0 { return 0 - 1 }
            state optionalComparisonName: String("icmp eq")
            if operationKind == compilerBodyMIROperationNotEqual() { optionalComparisonName: String("icmp ne") }
            let optionalComparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: optionalComparisonName, typeName: String("i1"), left: "%r\(optionalTagTemporary)", right: String("false")))
            return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: optionalComparisonInstruction)
        }
        if (operationKind == compilerBodyMIROperationEqual() || operationKind == compilerBodyMIROperationNotEqual()) && leftValue.typeName == String("ptr") && rightValue.typeName == String("ptr") {
            let stringEqualTemporary: Int(binaryTemporary - 1)
            let equalInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(stringEqualTemporary)", operation: String("call"), typeName: String("i32"), left: String("stringEqual"), right: "ptr \(leftValue.text), ptr \(rightValue.text)"))
            state comparisonOperation: String("icmp ne")
            if operationKind == compilerBodyMIROperationNotEqual() { comparisonOperation: String("icmp eq") }
            let comparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: comparisonOperation, typeName: String("i32"), left: "%r\(stringEqualTemporary)", right: String("0")))
            if compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: equalInstruction) != 0
                || compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: comparisonInstruction) != 0 { return 0 - 1 }
            return 0
        }
        if operationKind >= compilerBodyMIROperationLessThan() && operationKind <= compilerBodyMIROperationGreaterEqual()
            && leftValue.typeName == String("ptr") && rightValue.typeName == String("ptr") {
            let stringCompareTemporary: Int(binaryTemporary - 1)
            let compareInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(stringCompareTemporary)", operation: String("call"), typeName: String("i32"), left: String("stringCompare"), right: "ptr \(leftValue.text), ptr \(rightValue.text)"))
            state orderedComparisonOperation: String("icmp slt")
            if operationKind == compilerBodyMIROperationLessEqual() { orderedComparisonOperation: String("icmp sle") }
            if operationKind == compilerBodyMIROperationGreaterThan() { orderedComparisonOperation: String("icmp sgt") }
            if operationKind == compilerBodyMIROperationGreaterEqual() { orderedComparisonOperation: String("icmp sge") }
            let orderedComparisonInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: orderedComparisonOperation, typeName: String("i32"), left: "%r\(stringCompareTemporary)", right: String("0")))
            if compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: compareInstruction) != 0
                || compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: orderedComparisonInstruction) != 0 { return 0 - 1 }
            return 0
        }
        state instructionName: String("icmp eq")
        if operationKind == compilerBodyMIROperationNotEqual() { instructionName: String("icmp ne") }
        if operationKind == compilerBodyMIROperationAnd() { instructionName: String("and") }
        if operationKind == compilerBodyMIROperationOr() { instructionName: String("or") }
        if operationKind == compilerBodyMIROperationAdd() { instructionName: String("add") }
        if operationKind == compilerBodyMIROperationSubtract() { instructionName: String("sub") }
        if operationKind == compilerBodyMIROperationMultiply() { instructionName: String("mul") }
        if operationKind == compilerBodyMIROperationDivide() { instructionName: String("sdiv") }
        if operationKind == compilerBodyMIROperationRemainder() { instructionName: String("srem") }
        if operationKind == compilerBodyMIROperationLessThan() { instructionName: String("icmp slt") }
        if operationKind == compilerBodyMIROperationLessEqual() { instructionName: String("icmp sle") }
        if operationKind == compilerBodyMIROperationGreaterThan() { instructionName: String("icmp sgt") }
        if operationKind == compilerBodyMIROperationGreaterEqual() { instructionName: String("icmp sge") }
        let binaryInstruction: CompilerLLVMInstruction(CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: instructionName, typeName: leftValue.typeName, left: leftValue.text, right: rightValue.text))
        if compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: binaryInstruction) != 0 { return 0 - 1 }
        return 0
    }
    return 0 - 1
}

function compilerBodyLLVMEmitterRenderBlock(emitter: CompilerBodyLLVMEmitter, mirBlockID: Int): Int {
    let cfgBlockID: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockCFGColumn()))
    let firstOperation: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
    let operationCount: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
    let terminatorOperationID: Int(firstOperation + operationCount - 1)
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: terminatorOperationID, column: compilerBodyMIROperationKindColumn()))
    let initialTerminal: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: String(""), falseLabel: String("")))
    state terminal: CompilerLLVMTerminator(initialTerminal)
    if terminatorKind == compilerBodyMIROperationCondBranch() {
        let conditionValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: terminatorOperationID, ordinal: 0))
        let conditionValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: conditionValueID))
        let trueBlockID: Int(compilerBodyLLVMFirstCFGTarget(arena: emitter.arena, blockID: cfgBlockID, role: compilerBodyCFGEdgeTrue()))
        let falseBlockID: Int(compilerBodyLLVMFirstCFGTarget(arena: emitter.arena, blockID: cfgBlockID, role: compilerBodyCFGEdgeFalse()))
        terminal: CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: conditionValue.text, trueLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: trueBlockID), falseLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: falseBlockID))
    }
    if terminatorKind == compilerBodyMIROperationReturn() {
        let returnValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: terminatorOperationID, ordinal: 0))
        let returnValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: returnValueID))
        if compilerBodyArenaOwnerReturnMode(arena: emitter.arena, plan: emitter.abiPlan) == compilerFunctionReturnABIIndirect() {
            if textBufferAppend(buffer: emitter.renderedBlocks, text: "  store \(returnValue.typeName) \(returnValue.text), ptr %returnDestination\n") != 0 { return 0 - 1 }
            terminal: CompilerLLVMTerminator(kind: String("return"), typeName: String("void"), value: String(""), trueLabel: String(""), falseLabel: String(""))
        } else {
            terminal: CompilerLLVMTerminator(kind: String("return"), typeName: returnValue.typeName, value: returnValue.text, trueLabel: String(""), falseLabel: String(""))
        }
    }
    if terminatorKind == compilerBodyMIROperationBranch() {
        let targetBlockID: Int(compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: cfgBlockID))
        terminal: CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: targetBlockID), falseLabel: String(""))
    }
    return textBufferAppend(buffer: emitter.renderedBlocks, text: "  \(compilerCoreRenderLLVMTerminator(terminal: terminal))\n")
}

function compilerBodyLLVMEmitterRenderCFGDepthFirst(emitter: CompilerBodyLLVMEmitter, mirBlockID: Int, visited: IntBuffer): Int {
    if mirBlockID < 0 || mirBlockID >= compilerIntTableRowCount(table: emitter.arena.mirBlocks) { return 0 - 1 }
    if intBufferElement(buffer: visited, index: mirBlockID) == 1 { return 0 }
    if mirBlockID != 0 && !compilerBodyLLVMAllForwardPredecessorsVisited(arena: emitter.arena, blockID: mirBlockID, visited: visited) { return 0 }
    if intBufferSet(buffer: visited, index: mirBlockID, value: 1) != 0 { return 0 - 1 }
    let firstOperation: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
    let operationCount: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
    state valid: Bool(operationCount > 0)
    let cfgBlockID: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockCFGColumn()))
    if textBufferAppend(buffer: emitter.renderedBlocks, text: "\(compilerBodyLLVMBlockLabel(emitter: emitter, blockID: cfgBlockID)):\n") != 0 { valid: false }
