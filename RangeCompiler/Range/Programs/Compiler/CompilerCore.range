function compilerCoreASTSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreASTSummaryForProgram(program: program)
}

function compilerSourceInventorySummary(source: String): String {
    let files: String(compilerSourceInventoryFileRecords(source: source))
    let count: Int(compilerSourceInventoryFileCount(source: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    return "sourceInventory\(tab)program\(newline)\(files)sourceFileCount\(tab)\(count)\(newline)"
}

function compilerSourceInventoryFileRecords(source: String): String {
    return compilerSourceInventoryFileRecordsFromIndex(source: source, sourceIndex: 0, output: String(""), fileCount: 0)
}

function compilerSourceInventoryFileRecordsFromIndex(source: String, sourceIndex: Int, output: String, fileCount: Int): String {
    let sourceLength: Int(stringLength(value: source))
    let nextMarkerIndex: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if nextMarkerIndex >= sourceLength {
        return output
    }

    let nextOutput: String(compilerSourceInventoryFileRecordsAppending(output: output, source: source, sourceIndex: nextMarkerIndex, fileCount: fileCount))
    let nextSourceIndex: Int(compilerSourceNextIndexAfterFileMarker(source: source, sourceIndex: nextMarkerIndex))
    return compilerSourceInventoryFileRecordsFromIndex(source: source, sourceIndex: nextSourceIndex, output: nextOutput, fileCount: fileCount + 1)
}

function compilerSourceInventoryFileRecordsAppending(output: String, source: String, sourceIndex: Int, fileCount: Int): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))
    let pathStart: Int(sourceIndex + markerLength)
    let pathEnd: Int(compilerSourceFilePathEnd(source: source, start: pathStart))
    let path: String(source.substring(start: pathStart, end: pathEnd))
    return "\(output)sourceFile\(tab)index=\(fileCount)\(tab)path=\(path)\(newline)"
}

function compilerSourceInventoryFileCount(source: String): Int {
    return compilerSourceInventoryFileCountFromIndex(source: source, sourceIndex: 0, fileCount: 0)
}

function compilerSourceInventoryFileCountFromIndex(source: String, sourceIndex: Int, fileCount: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    let nextMarkerIndex: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if nextMarkerIndex >= sourceLength {
        return fileCount
    }

    let nextSourceIndex: Int(compilerSourceNextIndexAfterFileMarker(source: source, sourceIndex: nextMarkerIndex))
    return compilerSourceInventoryFileCountFromIndex(source: source, sourceIndex: nextSourceIndex, fileCount: fileCount + 1)
}

function compilerSourceNextIndexAfterFileMarker(source: String, sourceIndex: Int): Int {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))
    return compilerSourceFilePathEnd(source: source, start: sourceIndex + markerLength)
}

function compilerSourceFileMarker(): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    return "compilerSourceFile\(slash)t"
}

function compilerSourceFilePathEnd(source: String, start: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    let suffixIndex: Int(stringIndexOf(source: source, needle: String(".range"), start: start))
    if suffixIndex >= sourceLength {
        return sourceLength
    }
    return suffixIndex + 6
}

function compilerSourceSetASTSummary(source: String): String {
    state output: String("sourceSetAST\tprogram\n")
    state sourceIndex: Int(0)
    state fileCount: Int(0)
    let sourceLength: Int(stringLength(value: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: source, start: sourceIndex, prefix: marker) {
            let pathStart: Int(sourceIndex + markerLength)
            state pathEnd: Int(0)
            pathEnd: pathStart
            while pathEnd < sourceLength && source.character(index: pathEnd) > String(" ") {
                pathEnd: pathEnd + 1
            }

            let path: String(source.substring(start: pathStart, end: pathEnd))
            let fileStart: Int(pathEnd + 1)
            let nextFileMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
            let fileSource: String(source.substring(start: fileStart, end: nextFileMarker))
            let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
            output: "\(output)sourceFileAST\tindex=\(fileCount)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\tdeclarationSummaryLength=\(stringLength(value: fileProgram.declarationSummary))\n"
            output: "\(output)\(fileProgram.declarationSummary)"
            fileCount: fileCount + 1
            sourceIndex: nextFileMarker
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    output: "\(output)sourceFileASTCount\t\(fileCount)\n"
    return output
}

function compilerSourceSetTypesSummary(source: String): String {
    state output: String("sourceSetTypes\tprogram\n")
    state sourceIndex: Int(0)
    state fileCount: Int(0)
    let sourceLength: Int(stringLength(value: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: source, start: sourceIndex, prefix: marker) {
            let pathStart: Int(sourceIndex + markerLength)
            state pathEnd: Int(0)
            pathEnd: pathStart
            while pathEnd < sourceLength && source.character(index: pathEnd) > String(" ") {
                pathEnd: pathEnd + 1
            }

            let path: String(source.substring(start: pathStart, end: pathEnd))
            let fileStart: Int(pathEnd + 1)
            let nextFileMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
            let fileSource: String(source.substring(start: fileStart, end: nextFileMarker))
            let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
            let declarationTypeSummary: String(compilerCoreTopLevelFunctionSymbolAndTypeSummary(records: fileProgram.declarationRecords))
            output: "\(output)sourceFileTypes\tindex=\(fileCount)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\tdeclarationSummaryLength=\(stringLength(value: fileProgram.declarationSummary))\ttypeSummaryLength=\(stringLength(value: declarationTypeSummary))\n"
            output: "\(output)\(declarationTypeSummary)"
            if fileProgram.hasMainBlock {
                let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: fileProgram))
                output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: fileProgram.declarationRecords, statementRecords: parsedBlock.statementRecords, scopeName: String("main"), incomingLocals: String(""), expectedReturnType: String("Int")))"
            }
            fileCount: fileCount + 1
            sourceIndex: nextFileMarker
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    output: "\(output)sourceFileTypesCount\t\(fileCount)\n"
    return output
}

function compilerCoreTopLevelFunctionSymbolAndTypeSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        if declarationKind == String("function") {
            let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
            let declarationParameters: String(compilerCoreRecordField(record: record, prefix: String("parameters=")))
            let declarationReturnType: String(compilerCoreRecordField(record: record, prefix: String("returnType=")))
            output: "\(output)symbol\tkind=function\tname=\(declarationName)\tscope=program\tparameters=[\(declarationParameters)]\treturnType=\(declarationReturnType)\n"
            output: "\(output)type\tkind=function\tname=\(declarationName)\tscope=program\treturnType=\(declarationReturnType)\n"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function compilerSourceSetLLVMSummary(source: String): String {
    state output: String("sourceSetLLVM\tprogram\n")
    state sourceIndex: Int(0)
    state fileCount: Int(0)
    let sourceLength: Int(stringLength(value: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let markerLength: Int(stringLength(value: marker))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: source, start: sourceIndex, prefix: marker) {
            let pathStart: Int(sourceIndex + markerLength)
            state pathEnd: Int(0)
            pathEnd: pathStart
            while pathEnd < sourceLength && source.character(index: pathEnd) > String(" ") {
                pathEnd: pathEnd + 1
            }

            let path: String(source.substring(start: pathStart, end: pathEnd))
            let fileStart: Int(pathEnd + 1)
            let nextFileMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
            let fileSource: String(source.substring(start: fileStart, end: nextFileMarker))
            let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
            output: "\(output)sourceFileLLVM\tindex=\(fileCount)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\n"
            if fileProgram.hasMainBlock {
                output: "\(output)sourceFileLLVMText\tpath=\(path)\n"
            }
            fileCount: fileCount + 1
            sourceIndex: nextFileMarker
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    let combinedProgram: CompilerProgram(compilerSourceSetProgramForLLVM(source: source))
    output: "\(output)sourceSetLLVMProgram\thasMainBlock=\(combinedProgram.hasMainBlock)\n"
    output: "\(output)sourceFileLLVMCount\t\(fileCount)\n"
    return output
}

function compilerSourceSetLLVMText(source: String): String {
    let combinedProgram: CompilerProgram(compilerSourceSetProgramForLLVM(source: source))
    return compilerCoreLLVMSourceSetEntryTextForProgram(program: combinedProgram)
}

function compilerNativeSourceSetLLVMText(source: String): String {
    let combinedProgram: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    return compilerCoreLLVMNativeEntryTextForProgram(program: combinedProgram)
}

function compilerSourceSetProgramForLLVM(source: String): CompilerProgram {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let firstMarker: Int(compilerSourceNextFileMarker(source: source, start: 0))
    let sourceLength: Int(stringLength(value: source))
    if firstMarker >= sourceLength {
        return parseCompilerProgramForLLVM(source: source)
    }

    return compilerSourceSetProgramForLLVMFromFirstMarker(source: source, firstMarker: firstMarker, marker: marker)
}

function compilerSourceSetProgramForLLVMFromFirstMarker(source: String, firstMarker: Int, marker: String): CompilerProgram {
    return compilerSourceSetProgramForLLVMFromIndex(source: source, sourceIndex: firstMarker, marker: marker, program: compilerSourceSetEmptyProgram())
}

function compilerSourceSetEmptyProgram(): CompilerProgram {
    let emptyBlock: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(source: String(""), hasMainBlock: false, mainAttributeStart: 0, mainBlock: emptyBlock, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: String(""), declarationSummary: String(""), functionSummary: String(""))
}

function compilerSourceSetProgramForLLVMFromIndex(source: String, sourceIndex: Int, marker: String, program: CompilerProgram): CompilerProgram {
    let sourceLength: Int(stringLength(value: source))
    let markerStart: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if markerStart >= sourceLength {
        return program
    }

    return compilerSourceSetProgramForLLVMAtMarker(source: source, markerStart: markerStart, marker: marker, program: program)
}

function compilerSourceSetProgramForLLVMAtMarker(source: String, markerStart: Int, marker: String, program: CompilerProgram): CompilerProgram {
    let markerLength: Int(stringLength(value: marker))
    let pathStart: Int(markerStart + markerLength)
    let pathEnd: Int(compilerSourceFilePathEnd(source: source, start: pathStart))
    let fileStart: Int(pathEnd + 1)
    let nextMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
    let fileSource: String(stringSubstring(source: source, start: fileStart, end: nextMarker))
    return compilerSourceSetProgramForLLVMFileSource(source: source, fileSource: fileSource, nextMarker: nextMarker, marker: marker, program: program)
}

function compilerSourceSetProgramForLLVMFileSource(source: String, fileSource: String, nextMarker: Int, marker: String, program: CompilerProgram): CompilerProgram {
    let fileProgram: CompilerProgram(parseCompilerProgramForLLVMNamedBodies(source: fileSource, bodyFunctionNames: compilerSourceSetBodyFunctionNames()))
    let nextProgram: CompilerProgram(compilerSourceSetProgramAppendingFile(program: program, fileProgram: fileProgram))
    return compilerSourceSetProgramForLLVMFromIndex(source: source, sourceIndex: nextMarker, marker: marker, program: nextProgram)
}

function compilerNativeSourceSetProgramForLLVM(source: String): CompilerProgram {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let firstMarker: Int(compilerSourceNextFileMarker(source: source, start: 0))
    let sourceLength: Int(stringLength(value: source))
    if firstMarker >= sourceLength {
        return compilerNativeProgramForLLVMFileSource(fileSource: source)
    }

    return compilerNativeSourceSetProgramForLLVMFromIndex(source: source, sourceIndex: firstMarker, marker: marker, program: compilerSourceSetEmptyProgram())
}

function compilerNativeSourceSetProgramForLLVMFromIndex(source: String, sourceIndex: Int, marker: String, program: CompilerProgram): CompilerProgram {
    let sourceLength: Int(stringLength(value: source))
    let markerStart: Int(compilerSourceNextFileMarker(source: source, start: sourceIndex))
    if markerStart >= sourceLength {
        return program
    }

    return compilerNativeSourceSetProgramForLLVMAtMarker(source: source, markerStart: markerStart, marker: marker, program: program)
}

function compilerNativeSourceSetProgramForLLVMAtMarker(source: String, markerStart: Int, marker: String, program: CompilerProgram): CompilerProgram {
    let markerLength: Int(stringLength(value: marker))
    let pathStart: Int(markerStart + markerLength)
    let pathEnd: Int(compilerSourceFilePathEnd(source: source, start: pathStart))
    let fileStart: Int(pathEnd + 1)
    let nextMarker: Int(compilerSourceNextFileMarker(source: source, start: fileStart))
    let fileSource: String(stringSubstring(source: source, start: fileStart, end: nextMarker))
    let fileProgram: CompilerProgram(compilerNativeProgramForLLVMFileSource(fileSource: fileSource))
    let nextProgram: CompilerProgram(compilerSourceSetProgramAppendingFile(program: program, fileProgram: fileProgram))
    return compilerNativeSourceSetProgramForLLVMFromIndex(source: source, sourceIndex: nextMarker, marker: marker, program: nextProgram)
}

function compilerNativeProgramForLLVMFileSource(fileSource: String): CompilerProgram {
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: fileSource, bodyFunctionNames: compilerSourceSetBodyFunctionNames()))
    let emptyBlock: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(source: String(""), hasMainBlock: false, mainAttributeStart: 0, mainBlock: emptyBlock, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: parsedDeclarations.records, declarationSummary: String(""), functionSummary: String(""))
}

function compilerSourceSetBodyFunctionNames(): String {
    return "\(compilerSourceSetBodyFunctionNamesInventory())\(compilerSourceSetBodyFunctionNamesNativeMain())\(compilerSourceSetBodyFunctionNamesNativeProgram())\(compilerSourceSetBodyFunctionNamesSourceSetPrep())\(compilerSourceSetBodyFunctionNamesSourceSetLLVM())\(compilerSourceSetBodyFunctionNamesSourceSetParser())\(compilerSourceSetBodyFunctionNamesMainASTLowering())\(compilerSourceSetBodyFunctionNamesLexer())\(compilerSourceSetBodyFunctionNamesScanning())"
}

function compilerSourceSetBodyFunctionNamesInventory(): String {
    return "\(compilerSourceSetBodyFunctionNamesInventoryCore())\(compilerSourceSetBodyFunctionNamesInventoryChunks())"
}

function compilerSourceSetBodyFunctionNamesInventoryCore(): String {
    return "compileRangeNativeSource;compileRangeNativeSourceDirectiveOutput;compileRangeNativeProgramOutput;compilerSourceRequestsSourceSetBodyFunctionNames;compilerSourceRequestsNativeSourceSetLLVMText;compilerSourceRequestsNativeSourceSetParseStats;compilerSourceRequestsNativeSourceSetReachableStats;compilerSourceRequestsNativeSourceSetSelectedStats;compilerSourceRequestsNativeSourceSetSelectedScanStats;compilerSourceRequestsSourceSetLLVMText;compilerSourceSetBodyFunctionNames;compilerSourceSetBodyFunctionNamesInventory;compilerSourceSetBodyFunctionNamesInventoryCore;compilerSourceSetBodyFunctionNamesInventoryChunks;compilerSourceSetBodyFunctionNamesInventorySourceSetChunks;compilerSourceSetBodyFunctionNamesInventoryMainASTChunks;compilerSourceSetBodyFunctionNamesNativeMain;compilerSourceSetBodyFunctionNamesNativeProgram;compilerSourceSetBodyFunctionNamesSourceSetPrep;"
