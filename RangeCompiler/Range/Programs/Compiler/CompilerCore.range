            let targetIdentity: CompilerFingerprint(compilerMacroExecutionTargetIdentity(tables: tables, targetSyntaxID: targetSyntaxID))
            let targetQueryIdentity: CompilerFingerprint(compilerMacroExecutionReadIdentity(applicationIdentity: targetApplicationIdentity, targetIdentity: targetIdentity, operation: compilerMacroTargetOperationMemberCount(), keyKindTag: compilerSyntaxKindConstruct(), key: memberName))
            let targetObservedCount: Int(compilerMacroExecutionTargetMemberCount(tables: tables, targetSyntaxID: targetSyntaxID, name: memberName))
            let targetObservation: CompilerFingerprint(compilerMacroExecutionTargetMemberObservation(tables: tables, targetSyntaxID: targetSyntaxID, name: memberName))
            let targetQueryResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
            if compilerMacroExecutionAppendReadDependency(tables: tables, invocationRow: invocationRow, operation: compilerMacroTargetOperationMemberCount(), arena: arena, operationRow: operationRow, kindValueID: nameValueID, nameValueID: nameValueID, kindTag: compilerSyntaxKindConstruct(), observedCount: targetObservedCount, applicationIdentity: targetApplicationIdentity, targetIdentity: targetIdentity, queryIdentity: targetQueryIdentity, observation: targetObservation) < 0
                || rawBufferStoreInt(buffer: evaluationValues, index: targetQueryResultValueID, value: targetObservedCount) != 0 {
