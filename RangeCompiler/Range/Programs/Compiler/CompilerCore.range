            || compilerIntTableValue(table: delta.nodes, row: row, column: 7) != compilerPlotterFacetKind(kindTag: compilerIntTableValue(table: delta.nodes, row: row, column: 1))
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: delta.nodes, row: row, column: 5)) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: delta.nodes, row: row, column: 6)) < 0
            || compilerIntTableValue(table: delta.facts, row: row, column: 0) != compilerGraphFactOmitted()
            || compilerIntTableValue(table: delta.facts, row: row, column: 1) != row
            || compilerIntTableValue(table: delta.facts, row: row, column: 2) != row
            || compilerIntTableValue(table: delta.facts, row: row, column: 3) != compilerGraphRoleExpansion()
            || compilerIntTableValue(table: delta.facts, row: row, column: 4) != row { return false }
        state prior: Int(0)
        while prior < row {
            if compilerIntTableValue(table: delta.nodes, row: prior, column: 2) == syntaxID { return false }
            prior: prior + 1
        }
        row: row + 1
    }
    return true
}

