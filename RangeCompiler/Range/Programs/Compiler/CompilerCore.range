function compilerMemoryStorageMutable(): Int { return 2 }

function compilerMemoryGraphCreate(): CompilerMemoryGraph {
    return CompilerMemoryGraph(
        layouts: compilerIntTableCreate(columnCount: compilerMemoryLayoutColumnCount(), estimatedRowCount: 32),
        storages: compilerIntTableCreate(columnCount: compilerMemoryStorageColumnCount(), estimatedRowCount: 64),
        decisions: compilerIntTableCreate(columnCount: compilerMemoryDecisionColumnCount(), estimatedRowCount: 128),
        failures: intBufferCreate(capacity: 1)
    )
}

function compilerMemoryGraphDestroy(memory: CompilerMemoryGraph): Int {
    state memoryDestroyStatus: Int(0)
    if compilerIntTableDestroy(table: memory.layouts) != 0 { memoryDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: memory.storages) != 0 { memoryDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: memory.decisions) != 0 { memoryDestroyStatus: 0 - 1 }
    if intBufferDestroy(buffer: memory.failures) != 0 { memoryDestroyStatus: 0 - 1 }
    return memoryDestroyStatus
}

function compilerMemoryGraphPoison(memory: CompilerMemoryGraph): Int {
    return intBufferAppend(buffer: memory.failures, value: 1)
}

function compilerMemoryAppend(memory: CompilerMemoryGraph, table: CompilerIntTable, value: Int): Int {
    let memoryAppendStatus: Int(compilerIntTableAppend(table: table, value: value))
    if memoryAppendStatus != 0 { compilerMemoryGraphPoison(memory: memory) }
    return memoryAppendStatus
}

function compilerMemoryAppendLayout(memory: CompilerMemoryGraph, typeNodeID: Int, fieldCount: Int, byteSize: Int, alignment: Int): Int {
    if typeNodeID < 0 || fieldCount <= 0 || byteSize <= 0 || alignment <= 0 {
        compilerMemoryGraphPoison(memory: memory)
        return 0 - 1
    }
    if compilerMemoryAppend(memory: memory, table: memory.layouts, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.layouts, value: fieldCount) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.layouts, value: byteSize) != 0 { return 0 - 1 }
    return compilerMemoryAppend(memory: memory, table: memory.layouts, value: alignment)
}

function compilerMemoryAppendStorage(memory: CompilerMemoryGraph, localNodeID: Int, typeNodeID: Int, regionNodeID: Int): Int {
    let storageID: Int(compilerIntTableRowCount(table: memory.storages))
    if localNodeID < 0 || typeNodeID < 0 - 1 || regionNodeID < 0 {
        compilerMemoryGraphPoison(memory: memory)
        return 0 - 1
    }
    if compilerMemoryAppend(memory: memory, table: memory.storages, value: storageID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.storages, value: localNodeID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.storages, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.storages, value: regionNodeID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.storages, value: compilerMemoryPlacementLocal()) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.storages, value: 0) != 0 { return 0 - 1 }
    return storageID
}

function compilerMemoryAppendDecision(memory: CompilerMemoryGraph, decisionKind: Int, nodeID: Int, storageID: Int, typeNodeID: Int, value: Int, originNodeID: Int): Int {
    if decisionKind < compilerMemoryDecisionLayout() || decisionKind > compilerMemoryDecisionAlias() || nodeID < 0 || typeNodeID < 0 - 1 || originNodeID < 0 {
        compilerMemoryGraphPoison(memory: memory)
        return 0 - 1
    }
    if compilerMemoryAppend(memory: memory, table: memory.decisions, value: decisionKind) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.decisions, value: nodeID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.decisions, value: storageID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.decisions, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerMemoryAppend(memory: memory, table: memory.decisions, value: value) != 0 { return 0 - 1 }
    return compilerMemoryAppend(memory: memory, table: memory.decisions, value: originNodeID)
}

function compilerMemoryLayoutRowForType(memory: CompilerMemoryGraph, typeNodeID: Int): Int {
    state memoryLayoutRow: Int(0)
    let memoryLayoutCount: Int(compilerIntTableRowCount(table: memory.layouts))
    while memoryLayoutRow < memoryLayoutCount {
        if compilerIntTableValue(table: memory.layouts, row: memoryLayoutRow, column: 0) == typeNodeID { return memoryLayoutRow }
        memoryLayoutRow: memoryLayoutRow + 1
    }
    return 0 - 1
}

function compilerMemoryStorageForLocal(memory: CompilerMemoryGraph, localNodeID: Int): Int {
    state memoryStorageRow: Int(0)
    let memoryStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    while memoryStorageRow < memoryStorageCount {
        if compilerIntTableValue(table: memory.storages, row: memoryStorageRow, column: 1) == localNodeID {
            return compilerIntTableValue(table: memory.storages, row: memoryStorageRow, column: 0)
        }
        memoryStorageRow: memoryStorageRow + 1
    }
    return 0 - 1
}

function compilerMemoryLocalStoragePolicy(tables: CompilerSyntaxTables, localNodeID: Int): Int {
    if localNodeID < 0 || localNodeID >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerIntTableValue(table: tables.syntaxIndex, row: localNodeID, column: 0) != compilerSyntaxKindLocalBinding() { return 0 - 1 }
    let memoryPolicyBodyRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: localNodeID, column: 1))
    let memoryPolicyAux: Int(compilerIntTableValue(table: tables.bodyNodes, row: memoryPolicyBodyRow, column: 10))
    if memoryPolicyAux == compilerSyntaxLocalKindLet() { return compilerMemoryStorageImmutable() }
    if memoryPolicyAux == compilerSyntaxLocalKindState() { return compilerMemoryStorageMutable() }
    return 0 - 1
}

function compilerMemoryEffectRowForParameter(semantics: CompilerSemanticGraph, parameterNodeID: Int): Int {
    state memoryEffectRow: Int(0)
    let memoryEffectCount: Int(compilerIntTableRowCount(table: semantics.parameterEffects))
    while memoryEffectRow < memoryEffectCount {
        if compilerIntTableValue(table: semantics.parameterEffects, row: memoryEffectRow, column: 1) == parameterNodeID { return memoryEffectRow }
        memoryEffectRow: memoryEffectRow + 1
    }
    return 0 - 1
}

function compilerMemoryConstructFieldCount(tables: CompilerSyntaxTables, semantics: CompilerSemanticGraph, constructNodeID: Int): Int {
    state memoryMemberRow: Int(0)
    state memoryFieldCount: Int(0)
    let memoryMemberCount: Int(compilerIntTableRowCount(table: tables.members))
    while memoryMemberRow < memoryMemberCount {
        if compilerIntTableValue(table: tables.members, row: memoryMemberRow, column: 2) == constructNodeID {
            let memoryMemberNodeID: Int(compilerIntTableValue(table: tables.members, row: memoryMemberRow, column: 0))
            let memoryMemberKind: Int(compilerIntTableValue(table: tables.members, row: memoryMemberRow, column: 12))
            if memoryMemberKind != compilerSyntaxMemberKindBinding() {
                if compilerIntTableValue(table: semantics.nodeTypes, row: memoryMemberNodeID, column: 1) != compilerSemanticTypeInt() {
                    return 0 - 1
                }
                memoryFieldCount: memoryFieldCount + 1
            }
        }
        memoryMemberRow: memoryMemberRow + 1
    }
    return memoryFieldCount
}

function compilerRuntimeABINone(): Int { return 0 }
function compilerRuntimeABIOpaqueIntBuffer(): Int { return 1 }
function compilerRuntimeABIFunctionNone(): Int { return 0 }
function compilerRuntimeABIFunctionCreate(): Int { return 1 }
function compilerRuntimeABIFunctionDestroy(): Int { return 2 }
function compilerRuntimeABIFunctionSharedRead(): Int { return 3 }

function compilerRuntimeABIDeclarationNameEquals(tables: CompilerSyntaxTables, declarationNodeID: Int, name: String): Bool {
    let runtimeDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: declarationNodeID))
    if runtimeDeclarationRow < 0 { return false }
    return compilerSemanticLocalRangeEqualsText(
        tables: tables,
        fileID: compilerIntTableValue(table: tables.declarations, row: runtimeDeclarationRow, column: 1),
        start: compilerIntTableValue(table: tables.declarations, row: runtimeDeclarationRow, column: 7),
        end: compilerIntTableValue(table: tables.declarations, row: runtimeDeclarationRow, column: 8),
        text: name
    )
}

function compilerRuntimeABIConstructKind(tables: CompilerSyntaxTables, constructNodeID: Int): Int {
    let runtimeConstructRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: constructNodeID))
    if runtimeConstructRow < 0
        || compilerIntTableValue(table: tables.declarations, row: runtimeConstructRow, column: 2) != compilerSyntaxKindConstruct()
        || compilerIntTableValue(table: tables.declarations, row: runtimeConstructRow, column: 13) != 1
        || !compilerRuntimeABIDeclarationNameEquals(tables: tables, declarationNodeID: constructNodeID, name: String("IntBuffer")) { return compilerRuntimeABINone() }
    state runtimeMemberRow: Int(0)
    let runtimeMemberCount: Int(compilerIntTableRowCount(table: tables.members))
    while runtimeMemberRow < runtimeMemberCount {
        if compilerIntTableValue(table: tables.members, row: runtimeMemberRow, column: 2) == constructNodeID { return compilerRuntimeABINone() }
        runtimeMemberRow: runtimeMemberRow + 1
    }
    return compilerRuntimeABIOpaqueIntBuffer()
}

function compilerRuntimeABIFunctionRole(tables: CompilerSyntaxTables, functionNodeID: Int): Int {
    let runtimeFunctionDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: functionNodeID))
    let runtimeFunctionRow: Int(compilerSemanticFunctionRowForSyntaxID(tables: tables, functionSyntaxID: functionNodeID))
    if runtimeFunctionDeclarationRow < 0 || runtimeFunctionRow < 0
        || compilerIntTableValue(table: tables.declarations, row: runtimeFunctionDeclarationRow, column: 13) != 1
        || compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 3) != 1 { return compilerRuntimeABIFunctionNone() }
    let runtimeParameterRow: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 2))
    let runtimeFunctionFileID: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 1))
    let runtimeParameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 1))
    let runtimeParameterIsInt: Bool(compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeParameterFileID, start: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 8), end: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 9), text: String("Int")))
    let runtimeParameterIsIntBuffer: Bool(compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeParameterFileID, start: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 8), end: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 9), text: String("IntBuffer")))
    let runtimeReturnIsInt: Bool(compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeFunctionFileID, start: compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 6), end: compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 7), text: String("Int")))
    let runtimeReturnIsIntBuffer: Bool(compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeFunctionFileID, start: compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 6), end: compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 7), text: String("IntBuffer")))
    if compilerRuntimeABIDeclarationNameEquals(tables: tables, declarationNodeID: functionNodeID, name: String("intBufferCreate"))
        && runtimeParameterIsInt && runtimeReturnIsIntBuffer { return compilerRuntimeABIFunctionCreate() }
    if compilerRuntimeABIDeclarationNameEquals(tables: tables, declarationNodeID: functionNodeID, name: String("intBufferDestroy"))
        && runtimeParameterIsIntBuffer && runtimeReturnIsInt { return compilerRuntimeABIFunctionDestroy() }
    if compilerRuntimeABIDeclarationNameEquals(tables: tables, declarationNodeID: functionNodeID, name: String("intBufferCount"))
        && runtimeParameterIsIntBuffer && runtimeReturnIsInt { return compilerRuntimeABIFunctionSharedRead() }
    return compilerRuntimeABIFunctionNone()
}

function compilerMemoryOpaqueDestroyApplicationCount(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, localNodeID: Int): Int {
    state opaqueDestroyCount: Int(0)
    state opaqueDestroyNodeID: Int(0)
    let opaqueDestroyNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while opaqueDestroyNodeID < opaqueDestroyNodeCount {
