function compilerTypedSyntaxCaptureTopLevelTokenWithPolicy(source: String, tables: CompilerSyntaxTables, declarationOrdinal: Int, token: RangeLexedToken, captureBodies: Bool, isLanguage: Bool, fileEnd: Int): CompilerTypedDeclarationCaptureStep {
    if token.kind == String("keyword") && (token.text == String("open") || token.text == String("closed")) {
        let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: token.end))
        let maybeMacro: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeMacro != nil {
            let fallbackMacro: RangeLexedToken(compilerFallbackToken(cursor: cursor))
            let macroToken: RangeLexedToken(maybeMacro ?? fallbackMacro)
            if macroToken.kind == String("keyword") && macroToken.text == String("macro") {
                state visibility: Int(compilerSyntaxMacroVisibilityDefault())
                if token.text == String("open") { visibility: compilerSyntaxMacroVisibilityOpen() }
                if token.text == String("closed") { visibility: compilerSyntaxMacroVisibilityClosed() }
                return compilerTypedSyntaxCaptureMacroWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, visibility: visibility, declarationStart: token.start, keyword: macroToken)
            }
        }
    }
    if token.kind == String("keyword") && token.text == String("construct") {
        return compilerTypedSyntaxCaptureConstructWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, keyword: token, isLanguage: isLanguage)
    }
    if token.kind == String("keyword") && token.text == String("function") {
        return compilerTypedSyntaxCaptureFunctionWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, keyword: token, captureBody: captureBodies, isLanguage: isLanguage, fileEnd: fileEnd)
    }
    if token.kind == String("keyword") && token.text == String("macro") {
        return compilerTypedSyntaxCaptureMacroWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, visibility: compilerSyntaxMacroVisibilityDefault(), declarationStart: token.start, keyword: token)
    }
    return CompilerTypedDeclarationCaptureStep(captured: false, nextIndex: token.end)
}

