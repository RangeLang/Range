function compilerSourceSetBodyFunctionNamesInventoryMainASTChunks(): String {
    return "compilerSourceSetBodyFunctionNamesMainASTLowering;compilerSourceSetBodyFunctionNamesMainASTParsing;compilerSourceSetBodyFunctionNamesMainASTStatements;compilerSourceSetBodyFunctionNamesMainASTRecords;compilerSourceSetBodyFunctionNamesMainASTNames;compilerSourceSetBodyFunctionNamesMainASTExpressions;compilerSourceSetBodyFunctionNamesMainASTLoweringCore;compilerSourceSetBodyFunctionNamesMainASTLoweringControl;compilerSourceSetBodyFunctionNamesMainASTLoweringDirect;compilerSourceSetBodyFunctionNamesMainASTLoweringLinear;compilerSourceSetBodyFunctionNamesMainASTLoweringLinearKinds;compilerSourceSetBodyFunctionNamesLexer;compilerSourceSetBodyFunctionNamesScanning;"
