}

function compilerBodyArenaOwnedPathBuildEdgeProjection(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, sourceBlockID: Int, targetBlockID: Int, pathRoots: RawBuffer, canonicalPaths: RawBuffer, projection: RawBuffer, pathCount: Int): Int {
