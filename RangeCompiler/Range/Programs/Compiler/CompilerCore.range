function compilerBodyMIRBuildTraversal(arena: CompilerBodyArena, blockID: Int): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: arena.cfgBlocks) { return 0 - 1 }
    if compilerBodyMIRTraversalContains(arena: arena, blockID: blockID) { return 0 }
    if blockID != 0 && !compilerBodyMIRAllForwardPredecessorsVisited(arena: arena, blockID: blockID) { return 0 }
    if rawBufferAppendInt(buffer: arena.mirTraversal, value: blockID) != 0 { return 0 - 1 }
