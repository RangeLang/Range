function compilerCoreASTSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreASTSummaryForProgram(program: program)
}

function compilerIntTableCreate(columnCount: Int, estimatedRowCount: Int): CompilerIntTable {
    state capacity: Int(0)
    if columnCount > 0 && estimatedRowCount > 0 {
        capacity: columnCount * estimatedRowCount
    }
    return CompilerIntTable(values: intBufferCreate(capacity: capacity), columnCount: columnCount)
}

function compilerIntTableAppend(table: CompilerIntTable, value: Int): Int {
    return intBufferAppend(buffer: table.values, value: value)
}

function compilerIntTableRowCount(table: CompilerIntTable): Int {
    if table.columnCount <= 0 {
        return 0
    }
    return intBufferCount(buffer: table.values) / table.columnCount
}

function compilerIntTableIsComplete(table: CompilerIntTable): Bool {
    if table.columnCount <= 0 {
        return false
    }
    return intBufferCount(buffer: table.values) % table.columnCount == 0
}

function compilerIntTableValue(table: CompilerIntTable, row: Int, column: Int): Int {
    let rowCount: Int(compilerIntTableRowCount(table: table))
    if row < 0 || row >= rowCount || column < 0 || column >= table.columnCount {
        return 0 - 1
    }
    return intBufferElement(buffer: table.values, index: row * table.columnCount + column)
}

function compilerIntTableDestroy(table: CompilerIntTable): Int {
    return intBufferDestroy(buffer: table.values)
}

function compilerSourceFileTableColumnCount(): Int {
    return 5
}

function compilerSourceRoleProject(): Int {
    return 3
}

function compilerSourceRoleName(role: Int): String {
    if role == compilerSourceRoleProject() {
        return String("project")
    }
    return String("unknown")
}

function compilerSourceFileTableAppend(files: CompilerIntTable, role: Int, pathStart: Int, pathEnd: Int, contentStart: Int, contentEnd: Int): Int {
    if files.columnCount != compilerSourceFileTableColumnCount() {
        return 0 - 1
    }
    if compilerIntTableAppend(table: files, value: role) != 0 {
        return 0 - 1
    }
    if compilerIntTableAppend(table: files, value: pathStart) != 0 {
        return 0 - 1
    }
    if compilerIntTableAppend(table: files, value: pathEnd) != 0 {
        return 0 - 1
    }
    if compilerIntTableAppend(table: files, value: contentStart) != 0 {
        return 0 - 1
    }
    return compilerIntTableAppend(table: files, value: contentEnd)
}

function compilerSourceStoreCreate(source: String): CompilerSourceStore {
    let sourceLength: Int(stringLength(value: source))
    let markerCount: Int(compilerSourceInventoryFileCount(source: source))
    let files: CompilerIntTable(compilerIntTableCreate(columnCount: compilerSourceFileTableColumnCount(), estimatedRowCount: markerCount))
    let firstMarker: Int(compilerSourceNextFileMarker(source: source, start: 0))
    if firstMarker >= sourceLength {
        let fallbackStatus: Int(compilerSourceFileTableAppend(files: files, role: compilerSourceRoleProject(), pathStart: 0, pathEnd: 0, contentStart: 0, contentEnd: sourceLength))
        return CompilerSourceStore(source: source, files: files, isValid: fallbackStatus == 0)
    }
    let bundleStatus: Int(compilerSourceStoreAppendBundledFiles(source: source, files: files, firstMarker: firstMarker))
    return CompilerSourceStore(source: source, files: files, isValid: bundleStatus == 0)
}

function compilerSourceStoreAppendBundledFiles(source: String, files: CompilerIntTable, firstMarker: Int): Int {
    state markerIndex: Int(firstMarker)
    let sourceLength: Int(stringLength(value: source))
    let markerLength: Int(stringLength(value: compilerSourceFileMarker()))
    while markerIndex < sourceLength {
        let pathStart: Int(markerIndex + markerLength)
        let pathEnd: Int(compilerSourceFilePathEnd(source: source, start: pathStart))
        if pathEnd >= sourceLength {
            return 0 - 1
        }
        let contentStart: Int(pathEnd + 1)
        let nextMarker: Int(compilerSourceNextFileMarker(source: source, start: contentStart))
        if compilerSourceFileTableAppend(files: files, role: compilerSourceRoleProject(), pathStart: pathStart, pathEnd: pathEnd, contentStart: contentStart, contentEnd: nextMarker) != 0 {
            return 0 - 1
        }
        markerIndex: nextMarker
    }
    return 0
}

function compilerSourceStoreFileCount(store: CompilerSourceStore): Int {
    return compilerIntTableRowCount(table: store.files)
}

function compilerSourceStoreFileRole(store: CompilerSourceStore, fileID: Int): Int {
    return compilerIntTableValue(table: store.files, row: fileID, column: 0)
}

function compilerSourceStoreFilePathStart(store: CompilerSourceStore, fileID: Int): Int {
    return compilerIntTableValue(table: store.files, row: fileID, column: 1)
}

function compilerSourceStoreFilePathEnd(store: CompilerSourceStore, fileID: Int): Int {
    return compilerIntTableValue(table: store.files, row: fileID, column: 2)
}

function compilerSourceStoreFileContentStart(store: CompilerSourceStore, fileID: Int): Int {
    return compilerIntTableValue(table: store.files, row: fileID, column: 3)
}

function compilerSourceStoreFileContentEnd(store: CompilerSourceStore, fileID: Int): Int {
    return compilerIntTableValue(table: store.files, row: fileID, column: 4)
}

function compilerSourceStoreFileIDAtGlobalOffset(store: CompilerSourceStore, globalOffset: Int): Int {
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        if globalOffset >= contentStart && globalOffset < contentEnd {
            return fileID
        }
        fileID: fileID + 1
    }
    return 0 - 1
}

function compilerSourceStoreFileLocalOffset(store: CompilerSourceStore, globalOffset: Int): Int {
    let fileID: Int(compilerSourceStoreFileIDAtGlobalOffset(store: store, globalOffset: globalOffset))
    if fileID < 0 {
        return 0 - 1
    }
    return globalOffset - compilerSourceStoreFileContentStart(store: store, fileID: fileID)
}

function compilerSourceStoreFileLocalOffsetForFileID(store: CompilerSourceStore, fileID: Int, globalOffset: Int): Int {
    let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
    let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
    if globalOffset < contentStart || globalOffset > contentEnd {
        return 0 - 1
    }
    return globalOffset - contentStart
}

function compilerSourceStoreGlobalOffset(store: CompilerSourceStore, fileID: Int, localOffset: Int): Int {
    let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
    let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
    let globalOffset: Int(contentStart + localOffset)
    if localOffset < 0 || globalOffset > contentEnd {
        return 0 - 1
    }
    return globalOffset
}

function compilerSourceStoreDestroy(store: CompilerSourceStore): Int {
    return compilerIntTableDestroy(table: store.files)
}

