    }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: ownerSyntaxID))
    if declarationRow < 0 {
        compilerSyntaxTablesPoison(tables: tables)
        return CompilerTypedDeclarationCaptureStep(captured: false, nextIndex: parts.bodyRange.next)
    }
    let baseFingerprint: CompilerFingerprint(CompilerFingerprint(
        first: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 11),
        second: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 12)
    ))
    compilerTypedSyntaxCaptureMembers(source: source, tables: tables, fileID: compilerSourceStoreFileIDAtGlobalOffset(store: tables.sourceStore, globalOffset: keyword.start), parentSyntaxID: ownerSyntaxID, start: parts.bodyRange.start, end: parts.bodyRange.end, baseFingerprint: baseFingerprint, captureBodies: captureBodies)
    return CompilerTypedDeclarationCaptureStep(captured: false, nextIndex: parts.bodyRange.next)
