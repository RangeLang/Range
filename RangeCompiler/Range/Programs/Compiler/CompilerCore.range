function compilerReachableLLVMStateBuild(reachability: CompilerReachableLLVMState): Int {
    if !reachability.selection.isValid || compilerFunctionReachabilitySeedRoots(tables: reachability.context.tables, index: reachability.context.declarationIndex, selection: reachability.selection, worklist: reachability.worklist, rootNames: String("compileRangeNativeSource;compilerNativeOutputExitCode;")) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
    return compilerReachableLLVMStateBuildSelected(reachability: reachability)
}

function compilerReachableLLVMStateHelpers(reachability: CompilerReachableLLVMState): CompilerTypedLLVMHelpers {
