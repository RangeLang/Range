        return compilerBodyMIRBuildTraversal(arena: arena, blockID: compilerBodyMIRCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeFalse()))
    }
    if terminatorKind == compilerBodyCFGTerminatorFallthrough() {
