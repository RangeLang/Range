    }
    return memoryTerminalReturnNodeID
}

function compilerMemoryRegionHasExit(delta: CompilerGraphDelta, regionNodeID: Int, exitNodeID: Int): Bool {
    if regionNodeID < 0 || exitNodeID < 0 || exitNodeID >= compilerIntTableRowCount(table: delta.nodes) { return false }
    let memoryExitKind: Int(compilerIntTableValue(table: delta.nodes, row: exitNodeID, column: 1))
    if memoryExitKind == compilerSyntaxKindReturn() {
        let memoryExitOwnerRegion: Int(compilerMemoryOwnedRegionForNode(delta: delta, nodeID: exitNodeID))
        return memoryExitOwnerRegion >= 0
            && compilerMemoryLastReturnInRegionNode(delta: delta, regionNodeID: memoryExitOwnerRegion) == exitNodeID
            && compilerMemoryRegionContainsNode(delta: delta, regionNodeID: regionNodeID, nodeID: exitNodeID)
    }
    return memoryExitKind == compilerSyntaxKindLexicalRegion()
        && exitNodeID == regionNodeID
        && !compilerMemoryRegionHasTerminalReturn(delta: delta, regionNodeID: regionNodeID)
}

function compilerMemoryExitAppliesToLocal(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, localNodeID: Int, exitNodeID: Int): Bool {
    return compilerMemoryNodeEnd(tables: tables, delta: delta, nodeID: localNodeID) < compilerMemoryNodeEnd(tables: tables, delta: delta, nodeID: exitNodeID)
}

function compilerMemoryNodeEnd(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, nodeID: Int): Int {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: delta.nodes) { return 0 - 1 }
    let memoryEndKind: Int(compilerIntTableValue(table: delta.nodes, row: nodeID, column: 1))
    if memoryEndKind < compilerSyntaxKindEntry() { return 0 - 1 }
    let memoryEndFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    return compilerIntTableValue(table: tables.bodyNodes, row: memoryEndFacetRow, column: 5)
}

function compilerMemoryDestroyFollowsUses(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, localNodeID: Int, destroyNodeID: Int): Bool {
    let memoryDestroyEnd: Int(compilerMemoryNodeEnd(tables: tables, delta: delta, nodeID: destroyNodeID))
    if memoryDestroyEnd < 0 { return false }
    state memoryDestroyPathRegion: Int(destroyNodeID)
    if compilerIntTableValue(table: delta.nodes, row: destroyNodeID, column: 1) == compilerSyntaxKindReturn() {
        memoryDestroyPathRegion: compilerMemoryOwnedRegionForNode(delta: delta, nodeID: destroyNodeID)
    }
    if memoryDestroyPathRegion < 0 { return false }
    state memoryDestroyUseRow: Int(0)
    let memoryDestroyUseCount: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while memoryDestroyUseRow < memoryDestroyUseCount {
        if compilerIntTableValue(table: semantics.resolutions, row: memoryDestroyUseRow, column: 1) == localNodeID
            && compilerIntTableValue(table: semantics.resolutions, row: memoryDestroyUseRow, column: 2) == compilerSemanticResolutionLocal() {
            let memoryDestroyUseNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: memoryDestroyUseRow, column: 0))
            if compilerMemoryRegionContainsNode(delta: delta, regionNodeID: memoryDestroyPathRegion, nodeID: memoryDestroyUseNodeID)
                && compilerMemoryNodeEnd(tables: tables, delta: delta, nodeID: memoryDestroyUseNodeID) > memoryDestroyEnd { return false }
        }
        memoryDestroyUseRow: memoryDestroyUseRow + 1
    }
    return true
}

function compilerMemoryBuildDestroyDecisions(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    state memoryDestroyNodeID: Int(0)
    let memoryDestroyNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    let memoryDestroyStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    state memoryOpaqueStorageRow: Int(0)
    while memoryOpaqueStorageRow < memoryDestroyStorageCount {
        let memoryOpaqueLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryOpaqueStorageRow, column: 1))
        let memoryOpaqueTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryOpaqueStorageRow, column: 2))
        if compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryOpaqueTypeNodeID) == compilerRuntimeABIOpaqueIntBuffer() {
            let memoryOpaqueDestroyNodeID: Int(compilerMemoryOpaqueDestroyApplicationForLocal(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryOpaqueLocalNodeID))
            if memoryOpaqueDestroyNodeID < 0
                || compilerMemoryOpaqueHandleHasUseAfterDestroy(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryOpaqueLocalNodeID, destroyNodeID: memoryOpaqueDestroyNodeID) {
                compilerMemoryGraphPoison(memory: memory)
                return 0 - 1
            }
        }
        memoryOpaqueStorageRow: memoryOpaqueStorageRow + 1
    }
    while memoryDestroyNodeID < memoryDestroyNodeCount {
        state memoryDestroyRow: Int(0)
        while memoryDestroyRow < memoryDestroyStorageCount {
            let memoryDestroyStorageID: Int(compilerIntTableValue(table: memory.storages, row: memoryDestroyRow, column: 0))
            let memoryDestroyLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryDestroyRow, column: 1))
            let memoryDestroyTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryDestroyRow, column: 2))
            let memoryDestroyRegionNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryDestroyRow, column: 3))
            state memoryDestroyApplies: Bool(false)
            if compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryDestroyTypeNodeID) == compilerRuntimeABIOpaqueIntBuffer() {
                memoryDestroyApplies: compilerMemoryOpaqueDestroyApplicationForLocal(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryDestroyLocalNodeID) == memoryDestroyNodeID
            } else {
                memoryDestroyApplies: compilerMemoryRegionHasExit(delta: delta, regionNodeID: memoryDestroyRegionNodeID, exitNodeID: memoryDestroyNodeID)
                    && compilerMemoryExitAppliesToLocal(tables: tables, delta: delta, localNodeID: memoryDestroyLocalNodeID, exitNodeID: memoryDestroyNodeID)
            }
            if memoryDestroyApplies {
                if !compilerMemoryDestroyFollowsUses(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryDestroyLocalNodeID, destroyNodeID: memoryDestroyNodeID)
                    || compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionDestroy(), nodeID: memoryDestroyNodeID, storageID: memoryDestroyStorageID, typeNodeID: memoryDestroyTypeNodeID, value: 1, originNodeID: memoryDestroyLocalNodeID) != 0 {
                    compilerMemoryGraphPoison(memory: memory)
                    return 0 - 1
                }
            }
            memoryDestroyRow: memoryDestroyRow + 1
        }
        memoryDestroyNodeID: memoryDestroyNodeID + 1
    }
    return 0
}

function compilerMemoryFunctionReturnNode(delta: CompilerGraphDelta, functionNodeID: Int): Int {
