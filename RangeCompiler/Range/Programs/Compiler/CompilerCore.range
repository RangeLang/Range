function compilerTypedIRFixedLLVMRender(tables: CompilerSyntaxTables, memory: CompilerMemoryGraph, ir: CompilerTypedIR): String {
    state typedIRHelperFunctionRow: Int(0 - 1)
    state typedIREntryFunctionRow: Int(0 - 1)
    state typedIRRenderFunctionRow: Int(0)
    while typedIRRenderFunctionRow < compilerIntTableRowCount(table: ir.functions) {
