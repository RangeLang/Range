}

function compilerBodyArenaOwnedPathToEffectPath(arena: CompilerBodyArena, ownedPathID: Int, effectPaths: CompilerIntTable): Int {
    if ownedPathID < 0 || ownedPathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 2 }
    let members: RawBuffer(rawBufferCreate(capacity: 8, stride: 4))
    state currentPathID: Int(ownedPathID)
    state status: Int(0)
    while currentPathID >= 0 && status == 0 {
        if currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) {
            status: 0 - 1
        } else {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn()))
            if memberRow >= 0 {
                if rawBufferAppendInt(buffer: members, value: memberRow) != 0 { status: 0 - 1 }
            }
            currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
        }
    }
    if status != 0 {
        rawBufferDestroy(buffer: members)
        return 0 - 2
    }
    state effectPathID: Int(0 - 1)
    state reverseOrdinal: Int(rawBufferCount(buffer: members) - 1)
    while reverseOrdinal >= 0 && status == 0 {
        let nextPathID: Int(compilerBodyFunctionInstanceEffectPathAppend(paths: effectPaths, parentPathID: effectPathID, memberRow: rawBufferLoadInt(buffer: members, index: reverseOrdinal)))
        if nextPathID < 0 {
            status: 0 - 1
        } else {
            effectPathID: nextPathID
        }
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: members)
    if status != 0 { return 0 - 2 }
    return effectPathID
}

function compilerReachableLLVMStateReturnTypeIDForArena(arena: CompilerBodyArena): Int {
    if arena.ownerKind != compilerBodyArenaOwnerFunction() || arena.ownerFunctionRow < 0 { return 0 - 1 }
    let functionRow: Int(arena.ownerFunctionRow)
    let ownerSyntaxID: Int(compilerBodyArenaFunctionOwnerSyntaxID(arena: arena, functionID: functionRow))
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 1))
    let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 6))
    let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 7))
    return compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: returnFileID, start: returnStart, end: returnEnd)
}

function compilerReachableLLVMStateBuildReturnSummaryForArena(reachability: CompilerReachableLLVMState, arena: CompilerBodyArena, instanceID: Int): Int {
    let priorStatus: Int(compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: instanceID))
    if priorStatus == compilerReachableFunctionInstanceReturnSummarySupported() || priorStatus == compilerReachableFunctionInstanceReturnSummaryNoTrackedStorage() { return 0 }
    if priorStatus != compilerReachableFunctionInstanceReturnSummaryUnknown() { return 0 - 1 }
    let returnTypeID: Int(compilerReachableLLVMStateReturnTypeIDForArena(arena: arena))
    if returnTypeID < 0 { return 0 - 1 }
    let returnTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID))
    let returnTypeKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: returnTypeID))
    if returnTypeKeyID < 0 || returnTypeKind == compilerBodyTypeUnknown() { return 0 - 1 }
    let returnTrackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: returnTypeID))
    if returnTrackedStatus < 0 { return 0 - 1 }
    if returnTrackedStatus == 0 {
        if compilerIntTableRowCount(table: arena.ownedReturnTransfers) != 0 { return 0 - 1 }
        if compilerReachableLLVMStateSetReturnSummary(reachability: reachability, instanceID: instanceID, status: compilerReachableFunctionInstanceReturnSummaryNoTrackedStorage(), typeKeyID: returnTypeKeyID, typeKind: returnTypeKind, firstLeaf: 0 - 1, leafCount: 0) != 0 { return 0 - 1 }
        return 1
    }
    let transferCount: Int(compilerIntTableRowCount(table: arena.ownedReturnTransfers))
    if transferCount <= 0 { return 0 - 1 }
    state validationRow: Int(0)
    while validationRow < transferCount {
        let transferReturnNodeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()))
        let transferSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
        let transferSourceTypeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferTypeColumn()))
        let transferStorageKeyID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()))
        let transferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferKindColumn()))
        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferIDColumn()) != validationRow
            || transferReturnNodeID < 0 || transferReturnNodeID >= compilerIntTableRowCount(table: arena.nodes)
            || compilerIntTableValue(table: arena.nodes, row: transferReturnNodeID, column: 1) != compilerSyntaxKindReturn()
            || transferSourcePathID < 0 || transferSourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || (transferKind != compilerBodyOwnedReturnTransferMove() && transferKind != compilerBodyOwnedReturnTransferAlias() && transferKind != compilerBodyOwnedReturnTransferForward())
            || !compilerBodyFunctionInstanceEffectPathIsValid(paths: reachability.functionInstanceEffectPaths, pathID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()))
            || transferSourceTypeID != compilerIntTableValue(table: arena.ownedPaths, row: transferSourcePathID, column: compilerBodyOwnedPathTypeColumn())
            || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: transferSourceTypeID)
            || transferStorageKeyID < 0
            || transferStorageKeyID != compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: transferSourceTypeID) { return 0 - 1 }
        let transferRootClass: Int(compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: transferSourcePathID))
        if transferKind == compilerBodyOwnedReturnTransferMove() {
            if transferRootClass != compilerBodyOwnedSummaryRootLocalCreate()
                || compilerIntTableValue(table: arena.ownedPaths, row: transferSourcePathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned() { return 0 - 1 }
        } else if transferRootClass != compilerBodyOwnedSummaryRootBoundary()
            || compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: transferSourcePathID) < 0
            || compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: transferSourcePathID) < 0
            || compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: transferSourcePathID, effectPaths: reachability.functionInstanceEffectPaths) == 0 - 2
            || (transferKind == compilerBodyOwnedReturnTransferForward()
                && compilerIntTableValue(table: arena.ownedPaths, row: transferSourcePathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyBorrowed()) {
            return 0 - 1
        }
        validationRow: validationRow + 1
    }
    let canonicalReturnNodeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: 0, column: compilerBodyOwnedReturnTransferReturnNodeColumn()))
    state canonicalCount: Int(0)
    state transferRow: Int(0)
    while transferRow < transferCount {
        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == canonicalReturnNodeID { canonicalCount: canonicalCount + 1 }
        transferRow: transferRow + 1
    }
    if canonicalCount <= 0 { return 0 - 1 }
    state returnNodeScanRow: Int(0)
    while returnNodeScanRow < transferCount {
        let returnNodeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: returnNodeScanRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()))
        state firstOccurrence: Bool(true)
        state priorRow: Int(0)
        while priorRow < returnNodeScanRow {
            if compilerIntTableValue(table: arena.ownedReturnTransfers, row: priorRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID { firstOccurrence: false }
            priorRow: priorRow + 1
        }
        if firstOccurrence {
            state branchCount: Int(0)
            transferRow: 0
            while transferRow < transferCount {
                if compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID { branchCount: branchCount + 1 }
                transferRow: transferRow + 1
            }
            if branchCount != canonicalCount { return 0 - 1 }
            transferRow: 0
            while transferRow < transferCount {
                if compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == canonicalReturnNodeID {
                    let canonicalPathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()))
                    let canonicalStorageKeyID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()))
                    let canonicalTransferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferKindColumn()))
                    let canonicalSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
                    state canonicalSourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
                    state canonicalBaseKind: Int(0 - 1)
                    state canonicalOrdinal: Int(0 - 1)
                    state canonicalSourceEffectPathID: Int(0 - 1)
                    if canonicalTransferKind == compilerBodyOwnedReturnTransferAlias() || canonicalTransferKind == compilerBodyOwnedReturnTransferForward() {
                        if canonicalTransferKind == compilerBodyOwnedReturnTransferAlias() {
                            canonicalSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                        } else {
                            canonicalSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                        }
                        canonicalBaseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: canonicalSourcePathID)
                        canonicalOrdinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: canonicalSourcePathID)
                        canonicalSourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: canonicalSourcePathID, effectPaths: reachability.functionInstanceEffectPaths)
                    }
                    if canonicalBaseKind < 0
                        && (canonicalSourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                            || canonicalSourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward()) { return 0 - 1 }
                    state matchingCount: Int(0)
                    state branchRow: Int(0)
                    while branchRow < transferCount {
                        let branchTransferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferKindColumn()))
                        let branchSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
                        state branchSourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
                        state branchBaseKind: Int(0 - 1)
                        state branchOrdinal: Int(0 - 1)
                        state branchSourceEffectPathID: Int(0 - 1)
                        if branchTransferKind == compilerBodyOwnedReturnTransferAlias() || branchTransferKind == compilerBodyOwnedReturnTransferForward() {
                            if branchTransferKind == compilerBodyOwnedReturnTransferAlias() {
                                branchSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                            } else {
                                branchSourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                            }
                            branchBaseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: branchSourcePathID)
                            branchOrdinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: branchSourcePathID)
                            branchSourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: branchSourcePathID, effectPaths: reachability.functionInstanceEffectPaths)
                        }
                        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
                            && compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == canonicalPathID
                            && compilerIntTableValue(table: arena.ownedReturnTransfers, row: branchRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()) == canonicalStorageKeyID
                            && branchTransferKind == canonicalTransferKind
                            && branchSourceKind == canonicalSourceKind
                            && branchBaseKind == canonicalBaseKind
                            && branchOrdinal == canonicalOrdinal
                            && branchSourceEffectPathID == canonicalSourceEffectPathID { matchingCount: matchingCount + 1 }
                        branchRow: branchRow + 1
                    }
                    if matchingCount != 1 { return 0 - 1 }
                }
                transferRow: transferRow + 1
            }
        }
        returnNodeScanRow: returnNodeScanRow + 1
    }
    let firstLeaf: Int(compilerIntTableRowCount(table: reachability.functionInstanceReturnLeaves))
    transferRow: 0
    while transferRow < transferCount {
        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == canonicalReturnNodeID {
            let transferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferKindColumn()))
            let transferSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
            state sourceKind: Int(compilerReachableFunctionInstanceReturnSourceLocalCreate())
            state baseKind: Int(0 - 1)
            state ordinal: Int(0 - 1)
            state sourceEffectPathID: Int(0 - 1)
            if transferKind == compilerBodyOwnedReturnTransferAlias() || transferKind == compilerBodyOwnedReturnTransferForward() {
                if transferKind == compilerBodyOwnedReturnTransferAlias() {
                    sourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                } else {
                    sourceKind: compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                }
                baseKind: compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: transferSourcePathID)
                ordinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: transferSourcePathID)
                sourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: transferSourcePathID, effectPaths: reachability.functionInstanceEffectPaths)
                if baseKind < 0 || ordinal < 0 || sourceEffectPathID == 0 - 2 { return 0 - 1 }
            }
            if compilerReachableLLVMStateAppendReturnLeafToBuffer(output: reachability.functionInstanceReturnLeaves.values, instanceID: instanceID, returnPathID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()), sourceKind: sourceKind, baseKind: baseKind, ordinal: ordinal, sourcePathID: sourceEffectPathID, storageKeyID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: transferRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn())) != 0 { return 0 - 1 }
        }
        transferRow: transferRow + 1
    }
    let setStatus: Int(compilerReachableLLVMStateSetReturnSummary(reachability: reachability, instanceID: instanceID, status: compilerReachableFunctionInstanceReturnSummarySupported(), typeKeyID: returnTypeKeyID, typeKind: returnTypeKind, firstLeaf: firstLeaf, leafCount: canonicalCount))
    if setStatus != 0 { return 0 - 1 }
    return 1
}

function compilerBodyArenaOwnedPathRootSymbolKind(arena: CompilerBodyArena, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 || compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()) != compilerBodyOwnedPathRootSymbol() { return 0 - 1 }
    let rootSymbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if rootSymbolID < 0 || rootSymbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    return compilerIntTableValue(table: arena.symbols, row: rootSymbolID, column: compilerBodySymbolKindColumn())
}

function compilerBodyArenaOwnedPathSummaryRootClass(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 { return compilerBodyOwnedSummaryRootInvalid() }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
    if rootKind == compilerBodyOwnedPathRootValue() {
        if compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyOwned() { return compilerBodyOwnedSummaryRootLocalCreate() }
        return compilerBodyOwnedSummaryRootInvalid()
    }
    if rootKind != compilerBodyOwnedPathRootSymbol() { return compilerBodyOwnedSummaryRootInvalid() }
    let rootSymbolKind: Int(compilerBodyArenaOwnedPathRootSymbolKind(arena: arena, pathID: pathID))
    if rootSymbolKind < 0 { return compilerBodyOwnedSummaryRootInvalid() }
