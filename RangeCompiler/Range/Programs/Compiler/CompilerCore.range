        } else {
            let graphApplicationIdentity: CompilerFingerprint(compilerMacroExecutionApplicationIdentity(tables: tables, applicationRow: applicationRow))
            let graphTargetIdentity: CompilerFingerprint(compilerMacroExecutionTargetIdentity(tables: tables, targetSyntaxID: targetSyntaxID))
            let graphQueryIdentity: CompilerFingerprint(compilerMacroExecutionReadIdentity(applicationIdentity: graphApplicationIdentity, targetIdentity: graphTargetIdentity, operation: compilerMacroGraphOperationDeclarationCount(), keyKindTag: queryKindTag, key: queryName))
            let graphObservedCount: Int(compilerMacroExecutionDeclarationCount(tables: tables, kindTag: queryKindTag, name: queryName))
            let graphObservation: CompilerFingerprint(compilerMacroExecutionDeclarationObservation(tables: tables, kindTag: queryKindTag, name: queryName))
            let graphQueryResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
            if compilerMacroExecutionAppendReadDependency(tables: tables, invocationRow: invocationRow, operation: compilerMacroGraphOperationDeclarationCount(), arena: arena, operationRow: operationRow, kindValueID: queryKindValueID, nameValueID: queryNameValueID, kindTag: queryKindTag, observedCount: graphObservedCount, applicationIdentity: graphApplicationIdentity, targetIdentity: graphTargetIdentity, queryIdentity: graphQueryIdentity, observation: graphObservation) < 0
                || rawBufferStoreInt(buffer: evaluationValues, index: graphQueryResultValueID, value: graphObservedCount) != 0 {
