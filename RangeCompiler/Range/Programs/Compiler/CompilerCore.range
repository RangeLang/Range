    if compilerSyntaxTableAppend(tables: tables, table: tables.parameters, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: typeStart)) != 0 { return 0 - 1 }
