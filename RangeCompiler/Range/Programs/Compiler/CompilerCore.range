            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: delta.nodes, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 901)
    row: 0
    while row < compilerIntTableRowCount(table: delta.facts) {
        column: 0
        while column < compilerGraphFactColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: delta.facts, row: row, column: column))
