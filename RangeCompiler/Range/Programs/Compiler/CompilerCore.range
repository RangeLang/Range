                    appendStatus: compilerMacroGraphDeltaAppendGeneratedFunction(tables: tables, delta: graphDelta, templateRow: templateRow, ownerTargetSyntaxID: expansionTargetSyntaxID, applicationRow: applicationRow, applicationIdentity: applicationIdentity, targetIdentity: targetIdentity)
                } else if templateKind == compilerMacroExpansionTemplateKindMember() {
                    appendStatus: compilerMacroGraphDeltaAppendGeneratedMember(tables: tables, delta: graphDelta, templateRow: templateRow, ownerTargetSyntaxID: expansionTargetSyntaxID, applicationRow: applicationRow, applicationIdentity: applicationIdentity, targetIdentity: targetIdentity)
                }
                if appendStatus < 0 { operationStatus: 0 - compilerMacroDiagnosticGraphDeltaInvalid() }
                templateCount: templateCount + 1
            }
            templateRow: templateRow + 1
        }
        if templateCount == 0 { operationStatus: 0 - compilerMacroDiagnosticGraphDeltaInvalid() }
    } else {
        operationStatus: 0 - compilerMacroDiagnosticGraphDeltaInvalid()
    }
    return operationStatus
}

function compilerMacroExecutionEvaluateReadOperation(tables: CompilerSyntaxTables, arena: CompilerBodyArena, evaluationValues: RawBuffer, applicationRow: Int, invocationRow: Int, targetSyntaxID: Int, operationRow: Int, operationKind: Int): Int {
    state operationStatus: Int(1)
