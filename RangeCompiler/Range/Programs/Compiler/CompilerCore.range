function compilerBodyArenaIsValid(arena: CompilerBodyArena): Bool {
    if arena.ownerKind == compilerBodyArenaOwnerFunction() {
        if arena.ownerFunctionRow < 0 || arena.ownerFunctionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return false }
        if arena.ownerDeclarationSyntaxID != compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 0)
            || arena.fileID != compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1) { return false }
    } else if arena.ownerKind == compilerBodyArenaOwnerEntry() {
        if arena.ownerFunctionRow != 0 - 1 { return false }
        let maybeMain: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: arena.tables.sourceStore.source))
        if maybeMain == nil { return false }
        let fallbackMain: CompilerMainBlock(CompilerMainBlock(attributeStart: 0, bodyStart: 0, bodyEnd: 0))
        let mainBlock: CompilerMainBlock(maybeMain ?? fallbackMain)
        if arena.ownerDeclarationSyntaxID != mainBlock.attributeStart
            || arena.fileID != compilerSourceStoreFileIDAtGlobalOffset(store: arena.tables.sourceStore, globalOffset: mainBlock.attributeStart)
            || arena.bodyStart != mainBlock.bodyStart
            || arena.bodyEnd != mainBlock.bodyEnd { return false }
    } else if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        if arena.ownerFunctionRow != 0 - 1
            || arena.ownerDeclarationSyntaxID < 0
            || arena.ownerDeclarationSyntaxID >= compilerIntTableRowCount(table: arena.tables.macroDeclarations)
            || arena.fileID != compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 1)
            || arena.bodyStart != compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 27))
            || arena.bodyEnd != compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 28)) { return false }
    } else { return false }
    if arena.bodyStart < 0
        || arena.bodyEnd <= arena.bodyStart
        || arena.rootNodeID != 0
        || intBufferCount(buffer: arena.failures) != 0
        || !compilerIntTableIsComplete(table: arena.nodes)
        || !compilerIntTableIsComplete(table: arena.edges)
        || !compilerIntTableIsComplete(table: arena.symbols)
        || !compilerIntTableIsComplete(table: arena.resolutions)
        || !compilerIntTableIsComplete(table: arena.typeInstances)
        || !compilerIntTableIsComplete(table: arena.cfgBlocks)
        || !compilerIntTableIsComplete(table: arena.cfgEdges)
        || !compilerIntTableIsComplete(table: arena.cfgSchedule)
        || !compilerIntTableIsComplete(table: arena.storages)
        || !compilerIntTableIsComplete(table: arena.memoryFacts)
        || intBufferCount(buffer: arena.memoryState) != compilerBodyMemoryStateCount()
        || !compilerIntTableIsComplete(table: arena.mirValues)
        || !compilerIntTableIsComplete(table: arena.mirBlocks)
        || !compilerIntTableIsComplete(table: arena.mirOperations)
        || !compilerIntTableIsComplete(table: arena.mirOperands)
        || !compilerIntTableIsComplete(table: arena.mirExpressionValues)
        || compilerIntTableRowCount(table: arena.nodes) < 1
        || compilerIntTableValue(table: arena.nodes, row: 0, column: 0) != 0
        || compilerIntTableValue(table: arena.nodes, row: 0, column: 1) != compilerSyntaxKindLexicalRegion() { return false }
    state nodeRow: Int(0)
    let nodeCount: Int(compilerIntTableRowCount(table: arena.nodes))
    while nodeRow < nodeCount {
        let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1))
        if compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 0) != nodeRow
            || compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 2) != arena.fileID
            || kind < compilerSyntaxKindEntry()
            || kind > compilerSyntaxKindRemainder() { return false }
        nodeRow: nodeRow + 1
    }
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        let ownerNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0))
        let childNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1))
        let role: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2))
        if ownerNodeID < 0 || ownerNodeID >= nodeCount
            || childNodeID < 0 || childNodeID >= nodeCount
            || role < compilerSyntaxRoleStatement() || role > compilerSyntaxRoleInterpolationPart() { return false }
        edgeRow: edgeRow + 1
    }
    return true
}

function compilerBodyArenaCanLowerFunction(arena: CompilerBodyArena): Bool {
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return false }
    let statementNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: arena.rootNodeID, role: compilerSyntaxRoleStatement(), ordinal: 0))
    if statementNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 1) != compilerSyntaxKindReturn() { return false }
    let expressionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
    if expressionNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: expressionNodeID, column: 1) != compilerSyntaxKindIntegerLiteral() { return false }
    let returnType: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6), localEnd: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7)))
    return returnType == String("Int")
}

