                let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleAssignedValue(), ordinal: 0))
                if targetNodeID < 0 || valueNodeID < 0
                    || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: targetNodeID, regionNodeID: regionNodeID) != 0
                    || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: valueNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                state writableSymbolID: Int(0 - 1)
                let targetKind: Int(compilerIntTableValue(table: arena.nodes, row: targetNodeID, column: 1))
                if targetKind == compilerSyntaxKindIdentifier() {
                    writableSymbolID: compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: targetNodeID)
                } else if targetKind == compilerSyntaxKindMemberRead() {
                    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: targetNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
                    if receiverNodeID >= 0 && compilerIntTableValue(table: arena.nodes, row: receiverNodeID, column: 1) == compilerSyntaxKindIdentifier() { writableSymbolID: compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: receiverNodeID) }
                }
                if writableSymbolID < 0 || compilerIntTableValue(table: arena.symbols, row: writableSymbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolState() { return 0 - 1 }
            } else if kind == compilerSyntaxKindReturn() {
                let returnNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
                if returnNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: returnNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
            } else if kind == compilerSyntaxKindApplication() {
                if compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: statementNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
            } else { return 0 - 1 }
            ordinal: ordinal + 1
        }
    }
    return 0
}

function compilerBodyArenaBuildSymbolsAndResolutions(arena: CompilerBodyArena, index: CompilerDeclarationIndex): Int {
    if compilerBodyArenaSeedParameterSymbols(arena: arena) != 0 { return 0 - 1 }
    return compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: arena.rootNodeID)
}

function compilerBodyArenaCFGAppendBlock(arena: CompilerBodyArena, regionNodeID: Int, firstStatementOrdinal: Int): Int {
    let blockID: Int(compilerIntTableRowCount(table: arena.cfgBlocks))
    if compilerIntTableAppend(table: arena.cfgBlocks, value: blockID) != 0
        || compilerIntTableAppend(table: arena.cfgBlocks, value: regionNodeID) != 0
