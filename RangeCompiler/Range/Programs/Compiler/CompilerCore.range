    let mirTraversalStatus: Int(intBufferDestroy(buffer: arena.mirTraversal))
    let failureStatus: Int(intBufferDestroy(buffer: arena.failures))
    if nodeStatus != 0 || edgeStatus != 0 || symbolStatus != 0 || resolutionStatus != 0 || typeInstanceStatus != 0
        || cfgBlockStatus != 0 || cfgEdgeStatus != 0 || cfgScheduleStatus != 0 || storageStatus != 0 || memoryStatus != 0 || memoryStateStatus != 0
        || mirValueStatus != 0 || mirBlockStatus != 0 || mirStatus != 0 || mirOperandStatus != 0 || mirVersionStatus != 0 || mirExpressionValueStatus != 0 || mirTraversalStatus != 0
        || failureStatus != 0 { return 0 - 1 }
    return 0
}

function compilerBodyArenaChild(arena: CompilerBodyArena, ownerNodeID: Int, role: Int, ordinal: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0) == ownerNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == role
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 3) == ordinal {
            return compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1)
