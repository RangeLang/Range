function compilerTypedSyntaxCaptureTopLevelTokenWithPolicy(source: String, tables: CompilerSyntaxTables, declarationOrdinal: Int, token: RangeLexedToken, captureBodies: Bool, builtinPolicy: Int, fileEnd: Int): CompilerTypedDeclarationCaptureStep {
    if token.kind == .keyword && (token.text == String("open") || token.text == String("closed")) {
        let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: token.end))
        let maybeMacro: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeMacro != nil {
            let fallbackMacro: RangeLexedToken(compilerFallbackToken(cursor: cursor))
            let macroToken: RangeLexedToken(maybeMacro ?? fallbackMacro)
            if macroToken.kind == .keyword && macroToken.text == String("macro") {
                state visibility: Int(compilerSyntaxMacroVisibilityDefault())
                if token.text == String("open") { visibility: compilerSyntaxMacroVisibilityOpen() }
                if token.text == String("closed") { visibility: compilerSyntaxMacroVisibilityClosed() }
                return compilerTypedSyntaxCaptureMacroWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, visibility: visibility, declarationStart: token.start, keyword: macroToken)
            }
        }
    }
    if token.kind == .keyword && token.text == String("construct") {
        return compilerTypedSyntaxCaptureConstructWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, keyword: token, builtinPolicy: builtinPolicy, captureBodies: captureBodies, parentSyntaxID: 0 - 1)
    }
    if token.kind == .keyword && token.text == String("enum") {
        return compilerTypedSyntaxCaptureEnum(source: source, tables: tables, declarationOrdinal: declarationOrdinal, keyword: token, builtinPolicy: builtinPolicy)
    }
    if token.kind == .keyword && token.text == String("extension") {
        return compilerTypedSyntaxCaptureExtension(source: source, tables: tables, keyword: token, captureBodies: captureBodies, builtinPolicy: builtinPolicy)
    }
    if token.kind == .keyword && token.text == String("function") {
        return compilerTypedSyntaxCaptureFunctionWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, parentSyntaxID: 0 - 1, keyword: token, captureBody: captureBodies, builtinPolicy: builtinPolicy, fileEnd: fileEnd)
    }
    if token.kind == .keyword && token.text == String("macro") {
        return compilerTypedSyntaxCaptureMacroWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, visibility: compilerSyntaxMacroVisibilityDefault(), declarationStart: token.start, keyword: token)
    }
    return CompilerTypedDeclarationCaptureStep(captured: false, nextIndex: token.end)
}

function compilerTypedSyntaxCaptureConstruct(source: String, tables: CompilerSyntaxTables, declarationOrdinal: Int, keyword: RangeLexedToken): CompilerTypedDeclarationCaptureStep {
    return compilerTypedSyntaxCaptureConstructWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, keyword: keyword, builtinPolicy: compilerBuiltinPolicyNone(), captureBodies: true, parentSyntaxID: 0 - 1)
