            let boundaryValueNodeID: Int(compilerBodyArenaCallBoundaryValueNode(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
            let boundaryPathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
            let sourcePathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: boundaryPathID, effectPaths: effectPaths, effectPathID: sourceEffectPathID))
            if compilerIntTableValue(table: arena.ownedPaths, row: destinationLeafPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned()
                || boundaryValueNodeID < 0 || compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: boundaryValueNodeID)
                || boundaryPathID < 0 || sourcePathID < 0
                || compilerBodyArenaOwnedPathState(states: states, pathID: boundaryPathID) != compilerBodyOwnedPathLive()
                || compilerBodyArenaOwnedPathState(states: states, pathID: sourcePathID) != compilerBodyOwnedPathLive() { return 0 - 1 }
            let sourcePolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathPolicyColumn()))
            let sourceOriginPathID: Int(compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: sourcePathID))
            if (sourcePolicy != compilerBodyOwnedPathPolicyOwned() && sourcePolicy != compilerBodyOwnedPathPolicyBorrowed())
                || (sourcePolicy == compilerBodyOwnedPathPolicyOwned() && sourceOriginPathID != compilerBodyOwnedOriginLocal() && !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: sourceOriginPathID))
                || (sourcePolicy == compilerBodyOwnedPathPolicyBorrowed() && !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: sourceOriginPathID))
                || compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathTypeColumn())) != storageKeyID { return 0 - 1 }
            state priorForwardLeafOffset: Int(0)
            while priorForwardLeafOffset < leafOffset {
                let priorLeafRow: Int(firstLeaf + priorForwardLeafOffset)
                if compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafSourceKindColumn()) == compilerReachableFunctionInstanceReturnSourceBoundaryForward() {
                    let priorBaseKind: Int(compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn()))
                    let priorOrdinal: Int(compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn()))
                    let priorBoundaryPathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: priorBaseKind, ordinal: priorOrdinal))
                    let priorSourcePathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: priorBoundaryPathID, effectPaths: effectPaths, effectPathID: compilerIntTableValue(table: returnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn())))
                    if priorBoundaryPathID < 0 || priorSourcePathID < 0 || priorSourcePathID == sourcePathID { return 0 - 1 }
                }
                priorForwardLeafOffset: priorForwardLeafOffset + 1
            }
        } else {
            return 0 - 1
        }
