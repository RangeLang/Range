}

function compilerMacroExecutionEvaluateValueOperation(arena: CompilerBodyArena, evaluationValues: RawBuffer, currentBlockID: Int, previousBlockID: Int, operationRow: Int, operationKind: Int): Int {
    state operationStatus: Int(1)
    if operationKind == compilerBodyMIROperationConstant() || operationKind == compilerBodyMIROperationStringGlobal() {
        let constantResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let scalarValue: Int(compilerMacroExecutionScalarValue(arena: arena, valueID: constantResultValueID))
        if rawBufferStoreInt(buffer: evaluationValues, index: constantResultValueID, value: scalarValue) != 0 {
            operationStatus: 0 - compilerMacroDiagnosticBodyInvalid()
        }
    } else if operationKind == compilerBodyMIROperationLocalValue() || operationKind == compilerBodyMIROperationAssignVersion() || operationKind == compilerBodyMIROperationPhi() {
        let copyResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let copyOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
        state incomingOrdinal: Int(0)
        if operationKind == compilerBodyMIROperationPhi() { incomingOrdinal: compilerMacroExecutionPhiOperandOrdinal(arena: arena, blockID: currentBlockID, previousBlockID: previousBlockID, operandCount: copyOperandCount) }
        let incomingValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: incomingOrdinal))
        if copyOperandCount <= 0 || incomingValueID < 0 || incomingValueID >= rawBufferCount(buffer: evaluationValues)
            || rawBufferStoreInt(buffer: evaluationValues, index: copyResultValueID, value: rawBufferLoadInt(buffer: evaluationValues, index: incomingValueID)) != 0 {
            operationStatus: 0 - compilerMacroDiagnosticBodyInvalid()
        }
    } else if operationKind == compilerBodyMIROperationEqual() || operationKind == compilerBodyMIROperationNotEqual()
        || operationKind == compilerBodyMIROperationAnd() || operationKind == compilerBodyMIROperationOr()
        || operationKind == compilerBodyMIROperationAdd() || operationKind == compilerBodyMIROperationSubtract()
        || operationKind == compilerBodyMIROperationMultiply() || operationKind == compilerBodyMIROperationDivide()
        || operationKind == compilerBodyMIROperationRemainder() || operationKind == compilerBodyMIROperationLessThan()
        || operationKind == compilerBodyMIROperationLessEqual() || operationKind == compilerBodyMIROperationGreaterThan()
        || operationKind == compilerBodyMIROperationGreaterEqual() {
        let leftValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
        let rightValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 1))
        let binaryResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let binaryOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
        state binaryScalarResult: Int(0)
        state binaryOperationValid: Bool(binaryOperandCount == 2
            && leftValueID >= 0 && leftValueID < rawBufferCount(buffer: evaluationValues)
            && rightValueID >= 0 && rightValueID < rawBufferCount(buffer: evaluationValues))
        if binaryOperationValid {
            let leftValue: Int(rawBufferLoadInt(buffer: evaluationValues, index: leftValueID))
            let rightValue: Int(rawBufferLoadInt(buffer: evaluationValues, index: rightValueID))
            if operationKind == compilerBodyMIROperationEqual() { if leftValue == rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationNotEqual() { if leftValue != rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationAnd() { if leftValue != 0 && rightValue != 0 { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationOr() { if leftValue != 0 || rightValue != 0 { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationAdd() { binaryScalarResult: leftValue + rightValue }
            if operationKind == compilerBodyMIROperationSubtract() { binaryScalarResult: leftValue - rightValue }
            if operationKind == compilerBodyMIROperationMultiply() { binaryScalarResult: leftValue * rightValue }
            if operationKind == compilerBodyMIROperationDivide() {
                if rightValue == 0 { binaryOperationValid: false } else { binaryScalarResult: leftValue / rightValue }
            }
            if operationKind == compilerBodyMIROperationRemainder() {
                if rightValue == 0 { binaryOperationValid: false } else { binaryScalarResult: leftValue % rightValue }
            }
            if operationKind == compilerBodyMIROperationLessThan() { if leftValue < rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationLessEqual() { if leftValue <= rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationGreaterThan() { if leftValue > rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationGreaterEqual() { if leftValue >= rightValue { binaryScalarResult: 1 } }
        }
        if !binaryOperationValid || rawBufferStoreInt(buffer: evaluationValues, index: binaryResultValueID, value: binaryScalarResult) != 0 {
            operationStatus: 0 - compilerMacroDiagnosticBodyInvalid()
        }
    } else if operationKind == compilerBodyMIROperationPrefixNot() || operationKind == compilerBodyMIROperationPrefixNegate() {
        let operandValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
        let prefixResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let prefixOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
        state prefixScalarResult: Int(0)
        if prefixOperandCount != 1 || operandValueID < 0 || operandValueID >= rawBufferCount(buffer: evaluationValues) {
            operationStatus: 0 - compilerMacroDiagnosticBodyInvalid()
        } else {
            let operandValue: Int(rawBufferLoadInt(buffer: evaluationValues, index: operandValueID))
            if operationKind == compilerBodyMIROperationPrefixNot() {
                if operandValue == 0 { prefixScalarResult: 1 }
            } else { prefixScalarResult: 0 - operandValue }
            if rawBufferStoreInt(buffer: evaluationValues, index: prefixResultValueID, value: prefixScalarResult) != 0 {
                operationStatus: 0 - compilerMacroDiagnosticBodyInvalid()
            }
        }
    } else {
        operationStatus: 0
    }
    return operationStatus
}

function compilerMacroExecutionEvaluateInvocation(tables: CompilerSyntaxTables, arena: CompilerBodyArena, graphDelta: CompilerGraphDelta, pendingOmissionTargets: RawBuffer, applicationRow: Int, declarationRow: Int, invocationRow: Int, bodyStart: Int, bodyEnd: Int): CompilerMacroInvocationOutcome {
    state status: Int(0)
    state diagnosticCode: Int(0)
    state eventCount: Int(0)
    state readDependencyCount: Int(0)
    state mirOperationCount: Int(0)
    state stepCount: Int(0)
    let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 12))
    let evaluationValues: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.mirValues), stride: 4))
    state evaluationValueRow: Int(0)
    while evaluationValueRow < compilerIntTableRowCount(table: arena.mirValues) {
        rawBufferAppendInt(buffer: evaluationValues, value: 0)
        evaluationValueRow: evaluationValueRow + 1
    }
    state invocationSteps: Int(0)
    state currentBlockID: Int(0)
    state previousBlockID: Int(0 - 1)
    state pathRunning: Bool(true)
    state failureOperationRow: Int(0 - 1)
    while pathRunning && status == 0 {
        state blockValid: Bool(currentBlockID >= 0 && currentBlockID < compilerIntTableRowCount(table: arena.mirBlocks))
        if !blockValid {
            status: 0 - 1
            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
        } else {
            let blockFirstOperation: Int(compilerIntTableValue(table: arena.mirBlocks, row: currentBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
            let blockOperationCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: currentBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
            if blockOperationCount <= 0 || blockFirstOperation < 0 || blockFirstOperation + blockOperationCount > compilerIntTableRowCount(table: arena.mirOperations) {
                status: 0 - 1
                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
            } else {
                state blockOperationOrdinal: Int(0)
                while blockOperationOrdinal < blockOperationCount && pathRunning && status == 0 {
                    let operationRow: Int(blockFirstOperation + blockOperationOrdinal)
                    invocationSteps: invocationSteps + 1
                    stepCount: stepCount + 1
                    if invocationSteps > compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 8) {
                        status: 0 - 1
                        diagnosticCode: compilerMacroDiagnosticFuelExhausted()
                        failureOperationRow: operationRow
                        pathRunning: false
                    } else {
                        let operationKind: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationKindColumn()))
                        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationIDColumn()) != operationRow
                            || compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationBlockColumn()) != currentBlockID {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            failureOperationRow: operationRow
                        } else if operationKind == compilerBodyMIROperationMacroDiagnostic() {
                            let operation: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
                            let messageValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 1))
                            let diagnosticOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
                            let eventIdentity: CompilerFingerprint(compilerMacroExecutionErrorIdentity(base: compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow), code: operation, row: operationRow))
                            if diagnosticOperandCount != 2 || compilerMacroExecutionAppendEvent(tables: tables, invocationRow: invocationRow, operation: operation, arena: arena, operationRow: operationRow, messageValueID: messageValueID, identity: eventIdentity) < 0 {
                                status: 0 - 1
                                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                failureOperationRow: operationRow
                            } else {
                                eventCount: eventCount + 1
                                if operation == compilerMacroOperationError() {
                                    status: 0 - 1
                                    diagnosticCode: compilerMacroDiagnosticExecutionError()
                                    failureOperationRow: operationRow
                                }
                            }
                        } else if operationKind == compilerBodyMIROperationMacroTargetExpansion() {
                            let expansionStatus: Int(compilerMacroExecutionEvaluateExpansionOperation(tables: tables, arena: arena, graphDelta: graphDelta, pendingOmissionTargets: pendingOmissionTargets, applicationRow: applicationRow, declarationRow: declarationRow, targetSyntaxID: targetSyntaxID, operationRow: operationRow))
                            if expansionStatus < 0 {
                                status: 0 - 1
                                diagnosticCode: 0 - expansionStatus
                                failureOperationRow: operationRow
                            }
                        } else if operationKind == compilerBodyMIROperationMacroCapabilityDenied() {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticCapabilityDenied()
                            failureOperationRow: operationRow
                        } else if operationKind == compilerBodyMIROperationMacroGraphQuery() || operationKind == compilerBodyMIROperationMacroTargetQuery() {
                            let readStatus: Int(compilerMacroExecutionEvaluateReadOperation(tables: tables, arena: arena, evaluationValues: evaluationValues, applicationRow: applicationRow, invocationRow: invocationRow, targetSyntaxID: targetSyntaxID, operationRow: operationRow, operationKind: operationKind))
                            if readStatus < 0 {
                                status: 0 - 1
                                diagnosticCode: 0 - readStatus
                                failureOperationRow: operationRow
                            } else {
                                readDependencyCount: readDependencyCount + 1
                            }
                        } else {
                            let valueStatus: Int(compilerMacroExecutionEvaluateValueOperation(arena: arena, evaluationValues: evaluationValues, currentBlockID: currentBlockID, previousBlockID: previousBlockID, operationRow: operationRow, operationKind: operationKind))
                            if valueStatus < 0 {
                                status: 0 - 1
                                diagnosticCode: 0 - valueStatus
                                failureOperationRow: operationRow
                            } else if valueStatus == 0 {
                                if operationKind != compilerBodyMIROperationCondBranch()
                                    && operationKind != compilerBodyMIROperationBranch()
                                    && operationKind != compilerBodyMIROperationReturn() {
                                    status: 0 - 1
                                    diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                    failureOperationRow: operationRow
                                } else if operationKind == compilerBodyMIROperationReturn() {
                                    pathRunning: false
                                }
                            }
                        }
                    }
                    blockOperationOrdinal: blockOperationOrdinal + 1
                }
                if status == 0 && pathRunning {
                    let terminatorRow: Int(blockFirstOperation + blockOperationCount - 1)
                    let terminatorKind: Int(compilerIntTableValue(table: arena.mirOperations, row: terminatorRow, column: compilerBodyMIROperationKindColumn()))
                    state nextBlockID: Int(0 - 1)
                    if terminatorKind == compilerBodyMIROperationCondBranch() {
                        let conditionValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: terminatorRow, ordinal: 0))
                        state conditionTypeKind: Int(0 - 1)
                        if conditionValueID >= 0 && conditionValueID < compilerIntTableRowCount(table: arena.mirValues) {
                            conditionTypeKind: compilerIntTableValue(table: arena.mirValues, row: conditionValueID, column: compilerBodyMIRValueTypeColumn())
                        }
                        if conditionValueID < 0 || conditionValueID >= rawBufferCount(buffer: evaluationValues) || conditionTypeKind != compilerBodyTypeBool() {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            failureOperationRow: terminatorRow
                        } else if rawBufferLoadInt(buffer: evaluationValues, index: conditionValueID) != 0 {
                            nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeTrue())
                        } else {
                            nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeFalse())
                        }
                    } else if terminatorKind == compilerBodyMIROperationBranch() {
                        nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeFallthrough())
                        if nextBlockID < 0 { nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeBackedge()) }
                    } else if terminatorKind == compilerBodyMIROperationReturn() {
                        pathRunning: false
                    } else {
                        status: 0 - 1
                        diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                        failureOperationRow: terminatorRow
                    }
                    if status == 0 && pathRunning {
                        if nextBlockID < 0 || nextBlockID >= compilerIntTableRowCount(table: arena.mirBlocks) {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            failureOperationRow: terminatorRow
                        } else {
                            previousBlockID: currentBlockID
                            currentBlockID: nextBlockID
                        }
                    }
                }
            }
        }
    }
    mirOperationCount: mirOperationCount + compilerIntTableRowCount(table: arena.mirOperations)
    if status == 0 {
        let successIdentity: CompilerFingerprint(compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow))
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationSuccess(), diagnosticCode: 0, diagnosticFileID: 0 - 1, diagnosticStart: 0 - 1, diagnosticEnd: 0 - 1, resultIdentity: successIdentity, mirOperationCount: compilerIntTableRowCount(table: arena.mirOperations), stepCount: invocationSteps, pipelineStatus: 0, pipelineFailureCode: 0)
    } else {
        state failureFileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
        state failureStart: Int(bodyStart)
        state failureEnd: Int(bodyEnd)
        if failureOperationRow >= 0 && failureOperationRow < compilerIntTableRowCount(table: arena.mirOperations) {
            let failureSourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: failureOperationRow, column: compilerBodyMIROperationSourceColumn()))
            if failureSourceNodeID >= 0 && failureSourceNodeID < compilerIntTableRowCount(table: arena.nodes) {
                failureFileID: arena.fileID
                failureStart: compilerIntTableValue(table: arena.nodes, row: failureSourceNodeID, column: 4)
                failureEnd: compilerIntTableValue(table: arena.nodes, row: failureSourceNodeID, column: 5)
            }
        }
        let failureIdentity: CompilerFingerprint(compilerMacroExecutionErrorIdentity(base: compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow), code: diagnosticCode, row: failureOperationRow))
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationFailed(), diagnosticCode: diagnosticCode, diagnosticFileID: failureFileID, diagnosticStart: failureStart, diagnosticEnd: failureEnd, resultIdentity: failureIdentity, mirOperationCount: compilerIntTableRowCount(table: arena.mirOperations), stepCount: 0, pipelineStatus: 0, pipelineFailureCode: 0)
    }
    rawBufferDestroy(buffer: evaluationValues)
    return CompilerMacroInvocationOutcome(status: status, diagnosticCode: diagnosticCode, eventCount: eventCount, readDependencyCount: readDependencyCount, mirOperationCount: mirOperationCount, stepCount: stepCount)
}

function compilerMacroExecutionRunInvocation(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, graphDelta: CompilerGraphDelta, pendingOmissionTargets: RawBuffer, applicationRow: Int, declarationRow: Int, invocationRow: Int, bodyStart: Int, bodyEnd: Int): CompilerMacroInvocationOutcome {
    let declarationFileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
    let globalBodyStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: declarationFileID, localOffset: bodyStart))
    let globalBodyEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: declarationFileID, localOffset: bodyEnd))
    if compilerCoreFirstNonWhitespaceIndex(source: tables.sourceStore.source, start: globalBodyStart, end: globalBodyEnd) >= globalBodyEnd {
        let noOpIdentity: CompilerFingerprint(compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow))
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationSuccess(), diagnosticCode: 0, diagnosticFileID: 0 - 1, diagnosticStart: 0 - 1, diagnosticEnd: 0 - 1, resultIdentity: noOpIdentity, mirOperationCount: 0, stepCount: 0, pipelineStatus: 0, pipelineFailureCode: 0)
        return CompilerMacroInvocationOutcome(status: 0, diagnosticCode: 0, eventCount: 0, readDependencyCount: 0, mirOperationCount: 0, stepCount: 0)
    }
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateMacro(tables: tables, index: index, macroDeclarationRow: declarationRow)))
    let emptyReturnModes: RawBuffer(rawBufferCreate(capacity: 0, stride: 4))
    let emptyParticipants: RawBuffer(rawBufferCreate(capacity: 0, stride: 4))
    let emptyTypeKeys: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyColumnCount(), estimatedRowCount: 0))
    let emptyTypeKeyArguments: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyArgumentColumnCount(), estimatedRowCount: 0))
    let emptyEffectPaths: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectPathColumnCount(), estimatedRowCount: 0))
    let emptyReturnSummaries: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnSummaryColumnCount(), estimatedRowCount: 0))
    let emptyReturnLeaves: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnLeafColumnCount(), estimatedRowCount: 0))
    let abiPlan: CompilerModuleABIPlan(CompilerModuleABIPlan(returnModes: $emptyReturnModes, participants: $emptyParticipants, isFrozen: false))
    state status: Int(0)
    state diagnosticCode: Int(0)
    state eventCount: Int(0)
    state readDependencyCount: Int(0)
    state mirOperationCount: Int(0)
    state stepCount: Int(0)
    state pipelineStatus: Int(0)
    state pipelineFailureCode: Int(0)
    if rawBufferCount(buffer: arena.failures) != 0 {
        pipelineStatus: 1
        let parseFailureOffset: Int(rawBufferLoadInt(buffer: arena.failures, index: 0))
        if parseFailureOffset >= arena.bodyStart && parseFailureOffset < arena.bodyEnd {
            pipelineFailureCode: 1
        } else {
            pipelineFailureCode: 2
        }
