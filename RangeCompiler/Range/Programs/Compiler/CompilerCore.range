                            branchOrdinal: compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: branchSourcePathID)
                            branchSourceEffectPathID: compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: branchSourcePathID, effectPaths: reachability.functionInstanceEffectPaths)
