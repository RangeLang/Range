    let partsFallback: CompilerConstructDeclarationParts(CompilerConstructDeclarationParts(nameToken: fallbackToken, genericRange: fallbackRange, bodyRange: fallbackRange))
    let parts: CompilerConstructDeclarationParts(maybeParts ?? partsFallback)
    let ownerSyntaxID: Int(compilerSyntaxDeclarationSyntaxIDForTypeName(tables: tables, typeName: parts.nameToken.text))
    if builtinPolicy != compilerBuiltinPolicyNone()
        || ownerSyntaxID < 0
        || ownerSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
