function compilerBodyMIRNominalTypeID(typeKind: Int, typeID: Int): Int {
    if typeKind == compilerBodyTypeConstruct() || typeKind == compilerBodyTypeEnum() { return typeID }
    return 0 - 1
}

function compilerBodyArenaMIRTypeIDForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
    let typeKind: Int(compilerBodyArenaTypeKindForSpan(arena: arena, fileID: fileID, start: start, end: end))
    if typeKind != compilerBodyTypeConstruct() && typeKind != compilerBodyTypeEnum() { return 0 - 1 }
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: fileID, start: start, end: end)
}

