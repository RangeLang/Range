function compilerTypedSyntaxCapture(source: String, tables: CompilerSyntaxTables): Int {
    return compilerTypedSyntaxCaptureWithPolicy(source: source, tables: tables, captureBodies: true, captureMain: true)
}

function compilerTypedDeclarationsCapture(source: String, tables: CompilerSyntaxTables): Int {
    return compilerTypedSyntaxCaptureWithPolicy(source: source, tables: tables, captureBodies: false, captureMain: false)
}

function compilerTypedSyntaxCaptureWithPolicy(source: String, tables: CompilerSyntaxTables, captureBodies: Bool, captureMain: Bool): Int {
    if !tables.sourceStore.isValid {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }

    state fileID: Int(0)
    state sourceIndex: Int(0)
    state declarationOrdinal: Int(0)
    state pendingLanguageDeclaration: Bool(false)
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    while fileID < fileCount {
        let fileStart: Int(compilerSourceStoreFileContentStart(store: tables.sourceStore, fileID: fileID))
        let fileEnd: Int(compilerSourceStoreFileContentEnd(store: tables.sourceStore, fileID: fileID))
        sourceIndex: fileStart
        pendingLanguageDeclaration: false
        while sourceIndex < fileEnd {
            let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))
            if maybeToken == nil {
                sourceIndex: fileEnd
            } else {
                let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
                let token: RangeLexedToken(maybeToken ?? fallbackToken)
                if token.start >= fileEnd {
                    sourceIndex: fileEnd
                } else if token.kind == String("macroAttribute") && token.text == String("@language") {
                    pendingLanguageDeclaration: true
                    sourceIndex: token.end
