function compilerTypedIRBuild(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR): Int {
    if !compilerMemoryGraphIsValid(tables: tables, delta: delta, semantics: semantics, memory: memory) {
        compilerTypedIRPoison(ir: ir)
        return 0 - 1
    }
    if compilerTypedIRBuildFunctions(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir) != 0 { return 0 - 1 }
    state typedIRBuildNodeID: Int(0)
    let typedIRBuildNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while typedIRBuildNodeID < typedIRBuildNodeCount {
        if compilerTypedIRBuildNode(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir, nodeID: typedIRBuildNodeID) != 0 {
            compilerTypedIRPoison(ir: ir)
            return 0 - 1
        }
        typedIRBuildNodeID: typedIRBuildNodeID + 1
    }
    return 0
}

function compilerTypedIRDecisionKindForOperation(operationKind: Int): Int {
    if operationKind == compilerTypedIROperationConstruct() { return compilerMemoryDecisionInitialize() }
    if operationKind == compilerTypedIROperationCall() { return compilerMemoryDecisionBorrow() }
    if operationKind == compilerTypedIROperationDestroy() { return compilerMemoryDecisionDestroy() }
    if operationKind == compilerTypedIROperationLocal() { return compilerMemoryDecisionPlacement() }
    if operationKind == compilerTypedIROperationInsertField() { return compilerMemoryDecisionLayout() }
    if operationKind == compilerTypedIROperationNoEscape() { return compilerMemoryDecisionEscape() }
    if operationKind == compilerTypedIROperationConstructValue() { return compilerMemoryDecisionLayout() }
    if operationKind == compilerTypedIROperationTransfer() { return compilerMemoryDecisionTransfer() }
    if operationKind == compilerTypedIROperationCallReceive() { return compilerMemoryDecisionInitialize() }
    if operationKind == compilerTypedIROperationStoragePolicy() { return compilerMemoryDecisionStoragePolicy() }
    if operationKind == compilerTypedIROperationStore() { return compilerMemoryDecisionAccess() }
    return 0 - 1
}

function compilerTypedIRInsertFieldsAreValid(memory: CompilerMemoryGraph, ir: CompilerTypedIR): Bool {
    state typedIRConstructOperationRow: Int(0)
    let typedIRConstructOperationCount: Int(compilerIntTableRowCount(table: ir.operations))
    while typedIRConstructOperationRow < typedIRConstructOperationCount {
        let typedIRConstructOperationKind: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 2))
        if typedIRConstructOperationKind == compilerTypedIROperationConstruct() || typedIRConstructOperationKind == compilerTypedIROperationConstructValue() {
            let typedIRConstructNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 0))
            let typedIRConstructTypeNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 3))
            let typedIRConstructStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 4))
            let typedIRConstructLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIRConstructTypeNodeID))
            if typedIRConstructLayoutRow < 0 { return false }
            let typedIRConstructExpectedFields: Int(compilerIntTableValue(table: memory.layouts, row: typedIRConstructLayoutRow, column: 1))
            state typedIRConstructFieldOrdinal: Int(0)
            while typedIRConstructFieldOrdinal < typedIRConstructExpectedFields {
                state typedIRConstructFieldMatches: Int(0)
                state typedIRConstructCandidateRow: Int(0)
                while typedIRConstructCandidateRow < typedIRConstructOperationCount {
                    if compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 0) == typedIRConstructNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 2) == compilerTypedIROperationInsertField()
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 3) == typedIRConstructTypeNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 4) == typedIRConstructStorageID
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 5) == typedIRConstructFieldOrdinal { typedIRConstructFieldMatches: typedIRConstructFieldMatches + 1 }
                    typedIRConstructCandidateRow: typedIRConstructCandidateRow + 1
                }
                if typedIRConstructFieldMatches != 1 { return false }
                typedIRConstructFieldOrdinal: typedIRConstructFieldOrdinal + 1
            }
            if compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 5) != typedIRConstructExpectedFields { return false }
        }
        typedIRConstructOperationRow: typedIRConstructOperationRow + 1
    }
    state typedIRStoreOperationRow: Int(0)
    while typedIRStoreOperationRow < typedIRConstructOperationCount {
        if compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 2) == compilerTypedIROperationStore() {
            let typedIRStoreValueNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 5))
            let typedIRStoreTypeNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 3))
            let typedIRStoreStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 4))
            let typedIRStoreLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIRStoreTypeNodeID))
            if typedIRStoreLayoutRow < 0 { return false }
            let typedIRStoreExpectedFields: Int(compilerIntTableValue(table: memory.layouts, row: typedIRStoreLayoutRow, column: 1))
            state typedIRStoreFieldOrdinal: Int(0)
            while typedIRStoreFieldOrdinal < typedIRStoreExpectedFields {
                state typedIRStoreFieldMatches: Int(0)
                state typedIRStoreCandidateRow: Int(0)
                while typedIRStoreCandidateRow < typedIRConstructOperationCount {
                    if compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 0) == typedIRStoreValueNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 2) == compilerTypedIROperationInsertField()
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 4) == typedIRStoreStorageID
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 5) == typedIRStoreFieldOrdinal { typedIRStoreFieldMatches: typedIRStoreFieldMatches + 1 }
                    typedIRStoreCandidateRow: typedIRStoreCandidateRow + 1
                }
                if typedIRStoreFieldMatches != 1 { return false }
                typedIRStoreFieldOrdinal: typedIRStoreFieldOrdinal + 1
            }
        }
        typedIRStoreOperationRow: typedIRStoreOperationRow + 1
    }
    return true
}

function compilerTypedIRIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR): Bool {
    if intBufferCount(buffer: ir.failures) != 0
        || !compilerIntTableIsComplete(table: ir.functions)
        || !compilerIntTableIsComplete(table: ir.operations) { return false }
    if compilerIntTableRowCount(table: ir.functions) < 1 { return false }
    state typedIRValidationFunctionRow: Int(0)
    state typedIREntryCount: Int(0)
    while typedIRValidationFunctionRow < compilerIntTableRowCount(table: ir.functions) {
        let typedIRValidationOwnerNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 0))
        let typedIRValidationParameterNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 3))
        let typedIRValidationDecisionRow: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 5))
        let typedIRValidationIsEntry: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 6))
        if typedIRValidationIsEntry == 1 {
            typedIREntryCount: typedIREntryCount + 1
            if compilerIntTableValue(table: delta.nodes, row: typedIRValidationOwnerNodeID, column: 1) != compilerSyntaxKindEntry()
                || typedIRValidationParameterNodeID != 0 - 1 || typedIRValidationDecisionRow != 0 - 1 { return false }
        } else {
            if compilerIntTableValue(table: delta.nodes, row: typedIRValidationOwnerNodeID, column: 1) != compilerSyntaxKindFunction() || typedIRValidationDecisionRow < 0 { return false }
            if typedIRValidationParameterNodeID >= 0 {
                if compilerIntTableValue(table: delta.nodes, row: typedIRValidationParameterNodeID, column: 1) != compilerSyntaxKindParameter()
                    || compilerIntTableValue(table: memory.decisions, row: typedIRValidationDecisionRow, column: 0) != compilerMemoryDecisionPassMode() { return false }
            } else if compilerIntTableValue(table: memory.decisions, row: typedIRValidationDecisionRow, column: 0) != compilerMemoryDecisionReturnMode() { return false }
        }
        typedIRValidationFunctionRow: typedIRValidationFunctionRow + 1
    }
    if typedIREntryCount != 1 { return false }

    state typedIRValidationOperationRow: Int(0)
    state typedIRTerminatorCount: Int(0)
    while typedIRValidationOperationRow < compilerIntTableRowCount(table: ir.operations) {
        let typedIRValidationNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 0))
        let typedIRValidationRegionNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 1))
        let typedIRValidationOperationKind: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 2))
        let typedIRValidationStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 4))
        let typedIRValidationOperationDecisionRow: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 7))
        if typedIRValidationNodeID < 0 || typedIRValidationNodeID >= compilerIntTableRowCount(table: delta.nodes)
            || typedIRValidationRegionNodeID < 0 || typedIRValidationRegionNodeID >= compilerIntTableRowCount(table: delta.nodes) { return false }
        let typedIRRequiredDecisionKind: Int(compilerTypedIRDecisionKindForOperation(operationKind: typedIRValidationOperationKind))
        if typedIRValidationOperationKind == compilerTypedIROperationMemberRead() && typedIRValidationStorageID >= 0 {
            if typedIRValidationOperationDecisionRow < 0
                || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 0) != compilerMemoryDecisionAccess()
                || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 2) != typedIRValidationStorageID { return false }
        } else if typedIRRequiredDecisionKind >= 0 {
            if typedIRValidationOperationDecisionRow < 0
                || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 0) != typedIRRequiredDecisionKind { return false }
            if typedIRRequiredDecisionKind != compilerMemoryDecisionLayout()
                && compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 2) != typedIRValidationStorageID { return false }
            if typedIRValidationOperationKind == compilerTypedIROperationStoragePolicy()
                && compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 5) != compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 4) { return false }
            if typedIRValidationOperationKind == compilerTypedIROperationStore()
                && (compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 1) != typedIRValidationNodeID
                    || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 4) != compilerMemoryAccessWriteUnique()
                    || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 5) != compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 6)) { return false }
        } else if typedIRValidationOperationDecisionRow != 0 - 1 { return false }
        if typedIRValidationOperationKind == compilerTypedIROperationReturn() { typedIRTerminatorCount: typedIRTerminatorCount + 1 }
        typedIRValidationOperationRow: typedIRValidationOperationRow + 1
    }
    return typedIRTerminatorCount == compilerIntTableRowCount(table: ir.functions) && compilerTypedIRInsertFieldsAreValid(memory: memory, ir: ir)
}

function compilerTypedIRRenderSnapshot(ir: CompilerTypedIR): String {
    let typedIRTab: String(compilerCoreTabCharacter())
    let typedIRNewline: String(compilerCoreNewlineCharacter())
    let typedIRFunctions: String(compilerTypedSyntaxRenderRawTable(name: String("typedIRFunction"), table: ir.functions))
    let typedIROperations: String(compilerTypedSyntaxRenderRawTable(name: String("typedIROperation"), table: ir.operations))
    return "typedIR\(typedIRTab)valid=true\(typedIRTab)functionCount=\(compilerIntTableRowCount(table: ir.functions))\(typedIRTab)operationCount=\(compilerIntTableRowCount(table: ir.operations))\(typedIRNewline)\(typedIRFunctions)\(typedIROperations)"
}

function compilerTypedIRSummary(source: String): String {
    let typedIRTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let typedIRCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: typedIRTables))
    let typedIRDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let typedIRSemantics: CompilerSemanticGraph(compilerSemanticGraphCreate())
    let typedIRMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    let typedIRGraph: CompilerTypedIR(compilerTypedIRCreate())
    state typedIRSummaryText: String("")
    if typedIRCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: typedIRTables) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidTypedSyntaxSnapshot"))
    } else if compilerPlotterBuild(tables: typedIRTables, delta: typedIRDelta) != 0 || !compilerGraphDeltaIsValid(tables: typedIRTables, delta: typedIRDelta) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidGraphDelta"))
    } else if compilerSemanticBuild(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics) != 0 || !compilerSemanticGraphIsValid(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidSemanticGraph"))
    } else if compilerMemoryBuild(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory) != 0 || !compilerMemoryGraphIsValid(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidMemoryGraph"))
    } else if compilerTypedIRBuild(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory, ir: typedIRGraph) != 0 {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidTypedIRBuild"))
    } else if !compilerTypedIRIsValid(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory, ir: typedIRGraph) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidTypedIR"))
    } else {
        typedIRSummaryText: compilerTypedIRRenderSnapshot(ir: typedIRGraph)
    }
    let typedIRGraphDestroyStatus: Int(compilerTypedIRDestroy(ir: typedIRGraph))
    let typedIRMemoryDestroyStatus: Int(compilerMemoryGraphDestroy(memory: typedIRMemory))
    let typedIRSemanticsDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: typedIRSemantics))
    let typedIRDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: typedIRDelta))
    let typedIRTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: typedIRTables))
    if typedIRGraphDestroyStatus != 0 || typedIRMemoryDestroyStatus != 0 || typedIRSemanticsDestroyStatus != 0 || typedIRDeltaDestroyStatus != 0 || typedIRTablesDestroyStatus != 0 {
        return compilerNativeDiagnostic(kind: String("typedIROwnershipFailure"))
    }
    return typedIRSummaryText
}

function compilerTypedIROperationRow(ir: CompilerTypedIR, regionNodeID: Int, operationKind: Int, occurrence: Int): Int {
    state typedIRLookupRow: Int(0)
    state typedIRLookupOccurrence: Int(0)
    let typedIRLookupCount: Int(compilerIntTableRowCount(table: ir.operations))
    while typedIRLookupRow < typedIRLookupCount {
        if compilerIntTableValue(table: ir.operations, row: typedIRLookupRow, column: 1) == regionNodeID
            && compilerIntTableValue(table: ir.operations, row: typedIRLookupRow, column: 2) == operationKind {
            if typedIRLookupOccurrence == occurrence { return typedIRLookupRow }
            typedIRLookupOccurrence: typedIRLookupOccurrence + 1
        }
        typedIRLookupRow: typedIRLookupRow + 1
    }
    return 0 - 1
}

function compilerTypedIRIdentityText(value: Int): String {
    if value < 0 { return "n\(0 - value)" }
    return "p\(value)"
}

function compilerTypedIRLLVMAppend(buffer: TextBuffer, text: String): Bool {
    return textBufferAppend(buffer: buffer, text: text) == 0
}

function compilerTypedIRLLVMFixedAggregateType(memory: CompilerMemoryGraph, layoutRow: Int): String {
    let typedIRTypeBuffer: TextBuffer(textBufferCreate(capacity: 128))
    if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String("{ ")) { return String("") }
    state typedIRTypeFieldOrdinal: Int(0)
    let typedIRTypeFieldCount: Int(compilerIntTableValue(table: memory.layouts, row: layoutRow, column: 1))
    while typedIRTypeFieldOrdinal < typedIRTypeFieldCount {
        if typedIRTypeFieldOrdinal > 0 {
            if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String(", ")) { return String("") }
        }
        if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String("i32")) { return String("") }
        typedIRTypeFieldOrdinal: typedIRTypeFieldOrdinal + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String(" }")) { return String("") }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: typedIRTypeBuffer)
}

function compilerTypedIRLLVMTypeName(tables: CompilerSyntaxTables, typeNodeID: Int): String {
    let typedIRTypeDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: typeNodeID))
    if typedIRTypeDeclarationRow < 0 { return String("") }
    let typedIRTypeIdentityFirst: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 11))
    let typedIRTypeIdentitySecond: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 12))
    return "%Range.Fixed.\(compilerTypedIRIdentityText(value: typedIRTypeIdentityFirst)).\(compilerTypedIRIdentityText(value: typedIRTypeIdentitySecond))"
}

function compilerTypedIRFixedLLVMRenderEntry(tables: CompilerSyntaxTables, memory: CompilerMemoryGraph, ir: CompilerTypedIR, entryNodeID: Int): String {
    let typedIREntryNewline: String(compilerCoreNewlineCharacter())
    let typedIREntryBuffer: TextBuffer(textBufferCreate(capacity: 8192))
    state typedIREntryLayoutRow: Int(0)
    let typedIREntryLayoutCount: Int(compilerIntTableRowCount(table: memory.layouts))
    while typedIREntryLayoutRow < typedIREntryLayoutCount {
        let typedIREntryTypeNodeID: Int(compilerIntTableValue(table: memory.layouts, row: typedIREntryLayoutRow, column: 0))
        let typedIREntryTypeName: String(compilerTypedIRLLVMTypeName(tables: tables, typeNodeID: typedIREntryTypeNodeID))
        if typedIREntryTypeName == String("")
            || !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "\(typedIREntryTypeName) = type \(compilerTypedIRLLVMFixedAggregateType(memory: memory, layoutRow: typedIREntryLayoutRow))\(typedIREntryNewline)") {
            textBufferDestroy(buffer: typedIREntryBuffer)
            return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMType"))
        }
        typedIREntryLayoutRow: typedIREntryLayoutRow + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "\(typedIREntryNewline)define i32 @main() {\(typedIREntryNewline)entry:\(typedIREntryNewline)") {
        textBufferDestroy(buffer: typedIREntryBuffer)
        return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure"))
    }
    state typedIREntryStorageRow: Int(0)
    let typedIREntryStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    while typedIREntryStorageRow < typedIREntryStorageCount {
        let typedIREntryStorageTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: typedIREntryStorageRow, column: 2))
        let typedIREntryStorageLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIREntryStorageTypeNodeID))
        let typedIREntryStorageTypeName: String(compilerTypedIRLLVMTypeName(tables: tables, typeNodeID: typedIREntryStorageTypeNodeID))
        if typedIREntryStorageLayoutRow < 0 || typedIREntryStorageTypeName == String("")
            || !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  %storage\(typedIREntryStorageRow) = alloca \(typedIREntryStorageTypeName), align \(compilerIntTableValue(table: memory.layouts, row: typedIREntryStorageLayoutRow, column: 3))\(typedIREntryNewline)") {
            textBufferDestroy(buffer: typedIREntryBuffer)
            return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMStorage"))
        }
        typedIREntryStorageRow: typedIREntryStorageRow + 1
    }
    state typedIREntryOperationRow: Int(0)
    let typedIREntryOperationCount: Int(compilerIntTableRowCount(table: ir.operations))
    while typedIREntryOperationRow < typedIREntryOperationCount {
        if compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 1) == entryNodeID {
            let typedIREntryOperationNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 0))
            let typedIREntryOperationKind: Int(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 2))
            let typedIREntryOperationStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 4))
            if typedIREntryOperationKind == compilerTypedIROperationConstruct() || typedIREntryOperationKind == compilerTypedIROperationStore() {
                let typedIREntryOperationTypeNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 3))
                let typedIREntryOperationLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIREntryOperationTypeNodeID))
                let typedIREntryOperationTypeName: String(compilerTypedIRLLVMTypeName(tables: tables, typeNodeID: typedIREntryOperationTypeNodeID))
                let typedIREntryOperationValueNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 5))
                state typedIREntryFieldNodeID: Int(typedIREntryOperationNodeID)
                state typedIREntryAggregatePrefix: String("aggregate")
                if typedIREntryOperationKind == compilerTypedIROperationStore() {
                    typedIREntryFieldNodeID: typedIREntryOperationValueNodeID
                    typedIREntryAggregatePrefix: String("updated")
                }
                state typedIREntryFieldIndex: Int(0)
                state typedIREntryAggregateOperand: String("poison")
                state typedIREntryFieldRow: Int(0)
                while typedIREntryFieldRow < typedIREntryOperationCount {
                    if compilerIntTableValue(table: ir.operations, row: typedIREntryFieldRow, column: 0) == typedIREntryFieldNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIREntryFieldRow, column: 2) == compilerTypedIROperationInsertField() {
                        let typedIREntryAggregateResult: String("%\(typedIREntryAggregatePrefix)\(typedIREntryOperationNodeID)_\(typedIREntryFieldIndex)")
                        if !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  \(typedIREntryAggregateResult) = insertvalue \(typedIREntryOperationTypeName) \(typedIREntryAggregateOperand), i32 \(compilerIntTableValue(table: ir.operations, row: typedIREntryFieldRow, column: 6)), \(compilerIntTableValue(table: ir.operations, row: typedIREntryFieldRow, column: 5))\(typedIREntryNewline)") {
                            textBufferDestroy(buffer: typedIREntryBuffer)
                            return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure"))
                        }
                        typedIREntryAggregateOperand: typedIREntryAggregateResult
                        typedIREntryFieldIndex: typedIREntryFieldIndex + 1
                    }
                    typedIREntryFieldRow: typedIREntryFieldRow + 1
                }
                if typedIREntryOperationLayoutRow < 0 || typedIREntryOperationTypeName == String("")
                    || typedIREntryFieldIndex != compilerIntTableValue(table: memory.layouts, row: typedIREntryOperationLayoutRow, column: 1)
                    || !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  store \(typedIREntryOperationTypeName) \(typedIREntryAggregateOperand), ptr %storage\(typedIREntryOperationStorageID), align \(compilerIntTableValue(table: memory.layouts, row: typedIREntryOperationLayoutRow, column: 3))\(typedIREntryNewline)") {
                    textBufferDestroy(buffer: typedIREntryBuffer)
                    return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMStore"))
                }
            } else if typedIREntryOperationKind == compilerTypedIROperationMemberRead() {
                let typedIREntryReadTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: typedIREntryOperationStorageID, column: 2))
                let typedIREntryReadLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIREntryReadTypeNodeID))
                let typedIREntryReadTypeName: String(compilerTypedIRLLVMTypeName(tables: tables, typeNodeID: typedIREntryReadTypeNodeID))
                if typedIREntryReadLayoutRow < 0 || typedIREntryReadTypeName == String("")
                    || !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  %borrow\(typedIREntryOperationNodeID) = load \(typedIREntryReadTypeName), ptr %storage\(typedIREntryOperationStorageID), align \(compilerIntTableValue(table: memory.layouts, row: typedIREntryReadLayoutRow, column: 3))\(typedIREntryNewline)  %value\(typedIREntryOperationNodeID) = extractvalue \(typedIREntryReadTypeName) %borrow\(typedIREntryOperationNodeID), \(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 6))\(typedIREntryNewline)") {
                    textBufferDestroy(buffer: typedIREntryBuffer)
                    return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMRead"))
                }
            } else if typedIREntryOperationKind == compilerTypedIROperationAddition() {
                if !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  %value\(typedIREntryOperationNodeID) = add i32 %value\(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 5)), %value\(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 6))\(typedIREntryNewline)") {
                    textBufferDestroy(buffer: typedIREntryBuffer)
                    return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure"))
                }
            } else if typedIREntryOperationKind == compilerTypedIROperationReturn() {
                if !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  ret i32 %value\(compilerIntTableValue(table: ir.operations, row: typedIREntryOperationRow, column: 5))\(typedIREntryNewline)") {
                    textBufferDestroy(buffer: typedIREntryBuffer)
                    return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure"))
                }
            }
        }
        typedIREntryOperationRow: typedIREntryOperationRow + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "}\(typedIREntryNewline)") {
        textBufferDestroy(buffer: typedIREntryBuffer)
        return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure"))
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: typedIREntryBuffer)
}

function compilerTypedIRFunctionRowForOwner(ir: CompilerTypedIR, ownerNodeID: Int): Int {
    state typedIRFunctionLookupRow: Int(0)
    let typedIRFunctionLookupCount: Int(compilerIntTableRowCount(table: ir.functions))
    while typedIRFunctionLookupRow < typedIRFunctionLookupCount {
        if compilerIntTableValue(table: ir.functions, row: typedIRFunctionLookupRow, column: 0) == ownerNodeID { return typedIRFunctionLookupRow }
        typedIRFunctionLookupRow: typedIRFunctionLookupRow + 1
    }
    return 0 - 1
}

function compilerTypedIRFunctionName(ir: CompilerTypedIR, functionRow: Int): String {
    return "@range_fn_\(compilerTypedIRIdentityText(value: compilerIntTableValue(table: ir.functions, row: functionRow, column: 1)))_\(compilerTypedIRIdentityText(value: compilerIntTableValue(table: ir.functions, row: functionRow, column: 2)))"
}

function compilerTypedIRFixedLLVMRenderReturned(tables: CompilerSyntaxTables, memory: CompilerMemoryGraph, ir: CompilerTypedIR, entryNodeID: Int, typeName: String, layoutRow: Int): String {
    if compilerTypedIROperationRow(ir: ir, regionNodeID: entryNodeID, operationKind: compilerTypedIROperationCallReceive(), occurrence: 0) < 0
        || compilerTypedIROperationRow(ir: ir, regionNodeID: entryNodeID, operationKind: compilerTypedIROperationTransfer(), occurrence: 0) < 0
        || compilerTypedIROperationRow(ir: ir, regionNodeID: entryNodeID, operationKind: compilerTypedIROperationDestroy(), occurrence: 0) < 0 { return compilerNativeDiagnostic(kind: String("invalidReturnedTypedIRLLVMOperations")) }
    let typedIRReturnedNewline: String(compilerCoreNewlineCharacter())
    let typedIRReturnedAlignment: Int(compilerIntTableValue(table: memory.layouts, row: layoutRow, column: 3))
    let typedIRReturnedBuffer: TextBuffer(textBufferCreate(capacity: 4096))
    if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "\(typeName) = type \(compilerTypedIRLLVMFixedAggregateType(memory: memory, layoutRow: layoutRow))\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
    state typedIRReturnedOperationRow: Int(0)
    let typedIRReturnedOperationCount: Int(compilerIntTableRowCount(table: ir.operations))
    state typedIRReturnedFunctionRow: Int(0)
    while typedIRReturnedFunctionRow < compilerIntTableRowCount(table: ir.functions) {
        if compilerIntTableValue(table: ir.functions, row: typedIRReturnedFunctionRow, column: 6) == 0 {
            let typedIRReturnedHelperNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRReturnedFunctionRow, column: 0))
            if compilerIntTableValue(table: ir.functions, row: typedIRReturnedFunctionRow, column: 3) >= 0
                || compilerIntTableValue(table: ir.functions, row: typedIRReturnedFunctionRow, column: 4) != compilerIntTableValue(table: memory.layouts, row: layoutRow, column: 0)
                || compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRReturnedHelperNodeID, operationKind: compilerTypedIROperationConstructValue(), occurrence: 0) < 0
                || compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRReturnedHelperNodeID, operationKind: compilerTypedIROperationTransfer(), occurrence: 0) >= 0
                || compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRReturnedHelperNodeID, operationKind: compilerTypedIROperationDestroy(), occurrence: 0) >= 0 {
                textBufferDestroy(buffer: typedIRReturnedBuffer)
                return compilerNativeDiagnostic(kind: String("invalidReturnedTypedIRLLVMFunction"))
            }
            if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "\(typedIRReturnedNewline)define \(typeName) \(compilerTypedIRFunctionName(ir: ir, functionRow: typedIRReturnedFunctionRow))() {\(typedIRReturnedNewline)entry:\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
            state typedIRReturnedAggregateIndex: Int(0)
            state typedIRReturnedAggregateOperand: String("poison")
            typedIRReturnedOperationRow: 0
            while typedIRReturnedOperationRow < typedIRReturnedOperationCount {
                if compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 1) == typedIRReturnedHelperNodeID
                    && compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 2) == compilerTypedIROperationInsertField() {
                    let typedIRReturnedAggregateResult: String("%aggregate\(typedIRReturnedAggregateIndex)")
                    if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  \(typedIRReturnedAggregateResult) = insertvalue \(typeName) \(typedIRReturnedAggregateOperand), i32 \(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 6)), \(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 5))\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
                    typedIRReturnedAggregateOperand: typedIRReturnedAggregateResult
                    typedIRReturnedAggregateIndex: typedIRReturnedAggregateIndex + 1
                }
                typedIRReturnedOperationRow: typedIRReturnedOperationRow + 1
            }
            if typedIRReturnedAggregateIndex != compilerIntTableValue(table: memory.layouts, row: layoutRow, column: 1) {
                textBufferDestroy(buffer: typedIRReturnedBuffer)
                return compilerNativeDiagnostic(kind: String("invalidReturnedTypedIRLLVMFields"))
            }
            if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  ret \(typeName) \(typedIRReturnedAggregateOperand)\(typedIRReturnedNewline)}\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
        }
        typedIRReturnedFunctionRow: typedIRReturnedFunctionRow + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "\(typedIRReturnedNewline)define i32 @main() {\(typedIRReturnedNewline)entry:\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
    state typedIRReturnedStorageRow: Int(0)
    while typedIRReturnedStorageRow < compilerIntTableRowCount(table: memory.storages) {
        if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  %storage\(typedIRReturnedStorageRow) = alloca \(typeName), align \(typedIRReturnedAlignment)\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
        typedIRReturnedStorageRow: typedIRReturnedStorageRow + 1
    }
    typedIRReturnedOperationRow: 0
    while typedIRReturnedOperationRow < typedIRReturnedOperationCount {
        if compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 1) == entryNodeID {
            let typedIRReturnedOperationKind: Int(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 2))
            let typedIRReturnedNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 0))
            let typedIRReturnedStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 4))
            if typedIRReturnedOperationKind == compilerTypedIROperationCallReceive() {
                let typedIRReturnedCallFunctionRow: Int(compilerTypedIRFunctionRowForOwner(ir: ir, ownerNodeID: compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 5)))
                if typedIRReturnedCallFunctionRow < 0 {
                    textBufferDestroy(buffer: typedIRReturnedBuffer)
                    return compilerNativeDiagnostic(kind: String("invalidReturnedTypedIRLLVMCall"))
                }
                if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  %received\(typedIRReturnedNodeID) = call \(typeName) \(compilerTypedIRFunctionName(ir: ir, functionRow: typedIRReturnedCallFunctionRow))()\(typedIRReturnedNewline)  store \(typeName) %received\(typedIRReturnedNodeID), ptr %storage\(typedIRReturnedStorageID), align \(typedIRReturnedAlignment)\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
            } else if typedIRReturnedOperationKind == compilerTypedIROperationStore() {
                let typedIRStoreValueNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 5))
                state typedIRStoreAggregateIndex: Int(0)
                state typedIRStoreAggregateOperand: String("poison")
                state typedIRStoreFieldRow: Int(0)
                while typedIRStoreFieldRow < typedIRReturnedOperationCount {
                    if compilerIntTableValue(table: ir.operations, row: typedIRStoreFieldRow, column: 0) == typedIRStoreValueNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreFieldRow, column: 2) == compilerTypedIROperationInsertField() {
                        let typedIRStoreAggregateResult: String("%updated\(typedIRReturnedNodeID)_\(typedIRStoreAggregateIndex)")
                        if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  \(typedIRStoreAggregateResult) = insertvalue \(typeName) \(typedIRStoreAggregateOperand), i32 \(compilerIntTableValue(table: ir.operations, row: typedIRStoreFieldRow, column: 6)), \(compilerIntTableValue(table: ir.operations, row: typedIRStoreFieldRow, column: 5))\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
                        typedIRStoreAggregateOperand: typedIRStoreAggregateResult
                        typedIRStoreAggregateIndex: typedIRStoreAggregateIndex + 1
                    }
                    typedIRStoreFieldRow: typedIRStoreFieldRow + 1
                }
                if typedIRStoreAggregateIndex != compilerIntTableValue(table: memory.layouts, row: layoutRow, column: 1) {
                    textBufferDestroy(buffer: typedIRReturnedBuffer)
                    return compilerNativeDiagnostic(kind: String("invalidReturnedTypedIRLLVMStore"))
                }
                if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  store \(typeName) \(typedIRStoreAggregateOperand), ptr %storage\(typedIRReturnedStorageID), align \(typedIRReturnedAlignment)\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
            } else if typedIRReturnedOperationKind == compilerTypedIROperationMemberRead() {
                if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  %borrow\(typedIRReturnedNodeID) = load \(typeName), ptr %storage\(typedIRReturnedStorageID), align \(typedIRReturnedAlignment)\(typedIRReturnedNewline)  %value\(typedIRReturnedNodeID) = extractvalue \(typeName) %borrow\(typedIRReturnedNodeID), \(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 6))\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
            } else if typedIRReturnedOperationKind == compilerTypedIROperationAddition() {
                if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  %value\(typedIRReturnedNodeID) = add i32 %value\(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 5)), %value\(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 6))\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
            } else if typedIRReturnedOperationKind == compilerTypedIROperationReturn() {
                if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "  ret i32 %value\(compilerIntTableValue(table: ir.operations, row: typedIRReturnedOperationRow, column: 5))\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
            }
        }
        typedIRReturnedOperationRow: typedIRReturnedOperationRow + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIRReturnedBuffer, text: "}\(typedIRReturnedNewline)") { return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure")) }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: typedIRReturnedBuffer)
}

function compilerTypedIRFixedLLVMRender(tables: CompilerSyntaxTables, memory: CompilerMemoryGraph, ir: CompilerTypedIR): String {
    state typedIRHelperFunctionRow: Int(0 - 1)
    state typedIREntryFunctionRow: Int(0 - 1)
    state typedIRRenderFunctionRow: Int(0)
    while typedIRRenderFunctionRow < compilerIntTableRowCount(table: ir.functions) {
        if compilerIntTableValue(table: ir.functions, row: typedIRRenderFunctionRow, column: 6) == 1 {
            typedIREntryFunctionRow: typedIRRenderFunctionRow
        } else {
            typedIRHelperFunctionRow: typedIRRenderFunctionRow
        }
        typedIRRenderFunctionRow: typedIRRenderFunctionRow + 1
    }
    if typedIREntryFunctionRow < 0 { return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMFunctions")) }
    let typedIREntryNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIREntryFunctionRow, column: 0))
    if typedIRHelperFunctionRow < 0 {
        return compilerTypedIRFixedLLVMRenderEntry(tables: tables, memory: memory, ir: ir, entryNodeID: typedIREntryNodeID)
    }
    let typedIRHelperNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 0))
    let typedIRTypeNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 4))
    let typedIRTypeDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: typedIRTypeNodeID))
    if typedIRTypeDeclarationRow < 0 { return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMType")) }
    let typedIRTypeIdentityFirst: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 11))
    let typedIRTypeIdentitySecond: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 12))
    let typedIRTypeName: String("%Range.Fixed.\(compilerTypedIRIdentityText(value: typedIRTypeIdentityFirst)).\(compilerTypedIRIdentityText(value: typedIRTypeIdentitySecond))")
    let typedIRFunctionName: String("@range_fn_\(compilerTypedIRIdentityText(value: compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 1)))_\(compilerTypedIRIdentityText(value: compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 2)))")
    let typedIRLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIRTypeNodeID))
    if typedIRLayoutRow < 0 || compilerIntTableValue(table: memory.layouts, row: typedIRLayoutRow, column: 1) <= 0 { return compilerNativeDiagnostic(kind: String("unsupportedTypedIRLLVMLayout")) }
    if compilerIntTableValue(table: ir.functions, row: typedIRHelperFunctionRow, column: 3) < 0 {
        return compilerTypedIRFixedLLVMRenderReturned(tables: tables, memory: memory, ir: ir, entryNodeID: typedIREntryNodeID, typeName: typedIRTypeName, layoutRow: typedIRLayoutRow)
    }
    if compilerIntTableValue(table: memory.layouts, row: typedIRLayoutRow, column: 1) != 2 { return compilerNativeDiagnostic(kind: String("unsupportedTypedIRLLVMParameterLayout")) }
    let typedIRFirstReadRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRHelperNodeID, operationKind: compilerTypedIROperationMemberRead(), occurrence: 0))
    let typedIRSecondReadRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRHelperNodeID, operationKind: compilerTypedIROperationMemberRead(), occurrence: 1))
    let typedIRAddRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRHelperNodeID, operationKind: compilerTypedIROperationAddition(), occurrence: 0))
    let typedIRFirstInsertRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationInsertField(), occurrence: 0))
    let typedIRSecondInsertRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationInsertField(), occurrence: 1))
    let typedIRCallRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationCall(), occurrence: 0))
    let typedIRDestroyRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationDestroy(), occurrence: 0))
    if typedIRFirstReadRow < 0 || typedIRSecondReadRow < 0 || typedIRAddRow < 0 || typedIRFirstInsertRow < 0 || typedIRSecondInsertRow < 0 || typedIRCallRow < 0 || typedIRDestroyRow < 0 {
        return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMOperations"))
    }
    let typedIRFirstReadNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRFirstReadRow, column: 0))
    let typedIRSecondReadNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRSecondReadRow, column: 0))
    let typedIRAddNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRAddRow, column: 0))
    let typedIRCallNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRCallRow, column: 0))
    let typedIRFirstFieldOrdinal: Int(compilerIntTableValue(table: ir.operations, row: typedIRFirstReadRow, column: 6))
    let typedIRSecondFieldOrdinal: Int(compilerIntTableValue(table: ir.operations, row: typedIRSecondReadRow, column: 6))
    let typedIRFirstInsertOrdinal: Int(compilerIntTableValue(table: ir.operations, row: typedIRFirstInsertRow, column: 5))
    let typedIRSecondInsertOrdinal: Int(compilerIntTableValue(table: ir.operations, row: typedIRSecondInsertRow, column: 5))
    let typedIRFirstInsertValue: Int(compilerIntTableValue(table: ir.operations, row: typedIRFirstInsertRow, column: 6))
    let typedIRSecondInsertValue: Int(compilerIntTableValue(table: ir.operations, row: typedIRSecondInsertRow, column: 6))
    let typedIRAlignment: Int(compilerIntTableValue(table: memory.layouts, row: typedIRLayoutRow, column: 3))
    let typedIRLLVMNewline: String(compilerCoreNewlineCharacter())
    return "\(typedIRTypeName) = type { i32, i32 }\(typedIRLLVMNewline)\(typedIRLLVMNewline)define i32 \(typedIRFunctionName)(\(typedIRTypeName) %argument) {\(typedIRLLVMNewline)entry:\(typedIRLLVMNewline)  %value\(typedIRFirstReadNodeID) = extractvalue \(typedIRTypeName) %argument, \(typedIRFirstFieldOrdinal)\(typedIRLLVMNewline)  %value\(typedIRSecondReadNodeID) = extractvalue \(typedIRTypeName) %argument, \(typedIRSecondFieldOrdinal)\(typedIRLLVMNewline)  %value\(typedIRAddNodeID) = add i32 %value\(typedIRFirstReadNodeID), %value\(typedIRSecondReadNodeID)\(typedIRLLVMNewline)  ret i32 %value\(typedIRAddNodeID)\(typedIRLLVMNewline)}\(typedIRLLVMNewline)\(typedIRLLVMNewline)define i32 @main() {\(typedIRLLVMNewline)entry:\(typedIRLLVMNewline)  %storage0 = alloca \(typedIRTypeName), align \(typedIRAlignment)\(typedIRLLVMNewline)  %aggregate0 = insertvalue \(typedIRTypeName) poison, i32 \(typedIRFirstInsertValue), \(typedIRFirstInsertOrdinal)\(typedIRLLVMNewline)  %aggregate1 = insertvalue \(typedIRTypeName) %aggregate0, i32 \(typedIRSecondInsertValue), \(typedIRSecondInsertOrdinal)\(typedIRLLVMNewline)  store \(typedIRTypeName) %aggregate1, ptr %storage0, align \(typedIRAlignment)\(typedIRLLVMNewline)  %borrow0 = load \(typedIRTypeName), ptr %storage0, align \(typedIRAlignment)\(typedIRLLVMNewline)  %value\(typedIRCallNodeID) = call i32 \(typedIRFunctionName)(\(typedIRTypeName) %borrow0)\(typedIRLLVMNewline)  ret i32 %value\(typedIRCallNodeID)\(typedIRLLVMNewline)}\(typedIRLLVMNewline)"
}

function compilerTypedIRProofCandidate(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Bool {
    state typedIRCandidateConstructCount: Int(0)
    state typedIRCandidateNodeID: Int(0)
    let typedIRCandidateNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while typedIRCandidateNodeID < typedIRCandidateNodeCount {
        let typedIRCandidateNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: typedIRCandidateNodeID, column: 1))
        if typedIRCandidateNodeKind == compilerSyntaxKindConstruct() { typedIRCandidateConstructCount: typedIRCandidateConstructCount + 1 }
        typedIRCandidateNodeID: typedIRCandidateNodeID + 1
    }
    return typedIRCandidateConstructCount > 0
}

function compilerTypedIRFixedLLVMTextWithPolicy(source: String, unsupportedIsEmpty: Bool): String {
    let typedIRLLVMTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let typedIRLLVMCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: typedIRLLVMTables))
    let typedIRLLVMDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let typedIRLLVMSemantics: CompilerSemanticGraph(compilerSemanticGraphCreate())
    let typedIRLLVMMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    let typedIRLLVMGraph: CompilerTypedIR(compilerTypedIRCreate())
    state typedIRLLVMText: String("")
    if typedIRLLVMCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: typedIRLLVMTables) {
        if unsupportedIsEmpty {
            typedIRLLVMText: String("")
        } else {
            typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidTypedSyntaxSnapshot"))
        }
    } else if compilerPlotterBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta) != 0 || !compilerGraphDeltaIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidGraphDelta"))
    } else if compilerSemanticBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) != 0 || !compilerSemanticGraphIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) {
        if unsupportedIsEmpty {
            typedIRLLVMText: String("")
        } else {
            typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidSemanticGraph"))
        }
    } else if unsupportedIsEmpty && !compilerTypedIRProofCandidate(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) {
        typedIRLLVMText: String("")
    } else if compilerMemoryBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory) != 0 || !compilerMemoryGraphIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidMemoryGraph"))
    } else if compilerTypedIRBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph) != 0 || !compilerTypedIRIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidTypedIR"))
    } else {
        typedIRLLVMText: compilerTypedIRFixedLLVMRender(tables: typedIRLLVMTables, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph)
    }
    let typedIRLLVMGraphDestroyStatus: Int(compilerTypedIRDestroy(ir: typedIRLLVMGraph))
    let typedIRLLVMMemoryDestroyStatus: Int(compilerMemoryGraphDestroy(memory: typedIRLLVMMemory))
    let typedIRLLVMSemanticsDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: typedIRLLVMSemantics))
    let typedIRLLVMDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: typedIRLLVMDelta))
    let typedIRLLVMTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: typedIRLLVMTables))
    if typedIRLLVMGraphDestroyStatus != 0 || typedIRLLVMMemoryDestroyStatus != 0 || typedIRLLVMSemanticsDestroyStatus != 0 || typedIRLLVMDeltaDestroyStatus != 0 || typedIRLLVMTablesDestroyStatus != 0 {
        return compilerNativeDiagnostic(kind: String("typedIRLLVMOwnershipFailure"))
    }
    return typedIRLLVMText
}

function compilerTypedIRFixedLLVMText(source: String): String {
    return compilerTypedIRFixedLLVMTextWithPolicy(source: source, unsupportedIsEmpty: false)
}

function compilerTypedIRFixedLLVMIfSupported(source: String): String {
    return compilerTypedIRFixedLLVMTextWithPolicy(source: source, unsupportedIsEmpty: true)
}

function compilerTypedSyntaxLocalText(tables: CompilerSyntaxTables, fileID: Int, localStart: Int, localEnd: Int): String {
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localStart))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localEnd))
    if globalStart < 0 || globalEnd < globalStart
        || fileID < 0 || fileID >= compilerSourceStoreFileCount(store: tables.sourceStore)
        || globalEnd > compilerSourceStoreFileContentEnd(store: tables.sourceStore, fileID: fileID) {
        return String("")
    }
    return stringSliceUnchecked(source: tables.sourceStore.source, start: globalStart, end: globalEnd)
}

function compilerTypedSyntaxRenderRawTable(name: String, table: CompilerIntTable): String {
    let rawOutputBuffer: TextBuffer(textBufferCreate(capacity: 2048))
    let rawTab: String(compilerCoreTabCharacter())
    let rawNewline: String(compilerCoreNewlineCharacter())
    let rawRowCount: Int(compilerIntTableRowCount(table: table))
    textBufferAppend(buffer: rawOutputBuffer, text: "typedTable\(rawTab)name=\(name)\(rawTab)version=1\(rawTab)columns=\(table.columnCount)\(rawTab)rows=\(rawRowCount)\(rawNewline)")
    state rawRow: Int(0)
    while rawRow < rawRowCount {
        textBufferAppend(buffer: rawOutputBuffer, text: "\(name)\(rawTab)row=\(rawRow)\(rawTab)values=")
        state rawColumn: Int(0)
        while rawColumn < table.columnCount {
            if rawColumn > 0 { textBufferAppend(buffer: rawOutputBuffer, text: String(",")) }
            textBufferAppend(buffer: rawOutputBuffer, text: "\(compilerIntTableValue(table: table, row: rawRow, column: rawColumn))")
            rawColumn: rawColumn + 1
        }
        textBufferAppend(buffer: rawOutputBuffer, text: rawNewline)
        rawRow: rawRow + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: rawOutputBuffer)
}

function compilerTypedSyntaxRenderSnapshot(tables: CompilerSyntaxTables): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 8192))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    let memberCount: Int(compilerIntTableRowCount(table: tables.members))
    let functionCount: Int(compilerIntTableRowCount(table: tables.functions))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
    let bodyNodeCount: Int(compilerIntTableRowCount(table: tables.bodyNodes))
    let bodyEdgeCount: Int(compilerIntTableRowCount(table: tables.bodyEdges))
    textBufferAppend(buffer: outputBuffer, text: "typedSyntax\(tab)valid=true\(tab)identityScope=pathStable,pathlessSnapshotLocal\(tab)fileCount=\(compilerSourceStoreFileCount(store: tables.sourceStore))\(tab)syntaxCount=\(syntaxCount)\(tab)declarationCount=\(declarationCount)\(tab)memberCount=\(memberCount)\(tab)functionCount=\(functionCount)\(tab)parameterCount=\(parameterCount)\(tab)bodyNodeCount=\(bodyNodeCount)\(tab)bodyEdgeCount=\(bodyEdgeCount)\(newline)")

    state row: Int(0)
    while row < syntaxCount {
        let syntaxKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: row, column: 0))
        let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: row, column: 1))
        textBufferAppend(buffer: outputBuffer, text: "syntax\(tab)id=\(row)\(tab)kind=\(compilerSyntaxKindName(kindTag: syntaxKindTag))\(tab)facetRow=\(facetRow)\(newline)")
        row: row + 1
    }

    row: 0
    while row < declarationCount {
        let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 0))
        let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
        let declarationKindTag: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 2))
        let declarationOrdinal: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 4))
        let declarationStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 5))
        let declarationEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 6))
        let declarationNameStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 7))
        let declarationNameEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 8))
        let declarationBodyStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 9))
        let declarationBodyEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 10))
        let declarationFingerprintFirst: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 11))
        let declarationFingerprintSecond: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 12))
        let declarationLanguageABI: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 13))
        let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: declarationNameStart, localEnd: declarationNameEnd))
        textBufferAppend(buffer: outputBuffer, text: "declaration\(tab)row=\(row)\(tab)syntaxID=\(declarationSyntaxID)\(tab)fileID=\(declarationFileID)\(tab)kind=\(compilerSyntaxKindName(kindTag: declarationKindTag))\(tab)ordinal=\(declarationOrdinal)\(tab)start=\(declarationStart)\(tab)end=\(declarationEnd)\(tab)name=\(declarationName)\(tab)nameStart=\(declarationNameStart)\(tab)nameEnd=\(declarationNameEnd)\(tab)bodyStart=\(declarationBodyStart)\(tab)bodyEnd=\(declarationBodyEnd)\(tab)fingerprint=\(declarationFingerprintFirst):\(declarationFingerprintSecond)\(tab)languageABI=\(declarationLanguageABI)\(newline)")
        row: row + 1
    }

    row: 0
    while row < memberCount {
        let memberSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 0))
        let memberFileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 2))
        let memberOrdinal: Int(compilerIntTableValue(table: tables.members, row: row, column: 3))
        let memberStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 4))
        let memberEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 5))
        let memberNameStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 6))
        let memberNameEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 7))
        let memberTypeStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 8))
        let memberTypeEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 9))
        let memberFingerprintFirst: Int(compilerIntTableValue(table: tables.members, row: row, column: 10))
        let memberFingerprintSecond: Int(compilerIntTableValue(table: tables.members, row: row, column: 11))
        let memberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberNameStart, localEnd: memberNameEnd))
        let memberTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberTypeStart, localEnd: memberTypeEnd))
        textBufferAppend(buffer: outputBuffer, text: "member\(tab)row=\(row)\(tab)syntaxID=\(memberSyntaxID)\(tab)fileID=\(memberFileID)\(tab)parentSyntaxID=\(parentSyntaxID)\(tab)ordinal=\(memberOrdinal)\(tab)start=\(memberStart)\(tab)end=\(memberEnd)\(tab)name=\(memberName)\(tab)nameStart=\(memberNameStart)\(tab)nameEnd=\(memberNameEnd)\(tab)type=\(memberTypeName)\(tab)typeStart=\(memberTypeStart)\(tab)typeEnd=\(memberTypeEnd)\(tab)fingerprint=\(memberFingerprintFirst):\(memberFingerprintSecond)\(newline)")
        row: row + 1
    }

    row: 0
    while row < functionCount {
        let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 0))
        let functionFileID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 1))
        let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: row, column: 2))
        let childCount: Int(compilerIntTableValue(table: tables.functions, row: row, column: 3))
        let parameterStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 4))
        let parameterEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 5))
        let returnStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 6))
        let returnEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 7))
        let functionBodyStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 8))
        let functionBodyEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 9))
        let signatureFirst: Int(compilerIntTableValue(table: tables.functions, row: row, column: 10))
        let signatureSecond: Int(compilerIntTableValue(table: tables.functions, row: row, column: 11))
        textBufferAppend(buffer: outputBuffer, text: "function\(tab)row=\(row)\(tab)syntaxID=\(functionSyntaxID)\(tab)fileID=\(functionFileID)\(tab)firstParameterRow=\(firstParameterRow)\(tab)parameterCount=\(childCount)\(tab)parameterStart=\(parameterStart)\(tab)parameterEnd=\(parameterEnd)\(tab)returnStart=\(returnStart)\(tab)returnEnd=\(returnEnd)\(tab)bodyStart=\(functionBodyStart)\(tab)bodyEnd=\(functionBodyEnd)\(tab)signature=\(signatureFirst):\(signatureSecond)\(newline)")
        row: row + 1
    }

    row: 0
    while row < parameterCount {
        let parameterSyntaxID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 0))
        let parameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 1))
        let functionID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 2))
        let parameterOrdinal: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 3))
        let parameterValueStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 4))
        let parameterValueEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 5))
        let parameterNameStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 6))
        let parameterNameEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 7))
        let parameterTypeStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 8))
        let parameterTypeEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 9))
        let parameterFingerprintFirst: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 10))
        let parameterFingerprintSecond: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 11))
        let parameterName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: parameterNameStart, localEnd: parameterNameEnd))
        let parameterTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: parameterTypeStart, localEnd: parameterTypeEnd))
        textBufferAppend(buffer: outputBuffer, text: "parameter\(tab)row=\(row)\(tab)syntaxID=\(parameterSyntaxID)\(tab)fileID=\(parameterFileID)\(tab)functionID=\(functionID)\(tab)ordinal=\(parameterOrdinal)\(tab)start=\(parameterValueStart)\(tab)end=\(parameterValueEnd)\(tab)name=\(parameterName)\(tab)nameStart=\(parameterNameStart)\(tab)nameEnd=\(parameterNameEnd)\(tab)type=\(parameterTypeName)\(tab)typeStart=\(parameterTypeStart)\(tab)typeEnd=\(parameterTypeEnd)\(tab)fingerprint=\(parameterFingerprintFirst):\(parameterFingerprintSecond)\(newline)")
        row: row + 1
    }
    textBufferAppend(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("bodyNode"), table: tables.bodyNodes))
    textBufferAppend(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("bodyEdge"), table: tables.bodyEdges))
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerTypedSyntaxSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: tables))
    let typedSyntaxTab: String(compilerCoreTabCharacter())
    let typedSyntaxNewline: String(compilerCoreNewlineCharacter())
    state summary: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        summary: "compilerError\(typedSyntaxTab)kind=invalidTypedSyntaxSnapshot\(typedSyntaxNewline)"
    } else {
        summary: compilerTypedSyntaxRenderSnapshot(tables: tables)
    }
    let destroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if destroyStatus != 0 {
        return "compilerError\(typedSyntaxTab)kind=typedSyntaxOwnershipFailure\(typedSyntaxNewline)"
    }
    return summary
}

function compilerMacroDiagnosticName(code: Int): String {
    if code == compilerMacroDiagnosticMalformedDeclaration() { return String("malformedMacroDeclaration") }
    if code == compilerMacroDiagnosticMalformedApplication() { return String("malformedMacroApplication") }
    if code == compilerMacroDiagnosticUnresolved() { return String("unresolvedMacro") }
    if code == compilerMacroDiagnosticAmbiguous() { return String("ambiguousMacroDeclaration") }
    if code == compilerMacroDiagnosticTargetMismatch() { return String("macroTargetSurfaceMismatch") }
    if code == compilerMacroDiagnosticMissingTarget() { return String("macroMissingTarget") }
    if code == compilerMacroDiagnosticUnsupportedTarget() { return String("unsupportedMacroTargetSurface") }
    if code == compilerMacroDiagnosticHeaderMalformed() { return String("macroCapabilityHeaderMalformed") }
    if code == compilerMacroDiagnosticCapabilityDuplicate() { return String("macroCapabilityBindingDuplicate") }
    if code == compilerMacroDiagnosticCapabilityDenied() { return String("macroCapabilityDenied") }
    if code == compilerMacroDiagnosticFuelExhausted() { return String("macroExecutionFuelExhausted") }
    if code == compilerMacroDiagnosticBodyInvalid() { return String("macroExecutionBodyInvalid") }
    if code == compilerMacroDiagnosticExecutionError() { return String("macroExecutionError") }
    if code == compilerMacroDiagnosticGraphQueryInvalid() { return String("macroGraphQueryInvalid") }
    if code == compilerMacroDiagnosticGraphDeltaInvalid() { return String("macroGraphDeltaInvalid") }
    return String("invalidMacroDiagnostic")
}

function compilerMacroObserverDigest(tables: CompilerSyntaxTables): CompilerFingerprint {
    state digest: CompilerFingerprint(compilerFingerprintInitial())
    state row: Int(0)
    state column: Int(0)
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 100)
    while row < compilerIntTableRowCount(table: tables.macroDeclarations) {
        column: 0
        while column < compilerSyntaxMacroDeclarationColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 150)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroParameters) {
        column: 0
        while column < compilerSyntaxMacroParameterColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroParameters, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 200)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroApplications) {
        column: 0
        while column < compilerSyntaxMacroApplicationColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroApplications, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 300)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroEdges) {
        column: 0
        while column < compilerSyntaxMacroEdgeColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroEdges, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    return digest
}

