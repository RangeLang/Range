function compilerSourceSetBodyFunctionNamesSourceSetLLVMCore(): String {
    return "compilerSourceSetLLVMText;compilerNativeSourceSetLLVMText;compilerSourceSetProgramForLLVM;compilerSourceSetProgramForLLVMFromFirstMarker;compilerSourceSetEmptyProgram;compilerSourceSetProgramForLLVMFromIndex;compilerSourceSetProgramForLLVMAtMarker;compilerSourceSetProgramForLLVMFileSource;compilerNativeSourceSetProgramForLLVM;compilerNativeSourceSetProgramForLLVMFromIndex;compilerNativeSourceSetProgramForLLVMAtMarker;compilerNativeProgramForLLVMFileSource;compilerSourceSetProgramAppendingFile;"
