function compilerBodyMIRBuild(arena: CompilerBodyArena): Int {
    if !compilerBodyMemoryIsFrozenAndValid(arena: arena)
        || !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena)
        || !compilerBodyArenaCFGIsValid(arena: arena) { return 0 - 1 }
    let blockCount: Int(compilerIntTableRowCount(table: arena.cfgBlocks))
    let scheduleStarts: RawBuffer(rawBufferCreate(capacity: blockCount, stride: 4))
    let scheduleCounts: RawBuffer(rawBufferCreate(capacity: blockCount, stride: 4))
    let scheduleRows: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.cfgSchedule), stride: 4))
    state status: Int(compilerBodyArenaCFGScheduleBuildBlockIndex(arena: arena, blockStarts: scheduleStarts, blockCounts: scheduleCounts, scheduleRows: scheduleRows))
    if status == 0 { status: compilerBodyMIRBuildWithScheduleIndex(arena: arena, scheduleStarts: scheduleStarts, scheduleCounts: scheduleCounts, scheduleRows: scheduleRows) }
    if rawBufferDestroy(buffer: scheduleStarts) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: scheduleCounts) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: scheduleRows) != 0 { status: 0 - 1 }
    return status
}

function compilerBodyMIRBuildWithScheduleIndex(arena: CompilerBodyArena, scheduleStarts: RawBuffer, scheduleCounts: RawBuffer, scheduleRows: RawBuffer): Int {
