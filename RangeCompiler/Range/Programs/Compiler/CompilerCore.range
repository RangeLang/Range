        arrayTypeID: compilerBodyArenaArrayTypeID(arena: arena, sourceNodeID: nodeID, elementTypeID: elementTypeID)
        if arrayTypeID < 0
            || compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionArrayLiteral(), targetID: compilerBodyArenaArrayDeclarationSyntaxID(arena: arena), typeKind: compilerBodyTypeConstruct(), typeID: arrayTypeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
