        let transferSourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
        let transferSourceTypeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferTypeColumn()))
        let transferStorageKeyID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: validationRow, column: compilerBodyOwnedReturnTransferStorageKeyColumn()))
