        if memoryStatus != 0 {
            failureStage: 6000 + memoryStatus
            valid: false
        } else { failureStage: 7 }
    }
    if valid {
        if compilerBodyMIRBuild(arena: arena) != 0 { valid: false } else { failureStage: 8 }
    }
    if valid {
