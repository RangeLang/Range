    state cursor: Int(equal.end)
    state result: Int(equal.end)
    state parenDepth: Int(0)
    state bracketDepth: Int(0)
    state braceDepth: Int(0)
    while cursor < parameterRangeEnd {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: cursor))
        if maybeToken == nil { return 0 - 1 }
        let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: CompilerTokenCursor(source: source, index: cursor)))
        let token: RangeLexedToken(maybeToken ?? tokenFallback)
        if token.start >= parameterRangeEnd { return result }
        if token.kind == .comma && parenDepth == 0 && bracketDepth == 0 && braceDepth == 0 { return result }
