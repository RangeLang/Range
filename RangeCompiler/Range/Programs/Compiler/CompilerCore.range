    while opaqueUseRow < opaqueUseCount {
        if compilerIntTableValue(table: semantics.resolutions, row: opaqueUseRow, column: 1) == localNodeID
            && compilerIntTableValue(table: semantics.resolutions, row: opaqueUseRow, column: 2) == compilerSemanticResolutionLocal() {
            let opaqueUseNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: opaqueUseRow, column: 0))
            if compilerMemoryNodeEnd(tables: tables, delta: delta, nodeID: opaqueUseNodeID) > opaqueDestroyEnd { return true }
        }
        opaqueUseRow: opaqueUseRow + 1
    }
