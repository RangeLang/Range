                || compilerBodyArenaResolveEnumCaseValue(arena: arena, index: index, nodeID: binaryLeftNodeID, enumTypeID: rightEnumTypeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
        } else if kind == compilerSyntaxKindEquality() && rightIsEnumCase {
