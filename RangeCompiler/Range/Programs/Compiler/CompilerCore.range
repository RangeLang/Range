function compilerBodyArenaOwnedPathRelativeEffectPath(arena: CompilerBodyArena, basePathID: Int, leafPathID: Int, effectPaths: CompilerIntTable): Int {
    if basePathID < 0 || leafPathID < 0 || !compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: leafPathID, ancestorPathID: basePathID) { return 0 - 2 }
    if basePathID == leafPathID { return 0 - 1 }
    let members: RawBuffer(rawBufferCreate(capacity: 8, stride: 4))
    state currentPathID: Int(leafPathID)
    state status: Int(0)
    while currentPathID != basePathID && status == 0 {
        if currentPathID < 0 || currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) {
            status: 0 - 1
        } else {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn()))
            if memberRow < 0 || rawBufferAppendInt(buffer: members, value: memberRow) != 0 { status: 0 - 1 }
            currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
        }
    }
    state effectPathID: Int(0 - 1)
    state reverseOrdinal: Int(rawBufferCount(buffer: members) - 1)
    while reverseOrdinal >= 0 && status == 0 {
        let nextPathID: Int(compilerBodyFunctionInstanceEffectPathAppend(paths: effectPaths, parentPathID: effectPathID, memberRow: rawBufferLoadInt(buffer: members, index: reverseOrdinal)))
        if nextPathID < 0 { status: 0 - 1 } else { effectPathID: nextPathID }
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: members)
    if status != 0 { return 0 - 2 }
    return effectPathID
}

function compilerBodyArenaOwnedPathMoveValue(arena: CompilerBodyArena, sourceRootPathID: Int, destinationRootPathID: Int, states: RawBuffer, origins: RawBuffer, effectPaths: CompilerIntTable, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, sourceNodeID: Int, recordFacts: Bool): Int {
    let sourceLeafCount: Int(compilerBodyArenaOwnedPathOpaqueLeafCount(arena: arena, rootPathID: sourceRootPathID))
    let destinationLeafCount: Int(compilerBodyArenaOwnedPathOpaqueLeafCount(arena: arena, rootPathID: destinationRootPathID))
    if sourceLeafCount <= 0 || sourceLeafCount != destinationLeafCount { return 0 - 1 }
