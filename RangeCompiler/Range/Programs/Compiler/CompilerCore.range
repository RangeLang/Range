        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 3))
        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 9))
        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 10))
        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 11))
        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 12))
        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 13))
        row: row + 1
    }
    return digest
}

