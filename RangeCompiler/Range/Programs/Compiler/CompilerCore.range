        if compilerBodyMIRAppendLoopPhis(arena: arena, blockID: cfgBlockID) != 0 { return 0 - 1 }
        if compilerIntTableValue(table: arena.cfgBlocks, row: cfgBlockID, column: compilerBodyCFGBlockStatementCountColumn()) != 0 { return 0 - 1 }
        let scheduleStart: Int(rawBufferLoadInt(buffer: scheduleStarts, index: cfgBlockID))
        let scheduleCount: Int(rawBufferLoadInt(buffer: scheduleCounts, index: cfgBlockID))
        if scheduleStart < 0 || scheduleCount < 0 || scheduleStart + scheduleCount > rawBufferCount(buffer: scheduleRows) { return 0 - 1 }
        state scheduleOrdinal: Int(0)
