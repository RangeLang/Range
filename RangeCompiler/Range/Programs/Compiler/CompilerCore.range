    if compilerSyntaxTableAppend(tables: tables, table: tables.genericParameters, value: ownerKind) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.genericParameters, value: ordinal) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.genericParameters, value: fileID) != 0 { return 0 - 1 }
