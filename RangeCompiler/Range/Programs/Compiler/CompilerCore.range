    if compilerSyntaxTableAppend(tables: tables, table: tables.parameters, value: functionID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.parameters, value: ordinal) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.parameters, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: parameterStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.parameters, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: parameterEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.parameters, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: nameStart)) != 0 { return 0 - 1 }
