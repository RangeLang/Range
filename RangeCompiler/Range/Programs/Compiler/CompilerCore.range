    let destinationRootKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: destinationRootTypeID))
    if sourceRootKeyID < 0 || sourceRootKeyID != destinationRootKeyID { return 0 - 1 }
    if !compilerBodyArenaOwnedPathSubtreeIsAbsentAt(arena: arena, states: states, origins: origins, rootPathID: destinationRootPathID, blockID: 0 - 1, pathCount: compilerIntTableRowCount(table: arena.ownedPaths)) { return 0 - 1 }
    state sourcePathRow: Int(0)
    while sourcePathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        let sourceTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: sourcePathRow, column: compilerBodyOwnedPathTypeColumn()))
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: sourcePathRow, ancestorPathID: sourceRootPathID)
            && compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: sourceTypeID) {
            let relativePathID: Int(compilerBodyArenaOwnedPathRelativeEffectPath(arena: arena, basePathID: sourceRootPathID, leafPathID: sourcePathRow, effectPaths: effectPaths))
            let destinationPathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: destinationRootPathID, effectPaths: effectPaths, effectPathID: relativePathID))
            let sourcePolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: sourcePathRow, column: compilerBodyOwnedPathPolicyColumn()))
            let sourceOriginPathID: Int(compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: sourcePathRow))
            if relativePathID == 0 - 2 || destinationPathID < 0
                || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()))
                || (sourcePolicy != compilerBodyOwnedPathPolicyOwned() && sourcePolicy != compilerBodyOwnedPathPolicyBorrowed())
                || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned()
                || compilerBodyArenaOwnedPathState(states: states, pathID: sourcePathRow) != compilerBodyOwnedPathLive()
                || compilerBodyArenaOwnedPathState(states: states, pathID: destinationPathID) != compilerBodyOwnedPathAbsent()
                || (sourcePolicy == compilerBodyOwnedPathPolicyOwned()
                    && sourceOriginPathID != compilerBodyOwnedOriginLocal() && !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: sourceOriginPathID))
                || (sourcePolicy == compilerBodyOwnedPathPolicyBorrowed()
                    && !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: sourceOriginPathID))
                || compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: destinationPathID) != compilerBodyOwnedOriginUnknown() { return 0 - 1 }
            let sourceKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: sourceTypeID))
            let destinationKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn())))
            if sourceKeyID < 0 || sourceKeyID != destinationKeyID { return 0 - 1 }
        }
        sourcePathRow: sourcePathRow + 1
    }
    if compilerBodyArenaOwnedPathSetSubtreeState(arena: arena, states: states, rootPathID: sourceRootPathID, expectedState: compilerBodyOwnedPathLive(), nextState: compilerBodyOwnedPathMoved()) != 0 { return 0 - 1 }
    if compilerBodyArenaOwnedPathSetSubtreeState(arena: arena, states: states, rootPathID: destinationRootPathID, expectedState: compilerBodyOwnedPathAbsent(), nextState: compilerBodyOwnedPathLive()) != 0 { return 0 - 1 }
    sourcePathRow: 0
    while sourcePathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        let sourceTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: sourcePathRow, column: compilerBodyOwnedPathTypeColumn()))
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: sourcePathRow, ancestorPathID: sourceRootPathID)
            && compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: sourceTypeID) {
            let relativePathID: Int(compilerBodyArenaOwnedPathRelativeEffectPath(arena: arena, basePathID: sourceRootPathID, leafPathID: sourcePathRow, effectPaths: effectPaths))
            let destinationPathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: destinationRootPathID, effectPaths: effectPaths, effectPathID: relativePathID))
            if destinationPathID < 0
                || compilerBodyArenaOwnedPathSetOrigin(origins: origins, pathID: destinationPathID, originPathID: compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: sourcePathRow)) != 0 { return 0 - 1 }
        }
