                || compilerBodyArenaOwnedPathBuildEdgeProjection(arena: arena, states: states, origins: origins, sourceBlockID: sourceBlockID, targetBlockID: targetBlockID, pathRoots: pathRoots, canonicalPaths: canonicalPaths, projection: projectionB, pathCount: pathCount) != 0 { return false }
