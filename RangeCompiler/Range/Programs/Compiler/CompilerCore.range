function compilerBodyRuntimeBuiltinID(name: String): Int {
    if name == String("stringTransientRegionMark") { return compilerBodyRuntimeBuiltinStringTransientRegionMark() }
    if name == String("stringTransientRegionReset") { return compilerBodyRuntimeBuiltinStringTransientRegionReset() }
    if name == String("stringHasPrefix") { return compilerBodyRuntimeBuiltinStringHasPrefix() }
    if name == String("stringFindFrom") { return compilerBodyRuntimeBuiltinStringFindFrom() }
    if name == String("stringFindFirstOf") { return compilerBodyRuntimeBuiltinStringFindFirstOf() }
    if name == String("stringViewFrom") { return compilerBodyRuntimeBuiltinStringViewFrom() }
    if name == String("stringSliceUnchecked") { return compilerBodyRuntimeBuiltinStringSliceUnchecked() }
    if name == String("stringCharacterAt") { return compilerBodyRuntimeBuiltinStringCharacterAt() }
    if name == String("stringByteAt") { return compilerBodyRuntimeBuiltinStringByteAt() }
    if name == String("stringFindByteOf") { return compilerBodyRuntimeBuiltinStringFindByteOf() }
    if name == String("rawBufferCreate") { return compilerBodyRuntimeBuiltinRawBufferCreate() }
    if name == String("rawBufferAppendInt") { return compilerBodyRuntimeBuiltinRawBufferAppendInt() }
    if name == String("rawBufferCount") { return compilerBodyRuntimeBuiltinRawBufferCount() }
    if name == String("rawBufferLoadInt") { return compilerBodyRuntimeBuiltinRawBufferLoadInt() }
    if name == String("rawBufferStoreInt") { return compilerBodyRuntimeBuiltinRawBufferStoreInt() }
    if name == String("rawBufferAppendText") { return compilerBodyRuntimeBuiltinRawBufferAppendText() }
    if name == String("rawBufferAppendTextInt") { return compilerBodyRuntimeBuiltinRawBufferAppendTextInt() }
    if name == String("rawBufferAppendTextCharacter") { return compilerBodyRuntimeBuiltinRawBufferAppendTextCharacter() }
    if name == String("rawBufferMaterializeText") { return compilerBodyRuntimeBuiltinRawBufferMaterializeText() }
    if name == String("rawBufferDestroy") { return compilerBodyRuntimeBuiltinRawBufferDestroy() }
    if name == String("stringLength") { return compilerBodyRuntimeBuiltinStringLength() }
    if name == String("stringIndexOf") { return compilerBodyRuntimeBuiltinStringIndexOf() }
    if name == String("stringSubstring") { return compilerBodyRuntimeBuiltinStringSubstring() }
    if name == String("stringEqual") { return compilerBodyRuntimeBuiltinStringEqual() }
    if name == String("commandLineArgument") { return compilerBodyRuntimeBuiltinCommandLineArgument() }
    if name == String("commandLineArgumentCount") { return compilerBodyRuntimeBuiltinCommandLineArgumentCount() }
    if name == String("readFile") { return compilerBodyRuntimeBuiltinReadFile() }
    if name == String("compilerMetricsReset") { return compilerBodyRuntimeBuiltinCompilerMetricsReset() }
    if name == String("compilerMetricsSetEnabled") { return compilerBodyRuntimeBuiltinCompilerMetricsSetEnabled() }
    if name == String("compilerMetricsFunctionBegin") { return compilerBodyRuntimeBuiltinCompilerMetricsFunctionBegin() }
    if name == String("compilerMetricsFunctionEnd") { return compilerBodyRuntimeBuiltinCompilerMetricsFunctionEnd() }
    if name == String("compilerMetricsReport") { return compilerBodyRuntimeBuiltinCompilerMetricsReport() }
    if name == String("print") || name == String("puts") { return compilerBodyRuntimeBuiltinPrint() }
    if name == String("writeFile") { return compilerBodyRuntimeBuiltinWriteFile() }
    if name == String("rawBufferAppendRandomBytes") { return compilerBodyRuntimeBuiltinRawBufferAppendRandomBytes() }
    if name == String("rawBufferAppendUnsigned8") { return compilerBodyRuntimeBuiltinRawBufferAppendUnsigned8() }
    if name == String("rawBufferLoadUnsigned8") { return compilerBodyRuntimeBuiltinRawBufferLoadUnsigned8() }
    if name == String("rawBufferStoreUnsigned8") { return compilerBodyRuntimeBuiltinRawBufferStoreUnsigned8() }
    if name == String("runProcess") { return compilerBodyRuntimeBuiltinRunProcess() }
    if name == String("runProcessBatch") { return compilerBodyRuntimeBuiltinRunProcessBatch() }
    return compilerBodyRuntimeBuiltinNone()
}

