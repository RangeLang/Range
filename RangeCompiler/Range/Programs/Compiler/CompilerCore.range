            if terminatorValueID < 0 { terminatorValueID: compilerBodyMIRExpressionValue(arena: arena, nodeID: terminatorSourceNodeID, action: compilerBodyCFGScheduleStatementCommit()) }
            if terminatorValueID < 0 { terminatorValueID: compilerBodyMIRExpressionValue(arena: arena, nodeID: terminatorSourceNodeID, action: compilerBodyCFGScheduleSwitchMatch()) }
        }
        if cfgTerminatorKind == compilerBodyCFGTerminatorReturn() {
            mirTerminatorKind: compilerBodyMIROperationReturn()
            if terminatorSourceNodeID >= 0 {
