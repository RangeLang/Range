            if sourceKind == compilerReachableFunctionInstanceReturnSourceLocalCreate() {
                if compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: compilerBodyMemoryFactResourceCreate(), sourceNodeID: applicationNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: destinationLeafPathID, auxID: compilerIntTableValue(table: arena.ownedPaths, row: destinationLeafPathID, column: compilerBodyOwnedPathTypeColumn())) < 0 { return 0 - 1 }
            } else if sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias() {
                let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: destinationLeafPathID))
                if canonicalSourcePathID < 0
                    || compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: compilerBodyMemoryFactBindingAlias(), sourceNodeID: applicationNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: destinationLeafPathID, auxID: canonicalSourcePathID) < 0 { return 0 - 1 }
            } else if sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward() {
                let baseKind: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn()))
                let ordinal: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn()))
                let boundaryPathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
                let sourcePathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: boundaryPathID, effectPaths: effectPaths, effectPathID: compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn())))
                if sourcePathID < 0
                    || compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: compilerBodyMemoryFactMove(), sourceNodeID: applicationNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: sourcePathID, auxID: destinationLeafPathID) < 0 { return 0 - 1 }
            } else { return 0 - 1 }
        }
