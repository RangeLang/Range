    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: ordinal) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: memberStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: memberEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: nameStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: nameEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: typeStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: typeEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: fingerprint.first) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: fingerprint.second) != 0 { return 0 - 1 }
    return compilerSyntaxTableAppend(tables: tables, table: tables.members, value: memberKind)
}

function compilerSyntaxAppendFunction(tables: CompilerSyntaxTables, syntaxID: Int, fileID: Int, firstParameterRow: Int, parameterCount: Int, parameterStart: Int, parameterEnd: Int, returnTypeStart: Int, returnTypeEnd: Int, bodyStart: Int, bodyEnd: Int, signature: CompilerFingerprint): Int {
    if !compilerSyntaxFunctionRangesAreValid(tables: tables, fileID: fileID, parameterStart: parameterStart, parameterEnd: parameterEnd, returnTypeStart: returnTypeStart, returnTypeEnd: returnTypeEnd, bodyStart: bodyStart, bodyEnd: bodyEnd) {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: syntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: fileID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: firstParameterRow) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: parameterCount) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: parameterStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: parameterEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: returnTypeStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: returnTypeEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: bodyStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: bodyEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: signature.first) != 0 { return 0 - 1 }
    return compilerSyntaxTableAppend(tables: tables, table: tables.functions, value: signature.second)
}

function compilerSyntaxAppendParameter(tables: CompilerSyntaxTables, syntaxID: Int, fileID: Int, functionID: Int, ordinal: Int, parameterStart: Int, parameterEnd: Int, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int, fingerprint: CompilerFingerprint): Int {
    if !compilerSyntaxParameterRangesAreValid(tables: tables, fileID: fileID, parameterStart: parameterStart, parameterEnd: parameterEnd, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd) {
