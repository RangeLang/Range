function compilerMemoryLocalStoragePolicy(tables: CompilerSyntaxTables, localNodeID: Int): Int {
    if localNodeID < 0 || localNodeID >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerIntTableValue(table: tables.syntaxIndex, row: localNodeID, column: 0) != compilerSyntaxKindLocalBinding() { return 0 - 1 }
    let memoryPolicyBodyRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: localNodeID, column: 1))
    let memoryPolicyAux: Int(compilerIntTableValue(table: tables.bodyNodes, row: memoryPolicyBodyRow, column: 10))
    if memoryPolicyAux == compilerSyntaxLocalKindLet() { return compilerMemoryStorageImmutable() }
    if memoryPolicyAux == compilerSyntaxLocalKindState() { return compilerMemoryStorageMutable() }
    return 0 - 1
}

