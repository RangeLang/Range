function compilerCoreLLVMLowerDirectLinearRecordBlockAfterLowered(program: CompilerProgram, parsedBlock: CompilerParsedBlock, statementIndex: Int, statementRecord: String, loweredStatement: CompilerLLVMLoweredLinearStatement, llvmInstructionRecords: String, expectedReturnType: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    if loweredStatement.hasReturn {
        return compilerCoreRenderedDirectReturnBlock(program: program, parsedBlock: parsedBlock, renderedInstructionRecords: llvmInstructionRecords, localValues: loweredStatement.localValues, temporaryIndex: loweredStatement.nextTemporary, returnLLVMType: loweredStatement.returnLLVMType, returnLLVMValue: loweredStatement.returnLLVMValue, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
    }

    let nextStatementIndex: Int(compilerCoreStatementRecordNextIndex(records: parsedBlock.statementRecords, start: statementIndex))
    return compilerCoreLLVMLowerDirectLinearRecordBlockFromIndex(program: program, parsedBlock: parsedBlock, statementIndex: nextStatementIndex, llvmInstructionRecords: llvmInstructionRecords, llvmLocalValues: loweredStatement.localValues, llvmTemporaryIndex: loweredStatement.nextTemporary, expectedReturnType: expectedReturnType, initialBlockLabel: initialBlockLabel, initialBranchIndex: initialBranchIndex)
}

function compilerCoreLLVMLowerLinearStatementRecord(program: CompilerProgram, statementRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    let statementKind: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("kind=")))
    let statementName: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("name=")))
    let statementTypeName: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("type=")))
    let expressionSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("expression=")))
    let expressionRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("expressionRecord="))))
    return compilerCoreLLVMLowerLinearStatementRecordWithExpression(program: program, statementKind: statementKind, statementName: statementName, statementTypeName: statementTypeName, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
}

function compilerCoreLLVMLowerLinearStatementRecordWithExpression(program: CompilerProgram, statementKind: String, statementName: String, statementTypeName: String, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if statementKind == String("let") {
        return compilerCoreLLVMLowerLinearStatementRecordBinding(program: program, statementName: statementName, statementTypeName: statementTypeName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("state") {
        return compilerCoreLLVMLowerLinearStatementRecordBinding(program: program, statementName: statementName, statementTypeName: statementTypeName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    return compilerCoreLLVMLowerLinearStatementRecordNonBinding(program: program, statementKind: statementKind, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
}

function compilerCoreLLVMLowerLinearStatementRecordBinding(program: CompilerProgram, statementName: String, statementTypeName: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    if !compilerCoreCanLowerLocalType(declarationRecords: program.declarationRecords, typeName: statementTypeName) {
        return compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: localValues, temporaryIndex: temporaryIndex)
    }

    let loweredLocal: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: statementTypeName, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredLocal.instructionRecords, localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: statementName, operand: loweredLocal.operand, typeName: loweredLocal.typeName, rangeTypeName: statementTypeName))", nextTemporary: loweredLocal.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordNonBinding(program: CompilerProgram, statementKind: String, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    if statementKind == String("expression") {
        return compilerCoreLLVMLowerLinearStatementRecordExpression(program: program, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("assignment") {
        return compilerCoreLLVMLowerLinearStatementRecordAssignment(program: program, statementRecord: statementRecord, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
    }

    if statementKind == String("return") {
        return compilerCoreLLVMLowerLinearStatementRecordReturn(program: program, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex, expectedReturnType: expectedReturnType)
    }

    return compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: localValues, temporaryIndex: temporaryIndex)
}

function compilerCoreLLVMLowerLinearStatementRecordExpression(program: CompilerProgram, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    let loweredExpression: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: String(""), temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredExpression.instructionRecords, localValues: localValues, nextTemporary: loweredExpression.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordAssignment(program: CompilerProgram, statementRecord: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    state assignmentName: String("")
    assignmentName: compilerCoreStatementRecordField(record: statementRecord, prefix: String("name="))
    let assignmentTargetSummary: String(compilerCoreStatementRecordField(record: statementRecord, prefix: String("target=")))
    let assignmentTargetRecord: String(compilerCoreStatementRecordDecodeValue(value: compilerCoreStatementRecordField(record: statementRecord, prefix: String("targetRecord="))))
    if assignmentName == String("") {
        assignmentName: compilerCoreIdentifierExpressionRecordName(record: assignmentTargetRecord, fallbackSummary: assignmentTargetSummary)
    }
    return compilerCoreLLVMLowerLinearStatementRecordAssignmentName(program: program, assignmentName: assignmentName, expressionSummary: expressionSummary, expressionRecord: expressionRecord, localValues: localValues, temporaryIndex: temporaryIndex)
}

function compilerCoreLLVMLowerLinearStatementRecordAssignmentName(program: CompilerProgram, assignmentName: String, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    if assignmentName == String("") {
        return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
    }

    let assignmentLLVMType: String(compilerCoreLookupLLVMLocalType(localValues: localValues, name: assignmentName))
    state assignmentRangeType: String(compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: assignmentName))
    if assignmentRangeType == String("") {
        assignmentRangeType: compilerCoreRangeTypeNameForLLVMType(typeName: assignmentLLVMType)
    }
    let loweredAssignment: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: assignmentRangeType, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredAssignment.instructionRecords, localValues: "\(localValues)\(compilerCoreLLVMLocalRecordWithRangeType(name: assignmentName, operand: loweredAssignment.operand, typeName: loweredAssignment.typeName, rangeTypeName: assignmentRangeType))", nextTemporary: loweredAssignment.nextTemporary, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreLLVMLowerLinearStatementRecordReturn(program: CompilerProgram, expressionSummary: String, expressionRecord: String, localValues: String, temporaryIndex: Int, expectedReturnType: String): CompilerLLVMLoweredLinearStatement {
    let loweredReturn: CompilerLLVMLoweredExpression(compilerCoreLLVMLowerExpressionRecord(declarationRecords: program.declarationRecords, localValues: localValues, expressionRecord: expressionRecord, fallbackSummary: expressionSummary, expectedTypeName: expectedReturnType, temporaryIndex: temporaryIndex))
    return CompilerLLVMLoweredLinearStatement(handled: true, instructionRecords: loweredReturn.instructionRecords, localValues: localValues, nextTemporary: loweredReturn.nextTemporary, hasReturn: true, returnLLVMType: compilerCoreLLVMTypeNameForRangeType(typeName: expectedReturnType), returnLLVMValue: loweredReturn.operand)
}

function compilerCoreLLVMLowerLinearStatementRecordUnhandled(localValues: String, temporaryIndex: Int): CompilerLLVMLoweredLinearStatement {
    return CompilerLLVMLoweredLinearStatement(handled: false, instructionRecords: String(""), localValues: localValues, nextTemporary: temporaryIndex, hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
}

function compilerCoreRenderedDirectReturnBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, renderedInstructionRecords: String, localValues: String, temporaryIndex: Int, returnLLVMType: String, returnLLVMValue: String, initialBlockLabel: String, initialBranchIndex: Int): CompilerLLVMLoweredBlock {
    let terminator: CompilerLLVMTerminator(CompilerLLVMTerminator(kind: String("return"), typeName: returnLLVMType, value: returnLLVMValue, trueLabel: String(""), falseLabel: String("")))
    let renderedBlocks: String(compilerCoreRenderLLVMNamedBlock(label: initialBlockLabel, instructionRecords: renderedInstructionRecords, terminal: terminator))
    return CompilerLLVMLoweredBlock(block: parsedBlock.block, declarationRecords: program.declarationRecords, functionSummary: program.functionSummary, renderedBlocks: renderedBlocks, instructionRecords: renderedInstructionRecords, localValues: localValues, nextTemporary: temporaryIndex, nextBranchIndex: initialBranchIndex, exitLabel: initialBlockLabel, hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: true, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
