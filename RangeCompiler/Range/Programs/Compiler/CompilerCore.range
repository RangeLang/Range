    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroReadDependencies) {
        let fileID: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 4))
        let kindStart: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 5))
        let kindEnd: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 6))
        let nameStart: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 7))
        let nameEnd: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 8))
        state kindName: String(compilerCoreStringLiteralContent(text: compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: kindStart, localEnd: kindEnd)))
        let operation: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 2))
        if operation == compilerMacroTargetOperationMemberCount() { kindName: String("Construct") }
        let declarationName: String(compilerCoreStringLiteralContent(text: compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStart, localEnd: nameEnd)))
        rawBufferAppendText(buffer: outputBuffer, text: "macroReadDependency\(tab)row=\(row)\(tab)invocationRow=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 1))\(tab)operation=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 2))\(tab)kind=\(kindName)\(tab)name=\(declarationName)\(tab)observedCount=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 9))\(tab)applicationIdentity=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 10)):\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 11))\(tab)targetIdentity=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 12)):\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 13))\(tab)queryIdentity=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 14)):\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 15))\(tab)observation=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 16)):\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 17))\(newline)")
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderGraphDelta(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nodes) {
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphDeltaNode\(tab)row=\(row)\(tab)kind=\(compilerSyntaxKindName(kindTag: compilerIntTableValue(table: delta.nodes, row: row, column: 1)))\(tab)targetSyntaxID=\(compilerIntTableValue(table: delta.nodes, row: row, column: 2))\(tab)fileID=\(compilerIntTableValue(table: delta.nodes, row: row, column: 4))\(tab)start=\(compilerIntTableValue(table: delta.nodes, row: row, column: 5))\(tab)end=\(compilerIntTableValue(table: delta.nodes, row: row, column: 6))\(newline)")
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.facts) {
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphDeltaFact\(tab)row=\(row)\(tab)operation=omit\(tab)subjectNodeID=\(compilerIntTableValue(table: delta.facts, row: row, column: 1))\(tab)objectNodeID=\(compilerIntTableValue(table: delta.facts, row: row, column: 2))\(tab)role=\(compilerIntTableValue(table: delta.facts, row: row, column: 3))\(tab)ordinal=\(compilerIntTableValue(table: delta.facts, row: row, column: 4))\(newline)")
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.generatedFunctions) {
        let name: String(compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: row))
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphGeneratedFunction\(tab)row=\(row)\(tab)kind=function\(tab)ownerSyntaxID=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 2))\(tab)placement=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 21))\(tab)lexicalParentOrdinal=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 22))\(tab)parentFingerprint=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 23)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 24))\(tab)name=\(name)\(tab)returnType=\(compilerTypedSyntaxLocalText(tables: tables, fileID: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 3), localStart: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 8), localEnd: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 9)))\(tab)macroDeclarationRow=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12))\(tab)applicationRow=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 13))\(tab)ordinal=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14))\(tab)applicationIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 15)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 16))\(tab)targetIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 17)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 18))\(tab)stableIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 19)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 20))\(newline)")
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.generatedMembers) {
        let fileID: Int(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 3))
        let name: String(compilerMacroGraphDeltaGeneratedMemberName(tables: tables, delta: delta, row: row))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 8), localEnd: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 9)))
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphGeneratedMember\(tab)row=\(row)\(tab)kind=member\(tab)ownerSyntaxID=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 2))\(tab)placement=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 19))\(tab)lexicalParentOrdinal=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 20))\(tab)parentFingerprint=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 21)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 22))\(tab)name=\(name)\(tab)memberKind=\(compilerSyntaxMemberKindName(kindTag: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 23)))\(tab)type=\(typeName)\(tab)macroDeclarationRow=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 10))\(tab)applicationRow=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 11))\(tab)ordinal=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 12))\(tab)applicationIdentity=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 13)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 14))\(tab)targetIdentity=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 15)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 16))\(tab)stableIdentity=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 17)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 18))\(newline)")
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderExecutionError(tables: CompilerSyntaxTables, result: CompilerMacroExecutionResult): String {
    state invocationRow: Int(0 - 1)
    state foundInvocation: Bool(false)
    while invocationRow < compilerIntTableRowCount(table: tables.macroInvocations) - 1 && !foundInvocation {
        invocationRow: invocationRow + 1
        if compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 9) == compilerMacroInvocationFailed() { foundInvocation: true }
    }
    if invocationRow < 0 || invocationRow >= compilerIntTableRowCount(table: tables.macroInvocations) {
        return "compilerError\tkind=macroExecution\tdiagnosticKind=\(compilerMacroDiagnosticName(code: result.diagnosticCode))\n"
    }
    let applicationRow: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 1))
    let declarationRow: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 2))
    let applicationFileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let identityFirst: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 23))
    let identitySecond: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 24))
    state message: String("")
    state eventSourceFileID: Int(0 - 1)
    state eventSourceStart: Int(0 - 1)
    state eventSourceEnd: Int(0 - 1)
    state eventRow: Int(0)
    while eventRow < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        if compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 1) == invocationRow {
            let messageFileID: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 4))
            let rawMessage: String(compilerTypedSyntaxLocalText(tables: tables, fileID: messageFileID, localStart: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 5), localEnd: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 6)))
            message: compilerCoreStringLiteralContent(text: rawMessage)
            eventSourceFileID: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 7)
            eventSourceStart: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 8)
            eventSourceEnd: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 9)
        }
        eventRow: eventRow + 1
    }
    state output: String("compilerError\tkind=macroExecution\tdiagnosticKind=\(compilerMacroDiagnosticName(code: compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 10)))\tmessage=\(message)\tdiagnosticFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 11))\tdiagnosticStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 12))\tdiagnosticEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 13))\tapplicationFileID=\(applicationFileID)\tapplicationStart=\(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 2))\tapplicationEnd=\(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 3))\ttargetFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 17))\ttargetStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 18))\ttargetEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 19))\tmacroDeclarationFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 20))\tmacroDeclarationStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 21))\tmacroDeclarationEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 22))\tmacroBodyStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 15))\tmacroBodyEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 16))\tpipelineStatus=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 33))\tpipelineFailureCode=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 34))\teventSourceFileID=\(eventSourceFileID)\teventSourceStart=\(eventSourceStart)\teventSourceEnd=\(eventSourceEnd)\tgraphDeltaNodeCount=\(compilerIntTableRowCount(table: result.graphDelta.nodes))\tgraphDeltaFactCount=\(compilerIntTableRowCount(table: result.graphDelta.facts))\treadDependencyCount=\(result.readDependencyCount)\tinvocationIdentity=\(identityFirst):\(identitySecond)\n")
    output: "\(output)\(compilerMacroRenderReadDependencies(tables: tables))"
    return output
}

function compilerMacroRenderExecutionSnapshot(tables: CompilerSyntaxTables, result: CompilerMacroExecutionResult): String {
    let digest: CompilerFingerprint(compilerMacroExecutionDigest(tables: tables))
    let dependencyDigest: CompilerFingerprint(compilerMacroReadDependencyDigest(tables: tables))
    let graphDeltaDigest: CompilerFingerprint(compilerMacroGraphDeltaDigest(delta: result.graphDelta))
    state output: String("macroExecution\tvalid=true\tinvocationCount=\(compilerIntTableRowCount(table: tables.macroInvocations))\tcapabilityHandleCount=\(compilerIntTableRowCount(table: tables.macroCapabilityHandles))\teventCount=\(compilerIntTableRowCount(table: tables.macroExecutionEvents))\tgraphDeltaNodeCount=\(compilerIntTableRowCount(table: result.graphDelta.nodes))\tgraphDeltaFactCount=\(compilerIntTableRowCount(table: result.graphDelta.facts))\treadDependencyCount=\(result.readDependencyCount)\treadDependencyDigest=\(dependencyDigest.first):\(dependencyDigest.second)\tgraphDeltaDigest=\(graphDeltaDigest.first):\(graphDeltaDigest.second)\texecutionDigest=\(digest.first):\(digest.second)\n")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroInvocations) {
        output: "\(output)macroInvocation\trow=\(row)\tapplicationRow=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 1))\tdeclarationRow=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 2))\ttargetSyntaxID=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 3))\tphase=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 5))\tordinal=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 6))\tstatus=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 9))\tbudget=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 8))\tmirOperationCount=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 27))\tstepCount=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 28))\tapplicationIdentity=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 29)):\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 30))\tdeclarationIdentity=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 31)):\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 32))\n"
        row: row + 1
    }
    output: "\(output)\(compilerMacroRenderExecutionEvents(tables: tables))"
    output: "\(output)\(compilerMacroRenderReadDependencies(tables: tables))"
    output: "\(output)\(compilerMacroRenderGraphDelta(tables: tables, delta: result.graphDelta))"
    return output
}

function compilerMacroRenderSnapshot(tables: CompilerSyntaxTables): String {
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.macroParameters))
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let edgeCount: Int(compilerIntTableRowCount(table: tables.macroEdges))
    let appliesToCount: Int(compilerMacroEdgeCount(tables: tables, edgeKind: compilerMacroEdgeAppliesTo()))
    let resolvedByCount: Int(compilerMacroEdgeCount(tables: tables, edgeKind: compilerMacroEdgeResolvedBy()))
    let digest: CompilerFingerprint(compilerMacroObserverDigest(tables: tables))
    let identityDigest: CompilerFingerprint(compilerMacroIdentityProjectionDigest(tables: tables))
    return "macroGraph\tvalid=true\tdeclarationCount=\(declarationCount)\tparameterCount=\(parameterCount)\tapplicationCount=\(applicationCount)\tedgeCount=\(edgeCount)\tappliesToCount=\(appliesToCount)\tresolvedByCount=\(resolvedByCount)\tdigest=\(digest.first):\(digest.second)\nmacroStableProjection\tidentityDigest=\(identityDigest.first):\(identityDigest.second)\n"
}

function compilerMacroExecutionSummaryForValidIndex(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex): String {
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: index))
    let memory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    state output: String("")
    if execution.status != 0 {
        output: compilerMacroRenderExecutionError(tables: tables, result: execution)
    } else if compilerMemoryBuildMacroFamilyRepresentations(tables: tables, memory: memory) != 0
        || !compilerMemoryMacroFamilyRepresentationsAreValid(tables: tables, memory: memory) {
        output: "\(compilerNativeDiagnostic(kind: String("invalidMacroFamilyMemoryGraph")))\(compilerMemoryRenderMacroFamilySnapshot(memory: memory))"
    } else {
        output: "\(compilerMacroRenderExecutionSnapshot(tables: tables, result: execution))\(compilerMacroRenderSnapshot(tables: tables))\(compilerMemoryRenderMacroFamilySnapshot(memory: memory))"
    }
    if compilerGraphDeltaDestroy(delta: execution.graphDelta) != 0 {
        output: "compilerError\tkind=macroOwnershipFailure\n"
    }
    if compilerMemoryGraphDestroy(memory: memory) != 0 {
        output: "compilerError\tkind=macroOwnershipFailure\n"
    }
    return output
}

function compilerMacroSummaryForLinkedTables(tables: CompilerSyntaxTables): String {
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    state output: String("")
    if !declarationIndex.isValid {
        output: "compilerError\tkind=invalidDeclarationIndex\n"
    } else {
        output: compilerMacroExecutionSummaryForValidIndex(tables: tables, index: declarationIndex)
    }
    if compilerDeclarationIndexDestroy(index: declarationIndex) != 0 {
        output: "compilerError\tkind=macroOwnershipFailure\n"
    }
    return output
}

function compilerMacroSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    state output: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        output: compilerInvalidTypedDeclarationsDiagnostic(tables: tables)
    } else {
        let linkStatus: Int(compilerMacroLink(tables: tables))
        if linkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
            output: compilerMacroRenderDiagnostics(tables: tables)
        } else {
            output: compilerMacroSummaryForLinkedTables(tables: tables)
        }
    }
    if compilerSyntaxTablesDestroy(tables: tables) != 0 {
        return "compilerError(compilerCoreTabCharacter())kind=macroOwnershipFailure(compilerCoreNewlineCharacter())"
    }
    return output
}

function compilerSourceIdentitySummaryForValidStore(source: String, store: CompilerSourceStore): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 1024, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    rawBufferAppendText(buffer: outputBuffer, text: "sourceIdentity\(tab)fileCount=\(fileCount)\(newline)")
    state fileID: Int(0)
    while fileID < fileCount {
        let role: Int(compilerSourceStoreFileRole(store: store, fileID: fileID))
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart {
            path: stringSubstring(source: source, start: pathStart, end: pathEnd)
        }
        let mappedFileID: Int(compilerSourceStoreFileIDAtGlobalOffset(store: store, globalOffset: contentStart))
        let localOffset: Int(compilerSourceStoreFileLocalOffset(store: store, globalOffset: contentStart))
        rawBufferAppendText(buffer: outputBuffer, text: "sourceFile\(tab)id=\(fileID)\(tab)role=\(compilerSourceRoleName(role: role))\(tab)path=\(path)\(tab)pathStart=\(pathStart)\(tab)pathEnd=\(pathEnd)\(tab)contentStart=\(contentStart)\(tab)contentEnd=\(contentEnd)\(newline)")
        rawBufferAppendText(buffer: outputBuffer, text: "sourceMap\(tab)global=\(contentStart)\(tab)fileID=\(mappedFileID)\(tab)local=\(localOffset)\(newline)")
        fileID: fileID + 1
    }

    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerSourceIdentitySummary(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return String("compilerError\tkind=invalidSourceFileTable\n")
    }

    let summary: String(compilerSourceIdentitySummaryForValidStore(source: source, store: store))
    compilerSourceStoreDestroy(store: store)
    return summary
}

function compilerSourceInventorySummary(source: String): String {
    let files: String(compilerSourceInventoryFileRecords(source: source))
    if hasRangePrefix(source: files, start: 0, prefix: String("compilerError")) {
        return files
    }
    let count: Int(compilerSourceInventoryFileCount(source: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    return "sourceInventory\(tab)program\(newline)\(files)sourceFileCount\(tab)\(count)\(newline)"
}

function compilerSourceWorkTableColumnCount(): Int { return 7 }
function compilerSourceWorkIdentityColumn(): Int { return 0 }
function compilerSourceWorkPrerequisiteCountColumn(): Int { return 1 }
function compilerSourceWorkUnresolvedCountColumn(): Int { return 2 }
function compilerSourceWorkLifecycleColumn(): Int { return 3 }
function compilerSourceWorkMemoryReservationColumn(): Int { return 4 }
function compilerSourceWorkCommitIdentityColumn(): Int { return 5 }
function compilerSourceWorkStatusColumn(): Int { return 6 }

function compilerSourceWorkLifecycleWaiting(): Int { return 0 }
function compilerSourceWorkLifecycleReady(): Int { return 1 }
function compilerSourceWorkLifecycleRunning(): Int { return 2 }
function compilerSourceWorkLifecycleParked(): Int { return 3 }
function compilerSourceWorkLifecycleCompleted(): Int { return 4 }
function compilerSourceWorkLifecycleCancelled(): Int { return 5 }

function compilerSourceWorkStatusPending(): Int { return 0 }
function compilerSourceWorkStatusRendered(): Int { return 1 }
function compilerSourceWorkStatusCommitted(): Int { return 2 }
function compilerSourceWorkStatusFailed(): Int { return 3 }

function compilerSourceWorkLifecycleName(lifecycle: Int): String {
    if lifecycle == compilerSourceWorkLifecycleWaiting() { return String("waiting") }
    if lifecycle == compilerSourceWorkLifecycleReady() { return String("ready") }
    if lifecycle == compilerSourceWorkLifecycleRunning() { return String("running") }
    if lifecycle == compilerSourceWorkLifecycleParked() { return String("parked") }
    if lifecycle == compilerSourceWorkLifecycleCompleted() { return String("completed") }
    if lifecycle == compilerSourceWorkLifecycleCancelled() { return String("cancelled") }
    return String("unknown")
}

function compilerSourceWorkStatusName(status: Int): String {
    if status == compilerSourceWorkStatusPending() { return String("pending") }
    if status == compilerSourceWorkStatusRendered() { return String("rendered") }
    if status == compilerSourceWorkStatusCommitted() { return String("committed") }
    if status == compilerSourceWorkStatusFailed() { return String("failed") }
    return String("unknown")
}

function compilerSourceInventoryFileRecordForValidStore(source: String, store: CompilerSourceStore, fileID: Int): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
    let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
    state path: String("")
    if pathEnd > pathStart {
        path: stringSubstring(source: source, start: pathStart, end: pathEnd)
    }
    return "sourceFile\(tab)index=\(fileID)\(tab)role=\(compilerSourceRoleName(role: compilerSourceStoreFileRole(store: store, fileID: fileID)))\(tab)path=\(path)\(newline)"
}

function compilerSourceWorkTableAppend(work: CompilerIntTable, identity: Int, memoryReservation: Int): Int {
    if work.columnCount != compilerSourceWorkTableColumnCount() { return 0 - 1 }
    if compilerIntTableAppend(table: work, value: identity) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: work, value: 0) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: work, value: 0) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: work, value: compilerSourceWorkLifecycleWaiting()) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: work, value: memoryReservation) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: work, value: identity) != 0 { return 0 - 1 }
    return compilerIntTableAppend(table: work, value: compilerSourceWorkStatusPending())
}

function compilerSourceWorkTableCreate(source: String, store: CompilerSourceStore): CompilerIntTable {
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    let work: CompilerIntTable(compilerIntTableCreate(columnCount: compilerSourceWorkTableColumnCount(), estimatedRowCount: fileCount))
    state fileID: Int(0)
    while fileID < fileCount {
        let record: String(compilerSourceInventoryFileRecordForValidStore(source: source, store: store, fileID: fileID))
        if compilerSourceWorkTableAppend(work: work, identity: fileID, memoryReservation: stringLength(value: record)) != 0 {
            return work
        }
        fileID: fileID + 1
    }
    return work
}

function compilerSourceWorkTableStore(work: CompilerIntTable, row: Int, column: Int, value: Int): Int {
    if row < 0 || row >= compilerIntTableRowCount(table: work) || column < 0 || column >= work.columnCount { return 0 - 1 }
    return rawBufferStoreInt(buffer: work.values, index: row * work.columnCount + column, value: value)
}

function compilerSourceWorkTableIsInitial(work: CompilerIntTable, fileCount: Int): Bool {
    if work.columnCount != compilerSourceWorkTableColumnCount() || !compilerIntTableIsComplete(table: work) || compilerIntTableRowCount(table: work) != fileCount { return false }
    state row: Int(0)
    while row < fileCount {
        if compilerIntTableValue(table: work, row: row, column: compilerSourceWorkIdentityColumn()) != row
            || compilerIntTableValue(table: work, row: row, column: compilerSourceWorkPrerequisiteCountColumn()) != 0
            || compilerIntTableValue(table: work, row: row, column: compilerSourceWorkUnresolvedCountColumn()) != 0
            || compilerIntTableValue(table: work, row: row, column: compilerSourceWorkLifecycleColumn()) != compilerSourceWorkLifecycleWaiting()
            || compilerIntTableValue(table: work, row: row, column: compilerSourceWorkMemoryReservationColumn()) < 0
            || compilerIntTableValue(table: work, row: row, column: compilerSourceWorkCommitIdentityColumn()) != row
            || compilerIntTableValue(table: work, row: row, column: compilerSourceWorkStatusColumn()) != compilerSourceWorkStatusPending() { return false }
        row: row + 1
    }
    return true
}

function compilerSourceWorkLowestReadyRow(work: CompilerIntTable): Int {
    state selectedRow: Int(0 - 1)
    state selectedIdentity: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: work) {
        let identity: Int(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkIdentityColumn()))
        if compilerIntTableValue(table: work, row: row, column: compilerSourceWorkLifecycleColumn()) == compilerSourceWorkLifecycleReady()
            && (selectedRow < 0 || identity < selectedIdentity) {
            selectedRow: row
            selectedIdentity: identity
        }
        row: row + 1
    }
    return selectedRow
}

function compilerSourceWorkLowestCommitRow(work: CompilerIntTable): Int {
    state selectedRow: Int(0 - 1)
    state selectedIdentity: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: work) {
        let identity: Int(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkCommitIdentityColumn()))
        if compilerIntTableValue(table: work, row: row, column: compilerSourceWorkLifecycleColumn()) == compilerSourceWorkLifecycleCompleted()
            && compilerIntTableValue(table: work, row: row, column: compilerSourceWorkStatusColumn()) == compilerSourceWorkStatusRendered()
            && (selectedRow < 0 || identity < selectedIdentity) {
            selectedRow: row
            selectedIdentity: identity
        }
        row: row + 1
    }
    return selectedRow
}

function compilerSourceInventoryScheduleForValidStore(source: String, store: CompilerSourceStore): CompilerSourceScheduleResult {
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    let work: CompilerIntTable(compilerSourceWorkTableCreate(source: source, store: store))
    let projectedRecords: RawBuffer(rawBufferCreate(capacity: fileCount * 64, stride: 1))
    let committedRecords: RawBuffer(rawBufferCreate(capacity: fileCount * 64, stride: 1))
    let traceBuffer: RawBuffer(rawBufferCreate(capacity: fileCount * 256 + 128, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state valid: Bool(compilerSourceWorkTableIsInitial(work: work, fileCount: fileCount))
    if rawBufferAppendText(buffer: traceBuffer, text: "compilerSourceScheduleTrace\(tab)version=1\(tab)boundary=sourceInventoryFileRecord\(tab)laneCount=1\(tab)workCount=\(fileCount)\(newline)") != 0 { valid: false }

    state row: Int(0)
    while row < fileCount {
        let identity: Int(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkIdentityColumn()))
        if rawBufferAppendText(buffer: traceBuffer, text: "work\(tab)identity=\(identity)\(tab)prerequisiteCount=\(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkPrerequisiteCountColumn()))\(tab)unresolvedCount=\(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkUnresolvedCountColumn()))\(tab)lifecycle=\(compilerSourceWorkLifecycleName(lifecycle: compilerIntTableValue(table: work, row: row, column: compilerSourceWorkLifecycleColumn())))\(tab)memoryReservation=\(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkMemoryReservationColumn()))\(tab)commitIdentity=\(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkCommitIdentityColumn()))\(tab)status=\(compilerSourceWorkStatusName(status: compilerIntTableValue(table: work, row: row, column: compilerSourceWorkStatusColumn())))\(newline)") != 0 { valid: false }
        row: row + 1
    }

    row: 0
    while row < fileCount {
        if compilerIntTableValue(table: work, row: row, column: compilerSourceWorkPrerequisiteCountColumn()) == 0
            && compilerIntTableValue(table: work, row: row, column: compilerSourceWorkUnresolvedCountColumn()) == 0
            && compilerIntTableValue(table: work, row: row, column: compilerSourceWorkLifecycleColumn()) == compilerSourceWorkLifecycleWaiting() {
            let identity: Int(compilerIntTableValue(table: work, row: row, column: compilerSourceWorkIdentityColumn()))
            if compilerSourceWorkTableStore(work: work, row: row, column: compilerSourceWorkLifecycleColumn(), value: compilerSourceWorkLifecycleReady()) != 0 { valid: false }
            if rawBufferAppendText(buffer: traceBuffer, text: "transition\(tab)identity=\(identity)\(tab)from=waiting\(tab)to=ready\(newline)") != 0 { valid: false }
        }
        row: row + 1
    }

    state renderedCount: Int(0)
    state readyRow: Int(compilerSourceWorkLowestReadyRow(work: work))
    while valid && readyRow >= 0 {
        let identity: Int(compilerIntTableValue(table: work, row: readyRow, column: compilerSourceWorkIdentityColumn()))
        if compilerSourceWorkTableStore(work: work, row: readyRow, column: compilerSourceWorkLifecycleColumn(), value: compilerSourceWorkLifecycleRunning()) != 0 { valid: false }
        if rawBufferAppendText(buffer: traceBuffer, text: "transition\(tab)identity=\(identity)\(tab)from=ready\(tab)to=running\(newline)") != 0 { valid: false }
        let record: String(compilerSourceInventoryFileRecordForValidStore(source: source, store: store, fileID: identity))
        if stringLength(value: record) != compilerIntTableValue(table: work, row: readyRow, column: compilerSourceWorkMemoryReservationColumn())
            || rawBufferAppendText(buffer: projectedRecords, text: record) != 0 {
            compilerSourceWorkTableStore(work: work, row: readyRow, column: compilerSourceWorkStatusColumn(), value: compilerSourceWorkStatusFailed())
            compilerSourceWorkTableStore(work: work, row: readyRow, column: compilerSourceWorkLifecycleColumn(), value: compilerSourceWorkLifecycleCancelled())
            valid: false
        } else {
            if compilerSourceWorkTableStore(work: work, row: readyRow, column: compilerSourceWorkStatusColumn(), value: compilerSourceWorkStatusRendered()) != 0 { valid: false }
            if compilerSourceWorkTableStore(work: work, row: readyRow, column: compilerSourceWorkLifecycleColumn(), value: compilerSourceWorkLifecycleCompleted()) != 0 { valid: false }
            if rawBufferAppendText(buffer: traceBuffer, text: "transition\(tab)identity=\(identity)\(tab)from=running\(tab)to=completed\(newline)") != 0 { valid: false }
            renderedCount: renderedCount + 1
        }
        readyRow: compilerSourceWorkLowestReadyRow(work: work)
    }
    if renderedCount != fileCount { valid: false }

    state committedCount: Int(0)
    state commitRow: Int(compilerSourceWorkLowestCommitRow(work: work))
    while valid && commitRow >= 0 {
        let identity: Int(compilerIntTableValue(table: work, row: commitRow, column: compilerSourceWorkIdentityColumn()))
        let commitIdentity: Int(compilerIntTableValue(table: work, row: commitRow, column: compilerSourceWorkCommitIdentityColumn()))
        if commitIdentity != committedCount { valid: false }
        let record: String(compilerSourceInventoryFileRecordForValidStore(source: source, store: store, fileID: identity))
        if valid && rawBufferAppendText(buffer: committedRecords, text: record) != 0 { valid: false }
        if valid && compilerSourceWorkTableStore(work: work, row: commitRow, column: compilerSourceWorkStatusColumn(), value: compilerSourceWorkStatusCommitted()) != 0 { valid: false }
        if valid && rawBufferAppendText(buffer: traceBuffer, text: "commit\(tab)identity=\(identity)\(tab)commitIdentity=\(commitIdentity)\(tab)status=committed\(newline)") != 0 { valid: false }
        if valid { committedCount: committedCount + 1 }
        commitRow: compilerSourceWorkLowestCommitRow(work: work)
    }
    if committedCount != fileCount { valid: false }

    let projectedOutput: String(compilerCoreRawBufferMaterializeAndDestroy(buffer: projectedRecords))
    let committedOutput: String(compilerCoreRawBufferMaterializeAndDestroy(buffer: committedRecords))
    let trace: String(compilerCoreRawBufferMaterializeAndDestroy(buffer: traceBuffer))
    if projectedOutput != committedOutput { valid: false }
    if compilerIntTableDestroy(table: work) != 0 { valid: false }
    return CompilerSourceScheduleResult(output: committedOutput, trace: trace, isValid: valid)
}

function compilerSourceInventoryFileRecordsDirectForValidStore(source: String, store: CompilerSourceStore): String {
    state output: String("")
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        output: "\(output)\(compilerSourceInventoryFileRecordForValidStore(source: source, store: store, fileID: fileID))"
        fileID: fileID + 1
    }
    return output
}

function compilerSourceInventoryFileRecords(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return compilerNativeDiagnostic(kind: String("invalidSourceFileTable"))
    }

    let scheduled: CompilerSourceScheduleResult(compilerSourceInventoryScheduleForValidStore(source: source, store: store))
    let direct: String(compilerSourceInventoryFileRecordsDirectForValidStore(source: source, store: store))
    let destroyStatus: Int(compilerSourceStoreDestroy(store: store))
    if destroyStatus != 0 { return compilerNativeDiagnostic(kind: String("sourceInventoryOwnershipFailure")) }
    if !scheduled.isValid { return compilerNativeDiagnostic(kind: String("invalidSourceInventorySchedule")) }
    if scheduled.output != direct { return compilerNativeDiagnostic(kind: String("sourceInventoryScheduleMismatch")) }
    return scheduled.output
}

function compilerSourceScheduleTrace(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return compilerNativeDiagnostic(kind: String("invalidSourceFileTable"))
    }
    let scheduled: CompilerSourceScheduleResult(compilerSourceInventoryScheduleForValidStore(source: source, store: store))
    let destroyStatus: Int(compilerSourceStoreDestroy(store: store))
    if destroyStatus != 0 { return compilerNativeDiagnostic(kind: String("sourceInventoryOwnershipFailure")) }
    if !scheduled.isValid { return compilerNativeDiagnostic(kind: String("invalidSourceInventorySchedule")) }
    return scheduled.trace
}

function compilerSourceInventoryFileCount(source: String): Int {
    let markerCount: Int(compilerSourceInventoryFileCountFromMarker(source: source, marker: compilerSourceDecodeNextMarker(source: source, start: 0), fileCount: 0))
    if markerCount == 0 {
        return 1
    }
    return markerCount
}

function compilerSourceInventoryFileCountFromMarker(source: String, marker: CompilerSourceMarker, fileCount: Int): Int {
    if !marker.isValid {
        return 0 - 1
    }
    if !marker.found {
        return fileCount
    }
    let nextMarker: CompilerSourceMarker(compilerSourceDecodeNextMarker(source: source, start: marker.contentStart))
    return compilerSourceInventoryFileCountFromMarker(source: source, marker: nextMarker, fileCount: fileCount + 1)
}

function compilerSourceFileMarker(): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    return "compilerSourceFile\(slash)t"
}

function compilerSourceMarkerNotFound(sourceLength: Int): CompilerSourceMarker {
    return CompilerSourceMarker(found: false, isValid: true, markerStart: sourceLength, markerEnd: sourceLength, role: compilerSourceRoleProject(), pathStart: 0, pathEnd: 0, contentStart: sourceLength, contentEnd: sourceLength)
}

function compilerSourceMarkerInvalid(markerStart: Int): CompilerSourceMarker {
    return CompilerSourceMarker(found: true, isValid: false, markerStart: markerStart, markerEnd: markerStart, role: 0 - 1, pathStart: markerStart, pathEnd: markerStart, contentStart: markerStart, contentEnd: markerStart)
}

function compilerSourceMarkerPathIsValid(source: String, start: Int, end: Int): Bool {
    if end <= start {
        return false
    }
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let encodedTab: String("\(slash)t")
    let path: String(stringSubstring(source: source, start: start, end: end))
    return stringIndexOf(source: path, needle: encodedTab, start: 0) >= stringLength(value: path)
        && stringIndexOf(source: path, needle: compilerCoreTabCharacter(), start: 0) >= stringLength(value: path)
}

function compilerSourceMarkerContentEnd(source: String, start: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    let nextCandidate: Int(compilerSourceNextMarkerCandidate(source: source, start: start))
    if nextCandidate < sourceLength {
        return nextCandidate
    }
    return sourceLength
}

function compilerSourceMarkerValid(source: String, markerStart: Int, markerEnd: Int, role: Int, pathStart: Int): CompilerSourceMarker {
    let contentStart: Int(markerEnd + 1)
    let contentEnd: Int(compilerSourceMarkerContentEnd(source: source, start: contentStart))
    return CompilerSourceMarker(found: true, isValid: true, markerStart: markerStart, markerEnd: markerEnd, role: role, pathStart: pathStart, pathEnd: markerEnd, contentStart: contentStart, contentEnd: contentEnd)
}

function compilerSourceDecodeNextMarker(source: String, start: Int): CompilerSourceMarker {
    let sourceLength: Int(stringLength(value: source))
    let marker: String(compilerSourceFileMarker())
    let candidate: Int(compilerSourceNextMarkerCandidate(source: source, start: start))
    if candidate >= sourceLength {
        return compilerSourceMarkerNotFound(sourceLength: sourceLength)
    }

    let newline: String(compilerCoreNewlineCharacter())
    if candidate > 0 && source.character(index: candidate - 1) != newline {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }
    let lineEnd: Int(stringIndexOf(source: source, needle: newline, start: candidate))
    if lineEnd >= sourceLength {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }

    let markerLength: Int(20)
    let fieldsStart: Int(candidate + markerLength)
    if fieldsStart >= lineEnd {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }

    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let encodedTab: String("\(slash)t")
    let rolePrefix: String("role=")
    let rolePathSeparator: String("\(encodedTab)path=")
    if hasRangePrefix(source: source, start: fieldsStart, prefix: rolePrefix) {
        let separator: Int(stringIndexOf(source: source, needle: rolePathSeparator, start: fieldsStart))
        let roleNameStart: Int(fieldsStart + 5)
        if separator >= lineEnd || separator <= roleNameStart {
            return compilerSourceMarkerInvalid(markerStart: candidate)
        }
        let roleName: String(stringSubstring(source: source, start: roleNameStart, end: separator))
        let role: Int(compilerSourceRoleFromName(name: roleName))
        if role < 0 {
            return compilerSourceMarkerInvalid(markerStart: candidate)
        }
        let pathStart: Int(separator + 7)
        if !compilerSourceMarkerPathIsValid(source: source, start: pathStart, end: lineEnd) {
            return compilerSourceMarkerInvalid(markerStart: candidate)
        }
        return compilerSourceMarkerValid(source: source, markerStart: candidate, markerEnd: lineEnd, role: role, pathStart: pathStart)
    }
    if stringIndexOf(source: source, needle: encodedTab, start: fieldsStart) < lineEnd
        || !compilerSourceMarkerPathIsValid(source: source, start: fieldsStart, end: lineEnd) {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }
    return compilerSourceMarkerValid(source: source, markerStart: candidate, markerEnd: lineEnd, role: compilerSourceRoleProject(), pathStart: fieldsStart)
}

function compilerSourceNextMarkerCandidate(source: String, start: Int): Int {
    let marker: String(compilerSourceFileMarker())
    let candidate: Int(stringIndexOf(source: source, needle: marker, start: start))
    return compilerSourceNextMarkerCandidateFromCandidate(source: source, marker: marker, candidate: candidate)
}

function compilerSourceNextMarkerCandidateFromCandidate(source: String, marker: String, candidate: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    if candidate >= sourceLength {
        return sourceLength
    }
    if candidate == 0 || source.character(index: candidate - 1) == compilerCoreNewlineCharacter() {
        return candidate
    }
    return compilerSourceNextMarkerCandidateFromCandidate(source: source, marker: marker, candidate: stringIndexOf(source: source, needle: marker, start: candidate + 1))
}

function compilerNativeSourceSetLLVMTextForValidIndex(source: String, declarationTables: CompilerSyntaxTables, executionIndex: CompilerDeclarationIndex): String {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("macroExecution.begin"))
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: declarationTables, index: executionIndex))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("macroExecution.end"))
    let familyMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    state output: String("")
    if execution.status != 0 {
        output: compilerMacroRenderExecutionError(tables: declarationTables, result: execution)
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
    } else {
        if compilerGraphDeltaCommitGeneratedDeclarations(tables: declarationTables, delta: execution.graphDelta) != 0 {
            compilerMacroRecordGeneratedFunctionCommitDiagnostic(tables: declarationTables, delta: execution.graphDelta)
            output: compilerMacroRenderDiagnostics(tables: declarationTables)
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
            compilerDeclarationIndexDestroy(index: executionIndex)
        } else {
            compilerDeclarationIndexDestroy(index: executionIndex)
            if compilerMemoryBuildMacroFamilyRepresentations(tables: declarationTables, memory: familyMemory) != 0
                || !compilerMemoryMacroFamilyRepresentationsAreValid(tables: declarationTables, memory: familyMemory) {
                output: compilerNativeDiagnostic(kind: String("invalidMacroFamilyMemoryGraph"))
            } else {
                compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("llvmPipeline.begin"))
                let combinedProgram: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
                output: compilerCoreLLVMNativeEntryTextForProgram(program: combinedProgram, declarationTables: declarationTables, expansionDelta: execution.graphDelta)
                compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("llvmPipeline.end"))
            }
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
        }
    }
    if compilerMemoryGraphDestroy(memory: familyMemory) != 0 { return compilerNativeDiagnostic(kind: String("memoryOwnershipFailure")) }
    return output
}

function compilerNativeSourceSetLLVMTextForLinkedTables(source: String, declarationTables: CompilerSyntaxTables): String {
    let executionIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: declarationTables))
    state output: String("")
    if !executionIndex.isValid {
        compilerDeclarationIndexDestroy(index: executionIndex)
        output: String("compilerError\tkind=invalidDeclarationIndex\n")
    } else {
        output: compilerNativeSourceSetLLVMTextForValidIndex(source: source, declarationTables: declarationTables, executionIndex: executionIndex)
    }
    return output
}

function compilerNativeSourceSetLLVMText(source: String): String {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("sourceSet.begin"))
    let declarationTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: declarationTables))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("declarationCapture.end"))
    state output: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: declarationTables) {
        output: compilerInvalidTypedDeclarationsDiagnostic(tables: declarationTables)
    } else {
        let macroLinkStatus: Int(compilerMacroLink(tables: declarationTables))
        compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("macroLink.end"))
        if macroLinkStatus != 0 || compilerIntTableRowCount(table: declarationTables.macroDiagnostics) != 0 {
            output: compilerMacroRenderDiagnostics(tables: declarationTables)
        } else {
            output: compilerNativeSourceSetLLVMTextForLinkedTables(source: source, declarationTables: declarationTables)
        }
    }
    compilerSyntaxTablesDestroy(tables: declarationTables)
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("sourceSet.end"))
    return output
}

function compilerNativeSourceSetProgramForLLVM(source: String): CompilerProgram {
    let emptyBlock: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(source: source, hasMainBlock: false, mainAttributeStart: 0, mainBlock: emptyBlock, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: String(""), declarationSummary: String(""))
}

function compilerNativeDiagnostic(kind: String): String {
    return "compilerError\(compilerCoreTabCharacter())kind=\(kind)\(compilerCoreNewlineCharacter())"
}

function compilerNativeOutputIsError(output: String): Bool {
    return hasRangePrefix(source: output, start: 0, prefix: String("compilerError"))
}

function compilerNativeOutputExitCode(output: String): Int {
    if compilerNativeOutputIsError(output: output) { return 65 }
    return 0
}

function parseCompilerProgramForLLVMNamedBodies(source: String, bodyFunctionNames: String): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: source, bodyFunctionNames: bodyFunctionNames))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function compilerCoreProgramWithoutMain(source: String, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    let blockFallback: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(
        source: source,
        hasMainBlock: false,
        mainAttributeStart: 0,
        mainBlock: blockFallback,
        mainStatementRecords: String(""),
        mainStatementSummary: String(""),
        declarationRecords: parsedDeclarations.records,
        declarationSummary: parsedDeclarations.declarationSummary
    )
}

function compilerCoreSymbolSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreSymbolSummaryForProgram(program: program)
}

function compilerCoreTypeSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreTypeSummaryForProgram(program: program)
}

function parseCompilerTopLevelDeclarations(source: String): CompilerParsedDeclarations {
    return parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: source, includeFunctionBodies: false)
}

function compilerCoreDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.declarationSummary
}

function compilerCoreFunctionDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.functionSummary
}

function compilerCursorPeek(cursor: CompilerTokenCursor): Optional<RangeLexedToken> {
    return lexNextRangeToken(source: cursor.source, start: cursor.index)
}

function compilerCursorAdvance(cursor: CompilerTokenCursor, token: RangeLexedToken): CompilerTokenCursor {
    return CompilerTokenCursor(source: cursor.source, index: token.end)
}

function compilerFallbackToken(cursor: CompilerTokenCursor): RangeLexedToken {
    return RangeLexedToken(kind: .eof, start: cursor.index, end: cursor.index, text: String(""))
}

function compilerCoreParseBalancedRange(cursor: CompilerTokenCursor, leftKind: RangeTokenKind, rightKind: RangeTokenKind): Optional<CompilerSourceRange> {
    let maybeLeftToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeftToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let leftToken: RangeLexedToken(maybeLeftToken ?? fallbackToken)
    if leftToken.kind != leftKind {
        return nil
    }

    return compilerCoreParseBalancedRangeAfterLeft(cursor: cursor, leftToken: leftToken, leftKind: leftKind, rightKind: rightKind)
}

function compilerCoreParseBalancedRangeAfterLeft(cursor: CompilerTokenCursor, leftToken: RangeLexedToken, leftKind: RangeTokenKind, rightKind: RangeTokenKind): Optional<CompilerSourceRange> {
    let bodyCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: leftToken))
    return compilerCoreParseBalancedRangeScanning(cursor: bodyCursor, rangeStart: leftToken.end, leftKind: leftKind, rightKind: rightKind, depth: 1)
}

function compilerCoreParseBalancedRangeScanning(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, depth: Int): Optional<CompilerSourceRange> {
    state scanCursor: CompilerTokenCursor(cursor)
    state scanDepth: Int(depth)

    while true {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanCursor))
        if maybeToken == nil {
            return nil
        }

        let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanCursor))
        let token: RangeLexedToken(maybeToken ?? tokenFallback)
        if compilerCoreTokenKindEquals(token: token, kind: leftKind) {
            scanDepth: scanDepth + 1
        } else if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
            scanDepth: scanDepth - 1
            if scanDepth == 0 {
                return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
            }
        }
        scanCursor: compilerCursorAdvance(cursor: scanCursor, token: token)
    }

    return nil
}

function compilerCoreParseBalancedRangeScanningToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, depth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextDepth: Int(compilerCoreBalancedRangeNextDepth(token: token, leftKind: leftKind, rightKind: rightKind, depth: depth))
    return compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
        return compilerCoreParseBalancedRangeClosingToken(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
    }

    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreTokenKindEquals(token: RangeLexedToken, kind: RangeTokenKind): Bool {
    return compilerCoreRangeTokenKind(token: token) == kind
}

function compilerCoreRangeTokenKind(token: RangeLexedToken): RangeTokenKind {
    return token.kind
}

function compilerCoreRangeTokenText(token: RangeLexedToken): String {
    return token.text
}

function compilerCoreRangeTokenStart(token: RangeLexedToken): Int {
    return token.start
}

function compilerCoreRangeTokenEnd(token: RangeLexedToken): Int {
    return token.end
}

function compilerCoreParseBalancedRangeClosingToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if nextDepth == 0 {
        return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
    }
    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeContinue(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
    return compilerCoreParseBalancedRangeScanning(cursor: nextCursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, depth: nextDepth)
}

function compilerCoreBalancedRangeNextDepth(token: RangeLexedToken, leftKind: RangeTokenKind, rightKind: RangeTokenKind, depth: Int): Int {
    if compilerCoreRangeTokenKind(token: token) == leftKind {
        return depth + 1
    }
    if compilerCoreRangeTokenKind(token: token) == rightKind {
        return depth - 1
    }
    return depth
}

function compilerCoreParseTypeReference(cursor: CompilerTokenCursor): Optional<CompilerTypeReference> {
    return compilerCoreParseTypeReferenceWithEnd(cursor: cursor, end: stringLength(value: cursor.source))
}

function compilerCoreParseMacroSurfaceTypeReference(cursor: CompilerTokenCursor): Optional<CompilerTypeReference> {
    let maybeFirst: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: cursor))
    if maybeFirst == nil { return nil }
    let firstFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: cursor.index, end: cursor.index))
    let first: CompilerTypeReference(maybeFirst ?? firstFallback)
    state surfaceEnd: Int(first.end)
    while true {
        let separatorCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: surfaceEnd))
        let maybeSeparator: Optional<RangeLexedToken>(compilerCursorPeek(cursor: separatorCursor))
        if maybeSeparator == nil {
            return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: first.start, end: surfaceEnd), start: first.start, end: surfaceEnd)
        }
        let separatorFallback: RangeLexedToken(compilerFallbackToken(cursor: separatorCursor))
        let separator: RangeLexedToken(maybeSeparator ?? separatorFallback)
        if separator.kind != .ampersand && separator.kind != .pipe {
            return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: first.start, end: surfaceEnd), start: first.start, end: surfaceEnd)
        }
        let nextCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: separatorCursor, token: separator))
        let maybeNext: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: nextCursor))
        if maybeNext == nil { return nil }
        let nextFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: nextCursor.index, end: nextCursor.index))
        let next: CompilerTypeReference(maybeNext ?? nextFallback)
        surfaceEnd: next.end
    }
    return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: first.start, end: surfaceEnd), start: first.start, end: surfaceEnd)
}

function compilerCoreParseTypeReferenceWithEnd(cursor: CompilerTokenCursor, end: Int): Optional<CompilerTypeReference> {
    let maybeFirstToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeFirstToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let firstToken: RangeLexedToken(maybeFirstToken ?? fallbackToken)
    if firstToken.start >= end {
        return nil
    }
    if firstToken.kind == .leftParen {
        let maybeInputs: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftParen, rightKind: .rightParen))
        if maybeInputs == nil { return nil }
        let inputsFallback: CompilerSourceRange(CompilerSourceRange(start: firstToken.end, end: firstToken.end, next: firstToken.end))
        let inputs: CompilerSourceRange(maybeInputs ?? inputsFallback)
        let arrowCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: inputs.next))
        let maybeArrow: Optional<RangeLexedToken>(compilerCursorPeek(cursor: arrowCursor))
        if maybeArrow == nil { return nil }
        let arrowFallback: RangeLexedToken(compilerFallbackToken(cursor: arrowCursor))
        let arrow: RangeLexedToken(maybeArrow ?? arrowFallback)
        if arrow.kind != .arrow || arrow.end >= end { return nil }
        let resultCursor: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: arrow.end))
        let maybeResult: Optional<CompilerTypeReference>(compilerCoreParseTypeReferenceWithEnd(cursor: resultCursor, end: end))
        if maybeResult == nil { return nil }
        let resultFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: arrow.end, end: arrow.end))
        let result: CompilerTypeReference(maybeResult ?? resultFallback)
        return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: firstToken.start, end: result.end), start: firstToken.start, end: result.end)
    }
    if firstToken.kind != .identifier && firstToken.kind != .leftBracket && firstToken.kind != .macroAttribute {
        return nil
    }

    let initialState: CompilerTypeReferenceParseState(compilerCoreTypeReferenceInitialState(cursor: cursor, firstToken: firstToken))
    let parsedState: CompilerTypeReferenceParseState(compilerCoreParseTypeReferenceScanningUntil(parseState: initialState, end: end))
    return compilerCoreTypeReferenceFromState(firstToken: firstToken, parseState: parsedState)
}

function compilerCoreTypeReferenceInitialState(cursor: CompilerTokenCursor, firstToken: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: cursor.index))
    return CompilerTypeReferenceParseState(output: String(""), typeEnd: firstToken.start, cursor: cursorState, genericDepth: 0, arrayDepth: 0, consumedToken: false, keepScanning: true)
}

function compilerCoreParseTypeReferenceScanning(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return compilerCoreParseTypeReferenceScanningUntil(parseState: parseState, end: stringLength(value: parseState.cursor.source))
}

function compilerCoreParseTypeReferenceScanningUntil(parseState: CompilerTypeReferenceParseState, end: Int): CompilerTypeReferenceParseState {
    state scanState: CompilerTypeReferenceParseState(CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: parseState.keepScanning))
    while scanState.keepScanning {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanState.cursor))
        if maybeToken == nil {
            scanState: compilerCoreTypeReferenceStop(parseState: scanState)
        } else {
            let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanState.cursor))
            let token: RangeLexedToken(maybeToken ?? tokenFallback)
            if token.start >= end {
                scanState: compilerCoreTypeReferenceStop(parseState: scanState)
            } else {
                scanState: compilerCoreParseTypeReferenceToken(parseState: scanState, token: token)
            }
        }
    }
    return scanState
}

function compilerCoreTypeReferenceFromState(firstToken: RangeLexedToken, parseState: CompilerTypeReferenceParseState): Optional<CompilerTypeReference> {
    if !parseState.consumedToken {
        return nil
    }

    if parseState.genericDepth != 0 {
        return nil
    }

    if parseState.arrayDepth != 0 {
        return nil
    }

    return CompilerTypeReference(text: parseState.output, start: firstToken.start, end: parseState.typeEnd)
}

function compilerCoreParseTypeReferenceToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == .identifier {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .integer && parseState.genericDepth > 0 {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .macroAttribute && (!parseState.consumedToken || parseState.arrayDepth > 0 || parseState.genericDepth > 0) {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .dot {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("."), genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .less {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("<"), genericDelta: 1, arrayDelta: 0)
    }
    return compilerCoreParseTypeReferenceTokenPunctuation(parseState: parseState, token: token)
}

function compilerCoreParseTypeReferenceTokenPunctuation(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == .greater {
        return compilerCoreTypeReferenceCloseGeneric(parseState: parseState, token: token)
    }
    if token.kind == .leftBracket {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("["), genericDelta: 0, arrayDelta: 1)
    }
    if token.kind == .rightBracket {
        return compilerCoreTypeReferenceCloseArray(parseState: parseState, token: token)
    }
    if token.kind == .comma {
        return compilerCoreTypeReferenceComma(parseState: parseState, token: token)
    }
    if token.kind == .question {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("?"), genericDelta: 0, arrayDelta: 0)
    }
    return compilerCoreTypeReferenceStop(parseState: parseState)
}

function compilerCoreTypeReferenceAppend(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken, text: String, genericDelta: Int, arrayDelta: Int): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)\(text)", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth + genericDelta, arrayDepth: parseState.arrayDepth + arrayDelta, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseGeneric(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseGenericToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseArray(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseArrayToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseGenericToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)>", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth - 1, arrayDepth: parseState.arrayDepth, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseArrayToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)]", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth - 1, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceComma(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 && parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String(","), genericDelta: 0, arrayDelta: 0)
}

function compilerCoreTypeReferenceStop(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: false)
}

function parseCompilerCallArgumentsCore(source: String, start: Int, end: Int): CompilerCallArguments {
    state output: String("")
    state records: String("")
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    state argumentIndex: Int(0)

    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.start >= end {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        if token.kind == .comma {
            cursor: compilerCursorAdvance(cursor: cursor, token: token)
        } else {
            state label: String("")
            state labelStart: Int(0 - 1)
            state labelEnd: Int(0 - 1)
            state expressionStart: Int(0)
            expressionStart: token.start
            if token.kind == .identifier || token.kind == .keyword {
                let afterLabelCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
                let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterLabelCursor))
                if maybeColon != nil {
                    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: afterLabelCursor))
                    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
                    if colonToken.kind == .colon {
                        label: token.text
                        labelStart: token.start
                        labelEnd: token.end
                        expressionStart: colonToken.end
                    }
                }
            }

            let maybeArgumentExpression: Optional<CompilerExpression>(parseCompilerExpression(source: source, start: expressionStart, limit: end))
            if maybeArgumentExpression == nil {
                return CompilerCallArguments(summary: output, records: records, start: start, end: end)
            }
            let argumentFallback: CompilerExpression(compilerCoreMissingExpression(start: expressionStart))
            let expression: CompilerExpression(maybeArgumentExpression ?? argumentFallback)
            if label == String("") {
                output: "\(output)argument\(argumentIndex)=\(expression.summary);"
            } else {
                output: "\(output)argument\(argumentIndex).\(label)=\(expression.summary);"
            }
            records: "\(records)\(compilerCoreCallArgumentRecord(index: argumentIndex, label: label, expressionRecord: expression.record, expressionSummary: expression.summary))"
            argumentIndex: argumentIndex + 1
            cursor: CompilerTokenCursor(source: source, index: expression.end)
        }
    }

    return CompilerCallArguments(summary: output, records: records, start: start, end: end)
}

function compilerCoreMissingFunctionParameterTokenStep(source: String, index: Int, nextIndex: Int, keepScanning: Bool): CompilerFunctionParameterTokenStep {
    let missingToken: RangeLexedToken(RangeLexedToken(kind: .eof, start: index, end: index, text: String("")))
    let missingType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: index, end: index))
    return CompilerFunctionParameterTokenStep(found: false, keepScanning: keepScanning, nameToken: missingToken, typeReference: missingType, nextIndex: nextIndex)
}

function compilerCoreParseFunctionParameterToken(source: String, end: Int, token: RangeLexedToken): CompilerFunctionParameterTokenStep {
    if token.start >= end {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }
    if token.kind == .comma {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }
    if token.kind != .identifier && token.kind != .keyword {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    state nameToken: RangeLexedToken(token)
    let firstCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: token.start))
    state colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: firstCursor, token: token))
    state maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    state colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind == .identifier || colonToken.kind == .keyword {
        nameToken: colonToken
        colonCursor: compilerCursorAdvance(cursor: colonCursor, token: nameToken)
        maybeColon: compilerCursorPeek(cursor: colonCursor)
        if maybeColon == nil {
            return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: nameToken.end, keepScanning: false)
        }
        colonToken: maybeColon ?? colonFallback
    }
    if colonToken.kind != .colon {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    return CompilerFunctionParameterTokenStep(found: true, keepScanning: true, nameToken: nameToken, typeReference: typeReference, nextIndex: typeReference.end)
}

function compilerCoreMissingStoredMemberParseStep(source: String, index: Int, nextIndex: Int, keepScanning: Bool): CompilerStoredMemberParseStep {
    let missingToken: RangeLexedToken(RangeLexedToken(kind: .eof, start: index, end: index, text: String("")))
    let missingType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: index, end: index))
    return CompilerStoredMemberParseStep(found: false, keepScanning: keepScanning, kindTag: 0 - 1, nameToken: missingToken, typeReference: missingType, nextIndex: nextIndex)
}

function compilerCoreParseStoredMemberTrailingRange(cursor: CompilerTokenCursor, isDerivedBody: Bool): Optional<CompilerSourceRange> {
    if isDerivedBody {
        return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftBrace, rightKind: .rightBrace)
    }
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftParen, rightKind: .rightParen)
}

function compilerCoreParseStoredMemberToken(source: String, end: Int, token: RangeLexedToken): CompilerStoredMemberParseStep {
    if token.start >= end {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }
    if token.kind != .keyword || (token.text != String("let") && token.text != String("state") && token.text != String("binding") && token.text != String("derived")) {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let tokenCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: token.start))
    let nameCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: tokenCursor, token: token))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: nameCursor))
    if maybeName == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let nameFallback: RangeLexedToken(compilerFallbackToken(cursor: nameCursor))
    let nameToken: RangeLexedToken(maybeName ?? nameFallback)
    if nameToken.kind != .identifier && nameToken.kind != .keyword {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: nameCursor, token: nameToken))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != .colon {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    state nextIndex: Int(typeReference.end)
    let initializerCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: typeReference.end))
    let maybeInitializer: Optional<RangeLexedToken>(compilerCursorPeek(cursor: initializerCursor))
    if maybeInitializer != nil {
        let initializerFallback: RangeLexedToken(compilerFallbackToken(cursor: initializerCursor))
        let initializer: RangeLexedToken(maybeInitializer ?? initializerFallback)
        let initializerIsConstructor: Bool(token.text != String("derived") && initializer.kind == .leftParen)
        let initializerIsDerivedBody: Bool(token.text == String("derived") && initializer.kind == .leftBrace)
        if initializer.start < end && (initializerIsConstructor || initializerIsDerivedBody) {
            let maybeInitializerRange: Optional<CompilerSourceRange>(compilerCoreParseStoredMemberTrailingRange(cursor: initializerCursor, isDerivedBody: initializerIsDerivedBody))
            if maybeInitializerRange == nil {
                return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: initializer.end, keepScanning: false)
            }
            let initializerRangeFallback: CompilerSourceRange(CompilerSourceRange(start: initializer.end, end: initializer.end, next: initializer.end))
            let initializerRange: CompilerSourceRange(maybeInitializerRange ?? initializerRangeFallback)
            if initializerRange.next > end {
                return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: initializerRange.next, keepScanning: false)
            }
            nextIndex: initializerRange.next
        }
    }
    state memberKind: Int(compilerSyntaxMemberKindLet())
    if token.text == String("state") { memberKind: compilerSyntaxMemberKindState() }
    if token.text == String("binding") { memberKind: compilerSyntaxMemberKindBinding() }
    if token.text == String("derived") { memberKind: compilerSyntaxMemberKindDerived() }
    return CompilerStoredMemberParseStep(found: true, keepScanning: true, kindTag: memberKind, nameToken: nameToken, typeReference: typeReference, nextIndex: nextIndex)
}

function compilerCoreParseDeclarationNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.start))
    cursor: CompilerTokenCursor(source: source, index: keyword.end)
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    if nameToken.kind != .identifier {
        return nil
    }

    return nameToken
}

function compilerCoreParseMacroNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil { return nil }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    if nameToken.kind != .identifier && nameToken.kind != .keyword { return nil }
    return nameToken
}

function compilerCoreTokenCanNameFunction(token: RangeLexedToken): Bool {
    return token.kind == .identifier
        || token.kind == .ampersand
        || token.kind == .andAnd
        || token.kind == .asterisk
        || token.kind == .bang
        || token.kind == .bangEqual
        || token.kind == .equalEqual
        || token.kind == .greater
        || token.kind == .greaterEqual
        || token.kind == .less
        || token.kind == .lessEqual
        || token.kind == .minus
        || token.kind == .orOr
        || token.kind == .percent
        || token.kind == .pipe
        || token.kind == .plus
        || token.kind == .questionQuestion
        || token.kind == .slash
}

function compilerCoreParseFunctionNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil { return nil }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    if !compilerCoreTokenCanNameFunction(token: nameToken) { return nil }
    return nameToken
}

function compilerCoreParseAngleRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    let maybeLeft: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeft == nil { return nil }
    let fallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let left: RangeLexedToken(maybeLeft ?? fallback)
    if left.kind != .less { return nil }
    state scanCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: left))
    state depth: Int(1)
    while true {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanCursor))
        if maybeToken == nil { return nil }
        let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanCursor))
        let token: RangeLexedToken(maybeToken ?? tokenFallback)
        if token.kind == .less {
            depth: depth + 1
        } else if token.kind == .greater {
            depth: depth - 1
            if depth == 0 {
                return CompilerSourceRange(start: left.start, end: token.end, next: token.end)
            }
        }
        scanCursor: compilerCursorAdvance(cursor: scanCursor, token: token)
    }
    return nil
}

function compilerCoreParseMacroApplicationParts(source: String, macroToken: RangeLexedToken): Optional<CompilerMacroApplicationParts> {
    let invalidRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: compilerCoreRangeTokenEnd(token: macroToken)))
    state genericRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    state argumentRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    state bodyRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    state nextIndex: Int(compilerCoreRangeTokenEnd(token: macroToken))
    let maybeNext: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeNext != nil {
        let genericTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeNext ?? genericTokenFallback)
        if token.kind == .less {
            let syntheticName: RangeLexedToken(RangeLexedToken(kind: .identifier, start: compilerCoreRangeTokenStart(token: macroToken) + 1, end: compilerCoreRangeTokenEnd(token: macroToken), text: stringSliceUnchecked(source: source, start: compilerCoreRangeTokenStart(token: macroToken) + 1, end: compilerCoreRangeTokenEnd(token: macroToken))))
            let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: syntheticName))
            if maybeGeneric == nil { return nil }
            let genericFallback: CompilerSourceRange(CompilerSourceRange(start: token.start, end: token.end, next: token.end))
            genericRange: maybeGeneric ?? genericFallback
            nextIndex: genericRange.next
        }
    }
    let argumentCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nextIndex))
    let maybeArgumentToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: argumentCursor))
    if maybeArgumentToken != nil {
        let argumentTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: argumentCursor))
        let argumentToken: RangeLexedToken(maybeArgumentToken ?? argumentTokenFallback)
        if argumentToken.kind == .leftParen {
            let maybeArgument: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: argumentCursor, leftKind: .leftParen, rightKind: .rightParen))
            if maybeArgument == nil { return nil }
            let argumentFallback: CompilerSourceRange(CompilerSourceRange(start: argumentToken.end, end: argumentToken.end, next: argumentToken.end))
            argumentRange: maybeArgument ?? argumentFallback
            nextIndex: argumentRange.next
        }
    }
    let bodyCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nextIndex))
    let maybeBodyToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: bodyCursor))
    if maybeBodyToken != nil {
        let bodyTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: bodyCursor))
        let bodyToken: RangeLexedToken(maybeBodyToken ?? bodyTokenFallback)
        if bodyToken.kind == .leftBrace {
            let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: .leftBrace, rightKind: .rightBrace))
            if maybeBody == nil { return nil }
            let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: bodyToken.end, end: bodyToken.end, next: bodyToken.end))
            bodyRange: maybeBody ?? bodyFallback
            nextIndex: bodyRange.next
        }
    }
    return CompilerMacroApplicationParts(macroToken: macroToken, genericRange: genericRange, argumentRange: argumentRange, bodyRange: bodyRange, nextIndex: nextIndex)
}

function compilerCoreParseMacroCapabilityHeader(source: String, bodyRange: CompilerSourceRange): CompilerMacroCapabilityHeader {
    let invalidRange: CompilerSourceRange(CompilerSourceRange(start: bodyRange.start, end: bodyRange.start, next: bodyRange.start))
    if bodyRange.end <= bodyRange.start {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let fallback: RangeLexedToken(RangeLexedToken(kind: .eof, start: bodyRange.start, end: bodyRange.start, text: String("")))
    let firstMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: bodyRange.start))
    if firstMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDeclarative(), headerRange: invalidRange, executableBodyRange: bodyRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let first: RangeLexedToken(firstMaybe ?? fallback)
    let comma1Maybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: first.end))
    if (first.kind != .identifier && first.kind != .keyword) || comma1Maybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDeclarative(), headerRange: invalidRange, executableBodyRange: bodyRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let comma1: RangeLexedToken(comma1Maybe ?? fallback)
    if comma1.kind != .comma {
        if comma1.text == String("in") {
            return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: CompilerSourceRange(start: first.start, end: comma1.end, next: comma1.end), executableBodyRange: CompilerSourceRange(start: comma1.end, end: bodyRange.end, next: bodyRange.end), targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
        }
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDeclarative(), headerRange: invalidRange, executableBodyRange: bodyRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let secondMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: comma1.end))
    if secondMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let second: RangeLexedToken(secondMaybe ?? fallback)
    let comma2Maybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: second.end))
    if (second.kind != .identifier && second.kind != .keyword) || comma2Maybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let comma2: RangeLexedToken(comma2Maybe ?? fallback)
    if comma2.text == String("in") {
        if first.text == second.text {
            return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDuplicate(), headerRange: CompilerSourceRange(start: first.start, end: comma2.end, next: comma2.end), executableBodyRange: CompilerSourceRange(start: comma2.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: CompilerSourceRange(start: second.start, end: second.end, next: second.end), graphRange: invalidRange)
        }
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: CompilerSourceRange(start: first.start, end: comma2.end, next: comma2.end), executableBodyRange: CompilerSourceRange(start: comma2.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: CompilerSourceRange(start: second.start, end: second.end, next: second.end), graphRange: invalidRange)
    }
    if comma2.kind != .comma {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let thirdMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: comma2.end))
    if thirdMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let third: RangeLexedToken(thirdMaybe ?? fallback)
    let inMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: third.end))
    if (third.kind != .identifier && third.kind != .keyword) || inMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let inToken: RangeLexedToken(inMaybe ?? fallback)
    if inToken.text != String("in") {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    if first.text == second.text || first.text == third.text || second.text == third.text {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDuplicate(), headerRange: CompilerSourceRange(start: first.start, end: inToken.end, next: inToken.end), executableBodyRange: CompilerSourceRange(start: inToken.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: CompilerSourceRange(start: second.start, end: second.end, next: second.end), graphRange: CompilerSourceRange(start: third.start, end: third.end, next: third.end))
    }
    return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: CompilerSourceRange(start: first.start, end: inToken.end, next: inToken.end), executableBodyRange: CompilerSourceRange(start: inToken.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: CompilerSourceRange(start: second.start, end: second.end, next: second.end), graphRange: CompilerSourceRange(start: third.start, end: third.end, next: third.end))
}

function compilerCoreParseMacroDeclarationParts(source: String, keyword: RangeLexedToken, visibility: Int, declarationStart: Int): Optional<CompilerMacroDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseMacroNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil { return nil }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: CompilerTokenCursor(source: source, index: compilerCoreRangeTokenEnd(token: keyword))))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    let invalidRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: nameToken)))
    state genericRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: nameToken)))
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        let genericFallback: CompilerSourceRange(CompilerSourceRange(start: compilerCoreRangeTokenEnd(token: nameToken), end: compilerCoreRangeTokenEnd(token: nameToken), next: compilerCoreRangeTokenEnd(token: nameToken)))
        genericRange: maybeGeneric ?? genericFallback
    }
    state parameterStart: Int(compilerCoreRangeTokenEnd(token: nameToken))
    if maybeGeneric != nil { parameterStart: genericRange.next }
    let parameterCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterStart))
    let maybeParameter: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: parameterCursor, leftKind: .leftParen, rightKind: .rightParen))
    if maybeParameter == nil { return nil }
    let parameterFallback: CompilerSourceRange(CompilerSourceRange(start: compilerCoreRangeTokenEnd(token: nameToken), end: compilerCoreRangeTokenEnd(token: nameToken), next: compilerCoreRangeTokenEnd(token: nameToken)))
    let parameterRange: CompilerSourceRange(maybeParameter ?? parameterFallback)
    let separatorCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterRange.next))
    let maybeSeparator: Optional<RangeLexedToken>(compilerCursorPeek(cursor: separatorCursor))
    if maybeSeparator == nil { return nil }
    let separatorFallback: RangeLexedToken(compilerFallbackToken(cursor: separatorCursor))
    let separator: RangeLexedToken(maybeSeparator ?? separatorFallback)
    state targetType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset()))
    state expansionType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: 0 - 1, end: 0 - 1))
    state hasExpansion: Bool(false)
    state bodyCursor: CompilerTokenCursor(separatorCursor)
    if separator.kind == .colon {
        let targetCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: separatorCursor, token: separator))
        let maybeTarget: Optional<CompilerTypeReference>(compilerCoreParseMacroSurfaceTypeReference(cursor: targetCursor))
        if maybeTarget == nil { return nil }
        let targetFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: targetCursor.index, end: targetCursor.index))
        targetType: maybeTarget ?? targetFallback
        bodyCursor: CompilerTokenCursor(source: source, index: targetType.end)
        let maybeArrow: Optional<RangeLexedToken>(compilerCursorPeek(cursor: bodyCursor))
        if maybeArrow != nil {
            let arrowFallback: RangeLexedToken(compilerFallbackToken(cursor: bodyCursor))
            let arrow: RangeLexedToken(maybeArrow ?? arrowFallback)
            if arrow.kind == .arrow {
                let expansionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: bodyCursor, token: arrow))
                let maybeExpansion: Optional<CompilerTypeReference>(compilerCoreParseMacroSurfaceTypeReference(cursor: expansionCursor))
                if maybeExpansion == nil { return nil }
                let expansionFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: expansionCursor.index, end: expansionCursor.index))
                expansionType: maybeExpansion ?? expansionFallback
                hasExpansion: true
                bodyCursor: CompilerTokenCursor(source: source, index: expansionType.end)
            }
        }
    } else if separator.kind == .arrow {
        let expansionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: separatorCursor, token: separator))
        let maybeExpansion: Optional<CompilerTypeReference>(compilerCoreParseMacroSurfaceTypeReference(cursor: expansionCursor))
        if maybeExpansion == nil { return nil }
        let expansionFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: expansionCursor.index, end: expansionCursor.index))
        expansionType: maybeExpansion ?? expansionFallback
        hasExpansion: true
        bodyCursor: CompilerTokenCursor(source: source, index: expansionType.end)
    } else {
        return nil
    }
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: .leftBrace, rightKind: .rightBrace))
    if maybeBody == nil { return nil }
    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: bodyCursor.index, end: bodyCursor.index, next: bodyCursor.index))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    let capabilityHeader: CompilerMacroCapabilityHeader(compilerCoreParseMacroCapabilityHeader(source: source, bodyRange: bodyRange))
    return CompilerMacroDeclarationParts(nameToken: nameToken, genericRange: genericRange, parameterRange: parameterRange, targetType: targetType, expansionType: expansionType, hasExpansionType: hasExpansion, bodyRange: bodyRange, capabilityStatus: capabilityHeader.status, capabilityHeaderRange: capabilityHeader.headerRange, executableBodyRange: capabilityHeader.executableBodyRange, targetCapabilityRange: capabilityHeader.targetRange, diagnosticsCapabilityRange: capabilityHeader.diagnosticsRange, graphCapabilityRange: capabilityHeader.graphRange, declarationStart: declarationStart, visibility: visibility)
}

function compilerCoreParseBodyRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftBrace, rightKind: .rightBrace)
}

function compilerCoreParseParameterRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftParen, rightKind: .rightParen)
}

function compilerCoreParseReturnTypeAfterParameters(source: String, parameterRange: CompilerSourceRange): Optional<CompilerTypeReference> {
    return compilerCoreParseReturnTypeAfterParametersWithEnd(source: source, parameterRange: parameterRange, fileEnd: stringLength(value: source))
}

function compilerCoreParseReturnTypeAfterParametersWithEnd(source: String, parameterRange: CompilerSourceRange, fileEnd: Int): Optional<CompilerTypeReference> {
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterRange.start))
    cursor: CompilerTokenCursor(source: source, index: parameterRange.next)
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeColon == nil {
        return CompilerTypeReference(text: String("Void"), start: parameterRange.next, end: parameterRange.next)
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != .colon {
        return CompilerTypeReference(text: String("Void"), start: parameterRange.next, end: parameterRange.next)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: colonToken))
    return compilerCoreParseTypeReferenceWithEnd(cursor: typeCursor, end: fileEnd)
}

function compilerCoreParseFunctionBodyAfterReturnType(source: String, returnType: CompilerTypeReference): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: returnType.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftBrace, rightKind: .rightBrace)
}

function compilerCoreParseConstructDeclarationParts(source: String, keyword: RangeLexedToken): Optional<CompilerConstructDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    state genericRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: nameToken.end))
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        let genericFallback: CompilerSourceRange(CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end))
        genericRange: maybeGeneric ?? genericFallback
    }
    let bodyCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: genericRange.next))
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: .leftBrace, rightKind: .rightBrace))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: genericRange.next, end: genericRange.next, next: genericRange.next))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    return CompilerConstructDeclarationParts(nameToken: nameToken, genericRange: genericRange, bodyRange: bodyRange)
}

function compilerCoreParseFunctionDeclarationParts(source: String, keyword: RangeLexedToken): Optional<CompilerFunctionDeclarationParts> {
    return compilerCoreParseFunctionDeclarationPartsWithEnd(source: source, keyword: keyword, fileEnd: stringLength(value: source))
}

function compilerCoreParseFunctionDeclarationPartsWithEnd(source: String, keyword: RangeLexedToken, fileEnd: Int): Optional<CompilerFunctionDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseFunctionNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    state genericRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: nameToken.end))
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        let genericFallback: CompilerSourceRange(CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end))
        genericRange: maybeGeneric ?? genericFallback
    }
    let parameterCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: genericRange.next))
    let maybeParameters: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: parameterCursor, leftKind: .leftParen, rightKind: .rightParen))
    if maybeParameters == nil {
        return nil
    }

    let parameterFallback: CompilerSourceRange(CompilerSourceRange(start: genericRange.next, end: genericRange.next, next: genericRange.next))
    let parameterRange: CompilerSourceRange(maybeParameters ?? parameterFallback)
    let maybeReturnType: Optional<CompilerTypeReference>(compilerCoreParseReturnTypeAfterParametersWithEnd(source: source, parameterRange: parameterRange, fileEnd: fileEnd))
    if maybeReturnType == nil {
        return nil
    }

    let returnTypeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: parameterRange.next, end: parameterRange.next))
    let returnType: CompilerTypeReference(maybeReturnType ?? returnTypeFallback)
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseFunctionBodyAfterReturnType(source: source, returnType: returnType))
    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: returnType.end, end: returnType.end, next: returnType.end))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    return CompilerFunctionDeclarationParts(nameToken: nameToken, genericRange: genericRange, parameterRange: parameterRange, returnType: returnType, bodyRange: bodyRange)
}

function compilerCoreLLVM(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreLLVMForProgram(program: program)
}

function compilerCoreLLVMSelectedHelperAuditTyped(tables: CompilerSyntaxTables, selection: CompilerFunctionSelection): CompilerLLVMHelperAudit {
    state audit: CompilerLLVMHelperAudit(CompilerLLVMHelperAudit(selectedCount: 0, lowerableCount: 0, excludedCount: 0, maxBodyLength: 0, maxBodyName: String(""), details: String("")))
    state declarationRow: Int(0)
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while declarationRow < declarationCount {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
            if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
                audit: compilerCoreLLVMSelectedHelperAuditAppendingTypedFunction(tables: tables, audit: audit, declarationRow: declarationRow, functionRow: functionRow)
            }
        }
        declarationRow: declarationRow + 1
    }
    return audit
}

function compilerCoreLLVMSelectedHelperAuditAppendingTypedFunction(tables: CompilerSyntaxTables, audit: CompilerLLVMHelperAudit, declarationRow: Int, functionRow: Int): CompilerLLVMHelperAudit {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let bodyStart: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 8))
    let bodyEnd: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 9))
    let bodyLength: Int(bodyEnd - bodyStart)
    let reason: String(compilerCoreTypedFunctionExclusionReason(tables: tables, functionRow: functionRow))
    state maxLength: Int(0)
    maxLength: audit.maxBodyLength
    state maxName: String("")
    maxName: audit.maxBodyName
    if bodyLength > maxLength {
        maxLength: bodyLength
        maxName: name
    }
    if reason == String("") {
        return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount + 1, excludedCount: audit.excludedCount, maxBodyLength: maxLength, maxBodyName: maxName, details: audit.details)
    }
    let detail: String("excluded\tname=\(name)\treason=\(reason)\tbodyLength=\(bodyLength)\n")
    return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount, excludedCount: audit.excludedCount + 1, maxBodyLength: maxLength, maxBodyName: maxName, details: "\(audit.details)\(detail)")
}

function compilerCoreTypedFunctionExclusionReason(tables: CompilerSyntaxTables, functionRow: Int): String {
    let fileID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 1))
    let bodyStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: functionRow, column: 8)))
    let bodyEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: functionRow, column: 9)))
    if bodyStart < 0 || bodyEnd < bodyStart || bodyEnd >= stringLength(value: tables.sourceStore.source) {
        return String("missingStatementRecords")
    }
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    if compilerCoreLLVMTypeNameForRangeType(typeName: returnType) == String("") {
        return String("unsupportedSignature")
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if compilerCoreLLVMTypeNameForRangeType(typeName: typeName) == String("") {
            return String("unsupportedSignature")
        }
        ordinal: ordinal + 1
    }
    return String("")
}

function compilerCoreLLVMHelperAuditFailure(audit: CompilerLLVMHelperAudit): String {
    return "compilerError\tkind=unsupportedReachableHelpers\tselectedCount=\(audit.selectedCount)\tlowerableCount=\(audit.lowerableCount)\texcludedCount=\(audit.excludedCount)\n\(audit.details)"
}

function compilerCoreLLVMPlaceholderCount(text: String): Int {
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    state sourceIndex: Int(0)
    state count: Int(0)

    while sourceIndex >= 0 {
        let matchIndex: Int(stringFindFrom(source: text, start: sourceIndex, needle: marker))
        if matchIndex < 0 {
            return count
        }
        count: count + 1
        sourceIndex: matchIndex + markerLength
    }

    return count
}

function compilerCoreLLVMPlaceholderDetails(text: String): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 4096, stride: 1))
    let materializedText: String(compilerCoreMaterializeLLVMText(text: text))
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    let textLength: Int(stringLength(value: materializedText))
    state sourceIndex: Int(0)
    state currentFunction: String("")

    while sourceIndex < textLength {
        state lineEnd: Int(stringFindFirstOf(source: materializedText, start: sourceIndex, characters: compilerCoreNewlineCharacter()))
        if lineEnd < 0 {
            lineEnd: textLength
        }
        let line: String(materializedText.substring(start: sourceIndex, end: lineEnd))
        if stringHasPrefix(source: line, start: 0, prefix: String("define ")) {
            let nameStart: Int(stringFindFrom(source: line, start: 0, needle: String("@")))
            let nameEnd: Int(stringFindFrom(source: line, start: nameStart + 1, needle: String("(")))
            if nameStart >= 0 && nameEnd > nameStart {
                currentFunction: line.substring(start: nameStart + 1, end: nameEnd)
            }
        }
        let markerStart: Int(stringFindFrom(source: line, start: 0, needle: marker))
        if markerStart >= 0 {
            state reasonStart: Int(markerStart + markerLength)
            while reasonStart < stringLength(value: line) && stringHasPrefix(source: line, start: reasonStart, prefix: String(" ")) {
                reasonStart: reasonStart + 1
            }
            let reason: String(line.substring(start: reasonStart, end: stringLength(value: line)))
            rawBufferAppendText(buffer: outputBuffer, text: "placeholder\tfunction=\(currentFunction)\treason=\(reason)")
            rawBufferAppendText(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
        }
        sourceIndex: lineEnd + 1
    }

    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMPlaceholderFailure(placeholderCount: Int, renderedText: String): String {
    let details: String(compilerCoreLLVMPlaceholderDetails(text: renderedText))
    return "compilerError\tkind=unsupportedReachableLowering\tplaceholderCount=\(placeholderCount)\(compilerCoreNewlineCharacter())\(details)"
}

function compilerCoreRenderLLVMEntryFunction(block: CompilerLLVMLoweredBlock): String {
    let llvmFunction: CompilerLLVMFunction(CompilerLLVMFunction(name: String("main"), returnType: String("i32"), parameterText: String(""), renderedBlocks: block.renderedBlocks, block: compilerCoreMainLLVMBasicBlock(block: block)))
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreLLVMNativeProgramText(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        let diagnostic: String(compilerInvalidTypedDeclarationsDiagnostic(tables: tables))
        compilerSyntaxTablesDestroy(tables: tables)
        return diagnostic
    }
    let macroLinkStatus: Int(compilerMacroLink(tables: tables))
    if macroLinkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
        let macroDiagnosticOutput: String(compilerMacroRenderDiagnostics(tables: tables))
        compilerSyntaxTablesDestroy(tables: tables)
        return macroDiagnosticOutput
    }
    let executionIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    if !executionIndex.isValid {
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return String("compilerError\tkind=invalidDeclarationIndex")
    }
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: executionIndex))
    if execution.status != 0 {
        let executionOutput: String(compilerMacroRenderExecutionError(tables: tables, result: execution))
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return executionOutput
    }
    if compilerGraphDeltaCommitGeneratedDeclarations(tables: tables, delta: execution.graphDelta) != 0 {
        compilerMacroRecordGeneratedFunctionCommitDiagnostic(tables: tables, delta: execution.graphDelta)
        let commitOutput: String(compilerMacroRenderDiagnostics(tables: tables))
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return commitOutput
    }
    compilerDeclarationIndexDestroy(index: executionIndex)
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreateWithGraphDelta(tables: tables, delta: execution.graphDelta))
    if !declarationIndex.isValid {
        compilerDeclarationIndexDestroy(index: declarationIndex)
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerSyntaxTablesDestroy(tables: tables)
        return String("compilerError\tkind=invalidExpansionOverlay")
    }
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let context: CompilerLLVMLoweringContext(CompilerLLVMLoweringContext(program: program, tables: $tables, declarationIndex: $declarationIndex))
    let reachability: CompilerReachableLLVMState(compilerReachableLLVMStateCreate(context: context))
    let output: String(compilerCoreLLVMNativeEntryTextForReachability(reachability: reachability))
    compilerReachableLLVMStateDestroy(reachability: reachability)
    compilerDeclarationIndexDestroy(index: declarationIndex)
    compilerGraphDeltaDestroy(delta: execution.graphDelta)
    compilerSyntaxTablesDestroy(tables: tables)
    return output
}

function compilerCoreLLVMNativeEntryTextForReachability(reachability: CompilerReachableLLVMState): String {
    state output: String("compilerError\tkind=invalidEntryReachability")
    let seedStatus: Int(compilerReachableLLVMStateSeedEntryRoots(reachability: reachability))
    state buildStatus: Int(0 - 1)
    if seedStatus != 0 {
        compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 50000 + seedStatus)
        output: "compilerError\tkind=invalidEntryReachability\tstage=\(seedStatus)"
    } else {
        buildStatus: compilerReachableLLVMStateBuildSelected(reachability: reachability)
    }
    if seedStatus == 0 && buildStatus != 0 {
        output: compilerReachableLLVMStateRender(reachability: reachability)
    }
    if seedStatus == 0 && buildStatus == 0 {
        state blockedSensitiveFunctionRow: Int(0)
        while buildStatus == 0 && blockedSensitiveFunctionRow < rawBufferCount(buffer: reachability.abiSensitiveFunctions) {
            if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: blockedSensitiveFunctionRow)
                && rawBufferLoadInt(buffer: reachability.abiSensitiveFunctions, index: blockedSensitiveFunctionRow) == 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockedSensitiveFunctionRow) != 1 {
                buildStatus: compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 200000 + blockedSensitiveFunctionRow)
                output: compilerReachableLLVMStateRender(reachability: reachability)
            }
            blockedSensitiveFunctionRow: blockedSensitiveFunctionRow + 1
        }
    }
    if seedStatus == 0 && buildStatus == 0 {
        let abiPlan: CompilerModuleABIPlan(compilerReachableLLVMStateABIPlan(reachability: reachability))
        let entryLowering: CompilerTypedBodyLowering(compilerCoreLLVMLowerEntryTyped(context: reachability.context, reachability: reachability, initialTemporaryIndex: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary()), abiPlan: abiPlan))
        if !entryLowering.isValid {
            output: "compilerError\tkind=invalidEntryLowering\tstage=\(entryLowering.failureStage)"
        } else if !compilerBodyTelemetryIsTypedOnly(telemetry: entryLowering.telemetry) {
            output: compilerBodyTelemetryTypedOnlyFailure(telemetry: entryLowering.telemetry, scope: String("entry"))
        } else {
            let mainText: String(compilerCoreRenderLLVMEntryFunction(block: entryLowering.block))
            output: compilerReachableLLVMStateRenderModule(reachability: reachability, usage: String(""), extraGlobals: entryLowering.renderedGlobals, extraRuntimeRequirements: entryLowering.runtimeRequirements, mainText: mainText)
        }
    }
    return output
}

function compilerCoreLLVMNativeEntryTextForProgram(program: CompilerProgram, declarationTables: CompilerSyntaxTables, expansionDelta: CompilerGraphDelta): String {
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreateWithGraphDelta(tables: declarationTables, delta: expansionDelta))
    if !declarationIndex.isValid {
        compilerDeclarationIndexDestroy(index: declarationIndex)
        return String("compilerError\tkind=invalidDeclarationIndex")
    }
    let context: CompilerLLVMLoweringContext(CompilerLLVMLoweringContext(program: program, tables: $declarationTables, declarationIndex: $declarationIndex))
    let reachability: CompilerReachableLLVMState(compilerReachableLLVMStateCreate(context: context))
    let output: String(compilerCoreLLVMNativeEntryTextForReachability(reachability: reachability))
    compilerReachableLLVMStateDestroy(reachability: reachability)
    compilerDeclarationIndexDestroy(index: declarationIndex)
    return output
}

function compilerReachableLLVMStateRender(reachability: CompilerReachableLLVMState): String {
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMValid()) != 1 {
        let failedFunctions: String(rawBufferMaterializeText(buffer: reachability.functionsBuffer))
        let failedPlaceholderCount: Int(compilerCoreLLVMPlaceholderCount(text: failedFunctions))
        if failedPlaceholderCount > 0 { return compilerCoreLLVMPlaceholderFailure(placeholderCount: failedPlaceholderCount, renderedText: failedFunctions) }
        let failureStage: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFailureStage()))
        let returnFailureKind: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureKind()))
        if failureStage == 4 && returnFailureKind != 0 {
            let returnFailureFunctionRow: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureFunction()))
            let returnFailureDetail: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureDetail()))
            let returnFailureName: String(compilerReachableLLVMReturnFailureName(kind: returnFailureKind))
            if returnFailureFunctionRow >= 0 && returnFailureFunctionRow < compilerIntTableRowCount(table: reachability.context.tables.functions) {
                let returnFailureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: returnFailureFunctionRow, column: 0))
                let returnFailureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: returnFailureSyntaxID))
                if returnFailureDeclarationRow >= 0 {
                    let returnFailureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: returnFailureDeclarationRow, column: 1))
                    let returnFailureFunctionName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: returnFailureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: returnFailureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: returnFailureDeclarationRow, column: 8)))
                    return "compilerError\tkind=invalidOwnedReturnSummary\tfunctionRow=\(returnFailureFunctionRow)\tfunction=\(returnFailureFunctionName)\tfailureKind=\(returnFailureName)\tdetail=\(returnFailureDetail)"
                }
            }
            return "compilerError\tkind=invalidOwnedReturnSummary\tfunctionRow=\(returnFailureFunctionRow)\tfailureKind=\(returnFailureName)\tdetail=\(returnFailureDetail)"
        }
        if failureStage == 6 || (failureStage >= 6000 && failureStage < 7000) {
            let failureFunctionRow: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureFunction()))
            let failureInstanceID: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureInstance()))
            let failureDetail: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureDetail()))
            if failureFunctionRow >= 0 && failureFunctionRow < compilerIntTableRowCount(table: reachability.context.tables.functions) {
                let failureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: failureFunctionRow, column: 0))
                let failureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: failureSyntaxID))
                if failureDeclarationRow >= 0 {
                    let failureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 1))
                    let failureFunctionName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: failureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 8)))
                    state ownedPathStage: Int(0 - 1)
                    if failureStage >= 6000 { ownedPathStage: failureStage - 6000 }
                    return "compilerError\tkind=invalidFunctionReachability\tstage=6\tfunctionRow=\(failureFunctionRow)\tfunction=\(failureFunctionName)\tinstanceID=\(failureInstanceID)\tdetail=\(failureDetail)\townedPathStage=\(ownedPathStage)"
                }
            }
        }
        if failureStage >= 300000 && failureStage < 400000 {
            return "compilerError\tkind=invalidEntryOwnedPaths\tdetail=\(failureStage - 300000)"
        }
        if failureStage >= 200000 {
            let blockedFunctionRow: Int(failureStage - 200000)
            let blockedSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockedFunctionRow, column: 0))
            let blockedDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: blockedSyntaxID))
            let blockedFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 1))
            let blockedName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: blockedFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 8)))
            return "compilerError\tkind=representationSensitiveABICapabilityBlocked\tfunctionRow=\(blockedFunctionRow)\tfunction=\(blockedName)\tcapabilityStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockedFunctionRow))"
        }
        if failureStage >= 100000 {
            let failureFunctionRow: Int(failureStage - 100000)
            let failureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: failureFunctionRow, column: 0))
            let failureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: failureSyntaxID))
            let failureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 1))
            let failureName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: failureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 8)))
            return "compilerError\tkind=invalidFunctionDiscovery\tfunctionRow=\(failureFunctionRow)\tfunction=\(failureName)\tfailureCode=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: failureFunctionRow))"
        }
        return "compilerError\tkind=invalidFunctionReachability\tstage=\(failureStage)"
    }
    if !compilerReachableLLVMStateABIPlanIsValid(reachability: reachability) {
        state invalidPlanEdge: Int(0)
        while invalidPlanEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let invalidPlanOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: invalidPlanEdge))
            let invalidPlanTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: invalidPlanEdge))
            let invalidPlanOwnerParticipant: Int(rawBufferLoadInt(buffer: reachability.abiParticipants, index: invalidPlanOwner))
            let invalidPlanTargetParticipant: Int(rawBufferLoadInt(buffer: reachability.abiParticipants, index: invalidPlanTarget))
            let invalidPlanTargetReturnMode: Int(rawBufferLoadInt(buffer: reachability.abiReturnModes, index: invalidPlanTarget))
            let invalidPlanAggregateParameter: Bool(compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: invalidPlanTarget))
            if (invalidPlanTargetReturnMode == compilerFunctionReturnABIIndirect() && invalidPlanOwnerParticipant != 1)
                || (invalidPlanOwnerParticipant == 1 && invalidPlanAggregateParameter && invalidPlanTargetParticipant != 1)
                || (invalidPlanTargetParticipant == 1 && invalidPlanAggregateParameter && invalidPlanOwnerParticipant != 1) {
                return "compilerError\tkind=invalidModuleABIPlanEdge\townerFunctionRow=\(invalidPlanOwner)\ttargetFunctionRow=\(invalidPlanTarget)\townerParticipant=\(invalidPlanOwnerParticipant)\ttargetParticipant=\(invalidPlanTargetParticipant)\ttargetReturnMode=\(invalidPlanTargetReturnMode)\ttargetAggregateParameter=\(invalidPlanAggregateParameter)"
            }
            invalidPlanEdge: invalidPlanEdge + 1
        }
        return String("compilerError\tkind=invalidModuleABIPlan")
    }
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMIndirectCapabilities()) < 1 { return String("compilerError\tkind=emptyIndirectABICapability") }
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMIndirectActivations()) < 1 {
        state blockerEdge: Int(0)
        while blockerEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let blockerOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: blockerEdge))
            let blockerTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: blockerEdge))
            if rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockerTarget) == 1
                && compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: blockerTarget) == compilerFunctionReturnABIIndirect()
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockerOwner) != 1 {
                let targetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockerTarget, column: 0))
                let ownerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockerOwner, column: 0))
                let targetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: targetSyntaxID))
                let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: ownerSyntaxID))
                let targetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 8)))
                let ownerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 8)))
                return "compilerError\tkind=indirectABIActivationBlocked\ttargetFunctionRow=\(blockerTarget)\ttarget=\(targetName)\townerFunctionRow=\(blockerOwner)\towner=\(ownerName)\townerStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockerOwner))"
            }
            blockerEdge: blockerEdge + 1
        }
        state incapableEdge: Int(0)
        while incapableEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let incapableOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: incapableEdge))
            let incapableTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: incapableEdge))
            if compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: incapableTarget) == compilerFunctionReturnABIIndirect()
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: incapableTarget) != 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: incapableOwner) == 1 {
                let incapableTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: incapableTarget, column: 0))
                let incapableOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: incapableOwner, column: 0))
                let incapableTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: incapableTargetSyntaxID))
                let incapableOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: incapableOwnerSyntaxID))
                let incapableTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 8)))
                let incapableOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=indirectABIComponentBlocked\ttargetFunctionRow=\(incapableTarget)\ttarget=\(incapableTargetName)\ttargetStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: incapableTarget))\townerFunctionRow=\(incapableOwner)\towner=\(incapableOwnerName)"
            }
            incapableEdge: incapableEdge + 1
        }
        state parameterBlockerEdge: Int(0)
        while parameterBlockerEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let parameterBlockerOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: parameterBlockerEdge))
            let parameterBlockerTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: parameterBlockerEdge))
            if compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterBlockerTarget)
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterBlockerTarget) != 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterBlockerOwner) == 1 {
                let parameterBlockerTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: parameterBlockerTarget, column: 0))
                let parameterBlockerOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: parameterBlockerOwner, column: 0))
                let parameterBlockerTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: parameterBlockerTargetSyntaxID))
                let parameterBlockerOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: parameterBlockerOwnerSyntaxID))
                let parameterBlockerTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 8)))
                let parameterBlockerOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=aggregateParameterABIComponentBlocked\ttargetFunctionRow=\(parameterBlockerTarget)\ttarget=\(parameterBlockerTargetName)\ttargetStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterBlockerTarget))\townerFunctionRow=\(parameterBlockerOwner)\towner=\(parameterBlockerOwnerName)"
            }
            parameterBlockerEdge: parameterBlockerEdge + 1
        }
        state aggregateCallerBlockerEdge: Int(0)
        while aggregateCallerBlockerEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let aggregateCallerBlockerOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: aggregateCallerBlockerEdge))
            let aggregateCallerBlockerTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: aggregateCallerBlockerEdge))
            if compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: aggregateCallerBlockerTarget)
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerTarget) == 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerOwner) != 1 {
                let aggregateCallerBlockerTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: aggregateCallerBlockerTarget, column: 0))
                let aggregateCallerBlockerOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: aggregateCallerBlockerOwner, column: 0))
                let aggregateCallerBlockerTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: aggregateCallerBlockerTargetSyntaxID))
                let aggregateCallerBlockerOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: aggregateCallerBlockerOwnerSyntaxID))
                let aggregateCallerBlockerTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 8)))
                let aggregateCallerBlockerOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=aggregateParameterABICallerBlocked\ttargetFunctionRow=\(aggregateCallerBlockerTarget)\ttarget=\(aggregateCallerBlockerTargetName)\townerFunctionRow=\(aggregateCallerBlockerOwner)\towner=\(aggregateCallerBlockerOwnerName)\townerStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerOwner))"
            }
            aggregateCallerBlockerEdge: aggregateCallerBlockerEdge + 1
        }
        return String("compilerError\tkind=emptyIndirectABIActivation")
    }
    return String("compilerError\tkind=missingTypedEntryLowering")
}

function compilerReachableLLVMStateRenderModule(reachability: CompilerReachableLLVMState, usage: String, extraGlobals: String, extraRuntimeRequirements: Int, mainText: String): String {
    let audit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAuditTyped(tables: reachability.context.tables, selection: reachability.selection))
    if audit.excludedCount > 0 { return compilerCoreLLVMHelperAuditFailure(audit: audit) }
    let typedSelected: CompilerTypedLLVMHelpers(compilerReachableLLVMStateHelpers(reachability: reachability))
    if !compilerBodyTelemetryIsTypedOnly(telemetry: typedSelected.telemetry) {
        return compilerBodyTelemetryTypedOnlyFailure(telemetry: typedSelected.telemetry, scope: String("reachableFunctions"))
    }
    let selected: CompilerLLVMHelperFunctions(compilerTypedLLVMHelpersValue(value: typedSelected))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: selected.renderedFunctions))
    if placeholderCount > 0 { return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: selected.renderedFunctions) }
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMCommittedFailures()) != 0 { return String("compilerError\tkind=invalidFunctionReachability") }
    state runtimeRequirements: Int(0)
    runtimeRequirements: typedSelected.runtimeRequirements
    if extraRuntimeRequirements > runtimeRequirements { runtimeRequirements: extraRuntimeRequirements }
    let allRenderedFunctions: String("\(selected.renderedFunctions)\(mainText)")
    let nominalLayouts: String(compilerCoreRenderLLVMNominalLayouts(tables: reachability.context.tables, index: reachability.context.declarationIndex, includeBuiltinArray: compilerCoreRecordContains(record: allRenderedFunctions, text: String("%Range.Array"))))
    let runtimeDeclarations: String(compilerCoreRenderLLVMRuntimeDeclarationsTyped(records: selected.instructionRecords, renderedFunctions: allRenderedFunctions, runtimeRequirements: runtimeRequirements))
    let declarations: String(compilerCoreRenderLLVMFunctionDeclarationsExcludingTyped(tables: reachability.context.tables, index: reachability.context.declarationIndex, selection: reachability.selection))
    let text: String(compilerCoreLLVMNativeEntryTextFromParts(usage: usage, globals: "\(nominalLayouts)\(typedSelected.renderedGlobals)\(extraGlobals)", runtime: runtimeDeclarations, helpers: selected.renderedFunctions, declarations: declarations, main: mainText))
    let materialized: String(compilerCoreMaterializeLLVMText(text: text))
    let signatureAuditCode: Int(compilerCoreLLVMDirectCallSignatureAudit(tables: reachability.context.tables, index: reachability.context.declarationIndex, selection: reachability.selection, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, functionInstanceSignatureParameters: reachability.functionInstanceSignatureParameters, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability), text: materialized))
    if signatureAuditCode != 0 {
        let signatureAuditInstanceID: Int(signatureAuditCode - 1)
        let signatureAuditFunctionRow: Int(compilerIntTableValue(table: reachability.functionInstances, row: signatureAuditInstanceID, column: compilerReachableFunctionInstanceFunctionColumn()))
        let signatureAuditSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: signatureAuditFunctionRow, column: 0))
        let signatureAuditDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: signatureAuditSyntaxID))
        let signatureAuditFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: signatureAuditDeclarationRow, column: 1))
        let signatureAuditFunctionName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: signatureAuditFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: signatureAuditDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: signatureAuditDeclarationRow, column: 8)))
        return "compilerError\tkind=directCallSignatureAudit\tinstanceID=\(signatureAuditInstanceID)\tfunctionRow=\(signatureAuditFunctionRow)\tfunction=\(signatureAuditFunctionName)"
    }
    return materialized
}

function compilerCoreLLVMDirectCallSignatureAudit(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, functionInstances: CompilerIntTable, functionInstanceSignatures: CompilerIntTable, functionInstanceSignatureParameters: CompilerIntTable, abiPlan: CompilerModuleABIPlan, text: String): Int {
    state instanceID: Int(0)
    while instanceID < compilerIntTableRowCount(table: functionInstances) {
        let functionRow: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn()))
        if !compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) { return instanceID + 1 }
        let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
        let signatureRow: Int(compilerReachableFunctionInstanceSignatureRow(signatures: functionInstanceSignatures, instanceID: instanceID))
        if declarationRow < 0 || signatureRow < 0 { return instanceID + 1 }
        let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
        let baseName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
        let receiverKeyID: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceReceiverKeyColumn()))
        state name: String(baseName)
        if receiverKeyID >= 0 {
            name: "\(baseName)__ri\(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFingerprintFirstColumn()))_\(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFingerprintSecondColumn()))"
        }
        let parameterCount: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterCountColumn()))
        let parameterStart: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterFirstRowColumn()))
        if parameterCount < 0 || parameterStart < 0 || parameterStart + parameterCount > compilerIntTableRowCount(table: functionInstanceSignatureParameters) { return instanceID + 1 }
        state parameterOrdinal: Int(0)
        while parameterOrdinal < parameterCount {
            let parameterRow: Int(parameterStart + parameterOrdinal)
            if compilerIntTableValue(table: functionInstanceSignatureParameters, row: parameterRow, column: compilerReachableFunctionInstanceSignatureParameterInstanceColumn()) != instanceID
                || compilerIntTableValue(table: functionInstanceSignatureParameters, row: parameterRow, column: compilerReachableFunctionInstanceSignatureParameterOrdinalColumn()) != parameterOrdinal
                || compilerIntTableValue(table: functionInstanceSignatureParameters, row: parameterRow, column: compilerReachableFunctionInstanceSignatureParameterABICategoryColumn()) == compilerBodyFunctionSignatureABICategoryNone() && receiverKeyID >= 0 { return instanceID + 1 }
            parameterOrdinal: parameterOrdinal + 1
        }
        let returnCategory: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnABICategoryColumn()))
        if receiverKeyID >= 0 && returnCategory == compilerBodyFunctionSignatureABICategoryNone() { return instanceID + 1 }
        let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
        state llvmReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: returnType))
        if returnCategory == compilerBodyFunctionSignatureABICategoryInt() { llvmReturnType: String("i32") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryBool() { llvmReturnType: String("i1") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryFloat() { llvmReturnType: String("double") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryPointer() { llvmReturnType: String("ptr") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryUnsigned8() { llvmReturnType: String("i8") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryFloat32() { llvmReturnType: String("float") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryNone() && compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
            llvmReturnType: compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: returnType)
        }
        let returnMode: Int(compilerModuleABIPlanReturnMode(plan: abiPlan, tables: tables, index: index, functionRow: functionRow))
        if returnCategory == compilerBodyFunctionSignatureABICategoryNone() && returnMode == compilerFunctionReturnABIIndirect() { llvmReturnType: String("void") }
        let symbolNeedle: String("@\(name)(")
        let definitionPrefix: String("define \(llvmReturnType) ")
        let callPrefix: String("call \(llvmReturnType) ")
        let symbolNeedleLength: Int(stringLength(value: symbolNeedle))
        let definitionPrefixLength: Int(stringLength(value: definitionPrefix))
        let callPrefixLength: Int(stringLength(value: callPrefix))
        state definitionCount: Int(0)
        state occurrence: Int(stringFindFrom(source: text, start: 0, needle: symbolNeedle))
        while occurrence >= 0 {
            state recognized: Bool(false)
            if occurrence >= definitionPrefixLength && text.substring(start: occurrence - definitionPrefixLength, end: occurrence) == definitionPrefix {
                definitionCount: definitionCount + 1
                recognized: true
            }
            if !recognized && occurrence >= callPrefixLength && text.substring(start: occurrence - callPrefixLength, end: occurrence) == callPrefix {
                recognized: true
                if returnCategory == compilerBodyFunctionSignatureABICategoryNone() && returnMode == compilerFunctionReturnABIIndirect() {
                    let firstArgumentStart: Int(occurrence + symbolNeedleLength)
                    if !stringHasPrefix(source: text, start: firstArgumentStart, prefix: String("ptr ")) { return instanceID + 1 }
                }
            }
            if !recognized { return instanceID + 1 }
            occurrence: stringFindFrom(source: text, start: occurrence + symbolNeedleLength, needle: symbolNeedle)
        }
        if definitionCount != 1 { return instanceID + 1 }
        instanceID: instanceID + 1
    }
    return 0
}

function compilerCoreLLVMNativeEntryTextFromParts(usage: String, globals: String, runtime: String, helpers: String, declarations: String, main: String): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 1048576, stride: 1))
    rawBufferAppendText(buffer: outputBuffer, text: usage)
    rawBufferAppendText(buffer: outputBuffer, text: globals)
    rawBufferAppendText(buffer: outputBuffer, text: runtime)
    rawBufferAppendText(buffer: outputBuffer, text: helpers)
    rawBufferAppendText(buffer: outputBuffer, text: declarations)
    rawBufferAppendText(buffer: outputBuffer, text: main)
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreMainLLVM(block: CompilerLLVMLoweredBlock): String {
    let fallbackProgram: CompilerProgram(CompilerProgram(source: String(""), hasMainBlock: false, mainAttributeStart: 0, mainBlock: block.block, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: block.declarationRecords, declarationSummary: String("")))
    let module: CompilerLLVMModule(compilerCoreLLVMModule(program: fallbackProgram, block: block))
    return compilerCoreRenderLLVMModule(module: module)
}

function compilerCoreRenderLLVMFunctionDeclarations(program: CompilerProgram): String {
    return compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: String(""))
}

function compilerCoreRenderLLVMFunctionDeclarationsExcludingTyped(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 65536, stride: 1))
    let declarationCount: Int(compilerCoreAppendLLVMFunctionDeclarationsTyped(tables: tables, index: index, selection: selection, outputBuffer: outputBuffer))
    if declarationCount > 0 {
        rawBufferAppendText(buffer: outputBuffer, text: String("\n"))
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreAppendLLVMFunctionDeclarationsTyped(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, outputBuffer: RawBuffer): Int {
    state declarationRow: Int(0)
    state declarationCount: Int(0)
    let rowCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while declarationRow < rowCount {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
            if !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: syntaxID) {
                declarationCount: declarationCount + compilerCoreAppendLLVMFunctionDeclarationTyped(tables: tables, declarationRow: declarationRow, functionRow: functionRow, selection: selection, outputBuffer: outputBuffer)
            }
        }
        declarationRow: declarationRow + 1
    }
    return declarationCount
}

function compilerCoreAppendLLVMFunctionDeclarationTyped(tables: CompilerSyntaxTables, declarationRow: Int, functionRow: Int, selection: CompilerFunctionSelection, outputBuffer: RawBuffer): Int {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 13) != compilerBuiltinPolicyNone()
        && compilerBodyRuntimeBuiltinID(name: name) != compilerBodyRuntimeBuiltinNone() { return 0 }
    if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
        return 0
    }
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    let parameters: String(compilerCoreLLVMFunctionParameterTextTyped(tables: tables, functionRow: functionRow))
    rawBufferAppendText(buffer: outputBuffer, text: "declare \(compilerCoreLLVMTypeNameForRangeType(typeName: returnType)) @\(name)(\(parameters))\n")
    return 1
}

function compilerCoreLLVMFunctionParameterTextTyped(tables: CompilerSyntaxTables, functionRow: Int): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    state hasParameter: Bool(false)
    if ownerName != String("") {
        rawBufferAppendText(buffer: outputBuffer, text: "ptr %self")
        hasParameter: true
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if hasParameter { rawBufferAppendText(buffer: outputBuffer, text: String(", ")) }
        rawBufferAppendText(buffer: outputBuffer, text: "\(compilerCoreLLVMTypeNameForRangeType(typeName: typeName)) %\(name)")
        hasParameter: true
        ordinal: ordinal + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMNativeABITypeName(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, typeName: String): String {
    let optionalTypeName: String(compilerSpecializedOptionalLLVMTypeName(tables: tables, index: index, typeName: typeName))
    if optionalTypeName != String("") { return optionalTypeName }
    let nominalName: String(compilerBodyArenaTypeOuterName(typeName: typeName))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindConstruct()))
    let nominalTypeName: String(compilerNominalLLVMTypeName(tables: tables, declarationRow: declarationRow))
    if nominalTypeName != String("") { return nominalTypeName }
    let enumDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindEnum()))
    if enumDeclarationRow >= 0 {
        let enumSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: enumDeclarationRow, column: 0))
        if !compilerSyntaxEnumHasPayloads(tables: tables, enumSyntaxID: enumSyntaxID) { return String("i32") }
    }
    let enumTypeName: String(compilerEnumLLVMTypeName(tables: tables, declarationRow: enumDeclarationRow))
    if enumTypeName != String("") { return enumTypeName }
    return compilerCoreLLVMTypeNameForRangeType(typeName: typeName)
}

function compilerCoreLLVMFunctionParameterTextPlanned(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int, abiPlan: CompilerModuleABIPlan): String {
    if !compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
        return compilerCoreLLVMFunctionParameterTextTyped(tables: tables, functionRow: functionRow)
    }
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    state hasParameter: Bool(false)
    if ownerName != String("") {
        rawBufferAppendText(buffer: outputBuffer, text: "ptr %self")
        hasParameter: true
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if hasParameter { rawBufferAppendText(buffer: outputBuffer, text: String(", ")) }
        rawBufferAppendText(buffer: outputBuffer, text: "\(compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: typeName)) %\(name)")
        hasParameter: true
        ordinal: ordinal + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMFunctionParameterLocalValuesTyped(tables: CompilerSyntaxTables, functionRow: Int): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 512, stride: 1))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    if ownerName != String("") {
        rawBufferAppendText(buffer: outputBuffer, text: compilerCoreLLVMLocalRecordWithRangeType(name: String("self"), operand: String("%self"), typeName: String("ptr"), rangeTypeName: ownerName))
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        rawBufferAppendText(buffer: outputBuffer, text: compilerCoreLLVMLocalRecordWithRangeType(name: name, operand: "%\(name)", typeName: compilerCoreLLVMTypeNameForRangeType(typeName: typeName), rangeTypeName: typeName))
        ordinal: ordinal + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

