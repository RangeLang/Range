}

function compilerBodyArenaOwnedPathBackedgesAreStable(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathRoots: RawBuffer, canonicalPaths: RawBuffer, predecessorStarts: RawBuffer, predecessorCounts: RawBuffer, predecessorBlocks: RawBuffer, projectionA: RawBuffer, projectionB: RawBuffer, blockCount: Int, pathCount: Int): Bool {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge() {
            let sourceBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()))
            let targetBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()))
            if sourceBlockID < 0 || sourceBlockID >= blockCount || targetBlockID < 0 || targetBlockID >= blockCount { return false }
            let predecessorCount: Int(rawBufferLoadInt(buffer: predecessorCounts, index: targetBlockID))
            if predecessorCount < 1 { return false }
            let entryPredecessorIndex: Int(rawBufferLoadInt(buffer: predecessorStarts, index: targetBlockID))
            if entryPredecessorIndex < 0 || entryPredecessorIndex >= rawBufferCount(buffer: predecessorBlocks) { return false }
            let entryPredecessorID: Int(rawBufferLoadInt(buffer: predecessorBlocks, index: entryPredecessorIndex))
