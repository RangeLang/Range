        }
        row: row + 1
    }
    return false
}

function compilerSyntaxAppendGenericParameter(tables: CompilerSyntaxTables, ownerSyntaxID: Int, ownerKind: Int, ordinal: Int, fileID: Int, start: Int, end: Int, nameStart: Int, nameEnd: Int, kind: Int, fingerprint: CompilerFingerprint): Int {
