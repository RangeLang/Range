    if intBufferDestroy(buffer: reachability.abiCapabilities) != 0 { status: 0 - 1 }
    if intBufferDestroy(buffer: reachability.abiActivation) != 0 { status: 0 - 1 }
    if intBufferDestroy(buffer: reachability.abiReturnModes) != 0 { status: 0 - 1 }
    if intBufferDestroy(buffer: reachability.abiParticipants) != 0 { status: 0 - 1 }
    if intBufferDestroy(buffer: reachability.abiSensitiveFunctions) != 0 { status: 0 - 1 }
    if textBufferDestroy(buffer: reachability.functionsBuffer) != 0 { status: 0 - 1 }
    if textBufferDestroy(buffer: reachability.globalsBuffer) != 0 { status: 0 - 1 }
    if intBufferDestroy(buffer: reachability.counters) != 0 { status: 0 - 1 }
    return status
}

function compilerCoreLLVMSelectedHelperFunctionTyped(context: CompilerLLVMLoweringContext, declarationRow: Int, functionRow: Int, initialTemporaryIndex: Int, edgeOwners: IntBuffer, edgeTargets: IntBuffer, abiPlan: CompilerModuleABIPlan): CompilerTypedLLVMHelpers {
    let lowering: CompilerTypedBodyLowering(compilerCoreLLVMLowerHelperFunctionTypedObserved(context: context, functionRow: functionRow, initialTemporaryIndex: initialTemporaryIndex, edgeOwners: edgeOwners, edgeTargets: edgeTargets, abiPlan: abiPlan))
    if !lowering.isValid {
        let fileID: Int(compilerIntTableValue(table: context.tables.declarations, row: declarationRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: context.tables, fileID: fileID, localStart: compilerIntTableValue(table: context.tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: context.tables.declarations, row: declarationRow, column: 8)))
        let placeholder: String("; RANGE_LOWERING_PLACEHOLDER functionID=\(functionRow) function=\(name) reason=typedBodyPipelineFailure stage=\(lowering.failureStage)\n")
        return CompilerTypedLLVMHelpers(helpers: CompilerLLVMHelperFunctions(renderedFunctions: placeholder, instructionRecords: String(""), nextTemporary: initialTemporaryIndex), renderedGlobals: String(""), runtimeRequirements: 0, telemetry: lowering.telemetry)
    }
    let renderedFunction: String(compilerCoreRenderLLVMHelperFunctionTyped(tables: context.tables, index: context.declarationIndex, declarationRow: declarationRow, functionRow: functionRow, block: lowering.block, abiPlan: abiPlan))
    state renderedGlobals: String("")
    if lowering.telemetry.supportedCount == 0 {
        renderedGlobals: compilerCoreRenderLLVMGlobalRecords(records: lowering.block.instructionRecords)
    } else {
        renderedGlobals: lowering.renderedGlobals
    }
    return CompilerTypedLLVMHelpers(helpers: CompilerLLVMHelperFunctions(renderedFunctions: renderedFunction, instructionRecords: String(""), nextTemporary: lowering.block.nextTemporary), renderedGlobals: renderedGlobals, runtimeRequirements: lowering.runtimeRequirements, telemetry: lowering.telemetry)
}

