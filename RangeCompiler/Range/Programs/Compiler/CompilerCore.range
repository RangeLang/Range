        }
        if token.kind == .leftBrace { braceDepth: braceDepth + 1 }
        if token.kind == .rightBrace {
            if braceDepth <= 0 { return 0 - 1 }
            braceDepth: braceDepth - 1
        }
        result: token.end
        cursor: token.end
    }
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0 { return 0 - 1 }
    return result
}

function compilerTypedSyntaxCaptureMacroParameters(source: String, tables: CompilerSyntaxTables, macroDeclarationRow: Int, start: Int, end: Int, baseFingerprint: CompilerFingerprint): CompilerMacroParameterCapture {
