        digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroApplications, row: row, column: 18))
        row: row + 1
    }
    return digest
}

function compilerMacroRenderDiagnostics(tables: CompilerSyntaxTables): String {
    let count: Int(compilerIntTableRowCount(table: tables.macroDiagnostics))
    if count <= 0 { return String("compilerError\tkind=macroLinking\tcount=0\n") }
    let code: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 0))
    let identityFirst: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 6))
    let identitySecond: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 7))
    return "compilerError\tkind=macroLinking\tcount=\(count)\tdiagnosticKind=\(compilerMacroDiagnosticName(code: code))\tfileID=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 1))\tstart=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 2))\tend=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 3))\trelatedRow=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 5))\tidentity=\(identityFirst):\(identitySecond)\n"
}

function compilerMacroExecutionDigest(tables: CompilerSyntaxTables): CompilerFingerprint {
    state digest: CompilerFingerprint(compilerFingerprintInitial())
    state tableTag: Int(800)
    state row: Int(0)
    state column: Int(0)
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag)
    while row < compilerIntTableRowCount(table: tables.macroInvocations) {
        column: 0
        while column < compilerSyntaxMacroInvocationColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroInvocations, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 1)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroCapabilityHandles) {
        column: 0
        while column < compilerSyntaxMacroCapabilityHandleColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 2)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        column: 0
        while column < compilerSyntaxMacroExecutionEventColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 3)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroReadDependencies) {
        column: 0
        while column < compilerSyntaxMacroReadDependencyColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    return digest
}

function compilerMacroRenderExecutionEvents(tables: CompilerSyntaxTables): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        let fileID: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 4))
        let messageStart: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 5))
        let messageEnd: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 6))
        let rawMessage: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: messageStart, localEnd: messageEnd))
        let message: String(compilerCoreStringLiteralContent(text: rawMessage))
        textBufferAppend(buffer: outputBuffer, text: "macroExecutionEvent\(tab)row=\(row)\(tab)invocationRow=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 1))\(tab)severity=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 2))\(tab)operation=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 3))\(tab)message=\(message)\(tab)messageFileID=\(fileID)\(tab)messageStart=\(messageStart)\(tab)messageEnd=\(messageEnd)\(tab)sourceFileID=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 7))\(tab)sourceStart=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 8))\(tab)sourceEnd=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 9))\(newline)")
        row: row + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderReadDependencies(tables: CompilerSyntaxTables): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroReadDependencies) {
        let fileID: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 4))
        let kindStart: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 5))
        let kindEnd: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 6))
        let nameStart: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 7))
        let nameEnd: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 8))
        let kindName: String(compilerCoreStringLiteralContent(text: compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: kindStart, localEnd: kindEnd)))
        let declarationName: String(compilerCoreStringLiteralContent(text: compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStart, localEnd: nameEnd)))
        textBufferAppend(buffer: outputBuffer, text: "macroReadDependency\(tab)row=\(row)\(tab)invocationRow=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 1))\(tab)operation=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 2))\(tab)kind=\(kindName)\(tab)name=\(declarationName)\(tab)observedCount=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 9))\(tab)queryIdentity=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 10)):\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 11))\(tab)observation=\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 12)):\(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 13))\(newline)")
        row: row + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderGraphDelta(delta: CompilerGraphDelta): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 256))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nodes) {
        textBufferAppend(buffer: outputBuffer, text: "macroGraphDeltaNode\(tab)row=\(row)\(tab)kind=\(compilerSyntaxKindName(kindTag: compilerIntTableValue(table: delta.nodes, row: row, column: 1)))\(tab)targetSyntaxID=\(compilerIntTableValue(table: delta.nodes, row: row, column: 2))\(tab)fileID=\(compilerIntTableValue(table: delta.nodes, row: row, column: 4))\(tab)start=\(compilerIntTableValue(table: delta.nodes, row: row, column: 5))\(tab)end=\(compilerIntTableValue(table: delta.nodes, row: row, column: 6))\(newline)")
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.facts) {
        textBufferAppend(buffer: outputBuffer, text: "macroGraphDeltaFact\(tab)row=\(row)\(tab)operation=omit\(tab)subjectNodeID=\(compilerIntTableValue(table: delta.facts, row: row, column: 1))\(tab)objectNodeID=\(compilerIntTableValue(table: delta.facts, row: row, column: 2))\(tab)role=\(compilerIntTableValue(table: delta.facts, row: row, column: 3))\(tab)ordinal=\(compilerIntTableValue(table: delta.facts, row: row, column: 4))\(newline)")
        row: row + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderExecutionError(tables: CompilerSyntaxTables, result: CompilerMacroExecutionResult): String {
    state invocationRow: Int(0 - 1)
    state foundInvocation: Bool(false)
    while invocationRow < compilerIntTableRowCount(table: tables.macroInvocations) - 1 && !foundInvocation {
        invocationRow: invocationRow + 1
        if compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 9) == compilerMacroInvocationFailed() { foundInvocation: true }
    }
    if invocationRow < 0 || invocationRow >= compilerIntTableRowCount(table: tables.macroInvocations) {
        return "compilerError\tkind=macroExecution\tdiagnosticKind=\(compilerMacroDiagnosticName(code: result.diagnosticCode))\n"
    }
    let applicationRow: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 1))
    let declarationRow: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 2))
    let applicationFileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let identityFirst: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 23))
    let identitySecond: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 24))
    state message: String("")
    state eventSourceFileID: Int(0 - 1)
    state eventSourceStart: Int(0 - 1)
    state eventSourceEnd: Int(0 - 1)
    state eventRow: Int(0)
    while eventRow < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        if compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 1) == invocationRow {
            let messageFileID: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 4))
            let rawMessage: String(compilerTypedSyntaxLocalText(tables: tables, fileID: messageFileID, localStart: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 5), localEnd: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 6)))
            message: compilerCoreStringLiteralContent(text: rawMessage)
            eventSourceFileID: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 7)
            eventSourceStart: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 8)
            eventSourceEnd: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 9)
        }
        eventRow: eventRow + 1
    }
    return "compilerError\tkind=macroExecution\tdiagnosticKind=\(compilerMacroDiagnosticName(code: compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 10)))\tmessage=\(message)\tapplicationFileID=\(applicationFileID)\tapplicationStart=\(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 2))\tapplicationEnd=\(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 3))\ttargetFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 17))\ttargetStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 18))\ttargetEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 19))\tmacroDeclarationFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 20))\tmacroDeclarationStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 21))\tmacroDeclarationEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 22))\tmacroBodyStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 15))\tmacroBodyEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 16))\teventSourceFileID=\(eventSourceFileID)\teventSourceStart=\(eventSourceStart)\teventSourceEnd=\(eventSourceEnd)\tgraphDeltaNodeCount=\(compilerIntTableRowCount(table: result.graphDelta.nodes))\tgraphDeltaFactCount=\(compilerIntTableRowCount(table: result.graphDelta.facts))\tinvocationIdentity=\(identityFirst):\(identitySecond)\n"
}

function compilerMacroRenderExecutionSnapshot(tables: CompilerSyntaxTables, result: CompilerMacroExecutionResult): String {
    let digest: CompilerFingerprint(compilerMacroExecutionDigest(tables: tables))
    let dependencyDigest: CompilerFingerprint(compilerMacroReadDependencyDigest(tables: tables))
    let graphDeltaDigest: CompilerFingerprint(compilerMacroGraphDeltaDigest(delta: result.graphDelta))
    state output: String("macroExecution\tvalid=true\tinvocationCount=\(compilerIntTableRowCount(table: tables.macroInvocations))\tcapabilityHandleCount=\(compilerIntTableRowCount(table: tables.macroCapabilityHandles))\teventCount=\(compilerIntTableRowCount(table: tables.macroExecutionEvents))\tgraphDeltaNodeCount=\(compilerIntTableRowCount(table: result.graphDelta.nodes))\tgraphDeltaFactCount=\(compilerIntTableRowCount(table: result.graphDelta.facts))\treadDependencyCount=\(result.readDependencyCount)\treadDependencyDigest=\(dependencyDigest.first):\(dependencyDigest.second)\tgraphDeltaDigest=\(graphDeltaDigest.first):\(graphDeltaDigest.second)\texecutionDigest=\(digest.first):\(digest.second)\n")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroInvocations) {
        output: "\(output)macroInvocation\trow=\(row)\tapplicationRow=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 1))\tdeclarationRow=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 2))\ttargetSyntaxID=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 3))\tphase=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 5))\tordinal=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 6))\tstatus=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 9))\tbudget=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 8))\tmirOperationCount=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 27))\tstepCount=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 28))\tapplicationIdentity=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 29)):\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 30))\tdeclarationIdentity=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 31)):\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 32))\n"
        row: row + 1
    }
    output: "\(output)\(compilerMacroRenderExecutionEvents(tables: tables))"
    output: "\(output)\(compilerMacroRenderReadDependencies(tables: tables))"
    output: "\(output)\(compilerMacroRenderGraphDelta(delta: result.graphDelta))"
    return output
}

function compilerMacroRenderSnapshot(tables: CompilerSyntaxTables): String {
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.macroParameters))
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let edgeCount: Int(compilerIntTableRowCount(table: tables.macroEdges))
    let appliesToCount: Int(compilerMacroEdgeCount(tables: tables, edgeKind: compilerMacroEdgeAppliesTo()))
    let resolvedByCount: Int(compilerMacroEdgeCount(tables: tables, edgeKind: compilerMacroEdgeResolvedBy()))
    let digest: CompilerFingerprint(compilerMacroObserverDigest(tables: tables))
    let identityDigest: CompilerFingerprint(compilerMacroIdentityProjectionDigest(tables: tables))
    return "macroGraph\tvalid=true\tdeclarationCount=\(declarationCount)\tparameterCount=\(parameterCount)\tapplicationCount=\(applicationCount)\tedgeCount=\(edgeCount)\tappliesToCount=\(appliesToCount)\tresolvedByCount=\(resolvedByCount)\tdigest=\(digest.first):\(digest.second)\nmacroStableProjection\tidentityDigest=\(identityDigest.first):\(identityDigest.second)\n"
}

function compilerMacroSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    state output: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        output: "compilerError(compilerCoreTabCharacter())kind=invalidTypedDeclarations(compilerCoreNewlineCharacter())"
    } else {
        let linkStatus: Int(compilerMacroLink(tables: tables))
        if linkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
            output: compilerMacroRenderDiagnostics(tables: tables)
        } else {
            let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
            if !declarationIndex.isValid {
                output: "compilerError\tkind=invalidDeclarationIndex\n"
            } else {
                let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: declarationIndex))
                if execution.status != 0 {
                    output: compilerMacroRenderExecutionError(tables: tables, result: execution)
                } else {
                    output: "\(compilerMacroRenderExecutionSnapshot(tables: tables, result: execution))\(compilerMacroRenderSnapshot(tables: tables))"
                }
                if compilerGraphDeltaDestroy(delta: execution.graphDelta) != 0 {
                    output: "compilerError\tkind=macroOwnershipFailure\n"
                }
            }
            if compilerDeclarationIndexDestroy(index: declarationIndex) != 0 {
                output: "compilerError\tkind=macroOwnershipFailure\n"
            }
        }
    }
    if compilerSyntaxTablesDestroy(tables: tables) != 0 {
        return "compilerError(compilerCoreTabCharacter())kind=macroOwnershipFailure(compilerCoreNewlineCharacter())"
    }
    return output
}

function compilerSourceIdentitySummary(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return String("compilerError\tkind=invalidSourceFileTable\n")
    }

    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    textBufferAppend(buffer: outputBuffer, text: "sourceIdentity\(tab)fileCount=\(fileCount)\(newline)")
    state fileID: Int(0)
    while fileID < fileCount {
        let role: Int(compilerSourceStoreFileRole(store: store, fileID: fileID))
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart {
            path: stringSubstring(source: source, start: pathStart, end: pathEnd)
        }
        let mappedFileID: Int(compilerSourceStoreFileIDAtGlobalOffset(store: store, globalOffset: contentStart))
        let localOffset: Int(compilerSourceStoreFileLocalOffset(store: store, globalOffset: contentStart))
        textBufferAppend(buffer: outputBuffer, text: "sourceFile\(tab)id=\(fileID)\(tab)role=\(compilerSourceRoleName(role: role))\(tab)path=\(path)\(tab)pathStart=\(pathStart)\(tab)pathEnd=\(pathEnd)\(tab)contentStart=\(contentStart)\(tab)contentEnd=\(contentEnd)\(newline)")
        textBufferAppend(buffer: outputBuffer, text: "sourceMap\(tab)global=\(contentStart)\(tab)fileID=\(mappedFileID)\(tab)local=\(localOffset)\(newline)")
        fileID: fileID + 1
    }

    let summary: String(compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer))
    compilerSourceStoreDestroy(store: store)
    return summary
}

function compilerSourceInventorySummary(source: String): String {
    let files: String(compilerSourceInventoryFileRecords(source: source))
    if hasRangePrefix(source: files, start: 0, prefix: String("compilerError")) {
        return files
    }
    let count: Int(compilerSourceInventoryFileCount(source: source))
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    return "sourceInventory\(tab)program\(newline)\(files)sourceFileCount\(tab)\(count)\(newline)"
}

function compilerSourceInventoryFileRecords(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return compilerNativeDiagnostic(kind: String("invalidSourceFileTable"))
    }

    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let tab: String("\(slash)t")
    let newline: String("\(slash)n")
    state output: String("")
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart {
            path: stringSubstring(source: source, start: pathStart, end: pathEnd)
        }
        output: "\(output)sourceFile\(tab)index=\(fileID)\(tab)role=\(compilerSourceRoleName(role: compilerSourceStoreFileRole(store: store, fileID: fileID)))\(tab)path=\(path)\(newline)"
        fileID: fileID + 1
    }
    compilerSourceStoreDestroy(store: store)
    return output
}

function compilerSourceInventoryFileCount(source: String): Int {
    let markerCount: Int(compilerSourceInventoryFileCountFromMarker(source: source, marker: compilerSourceDecodeNextMarker(source: source, start: 0), fileCount: 0))
    if markerCount == 0 {
        return 1
    }
    return markerCount
}

function compilerSourceInventoryFileCountFromMarker(source: String, marker: CompilerSourceMarker, fileCount: Int): Int {
    if !marker.isValid {
        return 0 - 1
    }
    if !marker.found {
        return fileCount
    }
    let nextMarker: CompilerSourceMarker(compilerSourceDecodeNextMarker(source: source, start: marker.contentStart))
    return compilerSourceInventoryFileCountFromMarker(source: source, marker: nextMarker, fileCount: fileCount + 1)
}

function compilerSourceFileMarker(): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    return "compilerSourceFile\(slash)t"
}

function compilerSourceMarkerNotFound(sourceLength: Int): CompilerSourceMarker {
    return CompilerSourceMarker(found: false, isValid: true, markerStart: sourceLength, markerEnd: sourceLength, role: compilerSourceRoleProject(), pathStart: 0, pathEnd: 0, contentStart: sourceLength, contentEnd: sourceLength)
}

function compilerSourceMarkerInvalid(markerStart: Int): CompilerSourceMarker {
    return CompilerSourceMarker(found: true, isValid: false, markerStart: markerStart, markerEnd: markerStart, role: 0 - 1, pathStart: markerStart, pathEnd: markerStart, contentStart: markerStart, contentEnd: markerStart)
}

function compilerSourceMarkerPathIsValid(source: String, start: Int, end: Int): Bool {
    if end <= start {
        return false
    }
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let encodedTab: String("\(slash)t")
    let path: String(stringSubstring(source: source, start: start, end: end))
    return stringIndexOf(source: path, needle: encodedTab, start: 0) >= stringLength(value: path)
        && stringIndexOf(source: path, needle: compilerCoreTabCharacter(), start: 0) >= stringLength(value: path)
}

function compilerSourceMarkerContentEnd(source: String, start: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    let nextCandidate: Int(compilerSourceNextMarkerCandidate(source: source, start: start))
    if nextCandidate < sourceLength {
        return nextCandidate
    }
    return sourceLength
}

function compilerSourceMarkerValid(source: String, markerStart: Int, markerEnd: Int, role: Int, pathStart: Int): CompilerSourceMarker {
    let contentStart: Int(markerEnd + 1)
    let contentEnd: Int(compilerSourceMarkerContentEnd(source: source, start: contentStart))
    return CompilerSourceMarker(found: true, isValid: true, markerStart: markerStart, markerEnd: markerEnd, role: role, pathStart: pathStart, pathEnd: markerEnd, contentStart: contentStart, contentEnd: contentEnd)
}

function compilerSourceDecodeNextMarker(source: String, start: Int): CompilerSourceMarker {
    let sourceLength: Int(stringLength(value: source))
    let marker: String(compilerSourceFileMarker())
    let candidate: Int(compilerSourceNextMarkerCandidate(source: source, start: start))
    if candidate >= sourceLength {
        return compilerSourceMarkerNotFound(sourceLength: sourceLength)
    }

    let newline: String(compilerCoreNewlineCharacter())
    if candidate > 0 && source.character(index: candidate - 1) != newline {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }
    let lineEnd: Int(stringIndexOf(source: source, needle: newline, start: candidate))
    if lineEnd >= sourceLength {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }

    let markerLength: Int(20)
    let fieldsStart: Int(candidate + markerLength)
    if fieldsStart >= lineEnd {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }

    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let encodedTab: String("\(slash)t")
    let rolePrefix: String("role=")
    let rolePathSeparator: String("\(encodedTab)path=")
    if hasRangePrefix(source: source, start: fieldsStart, prefix: rolePrefix) {
        let separator: Int(stringIndexOf(source: source, needle: rolePathSeparator, start: fieldsStart))
        let roleNameStart: Int(fieldsStart + 5)
        if separator >= lineEnd || separator <= roleNameStart {
            return compilerSourceMarkerInvalid(markerStart: candidate)
        }
        let roleName: String(stringSubstring(source: source, start: roleNameStart, end: separator))
        let role: Int(compilerSourceRoleFromName(name: roleName))
        if role < 0 {
            return compilerSourceMarkerInvalid(markerStart: candidate)
        }
        let pathStart: Int(separator + 7)
        if !compilerSourceMarkerPathIsValid(source: source, start: pathStart, end: lineEnd) {
            return compilerSourceMarkerInvalid(markerStart: candidate)
        }
        return compilerSourceMarkerValid(source: source, markerStart: candidate, markerEnd: lineEnd, role: role, pathStart: pathStart)
    }
    if stringIndexOf(source: source, needle: encodedTab, start: fieldsStart) < lineEnd
        || !compilerSourceMarkerPathIsValid(source: source, start: fieldsStart, end: lineEnd) {
        return compilerSourceMarkerInvalid(markerStart: candidate)
    }
    return compilerSourceMarkerValid(source: source, markerStart: candidate, markerEnd: lineEnd, role: compilerSourceRoleProject(), pathStart: fieldsStart)
}

function compilerSourceNextMarkerCandidate(source: String, start: Int): Int {
    let marker: String(compilerSourceFileMarker())
    let candidate: Int(stringIndexOf(source: source, needle: marker, start: start))
    return compilerSourceNextMarkerCandidateFromCandidate(source: source, marker: marker, candidate: candidate)
}

function compilerSourceNextMarkerCandidateFromCandidate(source: String, marker: String, candidate: Int): Int {
    let sourceLength: Int(stringLength(value: source))
    if candidate >= sourceLength {
        return sourceLength
    }
    if candidate == 0 || source.character(index: candidate - 1) == compilerCoreNewlineCharacter() {
        return candidate
    }
    return compilerSourceNextMarkerCandidateFromCandidate(source: source, marker: marker, candidate: stringIndexOf(source: source, needle: marker, start: candidate + 1))
}

function compilerSourceSetASTSummary(source: String): String {
    state output: String("sourceSetAST\tprogram\n")
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return compilerNativeDiagnostic(kind: String("invalidSourceFileTable"))
    }
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart { path: stringSubstring(source: source, start: pathStart, end: pathEnd) }
        let fileSource: String(stringSubstring(source: source, start: contentStart, end: contentEnd))
        let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
        let declarationSummaryLength: Int(stringLength(value: fileProgram.declarationSummary))
        let roleName: String(compilerSourceRoleName(role: compilerSourceStoreFileRole(store: store, fileID: fileID)))
        output: "\(output)sourceFileAST\tindex=\(fileID)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\tdeclarationSummaryLength=\(declarationSummaryLength)\trole=\(roleName)\n"
        output: "\(output)\(fileProgram.declarationSummary)"
        fileID: fileID + 1
    }
    output: "\(output)sourceFileASTCount\t\(fileCount)\n"
    compilerSourceStoreDestroy(store: store)
    return output
}

function compilerSourceSetTypesSummary(source: String): String {
    state output: String("sourceSetTypes\tprogram\n")
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return compilerNativeDiagnostic(kind: String("invalidSourceFileTable"))
    }
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart { path: stringSubstring(source: source, start: pathStart, end: pathEnd) }
        let fileSource: String(stringSubstring(source: source, start: contentStart, end: contentEnd))
        let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
        let declarationTypeSummary: String(compilerCoreTopLevelFunctionSymbolAndTypeSummary(records: fileProgram.declarationRecords))
        let declarationSummaryLength: Int(stringLength(value: fileProgram.declarationSummary))
        let typeSummaryLength: Int(stringLength(value: declarationTypeSummary))
        let roleName: String(compilerSourceRoleName(role: compilerSourceStoreFileRole(store: store, fileID: fileID)))
        output: "\(output)sourceFileTypes\tindex=\(fileID)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\tdeclarationSummaryLength=\(declarationSummaryLength)\ttypeSummaryLength=\(typeSummaryLength)\trole=\(roleName)\n"
        output: "\(output)\(declarationTypeSummary)"
        if fileProgram.hasMainBlock {
            let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: fileProgram))
            output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: fileProgram.declarationRecords, statementRecords: parsedBlock.statementRecords, scopeName: String("main"), incomingLocals: String(""), expectedReturnType: String("Int")))"
        }
        fileID: fileID + 1
    }
    output: "\(output)sourceFileTypesCount\t\(fileCount)\n"
    compilerSourceStoreDestroy(store: store)
    return output
}

function compilerCoreTopLevelFunctionSymbolAndTypeSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
        if declarationKind == String("function") {
            let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
            let declarationParameters: String(compilerCoreRecordField(record: record, prefix: String("parameters=")))
            let declarationReturnType: String(compilerCoreRecordField(record: record, prefix: String("returnType=")))
            output: "\(output)symbol\tkind=function\tname=\(declarationName)\tscope=program\tparameters=[\(declarationParameters)]\treturnType=\(declarationReturnType)\n"
            output: "\(output)type\tkind=function\tname=\(declarationName)\tscope=program\treturnType=\(declarationReturnType)\n"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function compilerSourceSetLLVMSummary(source: String): String {
    state output: String("sourceSetLLVM\tprogram\n")
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return compilerNativeDiagnostic(kind: String("invalidSourceFileTable"))
    }
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        let pathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: fileID))
        let pathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: fileID))
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        state path: String("")
        if pathEnd > pathStart { path: stringSubstring(source: source, start: pathStart, end: pathEnd) }
        let fileSource: String(stringSubstring(source: source, start: contentStart, end: contentEnd))
        let fileProgram: CompilerProgram(parseCompilerProgram(source: fileSource))
        output: "\(output)sourceFileLLVM\tindex=\(fileID)\tpath=\(path)\thasMainBlock=\(fileProgram.hasMainBlock)\trole=\(compilerSourceRoleName(role: compilerSourceStoreFileRole(store: store, fileID: fileID)))\n"
        if fileProgram.hasMainBlock {
            output: "\(output)sourceFileLLVMText\tpath=\(path)\n"
        }
        fileID: fileID + 1
    }
    let combinedProgram: CompilerProgram(compilerSourceSetProgramForLLVM(source: source))
    output: "\(output)sourceSetLLVMProgram\thasMainBlock=\(combinedProgram.hasMainBlock)\n"
    output: "\(output)sourceFileLLVMCount\t\(fileCount)\n"
    compilerSourceStoreDestroy(store: store)
    return output
}

function compilerSourceSetLLVMText(source: String): String {
    let combinedProgram: CompilerProgram(compilerSourceSetProgramForLLVM(source: source))
    return compilerCoreLLVMSourceSetEntryTextForProgram(program: combinedProgram)
}

function compilerNativeSourceSetLLVMText(source: String): String {
    let declarationTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: declarationTables))
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: declarationTables) {
        compilerSyntaxTablesDestroy(tables: declarationTables)
        return String("compilerError\tkind=invalidTypedDeclarations")
    }
    let macroLinkStatus: Int(compilerMacroLink(tables: declarationTables))
    if macroLinkStatus != 0 || compilerIntTableRowCount(table: declarationTables.macroDiagnostics) != 0 {
        let macroDiagnosticOutput: String(compilerMacroRenderDiagnostics(tables: declarationTables))
        compilerSyntaxTablesDestroy(tables: declarationTables)
        return macroDiagnosticOutput
    }
    let executionIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: declarationTables))
    if !executionIndex.isValid {
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: declarationTables)
        return String("compilerError\tkind=invalidDeclarationIndex\n")
    }
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: declarationTables, index: executionIndex))
    if execution.status != 0 {
        let executionOutput: String(compilerMacroRenderExecutionError(tables: declarationTables, result: execution))
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: declarationTables)
        return executionOutput
    }
    compilerGraphDeltaDestroy(delta: execution.graphDelta)
    compilerDeclarationIndexDestroy(index: executionIndex)
    let combinedProgram: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let output: String(compilerCoreLLVMNativeEntryTextForProgram(program: combinedProgram, declarationTables: declarationTables))
    compilerSyntaxTablesDestroy(tables: declarationTables)
    return output
}

function compilerSourceSetProgramForLLVM(source: String): CompilerProgram {
    return parseCompilerProgramForLLVM(source: compilerSourceSetProgramSource(source: source))
}

function compilerNativeSourceSetProgramForLLVM(source: String): CompilerProgram {
    let emptyBlock: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(source: source, hasMainBlock: false, mainAttributeStart: 0, mainBlock: emptyBlock, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: String(""), declarationSummary: String(""))
}

function compilerSourceSetProgramSource(source: String): String {
    let store: CompilerSourceStore(compilerSourceStoreCreate(source: source))
    if !store.isValid || !compilerIntTableIsComplete(table: store.files) {
        compilerSourceStoreDestroy(store: store)
        return String("")
    }
    let firstPathStart: Int(compilerSourceStoreFilePathStart(store: store, fileID: 0))
    let firstPathEnd: Int(compilerSourceStoreFilePathEnd(store: store, fileID: 0))
    if compilerSourceStoreFileCount(store: store) == 1 && firstPathEnd <= firstPathStart {
        compilerSourceStoreDestroy(store: store)
        return source
    }
    state output: String("")
    state fileID: Int(0)
    let fileCount: Int(compilerSourceStoreFileCount(store: store))
    while fileID < fileCount {
        let contentStart: Int(compilerSourceStoreFileContentStart(store: store, fileID: fileID))
        let contentEnd: Int(compilerSourceStoreFileContentEnd(store: store, fileID: fileID))
        output: "\(output)\(stringSubstring(source: source, start: contentStart, end: contentEnd))\n"
        fileID: fileID + 1
    }
    compilerSourceStoreDestroy(store: store)
    return output
}

function compilerNativeMainSource(): String {
    let slashPair: String("\\")
    let slash: String(slashPair.substring(start: 0, end: 1))
    let marker: String("compilerSourceFile\(slash)t")
    let atSign: String("@")
    let mainAttribute: String("\(atSign)main")
    return "\(marker)NativeMain.range\n\(mainAttribute) {\n    if commandLineArgumentCount() != 1 {\n        print(value: String(\"usage: Compiler <input.range>\"))\n        return 64\n    }\n\n    let argument: Optional<String>(commandLineArgument(index: 0))\n    let path: String(argument ?? String(\"\"))\n    let source: String(readFile(path: path))\n    let output: String(compileRangeNativeSource(source: source))\n    print(value: output)\n    return compilerNativeOutputExitCode(output: output)\n}\n"
}

function compilerNativeDiagnostic(kind: String): String {
    return "compilerError\(compilerCoreTabCharacter())kind=\(kind)\(compilerCoreNewlineCharacter())"
}

function compilerNativeOutputIsError(output: String): Bool {
    return hasRangePrefix(source: output, start: 0, prefix: String("compilerError"))
}

function compilerNativeOutputExitCode(output: String): Int {
    if compilerNativeOutputIsError(output: output) { return 65 }
    return 0
}

function compilerCoreASTSummaryForProgram(program: CompilerProgram): String {
    let declarationBodySummary: String(compilerCoreDeclarationRecordsBodyASTSummary(records: program.declarationRecords))
    if !program.hasMainBlock {
        return "\(program.declarationSummary)\(declarationBodySummary)"
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    return "\(program.declarationSummary)\(declarationBodySummary)ast\tprogram\thasMainBlock=true\tdeclarationSummaryLength=\(stringLength(value: program.declarationSummary))\nast\tmainBlock\tbodyStart=\(program.mainBlock.start)\tbodyEnd=\(program.mainBlock.end)\nast\tblock\tkind=main\tstart=\(program.mainBlock.start)\tend=\(program.mainBlock.end)\n\(parsedBlock.statementSummary)"
}

function compilerCoreDeclarationRecordsBodyASTSummary(records: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: records, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if declaration.kind == String("function") && declaration.statementRecords != String("") {
            output: "\(output)ast\tblock\tkind=function\tname=\(declaration.name)\tstart=\(declaration.bodyStart)\tend=\(declaration.bodyEnd)\n"
            output: "\(output)\(compilerCoreStatementRecordsASTSummary(records: declaration.statementRecords))"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: records, start: sourceIndex)
    }

    return output
}

function parseCompilerProgram(source: String): CompilerProgram {
    return parseCompilerProgramWithFunctionBodyMode(source: source, includeFunctionBodies: false)
}

function parseCompilerProgramForLLVM(source: String): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVM(source: source))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function parseCompilerProgramForLLVMNamedBodies(source: String, bodyFunctionNames: String): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: source, bodyFunctionNames: bodyFunctionNames))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function parseCompilerProgramWithFunctionBodies(source: String): CompilerProgram {
    return parseCompilerProgramWithFunctionBodyMode(source: source, includeFunctionBodies: true)
}

function parseCompilerProgramWithFunctionBodyMode(source: String, includeFunctionBodies: Bool): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: source, includeFunctionBodies: includeFunctionBodies))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function compilerCoreProgramFromParsedParts(source: String, maybeMainBlock: Optional<CompilerMainBlock>, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    if maybeMainBlock == nil {
        return compilerCoreProgramWithoutMain(source: source, parsedDeclarations: parsedDeclarations)
    }

    let mainBlockFallback: CompilerMainBlock(CompilerMainBlock(attributeStart: 0, bodyStart: 0, bodyEnd: 0))
    let mainBlock: CompilerMainBlock(maybeMainBlock ?? mainBlockFallback)
    return compilerCoreProgramWithMain(source: source, mainBlock: mainBlock, parsedDeclarations: parsedDeclarations)
}

function compilerCoreProgramWithoutMain(source: String, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    let blockFallback: CompilerBlock(CompilerBlock(start: 0, end: 0))
    return CompilerProgram(
        source: source,
        hasMainBlock: false,
        mainAttributeStart: 0,
        mainBlock: blockFallback,
        mainStatementRecords: String(""),
        mainStatementSummary: String(""),
        declarationRecords: parsedDeclarations.records,
        declarationSummary: parsedDeclarations.declarationSummary
    )
}

function compilerCoreProgramWithMain(source: String, mainBlock: CompilerMainBlock, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    let block: CompilerBlock(CompilerBlock(start: mainBlock.bodyStart, end: mainBlock.bodyEnd))
    let parsingProgram: CompilerProgram(compilerCoreProgramWithoutMain(source: source, parsedDeclarations: parsedDeclarations))
    return compilerCoreProgramWithMainBlock(source: source, mainBlock: mainBlock, block: block, parsedDeclarations: parsedDeclarations, parsingProgram: parsingProgram)
}

function compilerCoreProgramWithMainBlock(source: String, mainBlock: CompilerMainBlock, block: CompilerBlock, parsedDeclarations: CompilerParsedDeclarations, parsingProgram: CompilerProgram): CompilerProgram {
    let statements: CompilerParsedStatements(compilerCoreParseStatements(program: parsingProgram, block: block))
    return compilerCoreProgramWithMainStatements(source: source, mainBlock: mainBlock, block: block, parsedDeclarations: parsedDeclarations, statements: statements)
}

function compilerCoreProgramWithMainStatements(source: String, mainBlock: CompilerMainBlock, block: CompilerBlock, parsedDeclarations: CompilerParsedDeclarations, statements: CompilerParsedStatements): CompilerProgram {
    let statementSummary: String(compilerCoreStatementRecordsASTSummary(records: statements.records))
    return compilerCoreProgramWithMainSummary(source: source, mainBlock: mainBlock, block: block, parsedDeclarations: parsedDeclarations, statements: statements, statementSummary: statementSummary)
}

function compilerCoreProgramWithMainSummary(source: String, mainBlock: CompilerMainBlock, block: CompilerBlock, parsedDeclarations: CompilerParsedDeclarations, statements: CompilerParsedStatements, statementSummary: String): CompilerProgram {
    return CompilerProgram(
        source: source,
        hasMainBlock: true,
        mainAttributeStart: mainBlock.attributeStart,
        mainBlock: block,
        mainStatementRecords: statements.records,
        mainStatementSummary: statementSummary,
        declarationRecords: parsedDeclarations.records,
        declarationSummary: parsedDeclarations.declarationSummary
    )
}

function compilerCoreSymbolSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreSymbolSummaryForProgram(program: program)
}

function compilerTypedTopLevelSymbolRender(tables: CompilerSyntaxTables): String {
    let typedSymbolBuffer: TextBuffer(textBufferCreate(capacity: 2048))
    let typedSymbolTab: String("\t")
    let typedSymbolNewline: String(compilerCoreNewlineCharacter())
    state typedSymbolDeclarationRow: Int(0)
    let typedSymbolDeclarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while typedSymbolDeclarationRow < typedSymbolDeclarationCount {
        let typedSymbolSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: typedSymbolDeclarationRow, column: 0))
        let typedSymbolFileID: Int(compilerIntTableValue(table: tables.declarations, row: typedSymbolDeclarationRow, column: 1))
        let typedSymbolKindTag: Int(compilerIntTableValue(table: tables.declarations, row: typedSymbolDeclarationRow, column: 2))
        let typedSymbolNameStart: Int(compilerIntTableValue(table: tables.declarations, row: typedSymbolDeclarationRow, column: 7))
        let typedSymbolNameEnd: Int(compilerIntTableValue(table: tables.declarations, row: typedSymbolDeclarationRow, column: 8))
        let typedSymbolName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolFileID, localStart: typedSymbolNameStart, localEnd: typedSymbolNameEnd))
        if typedSymbolKindTag == compilerSyntaxKindConstruct() {
            state typedSymbolMemberShape: String("")
            state typedSymbolMemberRow: Int(0)
            let typedSymbolMemberCount: Int(compilerIntTableRowCount(table: tables.members))
            while typedSymbolMemberRow < typedSymbolMemberCount {
                if compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 2) == typedSymbolSyntaxID {
                    let typedSymbolMemberFileID: Int(compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 1))
                    let typedSymbolMemberOrdinal: Int(compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 3))
                    let typedSymbolMemberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolMemberFileID, localStart: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 7)))
                    let typedSymbolMemberType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolMemberFileID, localStart: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 9)))
                    typedSymbolMemberShape: "\(typedSymbolMemberShape)member\(typedSymbolMemberOrdinal).name=\(typedSymbolMemberName),type=\(typedSymbolMemberType);"
                }
                typedSymbolMemberRow: typedSymbolMemberRow + 1
            }
            textBufferAppend(buffer: typedSymbolBuffer, text: "symbol\(typedSymbolTab)kind=construct\(typedSymbolTab)name=\(typedSymbolName)\(typedSymbolTab)scope=program\(typedSymbolTab)members=[\(typedSymbolMemberShape)]\(typedSymbolNewline)")
            typedSymbolMemberRow: 0
            while typedSymbolMemberRow < typedSymbolMemberCount {
                if compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 2) == typedSymbolSyntaxID {
                    let typedSymbolMemberOutputFileID: Int(compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 1))
                    let typedSymbolMemberOutputName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolMemberOutputFileID, localStart: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 7)))
                    let typedSymbolMemberOutputType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolMemberOutputFileID, localStart: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: typedSymbolMemberRow, column: 9)))
                    textBufferAppend(buffer: typedSymbolBuffer, text: "symbol\(typedSymbolTab)kind=member\(typedSymbolTab)name=\(typedSymbolMemberOutputName)\(typedSymbolTab)scope=construct:\(typedSymbolName)\(typedSymbolTab)type=\(typedSymbolMemberOutputType)\(typedSymbolNewline)")
                }
                typedSymbolMemberRow: typedSymbolMemberRow + 1
            }
        } else if typedSymbolKindTag == compilerSyntaxKindFunction() {
            let typedSymbolFunctionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: typedSymbolSyntaxID, column: 1))
            let typedSymbolReturnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolFileID, localStart: compilerIntTableValue(table: tables.functions, row: typedSymbolFunctionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: typedSymbolFunctionRow, column: 7)))
            state typedSymbolParameterShape: String("")
            state typedSymbolParameterRow: Int(0)
            let typedSymbolParameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
            while typedSymbolParameterRow < typedSymbolParameterCount {
                if compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 2) == typedSymbolFunctionRow {
                    let typedSymbolParameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 1))
                    let typedSymbolParameterOrdinal: Int(compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 3))
                    let typedSymbolParameterName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolParameterFileID, localStart: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 7)))
                    let typedSymbolParameterType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolParameterFileID, localStart: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 9)))
                    typedSymbolParameterShape: "\(typedSymbolParameterShape)parameter\(typedSymbolParameterOrdinal).name=\(typedSymbolParameterName),type=\(typedSymbolParameterType);"
                }
                typedSymbolParameterRow: typedSymbolParameterRow + 1
            }
            textBufferAppend(buffer: typedSymbolBuffer, text: "symbol\(typedSymbolTab)kind=function\(typedSymbolTab)name=\(typedSymbolName)\(typedSymbolTab)scope=program\(typedSymbolTab)parameters=[\(typedSymbolParameterShape)]\(typedSymbolTab)returnType=\(typedSymbolReturnType)\(typedSymbolNewline)")
            typedSymbolParameterRow: 0
            while typedSymbolParameterRow < typedSymbolParameterCount {
                if compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 2) == typedSymbolFunctionRow {
                    let typedSymbolParameterOutputFileID: Int(compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 1))
                    let typedSymbolParameterOutputName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolParameterOutputFileID, localStart: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 7)))
                    let typedSymbolParameterOutputType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedSymbolParameterOutputFileID, localStart: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: typedSymbolParameterRow, column: 9)))
                    textBufferAppend(buffer: typedSymbolBuffer, text: "symbol\(typedSymbolTab)kind=parameter\(typedSymbolTab)name=\(typedSymbolParameterOutputName)\(typedSymbolTab)scope=function:\(typedSymbolName)\(typedSymbolTab)type=\(typedSymbolParameterOutputType)\(typedSymbolNewline)")
                }
                typedSymbolParameterRow: typedSymbolParameterRow + 1
            }
        }
        typedSymbolDeclarationRow: typedSymbolDeclarationRow + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: typedSymbolBuffer)
}

function compilerTypedTopLevelSymbolSummary(source: String): String {
    let typedSymbolTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let typedSymbolCaptureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: typedSymbolTables))
    state typedSymbolSummary: String("")
    if typedSymbolCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: typedSymbolTables) {
        typedSymbolSummary: String("compilerError\tkind=invalidTypedSymbolSnapshot\n")
    } else {
        typedSymbolSummary: compilerTypedTopLevelSymbolRender(tables: typedSymbolTables)
    }
    let typedSymbolDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: typedSymbolTables))
    if typedSymbolDestroyStatus != 0 { return String("compilerError\tkind=typedSymbolOwnershipFailure\n") }
    return typedSymbolSummary
}

function compilerCoreSymbolSummaryForProgram(program: CompilerProgram): String {
    state output: String("symbols\tprogram\n")
    output: "\(output)\(compilerTypedTopLevelSymbolSummary(source: program.source))"
    if program.hasMainBlock {
        let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
        output: "\(output)\(compilerCoreStatementRecordsSymbolSummary(statementRecords: parsedBlock.statementRecords, scopeName: String("main")))"
    }
    return output
}

function compilerCoreStatementRecordsSymbolSummary(statementRecords: String, scopeName: String): String {
    state output: String("")
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: statementRecords))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("let") || statement.kind == String("state") {
            output: "\(output)symbol\tkind=\(statement.kind)\tname=\(statement.name)\tscope=\(scopeName)\ttype=\(statement.typeName)\texpressionKind=\(statement.expressionKind)\n"
        } else if statement.kind == String("if") || statement.kind == String("while") {
            output: "\(output)\(compilerCoreStatementRecordsSymbolSummary(statementRecords: statement.bodyStatementRecords, scopeName: "\(scopeName).\(statement.kind)@\(statement.start)"))"
        }

        statementIndex: compilerCoreStatementRecordNextIndex(records: statementRecords, start: statementIndex)
    }

    return output
}

function compilerCoreTypeSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreTypeSummaryForProgram(program: program)
}

function compilerCoreTypeSummaryForProgram(program: CompilerProgram): String {
    state output: String("types\tprogram\n")
    output: "\(output)\(compilerCoreFunctionRecordsTypeSummary(program: program))"
    if program.hasMainBlock {
        let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
        output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: program.declarationRecords, statementRecords: parsedBlock.statementRecords, scopeName: String("main"), incomingLocals: String(""), expectedReturnType: String("Int")))"
    }
    return output
}

function compilerCoreFunctionRecordsTypeSummary(program: CompilerProgram): String {
    state output: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
        if record == String("") {
            return output
        }

        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        if declaration.kind == String("function") {
            let parameterTypes: String(compilerCoreFunctionParameterLocalTypes(parameterSummary: declaration.parameterSummary))
            output: "\(output)type\tkind=function\tname=\(declaration.name)\tscope=program\treturnType=\(declaration.returnType)\n"
            output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: program.declarationRecords, statementRecords: declaration.statementRecords, scopeName: "function:\(declaration.name)", incomingLocals: parameterTypes, expectedReturnType: declaration.returnType))"
        }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex)
    }

    return output
}

function compilerCoreStatementRecordsTypeSummary(declarationRecords: String, statementRecords: String, scopeName: String, incomingLocals: String, expectedReturnType: String): String {
    state output: String("")
    state localTypes: String("")
    localTypes: incomingLocals
    state statementIndex: Int(0)
    let statementsLength: Int(stringLength(value: statementRecords))

    while statementIndex < statementsLength {
        let statementRecord: String(compilerCoreStatementRecordAt(records: statementRecords, start: statementIndex))
        if statementRecord == String("") {
            return output
        }

        let statement: CompilerStatement(compilerCoreStatementFromRecord(record: statementRecord))
        if statement.kind == String("let") || statement.kind == String("state") {
            let inferredType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: statement.expressionSummary, expectedType: statement.typeName))
            output: "\(output)type\tkind=\(statement.kind)\tname=\(statement.name)\tscope=\(scopeName)\tdeclared=\(statement.typeName)\tinferred=\(inferredType)\tstatus=\(compilerCoreTypeStatus(declaredType: statement.typeName, inferredType: inferredType))\n"
            localTypes: "\(localTypes)\(statement.name):\(statement.typeName);"
        } else if statement.kind == String("return") {
            let returnType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: statement.expressionSummary, expectedType: expectedReturnType))
            output: "\(output)type\tkind=return\tscope=\(scopeName)\tinferred=\(returnType)\tdeclared=\(expectedReturnType)\tstatus=\(compilerCoreTypeStatus(declaredType: expectedReturnType, inferredType: returnType))\n"
        } else if statement.kind == String("if") || statement.kind == String("while") {
            let conditionType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: statement.expressionSummary, expectedType: String("Bool")))
            output: "\(output)type\tkind=\(statement.kind)\tscope=\(scopeName)\tcondition=\(conditionType)\tstatus=\(compilerCoreTypeStatus(declaredType: String("Bool"), inferredType: conditionType))\n"
            output: "\(output)\(compilerCoreStatementRecordsTypeSummary(declarationRecords: declarationRecords, statementRecords: statement.bodyStatementRecords, scopeName: "\(scopeName).\(statement.kind)@\(statement.start)", incomingLocals: localTypes, expectedReturnType: expectedReturnType))"
        }

        statementIndex: compilerCoreStatementRecordNextIndex(records: statementRecords, start: statementIndex)
    }

    return output
}

function compilerCoreFunctionParameterLocalTypes(parameterSummary: String): String {
    state output: String("")
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: parameterSummary))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: parameterSummary, start: sourceIndex, prefix: String("parameter")) {
            let indexStart: Int(sourceIndex + 9)
            state scanIndex: Int(0)
            scanIndex: indexStart
            while scanIndex < sourceLength && !hasRangePrefix(source: parameterSummary, start: scanIndex, prefix: String(".name=")) {
                scanIndex: scanIndex + 1
            }
            if scanIndex < sourceLength {
                let nameStart: Int(scanIndex + 6)
                state nameEnd: Int(0)
                nameEnd: nameStart
                while nameEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: nameEnd, prefix: String(",type=")) {
                    nameEnd: nameEnd + 1
                }
                if nameEnd < sourceLength {
                    let typeStart: Int(nameEnd + 6)
                    state typeEnd: Int(0)
                    typeEnd: typeStart
                    while typeEnd < sourceLength && !hasRangePrefix(source: parameterSummary, start: typeEnd, prefix: String(";")) {
                        typeEnd: typeEnd + 1
                    }
                    let parameterName: String(parameterSummary.substring(start: nameStart, end: nameEnd))
                    let parameterType: String(parameterSummary.substring(start: typeStart, end: typeEnd))
                    output: "\(output)\(parameterName):\(parameterType);"
                    sourceIndex: typeEnd
                } else {
                    sourceIndex: scanIndex + 1
                }
            } else {
                sourceIndex: scanIndex
            }
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return output
}

function compilerCoreTypeStatus(declaredType: String, inferredType: String): String {
    if inferredType == String("Unknown") {
        return String("unknown")
    }

    if declaredType == String("") || declaredType == inferredType {
        return String("ok")
    }

    if compilerCoreTypeIsOptionalOf(optionalType: declaredType, valueType: inferredType) {
        return String("ok")
    }

    return String("mismatch")
}

function compilerCoreTypeIsOptionalOf(optionalType: String, valueType: String): Bool {
    return optionalType == "Optional<\(valueType)>"
        || optionalType == "\(valueType)?"
}

function compilerCoreExpressionSummaryRangeTypeForLLVM(context: CompilerLLVMLoweringContext, localValues: String, expressionSummary: String, expectedType: String): String {
    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("integerLiteral(")) {
        return String("Int")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("stringLiteral(")) {
        return String("String")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("boolLiteral(")) {
        return String("Bool")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("identifier(")) {
        let identifierName: String(compilerCoreIdentifierExpressionName(summary: expressionSummary))
        let localType: String(compilerCoreLookupLLVMLocalRangeType(localValues: localValues, name: identifierName))
        if localType != String("") {
            return localType
        }
        return String("Unknown")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("prefix(")) {
        let prefixOperatorText: String(compilerCorePrefixExpressionOperator(summary: expressionSummary))
        if prefixOperatorText == String("!") {
            return String("Bool")
        }
        if prefixOperatorText == String("-") {
            return String("Int")
        }

        let operandSummary: String(compilerCorePrefixExpressionOperand(summary: expressionSummary))
        return compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: operandSummary, expectedType: expectedType)
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("binary(")) {
        let binaryOperatorText: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 1))
        if binaryOperatorText == String("plus")
            || binaryOperatorText == String("+")
            || binaryOperatorText == String("minus")
            || binaryOperatorText == String("-")
            || binaryOperatorText == String("asterisk")
            || binaryOperatorText == String("*")
            || binaryOperatorText == String("slash")
            || binaryOperatorText == String("/")
            || binaryOperatorText == String("percent")
            || binaryOperatorText == String("%")
        {
            return String("Int")
        }

        if binaryOperatorText == String("equalEqual")
            || binaryOperatorText == String("==")
            || binaryOperatorText == String("bangEqual")
            || binaryOperatorText == String("!=")
            || binaryOperatorText == String("less")
            || binaryOperatorText == String("<")
            || binaryOperatorText == String("lessEqual")
            || binaryOperatorText == String("<=")
            || binaryOperatorText == String("greater")
            || binaryOperatorText == String(">")
            || binaryOperatorText == String("greaterEqual")
            || binaryOperatorText == String(">=")
            || binaryOperatorText == String("andAnd")
            || binaryOperatorText == String("&&")
            || binaryOperatorText == String("orOr")
            || binaryOperatorText == String("||")
        {
            return String("Bool")
        }

        if binaryOperatorText == String("questionQuestion") || binaryOperatorText == String("??") {
            if expectedType != String("") {
                return expectedType
            }

            let leftSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 0))
            let leftType: String(compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: leftSummary, expectedType: String("")))
            if leftType != String("Unknown") {
                return leftType
            }

            let rightSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 2))
            return compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: rightSummary, expectedType: String(""))
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: expressionSummary))
        let functionReturnType: String(compilerLLVMLoweringContextFunctionReturnType(context: context, name: functionName))
        if functionReturnType != String("") {
            return functionReturnType
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("member(")) {
        let baseSummary: String(compilerCoreMemberExpressionBase(summary: expressionSummary))
        let baseType: String(compilerCoreExpressionSummaryRangeTypeForLLVM(context: context, localValues: localValues, expressionSummary: baseSummary, expectedType: String("")))
        let memberName: String(compilerCoreMemberExpressionName(summary: expressionSummary))
        if baseType != String("Unknown") && baseType != String("") {
            let memberType: String(compilerLLVMLoweringContextConstructMemberType(context: context, constructName: baseType, memberName: memberName))
            if memberType != String("") {
                return memberType
            }
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    return String("Unknown")
}

function compilerCoreInferExpressionSummaryType(declarationRecords: String, localTypes: String, expressionSummary: String, expectedType: String): String {
    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("integerLiteral(")) {
        return String("Int")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("stringLiteral(")) {
        return String("String")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("boolLiteral(")) {
        return String("Bool")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("identifier(")) {
        let identifierName: String(compilerCoreIdentifierExpressionName(summary: expressionSummary))
        let localType: String(compilerCoreLookupLocalType(localTypes: localTypes, name: identifierName))
        if localType != String("") {
            return localType
        }
        return String("Unknown")
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("prefix(")) {
        let prefixOperatorText: String(compilerCorePrefixExpressionOperator(summary: expressionSummary))
        if prefixOperatorText == String("!") {
            return String("Bool")
        }
        if prefixOperatorText == String("-") {
            return String("Int")
        }

        let operandSummary: String(compilerCorePrefixExpressionOperand(summary: expressionSummary))
        return compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: operandSummary, expectedType: expectedType)
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("binary(")) {
        let binaryOperatorText: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 1))
        if binaryOperatorText == String("plus")
            || binaryOperatorText == String("+")
            || binaryOperatorText == String("minus")
            || binaryOperatorText == String("-")
            || binaryOperatorText == String("asterisk")
            || binaryOperatorText == String("*")
            || binaryOperatorText == String("slash")
            || binaryOperatorText == String("/")
            || binaryOperatorText == String("percent")
            || binaryOperatorText == String("%")
        {
            return String("Int")
        }

        if binaryOperatorText == String("equalEqual")
            || binaryOperatorText == String("==")
            || binaryOperatorText == String("bangEqual")
            || binaryOperatorText == String("!=")
            || binaryOperatorText == String("less")
            || binaryOperatorText == String("<")
            || binaryOperatorText == String("lessEqual")
            || binaryOperatorText == String("<=")
            || binaryOperatorText == String("greater")
            || binaryOperatorText == String(">")
            || binaryOperatorText == String("greaterEqual")
            || binaryOperatorText == String(">=")
            || binaryOperatorText == String("andAnd")
            || binaryOperatorText == String("&&")
            || binaryOperatorText == String("orOr")
            || binaryOperatorText == String("||")
        {
            return String("Bool")
        }

        if binaryOperatorText == String("questionQuestion") || binaryOperatorText == String("??") {
            if expectedType != String("") {
                return expectedType
            }

            let leftSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 0))
            let leftType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: leftSummary, expectedType: String("")))
            if leftType != String("Unknown") {
                return leftType
            }

            let rightSummary: String(compilerCoreBinaryExpressionPart(summary: expressionSummary, partIndex: 2))
            return compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: rightSummary, expectedType: String(""))
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("call(identifier(")) {
        let functionName: String(compilerCoreCallIdentifierName(summary: expressionSummary))
        let functionReturnType: String(compilerCoreDeclarationRecordsFunctionReturnType(records: declarationRecords, name: functionName))
        if functionReturnType != String("") {
            return functionReturnType
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    if hasRangePrefix(source: expressionSummary, start: 0, prefix: String("member(")) {
        let baseSummary: String(compilerCoreMemberExpressionBase(summary: expressionSummary))
        let baseType: String(compilerCoreInferExpressionSummaryType(declarationRecords: declarationRecords, localTypes: localTypes, expressionSummary: baseSummary, expectedType: String("")))
        let memberName: String(compilerCoreMemberExpressionName(summary: expressionSummary))
        if baseType != String("Unknown") {
            let memberType: String(compilerCoreDeclarationRecordsConstructMemberType(records: declarationRecords, constructName: baseType, memberName: memberName))
            if memberType != String("") {
                return memberType
            }
        }
        if expectedType != String("") {
            return expectedType
        }
    }

    return String("Unknown")
}

function compilerCoreLookupLocalType(localTypes: String, name: String): String {
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: localTypes))
    let namePrefix: String("\(name):")
    let namePrefixLength: Int(stringLength(value: namePrefix))

    while sourceIndex < sourceLength {
        if hasRangePrefix(source: localTypes, start: sourceIndex, prefix: namePrefix) {
            let typeStart: Int(sourceIndex + namePrefixLength)
            state typeEnd: Int(0)
            typeEnd: typeStart
            while typeEnd < sourceLength && !hasRangePrefix(source: localTypes, start: typeEnd, prefix: String(";")) {
                typeEnd: typeEnd + 1
            }
            return localTypes.substring(start: typeStart, end: typeEnd)
        }
        sourceIndex: sourceIndex + 1
    }

    return String("")
}

function parseCompilerTopLevelDeclarations(source: String): CompilerParsedDeclarations {
    return parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: source, includeFunctionBodies: false)
}

function parseCompilerTopLevelDeclarationsForLLVM(source: String): CompilerParsedDeclarations {
    return parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: source, bodyFunctionNames: String(""))
}

function parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: String, bodyFunctionNames: String): CompilerParsedDeclarations {
    state parsedDeclarations: CompilerParsedDeclarations(CompilerParsedDeclarations(records: String(""), declarationSummary: String(""), functionSummary: String(""), count: 0))
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))
        if maybeToken == nil {
            return parsedDeclarations
        }
        let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        let step: CompilerTopLevelDeclarationParseStep(compilerCoreParseTopLevelDeclarationStepForLLVM(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, token: token))
        parsedDeclarations: step.parsedDeclarations
        sourceIndex: step.nextIndex
    }

    return parsedDeclarations
}

function parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: String, includeFunctionBodies: Bool): CompilerParsedDeclarations {
    state parsedDeclarations: CompilerParsedDeclarations(CompilerParsedDeclarations(records: String(""), declarationSummary: String(""), functionSummary: String(""), count: 0))
    state sourceIndex: Int(0)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))
        if maybeToken == nil {
            return parsedDeclarations
        }
        let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        let step: CompilerTopLevelDeclarationParseStep(compilerCoreParseTopLevelDeclarationStep(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, token: token))
        parsedDeclarations: step.parsedDeclarations
        sourceIndex: step.nextIndex
    }

    return parsedDeclarations
}

function compilerCoreParseTopLevelDeclarationStepForLLVM(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    state tokenKind: String("")
    tokenKind: token.kind
    if tokenKind == String("keyword") {
        state tokenText: String("")
        tokenText: token.text
        if tokenText == String("construct") {
            return compilerCoreParseConstructDeclarationStepForLLVM(source: source, parsedDeclarations: parsedDeclarations, token: token)
        }

        if tokenText == String("function") {
            return compilerCoreParseFunctionDeclarationStepForLLVM(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, token: token)
        }
    }

    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
}

function compilerCoreParseConstructDeclarationStepForLLVM(source: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeConstruct: Optional<CompilerConstructDeclaration>(parseCompilerConstructDeclaration(source: source, keyword: token))
    if maybeConstruct == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let constructFallback: CompilerConstructDeclaration(CompilerConstructDeclaration(name: String(""), memberSummary: String(""), bodyStart: 0, bodyEnd: token.end))
    let constructDeclaration: CompilerConstructDeclaration(maybeConstruct ?? constructFallback)
    return compilerCoreParseConstructDeclarationStepForLLVMFromDeclaration(parsedDeclarations: parsedDeclarations, declaration: constructDeclaration)
}

function compilerCoreParseConstructDeclarationStepForLLVMFromDeclaration(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerConstructDeclaration): CompilerTopLevelDeclarationParseStep {
    let constructTopLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreConstructTopLevelDeclaration(declaration: declaration))
    let nextConstructDeclarations: CompilerParsedDeclarations(compilerCoreAppendDeclarationRecordOnly(parsedDeclarations: parsedDeclarations, declaration: constructTopLevelDeclaration))
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextConstructDeclarations, nextIndex: compilerCoreNextInt(value: declaration.bodyEnd))
}

function compilerCoreParseFunctionDeclarationStepForLLVM(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeFunction: Optional<CompilerFunctionDeclaration>(parseCompilerFunctionDeclaration(source: source, keyword: token))
    return compilerCoreParseFunctionDeclarationStepForLLVMMaybe(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, token: token, maybeFunction: maybeFunction)
}

function compilerCoreParseFunctionDeclarationStepForLLVMMaybe(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken, maybeFunction: Optional<CompilerFunctionDeclaration>): CompilerTopLevelDeclarationParseStep {
    if maybeFunction == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let functionFallback: CompilerFunctionDeclaration(CompilerFunctionDeclaration(name: String(""), parameterStart: 0, parameterEnd: 0, parameterSummary: String(""), returnType: String(""), bodyStart: 0, bodyEnd: token.end))
    let functionDeclaration: CompilerFunctionDeclaration(maybeFunction ?? functionFallback)
    return compilerCoreParseFunctionDeclarationStepForLLVMFromDeclaration(source: source, bodyFunctionNames: bodyFunctionNames, parsedDeclarations: parsedDeclarations, declaration: functionDeclaration)
}

function compilerCoreParseFunctionDeclarationStepForLLVMFromDeclaration(source: String, bodyFunctionNames: String, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclarationParseStep {
    let includeBody: Bool(compilerCoreNameListContains(names: bodyFunctionNames, name: declaration.name))
    return compilerCoreParseFunctionDeclarationStepForLLVMWithBodyMode(source: source, includeBody: includeBody, parsedDeclarations: parsedDeclarations, declaration: declaration)
}

function compilerCoreParseFunctionDeclarationStepForLLVMWithBodyMode(source: String, includeBody: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclarationParseStep {
    let topLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreFunctionTopLevelDeclaration(source: source, includeFunctionBodies: includeBody, parsedDeclarations: parsedDeclarations, declaration: declaration))
    let nextFunctionDeclarations: CompilerParsedDeclarations(compilerCoreAppendDeclarationRecordOnly(parsedDeclarations: parsedDeclarations, declaration: topLevelDeclaration))
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextFunctionDeclarations, nextIndex: compilerCoreNextInt(value: declaration.bodyEnd))
}

function compilerCoreAppendDeclarationRecordOnly(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerTopLevelDeclaration): CompilerParsedDeclarations {
    let declarationRecord: String(compilerCoreTopLevelDeclarationRecord(declaration: declaration))
    return CompilerParsedDeclarations(
        records: compilerCoreTextBufferConcat(left: parsedDeclarations.records, right: declarationRecord),
        declarationSummary: parsedDeclarations.declarationSummary,
        functionSummary: parsedDeclarations.functionSummary,
        count: compilerCoreNextInt(value: parsedDeclarations.count)
    )
}

function compilerCoreNextInt(value: Int): Int {
    return value + 1
}

function compilerCoreParseTopLevelDeclarationStep(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    state tokenKind: String("")
    tokenKind: token.kind
    state tokenText: String("")
    tokenText: token.text
    if tokenKind == String("keyword") {
        if tokenText == String("construct") {
            return compilerCoreParseConstructDeclarationStep(source: source, parsedDeclarations: parsedDeclarations, token: token)
        }

        if tokenText == String("function") {
            return compilerCoreParseFunctionDeclarationStep(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, token: token)
        }
    }

    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
}

function compilerCoreParseConstructDeclarationStep(source: String, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeConstruct: Optional<CompilerConstructDeclaration>(parseCompilerConstructDeclaration(source: source, keyword: token))
    if maybeConstruct == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let constructFallback: CompilerConstructDeclaration(CompilerConstructDeclaration(name: String(""), memberSummary: String(""), bodyStart: 0, bodyEnd: token.end))
    let constructDeclaration: CompilerConstructDeclaration(maybeConstruct ?? constructFallback)
    let constructTopLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreConstructTopLevelDeclaration(declaration: constructDeclaration))
    let nextParsedDeclarations: CompilerParsedDeclarations(compilerCoreAppendConstructDeclaration(parsedDeclarations: parsedDeclarations, declaration: constructTopLevelDeclaration))
    state nextIndex: Int(0)
    nextIndex: constructDeclaration.bodyEnd
    nextIndex: nextIndex + 1
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextParsedDeclarations, nextIndex: nextIndex)
}

function compilerCoreParseFunctionDeclarationStep(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, token: RangeLexedToken): CompilerTopLevelDeclarationParseStep {
    let maybeFunction: Optional<CompilerFunctionDeclaration>(parseCompilerFunctionDeclaration(source: source, keyword: token))
    if maybeFunction == nil {
        return CompilerTopLevelDeclarationParseStep(parsedDeclarations: parsedDeclarations, nextIndex: token.end)
    }

    let functionFallback: CompilerFunctionDeclaration(CompilerFunctionDeclaration(name: String(""), parameterStart: 0, parameterEnd: 0, parameterSummary: String(""), returnType: String(""), bodyStart: 0, bodyEnd: token.end))
    let functionDeclaration: CompilerFunctionDeclaration(maybeFunction ?? functionFallback)
    return compilerCoreParseFunctionDeclarationStepFromDeclaration(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, declaration: functionDeclaration)
}

function compilerCoreParseFunctionDeclarationStepFromDeclaration(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclarationParseStep {
    let functionTopLevelDeclaration: CompilerTopLevelDeclaration(compilerCoreFunctionTopLevelDeclaration(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, declaration: declaration))
    let nextParsedDeclarations: CompilerParsedDeclarations(compilerCoreAppendFunctionDeclaration(parsedDeclarations: parsedDeclarations, declaration: functionTopLevelDeclaration))
    state nextIndex: Int(0)
    nextIndex: declaration.bodyEnd
    nextIndex: nextIndex + 1
    return CompilerTopLevelDeclarationParseStep(parsedDeclarations: nextParsedDeclarations, nextIndex: nextIndex)
}

function compilerCoreConstructTopLevelDeclaration(declaration: CompilerConstructDeclaration): CompilerTopLevelDeclaration {
    return CompilerTopLevelDeclaration(
        kind: String("construct"),
        name: declaration.name,
        parameterStart: 0,
        parameterEnd: 0,
        parameterSummary: String(""),
        returnType: String(""),
        memberSummary: declaration.memberSummary,
        statementRecords: String(""),
        statementSummary: String(""),
        bodyStart: declaration.bodyStart,
        bodyEnd: declaration.bodyEnd
    )
}

function compilerCoreAppendConstructDeclaration(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerTopLevelDeclaration): CompilerParsedDeclarations {
    let declarationText: String(compilerCoreTopLevelDeclarationSummary(declaration: declaration))
    state nextCount: Int(0)
    nextCount: parsedDeclarations.count
    nextCount: nextCount + 1
    let declarationRecord: String(compilerCoreTopLevelDeclarationRecord(declaration: declaration))
    return CompilerParsedDeclarations(
        records: compilerCoreTextBufferConcat(left: parsedDeclarations.records, right: declarationRecord),
        declarationSummary: compilerCoreTextBufferConcat(left: parsedDeclarations.declarationSummary, right: declarationText),
        functionSummary: parsedDeclarations.functionSummary,
        count: nextCount
    )
}

function compilerCoreFunctionTopLevelDeclaration(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerTopLevelDeclaration {
    let parsedFunctionBody: CompilerParsedStatements(compilerCoreParseFunctionBodyStatements(source: source, includeFunctionBodies: includeFunctionBodies, parsedDeclarations: parsedDeclarations, declaration: declaration))
    return compilerCoreFunctionTopLevelDeclarationWithParsedBody(declaration: declaration, parsedFunctionBody: parsedFunctionBody)
}

function compilerCoreFunctionTopLevelDeclarationWithParsedBody(declaration: CompilerFunctionDeclaration, parsedFunctionBody: CompilerParsedStatements): CompilerTopLevelDeclaration {
    return CompilerTopLevelDeclaration(
        kind: String("function"),
        name: declaration.name,
        parameterStart: declaration.parameterStart,
        parameterEnd: declaration.parameterEnd,
        parameterSummary: declaration.parameterSummary,
        returnType: declaration.returnType,
        memberSummary: String(""),
        statementRecords: parsedFunctionBody.records,
        statementSummary: String(""),
        bodyStart: declaration.bodyStart,
        bodyEnd: declaration.bodyEnd
    )
}

function compilerCoreAppendFunctionDeclaration(parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerTopLevelDeclaration): CompilerParsedDeclarations {
    let declarationText: String(compilerCoreTopLevelDeclarationSummary(declaration: declaration))
    state nextCount: Int(0)
    nextCount: parsedDeclarations.count
    nextCount: nextCount + 1
    let declarationRecord: String(compilerCoreTopLevelDeclarationRecord(declaration: declaration))
    return CompilerParsedDeclarations(
        records: compilerCoreTextBufferConcat(left: parsedDeclarations.records, right: declarationRecord),
        declarationSummary: compilerCoreTextBufferConcat(left: parsedDeclarations.declarationSummary, right: declarationText),
        functionSummary: compilerCoreTextBufferConcat(left: parsedDeclarations.functionSummary, right: declarationText),
        count: nextCount
    )
}

function compilerCoreParseFunctionBodyStatements(source: String, includeFunctionBodies: Bool, parsedDeclarations: CompilerParsedDeclarations, declaration: CompilerFunctionDeclaration): CompilerParsedStatements {
    state bodyStart: Int(0)
    bodyStart: declaration.bodyStart
    state bodyEnd: Int(0)
    bodyEnd: declaration.bodyEnd
    if !includeFunctionBodies {
        return compilerCoreEmptyParsedStatements(start: bodyStart, end: bodyEnd)
    }

    return compilerCoreParseIncludedFunctionBodyStatements(source: source, parsedDeclarations: parsedDeclarations, bodyStart: bodyStart, bodyEnd: bodyEnd)
}

function compilerCoreParseIncludedFunctionBodyStatements(source: String, parsedDeclarations: CompilerParsedDeclarations, bodyStart: Int, bodyEnd: Int): CompilerParsedStatements {
    let functionBlock: CompilerBlock(CompilerBlock(start: bodyStart, end: bodyEnd))
    let emptyParsedDeclarations: CompilerParsedDeclarations(CompilerParsedDeclarations(records: String(""), declarationSummary: String(""), functionSummary: String(""), count: 0))
    let functionProgram: CompilerProgram(compilerCoreProgramWithoutMain(source: source, parsedDeclarations: emptyParsedDeclarations))
    return compilerCoreParseStatements(program: functionProgram, block: functionBlock)
}

function compilerCoreEmptyParsedStatements(start: Int, end: Int): CompilerParsedStatements {
    return CompilerParsedStatements(records: String(""), summary: String(""), count: 0, start: start, end: end)
}

function compilerCoreTopLevelDeclarationRecord(declaration: CompilerTopLevelDeclaration): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1024))
    if textBufferAppend(buffer: outputBuffer, text: "kind=\(declaration.kind)|name=\(declaration.name)|parameterStart=") != 0 { return String("") }
    if textBufferAppendInt(buffer: outputBuffer, value: declaration.parameterStart) != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: String("|parameterEnd=")) != 0 { return String("") }
    if textBufferAppendInt(buffer: outputBuffer, value: declaration.parameterEnd) != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: "|parameters=\(declaration.parameterSummary)|returnType=\(declaration.returnType)|members=\(declaration.memberSummary)|statementRecords=") != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: compilerCoreStatementRecordEncodeValue(value: declaration.statementRecords)) != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: String("|statementSummary=|bodyStart=")) != 0 { return String("") }
    if textBufferAppendInt(buffer: outputBuffer, value: declaration.bodyStart) != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: String("|bodyEnd=")) != 0 { return String("") }
    if textBufferAppendInt(buffer: outputBuffer, value: declaration.bodyEnd) != 0 { return String("") }
    if textBufferAppend(buffer: outputBuffer, text: compilerCoreTopLevelDeclarationRecordTerminator()) != 0 { return String("") }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreTopLevelDeclarationRecordTerminator(): String {
    return String("~")
}

function compilerCoreTopLevelDeclarationRecordAt(records: String, start: Int): String {
    let terminator: String(compilerCoreTopLevelDeclarationRecordTerminator())
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: terminator))
    if recordEnd < 0 {
        return String("")
    }
    return stringViewFrom(source: records, start: start)
}

function compilerCoreTopLevelDeclarationRecordNextIndex(records: String, start: Int): Int {
    let terminator: String(compilerCoreTopLevelDeclarationRecordTerminator())
    let recordEnd: Int(stringFindFrom(source: records, start: start, needle: terminator))
    if recordEnd < 0 {
        return stringLength(value: records)
    }
    return recordEnd + 1
}

function compilerCoreTopLevelDeclarationFromRecord(record: String): CompilerTopLevelDeclaration {
    return CompilerTopLevelDeclaration(
        kind: compilerCoreRecordField(record: record, prefix: String("kind=")),
        name: compilerCoreRecordField(record: record, prefix: String("name=")),
        parameterStart: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("parameterStart="))),
        parameterEnd: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("parameterEnd="))),
        parameterSummary: compilerCoreRecordField(record: record, prefix: String("parameters=")),
        returnType: compilerCoreRecordField(record: record, prefix: String("returnType=")),
        memberSummary: compilerCoreRecordField(record: record, prefix: String("members=")),
        statementRecords: compilerCoreStatementRecordDecodeValue(value: compilerCoreRecordField(record: record, prefix: String("statementRecords="))),
        statementSummary: compilerCoreStatementRecordDecodeValue(value: compilerCoreRecordField(record: record, prefix: String("statementSummary="))),
        bodyStart: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("bodyStart="))),
        bodyEnd: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("bodyEnd=")))
    )
}

function compilerCoreTopLevelDeclarationSummary(declaration: CompilerTopLevelDeclaration): String {
    state declarationKind: String("")
    declarationKind: declaration.kind
    if declarationKind == String("construct") {
        return "ast\tconstruct\tname=\(declaration.name)\tmembers=[\(declaration.memberSummary)]\tbodyStart=\(declaration.bodyStart)\tbodyEnd=\(declaration.bodyEnd)\n"
    }

    if declarationKind == String("function") {
        return "ast\tfunction\tname=\(declaration.name)\tparametersStart=\(declaration.parameterStart)\tparametersEnd=\(declaration.parameterEnd)\tparameters=[\(declaration.parameterSummary)]\treturnType=\(declaration.returnType)\tbodyStart=\(declaration.bodyStart)\tbodyEnd=\(declaration.bodyEnd)\n"
    }

    return String("")
}

function compilerCoreDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.declarationSummary
}

function compilerCoreFunctionDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.functionSummary
}

function compilerCursorPeek(cursor: CompilerTokenCursor): Optional<RangeLexedToken> {
    return lexNextRangeToken(source: cursor.source, start: cursor.index)
}

function compilerCursorAdvance(cursor: CompilerTokenCursor, token: RangeLexedToken): CompilerTokenCursor {
    return CompilerTokenCursor(source: cursor.source, index: token.end)
}

function compilerFallbackToken(cursor: CompilerTokenCursor): RangeLexedToken {
    return RangeLexedToken(kind: String("eof"), start: cursor.index, end: cursor.index, text: String(""))
}

function compilerCoreParseBalancedRange(cursor: CompilerTokenCursor, leftKind: String, rightKind: String): Optional<CompilerSourceRange> {
    let maybeLeftToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeftToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let leftToken: RangeLexedToken(maybeLeftToken ?? fallbackToken)
    if leftToken.kind != leftKind {
        return nil
    }

    return compilerCoreParseBalancedRangeAfterLeft(cursor: cursor, leftToken: leftToken, leftKind: leftKind, rightKind: rightKind)
}

function compilerCoreParseBalancedRangeAfterLeft(cursor: CompilerTokenCursor, leftToken: RangeLexedToken, leftKind: String, rightKind: String): Optional<CompilerSourceRange> {
    let bodyCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: leftToken))
    return compilerCoreParseBalancedRangeScanning(cursor: bodyCursor, rangeStart: leftToken.end, leftKind: leftKind, rightKind: rightKind, depth: 1)
}

function compilerCoreParseBalancedRangeScanning(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, depth: Int): Optional<CompilerSourceRange> {
    state scanCursor: CompilerTokenCursor(cursor)
    state scanDepth: Int(depth)

    while true {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanCursor))
        if maybeToken == nil {
            return nil
        }

        let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanCursor))
        let token: RangeLexedToken(maybeToken ?? tokenFallback)
        if compilerCoreTokenKindEquals(token: token, kind: leftKind) {
            scanDepth: scanDepth + 1
        } else if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
            scanDepth: scanDepth - 1
            if scanDepth == 0 {
                return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
            }
        }
        scanCursor: compilerCursorAdvance(cursor: scanCursor, token: token)
    }

    return nil
}

function compilerCoreParseBalancedRangeScanningToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, depth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextDepth: Int(compilerCoreBalancedRangeNextDepth(token: token, leftKind: leftKind, rightKind: rightKind, depth: depth))
    return compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
        return compilerCoreParseBalancedRangeClosingToken(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
    }

    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreTokenKindEquals(token: RangeLexedToken, kind: String): Bool {
    let tokenKind: String(compilerCoreRangeTokenKind(token: token))
    return tokenKind == kind
}

function compilerCoreRangeTokenKind(token: RangeLexedToken): String {
    return token.kind
}

function compilerCoreRangeTokenText(token: RangeLexedToken): String {
    return token.text
}

function compilerCoreRangeTokenStart(token: RangeLexedToken): Int {
    return token.start
}

function compilerCoreRangeTokenEnd(token: RangeLexedToken): Int {
    return token.end
}

function compilerCoreParseBalancedRangeClosingToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if nextDepth == 0 {
        return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
    }
    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeContinue(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: String, rightKind: String, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
    return compilerCoreParseBalancedRangeScanning(cursor: nextCursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, depth: nextDepth)
}

function compilerCoreBalancedRangeNextDepth(token: RangeLexedToken, leftKind: String, rightKind: String, depth: Int): Int {
    let tokenKind: String(compilerCoreRangeTokenKind(token: token))
    if tokenKind == leftKind {
        return depth + 1
    }
    if tokenKind == rightKind {
        return depth - 1
    }
    return depth
}

function compilerCoreParseTypeReference(cursor: CompilerTokenCursor): Optional<CompilerTypeReference> {
    return compilerCoreParseTypeReferenceWithEnd(cursor: cursor, end: stringLength(value: cursor.source))
}

function compilerCoreParseTypeReferenceWithEnd(cursor: CompilerTokenCursor, end: Int): Optional<CompilerTypeReference> {
    let maybeFirstToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeFirstToken == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let firstToken: RangeLexedToken(maybeFirstToken ?? fallbackToken)
    if firstToken.start >= end || (firstToken.kind != String("identifier") && firstToken.kind != String("leftBracket")) {
        return nil
    }

    let initialState: CompilerTypeReferenceParseState(compilerCoreTypeReferenceInitialState(cursor: cursor, firstToken: firstToken))
    let parsedState: CompilerTypeReferenceParseState(compilerCoreParseTypeReferenceScanningUntil(parseState: initialState, end: end))
    return compilerCoreTypeReferenceFromState(firstToken: firstToken, parseState: parsedState)
}

function compilerCoreTypeReferenceInitialState(cursor: CompilerTokenCursor, firstToken: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(CompilerTokenCursor(source: cursor.source, index: cursor.index))
    return CompilerTypeReferenceParseState(output: String(""), typeEnd: firstToken.start, cursor: cursorState, genericDepth: 0, arrayDepth: 0, consumedToken: false, keepScanning: true)
}

function compilerCoreParseTypeReferenceScanning(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return compilerCoreParseTypeReferenceScanningUntil(parseState: parseState, end: stringLength(value: parseState.cursor.source))
}

function compilerCoreParseTypeReferenceScanningUntil(parseState: CompilerTypeReferenceParseState, end: Int): CompilerTypeReferenceParseState {
    state scanState: CompilerTypeReferenceParseState(CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: parseState.keepScanning))
    while scanState.keepScanning {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanState.cursor))
        if maybeToken == nil {
            scanState: compilerCoreTypeReferenceStop(parseState: scanState)
        } else {
            let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanState.cursor))
            let token: RangeLexedToken(maybeToken ?? tokenFallback)
            if token.start >= end {
                scanState: compilerCoreTypeReferenceStop(parseState: scanState)
            } else {
                scanState: compilerCoreParseTypeReferenceToken(parseState: scanState, token: token)
            }
        }
    }
    return scanState
}

function compilerCoreTypeReferenceFromState(firstToken: RangeLexedToken, parseState: CompilerTypeReferenceParseState): Optional<CompilerTypeReference> {
    if !parseState.consumedToken {
        return nil
    }

    if parseState.genericDepth != 0 {
        return nil
    }

    if parseState.arrayDepth != 0 {
        return nil
    }

    return CompilerTypeReference(text: parseState.output, start: firstToken.start, end: parseState.typeEnd)
}

function compilerCoreParseTypeReferenceToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == String("identifier") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == String("dot") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("."), genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == String("less") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("<"), genericDelta: 1, arrayDelta: 0)
    }
    return compilerCoreParseTypeReferenceTokenPunctuation(parseState: parseState, token: token)
}

function compilerCoreParseTypeReferenceTokenPunctuation(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == String("greater") {
        return compilerCoreTypeReferenceCloseGeneric(parseState: parseState, token: token)
    }
    if token.kind == String("leftBracket") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("["), genericDelta: 0, arrayDelta: 1)
    }
    if token.kind == String("rightBracket") {
        return compilerCoreTypeReferenceCloseArray(parseState: parseState, token: token)
    }
    if token.kind == String("comma") {
        return compilerCoreTypeReferenceComma(parseState: parseState, token: token)
    }
    if token.kind == String("question") {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("?"), genericDelta: 0, arrayDelta: 0)
    }
    return compilerCoreTypeReferenceStop(parseState: parseState)
}

function compilerCoreTypeReferenceAppend(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken, text: String, genericDelta: Int, arrayDelta: Int): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)\(text)", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth + genericDelta, arrayDepth: parseState.arrayDepth + arrayDelta, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseGeneric(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseGenericToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseArray(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseArrayToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseGenericToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)>", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth - 1, arrayDepth: parseState.arrayDepth, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseArrayToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)]", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth - 1, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceComma(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 && parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String(","), genericDelta: 0, arrayDelta: 0)
}

function compilerCoreTypeReferenceStop(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: false)
}

function parseCompilerCallArguments(source: String, start: Int, end: Int): CompilerCallArguments {
    let sink: CompilerBodySyntaxSink(compilerBodySyntaxSinkDisabled(source: source))
    return parseCompilerCallArgumentsWithSink(source: source, start: start, end: end, sink: sink, callSyntaxID: 0 - 1)
}

function parseCompilerCallArgumentsWithSink(source: String, start: Int, end: Int, sink: CompilerBodySyntaxSink, callSyntaxID: Int): CompilerCallArguments {
    state output: String("")
    state records: String("")
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    state argumentIndex: Int(0)

    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.start >= end {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        if token.kind == String("comma") {
            cursor: compilerCursorAdvance(cursor: cursor, token: token)
        } else {
            state label: String("")
            state labelStart: Int(0 - 1)
            state labelEnd: Int(0 - 1)
            state expressionStart: Int(0)
            expressionStart: token.start
            if token.kind == String("identifier") || token.kind == String("keyword") {
                let afterLabelCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
                let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterLabelCursor))
                if maybeColon != nil {
                    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: afterLabelCursor))
                    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
                    if colonToken.kind == String("colon") {
                        label: token.text
                        labelStart: token.start
                        labelEnd: token.end
                        expressionStart: colonToken.end
                    }
                }
            }

            let maybeParsedArgumentExpression: Optional<CompilerParsedExpression>(parseCompilerExpressionWithSink(source: source, start: expressionStart, limit: end, sink: sink))
            if maybeParsedArgumentExpression == nil {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return CompilerCallArguments(summary: output, records: records, start: start, end: end)
            }
            let parsedArgumentFallback: CompilerParsedExpression(compilerCoreMissingParsedExpression(start: expressionStart))
            let parsedArgumentExpression: CompilerParsedExpression(maybeParsedArgumentExpression ?? parsedArgumentFallback)
            let expression: CompilerExpression(compilerParsedExpressionValue(parsed: parsedArgumentExpression))
            if label == String("") {
                output: "\(output)argument\(argumentIndex)=\(expression.summary);"
            } else {
                output: "\(output)argument\(argumentIndex).\(label)=\(expression.summary);"
            }
            records: "\(records)\(compilerCoreCallArgumentRecord(index: argumentIndex, label: label, expressionRecord: expression.record, expressionSummary: expression.summary))"
            let argumentSyntaxID: Int(compilerBodySyntaxAppendNode(sink: sink, kindTag: compilerSyntaxKindArgument(), ordinal: argumentIndex, start: token.start, end: expression.end, firstStart: labelStart, firstEnd: labelEnd, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
            if compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: callSyntaxID, childSyntaxID: argumentSyntaxID, roleTag: compilerSyntaxRoleArgument(), ordinal: argumentIndex) != 0
                || compilerBodySyntaxAppendEdge(sink: sink, ownerSyntaxID: argumentSyntaxID, childSyntaxID: compilerParsedExpressionSyntaxID(parsed: parsedArgumentExpression), roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0) != 0 {
                if sink.enabled { compilerSyntaxTablesPoison(tables: sink.tables) }
                return CompilerCallArguments(summary: output, records: records, start: start, end: end)
            }
            argumentIndex: argumentIndex + 1
            cursor: CompilerTokenCursor(source: source, index: expression.end)
        }
    }

    return CompilerCallArguments(summary: output, records: records, start: start, end: end)
}

function parseCompilerFunctionParameters(source: String, start: Int, end: Int): CompilerFunctionParameters {
    let initialCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    let initialState: CompilerFunctionParameterParseState(CompilerFunctionParameterParseState(output: String(""), cursor: initialCursor, parameterIndex: 0, keepScanning: true, start: start, end: end))
    let parsedState: CompilerFunctionParameterParseState(parseCompilerFunctionParametersScanning(parseState: initialState))
    return CompilerFunctionParameters(summary: parsedState.output, start: start, end: end)
}

function parseCompilerFunctionParametersScanning(parseState: CompilerFunctionParameterParseState): CompilerFunctionParameterParseState {
    state scanState: CompilerFunctionParameterParseState(CompilerFunctionParameterParseState(output: parseState.output, cursor: parseState.cursor, parameterIndex: parseState.parameterIndex, keepScanning: parseState.keepScanning, start: parseState.start, end: parseState.end))
    while scanState.keepScanning && scanState.cursor.index < scanState.end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanState.cursor))
        if maybeToken == nil {
            scanState: parseCompilerFunctionParametersDone(parseState: scanState)
        } else {
            let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: scanState.cursor))
            let token: RangeLexedToken(maybeToken ?? fallbackToken)
            scanState: parseCompilerFunctionParametersToken(parseState: scanState, token: token)
        }
    }
    return scanState
}

function parseCompilerFunctionParametersToken(parseState: CompilerFunctionParameterParseState, token: RangeLexedToken): CompilerFunctionParameterParseState {
    let step: CompilerFunctionParameterTokenStep(compilerCoreParseFunctionParameterToken(source: parseState.cursor.source, end: parseState.end, token: token))
    if !step.keepScanning {
        return parseCompilerFunctionParametersDone(parseState: parseState)
    }
    if step.found {
        return parseCompilerFunctionParameterAppending(parseState: parseState, nameToken: step.nameToken, typeReference: step.typeReference)
    }
    let nextCursor: CompilerTokenCursor(CompilerTokenCursor(source: parseState.cursor.source, index: step.nextIndex))
    return parseCompilerFunctionParametersWithCursor(parseState: parseState, cursor: nextCursor)
}

function compilerCoreMissingFunctionParameterTokenStep(source: String, index: Int, nextIndex: Int, keepScanning: Bool): CompilerFunctionParameterTokenStep {
    let missingToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: index, end: index, text: String("")))
    let missingType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: index, end: index))
    return CompilerFunctionParameterTokenStep(found: false, keepScanning: keepScanning, nameToken: missingToken, typeReference: missingType, nextIndex: nextIndex)
}

function compilerCoreParseFunctionParameterToken(source: String, end: Int, token: RangeLexedToken): CompilerFunctionParameterTokenStep {
    if token.start >= end {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }
    if token.kind == String("comma") {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }
    if token.kind != String("identifier") && token.kind != String("keyword") {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let nameToken: RangeLexedToken(token)
    let nameCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: token.start))
    let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: nameCursor, token: nameToken))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != String("colon") {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    return CompilerFunctionParameterTokenStep(found: true, keepScanning: true, nameToken: nameToken, typeReference: typeReference, nextIndex: typeReference.end)
}

function parseCompilerFunctionParameterAppending(parseState: CompilerFunctionParameterParseState, nameToken: RangeLexedToken, typeReference: CompilerTypeReference): CompilerFunctionParameterParseState {
    let output: String("\(parseState.output)parameter\(parseState.parameterIndex).name=\(nameToken.text),type=\(typeReference.text);")
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: parseState.cursor.source, index: typeReference.end))
    return CompilerFunctionParameterParseState(output: output, cursor: cursor, parameterIndex: parseState.parameterIndex + 1, keepScanning: true, start: parseState.start, end: parseState.end)
}

function parseCompilerFunctionParametersWithCursor(parseState: CompilerFunctionParameterParseState, cursor: CompilerTokenCursor): CompilerFunctionParameterParseState {
    return CompilerFunctionParameterParseState(output: parseState.output, cursor: cursor, parameterIndex: parseState.parameterIndex, keepScanning: parseState.keepScanning, start: parseState.start, end: parseState.end)
}

function parseCompilerFunctionParametersDone(parseState: CompilerFunctionParameterParseState): CompilerFunctionParameterParseState {
    return CompilerFunctionParameterParseState(output: parseState.output, cursor: parseState.cursor, parameterIndex: parseState.parameterIndex, keepScanning: false, start: parseState.start, end: parseState.end)
}

function parseCompilerConstructMembers(source: String, start: Int, end: Int): CompilerConstructMembers {
    state output: String("")
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: start))
    state memberIndex: Int(0)

    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            return CompilerConstructMembers(summary: output, start: start, end: end)
        }

        let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeToken ?? fallbackToken)
        if token.start >= end {
            return CompilerConstructMembers(summary: output, start: start, end: end)
        }

        let step: CompilerStoredMemberParseStep(compilerCoreParseStoredMemberToken(source: source, end: end, token: token))
        if !step.keepScanning {
            return CompilerConstructMembers(summary: output, start: start, end: end)
        }
        if step.found {
            output: "\(output)member\(memberIndex).name=\(step.nameToken.text),type=\(step.typeReference.text);"
            memberIndex: memberIndex + 1
            cursor: CompilerTokenCursor(source: source, index: step.nextIndex)
        } else {
            cursor: CompilerTokenCursor(source: source, index: step.nextIndex)
        }
    }

    return CompilerConstructMembers(summary: output, start: start, end: end)
}

function compilerCoreMissingStoredMemberParseStep(source: String, index: Int, nextIndex: Int, keepScanning: Bool): CompilerStoredMemberParseStep {
    let missingToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: index, end: index, text: String("")))
    let missingType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: index, end: index))
    return CompilerStoredMemberParseStep(found: false, keepScanning: keepScanning, kindTag: 0 - 1, nameToken: missingToken, typeReference: missingType, nextIndex: nextIndex)
}

function compilerCoreParseStoredMemberToken(source: String, end: Int, token: RangeLexedToken): CompilerStoredMemberParseStep {
    if token.start >= end {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }
    if token.kind != String("keyword") || (token.text != String("let") && token.text != String("state") && token.text != String("binding")) {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let tokenCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: token.start))
    let nameCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: tokenCursor, token: token))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: nameCursor))
    if maybeName == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let nameFallback: RangeLexedToken(compilerFallbackToken(cursor: nameCursor))
    let nameToken: RangeLexedToken(maybeName ?? nameFallback)
    if nameToken.kind != String("identifier") {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: nameCursor, token: nameToken))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    if colonToken.kind != String("colon") {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
    let typeReference: CompilerTypeReference(maybeType ?? typeFallback)
    state memberKind: Int(compilerSyntaxMemberKindLet())
    if token.text == String("state") { memberKind: compilerSyntaxMemberKindState() }
    if token.text == String("binding") { memberKind: compilerSyntaxMemberKindBinding() }
    return CompilerStoredMemberParseStep(found: true, keepScanning: true, kindTag: memberKind, nameToken: nameToken, typeReference: typeReference, nextIndex: typeReference.end)
}

function compilerCoreParseDeclarationNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.start))
    cursor: CompilerTokenCursor(source: source, index: keyword.end)
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    state nameKind: String("")
    nameKind: nameToken.kind
    if nameKind != String("identifier") {
        return nil
    }

    return nameToken
}

function compilerCoreParseAngleRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    let maybeLeft: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeft == nil { return nil }
    let fallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let left: RangeLexedToken(maybeLeft ?? fallback)
    if left.kind != String("less") { return nil }
    state scanCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: left))
    state depth: Int(1)
    while true {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanCursor))
        if maybeToken == nil { return nil }
        let tokenFallback: RangeLexedToken(compilerFallbackToken(cursor: scanCursor))
        let token: RangeLexedToken(maybeToken ?? tokenFallback)
        if token.kind == String("less") {
            depth: depth + 1
        } else if token.kind == String("greater") {
            depth: depth - 1
            if depth == 0 {
                return CompilerSourceRange(start: left.start, end: token.end, next: token.end)
            }
        }
        scanCursor: compilerCursorAdvance(cursor: scanCursor, token: token)
    }
    return nil
}

function compilerCoreParseMacroApplicationParts(source: String, macroToken: RangeLexedToken): Optional<CompilerMacroApplicationParts> {
    let invalidRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: compilerCoreRangeTokenEnd(token: macroToken)))
    state genericRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    state argumentRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    state bodyRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken)))
    state nextIndex: Int(compilerCoreRangeTokenEnd(token: macroToken))
    let maybeNext: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeNext != nil {
        let genericTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
        let token: RangeLexedToken(maybeNext ?? genericTokenFallback)
        if token.kind == String("less") {
            let syntheticName: RangeLexedToken(RangeLexedToken(kind: String("identifier"), start: compilerCoreRangeTokenStart(token: macroToken) + 1, end: compilerCoreRangeTokenEnd(token: macroToken), text: stringSliceUnchecked(source: source, start: compilerCoreRangeTokenStart(token: macroToken) + 1, end: compilerCoreRangeTokenEnd(token: macroToken))))
            let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: syntheticName))
            if maybeGeneric == nil { return nil }
            let genericFallback: CompilerSourceRange(CompilerSourceRange(start: token.start, end: token.end, next: token.end))
            genericRange: maybeGeneric ?? genericFallback
            nextIndex: genericRange.next
        }
    }
    let argumentCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nextIndex))
    let maybeArgumentToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: argumentCursor))
    if maybeArgumentToken != nil {
        let argumentTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: argumentCursor))
        let argumentToken: RangeLexedToken(maybeArgumentToken ?? argumentTokenFallback)
        if argumentToken.kind == String("leftParen") {
            let maybeArgument: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: argumentCursor, leftKind: String("leftParen"), rightKind: String("rightParen")))
            if maybeArgument == nil { return nil }
            let argumentFallback: CompilerSourceRange(CompilerSourceRange(start: argumentToken.end, end: argumentToken.end, next: argumentToken.end))
            argumentRange: maybeArgument ?? argumentFallback
            nextIndex: argumentRange.next
        }
    }
    let bodyCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nextIndex))
    let maybeBodyToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: bodyCursor))
    if maybeBodyToken != nil {
        let bodyTokenFallback: RangeLexedToken(compilerFallbackToken(cursor: bodyCursor))
        let bodyToken: RangeLexedToken(maybeBodyToken ?? bodyTokenFallback)
        if bodyToken.kind == String("leftBrace") {
            let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
            if maybeBody == nil { return nil }
            let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: bodyToken.end, end: bodyToken.end, next: bodyToken.end))
            bodyRange: maybeBody ?? bodyFallback
            nextIndex: bodyRange.next
        }
    }
    return CompilerMacroApplicationParts(macroToken: macroToken, genericRange: genericRange, argumentRange: argumentRange, bodyRange: bodyRange, nextIndex: nextIndex)
}

function compilerCoreParseMacroCapabilityHeader(source: String, bodyRange: CompilerSourceRange): CompilerMacroCapabilityHeader {
    let invalidRange: CompilerSourceRange(CompilerSourceRange(start: bodyRange.start, end: bodyRange.start, next: bodyRange.start))
    if bodyRange.end <= bodyRange.start {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let fallback: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: bodyRange.start, end: bodyRange.start, text: String("")))
    let firstMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: bodyRange.start))
    if firstMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let first: RangeLexedToken(firstMaybe ?? fallback)
    let comma1Maybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: first.end))
    if (first.kind != String("identifier") && first.kind != String("keyword")) || comma1Maybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let comma1: RangeLexedToken(comma1Maybe ?? fallback)
    let secondMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: comma1.end))
    if comma1.kind != String("comma") || secondMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let second: RangeLexedToken(secondMaybe ?? fallback)
    let comma2Maybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: second.end))
    if (second.kind != String("identifier") && second.kind != String("keyword")) || comma2Maybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let comma2: RangeLexedToken(comma2Maybe ?? fallback)
    let thirdMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: comma2.end))
    if comma2.kind != String("comma") || thirdMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let third: RangeLexedToken(thirdMaybe ?? fallback)
    let inMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: third.end))
    if (third.kind != String("identifier") && third.kind != String("keyword")) || inMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let inToken: RangeLexedToken(inMaybe ?? fallback)
    if inToken.text != String("in") {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    if first.text == second.text || first.text == third.text || second.text == third.text {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDuplicate(), headerRange: CompilerSourceRange(start: first.start, end: inToken.end, next: inToken.end), executableBodyRange: CompilerSourceRange(start: inToken.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: CompilerSourceRange(start: second.start, end: second.end, next: second.end), graphRange: CompilerSourceRange(start: third.start, end: third.end, next: third.end))
    }
    return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: CompilerSourceRange(start: first.start, end: inToken.end, next: inToken.end), executableBodyRange: CompilerSourceRange(start: inToken.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: CompilerSourceRange(start: second.start, end: second.end, next: second.end), graphRange: CompilerSourceRange(start: third.start, end: third.end, next: third.end))
}

function compilerCoreParseMacroDeclarationParts(source: String, keyword: RangeLexedToken, visibility: Int, declarationStart: Int): Optional<CompilerMacroDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil { return nil }
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: CompilerTokenCursor(source: source, index: compilerCoreRangeTokenEnd(token: keyword))))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    let invalidRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: nameToken)))
    state genericRange: CompilerSourceRange(CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: nameToken)))
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        let genericFallback: CompilerSourceRange(CompilerSourceRange(start: compilerCoreRangeTokenEnd(token: nameToken), end: compilerCoreRangeTokenEnd(token: nameToken), next: compilerCoreRangeTokenEnd(token: nameToken)))
        genericRange: maybeGeneric ?? genericFallback
    }
    state parameterStart: Int(compilerCoreRangeTokenEnd(token: nameToken))
    if maybeGeneric != nil { parameterStart: genericRange.next }
    let parameterCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterStart))
    let maybeParameter: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: parameterCursor, leftKind: String("leftParen"), rightKind: String("rightParen")))
    if maybeParameter == nil { return nil }
    let parameterFallback: CompilerSourceRange(CompilerSourceRange(start: compilerCoreRangeTokenEnd(token: nameToken), end: compilerCoreRangeTokenEnd(token: nameToken), next: compilerCoreRangeTokenEnd(token: nameToken)))
    let parameterRange: CompilerSourceRange(maybeParameter ?? parameterFallback)
    let colonCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterRange.next))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil { return nil }
    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: colonCursor))
    let colon: RangeLexedToken(maybeColon ?? colonFallback)
    if colon.kind != String("colon") { return nil }
    let targetCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colon))
    let maybeTarget: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: targetCursor))
    if maybeTarget == nil { return nil }
    let targetFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: targetCursor.index, end: targetCursor.index))
    let targetType: CompilerTypeReference(maybeTarget ?? targetFallback)
    let afterTargetCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: targetType.end))
    let maybeArrow: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterTargetCursor))
    state expansionType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: 0 - 1, end: 0 - 1))
    state hasExpansion: Bool(false)
    state bodyCursor: CompilerTokenCursor(afterTargetCursor)
    if maybeArrow != nil {
        let arrowFallback: RangeLexedToken(compilerFallbackToken(cursor: afterTargetCursor))
        let arrow: RangeLexedToken(maybeArrow ?? arrowFallback)
        if arrow.kind == String("arrow") {
            let expansionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: afterTargetCursor, token: arrow))
            let maybeExpansion: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: expansionCursor))
            if maybeExpansion == nil { return nil }
            let expansionFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: expansionCursor.index, end: expansionCursor.index))
            expansionType: maybeExpansion ?? expansionFallback
            hasExpansion: true
            bodyCursor: CompilerTokenCursor(source: source, index: expansionType.end)
        }
    }
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: String("leftBrace"), rightKind: String("rightBrace")))
    if maybeBody == nil { return nil }
    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: bodyCursor.index, end: bodyCursor.index, next: bodyCursor.index))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    let capabilityHeader: CompilerMacroCapabilityHeader(compilerCoreParseMacroCapabilityHeader(source: source, bodyRange: bodyRange))
    return CompilerMacroDeclarationParts(nameToken: nameToken, genericRange: genericRange, parameterRange: parameterRange, targetType: targetType, expansionType: expansionType, hasExpansionType: hasExpansion, bodyRange: bodyRange, capabilityStatus: capabilityHeader.status, capabilityHeaderRange: capabilityHeader.headerRange, executableBodyRange: capabilityHeader.executableBodyRange, targetCapabilityRange: capabilityHeader.targetRange, diagnosticsCapabilityRange: capabilityHeader.diagnosticsRange, graphCapabilityRange: capabilityHeader.graphRange, declarationStart: declarationStart, visibility: visibility)
}

function compilerCoreParseBodyRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: String("leftBrace"), rightKind: String("rightBrace"))
}

function compilerCoreParseParameterRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: nameToken.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: String("leftParen"), rightKind: String("rightParen"))
}

function compilerCoreParseReturnTypeAfterParameters(source: String, parameterRange: CompilerSourceRange): Optional<CompilerTypeReference> {
    return compilerCoreParseReturnTypeAfterParametersWithEnd(source: source, parameterRange: parameterRange, fileEnd: stringLength(value: source))
}

function compilerCoreParseReturnTypeAfterParametersWithEnd(source: String, parameterRange: CompilerSourceRange, fileEnd: Int): Optional<CompilerTypeReference> {
    state cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: parameterRange.start))
    cursor: CompilerTokenCursor(source: source, index: parameterRange.next)
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeColon == nil {
        return nil
    }

    let colonFallback: RangeLexedToken(compilerFallbackToken(cursor: cursor))
    let colonToken: RangeLexedToken(maybeColon ?? colonFallback)
    state colonKind: String("")
    colonKind: colonToken.kind
    if colonKind != String("colon") {
        return nil
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: colonToken))
    return compilerCoreParseTypeReferenceWithEnd(cursor: typeCursor, end: fileEnd)
}

function compilerCoreParseFunctionBodyAfterReturnType(source: String, returnType: CompilerTypeReference): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: returnType.end))
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: String("leftBrace"), rightKind: String("rightBrace"))
}

function compilerCoreFunctionDeclarationFromParts(parts: CompilerFunctionDeclarationParts, parameters: CompilerFunctionParameters): CompilerFunctionDeclaration {
    return CompilerFunctionDeclaration(
        name: parts.nameToken.text,
        parameterStart: parts.parameterRange.start,
        parameterEnd: parts.parameterRange.end,
        parameterSummary: parameters.summary,
        returnType: parts.returnType.text,
        bodyStart: parts.bodyRange.start,
        bodyEnd: parts.bodyRange.end
    )
}

function compilerCoreParseConstructDeclarationParts(source: String, keyword: RangeLexedToken): Optional<CompilerConstructDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBodyRangeAfterName(source: source, nameToken: nameToken))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    return CompilerConstructDeclarationParts(nameToken: nameToken, bodyRange: bodyRange)
}

function compilerCoreParseFunctionDeclarationParts(source: String, keyword: RangeLexedToken): Optional<CompilerFunctionDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let fallbackCursor: CompilerTokenCursor(CompilerTokenCursor(source: source, index: keyword.end))
    let fallbackToken: RangeLexedToken(compilerFallbackToken(cursor: fallbackCursor))
    let nameToken: RangeLexedToken(maybeName ?? fallbackToken)
    let maybeParameters: Optional<CompilerSourceRange>(compilerCoreParseParameterRangeAfterName(source: source, nameToken: nameToken))
    if maybeParameters == nil {
        return nil
    }

    let parameterFallback: CompilerSourceRange(CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end))
    let parameterRange: CompilerSourceRange(maybeParameters ?? parameterFallback)
    let maybeReturnType: Optional<CompilerTypeReference>(compilerCoreParseReturnTypeAfterParameters(source: source, parameterRange: parameterRange))
    if maybeReturnType == nil {
        return nil
    }

    let returnTypeFallback: CompilerTypeReference(CompilerTypeReference(text: String(""), start: parameterRange.next, end: parameterRange.next))
    let returnType: CompilerTypeReference(maybeReturnType ?? returnTypeFallback)
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseFunctionBodyAfterReturnType(source: source, returnType: returnType))
    if maybeBody == nil {
        return nil
    }

    let bodyFallback: CompilerSourceRange(CompilerSourceRange(start: returnType.end, end: returnType.end, next: returnType.end))
    let bodyRange: CompilerSourceRange(maybeBody ?? bodyFallback)
    return CompilerFunctionDeclarationParts(nameToken: nameToken, parameterRange: parameterRange, returnType: returnType, bodyRange: bodyRange)
}

function parseCompilerConstructDeclaration(source: String, keyword: RangeLexedToken): Optional<CompilerConstructDeclaration> {
    let maybeParts: Optional<CompilerConstructDeclarationParts>(compilerCoreParseConstructDeclarationParts(source: source, keyword: keyword))
    if maybeParts == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: keyword.end, end: keyword.end, text: String("")))
    let fallbackRange: CompilerSourceRange(CompilerSourceRange(start: keyword.end, end: keyword.end, next: keyword.end))
    let partsFallback: CompilerConstructDeclarationParts(CompilerConstructDeclarationParts(nameToken: fallbackToken, bodyRange: fallbackRange))
    let parts: CompilerConstructDeclarationParts(maybeParts ?? partsFallback)
    let members: CompilerConstructMembers(parseCompilerConstructMembers(source: source, start: parts.bodyRange.start, end: parts.bodyRange.end))
    return CompilerConstructDeclaration(
        name: parts.nameToken.text,
        memberSummary: members.summary,
        bodyStart: parts.bodyRange.start,
        bodyEnd: parts.bodyRange.end
    )
}

function parseCompilerFunctionDeclaration(source: String, keyword: RangeLexedToken): Optional<CompilerFunctionDeclaration> {
    let maybeParts: Optional<CompilerFunctionDeclarationParts>(compilerCoreParseFunctionDeclarationParts(source: source, keyword: keyword))
    if maybeParts == nil {
        return nil
    }

    let fallbackToken: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: keyword.end, end: keyword.end, text: String("")))
    let fallbackRange: CompilerSourceRange(CompilerSourceRange(start: keyword.end, end: keyword.end, next: keyword.end))
    let fallbackType: CompilerTypeReference(CompilerTypeReference(text: String(""), start: keyword.end, end: keyword.end))
    let partsFallback: CompilerFunctionDeclarationParts(CompilerFunctionDeclarationParts(nameToken: fallbackToken, parameterRange: fallbackRange, returnType: fallbackType, bodyRange: fallbackRange))
    let parts: CompilerFunctionDeclarationParts(maybeParts ?? partsFallback)
    let parameters: CompilerFunctionParameters(parseCompilerFunctionParameters(source: source, start: parts.parameterRange.start, end: parts.parameterRange.end))
    return compilerCoreFunctionDeclarationFromParts(parts: parts, parameters: parameters)
}

function compilerCoreLLVM(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreLLVMForProgram(program: program)
}

function compilerCoreLLVMForProgram(program: CompilerProgram): String {
    let moduleText: String(compilerCoreLLVMTextForProgram(program: program))
    if moduleText == String("") {
        return String("")
    }

    return "compilerCoreLLVM\tmain\ncompilerCoreLLVMText\t\(moduleText)\n"
}

function compilerCoreLLVMTextForProgram(program: CompilerProgram): String {
    if !program.hasMainBlock {
        return String("")
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlock(program: program, parsedBlock: parsedBlock))
    let module: CompilerLLVMModule(compilerCoreLLVMModule(program: program, block: loweredBlock))
    let renderedText: String(compilerCoreRenderLLVMModule(module: module))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: renderedText))
    if placeholderCount > 0 {
        return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: renderedText)
    }
    return compilerCoreMaterializeLLVMText(text: renderedText)
}

function compilerCoreLLVMSourceSetEntryTextForProgram(program: CompilerProgram): String {
    if !program.hasMainBlock {
        return String("")
    }

    let parsedBlock: CompilerParsedBlock(compilerCoreMainParsedBlock(program: program))
    let text: String(compilerCoreLLVMSourceSetEntryTextForParsedBlock(program: program, parsedBlock: parsedBlock))
    return compilerCoreMaterializeLLVMText(text: text)
}

function compilerCoreLLVMSourceSetEntryTextForParsedBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock): String {
    let loweredBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerBlock(program: program, parsedBlock: parsedBlock))
    let reachableFunctions: String(compilerCoreLLVMSourceSetExplicitReachableFunctions(program: program, parsedBlock: parsedBlock))
    return compilerCoreLLVMEntryTextForLoweredBlock(program: program, loweredBlock: loweredBlock, reachableFunctions: reachableFunctions)
}

function compilerCoreLLVMSourceSetExplicitReachableFunctions(program: CompilerProgram, parsedBlock: CompilerParsedBlock): String {
    let directlyCalledFunctions: String(compilerCoreStatementRecordsCalledFunctionNames(records: parsedBlock.statementRecords))
    return compilerCoreReachableFunctionNames(program: program, roots: directlyCalledFunctions)
}

function compilerCoreLLVMSelectedHelperAuditTyped(tables: CompilerSyntaxTables, selection: CompilerFunctionSelection): CompilerLLVMHelperAudit {
    state audit: CompilerLLVMHelperAudit(CompilerLLVMHelperAudit(selectedCount: 0, lowerableCount: 0, excludedCount: 0, maxBodyLength: 0, maxBodyName: String(""), details: String("")))
    state declarationRow: Int(0)
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while declarationRow < declarationCount {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
            if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
                audit: compilerCoreLLVMSelectedHelperAuditAppendingTypedFunction(tables: tables, audit: audit, declarationRow: declarationRow, functionRow: functionRow)
            }
        }
        declarationRow: declarationRow + 1
    }
    return audit
}

function compilerCoreLLVMSelectedHelperAuditAppendingTypedFunction(tables: CompilerSyntaxTables, audit: CompilerLLVMHelperAudit, declarationRow: Int, functionRow: Int): CompilerLLVMHelperAudit {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let bodyStart: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 8))
    let bodyEnd: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 9))
    let bodyLength: Int(bodyEnd - bodyStart)
    let reason: String(compilerCoreTypedFunctionExclusionReason(tables: tables, functionRow: functionRow))
    state maxLength: Int(0)
    maxLength: audit.maxBodyLength
    state maxName: String("")
    maxName: audit.maxBodyName
    if bodyLength > maxLength {
        maxLength: bodyLength
        maxName: name
    }
    if reason == String("") {
        return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount + 1, excludedCount: audit.excludedCount, maxBodyLength: maxLength, maxBodyName: maxName, details: audit.details)
    }
    let detail: String("excluded\tname=\(name)\treason=\(reason)\tbodyLength=\(bodyLength)\n")
    return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount, excludedCount: audit.excludedCount + 1, maxBodyLength: maxLength, maxBodyName: maxName, details: "\(audit.details)\(detail)")
}

function compilerCoreTypedFunctionExclusionReason(tables: CompilerSyntaxTables, functionRow: Int): String {
    let fileID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 1))
    let bodyStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: functionRow, column: 8)))
    let bodyEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: functionRow, column: 9)))
    if bodyStart < 0 || bodyEnd < bodyStart || bodyEnd >= stringLength(value: tables.sourceStore.source) {
        return String("missingStatementRecords")
    }
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    if compilerCoreLLVMTypeNameForRangeType(typeName: returnType) == String("") {
        return String("unsupportedSignature")
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if compilerCoreLLVMTypeNameForRangeType(typeName: typeName) == String("") {
            return String("unsupportedSignature")
        }
        ordinal: ordinal + 1
    }
    return String("")
}

function compilerCoreLLVMHelperAuditFailure(audit: CompilerLLVMHelperAudit): String {
    return "compilerError\tkind=unsupportedReachableHelpers\tselectedCount=\(audit.selectedCount)\tlowerableCount=\(audit.lowerableCount)\texcludedCount=\(audit.excludedCount)\n\(audit.details)"
}

function compilerCoreLLVMPlaceholderCount(text: String): Int {
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    state sourceIndex: Int(0)
    state count: Int(0)

    while sourceIndex >= 0 {
        let matchIndex: Int(stringFindFrom(source: text, start: sourceIndex, needle: marker))
        if matchIndex < 0 {
            return count
        }
        count: count + 1
        sourceIndex: matchIndex + markerLength
    }

    return count
}

function compilerCoreLLVMPlaceholderDetails(text: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 4096))
    let materializedText: String(compilerCoreMaterializeLLVMText(text: text))
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    let textLength: Int(stringLength(value: materializedText))
    state sourceIndex: Int(0)
    state currentFunction: String("")

    while sourceIndex < textLength {
        state lineEnd: Int(stringFindFirstOf(source: materializedText, start: sourceIndex, characters: compilerCoreNewlineCharacter()))
        if lineEnd < 0 {
            lineEnd: textLength
        }
        let line: String(materializedText.substring(start: sourceIndex, end: lineEnd))
        if stringHasPrefix(source: line, start: 0, prefix: String("define ")) {
            let nameStart: Int(stringFindFrom(source: line, start: 0, needle: String("@")))
            let nameEnd: Int(stringFindFrom(source: line, start: nameStart + 1, needle: String("(")))
            if nameStart >= 0 && nameEnd > nameStart {
                currentFunction: line.substring(start: nameStart + 1, end: nameEnd)
            }
        }
        let markerStart: Int(stringFindFrom(source: line, start: 0, needle: marker))
        if markerStart >= 0 {
            state reasonStart: Int(markerStart + markerLength)
            while reasonStart < stringLength(value: line) && stringHasPrefix(source: line, start: reasonStart, prefix: String(" ")) {
                reasonStart: reasonStart + 1
            }
            let reason: String(line.substring(start: reasonStart, end: stringLength(value: line)))
            textBufferAppend(buffer: outputBuffer, text: "placeholder\tfunction=\(currentFunction)\treason=\(reason)")
            textBufferAppend(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
        }
        sourceIndex: lineEnd + 1
    }

    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMPlaceholderFailure(placeholderCount: Int, renderedText: String): String {
    let details: String(compilerCoreLLVMPlaceholderDetails(text: renderedText))
    return "compilerError\tkind=unsupportedReachableLowering\tplaceholderCount=\(placeholderCount)\(compilerCoreNewlineCharacter())\(details)"
}

function compilerCoreRenderLLVMEntryFunction(block: CompilerLLVMLoweredBlock): String {
    let llvmFunction: CompilerLLVMFunction(CompilerLLVMFunction(name: String("main"), returnType: String("i32"), parameterText: String(""), renderedBlocks: block.renderedBlocks, block: compilerCoreMainLLVMBasicBlock(block: block)))
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreLLVMNativeProgramText(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        compilerSyntaxTablesDestroy(tables: tables)
        return String("compilerError\tkind=invalidTypedDeclarations")
    }
    let macroLinkStatus: Int(compilerMacroLink(tables: tables))
    if macroLinkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
        let macroDiagnosticOutput: String(compilerMacroRenderDiagnostics(tables: tables))
        compilerSyntaxTablesDestroy(tables: tables)
        return macroDiagnosticOutput
    }
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    if !declarationIndex.isValid {
        compilerDeclarationIndexDestroy(index: declarationIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return String("compilerError\tkind=invalidDeclarationIndex")
    }
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: declarationIndex))
    if execution.status != 0 {
        let executionOutput: String(compilerMacroRenderExecutionError(tables: tables, result: execution))
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: declarationIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return executionOutput
    }
    compilerGraphDeltaDestroy(delta: execution.graphDelta)
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let context: CompilerLLVMLoweringContext(CompilerLLVMLoweringContext(program: program, tables: tables, declarationIndex: declarationIndex))
    let reachability: CompilerReachableLLVMState(compilerReachableLLVMStateCreate(context: context))
    state output: String("compilerError\tkind=invalidEntryReachability")
    let seedStatus: Int(compilerReachableLLVMStateSeedEntryRoots(reachability: reachability))
    state buildStatus: Int(0 - 1)
    if seedStatus != 0 {
        compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 50000 + seedStatus)
        output: "compilerError\tkind=invalidEntryReachability\tstage=\(seedStatus)"
    } else {
        buildStatus: compilerReachableLLVMStateBuildSelected(reachability: reachability)
    }
    if seedStatus == 0 && buildStatus != 0 {
        output: compilerReachableLLVMStateRender(reachability: reachability)
    }
    if seedStatus == 0 && buildStatus == 0 {
        state blockedSensitiveFunctionRow: Int(0)
        while buildStatus == 0 && blockedSensitiveFunctionRow < intBufferCount(buffer: reachability.abiSensitiveFunctions) {
            if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: blockedSensitiveFunctionRow)
                && intBufferElement(buffer: reachability.abiSensitiveFunctions, index: blockedSensitiveFunctionRow) == 1
                && intBufferElement(buffer: reachability.abiCapabilities, index: blockedSensitiveFunctionRow) != 1 {
                buildStatus: compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 200000 + blockedSensitiveFunctionRow)
                output: compilerReachableLLVMStateRender(reachability: reachability)
            }
            blockedSensitiveFunctionRow: blockedSensitiveFunctionRow + 1
        }
    }
    if seedStatus == 0 && buildStatus == 0 {
        let abiPlan: CompilerModuleABIPlan(compilerReachableLLVMStateABIPlan(reachability: reachability))
        let entryLowering: CompilerTypedBodyLowering(compilerCoreLLVMLowerEntryTyped(context: context, initialTemporaryIndex: intBufferElement(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary()), abiPlan: abiPlan))
        if !entryLowering.isValid {
            output: "compilerError\tkind=invalidEntryLowering\tstage=\(entryLowering.failureStage)"
        } else {
            let mainText: String(compilerCoreRenderLLVMEntryFunction(block: entryLowering.block))
            output: compilerReachableLLVMStateRenderModule(reachability: reachability, usage: String(""), extraGlobals: entryLowering.renderedGlobals, extraRuntimeRequirements: entryLowering.runtimeRequirements, mainText: mainText)
        }
    }
    compilerReachableLLVMStateDestroy(reachability: reachability)
    compilerDeclarationIndexDestroy(index: declarationIndex)
    compilerSyntaxTablesDestroy(tables: tables)
    return output
}

function compilerCoreLLVMNativeEntryTextForProgram(program: CompilerProgram, declarationTables: CompilerSyntaxTables): String {
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: declarationTables))
    if !declarationIndex.isValid {
        compilerDeclarationIndexDestroy(index: declarationIndex)
        return String("compilerError\tkind=invalidDeclarationIndex")
    }
    let context: CompilerLLVMLoweringContext(CompilerLLVMLoweringContext(program: program, tables: declarationTables, declarationIndex: declarationIndex))
    let reachability: CompilerReachableLLVMState(compilerReachableLLVMStateCreate(context: context))
    let buildStatus: Int(compilerReachableLLVMStateBuild(reachability: reachability))
    let output: String(compilerReachableLLVMStateRender(reachability: reachability))
    compilerReachableLLVMStateDestroy(reachability: reachability)
    compilerDeclarationIndexDestroy(index: declarationIndex)
    return output
}

function compilerReachableLLVMStateRender(reachability: CompilerReachableLLVMState): String {
    if intBufferElement(buffer: reachability.counters, index: compilerReachableLLMValid()) != 1 {
        let failedFunctions: String(textBufferMaterialize(buffer: reachability.functionsBuffer))
        let failedPlaceholderCount: Int(compilerCoreLLVMPlaceholderCount(text: failedFunctions))
        if failedPlaceholderCount > 0 { return compilerCoreLLVMPlaceholderFailure(placeholderCount: failedPlaceholderCount, renderedText: failedFunctions) }
        let failureStage: Int(intBufferElement(buffer: reachability.counters, index: compilerReachableLLVMFailureStage()))
        if failureStage >= 200000 {
            let blockedFunctionRow: Int(failureStage - 200000)
            let blockedSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockedFunctionRow, column: 0))
            let blockedDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: blockedSyntaxID))
            let blockedFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 1))
            let blockedName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: blockedFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 8)))
            return "compilerError\tkind=representationSensitiveABICapabilityBlocked\tfunctionRow=\(blockedFunctionRow)\tfunction=\(blockedName)\tcapabilityStage=\(0 - intBufferElement(buffer: reachability.abiCapabilities, index: blockedFunctionRow))"
        }
        if failureStage >= 100000 {
            let failureFunctionRow: Int(failureStage - 100000)
            let failureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: failureFunctionRow, column: 0))
            let failureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: failureSyntaxID))
            let failureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 1))
            let failureName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: failureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 8)))
            return "compilerError\tkind=invalidFunctionDiscovery\tfunctionRow=\(failureFunctionRow)\tfunction=\(failureName)\tfailureCode=\(0 - intBufferElement(buffer: reachability.abiCapabilities, index: failureFunctionRow))"
        }
        return "compilerError\tkind=invalidFunctionReachability\tstage=\(failureStage)"
    }
    if !compilerReachableLLVMStateABIPlanIsValid(reachability: reachability) {
        state invalidPlanEdge: Int(0)
        while invalidPlanEdge < intBufferCount(buffer: reachability.edgeTargets) {
            let invalidPlanOwner: Int(intBufferElement(buffer: reachability.edgeOwners, index: invalidPlanEdge))
            let invalidPlanTarget: Int(intBufferElement(buffer: reachability.edgeTargets, index: invalidPlanEdge))
            let invalidPlanOwnerParticipant: Int(intBufferElement(buffer: reachability.abiParticipants, index: invalidPlanOwner))
            let invalidPlanTargetParticipant: Int(intBufferElement(buffer: reachability.abiParticipants, index: invalidPlanTarget))
            let invalidPlanTargetReturnMode: Int(intBufferElement(buffer: reachability.abiReturnModes, index: invalidPlanTarget))
            let invalidPlanAggregateParameter: Bool(compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: invalidPlanTarget))
            if (invalidPlanTargetReturnMode == compilerFunctionReturnABIIndirect() && invalidPlanOwnerParticipant != 1)
                || (invalidPlanOwnerParticipant == 1 && invalidPlanAggregateParameter && invalidPlanTargetParticipant != 1)
                || (invalidPlanTargetParticipant == 1 && invalidPlanAggregateParameter && invalidPlanOwnerParticipant != 1) {
                return "compilerError\tkind=invalidModuleABIPlanEdge\townerFunctionRow=\(invalidPlanOwner)\ttargetFunctionRow=\(invalidPlanTarget)\townerParticipant=\(invalidPlanOwnerParticipant)\ttargetParticipant=\(invalidPlanTargetParticipant)\ttargetReturnMode=\(invalidPlanTargetReturnMode)\ttargetAggregateParameter=\(invalidPlanAggregateParameter)"
            }
            invalidPlanEdge: invalidPlanEdge + 1
        }
        return String("compilerError\tkind=invalidModuleABIPlan")
    }
    if intBufferElement(buffer: reachability.counters, index: compilerReachableLLMIndirectCapabilities()) < 1 { return String("compilerError\tkind=emptyIndirectABICapability") }
    if intBufferElement(buffer: reachability.counters, index: compilerReachableLLMIndirectActivations()) < 1 {
        state blockerEdge: Int(0)
        while blockerEdge < intBufferCount(buffer: reachability.edgeTargets) {
            let blockerOwner: Int(intBufferElement(buffer: reachability.edgeOwners, index: blockerEdge))
            let blockerTarget: Int(intBufferElement(buffer: reachability.edgeTargets, index: blockerEdge))
            if intBufferElement(buffer: reachability.abiCapabilities, index: blockerTarget) == 1
                && compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: blockerTarget) == compilerFunctionReturnABIIndirect()
                && intBufferElement(buffer: reachability.abiCapabilities, index: blockerOwner) != 1 {
                let targetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockerTarget, column: 0))
                let ownerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockerOwner, column: 0))
                let targetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: targetSyntaxID))
                let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: ownerSyntaxID))
                let targetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 8)))
                let ownerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 8)))
                return "compilerError\tkind=indirectABIActivationBlocked\ttargetFunctionRow=\(blockerTarget)\ttarget=\(targetName)\townerFunctionRow=\(blockerOwner)\towner=\(ownerName)\townerStage=\(0 - intBufferElement(buffer: reachability.abiCapabilities, index: blockerOwner))"
            }
            blockerEdge: blockerEdge + 1
        }
        state incapableEdge: Int(0)
        while incapableEdge < intBufferCount(buffer: reachability.edgeTargets) {
            let incapableOwner: Int(intBufferElement(buffer: reachability.edgeOwners, index: incapableEdge))
            let incapableTarget: Int(intBufferElement(buffer: reachability.edgeTargets, index: incapableEdge))
            if compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: incapableTarget) == compilerFunctionReturnABIIndirect()
                && intBufferElement(buffer: reachability.abiCapabilities, index: incapableTarget) != 1
                && intBufferElement(buffer: reachability.abiCapabilities, index: incapableOwner) == 1 {
                let incapableTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: incapableTarget, column: 0))
                let incapableOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: incapableOwner, column: 0))
                let incapableTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: incapableTargetSyntaxID))
                let incapableOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: incapableOwnerSyntaxID))
                let incapableTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 8)))
                let incapableOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=indirectABIComponentBlocked\ttargetFunctionRow=\(incapableTarget)\ttarget=\(incapableTargetName)\ttargetStage=\(0 - intBufferElement(buffer: reachability.abiCapabilities, index: incapableTarget))\townerFunctionRow=\(incapableOwner)\towner=\(incapableOwnerName)"
            }
            incapableEdge: incapableEdge + 1
        }
        state parameterBlockerEdge: Int(0)
        while parameterBlockerEdge < intBufferCount(buffer: reachability.edgeTargets) {
            let parameterBlockerOwner: Int(intBufferElement(buffer: reachability.edgeOwners, index: parameterBlockerEdge))
            let parameterBlockerTarget: Int(intBufferElement(buffer: reachability.edgeTargets, index: parameterBlockerEdge))
            if compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterBlockerTarget)
                && intBufferElement(buffer: reachability.abiCapabilities, index: parameterBlockerTarget) != 1
                && intBufferElement(buffer: reachability.abiCapabilities, index: parameterBlockerOwner) == 1 {
                let parameterBlockerTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: parameterBlockerTarget, column: 0))
                let parameterBlockerOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: parameterBlockerOwner, column: 0))
                let parameterBlockerTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: parameterBlockerTargetSyntaxID))
                let parameterBlockerOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: parameterBlockerOwnerSyntaxID))
                let parameterBlockerTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 8)))
                let parameterBlockerOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=aggregateParameterABIComponentBlocked\ttargetFunctionRow=\(parameterBlockerTarget)\ttarget=\(parameterBlockerTargetName)\ttargetStage=\(0 - intBufferElement(buffer: reachability.abiCapabilities, index: parameterBlockerTarget))\townerFunctionRow=\(parameterBlockerOwner)\towner=\(parameterBlockerOwnerName)"
            }
            parameterBlockerEdge: parameterBlockerEdge + 1
        }
        state aggregateCallerBlockerEdge: Int(0)
        while aggregateCallerBlockerEdge < intBufferCount(buffer: reachability.edgeTargets) {
            let aggregateCallerBlockerOwner: Int(intBufferElement(buffer: reachability.edgeOwners, index: aggregateCallerBlockerEdge))
            let aggregateCallerBlockerTarget: Int(intBufferElement(buffer: reachability.edgeTargets, index: aggregateCallerBlockerEdge))
            if compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: aggregateCallerBlockerTarget)
                && intBufferElement(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerTarget) == 1
                && intBufferElement(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerOwner) != 1 {
                let aggregateCallerBlockerTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: aggregateCallerBlockerTarget, column: 0))
                let aggregateCallerBlockerOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: aggregateCallerBlockerOwner, column: 0))
                let aggregateCallerBlockerTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: aggregateCallerBlockerTargetSyntaxID))
                let aggregateCallerBlockerOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: aggregateCallerBlockerOwnerSyntaxID))
                let aggregateCallerBlockerTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 8)))
                let aggregateCallerBlockerOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=aggregateParameterABICallerBlocked\ttargetFunctionRow=\(aggregateCallerBlockerTarget)\ttarget=\(aggregateCallerBlockerTargetName)\townerFunctionRow=\(aggregateCallerBlockerOwner)\towner=\(aggregateCallerBlockerOwnerName)\townerStage=\(0 - intBufferElement(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerOwner))"
            }
            aggregateCallerBlockerEdge: aggregateCallerBlockerEdge + 1
        }
        return String("compilerError\tkind=emptyIndirectABIActivation")
    }
    return compilerReachableLLVMStateRenderModule(reachability: reachability, usage: compilerCoreNativeMainUsageGlobalLLVMText(), extraGlobals: String(""), extraRuntimeRequirements: 0, mainText: compilerCoreNativeMainLLVMText())
}

function compilerReachableLLVMStateRenderModule(reachability: CompilerReachableLLVMState, usage: String, extraGlobals: String, extraRuntimeRequirements: Int, mainText: String): String {
    let audit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAuditTyped(tables: reachability.context.tables, selection: reachability.selection))
    if audit.excludedCount > 0 { return compilerCoreLLVMHelperAuditFailure(audit: audit) }
    let typedSelected: CompilerTypedLLVMHelpers(compilerReachableLLVMStateHelpers(reachability: reachability))
    let selected: CompilerLLVMHelperFunctions(compilerTypedLLVMHelpersValue(value: typedSelected))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: selected.renderedFunctions))
    if placeholderCount > 0 { return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: selected.renderedFunctions) }
    if intBufferElement(buffer: reachability.counters, index: compilerReachableLLMCommittedFailures()) != 0 { return String("compilerError\tkind=invalidFunctionReachability") }
    state runtimeRequirements: Int(0)
    runtimeRequirements: typedSelected.runtimeRequirements
    if extraRuntimeRequirements > runtimeRequirements { runtimeRequirements: extraRuntimeRequirements }
    let nominalLayouts: String(compilerCoreRenderLLVMNominalLayouts(tables: reachability.context.tables, index: reachability.context.declarationIndex))
    let allRenderedFunctions: String("\(selected.renderedFunctions)\(mainText)")
    let runtimeDeclarations: String(compilerCoreRenderLLVMRuntimeDeclarationsTyped(records: selected.instructionRecords, renderedFunctions: allRenderedFunctions, runtimeRequirements: runtimeRequirements))
    let declarations: String(compilerCoreRenderLLVMFunctionDeclarationsExcludingTyped(tables: reachability.context.tables, selection: reachability.selection))
    let text: String(compilerCoreLLVMNativeEntryTextFromParts(usage: usage, globals: "\(nominalLayouts)\(typedSelected.renderedGlobals)\(extraGlobals)", runtime: runtimeDeclarations, helpers: selected.renderedFunctions, declarations: declarations, main: mainText))
    let materialized: String(compilerCoreMaterializeLLVMText(text: text))
    let signatureAuditCode: Int(compilerCoreLLVMDirectCallSignatureAudit(tables: reachability.context.tables, index: reachability.context.declarationIndex, selection: reachability.selection, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability), text: materialized))
    if signatureAuditCode != 0 { return "compilerError\tkind=directCallSignatureAudit\tfunctionRow=\(signatureAuditCode - 1)" }
    return materialized
}

function compilerCoreLLVMDirectCallSignatureAudit(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, abiPlan: CompilerModuleABIPlan, text: String): Int {
    state functionRow: Int(0)
    while functionRow < compilerIntTableRowCount(table: tables.functions) {
        if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
            let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
            let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
            if declarationRow < 0 { return functionRow + 1 }
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
            let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
            let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
            state llvmReturnType: String("")
            llvmReturnType: compilerCoreLLVMTypeNameForRangeType(typeName: returnType)
            if compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
                llvmReturnType: compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: returnType)
            }
            let returnMode: Int(compilerModuleABIPlanReturnMode(plan: abiPlan, tables: tables, index: index, functionRow: functionRow))
            if returnMode == compilerFunctionReturnABIIndirect() { llvmReturnType: String("void") }
            let symbolNeedle: String("@\(name)(")
            let definitionPrefix: String("define \(llvmReturnType) ")
            let callPrefix: String("call \(llvmReturnType) ")
            state symbolNeedleLength: Int(0)
            state definitionPrefixLength: Int(0)
            state callPrefixLength: Int(0)
            symbolNeedleLength: stringLength(value: symbolNeedle)
            definitionPrefixLength: stringLength(value: definitionPrefix)
            callPrefixLength: stringLength(value: callPrefix)
            state definitionCount: Int(0)
            state occurrence: Int(0)
            occurrence: stringFindFrom(source: text, start: 0, needle: symbolNeedle)
            while occurrence >= 0 {
                state recognized: Bool(false)
                if occurrence >= definitionPrefixLength {
                    if text.substring(start: occurrence - definitionPrefixLength, end: occurrence) == definitionPrefix {
                        definitionCount: definitionCount + 1
                        recognized: true
                    }
                }
                if !recognized && occurrence >= callPrefixLength {
                    if text.substring(start: occurrence - callPrefixLength, end: occurrence) == callPrefix {
                        recognized: true
                        if returnMode == compilerFunctionReturnABIIndirect() {
                            let firstArgumentStart: Int(occurrence + symbolNeedleLength)
                            if !stringHasPrefix(source: text, start: firstArgumentStart, prefix: String("ptr ")) { return functionRow + 1 }
                        }
                    }
                }
                if !recognized { return functionRow + 1 }
                occurrence: stringFindFrom(source: text, start: occurrence + symbolNeedleLength, needle: symbolNeedle)
            }
            if definitionCount != 1 { return functionRow + 1 }
        }
        functionRow: functionRow + 1
    }
    return 0
}

function compilerCoreLLVMNativeEntryTextFromParts(usage: String, globals: String, runtime: String, helpers: String, declarations: String, main: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    textBufferAppend(buffer: outputBuffer, text: usage)
    textBufferAppend(buffer: outputBuffer, text: globals)
    textBufferAppend(buffer: outputBuffer, text: runtime)
    textBufferAppend(buffer: outputBuffer, text: helpers)
    textBufferAppend(buffer: outputBuffer, text: declarations)
    textBufferAppend(buffer: outputBuffer, text: main)
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreNativeMainUsageGlobalLLVMText(): String {
    return String("")
}

function compilerCoreNativeMainLLVMText(): String {
    let newlineValue: String("
")
    let newline: String(newlineValue.substring(start: 0, end: 1))
    let atSign: String("@")
    state output: String("")
    output: "define i32 \(atSign)main() {\(newline)"
    output: "\(output)entry:\(newline)"
    output: "\(output)  %r0 = call i32 \(atSign)commandLineArgumentCount()\(newline)"
    output: "\(output)  %r1 = icmp ne i32 %r0, 1\(newline)"
    output: "\(output)  br i1 %r1, label %if0, label %after0\(newline)"
    output: "\(output)if0:\(newline)"
    output: "\(output)  ret i32 64\(newline)"
    output: "\(output)after0:\(newline)"
    output: "\(output)  %r3 = call ptr \(atSign)commandLineArgument(i32 0)\(newline)"
    output: "\(output)  %r4 = call ptr \(atSign)readFile(ptr %r3)\(newline)"
    output: "\(output)  %r5 = call ptr \(atSign)compileRangeNativeSource(ptr %r4)\(newline)"
    output: "\(output)  %r6 = call i32 \(atSign)puts(ptr %r5)\(newline)"
    output: "\(output)  %r7 = call i32 \(atSign)compilerNativeOutputExitCode(ptr %r5)\(newline)"
    output: "\(output)  ret i32 %r7\(newline)"
    output: "\(output)}\(newline)"
    return output
}

function compilerCoreLLVMEntryTextForLoweredBlock(program: CompilerProgram, loweredBlock: CompilerLLVMLoweredBlock, reachableFunctions: String): String {
    let selectedHelperFunctions: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctions(program: program, names: reachableFunctions, initialTemporaryIndex: loweredBlock.nextTemporary))
    let module: CompilerLLVMModule(compilerCoreLLVMEntryModule(program: program, block: loweredBlock, selectedHelperFunctions: selectedHelperFunctions, reachableFunctions: reachableFunctions))
    let renderedText: String(compilerCoreRenderLLVMModule(module: module))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: renderedText))
    if placeholderCount > 0 {
        return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: renderedText)
    }
    return renderedText
}

function compilerCoreLLVMEntryModule(program: CompilerProgram, block: CompilerLLVMLoweredBlock, selectedHelperFunctions: CompilerLLVMHelperFunctions, reachableFunctions: String): CompilerLLVMModule {
    let mainBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    let mainFunction: CompilerLLVMFunction(CompilerLLVMFunction(
        name: String("main"),
        returnType: String("i32"),
        parameterText: String(""),
        renderedBlocks: block.renderedBlocks,
        block: mainBlock
    ))
    return CompilerLLVMModule(
        helperFunctions: "\(selectedHelperFunctions.renderedFunctions)\(compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: reachableFunctions))",
        instructionRecords: "\(selectedHelperFunctions.instructionRecords)\(block.instructionRecords)",
        mainFunction: mainFunction
    )
}

function compilerCoreLLVMModule(program: CompilerProgram, block: CompilerLLVMLoweredBlock): CompilerLLVMModule {
    let helperFunctions: CompilerLLVMHelperFunctions(compilerCoreLLVMHelperFunctions(program: program))
    let mainBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    let mainFunction: CompilerLLVMFunction(CompilerLLVMFunction(
        name: String("main"),
        returnType: String("i32"),
        parameterText: String(""),
        renderedBlocks: block.renderedBlocks,
        block: mainBlock
    ))
    return CompilerLLVMModule(
        helperFunctions: helperFunctions.renderedFunctions,
        instructionRecords: "\(helperFunctions.instructionRecords)\(block.instructionRecords)",
        mainFunction: mainFunction
    )
}

function compilerCoreMainLLVM(block: CompilerLLVMLoweredBlock): String {
    let fallbackProgram: CompilerProgram(CompilerProgram(source: String(""), hasMainBlock: false, mainAttributeStart: 0, mainBlock: block.block, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: block.declarationRecords, declarationSummary: String("")))
    let module: CompilerLLVMModule(compilerCoreLLVMModule(program: fallbackProgram, block: block))
    return compilerCoreRenderLLVMModule(module: module)
}

function compilerCoreLLVMHelperFunctions(program: CompilerProgram): CompilerLLVMHelperFunctions {
    state renderedFunctions: String("")
    state instructionRecords: String("")
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: program.declarationRecords))

    while sourceIndex < recordsLength {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: sourceIndex))
        if record == String("") {
            return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords, nextTemporary: 0)
        }

            let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
            if declaration.kind == String("function") {
                let loweredFunction: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerHelperFunction(program: program, declaration: declaration, initialTemporaryIndex: sourceIndex))
                let renderedFunction: String(compilerCoreRenderLLVMHelperFunction(declaration: declaration, block: loweredFunction))
                renderedFunctions: "\(renderedFunctions)\(renderedFunction)"
                instructionRecords: "\(instructionRecords)\(compilerCoreLLVMGlobalRecords(records: loweredFunction.instructionRecords))"
            }
        sourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: sourceIndex)
    }

    return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords, nextTemporary: 0)
}

function compilerCoreLLVMSelectedHelperFunctions(program: CompilerProgram, names: String, initialTemporaryIndex: Int): CompilerLLVMHelperFunctions {
    let functionsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    let recordsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    state sourceIndex: Int(0)
    state nextTemporary: Int(initialTemporaryIndex)
    let recordsLength: Int(stringLength(value: program.declarationRecords))
    let chunkLength: Int(100000)

    while sourceIndex < recordsLength {
        let chunkEnd: Int(sourceIndex + chunkLength)
        let chunk: CompilerLLVMHelperFunctionChunk(compilerCoreLLVMSelectedHelperFunctionsChunk(program: program, loweringProgram: program, names: names, sourceIndex: sourceIndex, chunkEnd: chunkEnd, recordsLength: recordsLength, initialTemporaryIndex: nextTemporary))
        textBufferAppend(buffer: functionsBuffer, text: chunk.renderedFunctions)
        textBufferAppend(buffer: recordsBuffer, text: chunk.instructionRecords)
        if chunk.nextIndex <= sourceIndex {
            return compilerCoreLLVMHelperFunctionsFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer, nextTemporary: chunk.nextTemporary)
        }
        sourceIndex: chunk.nextIndex
        nextTemporary: chunk.nextTemporary
    }

    return compilerCoreLLVMHelperFunctionsFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer, nextTemporary: nextTemporary)
}

function compilerCoreLLVMSelectedHelperFunctionsChunk(program: CompilerProgram, loweringProgram: CompilerProgram, names: String, sourceIndex: Int, chunkEnd: Int, recordsLength: Int, initialTemporaryIndex: Int): CompilerLLVMHelperFunctionChunk {
    let functionsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    let recordsBuffer: TextBuffer(textBufferCreate(capacity: 1048576))
    state nextSourceIndex: Int(sourceIndex)
    state nextTemporary: Int(initialTemporaryIndex)

    while nextSourceIndex < recordsLength && nextSourceIndex < chunkEnd {
        let record: String(compilerCoreTopLevelDeclarationRecordAt(records: program.declarationRecords, start: nextSourceIndex))
        if record == String("") {
            return compilerCoreLLVMHelperFunctionChunkFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer, nextIndex: recordsLength, nextTemporary: nextTemporary)
        }

        let transientMark: Int(stringTransientRegionMark())
        let selectedFunction: CompilerLLVMHelperFunctions(compilerCoreLLVMSelectedHelperFunctionForRecord(loweringProgram: loweringProgram, names: names, initialTemporaryIndex: nextTemporary, record: record))
        state selectedNextTemporary: Int(0)
        selectedNextTemporary: selectedFunction.nextTemporary
        textBufferAppend(buffer: functionsBuffer, text: selectedFunction.renderedFunctions)
        textBufferAppend(buffer: recordsBuffer, text: selectedFunction.instructionRecords)
        stringTransientRegionReset(mark: transientMark)
        nextTemporary: selectedNextTemporary
        nextSourceIndex: compilerCoreTopLevelDeclarationRecordNextIndex(records: program.declarationRecords, start: nextSourceIndex)
    }

    return compilerCoreLLVMHelperFunctionChunkFromTextBuffers(functionsBuffer: functionsBuffer, recordsBuffer: recordsBuffer, nextIndex: nextSourceIndex, nextTemporary: nextTemporary)
}

function compilerCoreLLVMHelperFunctionsFromTextBuffers(functionsBuffer: TextBuffer, recordsBuffer: TextBuffer, nextTemporary: Int): CompilerLLVMHelperFunctions {
    let renderedFunctions: String(textBufferMaterialize(buffer: functionsBuffer))
    let instructionRecords: String(textBufferMaterialize(buffer: recordsBuffer))
    textBufferDestroy(buffer: functionsBuffer)
    textBufferDestroy(buffer: recordsBuffer)
    return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords, nextTemporary: nextTemporary)
}

function compilerCoreLLVMHelperFunctionChunkFromTextBuffers(functionsBuffer: TextBuffer, recordsBuffer: TextBuffer, nextIndex: Int, nextTemporary: Int): CompilerLLVMHelperFunctionChunk {
    let renderedFunctions: String(textBufferMaterialize(buffer: functionsBuffer))
    let instructionRecords: String(textBufferMaterialize(buffer: recordsBuffer))
    textBufferDestroy(buffer: functionsBuffer)
    textBufferDestroy(buffer: recordsBuffer)
    return CompilerLLVMHelperFunctionChunk(renderedFunctions: renderedFunctions, instructionRecords: instructionRecords, nextIndex: nextIndex, nextTemporary: nextTemporary)
}

function compilerCoreLLVMSelectedHelperFunctionForRecord(loweringProgram: CompilerProgram, names: String, initialTemporaryIndex: Int, record: String): CompilerLLVMHelperFunctions {
    let declarationKind: String(compilerCoreRecordField(record: record, prefix: String("kind=")))
    let declarationName: String(compilerCoreRecordField(record: record, prefix: String("name=")))
    if declarationKind == String("function") && compilerCoreNameListContains(names: names, name: declarationName) {
        let declaration: CompilerTopLevelDeclaration(compilerCoreTopLevelDeclarationFromRecord(record: record))
        return compilerCoreLLVMSelectedHelperFunctionForDeclaration(loweringProgram: loweringProgram, declaration: declaration, initialTemporaryIndex: initialTemporaryIndex)
    }

    return CompilerLLVMHelperFunctions(renderedFunctions: String(""), instructionRecords: String(""), nextTemporary: initialTemporaryIndex)
}

function compilerCoreLLVMSelectedHelperFunctionForDeclaration(loweringProgram: CompilerProgram, declaration: CompilerTopLevelDeclaration, initialTemporaryIndex: Int): CompilerLLVMHelperFunctions {
    if compilerCoreShouldLowerSelectedHelperFunction(program: loweringProgram, declaration: declaration) {
        let loweredFunction: CompilerLLVMLoweredBlock(compilerCoreLLVMLowerHelperFunction(program: loweringProgram, declaration: declaration, initialTemporaryIndex: initialTemporaryIndex))
        let renderedFunction: String(compilerCoreRenderLLVMHelperFunction(declaration: declaration, block: loweredFunction))
        let globalRecords: String(compilerCoreLLVMGlobalRecords(records: loweredFunction.instructionRecords))
        return CompilerLLVMHelperFunctions(renderedFunctions: renderedFunction, instructionRecords: globalRecords, nextTemporary: loweredFunction.nextTemporary)
    }

    let declarationText: String(compilerCoreRenderLLVMHelperFunctionDeclaration(declaration: declaration))
    return CompilerLLVMHelperFunctions(renderedFunctions: declarationText, instructionRecords: String(""), nextTemporary: initialTemporaryIndex)
}

function compilerCoreRenderLLVMFunctionDeclarations(program: CompilerProgram): String {
    return compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: String(""))
}

function compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: CompilerProgram, names: String): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    let declarationCount: Int(compilerCoreAppendLLVMFunctionDeclarations(program: program, names: names, outputBuffer: outputBuffer))
    if declarationCount > 0 {
        textBufferAppend(buffer: outputBuffer, text: String("\n"))
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMFunctionDeclarationsExcludingTyped(tables: CompilerSyntaxTables, selection: CompilerFunctionSelection): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 65536))
    let declarationCount: Int(compilerCoreAppendLLVMFunctionDeclarationsTyped(tables: tables, selection: selection, outputBuffer: outputBuffer))
    if declarationCount > 0 {
        textBufferAppend(buffer: outputBuffer, text: String("\n"))
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreAppendLLVMFunctionDeclarationsTyped(tables: CompilerSyntaxTables, selection: CompilerFunctionSelection, outputBuffer: TextBuffer): Int {
    state declarationRow: Int(0)
    state declarationCount: Int(0)
    let rowCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while declarationRow < rowCount {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
            declarationCount: declarationCount + compilerCoreAppendLLVMFunctionDeclarationTyped(tables: tables, declarationRow: declarationRow, functionRow: functionRow, selection: selection, outputBuffer: outputBuffer)
        }
        declarationRow: declarationRow + 1
    }
    return declarationCount
}

function compilerCoreAppendLLVMFunctionDeclarationTyped(tables: CompilerSyntaxTables, declarationRow: Int, functionRow: Int, selection: CompilerFunctionSelection, outputBuffer: TextBuffer): Int {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 13) == 1
        && compilerBodyRuntimeBuiltinID(name: name) != compilerBodyRuntimeBuiltinNone() { return 0 }
    if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
        return 0
    }
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    let parameters: String(compilerCoreLLVMFunctionParameterTextTyped(tables: tables, functionRow: functionRow))
    textBufferAppend(buffer: outputBuffer, text: "declare \(compilerCoreLLVMTypeNameForRangeType(typeName: returnType)) @\(name)(\(parameters))\n")
    return 1
}

function compilerCoreLLVMFunctionParameterTextTyped(tables: CompilerSyntaxTables, functionRow: Int): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 256))
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if ordinal > 0 { textBufferAppend(buffer: outputBuffer, text: String(", ")) }
        textBufferAppend(buffer: outputBuffer, text: "\(compilerCoreLLVMTypeNameForRangeType(typeName: typeName)) %\(name)")
        ordinal: ordinal + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMNativeABITypeName(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, typeName: String): String {
    let optionalTypeName: String(compilerSpecializedOptionalLLVMTypeName(tables: tables, index: index, typeName: typeName))
    if optionalTypeName != String("") { return optionalTypeName }
    let nominalName: String(compilerBodyArenaTypeOuterName(typeName: typeName))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindConstruct()))
    let nominalTypeName: String(compilerNominalLLVMTypeName(tables: tables, declarationRow: declarationRow))
    if nominalTypeName != String("") { return nominalTypeName }
    return compilerCoreLLVMTypeNameForRangeType(typeName: typeName)
}

function compilerCoreLLVMFunctionParameterTextPlanned(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int, abiPlan: CompilerModuleABIPlan): String {
    if !compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
        return compilerCoreLLVMFunctionParameterTextTyped(tables: tables, functionRow: functionRow)
    }
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 256))
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if ordinal > 0 { textBufferAppend(buffer: outputBuffer, text: String(", ")) }
        textBufferAppend(buffer: outputBuffer, text: "\(compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: typeName)) %\(name)")
        ordinal: ordinal + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMFunctionParameterLocalValuesTyped(tables: CompilerSyntaxTables, functionRow: Int): String {
    let outputBuffer: TextBuffer(textBufferCreate(capacity: 512))
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        textBufferAppend(buffer: outputBuffer, text: compilerCoreLLVMLocalRecordWithRangeType(name: name, operand: "%\(name)", typeName: compilerCoreLLVMTypeNameForRangeType(typeName: typeName), rangeTypeName: typeName))
        ordinal: ordinal + 1
    }
    return compilerCoreTextBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerReachableLLVMNextTemporary(): Int { return 0 }
function compilerReachableLLVMRuntimeRequirements(): Int { return 1 }
function compilerReachableLLMSupported(): Int { return 2 }
function compilerReachableLLMTypedAttempts(): Int { return 3 }
function compilerReachableLLMTypedSuccesses(): Int { return 4 }
function compilerReachableLLMLegacyParses(): Int { return 5 }
function compilerReachableLLMArenaCreates(): Int { return 6 }
function compilerReachableLLMArenaDestroys(): Int { return 7 }
function compilerReachableLLMRecordBytes(): Int { return 8 }
function compilerReachableLLMCommittedFailures(): Int { return 9 }
function compilerReachableLLMValid(): Int { return 10 }
function compilerReachableLLMWorkIndex(): Int { return 11 }
function compilerReachableLLMIndirectCapabilities(): Int { return 12 }
function compilerReachableLLMIndirectActivations(): Int { return 13 }
function compilerReachableLLVMEmissionIndex(): Int { return 14 }
function compilerReachableLLVMPlanFrozen(): Int { return 15 }
function compilerReachableLLVMFailureStage(): Int { return 16 }
function compilerReachableLLMCounterCount(): Int { return 17 }

function compilerReachableLLVMStateCreate(context: CompilerLLVMLoweringContext): CompilerReachableLLVMState {
    let functionCount: Int(compilerIntTableRowCount(table: context.tables.functions))
    let counters: IntBuffer(intBufferCreate(capacity: compilerReachableLLMCounterCount()))
    state counterIndex: Int(0)
    while counterIndex < compilerReachableLLMCounterCount() {
        intBufferAppend(buffer: counters, value: 0)
        counterIndex: counterIndex + 1
    }
    intBufferSet(buffer: counters, index: compilerReachableLLMValid(), value: 1)
    let abiCapabilities: IntBuffer(intBufferCreate(capacity: functionCount))
    let abiActivation: IntBuffer(intBufferCreate(capacity: functionCount))
    let abiReturnModes: IntBuffer(intBufferCreate(capacity: functionCount))
    let abiParticipants: IntBuffer(intBufferCreate(capacity: functionCount))
    let abiSensitiveFunctions: IntBuffer(intBufferCreate(capacity: functionCount))
    state capabilityRow: Int(0)
    while capabilityRow < functionCount {
        intBufferAppend(buffer: abiCapabilities, value: 0)
        intBufferAppend(buffer: abiActivation, value: 0)
        intBufferAppend(buffer: abiReturnModes, value: compilerFunctionReturnABINone())
        intBufferAppend(buffer: abiParticipants, value: 0)
        intBufferAppend(buffer: abiSensitiveFunctions, value: 0)
        capabilityRow: capabilityRow + 1
    }
    return CompilerReachableLLVMState(
        context: context,
        selection: compilerFunctionSelectionCreateEmpty(functionCount: functionCount, valid: context.declarationIndex.isValid),
        worklist: intBufferCreate(capacity: functionCount),
        edgeOwners: intBufferCreate(capacity: functionCount * 4),
        edgeTargets: intBufferCreate(capacity: functionCount * 4),
        abiCapabilities: abiCapabilities,
        abiActivation: abiActivation,
        abiReturnModes: abiReturnModes,
        abiParticipants: abiParticipants,
        abiSensitiveFunctions: abiSensitiveFunctions,
        functionsBuffer: textBufferCreate(capacity: 1048576),
        globalsBuffer: textBufferCreate(capacity: 65536),
        counters: counters
    )
}

function compilerReachableLLVMStateSetInvalid(reachability: CompilerReachableLLVMState): Int {
    if intBufferSet(buffer: reachability.counters, index: compilerReachableLLMValid(), value: 0) != 0 { return 0 - 1 }
    return 0 - 1
}

function compilerReachableLLVMStateSetInvalidAt(reachability: CompilerReachableLLVMState, stage: Int): Int {
    if intBufferSet(buffer: reachability.counters, index: compilerReachableLLVMFailureStage(), value: stage) != 0 { return 0 - 1 }
    return compilerReachableLLVMStateSetInvalid(reachability: reachability)
}

function compilerReachableLLVMStateAddCounter(reachability: CompilerReachableLLVMState, index: Int, value: Int): Int {
    return intBufferSet(buffer: reachability.counters, index: index, value: intBufferElement(buffer: reachability.counters, index: index) + value)
}

function compilerReachableLLVMStateEnqueueEdges(reachability: CompilerReachableLLVMState, edgeStart: Int): Int {
    state edgeIndex: Int(edgeStart)
    while edgeIndex < intBufferCount(buffer: reachability.edgeTargets) {
        let targetFunctionRow: Int(intBufferElement(buffer: reachability.edgeTargets, index: edgeIndex))
        if targetFunctionRow < 0 || targetFunctionRow >= compilerIntTableRowCount(table: reachability.context.tables.functions) { return 0 - 1 }
        if !compilerFunctionSelectionContains(selection: reachability.selection, functionRow: targetFunctionRow) {
            if compilerFunctionSelectionMark(selection: reachability.selection, functionRow: targetFunctionRow) != 0
                || intBufferAppend(buffer: reachability.worklist, value: targetFunctionRow) != 0 { return 0 - 1 }
        }
        edgeIndex: edgeIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateAccumulate(reachability: CompilerReachableLLVMState, selected: CompilerTypedLLVMHelpers): Int {
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMSupported(), value: selected.telemetry.supportedCount) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMTypedAttempts(), value: selected.telemetry.typedParseAttempts) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMTypedSuccesses(), value: selected.telemetry.typedParseSuccesses) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMLegacyParses(), value: selected.telemetry.legacyParses) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMArenaCreates(), value: selected.telemetry.arenaCreates) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMArenaDestroys(), value: selected.telemetry.arenaDestroys) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMRecordBytes(), value: selected.telemetry.recordBytes) != 0
        || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMCommittedFailures(), value: selected.telemetry.committedFailures) != 0 { return 0 - 1 }
    if selected.runtimeRequirements > intBufferElement(buffer: reachability.counters, index: compilerReachableLLVMRuntimeRequirements()) {
        if intBufferSet(buffer: reachability.counters, index: compilerReachableLLVMRuntimeRequirements(), value: selected.runtimeRequirements) != 0 { return 0 - 1 }
    }
    return intBufferSet(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary(), value: selected.helpers.nextTemporary)
}

function compilerReachableLLVMStatePlannedReturnMode(reachability: CompilerReachableLLVMState, functionRow: Int): Int {
    let signatureMode: Int(compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow))
    if signatureMode == compilerFunctionReturnABINone()
        && intBufferElement(buffer: reachability.abiSensitiveFunctions, index: functionRow) == 1 { return compilerFunctionReturnABIIndirect() }
    return signatureMode
}

function compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: CompilerReachableLLVMState, functionRow: Int): Bool {
    if intBufferElement(buffer: reachability.abiSensitiveFunctions, index: functionRow) == 1 { return true }
    return compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow)
}

function compilerReachableLLVMStatePrepareCandidateABIPlan(reachability: CompilerReachableLLVMState): Int {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    state functionRow: Int(0)
    while functionRow < functionCount {
        let functionTransientMark: Int(stringTransientRegionMark())
        let returnMode: Int(compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: functionRow))
        state participant: Int(0)
        if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: functionRow) {
            if compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: functionRow) { participant: 1 }
        }
        if intBufferSet(buffer: reachability.abiReturnModes, index: functionRow, value: returnMode) != 0
            || intBufferSet(buffer: reachability.abiParticipants, index: functionRow, value: participant) != 0 {
            stringTransientRegionReset(mark: functionTransientMark)
            return 0 - 1
        }
        stringTransientRegionReset(mark: functionTransientMark)
        functionRow: functionRow + 1
    }
    state edgeIndex: Int(0)
    while edgeIndex < intBufferCount(buffer: reachability.edgeTargets) {
        let ownerFunctionRow: Int(intBufferElement(buffer: reachability.edgeOwners, index: edgeIndex))
        let targetFunctionRow: Int(intBufferElement(buffer: reachability.edgeTargets, index: edgeIndex))
        if ownerFunctionRow < 0 || ownerFunctionRow >= functionCount || targetFunctionRow < 0 || targetFunctionRow >= functionCount { return 0 - 1 }
        let edgeTransientMark: Int(stringTransientRegionMark())
        if compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow) {
            if intBufferSet(buffer: reachability.abiParticipants, index: ownerFunctionRow, value: 1) != 0
                || intBufferSet(buffer: reachability.abiParticipants, index: targetFunctionRow, value: 1) != 0 {
                stringTransientRegionReset(mark: edgeTransientMark)
                return 0 - 1
            }
        }
        stringTransientRegionReset(mark: edgeTransientMark)
        edgeIndex: edgeIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateSensitiveCount(reachability: CompilerReachableLLVMState): Int {
    state count: Int(0)
    state functionRow: Int(0)
    while functionRow < intBufferCount(buffer: reachability.abiSensitiveFunctions) {
        if intBufferElement(buffer: reachability.abiSensitiveFunctions, index: functionRow) == 1 { count: count + 1 }
        functionRow: functionRow + 1
    }
    return count
}

function compilerReachableLLVMStateProbeCandidateFunction(reachability: CompilerReachableLLVMState, functionRow: Int): Int {
    state transientMark: Int(stringTransientRegionMark())
    let probeEdgeOwners: IntBuffer(intBufferCreate(capacity: 16))
    let probeEdgeTargets: IntBuffer(intBufferCreate(capacity: 16))
    let sensitiveCountBefore: Int(compilerReachableLLVMStateSensitiveCount(reachability: reachability))
    let candidatePlan: CompilerModuleABIPlan(CompilerModuleABIPlan(returnModes: reachability.abiReturnModes, participants: reachability.abiParticipants, isFrozen: true))
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreate(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow)))
    state capable: Bool(compilerBodyArenaIsValid(arena: arena))
    state failureStage: Int(1)
    if capable {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 {
            failureStage: 2
            capable: false
        }
    }
    if capable {
        if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) {
            failureStage: 3
            capable: false
        }
    }
    if capable {
        if compilerBodyArenaAppendFunctionEdges(arena: arena, edgeOwners: probeEdgeOwners, edgeTargets: probeEdgeTargets) != 0 {
            failureStage: 10
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable {
        if compilerBodyArenaBuildCFG(arena: arena) != 0 {
            failureStage: 4
            capable: false
        }
    }
    if capable {
        if !compilerBodyArenaCFGIsValid(arena: arena) {
            failureStage: 5
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable {
        let memoryBuildStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: candidatePlan))
        if memoryBuildStatus != 0 {
            failureStage: 6000 + memoryBuildStatus
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable {
        if compilerBodyMIRBuild(arena: arena) != 0 {
            failureStage: 7
            capable: false
        }
    }
    if capable {
        if compilerBodyMIRAppendFunctionEdges(arena: arena, edgeOwners: probeEdgeOwners, edgeTargets: probeEdgeTargets) != 0 {
            failureStage: 10
            capable: false
        }
    }
    if capable {
        if compilerBodyMIRMarkRepresentationSensitiveTargets(arena: arena, sensitiveFunctions: reachability.abiSensitiveFunctions) != 0 {
            failureStage: 10001
            capable: false
        }
    }
    state discoveredSensitiveTarget: Bool(false)
    if capable && compilerReachableLLVMStateSensitiveCount(reachability: reachability) != sensitiveCountBefore { discoveredSensitiveTarget: true }
    if capable {
        state probeEdgeIndex: Int(0)
        while capable && probeEdgeIndex < intBufferCount(buffer: probeEdgeTargets) {
            if !compilerFunctionEdgesContain(edgeOwners: reachability.edgeOwners, edgeTargets: reachability.edgeTargets, ownerFunctionRow: intBufferElement(buffer: probeEdgeOwners, index: probeEdgeIndex), targetFunctionRow: intBufferElement(buffer: probeEdgeTargets, index: probeEdgeIndex)) {
                failureStage: 10002
                capable: false
            }
            probeEdgeIndex: probeEdgeIndex + 1
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable && !discoveredSensitiveTarget {
        let validationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: candidatePlan))
        if validationCode != 0 {
            failureStage: 8000 + validationCode
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    state capabilityValue: Int(1)
    if !capable { capabilityValue: 0 - failureStage }
    if discoveredSensitiveTarget { capabilityValue: 0 }
    state status: Int(intBufferSet(buffer: reachability.abiCapabilities, index: functionRow, value: capabilityValue))
    if compilerBodyArenaDestroy(arena: arena) != 0 { status: 0 - 1 }
    if intBufferDestroy(buffer: probeEdgeOwners) != 0 || intBufferDestroy(buffer: probeEdgeTargets) != 0 { status: 0 - 1 }
    stringTransientRegionReset(mark: transientMark)
    return status
}

function compilerReachableLLVMStateRefreshCapabilityCounter(reachability: CompilerReachableLLVMState): Int {
    state capabilityCount: Int(0)
    state functionRow: Int(0)
    while functionRow < intBufferCount(buffer: reachability.abiCapabilities) {
        if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: functionRow)
            && intBufferElement(buffer: reachability.abiCapabilities, index: functionRow) == 1 { capabilityCount: capabilityCount + 1 }
        functionRow: functionRow + 1
    }
    return intBufferSet(buffer: reachability.counters, index: compilerReachableLLMIndirectCapabilities(), value: capabilityCount)
}

function compilerReachableLLVMStatePruneFailedCandidateComponents(reachability: CompilerReachableLLVMState): Int {
    state functionRow: Int(0)
    while functionRow < intBufferCount(buffer: reachability.abiCapabilities) {
        if intBufferElement(buffer: reachability.abiParticipants, index: functionRow) == 1
            && intBufferElement(buffer: reachability.abiCapabilities, index: functionRow) < 0 {
            if intBufferSet(buffer: reachability.abiParticipants, index: functionRow, value: 2) != 0 { return 0 - 1 }
        }
        functionRow: functionRow + 1
    }
    state changed: Bool(true)
    while changed {
        changed: false
        state edgeIndex: Int(0)
        while edgeIndex < intBufferCount(buffer: reachability.edgeTargets) {
            let ownerFunctionRow: Int(intBufferElement(buffer: reachability.edgeOwners, index: edgeIndex))
            let targetFunctionRow: Int(intBufferElement(buffer: reachability.edgeTargets, index: edgeIndex))
            if compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow) {
                if intBufferElement(buffer: reachability.abiParticipants, index: ownerFunctionRow) == 2
                    && intBufferElement(buffer: reachability.abiParticipants, index: targetFunctionRow) == 1 {
                    if intBufferSet(buffer: reachability.abiParticipants, index: targetFunctionRow, value: 2) != 0 { return 0 - 1 }
                    changed: true
                }
                if intBufferElement(buffer: reachability.abiParticipants, index: targetFunctionRow) == 2
                    && intBufferElement(buffer: reachability.abiParticipants, index: ownerFunctionRow) == 1 {
                    if intBufferSet(buffer: reachability.abiParticipants, index: ownerFunctionRow, value: 2) != 0 { return 0 - 1 }
                    changed: true
                }
            }
            edgeIndex: edgeIndex + 1
        }
    }
    return 0
}

function compilerReachableLLVMStatePreclassifyCandidateBodies(reachability: CompilerReachableLLVMState): Int {
    state candidateIndex: Int(0)
    while candidateIndex < intBufferCount(buffer: reachability.worklist) {
        let functionRow: Int(intBufferElement(buffer: reachability.worklist, index: candidateIndex))
        if intBufferElement(buffer: reachability.abiParticipants, index: functionRow) == 1
            && intBufferElement(buffer: reachability.abiCapabilities, index: functionRow) == 0 {
            if !compilerBodyArenaRecognizesFunction(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow) {
                if intBufferSet(buffer: reachability.abiCapabilities, index: functionRow, value: 0 - 1) != 0 { return 0 - 1 }
                if compilerReachableLLVMStatePruneFailedCandidateComponents(reachability: reachability) != 0 { return 0 - 1 }
            }
        }
        candidateIndex: candidateIndex + 1
    }
    return 0
}

function compilerReachableLLVMStatePreclassifyCandidateCFG(reachability: CompilerReachableLLVMState): Int {
    state candidateIndex: Int(0)
    while candidateIndex < intBufferCount(buffer: reachability.worklist) {
        let functionRow: Int(intBufferElement(buffer: reachability.worklist, index: candidateIndex))
        if intBufferElement(buffer: reachability.abiParticipants, index: functionRow) == 1
            && intBufferElement(buffer: reachability.abiCapabilities, index: functionRow) == 0 {
            let transientMark: Int(stringTransientRegionMark())
            let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreate(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow)))
            state capable: Bool(compilerBodyArenaIsValid(arena: arena))
            state failureStage: Int(1)
            if capable {
                if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 {
                    failureStage: 2
                    capable: false
                }
            }
            if capable {
                if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) {
                    failureStage: 3
                    capable: false
                }
            }
            if capable {
                if compilerBodyArenaBuildCFG(arena: arena) != 0 {
                    failureStage: 4
                    capable: false
                }
            }
            if capable {
                if !compilerBodyArenaCFGIsValid(arena: arena) {
                    failureStage: 5
                    capable: false
                }
            }
            if !capable {
                if intBufferSet(buffer: reachability.abiCapabilities, index: functionRow, value: 0 - failureStage) != 0 {
                    compilerBodyArenaDestroy(arena: arena)
                    stringTransientRegionReset(mark: transientMark)
                    return 0 - 1
                }
            }
            if compilerBodyArenaDestroy(arena: arena) != 0 {
                stringTransientRegionReset(mark: transientMark)
                return 0 - 1
            }
            stringTransientRegionReset(mark: transientMark)
            if compilerReachableLLVMStatePruneFailedCandidateComponents(reachability: reachability) != 0 { return 0 - 1 }
        }
        candidateIndex: candidateIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateProbeCandidateABIPlan(reachability: CompilerReachableLLVMState): Int {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    state iteration: Int(0)
    state graphChanged: Bool(true)
    while graphChanged {
        if iteration > functionCount { return 0 - 1 }
        graphChanged: false
        let edgeCountBefore: Int(intBufferCount(buffer: reachability.edgeTargets))
        let sensitiveCountBefore: Int(compilerReachableLLVMStateSensitiveCount(reachability: reachability))
        let workCountBefore: Int(intBufferCount(buffer: reachability.worklist))
        if compilerReachableLLVMStatePrepareCandidateABIPlan(reachability: reachability) != 0 { return 0 - 1 }
        if compilerReachableLLVMStatePreclassifyCandidateBodies(reachability: reachability) != 0 { return 0 - 1 }
        if compilerReachableLLVMStatePruneFailedCandidateComponents(reachability: reachability) != 0 { return 0 - 1 }
        if compilerReachableLLVMStatePreclassifyCandidateCFG(reachability: reachability) != 0 { return 0 - 1 }
        state candidateIndex: Int(0)
        while candidateIndex < intBufferCount(buffer: reachability.worklist) {
            let candidateFunctionRow: Int(intBufferElement(buffer: reachability.worklist, index: candidateIndex))
            if intBufferElement(buffer: reachability.abiParticipants, index: candidateFunctionRow) == 1
                && intBufferElement(buffer: reachability.abiCapabilities, index: candidateFunctionRow) == 0 {
                if compilerReachableLLVMStateProbeCandidateFunction(reachability: reachability, functionRow: candidateFunctionRow) != 0 { return 0 - 1 }
                if compilerReachableLLVMStatePruneFailedCandidateComponents(reachability: reachability) != 0 { return 0 - 1 }
            }
            candidateIndex: candidateIndex + 1
        }
        while intBufferElement(buffer: reachability.counters, index: compilerReachableLLMWorkIndex()) < intBufferCount(buffer: reachability.worklist) {
            let workIndex: Int(intBufferElement(buffer: reachability.counters, index: compilerReachableLLMWorkIndex()))
            let discoveredFunctionRow: Int(intBufferElement(buffer: reachability.worklist, index: workIndex))
            if compilerReachableLLVMStateDiscoverFunction(reachability: reachability, functionRow: discoveredFunctionRow) != 0 { return 0 - 1 }
            if intBufferSet(buffer: reachability.counters, index: compilerReachableLLMWorkIndex(), value: workIndex + 1) != 0 { return 0 - 1 }
        }
        if intBufferCount(buffer: reachability.edgeTargets) != edgeCountBefore
            || compilerReachableLLVMStateSensitiveCount(reachability: reachability) != sensitiveCountBefore
            || intBufferCount(buffer: reachability.worklist) != workCountBefore { graphChanged: true }
        iteration: iteration + 1
    }
    if compilerReachableLLVMStatePrepareCandidateABIPlan(reachability: reachability) != 0 { return 0 - 1 }
    if compilerReachableLLVMStatePruneFailedCandidateComponents(reachability: reachability) != 0 { return 0 - 1 }
    return compilerReachableLLVMStateRefreshCapabilityCounter(reachability: reachability)
}

function compilerReachableLLVMStateDiscoverFunction(reachability: CompilerReachableLLVMState, functionRow: Int): Int {
    let transientMark: Int(stringTransientRegionMark())
    let edgeStart: Int(intBufferCount(buffer: reachability.edgeTargets))
    state shouldProbeIndirectABI: Bool(false)
    let typedEdgeOwners: IntBuffer(intBufferCreate(capacity: 16))
    let typedEdgeTargets: IntBuffer(intBufferCreate(capacity: 16))
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreate(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow)))
    state typedReady: Bool(compilerBodyArenaIsValid(arena: arena))
    state typedFailureStage: Int(0)
    if !typedReady { typedFailureStage: 1 }
    if typedReady {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 {
            typedFailureStage: 2
            typedReady: false
        }
    }
    if typedReady {
        if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) {
            typedFailureStage: 3
            typedReady: false
        }
    }
    if typedReady {
        if compilerBodyArenaAppendFunctionEdges(arena: arena, edgeOwners: typedEdgeOwners, edgeTargets: typedEdgeTargets) != 0 {
            typedFailureStage: 10
            typedReady: false
        }
    }
    if typedReady {
        if compilerBodyArenaMarkRepresentationSensitiveTargets(arena: arena, sensitiveFunctions: reachability.abiSensitiveFunctions) != 0 {
            typedFailureStage: 10
            typedReady: false
        }
    }
    if typedReady && !shouldProbeIndirectABI {
        state typedProbeEdgeIndex: Int(0)
        while typedProbeEdgeIndex < intBufferCount(buffer: typedEdgeTargets) {
            let typedProbeTargetFunctionRow: Int(intBufferElement(buffer: typedEdgeTargets, index: typedProbeEdgeIndex))
            if compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: typedProbeTargetFunctionRow) == compilerFunctionReturnABIIndirect()
                || compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: typedProbeTargetFunctionRow) { shouldProbeIndirectABI: true }
            typedProbeEdgeIndex: typedProbeEdgeIndex + 1
        }
    }
    if !typedReady {
        state retainedFailureCode: Int(typedFailureStage)
        if intBufferCount(buffer: arena.failures) > 0 { retainedFailureCode: intBufferElement(buffer: arena.failures, index: 0) }
        if retainedFailureCode <= 0 { retainedFailureCode: 1 }
        if intBufferSet(buffer: reachability.abiCapabilities, index: functionRow, value: 0 - retainedFailureCode) != 0 {
            compilerBodyArenaDestroy(arena: arena)
            stringTransientRegionReset(mark: transientMark)
            return 0 - 1
        }
        compilerBodyArenaDestroy(arena: arena)
        stringTransientRegionReset(mark: transientMark)
        return 0 - 1
    }
    state typedEdgesAccepted: Bool(typedReady)
    state indirectCapableForPlan: Bool(typedReady)
    if shouldProbeIndirectABI {
        state indirectFailureStage: Int(typedFailureStage)
        if indirectCapableForPlan {
            if compilerBodyArenaBuildCFG(arena: arena) != 0 {
                indirectFailureStage: 4
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            if !compilerBodyArenaCFGIsValid(arena: arena) {
                indirectFailureStage: 5
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            let memoryBuildStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability)))
            if memoryBuildStatus != 0 {
                indirectFailureStage: 6000 + memoryBuildStatus
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            if compilerBodyMIRBuild(arena: arena) != 0 {
                indirectFailureStage: 7
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            if compilerBodyMIRAppendFunctionEdges(arena: arena, edgeOwners: typedEdgeOwners, edgeTargets: typedEdgeTargets) != 0 {
                indirectFailureStage: 10
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            if compilerBodyMIRMarkRepresentationSensitiveTargets(arena: arena, sensitiveFunctions: reachability.abiSensitiveFunctions) != 0 {
                indirectFailureStage: 10
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            let discoveryMIRValidationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability)))
            if discoveryMIRValidationCode != 0 {
                indirectFailureStage: 8000 + discoveryMIRValidationCode
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            let capabilityEmission: CompilerBodyLLVMEmissionResult(compilerBodyLLVMEmit(arena: arena, initialTemporary: 0, initialBranch: 0, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability)))
            if !capabilityEmission.isValid {
                indirectFailureStage: 9
                indirectCapableForPlan: false
            }
        }
        if indirectCapableForPlan {
            if intBufferSet(buffer: reachability.abiCapabilities, index: functionRow, value: 1) != 0
                || compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectCapabilities(), value: 1) != 0 {
                compilerBodyArenaDestroy(arena: arena)
                stringTransientRegionReset(mark: transientMark)
                return 0 - 1
            }
        } else {
            if intBufferSet(buffer: reachability.abiCapabilities, index: functionRow, value: 0 - indirectFailureStage) != 0 {
                compilerBodyArenaDestroy(arena: arena)
                stringTransientRegionReset(mark: transientMark)
                return 0 - 1
            }
        }
    }
    if typedEdgesAccepted {
        state acceptedEdgeIndex: Int(0)
        while acceptedEdgeIndex < intBufferCount(buffer: typedEdgeTargets) {
            if intBufferAppend(buffer: reachability.edgeOwners, value: intBufferElement(buffer: typedEdgeOwners, index: acceptedEdgeIndex)) != 0 { return 0 - 1 }
            if intBufferAppend(buffer: reachability.edgeTargets, value: intBufferElement(buffer: typedEdgeTargets, index: acceptedEdgeIndex)) != 0 { return 0 - 1 }
            acceptedEdgeIndex: acceptedEdgeIndex + 1
        }
    }
    if intBufferDestroy(buffer: typedEdgeOwners) != 0 || intBufferDestroy(buffer: typedEdgeTargets) != 0 { return 0 - 1 }
    if compilerBodyArenaDestroy(arena: arena) != 0
        || compilerReachableLLVMStateEnqueueEdges(reachability: reachability, edgeStart: edgeStart) != 0 {
        stringTransientRegionReset(mark: transientMark)
        return 0 - 1
    }
    stringTransientRegionReset(mark: transientMark)
    return 0
}

function compilerReachableLLVMStateEmitFunction(reachability: CompilerReachableLLVMState, functionRow: Int, emissionEdgeOwners: IntBuffer, emissionEdgeTargets: IntBuffer): Int {
    if intBufferElement(buffer: reachability.counters, index: compilerReachableLLVMPlanFrozen()) != 1 { return 0 - 1 }
    let syntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: functionRow, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: syntaxID))
    if declarationRow < 0 { return 0 - 1 }
    let fileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: fileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 8)))
    compilerMetricsFunctionBegin(functionID: functionRow, name: name)
    let transientMark: Int(stringTransientRegionMark())
    let selected: CompilerTypedLLVMHelpers(compilerCoreLLVMSelectedHelperFunctionTyped(context: reachability.context, declarationRow: declarationRow, functionRow: functionRow, initialTemporaryIndex: intBufferElement(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary()), edgeOwners: emissionEdgeOwners, edgeTargets: emissionEdgeTargets, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability)))
    compilerMetricsFunctionEnd(legacyParses: selected.telemetry.legacyParses, recordBytes: selected.telemetry.recordBytes)
    state status: Int(0)
    if textBufferAppend(buffer: reachability.functionsBuffer, text: selected.helpers.renderedFunctions) != 0
        || textBufferAppend(buffer: reachability.globalsBuffer, text: selected.renderedGlobals) != 0
        || compilerReachableLLVMStateAccumulate(reachability: reachability, selected: selected) != 0 { status: 0 - 1 }
    stringTransientRegionReset(mark: transientMark)
    return status
}

function compilerReachableLLVMStateFreezeABIPlan(reachability: CompilerReachableLLVMState): Int {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    state functionRow: Int(0)
    while functionRow < functionCount {
        state returnMode: Int(compilerFunctionReturnABINone())
        let capabilityMode: Int(compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: functionRow))
        if capabilityMode == compilerFunctionReturnABIDirect() { returnMode: compilerFunctionReturnABIDirect() }
        if intBufferElement(buffer: reachability.abiActivation, index: functionRow) == 1 { returnMode: compilerFunctionReturnABIIndirect() }
        if intBufferSet(buffer: reachability.abiReturnModes, index: functionRow, value: returnMode) != 0 { return 0 - 1 }
        if returnMode == compilerFunctionReturnABIIndirect() {
            if intBufferSet(buffer: reachability.abiParticipants, index: functionRow, value: 1) != 0 { return 0 - 1 }
        }
        functionRow: functionRow + 1
    }
    state edgeIndex: Int(0)
    while edgeIndex < intBufferCount(buffer: reachability.edgeTargets) {
        let ownerFunctionRow: Int(intBufferElement(buffer: reachability.edgeOwners, index: edgeIndex))
        let targetFunctionRow: Int(intBufferElement(buffer: reachability.edgeTargets, index: edgeIndex))
        if intBufferElement(buffer: reachability.abiReturnModes, index: targetFunctionRow) == compilerFunctionReturnABIIndirect() {
            if intBufferSet(buffer: reachability.abiParticipants, index: ownerFunctionRow, value: 1) != 0 { return 0 - 1 }
        }
        edgeIndex: edgeIndex + 1
    }
    return intBufferSet(buffer: reachability.counters, index: compilerReachableLLVMPlanFrozen(), value: 1)
}

function compilerReachableLLVMStateABIPlanIsValid(reachability: CompilerReachableLLVMState): Bool {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    if intBufferElement(buffer: reachability.counters, index: compilerReachableLLVMPlanFrozen()) != 1
        || intBufferCount(buffer: reachability.abiReturnModes) != functionCount
        || intBufferCount(buffer: reachability.abiParticipants) != functionCount { return false }
    state functionRow: Int(0)
    while functionRow < functionCount {
        let returnMode: Int(intBufferElement(buffer: reachability.abiReturnModes, index: functionRow))
        if returnMode < compilerFunctionReturnABINone() || returnMode > compilerFunctionReturnABIIndirect() { return false }
        if returnMode == compilerFunctionReturnABIIndirect()
            && (intBufferElement(buffer: reachability.abiActivation, index: functionRow) != 1
                || intBufferElement(buffer: reachability.abiParticipants, index: functionRow) != 1
                || compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: functionRow) != compilerFunctionReturnABIIndirect()) { return false }
        if intBufferElement(buffer: reachability.abiParticipants, index: functionRow) == 1
            && compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: functionRow)
            && intBufferElement(buffer: reachability.abiCapabilities, index: functionRow) != 1 { return false }
        functionRow: functionRow + 1
    }
    state edgeIndex: Int(0)
    while edgeIndex < intBufferCount(buffer: reachability.edgeTargets) {
        let ownerFunctionRow: Int(intBufferElement(buffer: reachability.edgeOwners, index: edgeIndex))
        let targetFunctionRow: Int(intBufferElement(buffer: reachability.edgeTargets, index: edgeIndex))
        if intBufferElement(buffer: reachability.abiReturnModes, index: targetFunctionRow) == compilerFunctionReturnABIIndirect()
            && intBufferElement(buffer: reachability.abiParticipants, index: ownerFunctionRow) != 1 { return false }
        if intBufferElement(buffer: reachability.abiParticipants, index: ownerFunctionRow) == 1
            && compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow)
            && intBufferElement(buffer: reachability.abiParticipants, index: targetFunctionRow) != 1 { return false }
        if intBufferElement(buffer: reachability.abiParticipants, index: targetFunctionRow) == 1
            && compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow)
            && intBufferElement(buffer: reachability.abiParticipants, index: ownerFunctionRow) != 1 { return false }
        edgeIndex: edgeIndex + 1
    }
    return true
}

function compilerReachableLLVMStateBuildABIComponents(reachability: CompilerReachableLLVMState): Int {
