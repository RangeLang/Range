                if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeConstruct() {
                    if intBufferSet(buffer: reachability.abiSensitiveFunctions, index: targetFunctionRow, value: 1) != 0 { status: 5 }
                }
