                }
                componentProbe: componentProbe - 1
            }
            state componentFinalize: Int(componentStart)
            while !componentRequiresRestart && componentFinalize < componentEnd {
                let finalizedMember: Int(intBufferElement(buffer: componentQueue, index: componentFinalize))
                state finalizedParticipant: Int(1)
                if componentBlocked { finalizedParticipant: 2 }
                if intBufferSet(buffer: reachability.abiParticipants, index: finalizedMember, value: finalizedParticipant) != 0 {
