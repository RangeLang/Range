    }
    return memoryReturnNodeID
}

function compilerMemoryOwnedRegionForNode(delta: CompilerGraphDelta, nodeID: Int): Int {
    return compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleStatement())
}

function compilerMemoryRegionContainsNode(delta: CompilerGraphDelta, regionNodeID: Int, nodeID: Int): Bool {
    if regionNodeID < 0 || nodeID < 0 { return false }
    if regionNodeID == nodeID { return true }
    state memoryContainmentNodeID: Int(nodeID)
    state memoryContainmentSteps: Int(0)
    let memoryContainmentLimit: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryContainmentNodeID >= 0 && memoryContainmentSteps < memoryContainmentLimit {
        state memoryContainmentParent: Int(0 - 1)
        state memoryContainmentFactRow: Int(0)
        let memoryContainmentFactCount: Int(compilerIntTableRowCount(table: delta.facts))
        while memoryContainmentFactRow < memoryContainmentFactCount && memoryContainmentParent < 0 {
            if compilerIntTableValue(table: delta.facts, row: memoryContainmentFactRow, column: 0) == compilerGraphFactOwns()
                && compilerIntTableValue(table: delta.facts, row: memoryContainmentFactRow, column: 2) == memoryContainmentNodeID {
                memoryContainmentParent: compilerIntTableValue(table: delta.facts, row: memoryContainmentFactRow, column: 1)
            }
            memoryContainmentFactRow: memoryContainmentFactRow + 1
        }
        if memoryContainmentParent == regionNodeID { return true }
        memoryContainmentNodeID: memoryContainmentParent
        memoryContainmentSteps: memoryContainmentSteps + 1
    }
    return false
}

function compilerMemoryRegionHasTerminalReturn(delta: CompilerGraphDelta, regionNodeID: Int): Bool {
    return compilerMemoryLastReturnInRegionNode(delta: delta, regionNodeID: regionNodeID) >= 0
