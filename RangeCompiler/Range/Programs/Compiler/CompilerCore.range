function compilerMemoryBuildAccessDecisions(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    state memoryAccessNodeID: Int(0)
    let memoryAccessNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryAccessNodeID < memoryAccessNodeCount {
        let memoryAccessNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: memoryAccessNodeID, column: 1))
        if memoryAccessNodeKind == compilerSyntaxKindMemberRead() {
            if compilerSemanticGraphParent(delta: delta, objectNodeID: memoryAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget()) < 0 {
                let memoryAccessReceiverNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: memoryAccessNodeID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0))
                if compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryAccessReceiverNodeID) == compilerSemanticResolutionLocal() {
                    let memoryAccessLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryAccessReceiverNodeID))
                    let memoryAccessStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: memoryAccessLocalNodeID))
                    if memoryAccessStorageID < 0 { return 0 - 1 }
                    let memoryAccessTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryAccessStorageID, column: 2))
                    if compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionAccess(), nodeID: memoryAccessNodeID, storageID: memoryAccessStorageID, typeNodeID: memoryAccessTypeNodeID, value: compilerMemoryAccessRead(), originNodeID: memoryAccessReceiverNodeID) != 0 { return 0 - 1 }
                }
            }
        } else if memoryAccessNodeKind == compilerSyntaxKindIdentifier() {
            if compilerSemanticGraphParent(delta: delta, objectNodeID: memoryAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget()) < 0
                && compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryAccessNodeID) == compilerSemanticResolutionLocal()
                && compilerIntTableValue(table: semantics.nodeTypes, row: memoryAccessNodeID, column: 1) == compilerSemanticTypeInt() {
                let memoryScalarLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryAccessNodeID))
                let memoryScalarStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: memoryScalarLocalNodeID))
                if memoryScalarStorageID < 0 { return 0 - 1 }
                let memoryScalarTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryScalarStorageID, column: 2))
                if compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionAccess(), nodeID: memoryAccessNodeID, storageID: memoryScalarStorageID, typeNodeID: memoryScalarTypeNodeID, value: compilerMemoryAccessRead(), originNodeID: memoryAccessNodeID) != 0 { return 0 - 1 }
            }
        } else if memoryAccessNodeKind == compilerSyntaxKindAssignment() {
            let memoryWriteTargetNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: memoryAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
            let memoryWriteEffectRow: Int(compilerSemanticAccessEffectRowForAssignment(semantics: semantics, assignmentNodeID: memoryAccessNodeID))
            state memoryWriteLocalNodeID: Int(0 - 1)
            if memoryWriteEffectRow >= 0 { memoryWriteLocalNodeID: compilerIntTableValue(table: semantics.accessEffects, row: memoryWriteEffectRow, column: 2) }
            let memoryWriteStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: memoryWriteLocalNodeID))
            if memoryWriteTargetNodeID < 0 || memoryWriteLocalNodeID < 0 || memoryWriteStorageID < 0
                || memoryWriteEffectRow < 0
                || compilerIntTableValue(table: semantics.accessEffects, row: memoryWriteEffectRow, column: 2) != memoryWriteLocalNodeID
                || compilerIntTableValue(table: semantics.accessEffects, row: memoryWriteEffectRow, column: 3) != compilerSemanticAccessWrite()
                || compilerIntTableValue(table: semantics.accessEffects, row: memoryWriteEffectRow, column: 4) != compilerSemanticAccessUnique()
                || compilerMemoryLocalStoragePolicy(tables: tables, localNodeID: memoryWriteLocalNodeID) != compilerMemoryStorageMutable() { return 0 - 1 }
            let memoryWriteTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryWriteStorageID, column: 2))
            if compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionAccess(), nodeID: memoryAccessNodeID, storageID: memoryWriteStorageID, typeNodeID: memoryWriteTypeNodeID, value: compilerMemoryAccessWriteUnique(), originNodeID: memoryWriteTargetNodeID) != 0 { return 0 - 1 }
        }
        memoryAccessNodeID: memoryAccessNodeID + 1
    }
    return 0
}

function compilerMemoryBindingAliasOwnerLocal(delta: CompilerGraphDelta, aliasNodeID: Int): Int {
    let aliasArgumentNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: aliasNodeID, roleTag: compilerSyntaxRoleArgumentValue()))
    let aliasApplicationNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: aliasArgumentNodeID, roleTag: compilerSyntaxRoleArgument()))
    return compilerSemanticGraphParent(delta: delta, objectNodeID: aliasApplicationNodeID, roleTag: compilerSyntaxRoleInitializer())
}

function compilerMemoryAssignmentUsesBindingAlias(delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, assignmentNodeID: Int, aliasNodeID: Int): Bool {
    let aliasArgumentNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: aliasNodeID, roleTag: compilerSyntaxRoleArgumentValue()))
    let aliasMemberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: aliasArgumentNodeID))
    let aliasOwnerLocalNodeID: Int(compilerMemoryBindingAliasOwnerLocal(delta: delta, aliasNodeID: aliasNodeID))
    let assignmentTargetNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: assignmentNodeID, roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
    if compilerIntTableValue(table: delta.nodes, row: assignmentTargetNodeID, column: 1) != compilerSyntaxKindMemberRead()
        || compilerSemanticResolutionTarget(semantics: semantics, useNodeID: assignmentTargetNodeID) != aliasMemberNodeID { return false }
    let assignmentReceiverNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: assignmentTargetNodeID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0))
    return compilerSemanticResolutionKind(semantics: semantics, useNodeID: assignmentReceiverNodeID) == compilerSemanticResolutionLocal()
        && compilerSemanticResolutionTarget(semantics: semantics, useNodeID: assignmentReceiverNodeID) == aliasOwnerLocalNodeID
}

function compilerMemoryBindingAliasIsUnique(delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, aliasNodeID: Int): Bool {
    state aliasAssignmentNodeID: Int(0)
    let aliasAssignmentNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while aliasAssignmentNodeID < aliasAssignmentNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: aliasAssignmentNodeID, column: 1) == compilerSyntaxKindAssignment()
            && compilerMemoryAssignmentUsesBindingAlias(delta: delta, semantics: semantics, assignmentNodeID: aliasAssignmentNodeID, aliasNodeID: aliasNodeID) { return true }
        aliasAssignmentNodeID: aliasAssignmentNodeID + 1
    }
    return false
}

function compilerMemoryBuildAliasDecisions(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    state aliasNodeID: Int(0)
    let aliasNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while aliasNodeID < aliasNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: aliasNodeID, column: 1) == compilerSyntaxKindBindingReference() {
            let aliasArgumentNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: aliasNodeID, roleTag: compilerSyntaxRoleArgumentValue()))
            if aliasArgumentNodeID >= 0 {
                let aliasMemberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: aliasArgumentNodeID))
                if aliasMemberNodeID >= 0 {
                    let aliasMemberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: aliasMemberNodeID, column: 1))
                    if compilerIntTableValue(table: tables.members, row: aliasMemberFacetRow, column: 12) == compilerSyntaxMemberKindBinding() {
                    let aliasLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: aliasNodeID))
                    let aliasStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: aliasLocalNodeID))
                    let aliasTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: aliasStorageID, column: 2))
                    state aliasAccessKind: Int(compilerMemoryAccessSharedAlias())
                    if compilerMemoryBindingAliasIsUnique(delta: delta, semantics: semantics, aliasNodeID: aliasNodeID) { aliasAccessKind: compilerMemoryAccessUniqueAlias() }
                    if aliasLocalNodeID < 0 || aliasStorageID < 0
                        || compilerIntTableValue(table: semantics.nodeTypes, row: aliasNodeID, column: 1) != compilerSemanticTypeConstruct()
                        || compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionAlias(), nodeID: aliasNodeID, storageID: aliasStorageID, typeNodeID: aliasTypeNodeID, value: aliasAccessKind, originNodeID: aliasMemberNodeID) != 0 { return 0 - 1 }
                    }
                }
            }
        }
        aliasNodeID: aliasNodeID + 1
    }
    if compilerMemoryAliasAccessesConflict(delta: delta, semantics: semantics, memory: memory) {
        compilerMemoryGraphPoison(memory: memory)
        return 0 - 1
    }
    return 0
}

function compilerMemoryAliasAccessesConflict(delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Bool {
    state aliasDecisionRow: Int(0)
    let decisionCount: Int(compilerIntTableRowCount(table: memory.decisions))
    while aliasDecisionRow < decisionCount {
        if compilerIntTableValue(table: memory.decisions, row: aliasDecisionRow, column: 0) == compilerMemoryDecisionAlias() {
            let aliasStorageID: Int(compilerIntTableValue(table: memory.decisions, row: aliasDecisionRow, column: 2))
            let aliasNodeID: Int(compilerIntTableValue(table: memory.decisions, row: aliasDecisionRow, column: 1))
            let aliasAccessKind: Int(compilerIntTableValue(table: memory.decisions, row: aliasDecisionRow, column: 4))
            state accessDecisionRow: Int(0)
            while accessDecisionRow < decisionCount {
                let candidateDecisionKind: Int(compilerIntTableValue(table: memory.decisions, row: accessDecisionRow, column: 0))
                if accessDecisionRow != aliasDecisionRow
                    && candidateDecisionKind == compilerMemoryDecisionAlias()
                    && compilerIntTableValue(table: memory.decisions, row: accessDecisionRow, column: 2) == aliasStorageID
                    && (aliasAccessKind == compilerMemoryAccessUniqueAlias()
                        || compilerIntTableValue(table: memory.decisions, row: accessDecisionRow, column: 4) == compilerMemoryAccessUniqueAlias()) { return true }
                if candidateDecisionKind == compilerMemoryDecisionAccess()
                    && compilerIntTableValue(table: memory.decisions, row: accessDecisionRow, column: 2) == aliasStorageID
                    && compilerIntTableValue(table: memory.decisions, row: accessDecisionRow, column: 4) == compilerMemoryAccessWriteUnique() {
                    let accessAssignmentNodeID: Int(compilerIntTableValue(table: memory.decisions, row: accessDecisionRow, column: 1))
                    if aliasAccessKind == compilerMemoryAccessSharedAlias()
                        || !compilerMemoryAssignmentUsesBindingAlias(delta: delta, semantics: semantics, assignmentNodeID: accessAssignmentNodeID, aliasNodeID: aliasNodeID) { return true }
                }
                accessDecisionRow: accessDecisionRow + 1
            }
        }
        aliasDecisionRow: aliasDecisionRow + 1
    }
    return false
}

function compilerMemoryBuildStoragePolicyDecisions(tables: CompilerSyntaxTables, memory: CompilerMemoryGraph): Int {
    state memoryPolicyStorageRow: Int(0)
    let memoryPolicyStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    while memoryPolicyStorageRow < memoryPolicyStorageCount {
        let memoryPolicyStorageID: Int(compilerIntTableValue(table: memory.storages, row: memoryPolicyStorageRow, column: 0))
        let memoryPolicyLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryPolicyStorageRow, column: 1))
        let memoryPolicyTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryPolicyStorageRow, column: 2))
        let memoryPolicyValue: Int(compilerMemoryLocalStoragePolicy(tables: tables, localNodeID: memoryPolicyLocalNodeID))
        if memoryPolicyValue < 0
            || compilerMemoryAppendDecision(memory: memory, decisionKind: compilerMemoryDecisionStoragePolicy(), nodeID: memoryPolicyLocalNodeID, storageID: memoryPolicyStorageID, typeNodeID: memoryPolicyTypeNodeID, value: memoryPolicyValue, originNodeID: memoryPolicyLocalNodeID) != 0 { return 0 - 1 }
        memoryPolicyStorageRow: memoryPolicyStorageRow + 1
    }
    return 0
}

function compilerMemoryBuild(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    if !compilerSemanticGraphIsValid(tables: tables, delta: delta, semantics: semantics) {
        compilerMemoryGraphPoison(memory: memory)
        return 0 - 1
    }
    if compilerMemoryBuildLayouts(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildStorages(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildLayoutDecisions(memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildPlacementDecisions(memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildInitializeDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildBorrowDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildEscapeDecisions(memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildPassDecisions(tables: tables, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildDestroyDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildTransferDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildReturnModeDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildAccessDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory) != 0 { return 0 - 1 }
    if compilerMemoryBuildStoragePolicyDecisions(tables: tables, memory: memory) != 0 { return 0 - 1 }
    return compilerMemoryBuildAliasDecisions(tables: tables, delta: delta, semantics: semantics, memory: memory)
}

function compilerMemoryDecisionCount(memory: CompilerMemoryGraph, decisionKind: Int): Int {
    state memoryDecisionCountRow: Int(0)
    state memoryDecisionKindCount: Int(0)
    let memoryDecisionRowCount: Int(compilerIntTableRowCount(table: memory.decisions))
    while memoryDecisionCountRow < memoryDecisionRowCount {
        if compilerIntTableValue(table: memory.decisions, row: memoryDecisionCountRow, column: 0) == decisionKind {
            memoryDecisionKindCount: memoryDecisionKindCount + 1
        }
        memoryDecisionCountRow: memoryDecisionCountRow + 1
    }
    return memoryDecisionKindCount
}

function compilerMemoryExpectedDestroyCount(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    state memoryExpectedDestroyCount: Int(0)
    state memoryExpectedExitNodeID: Int(0)
    let memoryExpectedExitNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    let memoryExpectedStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    while memoryExpectedExitNodeID < memoryExpectedExitNodeCount {
        state memoryExpectedStorageRow: Int(0)
        while memoryExpectedStorageRow < memoryExpectedStorageCount {
            let memoryExpectedLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryExpectedStorageRow, column: 1))
            let memoryExpectedTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryExpectedStorageRow, column: 2))
            let memoryExpectedRegionNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryExpectedStorageRow, column: 3))
            state memoryExpectedDestroyApplies: Bool(false)
            if compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryExpectedTypeNodeID) == compilerRuntimeABIOpaqueIntBuffer() {
                memoryExpectedDestroyApplies: compilerMemoryOpaqueDestroyApplicationForLocal(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryExpectedLocalNodeID) == memoryExpectedExitNodeID
            } else {
                memoryExpectedDestroyApplies: compilerMemoryRegionHasExit(delta: delta, regionNodeID: memoryExpectedRegionNodeID, exitNodeID: memoryExpectedExitNodeID)
                    && compilerMemoryExitAppliesToLocal(tables: tables, delta: delta, localNodeID: memoryExpectedLocalNodeID, exitNodeID: memoryExpectedExitNodeID)
            }
            if memoryExpectedDestroyApplies {
                memoryExpectedDestroyCount: memoryExpectedDestroyCount + 1
            }
            memoryExpectedStorageRow: memoryExpectedStorageRow + 1
        }
        memoryExpectedExitNodeID: memoryExpectedExitNodeID + 1
    }
    return memoryExpectedDestroyCount
}

function compilerMemoryConstructParameterCount(tables: CompilerSyntaxTables, semantics: CompilerSemanticGraph): Int {
    state memoryConstructParameterRow: Int(0)
    state memoryConstructParameterCount: Int(0)
    let memoryConstructEffectCount: Int(compilerIntTableRowCount(table: semantics.parameterEffects))
    while memoryConstructParameterRow < memoryConstructEffectCount {
        let memoryConstructParameterNodeID: Int(compilerIntTableValue(table: semantics.parameterEffects, row: memoryConstructParameterRow, column: 1))
        let memoryConstructFunctionNodeID: Int(compilerIntTableValue(table: semantics.parameterEffects, row: memoryConstructParameterRow, column: 0))
        if compilerIntTableValue(table: semantics.nodeTypes, row: memoryConstructParameterNodeID, column: 1) == compilerSemanticTypeConstruct()
            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: memoryConstructFunctionNodeID) == compilerRuntimeABIFunctionNone() {
            memoryConstructParameterCount: memoryConstructParameterCount + 1
        }
        memoryConstructParameterRow: memoryConstructParameterRow + 1
    }
    return memoryConstructParameterCount
}

function compilerMemoryBorrowCount(tables: CompilerSyntaxTables, semantics: CompilerSemanticGraph): Int {
    state memoryBorrowCountRow: Int(0)
    state memoryBorrowCountValue: Int(0)
    let memoryBorrowCountRows: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while memoryBorrowCountRow < memoryBorrowCountRows {
        let memoryBorrowCountUseNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: memoryBorrowCountRow, column: 0))
        let memoryBorrowCountTargetNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: memoryBorrowCountRow, column: 1))
        if compilerIntTableValue(table: semantics.resolutions, row: memoryBorrowCountRow, column: 2) == compilerSemanticResolutionArgumentParameter()
            && compilerIntTableValue(table: semantics.nodeTypes, row: memoryBorrowCountTargetNodeID, column: 1) == compilerSemanticTypeConstruct()
            && memoryBorrowCountUseNodeID >= 0 {
            let memoryBorrowEffectRow: Int(compilerMemoryEffectRowForParameter(semantics: semantics, parameterNodeID: memoryBorrowCountTargetNodeID))
            if memoryBorrowEffectRow >= 0
                && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: compilerIntTableValue(table: semantics.parameterEffects, row: memoryBorrowEffectRow, column: 0)) != compilerRuntimeABIFunctionDestroy() {
                memoryBorrowCountValue: memoryBorrowCountValue + 1
            }
        }
        memoryBorrowCountRow: memoryBorrowCountRow + 1
    }
    return memoryBorrowCountValue
}

function compilerMemoryReturnedConstructFunctionCount(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state memoryReturnedFunctionNodeID: Int(0)
    state memoryReturnedFunctionCount: Int(0)
    let memoryReturnedFunctionNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryReturnedFunctionNodeID < memoryReturnedFunctionNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: memoryReturnedFunctionNodeID, column: 1) == compilerSyntaxKindFunction()
            && compilerIntTableValue(table: semantics.nodeTypes, row: memoryReturnedFunctionNodeID, column: 1) == compilerSemanticTypeConstruct()
            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: memoryReturnedFunctionNodeID) == compilerRuntimeABIFunctionNone() {
            memoryReturnedFunctionCount: memoryReturnedFunctionCount + 1
        }
        memoryReturnedFunctionNodeID: memoryReturnedFunctionNodeID + 1
    }
    return memoryReturnedFunctionCount
}

function compilerMemoryReturnedConstructCallCount(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state memoryReturnedCallNodeID: Int(0)
    state memoryReturnedCallCount: Int(0)
    let memoryReturnedCallNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryReturnedCallNodeID < memoryReturnedCallNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: memoryReturnedCallNodeID, column: 1) == compilerSyntaxKindApplication()
            && compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryReturnedCallNodeID) == compilerSemanticResolutionFunction()
            && compilerIntTableValue(table: semantics.nodeTypes, row: memoryReturnedCallNodeID, column: 1) == compilerSemanticTypeConstruct()
            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryReturnedCallNodeID)) == compilerRuntimeABIFunctionNone() {
            memoryReturnedCallCount: memoryReturnedCallCount + 1
        }
        memoryReturnedCallNodeID: memoryReturnedCallNodeID + 1
    }
    return memoryReturnedCallCount
}

function compilerMemoryLocalMemberAccessCount(delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state memoryLocalAccessNodeID: Int(0)
    state memoryLocalAccessCount: Int(0)
    let memoryLocalAccessNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryLocalAccessNodeID < memoryLocalAccessNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: memoryLocalAccessNodeID, column: 1) == compilerSyntaxKindMemberRead() {
            if compilerSemanticGraphParent(delta: delta, objectNodeID: memoryLocalAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget()) < 0 {
                let memoryLocalAccessReceiverNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: memoryLocalAccessNodeID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0))
                if compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryLocalAccessReceiverNodeID) == compilerSemanticResolutionLocal() {
                    memoryLocalAccessCount: memoryLocalAccessCount + 1
                }
            }
        } else if compilerIntTableValue(table: delta.nodes, row: memoryLocalAccessNodeID, column: 1) == compilerSyntaxKindIdentifier() {
            if compilerSemanticGraphParent(delta: delta, objectNodeID: memoryLocalAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget()) < 0
                && compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryLocalAccessNodeID) == compilerSemanticResolutionLocal()
                && compilerIntTableValue(table: semantics.nodeTypes, row: memoryLocalAccessNodeID, column: 1) == compilerSemanticTypeInt() {
                memoryLocalAccessCount: memoryLocalAccessCount + 1
            }
        } else if compilerIntTableValue(table: delta.nodes, row: memoryLocalAccessNodeID, column: 1) == compilerSyntaxKindAssignment() {
            memoryLocalAccessCount: memoryLocalAccessCount + 1
        }
        memoryLocalAccessNodeID: memoryLocalAccessNodeID + 1
    }
    return memoryLocalAccessCount
}

function compilerMemoryBindingAliasCount(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state aliasNodeID: Int(0)
    state aliasCount: Int(0)
    let nodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while aliasNodeID < nodeCount {
        if compilerIntTableValue(table: delta.nodes, row: aliasNodeID, column: 1) == compilerSyntaxKindBindingReference() {
            let argumentValueNodeID: Int(aliasNodeID)
            let argumentNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: argumentValueNodeID, roleTag: compilerSyntaxRoleArgumentValue()))
            if argumentNodeID >= 0 {
                let memberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: argumentNodeID))
                if memberNodeID >= 0 {
                    let memberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: memberNodeID, column: 1))
                    if compilerIntTableValue(table: tables.members, row: memberFacetRow, column: 12) == compilerSyntaxMemberKindBinding() { aliasCount: aliasCount + 1 }
                }
            }
        }
        aliasNodeID: aliasNodeID + 1
    }
    return aliasCount
}

function compilerMemoryGraphIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Bool {
    if intBufferCount(buffer: memory.failures) != 0
        || !compilerIntTableIsComplete(table: memory.layouts)
        || !compilerIntTableIsComplete(table: memory.storages)
        || !compilerIntTableIsComplete(table: memory.decisions) { return false }
    let memoryLayoutCount: Int(compilerIntTableRowCount(table: memory.layouts))
    let memoryStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    let memoryConstructParameterCount: Int(compilerMemoryConstructParameterCount(tables: tables, semantics: semantics))
    let memoryExpectedBorrowCount: Int(compilerMemoryBorrowCount(tables: tables, semantics: semantics))
    let memoryReturnedFunctionCount: Int(compilerMemoryReturnedConstructFunctionCount(tables: tables, delta: delta, semantics: semantics))
    let memoryReturnedCallCount: Int(compilerMemoryReturnedConstructCallCount(tables: tables, delta: delta, semantics: semantics))
    let memoryExpectedAccessCount: Int(compilerMemoryLocalMemberAccessCount(delta: delta, semantics: semantics))
    let memoryExpectedAliasCount: Int(compilerMemoryBindingAliasCount(tables: tables, delta: delta, semantics: semantics))
    if compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionLayout()) != memoryLayoutCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionPlacement()) != memoryStorageCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionInitialize()) != memoryStorageCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionBorrow()) != memoryExpectedBorrowCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionEscape()) != memoryStorageCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionPassMode()) != memoryConstructParameterCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionDestroy()) != compilerMemoryExpectedDestroyCount(tables: tables, delta: delta, semantics: semantics, memory: memory)
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionTransfer()) != memoryReturnedCallCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionReturnMode()) != memoryReturnedFunctionCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionAccess()) != memoryExpectedAccessCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionAlias()) != memoryExpectedAliasCount
        || compilerMemoryDecisionCount(memory: memory, decisionKind: compilerMemoryDecisionStoragePolicy()) != memoryStorageCount { return false }

    state memoryValidationLayoutRow: Int(0)
    state memoryPreviousLayoutType: Int(0 - 1)
    while memoryValidationLayoutRow < memoryLayoutCount {
        let memoryValidationTypeNodeID: Int(compilerIntTableValue(table: memory.layouts, row: memoryValidationLayoutRow, column: 0))
        let memoryValidationFieldCount: Int(compilerIntTableValue(table: memory.layouts, row: memoryValidationLayoutRow, column: 1))
        if memoryValidationTypeNodeID <= memoryPreviousLayoutType
            || compilerIntTableValue(table: delta.nodes, row: memoryValidationTypeNodeID, column: 1) != compilerSyntaxKindConstruct()
            || memoryValidationFieldCount <= 0
            || compilerIntTableValue(table: memory.layouts, row: memoryValidationLayoutRow, column: 2) != memoryValidationFieldCount * 4
            || compilerIntTableValue(table: memory.layouts, row: memoryValidationLayoutRow, column: 3) != 4 { return false }
        memoryPreviousLayoutType: memoryValidationTypeNodeID
        memoryValidationLayoutRow: memoryValidationLayoutRow + 1
    }

    state memoryValidationStorageRow: Int(0)
    while memoryValidationStorageRow < memoryStorageCount {
        let memoryValidationStorageID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationStorageRow, column: 0))
        let memoryValidationLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationStorageRow, column: 1))
        let memoryValidationStorageTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationStorageRow, column: 2))
        let memoryValidationRegionNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationStorageRow, column: 3))
        let memoryValidationStorageTypeKind: Int(compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationLocalNodeID, column: 1))
        if memoryValidationStorageID != memoryValidationStorageRow
            || compilerIntTableValue(table: delta.nodes, row: memoryValidationLocalNodeID, column: 1) != compilerSyntaxKindLocalBinding()
            || (compilerIntTableValue(table: delta.nodes, row: memoryValidationRegionNodeID, column: 1) != compilerSyntaxKindEntry()
                && compilerIntTableValue(table: delta.nodes, row: memoryValidationRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion())
            || compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationLocalNodeID, column: 2) != memoryValidationStorageTypeNodeID
            || (memoryValidationStorageTypeKind == compilerSemanticTypeConstruct()
                && compilerMemoryLayoutRowForType(memory: memory, typeNodeID: memoryValidationStorageTypeNodeID) < 0
                && compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryValidationStorageTypeNodeID) != compilerRuntimeABIOpaqueIntBuffer())
            || (memoryValidationStorageTypeKind == compilerSemanticTypeInt() && memoryValidationStorageTypeNodeID != 0 - 1)
            || (memoryValidationStorageTypeKind != compilerSemanticTypeConstruct() && memoryValidationStorageTypeKind != compilerSemanticTypeInt())
            || compilerIntTableValue(table: memory.storages, row: memoryValidationStorageRow, column: 4) != compilerMemoryPlacementLocal()
            || compilerIntTableValue(table: memory.storages, row: memoryValidationStorageRow, column: 5) != 0 { return false }
        memoryValidationStorageRow: memoryValidationStorageRow + 1
    }

    state memoryValidationDecisionRow: Int(0)
    state memoryPreviousDecisionKind: Int(0)
    state memoryPreviousDecisionNodeID: Int(0 - 1)
    state memoryPreviousDecisionStorageID: Int(0 - 1)
    state memoryPreviousDecisionTypeNodeID: Int(0 - 1)
    let memoryValidationDecisionCount: Int(compilerIntTableRowCount(table: memory.decisions))
    while memoryValidationDecisionRow < memoryValidationDecisionCount {
        let memoryValidationDecisionKind: Int(compilerIntTableValue(table: memory.decisions, row: memoryValidationDecisionRow, column: 0))
        let memoryValidationDecisionNodeID: Int(compilerIntTableValue(table: memory.decisions, row: memoryValidationDecisionRow, column: 1))
        let memoryValidationDecisionStorageID: Int(compilerIntTableValue(table: memory.decisions, row: memoryValidationDecisionRow, column: 2))
        let memoryValidationDecisionTypeNodeID: Int(compilerIntTableValue(table: memory.decisions, row: memoryValidationDecisionRow, column: 3))
        let memoryValidationDecisionOriginNodeID: Int(compilerIntTableValue(table: memory.decisions, row: memoryValidationDecisionRow, column: 5))
        if memoryValidationDecisionKind < memoryPreviousDecisionKind
            || memoryValidationDecisionNodeID < 0 || memoryValidationDecisionNodeID >= compilerIntTableRowCount(table: delta.nodes)
            || memoryValidationDecisionOriginNodeID < 0 || memoryValidationDecisionOriginNodeID >= compilerIntTableRowCount(table: delta.nodes) { return false }
        if memoryValidationDecisionKind == memoryPreviousDecisionKind
            && (memoryValidationDecisionNodeID < memoryPreviousDecisionNodeID
                || (memoryValidationDecisionNodeID == memoryPreviousDecisionNodeID && memoryValidationDecisionStorageID < memoryPreviousDecisionStorageID)
                || (memoryValidationDecisionNodeID == memoryPreviousDecisionNodeID && memoryValidationDecisionStorageID == memoryPreviousDecisionStorageID && memoryValidationDecisionTypeNodeID <= memoryPreviousDecisionTypeNodeID)) { return false }
        if memoryValidationDecisionStorageID < 0 - 1 || memoryValidationDecisionStorageID >= memoryStorageCount { return false }
        if memoryValidationDecisionKind != compilerMemoryDecisionLayout() && memoryValidationDecisionKind != compilerMemoryDecisionPassMode() && memoryValidationDecisionKind != compilerMemoryDecisionReturnMode()
            && memoryValidationDecisionStorageID < 0 { return false }
        if (memoryValidationDecisionKind == compilerMemoryDecisionLayout() || memoryValidationDecisionKind == compilerMemoryDecisionPassMode() || memoryValidationDecisionKind == compilerMemoryDecisionReturnMode())
            && memoryValidationDecisionStorageID != 0 - 1 { return false }
        let memoryValidationDecisionValue: Int(compilerIntTableValue(table: memory.decisions, row: memoryValidationDecisionRow, column: 4))
        if memoryValidationDecisionKind == compilerMemoryDecisionLayout()
            && (compilerMemoryLayoutRowForType(memory: memory, typeNodeID: memoryValidationDecisionTypeNodeID) < 0
                || memoryValidationDecisionValue != compilerIntTableValue(table: memory.layouts, row: compilerMemoryLayoutRowForType(memory: memory, typeNodeID: memoryValidationDecisionTypeNodeID), column: 2)) { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionPlacement() && memoryValidationDecisionValue != compilerMemoryPlacementLocal() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionInitialize() && memoryValidationDecisionValue != 1 { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionBorrow() && memoryValidationDecisionValue != compilerMemoryBorrowShared() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionEscape() && memoryValidationDecisionValue != 0 { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionPassMode() && memoryValidationDecisionValue != compilerMemoryPassByValue() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionDestroy() && memoryValidationDecisionValue != 1 { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionTransfer() && memoryValidationDecisionValue != compilerMemoryTransferOwnership() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionReturnMode() && memoryValidationDecisionValue != compilerMemoryReturnAggregateValue() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionAccess()
            && memoryValidationDecisionValue != compilerMemoryAccessRead()
            && memoryValidationDecisionValue != compilerMemoryAccessWriteUnique() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionAlias()
            && memoryValidationDecisionValue != compilerMemoryAccessSharedAlias()
            && memoryValidationDecisionValue != compilerMemoryAccessUniqueAlias() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionStoragePolicy()
            && memoryValidationDecisionValue != compilerMemoryStorageImmutable()
            && memoryValidationDecisionValue != compilerMemoryStorageMutable() { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionLayout()
            && (memoryValidationDecisionNodeID != memoryValidationDecisionTypeNodeID || memoryValidationDecisionOriginNodeID != memoryValidationDecisionTypeNodeID) { return false }
        if memoryValidationDecisionKind == compilerMemoryDecisionPassMode() {
            let memoryValidationPassEffectRow: Int(compilerMemoryEffectRowForParameter(semantics: semantics, parameterNodeID: memoryValidationDecisionNodeID))
            if memoryValidationPassEffectRow < 0
                || compilerIntTableValue(table: semantics.parameterEffects, row: memoryValidationPassEffectRow, column: 0) != memoryValidationDecisionOriginNodeID
                || compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationDecisionNodeID, column: 2) != memoryValidationDecisionTypeNodeID { return false }
        }
        if memoryValidationDecisionKind == compilerMemoryDecisionReturnMode() {
            if compilerIntTableValue(table: delta.nodes, row: memoryValidationDecisionNodeID, column: 1) != compilerSyntaxKindFunction()
                || compilerMemoryFunctionReturnNode(delta: delta, functionNodeID: memoryValidationDecisionNodeID) != memoryValidationDecisionOriginNodeID
                || compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationDecisionNodeID, column: 2) != memoryValidationDecisionTypeNodeID { return false }
        }
        if memoryValidationDecisionStorageID >= 0 {
            let memoryValidationDecisionLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationDecisionStorageID, column: 1))
            let memoryValidationDecisionStorageTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationDecisionStorageID, column: 2))
            let memoryValidationDecisionRegionNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryValidationDecisionStorageID, column: 3))
            if memoryValidationDecisionTypeNodeID != memoryValidationDecisionStorageTypeNodeID { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionPlacement()
                && (memoryValidationDecisionNodeID != memoryValidationDecisionLocalNodeID || memoryValidationDecisionOriginNodeID != memoryValidationDecisionRegionNodeID) { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionInitialize()
                && (memoryValidationDecisionOriginNodeID != memoryValidationDecisionLocalNodeID
                    || compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationDecisionNodeID, column: 1) != compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationDecisionLocalNodeID, column: 1)
                    || compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationDecisionNodeID, column: 2) != memoryValidationDecisionTypeNodeID) { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionInitialize()
                && compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryValidationDecisionTypeNodeID) == compilerRuntimeABIOpaqueIntBuffer()
                && (compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryValidationDecisionNodeID) != compilerSemanticResolutionFunction()
                    || compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryValidationDecisionNodeID)) != compilerRuntimeABIFunctionCreate()) { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionBorrow()
                && compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryValidationDecisionOriginNodeID) != memoryValidationDecisionLocalNodeID { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionEscape()
                && (memoryValidationDecisionNodeID != memoryValidationDecisionLocalNodeID || memoryValidationDecisionOriginNodeID != memoryValidationDecisionLocalNodeID) { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionDestroy()
                && memoryValidationDecisionOriginNodeID != memoryValidationDecisionLocalNodeID { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionDestroy() {
                if compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryValidationDecisionStorageTypeNodeID) == compilerRuntimeABIOpaqueIntBuffer() {
                    if compilerMemoryOpaqueDestroyApplicationForLocal(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryValidationDecisionLocalNodeID) != memoryValidationDecisionNodeID
                        || compilerMemoryOpaqueHandleHasUseAfterDestroy(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryValidationDecisionLocalNodeID, destroyNodeID: memoryValidationDecisionNodeID) { return false }
                } else if !compilerMemoryRegionHasExit(delta: delta, regionNodeID: memoryValidationDecisionRegionNodeID, exitNodeID: memoryValidationDecisionNodeID)
                    || !compilerMemoryExitAppliesToLocal(tables: tables, delta: delta, localNodeID: memoryValidationDecisionLocalNodeID, exitNodeID: memoryValidationDecisionNodeID) { return false }
                if !compilerMemoryDestroyFollowsUses(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryValidationDecisionLocalNodeID, destroyNodeID: memoryValidationDecisionNodeID) { return false }
            }
            if memoryValidationDecisionKind == compilerMemoryDecisionTransfer()
                && (compilerIntTableValue(table: delta.nodes, row: memoryValidationDecisionNodeID, column: 1) != compilerSyntaxKindApplication()
                    || compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryValidationDecisionNodeID) != compilerSemanticResolutionFunction()
                    || compilerSemanticGraphChild(delta: delta, subjectNodeID: compilerMemoryFunctionReturnNode(delta: delta, functionNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryValidationDecisionNodeID)), roleTag: compilerSyntaxRoleReturnValue(), ordinal: 0) != memoryValidationDecisionOriginNodeID) { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionAccess() {
                let memoryValidationAccessNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: memoryValidationDecisionNodeID, column: 1))
                if memoryValidationAccessNodeKind == compilerSyntaxKindMemberRead() {
                    if memoryValidationDecisionValue != compilerMemoryAccessRead()
                        || compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryValidationDecisionOriginNodeID) != memoryValidationDecisionLocalNodeID { return false }
                } else if memoryValidationAccessNodeKind == compilerSyntaxKindIdentifier() {
                    if memoryValidationDecisionValue != compilerMemoryAccessRead()
                        || memoryValidationDecisionOriginNodeID != memoryValidationDecisionNodeID
                        || compilerSemanticResolutionKind(semantics: semantics, useNodeID: memoryValidationDecisionNodeID) != compilerSemanticResolutionLocal()
                        || compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryValidationDecisionNodeID) != memoryValidationDecisionLocalNodeID
                        || compilerIntTableValue(table: semantics.nodeTypes, row: memoryValidationDecisionNodeID, column: 1) != compilerSemanticTypeInt() { return false }
                } else if memoryValidationAccessNodeKind == compilerSyntaxKindAssignment() {
                    let memoryValidationWriteEffectRow: Int(compilerSemanticAccessEffectRowForAssignment(semantics: semantics, assignmentNodeID: memoryValidationDecisionNodeID))
                    if memoryValidationDecisionValue != compilerMemoryAccessWriteUnique()
                        || memoryValidationWriteEffectRow < 0
                        || compilerIntTableValue(table: semantics.accessEffects, row: memoryValidationWriteEffectRow, column: 1) != memoryValidationDecisionOriginNodeID
                        || compilerIntTableValue(table: semantics.accessEffects, row: memoryValidationWriteEffectRow, column: 2) != memoryValidationDecisionLocalNodeID
                        || compilerMemoryLocalStoragePolicy(tables: tables, localNodeID: memoryValidationDecisionLocalNodeID) != compilerMemoryStorageMutable() { return false }
                } else { return false }
            }
            if memoryValidationDecisionKind == compilerMemoryDecisionStoragePolicy()
                && (memoryValidationDecisionNodeID != memoryValidationDecisionLocalNodeID
                    || memoryValidationDecisionOriginNodeID != memoryValidationDecisionLocalNodeID
                    || memoryValidationDecisionValue != compilerMemoryLocalStoragePolicy(tables: tables, localNodeID: memoryValidationDecisionLocalNodeID)) { return false }
            if memoryValidationDecisionKind == compilerMemoryDecisionAlias() {
                if compilerIntTableValue(table: delta.nodes, row: memoryValidationDecisionNodeID, column: 1) != compilerSyntaxKindBindingReference()
                    || compilerIntTableValue(table: delta.nodes, row: memoryValidationDecisionOriginNodeID, column: 1) != compilerSyntaxKindMember()
                    || (memoryValidationDecisionValue == compilerMemoryAccessUniqueAlias()) != compilerMemoryBindingAliasIsUnique(delta: delta, semantics: semantics, aliasNodeID: memoryValidationDecisionNodeID) { return false }
            }
        }
        memoryPreviousDecisionKind: memoryValidationDecisionKind
        memoryPreviousDecisionNodeID: memoryValidationDecisionNodeID
        memoryPreviousDecisionStorageID: memoryValidationDecisionStorageID
        memoryPreviousDecisionTypeNodeID: memoryValidationDecisionTypeNodeID
        memoryValidationDecisionRow: memoryValidationDecisionRow + 1
    }
    return true
}

function compilerMemoryRenderSnapshot(memory: CompilerMemoryGraph): String {
    let memoryTab: String(compilerCoreTabCharacter())
    let memoryNewline: String(compilerCoreNewlineCharacter())
    let memoryLayouts: String(compilerTypedSyntaxRenderRawTable(name: String("memoryLayout"), table: memory.layouts))
    let memoryStorages: String(compilerTypedSyntaxRenderRawTable(name: String("memoryStorage"), table: memory.storages))
    let memoryDecisions: String(compilerTypedSyntaxRenderRawTable(name: String("memoryDecision"), table: memory.decisions))
    return "memoryGraph\(memoryTab)valid=true\(memoryTab)layoutCount=\(compilerIntTableRowCount(table: memory.layouts))\(memoryTab)storageCount=\(compilerIntTableRowCount(table: memory.storages))\(memoryTab)decisionCount=\(compilerIntTableRowCount(table: memory.decisions))\(memoryNewline)\(memoryLayouts)\(memoryStorages)\(memoryDecisions)"
}

function compilerMemorySummary(source: String): String {
    let memoryTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let memoryCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: memoryTables))
    let memoryDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let memorySemantics: CompilerSemanticGraph(compilerSemanticGraphCreate())
    let memoryGraph: CompilerMemoryGraph(compilerMemoryGraphCreate())
    state memorySummary: String("")
    if memoryCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: memoryTables) {
        memorySummary: compilerNativeDiagnostic(kind: String("invalidTypedSyntaxSnapshot"))
    } else if compilerPlotterBuild(tables: memoryTables, delta: memoryDelta) != 0 || !compilerGraphDeltaIsValid(tables: memoryTables, delta: memoryDelta) {
        memorySummary: compilerNativeDiagnostic(kind: String("invalidGraphDelta"))
    } else if compilerSemanticBuild(tables: memoryTables, delta: memoryDelta, semantics: memorySemantics) != 0 || !compilerSemanticGraphIsValid(tables: memoryTables, delta: memoryDelta, semantics: memorySemantics) {
        memorySummary: compilerNativeDiagnostic(kind: String("invalidSemanticGraph"))
    } else if compilerMemoryBuild(tables: memoryTables, delta: memoryDelta, semantics: memorySemantics, memory: memoryGraph) != 0 || !compilerMemoryGraphIsValid(tables: memoryTables, delta: memoryDelta, semantics: memorySemantics, memory: memoryGraph) {
        memorySummary: compilerNativeDiagnostic(kind: String("invalidMemoryGraph"))
    } else {
        memorySummary: compilerMemoryRenderSnapshot(memory: memoryGraph)
    }
    let memoryGraphDestroyStatus: Int(compilerMemoryGraphDestroy(memory: memoryGraph))
    let memorySemanticsDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: memorySemantics))
    let memoryDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: memoryDelta))
    let memoryTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: memoryTables))
    if memoryGraphDestroyStatus != 0 || memorySemanticsDestroyStatus != 0 || memoryDeltaDestroyStatus != 0 || memoryTablesDestroyStatus != 0 {
        return compilerNativeDiagnostic(kind: String("memoryOwnershipFailure"))
    }
    return memorySummary
}

function compilerTypedIRFunctionColumnCount(): Int { return 7 }
function compilerTypedIROperationColumnCount(): Int { return 8 }
function compilerTypedIROperationConstruct(): Int { return 1 }
function compilerTypedIROperationMemberRead(): Int { return 2 }
function compilerTypedIROperationAddition(): Int { return 3 }
function compilerTypedIROperationCall(): Int { return 4 }
function compilerTypedIROperationReturn(): Int { return 5 }
function compilerTypedIROperationDestroy(): Int { return 6 }
function compilerTypedIROperationLocal(): Int { return 7 }
function compilerTypedIROperationInteger(): Int { return 8 }
function compilerTypedIROperationInsertField(): Int { return 9 }
function compilerTypedIROperationNoEscape(): Int { return 10 }
function compilerTypedIROperationConstructValue(): Int { return 11 }
function compilerTypedIROperationTransfer(): Int { return 12 }
function compilerTypedIROperationCallReceive(): Int { return 13 }
function compilerTypedIROperationStoragePolicy(): Int { return 14 }
function compilerTypedIROperationStore(): Int { return 15 }

function compilerTypedIRCreate(): CompilerTypedIR {
    return CompilerTypedIR(
        functions: compilerIntTableCreate(columnCount: compilerTypedIRFunctionColumnCount(), estimatedRowCount: 16),
        operations: compilerIntTableCreate(columnCount: compilerTypedIROperationColumnCount(), estimatedRowCount: 64),
        failures: intBufferCreate(capacity: 1)
    )
}

function compilerTypedIRDestroy(ir: CompilerTypedIR): Int {
    state typedIRDestroyStatus: Int(0)
    if compilerIntTableDestroy(table: ir.functions) != 0 { typedIRDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: ir.operations) != 0 { typedIRDestroyStatus: 0 - 1 }
    if intBufferDestroy(buffer: ir.failures) != 0 { typedIRDestroyStatus: 0 - 1 }
    return typedIRDestroyStatus
}

function compilerTypedIRPoison(ir: CompilerTypedIR): Int {
    return intBufferAppend(buffer: ir.failures, value: 1)
}

function compilerTypedIRAppend(ir: CompilerTypedIR, table: CompilerIntTable, value: Int): Int {
    let typedIRAppendStatus: Int(compilerIntTableAppend(table: table, value: value))
    if typedIRAppendStatus != 0 { compilerTypedIRPoison(ir: ir) }
    return typedIRAppendStatus
}

function compilerTypedIRAppendFunction(ir: CompilerTypedIR, ownerNodeID: Int, identityFirst: Int, identitySecond: Int, parameterNodeID: Int, typeNodeID: Int, memoryDecisionRow: Int, isEntry: Int): Int {
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: ownerNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: identityFirst) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: identitySecond) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: parameterNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: memoryDecisionRow) != 0 { return 0 - 1 }
    return compilerTypedIRAppend(ir: ir, table: ir.functions, value: isEntry)
}

function compilerTypedIRAppendOperation(ir: CompilerTypedIR, nodeID: Int, regionNodeID: Int, operationKind: Int, typeNodeID: Int, storageID: Int, first: Int, second: Int, memoryDecisionRow: Int): Int {
    if nodeID < 0 || regionNodeID < 0 || operationKind < compilerTypedIROperationConstruct() || operationKind > compilerTypedIROperationStore() {
        compilerTypedIRPoison(ir: ir)
        return 0 - 1
    }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: nodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: regionNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: operationKind) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: storageID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: first) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: second) != 0 { return 0 - 1 }
    return compilerTypedIRAppend(ir: ir, table: ir.operations, value: memoryDecisionRow)
}

function compilerTypedIRMemoryDecisionRow(memory: CompilerMemoryGraph, decisionKind: Int, nodeID: Int, storageID: Int): Int {
    state typedIRDecisionRow: Int(0)
    let typedIRDecisionCount: Int(compilerIntTableRowCount(table: memory.decisions))
    while typedIRDecisionRow < typedIRDecisionCount {
        if compilerIntTableValue(table: memory.decisions, row: typedIRDecisionRow, column: 0) == decisionKind
            && compilerIntTableValue(table: memory.decisions, row: typedIRDecisionRow, column: 1) == nodeID
            && compilerIntTableValue(table: memory.decisions, row: typedIRDecisionRow, column: 2) == storageID { return typedIRDecisionRow }
        typedIRDecisionRow: typedIRDecisionRow + 1
    }
    return 0 - 1
}

function compilerTypedIRNodeRegion(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, nodeID: Int): Int {
    let typedIRNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: nodeID, column: 1))
    if typedIRNodeKind == compilerSyntaxKindFunction() || typedIRNodeKind == compilerSyntaxKindEntry() { return nodeID }
    if typedIRNodeKind < compilerSyntaxKindEntry() { return 0 - 1 }
    let typedIRNodeFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    return compilerIntTableValue(table: tables.bodyNodes, row: typedIRNodeFacetRow, column: 2)
}

function compilerTypedIRIntegerValue(tables: CompilerSyntaxTables, nodeID: Int): Int {
    let typedIRIntegerFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    let typedIRIntegerText: String(compilerTypedSyntaxLocalText(tables: tables, fileID: compilerIntTableValue(table: tables.bodyNodes, row: typedIRIntegerFacetRow, column: 1), localStart: compilerIntTableValue(table: tables.bodyNodes, row: typedIRIntegerFacetRow, column: 6), localEnd: compilerIntTableValue(table: tables.bodyNodes, row: typedIRIntegerFacetRow, column: 7)))
    return compilerCoreParseDecimalInt(value: typedIRIntegerText)
}

function compilerTypedIRArgumentIntegerForMember(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, applicationNodeID: Int, memberOrdinal: Int): Int {
    state typedIRArgumentOrdinal: Int(0)
    while true {
        let typedIRArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: applicationNodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: typedIRArgumentOrdinal))
        if typedIRArgumentNodeID < 0 { return 0 - 1 }
        let typedIRArgumentMemberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: typedIRArgumentNodeID))
        let typedIRArgumentMemberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: typedIRArgumentMemberNodeID, column: 1))
        if compilerIntTableValue(table: tables.members, row: typedIRArgumentMemberFacetRow, column: 3) == memberOrdinal {
            let typedIRArgumentValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if compilerIntTableValue(table: delta.nodes, row: typedIRArgumentValueNodeID, column: 1) != compilerSyntaxKindIntegerLiteral() { return 0 - 1 }
            return compilerTypedIRIntegerValue(tables: tables, nodeID: typedIRArgumentValueNodeID)
        }
        typedIRArgumentOrdinal: typedIRArgumentOrdinal + 1
    }
    return 0 - 1
}

function compilerTypedIRAppendConstructFields(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR, applicationNodeID: Int, regionNodeID: Int, typeNodeID: Int, storageID: Int, layoutDecisionRow: Int): Int {
    let typedIRConstructLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typeNodeID))
    if typedIRConstructLayoutRow < 0 { return 0 - 1 }
    let typedIRConstructFieldCount: Int(compilerIntTableValue(table: memory.layouts, row: typedIRConstructLayoutRow, column: 1))
