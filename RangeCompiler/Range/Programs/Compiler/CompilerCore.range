function compilerCoreLoweredDirectIfBlock(program: CompilerProgram, parsedBlock: CompilerParsedBlock, loweredCondition: CompilerLLVMLoweredExpression, loweredAfterBlock: CompilerLLVMLoweredBlock, renderedBlocks: String, instructionRecords: String, thenLabel: String, afterLabel: String): CompilerLLVMLoweredBlock {
