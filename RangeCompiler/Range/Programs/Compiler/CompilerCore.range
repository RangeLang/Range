function compilerBodyArenaSwitchOwnerForCase(arena: CompilerBodyArena, caseNodeID: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == caseNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleSwitchCase() { return compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0) }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaSwitchSubjectIsStorage(arena: CompilerBodyArena, subjectNodeID: Int): Bool {
    state storageNodeID: Int(subjectNodeID)
    state kind: Int(0 - 1)
    if storageNodeID >= 0 && storageNodeID < compilerIntTableRowCount(table: arena.nodes) {
        kind: compilerIntTableValue(table: arena.nodes, row: storageNodeID, column: 1)
    }
    if kind == compilerSyntaxKindGrouping() {
        storageNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: storageNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0)
        if storageNodeID >= 0 && storageNodeID < compilerIntTableRowCount(table: arena.nodes) {
            kind: compilerIntTableValue(table: arena.nodes, row: storageNodeID, column: 1)
        } else {
            kind: 0 - 1
        }
    }
    if kind != compilerSyntaxKindIdentifier() && kind != compilerSyntaxKindBindingReference() && kind != compilerSyntaxKindMemberRead() && kind != compilerSyntaxKindIndex() { return false }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: storageNodeID))
    if resolutionRow < 0 { return false }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    return targetKind == compilerBodyResolutionLocalSymbol() || targetKind == compilerBodyResolutionMember()
        || (kind == compilerSyntaxKindIndex() && targetKind == compilerBodyResolutionOperator())
}

function compilerBodyArenaSwitchTypeHasMatcher(arena: CompilerBodyArena, typeKind: Int, typeID: Int): Bool {
    if typeKind == compilerBodyTypeInt() || typeKind == compilerBodyTypeUnsigned8() || typeKind == compilerBodyTypeBool() || typeKind == compilerBodyTypeFloat() || typeKind == compilerBodyTypeFloat32() || typeKind == compilerBodyTypeString() { return true }
    if typeKind == compilerBodyTypeEnum() { return compilerBodyArenaEnumSyntaxIDForTypeID(arena: arena, typeID: typeID) >= 0 }
    return false
}

function compilerBodyArenaExpressionTypesMatch(arena: CompilerBodyArena, leftNodeID: Int, rightNodeID: Int): Bool {
    let leftTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: leftNodeID))
    let rightTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: rightNodeID))
    if leftTypeKind != rightTypeKind { return false }
    if leftTypeKind == compilerBodyTypeConstruct() || leftTypeKind == compilerBodyTypeEnum() {
        return compilerBodyArenaExpressionTypeID(arena: arena, nodeID: leftNodeID) == compilerBodyArenaExpressionTypeID(arena: arena, nodeID: rightNodeID)
    }
    return leftTypeKind != compilerBodyTypeUnknown()
}

function compilerBodyArenaMutableArraySymbolForTarget(arena: CompilerBodyArena, targetNodeID: Int): Int {
    if targetNodeID < 0 || targetNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: targetNodeID, column: 1) != compilerSyntaxKindIndex() { return 0 - 1 }
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: targetNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    if receiverNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: receiverNodeID, column: 1) != compilerSyntaxKindIdentifier() { return 0 - 1 }
    let receiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: receiverNodeID))
    if receiverResolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    let symbolID: Int(compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolState()
        || !compilerBodyArenaTypeIDIsArray(arena: arena, typeID: compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolID)) { return 0 - 1 }
    return symbolID
}

function compilerBodyArenaEnumCaseCount(arena: CompilerBodyArena, enumSyntaxID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: row, column: 2) == enumSyntaxID
            && compilerIntTableValue(table: arena.tables.members, row: row, column: 12) == compilerSyntaxMemberKindEnumCase() { count: count + 1 }
        row: row + 1
    }
    return count
