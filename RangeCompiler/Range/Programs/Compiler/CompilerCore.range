        if memberSyntaxID < 0
            || compilerSyntaxAppendMember(tables: tables, syntaxID: memberSyntaxID, fileID: fileID, parentSyntaxID: parentSyntaxID, ordinal: caseOrdinal, memberStart: caseToken.start, memberEnd: caseEnd, nameStart: nameToken.start, nameEnd: nameToken.end, typeStart: nameToken.end, typeEnd: nameToken.end, fingerprint: caseFingerprint, memberKind: compilerSyntaxMemberKindEnumCase()) != 0 {
