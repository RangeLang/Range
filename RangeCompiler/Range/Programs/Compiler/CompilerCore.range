function compilerTypedSyntaxCaptureEnumCases(source: String, tables: CompilerSyntaxTables, fileID: Int, parentSyntaxID: Int, start: Int, end: Int, baseFingerprint: CompilerFingerprint): CompilerTypedMemberCapture {
