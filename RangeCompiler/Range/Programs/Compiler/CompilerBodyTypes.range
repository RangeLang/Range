function compilerBodyArenaEnumCasePayloadCount(arena: CompilerBodyArena, caseMemberRow: Int): Int {
    if caseMemberRow < 0 || caseMemberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: arena.tables.members, row: caseMemberRow, column: 12) != compilerSyntaxMemberKindEnumCase() { return 0 - 1 }
