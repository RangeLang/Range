}

function compilerReachableTypeKeyArgumentsMatch(typeKeyArguments: CompilerIntTable, typeKeyID: Int, argumentCount: Int, argumentIDs: RawBuffer): Bool {
    if compilerReachableTypeKeyArgumentCount(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID) != argumentCount { return false }
    state ordinal: Int(0)
    while ordinal < argumentCount {
        if compilerReachableTypeKeyArgumentValue(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID, ordinal: ordinal) != rawBufferLoadInt(buffer: argumentIDs, index: ordinal) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerReachableTypeKeyFind(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, typeKind: Int, nominalSyntaxID: Int, argumentCount: Int, argumentIDs: RawBuffer): Int {
    state row: Int(0)
