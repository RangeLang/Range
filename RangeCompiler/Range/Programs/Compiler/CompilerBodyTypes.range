        state parameterRow: Int(0)
        while parameterRow < compilerIntTableRowCount(table: arena.tables.macroParameters) {
            if compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 1) == arena.ownerDeclarationSyntaxID {
                if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolParameter(), declarationRef: parameterRow, regionNodeID: arena.rootNodeID, nameStart: compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 5), nameEnd: compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 6), typeStart: compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 7), typeEnd: compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 8)) < 0 { return 0 - 1 }
            }
            parameterRow: parameterRow + 1
        }
        return 0
    }
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return 0 - 1 }
    if compilerBodyArenaReceiverConstructSyntaxID(arena: arena) >= 0 {
        if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolReceiver(), declarationRef: arena.rootNodeID, regionNodeID: arena.rootNodeID, nameStart: 0, nameEnd: 1, typeStart: 0, typeEnd: 1) < 0 { return 0 - 1 }
    }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolParameter(), declarationRef: parameterRow, regionNodeID: arena.rootNodeID, nameStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 6), nameEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 7), typeStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8), typeEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9)) < 0 { return 0 - 1 }
