            if maybeElementType == nil { return 0 - 1 }
            let fallback: CompilerTypeReference(text: String(""), start: typeGlobalStart + 1, end: typeGlobalStart + 1)
            let elementType: CompilerTypeReference(maybeElementType ?? fallback)
            if elementType.end != typeGlobalEnd - 1 { return 0 - 1 }
            let elementLocalStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: arena.fileID, globalOffset: elementType.start))
            let elementLocalEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: arena.fileID, globalOffset: elementType.end))
            return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: arena.fileID, start: elementLocalStart, end: elementLocalEnd)
