function compilerBodyArenaSeedParameterSymbols(arena: CompilerBodyArena): Int {
    if compilerBodyArenaIsEntry(arena: arena) { return 0 }
    if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        let capabilityCount: Int(compilerIntTableRowCount(table: arena.tables.macroCapabilities))
        state row: Int(0)
        while row < capabilityCount {
            if compilerIntTableValue(table: arena.tables.macroCapabilities, row: row, column: 1) == arena.ownerDeclarationSyntaxID {
                let nameStart: Int(compilerIntTableValue(table: arena.tables.macroCapabilities, row: row, column: 4))
                let nameEnd: Int(compilerIntTableValue(table: arena.tables.macroCapabilities, row: row, column: 5))
                if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolParameter(), declarationRef: row, regionNodeID: arena.rootNodeID, nameStart: nameStart, nameEnd: nameEnd, typeStart: nameStart, typeEnd: nameEnd) < 0 { return 0 - 1 }
