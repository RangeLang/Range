function compilerReachableTypeKeyFingerprint(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, tables: CompilerSyntaxTables, typeKeyID: Int): CompilerFingerprint {
    if typeKeyID < 0 || typeKeyID >= compilerIntTableRowCount(table: typeKeys) { return CompilerFingerprint(first: 0, second: 0) }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyKindColumn()))
    let nominalSyntaxID: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyNominalColumn()))
    if nominalSyntaxID >= 0 {
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: nominalSyntaxID))
        if declarationRow < 0 { return CompilerFingerprint(first: 0, second: 0) }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 11))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 12))
    }
    let argumentCount: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyArgumentCountColumn()))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentCount)
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let argumentKeyID: Int(compilerReachableTypeKeyArgumentValue(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID, ordinal: ordinal))
        let argumentFingerprint: CompilerFingerprint(compilerReachableTypeKeyFingerprint(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, tables: tables, typeKeyID: argumentKeyID))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentFingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentFingerprint.second)
        ordinal: ordinal + 1
    }
    return fingerprint
}

function compilerReachableTypeKeysAreValid(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, tables: CompilerSyntaxTables): Bool {
    if !compilerIntTableIsComplete(table: typeKeys) || !compilerIntTableIsComplete(table: typeKeyArguments) { return false }
    let keyCount: Int(compilerIntTableRowCount(table: typeKeys))
    state keyID: Int(0)
    while keyID < keyCount {
        let argumentCount: Int(compilerIntTableValue(table: typeKeys, row: keyID, column: compilerReachableTypeKeyArgumentCountColumn()))
        if compilerIntTableValue(table: typeKeys, row: keyID, column: compilerReachableTypeKeyIDColumn()) != keyID
            || argumentCount < 0
            || compilerReachableTypeKeyArgumentCount(typeKeyArguments: typeKeyArguments, typeKeyID: keyID) != argumentCount { return false }
        keyID: keyID + 1
    }
    let argumentRowCount: Int(compilerIntTableRowCount(table: typeKeyArguments))
    state argumentRow: Int(0)
    state priorOwner: Int(0 - 1)
    state priorOrdinal: Int(0 - 1)
    while argumentRow < argumentRowCount {
        let owner: Int(compilerIntTableValue(table: typeKeyArguments, row: argumentRow, column: compilerReachableTypeKeyArgumentOwnerColumn()))
        let ordinal: Int(compilerIntTableValue(table: typeKeyArguments, row: argumentRow, column: compilerReachableTypeKeyArgumentOrdinalColumn()))
        let argument: Int(compilerIntTableValue(table: typeKeyArguments, row: argumentRow, column: compilerReachableTypeKeyArgumentValueColumn()))
        if owner < 0 || owner >= keyCount { return false }
        let expectedCount: Int(compilerIntTableValue(table: typeKeys, row: owner, column: compilerReachableTypeKeyArgumentCountColumn()))
        let firstArgumentRow: Int(compilerIntTableValue(table: typeKeys, row: owner, column: compilerReachableTypeKeyFirstArgumentColumn()))
        if argument < 0 || argument >= owner || ordinal < 0 || ordinal >= expectedCount
            || firstArgumentRow < 0 || firstArgumentRow + ordinal != argumentRow
            || owner < priorOwner || (owner == priorOwner && ordinal != priorOrdinal + 1) { return false }
        priorOwner: owner
        priorOrdinal: ordinal
        argumentRow: argumentRow + 1
    }
    return true
}

function compilerBodyArenaTypeInstanceFindInTables(typeInstances: CompilerIntTable, typeArguments: CompilerIntTable, typeKind: Int, nominalSyntaxID: Int, argumentCount: Int, argumentIDs: RawBuffer): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeInstances) {
        if compilerIntTableValue(table: typeInstances, row: row, column: compilerBodyTypeInstanceKindColumn()) == typeKind
            && compilerIntTableValue(table: typeInstances, row: row, column: compilerBodyTypeInstanceNominalSyntaxColumn()) == nominalSyntaxID
            && compilerBodyArenaTypeArgumentCountForTypeIDTables(typeArguments: typeArguments, typeID: row) == argumentCount {
            state ordinal: Int(0)
            state matches: Bool(true)
            while ordinal < argumentCount {
                if compilerBodyArenaTypeArgumentValueForTypeIDTables(typeArguments: typeArguments, typeID: row, ordinal: ordinal) != rawBufferLoadInt(buffer: argumentIDs, index: ordinal) { matches: false }
                ordinal: ordinal + 1
            }
            if matches { return row }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeArgumentCountForTypeIDTables(typeArguments: CompilerIntTable, typeID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeArguments) {
        if compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyArenaTypeArgumentValueForTypeIDTables(typeArguments: CompilerIntTable, typeID: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeArguments) {
        if compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID
            && compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentOrdinalColumn()) == ordinal { return compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentValueTypeInstanceColumn()) }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaImportTypeKeyIntoTables(typeInstances: CompilerIntTable, typeArguments: CompilerIntTable, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, typeKeyID: Int): Int {
    if typeKeyID < 0 || typeKeyID >= compilerIntTableRowCount(table: typeKeys) { return 0 - 1 }
    let argumentCount: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyArgumentCountColumn()))
    let argumentIDs: RawBuffer(rawBufferCreate(capacity: argumentCount + 1, stride: 4))
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let childKeyID: Int(compilerReachableTypeKeyArgumentValue(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID, ordinal: ordinal))
        let childTypeID: Int(compilerBodyArenaImportTypeKeyIntoTables(typeInstances: typeInstances, typeArguments: typeArguments, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, typeKeyID: childKeyID))
        if childTypeID < 0 {
            rawBufferDestroy(buffer: argumentIDs)
            return 0 - 1
        }
        if rawBufferAppendInt(buffer: argumentIDs, value: childTypeID) != 0 {
            rawBufferDestroy(buffer: argumentIDs)
            return 0 - 1
        }
        ordinal: ordinal + 1
    }
    let typeKind: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyKindColumn()))
    let nominalSyntaxID: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyNominalColumn()))
    let existing: Int(compilerBodyArenaTypeInstanceFindInTables(typeInstances: typeInstances, typeArguments: typeArguments, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: argumentCount, argumentIDs: argumentIDs))
    if existing >= 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return existing
    }
    let localTypeID: Int(compilerIntTableRowCount(table: typeInstances))
    if compilerIntTableAppend(table: typeInstances, value: localTypeID) != 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyFileColumn())) != 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyStartColumn())) != 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyEndColumn())) != 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: typeKind) != 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: nominalSyntaxID) != 0 {
        rawBufferDestroy(buffer: argumentIDs)
        return 0 - 1
    }
    ordinal: 0
    while ordinal < argumentCount {
        if compilerIntTableAppend(table: typeArguments, value: localTypeID) != 0 {
            rawBufferDestroy(buffer: argumentIDs)
            return 0 - 1
        }
        if compilerIntTableAppend(table: typeArguments, value: ordinal) != 0 {
            rawBufferDestroy(buffer: argumentIDs)
            return 0 - 1
        }
        if compilerIntTableAppend(table: typeArguments, value: rawBufferLoadInt(buffer: argumentIDs, index: ordinal)) != 0 {
            rawBufferDestroy(buffer: argumentIDs)
            return 0 - 1
        }
        ordinal: ordinal + 1
    }
    rawBufferDestroy(buffer: argumentIDs)
    return localTypeID
}

function compilerBodyArenaTypeIDForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
    return compilerBodyArenaTypeInstanceIntern(arena: arena, fileID: fileID, start: start, end: end)
}

function compilerBodyArenaTypeKindForTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return compilerBodyTypeUnknown() }
    return compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn())
}

function compilerBodyArenaGenericParameterOrdinal(arena: CompilerBodyArena, ownerSyntaxID: Int, fileID: Int, start: Int, end: Int): Int {
    if ownerSyntaxID < 0 { return 0 - 1 }
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return 0 - 1 }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.genericParameters) {
        if compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()) == ownerSyntaxID
            && compilerSemanticLocalRangesEqual(tables: arena.tables, firstFileID: fileID, firstStart: normalizedRange.start, firstEnd: normalizedRange.end, secondFileID: compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()), secondStart: compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameStartColumn()), secondEnd: compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameEndColumn())) { return compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()) }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaSpecializedTypeIDForSpan(arena: CompilerBodyArena, receiverTypeID: Int, ownerSyntaxID: Int, fileID: Int, start: Int, end: Int): Int {
    let parameterOrdinal: Int(compilerBodyArenaGenericParameterOrdinal(arena: arena, ownerSyntaxID: ownerSyntaxID, fileID: fileID, start: start, end: end))
    if parameterOrdinal >= 0 {
        if receiverTypeID < 0 || receiverTypeID >= compilerIntTableRowCount(table: arena.typeInstances)
            || compilerIntTableValue(table: arena.typeInstances, row: receiverTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()) != ownerSyntaxID { return 0 - 1 }
        return compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: receiverTypeID, ordinal: parameterOrdinal)
    }
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: fileID, start: start, end: end)
}

function compilerBodyArenaSpecializedTypeKindForSpan(arena: CompilerBodyArena, receiverTypeID: Int, ownerSyntaxID: Int, fileID: Int, start: Int, end: Int): Int {
    return compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: fileID, start: start, end: end))
}

function compilerBodyArenaFunctionOwnerSyntaxID(arena: CompilerBodyArena, functionID: Int): Int {
    if functionID < 0 || functionID >= rawBufferCount(buffer: arena.tables.functionOwners) { return 0 - 1 }
    return rawBufferLoadInt(buffer: arena.tables.functionOwners, index: functionID)
}

function compilerBodyArenaReceiverConstructSyntaxID(arena: CompilerBodyArena): Int {
    if arena.ownerKind != compilerBodyArenaOwnerFunction()
        || arena.ownerFunctionRow < 0
        || arena.ownerFunctionRow >= rawBufferCount(buffer: arena.tables.functionOwners) { return 0 - 1 }
    let ownerSyntaxID: Int(rawBufferLoadInt(buffer: arena.tables.functionOwners, index: arena.ownerFunctionRow))
    let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: ownerSyntaxID))
    if ownerDeclarationRow < 0 || compilerIntTableValue(table: arena.tables.declarations, row: ownerDeclarationRow, column: 2) != compilerSyntaxKindConstruct() { return 0 - 1 }
    return ownerSyntaxID
}

function compilerBodyArenaReceiverTypeID(arena: CompilerBodyArena): Int {
    if arena.ownerReceiverTypeKeyID >= 0 { return arena.ownerReceiverTypeID }
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    if ownerSyntaxID < 0 { return 0 - 1 }
    let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: ownerSyntaxID))
    let ownerFileID: Int(compilerIntTableValue(table: arena.tables.declarations, row: ownerDeclarationRow, column: 1))
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: ownerFileID, start: compilerIntTableValue(table: arena.tables.declarations, row: ownerDeclarationRow, column: 7), end: compilerIntTableValue(table: arena.tables.declarations, row: ownerDeclarationRow, column: 8))
}

function compilerBodyArenaSymbolArrayInitializer(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if declarationNodeID < 0 || declarationNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 1) != compilerSyntaxKindLocalBinding() { return 0 - 1 }
    let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
    if initializerNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: initializerNodeID, column: 1) != compilerSyntaxKindArrayLiteral() { return 0 - 1 }
    return initializerNodeID
}

function compilerBodyArenaSymbolIsCapturedMacroParameter(arena: CompilerBodyArena, symbolID: Int): Bool {
    if arena.ownerKind != compilerBodyArenaOwnerMacro() || symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolParameter() { return false }
    let parameterRow: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: arena.tables.macroParameters)
        || compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 1) != arena.ownerDeclarationSyntaxID
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameStartColumn()) != compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 5)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameEndColumn()) != compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 6) { return false }
    let parameterStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: compilerIntTableValue(table: arena.tables.macroParameters, row: parameterRow, column: 3)))
    let maybeAttribute: Optional<RangeLexedToken>(lexNextRangeToken(source: arena.tables.sourceStore.source, start: parameterStart))
    if maybeAttribute == nil { return false }
    let fallback: RangeLexedToken(compilerFallbackToken(cursor: CompilerTokenCursor(source: arena.tables.sourceStore.source, index: parameterStart)))
    let attribute: RangeLexedToken(maybeAttribute ?? fallback)
    return attribute.kind == .macroAttribute && attribute.text == String("@capture")
}

function compilerBodyArenaNominalTypeID(arena: CompilerBodyArena, name: String): Int {
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: name, kindTag: compilerSyntaxKindConstruct()))
    if declarationRow < 0 { return 0 - 1 }
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 1), start: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 7), end: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 8))
}

function compilerBodyArenaSymbolTypeKind(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return compilerBodyTypeUnknown() }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind == compilerBodySymbolReceiver() { return compilerBodyTypeConstruct() }
    if symbolKind == compilerBodySymbolEnumPayloadBinding() {
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: declarationNodeID))
        if resolutionRow < 0 { return compilerBodyTypeUnknown() }
        return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn())
    }
    if compilerBodyArenaSymbolIsCapturedMacroParameter(arena: arena, symbolID: symbolID) { return compilerBodyTypeConstruct() }
    if compilerBodyArenaSymbolArrayInitializer(arena: arena, symbolID: symbolID) >= 0 { return compilerBodyTypeConstruct() }
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    if arena.ownerReceiverTypeID >= 0 && ownerSyntaxID >= 0 {
        return compilerBodyArenaSpecializedTypeKindForSpan(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
    }
    return compilerBodyArenaTypeKindForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
}

function compilerBodyArenaSymbolTypeID(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind == compilerBodySymbolReceiver() { return compilerBodyArenaReceiverTypeID(arena: arena) }
    if symbolKind == compilerBodySymbolEnumPayloadBinding() {
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: declarationNodeID))
        if resolutionRow < 0 { return 0 - 1 }
        return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())
    }
    if compilerBodyArenaSymbolIsCapturedMacroParameter(arena: arena, symbolID: symbolID) { return compilerBodyArenaNominalTypeID(arena: arena, name: String("WrittenExpression")) }
    let arrayInitializerNodeID: Int(compilerBodyArenaSymbolArrayInitializer(arena: arena, symbolID: symbolID))
    if arrayInitializerNodeID >= 0 { return compilerBodyArenaExpressionTypeID(arena: arena, nodeID: arrayInitializerNodeID) }
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    if arena.ownerReceiverTypeID >= 0 && ownerSyntaxID >= 0 {
        return compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
    }
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
}

function compilerBodyArenaTypeNameForTypeID(arena: CompilerBodyArena, typeID: Int): String {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return String("") }
    let fileID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceFileColumn()))
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceStartColumn()), localEnd: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceEndColumn()))
}

function compilerBodyOptionalPayloadMatches(arena: CompilerBodyArena, optionalTypeID: Int, payloadTypeID: Int): Bool {
    let optionalTypeName: String(compilerBodyArenaTypeNameForTypeID(arena: arena, typeID: optionalTypeID))
    let payloadTypeName: String(compilerBodyArenaTypeNameForTypeID(arena: arena, typeID: payloadTypeID))
    return optionalTypeName != String("") && payloadTypeName != String("")
        && compilerOptionalPayloadTypeName(typeName: optionalTypeName) == payloadTypeName
}

function compilerBodyArenaTypeArgumentsAreValid(arena: CompilerBodyArena): Bool {
    if !compilerIntTableIsComplete(table: arena.typeInstances) || !compilerIntTableIsComplete(table: arena.typeArguments) { return false }
    let typeCount: Int(compilerIntTableRowCount(table: arena.typeInstances))
    state typeID: Int(0)
    while typeID < typeCount {
        let expectedCount: Int(compilerBodyArenaTypeArgumentExpectedCountForTypeID(arena: arena, typeID: typeID))
        let actualCount: Int(compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID))
        if expectedCount < 0 || actualCount != expectedCount { return false }
        state ordinal: Int(0)
        while ordinal < expectedCount {
            let argumentTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: typeID, ordinal: ordinal))
            if argumentTypeID < 0 || argumentTypeID >= typeCount { return false }
            ordinal: ordinal + 1
        }
        typeID: typeID + 1
    }
    state argumentRow: Int(0)
    state priorOwnerTypeID: Int(0 - 1)
    state priorOrdinal: Int(0 - 1)
    let argumentRowCount: Int(compilerIntTableRowCount(table: arena.typeArguments))
    while argumentRow < argumentRowCount {
        let ownerTypeID: Int(compilerIntTableValue(table: arena.typeArguments, row: argumentRow, column: compilerBodyTypeArgumentTypeInstanceColumn()))
        let ordinal: Int(compilerIntTableValue(table: arena.typeArguments, row: argumentRow, column: compilerBodyTypeArgumentOrdinalColumn()))
        let argumentTypeID: Int(compilerIntTableValue(table: arena.typeArguments, row: argumentRow, column: compilerBodyTypeArgumentValueTypeInstanceColumn()))
        let expectedCount: Int(compilerBodyArenaTypeArgumentExpectedCountForTypeID(arena: arena, typeID: ownerTypeID))
        if ownerTypeID < 0 || ownerTypeID >= typeCount || expectedCount < 0 || ordinal < 0 || ordinal >= expectedCount || argumentTypeID < 0 || argumentTypeID >= typeCount
            || argumentTypeID >= ownerTypeID
            || ownerTypeID < priorOwnerTypeID
            || (ownerTypeID == priorOwnerTypeID && ordinal != priorOrdinal + 1) { return false }
        state priorRow: Int(0)
        while priorRow < argumentRow {
            if compilerIntTableValue(table: arena.typeArguments, row: priorRow, column: compilerBodyTypeArgumentTypeInstanceColumn()) == ownerTypeID
                && compilerIntTableValue(table: arena.typeArguments, row: priorRow, column: compilerBodyTypeArgumentOrdinalColumn()) == ordinal { return false }
            priorRow: priorRow + 1
        }
        priorOwnerTypeID: ownerTypeID
        priorOrdinal: ordinal
        argumentRow: argumentRow + 1
    }
    return true
}

function compilerBodyArenaAppendResolution(arena: CompilerBodyArena, sourceNodeID: Int, targetKind: Int, targetID: Int, typeKind: Int, typeID: Int, regionNodeID: Int): Int {
    if compilerIntTableAppend(table: arena.resolutions, value: sourceNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.resolutions, value: targetKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.resolutions, value: targetID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.resolutions, value: typeKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.resolutions, value: typeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.resolutions, value: regionNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.resolutions, value: 0 - 1) != 0 { return 0 - 1 }
    return 0
}

function compilerBodyArenaSetResolutionInstanceID(arena: CompilerBodyArena, resolutionRow: Int, instanceID: Int): Int {
    if resolutionRow < 0 || resolutionRow >= compilerIntTableRowCount(table: arena.resolutions) { return 0 - 1 }
    return rawBufferStoreInt(buffer: arena.resolutions.values, index: resolutionRow * compilerBodyResolutionColumnCount() + compilerBodyResolutionInstanceIDColumn(), value: instanceID)
}

function compilerBodyArenaNodeText(arena: CompilerBodyArena, nodeID: Int): String {
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: compilerIntTableValue(table: arena.nodes, row: nodeID, column: 6), localEnd: compilerIntTableValue(table: arena.nodes, row: nodeID, column: 7))
}

function compilerBodyArenaExpressionTypeKind(arena: CompilerBodyArena, nodeID: Int): Int {
    let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if kind == compilerSyntaxKindIntegerLiteral() { return compilerBodyTypeInt() }
    if kind == compilerSyntaxKindDoubleLiteral() { return compilerBodyTypeFloat() }
    if kind == compilerSyntaxKindStringLiteral() || kind == compilerSyntaxKindStringSegment() || kind == compilerSyntaxKindInterpolatedString() { return compilerBodyTypeString() }
    if kind == compilerSyntaxKindBoolLiteral() { return compilerBodyTypeBool() }
    if kind == compilerSyntaxKindGrouping() {
        let groupedNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        if groupedNodeID < 0 { return compilerBodyTypeUnknown() }
        return compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: groupedNodeID)
    }
    if kind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        let callResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
        if callResolutionRow < 0 { return compilerBodyTypeUnknown() }
        return compilerIntTableValue(table: arena.resolutions, row: callResolutionRow, column: compilerBodyResolutionTypeKindColumn())
    }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: nodeID))
    if resolutionRow < 0 { return compilerBodyTypeUnknown() }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn())
}

function compilerBodyArenaExpressionTypeID(arena: CompilerBodyArena, nodeID: Int): Int {
    let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if kind == compilerSyntaxKindGrouping() {
        let groupedNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        if groupedNodeID < 0 { return 0 - 1 }
        return compilerBodyArenaExpressionTypeID(arena: arena, nodeID: groupedNodeID)
    }
    if kind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        let callResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
        if callResolutionRow < 0 { return 0 - 1 }
        return compilerIntTableValue(table: arena.resolutions, row: callResolutionRow, column: compilerBodyResolutionTypeIDColumn())
    }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: nodeID))
    if resolutionRow < 0 { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())
}

function compilerBodyArenaExpectedApplicationArgumentTypeID(arena: CompilerBodyArena, applicationNodeID: Int, argumentNodeID: Int): Int {
    if applicationNodeID < 0 || applicationNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || argumentNodeID < 0 || argumentNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let calleeResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || calleeResolutionRow < 0 { return 0 - 1 }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    let targetID: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if targetKind == compilerBodyResolutionEnum() {
        return compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTypeIDColumn())
    }
    if targetKind == compilerBodyResolutionConstruct() {
        let memberRow: Int(compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: targetID, argumentNodeID: argumentNodeID))
        let receiverTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTypeIDColumn()))
        if memberRow < 0 || receiverTypeID < 0 { return 0 - 1 }
        return compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: receiverTypeID, memberRow: memberRow)
    }
    if targetKind == compilerBodyResolutionFunction() {
        if targetID < 0 || targetID >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - 1 }
        let parameterOrdinal: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 3))
        let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: targetID, column: 2))
        let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: targetID, column: 3))
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        if parameterOrdinal < 0 || parameterOrdinal >= parameterCount
            || parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: arena.tables.parameters) { return 0 - 1 }
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterStart: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8))
        let parameterEnd: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9))
        if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindMemberRead() {
            let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
            let receiverTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: receiverNodeID))
            let ownerSyntaxID: Int(compilerBodyArenaFunctionOwnerSyntaxID(arena: arena, functionID: targetID))
            if receiverNodeID < 0 || receiverTypeID < 0 || ownerSyntaxID < 0 { return 0 - 1 }
            return compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: parameterStart, end: parameterEnd)
        }
        return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: parameterFileID, start: parameterStart, end: parameterEnd)
    }
    return 0 - 1
}

function compilerBodyArenaExpectedTypeIDForExpression(arena: CompilerBodyArena, expressionNodeID: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == expressionNodeID {
            let declarationNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0))
            let role: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2))
            if role == compilerSyntaxRoleInitializer() && declarationNodeID >= 0
                && declarationNodeID < compilerIntTableRowCount(table: arena.nodes)
                && compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 1) == compilerSyntaxKindLocalBinding() {
                let typeStart: Int(compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 8))
                let typeEnd: Int(compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 9))
                if typeStart >= 0 && typeEnd > typeStart {
                    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: arena.fileID, start: typeStart, end: typeEnd)
                }
            }
            if role == compilerSyntaxRoleArrayElement() {
                let arrayResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: declarationNodeID))
                if arrayResolutionRow >= 0 {
                    let arrayTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: arrayResolutionRow, column: compilerBodyResolutionTypeIDColumn()))
                    if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: arrayTypeID) {
                        return compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: arrayTypeID, ordinal: 0)
                    }
                }
            }
            if role == compilerSyntaxRoleAssignedValue() {
                let targetNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
                let targetResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: targetNodeID))
                if targetNodeID >= 0 && targetResolutionRow >= 0 {
                    return compilerIntTableValue(table: arena.resolutions, row: targetResolutionRow, column: compilerBodyResolutionTypeIDColumn())
                }
            }
            if role == compilerSyntaxRoleReturnValue() && arena.ownerFunctionRow >= 0 {
                let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
                let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6))
                let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7))
                return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: returnFileID, start: returnStart, end: returnEnd)
            }
            if role == compilerSyntaxRoleArgumentValue() {
                state argumentOwnerNodeID: Int(0 - 1)
                state argumentEdgeRow: Int(0)
                while argumentEdgeRow < compilerIntTableRowCount(table: arena.edges) {
                    if compilerIntTableValue(table: arena.edges, row: argumentEdgeRow, column: 1) == declarationNodeID
                        && compilerIntTableValue(table: arena.edges, row: argumentEdgeRow, column: 2) == compilerSyntaxRoleArgument() {
                        argumentOwnerNodeID: compilerIntTableValue(table: arena.edges, row: argumentEdgeRow, column: 0)
                    }
                    argumentEdgeRow: argumentEdgeRow + 1
                }
                if argumentOwnerNodeID >= 0 {
                    let expectedArgumentTypeID: Int(compilerBodyArenaExpectedApplicationArgumentTypeID(arena: arena, applicationNodeID: argumentOwnerNodeID, argumentNodeID: declarationNodeID))
                    if expectedArgumentTypeID >= 0 { return expectedArgumentTypeID }
                    let ownerCalleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentOwnerNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
                    let ownerResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerCalleeNodeID))
                    if ownerResolutionRow >= 0
                        && compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionEnum() {
                        return compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTypeIDColumn())
                    }
                }
            }
        }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaRegionContainsNode(arena: CompilerBodyArena, regionNodeID: Int, nodeID: Int): Bool {
    let regionStart: Int(compilerIntTableValue(table: arena.nodes, row: regionNodeID, column: 4))
    let regionEnd: Int(compilerIntTableValue(table: arena.nodes, row: regionNodeID, column: 5))
    let nodeStart: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 4))
    return nodeStart >= regionStart && nodeStart < regionEnd
}

function compilerBodyArenaLexicalParentRegion(arena: CompilerBodyArena, regionNodeID: Int): Int {
    if regionNodeID < 0 || regionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: regionNodeID, column: 1) != compilerSyntaxKindLexicalRegion() { return 0 - 2 }
    if regionNodeID == arena.rootNodeID { return 0 - 1 }
    if rawBufferCount(buffer: arena.parentNodes) != compilerIntTableRowCount(table: arena.nodes)
        || rawBufferCount(buffer: arena.parentRoles) != compilerIntTableRowCount(table: arena.nodes) { return 0 - 2 }
    state ownerStatementNodeID: Int(rawBufferLoadInt(buffer: arena.parentNodes, index: regionNodeID))
    let ownerRole: Int(rawBufferLoadInt(buffer: arena.parentRoles, index: regionNodeID))
    if ownerRole == compilerSyntaxRoleSwitchBody() {
        let caseNodeID: Int(ownerStatementNodeID)
        if caseNodeID < 0 || caseNodeID >= rawBufferCount(buffer: arena.parentNodes)
            || rawBufferLoadInt(buffer: arena.parentRoles, index: caseNodeID) != compilerSyntaxRoleSwitchCase() { return 0 - 2 }
        ownerStatementNodeID: rawBufferLoadInt(buffer: arena.parentNodes, index: caseNodeID)
    } else if ownerRole != compilerSyntaxRoleThenRegion() && ownerRole != compilerSyntaxRoleElseRegion() && ownerRole != compilerSyntaxRoleWhileBody() {
        return 0 - 2
    }
    if ownerStatementNodeID < 0 || ownerStatementNodeID >= rawBufferCount(buffer: arena.parentNodes)
        || rawBufferLoadInt(buffer: arena.parentRoles, index: ownerStatementNodeID) != compilerSyntaxRoleStatement() { return 0 - 2 }
    let parentRegionNodeID: Int(rawBufferLoadInt(buffer: arena.parentNodes, index: ownerStatementNodeID))
    if parentRegionNodeID < 0 || parentRegionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: parentRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion() { return 0 - 2 }
    return parentRegionNodeID
}

function compilerBodyArenaLexicalRegionContainsRegion(arena: CompilerBodyArena, ancestorRegionNodeID: Int, candidateRegionNodeID: Int): Bool {
    if ancestorRegionNodeID < 0 || ancestorRegionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || candidateRegionNodeID < 0 || candidateRegionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: ancestorRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion()
        || compilerIntTableValue(table: arena.nodes, row: candidateRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion() { return false }
    state currentRegionNodeID: Int(candidateRegionNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        if currentRegionNodeID == ancestorRegionNodeID { return true }
        let parentRegionNodeID: Int(compilerBodyArenaLexicalParentRegion(arena: arena, regionNodeID: currentRegionNodeID))
        if parentRegionNodeID == 0 - 1 { return false }
        if parentRegionNodeID < 0 || parentRegionNodeID == currentRegionNodeID { return false }
        currentRegionNodeID: parentRegionNodeID
        step: step + 1
    }
    return false
}

function compilerBodyArenaSymbolName(arena: CompilerBodyArena, symbolID: Int): String {
    if symbolID >= 0 && symbolID < compilerIntTableRowCount(table: arena.symbols)
        && compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolReceiver() { return String("self") }
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameStartColumn()), localEnd: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameEndColumn()))
}

function compilerBodyArenaSymbolForIdentifier(arena: CompilerBodyArena, identifierNodeID: Int): Int {
    let name: String(compilerBodyArenaNodeText(arena: arena, nodeID: identifierNodeID))
    state symbolRow: Int(compilerIntTableRowCount(table: arena.symbols) - 1)
    while symbolRow >= 0 {
        let regionNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolRegionColumn()))
        if compilerBodyArenaRegionContainsNode(arena: arena, regionNodeID: regionNodeID, nodeID: identifierNodeID) {
            let candidate: String(compilerBodyArenaSymbolName(arena: arena, symbolID: symbolRow))
            if candidate == name { return symbolRow }
        }
        symbolRow: symbolRow - 1
    }
    return 0 - 1
}

function compilerBodyArenaNodeIsReturnValue(arena: CompilerBodyArena, nodeID: Int): Bool {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == nodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleReturnValue() { return true }
        edgeRow: edgeRow + 1
    }
    return false
}

function compilerBodyArenaAppendNilResolution(arena: CompilerBodyArena, nodeID: Int, typeKind: Int, typeID: Int, regionNodeID: Int): Int {
    if typeKind != compilerBodyTypeConstruct() || typeID < 0 { return 0 - 1 }
    return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionBuiltin(), targetID: compilerBodyBuiltinNil(), typeKind: typeKind, typeID: typeID, regionNodeID: regionNodeID)
}

function compilerBodyArenaApplicationArgumentCount(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    state count: Int(0)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0) == applicationNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleArgument() { count: count + 1 }
        edgeRow: edgeRow + 1
    }
    return count
}

function compilerBodyArenaCallLabelsMatchFunction(arena: CompilerBodyArena, applicationNodeID: Int, functionID: Int): Bool {
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 3))
    if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != parameterCount { return false }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 2))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if argumentNodeID < 0 { return false }
        let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
        let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
        if labelStart < 0 || labelEnd < labelStart { return false }
        let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: parameterFileID, localStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 7)))
        if label != parameterName { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaCallLabelsMatchMemberRuntimeBuiltin(arena: CompilerBodyArena, applicationNodeID: Int, builtinID: Int): Bool {
    let argumentCount: Int(compilerBodyMemberRuntimeBuiltinArgumentCount(id: builtinID))
    if argumentCount < 0 || compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != argumentCount { return false }
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if argumentNodeID < 0 { return false }
        let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
        let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
        if labelStart < 0 || labelEnd <= labelStart { return false }
        let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
        if label != compilerBodyMemberRuntimeBuiltinArgumentLabel(id: builtinID, ordinal: ordinal) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaConstructMemberRowAtOrdinal(arena: CompilerBodyArena, constructSyntaxID: Int, ordinal: Int): Int {
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == constructSyntaxID
            && compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 3) == ordinal { return memberRow }
        memberRow: memberRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaConstructMemberCount(arena: CompilerBodyArena, constructSyntaxID: Int): Int {
    state count: Int(0)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == constructSyntaxID { count: count + 1 }
        memberRow: memberRow + 1
    }
    return count
}

function compilerBodyArenaConstructMemberRowForArgument(arena: CompilerBodyArena, constructSyntaxID: Int, argumentNodeID: Int): Int {
    if argumentNodeID < 0 || argumentNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
    let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
    if labelStart < 0 || labelEnd <= labelStart { return 0 - 1 }
    let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
    return compilerDeclarationIndexMemberLookup(tables: arena.tables, index: arena.declarationIndex, parentSyntaxID: constructSyntaxID, name: label)
}

function compilerBodyArenaConstructArgumentOrdinalForMemberOrdinal(arena: CompilerBodyArena, applicationNodeID: Int, constructSyntaxID: Int, memberOrdinal: Int): Int {
    let memberRow: Int(compilerBodyArenaConstructMemberRowAtOrdinal(arena: arena, constructSyntaxID: constructSyntaxID, ordinal: memberOrdinal))
    if memberRow < 0 { return 0 - 1 }
    state argumentOrdinal: Int(0)
    let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID))
    while argumentOrdinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
        if compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: argumentNodeID) == memberRow { return argumentOrdinal }
        argumentOrdinal: argumentOrdinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaMacroCapabilityRootNode(arena: CompilerBodyArena, nodeID: Int): Int {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    state currentNodeID: Int(nodeID)
    if compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1) == compilerSyntaxKindApplication() {
        currentNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0)
    }
    state keepWalking: Bool(currentNodeID >= 0)
    while keepWalking && compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if receiverNodeID < 0 {
            keepWalking: false
            currentNodeID: 0 - 1
        } else {
            currentNodeID: receiverNodeID
        }
    }
    return currentNodeID
}

function compilerBodyArenaExpressionUsesMacroCapability(arena: CompilerBodyArena, nodeID: Int): Bool {
    if arena.ownerKind != compilerBodyArenaOwnerMacro() || nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    if compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1) == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        if calleeNodeID >= 0 && compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindIdentifier()
            && compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID) == String("expand") { return true }
    }
    let rootNodeID: Int(compilerBodyArenaMacroCapabilityRootNode(arena: arena, nodeID: nodeID))
    if rootNodeID < 0 { return false }
    let rootKind: Int(compilerIntTableValue(table: arena.nodes, row: rootNodeID, column: 1))
    if rootKind != compilerSyntaxKindIdentifier() && rootKind != compilerSyntaxKindBindingReference() { return false }
    let symbolID: Int(compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: rootNodeID))
    if symbolID < 0 { return false }
    return compilerMacroCapabilityKindForTypeKind(typeKind: compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: symbolID)) > 0
}

function compilerBodyArenaCallLabelsMatchConstruct(arena: CompilerBodyArena, applicationNodeID: Int, constructSyntaxID: Int): Bool {
    let memberCount: Int(compilerBodyArenaConstructMemberCount(arena: arena, constructSyntaxID: constructSyntaxID))
    if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != memberCount { return false }
    state ordinal: Int(0)
    while ordinal < memberCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        let memberRow: Int(compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: argumentNodeID))
        if argumentNodeID < 0 || memberRow < 0 { return false }
        state priorOrdinal: Int(0)
        while priorOrdinal < ordinal {
            let priorArgumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: priorOrdinal))
            if compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: priorArgumentNodeID) == memberRow { return false }
            priorOrdinal: priorOrdinal + 1
        }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaResolveCapabilityExpression(arena: CompilerBodyArena, index: CompilerDeclarationIndex, nodeID: Int, regionNodeID: Int): Int {
    let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if kind == compilerSyntaxKindMemberRead() {
        let memberReceiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if memberReceiverNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: memberReceiverNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
        let memberReceiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: memberReceiverNodeID))
        if memberReceiverResolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: memberReceiverResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
        let memberCapabilityKind: Int(compilerMacroCapabilityKindForTypeKind(typeKind: compilerIntTableValue(table: arena.resolutions, row: memberReceiverResolutionRow, column: compilerBodyResolutionTypeKindColumn())))
        if memberCapabilityKind <= 0 { return 0 - 1 }
        let memberOperation: Int(compilerMacroDiagnosticsOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: nodeID)))
        if memberCapabilityKind == compilerMacroCapabilityDiagnostics() && memberOperation > 0 {
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroCapability(), targetID: memberOperation, typeKind: compilerBodyTypeVoid(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        let targetOperation: Int(compilerMacroTargetOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: nodeID)))
        if memberCapabilityKind == compilerMacroCapabilityTarget() && targetOperation > 0 {
            state targetTypeKind: Int(compilerBodyTypeVoid())
            if targetOperation == compilerMacroTargetOperationMemberCount() { targetTypeKind: compilerBodyTypeInt() }
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroTargetOperation(), targetID: targetOperation, typeKind: targetTypeKind, typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        let graphOperation: Int(compilerMacroGraphOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: nodeID)))
        if memberCapabilityKind == compilerMacroCapabilityGraph() && graphOperation > 0 {
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroGraphQuery(), targetID: graphOperation, typeKind: compilerBodyTypeInt(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroCapabilityDenied(), targetID: 0, typeKind: compilerBodyTypeVoid(), typeID: 0 - 1, regionNodeID: regionNodeID)
    }
    if kind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        if calleeNodeID < 0 { return 0 - 1 }
        if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindIdentifier()
            && compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID) == String("expand") {
            if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 0 { return 0 - 1 }
            state targetCapabilityFound: Bool(false)
            state capabilityRow: Int(0)
            while capabilityRow < compilerIntTableRowCount(table: arena.tables.macroCapabilities) {
                if compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 1) == arena.ownerDeclarationSyntaxID
                    && compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 3) == compilerMacroCapabilityTarget() { targetCapabilityFound: true }
                capabilityRow: capabilityRow + 1
            }
            if !targetCapabilityFound { return 0 - 1 }
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: calleeNodeID, targetKind: compilerBodyResolutionMacroTargetOperation(), targetID: compilerMacroTargetOperationExpand(), typeKind: compilerBodyTypeVoid(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
        let applicationReceiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if applicationReceiverNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: applicationReceiverNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
        let applicationReceiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: applicationReceiverNodeID))
        if applicationReceiverResolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: applicationReceiverResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
        let applicationReceiverTypeKind: Int(compilerIntTableValue(table: arena.resolutions, row: applicationReceiverResolutionRow, column: compilerBodyResolutionTypeKindColumn()))
        let applicationCapabilityKind: Int(compilerMacroCapabilityKindForTypeKind(typeKind: applicationReceiverTypeKind))
        if applicationCapabilityKind <= 0 { return 0 - 1 }
        let applicationOperation: Int(compilerMacroDiagnosticsOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID)))
        let applicationGraphOperation: Int(compilerMacroGraphOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID)))
        let applicationTargetOperation: Int(compilerMacroTargetOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID)))
        state targetKind: Int(compilerBodyResolutionMacroCapabilityDenied())
        state targetID: Int(0)
        state resultTypeKind: Int(compilerBodyTypeVoid())
        state invalidTargetQuery: Bool(false)
        if applicationCapabilityKind == compilerMacroCapabilityDiagnostics() && applicationOperation > 0 {
            targetKind: compilerBodyResolutionMacroCapability()
            targetID: applicationOperation
            if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 1 { return 0 - 1 }
        } else if applicationCapabilityKind == compilerMacroCapabilityTarget() && applicationTargetOperation > 0 {
            targetKind: compilerBodyResolutionMacroTargetOperation()
            targetID: applicationTargetOperation
            if applicationTargetOperation == compilerMacroTargetOperationOmit()
                && compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 0 { return 0 - 1 }
            if applicationTargetOperation == compilerMacroTargetOperationMemberCount() {
                resultTypeKind: compilerBodyTypeInt()
                if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 1 { invalidTargetQuery: true }
            }
        } else if applicationCapabilityKind == compilerMacroCapabilityGraph() && applicationGraphOperation > 0 {
            targetKind: compilerBodyResolutionMacroGraphQuery()
            targetID: applicationGraphOperation
            resultTypeKind: compilerBodyTypeInt()
            if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 2 { return 0 - 1 }
        } else if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 0 { return 0 - 1 }
        let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID))
        state argumentOrdinal: Int(0)
        while argumentOrdinal < argumentCount {
            let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
            let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
