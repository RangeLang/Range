            && compilerIntTableValue(table: typeKeys, row: row, column: compilerReachableTypeKeyNominalColumn()) == nominalSyntaxID
            && compilerIntTableValue(table: typeKeys, row: row, column: compilerReachableTypeKeyArgumentCountColumn()) == argumentCount
            && compilerReachableTypeKeyArgumentsMatch(typeKeyArguments: typeKeyArguments, typeKeyID: row, argumentCount: argumentCount, argumentIDs: argumentIDs) { return row }
        row: row + 1
    }
    return 0 - 1
}

