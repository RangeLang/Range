function compilerBodyArenaAppendSymbol(arena: CompilerBodyArena, kind: Int, declarationRef: Int, regionNodeID: Int, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): Int {
    let symbolID: Int(compilerIntTableRowCount(table: arena.symbols))
    if compilerIntTableAppend(table: arena.symbols, value: symbolID) != 0
        || compilerIntTableAppend(table: arena.symbols, value: kind) != 0
        || compilerIntTableAppend(table: arena.symbols, value: declarationRef) != 0
        || compilerIntTableAppend(table: arena.symbols, value: regionNodeID) != 0
        || compilerIntTableAppend(table: arena.symbols, value: nameStart) != 0
        || compilerIntTableAppend(table: arena.symbols, value: nameEnd) != 0
        || compilerIntTableAppend(table: arena.symbols, value: typeStart) != 0
        || compilerIntTableAppend(table: arena.symbols, value: typeEnd) != 0 { return 0 - 1 }
    return symbolID
}

function compilerBodyArenaTypeOuterName(typeName: String): String {
    let length: Int(stringLength(value: typeName))
    if length > 1 && typeName.substring(start: length - 1, end: length) == String("?") { return String("Optional") }
    let genericStart: Int(stringIndexOf(source: typeName, needle: String("<"), start: 0))
    if genericStart < 0 { return typeName }
    return typeName.substring(start: 0, end: genericStart)
}

function compilerBodyArenaGenericArgumentText(typeName: String, ordinal: Int): String {
    let genericStart: Int(stringIndexOf(source: typeName, needle: String("<"), start: 0))
    if genericStart < 0 || ordinal < 0 { return String("") }
    state depth: Int(0)
    state argumentOrdinal: Int(0)
    state argumentStart: Int(genericStart + 1)
    state index: Int(genericStart + 1)
    let length: Int(stringLength(value: typeName))
    while index < length {
        let character: String(stringCharacterAt(source: typeName, index: index))
        if character == String("<") {
            depth: depth + 1
        } else if character == String(">") {
            if depth == 0 {
                if argumentOrdinal == ordinal { return typeName.substring(start: argumentStart, end: index) }
                return String("")
            }
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            if argumentOrdinal == ordinal { return typeName.substring(start: argumentStart, end: index) }
            argumentOrdinal: argumentOrdinal + 1
            argumentStart: index + 1
        }
        index: index + 1
    }
    return String("")
}

function compilerBodyArenaGenericArgumentCount(typeName: String): Int {
    let genericStart: Int(stringIndexOf(source: typeName, needle: String("<"), start: 0))
    if genericStart < 0 { return 0 }
    state count: Int(0)
    while compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: count) != String("") { count: count + 1 }
    return count
}

function compilerIntegerTypeIsUnsigned8(typeName: String): Bool {
    if compilerBodyArenaTypeOuterName(typeName: typeName) != String("Int")
        || compilerBodyArenaGenericArgumentCount(typeName: typeName) != 2 { return false }
    let bits: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 0))
    let signedness: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 1))
    let bitsRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: bits, start: 0, end: stringLength(value: bits)))
    let signednessRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: signedness, start: 0, end: stringLength(value: signedness)))
    return bitsRange.start >= 0 && signednessRange.start >= 0
        && compilerSemanticStringRangeEqualsText(text: bits, start: bitsRange.start, end: bitsRange.end, literal: String("8"))
        && compilerSemanticStringRangeEqualsText(text: signedness, start: signednessRange.start, end: signednessRange.end, literal: String(".unsigned"))
}

function compilerFloatTypeBitWidth(typeName: String): Int {
    if compilerBodyArenaTypeOuterName(typeName: typeName) != String("Float")
        || compilerBodyArenaGenericArgumentCount(typeName: typeName) != 1 { return 0 - 1 }
    let bits: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 0))
    let bitsRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: bits, start: 0, end: stringLength(value: bits)))
    if bitsRange.start < 0 { return 0 - 1 }
    if compilerSemanticStringRangeEqualsText(text: bits, start: bitsRange.start, end: bitsRange.end, literal: String("32")) { return 32 }
    if compilerSemanticStringRangeEqualsText(text: bits, start: bitsRange.start, end: bitsRange.end, literal: String("64")) { return 64 }
    return 0 - 1
}

function compilerFloatTypeIs32(typeName: String): Bool {
    return compilerFloatTypeBitWidth(typeName: typeName) == 32
}

function compilerFloatTypeIs64(typeName: String): Bool {
    return compilerFloatTypeBitWidth(typeName: typeName) == 64
}

function compilerMacroDiagnosticsOperationForName(name: String): Int {
    if name == String("information") { return compilerMacroOperationInformation() }
    if name == String("warning") { return compilerMacroOperationWarning() }
    if name == String("hint") { return compilerMacroOperationHint() }
    if name == String("error") { return compilerMacroOperationError() }
    return 0
}

function compilerMacroGraphOperationForName(name: String): Int {
    if name == String("declarationCount") { return compilerMacroGraphOperationDeclarationCount() }
    return 0
}

function compilerMacroTargetOperationForName(name: String): Int {
    if name == String("omit") { return compilerMacroTargetOperationOmit() }
    if name == String("memberCount") { return compilerMacroTargetOperationMemberCount() }
    return 0
}

function compilerMacroDiagnosticsSeverityForOperation(operation: Int): Int {
    if operation == compilerMacroOperationInformation() { return compilerMacroSeverityInformation() }
    if operation == compilerMacroOperationWarning() { return compilerMacroSeverityWarning() }
    if operation == compilerMacroOperationHint() { return compilerMacroSeverityHint() }
    if operation == compilerMacroOperationError() { return compilerMacroSeverityError() }
    return 0
}

function compilerMacroCapabilityTypeKind(kind: Int): Int {
    if kind == compilerMacroCapabilityTarget() { return compilerBodyTypeMacroTarget() }
    if kind == compilerMacroCapabilityDiagnostics() { return compilerBodyTypeMacroDiagnostics() }
    if kind == compilerMacroCapabilityGraph() { return compilerBodyTypeMacroGraph() }
    return compilerBodyTypeUnknown()
}

function compilerMacroCapabilityKindForTypeKind(typeKind: Int): Int {
    if typeKind == compilerBodyTypeMacroTarget() { return compilerMacroCapabilityTarget() }
    if typeKind == compilerBodyTypeMacroDiagnostics() { return compilerMacroCapabilityDiagnostics() }
    if typeKind == compilerBodyTypeMacroGraph() { return compilerMacroCapabilityGraph() }
    return 0
}

function compilerBodyArenaTypeKindForName(arena: CompilerBodyArena, typeName: String): Int {
    if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        let capabilityCount: Int(compilerIntTableRowCount(table: arena.tables.macroCapabilities))
        state capabilityRow: Int(0)
        while capabilityRow < capabilityCount {
            if compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 1) == arena.ownerDeclarationSyntaxID {
                let declarationFileID: Int(compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 1))
                let capabilityName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: declarationFileID, localStart: compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 4), localEnd: compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 5)))
                if capabilityName == typeName { return compilerMacroCapabilityTypeKind(kind: compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 3)) }
            }
            capabilityRow: capabilityRow + 1
        }
    }
    if typeName == String("Int") { return compilerBodyTypeInt() }
    if compilerIntegerTypeIsUnsigned8(typeName: typeName) { return compilerBodyTypeUnsigned8() }
    if typeName == String("Bool") { return compilerBodyTypeBool() }
    if typeName == String("String") { return compilerBodyTypeString() }
    if compilerFloatTypeIs32(typeName: typeName) { return compilerBodyTypeFloat32() }
    if compilerFloatTypeIs64(typeName: typeName) { return compilerBodyTypeFloat() }
    if typeName == String("Float") { return compilerBodyTypeFloat() }
    if typeName == String("Void") { return compilerBodyTypeVoid() }
    if compilerBodyRuntimeABITypeIsOpaque(tables: arena.tables, typeName: typeName) { return compilerBodyTypeConstruct() }
    let outerName: String(compilerBodyArenaTypeOuterName(typeName: typeName))
    if outerName == String("Optional") || compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: outerName, kindTag: compilerSyntaxKindConstruct()) >= 0 { return compilerBodyTypeConstruct() }
    if compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: outerName, kindTag: compilerSyntaxKindEnum()) >= 0 { return compilerBodyTypeEnum() }
    return compilerBodyTypeUnknown()
}

function compilerBodyArenaTypeByteIsWhitespace(byte: Int): Bool {
    return byte == 9 || byte == 10 || byte == 13 || byte == 32
}

function compilerBodyArenaTypeInvalidRange(): CompilerSourceRange {
    return CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
}

function compilerBodyArenaTypeRangeFromGlobal(arena: CompilerBodyArena, fileID: Int, globalStart: Int, globalEnd: Int): CompilerSourceRange {
    let localStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: fileID, globalOffset: globalStart))
    let localEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: fileID, globalOffset: globalEnd))
    if localStart < 0 || localEnd <= localStart { return compilerBodyArenaTypeInvalidRange() }
    return CompilerSourceRange(start: localStart, end: localEnd, next: localEnd)
}

function compilerBodyArenaNormalizedTypeRange(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): CompilerSourceRange {
    let invalidRange: CompilerSourceRange(compilerBodyArenaTypeInvalidRange())
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: start))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: end))
    if globalStart < 0 || globalEnd <= globalStart { return invalidRange }
    state trimmedGlobalStart: Int(globalStart)
    while trimmedGlobalStart < globalEnd
        && compilerBodyArenaTypeByteIsWhitespace(byte: stringByteAt(source: arena.tables.sourceStore.source, index: trimmedGlobalStart)) {
        trimmedGlobalStart: trimmedGlobalStart + 1
    }
    state trimmedGlobalEnd: Int(globalEnd)
    while trimmedGlobalEnd > trimmedGlobalStart
        && compilerBodyArenaTypeByteIsWhitespace(byte: stringByteAt(source: arena.tables.sourceStore.source, index: trimmedGlobalEnd - 1)) {
        trimmedGlobalEnd: trimmedGlobalEnd - 1
    }
    return compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: trimmedGlobalStart, globalEnd: trimmedGlobalEnd)
}

function compilerBodyArenaTypeGenericStartGlobal(arena: CompilerBodyArena, fileID: Int, typeRange: CompilerSourceRange): Int {
    if typeRange.start < 0 || typeRange.end <= typeRange.start { return 0 - 1 }
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: typeRange.start))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: typeRange.end))
    if globalStart < 0 || globalEnd <= globalStart { return 0 - 1 }
    state cursor: Int(globalStart)
    while cursor < globalEnd {
        if stringByteAt(source: arena.tables.sourceStore.source, index: cursor) == 60 { return cursor }
        cursor: cursor + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeOuterRangeForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): CompilerSourceRange {
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return normalizedRange }
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    if genericStartGlobal < 0 { return normalizedRange }
    let normalizedGlobalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.start))
    state outerGlobalEnd: Int(genericStartGlobal)
    while outerGlobalEnd > normalizedGlobalStart
        && compilerBodyArenaTypeByteIsWhitespace(byte: stringByteAt(source: arena.tables.sourceStore.source, index: outerGlobalEnd - 1)) {
        outerGlobalEnd: outerGlobalEnd - 1
    }
    return compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: normalizedGlobalStart, globalEnd: outerGlobalEnd)
}

function compilerBodyArenaTypeArgumentCountForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return 0 - 1 }
    let normalizedGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.end))
    if normalizedGlobalEnd > 0 && stringByteAt(source: arena.tables.sourceStore.source, index: normalizedGlobalEnd - 1) == 63 { return 1 }
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    if genericStartGlobal < 0 { return 0 }
    if normalizedGlobalEnd <= genericStartGlobal + 1 { return 0 - 1 }
    state depth: Int(0)
    state argumentCount: Int(1)
    state argumentStart: Int(genericStartGlobal + 1)
    state cursor: Int(genericStartGlobal + 1)
    state sawClosing: Bool(false)
    state valid: Bool(true)
    while cursor < normalizedGlobalEnd && !sawClosing && valid {
        let byte: Int(stringByteAt(source: arena.tables.sourceStore.source, index: cursor))
        if byte == 60 {
            depth: depth + 1
        } else if byte == 62 {
            if depth > 0 {
                depth: depth - 1
            } else {
                let argumentRange: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
                if argumentRange.start < 0 || cursor + 1 != normalizedGlobalEnd { valid: false } else { sawClosing: true }
            }
        } else if byte == 44 && depth == 0 {
            let argumentRange: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
            if argumentRange.start < 0 {
                valid: false
            } else {
                argumentCount: argumentCount + 1
                argumentStart: cursor + 1
            }
        }
        cursor: cursor + 1
    }
    if !valid || !sawClosing || depth != 0 { return 0 - 1 }
    return argumentCount
}

function compilerBodyArenaTypeArgumentRangeForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int, ordinal: Int): CompilerSourceRange {
    let invalidRange: CompilerSourceRange(compilerBodyArenaTypeInvalidRange())
    if ordinal < 0 { return invalidRange }
    let argumentCount: Int(compilerBodyArenaTypeArgumentCountForSpan(arena: arena, fileID: fileID, start: start, end: end))
    if argumentCount < 0 || ordinal >= argumentCount { return invalidRange }
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    let shorthandGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.end))
    if argumentCount == 1 && ordinal == 0 && shorthandGlobalEnd > 0
        && stringByteAt(source: arena.tables.sourceStore.source, index: shorthandGlobalEnd - 1) == 63 {
        return CompilerSourceRange(start: normalizedRange.start, end: normalizedRange.end - 1, next: normalizedRange.end - 1)
    }
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    let normalizedGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.end))
    state depth: Int(0)
    state argumentOrdinal: Int(0)
    state argumentStart: Int(genericStartGlobal + 1)
    state candidateStart: Int(0 - 1)
    state candidateEnd: Int(0 - 1)
    state cursor: Int(genericStartGlobal + 1)
    while cursor < normalizedGlobalEnd {
        let byte: Int(stringByteAt(source: arena.tables.sourceStore.source, index: cursor))
        if byte == 60 {
            depth: depth + 1
        } else if byte == 62 {
            if depth > 0 {
                depth: depth - 1
            } else {
                if argumentOrdinal == ordinal {
                    let candidate: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
                    candidateStart: candidate.start
                    candidateEnd: candidate.end
                }
                cursor: normalizedGlobalEnd
            }
        } else if byte == 44 && depth == 0 {
            if argumentOrdinal == ordinal {
                let candidate: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
                candidateStart: candidate.start
                candidateEnd: candidate.end
            }
            argumentOrdinal: argumentOrdinal + 1
            argumentStart: cursor + 1
        }
        cursor: cursor + 1
    }
    if candidateStart < 0 || candidateEnd <= candidateStart { return invalidRange }
    return CompilerSourceRange(start: candidateStart, end: candidateEnd, next: candidateEnd)
}

function compilerBodyArenaTypeKindForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
    if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        let macroTypeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: start, localEnd: end))
        return compilerBodyArenaTypeKindForName(arena: arena, typeName: macroTypeName)
    }
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return compilerBodyTypeUnknown() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Int")) { return compilerBodyTypeInt() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Bool")) { return compilerBodyTypeBool() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("String")) { return compilerBodyTypeString() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Float")) { return compilerBodyTypeFloat() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Void")) { return compilerBodyTypeVoid() }
    let normalizedTypeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: normalizedRange.start, localEnd: normalizedRange.end))
    if compilerIntegerTypeIsUnsigned8(typeName: normalizedTypeName) { return compilerBodyTypeUnsigned8() }
    if compilerFloatTypeIs32(typeName: normalizedTypeName) { return compilerBodyTypeFloat32() }
    if compilerFloatTypeIs64(typeName: normalizedTypeName) { return compilerBodyTypeFloat() }
    if compilerBodyArenaTypeOuterName(typeName: normalizedTypeName) == String("Optional") { return compilerBodyTypeConstruct() }
    let outerRange: CompilerSourceRange(compilerBodyArenaTypeOuterRangeForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end))
    if outerRange.start < 0 { return compilerBodyTypeUnknown() }
    let declarationSyntaxID: Int(compilerDeclarationIndexLocalRangeSyntaxID(tables: arena.tables, index: arena.declarationIndex, fileID: fileID, start: outerRange.start, end: outerRange.end, kindTag: compilerSyntaxKindConstruct()))
    if declarationSyntaxID >= 0 { return compilerBodyTypeConstruct() }
    let enumSyntaxID: Int(compilerDeclarationIndexLocalRangeSyntaxID(tables: arena.tables, index: arena.declarationIndex, fileID: fileID, start: outerRange.start, end: outerRange.end, kindTag: compilerSyntaxKindEnum()))
    if enumSyntaxID >= 0 { return compilerBodyTypeEnum() }
    return compilerBodyTypeUnknown()
}

function compilerBodyArenaTypeArgumentCountForTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.typeArguments) {
        if compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyArenaTypeArgumentValueForTypeID(arena: CompilerBodyArena, typeID: Int, ordinal: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) || ordinal < 0 { return 0 - 1 }
    state matches: Int(0)
    state value: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.typeArguments) {
        if compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID
            && compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentOrdinalColumn()) == ordinal {
            matches: matches + 1
            value: compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentValueTypeInstanceColumn())
        }
        row: row + 1
    }
    if matches != 1 { return 0 - 1 }
    return value
}

function compilerBodyArenaTypeArgumentExpectedCountForTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if nominalSyntaxID == compilerBodyBuiltinArraySyntaxID() { return 1 }
    if nominalSyntaxID >= 0 {
        let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: nominalSyntaxID))
        if genericCount > 0 { return genericCount }
    }
    let typeFileID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceFileColumn()))
    let typeStart: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceStartColumn()))
    let typeEnd: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceEndColumn()))
    let typeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: typeFileID, localStart: typeStart, localEnd: typeEnd))
    if compilerBodyArenaTypeOuterName(typeName: typeName) == String("Optional") { return 1 }
    return 0
}

function compilerBodyArenaTypeInstanceArgumentsMatch(arena: CompilerBodyArena, typeID: Int, argumentCount: Int, argumentIDs: RawBuffer): Bool {
    if compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID) != argumentCount { return false }
    state ordinal: Int(0)
    while ordinal < argumentCount {
        if compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: typeID, ordinal: ordinal) != rawBufferLoadInt(buffer: argumentIDs, index: ordinal) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaTypeInstanceFind(arena: CompilerBodyArena, typeKind: Int, nominalSyntaxID: Int, argumentCount: Int, argumentIDs: RawBuffer): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.typeInstances) {
        if compilerIntTableValue(table: arena.typeInstances, row: row, column: compilerBodyTypeInstanceKindColumn()) == typeKind
            && compilerIntTableValue(table: arena.typeInstances, row: row, column: compilerBodyTypeInstanceNominalSyntaxColumn()) == nominalSyntaxID
            && compilerBodyArenaTypeInstanceArgumentsMatch(arena: arena, typeID: row, argumentCount: argumentCount, argumentIDs: argumentIDs) { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaArrayDeclarationSyntaxID(arena: CompilerBodyArena): Int {
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: String("Array"), kindTag: compilerSyntaxKindConstruct()))
    if declarationRow < 0 { return compilerBodyBuiltinArraySyntaxID() }
    let syntaxID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0))
    if !compilerNominalDeclarationIsArray(tables: arena.tables, declarationRow: declarationRow) { return compilerBodyBuiltinArraySyntaxID() }
    return syntaxID
}

function compilerBodyArenaTypeInstanceInternStructuralAtSpan(arena: CompilerBodyArena, typeKind: Int, nominalSyntaxID: Int, fileID: Int, start: Int, end: Int, argumentIDs: RawBuffer): Int {
    if typeKind <= compilerBodyTypeUnknown() || typeKind > compilerBodyTypeLast()
        || fileID < 0 || start < 0 || end < start { return 0 - 1 }
    let argumentCount: Int(rawBufferCount(buffer: argumentIDs))
    let existing: Int(compilerBodyArenaTypeInstanceFind(arena: arena, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: argumentCount, argumentIDs: argumentIDs))
    if existing >= 0 { return existing }
    let typeID: Int(compilerIntTableRowCount(table: arena.typeInstances))
    if compilerIntTableAppend(table: arena.typeInstances, value: typeID) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: fileID) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: start) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: end) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: typeKind) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: nominalSyntaxID) != 0
        || compilerBodyArenaAppendTypeArguments(arena: arena, typeID: typeID, argumentIDs: argumentIDs) != 0 { return 0 - 1 }
    return typeID
}

function compilerBodyArenaTypeInstanceInternStructural(arena: CompilerBodyArena, typeKind: Int, nominalSyntaxID: Int, sourceNodeID: Int, argumentIDs: RawBuffer): Int {
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    return compilerBodyArenaTypeInstanceInternStructuralAtSpan(arena: arena, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, fileID: arena.fileID, start: compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 4), end: compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 5), argumentIDs: argumentIDs)
}

function compilerBodyArenaExpressionConcreteTypeID(arena: CompilerBodyArena, nodeID: Int): Int {
    let resolvedTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: nodeID))
    if resolvedTypeID >= 0 { return resolvedTypeID }
    let typeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeID))
    if typeKind != compilerBodyTypeInt() && typeKind != compilerBodyTypeUnsigned8() && typeKind != compilerBodyTypeBool() && typeKind != compilerBodyTypeFloat() && typeKind != compilerBodyTypeFloat32() && typeKind != compilerBodyTypeString() { return 0 - 1 }
    let noArguments: RawBuffer(rawBufferCreate(capacity: 0, stride: 4))
    let typeID: Int(compilerBodyArenaTypeInstanceInternStructural(arena: arena, typeKind: typeKind, nominalSyntaxID: 0 - 1, sourceNodeID: nodeID, argumentIDs: noArguments))
