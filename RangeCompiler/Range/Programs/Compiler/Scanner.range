construct ScannedRangeToken {
    let index: Int
    let start: Int
    let end: Int
    let text: String
}

function scanRangeSource(source: String): String {
    state output: ""
    state tokenIndex: Int(0)
    state sourceIndex: Int(0)

    while true {
        let maybeToken: Optional<ScannedRangeToken>(scanNextRangeToken(
            source: source,
            start: sourceIndex,
            index: tokenIndex
        ))

        if maybeToken == nil {
            return output
        }

        let fallback: ScannedRangeToken(ScannedRangeToken(index: 0, start: 0, end: 0, text: String("")))
        let token: ScannedRangeToken(maybeToken ?? fallback)
        output: "\(output)\(renderScannedRangeToken(token: token))"
        sourceIndex: token.end
        tokenIndex: tokenIndex + 1
    }

    return output
}

function scanNextRangeToken(source: String, start: Int, index: Int): Optional<ScannedRangeToken> {
    state sourceIndex: Int(start)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength {
        let character: String(source.character(index: sourceIndex))

        if isRangeScannerWhitespace(character: character) {
            sourceIndex: sourceIndex + 1
            continue
        }

        let tokenStart: Int(sourceIndex)

        if character == String("\"") {
            sourceIndex: scanRangeScannerString(source: source, start: sourceIndex)
        } else if isRangeScannerDelimiter(character: character) {
            sourceIndex: sourceIndex + 1
        } else {
            sourceIndex: scanRangeScannerWord(source: source, start: sourceIndex)
        }

        return ScannedRangeToken(
            index: index,
            start: tokenStart,
            end: sourceIndex,
            text: source.substring(start: tokenStart, end: sourceIndex)
        )
    }

    return nil
}

function renderScannedRangeToken(token: ScannedRangeToken): String {
    return "\(token.index)\t\(token.text)\n"
}

function isRangeScannerWhitespace(character: String): Bool {
    return character == String(" ") || character == String("\n") || character == String("\t")
}

function isRangeScannerDelimiter(character: String): Bool {
    return character == String("{") || character == String("}") || character == String("(") || character == String(")")
        || character == String("[") || character == String("]") || character == String(":") || character == String(",")
}

function scanRangeScannerString(source: String, start: Int): Int {
    state sourceIndex: Int(start + 1)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength && source.character(index: sourceIndex) != String("\"") {
        sourceIndex: sourceIndex + 1
    }

    if sourceIndex < sourceLength {
        return sourceIndex + 1
    }

    return sourceIndex
}

function scanRangeScannerWord(source: String, start: Int): Int {
    state sourceIndex: Int(start)
    let sourceLength: Int(stringLength(value: source))

    while sourceIndex < sourceLength {
        let current: String(source.character(index: sourceIndex))
        if isRangeScannerWhitespace(character: current) || isRangeScannerDelimiter(character: current) {
            return sourceIndex
        }
        sourceIndex: sourceIndex + 1
    }

    return sourceIndex
}
