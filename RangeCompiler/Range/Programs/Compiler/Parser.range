construct ParsedMainBlock {
    let attributeStart: Int
    let bodyStart: Int
    let bodyEnd: Int
}

construct ParsedFunctionDeclaration {
    let name: String
    let keywordStart: Int
    let bodyStart: Int
    let bodyEnd: Int
}

construct Stage2MainFunction {
    let name: String
    let bodyStart: Int
    let bodyEnd: Int
}

function parseRangeSource(source: String): String {
    let mainBlock: Optional<ParsedMainBlock>(parseRangeMainBlock(source: source))
    let functionSummary: String(parseRangeFunctionDeclarations(source: source))

    if mainBlock == nil {
        return "\(String("parse\tnoMainBlock\n"))\(functionSummary)"
    }

    let fallback: ParsedMainBlock(ParsedMainBlock(attributeStart: 0, bodyStart: 0, bodyEnd: 0))
    let parsed: ParsedMainBlock(mainBlock ?? fallback)
    let stage2Main: Stage2MainFunction(lowerMainBlockToStage2MainFunction(mainBlock: parsed))
    return "parse\tmainBlock\tattributeStart=\(parsed.attributeStart)\tbodyStart=\(parsed.bodyStart)\tbodyEnd=\(parsed.bodyEnd)\n\(renderStage2MainFunction(function: stage2Main))\(functionSummary)"
}

function parseRangeMainBlock(source: String): Optional<ParsedMainBlock> {
    state sourceIndex: Int(0)
    state sawMainAttribute: Bool(false)
    state mainAttributeStart: Int(0)
    state bodyStart: Int(0)
    state bodyDepth: Int(0)

    while true {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))

        if maybeToken == nil {
            return nil
        }

        let fallback: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
        let token: RangeLexedToken(maybeToken ?? fallback)

        if !sawMainAttribute {
            if token.kind == String("macroAttribute") && token.text == String("@main") {
                sawMainAttribute: true
                mainAttributeStart: token.start
            }
        } else if bodyDepth == 0 {
            if token.kind == String("leftBrace") {
                bodyStart: token.end
                bodyDepth: 1
            }
        } else {
            if token.kind == String("leftBrace") {
                bodyDepth: bodyDepth + 1
            } else if token.kind == String("rightBrace") {
                bodyDepth: bodyDepth - 1
                if bodyDepth == 0 {
                    return ParsedMainBlock(
                        attributeStart: mainAttributeStart,
                        bodyStart: bodyStart,
                        bodyEnd: token.start
                    )
                }
            }
        }

        sourceIndex: token.end
    }

    return nil
}

function lowerMainBlockToStage2MainFunction(mainBlock: ParsedMainBlock): Stage2MainFunction {
    return Stage2MainFunction(
        name: String("main"),
        bodyStart: mainBlock.bodyStart,
        bodyEnd: mainBlock.bodyEnd
    )
}

function renderStage2MainFunction(function: Stage2MainFunction): String {
    return "stage2\tmainFunction\tname=\(function.name)\tbodyStart=\(function.bodyStart)\tbodyEnd=\(function.bodyEnd)\n"
}

function parseRangeFunctionDeclarations(source: String): String {
    state output: ""
    state sourceIndex: Int(0)

    while true {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))

        if maybeToken == nil {
            return output
        }

        let fallback: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: sourceIndex, end: sourceIndex, text: String("")))
        let token: RangeLexedToken(maybeToken ?? fallback)

        if token.kind == String("keyword") && token.text == String("function") {
            let maybeFunction: Optional<ParsedFunctionDeclaration>(parseRangeFunctionDeclaration(source: source, keyword: token))
            if maybeFunction != nil {
                let functionFallback: ParsedFunctionDeclaration(ParsedFunctionDeclaration(name: String(""), keywordStart: 0, bodyStart: 0, bodyEnd: 0))
                let declaration: ParsedFunctionDeclaration(maybeFunction ?? functionFallback)
                output: "\(output)parse\tfunction\tname=\(declaration.name)\tkeywordStart=\(declaration.keywordStart)\tbodyStart=\(declaration.bodyStart)\tbodyEnd=\(declaration.bodyEnd)\n"
                sourceIndex: declaration.bodyEnd + 1
                continue
            }
        }

        sourceIndex: token.end
    }

    return output
}

function parseRangeFunctionDeclaration(source: String, keyword: RangeLexedToken): Optional<ParsedFunctionDeclaration> {
    let maybeName: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: keyword.end))

    if maybeName == nil {
        return nil
    }

    let fallback: RangeLexedToken(RangeLexedToken(kind: String("eof"), start: keyword.end, end: keyword.end, text: String("")))
    let name: RangeLexedToken(maybeName ?? fallback)

    if name.kind != String("identifier") {
        return nil
    }

    state sourceIndex: Int(0)
    sourceIndex: name.end
    state bodyDepth: Int(0)
    state bodyStart: Int(0)

    while true {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: sourceIndex))

        if maybeToken == nil {
            return nil
        }

        let token: RangeLexedToken(maybeToken ?? fallback)

        if bodyDepth == 0 {
            if token.kind == String("leftBrace") {
                bodyStart: token.end
                bodyDepth: 1
            }
        } else {
            if token.kind == String("leftBrace") {
                bodyDepth: bodyDepth + 1
            } else if token.kind == String("rightBrace") {
                bodyDepth: bodyDepth - 1
                if bodyDepth == 0 {
                    return ParsedFunctionDeclaration(
                        name: name.text,
                        keywordStart: keyword.start,
                        bodyStart: bodyStart,
                        bodyEnd: token.start
                    )
                }
            }
        }

        sourceIndex: token.end
    }

    return nil
}
