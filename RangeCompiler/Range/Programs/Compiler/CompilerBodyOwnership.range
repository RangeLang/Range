            }
            currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
        }
    }
    if status != 0 {
        rawBufferDestroy(buffer: members)
        return 0 - 2
    }
    state effectPathID: Int(0 - 1)
    state reverseOrdinal: Int(rawBufferCount(buffer: members) - 1)
    while reverseOrdinal >= 0 && status == 0 {
        let nextPathID: Int(compilerBodyFunctionInstanceEffectPathAppend(paths: effectPaths, parentPathID: effectPathID, memberRow: rawBufferLoadInt(buffer: members, index: reverseOrdinal)))
