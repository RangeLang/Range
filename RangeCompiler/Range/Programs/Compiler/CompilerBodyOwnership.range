    state pathID: Int(0)
    while pathID < pathCount {
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathID, ancestorPathID: rootPathID)
            && compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn())) {
            if !compilerBodyArenaOwnedPathOpaqueLeafCanDeactivateAt(arena: arena, states: states, origins: origins, pathID: pathID, blockID: blockID, pathCount: pathCount) { return false }
            leafCount: leafCount + 1
        }
        pathID: pathID + 1
    }
    return leafCount > 0
}

function compilerBodyArenaOwnedPathSetSubtreeAbsent(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, rootPathID: Int): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
