                let entryState: Int(compilerBodyArenaOwnedPathProjectedEdgeStateCached(states: states, sourceBlockID: entryPredecessorID, pathRoots: pathRoots, projection: projectionA, pathID: pathID, pathCount: pathCount))
                let backedgeState: Int(compilerBodyArenaOwnedPathProjectedEdgeStateCached(states: states, sourceBlockID: sourceBlockID, pathRoots: pathRoots, projection: projectionB, pathID: pathID, pathCount: pathCount))
                let entryOrigin: Int(compilerBodyArenaOwnedPathProjectedEdgeOriginCached(origins: origins, sourceBlockID: entryPredecessorID, pathRoots: pathRoots, projection: projectionA, pathID: pathID, pathCount: pathCount))
                let backedgeOrigin: Int(compilerBodyArenaOwnedPathProjectedEdgeOriginCached(origins: origins, sourceBlockID: sourceBlockID, pathRoots: pathRoots, projection: projectionB, pathID: pathID, pathCount: pathCount))
                if entryState == compilerBodyOwnedPathUnknown() || backedgeState == compilerBodyOwnedPathUnknown()
                    || entryOrigin == compilerBodyOwnedOriginInvalid() || backedgeOrigin == compilerBodyOwnedOriginInvalid()
                    || backedgeState != entryState || backedgeOrigin != entryOrigin { return false }
