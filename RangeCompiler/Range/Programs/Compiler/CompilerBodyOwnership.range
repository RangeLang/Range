                                } else if rawBufferAppendInt(buffer: pending, value: fieldTypeID) != 0 { status: 0 - 1 }
                                if status == 0 { pendingCount: pendingCount + 1 }
                            }
                        }
                    }
                    memberRow: memberRow + 1
                }
            }
        }
    }
    if rawBufferDestroy(buffer: pending) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: visited) != 0 { status: 0 - 1 }
    if status != 0 { return status }
