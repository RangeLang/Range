function compilerBodyArenaOwnedPathSetSubtreeState(arena: CompilerBodyArena, states: RawBuffer, rootPathID: Int, expectedState: Int, nextState: Int): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    if rootPathID < 0 || rootPathID >= pathCount || rawBufferCount(buffer: states) < pathCount { return 0 - 1 }
