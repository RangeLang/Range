            }
            else if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: candidate) == compilerBodyTypeConstruct() {
                let receiverSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: candidate, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
                state memberRow: Int(0)
                if receiverSyntaxID < 0 { status: 0 - 1 }
                while memberRow < compilerIntTableRowCount(table: arena.tables.members) && status == 0 {
                    if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == receiverSyntaxID {
                        let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
                        if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() || memberKind == compilerSyntaxMemberKindBinding() {
                            let fieldTypeID: Int(compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: candidate, memberRow: memberRow))
                            if fieldTypeID < 0 {
                                status: 0 - 1
                            } else if !compilerBodyArenaTypeListContains(values: visited, value: fieldTypeID) {
                                if pendingCount < rawBufferCount(buffer: pending) {
