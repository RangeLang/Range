function compilerBodyMIROperationIsOwnershipOrEffectBarrier(kind: Int): Bool {
    return kind == compilerBodyMIROperationAssignVersion()
        || kind == compilerBodyMIROperationMemberRead()
        || kind == compilerBodyMIROperationConstruct()
        || kind == compilerBodyMIROperationOptionalSome()
        || kind == compilerBodyMIROperationOptionalPayload()
        || kind == compilerBodyMIROperationStringConcat()
        || kind == compilerBodyMIROperationStringOwnedCopy()
        || kind == compilerBodyMIROperationStringAppendOwned()
        || kind == compilerBodyMIROperationStringFromInt()
        || kind == compilerBodyMIROperationStringFromBool()
        || kind == compilerBodyMIROperationMemberAssign()
        || kind == compilerBodyMIROperationEnumConstruct()
        || kind == compilerBodyMIROperationEnumPayload()
        || kind == compilerBodyMIROperationArrayLiteral()
        || kind == compilerBodyMIROperationArrayIndex()
        || kind == compilerBodyMIROperationArrayCount()
        || kind == compilerBodyMIROperationArrayStore()
}

function compilerBodyGraphZeroSourceHasOwnershipOrEffectBarrier(arena: CompilerBodyArena, sourceNodeID: Int): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()) == sourceNodeID {
            let kind: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()))
            if kind == compilerBodyMemoryFactWriteUnique()
                || kind == compilerBodyMemoryFactMemberWrite()
                || kind == compilerBodyMemoryFactMove()
                || kind == compilerBodyMemoryFactSharedBorrow()
                || kind == compilerBodyMemoryFactUniqueBorrow()
                || kind == compilerBodyMemoryFactConsume()
                || kind == compilerBodyMemoryFactDestruction() { return true }
        }
        row: row + 1
    }
    return false
}

function compilerBodyMIROperationRequiresOrder(arena: CompilerBodyArena, kind: Int, sourceNodeID: Int): Bool {
    return compilerBodyMIROperationIsOwnershipOrEffectBarrier(kind: kind)
        || compilerBodyGraphZeroSourceHasOwnershipOrEffectBarrier(arena: arena, sourceNodeID: sourceNodeID)
        || kind == compilerBodyMIROperationCondBranch()
        || kind == compilerBodyMIROperationBranch()
        || kind == compilerBodyMIROperationReturn()
        || kind == compilerBodyMIROperationPhi()
}

function compilerBodyMIRValueProducerOperationAny(arena: CompilerBodyArena, valueID: Int): Int {
    state producer: Int(0 - 1)
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()) == valueID {
            if producer >= 0 { return 0 - 2 }
            producer: operationRow
        }
