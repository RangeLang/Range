                                if instanceEffectStatus != 0 { status: 0 - 1 }
                            }
                            if status == 0 && targetKind == compilerBodyResolutionFunction() {
                                let returnTransferStatus: Int(compilerBodyArenaOwnedPathApplyReturnTransfer(arena: arena, applicationNodeID: nodeID, states: states, origins: origins, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, returnLeaves: returnLeaves, effectPaths: effectPaths, recordFacts: recordFacts))
