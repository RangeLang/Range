function compilerBodyStorageFactsAreValid(arena: CompilerBodyArena, storageID: Int): Bool {
    if compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCalleeReturn() {
        return compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnDestination()) == 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactInitialize()) >= 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactPlacement()) == 0
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnTransfer()) == 0
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactDestruction()) == 0
    }
    if compilerBodyStorageIsConstructInitialized(arena: arena, storageID: storageID) {
        return compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactPlacement()) == 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactInitialize()) == 1
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnTransfer()) == 0
            && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactDestruction()) == 1
    }
    return compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactPlacement()) == 1
        && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactInitialize()) == 1
        && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactReturnTransfer()) == 1
        && compilerBodyMemoryFactCountForStorage(arena: arena, storageID: storageID, kind: compilerBodyMemoryFactDestruction()) == 1
}

function compilerBodyAggregateMemoryValidationCode(arena: CompilerBodyArena): Int {
    if !compilerIntTableIsComplete(table: arena.memoryFacts) || !compilerIntTableIsComplete(table: arena.storages)
        || rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateCompletedPhase()) != compilerBodyMemoryPhaseLifetime()
        || rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateValid()) != 1 { return 1 }
    state row: Int(0)
    state priorPhase: Int(compilerBodyMemoryPhaseValue())
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        let phase: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactPhaseColumn()))
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactIDColumn()) != row
            || phase < priorPhase || phase < compilerBodyMemoryPhaseValue() || phase > compilerBodyMemoryPhaseLifetime() { return 2000 + row }
        priorPhase: phase
        row: row + 1
    }
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if !compilerBodyStorageIsValid(arena: arena, storageID: storageRow) { return 3000 + storageRow }
        if !compilerBodyStorageFactsAreValid(arena: arena, storageID: storageRow) { return 4000 + storageRow }
        storageRow: storageRow + 1
    }
    return 0
}

function compilerBodyAggregateMemoryFactsAreValid(arena: CompilerBodyArena): Bool {
