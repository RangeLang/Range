        && compilerIntTableValue(table: arena.ownedPaths, row: originPathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyBorrowed()
        && compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: originPathID, column: compilerBodyOwnedPathTypeColumn()))
