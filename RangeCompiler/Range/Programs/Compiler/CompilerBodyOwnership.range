    if compilerIntTableAppend(table: arena.mirExpressionValues, value: nodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: action) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: valueID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirExpressionValues, value: blockID) != 0 { return 0 - 1 }
    return row
}

function compilerBodyMIRLatestVersionInBlock(arena: CompilerBodyArena, symbolID: Int, blockID: Int): Int {
    state result: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirVersions) {
        if compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionSymbolColumn()) == symbolID
            && compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionBlockColumn()) == blockID { result: compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionValueColumn()) }
        row: row + 1
    }
    return result
}

function compilerBodyMIRUniqueVersionForSymbol(arena: CompilerBodyArena, symbolID: Int): Int {
    state valueID: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirVersions) {
        if compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionSymbolColumn()) == symbolID {
            if valueID >= 0 { return 0 - 2 }
            valueID: compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionValueColumn())
        }
        row: row + 1
    }
    return valueID
}

function compilerBodyMIRValueForSymbolAtBlockMemo(arena: CompilerBodyArena, symbolID: Int, blockID: Int, memo: RawBuffer): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: arena.cfgBlocks) { return 0 - 1 }
    let memoizedValueID: Int(rawBufferLoadInt(buffer: memo, index: blockID))
    if memoizedValueID == 0 - 3 { return 0 - 1 }
    if memoizedValueID != 0 - 2 { return memoizedValueID }
    if rawBufferStoreInt(buffer: memo, index: blockID, value: 0 - 3) != 0 { return 0 - 1 }
    let localValueID: Int(compilerBodyMIRLatestVersionInBlock(arena: arena, symbolID: symbolID, blockID: blockID))
    if localValueID >= 0 {
        rawBufferStoreInt(buffer: memo, index: blockID, value: localValueID)
        return localValueID
    }
    state inheritedValueID: Int(0 - 1)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
            && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) != compilerBodyCFGEdgeBackedge() {
            let predecessorID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()))
            let predecessorValueID: Int(compilerBodyMIRValueForSymbolAtBlockMemo(arena: arena, symbolID: symbolID, blockID: predecessorID, memo: memo))
            if predecessorValueID < 0 {
                rawBufferStoreInt(buffer: memo, index: blockID, value: 0 - 1)
                return 0 - 1
            }
            if inheritedValueID >= 0 && inheritedValueID != predecessorValueID {
                rawBufferStoreInt(buffer: memo, index: blockID, value: 0 - 1)
                return 0 - 1
            }
            inheritedValueID: predecessorValueID
        }
        edgeRow: edgeRow + 1
    }
    rawBufferStoreInt(buffer: memo, index: blockID, value: inheritedValueID)
    return inheritedValueID
}

function compilerBodyMIRValueForSymbolAtBlock(arena: CompilerBodyArena, symbolID: Int, blockID: Int): Int {
    let memo: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.cfgBlocks), stride: 4))
    while rawBufferCount(buffer: memo) < compilerIntTableRowCount(table: arena.cfgBlocks) { rawBufferAppendInt(buffer: memo, value: 0 - 2) }
    let valueID: Int(compilerBodyMIRValueForSymbolAtBlockMemo(arena: arena, symbolID: symbolID, blockID: blockID, memo: memo))
    rawBufferDestroy(buffer: memo)
    return valueID
}

function compilerBodyMemoryHasFact(arena: CompilerBodyArena, kind: Int, sourceNodeID: Int, subjectID: Int): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()) == kind
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()) == sourceNodeID
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()) == subjectID { return true }
        row: row + 1
    }
    return false
}

function compilerBodyArenaTypeIDIsOpaqueStorage(arena: CompilerBodyArena, typeID: Int): Bool {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances)
        || compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()) != compilerBodyTypeConstruct() { return false }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    return nominalSyntaxID >= 0 && compilerRuntimeABIConstructKind(tables: arena.tables, constructNodeID: nominalSyntaxID) == compilerRuntimeABIOpaqueStorage()
}

function compilerBodyArenaOwnedFieldTypeID(arena: CompilerBodyArena, receiverTypeID: Int, memberRow: Int): Int {
    if receiverTypeID < 0 || receiverTypeID >= compilerIntTableRowCount(table: arena.typeInstances)
        || memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    let receiverSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: receiverTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    let memberOwnerSyntaxID: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2))
    let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
    if receiverSyntaxID < 0 || receiverSyntaxID != memberOwnerSyntaxID
        || (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState()) { return 0 - 1 }
    return compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: receiverTypeID, memberRow: memberRow)
}

function compilerBodyArenaRuntimeBuiltinRoleForApplication(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionRuntimeBuiltin()
        || compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindIdentifier() { return compilerRuntimeABIFunctionNone() }
    let functionName: String(compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: functionName, kindTag: compilerSyntaxKindFunction()))
    if declarationRow < 0 { return compilerRuntimeABIFunctionNone() }
    let functionSyntaxID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0))
    return compilerRuntimeABIFunctionRole(tables: arena.tables, functionNodeID: functionSyntaxID)
}

function compilerBodyArenaSymbolForDeclaration(arena: CompilerBodyArena, declarationNodeID: Int): Int {
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        if compilerBodySymbolOwnsLocalStorage(kind: compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolKindColumn()))
            && compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolDeclarationColumn()) == declarationNodeID { return symbolRow }
        symbolRow: symbolRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaParameterOrdinalForSymbol(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolParameter() { return 0 - 1 }
    let parameterRow: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: arena.tables.parameters) { return 0 - 1 }
    return compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 3)
}

function compilerBodyArenaValueCarriesBindingReference(arena: CompilerBodyArena, valueNodeID: Int): Bool {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    state currentNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        let currentKind: Int(compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1))
        if currentKind == compilerSyntaxKindBindingReference() { return true }
        state nextNodeID: Int(0 - 1)
        if currentKind == compilerSyntaxKindGrouping() {
            nextNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0)
        } else if currentKind == compilerSyntaxKindMemberRead() {
            nextNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
        } else {
            return false
        }
        if nextNodeID < 0 || nextNodeID >= compilerIntTableRowCount(table: arena.nodes) || nextNodeID == currentNodeID { return false }
        currentNodeID: nextNodeID
        step: step + 1
    }
    return false
}

function compilerBodyArenaValueLocalSymbolID(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let valueKind: Int(compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1))
    if valueKind == compilerSyntaxKindGrouping() {
        return compilerBodyArenaValueLocalSymbolID(arena: arena, valueNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
    }
    if valueKind != compilerSyntaxKindIdentifier() && valueKind != compilerSyntaxKindBindingReference() { return 0 - 1 }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: valueNodeID))
    if resolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn())
}

function compilerBodyArenaMemberReceiverSymbolForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: valueNodeID))
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: valueNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    let receiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: receiverNodeID))
    if memberResolutionRow < 0 || receiverNodeID < 0 || receiverResolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember()
        || compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTargetIDColumn())
}

function compilerBodyArenaMemberRowForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: valueNodeID))
    if memberResolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetIDColumn())
}

function compilerBodyArenaFirstArgumentValue(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
    if argumentNodeID < 0 { return 0 - 1 }
    return compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0)
}

function compilerBodyOwnedPathFind(paths: CompilerIntTable, rootKind: Int, rootID: Int, memberRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: paths) {
        if compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathRootKindColumn()) == rootKind
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathRootIDColumn()) == rootID
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathParentColumn()) == 0 - 1
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathMemberColumn()) == memberRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyOwnedPathFindChild(paths: CompilerIntTable, parentPathID: Int, memberRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: paths) {
        if compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathParentColumn()) == parentPathID
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyOwnedPathMemberColumn()) == memberRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyOwnedPathAppend(paths: CompilerIntTable, rootKind: Int, rootID: Int, parentPathID: Int, memberRow: Int, typeID: Int, policy: Int): Int {
    let pathID: Int(compilerIntTableRowCount(table: paths))
    if parentPathID < 0 {
        if compilerBodyOwnedPathFind(paths: paths, rootKind: rootKind, rootID: rootID, memberRow: memberRow) >= 0 { return 0 - 1 }
    } else if compilerBodyOwnedPathFindChild(paths: paths, parentPathID: parentPathID, memberRow: memberRow) >= 0 {
        return 0 - 1
    }
    if compilerIntTableAppend(table: paths, value: pathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: rootKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: rootID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: parentPathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: memberRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: typeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: policy) != 0 { return 0 - 1 }
    return pathID
}

function compilerBodyBindingAliasFind(aliases: CompilerIntTable, destinationPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: aliases) {
        if compilerIntTableValue(table: aliases, row: row, column: compilerBodyBindingAliasDestinationPathColumn()) == destinationPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaBindingAliasCanonicalPath(arena: CompilerBodyArena, pathID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    state currentPathID: Int(pathID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.bindingAliases) + 1)
    while step < maximumSteps {
        let aliasRow: Int(compilerBodyBindingAliasFind(aliases: arena.bindingAliases, destinationPathID: currentPathID))
        if aliasRow < 0 { return currentPathID }
        let sourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: aliasRow, column: compilerBodyBindingAliasSourcePathColumn()))
        if sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths) || sourcePathID == currentPathID { return 0 - 1 }
        currentPathID: sourcePathID
        step: step + 1
    }
    return 0 - 1
}

function compilerBodyArenaOwnedPathStorageID(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 { return 0 - 1 }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
    let rootID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if rootKind == compilerBodyOwnedPathRootSymbol() { return compilerBodyStorageForSymbol(arena: arena, symbolID: rootID) }
    if rootKind == compilerBodyOwnedPathRootValue() { return compilerBodyStorageForCall(arena: arena, callNodeID: rootID) }
    return 0 - 1
}

function compilerBodyBindingAliasAppendWithProvenance(arena: CompilerBodyArena, destinationPathID: Int, sourcePathID: Int, sourceNodeID: Int, provenanceKind: Int): Int {
    if destinationPathID < 0 || destinationPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || (provenanceKind != compilerBodyBindingAliasProvenanceExplicit() && provenanceKind != compilerBodyBindingAliasProvenanceReturnedCall())
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyAlias() { return 0 - 1 }
    let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
    if canonicalSourcePathID < 0 || canonicalSourcePathID == destinationPathID
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: canonicalSourcePathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
    let sourceStorageID: Int(compilerBodyArenaOwnedPathStorageID(arena: arena, pathID: canonicalSourcePathID))
    let existingRow: Int(compilerBodyBindingAliasFind(aliases: arena.bindingAliases, destinationPathID: destinationPathID))
    if existingRow >= 0 {
        let existingSourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: existingRow, column: compilerBodyBindingAliasSourcePathColumn()))
        let canonicalExistingSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: existingSourcePathID))
        if canonicalExistingSourcePathID < 0 || canonicalExistingSourcePathID != canonicalSourcePathID
            || compilerIntTableValue(table: arena.bindingAliases, row: existingRow, column: compilerBodyBindingAliasSourceNodeColumn()) != sourceNodeID
            || compilerIntTableValue(table: arena.bindingAliases, row: existingRow, column: compilerBodyBindingAliasProvenanceColumn()) != provenanceKind { return 0 - 1 }
        if rawBufferStoreInt(buffer: arena.bindingAliases.values, index: existingRow * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourcePathColumn(), value: canonicalSourcePathID) != 0
            || rawBufferStoreInt(buffer: arena.bindingAliases.values, index: existingRow * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourceStorageColumn(), value: sourceStorageID) != 0 { return 0 - 1 }
        return existingRow
    }
    let aliasID: Int(compilerIntTableRowCount(table: arena.bindingAliases))
    if compilerIntTableAppend(table: arena.bindingAliases, value: aliasID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: destinationPathID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: canonicalSourcePathID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: sourceStorageID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: sourceNodeID) != 0
        || compilerIntTableAppend(table: arena.bindingAliases, value: provenanceKind) != 0 { return 0 - 1 }
    return aliasID
}

function compilerBodyBindingAliasAppend(arena: CompilerBodyArena, destinationPathID: Int, sourcePathID: Int, sourceNodeID: Int): Int {
    return compilerBodyBindingAliasAppendWithProvenance(arena: arena, destinationPathID: destinationPathID, sourcePathID: sourcePathID, sourceNodeID: sourceNodeID, provenanceKind: compilerBodyBindingAliasProvenanceExplicit())
}

function compilerBodyArenaBindingAliasNormalize(arena: CompilerBodyArena): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.bindingAliases) {
        let destinationPathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasDestinationPathColumn()))
        let sourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourcePathColumn()))
        let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
        if destinationPathID < 0 || destinationPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || canonicalSourcePathID < 0 || canonicalSourcePathID == destinationPathID
            || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: canonicalSourcePathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
        let sourceStorageID: Int(compilerBodyArenaOwnedPathStorageID(arena: arena, pathID: canonicalSourcePathID))
        if rawBufferStoreInt(buffer: arena.bindingAliases.values, index: row * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourcePathColumn(), value: canonicalSourcePathID) != 0
            || rawBufferStoreInt(buffer: arena.bindingAliases.values, index: row * compilerBodyBindingAliasColumnCount() + compilerBodyBindingAliasSourceStorageColumn(), value: sourceStorageID) != 0 { return 0 - 1 }
        row: row + 1
    }
    return 0
}

function compilerBodyArenaOwnedPathRelativeTarget(arena: CompilerBodyArena, sourceRootPathID: Int, destinationRootPathID: Int, destinationPathID: Int): Int {
    if sourceRootPathID < 0 || destinationRootPathID < 0 || destinationPathID < 0
        || !compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: destinationPathID, ancestorPathID: destinationRootPathID) { return 0 - 1 }
    let members: RawBuffer(rawBufferCreate(capacity: 8, stride: 4))
    state currentPathID: Int(destinationPathID)
    state status: Int(0)
    while currentPathID != destinationRootPathID && status == 0 {
        if currentPathID < 0 || currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) {
            status: 0 - 1
        } else {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn()))
            if memberRow < 0 || rawBufferAppendInt(buffer: members, value: memberRow) != 0 { status: 0 - 1 }
            currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
        }
    }
    state sourcePathID: Int(sourceRootPathID)
    state reverseOrdinal: Int(rawBufferCount(buffer: members) - 1)
    while reverseOrdinal >= 0 && status == 0 {
        sourcePathID: compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: sourcePathID, memberRow: rawBufferLoadInt(buffer: members, index: reverseOrdinal))
        if sourcePathID < 0 { status: 0 - 1 }
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: members)
    if status != 0 { return 0 - 1 }
    return sourcePathID
}

function compilerBodyArenaBindingAliasAppendSubtree(arena: CompilerBodyArena, destinationRootPathID: Int, sourceRootPathID: Int, sourceNodeID: Int): Int {
    if destinationRootPathID < 0 || sourceRootPathID < 0
        || compilerIntTableValue(table: arena.ownedPaths, row: destinationRootPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: sourceRootPathID, column: compilerBodyOwnedPathTypeColumn()) { return 0 - 1 }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathRow, ancestorPathID: destinationRootPathID) {
            let sourcePathID: Int(compilerBodyArenaOwnedPathRelativeTarget(arena: arena, sourceRootPathID: sourceRootPathID, destinationRootPathID: destinationRootPathID, destinationPathID: pathRow))
            if sourcePathID < 0 || compilerBodyBindingAliasAppend(arena: arena, destinationPathID: pathRow, sourcePathID: sourcePathID, sourceNodeID: sourceNodeID) < 0 { return 0 - 1 }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaBindingAliasReturnedCallNodeIsValid(arena: CompilerBodyArena, sourceNodeID: Int): Bool {
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 1) != compilerSyntaxKindApplication() { return false }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    return calleeNodeID >= 0 && resolutionRow >= 0
        && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction()
}

function compilerBodyArenaBindingAliasValidationCode(arena: CompilerBodyArena): Int {
    if !compilerIntTableIsComplete(table: arena.bindingAliases) { return 1 }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.bindingAliases) {
        let destinationPathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasDestinationPathColumn()))
        let sourcePathID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourcePathColumn()))
        let sourceStorageID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourceStorageColumn()))
        let sourceNodeID: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasSourceNodeColumn()))
        let provenanceKind: Int(compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasProvenanceColumn()))
        state provenanceIsValid: Bool(false)
        if provenanceKind == compilerBodyBindingAliasProvenanceExplicit() {
            provenanceIsValid: compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: sourceNodeID)
        } else if provenanceKind == compilerBodyBindingAliasProvenanceReturnedCall() {
            provenanceIsValid: compilerBodyArenaBindingAliasReturnedCallNodeIsValid(arena: arena, sourceNodeID: sourceNodeID)
        }
        if compilerIntTableValue(table: arena.bindingAliases, row: row, column: compilerBodyBindingAliasIDColumn()) != row
            || destinationPathID < 0 || destinationPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
            || !provenanceIsValid
            || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyAlias()
            || compilerIntTableValue(table: arena.ownedPaths, row: destinationPathID, column: compilerBodyOwnedPathTypeColumn()) != compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathTypeColumn())
            || compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: destinationPathID) < 0 { return 1000 + row }
        if sourceStorageID >= 0 {
            let canonicalSourcePathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourcePathID))
            if sourceStorageID >= compilerIntTableRowCount(table: arena.storages)
                || canonicalSourcePathID < 0
                || compilerBodyArenaOwnedPathStorageID(arena: arena, pathID: canonicalSourcePathID) != sourceStorageID { return 2000 + row }
        }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: arena.bindingAliases, row: priorRow, column: compilerBodyBindingAliasDestinationPathColumn()) == destinationPathID { return 3000 + row }
            priorRow: priorRow + 1
        }
        row: row + 1
    }
    state pathRow: Int(0)
    while pathRow < compilerIntTableRowCount(table: arena.ownedPaths) {
        if compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyAlias()
            && compilerBodyBindingAliasFind(aliases: arena.bindingAliases, destinationPathID: pathRow) < 0 {
            let rootSymbolKind: Int(compilerBodyArenaOwnedPathRootSymbolKind(arena: arena, pathID: pathRow))
            if rootSymbolKind != compilerBodySymbolParameter() && rootSymbolKind != compilerBodySymbolReceiver() { return 4000 + pathRow }
        }
        pathRow: pathRow + 1
    }
    return 0
}

function compilerBodyArenaBindingAliasesAreValid(arena: CompilerBodyArena): Bool {
    return compilerBodyArenaBindingAliasValidationCode(arena: arena) == 0
}

function compilerBodyOwnedReturnTransferFind(transfers: CompilerIntTable, returnNodeID: Int, returnPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: transfers) {
        if compilerIntTableValue(table: transfers, row: row, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
            && compilerIntTableValue(table: transfers, row: row, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == returnPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyOwnedReturnTransferCountForReturnNode(transfers: CompilerIntTable, returnNodeID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: transfers) {
        if compilerIntTableValue(table: transfers, row: row, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyOwnedReturnTransferAppend(arena: CompilerBodyArena, effectPaths: CompilerIntTable, returnNodeID: Int, returnPathID: Int, sourcePathID: Int, transferKind: Int, storageKeyID: Int, sourceTypeID: Int): Int {
    if returnNodeID < 0 || returnNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || (transferKind != compilerBodyOwnedReturnTransferMove() && transferKind != compilerBodyOwnedReturnTransferAlias() && transferKind != compilerBodyOwnedReturnTransferForward()) || storageKeyID < 0 || sourceTypeID < 0
        || !compilerBodyFunctionInstanceEffectPathIsValid(paths: effectPaths, pathID: returnPathID) { return 0 - 1 }
    if compilerBodyOwnedReturnTransferFind(transfers: arena.ownedReturnTransfers, returnNodeID: returnNodeID, returnPathID: returnPathID) >= 0 { return 0 - 1 }
    let transferID: Int(compilerIntTableRowCount(table: arena.ownedReturnTransfers))
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: transferID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: returnNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: returnPathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: sourcePathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: transferKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: storageKeyID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.ownedReturnTransfers, value: sourceTypeID) != 0 { return 0 - 1 }
    return transferID
}

function compilerBodyRuntimeCallContractFind(contracts: CompilerIntTable, callNodeID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: contracts) {
        if compilerIntTableValue(table: contracts, row: row, column: compilerBodyRuntimeCallContractCallNodeColumn()) == callNodeID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyRuntimeCallContractAppend(contracts: CompilerIntTable, callNodeID: Int, functionID: Int, role: Int, storageArgumentOrdinal: Int, storageTypeID: Int): Int {
    if compilerBodyRuntimeCallContractFind(contracts: contracts, callNodeID: callNodeID) >= 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: callNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: functionID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: role) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: storageArgumentOrdinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: contracts, value: storageTypeID) != 0 { return 0 - 1 }
    return compilerIntTableRowCount(table: contracts) - 1
}

function compilerBodyFunctionInstanceEffectPathFind(paths: CompilerIntTable, parentPathID: Int, memberRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: paths) {
        if compilerIntTableValue(table: paths, row: row, column: compilerBodyFunctionInstanceEffectPathParentColumn()) == parentPathID
            && compilerIntTableValue(table: paths, row: row, column: compilerBodyFunctionInstanceEffectPathMemberColumn()) == memberRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyFunctionInstanceEffectPathAppend(paths: CompilerIntTable, parentPathID: Int, memberRow: Int): Int {
    if memberRow < 0 || (parentPathID < 0 && parentPathID != 0 - 1) { return 0 - 1 }
    if parentPathID >= 0 && !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: parentPathID) { return 0 - 1 }
    let existing: Int(compilerBodyFunctionInstanceEffectPathFind(paths: paths, parentPathID: parentPathID, memberRow: memberRow))
    if existing >= 0 { return existing }
    let pathID: Int(compilerIntTableRowCount(table: paths))
    state parentDepth: Int(0)
    if parentPathID >= 0 {
        if parentPathID >= pathID { return 0 - 1 }
        parentDepth: compilerIntTableValue(table: paths, row: parentPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn())
    }
    if compilerIntTableAppend(table: paths, value: pathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: parentPathID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: memberRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: paths, value: parentDepth + 1) != 0 { return 0 - 1 }
    return pathID
}

function compilerBodyFunctionInstanceEffectPathLeaf(paths: CompilerIntTable, pathID: Int): Int {
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: pathID) || pathID < 0 { return 0 - 1 }
    return compilerIntTableValue(table: paths, row: pathID, column: compilerBodyFunctionInstanceEffectPathMemberColumn())
}

function compilerBodyFunctionInstanceEffectPathIsValid(paths: CompilerIntTable, pathID: Int): Bool {
    if pathID == 0 - 1 { return true }
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: paths) { return false }
    state currentPathID: Int(pathID)
    state step: Int(0)
    let pathCount: Int(compilerIntTableRowCount(table: paths))
    while currentPathID >= 0 && step <= pathCount {
        if currentPathID >= pathCount { return false }
        let memberRow: Int(compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathMemberColumn()))
        let parentPathID: Int(compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathParentColumn()))
        let depth: Int(compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn()))
        if memberRow < 0 || depth <= 0 || (parentPathID < 0 && parentPathID != 0 - 1) { return false }
        if parentPathID < 0 {
            if depth != 1 { return false }
        } else {
            if parentPathID >= currentPathID || parentPathID >= pathCount { return false }
            let parentDepth: Int(compilerIntTableValue(table: paths, row: parentPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn()))
            if parentDepth <= 0 || depth != parentDepth + 1 { return false }
        }
        currentPathID: parentPathID
        step: step + 1
    }
    return currentPathID == 0 - 1
}

function compilerBodyFunctionInstanceEffectPathMaterialize(paths: CompilerIntTable, pathID: Int): RawBuffer {
    let result: RawBuffer(rawBufferCreate(capacity: 8, stride: 4))
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: pathID) { return result }
    state currentPathID: Int(pathID)
    while currentPathID >= 0 {
        if rawBufferAppendInt(buffer: result, value: compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathMemberColumn())) != 0 { return result }
        currentPathID: compilerIntTableValue(table: paths, row: currentPathID, column: compilerBodyFunctionInstanceEffectPathParentColumn())
    }
    return result
}

function compilerBodyFunctionInstanceEffectPathMaterializedIsComplete(paths: CompilerIntTable, pathID: Int, members: RawBuffer): Bool {
    if pathID == 0 - 1 { return rawBufferCount(buffer: members) == 0 }
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: pathID) { return false }
    return rawBufferCount(buffer: members) == compilerIntTableValue(table: paths, row: pathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn())
}

function compilerBodyFunctionInstanceEffectPathConcat(paths: CompilerIntTable, prefixPathID: Int, suffixPathID: Int): Int {
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: prefixPathID) || !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: suffixPathID) { return 0 - 2 }
    if prefixPathID < 0 && suffixPathID < 0 { return 0 - 1 }
    if suffixPathID < 0 { return prefixPathID }
    if suffixPathID >= compilerIntTableRowCount(table: paths) { return 0 - 2 }
    let suffixMembers: RawBuffer(compilerBodyFunctionInstanceEffectPathMaterialize(paths: paths, pathID: suffixPathID))
    if !compilerBodyFunctionInstanceEffectPathMaterializedIsComplete(paths: paths, pathID: suffixPathID, members: suffixMembers) {
        rawBufferDestroy(buffer: suffixMembers)
        return 0 - 2
    }
    state currentPathID: Int(prefixPathID)
    let suffixCount: Int(rawBufferCount(buffer: suffixMembers))
    state reverseOrdinal: Int(suffixCount - 1)
    while reverseOrdinal >= 0 {
        let nextPathID: Int(compilerBodyFunctionInstanceEffectPathAppend(paths: paths, parentPathID: currentPathID, memberRow: rawBufferLoadInt(buffer: suffixMembers, index: reverseOrdinal)))
        if nextPathID < 0 {
            rawBufferDestroy(buffer: suffixMembers)
            return 0 - 2
        }
        currentPathID: nextPathID
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: suffixMembers)
    return currentPathID
}

function compilerBodyArenaOwnedPathFollowEffectPath(arena: CompilerBodyArena, basePathID: Int, effectPaths: CompilerIntTable, effectPathID: Int): Int {
    if basePathID < 0 || basePathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: effectPaths, pathID: effectPathID) { return 0 - 1 }
    if effectPathID < 0 { return basePathID }
    let members: RawBuffer(compilerBodyFunctionInstanceEffectPathMaterialize(paths: effectPaths, pathID: effectPathID))
    if !compilerBodyFunctionInstanceEffectPathMaterializedIsComplete(paths: effectPaths, pathID: effectPathID, members: members) {
        rawBufferDestroy(buffer: members)
        return 0 - 1
    }
    state pathID: Int(basePathID)
    state reverseOrdinal: Int(rawBufferCount(buffer: members) - 1)
    while reverseOrdinal >= 0 {
        let memberRow: Int(rawBufferLoadInt(buffer: members, index: reverseOrdinal))
        pathID: compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: pathID, memberRow: memberRow)
        if pathID < 0 {
            rawBufferDestroy(buffer: members)
            return 0 - 1
        }
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: members)
    return pathID
}

function compilerBodyFunctionInstanceEffectFind(effects: CompilerIntTable, instanceID: Int, baseKind: Int, ordinal: Int, memberPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: effects) {
        if compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectInstanceColumn()) == instanceID
            && compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectBaseKindColumn()) == baseKind
            && compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectOrdinalColumn()) == ordinal
            && compilerIntTableValue(table: effects, row: row, column: compilerBodyFunctionInstanceEffectPathColumn()) == memberPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyFunctionInstanceEffectAppend(effects: CompilerIntTable, paths: CompilerIntTable, instanceID: Int, baseKind: Int, ordinal: Int, memberPathID: Int, storageKeyID: Int, effectKind: Int): Int {
    if !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: memberPathID) { return 0 - 1 }
    let row: Int(compilerIntTableRowCount(table: effects))
    let existing: Int(compilerBodyFunctionInstanceEffectFind(effects: effects, instanceID: instanceID, baseKind: baseKind, ordinal: ordinal, memberPathID: memberPathID))
    if existing >= 0 {
        if compilerIntTableValue(table: effects, row: existing, column: compilerBodyFunctionInstanceEffectStorageKeyColumn()) != storageKeyID { return 0 - 1 }
        let priorEffect: Int(compilerIntTableValue(table: effects, row: existing, column: compilerBodyFunctionInstanceEffectKindColumn()))
        if effectKind > priorEffect {
            if rawBufferStoreInt(buffer: effects.values, index: existing * effects.columnCount + compilerBodyFunctionInstanceEffectKindColumn(), value: effectKind) != 0 { return 0 - 1 }
            return 1
        }
        return 0
    }
    state memberRow: Int(0 - 1)
    if memberPathID >= 0 {
        memberRow: compilerBodyFunctionInstanceEffectPathLeaf(paths: paths, pathID: memberPathID)
        if memberRow < 0 { return 0 - 1 }
    }
    if compilerIntTableAppend(table: effects, value: instanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: baseKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: ordinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: memberRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: storageKeyID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: effectKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: effects, value: memberPathID) != 0 { return 0 - 1 }
    return 1
}

function compilerBodyFunctionInstanceEffectCallFind(calls: CompilerIntTable, callerInstanceID: Int, targetInstanceID: Int, calleeBaseKind: Int, calleeOrdinal: Int, callerBaseKind: Int, callerOrdinal: Int, prefixPathID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: calls) {
        if compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCallerColumn()) == callerInstanceID
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallTargetColumn()) == targetInstanceID
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCalleeBaseKindColumn()) == calleeBaseKind
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCalleeOrdinalColumn()) == calleeOrdinal
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCallerBaseKindColumn()) == callerBaseKind
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallCallerOrdinalColumn()) == callerOrdinal
            && compilerIntTableValue(table: calls, row: row, column: compilerBodyFunctionInstanceEffectCallPrefixPathColumn()) == prefixPathID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyFunctionInstanceEffectCallAppend(calls: CompilerIntTable, paths: CompilerIntTable, callerInstanceID: Int, targetInstanceID: Int, calleeBaseKind: Int, calleeOrdinal: Int, callerBaseKind: Int, callerOrdinal: Int, prefixPathID: Int): Int {
    if callerInstanceID < 0 || targetInstanceID < 0 || calleeOrdinal < 0 || callerOrdinal < 0
        || (calleeBaseKind != compilerBodyOwnedBaseReceiver() && calleeBaseKind != compilerBodyOwnedBaseParameter())
        || (callerBaseKind != compilerBodyOwnedBaseReceiver() && callerBaseKind != compilerBodyOwnedBaseParameter())
        || !compilerBodyFunctionInstanceEffectPathIsValid(paths: paths, pathID: prefixPathID) { return 0 - 1 }
    let existing: Int(compilerBodyFunctionInstanceEffectCallFind(calls: calls, callerInstanceID: callerInstanceID, targetInstanceID: targetInstanceID, calleeBaseKind: calleeBaseKind, calleeOrdinal: calleeOrdinal, callerBaseKind: callerBaseKind, callerOrdinal: callerOrdinal, prefixPathID: prefixPathID))
    if existing >= 0 { return existing }
    if compilerIntTableAppend(table: calls, value: callerInstanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: targetInstanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: calleeBaseKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: calleeOrdinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: callerBaseKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: callerOrdinal) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: calls, value: prefixPathID) != 0 { return 0 - 1 }
    return compilerIntTableRowCount(table: calls) - 1
}

function compilerBodyArenaRuntimeBuiltinFunctionIDForApplication(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionRuntimeBuiltin() { return 0 - 1 }
    let functionName: String(compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: functionName, kindTag: compilerSyntaxKindFunction()))
    if declarationRow < 0 { return 0 - 1 }
    let functionSyntaxID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0))
    return compilerSemanticFunctionRowForSyntaxID(tables: arena.tables, functionSyntaxID: functionSyntaxID)
}

function compilerBodyArenaRuntimeStorageArgumentOrdinal(arena: CompilerBodyArena, functionRow: Int): Int {
    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - 1 }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterTypeID: Int(compilerBodyArenaTypeIDForSpan(arena: arena, fileID: parameterFileID, start: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8), end: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9)))
        if compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: parameterTypeID) { return ordinal }
        ordinal: ordinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaInitializerDeclarationForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    state currentNodeID: Int(valueNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        state groupingOwnerNodeID: Int(0 - 1)
        state initializerOwnerNodeID: Int(0 - 1)
        state edgeRow: Int(0)
        while edgeRow < compilerIntTableRowCount(table: arena.edges) {
            if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == currentNodeID {
                let edgeOwnerNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0))
                let edgeRole: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2))
                if edgeRole == compilerSyntaxRoleInitializer()
                    && edgeOwnerNodeID >= 0 && edgeOwnerNodeID < compilerIntTableRowCount(table: arena.nodes)
                    && compilerIntTableValue(table: arena.nodes, row: edgeOwnerNodeID, column: 1) == compilerSyntaxKindLocalBinding() { initializerOwnerNodeID: edgeOwnerNodeID }
                if edgeRole == compilerSyntaxRoleGroupedValue()
                    && edgeOwnerNodeID >= 0 && edgeOwnerNodeID < compilerIntTableRowCount(table: arena.nodes)
                    && compilerIntTableValue(table: arena.nodes, row: edgeOwnerNodeID, column: 1) == compilerSyntaxKindGrouping() { groupingOwnerNodeID: edgeOwnerNodeID }
            }
            edgeRow: edgeRow + 1
        }
        if initializerOwnerNodeID >= 0 { return initializerOwnerNodeID }
        if groupingOwnerNodeID < 0 || groupingOwnerNodeID == currentNodeID { return 0 - 1 }
        currentNodeID: groupingOwnerNodeID
        step: step + 1
    }
    return 0 - 1
}

function compilerBodyArenaSymbolForInitializerValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    let declarationNodeID: Int(compilerBodyArenaInitializerDeclarationForValue(arena: arena, valueNodeID: valueNodeID))
