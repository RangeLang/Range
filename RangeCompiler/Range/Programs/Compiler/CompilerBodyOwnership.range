function compilerBodyArenaOwnedPathActivationKindForRoot(arena: CompilerBodyArena, rootPathID: Int): Int {
    if rootPathID < 0 || rootPathID >= compilerIntTableRowCount(table: arena.ownedPaths)
        || compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathParentColumn()) >= 0 { return compilerBodyOwnedPathActivationInvalid() }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
    if rootKind == compilerBodyOwnedPathRootValue() { return compilerBodyOwnedPathActivationEvaluationTemporary() }
    if rootKind != compilerBodyOwnedPathRootSymbol() { return compilerBodyOwnedPathActivationInvalid() }
    let symbolID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return compilerBodyOwnedPathActivationInvalid() }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver() { return compilerBodyOwnedPathActivationBoundary() }
    if symbolKind == compilerBodySymbolLet() || symbolKind == compilerBodySymbolState() { return compilerBodyOwnedPathActivationLexicalSymbol() }
    return compilerBodyOwnedPathActivationInvalid()
}

