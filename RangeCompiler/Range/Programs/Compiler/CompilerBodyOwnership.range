function compilerBodyArenaPrepareReturnedAliasTopologyForApplication(arena: CompilerBodyArena, applicationNodeID: Int, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, returnSummaries: CompilerIntTable, returnLeaves: CompilerIntTable, effectPaths: CompilerIntTable, installLocalDestination: Bool): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
