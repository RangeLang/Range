function compilerBodyArenaOwnedPathToEffectPath(arena: CompilerBodyArena, ownedPathID: Int, effectPaths: CompilerIntTable): Int {
    if ownedPathID < 0 || ownedPathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 2 }
    let members: RawBuffer(rawBufferCreate(capacity: 8, stride: 4))
    state currentPathID: Int(ownedPathID)
    state status: Int(0)
    while currentPathID >= 0 && status == 0 {
        if currentPathID >= compilerIntTableRowCount(table: arena.ownedPaths) {
            status: 0 - 1
        } else {
            let memberRow: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn()))
            if memberRow >= 0 {
