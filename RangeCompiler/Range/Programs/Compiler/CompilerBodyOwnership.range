function compilerBodyArenaOwnedPathCollectEvaluationProducers(arena: CompilerBodyArena, pathRoots: RawBuffer, evaluationProducers: RawBuffer, nodeRootValues: RawBuffer, producerCounts: RawBuffer): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    let nodeCount: Int(compilerIntTableRowCount(table: arena.nodes))
    if rawBufferCount(buffer: pathRoots) != pathCount || rawBufferCount(buffer: evaluationProducers) != pathCount
        || rawBufferCount(buffer: producerCounts) != pathCount || rawBufferCount(buffer: nodeRootValues) != nodeCount { return 0 - 1 }
    state scheduleRow: Int(0)
    while scheduleRow < compilerIntTableRowCount(table: arena.cfgSchedule) {
        if compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleActionColumn()) == compilerBodyCFGScheduleEvaluateNode() {
            let scheduleNodeID: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleNodeColumn()))
            if scheduleNodeID < 0 || scheduleNodeID >= nodeCount {
                return 0 - 1
            } else {
                let scheduledRootPathID: Int(rawBufferLoadInt(buffer: nodeRootValues, index: scheduleNodeID))
                if scheduledRootPathID >= 0 {
                    let producerCount: Int(rawBufferLoadInt(buffer: producerCounts, index: scheduledRootPathID))
                    if rawBufferStoreInt(buffer: producerCounts, index: scheduledRootPathID, value: producerCount + 1) != 0
                        || rawBufferStoreInt(buffer: evaluationProducers, index: scheduledRootPathID, value: compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleBlockColumn())) != 0 { return 0 - 1 }
                }
            }
