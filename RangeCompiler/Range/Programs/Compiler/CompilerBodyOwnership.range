}

function compilerBodyScalarMemoryFactsAreValid(arena: CompilerBodyArena): Bool {
    if !compilerIntTableIsComplete(table: arena.memoryFacts)
        || rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateCompletedPhase()) != compilerBodyMemoryPhaseLifetime()
        || rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateValid()) != 1 { return false }
