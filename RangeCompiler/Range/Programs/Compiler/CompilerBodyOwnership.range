        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactIDColumn()) != row
            || phase < priorPhase || phase < compilerBodyMemoryPhaseValue() || phase > compilerBodyMemoryPhaseLifetime()
            || kind == compilerBodyMemoryFactPlacement() || kind == compilerBodyMemoryFactDestruction() || kind == compilerBodyMemoryFactReturnTransfer() || kind == compilerBodyMemoryFactInitialize() { return false }
