            || rawBufferAppendInt(buffer: canonicalPaths, value: canonicalPathID) != 0
            || rawBufferAppendInt(buffer: evaluationProducers, value: 0 - 1) != 0
            || rawBufferAppendInt(buffer: producerCounts, value: 0) != 0 { return 0 - 1 }
