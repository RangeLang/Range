function compilerBodyArenaConstructArgumentValueForMember(arena: CompilerBodyArena, applicationNodeID: Int, memberRow: Int): Int {
    state ordinal: Int(0)
    let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID))
