function compilerBodyArenaOwnedPathSetOrigin(origins: RawBuffer, pathID: Int, originPathID: Int): Int {
    if pathID < 0 || pathID >= rawBufferCount(buffer: origins) { return 0 - 1 }
    return rawBufferStoreInt(buffer: origins, index: pathID, value: originPathID)
}

function compilerBodyArenaOwnedPathOrigin(origins: RawBuffer, pathID: Int): Int {
