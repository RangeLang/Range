    state storageID: Int(0 - 1)
    if kind == compilerBodyMIROperationDirectCall() { storageID: compilerBodyStorageForCall(arena: arena, callNodeID: sourceNodeID) }
    if kind == compilerBodyMIROperationLocalValue() { storageID: compilerBodyStorageForSymbol(arena: arena, symbolID: targetID) }
    if kind == compilerBodyMIROperationReturn() { storageID: compilerBodyCalleeReturnStorage(arena: arena) }
    if compilerIntTableAppend(table: arena.mirOperations, value: operationID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: blockID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: kind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: resultValueID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: sourceNodeID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: firstOperand) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: operandCount) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: targetKind) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: targetID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: storageID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirOperations, value: 0 - 1) != 0 { return 0 - 1 }
    if compilerBodyMIROperationRequiresOrder(arena: arena, kind: kind, sourceNodeID: sourceNodeID) {
        state priorOperation: Int(operationID - 1)
        state orderProducer: Int(0 - 1)
        while priorOperation >= 0 && orderProducer < 0 {
            if compilerIntTableValue(table: arena.mirOperations, row: priorOperation, column: compilerBodyMIROperationBlockColumn()) == blockID
                && compilerBodyMIROperationRequiresOrder(arena: arena, kind: compilerIntTableValue(table: arena.mirOperations, row: priorOperation, column: compilerBodyMIROperationKindColumn()), sourceNodeID: compilerIntTableValue(table: arena.mirOperations, row: priorOperation, column: compilerBodyMIROperationSourceColumn())) { orderProducer: priorOperation }
            priorOperation: priorOperation - 1
        }
        if orderProducer >= 0 {
            let dependencyID: Int(compilerIntTableRowCount(table: arena.graphZeroMIRDependencies))
            if compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: dependencyID) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: orderProducer) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: operationID) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: 0 - 1) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: compilerBodyGraphZeroMIRDependencyOrder()) != 0
                || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: 0) != 0 { return 0 - 1 }
        }
    }
    return operationID
}

function compilerBodyMIRSetOperationInstanceID(arena: CompilerBodyArena, operationID: Int, instanceID: Int): Int {
    if operationID < 0 || operationID >= compilerIntTableRowCount(table: arena.mirOperations) { return 0 - 1 }
    return rawBufferStoreInt(buffer: arena.mirOperations.values, index: operationID * compilerBodyMIROperationColumnCount() + compilerBodyMIROperationInstanceIDColumn(), value: instanceID)
}

function compilerBodyMIRAppendVersion(arena: CompilerBodyArena, symbolID: Int, blockID: Int, valueID: Int): Int {
    state ordinal: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirVersions) {
        if compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionSymbolColumn()) == symbolID
            && compilerIntTableValue(table: arena.mirVersions, row: row, column: compilerBodyMIRVersionBlockColumn()) == blockID { ordinal: ordinal + 1 }
        row: row + 1
    }
    if compilerIntTableAppend(table: arena.mirVersions, value: symbolID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirVersions, value: blockID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirVersions, value: valueID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: arena.mirVersions, value: ordinal) != 0 { return 0 - 1 }
    return ordinal
}

function compilerBodyMIRExpressionValue(arena: CompilerBodyArena, nodeID: Int, action: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.mirExpressionValues) {
