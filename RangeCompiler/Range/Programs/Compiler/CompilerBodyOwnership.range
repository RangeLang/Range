    if effectKind == compilerBodyOwnedEffectUnique() { return compilerBodyMemoryFactUniqueBorrow() }
    if effectKind == compilerBodyOwnedEffectConsume() { return compilerBodyMemoryFactConsume() }
    return 0 - 1
}

function compilerBodyArenaOwnedPathApplyRuntimeContract(arena: CompilerBodyArena, contractRow: Int, states: RawBuffer, origins: RawBuffer, recordFacts: Bool): Int {
    let callNodeID: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractCallNodeColumn()))
    let role: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractRoleColumn()))
    if role == compilerRuntimeABIFunctionCreate() {
        let resultPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootValue(), rootID: callNodeID, memberRow: 0 - 1))
        let storageTypeID: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractStorageTypeColumn()))
        if resultPathID < 0
            || compilerIntTableValue(table: arena.ownedPaths, row: resultPathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned()
            || compilerIntTableValue(table: arena.ownedPaths, row: resultPathID, column: compilerBodyOwnedPathTypeColumn()) != storageTypeID
            || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: storageTypeID)
            || !compilerBodyArenaOwnedPathSubtreeIsAbsentAt(arena: arena, states: states, origins: origins, rootPathID: resultPathID, blockID: 0 - 1, pathCount: compilerIntTableRowCount(table: arena.ownedPaths)) { return 0 - 1 }
        if compilerBodyArenaOwnedPathSetState(states: states, pathID: resultPathID, stateValue: compilerBodyOwnedPathLive()) != 0
            || compilerBodyArenaOwnedPathSetOrigin(origins: origins, pathID: resultPathID, originPathID: compilerBodyOwnedOriginLocal()) != 0 { return 0 - 1 }
        if recordFacts {
            if compilerBodyMemoryAppendFact(arena: arena, phase: compilerBodyMemoryPhasePassEscape(), kind: compilerBodyMemoryFactResourceCreate(), sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectOwnedPath(), subjectID: resultPathID, auxID: storageTypeID) < 0 { return 0 - 1 }
        }
        return 0
    }
    let storageArgumentOrdinal: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractStorageArgumentColumn()))
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: callNodeID, role: compilerSyntaxRoleArgument(), ordinal: storageArgumentOrdinal))
    if argumentNodeID < 0 { return 0 - 1 }
    let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
    if valueNodeID < 0 { return 0 - 1 }
    let pathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: valueNodeID))
    if pathID < 0 { return 0 - 1 }
    let effectKind: Int(compilerBodyArenaOwnedEffectForRuntimeRole(role: role))
    if effectKind == compilerBodyOwnedEffectNone() { return 0 - 1 }
    if effectKind == compilerBodyOwnedEffectConsume() && compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: valueNodeID) { return 0 - 1 }
    let effectTargetPathID: Int(compilerBodyArenaOwnedPathApplyEffectThroughAlias(arena: arena, states: states, origins: origins, pathID: pathID, effectKind: effectKind))
    if effectTargetPathID < 0 { return 0 - 1 }
    let factKind: Int(compilerBodyArenaOwnedMemoryFactForEffect(effectKind: effectKind))
    if recordFacts && factKind >= 0 {
