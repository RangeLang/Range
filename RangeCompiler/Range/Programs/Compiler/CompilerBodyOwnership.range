function compilerBodyArenaOwnedPathBackedgesAreStable(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathRoots: RawBuffer, canonicalPaths: RawBuffer, predecessorStarts: RawBuffer, predecessorCounts: RawBuffer, predecessorBlocks: RawBuffer, projectionA: RawBuffer, projectionB: RawBuffer, blockCount: Int, pathCount: Int): Bool {
