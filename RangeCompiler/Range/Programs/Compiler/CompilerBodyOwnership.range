        let sourceKind: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourceKindColumn()))
        if compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafInstanceColumn()) != targetInstanceID { return 0 - 1 }
        if sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias() {
            let returnPathID: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafPathColumn()))
            let baseKind: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn()))
            let ordinal: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn()))
            let sourceEffectPathID: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn()))
            let expectedStorageKeyID: Int(compilerIntTableValue(table: returnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafStorageKeyColumn()))
            let boundaryPathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
            let sourceLeafPathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: boundaryPathID, effectPaths: effectPaths, effectPathID: sourceEffectPathID))
            let canonicalSourceLeafPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: sourceLeafPathID))
            let callLeafPathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: callRootPathID, effectPaths: effectPaths, effectPathID: returnPathID))
