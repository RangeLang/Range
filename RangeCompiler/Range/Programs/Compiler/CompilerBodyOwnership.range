function compilerBodyArenaOwnedPathSummaryRootClass(arena: CompilerBodyArena, pathID: Int): Int {
    let rootPathID: Int(compilerBodyArenaOwnedPathRootPathID(arena: arena, pathID: pathID))
    if rootPathID < 0 { return compilerBodyOwnedSummaryRootInvalid() }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootKindColumn()))
