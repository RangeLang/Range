    if calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
    if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionFunction() { return 0 }
    let callRootPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootValue(), rootID: applicationNodeID, memberRow: 0 - 1))
    if callRootPathID < 0 { return 0 }
    let targetInstanceID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionInstanceIDColumn()))
    if targetInstanceID < 0 || targetInstanceID >= compilerIntTableRowCount(table: returnSummaries) { return 0 - 1 }
    let summaryStatus: Int(compilerIntTableValue(table: returnSummaries, row: targetInstanceID, column: compilerReachableFunctionInstanceReturnSummaryStatusColumn()))
    if summaryStatus != compilerReachableFunctionInstanceReturnSummarySupported() { return 0 - 1 }
    let resultTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
    let resultTypeKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()))
    let resultTypeKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: resultTypeID))
    if resultTypeID < 0 || resultTypeKeyID < 0
        || compilerIntTableValue(table: returnSummaries, row: targetInstanceID, column: compilerReachableFunctionInstanceReturnSummaryInstanceColumn()) != targetInstanceID
        || compilerIntTableValue(table: returnSummaries, row: targetInstanceID, column: compilerReachableFunctionInstanceReturnSummaryTypeKeyColumn()) != resultTypeKeyID
        || compilerIntTableValue(table: returnSummaries, row: targetInstanceID, column: compilerReachableFunctionInstanceReturnSummaryTypeKindColumn()) != resultTypeKind { return 0 - 1 }
