    if !compilerBodyArenaOwnedPathSubtreeCanDeactivateAt(arena: arena, states: states, origins: origins, rootPathID: rootPathID, blockID: 0 - 1, pathCount: pathCount) { return 0 - 1 }
    state pathID: Int(0)
