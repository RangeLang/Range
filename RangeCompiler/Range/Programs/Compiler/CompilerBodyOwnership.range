}

function compilerBodyArenaOwnedPathBlockIsTerminal(arena: CompilerBodyArena, blockID: Int): Bool {
    let terminatorKind: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorKindColumn()))
