            || (pathPolicy == compilerBodyOwnedPathPolicyOwned() && originPathID != compilerBodyOwnedOriginLocal())
            || (pathPolicy == compilerBodyOwnedPathPolicyBorrowed() && !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID)) { return 0 - 1 }
        return compilerBodyArenaOwnedPathSetState(states: states, pathID: pathID, stateValue: compilerBodyOwnedPathConsumed())
    }
    if effectKind == compilerBodyOwnedEffectShared() || effectKind == compilerBodyOwnedEffectUnique() { return 0 }
