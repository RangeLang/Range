        let memberRow: Int(rawBufferLoadInt(buffer: members, index: reverseOrdinal))
        pathID: compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: pathID, memberRow: memberRow)
        if pathID < 0 {
            rawBufferDestroy(buffer: members)
            return 0 - 1
        }
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: members)
    if compilerBodyArenaOwnedPathApplyEffectThroughAlias(arena: arena, states: states, origins: origins, pathID: pathID, effectKind: effectKind) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyArenaCallBoundaryValueNode(arena: CompilerBodyArena, applicationNodeID: Int, calleeNodeID: Int, baseKind: Int, ordinal: Int): Int {
    if baseKind == compilerBodyOwnedBaseReceiver() {
