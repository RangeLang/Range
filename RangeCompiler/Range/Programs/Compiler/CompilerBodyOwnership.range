function compilerBodyArenaOwnedPathApplyEffect(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathID: Int, effectKind: Int): Int {
    if compilerBodyArenaOwnedPathState(states: states, pathID: pathID) != compilerBodyOwnedPathLive() { return 0 - 1 }
    if effectKind == compilerBodyOwnedEffectConsume() {
