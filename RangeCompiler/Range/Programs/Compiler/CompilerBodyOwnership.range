    }
    return producer
}

function compilerBodyMIRAppendOperation(arena: CompilerBodyArena, blockID: Int, kind: Int, resultValueID: Int, sourceNodeID: Int, firstOperand: Int, operandCount: Int, targetKind: Int, targetID: Int): Int {
