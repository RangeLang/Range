            let pathID: Int(compilerBodyArenaCallBoundaryPath(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
            let effectPathID: Int(compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectPathColumn()))
            let effectKind: Int(compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectKindColumn()))
            if pathID < 0 { return 0 - 1 }
            if effectKind == compilerBodyOwnedEffectConsume() && compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: valueNodeID) { return 0 - 1 }
            let effectTargetPathID: Int(compilerBodyArenaOwnedPathFollowEffectPath(arena: arena, basePathID: pathID, effectPaths: effectPaths, effectPathID: effectPathID))
            let expectedStorageKeyID: Int(compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectStorageKeyColumn()))
            if effectTargetPathID < 0 || expectedStorageKeyID < 0
                || compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: effectTargetPathID, column: compilerBodyOwnedPathTypeColumn())) != expectedStorageKeyID { return 0 - 1 }
