    if rootSymbolKind == compilerBodySymbolReceiver() || rootSymbolKind == compilerBodySymbolParameter() { return compilerBodyOwnedSummaryRootBoundary() }
    if (rootSymbolKind == compilerBodySymbolLet() || rootSymbolKind == compilerBodySymbolState())
        && compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathPolicyColumn()) == compilerBodyOwnedPathPolicyOwned() { return compilerBodyOwnedSummaryRootLocalCreate() }
    return compilerBodyOwnedSummaryRootUnsupported()
