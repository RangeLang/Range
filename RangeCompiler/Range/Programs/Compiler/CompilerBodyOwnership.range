function compilerBodyArenaOwnedPathApplyInstanceEffects(arena: CompilerBodyArena, applicationNodeID: Int, states: RawBuffer, origins: RawBuffer, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effects: CompilerIntTable, effectPaths: CompilerIntTable, recordFacts: Bool): Int {
