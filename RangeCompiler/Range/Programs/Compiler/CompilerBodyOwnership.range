function compilerBodyArenaOwnedPathBuildDescriptorCaches(arena: CompilerBodyArena, pathRoots: RawBuffer, canonicalPaths: RawBuffer, evaluationProducers: RawBuffer): Int {
    let nodeRootValues: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.nodes), stride: 4))
    let producerCounts: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.ownedPaths), stride: 4))
    state status: Int(compilerBodyArenaOwnedPathInitializeDescriptorCaches(arena: arena, pathRoots: pathRoots, canonicalPaths: canonicalPaths, evaluationProducers: evaluationProducers, nodeRootValues: nodeRootValues, producerCounts: producerCounts))
    if status == 0 { status: compilerBodyArenaOwnedPathIndexEvaluationRoots(arena: arena, pathRoots: pathRoots, nodeRootValues: nodeRootValues) }
    if status == 0 { status: compilerBodyArenaOwnedPathCollectEvaluationProducers(arena: arena, pathRoots: pathRoots, evaluationProducers: evaluationProducers, nodeRootValues: nodeRootValues, producerCounts: producerCounts) }
    if rawBufferDestroy(buffer: nodeRootValues) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: producerCounts) != 0 { status: 0 - 1 }
    return status
}

function compilerBodyArenaOwnedPathValueRequiresUnsupportedCoalescingLiveRange(arena: CompilerBodyArena, pathRoots: RawBuffer, valueNodeID: Int): Bool {
