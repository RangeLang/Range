function compilerBodyArenaOwnedPathInitializeDescriptorCaches(arena: CompilerBodyArena, pathRoots: RawBuffer, canonicalPaths: RawBuffer, evaluationProducers: RawBuffer, nodeRootValues: RawBuffer, producerCounts: RawBuffer): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
