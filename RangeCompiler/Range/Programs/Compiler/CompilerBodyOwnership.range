function compilerBodyMemoryAppendFact(arena: CompilerBodyArena, phase: Int, kind: Int, sourceNodeID: Int, subjectKind: Int, subjectID: Int, auxID: Int): Int {
    let factID: Int(compilerIntTableRowCount(table: arena.memoryFacts))
    if compilerIntTableAppend(table: arena.memoryFacts, value: factID) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: phase) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: kind) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: sourceNodeID) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: subjectKind) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: subjectID) != 0
        || compilerIntTableAppend(table: arena.memoryFacts, value: auxID) != 0 { return 0 - 1 }
    return factID
}

function compilerBodyMemoryBeginPhase(arena: CompilerBodyArena, phase: Int): Bool {
    return rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateValid()) == 1
        && rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateFrozen()) == 0
        && rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateCompletedPhase()) == phase - 1
}

function compilerBodyMemoryCompletePhase(arena: CompilerBodyArena, phase: Int): Int {
    return rawBufferStoreInt(buffer: arena.memoryState, index: compilerBodyMemoryStateCompletedPhase(), value: phase)
}

function compilerBodyMemoryBuildValuePhase(arena: CompilerBodyArena): Int {
    let phase: Int(compilerBodyMemoryPhaseValue())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 0 - 1 }
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolKindColumn()))
        state symbolFactKind: Int(compilerBodyMemoryFactOwnedImmutableValue())
        if symbolKind == compilerBodySymbolParameter() || symbolKind == compilerBodySymbolReceiver() || symbolKind == compilerBodySymbolEnumPayloadBinding() { symbolFactKind: compilerBodyMemoryFactBorrowedParameterValue() }
        if symbolKind == compilerBodySymbolState() { symbolFactKind: compilerBodyMemoryFactOwnedMutableValue() }
        let symbolTypeKind: Int(compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: symbolRow))
        if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: symbolFactKind, sourceNodeID: compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolDeclarationColumn()), subjectKind: compilerBodyMemorySubjectSymbol(), subjectID: symbolRow, auxID: symbolTypeKind) < 0 { return 0 - 1 }
        symbolRow: symbolRow + 1
    }
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1))
        state nodeFactKind: Int(0)
        state nodeTypeKind: Int(compilerBodyTypeUnknown())
        if nodeKind == compilerSyntaxKindIntegerLiteral() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeInt()
        }
        if nodeKind == compilerSyntaxKindStringLiteral() || nodeKind == compilerSyntaxKindStringSegment() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeString()
        }
        if nodeKind == compilerSyntaxKindInterpolatedString() {
            nodeFactKind: compilerBodyMemoryFactBinaryValue()
            nodeTypeKind: compilerBodyTypeString()
        }
        if nodeKind == compilerSyntaxKindBoolLiteral() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeBool()
        }
        if nodeKind == compilerSyntaxKindEnumCaseValue() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeEnum()
        }
        if nodeKind == compilerSyntaxKindArrayLiteral() {
            nodeFactKind: compilerBodyMemoryFactLiteralValue()
            nodeTypeKind: compilerBodyTypeConstruct()
        }
        if nodeKind == compilerSyntaxKindIndex() || nodeKind == compilerSyntaxKindMemberRead() {
            nodeFactKind: compilerBodyMemoryFactRead()
            nodeTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeRow)
        }
        if nodeKind == compilerSyntaxKindApplication() { nodeFactKind: compilerBodyMemoryFactCallValue() }
        if nodeKind == compilerSyntaxKindEquality() || nodeKind == compilerSyntaxKindBooleanAnd() || nodeKind == compilerSyntaxKindBooleanOr() || nodeKind == compilerSyntaxKindOptionalCoalescing() {
            nodeFactKind: compilerBodyMemoryFactBinaryValue()
            if nodeKind == compilerSyntaxKindOptionalCoalescing() {
                nodeTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeRow)
            } else {
                nodeTypeKind: compilerBodyTypeBool()
            }
        }
        if nodeKind == compilerSyntaxKindAddition() || nodeKind == compilerSyntaxKindSubtraction() || nodeKind == compilerSyntaxKindMultiplication() || nodeKind == compilerSyntaxKindDivision() || nodeKind == compilerSyntaxKindRemainder()
            || nodeKind == compilerSyntaxKindLessThan() || nodeKind == compilerSyntaxKindLessEqual() || nodeKind == compilerSyntaxKindGreaterThan() || nodeKind == compilerSyntaxKindGreaterEqual()
            || nodeKind == compilerSyntaxKindPrefixNot() || nodeKind == compilerSyntaxKindPrefixNegate() {
            nodeFactKind: compilerBodyMemoryFactBinaryValue()
            nodeTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeRow)
        }
        if nodeFactKind != 0 {
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: nodeFactKind, sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectNode(), subjectID: nodeRow, auxID: nodeTypeKind) < 0 { return 0 - 1 }
        }
        nodeRow: nodeRow + 1
    }
    return compilerBodyMemoryCompletePhase(arena: arena, phase: phase)
}

function compilerBodyStorageAppend(arena: CompilerBodyArena, ownerNodeID: Int, typeID: Int, regionNodeID: Int, placement: Int, mutable: Bool): Int {
    let storageID: Int(compilerIntTableRowCount(table: arena.storages))
    state mutableValue: Int(0)
    if mutable { mutableValue: 1 }
    if compilerIntTableAppend(table: arena.storages, value: storageID) != 0
        || compilerIntTableAppend(table: arena.storages, value: ownerNodeID) != 0
        || compilerIntTableAppend(table: arena.storages, value: typeID) != 0
        || compilerIntTableAppend(table: arena.storages, value: regionNodeID) != 0
        || compilerIntTableAppend(table: arena.storages, value: placement) != 0
        || compilerIntTableAppend(table: arena.storages, value: mutableValue) != 0 { return 0 - 1 }
    return storageID
}

function compilerBodyStorageForSymbol(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStorageOwnerNodeColumn()) == declarationNodeID
            && compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCaller() { return storageRow }
        storageRow: storageRow + 1
    }
    return 0 - 1
}

function compilerBodyStorageForCall(arena: CompilerBodyArena, callNodeID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.storages) {
        let ownerNodeID: Int(compilerIntTableValue(table: arena.storages, row: row, column: compilerBodyStorageOwnerNodeColumn()))
        if ownerNodeID == callNodeID
            && compilerBodyMemoryHasFact(arena: arena, kind: compilerBodyMemoryFactPlacement(), sourceNodeID: callNodeID, subjectID: row) { return row }
        if compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0) == callNodeID { return row }
        row: row + 1
    }
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == callNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleReturnValue() {
            let returnStorageID: Int(compilerBodyCalleeReturnStorage(arena: arena))
            if returnStorageID >= 0
                && compilerBodyArenaExpressionTypeID(arena: arena, nodeID: callNodeID) == compilerIntTableValue(table: arena.storages, row: returnStorageID, column: compilerBodyStorageTypeIDColumn()) { return returnStorageID }
        }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeIDHasNativeNominalLayout(arena: CompilerBodyArena, typeID: Int): Bool {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return false }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if nominalSyntaxID == compilerBodyBuiltinArraySyntaxID() { return compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID) == 1 }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: nominalSyntaxID))
    if declarationRow < 0 { return false }
    let declarationKind: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 2))
    if declarationKind == compilerSyntaxKindConstruct() { return compilerNominalLLVMTypeName(tables: arena.tables, declarationRow: declarationRow) != String("") }
    if declarationKind == compilerSyntaxKindEnum() { return compilerEnumLLVMTypeName(tables: arena.tables, declarationRow: declarationRow) != String("") }
    return false
}

function compilerBodyArenaInitializerResolutionNode(arena: CompilerBodyArena, initializerNodeID: Int): Int {
    if initializerNodeID < 0 || initializerNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    if compilerIntTableValue(table: arena.nodes, row: initializerNodeID, column: 1) == compilerSyntaxKindEnumCaseValue()
        || compilerIntTableValue(table: arena.nodes, row: initializerNodeID, column: 1) == compilerSyntaxKindArrayLiteral() { return initializerNodeID }
    return compilerBodyArenaChild(arena: arena, ownerNodeID: initializerNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0)
}

function compilerBodyStorageIsConstructInitialized(arena: CompilerBodyArena, storageID: Int): Bool {
    if storageID < 0 || storageID >= compilerIntTableRowCount(table: arena.storages) { return false }
    let ownerNodeID: Int(compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageOwnerNodeColumn()))
    let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
    let resolutionNodeID: Int(compilerBodyArenaInitializerResolutionNode(arena: arena, initializerNodeID: initializerNodeID))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: resolutionNodeID))
    if ownerNodeID < 0 || initializerNodeID < 0 || resolutionNodeID < 0 || resolutionRow < 0 { return false }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    return targetKind == compilerBodyResolutionConstruct() || targetKind == compilerBodyResolutionEnum() || targetKind == compilerBodyResolutionEnumCase()
}

function compilerBodyArenaReturnOwnerForValue(arena: CompilerBodyArena, valueNodeID: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == valueNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleReturnValue() { return compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0) }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyMemoryBuildPlacementForSymbol(arena: CompilerBodyArena, symbolID: Int, phase: Int, abiPlan: CompilerModuleABIPlan): Int {
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if !compilerBodySymbolOwnsLocalStorage(kind: symbolKind) { return 0 }
    let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if declarationNodeID < 0 || declarationNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 }
    let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
    if initializerNodeID < 0 { return 0 }
    let resolutionNodeID: Int(compilerBodyArenaInitializerResolutionNode(arena: arena, initializerNodeID: initializerNodeID))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: resolutionNodeID))
    if resolutionRow < 0 { return 0 }
    let localTypeKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()))
    if localTypeKind != compilerBodyTypeConstruct() && localTypeKind != compilerBodyTypeEnum() { return 0 }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    if targetKind != compilerBodyResolutionConstruct() && targetKind != compilerBodyResolutionEnum() && targetKind != compilerBodyResolutionEnumCase() && targetKind != compilerBodyResolutionFunction() { return 0 }
    let localTypeID: Int(compilerBodyArenaTypeIDForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn())))
    let callTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
    if localTypeID < 0 || localTypeID != callTypeID { return 0 - 1 }
    if targetKind == compilerBodyResolutionConstruct() || targetKind == compilerBodyResolutionEnum() || targetKind == compilerBodyResolutionEnumCase() {
        if !compilerBodyArenaTypeIDHasNativeNominalLayout(arena: arena, typeID: localTypeID) { return 0 }
    } else if targetKind == compilerBodyResolutionFunction() {
        let targetFunctionID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
        if compilerModuleABIPlanReturnMode(plan: abiPlan, tables: arena.tables, index: arena.declarationIndex, functionRow: targetFunctionID) != compilerFunctionReturnABIIndirect() { return 0 }
    } else { return 0 }
    let mutable: Bool(symbolKind == compilerBodySymbolState())
    let storageID: Int(compilerBodyStorageAppend(arena: arena, ownerNodeID: declarationNodeID, typeID: localTypeID, regionNodeID: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolRegionColumn()), placement: compilerBodyStorageCaller(), mutable: mutable))
    if storageID < 0
        || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactPlacement(), sourceNodeID: initializerNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: localTypeID) < 0
        || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: initializerNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: callTypeID) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyMemoryBuildPlacementForCall(arena: CompilerBodyArena, callNodeID: Int, phase: Int, abiPlan: CompilerModuleABIPlan): Int {
    if compilerIntTableValue(table: arena.nodes, row: callNodeID, column: 1) != compilerSyntaxKindApplication() { return 0 }
    if compilerBodyStorageForCall(arena: arena, callNodeID: callNodeID) >= 0 { return 0 }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: callNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
    if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionFunction()
        || (compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) != compilerBodyTypeConstruct()
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) != compilerBodyTypeEnum()) { return 0 }
    let targetFunctionID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if compilerModuleABIPlanReturnMode(plan: abiPlan, tables: arena.tables, index: arena.declarationIndex, functionRow: targetFunctionID) != compilerFunctionReturnABIIndirect() { return 0 }
    let callTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
    let regionNodeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionRegionColumn()))
    let storageID: Int(compilerBodyStorageAppend(arena: arena, ownerNodeID: callNodeID, typeID: callTypeID, regionNodeID: regionNodeID, placement: compilerBodyStorageCaller(), mutable: false))
    if storageID < 0 { return 0 - 1 }
    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactPlacement(), sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: callTypeID) < 0 { return 0 - 1 }
    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: callNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: callTypeID) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyCalleeReturnStorage(arena: CompilerBodyArena): Int {
    state storageRow: Int(0)
    while storageRow < compilerIntTableRowCount(table: arena.storages) {
        if compilerIntTableValue(table: arena.storages, row: storageRow, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCalleeReturn() { return storageRow }
        storageRow: storageRow + 1
    }
    return 0 - 1
}

function compilerBodyMemoryBuildCalleeReturnDestination(arena: CompilerBodyArena, phase: Int, abiPlan: CompilerModuleABIPlan): Int {
    if compilerBodyArenaOwnerReturnMode(arena: arena, plan: abiPlan) != compilerFunctionReturnABIIndirect() { return 0 }
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
    let returnTypeID: Int(compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: compilerBodyArenaReceiverTypeID(arena: arena), ownerSyntaxID: compilerBodyArenaReceiverConstructSyntaxID(arena: arena), fileID: returnFileID, start: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6), end: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7)))
    if returnTypeID < 0 { return 0 - 1 }
    let storageID: Int(compilerBodyStorageAppend(arena: arena, ownerNodeID: arena.rootNodeID, typeID: returnTypeID, regionNodeID: arena.rootNodeID, placement: compilerBodyStorageCalleeReturn(), mutable: true))
    if storageID < 0 || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactReturnDestination(), sourceNodeID: arena.rootNodeID, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: returnTypeID) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyMemoryBuildPlacementPhase(arena: CompilerBodyArena, abiPlan: CompilerModuleABIPlan): Int {
    let phase: Int(compilerBodyMemoryPhasePlacement())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 1 }
    if compilerBodyMemoryBuildCalleeReturnDestination(arena: arena, phase: phase, abiPlan: abiPlan) != 0 { return 2 }
    state symbolRow: Int(0)
    while symbolRow < compilerIntTableRowCount(table: arena.symbols) {
        if compilerBodyMemoryBuildPlacementForSymbol(arena: arena, symbolID: symbolRow, phase: phase, abiPlan: abiPlan) != 0 { return 1000 + symbolRow }
        symbolRow: symbolRow + 1
    }
    state callNodeRow: Int(0)
    while callNodeRow < compilerIntTableRowCount(table: arena.nodes) {
        if compilerBodyMemoryBuildPlacementForCall(arena: arena, callNodeID: callNodeRow, phase: phase, abiPlan: abiPlan) != 0 { return 2000 + callNodeRow }
        callNodeRow: callNodeRow + 1
    }
    if compilerBodyMemoryCompletePhase(arena: arena, phase: phase) != 0 { return 3 }
    return 0
}

function compilerBodyArenaNodeIsAssignmentTarget(arena: CompilerBodyArena, nodeID: Int): Bool {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == nodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleAssignmentTarget() { return true }
        edgeRow: edgeRow + 1
    }
    return false
}

function compilerBodyMemoryBuildAccessPhase(arena: CompilerBodyArena): Int {
    let phase: Int(compilerBodyMemoryPhaseAccess())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 0 - 1 }
    state resolutionRow: Int(0)
    while resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
        let sourceNodeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionSourceColumn()))
        if targetKind == compilerBodyResolutionLocalSymbol() {
            state accessKind: Int(compilerBodyMemoryFactRead())
            if compilerBodyArenaNodeIsAssignmentTarget(arena: arena, nodeID: sourceNodeID) { accessKind: compilerBodyMemoryFactWriteUnique() }
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: accessKind, sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectSymbol(), subjectID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()), auxID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn())) < 0 { return 0 - 1 }
        }
        if targetKind == compilerBodyResolutionMember() {
            state memberAccessKind: Int(compilerBodyMemoryFactMemberRead())
            if sourceNodeID >= 0 && sourceNodeID < compilerIntTableRowCount(table: arena.nodes)
                && compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 10) == compilerBodyEnumPatternBindingAux() {
                memberAccessKind: compilerBodyMemoryFactEnumPayloadBorrow()
            } else if compilerBodyArenaNodeIsAssignmentTarget(arena: arena, nodeID: sourceNodeID) {
                memberAccessKind: compilerBodyMemoryFactMemberWrite()
            }
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: memberAccessKind, sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: sourceNodeID, auxID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn())) < 0 { return 0 - 1 }
        }
        if targetKind == compilerBodyResolutionOperator()
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()) == compilerSyntaxKindIndex()
            && compilerBodyArenaNodeIsAssignmentTarget(arena: arena, nodeID: sourceNodeID) {
            let mutableArraySymbolID: Int(compilerBodyArenaMutableArraySymbolForTarget(arena: arena, targetNodeID: sourceNodeID))
            if mutableArraySymbolID < 0
                || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactWriteUnique(), sourceNodeID: sourceNodeID, subjectKind: compilerBodyMemorySubjectSymbol(), subjectID: mutableArraySymbolID, auxID: compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: mutableArraySymbolID)) < 0 { return 0 - 1 }
        }
        resolutionRow: resolutionRow + 1
    }
    return compilerBodyMemoryCompletePhase(arena: arena, phase: phase)
}

function compilerBodyArenaResolutionForSource(arena: CompilerBodyArena, sourceNodeID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: row, column: compilerBodyResolutionSourceColumn()) == sourceNodeID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyMemoryBuildPassEscapePhase(arena: CompilerBodyArena, abiPlan: CompilerModuleABIPlan): Int {
    let phase: Int(compilerBodyMemoryPhasePassEscape())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 1 }
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1))
        if nodeKind == compilerSyntaxKindApplication() {
            let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleCallee(), ordinal: 0))
            let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
            if resolutionRow < 0 { return 10000 + nodeRow }
            let targetID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            let resolvedTargetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
            let ordinaryMemberFunction: Bool(resolvedTargetKind == compilerBodyResolutionFunction() && compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindMemberRead())
            if resolvedTargetKind == compilerBodyResolutionMemberRuntimeBuiltin() || ordinaryMemberFunction {
                let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
                if receiverNodeID < 0
                    || compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactArgumentPass(), sourceNodeID: calleeNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: receiverNodeID, auxID: targetID) < 0 { return 11000 + nodeRow }
            }
            state ordinal: Int(0)
            let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeRow))
            while ordinal < argumentCount {
                let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
                let argumentValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
                if argumentNodeID < 0 || argumentValueNodeID < 0 { return 20000 + nodeRow }
                if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactArgumentPass(), sourceNodeID: argumentNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: argumentValueNodeID, auxID: targetID) < 0 { return 21000 + nodeRow }
                ordinal: ordinal + 1
            }
            if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction()
                && (compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeConstruct()
                    || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeEnum())
                && compilerModuleABIPlanReturnMode(plan: abiPlan, tables: arena.tables, index: arena.declarationIndex, functionRow: targetID) == compilerFunctionReturnABIIndirect() {
                let storageID: Int(compilerBodyStorageForCall(arena: arena, callNodeID: nodeRow))
                if storageID < 0 { return 30000 + nodeRow }
                if compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCaller() {
                    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactReturnTransfer(), sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: storageID, auxID: targetID) < 0 { return 31000 + nodeRow }
                }
            }
        }
        if nodeKind == compilerSyntaxKindReturn() {
            let returnValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
            if returnValueNodeID < 0 { return 40000 + nodeRow }
            if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactReturnEscape(), sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectNode(), subjectID: returnValueNodeID, auxID: compilerBodyArenaOwnerAuxID(arena: arena)) < 0 { return 41000 + nodeRow }
            let returnStorageID: Int(compilerBodyCalleeReturnStorage(arena: arena))
            if returnStorageID >= 0 {
                let returnTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: returnValueNodeID))
                let destinationTypeID: Int(compilerIntTableValue(table: arena.storages, row: returnStorageID, column: compilerBodyStorageTypeIDColumn()))
                if returnTypeID < 0 { return 42000 + nodeRow }
                if returnTypeID != destinationTypeID {
                    if !compilerBodyOptionalPayloadMatches(arena: arena, optionalTypeID: destinationTypeID, payloadTypeID: returnTypeID) { return 43000 + nodeRow }
                    if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactOptionalInjection(), sourceNodeID: returnValueNodeID, subjectKind: compilerBodyMemorySubjectNode(), subjectID: returnValueNodeID, auxID: destinationTypeID) < 0 { return 44000 + nodeRow }
                }
                if compilerBodyMemoryAppendFact(arena: arena, phase: phase, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: nodeRow, subjectKind: compilerBodyMemorySubjectStorage(), subjectID: returnStorageID, auxID: destinationTypeID) < 0 { return 45000 + nodeRow }
            }
        }
        nodeRow: nodeRow + 1
    }
    if compilerBodyMemoryCompletePhase(arena: arena, phase: phase) != 0 { return 50000 }
    return 0
}

function compilerBodyMemoryBuildLifetimePhase(arena: CompilerBodyArena): Int {
    let phase: Int(compilerBodyMemoryPhaseLifetime())
    if !compilerBodyMemoryBeginPhase(arena: arena, phase: phase) { return 0 - 1 }
