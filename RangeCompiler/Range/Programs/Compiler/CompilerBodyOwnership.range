            status: 0 - 1
        } else {
            effectPathID: nextPathID
        }
        reverseOrdinal: reverseOrdinal - 1
    }
    rawBufferDestroy(buffer: members)
    if status != 0 { return 0 - 2 }
    return effectPathID
}

