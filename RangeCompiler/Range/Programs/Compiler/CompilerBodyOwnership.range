function compilerBodyArenaOwnedPathSubtreeIsAbsentAt(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, rootPathID: Int, blockID: Int, pathCount: Int): Bool {
    if rootPathID < 0 || rootPathID >= pathCount { return false }
    state pathID: Int(0)
    while pathID < pathCount {
        if compilerBodyArenaOwnedPathIsDescendant(arena: arena, pathID: pathID, ancestorPathID: rootPathID)
            && (compilerBodyArenaOwnedPathStateAt(states: states, pathID: pathID, blockID: blockID, pathCount: pathCount) != compilerBodyOwnedPathAbsent()
                || compilerBodyArenaOwnedPathOriginAt(origins: origins, pathID: pathID, blockID: blockID, pathCount: pathCount) != compilerBodyOwnedOriginUnknown()) { return false }
        pathID: pathID + 1
