    let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
    if pathPolicy == compilerBodyOwnedPathPolicyAlias() && effectKind == compilerBodyOwnedEffectConsume() { return 0 - 1 }
    let targetPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
    if targetPathID < 0 || compilerBodyArenaOwnedPathApplyEffect(arena: arena, states: states, origins: origins, pathID: targetPathID, effectKind: effectKind) != 0 { return 0 - 1 }
    return targetPathID
}

function compilerBodyArenaOwnedEffectForRuntimeRole(role: Int): Int {
    if role == compilerRuntimeABIFunctionSharedRead() { return compilerBodyOwnedEffectShared() }
    if role == compilerRuntimeABIFunctionUniqueWrite() { return compilerBodyOwnedEffectUnique() }
    if role == compilerRuntimeABIFunctionDestroy() { return compilerBodyOwnedEffectConsume() }
    return compilerBodyOwnedEffectNone()
