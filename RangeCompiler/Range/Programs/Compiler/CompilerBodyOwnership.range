}

function compilerBodyStorageIsValid(arena: CompilerBodyArena, storageID: Int): Bool {
    if storageID < 0 || storageID >= compilerIntTableRowCount(table: arena.storages) { return false }
    let placement: Int(compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStoragePlacementColumn()))
    return compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageIDColumn()) == storageID
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageOwnerNodeColumn()) >= 0
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageOwnerNodeColumn()) < compilerIntTableRowCount(table: arena.nodes)
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageTypeIDColumn()) >= 0
        && compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageTypeIDColumn()) < compilerIntTableRowCount(table: arena.typeInstances)
        && (placement == compilerBodyStorageCaller() || placement == compilerBodyStorageCalleeReturn())
