function compilerBodyArenaBindingAliasAppendReturnedAncestors(arena: CompilerBodyArena, destinationLeafPathID: Int, sourceLeafPathID: Int, sourceNodeID: Int): Int {
    state destinationPathID: Int(destinationLeafPathID)
