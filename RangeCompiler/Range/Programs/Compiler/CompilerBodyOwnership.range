    return 0
}

function compilerReachableLLVMStateAppendEffectCallMappingForValue(reachability: CompilerReachableLLVMState, arena: CompilerBodyArena, callerInstanceID: Int, targetInstanceID: Int, calleeBaseKind: Int, calleeOrdinal: Int, valueNodeID: Int): Int {
    if valueNodeID < 0 || valueNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let pathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: valueNodeID))
    if pathID < 0 {
        let valueTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID))
        if valueTypeKind == compilerBodyTypeUnknown() { return 0 - 1 }
        if valueTypeKind != compilerBodyTypeConstruct() { return 0 }
        let valueTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: valueNodeID))
        let trackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: valueTypeID))
        if trackedStatus < 0 || trackedStatus == 1 { return 0 - 1 }
        return 0
    }
    let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
    if canonicalPathID < 0 { return 0 - 1 }
    let rootClass: Int(compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: canonicalPathID))
    if rootClass == compilerBodyOwnedSummaryRootLocalCreate() { return 0 }
    if rootClass != compilerBodyOwnedSummaryRootBoundary() { return 0 - 1 }
    let callerBaseKind: Int(compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: canonicalPathID))
    let callerOrdinal: Int(compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: canonicalPathID))
    let prefixPathID: Int(compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: canonicalPathID, effectPaths: reachability.functionInstanceEffectPaths))
    if callerBaseKind < 0 || callerOrdinal < 0 || prefixPathID == 0 - 2 { return 0 - 1 }
    if compilerBodyFunctionInstanceEffectCallAppend(calls: reachability.functionInstanceEffectCalls, paths: reachability.functionInstanceEffectPaths, callerInstanceID: callerInstanceID, targetInstanceID: targetInstanceID, calleeBaseKind: calleeBaseKind, calleeOrdinal: calleeOrdinal, callerBaseKind: callerBaseKind, callerOrdinal: callerOrdinal, prefixPathID: prefixPathID) < 0 { return 0 - 1 }
    return 0
}

function compilerReachableLLVMStateAppendReachableEffectCandidatesAndCallsForArena(reachability: CompilerReachableLLVMState, arena: CompilerBodyArena, instanceID: Int): Int {
    state scheduleRow: Int(0)
    while scheduleRow < compilerIntTableRowCount(table: arena.cfgSchedule) {
        let applicationNodeID: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleNodeColumn()))
        let scheduleAction: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleActionColumn()))
        if scheduleAction == compilerBodyCFGScheduleEvaluateNode()
            && applicationNodeID >= 0 && applicationNodeID < compilerIntTableRowCount(table: arena.nodes)
            && compilerIntTableValue(table: arena.nodes, row: applicationNodeID, column: 1) == compilerSyntaxKindApplication() {
            let contractRow: Int(compilerBodyRuntimeCallContractFind(contracts: arena.runtimeCallContracts, callNodeID: applicationNodeID))
            if contractRow >= 0 {
                let role: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractRoleColumn()))
                if role != compilerRuntimeABIFunctionCreate() {
                    let storageArgumentOrdinal: Int(compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractStorageArgumentColumn()))
                    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: storageArgumentOrdinal))
                    let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
                    if argumentNodeID < 0 || valueNodeID < 0 { return 0 - 1 }
                    let pathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: valueNodeID))
                    if pathID < 0 { return 0 - 1 }
                    let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
                    if canonicalPathID < 0 { return 0 - 1 }
                    let rootClass: Int(compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: canonicalPathID))
                    if rootClass == compilerBodyOwnedSummaryRootBoundary() {
                        let baseKind: Int(compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: canonicalPathID))
                        let baseOrdinal: Int(compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: canonicalPathID))
                        let storageTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: canonicalPathID, column: compilerBodyOwnedPathTypeColumn()))
                        let storageKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: storageTypeID))
                        let effectPathID: Int(compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: canonicalPathID, effectPaths: reachability.functionInstanceEffectPaths))
                        let effectKind: Int(compilerBodyArenaOwnedEffectForRuntimeRole(role: role))
                        if baseKind < 0 || baseOrdinal < 0 || storageKeyID < 0 || effectPathID == 0 - 2 || effectKind == compilerBodyOwnedEffectNone() { return 0 - 1 }
                        if compilerBodyFunctionInstanceEffectAppend(effects: reachability.functionInstanceEffects, paths: reachability.functionInstanceEffectPaths, instanceID: instanceID, baseKind: baseKind, ordinal: baseOrdinal, memberPathID: effectPathID, storageKeyID: storageKeyID, effectKind: effectKind) < 0 { return 0 - 1 }
                    } else if rootClass != compilerBodyOwnedSummaryRootLocalCreate() {
                        return 0 - 1
                    }
                }
            }
            let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
            let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
            if calleeNodeID < 0 || resolutionRow < 0 { return 0 - 1 }
            if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction() {
                let targetInstanceID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionInstanceIDColumn()))
                if targetInstanceID < 0 || targetInstanceID >= compilerIntTableRowCount(table: reachability.functionInstances) { return 0 - 1 }
                let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
                if receiverNodeID >= 0 {
                    if compilerReachableLLVMStateAppendEffectCallMappingForValue(reachability: reachability, arena: arena, callerInstanceID: instanceID, targetInstanceID: targetInstanceID, calleeBaseKind: compilerBodyOwnedBaseReceiver(), calleeOrdinal: 0, valueNodeID: receiverNodeID) != 0 { return 0 - 1 }
                }
                let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID))
                if argumentCount < 0 { return 0 - 1 }
                state argumentOrdinal: Int(0)
                while argumentOrdinal < argumentCount {
                    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
                    let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
                    if argumentNodeID < 0 || valueNodeID < 0
                        || compilerReachableLLVMStateAppendEffectCallMappingForValue(reachability: reachability, arena: arena, callerInstanceID: instanceID, targetInstanceID: targetInstanceID, calleeBaseKind: compilerBodyOwnedBaseParameter(), calleeOrdinal: argumentOrdinal, valueNodeID: valueNodeID) != 0 { return 0 - 1 }
                    argumentOrdinal: argumentOrdinal + 1
                }
            }
        }
        scheduleRow: scheduleRow + 1
    }
    return 0
}

function compilerReachableLLVMStateClassifyReturnAndCollectDirectEffectsForWorkItem(reachability: CompilerReachableLLVMState, workIndex: Int): Int {
    if workIndex < 0 || workIndex >= rawBufferCount(buffer: reachability.worklist) { return 0 - 1 }
    let functionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
    let instanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
    if functionRow < 0 || instanceID < 0
        || compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: instanceID) != compilerReachableFunctionInstanceReturnSummaryUnknown() { return 0 - 1 }
    let transientMark: Int(stringTransientRegionMark())
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateForFunctionInstance(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow, functionInstanceID: instanceID, receiverTypeKeyID: compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: reachability, instanceID: instanceID), typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments)))
    state status: Int(0)
    if !compilerBodyArenaIsValid(arena: arena) { status: 1 }
    if status == 0 && compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 { status: 2 }
    if status == 0 && compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, arena: arena) != 0 { status: 3 }
    if status == 0 && compilerBodyArenaBuildCFG(arena: arena) != 0 { status: 4 }
    if status == 0 && compilerBodyArenaBuildOwnedPathTables(arena: arena) != 0 { status: 5 }
    let returnTypeID: Int(compilerReachableLLVMStateReturnTypeIDForArena(arena: arena))
    let returnTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID))
    let returnTypeKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: returnTypeID))
    let signatureRow: Int(compilerReachableFunctionInstanceSignatureRow(signatures: reachability.functionInstanceSignatures, instanceID: instanceID))
    if status == 0 {
        if returnTypeID < 0 || returnTypeKind == compilerBodyTypeUnknown() || returnTypeKeyID < 0 || signatureRow < 0
            || compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKeyColumn()) != returnTypeKeyID
            || compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKindColumn()) != returnTypeKind { status: 6 }
    }
    if status == 0 && compilerReachableLLVMStateAppendReachableEffectCandidatesAndCallsForArena(reachability: reachability, arena: arena, instanceID: instanceID) != 0 { status: 7 }
    if status == 0 {
        let trackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: returnTypeID))
        if trackedStatus < 0 {
            status: 8
        } else {
            state summaryStatus: Int(compilerReachableFunctionInstanceReturnSummaryUnknown())
            if trackedStatus == 0 { summaryStatus: compilerReachableFunctionInstanceReturnSummaryNoTrackedStorage() }
            if compilerReachableLLVMStateSetReturnSummary(reachability: reachability, instanceID: instanceID, status: summaryStatus, typeKeyID: returnTypeKeyID, typeKind: returnTypeKind, firstLeaf: 0 - 1, leafCount: 0) != 0 { status: 9 }
        }
    }
    let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if status == 0 && destroyStatus != 0 { status: 10 }
    stringTransientRegionReset(mark: transientMark)
    if status != 0 { return 0 - status }
    return 0
}

function compilerReachableLLVMStateCloseFunctionInstanceEffects(reachability: CompilerReachableLLVMState, effects: CompilerIntTable): Int {
    let instanceCount: Int(compilerIntTableRowCount(table: reachability.functionInstances))
    let mappingCount: Int(compilerIntTableRowCount(table: reachability.functionInstanceEffectCalls))
    let maximumDepth: Int(compilerIntTableRowCount(table: reachability.context.tables.members) + 1)
    let maximumPassCount: Int(instanceCount * maximumDepth + mappingCount + 16)
    state pass: Int(0)
    state changed: Bool(true)
    while changed {
        if pass >= maximumPassCount { return 0 - 1 }
        changed: false
        state mappingRow: Int(0)
        while mappingRow < mappingCount {
            let callerInstanceID: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallCallerColumn()))
            let targetInstanceID: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallTargetColumn()))
            let calleeBaseKind: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallCalleeBaseKindColumn()))
            let calleeOrdinal: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallCalleeOrdinalColumn()))
            let callerBaseKind: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallCallerBaseKindColumn()))
            let callerOrdinal: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallCallerOrdinalColumn()))
            let prefixPathID: Int(compilerIntTableValue(table: reachability.functionInstanceEffectCalls, row: mappingRow, column: compilerBodyFunctionInstanceEffectCallPrefixPathColumn()))
            if callerInstanceID < 0 || callerInstanceID >= instanceCount || targetInstanceID < 0 || targetInstanceID >= instanceCount
                || !compilerBodyFunctionInstanceEffectPathIsValid(paths: reachability.functionInstanceEffectPaths, pathID: prefixPathID) { return 0 - 1 }
            let effectCountAtStart: Int(compilerIntTableRowCount(table: effects))
            state effectRow: Int(0)
            while effectRow < effectCountAtStart {
                if compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectInstanceColumn()) == targetInstanceID
                    && compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectBaseKindColumn()) == calleeBaseKind
                    && compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectOrdinalColumn()) == calleeOrdinal {
                    let suffixPathID: Int(compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectPathColumn()))
                    let combinedPathID: Int(compilerBodyFunctionInstanceEffectPathConcat(paths: reachability.functionInstanceEffectPaths, prefixPathID: prefixPathID, suffixPathID: suffixPathID))
                    if combinedPathID == 0 - 2 { return 0 - 1 }
                    if combinedPathID >= 0 && compilerIntTableValue(table: reachability.functionInstanceEffectPaths, row: combinedPathID, column: compilerBodyFunctionInstanceEffectPathDepthColumn()) > maximumDepth { return 0 - 1 }
                    let storageKeyID: Int(compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectStorageKeyColumn()))
                    let effectKind: Int(compilerIntTableValue(table: effects, row: effectRow, column: compilerBodyFunctionInstanceEffectKindColumn()))
                    if storageKeyID < 0 || storageKeyID >= compilerIntTableRowCount(table: reachability.typeKeys)
                        || effectKind < compilerBodyOwnedEffectShared() || effectKind > compilerBodyOwnedEffectConsume() { return 0 - 1 }
                    let appendStatus: Int(compilerBodyFunctionInstanceEffectAppend(effects: effects, paths: reachability.functionInstanceEffectPaths, instanceID: callerInstanceID, baseKind: callerBaseKind, ordinal: callerOrdinal, memberPathID: combinedPathID, storageKeyID: storageKeyID, effectKind: effectKind))
                    if appendStatus < 0 { return 0 - 1 }
                    if appendStatus > 0 { changed: true }
                }
                effectRow: effectRow + 1
            }
            mappingRow: mappingRow + 1
        }
        pass: pass + 1
    }
    return 0
}

function compilerReachableLLVMStateOwnedReturnDependenciesResolved(reachability: CompilerReachableLLVMState, instanceID: Int): Int {
    if rawBufferCount(buffer: reachability.instanceEdgeOwners) != rawBufferCount(buffer: reachability.instanceEdgeTargets) { return 0 - 1 }
    state edgeIndex: Int(0)
    while edgeIndex < rawBufferCount(buffer: reachability.instanceEdgeTargets) {
        if rawBufferLoadInt(buffer: reachability.instanceEdgeOwners, index: edgeIndex) == instanceID {
            let targetInstanceID: Int(rawBufferLoadInt(buffer: reachability.instanceEdgeTargets, index: edgeIndex))
            if targetInstanceID < 0 || targetInstanceID >= compilerIntTableRowCount(table: reachability.functionInstances) { return 0 - 1 }
            let targetStatus: Int(compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: targetInstanceID))
            if targetStatus == compilerReachableFunctionInstanceReturnSummaryUnknown() { return 0 }
            if targetStatus != compilerReachableFunctionInstanceReturnSummaryNoTrackedStorage()
                && targetStatus != compilerReachableFunctionInstanceReturnSummarySupported() { return 0 - 1 }
        }
        edgeIndex: edgeIndex + 1
    }
    return 1
}

function compilerReachableLLVMStateBuildOwnedReturnSummaryForWorkItem(reachability: CompilerReachableLLVMState, workIndex: Int): Int {
    if workIndex < 0 || workIndex >= rawBufferCount(buffer: reachability.worklist) { return 0 - 1 }
    let functionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
    let instanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
    if functionRow < 0 || instanceID < 0
        || compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: instanceID) != compilerReachableFunctionInstanceReturnSummaryUnknown() { return 0 - 1 }
    let transientMark: Int(stringTransientRegionMark())
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateForFunctionInstance(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow, functionInstanceID: instanceID, receiverTypeKeyID: compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: reachability, instanceID: instanceID), typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments)))
    state status: Int(0)
    if !compilerBodyArenaIsValid(arena: arena) { status: 1 }
    if status == 0 && compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 { status: 2 }
    if status == 0 && compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, arena: arena) != 0 { status: 3 }
    if status == 0 && compilerBodyArenaBuildCFG(arena: arena) != 0 { status: 4 }
    if status == 0 && compilerBodyArenaBuildOwnedPathTables(arena: arena) != 0 { status: 5 }
    if status == 0 && compilerBodyArenaValidateOwnedPaths(arena: arena, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, effects: reachability.functionInstanceEffects, effectPaths: reachability.functionInstanceEffectPaths, returnSummaries: reachability.functionInstanceReturnSummaries, returnLeaves: reachability.functionInstanceReturnLeaves, applyInstanceEffects: true, recordFacts: false) != 0 { status: 6 }
    if status == 0 && compilerReachableLLVMStateBuildReturnSummaryForArena(reachability: reachability, arena: arena, instanceID: instanceID) <= 0 { status: 7 }
    let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if status == 0 && destroyStatus != 0 { status: 8 }
    stringTransientRegionReset(mark: transientMark)
    if status != 0 { return 0 - status }
    return 0
}

function compilerReachableLLVMStateBuildOwnedReturnSummaries(reachability: CompilerReachableLLVMState): Int {
    state unresolved: Bool(true)
    state pass: Int(0)
    let maximumPassCount: Int(compilerIntTableRowCount(table: reachability.functionInstances) + 1)
    while unresolved {
        if pass >= maximumPassCount { return compilerReachableLLVMStateSetReturnFailure(reachability: reachability, kind: compilerReachableLLVMReturnFailurePassLimit(), functionRow: 0 - 1, detail: pass) }
        unresolved: false
        state changed: Bool(false)
        state workIndex: Int(0)
        while workIndex < rawBufferCount(buffer: reachability.worklist) {
            let instanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
            if compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: instanceID) == compilerReachableFunctionInstanceReturnSummaryUnknown() {
                unresolved: true
                let functionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
                let dependencyStatus: Int(compilerReachableLLVMStateOwnedReturnDependenciesResolved(reachability: reachability, instanceID: instanceID))
                if dependencyStatus < 0 { return compilerReachableLLVMStateSetReturnFailure(reachability: reachability, kind: compilerReachableLLVMReturnFailureDependency(), functionRow: functionRow, detail: 0 - dependencyStatus) }
                if dependencyStatus == 1 {
                    let buildStatus: Int(compilerReachableLLVMStateBuildOwnedReturnSummaryForWorkItem(reachability: reachability, workIndex: workIndex))
                    if buildStatus != 0 { return compilerReachableLLVMStateSetReturnFailure(reachability: reachability, kind: compilerReachableLLVMReturnFailureProof(), functionRow: functionRow, detail: 0 - buildStatus) }
                    changed: true
                }
            }
            workIndex: workIndex + 1
        }
        if unresolved && !changed {
            state unresolvedWorkIndex: Int(0)
            while unresolvedWorkIndex < rawBufferCount(buffer: reachability.worklist) {
                let unresolvedInstanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: unresolvedWorkIndex))
                if compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: unresolvedInstanceID) == compilerReachableFunctionInstanceReturnSummaryUnknown() {
                    return compilerReachableLLVMStateSetReturnFailure(reachability: reachability, kind: compilerReachableLLVMReturnFailureUnresolved(), functionRow: rawBufferLoadInt(buffer: reachability.worklist, index: unresolvedWorkIndex), detail: unresolvedInstanceID)
                }
                unresolvedWorkIndex: unresolvedWorkIndex + 1
            }
            return compilerReachableLLVMStateSetReturnFailure(reachability: reachability, kind: compilerReachableLLVMReturnFailureUnresolved(), functionRow: 0 - 1, detail: pass)
        }
        pass: pass + 1
    }
    return 0
}

function compilerReachableLLVMStateReturnSummariesAreValid(reachability: CompilerReachableLLVMState): Bool {
    let instanceCount: Int(compilerIntTableRowCount(table: reachability.functionInstances))
    let leafCount: Int(compilerIntTableRowCount(table: reachability.functionInstanceReturnLeaves))
    if !compilerIntTableIsComplete(table: reachability.functionInstanceReturnSummaries)
        || !compilerIntTableIsComplete(table: reachability.functionInstanceReturnLeaves)
        || compilerIntTableRowCount(table: reachability.functionInstanceReturnSummaries) != instanceCount { return false }
    state referencedLeafCount: Int(0)
    state instanceID: Int(0)
    while instanceID < instanceCount {
        let signatureRow: Int(compilerReachableFunctionInstanceSignatureRow(signatures: reachability.functionInstanceSignatures, instanceID: instanceID))
        let status: Int(compilerReachableLLVMStateReturnSummaryStatus(reachability: reachability, instanceID: instanceID))
        let firstLeaf: Int(compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: instanceID, column: compilerReachableFunctionInstanceReturnSummaryFirstLeafColumn()))
        let instanceLeafCount: Int(compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: instanceID, column: compilerReachableFunctionInstanceReturnSummaryLeafCountColumn()))
        if signatureRow < 0
            || compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: instanceID, column: compilerReachableFunctionInstanceReturnSummaryInstanceColumn()) != instanceID
            || compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: instanceID, column: compilerReachableFunctionInstanceReturnSummaryTypeKeyColumn()) != compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKeyColumn())
            || compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: instanceID, column: compilerReachableFunctionInstanceReturnSummaryTypeKindColumn()) != compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKindColumn()) { return false }
        if status == compilerReachableFunctionInstanceReturnSummaryNoTrackedStorage() {
            if firstLeaf != 0 - 1 || instanceLeafCount != 0 { return false }
        } else if status == compilerReachableFunctionInstanceReturnSummarySupported() {
            if firstLeaf < 0 || instanceLeafCount <= 0 || firstLeaf + instanceLeafCount > leafCount { return false }
            state priorInstanceID: Int(0)
            while priorInstanceID < instanceID {
                let priorFirstLeaf: Int(compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: priorInstanceID, column: compilerReachableFunctionInstanceReturnSummaryFirstLeafColumn()))
                let priorLeafCount: Int(compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: priorInstanceID, column: compilerReachableFunctionInstanceReturnSummaryLeafCountColumn()))
                if priorFirstLeaf >= 0 && firstLeaf < priorFirstLeaf + priorLeafCount && priorFirstLeaf < firstLeaf + instanceLeafCount { return false }
                priorInstanceID: priorInstanceID + 1
            }
            referencedLeafCount: referencedLeafCount + instanceLeafCount
            state leafOffset: Int(0)
            while leafOffset < instanceLeafCount {
                let leafRow: Int(firstLeaf + leafOffset)
                let returnPathID: Int(compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafPathColumn()))
                let sourceKind: Int(compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourceKindColumn()))
                let baseKind: Int(compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn()))
                let ordinal: Int(compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn()))
                let sourcePathID: Int(compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn()))
                if compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafInstanceColumn()) != instanceID
                    || !compilerBodyFunctionInstanceEffectPathIsValid(paths: reachability.functionInstanceEffectPaths, pathID: returnPathID)
                    || compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafStorageKeyColumn()) < 0
                    || compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: leafRow, column: compilerReachableFunctionInstanceReturnLeafStorageKeyColumn()) >= compilerIntTableRowCount(table: reachability.typeKeys) { return false }
                if sourceKind == compilerReachableFunctionInstanceReturnSourceLocalCreate() {
                    if baseKind != 0 - 1 || ordinal != 0 - 1 || sourcePathID != 0 - 1 { return false }
                } else if sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                    || sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward() {
                    let functionRow: Int(compilerIntTableValue(table: reachability.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn()))
                    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: reachability.context.tables.functions)
                        || functionRow >= rawBufferCount(buffer: reachability.context.tables.functionOwners)
                        || ordinal < 0
                        || !compilerBodyFunctionInstanceEffectPathIsValid(paths: reachability.functionInstanceEffectPaths, pathID: sourcePathID) { return false }
                    if baseKind == compilerBodyOwnedBaseParameter() {
                        if ordinal >= compilerIntTableValue(table: reachability.context.tables.functions, row: functionRow, column: 3) { return false }
                    } else if baseKind == compilerBodyOwnedBaseReceiver() {
                        let ownerSyntaxID: Int(rawBufferLoadInt(buffer: reachability.context.tables.functionOwners, index: functionRow))
                        let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: ownerSyntaxID))
                        if ordinal != 0 || ownerDeclarationRow < 0
                            || compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 2) != compilerSyntaxKindConstruct() { return false }
                    } else { return false }
                } else { return false }
                state priorOffset: Int(0)
                while priorOffset < leafOffset {
                    let priorLeafRow: Int(firstLeaf + priorOffset)
                    let priorSourceKind: Int(compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafSourceKindColumn()))
                    if compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafPathColumn()) == returnPathID { return false }
                    let aliasForwardConflict: Bool((sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias()
                            && priorSourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward())
                        || (sourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryForward()
                            && priorSourceKind == compilerReachableFunctionInstanceReturnSourceBoundaryAlias()))
                    if aliasForwardConflict
                        && baseKind == compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafBaseKindColumn())
                        && ordinal == compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafOrdinalColumn())
                        && sourcePathID == compilerIntTableValue(table: reachability.functionInstanceReturnLeaves, row: priorLeafRow, column: compilerReachableFunctionInstanceReturnLeafSourcePathColumn()) { return false }
                    priorOffset: priorOffset + 1
                }
                leafOffset: leafOffset + 1
            }
        } else { return false }
        instanceID: instanceID + 1
    }
    return referencedLeafCount == leafCount
}

function compilerReachableLLVMStateProjectValidatedEffectsForArena(reachability: CompilerReachableLLVMState, arena: CompilerBodyArena, instanceID: Int, validatedEffects: CompilerIntTable): Int {
    state factRow: Int(0)
    while factRow < compilerIntTableRowCount(table: arena.memoryFacts) {
        let factKind: Int(compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactKindColumn()))
        state effectKind: Int(compilerBodyOwnedEffectNone())
        if factKind == compilerBodyMemoryFactSharedBorrow() { effectKind: compilerBodyOwnedEffectShared() }
        if factKind == compilerBodyMemoryFactUniqueBorrow() { effectKind: compilerBodyOwnedEffectUnique() }
        if factKind == compilerBodyMemoryFactConsume() { effectKind: compilerBodyOwnedEffectConsume() }
        if effectKind != compilerBodyOwnedEffectNone() {
            let sourceNodeID: Int(compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactSourceColumn()))
            let contractRow: Int(compilerBodyRuntimeCallContractFind(contracts: arena.runtimeCallContracts, callNodeID: sourceNodeID))
            if contractRow >= 0 {
            let pathID: Int(compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactSubjectIDColumn()))
            if compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactPhaseColumn()) != compilerBodyMemoryPhasePassEscape()
                || compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactSubjectKindColumn()) != compilerBodyMemorySubjectOwnedPath()
                || compilerBodyArenaOwnedEffectForRuntimeRole(role: compilerIntTableValue(table: arena.runtimeCallContracts, row: contractRow, column: compilerBodyRuntimeCallContractRoleColumn())) != effectKind
                || pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
            let rootClass: Int(compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: pathID))
            if rootClass == compilerBodyOwnedSummaryRootBoundary() {
                let baseKind: Int(compilerBodyArenaOwnedPathBaseKind(arena: arena, pathID: pathID))
                let baseOrdinal: Int(compilerBodyArenaOwnedPathBaseOrdinal(arena: arena, pathID: pathID))
                let storageTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn()))
                let storageKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: storageTypeID))
                let effectPathID: Int(compilerBodyArenaOwnedPathToEffectPath(arena: arena, ownedPathID: pathID, effectPaths: reachability.functionInstanceEffectPaths))
                if baseKind < 0 || baseOrdinal < 0 || storageKeyID < 0 || effectPathID == 0 - 2
                    || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: storageTypeID)
                    || compilerBodyFunctionInstanceEffectAppend(effects: validatedEffects, paths: reachability.functionInstanceEffectPaths, instanceID: instanceID, baseKind: baseKind, ordinal: baseOrdinal, memberPathID: effectPathID, storageKeyID: storageKeyID, effectKind: effectKind) < 0 { return 0 - 1 }
            } else if rootClass != compilerBodyOwnedSummaryRootLocalCreate() {
                return 0 - 1
            }
            }
        }
        factRow: factRow + 1
    }
    return 0
}

function compilerBodyFunctionInstanceEffectsAreEqual(left: CompilerIntTable, right: CompilerIntTable): Bool {
    if !compilerIntTableIsComplete(table: left) || !compilerIntTableIsComplete(table: right)
        || compilerIntTableRowCount(table: left) != compilerIntTableRowCount(table: right) { return false }
    state leftRow: Int(0)
    while leftRow < compilerIntTableRowCount(table: left) {
        let matchingRightRow: Int(compilerBodyFunctionInstanceEffectFind(effects: right, instanceID: compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectInstanceColumn()), baseKind: compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectBaseKindColumn()), ordinal: compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectOrdinalColumn()), memberPathID: compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectPathColumn())))
        if matchingRightRow < 0
            || compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectMemberColumn()) != compilerIntTableValue(table: right, row: matchingRightRow, column: compilerBodyFunctionInstanceEffectMemberColumn())
            || compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectStorageKeyColumn()) != compilerIntTableValue(table: right, row: matchingRightRow, column: compilerBodyFunctionInstanceEffectStorageKeyColumn())
            || compilerIntTableValue(table: left, row: leftRow, column: compilerBodyFunctionInstanceEffectKindColumn()) != compilerIntTableValue(table: right, row: matchingRightRow, column: compilerBodyFunctionInstanceEffectKindColumn()) { return false }
        leftRow: leftRow + 1
    }
    return true
}

function compilerReachableLLVMStateValidateFunctionInstanceEffectsForWorkItem(reachability: CompilerReachableLLVMState, workIndex: Int, validatedEffects: CompilerIntTable): Int {
    if workIndex < 0 || workIndex >= rawBufferCount(buffer: reachability.worklist) { return 0 - 1 }
    let functionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
    let instanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
    if functionRow < 0 || instanceID < 0 { return 0 - 1 }
    let transientMark: Int(stringTransientRegionMark())
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateForFunctionInstance(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow, functionInstanceID: instanceID, receiverTypeKeyID: compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: reachability, instanceID: instanceID), typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments)))
    state status: Int(0)
    if !compilerBodyArenaIsValid(arena: arena) { status: 1 }
    if status == 0 {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 { status: 2 }
    }
    if status == 0 {
        let bindingStatus: Int(compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, arena: arena))
        if bindingStatus != 0 { status: 3 }
    }
    if status == 0 {
        if compilerBodyArenaBuildCFG(arena: arena) != 0 { status: 4 }
    }
    if status == 0 {
        if compilerBodyArenaBuildOwnedPathTables(arena: arena) != 0 { status: 5 }
    }
    if status == 0 {
        let ownedPathStatus: Int(compilerBodyArenaValidateOwnedPaths(arena: arena, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, effects: reachability.functionInstanceEffects, effectPaths: reachability.functionInstanceEffectPaths, returnSummaries: reachability.functionInstanceReturnSummaries, returnLeaves: reachability.functionInstanceReturnLeaves, applyInstanceEffects: true, recordFacts: true))
        if ownedPathStatus != 0 { status: 6000 + (0 - ownedPathStatus) }
    }
    if status == 0 && compilerReachableLLVMStateProjectValidatedEffectsForArena(reachability: reachability, arena: arena, instanceID: instanceID, validatedEffects: validatedEffects) != 0 { status: 7 }
    let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if status == 0 {
        if destroyStatus != 0 { status: 8 }
    }
    state result: Int(0)
    if status != 0 { result: 0 - status }
    stringTransientRegionReset(mark: transientMark)
    return result
}

function compilerReachableLLVMStateValidateFunctionInstanceEffects(reachability: CompilerReachableLLVMState): Int {
    let validatedEffects: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectColumnCount(), estimatedRowCount: compilerIntTableRowCount(table: reachability.functionInstanceEffects) + 16))
    state status: Int(0)
    state workIndex: Int(0)
    while status == 0 && workIndex < rawBufferCount(buffer: reachability.worklist) {
        let validationStatus: Int(compilerReachableLLVMStateValidateFunctionInstanceEffectsForWorkItem(reachability: reachability, workIndex: workIndex, validatedEffects: validatedEffects))
        if validationStatus != 0 {
            let failureFunctionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
            let failureInstanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
            if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureFunction(), value: failureFunctionRow) != 0
                || rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureInstance(), value: failureInstanceID) != 0
                || rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureDetail(), value: 0 - validationStatus) != 0 {
                status: 0 - 11
            } else {
                status: validationStatus
            }
        }
        workIndex: workIndex + 1
    }
    if status == 0 && compilerReachableLLVMStateCloseFunctionInstanceEffects(reachability: reachability, effects: validatedEffects) != 0 { status: 0 - 9 }
    if status == 0 && !compilerBodyFunctionInstanceEffectsAreEqual(left: reachability.functionInstanceEffects, right: validatedEffects) { status: 0 - 9 }
    let destroyStatus: Int(compilerIntTableDestroy(table: validatedEffects))
    if status == 0 && destroyStatus != 0 { status: 0 - 10 }
    return status
}

function compilerReachableLLVMStateBuildFunctionInstanceEffects(reachability: CompilerReachableLLVMState): Int {
    if compilerIntTableRowCount(table: reachability.functionInstanceEffects) != 0
        || compilerIntTableRowCount(table: reachability.functionInstanceEffectPaths) != 0
        || compilerIntTableRowCount(table: reachability.functionInstanceEffectCalls) != 0
        || compilerIntTableRowCount(table: reachability.functionInstanceReturnLeaves) != 0 { return 0 - 1 }
    state workIndex: Int(0)
    while workIndex < rawBufferCount(buffer: reachability.worklist) {
        if compilerReachableLLVMStateClassifyReturnAndCollectDirectEffectsForWorkItem(reachability: reachability, workIndex: workIndex) != 0 { return 0 - 2 }
        workIndex: workIndex + 1
    }
    if compilerReachableLLVMStateCloseFunctionInstanceEffects(reachability: reachability, effects: reachability.functionInstanceEffects) != 0 { return 0 - 3 }
    let ownedReturnStatus: Int(compilerReachableLLVMStateBuildOwnedReturnSummaries(reachability: reachability))
    if ownedReturnStatus != 0 { return 0 - 4 }
    if !compilerReachableLLVMStateReturnSummariesAreValid(reachability: reachability) { return 0 - 5 }
    return compilerReachableLLVMStateValidateFunctionInstanceEffects(reachability: reachability)
}

function compilerReachableLLVMStateValidateEntryOwnedPaths(reachability: CompilerReachableLLVMState): Int {
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateEntry(tables: reachability.context.tables, index: reachability.context.declarationIndex)))
    state status: Int(0)
    if !compilerBodyArenaIsValid(arena: arena) { status: 1 }
    if status == 0 {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 { status: 2 }
    }
    if status == 0 {
        let bindStatus: Int(compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, arena: arena))
        if bindStatus != 0 { status: 3000 + (0 - bindStatus) }
    }
    if status == 0 {
        if compilerBodyArenaBuildCFG(arena: arena) != 0 { status: 4 }
    }
    if status == 0 {
        if compilerBodyArenaBuildOwnedPathTables(arena: arena) != 0 { status: 5 }
    }
    if status == 0 {
        let ownedPathStatus: Int(compilerBodyArenaValidateOwnedPaths(arena: arena, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, effects: reachability.functionInstanceEffects, effectPaths: reachability.functionInstanceEffectPaths, returnSummaries: reachability.functionInstanceReturnSummaries, returnLeaves: reachability.functionInstanceReturnLeaves, applyInstanceEffects: true, recordFacts: false))
        if ownedPathStatus != 0 { status: 6000 + (0 - ownedPathStatus) }
    }
    let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if status == 0 {
        if destroyStatus != 0 { status: 7 }
    }
    return status
}
