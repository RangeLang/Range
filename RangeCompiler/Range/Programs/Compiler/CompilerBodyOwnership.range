        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if argumentNodeID < 0 { return 0 - 1 }
        return compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0)
    }
    return 0 - 1
}

function compilerBodyArenaCallBoundaryPath(arena: CompilerBodyArena, applicationNodeID: Int, calleeNodeID: Int, baseKind: Int, ordinal: Int): Int {
    let valueNodeID: Int(compilerBodyArenaCallBoundaryValueNode(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID, baseKind: baseKind, ordinal: ordinal))
