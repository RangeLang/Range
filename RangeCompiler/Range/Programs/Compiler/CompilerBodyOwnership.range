function compilerBodyArenaOwnedPathApplyEffectThroughAlias(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathID: Int, effectKind: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
