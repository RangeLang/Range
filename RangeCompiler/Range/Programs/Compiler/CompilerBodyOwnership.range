            && compilerIntTableValue(table: arena.mirExpressionValues, row: row, column: compilerBodyMIRExpressionValueActionColumn()) == action {
            return compilerIntTableValue(table: arena.mirExpressionValues, row: row, column: compilerBodyMIRExpressionValueValueColumn())
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyMIRAppendExpressionValue(arena: CompilerBodyArena, nodeID: Int, action: Int, valueID: Int, blockID: Int): Int {
    if compilerBodyMIRExpressionValue(arena: arena, nodeID: nodeID, action: action) >= 0 { return 0 - 1 }
