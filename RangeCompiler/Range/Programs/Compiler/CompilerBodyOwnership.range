}

function compilerBodyArenaOwnedPathOpaqueLeafCanDeactivateAt(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathID: Int, blockID: Int, pathCount: Int): Bool {
    if pathID < 0 || pathID >= pathCount
        || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn())) { return false }
    let policy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
    let stateValue: Int(compilerBodyArenaOwnedPathStateAt(states: states, pathID: pathID, blockID: blockID, pathCount: pathCount))
    let originPathID: Int(compilerBodyArenaOwnedPathOriginAt(origins: origins, pathID: pathID, blockID: blockID, pathCount: pathCount))
    if policy == compilerBodyOwnedPathPolicyOwned() {
        if originPathID == compilerBodyOwnedOriginLocal() { return stateValue == compilerBodyOwnedPathMoved() || stateValue == compilerBodyOwnedPathConsumed() }
        if compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID) { return stateValue == compilerBodyOwnedPathMoved() }
        return false
    }
    if policy == compilerBodyOwnedPathPolicyAlias() {
        if stateValue == compilerBodyOwnedPathMoved() && originPathID == compilerBodyOwnedOriginUnknown() { return true }
        let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: pathID))
        return stateValue == compilerBodyOwnedPathLive() && originPathID == compilerBodyOwnedOriginUnknown()
            && canonicalPathID >= 0 && canonicalPathID != pathID
            && compilerBodyArenaOwnedPathStateAt(states: states, pathID: canonicalPathID, blockID: blockID, pathCount: pathCount) == compilerBodyOwnedPathLive()
    }
    return false
}

function compilerBodyArenaOwnedPathSubtreeCanDeactivateAt(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, rootPathID: Int, blockID: Int, pathCount: Int): Bool {
    if rootPathID < 0 || rootPathID >= pathCount { return false }
