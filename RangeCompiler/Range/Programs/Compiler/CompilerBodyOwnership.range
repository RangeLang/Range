            && compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID) == compilerBodyOwnedPathActivationEvaluationTemporary() {
            let applicationNodeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: rootPathID, column: compilerBodyOwnedPathRootIDColumn()))
            if applicationNodeID < 0 || applicationNodeID >= nodeCount
