    while ordinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: argumentNodeID) == memberRow {
            return compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0)
        }
        ordinal: ordinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeListContains(values: RawBuffer, value: Int): Bool {
    state row: Int(0)
    while row < rawBufferCount(buffer: values) {
