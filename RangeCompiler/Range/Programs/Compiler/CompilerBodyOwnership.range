function compilerBodyArenaOwnedPathIndexEvaluationRoots(arena: CompilerBodyArena, pathRoots: RawBuffer, nodeRootValues: RawBuffer): Int {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    let nodeCount: Int(compilerIntTableRowCount(table: arena.nodes))
    if rawBufferCount(buffer: pathRoots) != pathCount || rawBufferCount(buffer: nodeRootValues) != nodeCount { return 0 - 1 }
