    return outgoingCount == 0
}

function compilerBodyArenaOwnedPathCurrentStateIsTerminalValid(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathRoots: RawBuffer): Bool {
    let pathCount: Int(compilerIntTableRowCount(table: arena.ownedPaths))
    state pathRow: Int(0)
    while pathRow < pathCount {
        let pathTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathTypeColumn()))
        if !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: pathTypeID) {
            pathRow: pathRow + 1
        } else {
        let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathRow, column: compilerBodyOwnedPathPolicyColumn()))
        let pathState: Int(compilerBodyArenaOwnedPathState(states: states, pathID: pathRow))
        let originPathID: Int(compilerBodyArenaOwnedPathOrigin(origins: origins, pathID: pathRow))
        let rootPathID: Int(compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: pathRow, pathCount: pathCount))
        let activationKind: Int(compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID))
        if pathState == compilerBodyOwnedPathAbsent() {
            if originPathID != compilerBodyOwnedOriginUnknown()
                || (activationKind != compilerBodyOwnedPathActivationLexicalSymbol() && activationKind != compilerBodyOwnedPathActivationEvaluationTemporary()) { return false }
        } else if pathState == compilerBodyOwnedPathUnknown() {
            return false
        } else if pathPolicy == compilerBodyOwnedPathPolicyOwned() {
            if originPathID == compilerBodyOwnedOriginLocal() {
                if pathState != compilerBodyOwnedPathMoved() && pathState != compilerBodyOwnedPathConsumed() { return false }
            } else if compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID) {
                if pathState != compilerBodyOwnedPathMoved() { return false }
            } else { return false }
        } else if pathPolicy == compilerBodyOwnedPathPolicyBorrowed() {
            if !compilerBodyArenaOwnedPathOriginIsBoundary(arena: arena, originPathID: originPathID)
                || (pathState != compilerBodyOwnedPathLive() && pathState != compilerBodyOwnedPathMoved() && pathState != compilerBodyOwnedPathConsumed()) { return false }
        } else if pathPolicy == compilerBodyOwnedPathPolicyAlias() {
            if originPathID != compilerBodyOwnedOriginUnknown() || pathState != compilerBodyOwnedPathLive() { return false }
        } else { return false }
        pathRow: pathRow + 1
        }
    }
    return true
}

function compilerBodyArenaOwnedPathTerminalStatesAreConsistent(arena: CompilerBodyArena, states: RawBuffer, origins: RawBuffer, pathRoots: RawBuffer, blockCount: Int, pathCount: Int): Bool {
    state pathID: Int(0)
    while pathID < pathCount {
        let pathTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathTypeColumn()))
        let pathPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: pathID, column: compilerBodyOwnedPathPolicyColumn()))
        if compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: pathTypeID) {
            state hasTerminalState: Bool(false)
            state hasTerminalBlock: Bool(false)
            state canonicalTerminalState: Int(compilerBodyOwnedPathUnknown())
            state canonicalTerminalOrigin: Int(compilerBodyOwnedOriginUnknown())
            state blockID: Int(0)
            while blockID < blockCount {
                if compilerBodyArenaOwnedPathBlockIsTerminal(arena: arena, blockID: blockID) {
                    hasTerminalBlock: true
                    if rawBufferLoadInt(buffer: states, index: compilerBodyArenaOwnedPathBlockProcessedIndex(blockID: blockID, blockCount: blockCount, pathCount: pathCount)) != 1 { return false }
                    let terminalState: Int(rawBufferLoadInt(buffer: states, index: compilerBodyArenaOwnedPathBlockStateIndex(blockID: blockID, pathID: pathID, pathCount: pathCount)))
                    let terminalOrigin: Int(rawBufferLoadInt(buffer: origins, index: compilerBodyArenaOwnedPathBlockStateIndex(blockID: blockID, pathID: pathID, pathCount: pathCount)))
                    if terminalState == compilerBodyOwnedPathAbsent() {
                        let rootPathID: Int(compilerBodyArenaOwnedPathCachedRootPathID(pathRoots: pathRoots, pathID: pathID, pathCount: pathCount))
                        let activationKind: Int(compilerBodyArenaOwnedPathActivationKindForRoot(arena: arena, rootPathID: rootPathID))
                        if terminalOrigin != compilerBodyOwnedOriginUnknown()
                            || (activationKind != compilerBodyOwnedPathActivationLexicalSymbol() && activationKind != compilerBodyOwnedPathActivationEvaluationTemporary()) { return false }
                    } else {
                        if terminalState == compilerBodyOwnedPathUnknown() { return false }
                        if pathPolicy == compilerBodyOwnedPathPolicyBorrowed()
                            && terminalState != compilerBodyOwnedPathLive() && terminalState != compilerBodyOwnedPathMoved() && terminalState != compilerBodyOwnedPathConsumed() { return false }
                        if pathPolicy == compilerBodyOwnedPathPolicyAlias() && terminalState != compilerBodyOwnedPathLive() { return false }
                        if !hasTerminalState {
                            canonicalTerminalState: terminalState
                            canonicalTerminalOrigin: terminalOrigin
                            hasTerminalState: true
                        } else if terminalOrigin != canonicalTerminalOrigin
                            || ((pathPolicy == compilerBodyOwnedPathPolicyBorrowed() || pathPolicy == compilerBodyOwnedPathPolicyAlias()) && terminalState != canonicalTerminalState) {
                            return false
                        }
                    }
                }
                blockID: blockID + 1
            }
            if !hasTerminalBlock { return false }
        }
        pathID: pathID + 1
    }
    return true
}

function compilerBodyArenaOwnedPathEvaluateBlock(arena: CompilerBodyArena, blockID: Int, states: RawBuffer, origins: RawBuffer, scheduleStarts: RawBuffer, scheduleCounts: RawBuffer, scheduleRows: RawBuffer, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effects: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable, returnLeaves: CompilerIntTable, applyInstanceEffects: Bool, recordFacts: Bool): Int {
