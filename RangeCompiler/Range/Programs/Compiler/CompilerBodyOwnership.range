}

function compilerBodyOwnedSemanticFactsAreValid(arena: CompilerBodyArena): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        let kind: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()))
        if kind == compilerBodyMemoryFactResourceCreate() || kind == compilerBodyMemoryFactMove() || kind == compilerBodyMemoryFactBindingAlias() {
            let sourceNodeID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()))
            let subjectPathID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()))
            let auxID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactAuxColumn()))
            if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactPhaseColumn()) != compilerBodyMemoryPhasePassEscape()
                || compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectKindColumn()) != compilerBodyMemorySubjectOwnedPath()
                || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
                || subjectPathID < 0 || subjectPathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return false }
            let subjectPolicy: Int(compilerIntTableValue(table: arena.ownedPaths, row: subjectPathID, column: compilerBodyOwnedPathPolicyColumn()))
            let subjectTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: subjectPathID, column: compilerBodyOwnedPathTypeColumn()))
            if kind == compilerBodyMemoryFactResourceCreate() {
                if subjectPolicy != compilerBodyOwnedPathPolicyOwned()
                    || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: subjectTypeID)
                    || auxID != subjectTypeID { return false }
            }
            if kind == compilerBodyMemoryFactMove() {
                let movePolicyIsValid: Bool(subjectPolicy == compilerBodyOwnedPathPolicyOwned()
                    || (subjectPolicy == compilerBodyOwnedPathPolicyBorrowed()
                        && compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: subjectPathID) == compilerBodyOwnedSummaryRootBoundary()))
                if !movePolicyIsValid
                    || (auxID >= 0 && auxID >= compilerIntTableRowCount(table: arena.ownedPaths)) { return false }
            }
            if kind == compilerBodyMemoryFactBindingAlias() {
                let canonicalPathID: Int(compilerBodyArenaBindingAliasCanonicalPath(arena: arena, pathID: subjectPathID))
                if subjectPolicy != compilerBodyOwnedPathPolicyAlias()
                    || canonicalPathID < 0 || auxID != canonicalPathID
                    || compilerIntTableValue(table: arena.ownedPaths, row: canonicalPathID, column: compilerBodyOwnedPathTypeColumn()) != subjectTypeID { return false }
            }
        }
        row: row + 1
    }
    return true
}

function compilerBodyOwnedReturnTransfersAreValid(arena: CompilerBodyArena): Bool {
    if !compilerIntTableIsComplete(table: arena.ownedReturnTransfers) { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.ownedReturnTransfers) {
        let returnNodeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferReturnNodeColumn()))
        let returnPathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferReturnPathColumn()))
        let sourcePathID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferSourcePathColumn()))
        let transferKind: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferKindColumn()))
        let sourceTypeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferTypeColumn()))
        if compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferIDColumn()) != row
            || returnNodeID < 0 || returnNodeID >= compilerIntTableRowCount(table: arena.nodes)
            || compilerIntTableValue(table: arena.nodes, row: returnNodeID, column: 1) != compilerSyntaxKindReturn()
            || returnPathID < 0 - 1
            || sourcePathID < 0 || sourcePathID >= compilerIntTableRowCount(table: arena.ownedPaths)
            || compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferStorageKeyColumn()) < 0
            || sourceTypeID != compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathTypeColumn())
            || !compilerBodyArenaTypeIDIsOpaqueStorage(arena: arena, typeID: sourceTypeID) { return false }
        let sourceRootClass: Int(compilerBodyArenaOwnedPathSummaryRootClass(arena: arena, pathID: sourcePathID))
        if transferKind == compilerBodyOwnedReturnTransferMove() {
            if sourceRootClass != compilerBodyOwnedSummaryRootLocalCreate()
                || compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyOwned() { return false }
        } else if transferKind == compilerBodyOwnedReturnTransferAlias() {
            if sourceRootClass != compilerBodyOwnedSummaryRootBoundary() { return false }
        } else if transferKind == compilerBodyOwnedReturnTransferForward() {
            if sourceRootClass != compilerBodyOwnedSummaryRootBoundary()
                || compilerIntTableValue(table: arena.ownedPaths, row: sourcePathID, column: compilerBodyOwnedPathPolicyColumn()) != compilerBodyOwnedPathPolicyBorrowed() { return false }
        } else { return false }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: arena.ownedReturnTransfers, row: priorRow, column: compilerBodyOwnedReturnTransferReturnNodeColumn()) == returnNodeID
                && compilerIntTableValue(table: arena.ownedReturnTransfers, row: priorRow, column: compilerBodyOwnedReturnTransferReturnPathColumn()) == returnPathID { return false }
            priorRow: priorRow + 1
        }
        row: row + 1
    }
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1) == compilerSyntaxKindReturn() {
            let returnValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
            state expectedTransferCount: Int(0)
            if returnValueNodeID < 0 { return false }
            if compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: returnValueNodeID) == compilerBodyTypeConstruct() {
                let returnTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: returnValueNodeID))
                let trackedStatus: Int(compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: returnTypeID))
                if trackedStatus < 0 { return false }
                if trackedStatus == 1 {
                    let sourceRootPathID: Int(compilerBodyArenaOwnedPathForValue(arena: arena, valueNodeID: returnValueNodeID))
                    if sourceRootPathID < 0 { return false }
                    expectedTransferCount: compilerBodyArenaOwnedPathOpaqueLeafCount(arena: arena, rootPathID: sourceRootPathID)
                    if expectedTransferCount <= 0 { return false }
                }
            }
            if compilerBodyOwnedReturnTransferCountForReturnNode(transfers: arena.ownedReturnTransfers, returnNodeID: nodeRow) != expectedTransferCount { return false }
        }
        nodeRow: nodeRow + 1
    }
    return true
}

function compilerBodyOwnedReturnTransferContractsAreValid(arena: CompilerBodyArena, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effectPaths: CompilerIntTable): Bool {
    if !compilerBodyOwnedReturnTransfersAreValid(arena: arena) { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.ownedReturnTransfers) {
        let sourceTypeID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferTypeColumn()))
        let storageKeyID: Int(compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferStorageKeyColumn()))
        if !compilerBodyFunctionInstanceEffectPathIsValid(paths: effectPaths, pathID: compilerIntTableValue(table: arena.ownedReturnTransfers, row: row, column: compilerBodyOwnedReturnTransferReturnPathColumn()))
            || storageKeyID != compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: sourceTypeID) { return false }
        row: row + 1
    }
    return true
}

function compilerBodyMemoryFactsAreValid(arena: CompilerBodyArena): Bool {
    if !compilerBodyArenaBindingAliasesAreValid(arena: arena)
        || !compilerBodyOwnedSemanticFactsAreValid(arena: arena)
        || !compilerBodyOwnedReturnTransfersAreValid(arena: arena) { return false }
    if compilerIntTableRowCount(table: arena.storages) == 0 { return compilerBodyScalarMemoryFactsAreValid(arena: arena) }
    return compilerBodyAggregateMemoryFactsAreValid(arena: arena)
}

function compilerBodyMemoryBuildAndFreeze(arena: CompilerBodyArena, abiPlan: CompilerModuleABIPlan, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, effects: CompilerIntTable, effectPaths: CompilerIntTable, returnSummaries: CompilerIntTable, returnLeaves: CompilerIntTable, applyInstanceEffects: Bool, recordOwnedFacts: Bool): Int {
    let ownedPathBuildStatus: Int(compilerBodyArenaBuildOwnedPathTables(arena: arena))
    if ownedPathBuildStatus != 0 { return 8000 + (0 - ownedPathBuildStatus) }
    if applyInstanceEffects
        && compilerBodyArenaPrepareReturnedAliasTopology(arena: arena, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, returnSummaries: returnSummaries, returnLeaves: returnLeaves, effectPaths: effectPaths) != 0 { return 8050 }
    let bindingAliasTopologyStatus: Int(compilerBodyArenaBindingAliasValidationCode(arena: arena))
    if bindingAliasTopologyStatus != 0 { return 9000 + bindingAliasTopologyStatus }
    if compilerBodyMemoryBuildValuePhase(arena: arena) != 0 { return 1 }
    let placementStatus: Int(compilerBodyMemoryBuildPlacementPhase(arena: arena, abiPlan: abiPlan))
    if placementStatus != 0 { return 2000 + placementStatus }
    if compilerBodyMemoryBuildAccessPhase(arena: arena) != 0 { return 3 }
    let passEscapeStatus: Int(compilerBodyMemoryBuildPassEscapePhase(arena: arena, abiPlan: abiPlan))
    if passEscapeStatus != 0 { return 4000 + passEscapeStatus }
    let ownedPathValidationStatus: Int(compilerBodyArenaValidateOwnedPaths(arena: arena, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, effects: effects, effectPaths: effectPaths, returnSummaries: returnSummaries, returnLeaves: returnLeaves, applyInstanceEffects: applyInstanceEffects, recordFacts: recordOwnedFacts))
    if ownedPathValidationStatus != 0 { return 8100 + (0 - ownedPathValidationStatus) }
    if !compilerBodyOwnedReturnTransferContractsAreValid(arena: arena, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, effectPaths: effectPaths) { return 8200 }
    if compilerBodyMemoryBuildLifetimePhase(arena: arena) != 0 { return 5 }
    let bindingAliasFinalStatus: Int(compilerBodyArenaBindingAliasValidationCode(arena: arena))
    if bindingAliasFinalStatus != 0 { return 9000 + bindingAliasFinalStatus }
    if !compilerBodyMemoryFactsAreValid(arena: arena) { return 6 }
    if rawBufferStoreInt(buffer: arena.memoryState, index: compilerBodyMemoryStateFrozen(), value: 1) != 0 { return 7 }
    return 0
}

function compilerBodyMemoryIsFrozenAndValid(arena: CompilerBodyArena): Bool {
    return rawBufferLoadInt(buffer: arena.memoryState, index: compilerBodyMemoryStateFrozen()) == 1
        && compilerBodyMemoryFactsAreValid(arena: arena)
}

