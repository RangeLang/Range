            if compilerBodyArenaOwnedPathSetState(states: states, pathID: pathID, stateValue: compilerBodyOwnedPathAbsent()) != 0
                || compilerBodyArenaOwnedPathSetOrigin(origins: origins, pathID: pathID, originPathID: compilerBodyOwnedOriginUnknown()) != 0 { return 0 - 1 }
        }
        pathID: pathID + 1
    }
