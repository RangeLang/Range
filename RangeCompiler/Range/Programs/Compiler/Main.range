@main {
    if commandLineArgumentCount() != 1 {
        print(value: String("usage: Compiler <input.range>"))
        return 64
    }

    let path: String(commandLineArgument(index: 0))
    let source: String(readFile(path: path))
    let output: String(compileRangeSource(source: source))
    print(value: output)
    return compilerNativeOutputExitCode(output: output)
}
