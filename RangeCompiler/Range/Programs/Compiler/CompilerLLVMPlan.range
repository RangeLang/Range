    }
    let emissionEdgeOwnersDestroyStatus: Int(rawBufferDestroy(buffer: emissionEdgeOwners))
    let emissionEdgeTargetsDestroyStatus: Int(rawBufferDestroy(buffer: emissionEdgeTargets))
    if emissionEdgeOwnersDestroyStatus != 0 || emissionEdgeTargetsDestroyStatus != 0 { emissionStatus: 33 }
    if emissionStatus != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: emissionStatus) }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("functionEmission.end"))
    return 0
}

function compilerReachableLLVMStateHelpers(reachability: CompilerReachableLLVMState): CompilerTypedLLVMHelpers {
    let telemetry: CompilerBodyTelemetry(
        supportedCount: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMSupported()),
        typedParseAttempts: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMTypedAttempts()),
        typedParseSuccesses: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMTypedSuccesses()),
        legacyParses: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMLegacyParses()),
        arenaCreates: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMArenaCreates()),
        arenaDestroys: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMArenaDestroys()),
        recordBytes: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMRecordBytes()),
        committedFailures: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMCommittedFailures())
    )
    return CompilerTypedLLVMHelpers(
        helpers: CompilerLLVMHelperFunctions(renderedFunctions: rawBufferMaterializeText(buffer: reachability.functionsBuffer), instructionRecords: String(""), nextTemporary: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary())),
        renderedGlobals: rawBufferMaterializeText(buffer: reachability.globalsBuffer),
        runtimeRequirements: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMRuntimeRequirements()),
        telemetry: telemetry
    )
}

function compilerReachableLLVMStateDestroy(reachability: CompilerReachableLLVMState): Int {
    state status: Int(compilerFunctionSelectionDestroy(selection: reachability.selection))
    if rawBufferDestroy(buffer: reachability.worklist) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.worklistInstanceIDs) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.edgeOwners) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.edgeTargets) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.instanceEdgeOwners) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.instanceEdgeTargets) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.typeKeys) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.typeKeyArguments) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstances) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceSignatures) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceSignatureParameters) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceEffects) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceEffectPaths) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceEffectCalls) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceReturnSummaries) != 0 { status: 0 - 1 }
    if compilerIntTableDestroy(table: reachability.functionInstanceReturnLeaves) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.abiCapabilities) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.abiActivation) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.abiReturnModes) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.abiParticipants) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.abiSensitiveFunctions) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.functionsBuffer) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.globalsBuffer) != 0 { status: 0 - 1 }
    if rawBufferDestroy(buffer: reachability.counters) != 0 { status: 0 - 1 }
    return status
}

function compilerCoreLLVMSelectedHelperFunctionTyped(context: CompilerLLVMLoweringContext, declarationRow: Int, functionRow: Int, instanceID: Int, receiverTypeKeyID: Int, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, functionInstances: CompilerIntTable, functionInstanceSignatures: CompilerIntTable, functionInstanceSignatureParameters: CompilerIntTable, functionInstanceEffects: CompilerIntTable, functionInstanceEffectPaths: CompilerIntTable, functionInstanceReturnSummaries: CompilerIntTable, functionInstanceReturnLeaves: CompilerIntTable, expectedSignatureFirst: Int, expectedSignatureSecond: Int, initialTemporaryIndex: Int, edgeOwners: RawBuffer, edgeTargets: RawBuffer, abiPlan: CompilerModuleABIPlan): CompilerTypedLLVMHelpers {
    let lowering: CompilerTypedBodyLowering(compilerCoreLLVMLowerHelperFunctionTypedObserved(context: context, functionRow: functionRow, instanceID: instanceID, receiverTypeKeyID: receiverTypeKeyID, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, functionInstances: functionInstances, functionInstanceSignatures: functionInstanceSignatures, functionInstanceSignatureParameters: functionInstanceSignatureParameters, functionInstanceEffects: functionInstanceEffects, functionInstanceEffectPaths: functionInstanceEffectPaths, functionInstanceReturnSummaries: functionInstanceReturnSummaries, functionInstanceReturnLeaves: functionInstanceReturnLeaves, expectedSignatureFirst: expectedSignatureFirst, expectedSignatureSecond: expectedSignatureSecond, initialTemporaryIndex: initialTemporaryIndex, edgeOwners: edgeOwners, edgeTargets: edgeTargets, abiPlan: abiPlan))
    if !lowering.isValid {
        let fileID: Int(compilerIntTableValue(table: context.tables.declarations, row: declarationRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: context.tables, fileID: fileID, localStart: compilerIntTableValue(table: context.tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: context.tables.declarations, row: declarationRow, column: 8)))
        let placeholder: String("; RANGE_LOWERING_PLACEHOLDER functionID=\(functionRow) function=\(name) reason=typedBodyPipelineFailure stage=\(lowering.failureStage)\n")
        return CompilerTypedLLVMHelpers(helpers: CompilerLLVMHelperFunctions(renderedFunctions: placeholder, instructionRecords: String(""), nextTemporary: initialTemporaryIndex), renderedGlobals: String(""), runtimeRequirements: 0, telemetry: lowering.telemetry)
    }
    let renderedFunction: String(compilerCoreRenderLLVMHelperFunctionTyped(tables: context.tables, index: context.declarationIndex, declarationRow: declarationRow, functionRow: functionRow, functionName: lowering.functionName, returnLLVMType: lowering.returnLLVMType, parameterText: lowering.parameterText, block: lowering.block, abiPlan: abiPlan))
    state renderedGlobals: String("")
    if lowering.telemetry.supportedCount == 0 {
        renderedGlobals: compilerCoreRenderLLVMGlobalRecords(records: lowering.block.instructionRecords)
    } else {
        renderedGlobals: lowering.renderedGlobals
    }
    return CompilerTypedLLVMHelpers(helpers: CompilerLLVMHelperFunctions(renderedFunctions: renderedFunction, instructionRecords: String(""), nextTemporary: lowering.block.nextTemporary), renderedGlobals: renderedGlobals, runtimeRequirements: lowering.runtimeRequirements, telemetry: lowering.telemetry)
}

