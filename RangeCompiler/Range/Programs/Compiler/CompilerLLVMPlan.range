function compilerCoreLLVM(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreLLVMForProgram(program: program)
}

function compilerCoreLLVMSelectedHelperAuditTyped(tables: CompilerSyntaxTables, selection: CompilerFunctionSelection): CompilerLLVMHelperAudit {
    state audit: CompilerLLVMHelperAudit(selectedCount: 0, lowerableCount: 0, excludedCount: 0, maxBodyLength: 0, maxBodyName: String(""), details: String(""))
    state declarationRow: Int(0)
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while declarationRow < declarationCount {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
            if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
                audit: compilerCoreLLVMSelectedHelperAuditAppendingTypedFunction(tables: tables, audit: audit, declarationRow: declarationRow, functionRow: functionRow)
            }
        }
        declarationRow: declarationRow + 1
    }
    return audit
}

function compilerCoreLLVMSelectedHelperAuditAppendingTypedFunction(tables: CompilerSyntaxTables, audit: CompilerLLVMHelperAudit, declarationRow: Int, functionRow: Int): CompilerLLVMHelperAudit {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let bodyStart: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 8))
    let bodyEnd: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 9))
    let bodyLength: Int(bodyEnd - bodyStart)
    let reason: String(compilerCoreTypedFunctionExclusionReason(tables: tables, functionRow: functionRow))
    state maxLength: Int(0)
    maxLength: audit.maxBodyLength
    state maxName: String("")
    maxName: audit.maxBodyName
    if bodyLength > maxLength {
        maxLength: bodyLength
        maxName: name
    }
    if reason == String("") {
        return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount + 1, excludedCount: audit.excludedCount, maxBodyLength: maxLength, maxBodyName: maxName, details: audit.details)
    }
    let detail: String("excluded\tname=\(name)\treason=\(reason)\tbodyLength=\(bodyLength)\n")
    return CompilerLLVMHelperAudit(selectedCount: audit.selectedCount + 1, lowerableCount: audit.lowerableCount, excludedCount: audit.excludedCount + 1, maxBodyLength: maxLength, maxBodyName: maxName, details: "\(audit.details)\(detail)")
}

function compilerCoreTypedFunctionExclusionReason(tables: CompilerSyntaxTables, functionRow: Int): String {
    let fileID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 1))
    let bodyStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: functionRow, column: 8)))
    let bodyEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: functionRow, column: 9)))
    if bodyStart < 0 || bodyEnd < bodyStart || bodyEnd >= stringLength(value: tables.sourceStore.source) {
        return String("missingStatementRecords")
    }
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    if compilerCoreLLVMTypeNameForRangeType(typeName: returnType) == String("") {
        return String("unsupportedSignature")
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if compilerCoreLLVMTypeNameForRangeType(typeName: typeName) == String("") {
            return String("unsupportedSignature")
        }
        ordinal: ordinal + 1
    }
    return String("")
}

function compilerCoreLLVMHelperAuditFailure(audit: CompilerLLVMHelperAudit): String {
    return "compilerError\tkind=unsupportedReachableHelpers\tselectedCount=\(audit.selectedCount)\tlowerableCount=\(audit.lowerableCount)\texcludedCount=\(audit.excludedCount)\n\(audit.details)"
}

function compilerCoreLLVMPlaceholderCount(text: String): Int {
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    state sourceIndex: Int(0)
    state count: Int(0)

    while sourceIndex >= 0 {
        let matchIndex: Int(stringFindFrom(source: text, start: sourceIndex, needle: marker))
        if matchIndex < 0 {
            return count
        }
        count: count + 1
        sourceIndex: matchIndex + markerLength
    }

    return count
}

function compilerCoreLLVMPlaceholderDetails(text: String): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 4096, stride: 1))
    let materializedText: String(compilerCoreMaterializeLLVMText(text: text))
    let marker: String("RANGE_LOWERING_PLACEHOLDER")
    let markerLength: Int(stringLength(value: marker))
    let textLength: Int(stringLength(value: materializedText))
    state sourceIndex: Int(0)
    state currentFunction: String("")

    while sourceIndex < textLength {
        state lineEnd: Int(stringFindFirstOf(source: materializedText, start: sourceIndex, characters: compilerCoreNewlineCharacter()))
        if lineEnd < 0 {
            lineEnd: textLength
        }
        let line: String(materializedText.substring(start: sourceIndex, end: lineEnd))
        if stringHasPrefix(source: line, start: 0, prefix: String("define ")) {
            let nameStart: Int(stringFindFrom(source: line, start: 0, needle: String("@")))
            let nameEnd: Int(stringFindFrom(source: line, start: nameStart + 1, needle: String("(")))
            if nameStart >= 0 && nameEnd > nameStart {
                currentFunction: line.substring(start: nameStart + 1, end: nameEnd)
            }
        }
        let markerStart: Int(stringFindFrom(source: line, start: 0, needle: marker))
        if markerStart >= 0 {
            state reasonStart: Int(markerStart + markerLength)
            while reasonStart < stringLength(value: line) && stringHasPrefix(source: line, start: reasonStart, prefix: String(" ")) {
                reasonStart: reasonStart + 1
            }
            let reason: String(line.substring(start: reasonStart, end: stringLength(value: line)))
            rawBufferAppendText(buffer: outputBuffer, text: "placeholder\tfunction=\(currentFunction)\treason=\(reason)")
            rawBufferAppendText(buffer: outputBuffer, text: compilerCoreNewlineCharacter())
        }
        sourceIndex: lineEnd + 1
    }

    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMPlaceholderFailure(placeholderCount: Int, renderedText: String): String {
    let details: String(compilerCoreLLVMPlaceholderDetails(text: renderedText))
    return "compilerError\tkind=unsupportedReachableLowering\tplaceholderCount=\(placeholderCount)\(compilerCoreNewlineCharacter())\(details)"
}

function compilerCoreRenderLLVMEntryFunction(block: CompilerLLVMLoweredBlock): String {
    let llvmFunction: CompilerLLVMFunction(name: String("main"), returnType: String("i32"), parameterText: String(""), renderedBlocks: block.renderedBlocks, block: compilerCoreMainLLVMBasicBlock(block: block))
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreLLVMNativeProgramText(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        let diagnostic: String(compilerInvalidTypedDeclarationsDiagnostic(tables: tables))
        compilerSyntaxTablesDestroy(tables: tables)
        return diagnostic
    }
    let macroLinkStatus: Int(compilerMacroLink(tables: tables))
    if macroLinkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
        let macroDiagnosticOutput: String(compilerMacroRenderDiagnostics(tables: tables))
        compilerSyntaxTablesDestroy(tables: tables)
        return macroDiagnosticOutput
    }
    let executionIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    if !executionIndex.isValid {
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return String("compilerError\tkind=invalidDeclarationIndex")
    }
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: executionIndex))
    if execution.status != 0 {
        let executionOutput: String(compilerMacroRenderExecutionError(tables: tables, result: execution))
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return executionOutput
    }
    if compilerGraphDeltaCommitGeneratedDeclarations(tables: tables, delta: execution.graphDelta) != 0 {
        compilerMacroRecordGeneratedFunctionCommitDiagnostic(tables: tables, delta: execution.graphDelta)
        let commitOutput: String(compilerMacroRenderDiagnostics(tables: tables))
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
        compilerSyntaxTablesDestroy(tables: tables)
        return commitOutput
    }
    compilerDeclarationIndexDestroy(index: executionIndex)
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreateWithGraphDelta(tables: tables, delta: execution.graphDelta))
    if !declarationIndex.isValid {
        compilerDeclarationIndexDestroy(index: declarationIndex)
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerSyntaxTablesDestroy(tables: tables)
        return String("compilerError\tkind=invalidExpansionOverlay")
    }
    let program: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
    let context: CompilerLLVMLoweringContext(program: program, tables: $tables, declarationIndex: $declarationIndex)
    let reachability: CompilerReachableLLVMState(compilerReachableLLVMStateCreate(context: context))
    let output: String(compilerCoreLLVMNativeEntryTextForReachability(reachability: reachability))
    compilerReachableLLVMStateDestroy(reachability: reachability)
    compilerDeclarationIndexDestroy(index: declarationIndex)
    compilerGraphDeltaDestroy(delta: execution.graphDelta)
    compilerSyntaxTablesDestroy(tables: tables)
    return output
}

function compilerCoreLLVMNativeEntryTextForReachability(reachability: CompilerReachableLLVMState): String {
    state output: String("compilerError\tkind=invalidEntryReachability")
    let seedStatus: Int(compilerReachableLLVMStateSeedEntryRoots(reachability: reachability))
    state buildStatus: Int(0 - 1)
    if seedStatus != 0 {
        compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 50000 + seedStatus)
        output: "compilerError\tkind=invalidEntryReachability\tstage=\(seedStatus)"
    } else {
        buildStatus: compilerReachableLLVMStateBuildSelected(reachability: reachability)
    }
    if seedStatus == 0 && buildStatus != 0 {
        output: compilerReachableLLVMStateRender(reachability: reachability)
    }
    if seedStatus == 0 && buildStatus == 0 {
        state blockedSensitiveFunctionRow: Int(0)
        while buildStatus == 0 && blockedSensitiveFunctionRow < rawBufferCount(buffer: reachability.abiSensitiveFunctions) {
            if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: blockedSensitiveFunctionRow)
                && rawBufferLoadInt(buffer: reachability.abiSensitiveFunctions, index: blockedSensitiveFunctionRow) == 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockedSensitiveFunctionRow) != 1 {
                buildStatus: compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 200000 + blockedSensitiveFunctionRow)
                output: compilerReachableLLVMStateRender(reachability: reachability)
            }
            blockedSensitiveFunctionRow: blockedSensitiveFunctionRow + 1
        }
    }
    if seedStatus == 0 && buildStatus == 0 {
        let abiPlan: CompilerModuleABIPlan(compilerReachableLLVMStateABIPlan(reachability: reachability))
        let entryLowering: CompilerTypedBodyLowering(compilerCoreLLVMLowerEntryTyped(context: reachability.context, reachability: reachability, initialTemporaryIndex: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary()), abiPlan: abiPlan))
        if !entryLowering.isValid {
            output: "compilerError\tkind=invalidEntryLowering\tstage=\(entryLowering.failureStage)"
        } else if !compilerBodyTelemetryIsTypedOnly(telemetry: entryLowering.telemetry) {
            output: compilerBodyTelemetryTypedOnlyFailure(telemetry: entryLowering.telemetry, scope: String("entry"))
        } else {
            let mainText: String(compilerCoreRenderLLVMEntryFunction(block: entryLowering.block))
            output: compilerReachableLLVMStateRenderModule(reachability: reachability, usage: String(""), extraGlobals: entryLowering.renderedGlobals, extraRuntimeRequirements: entryLowering.runtimeRequirements, mainText: mainText)
        }
    }
    return output
}

function compilerCoreLLVMNativeEntryTextForProgram(program: CompilerProgram, declarationTables: CompilerSyntaxTables, expansionDelta: CompilerGraphDelta): String {
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreateWithGraphDelta(tables: declarationTables, delta: expansionDelta))
    if !declarationIndex.isValid {
        compilerDeclarationIndexDestroy(index: declarationIndex)
        return String("compilerError\tkind=invalidDeclarationIndex")
    }
    let context: CompilerLLVMLoweringContext(program: program, tables: $declarationTables, declarationIndex: $declarationIndex)
    let reachability: CompilerReachableLLVMState(compilerReachableLLVMStateCreate(context: context))
    let output: String(compilerCoreLLVMNativeEntryTextForReachability(reachability: reachability))
    compilerReachableLLVMStateDestroy(reachability: reachability)
    compilerDeclarationIndexDestroy(index: declarationIndex)
    return output
}

function compilerReachableLLVMStateRender(reachability: CompilerReachableLLVMState): String {
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMValid()) != 1 {
        let failedFunctions: String(rawBufferMaterializeText(buffer: reachability.functionsBuffer))
        let failedPlaceholderCount: Int(compilerCoreLLVMPlaceholderCount(text: failedFunctions))
        if failedPlaceholderCount > 0 { return compilerCoreLLVMPlaceholderFailure(placeholderCount: failedPlaceholderCount, renderedText: failedFunctions) }
        let failureStage: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFailureStage()))
        let returnFailureKind: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureKind()))
        if failureStage == 4 && returnFailureKind != 0 {
            let returnFailureFunctionRow: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureFunction()))
            let returnFailureDetail: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureDetail()))
            let returnFailureName: String(compilerReachableLLVMReturnFailureName(kind: returnFailureKind))
            if returnFailureFunctionRow >= 0 && returnFailureFunctionRow < compilerIntTableRowCount(table: reachability.context.tables.functions) {
                let returnFailureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: returnFailureFunctionRow, column: 0))
                let returnFailureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: returnFailureSyntaxID))
                if returnFailureDeclarationRow >= 0 {
                    let returnFailureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: returnFailureDeclarationRow, column: 1))
                    let returnFailureFunctionName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: returnFailureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: returnFailureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: returnFailureDeclarationRow, column: 8)))
                    return "compilerError\tkind=invalidOwnedReturnSummary\tfunctionRow=\(returnFailureFunctionRow)\tfunction=\(returnFailureFunctionName)\tfailureKind=\(returnFailureName)\tdetail=\(returnFailureDetail)"
                }
            }
            return "compilerError\tkind=invalidOwnedReturnSummary\tfunctionRow=\(returnFailureFunctionRow)\tfailureKind=\(returnFailureName)\tdetail=\(returnFailureDetail)"
        }
        if failureStage == 6 || (failureStage >= 6000 && failureStage < 7000) {
            let failureFunctionRow: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureFunction()))
            let failureInstanceID: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureInstance()))
            let failureDetail: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMFunctionFailureDetail()))
            if failureFunctionRow >= 0 && failureFunctionRow < compilerIntTableRowCount(table: reachability.context.tables.functions) {
                let failureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: failureFunctionRow, column: 0))
                let failureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: failureSyntaxID))
                if failureDeclarationRow >= 0 {
                    let failureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 1))
                    let failureFunctionName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: failureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 8)))
                    state ownedPathStage: Int(0 - 1)
                    if failureStage >= 6000 { ownedPathStage: failureStage - 6000 }
                    return "compilerError\tkind=invalidFunctionReachability\tstage=6\tfunctionRow=\(failureFunctionRow)\tfunction=\(failureFunctionName)\tinstanceID=\(failureInstanceID)\tdetail=\(failureDetail)\townedPathStage=\(ownedPathStage)"
                }
            }
        }
        if failureStage >= 300000 && failureStage < 400000 {
            return "compilerError\tkind=invalidEntryOwnedPaths\tdetail=\(failureStage - 300000)"
        }
        if failureStage >= 200000 {
            let blockedFunctionRow: Int(failureStage - 200000)
            let blockedSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockedFunctionRow, column: 0))
            let blockedDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: blockedSyntaxID))
            let blockedFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 1))
            let blockedName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: blockedFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: blockedDeclarationRow, column: 8)))
            return "compilerError\tkind=representationSensitiveABICapabilityBlocked\tfunctionRow=\(blockedFunctionRow)\tfunction=\(blockedName)\tcapabilityStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockedFunctionRow))"
        }
        if failureStage >= 100000 {
            let failureFunctionRow: Int(failureStage - 100000)
            let failureSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: failureFunctionRow, column: 0))
            let failureDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: failureSyntaxID))
            let failureFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 1))
            let failureName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: failureFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: failureDeclarationRow, column: 8)))
            return "compilerError\tkind=invalidFunctionDiscovery\tfunctionRow=\(failureFunctionRow)\tfunction=\(failureName)\tfailureCode=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: failureFunctionRow))"
        }
        return "compilerError\tkind=invalidFunctionReachability\tstage=\(failureStage)"
    }
    if !compilerReachableLLVMStateABIPlanIsValid(reachability: reachability) {
        state invalidPlanEdge: Int(0)
        while invalidPlanEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let invalidPlanOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: invalidPlanEdge))
            let invalidPlanTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: invalidPlanEdge))
            let invalidPlanOwnerParticipant: Int(rawBufferLoadInt(buffer: reachability.abiParticipants, index: invalidPlanOwner))
            let invalidPlanTargetParticipant: Int(rawBufferLoadInt(buffer: reachability.abiParticipants, index: invalidPlanTarget))
            let invalidPlanTargetReturnMode: Int(rawBufferLoadInt(buffer: reachability.abiReturnModes, index: invalidPlanTarget))
            let invalidPlanAggregateParameter: Bool(compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: invalidPlanTarget))
            if (invalidPlanTargetReturnMode == compilerFunctionReturnABIIndirect() && invalidPlanOwnerParticipant != 1)
                || (invalidPlanOwnerParticipant == 1 && invalidPlanAggregateParameter && invalidPlanTargetParticipant != 1)
                || (invalidPlanTargetParticipant == 1 && invalidPlanAggregateParameter && invalidPlanOwnerParticipant != 1) {
                return "compilerError\tkind=invalidModuleABIPlanEdge\townerFunctionRow=\(invalidPlanOwner)\ttargetFunctionRow=\(invalidPlanTarget)\townerParticipant=\(invalidPlanOwnerParticipant)\ttargetParticipant=\(invalidPlanTargetParticipant)\ttargetReturnMode=\(invalidPlanTargetReturnMode)\ttargetAggregateParameter=\(invalidPlanAggregateParameter)"
            }
            invalidPlanEdge: invalidPlanEdge + 1
        }
        return String("compilerError\tkind=invalidModuleABIPlan")
    }
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMIndirectCapabilities()) < 1 { return String("compilerError\tkind=emptyIndirectABICapability") }
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMIndirectActivations()) < 1 {
        state blockerEdge: Int(0)
        while blockerEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let blockerOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: blockerEdge))
            let blockerTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: blockerEdge))
            if rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockerTarget) == 1
                && compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: blockerTarget) == compilerFunctionReturnABIIndirect()
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockerOwner) != 1 {
                let targetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockerTarget, column: 0))
                let ownerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: blockerOwner, column: 0))
                let targetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: targetSyntaxID))
                let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: ownerSyntaxID))
                let targetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: targetDeclarationRow, column: 8)))
                let ownerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: ownerDeclarationRow, column: 8)))
                return "compilerError\tkind=indirectABIActivationBlocked\ttargetFunctionRow=\(blockerTarget)\ttarget=\(targetName)\townerFunctionRow=\(blockerOwner)\towner=\(ownerName)\townerStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: blockerOwner))"
            }
            blockerEdge: blockerEdge + 1
        }
        state incapableEdge: Int(0)
        while incapableEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let incapableOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: incapableEdge))
            let incapableTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: incapableEdge))
            if compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: incapableTarget) == compilerFunctionReturnABIIndirect()
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: incapableTarget) != 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: incapableOwner) == 1 {
                let incapableTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: incapableTarget, column: 0))
                let incapableOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: incapableOwner, column: 0))
                let incapableTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: incapableTargetSyntaxID))
                let incapableOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: incapableOwnerSyntaxID))
                let incapableTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableTargetDeclarationRow, column: 8)))
                let incapableOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: incapableOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=indirectABIComponentBlocked\ttargetFunctionRow=\(incapableTarget)\ttarget=\(incapableTargetName)\ttargetStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: incapableTarget))\townerFunctionRow=\(incapableOwner)\towner=\(incapableOwnerName)"
            }
            incapableEdge: incapableEdge + 1
        }
        state parameterBlockerEdge: Int(0)
        while parameterBlockerEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let parameterBlockerOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: parameterBlockerEdge))
            let parameterBlockerTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: parameterBlockerEdge))
            if compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterBlockerTarget)
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterBlockerTarget) != 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterBlockerOwner) == 1 {
                let parameterBlockerTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: parameterBlockerTarget, column: 0))
                let parameterBlockerOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: parameterBlockerOwner, column: 0))
                let parameterBlockerTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: parameterBlockerTargetSyntaxID))
                let parameterBlockerOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: parameterBlockerOwnerSyntaxID))
                let parameterBlockerTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerTargetDeclarationRow, column: 8)))
                let parameterBlockerOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: parameterBlockerOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=aggregateParameterABIComponentBlocked\ttargetFunctionRow=\(parameterBlockerTarget)\ttarget=\(parameterBlockerTargetName)\ttargetStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterBlockerTarget))\townerFunctionRow=\(parameterBlockerOwner)\towner=\(parameterBlockerOwnerName)"
            }
            parameterBlockerEdge: parameterBlockerEdge + 1
        }
        state aggregateCallerBlockerEdge: Int(0)
        while aggregateCallerBlockerEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let aggregateCallerBlockerOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: aggregateCallerBlockerEdge))
            let aggregateCallerBlockerTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: aggregateCallerBlockerEdge))
            if compilerFunctionHasAggregateParameterABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: aggregateCallerBlockerTarget)
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerTarget) == 1
                && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerOwner) != 1 {
                let aggregateCallerBlockerTargetSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: aggregateCallerBlockerTarget, column: 0))
                let aggregateCallerBlockerOwnerSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: aggregateCallerBlockerOwner, column: 0))
                let aggregateCallerBlockerTargetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: aggregateCallerBlockerTargetSyntaxID))
                let aggregateCallerBlockerOwnerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: aggregateCallerBlockerOwnerSyntaxID))
                let aggregateCallerBlockerTargetName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerTargetDeclarationRow, column: 8)))
                let aggregateCallerBlockerOwnerName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 1), localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: aggregateCallerBlockerOwnerDeclarationRow, column: 8)))
                return "compilerError\tkind=aggregateParameterABICallerBlocked\ttargetFunctionRow=\(aggregateCallerBlockerTarget)\ttarget=\(aggregateCallerBlockerTargetName)\townerFunctionRow=\(aggregateCallerBlockerOwner)\towner=\(aggregateCallerBlockerOwnerName)\townerStage=\(0 - rawBufferLoadInt(buffer: reachability.abiCapabilities, index: aggregateCallerBlockerOwner))"
            }
            aggregateCallerBlockerEdge: aggregateCallerBlockerEdge + 1
        }
        return String("compilerError\tkind=emptyIndirectABIActivation")
    }
    return String("compilerError\tkind=missingTypedEntryLowering")
}

function compilerReachableLLVMStateRenderModule(reachability: CompilerReachableLLVMState, usage: String, extraGlobals: String, extraRuntimeRequirements: Int, mainText: String): String {
    let audit: CompilerLLVMHelperAudit(compilerCoreLLVMSelectedHelperAuditTyped(tables: reachability.context.tables, selection: reachability.selection))
    if audit.excludedCount > 0 { return compilerCoreLLVMHelperAuditFailure(audit: audit) }
    let typedSelected: CompilerTypedLLVMHelpers(compilerReachableLLVMStateHelpers(reachability: reachability))
    if !compilerBodyTelemetryIsTypedOnly(telemetry: typedSelected.telemetry) {
        return compilerBodyTelemetryTypedOnlyFailure(telemetry: typedSelected.telemetry, scope: String("reachableFunctions"))
    }
    let selected: CompilerLLVMHelperFunctions(compilerTypedLLVMHelpersValue(value: typedSelected))
    let placeholderCount: Int(compilerCoreLLVMPlaceholderCount(text: selected.renderedFunctions))
    if placeholderCount > 0 { return compilerCoreLLVMPlaceholderFailure(placeholderCount: placeholderCount, renderedText: selected.renderedFunctions) }
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMCommittedFailures()) != 0 { return String("compilerError\tkind=invalidFunctionReachability") }
    state runtimeRequirements: Int(0)
    runtimeRequirements: typedSelected.runtimeRequirements
    if extraRuntimeRequirements > runtimeRequirements { runtimeRequirements: extraRuntimeRequirements }
    let allRenderedFunctions: String("\(selected.renderedFunctions)\(mainText)")
    let nominalLayouts: String(compilerCoreRenderLLVMNominalLayouts(tables: reachability.context.tables, index: reachability.context.declarationIndex, includeBuiltinArray: compilerCoreShouldRenderBuiltinArrayLayout(tables: reachability.context.tables, index: reachability.context.declarationIndex, renderedFunctions: allRenderedFunctions)))
    let runtimeDeclarations: String(compilerCoreRenderLLVMRuntimeDeclarationsTyped(records: selected.instructionRecords, renderedFunctions: allRenderedFunctions, runtimeRequirements: runtimeRequirements))
    let declarations: String(compilerCoreRenderLLVMFunctionDeclarationsExcludingTyped(tables: reachability.context.tables, index: reachability.context.declarationIndex, selection: reachability.selection))
    let text: String(compilerCoreLLVMNativeEntryTextFromParts(usage: usage, globals: "\(nominalLayouts)\(typedSelected.renderedGlobals)\(extraGlobals)", runtime: runtimeDeclarations, helpers: selected.renderedFunctions, declarations: declarations, main: mainText))
    let materialized: String(compilerCoreMaterializeLLVMText(text: text))
    let signatureAuditCode: Int(compilerCoreLLVMDirectCallSignatureAudit(tables: reachability.context.tables, index: reachability.context.declarationIndex, selection: reachability.selection, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, functionInstanceSignatureParameters: reachability.functionInstanceSignatureParameters, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability), text: materialized))
    if signatureAuditCode != 0 {
        let signatureAuditInstanceID: Int(signatureAuditCode - 1)
        let signatureAuditFunctionRow: Int(compilerIntTableValue(table: reachability.functionInstances, row: signatureAuditInstanceID, column: compilerReachableFunctionInstanceFunctionColumn()))
        let signatureAuditSyntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: signatureAuditFunctionRow, column: 0))
        let signatureAuditDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: signatureAuditSyntaxID))
        let signatureAuditFileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: signatureAuditDeclarationRow, column: 1))
        let signatureAuditFunctionName: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: signatureAuditFileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: signatureAuditDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: signatureAuditDeclarationRow, column: 8)))
        return "compilerError\tkind=directCallSignatureAudit\tinstanceID=\(signatureAuditInstanceID)\tfunctionRow=\(signatureAuditFunctionRow)\tfunction=\(signatureAuditFunctionName)"
    }
    return materialized
}

function compilerCoreLLVMDirectCallSignatureAudit(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, functionInstances: CompilerIntTable, functionInstanceSignatures: CompilerIntTable, functionInstanceSignatureParameters: CompilerIntTable, abiPlan: CompilerModuleABIPlan, text: String): Int {
    state instanceID: Int(0)
    while instanceID < compilerIntTableRowCount(table: functionInstances) {
        let functionRow: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn()))
        if !compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) { return instanceID + 1 }
        let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
        let signatureRow: Int(compilerReachableFunctionInstanceSignatureRow(signatures: functionInstanceSignatures, instanceID: instanceID))
        if declarationRow < 0 || signatureRow < 0 { return instanceID + 1 }
        let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
        let baseName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
        let receiverKeyID: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceReceiverKeyColumn()))
        state name: String(baseName)
        if receiverKeyID >= 0 {
            name: "\(baseName)__ri\(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFingerprintFirstColumn()))_\(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFingerprintSecondColumn()))"
        }
        let parameterCount: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterCountColumn()))
        let parameterStart: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterFirstRowColumn()))
        if parameterCount < 0 || parameterStart < 0 || parameterStart + parameterCount > compilerIntTableRowCount(table: functionInstanceSignatureParameters) { return instanceID + 1 }
        state parameterOrdinal: Int(0)
        while parameterOrdinal < parameterCount {
            let parameterRow: Int(parameterStart + parameterOrdinal)
            if compilerIntTableValue(table: functionInstanceSignatureParameters, row: parameterRow, column: compilerReachableFunctionInstanceSignatureParameterInstanceColumn()) != instanceID
                || compilerIntTableValue(table: functionInstanceSignatureParameters, row: parameterRow, column: compilerReachableFunctionInstanceSignatureParameterOrdinalColumn()) != parameterOrdinal
                || compilerIntTableValue(table: functionInstanceSignatureParameters, row: parameterRow, column: compilerReachableFunctionInstanceSignatureParameterABICategoryColumn()) == compilerBodyFunctionSignatureABICategoryNone() && receiverKeyID >= 0 { return instanceID + 1 }
            parameterOrdinal: parameterOrdinal + 1
        }
        let returnCategory: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnABICategoryColumn()))
        if receiverKeyID >= 0 && returnCategory == compilerBodyFunctionSignatureABICategoryNone() { return instanceID + 1 }
        let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
        state llvmReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: returnType))
        if returnCategory == compilerBodyFunctionSignatureABICategoryInt() { llvmReturnType: String("i32") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryBool() { llvmReturnType: String("i1") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryFloat() { llvmReturnType: String("double") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryPointer() { llvmReturnType: String("ptr") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryUnsigned8() { llvmReturnType: String("i8") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryFloat32() { llvmReturnType: String("float") }
        if returnCategory == compilerBodyFunctionSignatureABICategoryNone() && compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
            llvmReturnType: compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: returnType)
        }
        let returnMode: Int(compilerModuleABIPlanReturnMode(plan: abiPlan, tables: tables, index: index, functionRow: functionRow))
        if returnCategory == compilerBodyFunctionSignatureABICategoryNone() && returnMode == compilerFunctionReturnABIIndirect() { llvmReturnType: String("void") }
        let symbolNeedle: String("@\(name)(")
        let definitionPrefix: String("define \(llvmReturnType) ")
        let callPrefix: String("call \(llvmReturnType) ")
        let symbolNeedleLength: Int(stringLength(value: symbolNeedle))
        let definitionPrefixLength: Int(stringLength(value: definitionPrefix))
        let callPrefixLength: Int(stringLength(value: callPrefix))
        state definitionCount: Int(0)
        state occurrence: Int(stringFindFrom(source: text, start: 0, needle: symbolNeedle))
        while occurrence >= 0 {
            state recognized: Bool(false)
            if occurrence >= definitionPrefixLength && text.substring(start: occurrence - definitionPrefixLength, end: occurrence) == definitionPrefix {
                definitionCount: definitionCount + 1
                recognized: true
            }
            if !recognized && occurrence >= callPrefixLength && text.substring(start: occurrence - callPrefixLength, end: occurrence) == callPrefix {
                recognized: true
                if returnCategory == compilerBodyFunctionSignatureABICategoryNone() && returnMode == compilerFunctionReturnABIIndirect() {
                    let firstArgumentStart: Int(occurrence + symbolNeedleLength)
                    if !stringHasPrefix(source: text, start: firstArgumentStart, prefix: String("ptr ")) { return instanceID + 1 }
                }
            }
            if !recognized { return instanceID + 1 }
            occurrence: stringFindFrom(source: text, start: occurrence + symbolNeedleLength, needle: symbolNeedle)
        }
        if definitionCount != 1 { return instanceID + 1 }
        instanceID: instanceID + 1
    }
    return 0
}

function compilerCoreLLVMNativeEntryTextFromParts(usage: String, globals: String, runtime: String, helpers: String, declarations: String, main: String): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 1048576, stride: 1))
    rawBufferAppendText(buffer: outputBuffer, text: usage)
    rawBufferAppendText(buffer: outputBuffer, text: globals)
    rawBufferAppendText(buffer: outputBuffer, text: runtime)
    rawBufferAppendText(buffer: outputBuffer, text: helpers)
    rawBufferAppendText(buffer: outputBuffer, text: declarations)
    rawBufferAppendText(buffer: outputBuffer, text: main)
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreMainLLVM(block: CompilerLLVMLoweredBlock): String {
    let fallbackProgram: CompilerProgram(source: String(""), hasMainBlock: false, mainAttributeStart: 0, mainBlock: block.block, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: block.declarationRecords, declarationSummary: String(""))
    let module: CompilerLLVMModule(compilerCoreLLVMModule(program: fallbackProgram, block: block))
    return compilerCoreRenderLLVMModule(module: module)
}

function compilerCoreRenderLLVMFunctionDeclarations(program: CompilerProgram): String {
    return compilerCoreRenderLLVMFunctionDeclarationsExcluding(program: program, names: String(""))
}

function compilerCoreRenderLLVMFunctionDeclarationsExcludingTyped(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 65536, stride: 1))
    let declarationCount: Int(compilerCoreAppendLLVMFunctionDeclarationsTyped(tables: tables, index: index, selection: selection, outputBuffer: outputBuffer))
    if declarationCount > 0 {
        rawBufferAppendText(buffer: outputBuffer, text: String("\n"))
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreAppendLLVMFunctionDeclarationsTyped(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, outputBuffer: RawBuffer): Int {
    state declarationRow: Int(0)
    state declarationCount: Int(0)
    let rowCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while declarationRow < rowCount {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
            if !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: syntaxID) {
                declarationCount: declarationCount + compilerCoreAppendLLVMFunctionDeclarationTyped(tables: tables, declarationRow: declarationRow, functionRow: functionRow, selection: selection, outputBuffer: outputBuffer)
            }
        }
        declarationRow: declarationRow + 1
    }
    return declarationCount
}

function compilerCoreAppendLLVMFunctionDeclarationTyped(tables: CompilerSyntaxTables, declarationRow: Int, functionRow: Int, selection: CompilerFunctionSelection, outputBuffer: RawBuffer): Int {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 13) != compilerBuiltinPolicyNone()
        && compilerBodyRuntimeBuiltinID(name: name) != compilerBodyRuntimeBuiltinNone() { return 0 }
    if compilerFunctionSelectionContains(selection: selection, functionRow: functionRow) {
        return 0
    }
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    let parameters: String(compilerCoreLLVMFunctionParameterTextTyped(tables: tables, functionRow: functionRow))
    rawBufferAppendText(buffer: outputBuffer, text: "declare \(compilerCoreLLVMTypeNameForRangeType(typeName: returnType)) @\(name)(\(parameters))\n")
    return 1
}

function compilerCoreLLVMFunctionParameterTextTyped(tables: CompilerSyntaxTables, functionRow: Int): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    state hasParameter: Bool(false)
    if ownerName != String("") {
        rawBufferAppendText(buffer: outputBuffer, text: "ptr %self")
        hasParameter: true
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if hasParameter { rawBufferAppendText(buffer: outputBuffer, text: String(", ")) }
        rawBufferAppendText(buffer: outputBuffer, text: "\(compilerCoreLLVMTypeNameForRangeType(typeName: typeName)) %\(name)")
        hasParameter: true
        ordinal: ordinal + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMNativeABITypeName(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, typeName: String): String {
    let optionalTypeName: String(compilerSpecializedOptionalLLVMTypeName(tables: tables, index: index, typeName: typeName))
    if optionalTypeName != String("") { return optionalTypeName }
    let nominalName: String(compilerBodyArenaTypeOuterName(typeName: typeName))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindConstruct()))
    let nominalTypeName: String(compilerNominalLLVMTypeName(tables: tables, declarationRow: declarationRow))
    if nominalTypeName != String("") { return nominalTypeName }
    let enumDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindEnum()))
    if enumDeclarationRow >= 0 {
        let enumSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: enumDeclarationRow, column: 0))
        if !compilerSyntaxEnumHasPayloads(tables: tables, enumSyntaxID: enumSyntaxID) { return String("i32") }
    }
    let enumTypeName: String(compilerEnumLLVMTypeName(tables: tables, declarationRow: enumDeclarationRow))
    if enumTypeName != String("") { return enumTypeName }
    return compilerCoreLLVMTypeNameForRangeType(typeName: typeName)
}

function compilerCoreLLVMFunctionParameterTextPlanned(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int, abiPlan: CompilerModuleABIPlan): String {
    if !compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
        return compilerCoreLLVMFunctionParameterTextTyped(tables: tables, functionRow: functionRow)
    }
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    state hasParameter: Bool(false)
    if ownerName != String("") {
        rawBufferAppendText(buffer: outputBuffer, text: "ptr %self")
        hasParameter: true
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if hasParameter { rawBufferAppendText(buffer: outputBuffer, text: String(", ")) }
        rawBufferAppendText(buffer: outputBuffer, text: "\(compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: typeName)) %\(name)")
        hasParameter: true
        ordinal: ordinal + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreLLVMFunctionParameterLocalValuesTyped(tables: CompilerSyntaxTables, functionRow: Int): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 512, stride: 1))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    if ownerName != String("") {
        rawBufferAppendText(buffer: outputBuffer, text: compilerCoreLLVMLocalRecordWithRangeType(name: String("self"), operand: String("%self"), typeName: String("ptr"), rangeTypeName: ownerName))
    }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 7)))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        rawBufferAppendText(buffer: outputBuffer, text: compilerCoreLLVMLocalRecordWithRangeType(name: name, operand: "%\(name)", typeName: compilerCoreLLVMTypeNameForRangeType(typeName: typeName), rangeTypeName: typeName))
        ordinal: ordinal + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerReachableLLVMNextTemporary(): Int { return 0 }
function compilerReachableLLVMRuntimeRequirements(): Int { return 1 }
function compilerReachableLLMSupported(): Int { return 2 }
function compilerReachableLLMTypedAttempts(): Int { return 3 }
function compilerReachableLLMTypedSuccesses(): Int { return 4 }
function compilerReachableLLMLegacyParses(): Int { return 5 }
function compilerReachableLLMArenaCreates(): Int { return 6 }
function compilerReachableLLMArenaDestroys(): Int { return 7 }
function compilerReachableLLMRecordBytes(): Int { return 8 }
function compilerReachableLLMCommittedFailures(): Int { return 9 }
function compilerReachableLLMValid(): Int { return 10 }
function compilerReachableLLMWorkIndex(): Int { return 11 }
function compilerReachableLLMIndirectCapabilities(): Int { return 12 }
function compilerReachableLLMIndirectActivations(): Int { return 13 }
function compilerReachableLLVMEmissionIndex(): Int { return 14 }
function compilerReachableLLVMPlanFrozen(): Int { return 15 }
function compilerReachableLLVMFailureStage(): Int { return 16 }
function compilerReachableLLVMReturnFailureKind(): Int { return 17 }
function compilerReachableLLVMReturnFailureFunction(): Int { return 18 }
function compilerReachableLLVMReturnFailureDetail(): Int { return 19 }
function compilerReachableLLVMFunctionFailureFunction(): Int { return 20 }
function compilerReachableLLVMFunctionFailureInstance(): Int { return 21 }
function compilerReachableLLVMFunctionFailureDetail(): Int { return 22 }
function compilerReachableLLMCounterCount(): Int { return 23 }

function compilerReachableLLVMReturnFailureDependency(): Int { return 1 }
function compilerReachableLLVMReturnFailureProof(): Int { return 2 }
function compilerReachableLLVMReturnFailureUnresolved(): Int { return 3 }
function compilerReachableLLVMReturnFailurePassLimit(): Int { return 4 }

function compilerReachableLLVMReturnFailureName(kind: Int): String {
    if kind == compilerReachableLLVMReturnFailureDependency() { return String("dependency") }
    if kind == compilerReachableLLVMReturnFailureProof() { return String("proof") }
    if kind == compilerReachableLLVMReturnFailureUnresolved() { return String("unresolved") }
    if kind == compilerReachableLLVMReturnFailurePassLimit() { return String("passLimit") }
    return String("invalid")
}

