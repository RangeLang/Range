    stringTransientRegionReset(mark: closureTransientMark)
    if compilerReachableLLVMStateFreezeABIPlan(reachability: reachability) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("abiPlan.end"))
    if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary(), value: 0) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
    let emissionEdgeOwners: RawBuffer(rawBufferCreate(capacity: rawBufferCount(buffer: reachability.edgeOwners), stride: 4))
    let emissionEdgeTargets: RawBuffer(rawBufferCreate(capacity: rawBufferCount(buffer: reachability.edgeTargets), stride: 4))
    state emissionStatus: Int(0)
    while emissionStatus == 0 && rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMEmissionIndex()) < rawBufferCount(buffer: reachability.worklist) {
        let emissionIndex: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMEmissionIndex()))
        let emissionFunctionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: emissionIndex))
        let emissionInstanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: emissionIndex))
        if compilerReachableLLVMStateEmitFunction(reachability: reachability, functionRow: emissionFunctionRow, instanceID: emissionInstanceID, emissionEdgeOwners: emissionEdgeOwners, emissionEdgeTargets: emissionEdgeTargets) != 0 { emissionStatus: 20 }
