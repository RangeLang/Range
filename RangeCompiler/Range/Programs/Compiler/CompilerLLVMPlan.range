        abiComponentChanged: compilerReachableLLVMStateSensitiveCount(reachability: reachability) != sensitiveCountBeforeComponents
        abiComponentIteration: abiComponentIteration + 1
    }
    if abiComponentStatus < 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 41) }
    if abiComponentStatus > 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 200000 + abiComponentStatus - 1) }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("abiComponents.end"))
    if compilerReachableLLVMStateRefreshCapabilityCounter(reachability: reachability) != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 42) }
    let entryOwnedPathStatus: Int(compilerReachableLLVMStateValidateEntryOwnedPaths(reachability: reachability))
    if entryOwnedPathStatus != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 300000 + entryOwnedPathStatus) }
    let closureTransientMark: Int(stringTransientRegionMark())
    state activationWorkIndex: Int(rawBufferCount(buffer: reachability.worklist))
    while activationWorkIndex < rawBufferCount(buffer: reachability.worklist) {
        let activationFunctionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: activationWorkIndex))
        if rawBufferLoadInt(buffer: reachability.abiCapabilities, index: activationFunctionRow) == 1
            && compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: activationFunctionRow) == compilerFunctionReturnABIIndirect() {
            if rawBufferStoreInt(buffer: reachability.abiActivation, index: activationFunctionRow, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
            if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectActivations(), value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
        }
        activationWorkIndex: activationWorkIndex + 1
    }
    state closureChanged: Bool(false)
    while closureChanged {
        let closureIterationMark: Int(stringTransientRegionMark())
        closureChanged: false
        state closureFunctionRow: Int(0)
        while closureFunctionRow < compilerIntTableRowCount(table: reachability.context.tables.functions) {
            state closureParticipant: Int(0)
            if rawBufferLoadInt(buffer: reachability.abiActivation, index: closureFunctionRow) == 1 { closureParticipant: 1 }
            if rawBufferStoreInt(buffer: reachability.abiParticipants, index: closureFunctionRow, value: closureParticipant) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
            closureFunctionRow: closureFunctionRow + 1
        }
