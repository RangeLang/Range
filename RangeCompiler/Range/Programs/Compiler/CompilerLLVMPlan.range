}

function compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: CompilerReachableLLVMState, instanceID: Int): Int {
    if instanceID < 0 || instanceID >= compilerIntTableRowCount(table: reachability.functionInstances) { return 0 - 1 }
    return compilerIntTableValue(table: reachability.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceReceiverKeyColumn())
}

function compilerReachableFunctionInstanceSignatureRow(signatures: CompilerIntTable, instanceID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: signatures) {
        if compilerIntTableValue(table: signatures, row: row, column: compilerReachableFunctionInstanceSignatureIDColumn()) == instanceID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerReachablePlannedFunctionInstance(functionInstances: CompilerIntTable, functionRow: Int, receiverTypeKeyID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: functionInstances) {
        if compilerIntTableValue(table: functionInstances, row: row, column: compilerReachableFunctionInstanceFunctionColumn()) == functionRow
            && compilerIntTableValue(table: functionInstances, row: row, column: compilerReachableFunctionInstanceReceiverKeyColumn()) == receiverTypeKeyID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerReachableLLVMStateInternFunctionInstance(reachability: CompilerReachableLLVMState, functionRow: Int, receiverTypeKeyID: Int): Int {
    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: reachability.context.tables.functions) { return 0 - 1 }
    let ownerSyntaxID: Int(rawBufferLoadInt(buffer: reachability.context.tables.functionOwners, index: functionRow))
    let ownerGenericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: reachability.context.tables, ownerSyntaxID: ownerSyntaxID))
    state canonicalReceiverTypeKeyID: Int(receiverTypeKeyID)
    if ownerGenericCount <= 0 {
        canonicalReceiverTypeKeyID: 0 - 1
    } else {
        if canonicalReceiverTypeKeyID < 0 { return 0 - 1 }
        if canonicalReceiverTypeKeyID >= compilerIntTableRowCount(table: reachability.typeKeys) { return 0 - 1 }
        if ownerSyntaxID < 0 || compilerIntTableValue(table: reachability.typeKeys, row: canonicalReceiverTypeKeyID, column: compilerReachableTypeKeyNominalColumn()) != ownerSyntaxID { return 0 - 1 }
    }
    state existingRow: Int(0)
    while existingRow < compilerIntTableRowCount(table: reachability.functionInstances) {
        if compilerIntTableValue(table: reachability.functionInstances, row: existingRow, column: compilerReachableFunctionInstanceFunctionColumn()) == functionRow
            && compilerIntTableValue(table: reachability.functionInstances, row: existingRow, column: compilerReachableFunctionInstanceReceiverKeyColumn()) == canonicalReceiverTypeKeyID { return existingRow }
        existingRow: existingRow + 1
    }
    let syntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: functionRow, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: syntaxID))
    if declarationRow < 0 { return 0 - 1 }
    state fingerprint: CompilerFingerprint(first: compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 11), second: compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 12))
    if canonicalReceiverTypeKeyID >= 0 {
        let receiverFingerprint: CompilerFingerprint(compilerReachableTypeKeyFingerprint(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, tables: reachability.context.tables, typeKeyID: canonicalReceiverTypeKeyID))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: receiverFingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: receiverFingerprint.second)
    }
    let instanceID: Int(compilerIntTableRowCount(table: reachability.functionInstances))
    if compilerIntTableAppend(table: reachability.functionInstances, value: instanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstances, value: functionRow) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstances, value: canonicalReceiverTypeKeyID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstances, value: fingerprint.first) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstances, value: fingerprint.second) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstances, value: 0 - 1) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstances, value: 0 - 1) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstanceReturnSummaries, value: instanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstanceReturnSummaries, value: compilerReachableFunctionInstanceReturnSummaryUnknown()) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstanceReturnSummaries, value: 0 - 1) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstanceReturnSummaries, value: compilerBodyTypeUnknown()) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstanceReturnSummaries, value: 0 - 1) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: reachability.functionInstanceReturnSummaries, value: 0) != 0 { return 0 - 1 }
    return instanceID
}

function compilerReachableLLVMStateFreezeFunctionInstanceSignature(reachability: CompilerReachableLLVMState, instanceID: Int, arena: CompilerBodyArena): Int {
    if instanceID < 0 || instanceID >= compilerIntTableRowCount(table: reachability.functionInstances) { return 0 - 1 }
    let signature: CompilerFingerprint(compilerBodyArenaFunctionSignatureFingerprint(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, allowIntern: true))
    if signature.first == 0 && signature.second == 0 { return 0 - 1 }
    let firstIndex: Int(instanceID * compilerReachableFunctionInstanceColumnCount() + compilerReachableFunctionInstanceSignatureFirstColumn())
    let secondIndex: Int(instanceID * compilerReachableFunctionInstanceColumnCount() + compilerReachableFunctionInstanceSignatureSecondColumn())
    let existingFirst: Int(rawBufferLoadInt(buffer: reachability.functionInstances.values, index: firstIndex))
    let existingSecond: Int(rawBufferLoadInt(buffer: reachability.functionInstances.values, index: secondIndex))
    if existingFirst >= 0 || existingSecond >= 0 {
        if existingFirst != signature.first || existingSecond != signature.second { return 0 - 1 }
    }
    let ownerSyntaxID: Int(rawBufferLoadInt(buffer: reachability.context.tables.functionOwners, index: compilerIntTableValue(table: reachability.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn())))
    let functionRow: Int(compilerIntTableValue(table: reachability.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn()))
    let receiverTypeID: Int(arena.ownerReceiverTypeID)
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 1))
    let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 6))
    let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 7))
    let returnTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: returnFileID, start: returnStart, end: returnEnd))
    let returnTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID))
    let returnTypeKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: returnTypeID))
    let returnABICategory: Int(compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: returnTypeID, typeKind: returnTypeKind))
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 3))
    if returnTypeID < 0 || returnTypeKeyID < 0 || returnTypeKind == compilerBodyTypeUnknown() || firstParameterRow < 0 || parameterCount < 0 || firstParameterRow + parameterCount > compilerIntTableRowCount(table: arena.tables.parameters) || (arena.ownerReceiverTypeKeyID >= 0 && returnABICategory == compilerBodyFunctionSignatureABICategoryNone()) { return 0 - 1 }
    state signatureRow: Int(0 - 1)
    state signatureScanRow: Int(0)
    while signatureScanRow < compilerIntTableRowCount(table: reachability.functionInstanceSignatures) {
        if compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureScanRow, column: compilerReachableFunctionInstanceSignatureIDColumn()) == instanceID { signatureRow: signatureScanRow }
        signatureScanRow: signatureScanRow + 1
    }
    state parameterStorageStart: Int(compilerIntTableRowCount(table: reachability.functionInstanceSignatureParameters))
    if signatureRow >= 0 {
        parameterStorageStart: compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterFirstRowColumn())
        if compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKeyColumn()) != returnTypeKeyID
            || compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKindColumn()) != returnTypeKind
            || compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnABICategoryColumn()) != returnABICategory
            || compilerIntTableValue(table: reachability.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterCountColumn()) != parameterCount { return 0 - 1 }
    } else {
        if compilerIntTableAppend(table: reachability.functionInstanceSignatures, value: instanceID) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: reachability.functionInstanceSignatures, value: returnTypeKeyID) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: reachability.functionInstanceSignatures, value: returnTypeKind) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: reachability.functionInstanceSignatures, value: returnABICategory) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: reachability.functionInstanceSignatures, value: parameterCount) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: reachability.functionInstanceSignatures, value: parameterStorageStart) != 0 { return 0 - 1 }
    }
    state parameterOrdinal: Int(0)
    while parameterOrdinal < parameterCount {
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterStart: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8))
        let parameterEnd: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9))
        let parameterTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: parameterStart, end: parameterEnd))
        let parameterTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: parameterTypeID))
        let parameterTypeKeyID: Int(compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: parameterTypeID))
        let parameterABICategory: Int(compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: parameterTypeID, typeKind: parameterTypeKind))
        let storedParameterRow: Int(parameterStorageStart + parameterOrdinal)
        if parameterTypeID < 0 || parameterTypeKeyID < 0 || parameterTypeKind == compilerBodyTypeUnknown() || (arena.ownerReceiverTypeKeyID >= 0 && parameterABICategory == compilerBodyFunctionSignatureABICategoryNone()) { return 0 - 1 }
        if signatureRow >= 0 {
            if storedParameterRow < 0 || storedParameterRow >= compilerIntTableRowCount(table: reachability.functionInstanceSignatureParameters)
                || compilerIntTableValue(table: reachability.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterInstanceColumn()) != instanceID
                || compilerIntTableValue(table: reachability.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterOrdinalColumn()) != parameterOrdinal
                || compilerIntTableValue(table: reachability.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterTypeKeyColumn()) != parameterTypeKeyID
                || compilerIntTableValue(table: reachability.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterTypeKindColumn()) != parameterTypeKind
                || compilerIntTableValue(table: reachability.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterABICategoryColumn()) != parameterABICategory { return 0 - 1 }
        } else {
            if compilerIntTableAppend(table: reachability.functionInstanceSignatureParameters, value: instanceID) != 0 { return 0 - 1 }
            if compilerIntTableAppend(table: reachability.functionInstanceSignatureParameters, value: parameterOrdinal) != 0 { return 0 - 1 }
            if compilerIntTableAppend(table: reachability.functionInstanceSignatureParameters, value: parameterTypeKeyID) != 0 { return 0 - 1 }
            if compilerIntTableAppend(table: reachability.functionInstanceSignatureParameters, value: parameterTypeKind) != 0 { return 0 - 1 }
            if compilerIntTableAppend(table: reachability.functionInstanceSignatureParameters, value: parameterABICategory) != 0 { return 0 - 1 }
        }
        parameterOrdinal: parameterOrdinal + 1
    }
    if rawBufferStoreInt(buffer: reachability.functionInstances.values, index: firstIndex, value: signature.first) != 0 { return 0 - 1 }
    if rawBufferStoreInt(buffer: reachability.functionInstances.values, index: secondIndex, value: signature.second) != 0 { return 0 - 1 }
    return 0
}

function compilerReachableLLVMStateCreate(context: CompilerLLVMLoweringContext): CompilerReachableLLVMState {
    let functionCount: Int(compilerIntTableRowCount(table: context.tables.functions))
    let counters: RawBuffer(rawBufferCreate(capacity: compilerReachableLLMCounterCount(), stride: 4))
    state counterIndex: Int(0)
    while counterIndex < compilerReachableLLMCounterCount() {
        rawBufferAppendInt(buffer: counters, value: 0)
        counterIndex: counterIndex + 1
    }
    rawBufferStoreInt(buffer: counters, index: compilerReachableLLMValid(), value: 1)
    rawBufferStoreInt(buffer: counters, index: compilerReachableLLVMReturnFailureFunction(), value: 0 - 1)
    rawBufferStoreInt(buffer: counters, index: compilerReachableLLVMFunctionFailureFunction(), value: 0 - 1)
    rawBufferStoreInt(buffer: counters, index: compilerReachableLLVMFunctionFailureInstance(), value: 0 - 1)
    let abiCapabilities: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    let abiActivation: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    let abiReturnModes: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    let abiParticipants: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    let abiSensitiveFunctions: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    state capabilityRow: Int(0)
    while capabilityRow < functionCount {
        rawBufferAppendInt(buffer: abiCapabilities, value: 0)
        rawBufferAppendInt(buffer: abiActivation, value: 0)
        rawBufferAppendInt(buffer: abiReturnModes, value: compilerFunctionReturnABINone())
        rawBufferAppendInt(buffer: abiParticipants, value: 0)
        rawBufferAppendInt(buffer: abiSensitiveFunctions, value: 0)
        capabilityRow: capabilityRow + 1
    }
    let selection: CompilerFunctionSelection(compilerFunctionSelectionCreateEmpty(functionCount: functionCount, valid: context.declarationIndex.isValid))
    let worklist: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    let worklistInstanceIDs: RawBuffer(rawBufferCreate(capacity: functionCount * 2 + 16, stride: 4))
    let edgeOwners: RawBuffer(rawBufferCreate(capacity: functionCount * 4, stride: 4))
    let edgeTargets: RawBuffer(rawBufferCreate(capacity: functionCount * 4, stride: 4))
    let instanceEdgeOwners: RawBuffer(rawBufferCreate(capacity: functionCount * 4, stride: 4))
    let instanceEdgeTargets: RawBuffer(rawBufferCreate(capacity: functionCount * 4, stride: 4))
    let typeKeys: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyColumnCount(), estimatedRowCount: 32))
    let typeKeyArguments: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyArgumentColumnCount(), estimatedRowCount: 48))
    let functionInstances: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceColumnCount(), estimatedRowCount: functionCount * 2 + 16))
    let functionInstanceSignatures: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceSignatureColumnCount(), estimatedRowCount: functionCount * 2 + 16))
    let functionInstanceSignatureParameters: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceSignatureParameterColumnCount(), estimatedRowCount: functionCount * 4 + 32))
    let functionInstanceEffects: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectColumnCount(), estimatedRowCount: functionCount * 4 + 32))
    let functionInstanceEffectPaths: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectPathColumnCount(), estimatedRowCount: functionCount * 4 + 32))
    let functionInstanceEffectCalls: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectCallColumnCount(), estimatedRowCount: functionCount * 4 + 32))
    let functionInstanceReturnSummaries: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnSummaryColumnCount(), estimatedRowCount: functionCount * 2 + 16))
    let functionInstanceReturnLeaves: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnLeafColumnCount(), estimatedRowCount: functionCount * 4 + 32))
    let functionsBuffer: RawBuffer(rawBufferCreate(capacity: 1048576, stride: 1))
    let globalsBuffer: RawBuffer(rawBufferCreate(capacity: 65536, stride: 1))
    let created: CompilerReachableLLVMState(
        context: $context,
        selection: selection,
        worklist: worklist,
        worklistInstanceIDs: worklistInstanceIDs,
        edgeOwners: edgeOwners,
        edgeTargets: edgeTargets,
        instanceEdgeOwners: instanceEdgeOwners,
        instanceEdgeTargets: instanceEdgeTargets,
        typeKeys: typeKeys,
        typeKeyArguments: typeKeyArguments,
        functionInstances: functionInstances,
        functionInstanceSignatures: functionInstanceSignatures,
        functionInstanceSignatureParameters: functionInstanceSignatureParameters,
        functionInstanceEffects: functionInstanceEffects,
        functionInstanceEffectPaths: functionInstanceEffectPaths,
        functionInstanceEffectCalls: functionInstanceEffectCalls,
        functionInstanceReturnSummaries: functionInstanceReturnSummaries,
        functionInstanceReturnLeaves: functionInstanceReturnLeaves,
        abiCapabilities: abiCapabilities,
        abiActivation: abiActivation,
        abiReturnModes: abiReturnModes,
        abiParticipants: abiParticipants,
        abiSensitiveFunctions: abiSensitiveFunctions,
        functionsBuffer: functionsBuffer,
        globalsBuffer: globalsBuffer,
        counters: counters
    )
    return created
}

function compilerReachableLLVMStateSetInvalid(reachability: CompilerReachableLLVMState): Int {
    if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLMValid(), value: 0) != 0 { return 0 - 1 }
    return 0 - 1
}

function compilerReachableLLVMStateSetInvalidAt(reachability: CompilerReachableLLVMState, stage: Int): Int {
    if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMFailureStage(), value: stage) != 0 { return 0 - 1 }
    return compilerReachableLLVMStateSetInvalid(reachability: reachability)
}

function compilerReachableLLVMStateSetReturnFailure(reachability: CompilerReachableLLVMState, kind: Int, functionRow: Int, detail: Int): Int {
    if kind < compilerReachableLLVMReturnFailureDependency() || kind > compilerReachableLLVMReturnFailurePassLimit() { return 0 - 1 }
    if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureKind(), value: kind) != 0
        || rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureFunction(), value: functionRow) != 0
        || rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMReturnFailureDetail(), value: detail) != 0 { return 0 - 1 }
    return 0 - 1
}

function compilerReachableLLVMStateWorklistInstanceID(reachability: CompilerReachableLLVMState, workIndex: Int): Int {
    if workIndex < 0 || workIndex >= rawBufferCount(buffer: reachability.worklistInstanceIDs) { return 0 - 1 }
    return rawBufferLoadInt(buffer: reachability.worklistInstanceIDs, index: workIndex)
}

function compilerReachableLLVMStateWorklistContainsInstance(reachability: CompilerReachableLLVMState, instanceID: Int): Bool {
    state workIndex: Int(0)
    while workIndex < rawBufferCount(buffer: reachability.worklistInstanceIDs) {
        if rawBufferLoadInt(buffer: reachability.worklistInstanceIDs, index: workIndex) == instanceID { return true }
        workIndex: workIndex + 1
    }
    return false
}

function compilerReachableLLVMStateAppendWorklistInstance(reachability: CompilerReachableLLVMState, instanceID: Int): Int {
    let functionRow: Int(compilerReachableLLVMStateFunctionInstanceRow(reachability: reachability, instanceID: instanceID))
    if functionRow < 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: reachability.worklist, value: functionRow) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: reachability.worklistInstanceIDs, value: instanceID) != 0 { return 0 - 1 }
    return 0
}

function compilerReachableLLVMStateNormalizeSeedWorklist(reachability: CompilerReachableLLVMState): Int {
    if rawBufferCount(buffer: reachability.worklistInstanceIDs) != 0 { return 0 - 1 }
    state workIndex: Int(0)
    let seedCount: Int(rawBufferCount(buffer: reachability.worklist))
    while workIndex < seedCount {
        let functionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
        let instanceID: Int(compilerReachableLLVMStateInternFunctionInstance(reachability: reachability, functionRow: functionRow, receiverTypeKeyID: 0 - 1))
        if instanceID < 0 { return 0 - 1 }
        if rawBufferAppendInt(buffer: reachability.worklistInstanceIDs, value: instanceID) != 0 { return 0 - 1 }
        workIndex: workIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateEnqueueInstance(reachability: CompilerReachableLLVMState, instanceID: Int): Int {
    let functionRow: Int(compilerReachableLLVMStateFunctionInstanceRow(reachability: reachability, instanceID: instanceID))
    if functionRow < 0 { return 0 - 1 }
    if !compilerFunctionSelectionContains(selection: reachability.selection, functionRow: functionRow) {
        if compilerFunctionSelectionMark(selection: reachability.selection, functionRow: functionRow) != 0 { return 0 - 1 }
    }
    if compilerReachableLLVMStateWorklistContainsInstance(reachability: reachability, instanceID: instanceID) { return 0 }
    return compilerReachableLLVMStateAppendWorklistInstance(reachability: reachability, instanceID: instanceID)
}

function compilerReachableLLVMStateAppendInstanceEdgeMissing(reachability: CompilerReachableLLVMState, ownerInstanceID: Int, targetInstanceID: Int): Int {
    state edgeIndex: Int(0)
    while edgeIndex < rawBufferCount(buffer: reachability.instanceEdgeTargets) {
        if rawBufferLoadInt(buffer: reachability.instanceEdgeOwners, index: edgeIndex) == ownerInstanceID
            && rawBufferLoadInt(buffer: reachability.instanceEdgeTargets, index: edgeIndex) == targetInstanceID { return 0 }
        edgeIndex: edgeIndex + 1
    }
    if rawBufferAppendInt(buffer: reachability.instanceEdgeOwners, value: ownerInstanceID) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: reachability.instanceEdgeTargets, value: targetInstanceID) != 0 { return 0 - 1 }
    return 0
}

function compilerReachableLLVMStateReceiverTypeIDForResolution(arena: CompilerBodyArena, resolutionRow: Int): Int {
    if resolutionRow < 0 || resolutionRow >= compilerIntTableRowCount(table: arena.resolutions) { return 0 - 1 }
    let sourceNodeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionSourceColumn()))
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    let receiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: receiverNodeID))
    if receiverResolutionRow < 0 { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTypeIDColumn())
}

function compilerReachableLLVMStateAssignFunctionInstancesForArena(reachability: CompilerReachableLLVMState, arena: CompilerBodyArena, ownerInstanceID: Int): Int {
    state resolutionRow: Int(0)
    while resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction() {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            if targetFunctionRow < 0 || targetFunctionRow >= compilerIntTableRowCount(table: reachability.context.tables.functions) { return 0 - 1 }
            state receiverKeyID: Int(0 - 1)
            let receiverTypeID: Int(compilerReachableLLVMStateReceiverTypeIDForResolution(arena: arena, resolutionRow: resolutionRow))
            if receiverTypeID >= 0 {
                if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: receiverTypeID) != compilerBodyTypeConstruct() { return 0 - 1 }
                receiverKeyID: compilerReachableTypeKeyInternFromArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, arena: arena, typeID: receiverTypeID)
                if receiverKeyID < 0 { return 0 - 1 }
            }
            let targetInstanceID: Int(compilerReachableLLVMStateInternFunctionInstance(reachability: reachability, functionRow: targetFunctionRow, receiverTypeKeyID: receiverKeyID))
            if targetInstanceID < 0 { return 0 - 1 }
            if compilerBodyArenaSetResolutionInstanceID(arena: arena, resolutionRow: resolutionRow, instanceID: targetInstanceID) != 0 { return 0 - 1 }
            if compilerReachableLLVMStateAppendInstanceEdgeMissing(reachability: reachability, ownerInstanceID: ownerInstanceID, targetInstanceID: targetInstanceID) != 0 { return 0 - 1 }
        }
        resolutionRow: resolutionRow + 1
    }
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetKindColumn()) == compilerBodyMIROperationTargetFunction() {
            let sourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationSourceColumn()))
            let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
            let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
            if resolutionRow < 0 { return 0 - 1 }
            let targetInstanceID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionInstanceIDColumn()))
            if targetInstanceID < 0 { return 0 - 1 }
            let storedInstanceID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationInstanceIDColumn()))
            if storedInstanceID != targetInstanceID { return 0 - 1 }
            if compilerReachableLLVMStateAppendInstanceEdgeMissing(reachability: reachability, ownerInstanceID: ownerInstanceID, targetInstanceID: targetInstanceID) != 0 { return 0 - 1 }
        }
        operationRow: operationRow + 1
    }
    return 0
}

function compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, functionInstances: CompilerIntTable, functionInstanceSignatures: CompilerIntTable, arena: CompilerBodyArena): Int {
    state resolutionRow: Int(0)
    while resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction() {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            if targetFunctionRow < 0 || targetFunctionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - (1000 + resolutionRow * 10 + 1) }
            let ownerSyntaxID: Int(rawBufferLoadInt(buffer: arena.tables.functionOwners, index: targetFunctionRow))
            let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: ownerSyntaxID))
            state receiverKeyID: Int(0 - 1)
            if genericCount > 0 {
                let receiverTypeID: Int(compilerReachableLLVMStateReceiverTypeIDForResolution(arena: arena, resolutionRow: resolutionRow))
                if receiverTypeID < 0 || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: receiverTypeID) != compilerBodyTypeConstruct() { return 0 - (1000 + resolutionRow * 10 + 2) }
                receiverKeyID: compilerReachableTypeKeyFindFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: receiverTypeID)
                if receiverKeyID < 0 { return 0 - (1000 + resolutionRow * 10 + 3) }
            }
            let targetInstanceID: Int(compilerReachablePlannedFunctionInstance(functionInstances: functionInstances, functionRow: targetFunctionRow, receiverTypeKeyID: receiverKeyID))
            if targetInstanceID < 0 { return 0 - (4000 + targetFunctionRow) }
            if compilerReachableFunctionInstanceSignatureRow(signatures: functionInstanceSignatures, instanceID: targetInstanceID) < 0 { return 0 - (8000 + targetFunctionRow) }
            if compilerBodyArenaSetResolutionInstanceID(arena: arena, resolutionRow: resolutionRow, instanceID: targetInstanceID) != 0 { return 0 - (1000 + resolutionRow * 10 + 6) }
        }
        resolutionRow: resolutionRow + 1
    }
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetKindColumn()) == compilerBodyMIROperationTargetFunction() {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
            if targetFunctionRow < 0 || targetFunctionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - (2000 + operationRow * 10 + 1) }
            let ownerSyntaxID: Int(rawBufferLoadInt(buffer: arena.tables.functionOwners, index: targetFunctionRow))
            let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: ownerSyntaxID))
            state receiverKeyID: Int(0 - 1)
            if genericCount > 0 {
                let sourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationSourceColumn()))
                let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
                let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
                let receiverTypeID: Int(compilerReachableLLVMStateReceiverTypeIDForResolution(arena: arena, resolutionRow: resolutionRow))
                if receiverTypeID < 0 { return 0 - (2000 + operationRow * 10 + 2) }
                receiverKeyID: compilerReachableTypeKeyFindFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: receiverTypeID)
                if receiverKeyID < 0 { return 0 - (2000 + operationRow * 10 + 3) }
            }
            let targetInstanceID: Int(compilerReachablePlannedFunctionInstance(functionInstances: functionInstances, functionRow: targetFunctionRow, receiverTypeKeyID: receiverKeyID))
            if targetInstanceID < 0 { return 0 - (2000 + operationRow * 10 + 4) }
            if compilerReachableFunctionInstanceSignatureRow(signatures: functionInstanceSignatures, instanceID: targetInstanceID) < 0 { return 0 - (2000 + operationRow * 10 + 5) }
            let storedInstanceID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationInstanceIDColumn()))
            if storedInstanceID != targetInstanceID { return 0 - (2000 + operationRow * 10 + 6) }
        }
        operationRow: operationRow + 1
    }
    return 0
}

function compilerReachableLLVMStateAddCounter(reachability: CompilerReachableLLVMState, index: Int, value: Int): Int {
    return rawBufferStoreInt(buffer: reachability.counters, index: index, value: rawBufferLoadInt(buffer: reachability.counters, index: index) + value)
}

function compilerReachableLLVMStateEnqueueEdges(reachability: CompilerReachableLLVMState, edgeStart: Int): Int {
    state edgeIndex: Int(edgeStart)
    while edgeIndex < rawBufferCount(buffer: reachability.edgeTargets) {
        let targetFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: edgeIndex))
        if targetFunctionRow < 0 || targetFunctionRow >= compilerIntTableRowCount(table: reachability.context.tables.functions) { return 0 - 1 }
        edgeIndex: edgeIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateEnqueueInstanceEdges(reachability: CompilerReachableLLVMState, edgeStart: Int): Int {
    state edgeIndex: Int(edgeStart)
    while edgeIndex < rawBufferCount(buffer: reachability.instanceEdgeTargets) {
        let targetInstanceID: Int(rawBufferLoadInt(buffer: reachability.instanceEdgeTargets, index: edgeIndex))
        if compilerReachableLLVMStateEnqueueInstance(reachability: reachability, instanceID: targetInstanceID) != 0 { return 0 - 1 }
        edgeIndex: edgeIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateAccumulate(reachability: CompilerReachableLLVMState, selected: CompilerTypedLLVMHelpers): Int {
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMSupported(), value: selected.telemetry.supportedCount) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMTypedAttempts(), value: selected.telemetry.typedParseAttempts) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMTypedSuccesses(), value: selected.telemetry.typedParseSuccesses) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMLegacyParses(), value: selected.telemetry.legacyParses) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMArenaCreates(), value: selected.telemetry.arenaCreates) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMArenaDestroys(), value: selected.telemetry.arenaDestroys) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMRecordBytes(), value: selected.telemetry.recordBytes) != 0 { return 0 - 1 }
    if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMCommittedFailures(), value: selected.telemetry.committedFailures) != 0 { return 0 - 1 }
    if selected.runtimeRequirements > rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMRuntimeRequirements()) {
        if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMRuntimeRequirements(), value: selected.runtimeRequirements) != 0 { return 0 - 1 }
    }
    return rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary(), value: selected.helpers.nextTemporary)
}

function compilerReachableLLVMStatePlannedReturnMode(reachability: CompilerReachableLLVMState, functionRow: Int): Int {
    let signatureMode: Int(compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow))
    if signatureMode == compilerFunctionReturnABINone()
        && rawBufferLoadInt(buffer: reachability.abiSensitiveFunctions, index: functionRow) == 1 { return compilerFunctionReturnABIIndirect() }
    return signatureMode
}

function compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: CompilerReachableLLVMState, functionRow: Int): Bool {
    if rawBufferLoadInt(buffer: reachability.abiSensitiveFunctions, index: functionRow) == 1 { return true }
    return compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow)
}

function compilerReachableLLVMStatePrepareCandidateABIPlan(reachability: CompilerReachableLLVMState): Int {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    state functionRow: Int(0)
    while functionRow < functionCount {
        let functionTransientMark: Int(stringTransientRegionMark())
        let returnMode: Int(compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: functionRow))
        state participant: Int(0)
        if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: functionRow) {
            if compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: functionRow) { participant: 1 }
        }
        if rawBufferStoreInt(buffer: reachability.abiReturnModes, index: functionRow, value: returnMode) != 0 {
            stringTransientRegionReset(mark: functionTransientMark)
            return 0 - 1
        }
        if rawBufferStoreInt(buffer: reachability.abiParticipants, index: functionRow, value: participant) != 0 {
            stringTransientRegionReset(mark: functionTransientMark)
            return 0 - 1
        }
        stringTransientRegionReset(mark: functionTransientMark)
        functionRow: functionRow + 1
    }
    state edgeIndex: Int(0)
    while edgeIndex < rawBufferCount(buffer: reachability.edgeTargets) {
        let ownerFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: edgeIndex))
        let targetFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: edgeIndex))
        if ownerFunctionRow < 0 || ownerFunctionRow >= functionCount || targetFunctionRow < 0 || targetFunctionRow >= functionCount { return 0 - 1 }
        let edgeTransientMark: Int(stringTransientRegionMark())
        if compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow) {
            if rawBufferStoreInt(buffer: reachability.abiParticipants, index: ownerFunctionRow, value: 1) != 0 {
                stringTransientRegionReset(mark: edgeTransientMark)
                return 0 - 1
            }
            if rawBufferStoreInt(buffer: reachability.abiParticipants, index: targetFunctionRow, value: 1) != 0 {
                stringTransientRegionReset(mark: edgeTransientMark)
                return 0 - 1
            }
        }
        stringTransientRegionReset(mark: edgeTransientMark)
        edgeIndex: edgeIndex + 1
    }
    return 0
}

function compilerReachableLLVMStateSensitiveCount(reachability: CompilerReachableLLVMState): Int {
    state count: Int(0)
    state functionRow: Int(0)
    while functionRow < rawBufferCount(buffer: reachability.abiSensitiveFunctions) {
        if rawBufferLoadInt(buffer: reachability.abiSensitiveFunctions, index: functionRow) == 1 { count: count + 1 }
        functionRow: functionRow + 1
    }
    return count
}

function compilerReachableLLVMStateProbeCandidateFunction(reachability: CompilerReachableLLVMState, functionRow: Int, instanceID: Int): Int {
    state transientMark: Int(stringTransientRegionMark())
    let probeEdgeOwners: RawBuffer(rawBufferCreate(capacity: 16, stride: 4))
    let probeEdgeTargets: RawBuffer(rawBufferCreate(capacity: 16, stride: 4))
    let sensitiveCountBefore: Int(compilerReachableLLVMStateSensitiveCount(reachability: reachability))
    let candidatePlan: CompilerModuleABIPlan(returnModes: $reachability.abiReturnModes, participants: $reachability.abiParticipants, isFrozen: true)
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateForFunctionInstance(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow, functionInstanceID: instanceID, receiverTypeKeyID: compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: reachability, instanceID: instanceID), typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments)))
    state capable: Bool(compilerBodyArenaIsValid(arena: arena))
    state failureStage: Int(1)
    if capable {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 {
            failureStage: 2
            capable: false
        }
    }
    if capable {
        if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) {
            failureStage: 3
            capable: false
        }
    }
    if capable {
        if compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, arena: arena) != 0 {
            failureStage: 8
            capable: false
        }
    }
    if capable {
        if compilerBodyArenaAppendFunctionEdges(arena: arena, edgeOwners: probeEdgeOwners, edgeTargets: probeEdgeTargets) != 0 {
            failureStage: 10
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable {
        if compilerBodyArenaBuildCFG(arena: arena) != 0 {
            failureStage: 4
            capable: false
        }
    }
    if capable {
        if !compilerBodyArenaCFGIsValid(arena: arena) {
            failureStage: 5
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable {
        let memoryBuildStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: candidatePlan, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, effects: reachability.functionInstanceEffects, effectPaths: reachability.functionInstanceEffectPaths, returnSummaries: reachability.functionInstanceReturnSummaries, returnLeaves: reachability.functionInstanceReturnLeaves, applyInstanceEffects: true, recordOwnedFacts: true))
        if memoryBuildStatus != 0 {
            failureStage: 6000 + memoryBuildStatus
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable {
        let mirBuildStatus: Int(compilerBodyMIRBuild(arena: arena))
        if mirBuildStatus != 0 {
            failureStage: 7
            capable: false
        }
    }
    if capable {
        if compilerBodyMIRAppendFunctionEdges(arena: arena, edgeOwners: probeEdgeOwners, edgeTargets: probeEdgeTargets) != 0 {
            failureStage: 10
            capable: false
        }
    }
    if capable {
        if compilerBodyMIRMarkRepresentationSensitiveTargets(arena: arena, sensitiveFunctions: reachability.abiSensitiveFunctions) != 0 {
            failureStage: 10001
            capable: false
        }
    }
    state discoveredSensitiveTarget: Bool(false)
    if capable && compilerReachableLLVMStateSensitiveCount(reachability: reachability) != sensitiveCountBefore { discoveredSensitiveTarget: true }
    if capable {
        state probeEdgeIndex: Int(0)
        while capable && probeEdgeIndex < rawBufferCount(buffer: probeEdgeTargets) {
            if !compilerFunctionEdgesContain(edgeOwners: reachability.edgeOwners, edgeTargets: reachability.edgeTargets, ownerFunctionRow: rawBufferLoadInt(buffer: probeEdgeOwners, index: probeEdgeIndex), targetFunctionRow: rawBufferLoadInt(buffer: probeEdgeTargets, index: probeEdgeIndex)) {
                failureStage: 10002
                capable: false
            }
            probeEdgeIndex: probeEdgeIndex + 1
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    if capable && !discoveredSensitiveTarget {
        let validationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: candidatePlan))
        if validationCode != 0 {
            failureStage: 8000 + validationCode
            capable: false
        }
    }
    if capable && !discoveredSensitiveTarget {
        let capabilityEmission: CompilerBodyLLVMEmissionResult(compilerBodyLLVMEmit(arena: arena, initialTemporary: 0, initialBranch: 0, abiPlan: candidatePlan, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, functionInstanceSignatureParameters: reachability.functionInstanceSignatureParameters))
        if !capabilityEmission.isValid {
            failureStage: 9
            capable: false
        }
    }
    stringTransientRegionReset(mark: transientMark)
    transientMark: stringTransientRegionMark()
    state capabilityValue: Int(1)
    if !capable { capabilityValue: 0 - failureStage }
    if discoveredSensitiveTarget { capabilityValue: 0 }
    state status: Int(rawBufferStoreInt(buffer: reachability.abiCapabilities, index: functionRow, value: capabilityValue))
    if compilerBodyArenaDestroy(arena: arena) != 0 { status: 0 - 1 }
    let probeEdgeOwnersDestroyStatus: Int(rawBufferDestroy(buffer: probeEdgeOwners))
    let probeEdgeTargetsDestroyStatus: Int(rawBufferDestroy(buffer: probeEdgeTargets))
    if probeEdgeOwnersDestroyStatus != 0 || probeEdgeTargetsDestroyStatus != 0 { status: 0 - 1 }
    stringTransientRegionReset(mark: transientMark)
    return status
}

function compilerReachableLLVMStateRefreshCapabilityCounter(reachability: CompilerReachableLLVMState): Int {
    state capabilityCount: Int(0)
    state functionRow: Int(0)
    while functionRow < rawBufferCount(buffer: reachability.abiCapabilities) {
        if compilerFunctionSelectionContains(selection: reachability.selection, functionRow: functionRow)
            && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: functionRow) == 1 { capabilityCount: capabilityCount + 1 }
        functionRow: functionRow + 1
    }
    return rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLMIndirectCapabilities(), value: capabilityCount)
}

function compilerReachableLLVMStateProbeReachableInstancesForFunction(reachability: CompilerReachableLLVMState, functionRow: Int): Int {
    state foundInstance: Bool(false)
    state workIndex: Int(0)
    let workCount: Int(rawBufferCount(buffer: reachability.worklist))
    while workIndex < workCount {
        if rawBufferLoadInt(buffer: reachability.worklist, index: workIndex) == functionRow {
            foundInstance: true
            let instanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
            if instanceID < 0 { return 0 - 1 }
            if compilerReachableLLVMStateProbeCandidateFunction(reachability: reachability, functionRow: functionRow, instanceID: instanceID) != 0 { return 0 - 1 }
            if rawBufferLoadInt(buffer: reachability.abiCapabilities, index: functionRow) != 1 { return 0 }
        }
        workIndex: workIndex + 1
    }
    if !foundInstance { return 0 - 1 }
    return 0
}

function compilerReachableLLVMStateDiscoverFunction(reachability: CompilerReachableLLVMState, functionRow: Int, instanceID: Int): Int {
    let transientMark: Int(stringTransientRegionMark())
    let edgeStart: Int(rawBufferCount(buffer: reachability.edgeTargets))
    let instanceEdgeStart: Int(rawBufferCount(buffer: reachability.instanceEdgeTargets))
    let typedEdgeOwners: RawBuffer(rawBufferCreate(capacity: 16, stride: 4))
    let typedEdgeTargets: RawBuffer(rawBufferCreate(capacity: 16, stride: 4))
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateForFunctionInstance(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: functionRow, functionInstanceID: instanceID, receiverTypeKeyID: compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: reachability, instanceID: instanceID), typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments)))
    state typedReady: Bool(compilerBodyArenaIsValid(arena: arena))
    state typedFailureStage: Int(0)
    if !typedReady { typedFailureStage: 1 }
    if typedReady {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 {
            typedFailureStage: 2
            typedReady: false
        }
    }
    if typedReady {
        if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) {
            typedFailureStage: 3
            typedReady: false
        }
    }
    if typedReady {
        if compilerReachableLLVMStateFreezeFunctionInstanceSignature(reachability: reachability, instanceID: instanceID, arena: arena) != 0 {
            typedFailureStage: 12
            typedReady: false
        }
    }
    if typedReady {
        if compilerBodyArenaAppendFunctionEdges(arena: arena, edgeOwners: typedEdgeOwners, edgeTargets: typedEdgeTargets) != 0 {
            typedFailureStage: 10
            typedReady: false
        }
    }
    if typedReady {
        if compilerReachableLLVMStateAssignFunctionInstancesForArena(reachability: reachability, arena: arena, ownerInstanceID: instanceID) != 0 {
            typedFailureStage: 11
            typedReady: false
        }
    }
    if typedReady {
        if compilerBodyArenaMarkRepresentationSensitiveTargets(arena: arena, sensitiveFunctions: reachability.abiSensitiveFunctions) != 0 {
            typedFailureStage: 10
            typedReady: false
        }
    }
    state status: Int(0)
    if !typedReady {
        state retainedFailureCode: Int(typedFailureStage)
        if rawBufferCount(buffer: arena.failures) > 0 { retainedFailureCode: rawBufferLoadInt(buffer: arena.failures, index: 0) }
        if retainedFailureCode <= 0 { retainedFailureCode: 1 }
        if rawBufferStoreInt(buffer: reachability.abiCapabilities, index: functionRow, value: 0 - retainedFailureCode) != 0 {
            status: 0 - 1
        }
        if status == 0 { status: 0 - 1 }
    }
    if status == 0 {
        state acceptedEdgeIndex: Int(0)
        while acceptedEdgeIndex < rawBufferCount(buffer: typedEdgeTargets) {
            if rawBufferAppendInt(buffer: reachability.edgeOwners, value: rawBufferLoadInt(buffer: typedEdgeOwners, index: acceptedEdgeIndex)) != 0 { status: 0 - 1 }
            if status == 0 {
                if rawBufferAppendInt(buffer: reachability.edgeTargets, value: rawBufferLoadInt(buffer: typedEdgeTargets, index: acceptedEdgeIndex)) != 0 { status: 0 - 1 }
            }
            acceptedEdgeIndex: acceptedEdgeIndex + 1
        }
    }
    let typedEdgeOwnersDestroyStatus: Int(rawBufferDestroy(buffer: typedEdgeOwners))
    let typedEdgeTargetsDestroyStatus: Int(rawBufferDestroy(buffer: typedEdgeTargets))
    let typedArenaDestroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if typedEdgeOwnersDestroyStatus != 0 || typedEdgeTargetsDestroyStatus != 0 || typedArenaDestroyStatus != 0 {
        status: 0 - 1
    }
    if status == 0 {
        if compilerReachableLLVMStateEnqueueEdges(reachability: reachability, edgeStart: edgeStart) != 0 { status: 0 - 1 }
    }
    if status == 0 {
        if compilerReachableLLVMStateEnqueueInstanceEdges(reachability: reachability, edgeStart: instanceEdgeStart) != 0 { status: 0 - 1 }
    }
    stringTransientRegionReset(mark: transientMark)
    return status
}

function compilerReachableLLVMStateEmitFunction(reachability: CompilerReachableLLVMState, functionRow: Int, instanceID: Int, emissionEdgeOwners: RawBuffer, emissionEdgeTargets: RawBuffer): Int {
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMPlanFrozen()) != 1 { return 0 - 1 }
    let syntaxID: Int(compilerIntTableValue(table: reachability.context.tables.functions, row: functionRow, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: reachability.context.tables, syntaxID: syntaxID))
    if declarationRow < 0 { return 0 - 1 }
    let fileID: Int(compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: reachability.context.tables, fileID: fileID, localStart: compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: reachability.context.tables.declarations, row: declarationRow, column: 8)))
    compilerMetricsFunctionBegin(functionID: functionRow, name: name)
    let transientMark: Int(stringTransientRegionMark())
    let selected: CompilerTypedLLVMHelpers(compilerCoreLLVMSelectedHelperFunctionTyped(context: reachability.context, declarationRow: declarationRow, functionRow: functionRow, instanceID: instanceID, receiverTypeKeyID: compilerReachableLLVMStateFunctionInstanceReceiverKey(reachability: reachability, instanceID: instanceID), typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, functionInstanceSignatureParameters: reachability.functionInstanceSignatureParameters, functionInstanceEffects: reachability.functionInstanceEffects, functionInstanceEffectPaths: reachability.functionInstanceEffectPaths, functionInstanceReturnSummaries: reachability.functionInstanceReturnSummaries, functionInstanceReturnLeaves: reachability.functionInstanceReturnLeaves, expectedSignatureFirst: compilerIntTableValue(table: reachability.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceSignatureFirstColumn()), expectedSignatureSecond: compilerIntTableValue(table: reachability.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceSignatureSecondColumn()), initialTemporaryIndex: rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMNextTemporary()), edgeOwners: emissionEdgeOwners, edgeTargets: emissionEdgeTargets, abiPlan: compilerReachableLLVMStateABIPlan(reachability: reachability)))
    compilerMetricsFunctionEnd(legacyParses: selected.telemetry.legacyParses, recordBytes: selected.telemetry.recordBytes)
    state status: Int(0)
    if rawBufferAppendText(buffer: reachability.functionsBuffer, text: selected.helpers.renderedFunctions) != 0 { status: 0 - 1 }
    if status == 0 {
