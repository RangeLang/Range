    let abiComponentFunctionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    while abiComponentStatus == 0 && abiComponentChanged {
        if abiComponentIteration > abiComponentFunctionCount { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 40) }
        let sensitiveCountBeforeComponents: Int(compilerReachableLLVMStateSensitiveCount(reachability: reachability))
        if compilerReachableLLVMStatePrepareCandidateABIPlan(reachability: reachability) != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 40) }
        abiComponentStatus: compilerReachableLLVMStateBuildABIComponents(reachability: reachability)
