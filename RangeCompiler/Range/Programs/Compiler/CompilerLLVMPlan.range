                    && rawBufferLoadInt(buffer: reachability.abiParticipants, index: closureCheckedTarget) == 1 {
                    if rawBufferStoreInt(buffer: reachability.abiParticipants, index: closureCheckedTarget, value: 2) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                    blockingParticipationChanged: true
                }
                if compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: closureCheckedTarget)
                    && rawBufferLoadInt(buffer: reachability.abiParticipants, index: closureCheckedTarget) == 2
                    && rawBufferLoadInt(buffer: reachability.abiParticipants, index: closureCheckedOwner) == 1 {
                    if rawBufferStoreInt(buffer: reachability.abiParticipants, index: closureCheckedOwner, value: 2) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                    blockingParticipationChanged: true
                }
                if rawBufferLoadInt(buffer: reachability.abiParticipants, index: closureCheckedOwner) == 1
                    && (rawBufferLoadInt(buffer: reachability.abiCapabilities, index: closureCheckedOwner) != 1
                        || (compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: closureCheckedOwner) == compilerFunctionReturnABIIndirect()
                            && rawBufferLoadInt(buffer: reachability.abiActivation, index: closureCheckedOwner) != 1)
                        || (compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: closureCheckedTarget) == compilerFunctionReturnABIIndirect()
                            && rawBufferLoadInt(buffer: reachability.abiActivation, index: closureCheckedTarget) != 1)
                        || (compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: closureCheckedTarget)
                            && rawBufferLoadInt(buffer: reachability.abiParticipants, index: closureCheckedTarget) != 1)) {
                    if rawBufferStoreInt(buffer: reachability.abiParticipants, index: closureCheckedOwner, value: 2) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                    blockingParticipationChanged: true
                }
                closureEdge: closureEdge + 1
            }
        }
        closureFunctionRow: 0
        while closureFunctionRow < compilerIntTableRowCount(table: reachability.context.tables.functions) {
            if rawBufferLoadInt(buffer: reachability.abiParticipants, index: closureFunctionRow) == 2
                && rawBufferLoadInt(buffer: reachability.abiActivation, index: closureFunctionRow) == 1 {
                if rawBufferStoreInt(buffer: reachability.abiActivation, index: closureFunctionRow, value: 0) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectActivations(), value: 0 - 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                closureChanged: true
            }
            closureFunctionRow: closureFunctionRow + 1
        }
        closureEdge: 0
        while closureEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let closurePrunedOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: closureEdge))
            let closurePrunedTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: closureEdge))
            if rawBufferLoadInt(buffer: reachability.abiParticipants, index: closurePrunedOwner) == 2
                && rawBufferLoadInt(buffer: reachability.abiActivation, index: closurePrunedTarget) == 1 {
                if rawBufferStoreInt(buffer: reachability.abiActivation, index: closurePrunedTarget, value: 0) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectActivations(), value: 0 - 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                closureChanged: true
