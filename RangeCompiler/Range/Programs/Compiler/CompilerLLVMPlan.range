        while closureEdge < rawBufferCount(buffer: reachability.edgeTargets) {
            let closureOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: closureEdge))
            let closureTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: closureEdge))
            if rawBufferLoadInt(buffer: reachability.abiActivation, index: closureTarget) == 1 {
                if rawBufferStoreInt(buffer: reachability.abiParticipants, index: closureOwner, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                if rawBufferStoreInt(buffer: reachability.abiParticipants, index: closureTarget, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
            }
            closureEdge: closureEdge + 1
        }
        state parameterParticipationChanged: Bool(true)
        while parameterParticipationChanged {
            parameterParticipationChanged: false
            state parameterParticipationEdge: Int(0)
            while parameterParticipationEdge < rawBufferCount(buffer: reachability.edgeTargets) {
                let parameterParticipationOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: parameterParticipationEdge))
                let parameterParticipationTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: parameterParticipationEdge))
                if rawBufferLoadInt(buffer: reachability.abiParticipants, index: parameterParticipationOwner) == 1
                    && compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterParticipationTarget)
                    && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterParticipationTarget) == 1
                    && rawBufferLoadInt(buffer: reachability.abiParticipants, index: parameterParticipationTarget) == 0 {
                    if rawBufferStoreInt(buffer: reachability.abiParticipants, index: parameterParticipationTarget, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                    if compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterParticipationTarget) == compilerFunctionReturnABIIndirect()
                        && rawBufferLoadInt(buffer: reachability.abiActivation, index: parameterParticipationTarget) == 0 {
                        if rawBufferStoreInt(buffer: reachability.abiActivation, index: parameterParticipationTarget, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                        if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectActivations(), value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                        closureChanged: true
                    }
                    parameterParticipationChanged: true
                }
                if rawBufferLoadInt(buffer: reachability.abiParticipants, index: parameterParticipationTarget) == 1
                    && compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterParticipationTarget)
                    && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterParticipationOwner) == 1
                    && rawBufferLoadInt(buffer: reachability.abiParticipants, index: parameterParticipationOwner) == 0 {
                    if rawBufferStoreInt(buffer: reachability.abiParticipants, index: parameterParticipationOwner, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                    if compilerFunctionReturnABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterParticipationOwner) == compilerFunctionReturnABIIndirect()
                        && rawBufferLoadInt(buffer: reachability.abiActivation, index: parameterParticipationOwner) == 0 {
                        if rawBufferStoreInt(buffer: reachability.abiActivation, index: parameterParticipationOwner, value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                        if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectActivations(), value: 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                        closureChanged: true
                    }
                    parameterParticipationChanged: true
                }
                if rawBufferLoadInt(buffer: reachability.abiParticipants, index: parameterParticipationTarget) == 1
                    && compilerFunctionHasRepresentationSensitiveABI(tables: reachability.context.tables, index: reachability.context.declarationIndex, functionRow: parameterParticipationTarget)
                    && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: parameterParticipationOwner) != 1
                    && rawBufferLoadInt(buffer: reachability.abiParticipants, index: parameterParticipationOwner) == 0 {
                    if rawBufferStoreInt(buffer: reachability.abiParticipants, index: parameterParticipationOwner, value: 2) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
                    parameterParticipationChanged: true
                }
                parameterParticipationEdge: parameterParticipationEdge + 1
            }
        }
        state blockingParticipationChanged: Bool(true)
        while blockingParticipationChanged {
            blockingParticipationChanged: false
            closureEdge: 0
            while closureEdge < rawBufferCount(buffer: reachability.edgeTargets) {
