        if entryRefreshStatus != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 50000 + entryRefreshStatus) }
        entryClosureChanged: rawBufferCount(buffer: reachability.worklist) != worklistCountBeforeEntryRefresh
        entryClosureIteration: entryClosureIteration + 1
    }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("reachabilityDiscovery.end"))
    let effectBuildStatus: Int(compilerReachableLLVMStateBuildFunctionInstanceEffects(reachability: reachability))
    if effectBuildStatus != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 0 - effectBuildStatus) }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("functionEffects.end"))
    state abiComponentStatus: Int(0)
