        }
    }
    if rawBufferCount(buffer: emissionEdgeOwners) != rawBufferCount(buffer: emissionEdgeTargets)
        || rawBufferCount(buffer: reachability.edgeOwners) != rawBufferCount(buffer: reachability.edgeTargets) { emissionStatus: 30 }
    state emissionEdgeIndex: Int(0)
    while emissionStatus == 0 && emissionEdgeIndex < rawBufferCount(buffer: emissionEdgeTargets) {
        if !compilerFunctionEdgesContain(edgeOwners: reachability.edgeOwners, edgeTargets: reachability.edgeTargets, ownerFunctionRow: rawBufferLoadInt(buffer: emissionEdgeOwners, index: emissionEdgeIndex), targetFunctionRow: rawBufferLoadInt(buffer: emissionEdgeTargets, index: emissionEdgeIndex)) { emissionStatus: 31 }
        emissionEdgeIndex: emissionEdgeIndex + 1
    }
    state plannedEdgeIndex: Int(0)
    while emissionStatus == 0 && plannedEdgeIndex < rawBufferCount(buffer: reachability.edgeTargets) {
