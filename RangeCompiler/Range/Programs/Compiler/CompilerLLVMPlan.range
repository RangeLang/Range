    }
    if status == 0 {
        if compilerReachableLLVMStateAccumulate(reachability: reachability, selected: selected) != 0 { status: 0 - 1 }
    }
    stringTransientRegionReset(mark: transientMark)
    return status
}

function compilerReachableLLVMStateFreezeABIPlan(reachability: CompilerReachableLLVMState): Int {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    state functionRow: Int(0)
    while functionRow < functionCount {
        state returnMode: Int(compilerFunctionReturnABINone())
        let capabilityMode: Int(compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: functionRow))
        if capabilityMode == compilerFunctionReturnABIDirect() { returnMode: compilerFunctionReturnABIDirect() }
        if rawBufferLoadInt(buffer: reachability.abiActivation, index: functionRow) == 1 { returnMode: compilerFunctionReturnABIIndirect() }
        if rawBufferStoreInt(buffer: reachability.abiReturnModes, index: functionRow, value: returnMode) != 0 { return 0 - 1 }
        if returnMode == compilerFunctionReturnABIIndirect() {
            if rawBufferStoreInt(buffer: reachability.abiParticipants, index: functionRow, value: 1) != 0 { return 0 - 1 }
        }
        functionRow: functionRow + 1
    }
    state edgeIndex: Int(0)
    while edgeIndex < rawBufferCount(buffer: reachability.edgeTargets) {
        let ownerFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: edgeIndex))
        let targetFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: edgeIndex))
        if rawBufferLoadInt(buffer: reachability.abiReturnModes, index: targetFunctionRow) == compilerFunctionReturnABIIndirect() {
            if rawBufferStoreInt(buffer: reachability.abiParticipants, index: ownerFunctionRow, value: 1) != 0 { return 0 - 1 }
        }
        edgeIndex: edgeIndex + 1
    }
    return rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLVMPlanFrozen(), value: 1)
}

function compilerReachableLLVMStateABIPlanIsValid(reachability: CompilerReachableLLVMState): Bool {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    if rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLVMPlanFrozen()) != 1
        || rawBufferCount(buffer: reachability.abiReturnModes) != functionCount
        || rawBufferCount(buffer: reachability.abiParticipants) != functionCount { return false }
    state functionRow: Int(0)
    while functionRow < functionCount {
        let returnMode: Int(rawBufferLoadInt(buffer: reachability.abiReturnModes, index: functionRow))
        if returnMode < compilerFunctionReturnABINone() || returnMode > compilerFunctionReturnABIIndirect() { return false }
        if returnMode == compilerFunctionReturnABIIndirect()
            && (rawBufferLoadInt(buffer: reachability.abiActivation, index: functionRow) != 1
                || rawBufferLoadInt(buffer: reachability.abiParticipants, index: functionRow) != 1
                || compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: functionRow) != compilerFunctionReturnABIIndirect()) { return false }
        if rawBufferLoadInt(buffer: reachability.abiParticipants, index: functionRow) == 1
            && compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: functionRow)
            && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: functionRow) != 1 { return false }
        functionRow: functionRow + 1
    }
    state edgeIndex: Int(0)
    while edgeIndex < rawBufferCount(buffer: reachability.edgeTargets) {
        let ownerFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: edgeIndex))
        let targetFunctionRow: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: edgeIndex))
        if rawBufferLoadInt(buffer: reachability.abiReturnModes, index: targetFunctionRow) == compilerFunctionReturnABIIndirect()
            && rawBufferLoadInt(buffer: reachability.abiParticipants, index: ownerFunctionRow) != 1 { return false }
        if rawBufferLoadInt(buffer: reachability.abiParticipants, index: ownerFunctionRow) == 1
            && compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow)
            && rawBufferLoadInt(buffer: reachability.abiParticipants, index: targetFunctionRow) != 1 { return false }
        if rawBufferLoadInt(buffer: reachability.abiParticipants, index: targetFunctionRow) == 1
            && compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: targetFunctionRow)
            && rawBufferLoadInt(buffer: reachability.abiParticipants, index: ownerFunctionRow) != 1 { return false }
        edgeIndex: edgeIndex + 1
    }
    return true
}

function compilerReachableLLVMStateBuildABIComponents(reachability: CompilerReachableLLVMState): Int {
    let functionCount: Int(compilerIntTableRowCount(table: reachability.context.tables.functions))
    let componentQueue: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    let sensitiveFunctions: RawBuffer(rawBufferCreate(capacity: functionCount, stride: 4))
    state firstBlockedFunction: Int(0 - 1)
    state componentRequiresRestart: Bool(false)
    state status: Int(0)
    if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLMIndirectActivations(), value: 0) != 0 {
        status: 0 - 1
    }
    state sensitivityFunctionRow: Int(0)
    while sensitivityFunctionRow < functionCount && status == 0 {
        let sensitivityMark: Int(stringTransientRegionMark())
        state isSensitiveFunction: Int(0)
        if compilerReachableLLVMStateFunctionIsRepresentationSensitive(reachability: reachability, functionRow: sensitivityFunctionRow) { isSensitiveFunction: 1 }
        if rawBufferStoreInt(buffer: reachability.abiParticipants, index: sensitivityFunctionRow, value: 0) != 0 {
            status: 0 - 1
        }
        if status == 0 {
            if rawBufferStoreInt(buffer: reachability.abiActivation, index: sensitivityFunctionRow, value: 0) != 0 { status: 0 - 1 }
        }
        if status == 0 {
            if rawBufferAppendInt(buffer: sensitiveFunctions, value: isSensitiveFunction) != 0 { status: 0 - 1 }
        }
        stringTransientRegionReset(mark: sensitivityMark)
        sensitivityFunctionRow: sensitivityFunctionRow + 1
    }
    state seedFunctionRow: Int(0)
    while seedFunctionRow < functionCount && !componentRequiresRestart && status == 0 {
        if rawBufferLoadInt(buffer: reachability.abiParticipants, index: seedFunctionRow) == 0
            && compilerFunctionSelectionContains(selection: reachability.selection, functionRow: seedFunctionRow)
            && rawBufferLoadInt(buffer: sensitiveFunctions, index: seedFunctionRow) == 1 {
            let componentStart: Int(rawBufferCount(buffer: componentQueue))
            if rawBufferStoreInt(buffer: reachability.abiParticipants, index: seedFunctionRow, value: 3) != 0 {
                status: 0 - 1
            }
            if status == 0 {
                if rawBufferAppendInt(buffer: componentQueue, value: seedFunctionRow) != 0 { status: 0 - 1 }
            }
            state componentCursor: Int(componentStart)
            state componentBlocked: Bool(false)
            while componentCursor < rawBufferCount(buffer: componentQueue) && status == 0 {
                let componentMember: Int(rawBufferLoadInt(buffer: componentQueue, index: componentCursor))
                state componentEdge: Int(0)
                while componentEdge < rawBufferCount(buffer: reachability.edgeTargets) && status == 0 {
                    let componentOwner: Int(rawBufferLoadInt(buffer: reachability.edgeOwners, index: componentEdge))
                    let componentTarget: Int(rawBufferLoadInt(buffer: reachability.edgeTargets, index: componentEdge))
                    if componentOwner < 0 || componentOwner >= functionCount || componentTarget < 0 || componentTarget >= functionCount {
                        status: 0 - 1
                    }
                    if status == 0 && rawBufferLoadInt(buffer: sensitiveFunctions, index: componentTarget) == 1 {
                        state componentNeighbor: Int(0 - 1)
                        if componentOwner == componentMember { componentNeighbor: componentTarget }
                        if componentTarget == componentMember { componentNeighbor: componentOwner }
                        if componentNeighbor >= 0 {
                            if rawBufferLoadInt(buffer: reachability.abiParticipants, index: componentNeighbor) == 0 {
                                if rawBufferStoreInt(buffer: reachability.abiParticipants, index: componentNeighbor, value: 3) != 0 {
                                    status: 0 - 1
                                }
                                if status == 0 {
                                    if rawBufferAppendInt(buffer: componentQueue, value: componentNeighbor) != 0 { status: 0 - 1 }
                                }
                            }
                        }
                    }
                    componentEdge: componentEdge + 1
                }
                componentCursor: componentCursor + 1
            }
            let componentEnd: Int(rawBufferCount(buffer: componentQueue))
            state componentKnownFailure: Int(componentStart)
            while componentKnownFailure < componentEnd && status == 0 {
                let knownFailureMember: Int(rawBufferLoadInt(buffer: componentQueue, index: componentKnownFailure))
                if rawBufferLoadInt(buffer: reachability.abiCapabilities, index: knownFailureMember) < 0 {
                    componentBlocked: true
                    if firstBlockedFunction < 0 { firstBlockedFunction: knownFailureMember }
                }
                componentKnownFailure: componentKnownFailure + 1
            }
            state componentPrepare: Int(componentStart)
            while componentPrepare < componentEnd && status == 0 {
                if rawBufferStoreInt(buffer: reachability.abiParticipants, index: rawBufferLoadInt(buffer: componentQueue, index: componentPrepare), value: 1) != 0 {
                    status: 0 - 1
                }
                componentPrepare: componentPrepare + 1
            }
            state componentProbe: Int(componentEnd - 1)
            while !componentBlocked && !componentRequiresRestart && componentProbe >= componentStart && status == 0 {
                let probeMember: Int(rawBufferLoadInt(buffer: componentQueue, index: componentProbe))
                if rawBufferLoadInt(buffer: reachability.abiCapabilities, index: probeMember) == 0 {
                    let sensitiveCountBeforeProbe: Int(compilerReachableLLVMStateSensitiveCount(reachability: reachability))
                    let probeStatus: Int(compilerReachableLLVMStateProbeReachableInstancesForFunction(reachability: reachability, functionRow: probeMember))
                    if probeStatus != 0 { status: 0 - 1 }
                    if compilerReachableLLVMStateSensitiveCount(reachability: reachability) != sensitiveCountBeforeProbe { componentRequiresRestart: true }
                }
                if status == 0 && !componentRequiresRestart && rawBufferLoadInt(buffer: reachability.abiCapabilities, index: probeMember) != 1 {
                    componentBlocked: true
                    if firstBlockedFunction < 0 { firstBlockedFunction: probeMember }
                }
                componentProbe: componentProbe - 1
            }
            state componentFinalize: Int(componentStart)
            while !componentRequiresRestart && componentFinalize < componentEnd && status == 0 {
                let finalizedMember: Int(rawBufferLoadInt(buffer: componentQueue, index: componentFinalize))
                state finalizedParticipant: Int(1)
                if componentBlocked { finalizedParticipant: 2 }
                if rawBufferStoreInt(buffer: reachability.abiParticipants, index: finalizedMember, value: finalizedParticipant) != 0 {
                    status: 0 - 1
                }
                if status == 0 && !componentBlocked
                    && compilerReachableLLVMStatePlannedReturnMode(reachability: reachability, functionRow: finalizedMember) == compilerFunctionReturnABIIndirect() {
                    if rawBufferStoreInt(buffer: reachability.abiActivation, index: finalizedMember, value: 1) != 0 {
                        status: 0 - 1
                    }
                    if status == 0 {
                        if compilerReachableLLVMStateAddCounter(reachability: reachability, index: compilerReachableLLMIndirectActivations(), value: 1) != 0 { status: 0 - 1 }
                    }
                }
                componentFinalize: componentFinalize + 1
            }
        }
        seedFunctionRow: seedFunctionRow + 1
    }
    let sensitiveDestroyStatus: Int(rawBufferDestroy(buffer: sensitiveFunctions))
    let queueDestroyStatus: Int(rawBufferDestroy(buffer: componentQueue))
    if sensitiveDestroyStatus != 0 || queueDestroyStatus != 0 { status: 0 - 1 }
    if status == 0 && componentRequiresRestart { return functionCount + 1 }
    if status == 0 && firstBlockedFunction >= 0 { return firstBlockedFunction + 1 }
    return status
}

function compilerReachableLLVMStateSeedEntryRoots(reachability: CompilerReachableLLVMState): Int {
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateEntry(tables: reachability.context.tables, index: reachability.context.declarationIndex)))
    state status: Int(0)
    if !compilerBodyArenaIsValid(arena: arena) {
        let maybeMain: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: reachability.context.tables.sourceStore.source))
        if maybeMain == nil {
            status: 101
        } else {
            let fallbackMain: CompilerMainBlock(attributeStart: 0, bodyStart: 0, bodyEnd: 0)
            let mainBlock: CompilerMainBlock(maybeMain ?? fallbackMain)
            if arena.ownerFunctionRow != 0 - 1 { status: 102 }
            if status == 0 && arena.ownerDeclarationSyntaxID != mainBlock.attributeStart { status: 103 }
            if status == 0 && arena.fileID != compilerSourceStoreFileIDAtGlobalOffset(store: reachability.context.tables.sourceStore, globalOffset: mainBlock.attributeStart) { status: 104 }
            if status == 0 && arena.bodyStart != mainBlock.bodyStart { status: 105 }
            if status == 0 && arena.bodyEnd != mainBlock.bodyEnd { status: 106 }
            if status == 0 && rawBufferCount(buffer: arena.failures) != 0 { status: 1000 + rawBufferLoadInt(buffer: arena.failures, index: 0) }
            if status == 0 && compilerIntTableRowCount(table: arena.nodes) < 1 { status: 108 }
            if status == 0 { status: 109 }
        }
    }
    if status == 0 {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: reachability.context.declarationIndex) != 0 { status: 2 }
    }
    if status == 0 {
        if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) { status: 3 }
    }
    if status == 0 {
        if compilerReachableLLVMStateAssignFunctionInstancesForArena(reachability: reachability, arena: arena, ownerInstanceID: 0 - 1) != 0 { status: 9 }
    }
    state resolutionRow: Int(0)
    while status == 0 && resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction() {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            if targetFunctionRow < 0 || targetFunctionRow >= rawBufferCount(buffer: reachability.selection.selectedRows) {
                status: 4
            } else {
                if compilerBodyArenaResultTypeIsRepresentationSensitive(arena: arena, typeKind: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()), typeID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())) {
                    if rawBufferStoreInt(buffer: reachability.abiSensitiveFunctions, index: targetFunctionRow, value: 1) != 0 { status: 5 }
                }
            }
        }
        resolutionRow: resolutionRow + 1
    }
    state seedInstanceEdgeIndex: Int(0)
    while status == 0 && seedInstanceEdgeIndex < rawBufferCount(buffer: reachability.instanceEdgeTargets) {
        if compilerReachableLLVMStateEnqueueInstance(reachability: reachability, instanceID: rawBufferLoadInt(buffer: reachability.instanceEdgeTargets, index: seedInstanceEdgeIndex)) != 0 { status: 6 }
        seedInstanceEdgeIndex: seedInstanceEdgeIndex + 1
    }
    let entryArenaDestroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if status == 0 && entryArenaDestroyStatus != 0 { status: 8 }
    return status
}

function compilerReachableLLVMStateBuildSelected(reachability: CompilerReachableLLVMState): Int {
    if !reachability.selection.isValid { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
    state entryClosureChanged: Bool(true)
    state entryClosureIteration: Int(0)
    let entryClosureLimit: Int(compilerIntTableRowCount(table: reachability.context.tables.functions) + 1)
    while entryClosureChanged {
        if entryClosureIteration > entryClosureLimit { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 43) }
        while rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMWorkIndex()) < rawBufferCount(buffer: reachability.worklist) {
            let workIndex: Int(rawBufferLoadInt(buffer: reachability.counters, index: compilerReachableLLMWorkIndex()))
            let functionRow: Int(rawBufferLoadInt(buffer: reachability.worklist, index: workIndex))
            let instanceID: Int(compilerReachableLLVMStateWorklistInstanceID(reachability: reachability, workIndex: workIndex))
            if compilerReachableLLVMStateDiscoverFunction(reachability: reachability, functionRow: functionRow, instanceID: instanceID) != 0 { return compilerReachableLLVMStateSetInvalidAt(reachability: reachability, stage: 100000 + functionRow) }
            if rawBufferStoreInt(buffer: reachability.counters, index: compilerReachableLLMWorkIndex(), value: workIndex + 1) != 0 { return compilerReachableLLVMStateSetInvalid(reachability: reachability) }
        }
