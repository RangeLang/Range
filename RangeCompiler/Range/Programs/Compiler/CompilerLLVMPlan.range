function compilerReachableLLVMStateReturnSummaryStatus(reachability: CompilerReachableLLVMState, instanceID: Int): Int {
    if instanceID < 0 || instanceID >= compilerIntTableRowCount(table: reachability.functionInstanceReturnSummaries) { return 0 - 1 }
    return compilerIntTableValue(table: reachability.functionInstanceReturnSummaries, row: instanceID, column: compilerReachableFunctionInstanceReturnSummaryStatusColumn())
}

function compilerReachableLLVMStateSetReturnSummary(reachability: CompilerReachableLLVMState, instanceID: Int, status: Int, typeKeyID: Int, typeKind: Int, firstLeaf: Int, leafCount: Int): Int {
    if instanceID < 0 || instanceID >= compilerIntTableRowCount(table: reachability.functionInstanceReturnSummaries) { return 0 - 1 }
    let baseIndex: Int(instanceID * compilerReachableFunctionInstanceReturnSummaryColumnCount())
    if rawBufferStoreInt(buffer: reachability.functionInstanceReturnSummaries.values, index: baseIndex + compilerReachableFunctionInstanceReturnSummaryInstanceColumn(), value: instanceID) != 0 { return 0 - 1 }
    if rawBufferStoreInt(buffer: reachability.functionInstanceReturnSummaries.values, index: baseIndex + compilerReachableFunctionInstanceReturnSummaryStatusColumn(), value: status) != 0 { return 0 - 1 }
    if rawBufferStoreInt(buffer: reachability.functionInstanceReturnSummaries.values, index: baseIndex + compilerReachableFunctionInstanceReturnSummaryTypeKeyColumn(), value: typeKeyID) != 0 { return 0 - 1 }
    if rawBufferStoreInt(buffer: reachability.functionInstanceReturnSummaries.values, index: baseIndex + compilerReachableFunctionInstanceReturnSummaryTypeKindColumn(), value: typeKind) != 0 { return 0 - 1 }
    if rawBufferStoreInt(buffer: reachability.functionInstanceReturnSummaries.values, index: baseIndex + compilerReachableFunctionInstanceReturnSummaryFirstLeafColumn(), value: firstLeaf) != 0 { return 0 - 1 }
    return rawBufferStoreInt(buffer: reachability.functionInstanceReturnSummaries.values, index: baseIndex + compilerReachableFunctionInstanceReturnSummaryLeafCountColumn(), value: leafCount)
}

function compilerReachableLLVMStateAppendReturnLeafToBuffer(output: RawBuffer, instanceID: Int, returnPathID: Int, sourceKind: Int, baseKind: Int, ordinal: Int, sourcePathID: Int, storageKeyID: Int): Int {
    if rawBufferAppendInt(buffer: output, value: instanceID) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: output, value: returnPathID) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: output, value: sourceKind) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: output, value: baseKind) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: output, value: ordinal) != 0 { return 0 - 1 }
    if rawBufferAppendInt(buffer: output, value: sourcePathID) != 0 { return 0 - 1 }
    return rawBufferAppendInt(buffer: output, value: storageKeyID)
}

