function compileRangeSource(source: String): String {
    let sourceSetOutput: String(compileRangeSourceSetDirectiveOutput(source: source))
    if sourceSetOutput != String("") {
        return sourceSetOutput
    }

    let program: CompilerProgram(parseCompilerProgram(source: source))
    let coreOutput: String(compileRangeCoreDirectiveOutput(source: source, program: program))
    if coreOutput != String("") {
        return coreOutput
    }

    if program.hasMainBlock {
        let defaultLLVMProgram: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
        return "\(lexRangeSource(source: source))\(compilerCoreASTSummaryForProgram(program: program))\(compilerCoreLLVMForProgram(program: defaultLLVMProgram))"
    }

    return "\(lexRangeSource(source: source))\(compilerCoreASTSummaryForProgram(program: program))"
}

function compileRangeNativeSource(source: String): String {
    let directiveOutput: String(compileRangeNativeSourceDirectiveOutput(source: source))
    if directiveOutput != String("") {
        return directiveOutput
    }

    return compileRangeNativeProgramOutput(source: source)
}

function compileRangeNativeSourceDirectiveOutput(source: String): String {
    if compilerSourceRequestsSourceSetBodyFunctionNames(source: source) {
        let bodyFunctionNames: String("\(compilerSourceSetBodyFunctionNames())")
        return bodyFunctionNames
    }

    if compilerSourceRequestsSourceInventory(source: source) {
        return compilerSourceInventorySummary(source: source)
    }

    if compilerSourceRequestsNativeSourceSetParseStats(source: source) {
        return compilerNativeSourceSetParseStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetReachableStats(source: source) {
        return compilerNativeSourceSetReachableStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetSelectedStats(source: source) {
        return compilerNativeSourceSetSelectedStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetSelectedScanStats(source: source) {
        return compilerNativeSourceSetSelectedScanStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetLLVMText(source: source) {
        return compilerNativeSourceSetLLVMText(source: source)
    }

    if compilerSourceRequestsSourceSetLLVMText(source: source) {
        return compilerNativeSourceSetLLVMText(source: source)
    }

    return String("")
}

function compileRangeNativeProgramOutput(source: String): String {
    let program: CompilerProgram(parseCompilerProgramForLLVM(source: source))
    return compilerCoreLLVMEntryTextForProgram(program: program)
}

function compileRangeSourceSetDirectiveOutput(source: String): String {
    if compilerSourceRequestsSourceSetBodyFunctionNames(source: source) {
        let bodyFunctionNames: String("\(compilerSourceSetBodyFunctionNames())")
        return bodyFunctionNames
    }

    if compilerSourceRequestsNativeSourceSetLLVMText(source: source) {
        return compilerNativeSourceSetLLVMText(source: source)
    }

    if compilerSourceRequestsNativeSourceSetParseStats(source: source) {
        return compilerNativeSourceSetParseStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetReachableStats(source: source) {
        return compilerNativeSourceSetReachableStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetSelectedStats(source: source) {
        return compilerNativeSourceSetSelectedStats(source: source)
    }

    if compilerSourceRequestsNativeSourceSetSelectedScanStats(source: source) {
        return compilerNativeSourceSetSelectedScanStats(source: source)
    }

    if compilerSourceRequestsSourceSetAST(source: source) {
        return compilerSourceSetASTSummary(source: source)
    }

    if compilerSourceRequestsSourceSetTypes(source: source) {
        return compilerSourceSetTypesSummary(source: source)
    }

    if compilerSourceRequestsSourceSetLLVMText(source: source) {
        return compilerSourceSetLLVMText(source: source)
    }

    if compilerSourceRequestsSourceSetLLVM(source: source) {
        return compilerSourceSetLLVMSummary(source: source)
    }

    if compilerSourceRequestsSourceInventory(source: source) {
        return compilerSourceInventorySummary(source: source)
    }

    return String("")
}

function compileRangeCoreDirectiveOutput(source: String, program: CompilerProgram): String {
    if compilerSourceRequestsCoreAST(source: source) {
        let astProgram: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
        return "\(lexRangeSource(source: source))\(compilerCoreASTSummaryForProgram(program: astProgram))"
    }

    if compilerSourceRequestsCoreSymbols(source: source) {
        return "\(lexRangeSource(source: source))\(compilerCoreSymbolSummaryForProgram(program: program))"
    }

    if compilerSourceRequestsCoreTypes(source: source) {
        let typedProgram: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
        return "\(lexRangeSource(source: source))\(compilerCoreTypeSummaryForProgram(program: typedProgram))"
    }

    if compilerSourceRequestsCoreLLVM(source: source) {
        let llvmProgram: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
        return "\(lexRangeSource(source: source))\(compilerCoreLLVMForProgram(program: llvmProgram))"
    }

    if compilerSourceRequestsCompilerLLVMText(source: source) {
        let llvmTextProgram: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
        return compilerCoreLLVMTextForProgram(program: llvmTextProgram)
    }

    return String("")
}

function compilerSourceRequestsSourceInventory(source: String): Bool {
    if hasRangePrefix(source: source, start: 0, prefix: String("compilerSourceInventory")) {
        return true
    }
    return false
}

function compilerSourceRequestsSourceSetBodyFunctionNames(source: String): Bool {
    if hasRangePrefix(source: source, start: 0, prefix: String("compilerSourceSetBodyFunctionNames")) {
        return true
    }
    return false
}

