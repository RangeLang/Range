macro init<
    let value: TypeReference,
    let delimiter: Optional<String>,
    let wrapper: Optional<String>,
    let length: Optional<Int>
>(
    @capture pattern: Expression
): Construct & @syntax { target, diagnostics in
    let source: String(pattern.written.text)
    state delimiterCount: Int(0)

    if delimiter == nil && wrapper == nil {
        diagnostics.error("@init delimiter or wrapper is required.")
    }

    if wrapper != nil {
        let actualWrapper: String(wrapper ?? "")

        if actualWrapper.count == 0 {
            diagnostics.error("@init wrapper must not be empty.")
        }

        if source.count > 0 {
            if !source.hasPrefix(actualWrapper) {
                diagnostics.error("@init wrapped pattern must start with wrapper.")
            }

            if !source.hasSuffix(actualWrapper) {
                diagnostics.error("@init wrapped pattern must end with wrapper.")
            }
        }
    } else {
        if delimiter == nil {
            diagnostics.error("@init delimiter is required.")
        }
        let actualDelimiter: String(delimiter ?? "")
        let lets: Array<Let>(target.declaration.lets)
        let states: Array<State>(target.declaration.states)
        let fieldCount: Int(lets.count + states.count)

        if length != nil {
            let actualLength: Int(length ?? 0)

            if fieldCount != actualLength {
                diagnostics.error("@init length must match the construct field count.")
            }
        }

        if source.count > 0 {
            state delimiterCount: source.count(of: actualDelimiter)

            if delimiterCount == 0 {
                diagnostics.error("@init pattern must contain at least one delimiter.")
            }

            if source.hasPrefix(actualDelimiter) {
                diagnostics.error("@init pattern must not start with delimiter.")
            }

            if source.hasSuffix(actualDelimiter) {
                diagnostics.error("@init pattern must not end with delimiter.")
            }

            if source.containsRepeated(delimiter: actualDelimiter) {
                diagnostics.error("@init pattern must contain non-empty delimited slots.")
            }

            let slotCount: Int(delimiterCount + 1)

            if fieldCount != slotCount {
                diagnostics.error("@init pattern slot count must match the construct field count.")
            }
        }

        state letIndex: Int(0)
        while letIndex < lets.count {
            let field: Let(lets.element(index: letIndex))

            if source.count > 0 {
                let slot: String(source.segment(index: letIndex, delimiter: actualDelimiter))

                if field.identifier.name != slot {
                    diagnostics.error("@init pattern slot must match the construct field name.")
                }
            }

            if field.type != value {
                diagnostics.error("@init field type must match the literal value type.")
            }

            state letIndex: letIndex + 1
        }

        state stateIndex: Int(0)
        while stateIndex < states.count {
            let field: State(states.element(index: stateIndex))

            if source.count > 0 {
                let slot: String(
                    source.segment(index: lets.count + stateIndex, delimiter: actualDelimiter)
                )

                if field.identifier.name != slot {
                    diagnostics.error("@init pattern slot must match the construct field name.")
                }
            }

            if field.type != value {
                diagnostics.error("@init field type must match the literal value type.")
            }

            state stateIndex: stateIndex + 1
        }
    }
}
