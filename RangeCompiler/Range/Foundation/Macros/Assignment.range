@macro(name: "assignment", result: "String", target: "@statement"){
    @parameter(name: "target") {
        @value(type: "String", current: "String()")
    }
    @parameter(name: "value") {
        @value(type: "String", current: "String()")
    }

    @return(value: "statement|kind=assign|target="
        + target
        + "|value="
        + value
        + "|projection="
        + "target.declaration")
}
