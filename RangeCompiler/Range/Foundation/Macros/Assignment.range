@macro(name: @string("assignment"), result: @string, target: @statement) {
    @parameter(name: @string("target"), value: @string(value: ""))
    @parameter(name: @string("value"), value: @string(value: ""))

    @return(value: @string("effect|kind=environment-set|name="
        + target
        + "|value="
        + value))
}
