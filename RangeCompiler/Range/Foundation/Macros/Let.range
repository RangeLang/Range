@macro(name: let, result: @string, target: @statement) {
    @parameter(name: name, value: @name)
    @parameter(name: value, value: @string(value: ""))

    @state(name: valueType, value: "@llvmField(value: value, name: @string(\"type\"))")
    @state(name: valueConstruct, value: "@llvmField(value: value, name: @string(\"construct\"))")
    @state(name: llvm, value: "\"effect|kind=environment-set|name=\" + name + \"|value=\" + value")

    @if("!valueType.isEmpty") {
        @assignment(target: llvm, value: "\"llvm-effect|kind=llvm-binding|name=\" + name + \"|construct=\" + valueConstruct + \"|type=\" + valueType + \"|returnCast=\" + @llvmField(value: value, name: @string(\"returnCast\")) + \"|pointer=%\" + name + \"|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  %\" + name + \" = alloca \" + valueType + \"\\n  store \" + valueType + \" \" + @llvmField(value: value, name: @string(\"operand\")) + \", ptr %\" + name")
    }

    @return(value: llvm)
}
