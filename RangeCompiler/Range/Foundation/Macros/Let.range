@macro(name: let, result: @string, target: @statement) {
    @parameter(name: name, value: @name)
    @parameter(name: value, value: @string(value: ""))

    @state(name: valueType, value: "@llvmField(value: value, name: @string(\"type\"))")
    @state(name: valueConstruct, value: "@llvmField(value: value, name: @string(\"construct\"))")

    @if("!valueType.isEmpty") {
        @state(name: body, value: "@llvmField(value: value, name: @string(\"prelude\")) + \"  %\" + name + \" = alloca \" + valueType + \"\\n  store \" + valueType + \" \" + @llvmField(value: value, name: @string(\"operand\")) + \", ptr %\" + name")
        @return(value: @object(type: LLVMEffect, fields: [
            @field(name: kind, value: "llvm-binding"),
            @field(name: binding, value: name),
            @field(name: type, value: valueType),
            @field(name: construct, value: valueConstruct),
            @field(name: returnCast, value: @llvmField(value: value, name: @string("returnCast"))),
            @field(name: body, value: body)
        ]))
    }

    @return(value: @string("effect|kind=environment-set|name="
        + name
        + "|value="
        + value))
}
