@construct
@macro(name: "string", result: "String"){
    @return(value: "%Range.String = type { ptr, i64 }\n\n@.range.string.empty = private unnamed_addr constant [1 x i8] c\"\\00\", align 1\n\ndeclare ptr @malloc(i64)\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n\ndefine %Range.String @RangeString_empty() {\nentry:\n  %s0 = insertvalue %Range.String undef, ptr @.range.string.empty, 0\n  %s1 = insertvalue %Range.String %s0, i64 0, 1\n  ret %Range.String %s1\n}\n\ndefine %Range.String @RangeString_fromBytes(ptr %bytes, i64 %length) {\nentry:\n  %s0 = insertvalue %Range.String undef, ptr %bytes, 0\n  %s1 = insertvalue %Range.String %s0, i64 %length, 1\n  ret %Range.String %s1\n}\n\ndefine %Range.String @RangeString_concat(%Range.String %lhs, %Range.String %rhs) {\nentry:\n  %lhs.ptr = extractvalue %Range.String %lhs, 0\n  %lhs.len = extractvalue %Range.String %lhs, 1\n  %rhs.ptr = extractvalue %Range.String %rhs, 0\n  %rhs.len = extractvalue %Range.String %rhs, 1\n  %out.len = add i64 %lhs.len, %rhs.len\n  %out.ptr = call ptr @malloc(i64 %out.len)\n  call void @llvm.memcpy.p0.p0.i64(ptr %out.ptr, ptr %lhs.ptr, i64 %lhs.len, i1 false)\n  %rhs.dest = getelementptr i8, ptr %out.ptr, i64 %lhs.len\n  call void @llvm.memcpy.p0.p0.i64(ptr %rhs.dest, ptr %rhs.ptr, i64 %rhs.len, i1 false)\n  %out0 = insertvalue %Range.String undef, ptr %out.ptr, 0\n  %out1 = insertvalue %Range.String %out0, i64 %out.len, 1\n  ret %Range.String %out1\n}")
}
