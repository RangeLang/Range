construct CodingBehavior {
    @let key: Optional<String>
    @let exclude: Bool
}

@property
@macro(name: "codable", result: "CodingBehavior")(key: Optional<String> = nil, exclude: Bool = false){
    @generic(name: "T")
    target, diagnostics in
    @return(value: CodingBehavior(key: key, exclude: exclude))
}
