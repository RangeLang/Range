@syntax
construct ClosureSyntax {
    @let syntax: WrittenSyntax
    @let description: String
    @let delimiter: String
}

@parameter
@macro(name: "closure", result: "@syntax")(delimiter: String = "\n"){
    @return(value: ClosureSyntax(
        syntax: application.syntax,
        description: application.syntax.description,
        delimiter: delimiter
    ))
}
