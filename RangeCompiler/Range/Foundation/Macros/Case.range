@macro(name: "case", result: "String", target: "@member"){
    @parameter(name: "name") {
        @value(type: "String", current: "String()")
    }
    @parameter(name: "value") {
        @value(type: "String", current: "String()")
    }
    @return(value: "member|kind=case|name="
        + name
        + "|value="
        + value
        + "|ordinal="
        + String(target.ordinal))
}
