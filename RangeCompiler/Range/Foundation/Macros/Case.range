@statement
macro case -> String {
    @parameter(name: "name") {
        @value(type: "String", current: "String()")
    }
    @parameter(name: "value") {
        @value(type: "String", current: "String()")
    }

    target, diagnostics in
    @if(!name.isEmpty) {
        @return(value: "member|kind=case|name="
            + name
            + "|value="
            + value
            + "|ordinal="
            + "\(target.ordinal)")
    }

    @return(value: "statement|kind=case|value="
        + value
        + "|projection=target.declaration.statements")
}
