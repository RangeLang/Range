@member
@macro(name: case, result: @object){
    @parameter(name: name, value: @name)
    @parameter(name: label, value: @name(value: ""))
    @parameter(name: value, value: @generic(value: @void))

    @return(value: @object(type: EnumCase, fields: [
        @field(name: name, value: name),
        @field(name: label, value: label),
        @field(name: value, value: value)
    ]))
}
