@type
@macro(name: float, result: @object, target: @construct){
    @parameter(name: value, value: @literal)
    @generic(name: precision, value: @int(value: 64))
    @state(name: llvmType, value: "precision == \"32\" ? \"float\" : \"double\"")

    @return(value: @object(type: LLVMValue, fields: [
        @field(name: construct, value: "Float"),
        @field(name: type, value: llvmType),
        @field(name: operand, value: value),
        @field(name: precision, value: precision),
        @field(name: storage, value: "immediate"),
        @field(name: needsTrunc, value: "false"),
        @field(name: returnCast, value: "fptosi"),
        @field(name: prelude, value: "")
    ]))
}
