macro float(): Construct -> String {
    state precision: String("64")
    state hasPrecision: false

    for generic in declaration.generics {
        let name: String(generic.identifier.name)

        @if(name == "precision") {
            hasPrecision: true
            precision: generic.value
        }
    }

    @if(declaration.generics.count > 0 && !hasPrecision) {
        diagnostics.error("@float requires a value generic named precision.")
    }

    @if(precision == "32") {
        @return(value: "float")
    }

    @return(value: "double")
}
