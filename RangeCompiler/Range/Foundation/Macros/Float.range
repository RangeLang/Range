@construct
@macro(name: "float", result: "String"){
    @state(name: "precision", value: "String(\"64\")")
    @state(name: "hasPrecision", value: "Bool(false)")
    @state(name: "index", value: "Int(0)")

    @while("index < declaration.generics.count") {
        @let(name: "generic", value: "declaration.generics.element(index: index)")
        @let(name: "name", value: "generic.identifier.name")

        @if("name == \"precision\"") {
            @assignment(target: "hasPrecision", value: "Bool(true)")
            @assignment(target: "precision", value: "generic.value")
        }

        @assignment(target: "index", value: "index + Int(1)")
    }

    @if("declaration.generics.count > Int(0) && !hasPrecision") {
        diagnostics.error("@float requires a value generic named precision.")
    }

    @if("precision == \"32\"") {
        @return(value: "float")
    }

    @return(value: "double")
}
