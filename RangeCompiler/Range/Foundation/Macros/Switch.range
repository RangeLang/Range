@statement
@macro(name: "switch", result: "String"){
    @parameter(name: "value") {
        @value(type: "String", current: "String()")
    }
    @state(name: "bodyText", value: "@statement.bodyText")
    @state(name: "children", value: "String(\"\")")

    @if(!bodyText.isEmpty) {
        children: "\n" + bodyText
    }

    @return(value: "statement|kind=switch|value="
        + value
        + "|projection="
        + @statement.projection
        + children)
}
