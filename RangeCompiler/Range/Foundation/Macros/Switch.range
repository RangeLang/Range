@macro(name: "switch", result: "String", target: "@statement"){
    @parameter(name: "value") {
        @value(type: "String", current: "String()")
    }
    @state(name: "bodyText", value: "target.declaration.bodyText")
    @state(name: "children", value: "String(\"\")")

    @if("!bodyText.isEmpty") {
        @assignment(target: "children", value: "\"\\n\" + bodyText")
    }

    @return(value: "statement|kind=switch|value="
        + value
        + "|projection="
        + "target.declaration.statements"
        + children)
}
