macro encodeProperty(container: KeyedEncodingContainer, value: Identifier, key: String) -> Switch {
    switch container.encode(#(value), key: key) {
    case .success:
        break
    case .failure(let error):
        return .failure(cause: error)
    }
}

macro encodeBody(container: KeyedEncodingContainer, properties: Array<Let>) -> Array<Switch> {
    #(properties.map { property in
        let codingMacros: Array<Macro.Application>(
            property.macros.filter { application in
            application.identifier.name == "codable"
            }
        )
        let behaviors: Array<CodingBehavior>(
            codingMacros.map { application in
            application.value
            }
        )
        let keys: Array<String>(
            behaviors.map { behavior in
            behavior.key ?? property.identifier.name
            }
        )
        let key: keys.first(default: property.identifier.name)

        @encodeProperty(
            container: container,
            value: property.identifier,
            key: key
        )
    })
}

macro decodeProperty(container: KeyedDecodingContainer, type: TypeReference, value: Identifier, key: String) -> Switch {
    switch container.decode(#(type).self, key: key) {
    case .success(let #(value)):
        state self.#(value): #(value)
    case .failure(let error):
        return .failure(cause: error)
    }
}

macro decodeBody(container: KeyedDecodingContainer, properties: Array<Let>) -> Array<Switch> {
    #(properties.map { property in
        let codingMacros: Array<Macro.Application>(
            property.macros.filter { application in
            application.identifier.name == "codable"
            }
        )
        let behaviors: Array<CodingBehavior>(
            codingMacros.map { application in
            application.value
            }
        )
        let keys: Array<String>(
            behaviors.map { behavior in
            behavior.key ?? property.identifier.name
            }
        )
        let key: keys.first(default: property.identifier.name)

        @decodeProperty(
            container: container,
            type: property.type,
            value: property.identifier,
            key: key
        )
    })
}

macro codable<let shape: CodingShape = .object>(): @construct { target, diagnostics in
    if shape != .object {
        diagnostics.error("@codable currently supports object coding only.")
    }

    let properties: Array<Let>(
        target.declaration.lets.filter { property in
            let codingMacros: Array<Macro.Application>(
                property.macros.filter { application in
                application.identifier.name == "codable"
                }
            )
            let behaviors: Array<CodingBehavior>(
                codingMacros.map { application in
                application.value
                }
            )
            let excluded: Array<CodingBehavior>(
                behaviors.filter { behavior in
                behavior.exclude
                }
            )
            return excluded.count == 0
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            function encode(encoder: Encoder): Result<Void, EncodingError> {
                let container: KeyedEncodingContainer(encoder.keyedContainer())
                @encodeBody(
                    container: container,
                    properties: properties
                )
                return .success(result: Void())
            }

            function decode(decoder: Decoder): Result<Self, DecodingError> {
                let container: KeyedDecodingContainer(decoder.keyedContainer())
                @decodeBody(
                    container: container,
                    properties: properties
                )
                return .success(result: self)
            }
        }
    }
}
