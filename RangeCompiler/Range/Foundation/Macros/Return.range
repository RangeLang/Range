@macro(name: @string("return"), result: @string, target: @statement){
    @parameter(name: @string("value"), value: @string(value: ""))

    @state(name: @string("valueType"), value: "@llvmField(value: value, name: @string(\"type\"))")
    @state(name: @string("llvm"), value: "\"llvm-effect|kind=llvm-terminator|body=\"")

    @if("!valueType.isEmpty") {
        @assignment(target: @string("llvm"), value: "\"llvm-effect|kind=llvm-terminator|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  ret i32 \" + @llvmField(value: value, name: @string(\"operand\"))")
    }

    @if("@llvmField(value: value, name: @string(\"needsTrunc\")) == \"true\"") {
        @state(name: @string("returnOperand"), value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: @string("llvm"), value: "\"llvm-effect|kind=llvm-terminator|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  \" + returnOperand + \" = trunc \" + valueType + \" \" + @llvmField(value: value, name: @string(\"operand\")) + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @return(value: llvm)
}
