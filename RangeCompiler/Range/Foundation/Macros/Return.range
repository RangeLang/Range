@macro(name: return, result: @string, target: @statement){
    @parameter(name: value, value: @string(value: ""))

    @state(name: valueType, value: "@llvmField(value: value, name: @string(\"type\"))")
    @state(name: returnCast, value: "@llvmField(value: value, name: @string(\"returnCast\"))")
    @state(name: llvm, value: "\"llvm-effect|kind=llvm-terminator|body=\"")

    @if("!valueType.isEmpty") {
        @assignment(target: llvm, value: "\"llvm-effect|kind=llvm-terminator|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  ret i32 \" + @llvmField(value: value, name: @string(\"operand\"))")
    }

    @if("@llvmField(value: value, name: @string(\"needsTrunc\")) == \"true\"") {
        @state(name: returnOperand, value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: llvm, value: "\"llvm-effect|kind=llvm-terminator|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  \" + returnOperand + \" = trunc \" + valueType + \" \" + @llvmField(value: value, name: @string(\"operand\")) + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @if("returnCast == \"zext\"") {
        @state(name: returnOperand, value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: llvm, value: "\"llvm-effect|kind=llvm-terminator|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  \" + returnOperand + \" = zext \" + valueType + \" \" + @llvmField(value: value, name: @string(\"operand\")) + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @if("returnCast == \"fptosi\"") {
        @state(name: returnOperand, value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: llvm, value: "\"llvm-effect|kind=llvm-terminator|body=\" + @llvmField(value: value, name: @string(\"prelude\")) + \"  \" + returnOperand + \" = fptosi \" + valueType + \" \" + @llvmField(value: value, name: @string(\"operand\")) + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @return(value: llvm)
}
