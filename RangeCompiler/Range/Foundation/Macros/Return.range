@statement
macro return -> String {
    @parameter(name: "value") {
        @value(type: "String", current: "String()")
    }
    @state(name: "llvm", value: "\"ret \" + value")

    @if(value.isEmpty) {
        llvm: "ret void"
    }

    @if(value.contains(value: "Int(")) {
        @state(name: "suffix", value: "value.segment(index: 1, delimiter: \"Int(\")")
        llvm: "ret i64 " + suffix.segment(index: 0, delimiter: ")")
    }

    @if(value.contains(value: "Bool(true)")) {
        llvm: "ret i1 1"
    }

    @if(value.contains(value: "Bool(false)")) {
        llvm: "ret i1 0"
    }

    @return(value: "statement|kind=return|value="
        + value
        + "|projection="
        + @statement.declarationProjection
        + "|llvm="
        + llvm)
}
