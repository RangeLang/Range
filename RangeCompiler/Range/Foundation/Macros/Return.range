function returnLLVM(value: String): String {
    if value.isEmpty {
        @return(value: "ret void")
    }

    if value.contains(value: "Int(") {
        let suffix: String(value.segment(index: 1, delimiter: "Int("))
        @return(value: "ret i64 " + suffix.segment(index: 0, delimiter: ")"))
    }

    if value.contains(value: "Bool(true)") {
        @return(value: "ret i1 1")
    }

    if value.contains(value: "Bool(false)") {
        @return(value: "ret i1 0")
    }

    @return(value: "ret " + value)
}

@statement
macro return(value: String = "") -> String { target, diagnostics in
    @return(value: "statement|kind=return|value="
        + value
        + "|projection=target.declaration"
        + "|llvm="
        + returnLLVM(value: value))
}
