@macro(name: return, result: @object, target: @statement){
    @parameter(name: value, value: @string(value: ""))

    @state(name: valueType, value: "value.type")
    @state(name: returnCast, value: "value.returnCast")
    @state(name: rawValuePrelude, value: "value.prelude")
    @state(name: valuePrelude, value: "rawValuePrelude.isEmpty ? \"\" : rawValuePrelude + \"\\n\"")
    @state(name: valueOperand, value: "value.operand")
    @state(name: body, value: "\"\"")

    @if("!valueType.isEmpty") {
        @assignment(target: body, value: "valuePrelude + \"  ret i32 \" + valueOperand")
    }

    @if("value.needsTrunc == \"true\"") {
        @state(name: returnOperand, value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: body, value: "valuePrelude + \"  \" + returnOperand + \" = trunc \" + valueType + \" \" + valueOperand + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @if("returnCast == \"zext\"") {
        @state(name: returnOperand, value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: body, value: "valuePrelude + \"  \" + returnOperand + \" = zext \" + valueType + \" \" + valueOperand + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @if("returnCast == \"fptosi\"") {
        @state(name: returnOperand, value: "@temporary(prefix: @string(\"return\"))")
        @assignment(target: body, value: "valuePrelude + \"  \" + returnOperand + \" = fptosi \" + valueType + \" \" + valueOperand + \" to i32\\n  ret i32 \" + returnOperand")
    }

    @return(value: @object(type: LLVMEffect, fields: [
        @field(name: kind, value: "llvm-terminator"),
        @field(name: body, value: body),
        @field(name: binding, value: ""),
        @field(name: type, value: ""),
        @field(name: construct, value: ""),
        @field(name: returnCast, value: "")
    ]))
}
