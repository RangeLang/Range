macro compareOrderingProperty(lhs: T, rhs: T, value: Identifier) -> Array<If> {
    @generic(name: "T")

    if lhs.#(value) < rhs.#(value) {
        @return(value: true)
    }

    if rhs.#(value) < lhs.#(value) {
        @return(value: false)
    }
}

macro comparableBody(lhs: T, rhs: T, properties: Array<Let>) -> Array<@statement> {
    @generic(name: "T")

    #(properties.map { property in
        @compareOrderingProperty(lhs: lhs, rhs: rhs, value: property.identifier)
    })

    @return(value: false)
}

macro comparable(): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self) {
            function ==(lhs: Self, rhs: Self): Bool {
                @equatableBody(
                    lhs: lhs,
                    rhs: rhs,
                    properties: target.declaration.lets
                )
            }

            function <(lhs: Self, rhs: Self): Bool {
                @comparableBody(
                    lhs: lhs,
                    rhs: rhs,
                    properties: target.declaration.lets
                )
            }
        }
    }
}
