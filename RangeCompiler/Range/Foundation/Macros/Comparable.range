@macro(name: "compareOrderingProperty", result: "Array<If>")(lhs: T, rhs: T, value: Identifier){
    @generic(name: "T")

    if lhs.#(value) < rhs.#(value) {
        @return(value: true)
    }

    if rhs.#(value) < lhs.#(value) {
        @return(value: false)
    }
}

@macro(name: "comparableBody", result: "Array<@statement>")(lhs: T, rhs: T, properties: Array<Let>){
    @generic(name: "T")

    #(properties.map { property in
        @compareOrderingProperty(lhs: lhs, rhs: rhs, value: property.identifier)
    })

    @return(value: false)
}

@macro(name: "comparable"): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self) {
            function ==(lhs: Self, rhs: Self): Bool {
                @equatableBody(
                    lhs: lhs,
                    rhs: rhs,
                    properties: target.declaration.lets
                )
            }

            function <(lhs: Self, rhs: Self): Bool {
                @comparableBody(
                    lhs: lhs,
                    rhs: rhs,
                    properties: target.declaration.lets
                )
            }
        }
    }
}
