function forChildStatementRecords(target: Block): String {
    if target.declaration.bodyText.isEmpty {
        @return(value: "")
    }

    @return(value: "\n" + target.declaration.bodyText)
}

@statement
macro for(binding: String = "", sequence: String = "") -> String { target, diagnostics in
    @return(value: "statement|kind=for|binding="
        + binding
        + "|sequence="
        + sequence
        + "|projection=target.declaration.statements"
        + forChildStatementRecords(target: target))
}
