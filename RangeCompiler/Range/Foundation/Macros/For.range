@statement
@macro(name: "for", result: "String"){
    @parameter(name: "binding") {
        @value(type: "String", current: "String()")
    }
    @parameter(name: "sequence") {
        @value(type: "String", current: "String()")
    }
    @state(name: "bodyText", value: "@statement.bodyText")
    @state(name: "children", value: "String(\"\")")

    @if(!bodyText.isEmpty) {
        @set(name: "children", value: "\n" + bodyText)
    }

    @return(value: "statement|kind=for|binding="
        + binding
        + "|sequence="
        + sequence
        + "|projection="
        + @statement.projection
        + children)
}
