@statement
macro for -> String {
    @parameter(name: "binding") {
        @value(type: "String", current: "String()")
    }
    @parameter(name: "sequence") {
        @value(type: "String", current: "String()")
    }
    @state(name: "children", value: "String(\"\")")

    @if(!target.declaration.bodyText.isEmpty) {
        children: "\n" + target.declaration.bodyText
    }

    @return(value: "statement|kind=for|binding="
        + binding
        + "|sequence="
        + sequence
        + "|projection=target.declaration.statements"
        + children)
}
