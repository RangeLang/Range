@macro -> String {
    @parameter(name: "name") {
        @value(type: "String")
    }
    @parameter(name: "result") {
        @value(type: "String")
    }
    @parameter(name: "body") {
        @value(type: "String")
    }

    @return(value: "macro"
        + "|name="
        + name
        + "|result="
        + result
        + "\n"
        + body
    )
}
