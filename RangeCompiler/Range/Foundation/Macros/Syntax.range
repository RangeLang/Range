@syntax
construct SplicedSyntax {
    @let delimiter: String
    @let syntax: WrittenSyntax
    @let description: String
}

macro syntax(body: String): Construct -> String { target, diagnostics, graph in
    return body
}

macro syntaxCapture(@literal @spliced(delimiter: "") syntax: @syntax): Construct { target, diagnostics, graph in
    let splicedParameters: Array<Parameter>(
        target.declaration.parameters.filter { parameter in
            let splicedMacros: Array<Macro>(
                parameter.macros.filter { application in
                    application.identifier.name == "spliced"
                }
            )

            return splicedMacros.count > 0
        }
    )

    target.declaration.expand {
        macro #(target.declaration.identifier)(
            #(splicedParameters)
        ): #(target.declaration.self) { target, diagnostics, graph in
        }

        extension #(target.declaration.self) {
            let description: String
        }
    }
}

macro spliced(delimiter: String = ""): @parameter -> @syntax { target, diagnostics in
    return SplicedSyntax(
        delimiter: delimiter,
        syntax: target.application.syntax,
        description: target.application.syntax.description
    )
}

macro splice(@spliced syntax: @syntax): @syntax { target, diagnostics in
    return syntax
}

macro map<T>(collection: Array<T>, @spliced syntax: @syntax): @syntax { target, diagnostics in
    return syntax
}
