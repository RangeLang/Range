@syntax
construct SplicedSyntax {
    @let delimiter: String
    @let syntax: WrittenSyntax
    @let description: String
}

@macro(name: "syntax", result: "String")(body: String): Construct{ target, diagnostics, graph in
    @return(value: body)
}

@macro(name: "syntaxCapture")(@literal @spliced(delimiter: "") syntax: @syntax): Construct { target, diagnostics, graph in
    @let(
        name: "splicedParameters",
        value: target.declaration.parameters.filter { parameter in
            @let(
                name: "splicedMacros",
                value: parameter.macros.filter { application in
                    application.identifier.name == "spliced"
                }
            )

            @return(value: splicedMacros.count > 0)
        }
    )

    target.declaration.expand {
        macro #(target.declaration.identifier)(
            #(splicedParameters)
        ): #(target.declaration.self) { target, diagnostics, graph in
        }

        extension #(target.declaration.self) {
            let description: String
        }
    }
}

@macro(name: "spliced", result: "@syntax")(delimiter: String = ""): @parameter{ target, diagnostics in
    @return(value: SplicedSyntax(
        delimiter: delimiter,
        syntax: target.application.syntax,
        description: target.application.syntax.description
    ))
}

@macro(name: "splice")(@spliced syntax: @syntax): @syntax { target, diagnostics in
    @return(value: syntax)
}

@macro(name: "map")(collection: Array<T>, @spliced syntax: @syntax): @syntax {
    @generic(name: "T")
    @return(value: syntax)
}
