@macro(name: "state", result: "String", target: "@statement,@member"){
    @parameter(name: "name") {
        @value(type: "String")
    }
    @state(name: "members", value: "String(\"\")")
    @state(name: "index", value: "Int(0)")
    @state(name: "memberBodyText", value: "target.declaration.bodyText")

    @while("index < memberBodyText.count(of: \"\\n\") + Int(1)") {
        @state(
            name: "memberLine",
            value: "memberBodyText.segment(index: index, delimiter: \"\n\")"
        )

        @if("!memberLine.isEmpty") {
            @assignment(target: "members", value: "members + \"\\n\" + memberLine")
        }

        @assignment(target: "index", value: "index + Int(1)")
    }

    @return(value: "member|kind=state|name="
        + name
        + "|ordinal="
        + String(target.ordinal)
        + members)
}
