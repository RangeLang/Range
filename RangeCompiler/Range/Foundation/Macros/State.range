function stateLLVMType(value: String): String {
    if value.contains(value: "Int(") {
        @return(value: "i64")
    }

    if value.contains(value: "Bool(") {
        @return(value: "i1")
    }

    if value.contains(value: "String(") {
        @return(value: "%Range.String")
    }

    @return(value: "")
}

function stateLowering(name: String, value: String, ordinal: String, llvm: String): String {
    @return(value: "member|kind=state|name="
        + name
        + "|value="
        + value
        + "|ordinal="
        + ordinal
        + "|llvm="
        + llvm)
}

@member
macro state(name: String, value: String): @member -> String { target, diagnostics in
    @return(value: stateLowering(
        name: name,
        value: value,
        ordinal: "\(target.ordinal)",
        llvm: stateLLVMType(value: value)
    ))
}
