@macro(name: @string("state"), result: @string, target: @statement) {
    @parameter(name: @string("name"), value: @string(value: ""))
    @parameter(name: @string("value"), value: @string(value: ""))

    @return(value: @string("effect|kind=environment-set|name="
        + name
        + "|value="
        + value))
}
