@macro(name: "extension", result: "String", target: "@syntax"){
    @parameter(name: "name") {
        @value(type: "String")
    }
    @state(name: "members", value: "String(\"\")")
    @state(name: "index", value: "Int(0)")
    @state(name: "source", value: "target.application.rawBodyText")

    @while("index < source.count(of: \"\\n\") + Int(1)") {
        @state(
            name: "line",
            value: "source.segment(index: index, delimiter: \"\n\")"
        )

        @if("!line.isEmpty") {
            @assignment(target: "members", value: "members + \"\\n\" + line")
        }

        @assignment(target: "index", value: "index + Int(1)")
    }

    @return(value: "extension|name="
        + name
        + "|llvm=%Range."
        + name
        + ".extension = type { }"
        + members)
}
