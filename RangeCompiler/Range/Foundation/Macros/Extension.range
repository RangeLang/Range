function extensionLineLLVM(line: String): String {
    if line.contains(value: "|llvm=") {
        return line.segment(index: 1, delimiter: "|llvm=")
    }

    return ""
}

function extensionMembersLowering(source: String): String {
    state output: String("")
    let lineCount: Int(source.count(of: "\n") + 1)
    state index: 0

    while index < lineCount {
        let line: String(source.segment(index: index, delimiter: "\n"))

        if !line.isEmpty {
            output: output + "\n" + line
        }

        index: index + 1
    }

    return output
}

function extensionLowering(name: String, source: String): String {
    return "extension|name="
        + name
        + "|llvm=%Range."
        + name
        + ".extension = type { }"
        + extensionMembersLowering(source: source)
}

macro extension(name: String): @syntax -> String { target, diagnostics in
    return extensionLowering(name: name, source: target.application.rawBodyText)
}
