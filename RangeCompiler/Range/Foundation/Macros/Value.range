@member
@macro(name: "value", result: "String"){
    @parameter(name: "type") {
        @value(type: "String")
    }
    @parameter(name: "current") {
        @value(type: "String", current: "String()")
    }
    @return(value: "member|kind=value|type="
        + type
        + "|current="
        + current
        + "|ordinal="
        + @member.ordinal)
}
