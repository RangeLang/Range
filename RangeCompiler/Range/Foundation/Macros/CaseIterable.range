@macro(name: "caseIterable"): Enum { target, diagnostics in
    @let(
        name: "casesArray",
        value: ArrayExpression(
            type: ArrayTypeReference(element: NamedTypeReference(name: "Self")),
            elements: target.declaration.cases.map { enumCase in
                EnumCaseExpression(
                    type: NamedTypeReference(name: "Self"),
                    identifier: enumCase.identifier
                )
            }
        )
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            function allCases(): Array<Self> {
                @return(value: #(casesArray))
            }
        }
    }
}
