@syntax
@macro(name: "enum", result: "String"){
    @parameter(name: "name") {
        @value(type: "String")
    }
    @state(name: "members", value: "String(\"\")")
    @state(name: "index", value: "0")
    @state(name: "source", value: "@construct.application.rawBodyText")

    @while(index < source.count(of: "\n") + 1) {
        @state(
            name: "line",
            value: "source.segment(index: index, delimiter: \"\n\")"
        )

        @if(!line.isEmpty) {
            @set(name: "members", value: members + "\n" + line)
        }

        @set(name: "index", value: index + 1)
    }

    @return(value: "enum|name=" + name + members)
}
