@type
@macro(name: bool, result: @object, target: @construct){
    @parameter(name: value, value: @literal)
    @state(name: operand, value: "value == \"true\" ? \"1\" : \"0\"")

    @return(value: @object(type: LLVMValue, fields: [
        @field(name: construct, value: "Bool"),
        @field(name: type, value: "i1"),
        @field(name: operand, value: operand),
        @field(name: storage, value: "immediate"),
        @field(name: needsTrunc, value: "false"),
        @field(name: returnCast, value: "zext"),
        @field(name: prelude, value: "")
    ]))
}
