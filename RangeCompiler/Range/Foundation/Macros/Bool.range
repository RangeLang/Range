@type
@macro(name: bool, result: @string, target: @construct){
    @parameter(name: value, value: @literal)
    @state(name: operand, value: "value == \"true\" ? \"1\" : \"0\"")

    @return(value: @string("value|construct=Bool|llvm.type=i1"
        + "|llvm.operand="
        + operand
        + "|llvm.storage=immediate"
        + "|llvm.needsTrunc=false"
        + "|llvm.returnCast=zext"
        + "|llvm.prelude="))
}
