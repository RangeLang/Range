@construct
@macro(name: "integer", result: "String"){
    @state(name: "bits", value: String())
    @state(name: "signedness", value: String())
    @state(name: "hasBits", value: false)
    @state(name: "hasSignedness", value: false)
    @state(name: "index", value: 0)

    @while(index < declaration.generics.count) {
        @let(name: "generic", value: declaration.generics.element(index: index))
        @let(name: "name", value: generic.identifier.name)

        @if(name == "bits") {
            @set(name: "hasBits", value: true)
            @set(name: "bits", value: generic.value)
        }

        @if(name == "signedness") {
            @set(name: "hasSignedness", value: true)
            @set(name: "signedness", value: generic.value)
        }

        @set(name: "index", value: index + 1)
    }

    @if(declaration.generics.count > 0 && !hasBits) {
        diagnostics.error("@integer requires a value generic named bits.")
    }

    @if(declaration.generics.count > 0 && !hasSignedness) {
        diagnostics.error("@integer requires a value generic named signedness.")
    }

    @return(value: String("i" + bits))
}
