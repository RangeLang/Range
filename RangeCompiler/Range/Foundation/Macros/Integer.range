@construct
@macro(name: "integer", result: "String"){
    @parameter(name: "bits") {
        @value(type: "String", current: "64")
    }
    @parameter(name: "signedness") {
        @value(type: "String", current: "signed")
    }

    @return(value: "integer|bits="
        + bits
        + "|signedness="
        + signedness)
}
