open macro integer(): Construct -> String { target, diagnostics in
    let integerName: String(target.declaration.identifier.name.snakeCase)
    state bits: String()
    state signedness: String()
    state hasBits: false
    state hasSignedness: false

    for generic in target.declaration.generics {
        let name: String(generic.identifier.name)

        if name == "bits" {
            hasBits: true
            bits: generic.value
        }

        if name == "signedness" {
            hasSignedness: true
            signedness: generic.value
        }
    }

    if target.declaration.generics.count > 0 && !hasBits {
        diagnostics.error("@integer requires a value generic named bits.")
    }

    if target.declaration.generics.count > 0 && !hasSignedness {
        diagnostics.error("@integer requires a value generic named signedness.")
    }

    return String(integerName + bits)
}
