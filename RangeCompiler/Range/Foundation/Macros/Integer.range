macro integer(): Construct -> String {
    state bits: String()
    state signedness: String()
    state hasBits: false
    state hasSignedness: false

    for generic in declaration.generics {
        let name: String(generic.identifier.name)

        @if(name == "bits") {
            hasBits: true
            bits: generic.value
        }

        @if(name == "signedness") {
            hasSignedness: true
            signedness: generic.value
        }
    }

    @if(declaration.generics.count > 0 && !hasBits) {
        diagnostics.error("@integer requires a value generic named bits.")
    }

    @if(declaration.generics.count > 0 && !hasSignedness) {
        diagnostics.error("@integer requires a value generic named signedness.")
    }

    @return(value: String("i" + bits))
}
