@type
@macro(name: int, result: @string, target: @construct){
    @parameter(name: value, value: @literal)
    @generic(name: bits, value: @int(value: 64))
    @generic(name: signedness, value: signed)

    @return(value: @string("value|construct=Int|llvm.type=i"
        + bits
        + "|llvm.operand="
        + value
        + "|llvm.signedness="
        + signedness
        + "|llvm.storage=immediate"
        + "|llvm.needsTrunc=false"
        + "|llvm.prelude="))
}
