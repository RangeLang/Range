@type
@macro(name: @string("int"), result: @string, target: @construct){
    @parameter(name: @string("value"), value: @literal)
    @parameter(name: @string("bits"), value: @string(value: "64"))
    @parameter(name: @string("signedness"), value: @string(value: "signed"))

    @return(value: @string("value|construct=Int|llvm.type=i"
        + bits
        + "|llvm.operand="
        + value
        + "|llvm.signedness="
        + signedness
        + "|llvm.storage=immediate"
        + "|llvm.needsTrunc=false"
        + "|llvm.prelude="))
}
