@type
@macro(name: @string("int"), result: @string, target: @construct){
    @parameter(name: @string("value"), value: @string(value: ""))
    @parameter(name: @string("bits"), value: @string(value: "64"))
    @parameter(name: @string("signedness"), value: @string(value: "signed"))

    @return(value: @string("llvm-value|type=i"
        + bits
        + "|operand="
        + value
        + "|signedness="
        + signedness
        + "|storage=immediate"
        + "|needsTrunc=false"
        + "|prelude="))
}
