@statement
macro if -> String {
    @parameter(name: "condition") {
        @value(type: "String", current: "true")
    }
    @state(name: "bodyText", value: "@statement.bodyText")
    @state(name: "children", value: "String(\"\")")

    @if(!bodyText.isEmpty) {
        children: "\n" + bodyText
    }

    @return(value: "statement|kind=if|condition="
        + condition
        + "|projection="
        + @statement.projection
        + children)
}
