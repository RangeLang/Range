@macro(name: "if", result: "String", target: "@statement"){
    @parameter(name: "condition") {
        @value(type: "String", current: "true")
    }
    @state(name: "bodyText", value: "target.declaration.bodyText")
    @state(name: "children", value: "String(\"\")")

    @if("!bodyText.isEmpty") {
        @assignment(target: "children", value: "\"\\n\" + bodyText")
    }

    @return(value: "statement|kind=if|condition="
        + condition
        + "|projection="
        + "target.declaration.statements"
        + children)
}
