@statement
macro if(condition: String = "true") -> String { target, diagnostics in
    @state(name: "children", value: "String(\"\")")

    if !target.declaration.bodyText.isEmpty {
        children: "\n" + target.declaration.bodyText
    }

    @return(value: "statement|kind=if|condition="
        + condition
        + "|projection=target.declaration.statements"
        + children)
}
