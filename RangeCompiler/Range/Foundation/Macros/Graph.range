@construct
@macro(name: "graph", result: "Identity")(role: GraphRole){ target, diagnostics in
    @let(
        name: "rewrittenIdentifier",
        value: Identifier(name: "\(target.declaration.identifier.name)\(role == .application ? ".Application" : ".Declaration")")
    )

    target.declaration.replace {
        construct #(rewrittenIdentifier) {
            #(target.declaration.lets)
            #(target.declaration.states)
            #(target.declaration.bindings)
            #(target.declaration.deriveds)
            #(target.declaration.functions)
            #(target.declaration.constructs)
            #(target.declaration.extensions)
        }
    }

    @return(value: "Identity(uuid: UUID(storage: UUIDStorage()))")
}
