macro self() -> GraphIdentity {
    @return(value: context.current)
}

macro self.declaration() -> GraphEntry {
    @return(value: graph.declaration(context.current))
}

macro self.parent() -> Optional<GraphIdentity> {
    @return(value: graph.parent(of: context.current))
}

macro self.members() -> Array<GraphIdentity> {
    @return(value: graph.members(of: context.current))
}
