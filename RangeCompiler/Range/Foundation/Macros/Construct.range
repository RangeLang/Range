function constructLLVMType(line: String): String {
    @if(line.contains(value: "|type=Int")) {
        @return(value: "i64")
    }

    @if(line.contains(value: "|current=Int(")) {
        @return(value: "i64")
    }

    @if(line.contains(value: "|type=Bool")) {
        @return(value: "i1")
    }

    @if(line.contains(value: "|current=Bool(")) {
        @return(value: "i1")
    }

    @if(line.contains(value: "|type=String")) {
        @return(value: "%Range.String")
    }

    @if(line.contains(value: "|current=String(")) {
        @return(value: "%Range.String")
    }

    @return(value: "")
}

macro construct.application.rawBodyText -> String { target, diagnostics in
    @return(value: target.application.rawBodyText)
}

macro construct: @syntax -> String {
    @parameter(name: "name") {
        @value(type: "String")
    }
    @state(name: "fields", value: "String(\"\")")
    @state(name: "members", value: "String(\"\")")
    @state(name: "index", value: "0")
    @state(name: "fieldIndex", value: "0")
    @state(name: "pendingState", value: "String(\"false\")")
    @state(name: "source", value: "@construct.application.rawBodyText")

    @while(index < source.count(of: "\n") + 1) {
        @state(
            name: "line",
            value: "source.segment(index: index, delimiter: \"\n\")"
        )
        @state(name: "lineLLVM", value: "String(\"\")")
        @state(name: "wasPendingState", value: "pendingState")

        @if(line.contains(value: "member|kind=state")) {
            @if(line.contains(value: "|llvm=")) {
                lineLLVM: line.segment(index: 1, delimiter: "|llvm=")
            }

            pendingState: "true"
        }

        @if(wasPendingState == "true") {
            @if(line.contains(value: "member|kind=value")) {
                lineLLVM: constructLLVMType(line: line)
            }

            pendingState: "false"
        }

        @if(!lineLLVM.isEmpty) {
            @if(fieldIndex > 0) {
                fields: fields + ", "
            }

            fields: fields + lineLLVM
            fieldIndex: fieldIndex + 1
        }

        @if(!line.isEmpty) {
            members: members + "\n" + line
        }

        index: index + 1
    }

    @return(value: "construct|name="
        + name
        + "|llvm=%Range."
        + name
        + " = type { "
        + fields
        + " }"
        + members)
}
