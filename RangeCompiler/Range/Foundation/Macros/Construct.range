function constructLLVMType(line: String): String {
    @if("line.contains(value: \"integer|bits=64\")") {
        @return(value: "i64")
    }

    @if("line.contains(value: \"bool\")") {
        @return(value: "i1")
    }

    @if("line.contains(value: \"string\")") {
        @return(value: "%Range.String")
    }

    @if("line.contains(value: \"void\")") {
        @return(value: "")
    }

    @if("line.contains(value: \"|type=Int\")") {
        @return(value: "i64")
    }

    @if("line.contains(value: \"|current=Int(\")") {
        @return(value: "i64")
    }

    @if("line.contains(value: \"|type=Bool\")") {
        @return(value: "i1")
    }

    @if("line.contains(value: \"|current=Bool(\")") {
        @return(value: "i1")
    }

    @if("line.contains(value: \"|type=String\")") {
        @return(value: "%Range.String")
    }

    @if("line.contains(value: \"|current=String(\")") {
        @return(value: "%Range.String")
    }

    @return(value: "")
}

@macro(name: "construct", result: "String", target: "@syntax"){
    @parameter(name: "name") {
        @value(type: "String")
    }
    @state(name: "fields", value: "String(\"\")")
    @state(name: "members", value: "String(\"\")")
    @state(name: "index", value: "Int(0)")
    @state(name: "fieldIndex", value: "Int(0)")
    @state(name: "pendingState", value: "String(\"false\")")
    @state(name: "source", value: "String(\"\")")
    @state(name: "macroIndex", value: "Int(0)")

    @while("macroIndex < target.declaration.macros.count") {
        @state(
            name: "macro",
            value: "target.declaration.macros.element(index: macroIndex)"
        )
        @state(name: "macroRecord", value: "macro.evaluatedStringValue")

        @if("!macroRecord.isEmpty") {
            @if("!source.isEmpty") {
                @assignment(target: "source", value: "source + \"\\n\"")
            }

            @assignment(target: "source", value: "source + macroRecord")
        }

        @assignment(target: "macroIndex", value: "macroIndex + Int(1)")
    }

    @if("!target.application.rawBodyText.isEmpty") {
        @if("!source.isEmpty") {
            @assignment(target: "source", value: "source + \"\\n\"")
        }

        @assignment(target: "source", value: "source + target.application.rawBodyText")
    }

    @while("index < source.count(of: \"\\n\") + Int(1)") {
        @state(
            name: "line",
            value: "source.segment(index: index, delimiter: \"\n\")"
        )
        @state(name: "lineLLVM", value: "String(\"\")")
        @state(name: "wasPendingState", value: "pendingState")

        @if("line.contains(value: \"integer|bits=\")") {
            @assignment(target: "lineLLVM", value: "constructLLVMType(line: line)")
        }

        @if("line.contains(value: \"bool\")") {
            @assignment(target: "lineLLVM", value: "constructLLVMType(line: line)")
        }

        @if("line.contains(value: \"string\")") {
            @assignment(target: "lineLLVM", value: "constructLLVMType(line: line)")
        }

        @if("line.contains(value: \"void\")") {
            @assignment(target: "lineLLVM", value: "constructLLVMType(line: line)")
        }

        @if("line.contains(value: \"|llvm=\")") {
            @assignment(target: "lineLLVM", value: "line.segment(index: Int(1), delimiter: \"|llvm=\")")
        }

        @if("line.contains(value: \"member|kind=state\")") {
            @assignment(target: "pendingState", value: "String(\"true\")")
        }

        @if("wasPendingState == \"true\"") {
            @if("line.contains(value: \"member|kind=value\")") {
                @assignment(target: "lineLLVM", value: "constructLLVMType(line: line)")
            }

            @assignment(target: "pendingState", value: "String(\"false\")")
        }

        @if("!lineLLVM.isEmpty") {
            @if("fieldIndex > Int(0)") {
                @assignment(target: "fields", value: "fields + \", \"")
            }

            @assignment(target: "fields", value: "fields + lineLLVM")
            @assignment(target: "fieldIndex", value: "fieldIndex + Int(1)")
        }

        @if("!line.isEmpty") {
            @assignment(target: "members", value: "members + \"\\n\" + line")
        }

        @assignment(target: "index", value: "index + Int(1)")
    }

    @return(value: "construct|name="
        + name
        + "|llvm=%Range."
        + name
        + " = type { "
        + fields
        + " }"
        + members)
}
