function constructLineLLVM(line: String): String {
    if line.contains(value: "|llvm=") {
        return line.segment(index: 1, delimiter: "|llvm=")
    }

    return ""
}

function constructLLVMFields(source: String): String {
    state output: String("")
    let lineCount: Int(source.count(of: "\n") + 1)
    state index: 0
    state fieldIndex: 0

    while index < lineCount {
        let line: String(source.segment(index: index, delimiter: "\n"))
        let llvm: String(constructLineLLVM(line: line))

        if !llvm.isEmpty {
            if fieldIndex > 0 {
                output: output + ", "
            }

            output: output + llvm
            fieldIndex: fieldIndex + 1
        }

        index: index + 1
    }

    return output
}

function constructMembersLowering(source: String): String {
    state output: String("")
    let lineCount: Int(source.count(of: "\n") + 1)
    state index: 0

    while index < lineCount {
        let line: String(source.segment(index: index, delimiter: "\n"))

        if !line.isEmpty {
            output: output + "\n" + line
        }

        index: index + 1
    }

    return output
}

function constructLowering(name: String, source: String): String {
    return "construct|name="
        + name
        + "|llvm=%Range."
        + name
        + " = type { "
        + constructLLVMFields(source: source)
        + " }"
        + constructMembersLowering(source: source)
}

macro construct(name: String): @syntax -> String { target, diagnostics in
    return constructLowering(name: name, source: target.application.rawBodyText)
}
