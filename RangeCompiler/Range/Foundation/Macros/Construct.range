construct ConstructMember {
    @let text: String
}

construct Construct {
    @let name: String
    @let members: Array<ConstructMember>
}

function constructMembers(source: String): Array<ConstructMember> {
    state members: Array<ConstructMember>([])
    let lineCount: Int(source.count(of: "\n") + 1)
    state index: 0

    while index < lineCount {
        let line: String(source.segment(index: index, delimiter: "\n"))

        if !line.isEmpty {
            members.append(element: ConstructMember(text: line))
        }

        index: index + 1
    }

    return members
}

function construct(name: String, source: String): Construct {
    return Construct(name: name, members: constructMembers(source: source))
}

function constructLowering(declaration: Construct): String {
    return "%Range." + declaration.name + " = type { }"
}

macro construct(name: String): @syntax -> String { target, diagnostics in
    let declaration: Construct(construct(name: name, source: target.application.rawBodyText))
    return constructLowering(declaration: declaration)
}
