macro function(name: String, result: String, body: String = ""): @member -> String { target, diagnostics in
    @state(name: "llvm", value: "String(\"\")")
    @state(name: "records", value: "String(\"\")")
    @state(name: "members", value: "String(\"\")")
    @state(name: "bodyField", value: "body")
    @state(name: "index", value: "0")
    @state(name: "instructionIndex", value: "0")

    if body.contains(value: "statement|") {
        bodyField: "records"
    }

    @while(index < body.count(of: "\n") + 1) {
        @state(name: "line", value: body.segment(index: index, delimiter: "\n"))
        @state(name: "lineLLVM", value: "String(\"\")")

        if line.contains(value: "|llvm=") {
            lineLLVM: line.segment(index: 1, delimiter: "|llvm=")
        }

        if !lineLLVM.isEmpty {
            if instructionIndex > 0 {
                llvm: llvm + "; "
            }

            llvm: llvm + lineLLVM
            instructionIndex: instructionIndex + 1
        }

        if body.contains(value: "statement|") {
            if !line.isEmpty {
                records: records + "\n" + line
            }
        }

        index: index + 1
    }

    index: 0
    @while(index < target.declaration.bodyText.count(of: "\n") + 1) {
        @state(
            name: "memberLine",
            value: target.declaration.bodyText.segment(index: index, delimiter: "\n")
        )

        if !memberLine.isEmpty {
            members: members + "\n" + memberLine
        }

        index: index + 1
    }

    if llvm.isEmpty {
        @return(value: "member|kind=function|name="
            + name
            + "|result="
            + result
            + "|body="
            + bodyField
            + "|ordinal="
            + "\(target.ordinal)"
            + members
            + records)
    }

    @return(value: "member|kind=function|name="
        + name
        + "|result="
        + result
        + "|body="
        + bodyField
        + "|ordinal="
        + "\(target.ordinal)"
        + "|llvm="
        + llvm
        + members
        + records)
}
