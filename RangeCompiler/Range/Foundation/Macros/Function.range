construct FunctionMember {
    @let name: String
    @let result: String
    @let body: String
}

function functionMember(name: String, result: String, body: String): FunctionMember {
    return FunctionMember(name: name, result: result, body: body)
}

function functionLowering(member: FunctionMember): String {
    return "member|kind=function|name="
        + member.name
        + "|result="
        + member.result
        + "|body="
        + member.body
}

macro function(name: String, result: String, body: String): @member -> String { target, diagnostics in
    return String("member|kind=function|name=" + name + "|result=" + result + "|body=" + body)
}
