@type
@macro(name: array, result: @object, target: @construct){
    @generic(name: type, value: @void)
    @parameter(name: elements, value: @literal)

    @return(value: @object(type: ArrayValue, fields: [
        @field(name: construct, value: "Array"),
        @field(name: elementType, value: type),
        @field(name: elements, value: elements),
        @field(name: storage, value: "literal")
    ]))
}
