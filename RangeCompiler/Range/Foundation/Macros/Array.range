@macro(name: "array", result: "String", target: "@syntax,@construct"){
    @state(name: "elementName", value: "String(\"Element\")")
    @state(name: "elementLLVM", value: "String(\"${Element.llvm}\")")
    @state(name: "elementStride", value: "String(\"${Element.stride}\")")
    @state(name: "hasElement", value: "Bool(false)")
    @state(name: "index", value: "Int(0)")

    @while("index < application.generics.count") {
        @let(name: "generic", value: "application.generics.element(index: index)")
        @let(name: "typeName", value: "generic.name")

        @if("!typeName.isEmpty") {
            @assignment(target: "hasElement", value: "Bool(true)")
            @assignment(target: "elementName", value: "typeName")

            @if("!generic.llvm.isEmpty") {
                @assignment(target: "elementLLVM", value: "generic.llvm")
            }
        }

        @assignment(target: "index", value: "index + Int(1)")
    }

    @return(value: "; range.array.generics = Element\n; range.array.elements = Element\n; range.array.lowering = lane-per-element\n; range.array.layout = { ptr, count, capacity }\n; range.array.type = %Range.${Element}Array\n; range.array.element.type = ${Element.llvm}\n; range.array.element.stride = ${Element.stride}\n\n%Range.IntArray = type { ptr, i64, i64 }\n\ndeclare ptr @malloc(i64)\n\ndefine %Range.IntArray @RangeIntArray_empty() {\nentry:\n  %a0 = insertvalue %Range.IntArray undef, ptr null, 0\n  %a1 = insertvalue %Range.IntArray %a0, i64 0, 1\n  %a2 = insertvalue %Range.IntArray %a1, i64 0, 2\n  ret %Range.IntArray %a2\n}\n\ndefine %Range.IntArray @RangeIntArray_withCapacity(i64 %capacity) {\nentry:\n  %bytes = mul i64 %capacity, 8\n  %ptr = call ptr @malloc(i64 %bytes)\n  %a0 = insertvalue %Range.IntArray undef, ptr %ptr, 0\n  %a1 = insertvalue %Range.IntArray %a0, i64 0, 1\n  %a2 = insertvalue %Range.IntArray %a1, i64 %capacity, 2\n  ret %Range.IntArray %a2\n}\n\ndefine %Range.IntArray @RangeIntArray_fromBuffer(ptr %elements, i64 %count) {\nentry:\n  %a0 = insertvalue %Range.IntArray undef, ptr %elements, 0\n  %a1 = insertvalue %Range.IntArray %a0, i64 %count, 1\n  %a2 = insertvalue %Range.IntArray %a1, i64 %count, 2\n  ret %Range.IntArray %a2\n}\n\ndefine i64 @RangeIntArray_count(%Range.IntArray %array) {\nentry:\n  %count = extractvalue %Range.IntArray %array, 1\n  ret i64 %count\n}\n\ndefine i1 @RangeIntArray_isEmpty(%Range.IntArray %array) {\nentry:\n  %count = extractvalue %Range.IntArray %array, 1\n  %empty = icmp eq i64 %count, 0\n  ret i1 %empty\n}\n\ndefine i64 @RangeIntArray_element(%Range.IntArray %array, i64 %index) {\nentry:\n  %ptr = extractvalue %Range.IntArray %array, 0\n  %slot = getelementptr inbounds i64, ptr %ptr, i64 %index\n  %value = load i64, ptr %slot\n  ret i64 %value\n}\n\ndefine %Range.IntArray @RangeIntArray_update(%Range.IntArray %array, i64 %index, i64 %element) {\nentry:\n  %ptr = extractvalue %Range.IntArray %array, 0\n  %slot = getelementptr inbounds i64, ptr %ptr, i64 %index\n  store i64 %element, ptr %slot\n  ret %Range.IntArray %array\n}\n\ndefine %Range.IntArray @RangeIntArray_append(%Range.IntArray %array, i64 %element) {\nentry:\n  %ptr = extractvalue %Range.IntArray %array, 0\n  %count = extractvalue %Range.IntArray %array, 1\n  %slot = getelementptr inbounds i64, ptr %ptr, i64 %count\n  store i64 %element, ptr %slot\n  %next = add i64 %count, 1\n  %updated = insertvalue %Range.IntArray %array, i64 %next, 1\n  ret %Range.IntArray %updated\n}")
}
