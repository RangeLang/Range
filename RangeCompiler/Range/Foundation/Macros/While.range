function whileChildStatementRecords(target: Block): String {
    if target.declaration.bodyText.isEmpty {
        @return(value: "")
    }

    @return(value: "\n" + target.declaration.bodyText)
}

@statement
macro while(condition: String = "true") -> String { target, diagnostics in
    @return(value: "statement|kind=while|condition="
        + condition
        + "|projection=target.declaration.statements"
        + whileChildStatementRecords(target: target))
}
