@macro(name: "while", result: @string, target: @statement){
    @parameter(name: "condition", value: @string(value: "true"))
    @state(name: "bodyText", value: "target.declaration.bodyText")
    @state(name: "children", value: "String(\"\")")

    @if("!bodyText.isEmpty") {
        @assignment(target: "children", value: "\"\\n\" + bodyText")
    }

    @return(value: "statement|kind=while|condition="
        + condition
        + "|projection="
        + "target.declaration.statements"
        + children)
}
