@macro(name: reference, result: @object){
    @parameter(name: name, value: @name)
    @state(name: local, value: "@local(name: name)")
    @state(name: operand, value: "@temporary(prefix: name + @string(\".value\"))")
    @state(name: returnCast, value: "local.returnCast")
    @state(name: needsTrunc, value: "returnCast.isEmpty ? \"true\" : \"false\"")
    @state(name: type, value: "local.type")

    @return(value: @object(type: LLVMValue, fields: [
        @field(name: construct, value: local.construct),
        @field(name: type, value: type),
        @field(name: operand, value: operand),
        @field(name: storage, value: "temporary"),
        @field(name: needsTrunc, value: needsTrunc),
        @field(name: returnCast, value: returnCast),
        @field(name: prelude, value: "  "
            + operand
            + " = load "
            + type
            + ", ptr "
            + local.pointer)
    ]))
}
