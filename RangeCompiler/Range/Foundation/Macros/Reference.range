@macro(name: @string("reference"), result: @string){
    @parameter(name: @string("name"), value: @string(value: ""))
    @state(name: @string("binding"), value: "@llvmBinding(name: name)")
    @state(name: @string("operand"), value: "@temporary(prefix: name + @string(\".value\"))")
    @state(name: @string("returnCast"), value: "@llvmField(value: binding, name: @string(\"returnCast\"))")
    @state(name: @string("needsTrunc"), value: "returnCast.isEmpty ? \"true\" : \"false\"")

    @return(value: @string("value|construct="
        + @llvmField(value: binding, name: @string("construct"))
        + "|llvm.type="
        + @llvmField(value: binding, name: @string("type"))
        + "|llvm.operand="
        + operand
        + "|llvm.storage=temporary"
        + "|llvm.needsTrunc="
        + needsTrunc
        + "|llvm.returnCast="
        + returnCast
        + "|llvm.prelude=  "
        + operand
        + " = load "
        + @llvmField(value: binding, name: @string("type"))
        + ", ptr "
        + @llvmField(value: binding, name: @string("pointer"))))
}
