@macro(name: reference, result: @string){
    @parameter(name: name, value: @name)
    @state(name: binding, value: "@llvmBinding(name: name)")
    @state(name: operand, value: "@temporary(prefix: name + @string(\".value\"))")
    @state(name: returnCast, value: "@llvmField(value: binding, name: @string(\"returnCast\"))")
    @state(name: needsTrunc, value: "returnCast.isEmpty ? \"true\" : \"false\"")

    @return(value: @string("value|construct="
        + @llvmField(value: binding, name: @string("construct"))
        + "|llvm.type="
        + @llvmField(value: binding, name: @string("type"))
        + "|llvm.operand="
        + operand
        + "|llvm.storage=temporary"
        + "|llvm.needsTrunc="
        + needsTrunc
        + "|llvm.returnCast="
        + returnCast
        + "|llvm.prelude=  "
        + operand
        + " = load "
        + @llvmField(value: binding, name: @string("type"))
        + ", ptr "
        + @llvmField(value: binding, name: @string("pointer"))))
}
