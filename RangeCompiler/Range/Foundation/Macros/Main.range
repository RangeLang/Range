@macro(name: "main", result: "String"): @block{
    @let(name: "mainMacros", value: graph.macros(named: declaration.identifier.name))

    @if(mainMacros.count > 1) {
        diagnostics.error("A second @main conflicts with the main block already declared in this Range project.")
    }

    @return(value: llvmMain(body: declaration.body))
}
