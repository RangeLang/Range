@macro(name: "hashProperty", result: "@statement")(hasher: Hasher, value: Identifier){
    hasher.combine(#(value))
}

@macro(name: "hashableBody", result: "Array<@statement>")(hasher: Hasher, properties: Array<Let>){
    #(properties.map { property in
        @hashProperty(hasher: hasher, value: property.identifier)
    })
}

@macro(name: "hash")(algorithm: HashAlgorithm): Construct { target, diagnostics, graph in
    switch algorithm {
    case .sha256:
        target.declaration.expand {
            extension #(target.declaration.self) {
                @access(InternalGraph)
                state hash: SHA256
            }
        }
    }
}

@macro(name: "hashable"): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self) {
            function hash(hasher: Hasher) {
                @hashableBody(
                    hasher: hasher,
                    properties: target.declaration.lets
                )
            }
        }
    }
}
