macro encodeProperty(container: KeyedEncodingContainer, value: Identifier, key: String) -> Switch {
    switch container.encode(#(value), forKey: key) {
    case .success:
        break
    case .failure(let error):
        return .failure(cause: error)
    }
}

macro encodeBody(container: KeyedEncodingContainer, properties: [Let]) -> [Switch] {
    #(properties.map { property in
        let codingKeyMacros: Array<Macro.Application>(
            property.macros.filter { application in
            application.identifier.name == "codingKey"
            }
        )
        let codingKeyValues: Array<String>(
            codingKeyMacros.map { application in
            application.value
            }
        )
        let key: codingKeyValues.first(default: property.identifier.name)

        @encodeProperty(
            container: container,
            value: property.identifier,
            key: key
        )
    })
}

macro decodeProperty(container: KeyedDecodingContainer, type: TypeReference, value: Identifier, key: String) -> Switch {
    switch container.decode(#(type).self, forKey: key) {
    case .success(let #(value)):
        set self.#(value)   #(value)
    case .failure(let error):
        return .failure(cause: error)
    }
}

macro decodeBody(container: KeyedDecodingContainer, properties: [Let]) -> [Switch] {
    #(properties.map { property in
        let codingKeyMacros: Array<Macro.Application>(
            property.macros.filter { application in
            application.identifier.name == "codingKey"
            }
        )
        let codingKeyValues: Array<String>(
            codingKeyMacros.map { application in
            application.value
            }
        )
        let key: codingKeyValues.first(default: property.identifier.name)

        @decodeProperty(
            container: container,
            type: property.type,
            value: property.identifier,
            key: key
        )
    })
}

macro codable<let shape: CodingShape = .object>(): Construct { target, diagnostics in
    if shape != .object {
        diagnostics.error("@codable currently supports object coding only.")
    }

    let properties: [Let](target.declaration.lets)

    target.declaration.expand {
        extension #(target.declaration.self): Codable {
            function encode(to encoder: Encoder): Result<Void, EncodingError> {
                let container: KeyedEncodingContainer(encoder.keyedContainer())
                @encodeBody(
                    container: container,
                    properties: properties
                )
                return .success(result: Void())
            }

            function decode(from decoder: Decoder): Result<Self, DecodingError> {
                let container: KeyedDecodingContainer(decoder.keyedContainer())
                @decodeBody(
                    container: container,
                    properties: properties
                )
                return .success(result: self)
            }
        }
    }
}
