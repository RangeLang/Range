macro assemblyOperand(@spliced(delimiter: " ") syntax: @syntax): AssemblyOperand { target, diagnostics, graph in
    return AssemblyOperand(
        representation: syntax.description,
        symbol: nil
    )
}

macro assemblyInstruction(
    @spliced(delimiter: " ") parts: [@syntax]
): AssemblyInstruction { target, diagnostics, graph in
    let operands: [AssemblyOperand](
        parts.map { part in
            @assemblyOperand(syntax: part)
        }
    )
    let mnemonic: AssemblyOperand(
        operands.first(
            default: AssemblyOperand(
                representation: ""
            )
        )
    )

    return AssemblyInstruction(
        mnemonic: mnemonic,
        operands: operands,
        representation: target.application.syntax.description
    )
}

macro assemblySurface(
    @spliced(delimiter: "\n") lines: [@syntax]
): AssemblySurface { target, diagnostics, graph in
    let instructions: [AssemblyInstruction](
        lines.map { line in
            @assemblyInstruction(parts: line)
        }
    )

    return AssemblySurface(
        instructions: instructions,
        representation: target.application.syntax.description
    )
}

function arm64InstructionShapes(): [AssemblyInstructionShape] {
    return [
        AssemblyInstructionShape(mnemonic: "add", operandCount: 3, resultOperandIndex: 0),
        AssemblyInstructionShape(mnemonic: "sub", operandCount: 3, resultOperandIndex: 0),
        AssemblyInstructionShape(mnemonic: "mul", operandCount: 3, resultOperandIndex: 0),
        AssemblyInstructionShape(mnemonic: "sdiv", operandCount: 3, resultOperandIndex: 0),
        AssemblyInstructionShape(mnemonic: "msub", operandCount: 4, resultOperandIndex: 0),
        AssemblyInstructionShape(mnemonic: "cmp", operandCount: 2, resultOperandIndex: nil),
        AssemblyInstructionShape(mnemonic: "cset", operandCount: 2, resultOperandIndex: 0)
    ]
}

macro validateAssemblySurface(
    targetDeclaration: Function.Declaration,
    assemblyTarget: AssemblyTarget,
    surface: AssemblySurface
): Void { target, diagnostics, graph in
    switch assemblyTarget {
    case .arm64:
        let shapes: [AssemblyInstructionShape](arm64InstructionShapes())

        surface.instructions.forEach { instruction in
            let matchingShapes: [AssemblyInstructionShape](
                shapes.filter { shape in
                    shape.mnemonic == instruction.mnemonic.representation
                }
            )

            if matchingShapes.count == 0 {
                diagnostics.error(
                    "@assembly uses unknown arm64 instruction \(instruction.mnemonic.representation)."
                )
            }

            let shape: AssemblyInstructionShape(
                matchingShapes.first(
                    default: AssemblyInstructionShape(
                        mnemonic: instruction.mnemonic.representation,
                        operandCount: instruction.operands.count,
                        resultOperandIndex: nil
                    )
                )
            )

            if instruction.operands.count != shape.operandCount {
                diagnostics.error(
                    "@assembly instruction \(shape.mnemonic) expects \(shape.operandCount) operands."
                )
            }

            instruction.operands.forEach { operand in
                if operand.representation == "#result" && targetDeclaration.returnType == nil {
                    diagnostics.error(
                        "@assembly references #result, but \(targetDeclaration.identifier.name) has no return type."
                    )
                }

                let matchingParameters: [Parameter.Declaration](
                    targetDeclaration.parameters.filter { parameter in
                        operand.representation == "#\(parameter.identifier.name)"
                            || operand.representation == "#\(parameter.identifier.name).storage"
                    }
                )

                if operand.representation.hasPrefix("#")
                    && operand.representation != "#result"
                    && operand.representation != "#result.storage"
                    && matchingParameters.count == 0 {
                    diagnostics.error(
                        "@assembly references unknown operand \(operand.representation) on \(targetDeclaration.identifier.name)."
                    )
                }
            }
        }
    }
}

macro assembly(
    assemblyTarget: AssemblyTarget,
    @closure representation: @syntax
): Function -> AssemblyLowering { target, diagnostics, graph in
    let surface: AssemblySurface(
        @assemblySurface(lines: representation)
    )

    @validateAssemblySurface(
        targetDeclaration: target.declaration,
        assemblyTarget: assemblyTarget,
        surface: surface
    )

    return AssemblyLowering(
        identifier: target.declaration.identifier,
        parameters: target.declaration.parameters,
        returnType: target.declaration.returnType,
        target: assemblyTarget,
        surface: surface
    )
}
