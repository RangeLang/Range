macro access(_ accessTarget: AccessTarget): Construct { target, diagnostics in
    let accessibleFields: Enum.Declaration(
        self: NamedTypeReference(name: "AccessibleFields"),
        generics: [],
        cases: target.declaration.lets.map { field in
            Enum.Case(identifier: field.identifier, associatedValues: [])
        }
    )
    let accessibleMacros: Enum.Declaration(
        self: NamedTypeReference(name: "AccessibleMacros"),
        generics: [],
        cases: target.declaration.macros.map { macro in
            Enum.Case(identifier: macro.identifier, associatedValues: [])
        }
    )
    let accessibleConstructs: Enum.Declaration(
        self: NamedTypeReference(name: "AccessibleConstructs"),
        generics: [],
        cases: target.declaration.constructs.map { construct in
            Enum.Case(identifier: Identifier(name: construct.name.lastComponent()), associatedValues: [])
        }
    )

    target.declaration.expand {
        extension #(target.declaration.self) {
            #(accessibleFields)
            #(accessibleMacros)
            #(accessibleMacros)
            #(accessibleConstructs)
        }
    }
}
