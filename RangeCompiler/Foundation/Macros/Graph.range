macro GraphDeclaration(): @syntax -> GraphDeclaration { target, diagnostics in
    return GraphDeclaration(
        identity: RangeGraphIdentity(
            id: "",
            kind: "syntax",
            name: ""
        )
    )
}

macro GraphApplication(): @syntax -> GraphApplication { target, diagnostics in
    return GraphApplication(
        identity: RangeGraphIdentity(
            id: "",
            kind: "syntax",
            name: ""
        )
    )
}
