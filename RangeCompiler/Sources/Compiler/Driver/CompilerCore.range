function compilerCoreASTSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreASTSummaryForProgram(program: program)
}

function compilerIntTableCreate(columnCount: Int, estimatedRowCount: Int): CompilerIntTable {
    state capacity: Int(0)
    if columnCount > 0 && estimatedRowCount > 0 {
        capacity: columnCount * estimatedRowCount
    }
    return CompilerIntTable(values: bufferCreateInt(capacity: capacity), columnCount: columnCount)
}

function compilerIntTableAppend(table: CompilerIntTable, value: Int): Int {
    return table.values.append(element: value)
}

function compilerIntTableRowCount(table: CompilerIntTable): Int {
    if table.columnCount <= 0 {
        return 0
    }
    return table.values.count / table.columnCount
}

function compilerIntTableIsComplete(table: CompilerIntTable): Bool {
    if table.columnCount <= 0 {
        return false
    }
    return table.values.count % table.columnCount == 0
}

function compilerIntTableValue(table: CompilerIntTable, row: Int, column: Int): Int {
    let rowCount: Int(compilerIntTableRowCount(table: table))
    if row < 0 || row >= rowCount || column < 0 || column >= table.columnCount {
        return 0 - 1
    }
    return table.values.element(index: row * table.columnCount + column)
}

function compilerIntTableDestroy(table: CompilerIntTable): Int {
    return table.values.destroy()
}
