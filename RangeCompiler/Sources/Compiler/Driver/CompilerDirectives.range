function compilerSourceRequestsBuildPlan(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("rangeBuildPlan"))
}

function compilerSourceRequestsSourceInventory(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerSourceInventory"))
}

function compilerSourceRequestsSourceIdentity(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerSourceIdentity"))
}

function compilerSourceRequestsTypedSyntax(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerTypedSyntax"))
}

function compilerSourceRequestsSyntaxRecipes(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerSyntaxRecipes"))
}

function compilerSourceRequestsMacroSnapshot(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerMacroSnapshot"))
}

function compilerSourceRequestsMacroGraph(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerMacroGraph"))
}

function compilerSourceRequestsMacroSyntaxSnapshot(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerMacroSyntaxSnapshot"))
}

function compilerSourceRequestsPlotter(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerPlotter"))
}

function compilerSourceRequestsSemantics(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerSemantics"))
}

function compilerSourceRequestsMemoryGraph(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerMemoryGraph"))
}

function compilerSourceRequestsMemberRepresentations(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerMemberRepresentations"))
}

function compilerSourceRequestsTypedIR(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerTypedIR"))
}

function compilerSourceRequestsMemoryLLVMText(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerMemoryLLVMText"))
}

function compilerSourceRequestsNativeSourceSetLLVMText(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerNativeSourceSetLLVMText"))
}

function compilerSourceRequestsDevelopmentCompiler(source: String): Bool {
    return hasRangePrefix(
        source: source,
        start: 0,
        prefix: String("compilerNativeSourceSetLLVMText\n// range-development-compiler\n")
    )
}

function compilerSourceRequestsSourceSetLLVMText(source: String): Bool {
    return hasRangePrefix(source: source, start: 0, prefix: String("compilerSourceSetLLVMText"))
}
