construct CompilerV1 {
    let version: Int
}

construct CompilerV1Error {
    let message: String
}

construct CompilerV1SyntaxFacts {
    let isValid: Bool
    let syntax: CompilerV1IdentifiedText
    let edge: CompilerV1Edge
    let before: CompilerValueFingerprint
    let after: CompilerValueFingerprint
    let shapeIdentity: CompilerIdentity
    let shape: CompilerValueFingerprint
    let snapshotStart: Int
    let snapshotEnd: Int
    let recipe: String
}

construct CompilerV1BehaviorDelta {
    let identity: CompilerIdentity
    let input: CompilerValueFingerprint
    let before: CompilerValueFingerprint
    let after: CompilerValueFingerprint
    let snapshot: String
    let compiledOutput: String
}

construct CompilerV1CompiledDelta {
    let identity: CompilerIdentity
    let input: CompilerValueFingerprint
    let before: CompilerValueFingerprint
    let after: CompilerValueFingerprint
    let output: String
}

function compilerV1Load(input: String, before: CompilerValueFingerprint): CompilerV1SourceDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.load.begin"))
    let source: String(readFile(path: input))
    let delta: CompilerV1SourceDelta(compilerV1SourceDelta(path: input, source: source, before: before))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.load.end"))
    return delta
}

function compilerV1NativeBehaviorSnapshot(identity: CompilerIdentity, output: String): String {
    let product: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: identity, tag: 13, text: output))
    return "compilerV1Behavior\tvalid=true\tproduct=\(product.first):\(product.second)\n"
}

function compilerV1SyntaxFactsInvalid(): CompilerV1SyntaxFacts {
    let absent: CompilerValueFingerprint(compilerV1AbsentValue())
    let absentIdentity: CompilerIdentity(compilerV1AbsentIdentity())
    return CompilerV1SyntaxFacts(
        isValid: false,
        syntax: CompilerV1IdentifiedText(identity: absentIdentity, value: String("compilerError\tkind=invalidCompilerV1SyntaxFacts\n")),
        edge: CompilerV1Edge(from: absentIdentity, relationship: absentIdentity, to: absentIdentity),
        before: absent,
        after: absent,
        shapeIdentity: absentIdentity,
        shape: absent,
        snapshotStart: 0,
        snapshotEnd: 0,
        recipe: String("")
    )
}

function compilerV1SyntaxFactsCapture(source: CompilerV1SourceDelta): CompilerV1SyntaxFacts {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.syntaxFacts.begin"))
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source.source.value))
    state captureStatus: Int(compilerTypedDeclarationsCapture(source: source.source.value, tables: tables))
    if captureStatus == 0 {
        captureStatus: compilerTypedSyntaxCaptureMainRoot(source: source.source.value, tables: tables)
    }
    state snapshot: String("")
    state recipe: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        snapshot: String("compilerError\tkind=invalidTypedSyntaxSnapshot\n")
        recipe: String("compilerError\tkind=invalidSyntaxRecipes\n")
    } else {
        snapshot: compilerTypedSyntaxRenderSnapshot(tables: tables)
        if compilerMacroFinalizeApplications(tables: tables) == 0 {
            recipe: compilerSyntaxRecipeRender(tables: tables)
        } else {
            recipe: String("compilerError\tkind=invalidSyntaxRecipes\n")
        }
    }
    let tablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if tablesDestroyStatus != 0 {
        snapshot: String("compilerError\tkind=compilerV1SyntaxFactsOwnershipFailure\n")
        recipe: String("compilerError\tkind=invalidSyntaxRecipes\n")
    }
    let syntax: CompilerV1SyntaxDelta(compilerV1SyntaxDelta(source: source, snapshot: snapshot, before: compilerV1AbsentValue()))
    let shapeIdentity: CompilerIdentity(compilerV1IdentityAppendInt(identity: syntax.syntax.identity, value: 3))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.syntaxFacts.end"))
    return CompilerV1SyntaxFacts(
        isValid: !compilerNativeOutputIsError(output: snapshot) && !compilerNativeOutputIsError(output: recipe),
        syntax: syntax.syntax,
        edge: syntax.edge,
        before: syntax.before,
        after: syntax.after,
        shapeIdentity: shapeIdentity,
        shape: compilerV1ValueFingerprint(identity: shapeIdentity, tag: 12, text: recipe),
        snapshotStart: 0,
        snapshotEnd: stringLength(value: snapshot),
        recipe: recipe
    )
}

function compilerV1SyntaxFactsSnapshot(facts: CompilerV1SyntaxFacts): String {
    return facts.syntax.value.substring(start: facts.snapshotStart, end: facts.snapshotEnd)
}

function compilerV1SyntaxFactsRecipe(facts: CompilerV1SyntaxFacts): String {
    return facts.recipe
}

function compilerV1SyntaxFactsErrorMessage(facts: CompilerV1SyntaxFacts): String {
    let recipe: String(compilerV1SyntaxFactsRecipe(facts: facts))
    if compilerNativeOutputIsError(output: recipe) {
        return recipe
    }
    return compilerV1SyntaxFactsSnapshot(facts: facts)
}

function compilerV1SyntaxFactsEncode(facts: CompilerV1SyntaxFacts): String {
    if facts.snapshotStart != 0 { return facts.syntax.value }
    return "compilerV1SyntaxFacts\tversion=2\tsyntaxIdentityFirst=\(facts.syntax.identity.first)\tsyntaxIdentitySecond=\(facts.syntax.identity.second)\tedgeFromFirst=\(facts.edge.from.first)\tedgeFromSecond=\(facts.edge.from.second)\trelationshipFirst=\(facts.edge.relationship.first)\trelationshipSecond=\(facts.edge.relationship.second)\tsyntaxFirst=\(facts.after.first)\tsyntaxSecond=\(facts.after.second)\tshapeIdentityFirst=\(facts.shapeIdentity.first)\tshapeIdentitySecond=\(facts.shapeIdentity.second)\tshapeFirst=\(facts.shape.first)\tshapeSecond=\(facts.shape.second)\tbytes=\(facts.snapshotEnd - facts.snapshotStart)\trecipeBytes=\(facts.recipe.bytes.count)\n\(facts.syntax.value)\n\(facts.recipe)"
}

function compilerV1SyntaxFactsFieldIsDecimal(source: String, end: Int, ordinal: Int): Bool {
    return compilerBuildPlanIsDecimal(
        value: compilerBuildPlanFieldValue(source: source, start: 0, end: end, ordinal: ordinal)
    )
}

function compilerV1SyntaxFactsFieldInt(source: String, end: Int, ordinal: Int): Int {
    return compilerCoreParseDecimalInt(
        value: compilerBuildPlanFieldValue(source: source, start: 0, end: end, ordinal: ordinal)
    )
}

function compilerV1SyntaxFactsHeaderIsValid(encoded: String, headerEnd: Int): Bool {
    if headerEnd < 0
        || compilerBuildPlanFieldCount(source: encoded, start: 0, end: headerEnd) != 16
        || compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 0) != String("compilerV1SyntaxFacts")
        || compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 1) != String("version=2")
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 2), start: 0, prefix: String("syntaxIdentityFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 3), start: 0, prefix: String("syntaxIdentitySecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 4), start: 0, prefix: String("edgeFromFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 5), start: 0, prefix: String("edgeFromSecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 6), start: 0, prefix: String("relationshipFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 7), start: 0, prefix: String("relationshipSecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 8), start: 0, prefix: String("syntaxFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 9), start: 0, prefix: String("syntaxSecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 10), start: 0, prefix: String("shapeIdentityFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 11), start: 0, prefix: String("shapeIdentitySecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 12), start: 0, prefix: String("shapeFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 13), start: 0, prefix: String("shapeSecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 14), start: 0, prefix: String("bytes="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 15), start: 0, prefix: String("recipeBytes=")) {
        return false
    }
    state ordinal: Int(2)
    while ordinal < 16 {
        if !compilerV1SyntaxFactsFieldIsDecimal(source: encoded, end: headerEnd, ordinal: ordinal) {
            return false
        }
        ordinal: ordinal + 1
    }
    return true
}

function compilerV1SyntaxFactsIdentity(encoded: String, headerEnd: Int, firstOrdinal: Int): CompilerIdentity {
    return CompilerIdentity(
        first: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: firstOrdinal),
        second: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: firstOrdinal + 1)
    )
}

function compilerV1SyntaxFactsFingerprint(encoded: String, headerEnd: Int, firstOrdinal: Int): CompilerValueFingerprint {
    return CompilerValueFingerprint(
        first: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: firstOrdinal),
        second: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: firstOrdinal + 1)
    )
}

function compilerV1SyntaxFactsDecode(encoded: String): CompilerV1SyntaxFacts {
    let headerEnd: Int(stringIndexOf(source: encoded, needle: String("\n"), start: 0))
    if !compilerV1SyntaxFactsHeaderIsValid(encoded: encoded, headerEnd: headerEnd) {
        return compilerV1SyntaxFactsInvalid()
    }
    let snapshotStart: Int(headerEnd + 1)
    let snapshotBytes: Int(compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 14))
    let recipeBytes: Int(compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 15))
    let snapshotEnd: Int(snapshotStart + snapshotBytes)
    if snapshotEnd >= stringLength(value: encoded) {
        return compilerV1SyntaxFactsInvalid()
    }
    let recipeStart: Int(snapshotEnd + 1)
    if recipeStart + recipeBytes != stringLength(value: encoded) {
        return compilerV1SyntaxFactsInvalid()
    }
    let syntaxIdentity: CompilerIdentity(compilerV1SyntaxFactsIdentity(encoded: encoded, headerEnd: headerEnd, firstOrdinal: 2))
    let edgeFrom: CompilerIdentity(compilerV1SyntaxFactsIdentity(encoded: encoded, headerEnd: headerEnd, firstOrdinal: 4))
    let relationship: CompilerIdentity(compilerV1SyntaxFactsIdentity(encoded: encoded, headerEnd: headerEnd, firstOrdinal: 6))
    let syntax: CompilerValueFingerprint(compilerV1SyntaxFactsFingerprint(encoded: encoded, headerEnd: headerEnd, firstOrdinal: 8))
    let shapeIdentity: CompilerIdentity(compilerV1SyntaxFactsIdentity(encoded: encoded, headerEnd: headerEnd, firstOrdinal: 10))
    let shape: CompilerValueFingerprint(compilerV1SyntaxFactsFingerprint(encoded: encoded, headerEnd: headerEnd, firstOrdinal: 12))
    return CompilerV1SyntaxFacts(
        isValid: true,
        syntax: CompilerV1IdentifiedText(identity: syntaxIdentity, value: "\(encoded)"),
        edge: CompilerV1Edge(from: edgeFrom, relationship: relationship, to: syntaxIdentity),
        before: compilerV1AbsentValue(),
        after: syntax,
        shapeIdentity: shapeIdentity,
        shape: shape,
        snapshotStart: snapshotStart,
        snapshotEnd: snapshotEnd,
        recipe: encoded.substring(start: recipeStart, end: stringLength(value: encoded))
    )
}

function compilerV1SyntaxFactsIntegrityIsValid(facts: CompilerV1SyntaxFacts): Bool {
    let snapshot: String(compilerV1SyntaxFactsSnapshot(facts: facts))
    let recipe: String(compilerV1SyntaxFactsRecipe(facts: facts))
    let expectedSyntax: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: facts.syntax.identity, tag: 16, text: snapshot))
    let expectedShapeIdentity: CompilerIdentity(compilerV1IdentityAppendInt(identity: facts.syntax.identity, value: 3))
    let expectedRelationship: CompilerIdentity(compilerV1IdentityForSourceSyntaxRelationship())
    let expectedShape: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: facts.shapeIdentity, tag: 12, text: recipe))
    return facts.isValid
        && facts.edge.to.first == facts.syntax.identity.first
        && facts.edge.to.second == facts.syntax.identity.second
        && facts.edge.relationship.first == expectedRelationship.first
        && facts.edge.relationship.second == expectedRelationship.second
        && facts.shapeIdentity.first == expectedShapeIdentity.first
        && facts.shapeIdentity.second == expectedShapeIdentity.second
        && compilerV1ValueFingerprintEqual(left: facts.after, right: expectedSyntax)
        && compilerV1ValueFingerprintEqual(left: facts.shape, right: expectedShape)
}

function compilerV1SyntaxFactsMatchSource(facts: CompilerV1SyntaxFacts, source: CompilerV1SourceDelta): Bool {
    let expectedSyntaxIdentity: CompilerIdentity(compilerV1IdentityForSyntax(source: source.source.identity))
    return compilerV1SyntaxFactsIntegrityIsValid(facts: facts)
        && facts.syntax.identity.first == expectedSyntaxIdentity.first
        && facts.syntax.identity.second == expectedSyntaxIdentity.second
        && facts.edge.from.first == source.source.identity.first
        && facts.edge.from.second == source.source.identity.second
}

function compilerV1SyntaxBindingEncode(source: CompilerV1SourceDelta, facts: CompilerV1SyntaxFacts): String {
    return "compilerV1SyntaxBinding\tversion=1\tsourceFirst=\(source.after.first)\tsourceSecond=\(source.after.second)\tsyntaxFirst=\(facts.after.first)\tsyntaxSecond=\(facts.after.second)"
}

function compilerV1SyntaxBindingSourceIsValid(binding: String): Bool {
    let count: Int(stringLength(value: binding))
    if count == 0 || stringByteAt(source: binding, index: count - 1) != 10 {
        return false
    }
    let end: Int(count - 1)
    if compilerBuildPlanFieldCount(source: binding, start: 0, end: end) != 6
        || compilerBuildPlanFieldText(source: binding, start: 0, end: end, ordinal: 0) != String("compilerV1SyntaxBinding")
        || compilerBuildPlanFieldText(source: binding, start: 0, end: end, ordinal: 1) != String("version=1") {
        return false
    }
    state ordinal: Int(2)
    while ordinal < 6 {
        if !compilerV1SyntaxFactsFieldIsDecimal(source: binding, end: end, ordinal: ordinal) {
            return false
        }
        ordinal: ordinal + 1
    }
    return true
}

function compilerV1SyntaxBindingMatches(bindingPath: String, sourceFirst: Int, sourceSecond: Int, syntaxFirst: Int, syntaxSecond: Int): Bool {
    if !compilerV1SyntaxBindingSourceIsValid(binding: readFile(path: bindingPath)) { return false }
    return compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 2) == sourceFirst
        && compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 3) == sourceSecond
        && compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 4) == syntaxFirst
        && compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 5) == syntaxSecond
}

function compilerV1Shape(facts: CompilerV1SyntaxFacts, before: CompilerValueFingerprint): CompilerV1ShapeDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.shape.begin"))
    state snapshot: String("compilerError\tkind=invalidCompilerV1SyntaxFacts\n")
    let recipe: String(compilerV1SyntaxFactsRecipe(facts: facts))
    if compilerV1SyntaxFactsIntegrityIsValid(facts: facts) {
        snapshot: recipe
    } else if compilerNativeOutputIsError(output: recipe) {
        snapshot: recipe
    }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.shape.end"))
    return compilerV1ShapeDelta(syntaxIdentity: facts.syntax.identity, snapshot: snapshot, before: before)
}

function compilerV1ShapeOnly(source: CompilerV1SourceDelta, before: CompilerValueFingerprint): CompilerV1ShapeDelta {
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: source))
    return compilerV1Shape(facts: facts, before: before)
}

function compilerV1Behavior(source: CompilerV1SourceDelta, shape: CompilerV1ShapeDelta, before: CompilerValueFingerprint): CompilerV1BehaviorDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.behavior.begin"))
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source.source.value))
    state captureStatus: Int(compilerTypedDeclarationsCapture(source: source.source.value, tables: tables))
    if captureStatus == 0 {
        captureStatus: compilerTypedSyntaxCaptureMainRoot(source: source.source.value, tables: tables)
    }
    state snapshot: String("")
    state compiledOutput: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        snapshot: String("compilerError\tkind=invalidTypedSyntaxSnapshot\n")
        compiledOutput: snapshot
    } else {
        let macroLinkStatus: Int(compilerMacroLink(tables: tables))
        if macroLinkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
            compiledOutput: compilerMacroRenderDiagnostics(tables: tables)
        } else {
            compiledOutput: compilerNativeSourceSetLLVMTextForLinkedTables(source: source.source.value, declarationTables: tables)
        }
        if compilerNativeOutputIsError(output: compiledOutput) {
            snapshot: compiledOutput
        } else {
            snapshot: compilerV1NativeBehaviorSnapshot(identity: source.file.identity, output: compiledOutput)
        }
    }
    let tablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if tablesDestroyStatus != 0 {
        snapshot: String("compilerError\tkind=compilerV1BehaviorOwnershipFailure\n")
        compiledOutput: snapshot
    }
    let identity: CompilerIdentity(compilerV1IdentityAppendInt(identity: shape.shape.identity, value: 4))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.behavior.end"))
    return CompilerV1BehaviorDelta(
        identity: identity,
        input: shape.after,
        before: before,
        after: compilerV1ValueFingerprint(identity: identity, tag: 13, text: snapshot),
        snapshot: snapshot,
        compiledOutput: compiledOutput
    )
}

function compilerV1Compile(shape: CompilerV1ShapeDelta, behavior: CompilerV1BehaviorDelta, before: CompilerValueFingerprint): CompilerV1CompiledDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.compile.begin"))
    let identity: CompilerIdentity(compilerV1IdentityAppendInt(identity: behavior.identity, value: 5))
    if behavior.input.first != shape.after.first
        || behavior.input.second != shape.after.second {
        return CompilerV1CompiledDelta(
            identity: identity,
            input: behavior.after,
            before: before,
            after: compilerV1AbsentValue(),
            output: String("compilerError\tkind=compilerV1BehaviorShapeMismatch\n")
        )
    }
    let output: String("\(behavior.compiledOutput)")
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.compile.end"))
    return CompilerV1CompiledDelta(
        identity: identity,
        input: behavior.after,
        before: before,
        after: compilerV1ValueFingerprint(identity: identity, tag: 14, text: output),
        output: output
    )
}

function compilerV1Report(error: CompilerV1Error): Int {
    print(value: error.message)
    return 65
}

function compilerV1CompiledIdentityForFile(file: CompilerIdentity): CompilerIdentity {
    let source: CompilerIdentity(compilerV1IdentityForSource(file: file))
    let syntax: CompilerIdentity(compilerV1IdentityForSyntax(source: source))
    let shape: CompilerIdentity(compilerV1IdentityAppendInt(identity: syntax, value: 3))
    let behavior: CompilerIdentity(compilerV1IdentityAppendInt(identity: shape, value: 4))
    return compilerV1IdentityAppendInt(identity: behavior, value: 5)
}

function compilerV1CompiledValueMatches(input: String, expectedFirst: Int, expectedSecond: Int, outputPath: String): Int {
    let cachedOutput: String(readFile(path: outputPath))
    let file: CompilerIdentity(compilerV1IdentityForFile(path: input))
    let compiledIdentity: CompilerIdentity(compilerV1CompiledIdentityForFile(file: file))
    let cachedCompiled: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: compiledIdentity, tag: 14, text: cachedOutput))
    state matches: Int(0)
    if cachedCompiled.first == expectedFirst && cachedCompiled.second == expectedSecond {
        matches: 1
    }
    return matches
}

function compilerV1SourceValueMatches(input: String, expectedFirst: Int, expectedSecond: Int): Int {
    let source: String(readFile(path: input))
    let file: CompilerIdentity(compilerV1IdentityForFile(path: input))
    let sourceIdentity: CompilerIdentity(compilerV1IdentityForSource(file: file))
    let current: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: sourceIdentity, tag: 11, text: source))
    state matches: Int(0)
    if current.first == expectedFirst && current.second == expectedSecond {
        matches: 1
    }
    return matches
}

function compilerV1SourceIsEmpty(input: String): Int {
    let source: String(readFile(path: input))
    state isEmpty: Int(0)
    if source == String("") {
        isEmpty: 1
    }
    return isEmpty
}

function compilerV1FileIdentityPart(input: String, part: Int): Int {
    let identity: CompilerIdentity(compilerV1IdentityForFile(path: input))
    state value: Int(identity.first)
    if part == 1 {
        value: identity.second
    }
    return value
}

function compilerV1ExecutionFileMatches(executionPath: String, input: String): Int {
    let fileFirst: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 2))
    let fileSecond: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 3))
    let expectedFileFirst: Int(compilerV1FileIdentityPart(input: input, part: 0))
    let expectedFileSecond: Int(compilerV1FileIdentityPart(input: input, part: 1))
    state matches: Int(1)
    if (fileFirst != 0 || fileSecond != 0)
        && (fileFirst != expectedFileFirst || fileSecond != expectedFileSecond) {
        matches: 0
    }
    return matches
}

function compilerV1ExecutionSourceMatches(executionPath: String, input: String): Int {
    return compilerV1SourceValueMatches(
        input: input,
        expectedFirst: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 4),
        expectedSecond: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 5))
}

function compilerV1ExecutionFieldAtPath(executionPath: String, ordinal: Int): Int {
    let stored: String(readFile(path: executionPath))
    let count: Int(stored.bytes.count)
    state value: Int(0)
    if count != 0 {
        value: compilerV1ExecutionFieldInt(source: stored, end: count - 1, ordinal: ordinal)
    }
    return value
}

function compilerV1ExecutionValueFingerprintAtPath(executionPath: String, firstOrdinal: Int, secondOrdinal: Int): CompilerValueFingerprint {
    let first: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: firstOrdinal))
    let second: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: secondOrdinal))
    return CompilerValueFingerprint(first: first, second: second)
}

function compilerV1ExecutionVersionAtPath(executionPath: String): Int {
    let stored: String(readFile(path: executionPath))
    let count: Int(stored.bytes.count)
    state version: Int(0)
    if count != 0 {
        version: compilerCoreParseDecimalInt(value: compilerBuildPlanFieldValue(source: stored, start: 0, end: count - 1, ordinal: 1))
    }
    return version
}

function compilerV1ExecutionCompiledMatches(executionPath: String, input: String, outputPath: String): Int {
    state firstOrdinal: Int(10)
    state secondOrdinal: Int(11)
    if compilerV1ExecutionVersionAtPath(executionPath: executionPath) == 2 {
        firstOrdinal: 12
        secondOrdinal: 13
    }
    return compilerV1CompiledValueMatches(
        input: input,
        expectedFirst: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: firstOrdinal),
        expectedSecond: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: secondOrdinal),
        outputPath: outputPath)
}

function compilerV1SyntaxDeltaForFacts(facts: CompilerV1SyntaxFacts, before: CompilerValueFingerprint): CompilerV1SyntaxDelta {
    return CompilerV1SyntaxDelta(
        syntax: CompilerV1IdentifiedText(identity: facts.syntax.identity, value: "\(facts.syntax.value)"),
        edge: facts.edge,
        before: before,
        after: facts.after
    )
}

function compilerV1SyntaxExecutionReport(syntax: CompilerV1SyntaxDelta, edgeOperation: String): Int {
    let operation: String(compilerV1ReconciliationOperationName(operation: compilerV1ReconciliationOperation(before: syntax.before, after: syntax.after)))
    print(value: "compilerV1SyntaxExecution\toperation=\(operation)\tedgeOperation=\(edgeOperation)\tbefore=\(syntax.before.first):\(syntax.before.second)\tafter=\(syntax.after.first):\(syntax.after.second)\n")
    return 0
}

function compilerV1ShapeExecutionReport(shape: CompilerV1ShapeDelta, edgeOperation: String): Int {
    let operation: String(compilerV1ReconciliationOperationName(operation: compilerV1ReconciliationOperation(before: shape.before, after: shape.after)))
    print(value: "compilerV1ShapeExecution\toperation=\(operation)\tedgeOperation=\(edgeOperation)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
    return 0
}

function compilerV1ExecutionApply(sourceDelta: CompilerV1SourceDelta, facts: CompilerV1SyntaxFacts, executionPath: String, outputPath: String): Int {
    let priorFileFirst: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 2))
    let priorFileSecond: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 3))
    state syntaxFirstOrdinal: Int(0)
    state syntaxSecondOrdinal: Int(0)
    state shapeFirstOrdinal: Int(6)
    state shapeSecondOrdinal: Int(7)
    state behaviorFirstOrdinal: Int(8)
    state behaviorSecondOrdinal: Int(9)
    state compiledFirstOrdinal: Int(10)
    state compiledSecondOrdinal: Int(11)
    if compilerV1ExecutionVersionAtPath(executionPath: executionPath) == 2 {
        syntaxFirstOrdinal: 6
        syntaxSecondOrdinal: 7
        shapeFirstOrdinal: 8
        shapeSecondOrdinal: 9
        behaviorFirstOrdinal: 10
        behaviorSecondOrdinal: 11
        compiledFirstOrdinal: 12
        compiledSecondOrdinal: 13
    }
    let syntaxBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: syntaxFirstOrdinal, secondOrdinal: syntaxSecondOrdinal))
    let shapeBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: shapeFirstOrdinal, secondOrdinal: shapeSecondOrdinal))
    let behaviorBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: behaviorFirstOrdinal, secondOrdinal: behaviorSecondOrdinal))
    let compiledBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: compiledFirstOrdinal, secondOrdinal: compiledSecondOrdinal))
    if !compilerV1SyntaxFactsMatchSource(facts: facts, source: sourceDelta) {
        return compilerV1Report(error: CompilerV1Error(message: "compilerError\tkind=compilerV1SyntaxFactsSourceMismatch\n"))
    }
    let syntax: CompilerV1SyntaxDelta(compilerV1SyntaxDeltaForFacts(facts: facts, before: syntaxBefore))
    let shape: CompilerV1ShapeDelta(compilerV1Shape(facts: facts, before: shapeBefore))
    if compilerNativeOutputIsError(output: shape.shape.value) {
        return compilerV1Report(error: CompilerV1Error(message: shape.shape.value))
    }
    let behavior: CompilerV1BehaviorDelta(compilerV1Behavior(source: sourceDelta, shape: shape, before: behaviorBefore))
    if compilerNativeOutputIsError(output: behavior.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: behavior.snapshot))
    }
    let compiled: CompilerV1CompiledDelta(compilerV1Compile(shape: shape, behavior: behavior, before: compiledBefore))
    if compilerNativeOutputIsError(output: compiled.output) {
        return compilerV1Report(error: CompilerV1Error(message: compiled.output))
    }
    let outputStatus: Int(writeFile(path: outputPath, text: compiled.output))
    if outputStatus != 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to persist Compiler V1 output at \(outputPath)"))
    }
    let next: CompilerV1Execution(compilerV1ExecutionFromDeltas(source: sourceDelta, syntax: syntax, shape: shape, behavior: behavior, compiled: compiled))
    let executionStatus: Int(writeFile(path: executionPath, text: compilerV1ExecutionEncode(execution: next)))
    if executionStatus != 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to persist Compiler V1 execution at \(executionPath)"))
    }
    let sourceOperation: String(compilerV1ReconciliationOperationName(operation: compilerV1ReconciliationOperation(before: sourceDelta.before, after: sourceDelta.after)))
    if priorFileFirst == 0 && priorFileSecond == 0 {
        print(value: "compilerV1Execution\tstatus=cold\tchanged=1\tsourceOperation=\(sourceOperation)\tedgeOperation=insert\tsourceBefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tsourceAfter=\(sourceDelta.after.first):\(sourceDelta.after.second)\tshapeBefore=\(shape.before.first):\(shape.before.second)\tshapeAfter=\(shape.after.first):\(shape.after.second)\tbehaviorBefore=\(behavior.before.first):\(behavior.before.second)\tbehaviorAfter=\(behavior.after.first):\(behavior.after.second)\tcompiledBefore=\(compiled.before.first):\(compiled.before.second)\tcompiledAfter=\(compiled.after.first):\(compiled.after.second)\n")
        compilerV1SyntaxExecutionReport(syntax: syntax, edgeOperation: String("insert"))
        compilerV1ShapeExecutionReport(shape: shape, edgeOperation: String("insert"))
    } else {
        print(value: "compilerV1Execution\tstatus=updated\tchanged=1\tsourceOperation=\(sourceOperation)\tedgeOperation=reuse\tsourceBefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tsourceAfter=\(sourceDelta.after.first):\(sourceDelta.after.second)\tshapeBefore=\(shape.before.first):\(shape.before.second)\tshapeAfter=\(shape.after.first):\(shape.after.second)\tbehaviorBefore=\(behavior.before.first):\(behavior.before.second)\tbehaviorAfter=\(behavior.after.first):\(behavior.after.second)\tcompiledBefore=\(compiled.before.first):\(compiled.before.second)\tcompiledAfter=\(compiled.after.first):\(compiled.after.second)\n")
        compilerV1SyntaxExecutionReport(syntax: syntax, edgeOperation: String("reuse"))
        compilerV1ShapeExecutionReport(shape: shape, edgeOperation: String("reuse"))
    }
    return 0
}

function compilerV1ExecutionUpdate(input: String, executionPath: String, outputPath: String): Int {
    let sourceBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 4, secondOrdinal: 5))
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: sourceBefore))
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: sourceDelta))
    return compilerV1ExecutionApply(sourceDelta: sourceDelta, facts: facts, executionPath: executionPath, outputPath: outputPath)
}

function rangeCompilerV1ResumeCLI(executionPath: String, input: String, outputPath: String): Int {
    if compilerV1SourceIsEmpty(input: input) == 1 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(input)"))
    }
    if compilerV1ExecutionFileMatches(executionPath: executionPath, input: input) == 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: Compiler V1 execution belongs to a different File identity"))
    }
    if compilerV1ExecutionSourceMatches(executionPath: executionPath, input: input) == 1
        && compilerV1ExecutionCompiledMatches(executionPath: executionPath, input: input, outputPath: outputPath) == 1 {
        print(value: "compilerV1Execution\tstatus=reused\tchanged=0\tsourceOperation=reuse\tedgeOperation=reuse\ncompilerV1SyntaxExecution\toperation=reuse\tedgeOperation=reuse\ncompilerV1ShapeExecution\toperation=reuse\tedgeOperation=reuse\n")
        return 0
    }
    return compilerV1ExecutionUpdate(input: input, executionPath: executionPath, outputPath: outputPath)
}

function rangeCompilerV1ResumeFactsCLI(executionPath: String, bindingPath: String, factsPath: String, input: String, outputPath: String): Int {
    if compilerV1SourceIsEmpty(input: input) == 1 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(input)"))
    }
    if compilerV1ExecutionFileMatches(executionPath: executionPath, input: input) == 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: Compiler V1 execution belongs to a different File identity"))
    }
    let sourceBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 4, secondOrdinal: 5))
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: sourceBefore))
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsDecode(encoded: readFile(path: factsPath)))
    if !compilerV1SyntaxFactsMatchSource(facts: facts, source: sourceDelta)
        || !compilerV1SyntaxBindingMatches(
            bindingPath: bindingPath,
            sourceFirst: sourceDelta.after.first,
            sourceSecond: sourceDelta.after.second,
            syntaxFirst: facts.after.first,
            syntaxSecond: facts.after.second) {
        return compilerV1Report(error: CompilerV1Error(message: "compilerError\tkind=compilerV1SyntaxFactsSourceMismatch\n"))
    }
    if compilerV1ExecutionSourceMatches(executionPath: executionPath, input: input) == 1
        && compilerV1ExecutionCompiledMatches(executionPath: executionPath, input: input, outputPath: outputPath) == 1 {
        print(value: "compilerV1Execution\tstatus=reused\tchanged=0\tsourceOperation=reuse\tedgeOperation=reuse\ncompilerV1SyntaxExecution\toperation=reuse\tedgeOperation=reuse\ncompilerV1ShapeExecution\toperation=reuse\tedgeOperation=reuse\n")
        return 0
    }
    return compilerV1ExecutionApply(sourceDelta: sourceDelta, facts: facts, executionPath: executionPath, outputPath: outputPath)
}

function rangeCompilerV1SyntaxFactsWriteCLI(input: String, outputPath: String): Int {
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: compilerV1AbsentValue()))
    if sourceDelta.source.value == String("") {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(sourceDelta.file.value)"))
    }
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: sourceDelta))
    if !facts.isValid {
        return compilerV1Report(error: CompilerV1Error(message: compilerV1SyntaxFactsErrorMessage(facts: facts)))
    }
    let status: Int(writeFile(path: outputPath, text: compilerV1SyntaxFactsEncode(facts: facts)))
    if status != 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to persist Compiler V1 syntax facts at \(outputPath)"))
    }
    print(value: compilerV1SyntaxBindingEncode(source: sourceDelta, facts: facts))
    return 0
}

function rangeCompilerV1ProjectShapeCLI(factsPath: String): Int {
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsDecode(encoded: readFile(path: factsPath)))
    if !facts.isValid {
        return compilerV1Report(error: CompilerV1Error(message: compilerV1SyntaxFactsErrorMessage(facts: facts)))
    }
    let shape: CompilerV1ShapeDelta(compilerV1Shape(facts: facts, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: shape.shape.value) {
        return compilerV1Report(error: CompilerV1Error(message: shape.shape.value))
    }
    print(value: "compilerV1Shape\tversion=1\tidentity=\(shape.shape.identity.first):\(shape.shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
    print(value: shape.shape.value)
    return 0
}

function rangeCompilerV1ShapeCLI(input: String): Int {
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: compilerV1AbsentValue()))
    let source: String(sourceDelta.source.value)
    if source == String("") {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(sourceDelta.file.value)"))
    }
    let shape: CompilerV1ShapeDelta(compilerV1ShapeOnly(source: sourceDelta, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: shape.shape.value) {
        return compilerV1Report(error: CompilerV1Error(message: shape.shape.value))
    }
    print(value: "compilerV1Shape\tversion=1\tidentity=\(shape.shape.identity.first):\(shape.shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
    print(value: shape.shape.value)
    return 0
}

function rangeCompilerV1CLI(compiler: CompilerV1, input: String, inspect: Bool): Int {
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: compilerV1AbsentValue()))
    let source: String(sourceDelta.source.value)
    if source == String("") {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(sourceDelta.file.value)"))
    }
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: sourceDelta))
    let shape: CompilerV1ShapeDelta(compilerV1Shape(facts: facts, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: shape.shape.value) {
        return compilerV1Report(error: CompilerV1Error(message: shape.shape.value))
    }
    let behavior: CompilerV1BehaviorDelta(compilerV1Behavior(source: sourceDelta, shape: shape, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: behavior.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: behavior.snapshot))
    }
    let artifact: CompilerV1CompiledDelta(compilerV1Compile(shape: shape, behavior: behavior, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: artifact.output) {
        return compilerV1Report(error: CompilerV1Error(message: artifact.output))
    }
    let sourceLength: Int(source.bytes.count)
    let syntaxLength: Int(stringLength(value: compilerV1SyntaxFactsSnapshot(facts: facts)))
    if inspect {
        print(value: "compilerV1\tversion=\(compiler.version)\n")
        print(value: "compilerV1Entity\tkind=file\tidentity=\(sourceDelta.file.identity.first):\(sourceDelta.file.identity.second)\tvalue=\(sourceDelta.file.value)\n")
        print(value: "compilerV1Entity\tkind=source\tidentity=\(sourceDelta.source.identity.first):\(sourceDelta.source.identity.second)\tbefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tafter=\(sourceDelta.after.first):\(sourceDelta.after.second)\tbytes=\(sourceLength)\n")
        print(value: "compilerV1Edge\tfrom=\(sourceDelta.edge.from.first):\(sourceDelta.edge.from.second)\trelationship=\(sourceDelta.edge.relationship.first):\(sourceDelta.edge.relationship.second)\tto=\(sourceDelta.edge.to.first):\(sourceDelta.edge.to.second)\tcardinality=one\n")
        print(value: "compilerV1Delta\tphase=source\tidentity=\(sourceDelta.source.identity.first):\(sourceDelta.source.identity.second)\tbefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tafter=\(sourceDelta.after.first):\(sourceDelta.after.second)\n")
        print(value: "compilerV1Entity\tkind=syntax\tidentity=\(facts.syntax.identity.first):\(facts.syntax.identity.second)\tbefore=\(facts.before.first):\(facts.before.second)\tafter=\(facts.after.first):\(facts.after.second)\tbytes=\(syntaxLength)\n")
        print(value: "compilerV1Edge\tfrom=\(facts.edge.from.first):\(facts.edge.from.second)\trelationship=\(facts.edge.relationship.first):\(facts.edge.relationship.second)\tto=\(facts.edge.to.first):\(facts.edge.to.second)\tcardinality=one\n")
        print(value: "compilerV1Delta\tphase=syntax\tidentity=\(facts.syntax.identity.first):\(facts.syntax.identity.second)\tbefore=\(facts.before.first):\(facts.before.second)\tafter=\(facts.after.first):\(facts.after.second)\n")
        print(value: compilerV1SyntaxFactsSnapshot(facts: facts))
        print(value: "compilerV1Entity\tkind=shape\tidentity=\(shape.shape.identity.first):\(shape.shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\tbytes=\(shape.shape.value.bytes.count)\n")
        print(value: "compilerV1Edge\tfrom=\(shape.edge.from.first):\(shape.edge.from.second)\trelationship=\(shape.edge.relationship.first):\(shape.edge.relationship.second)\tto=\(shape.edge.to.first):\(shape.edge.to.second)\tcardinality=one\n")
        print(value: "compilerV1Delta\tphase=shape\tidentity=\(shape.shape.identity.first):\(shape.shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
        print(value: shape.shape.value)
        print(value: "compilerV1Delta\tphase=behavior\tidentity=\(behavior.identity.first):\(behavior.identity.second)\tinput=\(behavior.input.first):\(behavior.input.second)\tbefore=\(behavior.before.first):\(behavior.before.second)\tafter=\(behavior.after.first):\(behavior.after.second)\n")
        print(value: behavior.snapshot)
        print(value: "compilerV1Delta\tphase=compile\tidentity=\(artifact.identity.first):\(artifact.identity.second)\tinput=\(artifact.input.first):\(artifact.input.second)\tbefore=\(artifact.before.first):\(artifact.before.second)\tafter=\(artifact.after.first):\(artifact.after.second)\n")
    }
    print(value: artifact.output)
    return 0
}
