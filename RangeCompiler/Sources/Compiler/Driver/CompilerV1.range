construct CompilerV1 {
    let version: Int
}

construct CompilerV1Error {
    let message: String
}

construct CompilerV1ShapeDelta {
    let identity: CompilerIdentity
    let before: CompilerValueFingerprint
    let after: CompilerValueFingerprint
    let snapshot: String
}

construct CompilerV1SyntaxFacts {
    let isValid: Bool
    let syntax: CompilerValueFingerprint
    let shapeIdentity: CompilerIdentity
    let shape: CompilerValueFingerprint
    let snapshot: String
    let snapshotStart: Int
}

construct CompilerV1BehaviorDelta {
    let identity: CompilerIdentity
    let input: CompilerValueFingerprint
    let before: CompilerValueFingerprint
    let after: CompilerValueFingerprint
    let snapshot: String
    let compiledOutput: String
}

construct CompilerV1CompiledDelta {
    let identity: CompilerIdentity
    let input: CompilerValueFingerprint
    let before: CompilerValueFingerprint
    let after: CompilerValueFingerprint
    let output: String
}

function compilerV1Load(input: String, before: CompilerValueFingerprint): CompilerV1SourceDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.load.begin"))
    let source: String(readFile(path: input))
    let delta: CompilerV1SourceDelta(compilerV1SourceDelta(path: input, source: source, before: before))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.load.end"))
    return delta
}

function compilerV1NativeBehaviorSnapshot(identity: CompilerIdentity, output: String): String {
    let product: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: identity, tag: 13, text: output))
    return "compilerV1Behavior\tvalid=true\tproduct=\(product.first):\(product.second)\n"
}

function compilerV1SyntaxFactsInvalid(): CompilerV1SyntaxFacts {
    let absent: CompilerValueFingerprint(compilerV1AbsentValue())
    let absentIdentity: CompilerIdentity(compilerV1AbsentIdentity())
    return CompilerV1SyntaxFacts(
        isValid: false,
        syntax: absent,
        shapeIdentity: absentIdentity,
        shape: absent,
        snapshot: String("compilerError\tkind=invalidCompilerV1SyntaxFacts\n"),
        snapshotStart: 0
    )
}

function compilerV1SyntaxFactsCapture(source: CompilerV1SourceDelta): CompilerV1SyntaxFacts {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.syntaxFacts.begin"))
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source.value.source))
    state captureStatus: Int(compilerTypedDeclarationsCapture(source: source.value.source, tables: tables))
    if captureStatus == 0 {
        captureStatus: compilerTypedSyntaxCaptureMainRoot(source: source.value.source, tables: tables)
    }
    state snapshot: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        snapshot: String("compilerError\tkind=invalidTypedSyntaxSnapshot\n")
    } else {
        snapshot: compilerTypedSyntaxRenderSnapshot(tables: tables)
    }
    let tablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if tablesDestroyStatus != 0 {
        snapshot: String("compilerError\tkind=compilerV1SyntaxFactsOwnershipFailure\n")
    }
    let shapeIdentity: CompilerIdentity(compilerV1IdentityAppendInt(identity: source.identity, value: 2))
    let syntaxIdentity: CompilerIdentity(compilerV1IdentityAppendInt(identity: shapeIdentity, value: 15))
    let syntax: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: syntaxIdentity, tag: 16, text: snapshot))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.syntaxFacts.end"))
    return CompilerV1SyntaxFacts(
        isValid: !compilerNativeOutputIsError(output: snapshot),
        syntax: syntax,
        shapeIdentity: shapeIdentity,
        shape: compilerV1ValueFingerprint(identity: shapeIdentity, tag: 12, text: snapshot),
        snapshot: snapshot,
        snapshotStart: 0
    )
}

function compilerV1SyntaxFactsSnapshot(facts: CompilerV1SyntaxFacts): String {
    return facts.snapshot.substring(start: facts.snapshotStart, end: stringLength(value: facts.snapshot))
}

function compilerV1SyntaxFactsEncode(facts: CompilerV1SyntaxFacts): String {
    return "compilerV1SyntaxFacts\tversion=1\tsyntaxFirst=\(facts.syntax.first)\tsyntaxSecond=\(facts.syntax.second)\tshapeIdentityFirst=\(facts.shapeIdentity.first)\tshapeIdentitySecond=\(facts.shapeIdentity.second)\tshapeFirst=\(facts.shape.first)\tshapeSecond=\(facts.shape.second)\tbytes=\(facts.snapshot.bytes.count)\n\(facts.snapshot)"
}

function compilerV1SyntaxFactsFieldIsDecimal(source: String, end: Int, ordinal: Int): Bool {
    return compilerBuildPlanIsDecimal(
        value: compilerBuildPlanFieldValue(source: source, start: 0, end: end, ordinal: ordinal)
    )
}

function compilerV1SyntaxFactsFieldInt(source: String, end: Int, ordinal: Int): Int {
    return compilerCoreParseDecimalInt(
        value: compilerBuildPlanFieldValue(source: source, start: 0, end: end, ordinal: ordinal)
    )
}

function compilerV1SyntaxFactsHeaderIsValid(encoded: String, headerEnd: Int): Bool {
    if headerEnd < 0
        || compilerBuildPlanFieldCount(source: encoded, start: 0, end: headerEnd) != 9
        || compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 0) != String("compilerV1SyntaxFacts")
        || compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 1) != String("version=1")
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 2), start: 0, prefix: String("syntaxFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 3), start: 0, prefix: String("syntaxSecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 4), start: 0, prefix: String("shapeIdentityFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 5), start: 0, prefix: String("shapeIdentitySecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 6), start: 0, prefix: String("shapeFirst="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 7), start: 0, prefix: String("shapeSecond="))
        || !stringHasPrefix(source: compilerBuildPlanFieldText(source: encoded, start: 0, end: headerEnd, ordinal: 8), start: 0, prefix: String("bytes=")) {
        return false
    }
    state ordinal: Int(2)
    while ordinal < 9 {
        if !compilerV1SyntaxFactsFieldIsDecimal(source: encoded, end: headerEnd, ordinal: ordinal) {
            return false
        }
        ordinal: ordinal + 1
    }
    return true
}

function compilerV1SyntaxFactsDecode(encoded: String): CompilerV1SyntaxFacts {
    let headerEnd: Int(stringIndexOf(source: encoded, needle: String("\n"), start: 0))
    if !compilerV1SyntaxFactsHeaderIsValid(encoded: encoded, headerEnd: headerEnd) {
        return compilerV1SyntaxFactsInvalid()
    }
    let snapshotStart: Int(headerEnd + 1)
    let snapshotBytes: Int(compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 8))
    if snapshotBytes != stringLength(value: encoded) - snapshotStart {
        return compilerV1SyntaxFactsInvalid()
    }
    return CompilerV1SyntaxFacts(
        isValid: true,
        syntax: CompilerValueFingerprint(
            first: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 2),
            second: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 3)),
        shapeIdentity: CompilerIdentity(
            first: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 4),
            second: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 5)),
        shape: CompilerValueFingerprint(
            first: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 6),
            second: compilerV1SyntaxFactsFieldInt(source: encoded, end: headerEnd, ordinal: 7)),
        snapshot: "\(encoded)",
        snapshotStart: snapshotStart
    )
}

function compilerV1SyntaxFactsIntegrityIsValid(facts: CompilerV1SyntaxFacts): Bool {
    let expectedSyntaxIdentity: CompilerIdentity(compilerV1IdentityAppendInt(identity: facts.shapeIdentity, value: 15))
    let snapshot: String(compilerV1SyntaxFactsSnapshot(facts: facts))
    let expectedSyntax: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: expectedSyntaxIdentity, tag: 16, text: snapshot))
    let expectedShape: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: facts.shapeIdentity, tag: 12, text: snapshot))
    return facts.isValid
        && compilerV1ValueFingerprintEqual(left: facts.syntax, right: expectedSyntax)
        && compilerV1ValueFingerprintEqual(left: facts.shape, right: expectedShape)
}

function compilerV1SyntaxFactsMatchSource(facts: CompilerV1SyntaxFacts, source: CompilerV1SourceDelta): Bool {
    let expectedShapeIdentity: CompilerIdentity(compilerV1IdentityAppendInt(identity: source.identity, value: 2))
    return compilerV1SyntaxFactsIntegrityIsValid(facts: facts)
        && facts.shapeIdentity.first == expectedShapeIdentity.first
        && facts.shapeIdentity.second == expectedShapeIdentity.second
}

function compilerV1SyntaxBindingEncode(source: CompilerV1SourceDelta, facts: CompilerV1SyntaxFacts): String {
    return "compilerV1SyntaxBinding\tversion=1\tsourceFirst=\(source.after.first)\tsourceSecond=\(source.after.second)\tsyntaxFirst=\(facts.syntax.first)\tsyntaxSecond=\(facts.syntax.second)"
}

function compilerV1SyntaxBindingSourceIsValid(binding: String): Bool {
    let count: Int(stringLength(value: binding))
    if count == 0 || stringByteAt(source: binding, index: count - 1) != 10 {
        return false
    }
    let end: Int(count - 1)
    if compilerBuildPlanFieldCount(source: binding, start: 0, end: end) != 6
        || compilerBuildPlanFieldText(source: binding, start: 0, end: end, ordinal: 0) != String("compilerV1SyntaxBinding")
        || compilerBuildPlanFieldText(source: binding, start: 0, end: end, ordinal: 1) != String("version=1") {
        return false
    }
    state ordinal: Int(2)
    while ordinal < 6 {
        if !compilerV1SyntaxFactsFieldIsDecimal(source: binding, end: end, ordinal: ordinal) {
            return false
        }
        ordinal: ordinal + 1
    }
    return true
}

function compilerV1SyntaxBindingMatches(bindingPath: String, sourceFirst: Int, sourceSecond: Int, syntaxFirst: Int, syntaxSecond: Int): Bool {
    if !compilerV1SyntaxBindingSourceIsValid(binding: readFile(path: bindingPath)) { return false }
    return compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 2) == sourceFirst
        && compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 3) == sourceSecond
        && compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 4) == syntaxFirst
        && compilerV1ExecutionFieldAtPath(executionPath: bindingPath, ordinal: 5) == syntaxSecond
}

function compilerV1Shape(facts: CompilerV1SyntaxFacts, before: CompilerValueFingerprint): CompilerV1ShapeDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.shape.begin"))
    state snapshot: String("compilerError\tkind=invalidCompilerV1SyntaxFacts\n")
    if compilerV1SyntaxFactsIntegrityIsValid(facts: facts) {
        snapshot: compilerV1SyntaxFactsSnapshot(facts: facts)
    }
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.shape.end"))
    return CompilerV1ShapeDelta(
        identity: facts.shapeIdentity,
        before: before,
        after: compilerV1ValueFingerprint(identity: facts.shapeIdentity, tag: 12, text: snapshot),
        snapshot: snapshot
    )
}

function compilerV1ShapeOnly(source: CompilerV1SourceDelta, before: CompilerValueFingerprint): CompilerV1ShapeDelta {
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: source))
    return compilerV1Shape(facts: facts, before: before)
}

function compilerV1Behavior(source: CompilerV1SourceDelta, shape: CompilerV1ShapeDelta, before: CompilerValueFingerprint): CompilerV1BehaviorDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.behavior.begin"))
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source.value.source))
    state captureStatus: Int(compilerTypedDeclarationsCapture(source: source.value.source, tables: tables))
    if captureStatus == 0 {
        captureStatus: compilerTypedSyntaxCaptureMainRoot(source: source.value.source, tables: tables)
    }
    state snapshot: String("")
    state compiledOutput: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        snapshot: String("compilerError\tkind=invalidTypedSyntaxSnapshot\n")
        compiledOutput: snapshot
    } else {
        let macroLinkStatus: Int(compilerMacroLink(tables: tables))
        if macroLinkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
            compiledOutput: compilerMacroRenderDiagnostics(tables: tables)
        } else {
            compiledOutput: compilerNativeSourceSetLLVMTextForLinkedTables(source: source.value.source, declarationTables: tables)
        }
        if compilerNativeOutputIsError(output: compiledOutput) {
            snapshot: compiledOutput
        } else {
            snapshot: compilerV1NativeBehaviorSnapshot(identity: source.identity, output: compiledOutput)
        }
    }
    let tablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if tablesDestroyStatus != 0 {
        snapshot: String("compilerError\tkind=compilerV1BehaviorOwnershipFailure\n")
        compiledOutput: snapshot
    }
    let identity: CompilerIdentity(compilerV1IdentityAppendInt(identity: shape.identity, value: 3))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.behavior.end"))
    return CompilerV1BehaviorDelta(
        identity: identity,
        input: shape.after,
        before: before,
        after: compilerV1ValueFingerprint(identity: identity, tag: 13, text: snapshot),
        snapshot: snapshot,
        compiledOutput: compiledOutput
    )
}

function compilerV1Compile(shape: CompilerV1ShapeDelta, behavior: CompilerV1BehaviorDelta, before: CompilerValueFingerprint): CompilerV1CompiledDelta {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.compile.begin"))
    let identity: CompilerIdentity(compilerV1IdentityAppendInt(identity: behavior.identity, value: 4))
    if behavior.input.first != shape.after.first
        || behavior.input.second != shape.after.second {
        return CompilerV1CompiledDelta(
            identity: identity,
            input: behavior.after,
            before: before,
            after: compilerV1AbsentValue(),
            output: String("compilerError\tkind=compilerV1BehaviorShapeMismatch\n")
        )
    }
    let output: String("\(behavior.compiledOutput)")
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("compilerV1.compile.end"))
    return CompilerV1CompiledDelta(
        identity: identity,
        input: behavior.after,
        before: before,
        after: compilerV1ValueFingerprint(identity: identity, tag: 14, text: output),
        output: output
    )
}

function compilerV1Report(error: CompilerV1Error): Int {
    print(value: error.message)
    return 65
}

function compilerV1CompiledIdentityForFile(file: CompilerIdentity): CompilerIdentity {
    let shape: CompilerIdentity(compilerV1IdentityAppendInt(identity: file, value: 2))
    let behavior: CompilerIdentity(compilerV1IdentityAppendInt(identity: shape, value: 3))
    return compilerV1IdentityAppendInt(identity: behavior, value: 4)
}

function compilerV1CompiledValueMatches(input: String, expectedFirst: Int, expectedSecond: Int, outputPath: String): Int {
    let cachedOutput: String(readFile(path: outputPath))
    let file: CompilerIdentity(compilerV1IdentityForFile(path: input))
    let compiledIdentity: CompilerIdentity(compilerV1CompiledIdentityForFile(file: file))
    let cachedCompiled: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: compiledIdentity, tag: 14, text: cachedOutput))
    state matches: Int(0)
    if cachedCompiled.first == expectedFirst && cachedCompiled.second == expectedSecond {
        matches: 1
    }
    return matches
}

function compilerV1SourceValueMatches(input: String, expectedFirst: Int, expectedSecond: Int): Int {
    let source: String(readFile(path: input))
    let file: CompilerIdentity(compilerV1IdentityForFile(path: input))
    let current: CompilerValueFingerprint(compilerV1ValueFingerprint(identity: file, tag: 11, text: source))
    state matches: Int(0)
    if current.first == expectedFirst && current.second == expectedSecond {
        matches: 1
    }
    return matches
}

function compilerV1SourceIsEmpty(input: String): Int {
    let source: String(readFile(path: input))
    state isEmpty: Int(0)
    if source == String("") {
        isEmpty: 1
    }
    return isEmpty
}

function compilerV1FileIdentityPart(input: String, part: Int): Int {
    let identity: CompilerIdentity(compilerV1IdentityForFile(path: input))
    state value: Int(identity.first)
    if part == 1 {
        value: identity.second
    }
    return value
}

function compilerV1ExecutionFileMatches(executionPath: String, input: String): Int {
    let fileFirst: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 2))
    let fileSecond: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 3))
    let expectedFileFirst: Int(compilerV1FileIdentityPart(input: input, part: 0))
    let expectedFileSecond: Int(compilerV1FileIdentityPart(input: input, part: 1))
    state matches: Int(1)
    if (fileFirst != 0 || fileSecond != 0)
        && (fileFirst != expectedFileFirst || fileSecond != expectedFileSecond) {
        matches: 0
    }
    return matches
}

function compilerV1ExecutionSourceMatches(executionPath: String, input: String): Int {
    return compilerV1SourceValueMatches(
        input: input,
        expectedFirst: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 4),
        expectedSecond: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 5))
}

function compilerV1ExecutionFieldAtPath(executionPath: String, ordinal: Int): Int {
    let stored: String(readFile(path: executionPath))
    let count: Int(stored.bytes.count)
    state value: Int(0)
    if count != 0 {
        value: compilerV1ExecutionFieldInt(source: stored, end: count - 1, ordinal: ordinal)
    }
    return value
}

function compilerV1ExecutionValueFingerprintAtPath(executionPath: String, firstOrdinal: Int, secondOrdinal: Int): CompilerValueFingerprint {
    let first: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: firstOrdinal))
    let second: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: secondOrdinal))
    return CompilerValueFingerprint(first: first, second: second)
}

function compilerV1ExecutionCompiledMatches(executionPath: String, input: String, outputPath: String): Int {
    return compilerV1CompiledValueMatches(
        input: input,
        expectedFirst: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 10),
        expectedSecond: compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 11),
        outputPath: outputPath)
}

function compilerV1ExecutionApply(sourceDelta: CompilerV1SourceDelta, facts: CompilerV1SyntaxFacts, executionPath: String, outputPath: String): Int {
    let priorFileFirst: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 2))
    let priorFileSecond: Int(compilerV1ExecutionFieldAtPath(executionPath: executionPath, ordinal: 3))
    let shapeBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 6, secondOrdinal: 7))
    let behaviorBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 8, secondOrdinal: 9))
    let compiledBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 10, secondOrdinal: 11))
    if !compilerV1SyntaxFactsMatchSource(facts: facts, source: sourceDelta) {
        return compilerV1Report(error: CompilerV1Error(message: "compilerError\tkind=compilerV1SyntaxFactsSourceMismatch\n"))
    }
    let shape: CompilerV1ShapeDelta(compilerV1Shape(facts: facts, before: shapeBefore))
    if compilerNativeOutputIsError(output: shape.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: shape.snapshot))
    }
    let behavior: CompilerV1BehaviorDelta(compilerV1Behavior(source: sourceDelta, shape: shape, before: behaviorBefore))
    if compilerNativeOutputIsError(output: behavior.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: behavior.snapshot))
    }
    let compiled: CompilerV1CompiledDelta(compilerV1Compile(shape: shape, behavior: behavior, before: compiledBefore))
    if compilerNativeOutputIsError(output: compiled.output) {
        return compilerV1Report(error: CompilerV1Error(message: compiled.output))
    }
    let outputStatus: Int(writeFile(path: outputPath, text: compiled.output))
    if outputStatus != 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to persist Compiler V1 output at \(outputPath)"))
    }
    let next: CompilerV1Execution(compilerV1ExecutionFromDeltas(source: sourceDelta, shape: shape, behavior: behavior, compiled: compiled))
    let executionStatus: Int(writeFile(path: executionPath, text: compilerV1ExecutionEncode(execution: next)))
    if executionStatus != 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to persist Compiler V1 execution at \(executionPath)"))
    }
    if priorFileFirst == 0 && priorFileSecond == 0 {
        print(value: "compilerV1Execution\tstatus=cold\tchanged=1\tsourceBefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tsourceAfter=\(sourceDelta.after.first):\(sourceDelta.after.second)\tshapeBefore=\(shape.before.first):\(shape.before.second)\tshapeAfter=\(shape.after.first):\(shape.after.second)\tbehaviorBefore=\(behavior.before.first):\(behavior.before.second)\tbehaviorAfter=\(behavior.after.first):\(behavior.after.second)\tcompiledBefore=\(compiled.before.first):\(compiled.before.second)\tcompiledAfter=\(compiled.after.first):\(compiled.after.second)\n")
    } else {
        print(value: "compilerV1Execution\tstatus=updated\tchanged=1\tsourceBefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tsourceAfter=\(sourceDelta.after.first):\(sourceDelta.after.second)\tshapeBefore=\(shape.before.first):\(shape.before.second)\tshapeAfter=\(shape.after.first):\(shape.after.second)\tbehaviorBefore=\(behavior.before.first):\(behavior.before.second)\tbehaviorAfter=\(behavior.after.first):\(behavior.after.second)\tcompiledBefore=\(compiled.before.first):\(compiled.before.second)\tcompiledAfter=\(compiled.after.first):\(compiled.after.second)\n")
    }
    return 0
}

function compilerV1ExecutionUpdate(input: String, executionPath: String, outputPath: String): Int {
    let sourceBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 4, secondOrdinal: 5))
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: sourceBefore))
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: sourceDelta))
    return compilerV1ExecutionApply(sourceDelta: sourceDelta, facts: facts, executionPath: executionPath, outputPath: outputPath)
}

function rangeCompilerV1ResumeCLI(executionPath: String, input: String, outputPath: String): Int {
    if compilerV1SourceIsEmpty(input: input) == 1 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(input)"))
    }
    if compilerV1ExecutionFileMatches(executionPath: executionPath, input: input) == 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: Compiler V1 execution belongs to a different File identity"))
    }
    if compilerV1ExecutionSourceMatches(executionPath: executionPath, input: input) == 1
        && compilerV1ExecutionCompiledMatches(executionPath: executionPath, input: input, outputPath: outputPath) == 1 {
        print(value: "compilerV1Execution\tstatus=reused\tchanged=0\n")
        return 0
    }
    return compilerV1ExecutionUpdate(input: input, executionPath: executionPath, outputPath: outputPath)
}

function rangeCompilerV1ResumeFactsCLI(executionPath: String, bindingPath: String, factsPath: String, input: String, outputPath: String): Int {
    if compilerV1SourceIsEmpty(input: input) == 1 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(input)"))
    }
    if compilerV1ExecutionFileMatches(executionPath: executionPath, input: input) == 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: Compiler V1 execution belongs to a different File identity"))
    }
    let sourceBefore: CompilerValueFingerprint(compilerV1ExecutionValueFingerprintAtPath(executionPath: executionPath, firstOrdinal: 4, secondOrdinal: 5))
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: sourceBefore))
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsDecode(encoded: readFile(path: factsPath)))
    if !compilerV1SyntaxFactsMatchSource(facts: facts, source: sourceDelta)
        || !compilerV1SyntaxBindingMatches(
            bindingPath: bindingPath,
            sourceFirst: sourceDelta.after.first,
            sourceSecond: sourceDelta.after.second,
            syntaxFirst: facts.syntax.first,
            syntaxSecond: facts.syntax.second) {
        return compilerV1Report(error: CompilerV1Error(message: "compilerError\tkind=compilerV1SyntaxFactsSourceMismatch\n"))
    }
    if compilerV1ExecutionSourceMatches(executionPath: executionPath, input: input) == 1
        && compilerV1ExecutionCompiledMatches(executionPath: executionPath, input: input, outputPath: outputPath) == 1 {
        print(value: "compilerV1Execution\tstatus=reused\tchanged=0\n")
        return 0
    }
    return compilerV1ExecutionApply(sourceDelta: sourceDelta, facts: facts, executionPath: executionPath, outputPath: outputPath)
}

function rangeCompilerV1SyntaxFactsWriteCLI(input: String, outputPath: String): Int {
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: compilerV1AbsentValue()))
    if sourceDelta.value.source == String("") {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(sourceDelta.value.path)"))
    }
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: sourceDelta))
    if !facts.isValid {
        return compilerV1Report(error: CompilerV1Error(message: compilerV1SyntaxFactsSnapshot(facts: facts)))
    }
    let status: Int(writeFile(path: outputPath, text: compilerV1SyntaxFactsEncode(facts: facts)))
    if status != 0 {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to persist Compiler V1 syntax facts at \(outputPath)"))
    }
    print(value: compilerV1SyntaxBindingEncode(source: sourceDelta, facts: facts))
    return 0
}

function rangeCompilerV1ProjectShapeCLI(factsPath: String): Int {
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsDecode(encoded: readFile(path: factsPath)))
    if !facts.isValid {
        return compilerV1Report(error: CompilerV1Error(message: compilerV1SyntaxFactsSnapshot(facts: facts)))
    }
    let shape: CompilerV1ShapeDelta(compilerV1Shape(facts: facts, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: shape.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: shape.snapshot))
    }
    print(value: "compilerV1Shape\tversion=1\tidentity=\(shape.identity.first):\(shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
    print(value: shape.snapshot)
    return 0
}

function rangeCompilerV1ShapeCLI(input: String): Int {
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: compilerV1AbsentValue()))
    let source: String(sourceDelta.value.source)
    if source == String("") {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(sourceDelta.value.path)"))
    }
    let shape: CompilerV1ShapeDelta(compilerV1ShapeOnly(source: sourceDelta, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: shape.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: shape.snapshot))
    }
    print(value: "compilerV1Shape\tversion=1\tidentity=\(shape.identity.first):\(shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
    print(value: shape.snapshot)
    return 0
}

function rangeCompilerV1CLI(compiler: CompilerV1, input: String, inspect: Bool): Int {
    let sourceDelta: CompilerV1SourceDelta(compilerV1Load(input: input, before: compilerV1AbsentValue()))
    let source: String(sourceDelta.value.source)
    if source == String("") {
        return compilerV1Report(error: CompilerV1Error(message: "range: unable to read non-empty input at \(sourceDelta.value.path)"))
    }
    let facts: CompilerV1SyntaxFacts(compilerV1SyntaxFactsCapture(source: sourceDelta))
    let shape: CompilerV1ShapeDelta(compilerV1Shape(facts: facts, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: shape.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: shape.snapshot))
    }
    let behavior: CompilerV1BehaviorDelta(compilerV1Behavior(source: sourceDelta, shape: shape, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: behavior.snapshot) {
        return compilerV1Report(error: CompilerV1Error(message: behavior.snapshot))
    }
    let artifact: CompilerV1CompiledDelta(compilerV1Compile(shape: shape, behavior: behavior, before: compilerV1AbsentValue()))
    if compilerNativeOutputIsError(output: artifact.output) {
        return compilerV1Report(error: CompilerV1Error(message: artifact.output))
    }
    let sourceLength: Int(source.bytes.count)
    if inspect {
        print(value: "compilerV1\tversion=\(compiler.version)\n")
        print(value: "compilerV1Delta\tphase=source\tidentity=\(sourceDelta.identity.first):\(sourceDelta.identity.second)\tbefore=\(sourceDelta.before.first):\(sourceDelta.before.second)\tafter=\(sourceDelta.after.first):\(sourceDelta.after.second)\tvalue=File\tpath=\(sourceDelta.value.path)\tbytes=\(sourceLength)\n")
        print(value: "compilerV1Delta\tphase=shape\tidentity=\(shape.identity.first):\(shape.identity.second)\tbefore=\(shape.before.first):\(shape.before.second)\tafter=\(shape.after.first):\(shape.after.second)\n")
        print(value: shape.snapshot)
        print(value: "compilerV1Delta\tphase=behavior\tidentity=\(behavior.identity.first):\(behavior.identity.second)\tinput=\(behavior.input.first):\(behavior.input.second)\tbefore=\(behavior.before.first):\(behavior.before.second)\tafter=\(behavior.after.first):\(behavior.after.second)\n")
        print(value: behavior.snapshot)
        print(value: "compilerV1Delta\tphase=compile\tidentity=\(artifact.identity.first):\(artifact.identity.second)\tinput=\(artifact.input.first):\(artifact.input.second)\tbefore=\(artifact.before.first):\(artifact.before.second)\tafter=\(artifact.after.first):\(artifact.after.second)\n")
    }
    print(value: artifact.output)
    return 0
}
