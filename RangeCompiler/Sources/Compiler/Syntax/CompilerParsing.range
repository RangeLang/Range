function compilerTypedSyntaxLocalText(tables: CompilerSyntaxTables, fileID: Int, localStart: Int, localEnd: Int): String {
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localStart))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localEnd))
    if globalStart < 0 || globalEnd < globalStart
        || fileID < 0 || fileID >= compilerSourceStoreFileCount(store: tables.sourceStore)
        || globalEnd > compilerSourceStoreFileContentEnd(store: tables.sourceStore, fileID: fileID) {
        return String("")
    }
    return stringSliceUnchecked(source: tables.sourceStore.source, start: globalStart, end: globalEnd)
}

function compilerTypedSyntaxRenderRawTable(name: String, table: CompilerIntTable): String {
    let rawOutputBuffer: RawBuffer(rawBufferCreate(capacity: 2048, stride: 1))
    let rawTab: String(compilerCoreTabCharacter())
    let rawNewline: String(compilerCoreNewlineCharacter())
    let rawRowCount: Int(compilerIntTableRowCount(table: table))
    rawBufferAppendText(buffer: rawOutputBuffer, text: "typedTable\(rawTab)name=\(name)\(rawTab)version=1\(rawTab)columns=\(table.columnCount)\(rawTab)rows=\(rawRowCount)\(rawNewline)")
    state rawRow: Int(0)
    while rawRow < rawRowCount {
        rawBufferAppendText(buffer: rawOutputBuffer, text: "\(name)\(rawTab)row=\(rawRow)\(rawTab)values=")
        state rawColumn: Int(0)
        while rawColumn < table.columnCount {
            if rawColumn > 0 { rawBufferAppendText(buffer: rawOutputBuffer, text: String(",")) }
            rawBufferAppendText(buffer: rawOutputBuffer, text: "\(compilerIntTableValue(table: table, row: rawRow, column: rawColumn))")
            rawColumn: rawColumn + 1
        }
        rawBufferAppendText(buffer: rawOutputBuffer, text: rawNewline)
        rawRow: rawRow + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: rawOutputBuffer)
}

function compilerTypedSyntaxRenderSnapshot(tables: CompilerSyntaxTables): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 8192, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    let memberCount: Int(compilerIntTableRowCount(table: tables.members))
    let functionCount: Int(compilerIntTableRowCount(table: tables.functions))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
    let genericParameterCount: Int(compilerIntTableRowCount(table: tables.genericParameters))
    let typeReferenceCount: Int(compilerIntTableRowCount(table: tables.typeReferences))
    let bodyNodeCount: Int(compilerIntTableRowCount(table: tables.bodyNodes))
    let bodyEdgeCount: Int(compilerIntTableRowCount(table: tables.bodyEdges))
    rawBufferAppendText(buffer: outputBuffer, text: "typedSyntax\(tab)valid=true\(tab)identityScope=pathStable,pathlessSnapshotLocal\(tab)fileCount=\(compilerSourceStoreFileCount(store: tables.sourceStore))\(tab)syntaxCount=\(syntaxCount)\(tab)declarationCount=\(declarationCount)\(tab)memberCount=\(memberCount)\(tab)functionCount=\(functionCount)\(tab)parameterCount=\(parameterCount)\(tab)genericParameterCount=\(genericParameterCount)\(tab)typeReferenceCount=\(typeReferenceCount)\(tab)bodyNodeCount=\(bodyNodeCount)\(tab)bodyEdgeCount=\(bodyEdgeCount)\(newline)")

    state row: Int(0)
    while row < syntaxCount {
        let syntaxKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: row, column: 0))
        let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: row, column: 1))
        rawBufferAppendText(buffer: outputBuffer, text: "syntax\(tab)id=\(row)\(tab)kind=\(compilerSyntaxKindName(kindTag: syntaxKindTag))\(tab)facetRow=\(facetRow)\(newline)")
        row: row + 1
    }

    row: 0
    while row < declarationCount {
        let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 0))
        let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
        let declarationKindTag: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 2))
        let declarationOrdinal: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 4))
        let declarationStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 5))
        let declarationEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 6))
        let declarationNameStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 7))
        let declarationNameEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 8))
        let declarationBodyStart: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 9))
        let declarationBodyEnd: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 10))
        let declarationFingerprintFirst: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 11))
        let declarationFingerprintSecond: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 12))
        let declarationBuiltinABI: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 13))
        let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: declarationNameStart, localEnd: declarationNameEnd))
        rawBufferAppendText(buffer: outputBuffer, text: "declaration\(tab)row=\(row)\(tab)syntaxID=\(declarationSyntaxID)\(tab)fileID=\(declarationFileID)\(tab)kind=\(compilerSyntaxKindName(kindTag: declarationKindTag))\(tab)ordinal=\(declarationOrdinal)\(tab)start=\(declarationStart)\(tab)end=\(declarationEnd)\(tab)name=\(declarationName)\(tab)nameStart=\(declarationNameStart)\(tab)nameEnd=\(declarationNameEnd)\(tab)bodyStart=\(declarationBodyStart)\(tab)bodyEnd=\(declarationBodyEnd)\(tab)fingerprint=\(declarationFingerprintFirst):\(declarationFingerprintSecond)\(tab)builtinABI=\(declarationBuiltinABI)\(newline)")
        row: row + 1
    }

    row: 0
    while row < memberCount {
        let memberSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 0))
        let memberFileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 2))
        let memberOrdinal: Int(compilerIntTableValue(table: tables.members, row: row, column: 3))
        let memberStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 4))
        let memberEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 5))
        let memberNameStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 6))
        let memberNameEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 7))
        let memberTypeStart: Int(compilerIntTableValue(table: tables.members, row: row, column: 8))
        let memberTypeEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: 9))
        let memberFingerprintFirst: Int(compilerIntTableValue(table: tables.members, row: row, column: 10))
        let memberFingerprintSecond: Int(compilerIntTableValue(table: tables.members, row: row, column: 11))
        let memberKind: Int(compilerIntTableValue(table: tables.members, row: row, column: 12))
        let memberStoragePolicy: Int(compilerIntTableValue(table: tables.members, row: row, column: 13))
        let memberTypeTargetKind: Int(compilerIntTableValue(table: tables.members, row: row, column: 14))
        let memberTypeTargetID: Int(compilerIntTableValue(table: tables.members, row: row, column: 15))
        let memberValueStart: Int(compilerIntTableValue(table: tables.members, row: row, column: compilerSyntaxMemberValueStartColumn()))
        let memberValueEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: compilerSyntaxMemberValueEndColumn()))
        let memberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberNameStart, localEnd: memberNameEnd))
        let memberTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberTypeStart, localEnd: memberTypeEnd))
        state memberValue: String("")
        if memberValueStart >= 0 && memberValueEnd > memberValueStart {
            memberValue: compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: memberValueStart, localEnd: memberValueEnd)
        }
        rawBufferAppendText(buffer: outputBuffer, text: "member\(tab)row=\(row)\(tab)syntaxID=\(memberSyntaxID)\(tab)fileID=\(memberFileID)\(tab)parentSyntaxID=\(parentSyntaxID)\(tab)ordinal=\(memberOrdinal)\(tab)start=\(memberStart)\(tab)end=\(memberEnd)\(tab)name=\(memberName)\(tab)nameStart=\(memberNameStart)\(tab)nameEnd=\(memberNameEnd)\(tab)type=\(memberTypeName)\(tab)typeStart=\(memberTypeStart)\(tab)typeEnd=\(memberTypeEnd)\(tab)value=\(memberValue)\(tab)valueStart=\(memberValueStart)\(tab)valueEnd=\(memberValueEnd)\(tab)kind=\(compilerSyntaxMemberKindName(kindTag: memberKind))\(tab)storage=\(compilerSyntaxMemberStorageName(storagePolicy: memberStoragePolicy))\(tab)typeTargetKind=\(compilerSyntaxTypeTargetKindName(kind: memberTypeTargetKind))\(tab)typeTargetID=\(memberTypeTargetID)\(tab)fingerprint=\(memberFingerprintFirst):\(memberFingerprintSecond)\(newline)")
        row: row + 1
    }

    row: 0
    while row < functionCount {
        let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 0))
        let functionFileID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 1))
        let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: row, column: 2))
        let childCount: Int(compilerIntTableValue(table: tables.functions, row: row, column: 3))
        let parameterStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 4))
        let parameterEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 5))
        let returnStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 6))
        let returnEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 7))
        let functionBodyStart: Int(compilerIntTableValue(table: tables.functions, row: row, column: 8))
        let functionBodyEnd: Int(compilerIntTableValue(table: tables.functions, row: row, column: 9))
        let signatureFirst: Int(compilerIntTableValue(table: tables.functions, row: row, column: 10))
        let signatureSecond: Int(compilerIntTableValue(table: tables.functions, row: row, column: 11))
        rawBufferAppendText(buffer: outputBuffer, text: "function\(tab)row=\(row)\(tab)syntaxID=\(functionSyntaxID)\(tab)fileID=\(functionFileID)\(tab)firstParameterRow=\(firstParameterRow)\(tab)parameterCount=\(childCount)\(tab)parameterStart=\(parameterStart)\(tab)parameterEnd=\(parameterEnd)\(tab)returnStart=\(returnStart)\(tab)returnEnd=\(returnEnd)\(tab)bodyStart=\(functionBodyStart)\(tab)bodyEnd=\(functionBodyEnd)\(tab)signature=\(signatureFirst):\(signatureSecond)\(newline)")
        row: row + 1
    }

    row: 0
    while row < parameterCount {
        let parameterSyntaxID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 0))
        let parameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 1))
        let functionID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 2))
        let parameterOrdinal: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 3))
        let parameterValueStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 4))
        let parameterValueEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 5))
        let parameterNameStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 6))
        let parameterNameEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 7))
        let parameterTypeStart: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 8))
        let parameterTypeEnd: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 9))
        let parameterFingerprintFirst: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 10))
        let parameterFingerprintSecond: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 11))
        let parameterName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: parameterNameStart, localEnd: parameterNameEnd))
        let parameterTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: parameterFileID, localStart: parameterTypeStart, localEnd: parameterTypeEnd))
        rawBufferAppendText(buffer: outputBuffer, text: "parameter\(tab)row=\(row)\(tab)syntaxID=\(parameterSyntaxID)\(tab)fileID=\(parameterFileID)\(tab)functionID=\(functionID)\(tab)ordinal=\(parameterOrdinal)\(tab)start=\(parameterValueStart)\(tab)end=\(parameterValueEnd)\(tab)name=\(parameterName)\(tab)nameStart=\(parameterNameStart)\(tab)nameEnd=\(parameterNameEnd)\(tab)type=\(parameterTypeName)\(tab)typeStart=\(parameterTypeStart)\(tab)typeEnd=\(parameterTypeEnd)\(tab)fingerprint=\(parameterFingerprintFirst):\(parameterFingerprintSecond)\(newline)")
        row: row + 1
    }
    row: 0
    while row < genericParameterCount {
        let genericOwnerSyntaxID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()))
        let genericOwnerKind: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerKindColumn()))
        let genericOrdinal: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()))
        let genericFileID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()))
        let genericStart: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterStartColumn()))
        let genericEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterEndColumn()))
        let genericNameStart: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameStartColumn()))
        let genericNameEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameEndColumn()))
        let genericFingerprintFirst: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFingerprintFirstColumn()))
        let genericFingerprintSecond: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFingerprintSecondColumn()))
        let genericName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: genericFileID, localStart: genericNameStart, localEnd: genericNameEnd))
        let genericKind: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterKindColumn()))
        rawBufferAppendText(buffer: outputBuffer, text: "genericParameter\(tab)row=\(row)\(tab)ownerSyntaxID=\(genericOwnerSyntaxID)\(tab)ownerKind=\(compilerSyntaxKindName(kindTag: genericOwnerKind))\(tab)ordinal=\(genericOrdinal)\(tab)fileID=\(genericFileID)\(tab)start=\(genericStart)\(tab)end=\(genericEnd)\(tab)name=\(genericName)\(tab)nameStart=\(genericNameStart)\(tab)nameEnd=\(genericNameEnd)\(tab)kind=\(compilerSyntaxGenericParameterKindName(kind: genericKind))\(tab)fingerprint=\(genericFingerprintFirst):\(genericFingerprintSecond)\(newline)")
        row: row + 1
    }
    row: 0
    while row < typeReferenceCount {
        rawBufferAppendText(buffer: outputBuffer, text: "typeReference\(tab)id=\(row)\(tab)ownerMemberRow=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOwnerColumn()))\(tab)parent=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceParentColumn()))\(tab)ordinal=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOrdinalColumn()))\(tab)kind=\(compilerSyntaxTypeReferenceKindName(kind: compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceKindColumn())))\(tab)targetKind=\(compilerSyntaxTypeReferenceTargetName(kind: compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetKindColumn())))\(tab)targetID=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetIDColumn()))\(tab)childCount=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceChildCountColumn()))\(tab)depth=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceDepthColumn()))\(tab)nameStart=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameStartColumn()))\(tab)nameEnd=\(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameEndColumn()))\(newline)")
        row: row + 1
    }
    rawBufferAppendText(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("genericParameterTable"), table: tables.genericParameters))
    rawBufferAppendText(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("typeReferenceTable"), table: tables.typeReferences))
    rawBufferAppendText(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("bodyNode"), table: tables.bodyNodes))
    rawBufferAppendText(buffer: outputBuffer, text: compilerTypedSyntaxRenderRawTable(name: String("bodyEdge"), table: tables.bodyEdges))
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerTypedSyntaxSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: tables))
    let typedSyntaxTab: String(compilerCoreTabCharacter())
    let typedSyntaxNewline: String(compilerCoreNewlineCharacter())
    state summary: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        summary: "compilerError\(typedSyntaxTab)kind=invalidTypedSyntaxSnapshot\(typedSyntaxNewline)"
    } else {
        summary: compilerTypedSyntaxRenderSnapshot(tables: tables)
    }
    let destroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if destroyStatus != 0 {
        return "compilerError\(typedSyntaxTab)kind=typedSyntaxOwnershipFailure\(typedSyntaxNewline)"
    }
    return summary
}

function compilerSyntaxRecipeMemberRow(tables: CompilerSyntaxTables, targetSyntaxID: Int, name: String): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: row, column: 2) == targetSyntaxID {
            let fileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: row, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: row, column: 7)))
            if candidate == name { return row }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerSyntaxRecipeCardinality(tables: CompilerSyntaxTables, memberRow: Int): String {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: tables.members) { return String("invalid") }
    let fileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
    let typeStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.members, row: memberRow, column: 8)))
    let typeEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.members, row: memberRow, column: 9)))
    state cursor: Int(typeStart)
    state firstKind: RangeTokenKind(.eof)
    state lastKind: RangeTokenKind(.eof)
    state tokenCount: Int(0)
    while cursor < typeEnd {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: cursor))
        if maybeToken == nil { return String("invalid") }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackTokenAt(index: cursor))
        if token.start >= typeEnd { cursor: typeEnd } else {
            if tokenCount == 0 { firstKind: token.kind }
            lastKind: token.kind
            tokenCount: tokenCount + 1
            cursor: token.end
        }
    }
    if tokenCount == 0 { return String("invalid") }
    if firstKind == .leftBracket && lastKind == .rightBracket { return String("many") }
    if lastKind == .question { return String("optional") }
    return String("one")
}

function compilerSyntaxRecipeNominalTargetSyntaxID(tables: CompilerSyntaxTables, memberRow: Int): Int {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: tables.members)
        || compilerIntTableValue(table: tables.members, row: memberRow, column: 14) != compilerSyntaxTypeTargetReference() {
        return 0 - 1
    }
    state referenceID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 15))
    while referenceID >= 0 && referenceID < compilerIntTableRowCount(table: tables.typeReferences) {
        let targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: referenceID, column: compilerSyntaxTypeReferenceTargetKindColumn()))
        if targetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
            return compilerIntTableValue(table: tables.typeReferences, row: referenceID, column: compilerSyntaxTypeReferenceTargetIDColumn())
        }
        state childReferenceID: Int(0 - 1)
        state candidate: Int(0)
        while candidate < compilerIntTableRowCount(table: tables.typeReferences) {
            if compilerIntTableValue(table: tables.typeReferences, row: candidate, column: compilerSyntaxTypeReferenceParentColumn()) == referenceID
                && compilerIntTableValue(table: tables.typeReferences, row: candidate, column: compilerSyntaxTypeReferenceOrdinalColumn()) == 0 {
                childReferenceID: candidate
            }
            candidate: candidate + 1
        }
        referenceID: childReferenceID
    }
    return 0 - 1
}

function compilerSyntaxRecipeApplicationRowForTarget(tables: CompilerSyntaxTables, targetSyntaxID: Int): Int {
    if targetSyntaxID < 0 { return 0 - 1 }
    state applicationRow: Int(0)
    while applicationRow < compilerIntTableRowCount(table: tables.macroApplications) {
        let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 4), localEnd: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 5)))
        if name == String("syntax")
            && compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 12) == targetSyntaxID {
            return applicationRow
        }
        applicationRow: applicationRow + 1
    }
    return 0 - 1
}

function compilerSyntaxRecipeTemplateStart(tables: CompilerSyntaxTables, applicationRow: Int): Int {
    let bodyStart: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 10))
    if bodyStart >= 0 { return bodyStart }
    let argumentStart: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 8))
    if argumentStart >= 0 { return argumentStart }
    return compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 3)
}

function compilerSyntaxRecipeTemplateEnd(tables: CompilerSyntaxTables, applicationRow: Int): Int {
    let bodyEnd: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 11))
    if bodyEnd >= 0 { return bodyEnd }
    let argumentEnd: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 9))
    if argumentEnd >= 0 { return argumentEnd }
    return compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 3)
}

function compilerSyntaxRecipeTemplateMode(tables: CompilerSyntaxTables, applicationRow: Int): String {
    if compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 10) >= 0 { return String("body") }
    if compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 8) >= 0 { return String("argument") }
    return String("implicit")
}

function compilerSyntaxRecipeProcessApplication(tables: CompilerSyntaxTables, rows: RawBuffer, applicationRow: Int, recipeRow: Int, render: Bool): Int {
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 12))
    if targetSyntaxID < 0 {
        rawBufferAppendText(buffer: rows, text: "compilerError\(tab)kind=syntaxRecipeMissingTarget\(tab)applicationRow=\(applicationRow)\(newline)")
        return 0 - 1
    }
    let templateStartLocal: Int(compilerSyntaxRecipeTemplateStart(tables: tables, applicationRow: applicationRow))
    let templateEndLocal: Int(compilerSyntaxRecipeTemplateEnd(tables: tables, applicationRow: applicationRow))
    let mode: String(compilerSyntaxRecipeTemplateMode(tables: tables, applicationRow: applicationRow))
    let templateStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: templateStartLocal))
    let templateEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: templateEndLocal))
    if render {
        rawBufferAppendText(buffer: rows, text: "syntaxRecipe\(tab)row=\(recipeRow)\(tab)applicationRow=\(applicationRow)\(tab)targetSyntaxID=\(targetSyntaxID)\(tab)mode=\(mode)\(newline)")
    }
    state cursor: Int(templateStart)
    state ordinal: Int(0)
    while cursor < templateEnd {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: cursor))
        if maybeToken == nil {
            rawBufferAppendText(buffer: rows, text: "compilerError\(tab)kind=syntaxRecipeMalformedTemplate\(tab)applicationRow=\(applicationRow)\(newline)")
            return 0 - 1
        }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackTokenAt(index: cursor))
        if token.start >= templateEnd {
            cursor: templateEnd
        } else if token.kind == .dollar {
            let maybeCapture: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: token.end))
            if maybeCapture == nil {
                rawBufferAppendText(buffer: rows, text: "compilerError\(tab)kind=syntaxRecipeMalformedCapture\(tab)applicationRow=\(applicationRow)\(tab)ordinal=\(ordinal)\(newline)")
                return 0 - 1
            }
            let capture: RangeLexedToken(maybeCapture ?? compilerFallbackTokenAt(index: token.end))
            if capture.kind != .identifier && capture.kind != .keyword {
                rawBufferAppendText(buffer: rows, text: "compilerError\(tab)kind=syntaxRecipeMalformedCapture\(tab)applicationRow=\(applicationRow)\(tab)ordinal=\(ordinal)\(newline)")
                return 0 - 1
            }
            let memberRow: Int(compilerSyntaxRecipeMemberRow(tables: tables, targetSyntaxID: targetSyntaxID, name: capture.text))
            if memberRow < 0 {
                rawBufferAppendText(buffer: rows, text: "compilerError\(tab)kind=syntaxRecipeUnknownCapture\(tab)applicationRow=\(applicationRow)\(tab)ordinal=\(ordinal)\(tab)name=\(capture.text)\(newline)")
                return 0 - 1
            }
            if render {
                let memberFileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
                let memberType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 9)))
                let nestedTargetSyntaxID: Int(compilerSyntaxRecipeNominalTargetSyntaxID(tables: tables, memberRow: memberRow))
                let nestedRecipeApplicationRow: Int(compilerSyntaxRecipeApplicationRowForTarget(tables: tables, targetSyntaxID: nestedTargetSyntaxID))
                rawBufferAppendText(buffer: rows, text: "syntaxRecipeCapture\(tab)recipeRow=\(recipeRow)\(tab)ordinal=\(ordinal)\(tab)name=\(capture.text)\(tab)memberRow=\(memberRow)\(tab)type=\(memberType)\(tab)cardinality=\(compilerSyntaxRecipeCardinality(tables: tables, memberRow: memberRow))\(tab)nestedTargetSyntaxID=\(nestedTargetSyntaxID)\(tab)nestedRecipeApplicationRow=\(nestedRecipeApplicationRow)\(newline)")
            }
            ordinal: ordinal + 1
            cursor: capture.end
        } else {
            if render {
                rawBufferAppendText(buffer: rows, text: "syntaxRecipeLiteral\(tab)recipeRow=\(recipeRow)\(tab)ordinal=\(ordinal)\(tab)kind=\(rangeTokenKindName(kind: token.kind))\(tab)text=\(token.text)\(newline)")
            }
            ordinal: ordinal + 1
            cursor: token.end
        }
    }
    return 0
}

function compilerSyntaxRecipeRender(tables: CompilerSyntaxTables): String {
    let rows: RawBuffer(rawBufferCreate(capacity: 4096, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state recipeCount: Int(0)
    state applicationRow: Int(0)
    while applicationRow < compilerIntTableRowCount(table: tables.macroApplications) {
        let countFileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
        let countName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: countFileID, localStart: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 4), localEnd: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 5)))
        if countName == String("syntax") {
            if compilerSyntaxRecipeProcessApplication(tables: tables, rows: rows, applicationRow: applicationRow, recipeRow: recipeCount, render: false) != 0 {
                return compilerCoreRawBufferMaterializeAndDestroy(buffer: rows)
            }
            recipeCount: recipeCount + 1
        }
        applicationRow: applicationRow + 1
    }
    applicationRow: 0
    state recipeRow: Int(0)
    while applicationRow < compilerIntTableRowCount(table: tables.macroApplications) {
        let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 4), localEnd: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 5)))
        if name == String("syntax") {
            if compilerSyntaxRecipeProcessApplication(tables: tables, rows: rows, applicationRow: applicationRow, recipeRow: recipeRow, render: true) != 0 {
                return compilerCoreRawBufferMaterializeAndDestroy(buffer: rows)
            }
            recipeRow: recipeRow + 1
        }
        applicationRow: applicationRow + 1
    }
    rawBufferAppendText(buffer: rows, text: "syntaxRecipes\(tab)valid=true\(tab)recipeCount=\(recipeCount)\(newline)")
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: rows)
}

function compilerSyntaxRecipeSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: tables))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state summary: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) || compilerMacroFinalizeApplications(tables: tables) != 0 {
        summary: "compilerError\(tab)kind=invalidSyntaxRecipes\(newline)"
    } else {
        summary: compilerSyntaxRecipeRender(tables: tables)
    }
    let destroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if destroyStatus != 0 {
        return "compilerError\(tab)kind=syntaxRecipeOwnershipFailure\(newline)"
    }
    return summary
}

function compilerMacroDiagnosticName(code: Int): String {
    if code == compilerMacroDiagnosticMalformedDeclaration() { return String("malformedMacroDeclaration") }
    if code == compilerMacroDiagnosticMalformedApplication() { return String("malformedMacroApplication") }
    if code == compilerMacroDiagnosticUnresolved() { return String("unresolvedMacro") }
    if code == compilerMacroDiagnosticAmbiguous() { return String("ambiguousMacroDeclaration") }
    if code == compilerMacroDiagnosticTargetMismatch() { return String("macroTargetSurfaceMismatch") }
    if code == compilerMacroDiagnosticMissingTarget() { return String("macroMissingTarget") }
    if code == compilerMacroDiagnosticUnsupportedTarget() { return String("unsupportedMacroTargetSurface") }
    if code == compilerMacroDiagnosticHeaderMalformed() { return String("macroCapabilityHeaderMalformed") }
    if code == compilerMacroDiagnosticCapabilityDuplicate() { return String("macroCapabilityBindingDuplicate") }
    if code == compilerMacroDiagnosticCapabilityDenied() { return String("macroCapabilityDenied") }
    if code == compilerMacroDiagnosticFuelExhausted() { return String("macroExecutionFuelExhausted") }
    if code == compilerMacroDiagnosticBodyInvalid() { return String("macroExecutionBodyInvalid") }
    if code == compilerMacroDiagnosticExecutionError() { return String("macroExecutionError") }
    if code == compilerMacroDiagnosticGraphQueryInvalid() { return String("macroGraphQueryInvalid") }
    if code == compilerMacroDiagnosticGraphDeltaInvalid() { return String("macroGraphDeltaInvalid") }
    if code == compilerMacroDiagnosticGeneratedFunctionCollision() { return String("generatedFunctionCollision") }
    if code == compilerMacroDiagnosticGeneratedMemberCollision() { return String("generatedMemberCollision") }
    if code == compilerMacroDiagnosticGraphCapabilitiesInvalid() { return String("graphCapabilitiesInvalid") }
    if code == compilerMacroDiagnosticGraphDeclarationMissing() { return String("graphDeclarationCapabilityMissing") }
    if code == compilerMacroDiagnosticGraphApplicationMissing() { return String("graphApplicationCapabilityMissing") }
    return String("invalidMacroDiagnostic")
}

function compilerMacroObserverDigest(tables: CompilerSyntaxTables): CompilerFingerprint {
    state digest: CompilerFingerprint(compilerFingerprintInitial())
    state row: Int(0)
    state column: Int(0)
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 100)
    while row < compilerIntTableRowCount(table: tables.macroDeclarations) {
        column: 0
        while column < compilerSyntaxMacroDeclarationColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 150)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroParameters) {
        column: 0
        while column < compilerSyntaxMacroParameterColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroParameters, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 200)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroApplications) {
        column: 0
        while column < compilerSyntaxMacroApplicationColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroApplications, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: 300)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroEdges) {
        column: 0
        while column < compilerSyntaxMacroEdgeColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroEdges, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    return digest
}

