        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderGraphDelta(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nodes) {
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphDeltaNode\(tab)row=\(row)\(tab)kind=\(compilerSyntaxKindName(kindTag: compilerIntTableValue(table: delta.nodes, row: row, column: 1)))\(tab)targetSyntaxID=\(compilerIntTableValue(table: delta.nodes, row: row, column: 2))\(tab)fileID=\(compilerIntTableValue(table: delta.nodes, row: row, column: 4))\(tab)start=\(compilerIntTableValue(table: delta.nodes, row: row, column: 5))\(tab)end=\(compilerIntTableValue(table: delta.nodes, row: row, column: 6))\(newline)")
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.facts) {
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphDeltaFact\(tab)row=\(row)\(tab)operation=omit\(tab)subjectNodeID=\(compilerIntTableValue(table: delta.facts, row: row, column: 1))\(tab)objectNodeID=\(compilerIntTableValue(table: delta.facts, row: row, column: 2))\(tab)role=\(compilerIntTableValue(table: delta.facts, row: row, column: 3))\(tab)ordinal=\(compilerIntTableValue(table: delta.facts, row: row, column: 4))\(newline)")
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.generatedFunctions) {
        let name: String(compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: row))
        let generatedKind: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 1))
        if generatedKind == compilerGraphGeneratedKindEnum() {
            rawBufferAppendText(buffer: outputBuffer, text: "macroGraphGeneratedEnum\(tab)row=\(row)\(tab)kind=enum\(tab)ownerSyntaxID=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 2))\(tab)placement=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 21))\(tab)lexicalParentOrdinal=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 22))\(tab)parentFingerprint=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 23)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 24))\(tab)name=\(name)\(tab)macroDeclarationRow=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12))\(tab)applicationRow=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 13))\(tab)ordinal=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14))\(tab)applicationIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 15)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 16))\(tab)targetIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 17)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 18))\(tab)stableIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 19)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 20))\(newline)")
        } else {
            rawBufferAppendText(buffer: outputBuffer, text: "macroGraphGeneratedFunction\(tab)row=\(row)\(tab)kind=function\(tab)ownerSyntaxID=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 2))\(tab)placement=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 21))\(tab)lexicalParentOrdinal=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 22))\(tab)parentFingerprint=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 23)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 24))\(tab)name=\(name)\(tab)returnType=\(compilerTypedSyntaxLocalText(tables: tables, fileID: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 3), localStart: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 8), localEnd: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 9)))\(tab)macroDeclarationRow=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12))\(tab)applicationRow=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 13))\(tab)ordinal=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14))\(tab)applicationIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 15)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 16))\(tab)targetIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 17)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 18))\(tab)stableIdentity=\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 19)):\(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 20))\(newline)")
        }
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: delta.generatedMembers) {
        let fileID: Int(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 3))
        let name: String(compilerMacroGraphDeltaGeneratedMemberName(tables: tables, delta: delta, row: row))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 8), localEnd: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 9)))
        rawBufferAppendText(buffer: outputBuffer, text: "macroGraphGeneratedMember\(tab)row=\(row)\(tab)kind=member\(tab)ownerSyntaxID=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 2))\(tab)placement=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 19))\(tab)lexicalParentOrdinal=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 20))\(tab)parentFingerprint=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 21)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 22))\(tab)name=\(name)\(tab)memberKind=\(compilerSyntaxMemberKindName(kindTag: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 23)))\(tab)type=\(typeName)\(tab)macroDeclarationRow=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 10))\(tab)applicationRow=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 11))\(tab)ordinal=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 12))\(tab)applicationIdentity=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 13)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 14))\(tab)targetIdentity=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 15)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 16))\(tab)stableIdentity=\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 17)):\(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 18))\(newline)")
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroExpansionFragmentKindName(kind: Int): String {
    if kind == compilerMacroExpansionFragmentAuthored() { return String("authored") }
    if kind == compilerMacroExpansionFragmentBoundary() { return String("boundary") }
    if kind == compilerMacroExpansionFragmentChildMacro() { return String("childMacro") }
    return String("unknown")
}

function compilerMacroRenderExpansionFragments(tables: CompilerSyntaxTables): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 512, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExpansionFragments) {
        let kind: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 4))
        let fileID: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 5))
        let nameStart: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 8))
        let nameEnd: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 9))
        state name: String("")
        if kind != compilerMacroExpansionFragmentAuthored() {
            name: compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStart, localEnd: nameEnd)
        }
        rawBufferAppendText(buffer: outputBuffer, text: "macroExpansionFragment\(tab)row=\(row)\(tab)templateRow=\(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 1))\(tab)parentFragmentRow=\(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 2))\(tab)ordinal=\(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 3))\(tab)kind=\(compilerMacroExpansionFragmentKindName(kind: kind))\(tab)fileID=\(fileID)\(tab)start=\(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 6))\(tab)end=\(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 7))\(tab)name=\(name)\(newline)")
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerMacroRenderExpansionExecution(tables: CompilerSyntaxTables): String {
