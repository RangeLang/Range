function compilerMacroEdgeCount(tables: CompilerSyntaxTables, edgeKind: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroEdges) {
        if compilerIntTableValue(table: tables.macroEdges, row: row, column: 1) == edgeKind { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerMacroIdentityProjectionDigest(tables: CompilerSyntaxTables): CompilerFingerprint {
