        row: row + 1
    }
    return digest
}

function compilerMacroRenderDiagnostics(tables: CompilerSyntaxTables): String {
    let count: Int(compilerIntTableRowCount(table: tables.macroDiagnostics))
    if count <= 0 { return String("compilerError\tkind=macroLinking\tcount=0\n") }
    let code: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 0))
    let identityFirst: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 6))
    let identitySecond: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 7))
    state output: String("compilerError\tkind=macroLinking\tcount=\(count)\tdiagnosticKind=\(compilerMacroDiagnosticName(code: code))\tfileID=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 1))\tstart=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 2))\tend=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 3))\trelatedRow=\(compilerIntTableValue(table: tables.macroDiagnostics, row: 0, column: 5))\tidentity=\(identityFirst):\(identitySecond)")
    if code == compilerMacroDiagnosticGeneratedFunctionCollision() && identitySecond >= 0 && identitySecond < compilerIntTableRowCount(table: tables.functions) {
        let candidateSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: identitySecond, column: 0))
        let candidateDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: candidateSyntaxID))
        if candidateDeclarationRow >= 0 {
            output: "\(output)\tcandidateFunctionRow=\(identitySecond)\tcandidateSyntaxID=\(candidateSyntaxID)\tcandidateDeclarationRow=\(candidateDeclarationRow)\tcandidateName=\(compilerTypedSyntaxLocalText(tables: tables, fileID: compilerIntTableValue(table: tables.declarations, row: candidateDeclarationRow, column: 1), localStart: compilerIntTableValue(table: tables.declarations, row: candidateDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: candidateDeclarationRow, column: 8)))\tcandidateParent=\(compilerIntTableValue(table: tables.declarations, row: candidateDeclarationRow, column: 3))"
        }
    }
    return "\(output)\n"
}

function compilerMacroExecutionDigest(tables: CompilerSyntaxTables): CompilerFingerprint {
    state digest: CompilerFingerprint(compilerFingerprintInitial())
    state tableTag: Int(800)
    state row: Int(0)
    state column: Int(0)
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag)
    while row < compilerIntTableRowCount(table: tables.macroInvocations) {
        column: 0
        while column < 33 {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroInvocations, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 1)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroCapabilityHandles) {
        column: 0
        while column < compilerSyntaxMacroCapabilityHandleColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 2)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        column: 0
        while column < compilerSyntaxMacroExecutionEventColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 3)
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroReadDependencies) {
        column: 0
        while column < compilerSyntaxMacroReadDependencyColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    digest: compilerFingerprintAppendInt(fingerprint: digest, value: tableTag + 4)
    row: 0
    while row < compilerIntTableRowCount(table: tables.compilerFormulaFacts) {
        column: 0
        while column < compilerFormulaFactColumnCount() {
            digest: compilerFingerprintAppendInt(fingerprint: digest, value: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: column))
            column: column + 1
        }
        row: row + 1
    }
    return digest
}

function compilerMacroRenderExecutionEvents(tables: CompilerSyntaxTables): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 512, stride: 1))
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        let fileID: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 4))
        let messageStart: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 5))
        let messageEnd: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 6))
        let rawMessage: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: messageStart, localEnd: messageEnd))
        let message: String(compilerCoreStringLiteralContent(text: rawMessage))
        rawBufferAppendText(buffer: outputBuffer, text: "macroExecutionEvent\(tab)row=\(row)\(tab)invocationRow=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 1))\(tab)severity=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 2))\(tab)operation=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 3))\(tab)message=\(message)\(tab)messageFileID=\(fileID)\(tab)messageStart=\(messageStart)\(tab)messageEnd=\(messageEnd)\(tab)sourceFileID=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 7))\(tab)sourceStart=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 8))\(tab)sourceEnd=\(compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 9))\(newline)")
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

