function compilerMacroRenderExecutionError(tables: CompilerSyntaxTables, result: CompilerMacroExecutionResult): String {
    state invocationRow: Int(0 - 1)
    state foundInvocation: Bool(false)
    while invocationRow < compilerIntTableRowCount(table: tables.macroInvocations) - 1 && !foundInvocation {
        invocationRow: invocationRow + 1
        if compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 9) == compilerMacroInvocationFailed() { foundInvocation: true }
    }
    if invocationRow < 0 || invocationRow >= compilerIntTableRowCount(table: tables.macroInvocations) {
        return "compilerError\tkind=macroExecution\tdiagnosticKind=\(compilerMacroDiagnosticName(code: result.diagnosticCode))\n"
    }
    let applicationRow: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 1))
    let declarationRow: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 2))
    let applicationFileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let identityFirst: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 23))
    let identitySecond: Int(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 24))
    state message: String("")
    state eventSourceFileID: Int(0 - 1)
    state eventSourceStart: Int(0 - 1)
    state eventSourceEnd: Int(0 - 1)
    state eventRow: Int(0)
    while eventRow < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        if compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 1) == invocationRow {
            let messageFileID: Int(compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 4))
            let rawMessage: String(compilerTypedSyntaxLocalText(tables: tables, fileID: messageFileID, localStart: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 5), localEnd: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 6)))
            message: compilerCoreStringLiteralContent(text: rawMessage)
            eventSourceFileID: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 7)
            eventSourceStart: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 8)
            eventSourceEnd: compilerIntTableValue(table: tables.macroExecutionEvents, row: eventRow, column: 9)
        }
        eventRow: eventRow + 1
    }
    state output: String("compilerError\tkind=macroExecution\tdiagnosticKind=\(compilerMacroDiagnosticName(code: compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 10)))\tmessage=\(message)\tdiagnosticFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 11))\tdiagnosticStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 12))\tdiagnosticEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 13))\tapplicationFileID=\(applicationFileID)\tapplicationStart=\(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 2))\tapplicationEnd=\(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 3))\ttargetFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 17))\ttargetStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 18))\ttargetEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 19))\tmacroDeclarationFileID=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 20))\tmacroDeclarationStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 21))\tmacroDeclarationEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 22))\tmacroBodyStart=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 15))\tmacroBodyEnd=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 16))\tpipelineStatus=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 33))\tpipelineFailureCode=\(compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 34))\teventSourceFileID=\(eventSourceFileID)\teventSourceStart=\(eventSourceStart)\teventSourceEnd=\(eventSourceEnd)\tgraphDeltaNodeCount=\(compilerIntTableRowCount(table: result.graphDelta.nodes))\tgraphDeltaFactCount=\(compilerIntTableRowCount(table: result.graphDelta.facts))\treadDependencyCount=\(result.readDependencyCount)\tinvocationIdentity=\(identityFirst):\(identitySecond)\n")
    output: "\(output)\(compilerMacroRenderReadDependencies(tables: tables))"
    return output
}

function compilerMacroRenderExecutionSnapshot(tables: CompilerSyntaxTables, result: CompilerMacroExecutionResult): String {
    let digest: CompilerFingerprint(compilerMacroExecutionDigest(tables: tables))
    let dependencyDigest: CompilerFingerprint(compilerMacroReadDependencyDigest(tables: tables))
    let graphDeltaDigest: CompilerFingerprint(compilerMacroGraphDeltaDigest(delta: result.graphDelta))
    state output: String("macroExecution\tvalid=true\tinvocationCount=\(compilerIntTableRowCount(table: tables.macroInvocations))\tcapabilityHandleCount=\(compilerIntTableRowCount(table: tables.macroCapabilityHandles))\teventCount=\(compilerIntTableRowCount(table: tables.macroExecutionEvents))\tgraphDeltaNodeCount=\(compilerIntTableRowCount(table: result.graphDelta.nodes))\tgraphDeltaFactCount=\(compilerIntTableRowCount(table: result.graphDelta.facts))\treadDependencyCount=\(result.readDependencyCount)\texpansionFragmentCount=\(compilerIntTableRowCount(table: tables.macroExpansionFragments))\tchildApplicationCount=\(compilerIntTableRowCount(table: tables.macroChildApplications))\texpansionBindingCount=\(compilerIntTableRowCount(table: tables.macroExpansionBindings))\treadDependencyDigest=\(dependencyDigest.first):\(dependencyDigest.second)\tgraphDeltaDigest=\(graphDeltaDigest.first):\(graphDeltaDigest.second)\texecutionDigest=\(digest.first):\(digest.second)\n")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroInvocations) {
        output: "\(output)macroInvocation\trow=\(row)\tapplicationRow=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 1))\tdeclarationRow=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 2))\ttargetSyntaxID=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 3))\tphase=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 5))\tordinal=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 6))\tstatus=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 9))\tbudget=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 8))\tmirOperationCount=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 27))\tstepCount=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 28))\tapplicationIdentity=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 29)):\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 30))\tdeclarationIdentity=\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 31)):\(compilerIntTableValue(table: tables.macroInvocations, row: row, column: 32))\n"
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroResults) {
        output: "\(output)macroResult\trow=\(row)\tinvocationRow=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 1))\tapplicationRow=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 2))\tkind=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 5))\ttypeKind=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 6))\tnominalSyntaxID=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 7))\tscalar=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 8))\tchildCount=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 9))\tparentRow=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 10))\tordinal=\(compilerIntTableValue(table: tables.macroResults, row: row, column: 11))\n"
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.compilerFormulaFacts) {
        output: "\(output)compilerFormulaFact\trow=\(row)\tkind=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 1))\tinvocationRow=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 2))\tapplicationRow=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 3))\ttargetSyntaxID=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 4))\tcategory=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 5))\tsemanticElementSyntaxID=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 6))\tencoding=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 7))\tbits=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 8))\tsignedness=\(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 9))\n"
        row: row + 1
    }
    output: "\(output)\(compilerMacroRenderExecutionEvents(tables: tables))"
    output: "\(output)\(compilerMacroRenderReadDependencies(tables: tables))"
    output: "\(output)\(compilerMacroRenderExpansionFragments(tables: tables))"
    output: "\(output)\(compilerMacroRenderExpansionExecution(tables: tables))"
    output: "\(output)\(compilerMacroRenderGraphDelta(tables: tables, delta: result.graphDelta))"
    return output
}

function compilerMacroRenderSnapshot(tables: CompilerSyntaxTables): String {
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.macroParameters))
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let edgeCount: Int(compilerIntTableRowCount(table: tables.macroEdges))
    let appliesToCount: Int(compilerMacroEdgeCount(tables: tables, edgeKind: compilerMacroEdgeAppliesTo()))
    let resolvedByCount: Int(compilerMacroEdgeCount(tables: tables, edgeKind: compilerMacroEdgeResolvedBy()))
    let digest: CompilerFingerprint(compilerMacroObserverDigest(tables: tables))
    let identityDigest: CompilerFingerprint(compilerMacroIdentityProjectionDigest(tables: tables))
    return "macroGraph\tvalid=true\tdeclarationCount=\(declarationCount)\tparameterCount=\(parameterCount)\tapplicationCount=\(applicationCount)\tedgeCount=\(edgeCount)\tappliesToCount=\(appliesToCount)\tresolvedByCount=\(resolvedByCount)\tdigest=\(digest.first):\(digest.second)\nmacroStableProjection\tidentityDigest=\(identityDigest.first):\(identityDigest.second)\n"
}

function compilerMacroExecutionSummaryForValidIndex(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex): String {
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: index))
    let defaults: CompilerProjectDefaults(compilerProjectDefaultsResolve(tables: tables))
    let memory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    state output: String("")
    if execution.status != 0 {
        output: compilerMacroRenderExecutionError(tables: tables, result: execution)
    } else if !defaults.isValid {
        output: "compilerError\tkind=invalidProjectDefaults\treason=\(compilerProjectDefaultsReasonName(reason: defaults.reason))\trelatedRow=\(defaults.relatedRow)\n"
    } else {
        let storageLiteralFacts: CompilerStorageLiteralFacts(compilerStorageLiteralFactsResolve(tables: tables))
        if !storageLiteralFacts.isValid {
            output: "compilerError\tkind=invalidLiteralStorage\treason=\(compilerStorageLiteralReasonName(reason: storageLiteralFacts.reason))\trelatedRow=\(storageLiteralFacts.relatedRow)\n"
        } else {
            let textLiteralFacts: CompilerTextLiteralFacts(compilerTextLiteralFactsResolve(tables: tables))
            if !textLiteralFacts.isValid {
                output: "compilerError\tkind=invalidTextLiteralStorage\treason=\(compilerTextLiteralReasonName(reason: textLiteralFacts.reason))\trelatedRow=\(textLiteralFacts.relatedRow)\n"
            } else if compilerMemoryBuildMacroFamilyRepresentations(tables: tables, memory: memory) != 0
        || !compilerMemoryMacroFamilyRepresentationsAreValid(tables: tables, memory: memory) {
                output: "\(compilerNativeDiagnostic(kind: String("invalidMacroFamilyMemoryGraph")))\(compilerMemoryRenderMacroFamilySnapshot(memory: memory))"
            } else {
                output: "projectDefaults\tvalid=true\ttargetPointerBits=\(defaults.targetPointerBits)\tintegerBits=\(defaults.integerBits)\tintegerOverridden=\(defaults.integerWasOverridden)\tboolOverridden=\(defaults.boolWasOverridden)\nliteralStorage\tvalid=true\tstorageApplicationCount=\(storageLiteralFacts.storageApplicationCount)\tliteralApplicationCount=\(storageLiteralFacts.literalApplicationCount)\tnumericTargetSyntaxID=\(storageLiteralFacts.numericTargetSyntaxID)\tdecimalTargetSyntaxID=\(storageLiteralFacts.decimalTargetSyntaxID)\tdecimalSeparatorByte=\(storageLiteralFacts.decimalSeparatorByte)\ntextLiteralStorage\tvalid=true\ttextTargetSyntaxID=\(textLiteralFacts.textTargetSyntaxID)\tsemanticElementSyntaxID=\(textLiteralFacts.semanticElementSyntaxID)\tencoding=\(textLiteralFacts.encoding)\tcodeUnitBits=\(textLiteralFacts.codeUnitBits)\tcodeUnitSignedness=\(textLiteralFacts.codeUnitSignedness)\n\(compilerMacroRenderExecutionSnapshot(tables: tables, result: execution))\(compilerMacroRenderSnapshot(tables: tables))\(compilerMemoryRenderMacroFamilySnapshot(memory: memory))"
            }
        }
    }
    if compilerGraphDeltaDestroy(delta: execution.graphDelta) != 0 {
        output: "compilerError\tkind=macroOwnershipFailure\n"
    }
    if compilerMemoryGraphDestroy(memory: memory) != 0 {
        output: "compilerError\tkind=macroOwnershipFailure\n"
    }
    return output
}

function compilerMacroSummaryForLinkedTables(tables: CompilerSyntaxTables): String {
    let declarationIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
    state output: String("")
    if !declarationIndex.isValid {
        output: "compilerError\tkind=invalidDeclarationIndex\n"
    } else {
        output: compilerMacroExecutionSummaryForValidIndex(tables: tables, index: declarationIndex)
    }
    if compilerDeclarationIndexDestroy(index: declarationIndex) != 0 {
        output: "compilerError\tkind=macroOwnershipFailure\n"
    }
    return output
}

function compilerMacroSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    state output: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        output: compilerInvalidTypedDeclarationsDiagnostic(tables: tables)
    } else {
        let linkStatus: Int(compilerMacroLink(tables: tables))
        if linkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
            output: compilerMacroRenderDiagnostics(tables: tables)
        } else {
            output: compilerMacroSummaryForLinkedTables(tables: tables)
        }
    }
    if compilerSyntaxTablesDestroy(tables: tables) != 0 {
        return "compilerError(compilerCoreTabCharacter())kind=macroOwnershipFailure(compilerCoreNewlineCharacter())"
    }
    return output
}


function compilerNativeSourceSetLLVMTextForValidIndex(source: String, declarationTables: CompilerSyntaxTables, executionIndex: CompilerDeclarationIndex): String {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("macroExecution.begin"))
    let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: declarationTables, index: executionIndex))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("macroExecution.end"))
    let familyMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    state output: String("")
    if execution.status != 0 {
        output: compilerMacroRenderExecutionError(tables: declarationTables, result: execution)
        compilerGraphDeltaDestroy(delta: execution.graphDelta)
        compilerDeclarationIndexDestroy(index: executionIndex)
    } else {
        let defaults: CompilerProjectDefaults(compilerProjectDefaultsResolve(tables: declarationTables))
        if !defaults.isValid {
            output: "compilerError\tkind=invalidProjectDefaults\treason=\(compilerProjectDefaultsReasonName(reason: defaults.reason))\trelatedRow=\(defaults.relatedRow)\n"
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
            compilerDeclarationIndexDestroy(index: executionIndex)
        } else {
        let storageLiteralFacts: CompilerStorageLiteralFacts(compilerStorageLiteralFactsResolve(tables: declarationTables))
        if !storageLiteralFacts.isValid {
            output: "compilerError\tkind=invalidLiteralStorage\treason=\(compilerStorageLiteralReasonName(reason: storageLiteralFacts.reason))\trelatedRow=\(storageLiteralFacts.relatedRow)\n"
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
            compilerDeclarationIndexDestroy(index: executionIndex)
        } else {
        let textLiteralFacts: CompilerTextLiteralFacts(compilerTextLiteralFactsResolve(tables: declarationTables))
        if !textLiteralFacts.isValid {
            output: "compilerError\tkind=invalidTextLiteralStorage\treason=\(compilerTextLiteralReasonName(reason: textLiteralFacts.reason))\trelatedRow=\(textLiteralFacts.relatedRow)\n"
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
            compilerDeclarationIndexDestroy(index: executionIndex)
        } else {
        let generatedCommitStatus: Int(compilerGraphDeltaCommitGeneratedDeclarations(tables: declarationTables, delta: execution.graphDelta))
        if generatedCommitStatus != 0 {
            compilerMacroRecordGeneratedFunctionCommitDiagnostic(tables: declarationTables, delta: execution.graphDelta)
            output: compilerMacroRenderDiagnostics(tables: declarationTables)
            output: "\(output)macroGeneratedCommit\tstatus=\(generatedCommitStatus)\tpendingFunctionCount=\(compilerIntTableRowCount(table: declarationTables.pendingGeneratedFunctions))\tpendingMemberCount=\(compilerIntTableRowCount(table: declarationTables.pendingGeneratedMembers))\n"
            if generatedCommitStatus == 0 - 2 {
                output: "\(output)macroGeneratedCommit\tatomicRollback=true\tpendingFunctionCount=\(compilerIntTableRowCount(table: declarationTables.pendingGeneratedFunctions))\tpendingMemberCount=\(compilerIntTableRowCount(table: declarationTables.pendingGeneratedMembers))\n"
            }
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
            compilerDeclarationIndexDestroy(index: executionIndex)
        } else {
            compilerDeclarationIndexDestroy(index: executionIndex)
            if compilerMemoryBuildMacroFamilyRepresentations(tables: declarationTables, memory: familyMemory) != 0
                || !compilerMemoryMacroFamilyRepresentationsAreValid(tables: declarationTables, memory: familyMemory) {
                output: compilerNativeDiagnostic(kind: String("invalidMacroFamilyMemoryGraph"))
            } else {
                compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("llvmPipeline.begin"))
                let combinedProgram: CompilerProgram(compilerNativeSourceSetProgramForLLVM(source: source))
                output: compilerCoreLLVMNativeEntryTextForProgram(program: combinedProgram, declarationTables: declarationTables, expansionDelta: execution.graphDelta)
                compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("llvmPipeline.end"))
            }
            compilerGraphDeltaDestroy(delta: execution.graphDelta)
        }
        }
        }
        }
    }
    if compilerMemoryGraphDestroy(memory: familyMemory) != 0 { return compilerNativeDiagnostic(kind: String("memoryOwnershipFailure")) }
    return output
}

function compilerNativeSourceSetLLVMTextForLinkedTables(source: String, declarationTables: CompilerSyntaxTables): String {
    let executionIndex: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: declarationTables))
    state output: String("")
    if !executionIndex.isValid {
        compilerDeclarationIndexDestroy(index: executionIndex)
        output: String("compilerError\tkind=invalidDeclarationIndex\n")
    } else {
        output: compilerNativeSourceSetLLVMTextForValidIndex(source: source, declarationTables: declarationTables, executionIndex: executionIndex)
    }
    return output
}

function compilerNativeSourceSetLLVMText(source: String): String {
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("sourceSet.begin"))
    let declarationTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: declarationTables))
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("declarationCapture.end"))
    state output: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: declarationTables) {
        output: compilerInvalidTypedDeclarationsDiagnostic(tables: declarationTables)
    } else {
        let macroLinkStatus: Int(compilerMacroLink(tables: declarationTables))
        compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("macroLink.end"))
        if macroLinkStatus != 0 || compilerIntTableRowCount(table: declarationTables.macroDiagnostics) != 0 {
            output: compilerMacroRenderDiagnostics(tables: declarationTables)
        } else {
            output: compilerNativeSourceSetLLVMTextForLinkedTables(source: source, declarationTables: declarationTables)
        }
    }
    compilerSyntaxTablesDestroy(tables: declarationTables)
    compilerMetricsFunctionBegin(functionID: 0 - 1, name: String("sourceSet.end"))
    return output
}

function compilerNativeSourceSetProgramForLLVM(source: String): CompilerProgram {
    let emptyBlock: CompilerBlock(start: 0, end: 0)
    return CompilerProgram(source: $source, hasMainBlock: false, mainAttributeStart: 0, mainBlock: emptyBlock, mainStatementRecords: String(""), mainStatementSummary: String(""), declarationRecords: String(""), declarationSummary: String(""))
}

function compilerNativeDiagnostic(kind: String): String {
    return "compilerError\(compilerCoreTabCharacter())kind=\(kind)\(compilerCoreNewlineCharacter())"
}

function compilerNativeOutputIsError(output: String): Bool {
    return hasRangePrefix(source: output, start: 0, prefix: String("compilerError"))
}

function compilerNativeOutputExitCode(output: String): Int {
    if compilerNativeOutputIsError(output: output) { return 65 }
    return 0
}

function parseCompilerProgramForLLVMNamedBodies(source: String, bodyFunctionNames: String): CompilerProgram {
    let maybeMainBlock: Optional<CompilerMainBlock>(compilerCoreParseMainBlock(source: source))
    let parsedDeclarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarationsForLLVMNamedBodies(source: source, bodyFunctionNames: bodyFunctionNames))
    return compilerCoreProgramFromParsedParts(source: source, maybeMainBlock: maybeMainBlock, parsedDeclarations: parsedDeclarations)
}

function compilerCoreProgramWithoutMain(source: String, parsedDeclarations: CompilerParsedDeclarations): CompilerProgram {
    let blockFallback: CompilerBlock(start: 0, end: 0)
    return CompilerProgram(
        source: $source,
        hasMainBlock: false,
        mainAttributeStart: 0,
        mainBlock: blockFallback,
        mainStatementRecords: String(""),
        mainStatementSummary: String(""),
        declarationRecords: parsedDeclarations.records,
        declarationSummary: parsedDeclarations.declarationSummary
    )
}

function compilerCoreSymbolSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgram(source: source))
    return compilerCoreSymbolSummaryForProgram(program: program)
}

function compilerCoreTypeSummary(source: String): String {
    let program: CompilerProgram(parseCompilerProgramWithFunctionBodies(source: source))
    return compilerCoreTypeSummaryForProgram(program: program)
}

function parseCompilerTopLevelDeclarations(source: String): CompilerParsedDeclarations {
    return parseCompilerTopLevelDeclarationsWithFunctionBodyMode(source: source, includeFunctionBodies: false)
}

function compilerCoreDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.declarationSummary
}

function compilerCoreFunctionDeclarationSummary(source: String): String {
    let declarations: CompilerParsedDeclarations(parseCompilerTopLevelDeclarations(source: source))
    return declarations.functionSummary
}

function compilerCursorPeek(cursor: CompilerTokenCursor): Optional<RangeLexedToken> {
    return lexNextRangeToken(source: cursor.source, start: cursor.index)
}

function compilerCursorAdvance(cursor: CompilerTokenCursor, token: RangeLexedToken): CompilerTokenCursor {
    return CompilerTokenCursor(source: $cursor.source, index: token.end)
}

function compilerCursorPeekOrFallback(cursor: CompilerTokenCursor): RangeLexedToken {
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    return maybeToken ?? compilerFallbackTokenAt(index: cursor.index)
}

function compilerCursorPeekStartOrIndex(cursor: CompilerTokenCursor): Int {
    let token: RangeLexedToken(compilerCursorPeekOrFallback(cursor: cursor))
    return token.start
}

function compilerCursorPeekEndOrIndex(cursor: CompilerTokenCursor): Int {
    let token: RangeLexedToken(compilerCursorPeekOrFallback(cursor: cursor))
    return token.end
}

function compilerCursorPeekKindOrEOF(cursor: CompilerTokenCursor): RangeTokenKind {
    let token: RangeLexedToken(compilerCursorPeekOrFallback(cursor: cursor))
    return token.kind
}

function compilerCursorPeekTextEquals(cursor: CompilerTokenCursor, expected: String): Bool {
    let token: RangeLexedToken(compilerCursorPeekOrFallback(cursor: cursor))
    return token.text == expected
}

function compilerFallbackToken(cursor: CompilerTokenCursor): RangeLexedToken {
    return RangeLexedToken(kind: .eof, start: cursor.index, end: cursor.index, text: String(""))
}

function compilerFallbackTokenAt(index: Int): RangeLexedToken {
    return RangeLexedToken(kind: .eof, start: index, end: index, text: String(""))
}

function compilerCoreParseBalancedRange(cursor: CompilerTokenCursor, leftKind: RangeTokenKind, rightKind: RangeTokenKind): Optional<CompilerSourceRange> {
    let maybeLeftToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeftToken == nil {
        return nil
    }

    let leftToken: RangeLexedToken(
        maybeLeftToken ?? compilerFallbackToken(cursor: cursor)
    )
    if leftToken.kind != leftKind {
        return nil
    }

    return compilerCoreParseBalancedRangeAfterLeft(cursor: cursor, leftToken: leftToken, leftKind: leftKind, rightKind: rightKind)
}

function compilerCoreParseBalancedRangeAfterLeft(cursor: CompilerTokenCursor, leftToken: RangeLexedToken, leftKind: RangeTokenKind, rightKind: RangeTokenKind): Optional<CompilerSourceRange> {
    return compilerCoreParseBalancedRangeScanning(source: $cursor.source, scanIndex: leftToken.end, rangeStart: leftToken.end, leftKind: leftKind, rightKind: rightKind, depth: 1)
}

function compilerCoreParseBalancedRangeScanning(source: String, scanIndex: Int, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, depth: Int): Optional<CompilerSourceRange> {
    state currentIndex: Int(scanIndex)
    state scanDepth: Int(depth)

    while true {
        let scanCursor: CompilerTokenCursor(source: $source, index: currentIndex)
        let tokenKind: RangeTokenKind(compilerCursorPeekKindOrEOF(cursor: scanCursor))
        if tokenKind == .eof { return nil }
        let tokenStart: Int(compilerCursorPeekStartOrIndex(cursor: scanCursor))
        let tokenEnd: Int(compilerCursorPeekEndOrIndex(cursor: scanCursor))
        if tokenKind == leftKind {
            scanDepth: scanDepth + 1
        } else if tokenKind == rightKind {
            scanDepth: scanDepth - 1
            if scanDepth == 0 {
                return CompilerSourceRange(start: rangeStart, end: tokenStart, next: tokenEnd)
            }
        }
        currentIndex: tokenEnd
    }

    return nil
}

function compilerCoreParseBalancedRangeScanningToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, depth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    let nextDepth: Int(compilerCoreBalancedRangeNextDepth(token: token, leftKind: leftKind, rightKind: rightKind, depth: depth))
    return compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeScanningTokenWithDepth(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if compilerCoreTokenKindEquals(token: token, kind: rightKind) {
        return compilerCoreParseBalancedRangeClosingToken(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
    }

    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreTokenKindEquals(token: RangeLexedToken, kind: RangeTokenKind): Bool {
    return compilerCoreRangeTokenKind(token: token) == kind
}

function compilerCoreRangeTokenKind(token: RangeLexedToken): RangeTokenKind {
    return token.kind
}

function compilerCoreRangeTokenText(token: RangeLexedToken): String {
    return token.text
}

function compilerCoreRangeTokenStart(token: RangeLexedToken): Int {
    return token.start
}

function compilerCoreRangeTokenEnd(token: RangeLexedToken): Int {
    return token.end
}

function compilerCoreParseBalancedRangeClosingToken(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    if nextDepth == 0 {
        return CompilerSourceRange(start: rangeStart, end: token.start, next: token.end)
    }
    return compilerCoreParseBalancedRangeContinue(cursor: cursor, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, nextDepth: nextDepth, token: token)
}

function compilerCoreParseBalancedRangeContinue(cursor: CompilerTokenCursor, rangeStart: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind, nextDepth: Int, token: RangeLexedToken): Optional<CompilerSourceRange> {
    return compilerCoreParseBalancedRangeScanning(source: $cursor.source, scanIndex: token.end, rangeStart: rangeStart, leftKind: leftKind, rightKind: rightKind, depth: nextDepth)
}

function compilerCoreBalancedRangeNextDepth(token: RangeLexedToken, leftKind: RangeTokenKind, rightKind: RangeTokenKind, depth: Int): Int {
    if compilerCoreRangeTokenKind(token: token) == leftKind {
        return depth + 1
    }
    if compilerCoreRangeTokenKind(token: token) == rightKind {
        return depth - 1
    }
    return depth
}

function compilerCoreParseTypeReference(cursor: CompilerTokenCursor): Optional<CompilerTypeReference> {
    return compilerCoreParseTypeReferenceWithEnd(cursor: cursor, end: stringLength(value: cursor.source))
}

function compilerCoreParseMacroSurfaceTypeReference(cursor: CompilerTokenCursor): Optional<CompilerTypeReference> {
    let maybeFirst: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: cursor))
    if maybeFirst == nil { return nil }
    let first: CompilerTypeReference(
        maybeFirst ?? CompilerTypeReference(text: String(""), start: cursor.index, end: cursor.index)
    )
    state surfaceEnd: Int(first.end)
    while true {
        let separatorCursor: CompilerTokenCursor(source: $cursor.source, index: surfaceEnd)
        let maybeSeparator: Optional<RangeLexedToken>(compilerCursorPeek(cursor: separatorCursor))
        if maybeSeparator == nil {
            return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: first.start, end: surfaceEnd), start: first.start, end: surfaceEnd)
        }
        let separator: RangeLexedToken(
            maybeSeparator ?? compilerFallbackToken(cursor: separatorCursor)
        )
        if separator.kind != .ampersand && separator.kind != .pipe {
            return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: first.start, end: surfaceEnd), start: first.start, end: surfaceEnd)
        }
        let nextCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: separatorCursor, token: separator))
        let maybeNext: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: nextCursor))
        if maybeNext == nil { return nil }
        let next: CompilerTypeReference(
            maybeNext ?? CompilerTypeReference(text: String(""), start: nextCursor.index, end: nextCursor.index)
        )
        surfaceEnd: next.end
    }
    return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: first.start, end: surfaceEnd), start: first.start, end: surfaceEnd)
}

function compilerCoreParseTypeReferenceWithEnd(cursor: CompilerTokenCursor, end: Int): Optional<CompilerTypeReference> {
    let maybeFirstToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeFirstToken == nil {
        return nil
    }

    let firstToken: RangeLexedToken(
        maybeFirstToken ?? compilerFallbackToken(cursor: cursor)
    )
    if firstToken.start >= end {
        return nil
    }
    if firstToken.kind == .leftParen {
        let maybeInputs: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftParen, rightKind: .rightParen))
        if maybeInputs == nil { return nil }
        let inputs: CompilerSourceRange(
            maybeInputs ?? CompilerSourceRange(start: firstToken.end, end: firstToken.end, next: firstToken.end)
        )
        let arrowCursor: CompilerTokenCursor(source: $cursor.source, index: inputs.next)
        let maybeArrow: Optional<RangeLexedToken>(compilerCursorPeek(cursor: arrowCursor))
        if maybeArrow == nil { return nil }
        let arrow: RangeLexedToken(
            maybeArrow ?? compilerFallbackToken(cursor: arrowCursor)
        )
        if arrow.kind != .arrow || arrow.end >= end { return nil }
        let resultCursor: CompilerTokenCursor(source: $cursor.source, index: arrow.end)
        let maybeResult: Optional<CompilerTypeReference>(compilerCoreParseTypeReferenceWithEnd(cursor: resultCursor, end: end))
        if maybeResult == nil { return nil }
        let result: CompilerTypeReference(
            maybeResult ?? CompilerTypeReference(text: String(""), start: arrow.end, end: arrow.end)
        )
        return CompilerTypeReference(text: stringSubstring(source: cursor.source, start: firstToken.start, end: result.end), start: firstToken.start, end: result.end)
    }
    if firstToken.kind != .identifier && firstToken.kind != .leftBracket && firstToken.kind != .macroAttribute {
        return nil
    }

    let initialState: CompilerTypeReferenceParseState(compilerCoreTypeReferenceInitialState(cursor: cursor, firstToken: firstToken))
    let parsedState: CompilerTypeReferenceParseState(compilerCoreParseTypeReferenceScanningUntil(parseState: initialState, end: end))
    return compilerCoreTypeReferenceFromState(firstToken: firstToken, parseState: parsedState)
}

function compilerCoreTypeReferenceInitialState(cursor: CompilerTokenCursor, firstToken: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(source: $cursor.source, index: cursor.index)
    return CompilerTypeReferenceParseState(output: String(""), typeEnd: firstToken.start, cursor: cursorState, genericDepth: 0, arrayDepth: 0, consumedToken: false, keepScanning: true)
}

function compilerCoreParseTypeReferenceScanning(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return compilerCoreParseTypeReferenceScanningUntil(parseState: parseState, end: stringLength(value: parseState.cursor.source))
}

function compilerCoreParseTypeReferenceScanningUntil(parseState: CompilerTypeReferenceParseState, end: Int): CompilerTypeReferenceParseState {
    state scanState: CompilerTypeReferenceParseState(output: parseState.output, typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: parseState.keepScanning)
    while scanState.keepScanning {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanState.cursor))
        if maybeToken == nil {
            scanState: compilerCoreTypeReferenceStop(parseState: scanState)
        } else {
            let token: RangeLexedToken(
                maybeToken ?? compilerFallbackToken(cursor: scanState.cursor)
            )
            if token.start >= end {
                scanState: compilerCoreTypeReferenceStop(parseState: scanState)
            } else {
                scanState: compilerCoreParseTypeReferenceToken(parseState: scanState, token: token)
            }
        }
    }
    return scanState
}

function compilerCoreTypeReferenceFromState(firstToken: RangeLexedToken, parseState: CompilerTypeReferenceParseState): Optional<CompilerTypeReference> {
    if !parseState.consumedToken {
        return nil
    }

    if parseState.genericDepth != 0 {
        return nil
    }

    if parseState.arrayDepth != 0 {
        return nil
    }

    return CompilerTypeReference(text: parseState.output, start: firstToken.start, end: parseState.typeEnd)
}

function compilerCoreParseTypeReferenceToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == .identifier {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .integer && parseState.genericDepth > 0 {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .macroAttribute && (!parseState.consumedToken || parseState.arrayDepth > 0 || parseState.genericDepth > 0) {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: token.text, genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .dot {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("."), genericDelta: 0, arrayDelta: 0)
    }
    if token.kind == .less {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("<"), genericDelta: 1, arrayDelta: 0)
    }
    return compilerCoreParseTypeReferenceTokenPunctuation(parseState: parseState, token: token)
}

function compilerCoreParseTypeReferenceTokenPunctuation(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if token.kind == .greater {
        return compilerCoreTypeReferenceCloseGeneric(parseState: parseState, token: token)
    }
    if token.kind == .leftBracket {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("["), genericDelta: 0, arrayDelta: 1)
    }
    if token.kind == .rightBracket {
        return compilerCoreTypeReferenceCloseArray(parseState: parseState, token: token)
    }
    if token.kind == .comma {
        return compilerCoreTypeReferenceComma(parseState: parseState, token: token)
    }
    if token.kind == .question {
        return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String("?"), genericDelta: 0, arrayDelta: 0)
    }
    return compilerCoreTypeReferenceStop(parseState: parseState)
}

function compilerCoreTypeReferenceAppend(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken, text: String, genericDelta: Int, arrayDelta: Int): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)\(text)", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth + genericDelta, arrayDepth: parseState.arrayDepth + arrayDelta, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseGeneric(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseGenericToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseArray(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceCloseArrayToken(parseState: parseState, token: token)
}

function compilerCoreTypeReferenceCloseGenericToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)>", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth - 1, arrayDepth: parseState.arrayDepth, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceCloseArrayToken(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    let cursorState: CompilerTokenCursor(compilerCursorAdvance(cursor: parseState.cursor, token: token))
    return CompilerTypeReferenceParseState(output: "\(parseState.output)]", typeEnd: token.end, cursor: cursorState, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth - 1, consumedToken: true, keepScanning: true)
}

function compilerCoreTypeReferenceComma(parseState: CompilerTypeReferenceParseState, token: RangeLexedToken): CompilerTypeReferenceParseState {
    if parseState.genericDepth <= 0 && parseState.arrayDepth <= 0 {
        return compilerCoreTypeReferenceStop(parseState: parseState)
    }
    return compilerCoreTypeReferenceAppend(parseState: parseState, token: token, text: String(","), genericDelta: 0, arrayDelta: 0)
}

function compilerCoreTypeReferenceStop(parseState: CompilerTypeReferenceParseState): CompilerTypeReferenceParseState {
    return CompilerTypeReferenceParseState(output: "\(parseState.output)", typeEnd: parseState.typeEnd, cursor: parseState.cursor, genericDepth: parseState.genericDepth, arrayDepth: parseState.arrayDepth, consumedToken: parseState.consumedToken, keepScanning: false)
}

function parseCompilerCallArgumentsCore(source: String, start: Int, end: Int): CompilerCallArguments {
    state output: String("")
    state records: String("")
    state cursor: CompilerTokenCursor(source: $source, index: start)
    state argumentIndex: Int(0)

    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        let token: RangeLexedToken(
            maybeToken ?? compilerFallbackToken(cursor: cursor)
        )
        if token.start >= end {
            return CompilerCallArguments(summary: output, records: records, start: start, end: end)
        }

        if token.kind == .comma {
            cursor: compilerCursorAdvance(cursor: cursor, token: token)
        } else {
            state label: String("")
            state labelStart: Int(0 - 1)
            state labelEnd: Int(0 - 1)
            state expressionStart: Int(0)
            expressionStart: token.start
            if token.kind == .identifier || token.kind == .keyword {
                let afterLabelCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: token))
                let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: afterLabelCursor))
                if maybeColon != nil {
                    let colonToken: RangeLexedToken(
                        maybeColon ?? compilerFallbackToken(cursor: afterLabelCursor)
                    )
                    if colonToken.kind == .colon {
                        label: token.text
                        labelStart: token.start
                        labelEnd: token.end
                        expressionStart: colonToken.end
                    }
                }
            }

            let maybeArgumentExpression: Optional<CompilerExpression>(parseCompilerExpression(source: source, start: expressionStart, limit: end))
            if maybeArgumentExpression == nil {
                return CompilerCallArguments(summary: output, records: records, start: start, end: end)
            }
            let expression: CompilerExpression(
                maybeArgumentExpression ?? compilerCoreMissingExpression(start: expressionStart)
            )
            if label == String("") {
                output: "\(output)argument\(argumentIndex)=\(expression.summary);"
            } else {
                output: "\(output)argument\(argumentIndex).\(label)=\(expression.summary);"
            }
            records: "\(records)\(compilerCoreCallArgumentRecord(index: argumentIndex, label: label, expressionRecord: expression.record, expressionSummary: expression.summary))"
            argumentIndex: argumentIndex + 1
            cursor: CompilerTokenCursor(source: $source, index: expression.end)
        }
    }

    return CompilerCallArguments(summary: output, records: records, start: start, end: end)
}

function compilerCoreMissingFunctionParameterTokenStep(source: String, index: Int, nextIndex: Int, keepScanning: Bool): CompilerFunctionParameterTokenStep {
    let missingToken: RangeLexedToken(kind: .eof, start: index, end: index, text: String(""))
    let missingType: CompilerTypeReference(text: String(""), start: index, end: index)
    return CompilerFunctionParameterTokenStep(found: false, keepScanning: keepScanning, nameToken: missingToken, typeReference: missingType, nextIndex: nextIndex)
}

function compilerCoreParseFunctionParameterToken(source: String, end: Int, token: RangeLexedToken): CompilerFunctionParameterTokenStep {
    if token.start >= end {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }
    if token.kind == .comma {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }
    if token.kind != .identifier && token.kind != .keyword {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    state nameToken: RangeLexedToken(token)
    let firstCursor: CompilerTokenCursor(source: $source, index: token.start)
    state colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: firstCursor, token: token))
    state maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    state colonToken: RangeLexedToken(maybeColon ?? compilerFallbackToken(cursor: colonCursor))
    if colonToken.kind == .identifier || colonToken.kind == .keyword {
        nameToken: colonToken
        colonCursor: compilerCursorAdvance(cursor: colonCursor, token: nameToken)
        maybeColon: compilerCursorPeek(cursor: colonCursor)
        if maybeColon == nil {
            return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: nameToken.end, keepScanning: false)
        }
        colonToken: maybeColon ?? compilerFallbackToken(cursor: colonCursor)
    }
    if colonToken.kind != .colon {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return compilerCoreMissingFunctionParameterTokenStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeReference: CompilerTypeReference(
        maybeType ?? CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index)
    )
    return CompilerFunctionParameterTokenStep(found: true, keepScanning: true, nameToken: nameToken, typeReference: typeReference, nextIndex: typeReference.end)
}

function compilerCoreMissingStoredMemberParseStep(source: String, index: Int, nextIndex: Int, keepScanning: Bool): CompilerStoredMemberParseStep {
    let missingToken: RangeLexedToken(kind: .eof, start: index, end: index, text: String(""))
    let missingType: CompilerTypeReference(text: String(""), start: index, end: index)
    return CompilerStoredMemberParseStep(found: false, keepScanning: keepScanning, kindTag: 0 - 1, nameToken: missingToken, typeReference: missingType, nextIndex: nextIndex)
}

function compilerCoreParseStoredMemberTrailingRange(cursor: CompilerTokenCursor, isDerivedBody: Bool): Optional<CompilerSourceRange> {
    if isDerivedBody {
        return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftBrace, rightKind: .rightBrace)
    }
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftParen, rightKind: .rightParen)
}

function compilerCoreParseStoredMemberToken(source: String, end: Int, token: RangeLexedToken): CompilerStoredMemberParseStep {
    if token.start >= end {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }
    if token.kind != .keyword || (token.text != String("let") && token.text != String("state") && token.text != String("binding") && token.text != String("derived")) {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let tokenCursor: CompilerTokenCursor(source: $source, index: token.start)
    let nameCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: tokenCursor, token: token))
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: nameCursor))
    if maybeName == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let nameToken: RangeLexedToken(
        maybeName ?? compilerFallbackToken(cursor: nameCursor)
    )
    if nameToken.kind != .identifier && nameToken.kind != .keyword {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: nameCursor, token: nameToken))
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
    if maybeColon == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let colonToken: RangeLexedToken(
        maybeColon ?? compilerFallbackToken(cursor: colonCursor)
    )
    if colonToken.kind != .colon {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: true)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: colonCursor, token: colonToken))
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil {
        return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: token.end, keepScanning: false)
    }

    let typeReference: CompilerTypeReference(
        maybeType ?? CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index)
    )
    state nextIndex: Int(typeReference.end)
    let initializerCursor: CompilerTokenCursor(source: $source, index: typeReference.end)
    let maybeInitializer: Optional<RangeLexedToken>(compilerCursorPeek(cursor: initializerCursor))
    if maybeInitializer != nil {
        let initializer: RangeLexedToken(
            maybeInitializer ?? compilerFallbackToken(cursor: initializerCursor)
        )
        let initializerIsConstructor: Bool(token.text != String("derived") && initializer.kind == .leftParen)
        let initializerIsDerivedBody: Bool(token.text == String("derived") && initializer.kind == .leftBrace)
        if initializer.start < end && (initializerIsConstructor || initializerIsDerivedBody) {
            let maybeInitializerRange: Optional<CompilerSourceRange>(compilerCoreParseStoredMemberTrailingRange(cursor: initializerCursor, isDerivedBody: initializerIsDerivedBody))
            if maybeInitializerRange == nil {
                return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: initializer.end, keepScanning: false)
            }
            let initializerRange: CompilerSourceRange(
                maybeInitializerRange ?? CompilerSourceRange(start: initializer.end, end: initializer.end, next: initializer.end)
            )
            if initializerRange.next > end {
                return compilerCoreMissingStoredMemberParseStep(source: source, index: token.start, nextIndex: initializerRange.next, keepScanning: false)
            }
            nextIndex: initializerRange.next
        }
    }
    state memberKind: Int(compilerSyntaxMemberKindLet())
    if token.text == String("state") { memberKind: compilerSyntaxMemberKindState() }
    if token.text == String("binding") { memberKind: compilerSyntaxMemberKindBinding() }
    if token.text == String("derived") { memberKind: compilerSyntaxMemberKindDerived() }
    return CompilerStoredMemberParseStep(found: true, keepScanning: true, kindTag: memberKind, nameToken: nameToken, typeReference: typeReference, nextIndex: nextIndex)
}

function compilerCoreParseDeclarationNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    state cursor: CompilerTokenCursor(source: $source, index: keyword.start)
    cursor: CompilerTokenCursor(source: $source, index: keyword.end)
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil {
        return nil
    }

    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackToken(cursor: cursor))
    if nameToken.kind != .identifier {
        return nil
    }

    return nameToken
}

function compilerCoreParseMacroNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    let cursor: CompilerTokenCursor(source: $source, index: keyword.end)
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil { return nil }
    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackToken(cursor: cursor))
    if nameToken.kind != .identifier && nameToken.kind != .keyword { return nil }
    return nameToken
}

function compilerCoreTokenCanNameFunction(token: RangeLexedToken): Bool {
    return token.kind == .identifier
        || token.kind == .ampersand
        || token.kind == .andAnd
        || token.kind == .asterisk
        || token.kind == .bang
        || token.kind == .bangEqual
        || token.kind == .equalEqual
        || token.kind == .greater
        || token.kind == .greaterEqual
        || token.kind == .less
        || token.kind == .lessEqual
        || token.kind == .minus
        || token.kind == .orOr
        || token.kind == .percent
        || token.kind == .pipe
        || token.kind == .plus
        || token.kind == .questionQuestion
        || token.kind == .slash
}

function compilerCoreParseFunctionNameAfterKeyword(source: String, keyword: RangeLexedToken): Optional<RangeLexedToken> {
    let cursor: CompilerTokenCursor(source: $source, index: keyword.end)
    let maybeName: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeName == nil { return nil }
    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackToken(cursor: cursor))
    if !compilerCoreTokenCanNameFunction(token: nameToken) { return nil }
    return nameToken
}

function compilerCoreParseAngleRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(source: $source, index: nameToken.end)
    let maybeLeft: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeLeft == nil { return nil }
    let left: RangeLexedToken(maybeLeft ?? compilerFallbackToken(cursor: cursor))
    if left.kind != .less { return nil }
    state scanCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: left))
    state depth: Int(1)
    while true {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: scanCursor))
        if maybeToken == nil { return nil }
        let token: RangeLexedToken(
            maybeToken ?? compilerFallbackToken(cursor: scanCursor)
        )
        if token.kind == .less {
            depth: depth + 1
        } else if token.kind == .greater {
            depth: depth - 1
            if depth == 0 {
                return CompilerSourceRange(start: left.start, end: token.end, next: token.end)
            }
        }
        scanCursor: compilerCursorAdvance(cursor: scanCursor, token: token)
    }
    return nil
}

function compilerCoreInvalidMacroApplicationParts(index: Int): CompilerMacroApplicationParts {
    let invalidRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: index)
    return CompilerMacroApplicationParts(macroToken: compilerFallbackTokenAt(index: index), genericRange: invalidRange, argumentRange: invalidRange, bodyRange: invalidRange, nextIndex: index)
}

function compilerCoreOwnedMacroApplicationPartsCopy(parts: CompilerMacroApplicationParts): CompilerMacroApplicationParts {
    state macroText: String(parts.macroToken.text)
    let macroToken: RangeLexedToken(kind: parts.macroToken.kind, start: parts.macroToken.start, end: parts.macroToken.end, text: macroText)
    return CompilerMacroApplicationParts(
        macroToken: macroToken,
        genericRange: parts.genericRange,
        argumentRange: parts.argumentRange,
        bodyRange: parts.bodyRange,
        nextIndex: parts.nextIndex
    )
}

function compilerCoreParseMacroApplicationParts(source: String, macroToken: RangeLexedToken): CompilerMacroApplicationParseResult {
    let invalidRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken))
    let cursor: CompilerTokenCursor(source: $source, index: compilerCoreRangeTokenEnd(token: macroToken))
    state genericRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken))
    state argumentRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken))
    state bodyRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: macroToken))
    state nextIndex: Int(compilerCoreRangeTokenEnd(token: macroToken))
    let maybeNext: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeNext != nil {
        let token: RangeLexedToken(
            maybeNext ?? compilerFallbackToken(cursor: cursor)
        )
        if token.kind == .less {
            let syntheticName: RangeLexedToken(kind: .identifier, start: compilerCoreRangeTokenStart(token: macroToken) + 1, end: compilerCoreRangeTokenEnd(token: macroToken), text: stringSliceUnchecked(source: source, start: compilerCoreRangeTokenStart(token: macroToken) + 1, end: compilerCoreRangeTokenEnd(token: macroToken)))
            let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: syntheticName))
            if maybeGeneric == nil { return CompilerMacroApplicationParseResult(parts: compilerCoreOwnedMacroApplicationPartsCopy(parts: compilerCoreInvalidMacroApplicationParts(index: token.end)), isValid: false) }
            genericRange: maybeGeneric ?? CompilerSourceRange(start: token.start, end: token.end, next: token.end)
            nextIndex: genericRange.next
        }
    }
    let argumentCursor: CompilerTokenCursor(source: $source, index: nextIndex)
    let maybeArgumentToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: argumentCursor))
    if maybeArgumentToken != nil {
        let argumentToken: RangeLexedToken(
            maybeArgumentToken ?? compilerFallbackToken(cursor: argumentCursor)
        )
        if argumentToken.kind == .leftParen {
            let maybeArgument: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: argumentCursor, leftKind: .leftParen, rightKind: .rightParen))
            if maybeArgument == nil { return CompilerMacroApplicationParseResult(parts: compilerCoreOwnedMacroApplicationPartsCopy(parts: compilerCoreInvalidMacroApplicationParts(index: argumentToken.end)), isValid: false) }
            argumentRange: maybeArgument ?? CompilerSourceRange(start: argumentToken.end, end: argumentToken.end, next: argumentToken.end)
            nextIndex: argumentRange.next
        }
    }
    let bodyCursor: CompilerTokenCursor(source: $source, index: nextIndex)
    let maybeBodyToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: bodyCursor))
    if maybeBodyToken != nil {
        let bodyToken: RangeLexedToken(
            maybeBodyToken ?? compilerFallbackToken(cursor: bodyCursor)
        )
        if bodyToken.kind == .leftBrace {
            let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: .leftBrace, rightKind: .rightBrace))
            if maybeBody == nil { return CompilerMacroApplicationParseResult(parts: compilerCoreOwnedMacroApplicationPartsCopy(parts: compilerCoreInvalidMacroApplicationParts(index: bodyToken.end)), isValid: false) }
            bodyRange: maybeBody ?? CompilerSourceRange(start: bodyToken.end, end: bodyToken.end, next: bodyToken.end)
            nextIndex: bodyRange.next
        }
    }
    return CompilerMacroApplicationParseResult(parts: compilerCoreOwnedMacroApplicationPartsCopy(parts: CompilerMacroApplicationParts(macroToken: macroToken, genericRange: genericRange, argumentRange: argumentRange, bodyRange: bodyRange, nextIndex: nextIndex)), isValid: true)
}

function compilerCoreParseMacroCapabilityHeader(source: String, bodyRange: CompilerSourceRange): CompilerMacroCapabilityHeader {
    let invalidRange: CompilerSourceRange(start: bodyRange.start, end: bodyRange.start, next: bodyRange.start)
    if bodyRange.end <= bodyRange.start {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: invalidRange, executableBodyRange: invalidRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let firstMaybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: bodyRange.start))
    if firstMaybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDeclarative(), headerRange: invalidRange, executableBodyRange: bodyRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let first: RangeLexedToken(firstMaybe ?? compilerFallbackTokenAt(index: bodyRange.start))
    let comma1Maybe: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: first.end))
    if (first.kind != .identifier && first.kind != .keyword) || comma1Maybe == nil {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDeclarative(), headerRange: invalidRange, executableBodyRange: bodyRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    let comma1: RangeLexedToken(comma1Maybe ?? compilerFallbackTokenAt(index: first.end))
    if comma1.text == String("in") {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderValid(), headerRange: CompilerSourceRange(start: first.start, end: comma1.end, next: comma1.end), executableBodyRange: CompilerSourceRange(start: comma1.end, end: bodyRange.end, next: bodyRange.end), targetRange: CompilerSourceRange(start: first.start, end: first.end, next: first.end), diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    if comma1.kind != .comma {
        return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderDeclarative(), headerRange: invalidRange, executableBodyRange: bodyRange, targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
    }
    return CompilerMacroCapabilityHeader(status: compilerMacroCapabilityHeaderMalformed(), headerRange: CompilerSourceRange(start: first.start, end: comma1.end, next: comma1.end), executableBodyRange: CompilerSourceRange(start: comma1.end, end: bodyRange.end, next: bodyRange.end), targetRange: invalidRange, diagnosticsRange: invalidRange, graphRange: invalidRange)
}

function compilerCoreParseMacroDeclarationParts(source: String, keyword: RangeLexedToken, visibility: Int, declarationStart: Int): Optional<CompilerMacroDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseMacroNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil { return nil }
    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackTokenAt(index: compilerCoreRangeTokenEnd(token: keyword)))
    let invalidRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: nameToken))
    state genericRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: compilerCoreRangeTokenEnd(token: nameToken))
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        genericRange: maybeGeneric ?? CompilerSourceRange(start: compilerCoreRangeTokenEnd(token: nameToken), end: compilerCoreRangeTokenEnd(token: nameToken), next: compilerCoreRangeTokenEnd(token: nameToken))
    }
    state parameterStart: Int(compilerCoreRangeTokenEnd(token: nameToken))
    if maybeGeneric != nil { parameterStart: genericRange.next }
    let parameterCursor: CompilerTokenCursor(source: $source, index: parameterStart)
    let maybeParameter: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: parameterCursor, leftKind: .leftParen, rightKind: .rightParen))
    if maybeParameter == nil { return nil }
    let parameterRange: CompilerSourceRange(
        maybeParameter ?? CompilerSourceRange(start: compilerCoreRangeTokenEnd(token: nameToken), end: compilerCoreRangeTokenEnd(token: nameToken), next: compilerCoreRangeTokenEnd(token: nameToken))
    )
    let separatorCursor: CompilerTokenCursor(source: $source, index: parameterRange.next)
    let maybeSeparator: Optional<RangeLexedToken>(compilerCursorPeek(cursor: separatorCursor))
    if maybeSeparator == nil { return nil }
    let separator: RangeLexedToken(
        maybeSeparator ?? compilerFallbackToken(cursor: separatorCursor)
    )
    state targetType: CompilerTypeReference(text: String(""), start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset())
    state expansionType: CompilerTypeReference(text: String(""), start: 0 - 1, end: 0 - 1)
    state hasExpansion: Bool(false)
    state bodyCursor: CompilerTokenCursor(source: $source, index: separatorCursor.index)
    if separator.kind == .colon {
        let targetCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: separatorCursor, token: separator))
        let maybeTarget: Optional<CompilerTypeReference>(compilerCoreParseMacroSurfaceTypeReference(cursor: targetCursor))
        if maybeTarget == nil { return nil }
        targetType: maybeTarget ?? CompilerTypeReference(text: String(""), start: targetCursor.index, end: targetCursor.index)
        bodyCursor: CompilerTokenCursor(source: $source, index: targetType.end)
        let maybeArrow: Optional<RangeLexedToken>(compilerCursorPeek(cursor: bodyCursor))
        if maybeArrow != nil {
            let arrow: RangeLexedToken(
                maybeArrow ?? compilerFallbackToken(cursor: bodyCursor)
            )
            if arrow.kind == .arrow {
                let expansionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: bodyCursor, token: arrow))
                let maybeExpansion: Optional<CompilerTypeReference>(compilerCoreParseMacroSurfaceTypeReference(cursor: expansionCursor))
                if maybeExpansion == nil { return nil }
                expansionType: maybeExpansion ?? CompilerTypeReference(text: String(""), start: expansionCursor.index, end: expansionCursor.index)
                hasExpansion: true
                bodyCursor: CompilerTokenCursor(source: $source, index: expansionType.end)
            }
        }
    } else if separator.kind == .arrow {
        let expansionCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: separatorCursor, token: separator))
        let maybeExpansion: Optional<CompilerTypeReference>(compilerCoreParseMacroSurfaceTypeReference(cursor: expansionCursor))
        if maybeExpansion == nil { return nil }
        expansionType: maybeExpansion ?? CompilerTypeReference(text: String(""), start: expansionCursor.index, end: expansionCursor.index)
        hasExpansion: true
        bodyCursor: CompilerTokenCursor(source: $source, index: expansionType.end)
    } else {
        return nil
    }
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: .leftBrace, rightKind: .rightBrace))
    if maybeBody == nil { return nil }
    let bodyRange: CompilerSourceRange(
        maybeBody ?? CompilerSourceRange(start: bodyCursor.index, end: bodyCursor.index, next: bodyCursor.index)
    )
    let capabilityHeader: CompilerMacroCapabilityHeader(compilerCoreParseMacroCapabilityHeader(source: source, bodyRange: bodyRange))
    return CompilerMacroDeclarationParts(nameToken: nameToken, genericRange: genericRange, parameterRange: parameterRange, targetType: targetType, expansionType: expansionType, hasExpansionType: hasExpansion, bodyRange: bodyRange, capabilityStatus: capabilityHeader.status, capabilityHeaderRange: capabilityHeader.headerRange, executableBodyRange: capabilityHeader.executableBodyRange, targetCapabilityRange: capabilityHeader.targetRange, diagnosticsCapabilityRange: capabilityHeader.diagnosticsRange, graphCapabilityRange: capabilityHeader.graphRange, declarationStart: declarationStart, visibility: visibility)
}

function compilerCoreParseBodyRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(source: $source, index: nameToken.end)
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftBrace, rightKind: .rightBrace)
}

function compilerCoreParseParameterRangeAfterName(source: String, nameToken: RangeLexedToken): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(source: $source, index: nameToken.end)
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftParen, rightKind: .rightParen)
}

function compilerCoreParseReturnTypeAfterParameters(source: String, parameterRange: CompilerSourceRange): Optional<CompilerTypeReference> {
    return compilerCoreParseReturnTypeAfterParametersWithEnd(source: source, parameterRange: parameterRange, fileEnd: stringLength(value: source))
}

function compilerCoreParseReturnTypeAfterParametersWithEnd(source: String, parameterRange: CompilerSourceRange, fileEnd: Int): Optional<CompilerTypeReference> {
    state cursor: CompilerTokenCursor(source: $source, index: parameterRange.start)
    cursor: CompilerTokenCursor(source: $source, index: parameterRange.next)
    let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeColon == nil {
        return CompilerTypeReference(text: String("Void"), start: parameterRange.next, end: parameterRange.next)
    }

    let colonToken: RangeLexedToken(
        maybeColon ?? compilerFallbackToken(cursor: cursor)
    )
    if colonToken.kind != .colon {
        return CompilerTypeReference(text: String("Void"), start: parameterRange.next, end: parameterRange.next)
    }

    let typeCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: cursor, token: colonToken))
    return compilerCoreParseTypeReferenceWithEnd(cursor: typeCursor, end: fileEnd)
}

function compilerCoreParseFunctionBodyAfterReturnType(source: String, returnType: CompilerTypeReference): Optional<CompilerSourceRange> {
    let cursor: CompilerTokenCursor(source: $source, index: returnType.end)
    return compilerCoreParseBalancedRange(cursor: cursor, leftKind: .leftBrace, rightKind: .rightBrace)
}

function compilerCoreParseConstructDeclarationParts(source: String, keyword: RangeLexedToken): Optional<CompilerConstructDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseDeclarationNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackTokenAt(index: keyword.end))
    state genericRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: nameToken.end)
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        genericRange: maybeGeneric ?? CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end)
    }
    let bodyCursor: CompilerTokenCursor(source: $source, index: genericRange.next)
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: bodyCursor, leftKind: .leftBrace, rightKind: .rightBrace))
    if maybeBody == nil {
        return nil
    }

    let bodyRange: CompilerSourceRange(
        maybeBody ?? CompilerSourceRange(start: genericRange.next, end: genericRange.next, next: genericRange.next)
    )
    return CompilerConstructDeclarationParts(nameToken: nameToken, genericRange: genericRange, bodyRange: bodyRange)
}

function compilerCoreParseFunctionDeclarationParts(source: String, keyword: RangeLexedToken): Optional<CompilerFunctionDeclarationParts> {
    return compilerCoreParseFunctionDeclarationPartsWithEnd(source: source, keyword: keyword, fileEnd: stringLength(value: source))
}

function compilerCoreParseFunctionDeclarationPartsWithEnd(source: String, keyword: RangeLexedToken, fileEnd: Int): Optional<CompilerFunctionDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseFunctionNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil {
        return nil
    }

    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackTokenAt(index: keyword.end))
    state genericRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: nameToken.end)
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        genericRange: maybeGeneric ?? CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end)
    }
    let parameterCursor: CompilerTokenCursor(source: $source, index: genericRange.next)
    let maybeParameters: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: parameterCursor, leftKind: .leftParen, rightKind: .rightParen))
    if maybeParameters == nil {
        return nil
    }

    let parameterRange: CompilerSourceRange(
        maybeParameters ?? CompilerSourceRange(start: genericRange.next, end: genericRange.next, next: genericRange.next)
    )
    let maybeReturnType: Optional<CompilerTypeReference>(compilerCoreParseReturnTypeAfterParametersWithEnd(source: source, parameterRange: parameterRange, fileEnd: fileEnd))
    if maybeReturnType == nil {
        return nil
    }

    let returnType: CompilerTypeReference(
        maybeReturnType ?? CompilerTypeReference(text: String(""), start: parameterRange.next, end: parameterRange.next)
    )
    let maybeBody: Optional<CompilerSourceRange>(compilerCoreParseFunctionBodyAfterReturnType(source: source, returnType: returnType))
    let bodyRange: CompilerSourceRange(
        maybeBody ?? CompilerSourceRange(start: returnType.end, end: returnType.end, next: returnType.end)
    )
    return CompilerFunctionDeclarationParts(nameToken: nameToken, genericRange: genericRange, parameterRange: parameterRange, returnType: returnType, bodyRange: bodyRange)
}
