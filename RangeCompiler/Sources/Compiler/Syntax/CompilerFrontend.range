                compilerSyntaxTablesPoison(tables: tables)
                return 0 - 1
            }
            sourceIndex: statement.end
            statementOrdinal: statementOrdinal + 1
        }
    }
    return 0
}

function compilerTypedSyntaxCaptureBlock(source: String, tables: CompilerSyntaxTables, fileID: Int, ownerSyntaxID: Int, roleTag: Int, start: Int, end: Int): Int {
