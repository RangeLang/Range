function compilerMacroExecutionPrepareFunctionArena(arena: CompilerBodyArena, index: CompilerDeclarationIndex): Int {
    let emptyReturnModes: Buffer<Int>(bufferCreateInt(capacity: 0))
    let emptyParticipants: Buffer<Int>(bufferCreateInt(capacity: 0))
    let emptyTypeKeys: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyColumnCount(), estimatedRowCount: 0))
    let emptyTypeKeyArguments: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyArgumentColumnCount(), estimatedRowCount: 0))
    let emptyEffectPaths: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectPathColumnCount(), estimatedRowCount: 0))
    let emptyReturnSummaries: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnSummaryColumnCount(), estimatedRowCount: 0))
    let emptyReturnLeaves: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnLeafColumnCount(), estimatedRowCount: 0))
    let abiPlan: CompilerModuleABIPlan(returnModes: $emptyReturnModes, participants: $emptyParticipants, isFrozen: false)
    state status: Int(0)
    if arena.failures.count != 0 || !compilerBodyArenaIsValid(arena: arena) { status: 0 - 1 }
    if status == 0 && compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: index) != 0 { status: 0 - 1 }
    if status == 0 && compilerBodyArenaBuildCFG(arena: arena) != 0 { status: 0 - 1 }
    if status == 0 {
        let memoryStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: abiPlan, typeKeys: emptyTypeKeys, typeKeyArguments: emptyTypeKeyArguments, effects: arena.tables.bodyNodes, effectPaths: emptyEffectPaths, returnSummaries: emptyReturnSummaries, returnLeaves: emptyReturnLeaves, applyInstanceEffects: false, recordOwnedFacts: false))
        if memoryStatus != 0 { status: 0 - 1 }
    }
    if status == 0 && compilerBodyMIRBuild(arena: arena) != 0 { status: 0 - 1 }
    if status == 0 && compilerBodyMIRValidationCode(arena: arena, abiPlan: abiPlan) != 0 { status: 0 - 1 }
    compilerIntTableDestroy(table: emptyTypeKeys)
    compilerIntTableDestroy(table: emptyTypeKeyArguments)
    compilerIntTableDestroy(table: emptyEffectPaths)
    compilerIntTableDestroy(table: emptyReturnSummaries)
    compilerIntTableDestroy(table: emptyReturnLeaves)
    emptyReturnModes.destroy()
    emptyParticipants.destroy()
    return status
}

function compilerMacroExecutionSeedClosureInput(arena: CompilerBodyArena, nameStart: Int, nameEnd: Int, typeKind: Int, typeID: Int): Int {
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: nameStart))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: nameEnd))
    let declarationNodeID: Int(compilerBodyArenaAppendNode(arena: arena, kind: compilerSyntaxKindIdentifier(), ordinal: 0, start: globalStart, end: globalEnd, firstStart: globalStart, firstEnd: globalEnd, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    let symbolID: Int(compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolClosureParameter(), declarationRef: declarationNodeID, regionNodeID: arena.rootNodeID, nameStart: nameStart, nameEnd: nameEnd, typeStart: nameStart, typeEnd: nameEnd))
    if declarationNodeID < 0 || symbolID < 0
        || compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: declarationNodeID, targetKind: compilerBodyResolutionLocalSymbol(), targetID: symbolID, typeKind: typeKind, typeID: typeID, regionNodeID: arena.rootNodeID) != 0 { return 0 - 1 }
    return 0
}

function compilerMacroExecutionClosureCaptureSymbol(parentArena: CompilerBodyArena, parentOperationRow: Int, closureNodeID: Int, captureOrdinal: Int): Int {
    if parentOperationRow < 0 || parentOperationRow >= compilerIntTableRowCount(table: parentArena.mirOperations)
        || closureNodeID < 0 || captureOrdinal < 0 { return 0 - 1 }
    let operationKind: Int(compilerIntTableValue(table: parentArena.mirOperations, row: parentOperationRow, column: compilerBodyMIROperationKindColumn()))
    if (operationKind != compilerBodyMIROperationMacroCollectionFilter()
            && operationKind != compilerBodyMIROperationMacroCollectionMap())
        || compilerIntTableValue(table: parentArena.mirOperations, row: parentOperationRow, column: compilerBodyMIROperationTargetIDColumn()) != closureNodeID { return 0 - 1 }
    let captureValueID: Int(compilerBodyMIROperationOperandValue(arena: parentArena, operationID: parentOperationRow, ordinal: captureOrdinal + 1))
    if captureValueID < 0 || captureValueID >= compilerIntTableRowCount(table: parentArena.mirValues)
        || compilerIntTableValue(table: parentArena.mirValues, row: captureValueID, column: compilerBodyMIRValueProvenanceKindColumn()) != compilerBodyMemorySubjectSymbol() { return 0 - 1 }
    return compilerIntTableValue(table: parentArena.mirValues, row: captureValueID, column: compilerBodyMIRValueProvenanceIDColumn())
}

function compilerMacroExecutionClosureCaptureCount(parentArena: CompilerBodyArena, parentOperationRow: Int, closureNodeID: Int): Int {
    if parentOperationRow < 0 || parentOperationRow >= compilerIntTableRowCount(table: parentArena.mirOperations)
        || closureNodeID < 0 { return 0 - 1 }
    let operationKind: Int(compilerIntTableValue(table: parentArena.mirOperations, row: parentOperationRow, column: compilerBodyMIROperationKindColumn()))
    if (operationKind != compilerBodyMIROperationMacroCollectionFilter()
            && operationKind != compilerBodyMIROperationMacroCollectionMap())
        || compilerIntTableValue(table: parentArena.mirOperations, row: parentOperationRow, column: compilerBodyMIROperationTargetIDColumn()) != closureNodeID { return 0 - 1 }
    let operandCount: Int(compilerIntTableValue(table: parentArena.mirOperations, row: parentOperationRow, column: compilerBodyMIROperationOperandCountColumn()))
    if operandCount < 1 { return 0 - 1 }
    return operandCount - 1
}

function compilerMacroExecutionPrepareClosureArena(arena: CompilerBodyArena, parentArena: CompilerBodyArena, parentOperationRow: Int, closureNodeID: Int, index: CompilerDeclarationIndex): Int {
    let parameterNodeID: Int(compilerBodyArenaChild(arena: parentArena, ownerNodeID: closureNodeID, role: compilerSyntaxRoleClosureParameter(), ordinal: 0))
    let parameterResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: parentArena, sourceNodeID: parameterNodeID))
    if arena.failures.count != 0 || parameterNodeID < 0 || parameterResolutionRow < 0
        || compilerMacroExecutionSeedClosureInput(
            arena: arena,
            nameStart: compilerIntTableValue(table: parentArena.nodes, row: parameterNodeID, column: 6),
            nameEnd: compilerIntTableValue(table: parentArena.nodes, row: parameterNodeID, column: 7),
            typeKind: compilerIntTableValue(table: parentArena.resolutions, row: parameterResolutionRow, column: compilerBodyResolutionTypeKindColumn()),
            typeID: compilerIntTableValue(table: parentArena.resolutions, row: parameterResolutionRow, column: compilerBodyResolutionTypeIDColumn())
        ) != 0 { return 0 - 101 }
    let expectedCaptureCount: Int(compilerMacroExecutionClosureCaptureCount(parentArena: parentArena, parentOperationRow: parentOperationRow, closureNodeID: closureNodeID))
    if expectedCaptureCount < 0 { return 0 - 102 }
    state captureOrdinal: Int(0)
    state status: Int(0)
    while captureOrdinal < expectedCaptureCount && status == 0 {
        let symbolID: Int(compilerMacroExecutionClosureCaptureSymbol(parentArena: parentArena, parentOperationRow: parentOperationRow, closureNodeID: closureNodeID, captureOrdinal: captureOrdinal))
        if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: parentArena.symbols) {
            status: 0 - 102
        } else {
            if compilerMacroExecutionSeedClosureInput(
                arena: arena,
                nameStart: compilerIntTableValue(table: parentArena.symbols, row: symbolID, column: compilerBodySymbolNameStartColumn()),
                nameEnd: compilerIntTableValue(table: parentArena.symbols, row: symbolID, column: compilerBodySymbolNameEndColumn()),
                typeKind: compilerBodyArenaSymbolTypeKind(arena: parentArena, symbolID: symbolID),
                typeID: compilerBodyArenaSymbolTypeID(arena: parentArena, symbolID: symbolID)
            ) != 0 { status: 0 - 102 }
        }
        captureOrdinal: captureOrdinal + 1
    }
    if status != 0 { return status }
    if !compilerBodyArenaIsValid(arena: arena) { return 0 - 103 }
    if compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: arena.rootNodeID) != 0 { return 0 - 104 }
    let emptyReturnModes: Buffer<Int>(bufferCreateInt(capacity: 0))
    let emptyParticipants: Buffer<Int>(bufferCreateInt(capacity: 0))
    let emptyTypeKeys: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyColumnCount(), estimatedRowCount: 0))
    let emptyTypeKeyArguments: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyArgumentColumnCount(), estimatedRowCount: 0))
    let emptyEffectPaths: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectPathColumnCount(), estimatedRowCount: 0))
    let emptyReturnSummaries: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnSummaryColumnCount(), estimatedRowCount: 0))
    let emptyReturnLeaves: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnLeafColumnCount(), estimatedRowCount: 0))
    let abiPlan: CompilerModuleABIPlan(returnModes: $emptyReturnModes, participants: $emptyParticipants, isFrozen: false)
    if compilerBodyArenaBuildCFG(arena: arena) != 0 { status: 0 - 105 }
    if status == 0 {
        let memoryStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: abiPlan, typeKeys: emptyTypeKeys, typeKeyArguments: emptyTypeKeyArguments, effects: arena.tables.bodyNodes, effectPaths: emptyEffectPaths, returnSummaries: emptyReturnSummaries, returnLeaves: emptyReturnLeaves, applyInstanceEffects: false, recordOwnedFacts: false))
        if memoryStatus != 0 { status: 0 - (2000 + memoryStatus) }
    }
    if status == 0 && compilerBodyMIRBuild(arena: arena) != 0 { status: 0 - 106 }
    if status == 0 {
        let mirValidationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: abiPlan))
        if mirValidationCode != 0 { status: 0 - (3000 + mirValidationCode) }
    }
    compilerIntTableDestroy(table: emptyTypeKeys)
    compilerIntTableDestroy(table: emptyTypeKeyArguments)
    compilerIntTableDestroy(table: emptyEffectPaths)
    compilerIntTableDestroy(table: emptyReturnSummaries)
    compilerIntTableDestroy(table: emptyReturnLeaves)
    emptyReturnModes.destroy()
    emptyParticipants.destroy()
    return status
}

function compilerMacroExecutionEvaluatePreparedArena(
    arena: CompilerBodyArena,
    index: CompilerDeclarationIndex,
    store: CompilerMacroValueStore,
    arguments: Buffer<Int>,
    depth: Int
): CompilerMacroFunctionOutcome {
    if depth > 16 {
        return CompilerMacroFunctionOutcome(status: 0 - 601, valueID: 0 - 1, stepCount: 0)
    }
    state status: Int(0)
    let values: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.mirValues)))
    state valueRow: Int(0)
    while valueRow < compilerIntTableRowCount(table: arena.mirValues) {
        values.append(element: 0 - 1)
        valueRow: valueRow + 1
    }
    state argumentOrdinal: Int(0)
    valueRow: 0
    while valueRow < compilerIntTableRowCount(table: arena.mirValues) && status == 0 {
        if compilerIntTableValue(table: arena.mirValues, row: valueRow, column: compilerBodyMIRValueKindColumn()) == compilerBodyMIRValueParameter() {
            if argumentOrdinal < arguments.count {
                if values.update(element: arguments.element(index: argumentOrdinal), index: valueRow) != 0 {
                    status: 0 - 603
                }
                argumentOrdinal: argumentOrdinal + 1
            }
        }
        valueRow: valueRow + 1
    }
    if argumentOrdinal != arguments.count { status: 0 - 604 }
    state resultValueID: Int(0 - 1)
    state stepCount: Int(0)
    state currentBlockID: Int(0)
    state previousBlockID: Int(0 - 1)
    state running: Bool(status == 0)
    while running && status == 0 {
        if currentBlockID < 0 || currentBlockID >= compilerIntTableRowCount(table: arena.mirBlocks) {
            status: 0 - 605
        } else {
            let firstOperation: Int(compilerIntTableValue(table: arena.mirBlocks, row: currentBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
            let operationCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: currentBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
            state ordinal: Int(0)
            while ordinal < operationCount && running && status == 0 {
                let operationRow: Int(firstOperation + ordinal)
                let operationKind: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationKindColumn()))
                stepCount: stepCount + 1
                if stepCount > compilerMacroExecutionBudgetDefault() * 4 {
                    status: 0 - 606
                } else if operationKind == compilerBodyMIROperationDirectCall() {
                    let targetKind: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetKindColumn()))
                    let targetID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
                    let operandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
                    let callArguments: Buffer<Int>(bufferCreateInt(capacity: operandCount))
                    state callOrdinal: Int(0)
                    while callOrdinal < operandCount && status == 0 {
                        let operandValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: callOrdinal))
                        if operandValueID < 0 || operandValueID >= values.count
                            || values.element(index: operandValueID) < 0
                            || callArguments.append(element: values.element(index: operandValueID)) != 0 { status: 0 - 610 }
                        callOrdinal: callOrdinal + 1
                    }
                    if status == 0 && targetKind == compilerBodyMIROperationTargetFunction() {
                        let callOutcome: CompilerMacroFunctionOutcome(compilerMacroExecutionEvaluateFunction(tables: arena.tables, index: index, store: store, functionRow: targetID, arguments: callArguments, depth: depth + 1))
                        stepCount: stepCount + callOutcome.stepCount
                        let callResultMIRValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
                        if callOutcome.status != 0 || callResultMIRValueID < 0
                            || values.update(element: callOutcome.valueID, index: callResultMIRValueID) != 0 { status: 0 - 611 }
                    } else if status == 0 {
                        status: 0 - 612
                    }
                    callArguments.destroy()
                } else {
                    let valueStatus: Int(compilerMacroExecutionEvaluateValueOperation(arena: arena, index: index, store: store, evaluationValues: values, currentBlockID: currentBlockID, previousBlockID: previousBlockID, targetSyntaxID: 0 - 1, operationRow: operationRow, operationKind: operationKind, depth: depth))
                    if valueStatus < 0 {
                        status: valueStatus
                    } else if valueStatus == 0 {
                        if operationKind == compilerBodyMIROperationReturn() {
                            let returnOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
                            if returnOperandCount == 1 {
                                let returnMIRValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
                                if returnMIRValueID < 0 || returnMIRValueID >= values.count { status: 0 - 621 } else { resultValueID: values.element(index: returnMIRValueID) }
                            } else if returnOperandCount != 0 {
                                status: 0 - 622
                            }
                            running: false
                        } else if operationKind != compilerBodyMIROperationCondBranch() && operationKind != compilerBodyMIROperationBranch() {
                            status: 0 - 620
                        }
                    }
                }
                ordinal: ordinal + 1
            }
            if status == 0 && running {
                let terminatorRow: Int(firstOperation + operationCount - 1)
                let terminatorKind: Int(compilerIntTableValue(table: arena.mirOperations, row: terminatorRow, column: compilerBodyMIROperationKindColumn()))
                state nextBlockID: Int(0 - 1)
                if terminatorKind == compilerBodyMIROperationCondBranch() {
                    let conditionMIRValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: terminatorRow, ordinal: 0))
                    if conditionMIRValueID < 0 || conditionMIRValueID >= values.count {
                        status: 0 - 630
                    } else if compilerMacroValueStoreScalar(store: store, valueID: values.element(index: conditionMIRValueID)) != 0 {
                        nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeTrue())
                    } else {
                        nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeFalse())
                    }
                } else if terminatorKind == compilerBodyMIROperationBranch() {
                    nextBlockID: compilerMacroExecutionBranchTarget(arena: arena, blockID: currentBlockID)
                } else if terminatorKind == compilerBodyMIROperationReturn() {
                    running: false
                } else {
                    status: 0 - 631
                }
                if status == 0 && running {
                    previousBlockID: currentBlockID
                    currentBlockID: nextBlockID
                }
            }
        }
    }
    values.destroy()
    return CompilerMacroFunctionOutcome(status: status, valueID: resultValueID, stepCount: stepCount)
}

function compilerMacroExecutionEvaluateClosure(parentArena: CompilerBodyArena, index: CompilerDeclarationIndex, store: CompilerMacroValueStore, parentOperationRow: Int, closureNodeID: Int, arguments: Buffer<Int>, depth: Int): CompilerMacroFunctionOutcome {
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateClosure(parentArena: parentArena, closureNodeID: closureNodeID)))
    let preparationStatus: Int(compilerMacroExecutionPrepareClosureArena(arena: arena, parentArena: parentArena, parentOperationRow: parentOperationRow, closureNodeID: closureNodeID, index: index))
    if preparationStatus != 0 {
        compilerBodyArenaDestroy(arena: arena)
        return CompilerMacroFunctionOutcome(status: preparationStatus, valueID: 0 - 1, stepCount: 0)
    }
    let outcome: CompilerMacroFunctionOutcome(compilerMacroExecutionEvaluatePreparedArena(arena: arena, index: index, store: store, arguments: arguments, depth: depth))
    compilerBodyArenaDestroy(arena: arena)
    return outcome
}

function compilerMacroExecutionEvaluateFunction(
    tables: CompilerSyntaxTables,
    index: CompilerDeclarationIndex,
    store: CompilerMacroValueStore,
    functionRow: Int,
    arguments: Buffer<Int>,
    depth: Int
): CompilerMacroFunctionOutcome {
    if depth > 16 || functionRow < 0 || functionRow >= compilerIntTableRowCount(table: tables.functions) {
        return CompilerMacroFunctionOutcome(status: 0 - 1, valueID: 0 - 1, stepCount: 0)
    }
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreate(tables: tables, index: index, functionRow: functionRow)))
    let preparationStatus: Int(compilerMacroExecutionPrepareFunctionArena(arena: arena, index: index))
    if preparationStatus != 0 {
        compilerBodyArenaDestroy(arena: arena)
        return CompilerMacroFunctionOutcome(status: 0 - 1, valueID: 0 - 1, stepCount: 0)
    }
    let outcome: CompilerMacroFunctionOutcome(compilerMacroExecutionEvaluatePreparedArena(arena: arena, index: index, store: store, arguments: arguments, depth: depth))
    compilerBodyArenaDestroy(arena: arena)
    return outcome
}

function compilerMacroExecutionParameterValueText(
    tables: CompilerSyntaxTables,
    applicationRow: Int,
    parameterRow: Int
): String {
    if applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications)
        || parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: tables.macroParameters) { return String("") }
    let macroDeclarationRow: Int(compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 1))
    let declarationFileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: macroDeclarationRow, column: 1))
    let parameterName: String(compilerTypedSyntaxLocalText(
        tables: tables,
        fileID: declarationFileID,
        localStart: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 5),
        localEnd: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 6)
    ))
    let applicationFileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    state valueText: String("")
    let argumentStartLocal: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 8))
    let argumentEndLocal: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 9))
    if argumentStartLocal >= 0 && argumentEndLocal > argumentStartLocal {
        let arguments: String(compilerTypedSyntaxLocalText(tables: tables, fileID: applicationFileID, localStart: argumentStartLocal, localEnd: argumentEndLocal))
        let label: String("\(parameterName):")
        let labelStart: Int(stringIndexOf(source: arguments, needle: label, start: 0))
        if labelStart >= 0 {
            let valueStart: Int(labelStart + stringLength(value: label))
            let maybeValueToken: Optional<RangeLexedToken>(lexNextRangeToken(source: arguments, start: valueStart))
            if maybeValueToken != nil {
                let valueToken: RangeLexedToken(maybeValueToken ?? compilerFallbackTokenAt(index: valueStart))
                valueText: valueToken.text
            }
        } else {
            let parameterText: String(compilerTypedSyntaxLocalText(
                tables: tables,
                fileID: declarationFileID,
                localStart: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 3),
                localEnd: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 4)
            ))
            let maybeExternalLabel: Optional<RangeLexedToken>(lexNextRangeToken(source: parameterText, start: 0))
            if maybeExternalLabel != nil {
                let externalLabel: RangeLexedToken(maybeExternalLabel ?? compilerFallbackTokenAt(index: 0))
                if externalLabel.text == String("_") {
                    let maybeArgumentToken: Optional<RangeLexedToken>(lexNextRangeToken(source: arguments, start: 0))
                    if maybeArgumentToken != nil {
                        let argumentToken: RangeLexedToken(maybeArgumentToken ?? compilerFallbackTokenAt(index: 0))
                        let maybeArgumentFollowing: Optional<RangeLexedToken>(lexNextRangeToken(source: arguments, start: argumentToken.end))
                        state isLabeled: Bool(false)
                        if maybeArgumentFollowing != nil {
                            let argumentFollowing: RangeLexedToken(maybeArgumentFollowing ?? compilerFallbackTokenAt(index: argumentToken.end))
                            if argumentFollowing.kind == .colon { isLabeled: true }
                        }
                        if !isLabeled { valueText: argumentToken.text }
                    }
                }
            }
        }
    }
    if valueText == String("") {
        let typeEndGlobal: Int(compilerSourceStoreGlobalOffset(
            store: tables.sourceStore,
            fileID: declarationFileID,
            localOffset: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 8)
        ))
        let parameterEndGlobal: Int(compilerSourceStoreGlobalOffset(
            store: tables.sourceStore,
            fileID: declarationFileID,
            localOffset: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 4)
        ))
        let maybeDefaultStart: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: typeEndGlobal))
        if maybeDefaultStart != nil {
            let defaultStart: RangeLexedToken(maybeDefaultStart ?? compilerFallbackTokenAt(index: typeEndGlobal))
            if defaultStart.start < parameterEndGlobal
                && (defaultStart.kind == .leftParen || defaultStart.kind == .equal) {
                let maybeDefaultValue: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: defaultStart.end))
                if maybeDefaultValue != nil {
                    let defaultValue: RangeLexedToken(maybeDefaultValue ?? compilerFallbackTokenAt(index: defaultStart.end))
                    if defaultValue.start < parameterEndGlobal { valueText: defaultValue.text }
                }
            }
        }
    }
    return valueText
}

function compilerMacroExecutionParameterValue(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    applicationRow: Int,
    parameterRow: Int,
    typeKind: Int,
    typeID: Int
): Int {
    if parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: tables.macroParameters) { return 0 - 1 }
    let expansionBindingRow: Int(compilerMacroExpansionBindingForParameter(tables: tables, applicationRow: applicationRow, parameterRow: parameterRow))
    if expansionBindingRow >= 0 {
        return compilerMacroExpansionBindingMaterialize(tables: tables, store: store, bindingRow: expansionBindingRow)
    }
    let macroDeclarationRow: Int(compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 1))
    let declarationFileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: macroDeclarationRow, column: 1))
    let parameterType: String(compilerTypedSyntaxLocalText(
        tables: tables,
        fileID: declarationFileID,
        localStart: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 7),
        localEnd: compilerIntTableValue(table: tables.macroParameters, row: parameterRow, column: 8)
    ))
    let valueText: String(compilerMacroExecutionParameterValueText(
        tables: tables,
        applicationRow: applicationRow,
        parameterRow: parameterRow
    ))
    if parameterType == String("Bool") {
        if valueText == String("true") {
            return compilerMacroValueStoreAppendScalar(store: store, typeKind: typeKind, typeID: typeID, scalar: 1)
        }
        if valueText == String("false") {
            return compilerMacroValueStoreAppendScalar(store: store, typeKind: typeKind, typeID: typeID, scalar: 0)
        }
        return 0 - 1
    }
    if parameterType == String("String") {
        if stringLength(value: valueText) < 2 { return 0 - 1 }
        return compilerMacroValueStoreAppendScalar(
            store: store,
            typeKind: typeKind,
            typeID: typeID,
            scalar: compilerDeclarationNameHash(name: compilerCoreStringLiteralContent(text: valueText))
        )
    }
    if parameterType == String("String?") {
        let optionalChildren: Buffer<Int>(bufferCreateInt(capacity: 1))
        state optionalScalar: Int(0)
        state optionalValid: Bool(valueText == String("nil"))
        if !optionalValid && stringLength(value: valueText) >= 2 {
            let stringValueID: Int(compilerMacroValueStoreAppendScalar(
                store: store,
                typeKind: compilerBodyTypeString(),
                typeID: 0 - 1,
                scalar: compilerDeclarationNameHash(name: compilerCoreStringLiteralContent(text: valueText))
            ))
            if stringValueID >= 0 && optionalChildren.append(element: stringValueID) == 0 {
                optionalScalar: 1
                optionalValid: true
            }
        }
        state optionalValueID: Int(0 - 1)
        if optionalValid {
            optionalValueID: compilerMacroValueStoreAppendAggregate(
                store: store,
                kind: compilerMacroValueKindEnum(),
                typeKind: typeKind,
                typeID: typeID,
                scalar: optionalScalar,
                children: optionalChildren
            )
        }
        optionalChildren.destroy()
        return optionalValueID
    }
    return 0 - 1
}

function compilerMacroExecutionEvaluateInvocation(tables: CompilerSyntaxTables, arena: CompilerBodyArena, graphDelta: CompilerGraphDelta, pendingOmissionTargets: Buffer<Int>, applicationRow: Int, declarationRow: Int, invocationRow: Int, bodyStart: Int, bodyEnd: Int): CompilerMacroEvaluationOutcome {
    state status: Int(0)
    state diagnosticCode: Int(0)
    state eventCount: Int(0)
    state readDependencyCount: Int(0)
    state mirOperationCount: Int(0)
    state stepCount: Int(0)
    state resultStoreValueID: Int(0 - 1)
    let expansionTypeStart: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 13))
    let expansionTypeEnd: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 14))
    state expectsResult: Bool(expansionTypeStart >= 0 && expansionTypeEnd > expansionTypeStart)
    if expectsResult
        && compilerTypedSyntaxLocalText(
            tables: tables,
            fileID: compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1),
            localStart: expansionTypeStart,
            localEnd: expansionTypeEnd
        ) == String("Void") {
        expectsResult: false
    }
    let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 12))
    let valueStore: CompilerMacroValueStore(compilerMacroValueStoreCreate())
    let evaluationValues: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.mirValues)))
    state evaluationValueRow: Int(0)
    while evaluationValueRow < compilerIntTableRowCount(table: arena.mirValues) {
        evaluationValues.append(element: 0 - 1)
        evaluationValueRow: evaluationValueRow + 1
    }
    let environmentValueID: Int(compilerMacroExecutionMaterializeEnvironment(
        tables: tables,
        store: valueStore,
        invocationRow: invocationRow,
        targetSyntaxID: targetSyntaxID
    ))
    state environmentParameterBound: Bool(false)
    evaluationValueRow: 0
    while evaluationValueRow < compilerIntTableRowCount(table: arena.mirValues) && !environmentParameterBound {
        if compilerIntTableValue(table: arena.mirValues, row: evaluationValueRow, column: compilerBodyMIRValueKindColumn()) == compilerBodyMIRValueParameter() {
            if environmentValueID >= 0
                && evaluationValues.update(element: environmentValueID, index: evaluationValueRow) == 0 {
                environmentParameterBound: true
            }
        }
        evaluationValueRow: evaluationValueRow + 1
    }
    let firstMacroParameterRow: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 23))
    let macroParameterCount: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 24))
    state macroParameterOrdinal: Int(0)
    state seenEnvironmentParameter: Bool(false)
    state macroParametersBound: Bool(true)
    evaluationValueRow: 0
    while evaluationValueRow < compilerIntTableRowCount(table: arena.mirValues)
        && macroParameterOrdinal < macroParameterCount
        && macroParametersBound {
        if compilerIntTableValue(table: arena.mirValues, row: evaluationValueRow, column: compilerBodyMIRValueKindColumn()) == compilerBodyMIRValueParameter() {
            if !seenEnvironmentParameter {
                seenEnvironmentParameter: true
            } else {
                let parameterValueID: Int(compilerMacroExecutionParameterValue(
                    tables: tables,
                    store: valueStore,
                    applicationRow: applicationRow,
                    parameterRow: firstMacroParameterRow + macroParameterOrdinal,
                    typeKind: compilerIntTableValue(table: arena.mirValues, row: evaluationValueRow, column: compilerBodyMIRValueTypeColumn()),
                    typeID: compilerIntTableValue(table: arena.mirValues, row: evaluationValueRow, column: compilerBodyMIRValueTypeIDColumn())
                ))
                if parameterValueID < 0
                    || evaluationValues.update(element: parameterValueID, index: evaluationValueRow) != 0 {
                    macroParametersBound: false
                } else {
                    macroParameterOrdinal: macroParameterOrdinal + 1
                }
            }
        }
        evaluationValueRow: evaluationValueRow + 1
    }
    if macroParameterOrdinal != macroParameterCount { macroParametersBound: false }
    state invocationSteps: Int(0)
    state currentBlockID: Int(0)
    state previousBlockID: Int(0 - 1)
    state pathRunning: Bool(environmentParameterBound && macroParametersBound)
    state failureOperationRow: Int(0 - 1)
    state evaluationFailureDetail: Int(0)
    if !environmentParameterBound || !macroParametersBound {
        status: 0 - 1
        diagnosticCode: compilerMacroDiagnosticBodyInvalid()
    }
    while pathRunning && status == 0 {
        state blockValid: Bool(currentBlockID >= 0 && currentBlockID < compilerIntTableRowCount(table: arena.mirBlocks))
        if !blockValid {
            status: 0 - 1
            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
        } else {
            let blockFirstOperation: Int(compilerIntTableValue(table: arena.mirBlocks, row: currentBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
            let blockOperationCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: currentBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
            if blockOperationCount <= 0 || blockFirstOperation < 0 || blockFirstOperation + blockOperationCount > compilerIntTableRowCount(table: arena.mirOperations) {
                status: 0 - 1
                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
            } else {
                state blockOperationOrdinal: Int(0)
                while blockOperationOrdinal < blockOperationCount && pathRunning && status == 0 {
                    let operationRow: Int(blockFirstOperation + blockOperationOrdinal)
                    invocationSteps: invocationSteps + 1
                    stepCount: stepCount + 1
                    if invocationSteps > compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 8) {
                        status: 0 - 1
                        diagnosticCode: compilerMacroDiagnosticFuelExhausted()
                        failureOperationRow: operationRow
                        pathRunning: false
                    } else {
                        let operationKind: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationKindColumn()))
                        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationIDColumn()) != operationRow
                            || compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationBlockColumn()) != currentBlockID {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            failureOperationRow: operationRow
                        } else if operationKind == compilerBodyMIROperationDirectCall() {
                            let directTargetKind: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetKindColumn()))
                            let directTargetID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
                            let directOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
                            let directArguments: Buffer<Int>(bufferCreateInt(capacity: directOperandCount))
                            state directOrdinal: Int(0)
                            while directOrdinal < directOperandCount && status == 0 {
                                let directOperandValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: directOrdinal))
                                if directOperandValueID < 0 || directOperandValueID >= evaluationValues.count
                                    || evaluationValues.element(index: directOperandValueID) < 0
                                    || directArguments.append(element: evaluationValues.element(index: directOperandValueID)) != 0 {
                                    status: 0 - 1
                                    diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                    failureOperationRow: operationRow
                                }
                                directOrdinal: directOrdinal + 1
                            }
                            if status == 0 && directTargetKind == compilerBodyMIROperationTargetFunction() {
                                let directOutcome: CompilerMacroFunctionOutcome(compilerMacroExecutionEvaluateFunction(tables: tables, index: arena.declarationIndex, store: valueStore, functionRow: directTargetID, arguments: directArguments, depth: 1))
                                stepCount: stepCount + directOutcome.stepCount
                                let directResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
                                if directOutcome.status != 0 || directResultValueID < 0
                                    || evaluationValues.update(element: directOutcome.valueID, index: directResultValueID) != 0 {
                                    status: 0 - 1
                                    diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                    failureOperationRow: operationRow
                                }
                            } else if status == 0 {
                                status: 0 - 1
                                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                failureOperationRow: operationRow
                            }
                            directArguments.destroy()
                        } else if operationKind == compilerBodyMIROperationMacroDiagnostic() {
                            let operation: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
                            let messageValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 1))
                            let diagnosticOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
                            let eventIdentity: CompilerFingerprint(compilerMacroExecutionErrorIdentity(base: compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow), code: operation, row: operationRow))
                            if diagnosticOperandCount != 2 || compilerMacroExecutionAppendEvent(tables: tables, invocationRow: invocationRow, operation: operation, arena: arena, operationRow: operationRow, messageValueID: messageValueID, identity: eventIdentity) < 0 {
                                status: 0 - 1
                                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                failureOperationRow: operationRow
                            } else {
                                eventCount: eventCount + 1
                                if operation == compilerMacroOperationError() {
                                    status: 0 - 1
                                    diagnosticCode: compilerMacroDiagnosticExecutionError()
                                    failureOperationRow: operationRow
                                }
                            }
                        } else if operationKind == compilerBodyMIROperationMacroTargetExpansion() {
                            let expansionStatus: Int(compilerMacroExecutionEvaluateExpansionOperation(tables: tables, arena: arena, store: valueStore, evaluationValues: evaluationValues, graphDelta: graphDelta, pendingOmissionTargets: pendingOmissionTargets, applicationRow: applicationRow, declarationRow: declarationRow, invocationRow: invocationRow, targetSyntaxID: targetSyntaxID, currentBlockID: currentBlockID, operationRow: operationRow))
                            if expansionStatus < 0 {
                                status: 0 - 1
                                diagnosticCode: 0 - expansionStatus
                                failureOperationRow: operationRow
                            }
                        } else if operationKind == compilerBodyMIROperationMacroCapabilityDenied() {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticCapabilityDenied()
                            failureOperationRow: operationRow
                        } else if operationKind == compilerBodyMIROperationMacroGraphQuery() || operationKind == compilerBodyMIROperationMacroTargetQuery() {
                            let readStatus: Int(compilerMacroExecutionEvaluateReadOperation(tables: tables, arena: arena, store: valueStore, evaluationValues: evaluationValues, applicationRow: applicationRow, invocationRow: invocationRow, targetSyntaxID: targetSyntaxID, operationRow: operationRow, operationKind: operationKind))
                            if readStatus < 0 {
                                status: 0 - 1
                                diagnosticCode: 0 - readStatus
                                failureOperationRow: operationRow
                            } else {
                                readDependencyCount: readDependencyCount + 1
                            }
                        } else {
                            let valueStatus: Int(compilerMacroExecutionEvaluateValueOperation(arena: arena, index: arena.declarationIndex, store: valueStore, evaluationValues: evaluationValues, currentBlockID: currentBlockID, previousBlockID: previousBlockID, targetSyntaxID: targetSyntaxID, operationRow: operationRow, operationKind: operationKind, depth: 0))
                            if valueStatus < 0 {
                                status: 0 - 1
                                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                evaluationFailureDetail: 0 - valueStatus
                                failureOperationRow: operationRow
                            } else if valueStatus == 0 {
                                if operationKind != compilerBodyMIROperationCondBranch()
                                    && operationKind != compilerBodyMIROperationBranch()
                                    && operationKind != compilerBodyMIROperationReturn() {
                                    status: 0 - 1
                                    diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                    failureOperationRow: operationRow
                                } else if operationKind == compilerBodyMIROperationReturn() {
                                    let returnOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
                                    if expectsResult && returnOperandCount == 1 {
                                        let returnMIRValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
                                        if returnMIRValueID < 0 || returnMIRValueID >= evaluationValues.count
                                            || evaluationValues.element(index: returnMIRValueID) < 0 {
                                            status: 0 - 1
                                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                            failureOperationRow: operationRow
                                        } else {
                                            resultStoreValueID: evaluationValues.element(index: returnMIRValueID)
                                        }
                                    } else if expectsResult {
                                        status: 0 - 1
                                        diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                                        failureOperationRow: operationRow
                                    }
                                    pathRunning: false
                                }
                            }
                        }
                    }
                    blockOperationOrdinal: blockOperationOrdinal + 1
                }
                if status == 0 && pathRunning {
                    let terminatorRow: Int(blockFirstOperation + blockOperationCount - 1)
                    let terminatorKind: Int(compilerIntTableValue(table: arena.mirOperations, row: terminatorRow, column: compilerBodyMIROperationKindColumn()))
                    state nextBlockID: Int(0 - 1)
                    if terminatorKind == compilerBodyMIROperationCondBranch() {
                        let conditionValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: terminatorRow, ordinal: 0))
                        state conditionTypeKind: Int(0 - 1)
                        if conditionValueID >= 0 && conditionValueID < compilerIntTableRowCount(table: arena.mirValues) {
                            conditionTypeKind: compilerIntTableValue(table: arena.mirValues, row: conditionValueID, column: compilerBodyMIRValueTypeColumn())
                        }
                        if conditionValueID < 0 || conditionValueID >= evaluationValues.count || conditionTypeKind != compilerBodyTypeBool() {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            failureOperationRow: terminatorRow
                        } else if compilerMacroValueStoreScalar(store: valueStore, valueID: evaluationValues.element(index: conditionValueID)) != 0 {
                            nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeTrue())
                        } else {
                            nextBlockID: compilerBodyMIRCFGTarget(arena: arena, blockID: currentBlockID, role: compilerBodyCFGEdgeFalse())
                        }
                    } else if terminatorKind == compilerBodyMIROperationBranch() {
                        nextBlockID: compilerMacroExecutionBranchTarget(arena: arena, blockID: currentBlockID)
                    } else if terminatorKind == compilerBodyMIROperationReturn() {
                        pathRunning: false
                    } else {
                        status: 0 - 1
                        diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                        failureOperationRow: terminatorRow
                    }
                    if status == 0 && pathRunning {
                        if nextBlockID < 0 || nextBlockID >= compilerIntTableRowCount(table: arena.mirBlocks) {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            failureOperationRow: terminatorRow
                        } else {
                            previousBlockID: currentBlockID
                            currentBlockID: nextBlockID
                        }
                    }
                }
            }
        }
    }
    if status == 0 {
        state omissionRow: Int(0)
        while omissionRow < pendingOmissionTargets.count && status == 0 {
            if compilerMacroGraphDeltaAppendOmission(tables: tables, delta: graphDelta, targetSyntaxID: pendingOmissionTargets.element(index: omissionRow)) != 0 {
                status: 0 - 1
                diagnosticCode: compilerMacroDiagnosticGraphDeltaInvalid()
            }
            omissionRow: omissionRow + 1
        }
        if status == 0 && !compilerMacroGraphDeltaIsValid(tables: tables, delta: graphDelta) {
            status: 0 - 1
            if compilerMacroGraphDeltaHasGeneratedMemberCollision(tables: tables, delta: graphDelta) {
                diagnosticCode: compilerMacroDiagnosticGeneratedMemberCollision()
            } else if compilerMacroGraphDeltaHasGeneratedFunctionCollision(tables: tables, delta: graphDelta) {
                diagnosticCode: compilerMacroDiagnosticGeneratedFunctionCollision()
            } else {
                diagnosticCode: compilerMacroDiagnosticGraphDeltaInvalid()
            }
        }
    }
    mirOperationCount: mirOperationCount + compilerIntTableRowCount(table: arena.mirOperations)
    if status == 0 {
        let successIdentity: CompilerFingerprint(compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow))
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationSuccess(), diagnosticCode: 0, diagnosticFileID: 0 - 1, diagnosticStart: 0 - 1, diagnosticEnd: 0 - 1, resultIdentity: successIdentity, mirOperationCount: compilerIntTableRowCount(table: arena.mirOperations), stepCount: invocationSteps, pipelineStatus: 0, pipelineFailureCode: 0)
    } else {
        state failureFileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
        state failureStart: Int(bodyStart)
        state failureEnd: Int(bodyEnd)
        if failureOperationRow >= 0 && failureOperationRow < compilerIntTableRowCount(table: arena.mirOperations) {
            let failureSourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: failureOperationRow, column: compilerBodyMIROperationSourceColumn()))
            if failureSourceNodeID >= 0 && failureSourceNodeID < compilerIntTableRowCount(table: arena.nodes) {
                failureFileID: arena.fileID
                failureStart: compilerIntTableValue(table: arena.nodes, row: failureSourceNodeID, column: 4)
                failureEnd: compilerIntTableValue(table: arena.nodes, row: failureSourceNodeID, column: 5)
            }
        }
        let failureIdentity: CompilerFingerprint(compilerMacroExecutionErrorIdentity(base: compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow), code: diagnosticCode, row: failureOperationRow))
        state evaluationFailureCode: Int(failureOperationRow)
        if failureOperationRow >= 0 && failureOperationRow < compilerIntTableRowCount(table: arena.mirOperations) {
            evaluationFailureCode: compilerIntTableValue(table: arena.mirOperations, row: failureOperationRow, column: compilerBodyMIROperationKindColumn()) * 100000 + failureOperationRow
            if evaluationFailureDetail > 0 {
                evaluationFailureCode: 9000000 + evaluationFailureDetail * 1000 + failureOperationRow
            }
        }
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationFailed(), diagnosticCode: diagnosticCode, diagnosticFileID: failureFileID, diagnosticStart: failureStart, diagnosticEnd: failureEnd, resultIdentity: failureIdentity, mirOperationCount: compilerIntTableRowCount(table: arena.mirOperations), stepCount: 0, pipelineStatus: 0, pipelineFailureCode: evaluationFailureCode)
    }
    state result: CompilerMacroResult(.noValue)
    if status == 0 && resultStoreValueID >= 0 && resultStoreValueID < valueStore.kinds.count {
        let resultKind: Int(valueStore.kinds.element(index: resultStoreValueID))
        let resultTypeKind: Int(valueStore.typeKinds.element(index: resultStoreValueID))
        let resultScalar: Int(valueStore.scalars.element(index: resultStoreValueID))
        let resultChildCount: Int(valueStore.childCounts.element(index: resultStoreValueID))
        state resultNominalSyntaxID: Int(0 - 1)
        let resultTypeID: Int(valueStore.typeIDs.element(index: resultStoreValueID))
        if resultTypeID >= 0 && resultTypeID < compilerIntTableRowCount(table: arena.typeInstances) {
            resultNominalSyntaxID: compilerIntTableValue(table: arena.typeInstances, row: resultTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn())
        }
        result: .value(
            kind: resultKind,
            typeKind: resultTypeKind,
            nominalSyntaxID: resultNominalSyntaxID,
            scalar: resultScalar,
            childCount: resultChildCount
        )
        if compilerMacroExecutionPersistResultValue(
            tables: tables,
            arena: arena,
            store: valueStore,
            invocationRow: invocationRow,
            applicationRow: applicationRow,
            declarationRow: declarationRow,
            targetSyntaxID: targetSyntaxID,
            storeValueID: resultStoreValueID,
            parentResultRow: 0 - 1,
            childOrdinal: 0
        ) < 0 {
            status: 0 - 1
            diagnosticCode: compilerMacroDiagnosticBodyInvalid()
            result: .noValue
        }
    }
    evaluationValues.destroy()
    compilerMacroValueStoreDestroy(store: valueStore)
    return CompilerMacroEvaluationOutcome(status: status, diagnosticCode: diagnosticCode, eventCount: eventCount, readDependencyCount: readDependencyCount, mirOperationCount: mirOperationCount, stepCount: stepCount, result: result)
}

function compilerMacroExecutionRunInvocation(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, applicationRow: Int, declarationRow: Int, invocationRow: Int, bodyStart: Int, bodyEnd: Int): CompilerMacroInvocationOutcome {
    let graphDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let pendingOmissionTargets: Buffer<Int>(bufferCreateInt(capacity: 4))
    let declarationFileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
    let globalBodyStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: declarationFileID, localOffset: bodyStart))
    let globalBodyEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: declarationFileID, localOffset: bodyEnd))
    if compilerCoreFirstNonWhitespaceIndex(source: tables.sourceStore.source, start: globalBodyStart, end: globalBodyEnd) >= globalBodyEnd {
        let noOpIdentity: CompilerFingerprint(compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow))
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationSuccess(), diagnosticCode: 0, diagnosticFileID: 0 - 1, diagnosticStart: 0 - 1, diagnosticEnd: 0 - 1, resultIdentity: noOpIdentity, mirOperationCount: 0, stepCount: 0, pipelineStatus: 0, pipelineFailureCode: 0)
        pendingOmissionTargets.destroy()
        return CompilerMacroInvocationOutcome(status: 0, diagnosticCode: 0, eventCount: 0, readDependencyCount: 0, mirOperationCount: 0, stepCount: 0, result: .noValue, graphDelta: graphDelta)
    }
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateMacro(tables: tables, index: index, macroDeclarationRow: declarationRow)))
    let emptyReturnModes: Buffer<Int>(bufferCreateInt(capacity: 0))
    let emptyParticipants: Buffer<Int>(bufferCreateInt(capacity: 0))
    let emptyTypeKeys: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyColumnCount(), estimatedRowCount: 0))
    let emptyTypeKeyArguments: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableTypeKeyArgumentColumnCount(), estimatedRowCount: 0))
    let emptyEffectPaths: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyFunctionInstanceEffectPathColumnCount(), estimatedRowCount: 0))
    let emptyReturnSummaries: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnSummaryColumnCount(), estimatedRowCount: 0))
    let emptyReturnLeaves: CompilerIntTable(compilerIntTableCreate(columnCount: compilerReachableFunctionInstanceReturnLeafColumnCount(), estimatedRowCount: 0))
    let abiPlan: CompilerModuleABIPlan(returnModes: $emptyReturnModes, participants: $emptyParticipants, isFrozen: false)
    state status: Int(0)
    state diagnosticCode: Int(0)
    state eventCount: Int(0)
    state readDependencyCount: Int(0)
    state mirOperationCount: Int(0)
    state stepCount: Int(0)
    state pipelineStatus: Int(0)
    state pipelineFailureCode: Int(0)
    state result: CompilerMacroResult(.noValue)
    if arena.failures.count != 0 {
        pipelineStatus: 1
        let parseFailureOffset: Int(arena.failures.element(index: 0))
        if parseFailureOffset >= arena.bodyStart && parseFailureOffset < arena.bodyEnd {
            pipelineFailureCode: 1
        } else {
            pipelineFailureCode: 2
        }
    } else if !compilerBodyArenaIsValid(arena: arena) {
        pipelineStatus: 1
        pipelineFailureCode: 100 + compilerBodyArenaValidationCode(arena: arena)
    }
    if pipelineStatus == 0 {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: index) != 0 {
            pipelineStatus: 2
            if arena.failures.count > 1 { pipelineFailureCode: arena.failures.element(index: 1) }
        }
    }
    if pipelineStatus == 0 {
        if compilerBodyArenaBuildCFG(arena: arena) != 0 { pipelineStatus: 3 }
    }
    if pipelineStatus == 0 {
        let memoryBuildStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: abiPlan, typeKeys: emptyTypeKeys, typeKeyArguments: emptyTypeKeyArguments, effects: tables.bodyNodes, effectPaths: emptyEffectPaths, returnSummaries: emptyReturnSummaries, returnLeaves: emptyReturnLeaves, applyInstanceEffects: false, recordOwnedFacts: false))
        if memoryBuildStatus != 0 {
            pipelineStatus: 4
            pipelineFailureCode: memoryBuildStatus
        }
    }
    compilerIntTableDestroy(table: emptyTypeKeys)
    compilerIntTableDestroy(table: emptyTypeKeyArguments)
    compilerIntTableDestroy(table: emptyEffectPaths)
    compilerIntTableDestroy(table: emptyReturnSummaries)
    compilerIntTableDestroy(table: emptyReturnLeaves)
    if pipelineStatus == 0 {
        let mirBuildStatus: Int(compilerBodyMIRBuild(arena: arena))
        if mirBuildStatus != 0 {
            pipelineStatus: 5
            pipelineFailureCode: mirBuildStatus
        }
    }
    if pipelineStatus == 0 {
        let mirValidationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: abiPlan))
        if mirValidationCode != 0 {
            pipelineStatus: 6
            pipelineFailureCode: mirValidationCode
        }
    }
    if pipelineStatus != 0 {
        status: 0 - 1
        diagnosticCode: compilerMacroDiagnosticBodyInvalid()
        if pipelineStatus == 6
            && pipelineFailureCode >= compilerBodyMIRValidationMacroTargetQueryInvalidBase()
            && pipelineFailureCode < compilerBodyMIRValidationMacroTargetQueryInvalidBase() + compilerIntTableRowCount(table: arena.mirOperations) {
            diagnosticCode: compilerMacroDiagnosticGraphQueryInvalid()
        }
        let bodyIdentity: CompilerFingerprint(compilerMacroExecutionErrorIdentity(base: compilerMacroExecutionInvocationIdentity(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow), code: diagnosticCode, row: pipelineStatus))
        state diagnosticStart: Int(bodyStart)
        state diagnosticEnd: Int(bodyEnd)
        if arena.failures.count > 0 {
            let failureGlobalOffset: Int(arena.failures.element(index: 0))
            if failureGlobalOffset >= arena.bodyStart && failureGlobalOffset < arena.bodyEnd {
                diagnosticStart: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: arena.fileID, globalOffset: failureGlobalOffset)
                diagnosticEnd: diagnosticStart + 1
                let maybeFailureToken: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: failureGlobalOffset))
                if maybeFailureToken != nil {
                    let failureToken: RangeLexedToken(maybeFailureToken ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $tables.sourceStore.source, index: failureGlobalOffset)))
                    if failureToken.start < arena.bodyEnd {
                        diagnosticStart: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: arena.fileID, globalOffset: failureToken.start)
                        diagnosticEnd: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: arena.fileID, globalOffset: failureToken.end)
                    }
                }
            }
        }
        compilerMacroExecutionSetInvocation(tables: tables, row: invocationRow, status: compilerMacroInvocationFailed(), diagnosticCode: diagnosticCode, diagnosticFileID: compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1), diagnosticStart: diagnosticStart, diagnosticEnd: diagnosticEnd, resultIdentity: bodyIdentity, mirOperationCount: compilerIntTableRowCount(table: arena.mirOperations), stepCount: 0, pipelineStatus: pipelineStatus, pipelineFailureCode: pipelineFailureCode)
        mirOperationCount: mirOperationCount + compilerIntTableRowCount(table: arena.mirOperations)
    } else {
        let evaluationOutcome: CompilerMacroEvaluationOutcome(compilerMacroExecutionEvaluateInvocation(tables: tables, arena: arena, graphDelta: graphDelta, pendingOmissionTargets: pendingOmissionTargets, applicationRow: applicationRow, declarationRow: declarationRow, invocationRow: invocationRow, bodyStart: bodyStart, bodyEnd: bodyEnd))
        status: evaluationOutcome.status
        diagnosticCode: evaluationOutcome.diagnosticCode
        eventCount: evaluationOutcome.eventCount
        readDependencyCount: evaluationOutcome.readDependencyCount
        mirOperationCount: evaluationOutcome.mirOperationCount
        stepCount: evaluationOutcome.stepCount
        result: evaluationOutcome.result
    }
    compilerBodyArenaDestroy(arena: arena)
    emptyReturnModes.destroy()
    emptyParticipants.destroy()
    pendingOmissionTargets.destroy()
    return CompilerMacroInvocationOutcome(status: status, diagnosticCode: diagnosticCode, eventCount: eventCount, readDependencyCount: readDependencyCount, mirOperationCount: mirOperationCount, stepCount: stepCount, result: result, graphDelta: graphDelta)
}

function compilerMacroExecution(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex): CompilerMacroExecutionResult {
    let graphDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    state status: Int(0)
    state diagnosticCode: Int(0)
    state invocationCount: Int(0)
    state handleCount: Int(0)
    state eventCount: Int(0)
    state readDependencyCount: Int(0)
    state mirOperationCount: Int(0)
    state stepCount: Int(0)
    state applicationRow: Int(0)
    state applicationPass: Int(0)
    while applicationPass < 2 && status == 0 {
    applicationRow: 0
    while applicationRow < compilerIntTableRowCount(table: tables.macroApplications) && status == 0 {
        let applicationTargetKind: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 13))
        state executesInPass: Bool(applicationPass == 0 && applicationTargetKind == compilerSyntaxKindMember())
        if applicationPass == 1 && applicationTargetKind != compilerSyntaxKindMember() { executesInPass: true }
        if executesInPass {
        let declarationRow: Int(compilerMacroExecutionResolvedDeclaration(tables: tables, applicationRow: applicationRow))
        if declarationRow >= 0 {
            let formulaExecutionStatus: Int(compilerFormulaExecuteApplication(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow))
            if formulaExecutionStatus < 0 {
                status: 0 - 1
                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
            } else if formulaExecutionStatus > 0 {
                invocationCount: invocationCount + 1
                stepCount: stepCount + 1
            } else {
                let capabilitySetID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 29))
                let bodyStart: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 27))
                let bodyEnd: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 28))
                if capabilitySetID > 0 && bodyEnd > bodyStart {
                let invocationRow: Int(compilerMacroExecutionAppendInvocation(tables: tables, applicationRow: applicationRow, declarationRow: declarationRow, budget: compilerMacroExecutionBudgetDefault()))
                if invocationRow < 0 {
                    status: 0 - 1
                    diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                } else {
                    invocationCount: invocationCount + 1
                    let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 12))
                    state capabilityRow: Int(0)
                    while capabilityRow < compilerIntTableRowCount(table: tables.macroCapabilities) {
                        if compilerIntTableValue(table: tables.macroCapabilities, row: capabilityRow, column: 1) == declarationRow {
                            if compilerMacroExecutionAppendHandle(tables: tables, invocationRow: invocationRow, declarationRow: declarationRow, capabilityRow: capabilityRow, targetSyntaxID: targetSyntaxID, capabilitySetID: capabilitySetID) < 0 {
                                status: 0 - 1
                                diagnosticCode: compilerMacroDiagnosticBodyInvalid()
                            } else {
                                handleCount: handleCount + 1
                            }
                        }
                        capabilityRow: capabilityRow + 1
                    }
                    if status == 0 {
                        let invocationOutcome: CompilerMacroInvocationOutcome(compilerMacroExecutionRunInvocation(tables: tables, index: index, applicationRow: applicationRow, declarationRow: declarationRow, invocationRow: invocationRow, bodyStart: bodyStart, bodyEnd: bodyEnd))
                        status: invocationOutcome.status
                        diagnosticCode: invocationOutcome.diagnosticCode
                        eventCount: eventCount + invocationOutcome.eventCount
                        readDependencyCount: readDependencyCount + invocationOutcome.readDependencyCount
                        mirOperationCount: mirOperationCount + invocationOutcome.mirOperationCount
                        stepCount: stepCount + invocationOutcome.stepCount
                        if status == 0 && compilerGraphDeltaMerge(delta: graphDelta, source: invocationOutcome.graphDelta) != 0 {
                            status: 0 - 1
                            diagnosticCode: compilerMacroDiagnosticGraphDeltaInvalid()
                        }
                        compilerGraphDeltaDestroy(delta: invocationOutcome.graphDelta)
                    }
                }
                }
            }
        }
        }
        applicationRow: applicationRow + 1
    }
    applicationPass: applicationPass + 1
    }
    if status == 0 {
        if compilerMacroComposeGeneratedFunctions(tables: tables, delta: graphDelta) != 0 {
            status: 0 - 1
            diagnosticCode: compilerMacroDiagnosticGraphDeltaInvalid()
            compilerMacroExecutionRecordFinalFailure(tables: tables, code: diagnosticCode)
        } else if !compilerMacroGraphDeltaIsValid(tables: tables, delta: graphDelta) {
            status: 0 - 1
            if compilerMacroGraphDeltaHasGeneratedMemberCollision(tables: tables, delta: graphDelta) {
                diagnosticCode: compilerMacroDiagnosticGeneratedMemberCollision()
            } else if compilerMacroGraphDeltaHasGeneratedFunctionCollision(tables: tables, delta: graphDelta) {
                diagnosticCode: compilerMacroDiagnosticGeneratedFunctionCollision()
            } else {
                diagnosticCode: compilerMacroDiagnosticGraphDeltaInvalid()
            }
            compilerMacroExecutionRecordFinalFailure(tables: tables, code: diagnosticCode)
        }
    }
    return CompilerMacroExecutionResult(status: status, diagnosticCode: diagnosticCode, invocationCount: invocationCount, capabilityHandleCount: handleCount, eventCount: eventCount, readDependencyCount: readDependencyCount, mirOperationCount: mirOperationCount, stepCount: stepCount, graphDelta: graphDelta)
}

function compilerSyntaxTablesAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    state expectedSyntaxCount: Int(0)
    expectedSyntaxCount: compilerIntTableRowCount(table: tables.declarations) + compilerIntTableRowCount(table: tables.members) + compilerIntTableRowCount(table: tables.parameters) + compilerIntTableRowCount(table: tables.bodyNodes)
    if syntaxCount != expectedSyntaxCount {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 1)
        return false
    }
    state functionDeclarationCount: Int(0)
    state declarationRow: Int(0)
    while declarationRow < compilerIntTableRowCount(table: tables.declarations) {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
            functionDeclarationCount: functionDeclarationCount + 1
        }
        declarationRow: declarationRow + 1
    }
    if functionDeclarationCount != compilerIntTableRowCount(table: tables.functions) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 2)
        return false
    }
    state syntaxID: Int(0)
    while syntaxID < syntaxCount {
        if !compilerSyntaxFacetIsValid(tables: tables, syntaxID: syntaxID) {
            compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 3)
            return false
        }
        syntaxID: syntaxID + 1
    }
    if !compilerSyntaxDeclarationsAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 10)
        return false
    }
    if !compilerSyntaxMembersAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 11)
        return false
    }
    if !compilerSyntaxEnumPayloadTypesAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 12)
        return false
    }
    if !compilerSyntaxTypeReferencesAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 13)
        return false
    }
    if !compilerSyntaxEnumDirectPayloadCyclesAreAbsent(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 14)
        return false
    }
    if !compilerSyntaxFunctionsAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 15)
        return false
    }
    if !compilerSyntaxParametersAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 16)
        return false
    }
    if !compilerSyntaxGenericParametersAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 17)
        return false
    }
    if !compilerMacroTablesAreStructurallyValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 18)
        return false
    }
    if !compilerSyntaxBodyNodesAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 19)
        return false
    }
    if !compilerSyntaxBodyEdgesAreValid(tables: tables) {
        compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 20)
        return false
    }
    return true
}

function compilerSyntaxKindName(kindTag: Int): String {
    if kindTag == compilerSyntaxKindConstruct() {
        return String("construct")
    }
    if kindTag == compilerSyntaxKindEnum() {
        return String("enum")
    }
    if kindTag == compilerSyntaxKindFunction() {
        return String("function")
    }
    if kindTag == compilerSyntaxKindMember() {
        return String("member")
    }
    if kindTag == compilerSyntaxKindParameter() {
        return String("parameter")
    }
    if kindTag == compilerSyntaxKindEntry() { return String("entry") }
    if kindTag == compilerSyntaxKindLocalBinding() { return String("local") }
    if kindTag == compilerSyntaxKindReturn() { return String("return") }
    if kindTag == compilerSyntaxKindIdentifier() { return String("identifier") }
    if kindTag == compilerSyntaxKindApplication() { return String("application") }
    if kindTag == compilerSyntaxKindMemberRead() { return String("memberRead") }
    if kindTag == compilerSyntaxKindIntegerLiteral() { return String("integerLiteral") }
    if kindTag == compilerSyntaxKindAddition() { return String("addition") }
    if kindTag == compilerSyntaxKindArgument() { return String("argument") }
    if kindTag == compilerSyntaxKindMainAnnotation() { return String("mainAnnotation") }
    if kindTag == compilerSyntaxKindAssignment() { return String("assignment") }
    if kindTag == compilerSyntaxKindBindingReference() { return String("bindingReference") }
    if kindTag == compilerSyntaxKindIf() { return String("if") }
    if kindTag == compilerSyntaxKindBlock() { return String("block") }
    if kindTag == compilerSyntaxKindIndex() { return String("index") }
    if kindTag == compilerSyntaxKindSwitch() { return String("switch") }
    if kindTag == compilerSyntaxKindSwitchCase() { return String("switchCase") }
    if kindTag == compilerSyntaxKindEnumCaseValue() { return String("enumCaseValue") }
    if kindTag == compilerSyntaxKindArrayLiteral() { return String("arrayLiteral") }
    return String("unknown")
}

function compilerSyntaxMemberKindName(kindTag: Int): String {
    if kindTag == compilerSyntaxMemberKindLet() { return String("let") }
    if kindTag == compilerSyntaxMemberKindState() { return String("state") }
    if kindTag == compilerSyntaxMemberKindBinding() { return String("binding") }
    if kindTag == compilerSyntaxMemberKindEnumCase() { return String("case") }
    if kindTag == compilerSyntaxMemberKindEnumCasePayload() { return String("casePayload") }
    if kindTag == compilerSyntaxMemberKindDerived() { return String("derived") }
    return String("unknown")
}

function compilerSyntaxMemberStorageName(storagePolicy: Int): String {
    if storagePolicy == compilerSyntaxMemberStorageNone() { return String("none") }
    if storagePolicy == compilerSyntaxMemberStorageDirect() { return String("direct") }
    if storagePolicy == compilerSyntaxMemberStorageBinding() { return String("binding") }
    if storagePolicy == compilerSyntaxMemberStorageIndirect() { return String("indirect") }
    return String("unknown")
}

function compilerSyntaxTypeTargetKindName(kind: Int): String {
    if kind == compilerSyntaxTypeTargetNone() { return String("none") }
    if kind == compilerSyntaxTypeTargetBuiltin() { return String("builtin") }
    if kind == compilerSyntaxTypeTargetDeclaration() { return String("declaration") }
    if kind == compilerSyntaxTypeTargetReference() { return String("typeReference") }
    return String("unknown")
}

function compilerSyntaxTypeReferenceKindName(kind: Int): String {
    if kind == compilerSyntaxTypeReferenceNamed() { return String("named") }
    if kind == compilerSyntaxTypeReferenceApplication() { return String("application") }
    if kind == compilerSyntaxTypeReferenceArray() { return String("array") }
    if kind == compilerSyntaxTypeReferenceOptional() { return String("optional") }
    if kind == compilerSyntaxTypeReferenceValue() { return String("value") }
    return String("unknown")
}

function compilerSyntaxTypeReferenceTargetName(kind: Int): String {
    if kind == compilerSyntaxTypeReferenceTargetNone() { return String("none") }
    if kind == compilerSyntaxTypeReferenceTargetBuiltin() { return String("builtin") }
    if kind == compilerSyntaxTypeReferenceTargetDeclaration() { return String("declaration") }
    if kind == compilerSyntaxTypeReferenceTargetGenericParameter() { return String("genericParameter") }
    if kind == compilerSyntaxTypeReferenceTargetMissing() { return String("missing") }
    if kind == compilerSyntaxTypeReferenceTargetAmbiguous() { return String("ambiguous") }
    return String("unknown")
}
