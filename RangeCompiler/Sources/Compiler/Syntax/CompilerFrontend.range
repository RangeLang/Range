    identity: compilerFingerprintAppendInt(fingerprint: identity, value: targetIdentity.first)
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: targetIdentity.second)
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: keyKindTag)
    return compilerFingerprintAppendText(fingerprint: identity, tag: 711, text: key)
}

function compilerMacroExecutionDeclarationObservation(tables: CompilerSyntaxTables, kindTag: Int, name: String): CompilerFingerprint {
    state observation: CompilerFingerprint(compilerFingerprintInitial())
    observation: compilerFingerprintAppendInt(fingerprint: observation, value: 712)
    observation: compilerFingerprintAppendInt(fingerprint: observation, value: kindTag)
    observation: compilerFingerprintAppendText(fingerprint: observation, tag: 713, text: name)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.declarations) {
        if compilerIntTableValue(table: tables.declarations, row: row, column: 2) == kindTag {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)))
            if candidate == name {
                observation: compilerFingerprintAppendInt(fingerprint: observation, value: compilerIntTableValue(table: tables.declarations, row: row, column: 11))
                observation: compilerFingerprintAppendInt(fingerprint: observation, value: compilerIntTableValue(table: tables.declarations, row: row, column: 12))
            }
        }
        row: row + 1
    }
    return observation
}

