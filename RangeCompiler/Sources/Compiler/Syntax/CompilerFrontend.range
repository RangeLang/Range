        }
        captureValues.destroy()
        transformedChildren.destroy()
    } else if operationKind == compilerBodyMIROperationMacroEnvironmentProjection() {
        let projectionResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let projection: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
        let environmentReceiverMIRValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
