                    projectedSyntaxValue: syntaxMembersValid
                } else if !projectedSyntaxValue && projectedMemberName == String("macros") {
                    let syntaxApplications: Buffer<Int>(bufferCreateInt(capacity: 4))
                    state syntaxApplicationsValid: Bool(true)
                    state syntaxApplicationRow: Int(0)
                    while syntaxApplicationRow < compilerIntTableRowCount(table: arena.tables.macroApplications)
                        && syntaxApplicationsValid {
