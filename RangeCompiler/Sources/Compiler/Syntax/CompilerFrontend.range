            let token: RangeLexedToken(maybeToken ?? compilerFallbackTokenAt(index: cursor))
            if token.kind == .greater {
                if expectingName || token.start != genericRange.end - 1 || ordinal == 0 { valid: false } else { cursor: token.end }
            } else if !expectingName {
                valid: false
            } else if token.kind == .keyword && token.text == String("let") {
                let step: CompilerStoredMemberParseStep(compilerCoreParseStoredMemberToken(source: source, end: genericRange.end, token: token))
                let parameterEnd: Int(compilerTypedSyntaxGenericValueParameterEnd(source: source, typeEnd: step.typeReference.end, genericEnd: genericRange.end))
                if !step.keepScanning || !step.found || parameterEnd < step.typeReference.end {
                    valid: false
                } else {
                    let authored: String(stringSubstring(source: source, start: token.start, end: parameterEnd))
                    let parameterFingerprint: CompilerFingerprint(compilerTypedFingerprintAppendNamedType(fingerprint: baseFingerprint, tag: 60, ordinal: ordinal, name: step.nameToken.text, typeName: authored))
                    if compilerSyntaxAppendGenericParameter(tables: tables, ownerSyntaxID: ownerSyntaxID, ownerKind: ownerKind, ordinal: ordinal, fileID: fileID, start: token.start, end: parameterEnd, nameStart: step.nameToken.start, nameEnd: step.nameToken.end, kind: compilerSyntaxGenericParameterValueKind(), fingerprint: parameterFingerprint) != 0 {
                        valid: false
                    } else {
                        fingerprint: compilerTypedFingerprintAppendNamedType(fingerprint: fingerprint, tag: 60, ordinal: ordinal, name: step.nameToken.text, typeName: authored)
                        ordinal: ordinal + 1
                        let maybeSeparator: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: parameterEnd))
                        if maybeSeparator == nil { valid: false } else {
                            let separator: RangeLexedToken(maybeSeparator ?? compilerFallbackTokenAt(index: parameterEnd))
                            if separator.kind == .comma {
                                expectingName: true
                                cursor: separator.end
                            } else if separator.kind == .greater && separator.start == genericRange.end - 1 {
                                expectingName: false
                                cursor: separator.end
                            } else {
                                valid: false
                            }
                        }
                    }
                }
            } else if token.kind != .identifier {
                valid: false
            } else {
                let maybeFollowing: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: token.end))
                if maybeFollowing == nil {
                    valid: false
                } else {
                    let following: RangeLexedToken(maybeFollowing ?? compilerFallbackTokenAt(index: token.end))
                    if following.kind == .colon {
                        let step: CompilerFunctionParameterTokenStep(compilerCoreParseFunctionParameterToken(source: source, end: genericRange.end, token: token))
                        let parameterEnd: Int(compilerTypedSyntaxGenericValueParameterEnd(source: source, typeEnd: step.typeReference.end, genericEnd: genericRange.end))
                        if !step.keepScanning || !step.found || parameterEnd < step.typeReference.end {
                            valid: false
                        } else {
                            let authored: String(stringSubstring(source: source, start: token.start, end: parameterEnd))
                            let parameterFingerprint: CompilerFingerprint(compilerTypedFingerprintAppendNamedType(fingerprint: baseFingerprint, tag: 60, ordinal: ordinal, name: step.nameToken.text, typeName: authored))
                            if compilerSyntaxAppendGenericParameter(tables: tables, ownerSyntaxID: ownerSyntaxID, ownerKind: ownerKind, ordinal: ordinal, fileID: fileID, start: token.start, end: parameterEnd, nameStart: step.nameToken.start, nameEnd: step.nameToken.end, kind: compilerSyntaxGenericParameterValueKind(), fingerprint: parameterFingerprint) != 0 {
                                valid: false
                            } else {
                                fingerprint: compilerTypedFingerprintAppendNamedType(fingerprint: fingerprint, tag: 60, ordinal: ordinal, name: step.nameToken.text, typeName: authored)
                                ordinal: ordinal + 1
                                let maybeSeparator: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: parameterEnd))
                                if maybeSeparator == nil { valid: false } else {
                                    let separator: RangeLexedToken(maybeSeparator ?? compilerFallbackTokenAt(index: parameterEnd))
                                    if separator.kind == .comma {
                                        expectingName: true
                                        cursor: separator.end
                                    } else if separator.kind == .greater && separator.start == genericRange.end - 1 {
                                        expectingName: false
                                        cursor: separator.end
                                    } else {
                                        valid: false
                                    }
                                }
                            }
