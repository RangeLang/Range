function compilerGraphDeltaCommitGeneratedFunction(tables: CompilerSyntaxTables, row: Int): Int {
    let generatedGraphKind: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 1))
    let generatedSyntaxKind: Int(compilerSyntaxKindFunction())
    let ownerSyntaxID: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 2))
    let fileID: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 3))
    let parameterStart: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 6))
    let parameterEnd: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 7))
    let returnTypeStart: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 8))
    let returnTypeEnd: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 9))
    let bodyStart: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 10))
    let bodyEnd: Int(compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 11))
    let nameGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 4)))
    let nameGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.pendingGeneratedFunctions, row: row, column: 5)))
