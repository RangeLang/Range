                if closureArguments.append(element: captureValues.element(index: captureOrdinal)) != 0 { transformValid: false }
                captureOrdinal: captureOrdinal + 1
            }
            if transformValid {
                let closureOutcome: CompilerMacroFunctionOutcome(compilerMacroExecutionEvaluateClosure(parentArena: arena, index: index, store: store, parentOperationRow: operationRow, closureNodeID: closureNodeID, arguments: closureArguments, depth: depth + 1))
                if closureOutcome.status != 0 || closureOutcome.valueID < 0 {
                    transformFailureStatus: closureOutcome.status
                    if transformFailureStatus == 0 { transformFailureStatus: 0 - 701 }
                    transformValid: false
                } else if operationKind == compilerBodyMIROperationMacroCollectionMap() {
                    if transformedChildren.append(element: closureOutcome.valueID) != 0 { transformValid: false }
                } else if compilerMacroValueStoreScalar(store: store, valueID: closureOutcome.valueID) != 0 {
                    if transformedChildren.append(element: childStoreValueID) != 0 { transformValid: false }
                }
            }
            closureArguments.destroy()
            childOrdinal: childOrdinal + 1
        }
        if transformFailureStatus != 0 {
            captureValues.destroy()
            transformedChildren.destroy()
            return transformFailureStatus
        }
        state transformedStoreValueID: Int(0 - 1)
        if transformValid {
            transformedStoreValueID: compilerMacroValueStoreAppendAggregate(
                store: store,
                kind: compilerMacroValueKindArray(),
                typeKind: compilerIntTableValue(table: arena.mirValues, row: transformResultValueID, column: compilerBodyMIRValueTypeColumn()),
                typeID: compilerIntTableValue(table: arena.mirValues, row: transformResultValueID, column: compilerBodyMIRValueTypeIDColumn()),
                scalar: store.scalars.element(index: receiverStoreValueID),
                children: transformedChildren
            )
        }
        if transformedStoreValueID < 0 || evaluationValues.update(element: transformedStoreValueID, index: transformResultValueID) != 0 {
