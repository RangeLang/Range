function compilerSyntaxAppendMacroExpansionTemplate(tables: CompilerSyntaxTables, macroDeclarationRow: Int, fileID: Int, expansionStart: Int, expansionEnd: Int, declarationStart: Int, declarationEnd: Int, nameStart: Int, nameEnd: Int, parameterStart: Int, parameterEnd: Int, returnTypeStart: Int, returnTypeEnd: Int, bodyStart: Int, bodyEnd: Int, ordinal: Int, fingerprint: CompilerFingerprint, kindTag: Int, placement: Int, lexicalParent: Int, lexicalParentOrdinal: Int, targetSpliceStart: Int, targetSpliceEnd: Int, targetSpliceFingerprint: CompilerFingerprint, memberKind: Int): Int {
