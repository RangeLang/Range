        let binaryTypeID: Int(compilerIntTableValue(table: arena.mirValues, row: binaryResultValueID, column: compilerBodyMIRValueTypeIDColumn()))
        let binaryStoreValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: binaryTypeKind, typeID: binaryTypeID, scalar: binaryScalarResult))
        if !binaryOperationValid || binaryStoreValueID < 0 || evaluationValues.update(element: binaryStoreValueID, index: binaryResultValueID) != 0 {
