                    while syntaxMemberRow < compilerIntTableRowCount(table: arena.tables.members) && syntaxMembersValid {
                        let syntaxMemberKind: Int(compilerIntTableValue(table: arena.tables.members, row: syntaxMemberRow, column: 12))
