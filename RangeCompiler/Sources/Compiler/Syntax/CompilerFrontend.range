    if compilerSyntaxTableAppend(tables: tables, table: tables.macroDiagnostics, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: end)) != 0 { return 0 - 1 }
