function compilerMacroExecutionScalarValue(arena: CompilerBodyArena, valueID: Int): Int {
    if valueID < 0 || valueID >= compilerIntTableRowCount(table: arena.mirValues) { return 0 }
    let sourceNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueSourceColumn()))
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 }
    state sourceText: String(compilerBodyArenaNodeText(arena: arena, nodeID: sourceNodeID))
    state sourceIsNegated: Bool(false)
    if compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 1) == compilerSyntaxKindPrefixNegate() {
        let magnitudeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleOperand(), ordinal: 0))
        if magnitudeNodeID < 0
            || compilerIntTableValue(table: arena.nodes, row: magnitudeNodeID, column: 1) != compilerSyntaxKindIntegerLiteral() { return 0 }
        sourceText: compilerBodyArenaNodeText(arena: arena, nodeID: magnitudeNodeID)
        sourceIsNegated: true
    }
    let typeKind: Int(compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeColumn()))
    if typeKind == compilerBodyTypeBool() {
        if sourceText == String("true") { return 1 }
        return 0
    }
    if typeKind == compilerBodyTypeString() { return compilerDeclarationNameHash(name: compilerCoreStringLiteralContent(text: sourceText)) }
    if typeKind != compilerBodyTypeInt() { return 0 }
    state sign: Int(1)
    if sourceIsNegated { sign: 0 - 1 }
    state cursor: Int(0)
    if stringLength(value: sourceText) > 0 && stringByteAt(source: sourceText, index: 0) == 45 {
        sign: 0 - 1
        cursor: 1
    }
    state value: Int(0)
    while cursor < stringLength(value: sourceText) {
        let byte: Int(stringByteAt(source: sourceText, index: cursor))
        if byte < 48 || byte > 57 { return 0 }
        value: value * 10 + byte - 48
        cursor: cursor + 1
    }
    return value * sign
}

function compilerMacroExecutionPhiOperandOrdinal(arena: CompilerBodyArena, blockID: Int, previousBlockID: Int, operandCount: Int): Int {
    state ordinal: Int(0)
    while ordinal < compilerBodyMIRForwardPredecessorCount(arena: arena, blockID: blockID) {
        if compilerBodyMIRForwardPredecessorAt(arena: arena, blockID: blockID, ordinal: ordinal) == previousBlockID { return ordinal }
        ordinal: ordinal + 1
    }
    if previousBlockID >= 0 {
        state edgeRow: Int(0)
        while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
            if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
                && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) == previousBlockID
                && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge()
                && operandCount > 1 { return 1 }
            edgeRow: edgeRow + 1
        }
    }
    return 0
}

function compilerMacroExecutionBranchTarget(arena: CompilerBodyArena, blockID: Int): Int {
    state targetBlockID: Int(0 - 1)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) == blockID {
            let candidateBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()))
            if targetBlockID >= 0 && candidateBlockID != targetBlockID { return 0 - 1 }
            targetBlockID: candidateBlockID
        }
        edgeRow: edgeRow + 1
    }
    return targetBlockID
}

function compilerMacroExecutionAppendReadDependency(tables: CompilerSyntaxTables, invocationRow: Int, operation: Int, arena: CompilerBodyArena, operationRow: Int, kindValueID: Int, nameValueID: Int, kindTag: Int, observedCount: Int, applicationIdentity: CompilerFingerprint, targetIdentity: CompilerFingerprint, queryIdentity: CompilerFingerprint, observation: CompilerFingerprint): Int {
    if invocationRow < 0 || kindValueID < 0 || kindValueID >= compilerIntTableRowCount(table: arena.mirValues)
        || nameValueID < 0 || nameValueID >= compilerIntTableRowCount(table: arena.mirValues) || observedCount < 0 { return 0 - 1 }
    let kindNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: kindValueID, column: compilerBodyMIRValueSourceColumn()))
    let nameNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: nameValueID, column: compilerBodyMIRValueSourceColumn()))
    if kindNodeID < 0 || kindNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || nameNodeID < 0 || nameNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let row: Int(compilerIntTableRowCount(table: tables.macroReadDependencies))
    if compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: row) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: invocationRow) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: operation) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: kindTag) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: arena.fileID) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: compilerIntTableValue(table: arena.nodes, row: kindNodeID, column: 4)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: compilerIntTableValue(table: arena.nodes, row: kindNodeID, column: 5)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: compilerIntTableValue(table: arena.nodes, row: nameNodeID, column: 4)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: compilerIntTableValue(table: arena.nodes, row: nameNodeID, column: 5)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: observedCount) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: applicationIdentity.first) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: applicationIdentity.second) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: targetIdentity.first) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: targetIdentity.second) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: queryIdentity.first) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: queryIdentity.second) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: observation.first) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroReadDependencies, value: observation.second) != 0 { return 0 - 1 }
    return row
}

function compilerMacroGraphDeltaAppendOmission(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, targetSyntaxID: Int): Int {
    let nodeID: Int(compilerIntTableRowCount(table: delta.nodes))
    if targetSyntaxID < 0 || targetSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerPlotterAppendSyntaxNode(tables: tables, delta: delta, syntaxID: targetSyntaxID) != nodeID { return 0 - 1 }
    return compilerGraphDeltaAppendFact(delta: delta, factKind: compilerGraphFactOmitted(), subjectNodeID: nodeID, objectNodeID: nodeID, roleTag: compilerGraphRoleExpansion(), ordinal: nodeID)
}

function compilerMacroExpansionTemplateMatchesOperation(arena: CompilerBodyArena, operationRow: Int, templateRow: Int): Bool {
    if operationRow < 0 || operationRow >= compilerIntTableRowCount(table: arena.mirOperations)
        || templateRow < 0 || templateRow >= compilerIntTableRowCount(table: arena.tables.macroExpansionTemplates) { return false }
    let sourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationSourceColumn()))
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    return compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 2) == compilerIntTableValue(table: arena.tables.macroExpansionTemplates, row: templateRow, column: 2)
        && compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 4) == compilerIntTableValue(table: arena.tables.macroExpansionTemplates, row: templateRow, column: 3)
        && compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 5) == compilerIntTableValue(table: arena.tables.macroExpansionTemplates, row: templateRow, column: 4)
}

function compilerMacroExpansionTemplateRowForOrdinal(tables: CompilerSyntaxTables, macroDeclarationRow: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExpansionTemplates) {
        if compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 1) == macroDeclarationRow
            && compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 15) == ordinal { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroExpansionTemplateParentFingerprint(tables: CompilerSyntaxTables, extensionRow: Int): CompilerFingerprint {
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: 860)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: extensionRow, column: 16))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: extensionRow, column: 17))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: 861)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: extensionRow, column: 23))
    return compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: extensionRow, column: 24))
}

function compilerMacroGraphDeltaAppendGeneratedFunction(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, templateRow: Int, ownerTargetSyntaxID: Int, applicationRow: Int, applicationIdentity: CompilerFingerprint, targetIdentity: CompilerFingerprint): Int {
    let templateCount: Int(compilerIntTableRowCount(table: tables.macroExpansionTemplates))
    if templateRow < 0 || templateRow >= templateCount || ownerTargetSyntaxID < 0 || ownerTargetSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerIntTableValue(table: tables.syntaxIndex, row: ownerTargetSyntaxID, column: 0) != compilerSyntaxKindConstruct()
        || applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications) { return 0 - 1 }
    let kindTag: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18))
    let placement: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 19))
    let lexicalParent: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 20))
    let lexicalParentOrdinal: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 25))
    if kindTag != compilerGraphGeneratedKindFunction() { return 0 - 1 }
    state ownerSyntaxID: Int(0 - 1)
    state parentFingerprint: CompilerFingerprint(first: 0, second: 0)
    if placement == compilerMacroExpansionTemplatePlacementMember() {
        if lexicalParent < 0 || lexicalParent >= templateRow
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 18) != compilerMacroExpansionTemplateKindExtension()
            || lexicalParentOrdinal != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 15)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 21) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 21)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 22) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 22)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 23) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 23)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 24) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 24) { return 0 - 1 }
        parentFingerprint: compilerMacroExpansionTemplateParentFingerprint(tables: tables, extensionRow: lexicalParent)
        ownerSyntaxID: ownerTargetSyntaxID
    } else if placement != compilerMacroExpansionTemplatePlacementRoot() || lexicalParent != 0 - 1 || lexicalParentOrdinal != 0 - 1 {
        return 0 - 1
    }
    let templateFileID: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 2))
    let nameStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 7))
    let nameEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 8))
    let ordinal: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 15))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: templateFileID, localStart: nameStart, localEnd: nameEnd))
    state stable: CompilerFingerprint(compilerFingerprintInitial())
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: applicationIdentity.first)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: applicationIdentity.second)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: targetIdentity.first)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: targetIdentity.second)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: ordinal)
    stable: compilerFingerprintAppendText(fingerprint: stable, tag: 83, text: name)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 16))
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 17))
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: placement)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: lexicalParentOrdinal)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: parentFingerprint.first)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: parentFingerprint.second)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 23))
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 24))
    let row: Int(compilerIntTableRowCount(table: delta.generatedFunctions))
    if compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: row) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: ownerSyntaxID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: templateFileID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: nameStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: nameEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 9)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 10)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 11)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 12)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 13)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 14)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 1)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: applicationRow) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: ordinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: applicationIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: applicationIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: targetIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: targetIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: stable.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: stable.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: placement) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: lexicalParentOrdinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: parentFingerprint.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedFunctions, value: parentFingerprint.second) != 0 { return 0 - 1 }
    return row
}

function compilerMacroGraphDeltaAppendGeneratedMember(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, templateRow: Int, ownerTargetSyntaxID: Int, applicationRow: Int, applicationIdentity: CompilerFingerprint, targetIdentity: CompilerFingerprint): Int {
    let templateCount: Int(compilerIntTableRowCount(table: tables.macroExpansionTemplates))
    if templateRow < 0 || templateRow >= templateCount || ownerTargetSyntaxID < 0 || ownerTargetSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerIntTableValue(table: tables.syntaxIndex, row: ownerTargetSyntaxID, column: 0) != compilerSyntaxKindConstruct()
        || applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications) { return 0 - 1 }
    let kindTag: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18))
    let placement: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 19))
    let lexicalParent: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 20))
    let lexicalParentOrdinal: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 25))
    let memberKind: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 26))
    if kindTag != compilerMacroExpansionTemplateKindMember() || (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState()) { return 0 - 1 }
    state ownerSyntaxID: Int(0 - 1)
    state parentFingerprint: CompilerFingerprint(first: 0, second: 0)
    if placement == compilerMacroExpansionTemplatePlacementMember() {
        if lexicalParent < 0 || lexicalParent >= templateRow
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 18) != compilerMacroExpansionTemplateKindExtension()
            || lexicalParentOrdinal != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 15)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 21) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 21)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 22) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 22)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 23) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 23)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 24) != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 24) { return 0 - 1 }
        parentFingerprint: compilerMacroExpansionTemplateParentFingerprint(tables: tables, extensionRow: lexicalParent)
        ownerSyntaxID: ownerTargetSyntaxID
    } else if placement != compilerMacroExpansionTemplatePlacementRoot() || lexicalParent != 0 - 1 || lexicalParentOrdinal != 0 - 1 {
        return 0 - 1
    }
    let templateFileID: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 2))
    let memberStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 5))
    let memberEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 6))
    let nameStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 7))
    let nameEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 8))
    let typeStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 11))
    let typeEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 12))
    let ordinal: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 15))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: templateFileID, localStart: nameStart, localEnd: nameEnd))
    let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: templateFileID, localStart: typeStart, localEnd: typeEnd))
    state stable: CompilerFingerprint(compilerFingerprintInitial())
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: applicationIdentity.first)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: applicationIdentity.second)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: targetIdentity.first)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: targetIdentity.second)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: ordinal)
    stable: compilerFingerprintAppendText(fingerprint: stable, tag: 91, text: name)
    stable: compilerFingerprintAppendText(fingerprint: stable, tag: 92, text: typeName)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: memberKind)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: placement)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: lexicalParentOrdinal)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: parentFingerprint.first)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: parentFingerprint.second)
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 16))
    stable: compilerFingerprintAppendInt(fingerprint: stable, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 17))
    let row: Int(compilerIntTableRowCount(table: delta.generatedMembers))
    if compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: row) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: compilerGraphGeneratedKindMember()) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: ownerSyntaxID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: templateFileID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: memberStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: memberEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: nameStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: nameEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: typeStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: typeEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 1)) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: applicationRow) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: ordinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: applicationIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: applicationIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: targetIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: targetIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: stable.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: stable.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: placement) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: lexicalParentOrdinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: parentFingerprint.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: parentFingerprint.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: memberKind) != 0 { return 0 - 1 }
    return row
}

function compilerMacroGraphDeltaGeneratedFunctionName(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, row: Int): String {
    let fileID: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 3))
    return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 4), localEnd: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 5))
}

function compilerMacroGraphDeltaHasAuthoredFunctionCollisionExcluding(tables: CompilerSyntaxTables, ownerTargetSyntaxID: Int, name: String, ignoredFunctionRow: Int): Bool {
    state functionRow: Int(0)
    while functionRow < compilerIntTableRowCount(table: tables.functions) {
        if functionRow != ignoredFunctionRow
            && functionRow < tables.functionOwners.count
            && tables.functionOwners.element(index: functionRow) == ownerTargetSyntaxID {
            let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
            let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
            if declarationRow >= 0 {
                let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
                let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
                if candidate == name { return true }
            }
        }
        functionRow: functionRow + 1
    }
    return false
}

function compilerMacroInvocationRowForApplication(tables: CompilerSyntaxTables, applicationRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroInvocations) {
        if compilerIntTableValue(table: tables.macroInvocations, row: row, column: 1) == applicationRow
            && compilerIntTableValue(table: tables.macroInvocations, row: row, column: 9) == compilerMacroInvocationSuccess() {
            return row
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroChildApplicationForFragment(tables: CompilerSyntaxTables, parentInvocationRow: Int, templateRow: Int, fragmentRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroChildApplications) {
        if compilerIntTableValue(table: tables.macroChildApplications, row: row, column: 2) == parentInvocationRow
            && compilerIntTableValue(table: tables.macroChildApplications, row: row, column: 3) == templateRow
            && compilerIntTableValue(table: tables.macroChildApplications, row: row, column: 4) == fragmentRow {
            return compilerIntTableValue(table: tables.macroChildApplications, row: row, column: 1)
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroAppendChildArtifacts(tables: CompilerSyntaxTables, output: RawBuffer, childApplicationRow: Int): Int {
    state appended: Int(0)
    state ordinal: Int(0)
    while ordinal < compilerIntTableRowCount(table: tables.macroExpansionArtifacts) {
        state row: Int(0)
        state found: Bool(false)
        while row < compilerIntTableRowCount(table: tables.macroExpansionArtifacts) && !found {
            if compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 2) == childApplicationRow
                && compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 7) == ordinal {
                let fileID: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 4))
                let start: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 5)))
                let end: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 6)))
                if start < 0 || end < start
                    || rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: tables.sourceStore.source, start: start, end: end)) != 0 {
                    return 0 - 1
                }
                appended: appended + 1
                found: true
            }
            row: row + 1
        }
        if !found { return appended }
        ordinal: ordinal + 1
    }
    return appended
}

function compilerMacroExpansionBindingForFragment(tables: CompilerSyntaxTables, parentInvocationRow: Int, templateRow: Int, fragmentRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExpansionBindings) {
        if compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 1) == parentInvocationRow
            && compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 2) == 0 - 1
            && compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 3) == templateRow
            && compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 4) == fragmentRow
            && compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 11) == 0 - 1 {
            return row
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroExpansionBindingChildRow(tables: CompilerSyntaxTables, bindingRow: Int, ordinal: Int): Int {
    state row: Int(bindingRow + 1)
    while row < compilerIntTableRowCount(table: tables.macroExpansionBindings) {
        if compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 11) == bindingRow
            && compilerIntTableValue(table: tables.macroExpansionBindings, row: row, column: 12) == ordinal {
            return row
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroSyntaxSourceRange(tables: CompilerSyntaxTables, syntaxID: Int): CompilerSourceRange {
    if syntaxID < 0 || syntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex) {
        return CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
    }
    let kind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0))
    let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
    if kind == compilerSyntaxKindMember() && facetRow >= 0 && facetRow < compilerIntTableRowCount(table: tables.members) {
        let fileID: Int(compilerIntTableValue(table: tables.members, row: facetRow, column: 1))
        let start: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.members, row: facetRow, column: 4)))
        let end: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.members, row: facetRow, column: 5)))
        return CompilerSourceRange(start: start, end: end, next: end)
    }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
    if declarationRow >= 0 {
        let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
        let start: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 5)))
        let end: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 6)))
        return CompilerSourceRange(start: start, end: end, next: end)
    }
    return CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
}

function compilerMacroExpansionBindingIsSyntax(tables: CompilerSyntaxTables, bindingRow: Int): Bool {
    return bindingRow >= 0
        && bindingRow < compilerIntTableRowCount(table: tables.macroExpansionBindings)
        && compilerIntTableValue(table: tables.macroExpansionBindings, row: bindingRow, column: 6) == compilerMacroValueKindSyntax()
}

function compilerMacroAppendExpansionBindingValue(tables: CompilerSyntaxTables, output: RawBuffer, bindingRow: Int): Int {
    if bindingRow < 0 || bindingRow >= compilerIntTableRowCount(table: tables.macroExpansionBindings) { return 0 - 1 }
    let kind: Int(compilerIntTableValue(table: tables.macroExpansionBindings, row: bindingRow, column: 6))
    let typeKind: Int(compilerIntTableValue(table: tables.macroExpansionBindings, row: bindingRow, column: 7))
    let nominalSyntaxID: Int(compilerIntTableValue(table: tables.macroExpansionBindings, row: bindingRow, column: 8))
    let scalar: Int(compilerIntTableValue(table: tables.macroExpansionBindings, row: bindingRow, column: 9))
    let childCount: Int(compilerIntTableValue(table: tables.macroExpansionBindings, row: bindingRow, column: 10))
    if kind == compilerMacroValueKindSyntax() {
        if childCount == 3 {
            let fileRow: Int(compilerMacroExpansionBindingChildRow(tables: tables, bindingRow: bindingRow, ordinal: 0))
            let startRow: Int(compilerMacroExpansionBindingChildRow(tables: tables, bindingRow: bindingRow, ordinal: 1))
            let endRow: Int(compilerMacroExpansionBindingChildRow(tables: tables, bindingRow: bindingRow, ordinal: 2))
            if fileRow < 0 || startRow < 0 || endRow < 0 { return 0 - 1 }
            let fileID: Int(compilerIntTableValue(table: tables.macroExpansionBindings, row: fileRow, column: 9))
            let start: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.macroExpansionBindings, row: startRow, column: 9)))
            let end: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.macroExpansionBindings, row: endRow, column: 9)))
            if start < 0 || end <= start { return 0 - 1 }
            return rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: tables.sourceStore.source, start: start, end: end))
        }
        let range: CompilerSourceRange(compilerMacroSyntaxSourceRange(tables: tables, syntaxID: scalar))
        if range.start < 0 || range.end <= range.start { return 0 - 1 }
        return rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: tables.sourceStore.source, start: range.start, end: range.end))
    }
    if kind == compilerMacroValueKindScalar() {
        if typeKind == compilerBodyTypeInt() {
            return rawBufferAppendText(buffer: output, text: "\(scalar)")
        }
        if typeKind == compilerBodyTypeBool() {
            if scalar == 0 { return rawBufferAppendText(buffer: output, text: "false") }
            if scalar == 1 { return rawBufferAppendText(buffer: output, text: "true") }
        }
        return 0 - 1
    }
    if kind == compilerMacroValueKindArray() {
        state syntaxElements: Bool(true)
        state ordinal: Int(0)
        while ordinal < childCount && syntaxElements {
            syntaxElements: compilerMacroExpansionBindingIsSyntax(tables: tables, bindingRow: compilerMacroExpansionBindingChildRow(tables: tables, bindingRow: bindingRow, ordinal: ordinal))
            ordinal: ordinal + 1
        }
        if !syntaxElements && rawBufferAppendText(buffer: output, text: "[") != 0 { return 0 - 1 }
        ordinal: 0
        while ordinal < childCount {
            if ordinal > 0 {
                if syntaxElements {
                    if rawBufferAppendText(buffer: output, text: "\n") != 0 { return 0 - 1 }
                } else if rawBufferAppendText(buffer: output, text: ", ") != 0 { return 0 - 1 }
            }
            let childRow: Int(compilerMacroExpansionBindingChildRow(tables: tables, bindingRow: bindingRow, ordinal: ordinal))
            if childRow < 0 || compilerMacroAppendExpansionBindingValue(tables: tables, output: output, bindingRow: childRow) != 0 { return 0 - 1 }
            ordinal: ordinal + 1
        }
        if !syntaxElements { return rawBufferAppendText(buffer: output, text: "]") }
        return 0
    }
    if kind == compilerMacroValueKindEnum() {
        state nominalName: String("")
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: nominalSyntaxID))
        if declarationRow >= 0 {
            nominalName: compilerTypedSyntaxLocalText(
                tables: tables,
                fileID: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1),
                localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7),
                localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)
            )
        }
        if nominalName == String("Optional") {
            if scalar == 0 && childCount == 0 { return rawBufferAppendText(buffer: output, text: "nil") }
            if scalar == 1 && childCount == 1 {
                return compilerMacroAppendExpansionBindingValue(tables: tables, output: output, bindingRow: compilerMacroExpansionBindingChildRow(tables: tables, bindingRow: bindingRow, ordinal: 0))
            }
        }
        return 0 - 1
    }
    return 0 - 1
}

function compilerMacroComposeGeneratedFunction(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, row: Int): Int {
    let templateRow: Int(compilerMacroExpansionTemplateRowForOrdinal(
        tables: tables,
        macroDeclarationRow: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12),
        ordinal: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14)
    ))
    let applicationRow: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 13))
    let parentInvocationRow: Int(compilerMacroInvocationRowForApplication(tables: tables, applicationRow: applicationRow))
    if templateRow < 0 || templateRow >= compilerIntTableRowCount(table: tables.macroExpansionTemplates) || parentInvocationRow < 0 {
        return 0 - 1
    }
    let fileID: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 2))
    let declarationStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 5))
    let declarationEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 6))
    let bodyStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 13))
    let bodyEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 14))
    let declarationGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: declarationStart))
    let bodyGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: bodyStart))
    let bodyGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: bodyEnd))
    let declarationGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: declarationEnd))
    if declarationGlobalStart < 0 || bodyGlobalStart < declarationGlobalStart || bodyGlobalEnd < bodyGlobalStart || declarationGlobalEnd < bodyGlobalEnd {
        return 0 - 1
    }
    let output: RawBuffer(rawBufferCreate(capacity: declarationEnd - declarationStart + 256, stride: 1))
    if rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: tables.sourceStore.source, start: declarationGlobalStart, end: bodyGlobalStart)) != 0 {
        rawBufferDestroy(buffer: output)
        return 0 - 1
    }
    state fragmentRow: Int(0)
    state replacementCount: Int(0)
    state valid: Bool(true)
    while fragmentRow < compilerIntTableRowCount(table: tables.macroExpansionFragments) && valid {
        if compilerIntTableValue(table: tables.macroExpansionFragments, row: fragmentRow, column: 1) == templateRow
            && compilerIntTableValue(table: tables.macroExpansionFragments, row: fragmentRow, column: 2) < 0 {
            let kind: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: fragmentRow, column: 4))
            if kind == compilerMacroExpansionFragmentAuthored() {
                let start: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.macroExpansionFragments, row: fragmentRow, column: 6)))
                let end: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.macroExpansionFragments, row: fragmentRow, column: 7)))
                if start < 0 || end < start || rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: tables.sourceStore.source, start: start, end: end)) != 0 {
                    valid: false
                }
            } else if kind == compilerMacroExpansionFragmentChildMacro() {
                let childApplicationRow: Int(compilerMacroChildApplicationForFragment(tables: tables, parentInvocationRow: parentInvocationRow, templateRow: templateRow, fragmentRow: fragmentRow))
                if childApplicationRow < 0 || compilerMacroAppendChildArtifacts(tables: tables, output: output, childApplicationRow: childApplicationRow) <= 0 {
                    valid: false
                } else {
                    replacementCount: replacementCount + 1
                }
            } else if kind == compilerMacroExpansionFragmentBoundary() {
                let bindingRow: Int(compilerMacroExpansionBindingForFragment(tables: tables, parentInvocationRow: parentInvocationRow, templateRow: templateRow, fragmentRow: fragmentRow))
                if bindingRow < 0 || compilerMacroAppendExpansionBindingValue(tables: tables, output: output, bindingRow: bindingRow) != 0 {
                    valid: false
                } else {
                    replacementCount: replacementCount + 1
                }
            } else {
                valid: false
            }
        }
        fragmentRow: fragmentRow + 1
    }
    if valid && rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: tables.sourceStore.source, start: bodyGlobalEnd, end: declarationGlobalEnd)) != 0 {
        valid: false
    }
    if !valid {
        rawBufferDestroy(buffer: output)
        return 0 - 1
    }
    if replacementCount == 0 {
        rawBufferDestroy(buffer: output)
        return 0
    }
    let composed: String(compilerCoreRawBufferMaterializeAndDestroy(buffer: output))
    let generatedFileID: Int(compilerSourceStoreAppendGeneratedFile(store: tables.sourceStore, path: "MacroExpansion/\(row).range", content: composed))
    if generatedFileID < 0 { return 0 - 1 }
    let bodyOffset: Int(bodyStart - declarationStart)
    let bodyLength: Int(stringLength(value: composed) - (declarationEnd - bodyEnd) - bodyOffset)
    let base: Int(row * delta.generatedFunctions.columnCount)
    if delta.generatedFunctions.values.update(element: generatedFileID, index: base + 3) != 0
        || delta.generatedFunctions.values.update(element: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 7) - declarationStart, index: base + 4) != 0
        || delta.generatedFunctions.values.update(element: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 8) - declarationStart, index: base + 5) != 0
        || delta.generatedFunctions.values.update(element: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 9) - declarationStart, index: base + 6) != 0
        || delta.generatedFunctions.values.update(element: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 10) - declarationStart, index: base + 7) != 0
        || delta.generatedFunctions.values.update(element: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 11) - declarationStart, index: base + 8) != 0
        || delta.generatedFunctions.values.update(element: compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 12) - declarationStart, index: base + 9) != 0
        || delta.generatedFunctions.values.update(element: bodyOffset, index: base + 10) != 0
        || delta.generatedFunctions.values.update(element: bodyOffset + bodyLength, index: base + 11) != 0 {
        return 0 - 1
    }
    return 0
}

function compilerMacroComposeGeneratedFunctions(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.generatedFunctions) {
        if compilerMacroComposeGeneratedFunction(tables: tables, delta: delta, row: row) != 0 { return 0 - 1 }
        row: row + 1
    }
    return 0
}

function compilerMacroGraphDeltaCommittedGeneratedFunctionRow(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, generatedRow: Int): Int {
    let deltaCount: Int(compilerIntTableRowCount(table: delta.generatedFunctions))
    let expectedFunctionRow: Int(compilerIntTableRowCount(table: tables.functions) - deltaCount + generatedRow)
    if generatedRow < 0 || generatedRow >= deltaCount || expectedFunctionRow < 0 || expectedFunctionRow >= compilerIntTableRowCount(table: tables.functions) {
        return 0 - 1
    }
    let owner: Int(compilerIntTableValue(table: delta.generatedFunctions, row: generatedRow, column: 2))
    if expectedFunctionRow >= tables.functionOwners.count
        || tables.functionOwners.element(index: expectedFunctionRow) != owner { return 0 - 1 }
    let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: expectedFunctionRow, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
    if declarationRow < 0 { return 0 - 1 }
    if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 11) != compilerIntTableValue(table: delta.generatedFunctions, row: generatedRow, column: 19)
        || compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 12) != compilerIntTableValue(table: delta.generatedFunctions, row: generatedRow, column: 20) { return 0 - 1 }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let generatedName: String(compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: generatedRow))
    if candidate != generatedName { return 0 - 1 }
    return expectedFunctionRow
}

function compilerMacroGraphDeltaHasAuthoredFunctionCollisionForGeneratedRow(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, generatedRow: Int): Bool {
    let owner: Int(compilerIntTableValue(table: delta.generatedFunctions, row: generatedRow, column: 2))
    let name: String(compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: generatedRow))
    let ignoredFunctionRow: Int(compilerMacroGraphDeltaCommittedGeneratedFunctionRow(tables: tables, delta: delta, generatedRow: generatedRow))
    return compilerMacroGraphDeltaHasAuthoredFunctionCollisionExcluding(tables: tables, ownerTargetSyntaxID: owner, name: name, ignoredFunctionRow: ignoredFunctionRow)
}

function compilerMacroGraphDeltaGeneratedFunctionTemplateIsSupported(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, row: Int): Bool {
    let macroDeclarationRow: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12))
    let templateOrdinal: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14))
    let templateRow: Int(compilerMacroExpansionTemplateRowForOrdinal(tables: tables, macroDeclarationRow: macroDeclarationRow, ordinal: templateOrdinal))
    if templateRow < 0 || compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18) != compilerGraphGeneratedKindFunction() { return false }
    let fileID: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 3))
    state declarationStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 5))
    state expectedDeclarationEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 6))
    if compilerSourceStoreFileRole(store: tables.sourceStore, fileID: fileID) == compilerSourceRoleGenerated() {
        declarationStart: 0
        expectedDeclarationEnd: compilerSourceStoreFileContentEnd(store: tables.sourceStore, fileID: fileID) - compilerSourceStoreFileContentStart(store: tables.sourceStore, fileID: fileID)
    }
    let declarationGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: declarationStart))
    let maybeKeyword: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: declarationGlobalStart))
    if maybeKeyword == nil { return false }
    let keyword: RangeLexedToken(maybeKeyword ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $tables.sourceStore.source, index: declarationGlobalStart)))
    if keyword.text != String("function") { return false }
    state parserKeywordText: String(keyword.text)
    let parserKeyword: RangeLexedToken(kind: keyword.kind, start: keyword.start, end: keyword.end, text: parserKeywordText)
    let maybeParts: Optional<CompilerFunctionDeclarationParts>(compilerCoreParseFunctionDeclarationParts(source: tables.sourceStore.source, keyword: parserKeyword))
    if maybeParts == nil { return false }
    let parts: CompilerFunctionDeclarationParts(maybeParts ?? CompilerFunctionDeclarationParts(nameToken: compilerFallbackTokenAt(index: keyword.end), genericRange: CompilerSourceRange(start: keyword.end, end: keyword.end, next: keyword.end), parameterRange: CompilerSourceRange(start: keyword.end, end: keyword.end, next: keyword.end), returnType: CompilerTypeReference(text: String(""), start: keyword.end, end: keyword.end), bodyRange: CompilerSourceRange(start: keyword.end, end: keyword.end, next: keyword.end)))
    let expectedNameStart: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 4))
    let expectedNameEnd: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 5))
    let expectedParameterStart: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 6))
    let expectedParameterEnd: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 7))
    let expectedReturnStart: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 8))
    let expectedReturnEnd: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 9))
    let expectedBodyStart: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 10))
    let expectedBodyEnd: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 11))
    return parts.bodyRange.next == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedDeclarationEnd)
        && parts.nameToken.start == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedNameStart)
        && parts.nameToken.end == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedNameEnd)
        && parts.parameterRange.start == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedParameterStart)
        && parts.parameterRange.end == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedParameterEnd)
        && parts.returnType.start == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedReturnStart)
        && parts.returnType.end == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedReturnEnd)
        && parts.bodyRange.start == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedBodyStart)
        && parts.bodyRange.end == compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: expectedBodyEnd)
}

function compilerMacroGraphDeltaHasGeneratedFunctionCollision(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.generatedFunctions) {
        let owner: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 2))
        let name: String(compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: row))
        if compilerMacroGraphDeltaHasAuthoredFunctionCollisionForGeneratedRow(tables: tables, delta: delta, generatedRow: row) { return true }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: delta.generatedFunctions, row: priorRow, column: 2) == owner
                && compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: priorRow) == name { return true }
            priorRow: priorRow + 1
        }
        row: row + 1
    }
    return false
}

function compilerMacroGraphDeltaGeneratedFunctionPlacementIsValid(tables: CompilerSyntaxTables, owner: Int, placement: Int, lexicalParentOrdinal: Int, parentFingerprintFirst: Int, parentFingerprintSecond: Int, templateRow: Int): Bool {
    if templateRow < 0 || compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18) != compilerGraphGeneratedKindFunction()
        || compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 19) != placement
        || compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 25) != lexicalParentOrdinal { return false }
    if placement == compilerMacroExpansionTemplatePlacementRoot() {
        return owner == 0 - 1 && lexicalParentOrdinal == 0 - 1 && parentFingerprintFirst == 0 && parentFingerprintSecond == 0
    }
    if placement != compilerMacroExpansionTemplatePlacementMember()
        || owner < 0 || owner >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerIntTableValue(table: tables.syntaxIndex, row: owner, column: 0) != compilerSyntaxKindConstruct()
        || lexicalParentOrdinal < 0
        || (parentFingerprintFirst == 0 && parentFingerprintSecond == 0) { return false }
    let lexicalParent: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 20))
    if lexicalParent < 0 || lexicalParent >= templateRow
        || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 18) != compilerMacroExpansionTemplateKindExtension()
        || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 15) != lexicalParentOrdinal { return false }
    let expectedParentFingerprint: CompilerFingerprint(compilerMacroExpansionTemplateParentFingerprint(tables: tables, extensionRow: lexicalParent))
    return expectedParentFingerprint.first == parentFingerprintFirst && expectedParentFingerprint.second == parentFingerprintSecond
}

function compilerMacroGraphDeltaGeneratedFunctionsAreValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Bool {
    if !compilerIntTableIsComplete(table: delta.generatedFunctions) { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.generatedFunctions) {
        let owner: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 2))
        let fileID: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 3))
        let name: String(compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: row))
        let placement: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 21))
        let lexicalParentOrdinal: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 22))
        let parentFingerprintFirst: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 23))
        let parentFingerprintSecond: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 24))
        let macroDeclarationRow: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12))
        let templateOrdinal: Int(compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14))
        let templateRow: Int(compilerMacroExpansionTemplateRowForOrdinal(tables: tables, macroDeclarationRow: macroDeclarationRow, ordinal: templateOrdinal))
        if compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 0) != row
            || compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 1) != compilerGraphGeneratedKindFunction()
            || (placement != compilerMacroExpansionTemplatePlacementRoot() && placement != compilerMacroExpansionTemplatePlacementMember())
            || !compilerMacroGraphDeltaGeneratedFunctionPlacementIsValid(tables: tables, owner: owner, placement: placement, lexicalParentOrdinal: lexicalParentOrdinal, parentFingerprintFirst: parentFingerprintFirst, parentFingerprintSecond: parentFingerprintSecond, templateRow: templateRow)
            || fileID < 0 || fileID >= compilerSourceStoreFileCount(store: tables.sourceStore)
            || name == String("")
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 4), end: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 5), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 6), end: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 7), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 8), end: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 9), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 10), end: compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 11), optional: false)
            || compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12) < 0
            || compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 12) >= compilerIntTableRowCount(table: tables.macroDeclarations)
            || compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 13) < 0
            || compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 13) >= compilerIntTableRowCount(table: tables.macroApplications)
            || compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 14) < 0
            || (compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 15) == 0 && compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 16) == 0)
            || (compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 17) == 0 && compilerIntTableValue(table: delta.generatedFunctions, row: row, column: 18) == 0)
            || !compilerMacroGraphDeltaGeneratedFunctionTemplateIsSupported(tables: tables, delta: delta, row: row) { return false }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: delta.generatedFunctions, row: priorRow, column: 2) == owner
                && compilerMacroGraphDeltaGeneratedFunctionName(tables: tables, delta: delta, row: priorRow) == name { return false }
            priorRow: priorRow + 1
        }
        if compilerMacroGraphDeltaHasAuthoredFunctionCollisionForGeneratedRow(tables: tables, delta: delta, generatedRow: row) { return false }
        row: row + 1
    }
    return true
}

function compilerMacroGraphDeltaGeneratedMemberName(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, row: Int): String {
    let fileID: Int(compilerIntTableValue(table: delta.generatedMembers, row: row, column: 3))
    return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 6), localEnd: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 7))
}

function compilerMacroGraphDeltaHasAuthoredMemberCollisionExcluding(tables: CompilerSyntaxTables, ownerTargetSyntaxID: Int, name: String, ignoredMemberRow: Int): Bool {
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        if memberRow != ignoredMemberRow && compilerIntTableValue(table: tables.members, row: memberRow, column: 2) == ownerTargetSyntaxID {
            let fileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 7)))
            if candidate == name { return true }
        }
        memberRow: memberRow + 1
    }
    return false
}

function compilerMacroGraphDeltaCommittedGeneratedMemberRow(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, generatedRow: Int): Int {
    let deltaCount: Int(compilerIntTableRowCount(table: delta.generatedMembers))
    let expectedMemberRow: Int(compilerIntTableRowCount(table: tables.members) - deltaCount + generatedRow)
    if generatedRow < 0 || generatedRow >= deltaCount || expectedMemberRow < 0 || expectedMemberRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: tables.members, row: expectedMemberRow, column: 2) != compilerIntTableValue(table: delta.generatedMembers, row: generatedRow, column: 2) { return 0 - 1 }
    let syntaxID: Int(compilerIntTableValue(table: tables.members, row: expectedMemberRow, column: 0))
    if syntaxID < 0 || syntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex) || compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) != compilerSyntaxKindMember() { return 0 - 1 }
    let fingerprintFirst: Int(compilerIntTableValue(table: tables.members, row: expectedMemberRow, column: 10))
    let fingerprintSecond: Int(compilerIntTableValue(table: tables.members, row: expectedMemberRow, column: 11))
    if fingerprintFirst != compilerIntTableValue(table: delta.generatedMembers, row: generatedRow, column: 17)
        || fingerprintSecond != compilerIntTableValue(table: delta.generatedMembers, row: generatedRow, column: 18) { return 0 - 1 }
    return expectedMemberRow
}

function compilerMacroGraphDeltaHasAuthoredMemberCollisionForGeneratedRow(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, generatedRow: Int): Bool {
    let owner: Int(compilerIntTableValue(table: delta.generatedMembers, row: generatedRow, column: 2))
    let name: String(compilerMacroGraphDeltaGeneratedMemberName(tables: tables, delta: delta, row: generatedRow))
    let ignoredMemberRow: Int(compilerMacroGraphDeltaCommittedGeneratedMemberRow(tables: tables, delta: delta, generatedRow: generatedRow))
    return compilerMacroGraphDeltaHasAuthoredMemberCollisionExcluding(tables: tables, ownerTargetSyntaxID: owner, name: name, ignoredMemberRow: ignoredMemberRow)
}

