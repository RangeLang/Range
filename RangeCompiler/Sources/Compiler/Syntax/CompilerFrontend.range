function compilerTypedSyntaxCapture(source: String, tables: CompilerSyntaxTables): Int {
    return compilerTypedSyntaxCaptureWithPolicy(source: source, tables: tables, captureBodies: true, captureMain: true)
}

function compilerTypedDeclarationsCapture(source: String, tables: CompilerSyntaxTables): Int {
    let captureStatus: Int(compilerTypedSyntaxCaptureWithPolicy(source: source, tables: tables, captureBodies: false, captureMain: false))
    if captureStatus != 0 { return captureStatus }
    return compilerSyntaxRejectMissingTypeReferences(tables: tables)
}

function compilerBuiltinPolicyNone(): Int { return 0 }
function compilerBuiltinPolicyRuntime(): Int { return 1 }
function compilerBuiltinPolicyStorage(): Int { return 2 }
function compilerBuiltinPolicyCreate(): Int { return 3 }
function compilerBuiltinPolicyRead(): Int { return 4 }
function compilerBuiltinPolicyWrite(): Int { return 5 }
function compilerBuiltinPolicyDestroy(): Int { return 6 }
function compilerBuiltinPolicyTarget(): Int { return 7 }

function compilerBuiltinPolicyForName(name: String): Int {
    if name == String("storage") { return compilerBuiltinPolicyStorage() }
    if name == String("create") { return compilerBuiltinPolicyCreate() }
    if name == String("read") { return compilerBuiltinPolicyRead() }
    if name == String("write") { return compilerBuiltinPolicyWrite() }
    if name == String("destroy") { return compilerBuiltinPolicyDestroy() }
    if name == String("target") { return compilerBuiltinPolicyTarget() }
    return compilerBuiltinPolicyNone()
}

function compilerTypedSyntaxCaptureWithPolicy(source: String, tables: CompilerSyntaxTables, captureBodies: Bool, captureMain: Bool): Int {
