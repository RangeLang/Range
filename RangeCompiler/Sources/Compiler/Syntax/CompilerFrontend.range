            || compilerIntTableValue(table: delta.facts, row: row, column: 1) != row
            || compilerIntTableValue(table: delta.facts, row: row, column: 2) != row
            || compilerIntTableValue(table: delta.facts, row: row, column: 3) != compilerGraphRoleExpansion()
            || compilerIntTableValue(table: delta.facts, row: row, column: 4) != row { return false }
