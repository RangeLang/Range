}

function compilerSyntaxBuiltinTypeGenericParameterKind(typeID: Int, ordinal: Int): Int {
    if typeID == compilerSyntaxBuiltinTypeInt() && ordinal >= 0 && ordinal < 2 {
        return compilerSyntaxGenericParameterValueKind()
    }
    if typeID == compilerSyntaxBuiltinTypeFloat() && ordinal == 0 {
        return compilerSyntaxGenericParameterValueKind()
    }
    return 0 - 1
}

