        let scalarTypeID: Int(compilerIntTableValue(table: arena.mirValues, row: constantResultValueID, column: compilerBodyMIRValueTypeIDColumn()))
        let scalarStoreValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: scalarTypeKind, typeID: scalarTypeID, scalar: scalarValue))
