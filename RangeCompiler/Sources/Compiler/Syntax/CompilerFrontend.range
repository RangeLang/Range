        || operationKind == compilerBodyMIROperationMultiply() || operationKind == compilerBodyMIROperationDivide()
        || operationKind == compilerBodyMIROperationRemainder() || operationKind == compilerBodyMIROperationLessThan()
        || operationKind == compilerBodyMIROperationLessEqual() || operationKind == compilerBodyMIROperationGreaterThan()
        || operationKind == compilerBodyMIROperationGreaterEqual() {
        let leftValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
        let rightValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 1))
        let binaryResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let binaryOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
        state binaryScalarResult: Int(0)
        state binaryOperationValid: Bool(binaryOperandCount == 2
            && leftValueID >= 0 && leftValueID < evaluationValues.count
            && rightValueID >= 0 && rightValueID < evaluationValues.count)
        if binaryOperationValid {
            let leftValue: Int(compilerMacroValueStoreScalar(store: store, valueID: evaluationValues.element(index: leftValueID)))
            let rightValue: Int(compilerMacroValueStoreScalar(store: store, valueID: evaluationValues.element(index: rightValueID)))
            if operationKind == compilerBodyMIROperationEqual() { if leftValue == rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationNotEqual() { if leftValue != rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationAnd() { if leftValue != 0 && rightValue != 0 { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationOr() { if leftValue != 0 || rightValue != 0 { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationAdd() { binaryScalarResult: leftValue + rightValue }
            if operationKind == compilerBodyMIROperationSubtract() { binaryScalarResult: leftValue - rightValue }
            if operationKind == compilerBodyMIROperationMultiply() { binaryScalarResult: leftValue * rightValue }
            if operationKind == compilerBodyMIROperationDivide() {
                if rightValue == 0 { binaryOperationValid: false } else { binaryScalarResult: leftValue / rightValue }
            }
            if operationKind == compilerBodyMIROperationRemainder() {
                if rightValue == 0 { binaryOperationValid: false } else { binaryScalarResult: leftValue % rightValue }
            }
            if operationKind == compilerBodyMIROperationLessThan() { if leftValue < rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationLessEqual() { if leftValue <= rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationGreaterThan() { if leftValue > rightValue { binaryScalarResult: 1 } }
            if operationKind == compilerBodyMIROperationGreaterEqual() { if leftValue >= rightValue { binaryScalarResult: 1 } }
