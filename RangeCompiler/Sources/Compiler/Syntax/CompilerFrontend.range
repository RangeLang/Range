        || tables.macroInvocations.values.update(element: stepCount, index: base + 28) != 0
        || tables.macroInvocations.values.update(element: pipelineStatus, index: base + 33) != 0
        || tables.macroInvocations.values.update(element: pipelineFailureCode, index: base + 34) != 0 { return 0 - 1 }
    return 0
}

function compilerMacroExecutionAppendResult(
    tables: CompilerSyntaxTables,
    invocationRow: Int,
    applicationRow: Int,
    declarationRow: Int,
    targetSyntaxID: Int,
    resultKind: Int,
    resultTypeKind: Int,
    resultNominalSyntaxID: Int,
    resultScalar: Int,
    resultChildCount: Int,
    parentResultRow: Int,
    childOrdinal: Int
): Int {
    let row: Int(compilerIntTableRowCount(table: tables.macroResults))
    if compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: row) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: invocationRow) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: applicationRow) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: declarationRow) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: targetSyntaxID) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: resultKind) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: resultTypeKind) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: resultNominalSyntaxID) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: resultScalar) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: resultChildCount) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: parentResultRow) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroResults, value: childOrdinal) != 0 { return 0 - 1 }
    return row
}

function compilerMacroExecutionPersistResultValue(
    tables: CompilerSyntaxTables,
    arena: CompilerBodyArena,
    store: CompilerMacroValueStore,
    invocationRow: Int,
    applicationRow: Int,
    declarationRow: Int,
    targetSyntaxID: Int,
    storeValueID: Int,
    parentResultRow: Int,
    childOrdinal: Int
): Int {
    if storeValueID < 0 || storeValueID >= store.kinds.count { return 0 - 1 }
    let resultTypeID: Int(store.typeIDs.element(index: storeValueID))
    state resultNominalSyntaxID: Int(0 - 1)
    if resultTypeID >= 0 && resultTypeID < compilerIntTableRowCount(table: arena.typeInstances) {
        resultNominalSyntaxID: compilerIntTableValue(
            table: arena.typeInstances,
            row: resultTypeID,
            column: compilerBodyTypeInstanceNominalSyntaxColumn()
        )
    }
    let resultRow: Int(compilerMacroExecutionAppendResult(
        tables: tables,
        invocationRow: invocationRow,
        applicationRow: applicationRow,
        declarationRow: declarationRow,
        targetSyntaxID: targetSyntaxID,
        resultKind: store.kinds.element(index: storeValueID),
        resultTypeKind: store.typeKinds.element(index: storeValueID),
        resultNominalSyntaxID: resultNominalSyntaxID,
        resultScalar: store.scalars.element(index: storeValueID),
        resultChildCount: store.childCounts.element(index: storeValueID),
        parentResultRow: parentResultRow,
        childOrdinal: childOrdinal
    ))
    if resultRow < 0 { return 0 - 1 }
    state ordinal: Int(0)
    while ordinal < store.childCounts.element(index: storeValueID) {
        let childStoreValueID: Int(compilerMacroValueStoreChild(
            store: store,
            valueID: storeValueID,
            ordinal: ordinal
        ))
        if compilerMacroExecutionPersistResultValue(
            tables: tables,
            arena: arena,
            store: store,
            invocationRow: invocationRow,
            applicationRow: applicationRow,
            declarationRow: declarationRow,
            targetSyntaxID: targetSyntaxID,
            storeValueID: childStoreValueID,
            parentResultRow: resultRow,
            childOrdinal: ordinal
        ) < 0 { return 0 - 1 }
        ordinal: ordinal + 1
    }
    return resultRow
}

function compilerMacroExecutionAppendEvent(tables: CompilerSyntaxTables, invocationRow: Int, operation: Int, arena: CompilerBodyArena, operationRow: Int, messageValueID: Int, identity: CompilerFingerprint): Int {
    let row: Int(compilerIntTableRowCount(table: tables.macroExecutionEvents))
    let messageNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: messageValueID, column: compilerBodyMIRValueSourceColumn()))
    let sourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationSourceColumn()))
    let severity: Int(compilerMacroDiagnosticsSeverityForOperation(operation: operation))
    if messageNodeID < 0 || messageNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: row) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: invocationRow) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: severity) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: operation) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: arena.fileID) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: compilerIntTableValue(table: arena.nodes, row: messageNodeID, column: 4)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: compilerIntTableValue(table: arena.nodes, row: messageNodeID, column: 5)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: arena.fileID) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 4)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 5)) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: identity.first) != 0
        || compilerSyntaxTableAppend(tables: tables, table: tables.macroExecutionEvents, value: identity.second) != 0 { return 0 - 1 }
    return row
}

function compilerMacroExecutionErrorIdentity(base: CompilerFingerprint, code: Int, row: Int): CompilerFingerprint {
    state identity: CompilerFingerprint(base)
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: code)
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: row)
    return identity
}

function compilerMacroValueKindScalar(): Int { return 1 }
function compilerMacroValueKindArray(): Int { return 2 }
function compilerMacroValueKindConstruct(): Int { return 3 }
function compilerMacroValueKindEnum(): Int { return 4 }
function compilerMacroValueKindSyntax(): Int { return 5 }
function compilerMacroValueKindCapability(): Int { return 6 }
function compilerMacroValueKindEnvironment(): Int { return 7 }

function compilerMacroValueStoreCreate(): CompilerMacroValueStore {
    return CompilerMacroValueStore(
        kinds: bufferCreateInt(capacity: 64),
        typeKinds: bufferCreateInt(capacity: 64),
        typeIDs: bufferCreateInt(capacity: 64),
        scalars: bufferCreateInt(capacity: 64),
        firstChildren: bufferCreateInt(capacity: 64),
        childCounts: bufferCreateInt(capacity: 64),
        children: bufferCreateInt(capacity: 128)
    )
}

function compilerMacroValueStoreDestroy(store: CompilerMacroValueStore): Int {
    state status: Int(0)
    if store.kinds.destroy() != 0 { status: 0 - 1 }
    if store.typeKinds.destroy() != 0 { status: 0 - 1 }
    if store.typeIDs.destroy() != 0 { status: 0 - 1 }
    if store.scalars.destroy() != 0 { status: 0 - 1 }
    if store.firstChildren.destroy() != 0 { status: 0 - 1 }
    if store.childCounts.destroy() != 0 { status: 0 - 1 }
    if store.children.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerMacroValueStoreAppend(
    store: CompilerMacroValueStore,
    kind: Int,
    typeKind: Int,
    typeID: Int,
    scalar: Int,
    firstChild: Int,
    childCount: Int
): Int {
    let valueID: Int(store.kinds.count)
    if store.typeKinds.count != valueID || store.typeIDs.count != valueID
        || store.scalars.count != valueID || store.firstChildren.count != valueID
        || store.childCounts.count != valueID { return 0 - 1 }
    if store.kinds.append(element: kind) != 0
        || store.typeKinds.append(element: typeKind) != 0
        || store.typeIDs.append(element: typeID) != 0
        || store.scalars.append(element: scalar) != 0
        || store.firstChildren.append(element: firstChild) != 0
        || store.childCounts.append(element: childCount) != 0 { return 0 - 1 }
    return valueID
}

function compilerMacroValueStoreAppendScalar(
    store: CompilerMacroValueStore,
    typeKind: Int,
    typeID: Int,
    scalar: Int
): Int {
    return compilerMacroValueStoreAppend(
        store: store,
        kind: compilerMacroValueKindScalar(),
        typeKind: typeKind,
        typeID: typeID,
        scalar: scalar,
        firstChild: store.children.count,
        childCount: 0
    )
}

function compilerMacroValueStoreAppendAggregate(
    store: CompilerMacroValueStore,
    kind: Int,
    typeKind: Int,
    typeID: Int,
    scalar: Int,
    children: Buffer<Int>
): Int {
    let firstChild: Int(store.children.count)
    state ordinal: Int(0)
    while ordinal < children.count {
        if store.children.append(element: children.element(index: ordinal)) != 0 { return 0 - 1 }
        ordinal: ordinal + 1
    }
    return compilerMacroValueStoreAppend(
        store: store,
        kind: kind,
        typeKind: typeKind,
        typeID: typeID,
        scalar: scalar,
        firstChild: firstChild,
        childCount: children.count
    )
}

function compilerMacroExecutionCapabilityHandleRow(tables: CompilerSyntaxTables, invocationRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroCapabilityHandles) {
        if compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 1) == invocationRow
            && compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 3) == compilerMacroCapabilityTarget() {
            return row
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroExecutionMaterializeEnvironment(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    invocationRow: Int,
    targetSyntaxID: Int
): Int {
    let handleRow: Int(compilerMacroExecutionCapabilityHandleRow(tables: tables, invocationRow: invocationRow))
    if handleRow < 0
        || compilerIntTableValue(table: tables.macroCapabilityHandles, row: handleRow, column: 5) != targetSyntaxID {
        return 0 - 1
    }
    let targetValueID: Int(compilerMacroValueStoreAppend(
        store: store,
        kind: compilerMacroValueKindSyntax(),
        typeKind: compilerBodyTypeMacroTarget(),
        typeID: 0 - 1,
        scalar: targetSyntaxID,
        firstChild: store.children.count,
        childCount: 0
    ))
    let diagnosticsValueID: Int(compilerMacroValueStoreAppend(
        store: store,
        kind: compilerMacroValueKindCapability(),
        typeKind: compilerBodyTypeMacroDiagnostics(),
        typeID: 0 - 1,
        scalar: handleRow,
        firstChild: store.children.count,
        childCount: 0
    ))
    let graphValueID: Int(compilerMacroValueStoreAppend(
        store: store,
        kind: compilerMacroValueKindCapability(),
        typeKind: compilerBodyTypeMacroGraph(),
        typeID: 0 - 1,
        scalar: handleRow,
        firstChild: store.children.count,
        childCount: 0
    ))
    if targetValueID < 0 || diagnosticsValueID < 0 || graphValueID < 0 { return 0 - 1 }
    let environmentChildren: Buffer<Int>(bufferCreateInt(capacity: 3))
    state childrenValid: Bool(environmentChildren.append(element: targetValueID) == 0)
    if childrenValid && environmentChildren.append(element: diagnosticsValueID) != 0 { childrenValid: false }
    if childrenValid && environmentChildren.append(element: graphValueID) != 0 { childrenValid: false }
    state environmentValueID: Int(0 - 1)
    if childrenValid {
        environmentValueID: compilerMacroValueStoreAppendAggregate(
            store: store,
            kind: compilerMacroValueKindEnvironment(),
            typeKind: compilerBodyTypeMacroTarget(),
            typeID: 0 - 1,
            scalar: handleRow,
            children: environmentChildren
        )
    }
    environmentChildren.destroy()
    return environmentValueID
}

function compilerMacroExecutionMemberRowForSyntaxID(tables: CompilerSyntaxTables, syntaxID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: row, column: 0) == syntaxID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerMacroValueStoreScalar(store: CompilerMacroValueStore, valueID: Int): Int {
    if valueID < 0 || valueID >= store.kinds.count
        || store.kinds.element(index: valueID) != compilerMacroValueKindScalar() { return 0 }
    return store.scalars.element(index: valueID)
}

function compilerMacroValueStoreChild(store: CompilerMacroValueStore, valueID: Int, ordinal: Int): Int {
    if valueID < 0 || valueID >= store.kinds.count || ordinal < 0
        || ordinal >= store.childCounts.element(index: valueID) { return 0 - 1 }
    return store.children.element(index: store.firstChildren.element(index: valueID) + ordinal)
}

function compilerMacroExecutionAppendPlaceholderValue(store: CompilerMacroValueStore): Int {
    return compilerMacroValueStoreAppendScalar(
        store: store,
        typeKind: compilerBodyTypeUnknown(),
        typeID: 0 - 1,
        scalar: 0
    )
}

function compilerMacroExecutionMaterializePersistedResult(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    resultRow: Int
): Int {
    if resultRow < 0 || resultRow >= compilerIntTableRowCount(table: tables.macroResults) { return 0 - 1 }
    let children: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 9)))
    state childRow: Int(resultRow + 1)
    state childrenValid: Bool(true)
    while childRow < compilerIntTableRowCount(table: tables.macroResults) && childrenValid {
        if compilerIntTableValue(table: tables.macroResults, row: childRow, column: 10) == resultRow {
            let expectedOrdinal: Int(children.count)
            if compilerIntTableValue(table: tables.macroResults, row: childRow, column: 11) != expectedOrdinal {
                childrenValid: false
            } else {
                let childValueID: Int(compilerMacroExecutionMaterializePersistedResult(
                    tables: tables,
                    store: store,
                    resultRow: childRow
                ))
                if childValueID < 0 || children.append(element: childValueID) != 0 { childrenValid: false }
            }
        }
        childRow: childRow + 1
    }
    state valueID: Int(0 - 1)
    if childrenValid
        && children.count == compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 9) {
        valueID: compilerMacroValueStoreAppendAggregate(
            store: store,
            kind: compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 5),
            typeKind: compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 6),
            typeID: 0 - 1,
            scalar: compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 8),
            children: children
        )
    }
    children.destroy()
    return valueID
}

function compilerMacroExecutionRootResultRow(tables: CompilerSyntaxTables, applicationRow: Int): Int {
    state resultRow: Int(0)
    while resultRow < compilerIntTableRowCount(table: tables.macroResults) {
        if compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 2) == applicationRow
            && compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 10) < 0 {
            return resultRow
        }
        resultRow: resultRow + 1
    }
    return 0 - 1
}

function compilerMacroExecutionMaterializeIdentifier(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    applicationRow: Int
): Int {
    let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(
        tables: tables,
        fileID: fileID,
        localStart: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 4),
        localEnd: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 5)
    ))
    let identity: CompilerFingerprint(compilerMacroExecutionApplicationIdentity(tables: tables, applicationRow: applicationRow))
    let nameValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeString(), typeID: 0 - 1, scalar: compilerDeclarationNameHash(name: name)))
    let identityValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeString(), typeID: 0 - 1, scalar: identity.first))
    let parentValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let sourceValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let children: Buffer<Int>(bufferCreateInt(capacity: 4))
    state valid: Bool(nameValueID >= 0 && identityValueID >= 0 && parentValueID >= 0 && sourceValueID >= 0)
    if valid && children.append(element: nameValueID) != 0 { valid: false }
    if valid && children.append(element: identityValueID) != 0 { valid: false }
    if valid && children.append(element: parentValueID) != 0 { valid: false }
    if valid && children.append(element: sourceValueID) != 0 { valid: false }
    state identifierValueID: Int(0 - 1)
    if valid {
        identifierValueID: compilerMacroValueStoreAppendAggregate(
            store: store,
            kind: compilerMacroValueKindConstruct(),
            typeKind: compilerBodyTypeConstruct(),
            typeID: 0 - 1,
            scalar: applicationRow,
            children: children
        )
    }
    children.destroy()
    return identifierValueID
}

function compilerMacroExecutionMaterializeSyntaxIdentifier(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    syntaxID: Int,
    typeID: Int
): Int {
    state fileID: Int(0 - 1)
    state nameStart: Int(0 - 1)
    state nameEnd: Int(0 - 1)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) && fileID < 0 {
        if compilerIntTableValue(table: tables.members, row: memberRow, column: 0) == syntaxID {
            fileID: compilerIntTableValue(table: tables.members, row: memberRow, column: 1)
            nameStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 6)
            nameEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 7)
        }
        memberRow: memberRow + 1
    }
    if fileID < 0 || nameStart < 0 || nameEnd <= nameStart { return 0 - 1 }
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStart, localEnd: nameEnd))
    let nameValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeString(), typeID: 0 - 1, scalar: compilerDeclarationNameHash(name: name)))
    let identityValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeString(), typeID: 0 - 1, scalar: syntaxID))
    let parentValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let sourceValueID: Int(compilerMacroValueStoreAppend(
        store: store,
        kind: compilerMacroValueKindSyntax(),
        typeKind: compilerBodyTypeMacroTarget(),
        typeID: 0 - 1,
        scalar: syntaxID,
        firstChild: store.children.count,
        childCount: 0
    ))
    let children: Buffer<Int>(bufferCreateInt(capacity: 4))
    state valid: Bool(nameValueID >= 0 && identityValueID >= 0 && parentValueID >= 0 && sourceValueID >= 0)
    if valid && children.append(element: nameValueID) != 0 { valid: false }
    if valid && children.append(element: identityValueID) != 0 { valid: false }
    if valid && children.append(element: parentValueID) != 0 { valid: false }
    if valid && children.append(element: sourceValueID) != 0 { valid: false }
    state identifierValueID: Int(0 - 1)
    if valid {
        identifierValueID: compilerMacroValueStoreAppendAggregate(
            store: store,
            kind: compilerMacroValueKindConstruct(),
            typeKind: compilerBodyTypeConstruct(),
            typeID: typeID,
            scalar: syntaxID,
            children: children
        )
    }
    children.destroy()
    return identifierValueID
}

function compilerMacroExecutionMaterializeSyntaxValue(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    sourceSyntaxID: Int,
    fileID: Int,
    valueStart: Int,
    valueEnd: Int
): Int {
    if fileID < 0 || valueStart < 0 || valueEnd <= valueStart { return 0 - 1 }
    let fileValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeInt(), typeID: 0 - 1, scalar: fileID))
    let startValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeInt(), typeID: 0 - 1, scalar: valueStart))
    let endValueID: Int(compilerMacroValueStoreAppendScalar(store: store, typeKind: compilerBodyTypeInt(), typeID: 0 - 1, scalar: valueEnd))
    let children: Buffer<Int>(bufferCreateInt(capacity: 3))
    state valid: Bool(fileValueID >= 0 && startValueID >= 0 && endValueID >= 0)
    if valid && children.append(element: fileValueID) != 0 { valid: false }
    if valid && children.append(element: startValueID) != 0 { valid: false }
    if valid && children.append(element: endValueID) != 0 { valid: false }
    state syntaxValueID: Int(0 - 1)
    if valid {
        syntaxValueID: compilerMacroValueStoreAppendAggregate(
            store: store,
            kind: compilerMacroValueKindSyntax(),
            typeKind: compilerBodyTypeMacroTarget(),
            typeID: 0 - 1,
            scalar: sourceSyntaxID,
            children: children
        )
    }
    children.destroy()
    return syntaxValueID
}

function compilerMacroExecutionQuerySyntaxCapture(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    sourceSyntaxID: Int,
    captureMemberRow: Int,
    resultTypeKind: Int,
    resultTypeID: Int
): Int {
    if captureMemberRow < 0 || captureMemberRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
    let templateSyntaxID: Int(compilerIntTableValue(table: tables.members, row: captureMemberRow, column: 2))
    if templateSyntaxID < 0 { return 0 - 1 }
    let captureFileID: Int(compilerIntTableValue(table: tables.members, row: captureMemberRow, column: 1))
    let captureName: String(compilerTypedSyntaxLocalText(
        tables: tables,
        fileID: captureFileID,
        localStart: compilerIntTableValue(table: tables.members, row: captureMemberRow, column: 6),
        localEnd: compilerIntTableValue(table: tables.members, row: captureMemberRow, column: 7)
    ))
    if captureName == String("identifier") {
        return compilerMacroExecutionMaterializeSyntaxIdentifier(
            tables: tables,
            store: store,
            syntaxID: sourceSyntaxID,
            typeID: resultTypeID
        )
    }
    if captureName == String("value") {
        let sourceMemberRow: Int(compilerMacroExecutionMemberRowForSyntaxID(tables: tables, syntaxID: sourceSyntaxID))
        if sourceMemberRow < 0 { return 0 - 1 }
        let sourceMemberKind: Int(compilerIntTableValue(table: tables.members, row: sourceMemberRow, column: 12))
        if sourceMemberKind != compilerSyntaxMemberKindLet() && sourceMemberKind != compilerSyntaxMemberKindState() { return 0 - 1 }
        let valueStart: Int(compilerIntTableValue(table: tables.members, row: sourceMemberRow, column: compilerSyntaxMemberValueStartColumn()))
        let valueEnd: Int(compilerIntTableValue(table: tables.members, row: sourceMemberRow, column: compilerSyntaxMemberValueEndColumn()))
        let optionalChildren: Buffer<Int>(bufferCreateInt(capacity: 1))
        state optionalScalar: Int(0)
        state valid: Bool(valueStart == 0 - 1 && valueEnd == 0 - 1)
        if valueStart >= 0 && valueEnd > valueStart {
            let syntaxValueID: Int(compilerMacroExecutionMaterializeSyntaxValue(
                tables: tables,
                store: store,
                sourceSyntaxID: sourceSyntaxID,
                fileID: compilerIntTableValue(table: tables.members, row: sourceMemberRow, column: 1),
                valueStart: valueStart,
                valueEnd: valueEnd
            ))
            if syntaxValueID >= 0 && optionalChildren.append(element: syntaxValueID) == 0 {
                optionalScalar: 1
                valid: true
            }
        }
        state optionalValueID: Int(0 - 1)
        if valid {
            optionalValueID: compilerMacroValueStoreAppendAggregate(
                store: store,
                kind: compilerMacroValueKindEnum(),
                typeKind: resultTypeKind,
                typeID: resultTypeID,
                scalar: optionalScalar,
                children: optionalChildren
            )
        }
        optionalChildren.destroy()
        return optionalValueID
    }
    return 0 - 1
}

function compilerMacroExecutionMaterializeApplication(
    tables: CompilerSyntaxTables,
    store: CompilerMacroValueStore,
    applicationRow: Int
): Int {
    let identifierValueID: Int(compilerMacroExecutionMaterializeIdentifier(tables: tables, store: store, applicationRow: applicationRow))
    let targetValueID: Int(compilerMacroExecutionMaterializeIdentifier(tables: tables, store: store, applicationRow: applicationRow))
    let emptyChildren: Buffer<Int>(bufferCreateInt(capacity: 0))
    let genericArgumentsValueID: Int(compilerMacroValueStoreAppendAggregate(store: store, kind: compilerMacroValueKindArray(), typeKind: compilerBodyTypeConstruct(), typeID: 0 - 1, scalar: applicationRow, children: emptyChildren))
    let argumentClauseValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let argumentsValueID: Int(compilerMacroValueStoreAppendAggregate(store: store, kind: compilerMacroValueKindArray(), typeKind: compilerBodyTypeConstruct(), typeID: 0 - 1, scalar: applicationRow, children: emptyChildren))
    let rawBodyValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let declarationValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let visibilityValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let valueTypeValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    let rootResultRow: Int(compilerMacroExecutionRootResultRow(tables: tables, applicationRow: applicationRow))
    state resultValueID: Int(compilerMacroExecutionAppendPlaceholderValue(store: store))
    if rootResultRow >= 0 {
        resultValueID: compilerMacroExecutionMaterializePersistedResult(tables: tables, store: store, resultRow: rootResultRow)
    }
    emptyChildren.destroy()
    let children: Buffer<Int>(bufferCreateInt(capacity: 10))
    state valid: Bool(identifierValueID >= 0 && targetValueID >= 0 && genericArgumentsValueID >= 0
        && argumentClauseValueID >= 0 && argumentsValueID >= 0 && rawBodyValueID >= 0
        && declarationValueID >= 0 && visibilityValueID >= 0 && valueTypeValueID >= 0 && resultValueID >= 0)
    if valid && children.append(element: identifierValueID) != 0 { valid: false }
    if valid && children.append(element: targetValueID) != 0 { valid: false }
    if valid && children.append(element: genericArgumentsValueID) != 0 { valid: false }
    if valid && children.append(element: argumentClauseValueID) != 0 { valid: false }
    if valid && children.append(element: argumentsValueID) != 0 { valid: false }
    if valid && children.append(element: rawBodyValueID) != 0 { valid: false }
    if valid && children.append(element: declarationValueID) != 0 { valid: false }
    if valid && children.append(element: visibilityValueID) != 0 { valid: false }
    if valid && children.append(element: valueTypeValueID) != 0 { valid: false }
    if valid && children.append(element: resultValueID) != 0 { valid: false }
    state applicationValueID: Int(0 - 1)
    if valid {
        applicationValueID: compilerMacroValueStoreAppendAggregate(
            store: store,
            kind: compilerMacroValueKindConstruct(),
            typeKind: compilerBodyTypeConstruct(),
            typeID: 0 - 1,
            scalar: applicationRow,
            children: children
        )
    }
    children.destroy()
    return applicationValueID
}

function compilerMacroExecutionLiteralForValue(arena: CompilerBodyArena, valueID: Int): String {
    if valueID < 0 || valueID >= compilerIntTableRowCount(table: arena.mirValues) { return String("") }
    let sourceNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueSourceColumn()))
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 1) != compilerSyntaxKindStringLiteral() { return String("") }
    return compilerCoreStringLiteralContent(text: compilerBodyArenaNodeText(arena: arena, nodeID: sourceNodeID))
}

function compilerMacroExecutionApplicationIdentity(tables: CompilerSyntaxTables, applicationRow: Int): CompilerFingerprint {
    let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let pathStart: Int(compilerSourceStoreFilePathStart(store: tables.sourceStore, fileID: fileID))
    let pathEnd: Int(compilerSourceStoreFilePathEnd(store: tables.sourceStore, fileID: fileID))
    let applicationText: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 2), localEnd: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 3)))
    state occurrence: Int(0)
    state priorRow: Int(0)
    while priorRow < applicationRow {
        let priorFileID: Int(compilerIntTableValue(table: tables.macroApplications, row: priorRow, column: 1))
        if priorFileID == fileID {
            let priorText: String(compilerTypedSyntaxLocalText(tables: tables, fileID: priorFileID, localStart: compilerIntTableValue(table: tables.macroApplications, row: priorRow, column: 2), localEnd: compilerIntTableValue(table: tables.macroApplications, row: priorRow, column: 3)))
            if priorText == applicationText { occurrence: occurrence + 1 }
        }
        priorRow: priorRow + 1
    }
    state identity: CompilerFingerprint(compilerFingerprintInitial())
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: 716)
    identity: compilerFingerprintAppendRange(fingerprint: identity, tag: 717, source: tables.sourceStore.source, start: pathStart, end: pathEnd)
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: compilerSourceStoreFileRole(store: tables.sourceStore, fileID: fileID))
    identity: compilerFingerprintAppendText(fingerprint: identity, tag: 718, text: applicationText)
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: occurrence)
    return compilerFingerprintAppendInt(fingerprint: identity, value: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 13))
}

function compilerMacroExecutionTargetIdentity(tables: CompilerSyntaxTables, targetSyntaxID: Int): CompilerFingerprint {
    state identity: CompilerFingerprint(compilerFingerprintInitial())
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: 720)
    if targetSyntaxID < 0 || targetSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return identity }
    let targetKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: targetSyntaxID, column: 0))
    identity: compilerFingerprintAppendInt(fingerprint: identity, value: targetKind)
    if targetKind == compilerSyntaxKindConstruct() || targetKind == compilerSyntaxKindFunction() || targetKind == compilerSyntaxKindEnum() {
        let targetDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: targetSyntaxID))
        if targetDeclarationRow >= 0 {
            let targetFileID: Int(compilerIntTableValue(table: tables.declarations, row: targetDeclarationRow, column: 1))
            let targetPathStart: Int(compilerSourceStoreFilePathStart(store: tables.sourceStore, fileID: targetFileID))
            let targetPathEnd: Int(compilerSourceStoreFilePathEnd(store: tables.sourceStore, fileID: targetFileID))
            let targetText: String(compilerTypedSyntaxLocalText(tables: tables, fileID: targetFileID, localStart: compilerIntTableValue(table: tables.declarations, row: targetDeclarationRow, column: 5), localEnd: compilerIntTableValue(table: tables.declarations, row: targetDeclarationRow, column: 6)))
            state targetOccurrence: Int(0)
            state priorDeclarationRow: Int(0)
            while priorDeclarationRow < targetDeclarationRow {
                let priorFileID: Int(compilerIntTableValue(table: tables.declarations, row: priorDeclarationRow, column: 1))
                if priorFileID == targetFileID && compilerIntTableValue(table: tables.declarations, row: priorDeclarationRow, column: 2) == targetKind {
                    let priorText: String(compilerTypedSyntaxLocalText(tables: tables, fileID: priorFileID, localStart: compilerIntTableValue(table: tables.declarations, row: priorDeclarationRow, column: 5), localEnd: compilerIntTableValue(table: tables.declarations, row: priorDeclarationRow, column: 6)))
                    if priorText == targetText { targetOccurrence: targetOccurrence + 1 }
                }
                priorDeclarationRow: priorDeclarationRow + 1
            }
            identity: compilerFingerprintAppendRange(fingerprint: identity, tag: 721, source: tables.sourceStore.source, start: targetPathStart, end: targetPathEnd)
            identity: compilerFingerprintAppendInt(fingerprint: identity, value: compilerSourceStoreFileRole(store: tables.sourceStore, fileID: targetFileID))
            identity: compilerFingerprintAppendText(fingerprint: identity, tag: 722, text: targetText)
            identity: compilerFingerprintAppendInt(fingerprint: identity, value: targetOccurrence)
        }
    }
    return identity
}

function compilerMacroExecutionReadIdentity(applicationIdentity: CompilerFingerprint, targetIdentity: CompilerFingerprint, operation: Int, keyKindTag: Int, key: String): CompilerFingerprint {
    state identity: CompilerFingerprint(compilerFingerprintInitial())
