function compilerSyntaxTablesCreate(source: String): CompilerSyntaxTables {
    return CompilerSyntaxTables(
        sourceStore: compilerSourceStoreCreate(source: source),
        syntaxIndex: compilerIntTableCreate(columnCount: compilerSyntaxIndexColumnCount(), estimatedRowCount: 128),
        declarations: compilerIntTableCreate(columnCount: compilerSyntaxDeclarationColumnCount(), estimatedRowCount: 128),
        members: compilerIntTableCreate(columnCount: compilerSyntaxMemberColumnCount(), estimatedRowCount: 64),
        functions: compilerIntTableCreate(columnCount: compilerSyntaxFunctionColumnCount(), estimatedRowCount: 128),
        functionOwners: bufferCreateInt(capacity: 128),
        parameters: compilerIntTableCreate(columnCount: compilerSyntaxParameterColumnCount(), estimatedRowCount: 128),
        genericParameters: compilerIntTableCreate(columnCount: compilerSyntaxGenericParameterColumnCount(), estimatedRowCount: 64),
        typeReferences: compilerIntTableCreate(columnCount: compilerSyntaxTypeReferenceColumnCount(), estimatedRowCount: 128),
        macroDeclarations: compilerIntTableCreate(columnCount: compilerSyntaxMacroDeclarationColumnCount(), estimatedRowCount: 32),
        macroParameters: compilerIntTableCreate(columnCount: compilerSyntaxMacroParameterColumnCount(), estimatedRowCount: 64),
        macroApplications: compilerIntTableCreate(columnCount: compilerSyntaxMacroApplicationColumnCount(), estimatedRowCount: 128),
        macroEdges: compilerIntTableCreate(columnCount: compilerSyntaxMacroEdgeColumnCount(), estimatedRowCount: 256),
        macroDiagnostics: compilerIntTableCreate(columnCount: compilerSyntaxMacroDiagnosticColumnCount(), estimatedRowCount: 16),
        macroCapabilities: compilerIntTableCreate(columnCount: compilerSyntaxMacroCapabilityColumnCount(), estimatedRowCount: 96),
        macroInvocations: compilerIntTableCreate(columnCount: compilerSyntaxMacroInvocationColumnCount(), estimatedRowCount: 128),
        macroCapabilityHandles: compilerIntTableCreate(columnCount: compilerSyntaxMacroCapabilityHandleColumnCount(), estimatedRowCount: 384),
        macroExecutionEvents: compilerIntTableCreate(columnCount: compilerSyntaxMacroExecutionEventColumnCount(), estimatedRowCount: 128),
        macroReadDependencies: compilerIntTableCreate(columnCount: compilerSyntaxMacroReadDependencyColumnCount(), estimatedRowCount: 128),
        macroResults: compilerIntTableCreate(columnCount: compilerSyntaxMacroResultColumnCount(), estimatedRowCount: 128),
        compilerFormulaFacts: compilerIntTableCreate(columnCount: compilerFormulaFactColumnCount(), estimatedRowCount: 32),
        macroExpansionTemplates: compilerIntTableCreate(columnCount: compilerSyntaxMacroExpansionTemplateColumnCount(), estimatedRowCount: 32),
        macroExpansionFragments: compilerIntTableCreate(columnCount: compilerSyntaxMacroExpansionFragmentColumnCount(), estimatedRowCount: 128),
        macroExpansionBindings: compilerIntTableCreate(columnCount: compilerSyntaxMacroExpansionBindingColumnCount(), estimatedRowCount: 128),
        macroChildApplications: compilerIntTableCreate(columnCount: compilerSyntaxMacroChildApplicationColumnCount(), estimatedRowCount: 32),
        macroExpansionArtifacts: compilerIntTableCreate(columnCount: compilerSyntaxMacroExpansionArtifactColumnCount(), estimatedRowCount: 32),
        pendingGeneratedFunctions: compilerIntTableCreate(columnCount: compilerGraphGeneratedFunctionColumnCount(), estimatedRowCount: 32),
        pendingGeneratedMembers: compilerIntTableCreate(columnCount: compilerGraphGeneratedMemberColumnCount(), estimatedRowCount: 32),
        bodyNodes: compilerIntTableCreate(columnCount: compilerSyntaxBodyNodeColumnCount(), estimatedRowCount: 256),
        bodyEdges: compilerIntTableCreate(columnCount: compilerSyntaxBodyEdgeColumnCount(), estimatedRowCount: 256),
        failures: bufferCreateInt(capacity: compilerSyntaxFailureColumnCount())
    )
}

function compilerSyntaxTablesDestroy(tables: CompilerSyntaxTables): Int {
    state status: Int(0)
    if compilerIntTableDestroy(table: tables.syntaxIndex) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.declarations) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.members) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.functions) != 0 {
        status: 0 - 1
    }
    if tables.functionOwners.destroy() != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.parameters) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.genericParameters) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.typeReferences) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroDeclarations) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroParameters) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroApplications) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroEdges) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroDiagnostics) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroCapabilities) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroInvocations) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroCapabilityHandles) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroExecutionEvents) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroReadDependencies) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroResults) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.compilerFormulaFacts) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroExpansionTemplates) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroExpansionFragments) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroExpansionBindings) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroChildApplications) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.macroExpansionArtifacts) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.pendingGeneratedFunctions) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.pendingGeneratedMembers) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.bodyNodes) != 0 {
        status: 0 - 1
    }
    if compilerIntTableDestroy(table: tables.bodyEdges) != 0 {
        status: 0 - 1
    }
    if tables.failures.destroy() != 0 {
        status: 0 - 1
    }
    if compilerSourceStoreDestroy(store: tables.sourceStore) != 0 {
        status: 0 - 1
    }
    return status
}

function compilerSyntaxTablesFailureAppend(tables: CompilerSyntaxTables, phase: Int, reason: Int, fileID: Int, start: Int, end: Int, relatedRow: Int): Int {
    if tables.failures.count != 0 { return 0 }
    if tables.failures.append(element: phase) != 0 { return 0 - 1 }
    if tables.failures.append(element: reason) != 0 { return 0 - 1 }
    if tables.failures.append(element: fileID) != 0 { return 0 - 1 }
    if tables.failures.append(element: start) != 0 { return 0 - 1 }
    if tables.failures.append(element: end) != 0 { return 0 - 1 }
    return tables.failures.append(element: relatedRow)
}

function compilerSyntaxTablesFailureAnnotate(tables: CompilerSyntaxTables, phase: Int, reason: Int, fileID: Int, start: Int, end: Int, relatedRow: Int): Int {
    if tables.failures.count == 0 {
        return compilerSyntaxTablesFailureAppend(tables: tables, phase: phase, reason: reason, fileID: fileID, start: start, end: end, relatedRow: relatedRow)
    }
    if tables.failures.count != compilerSyntaxFailureColumnCount() { return 0 - 1 }
    if tables.failures.element(index: compilerSyntaxFailurePhaseColumn()) == compilerSyntaxFailureUnknown()
        && tables.failures.update(element: phase, index: compilerSyntaxFailurePhaseColumn()) != 0 { return 0 - 1 }
    if tables.failures.element(index: compilerSyntaxFailureReasonColumn()) == compilerSyntaxFailureUnknown()
        && tables.failures.update(element: reason, index: compilerSyntaxFailureReasonColumn()) != 0 { return 0 - 1 }
    if tables.failures.element(index: compilerSyntaxFailureFileColumn()) < 0
        && tables.failures.update(element: fileID, index: compilerSyntaxFailureFileColumn()) != 0 { return 0 - 1 }
    if tables.failures.element(index: compilerSyntaxFailureStartColumn()) < 0
        && tables.failures.update(element: start, index: compilerSyntaxFailureStartColumn()) != 0 { return 0 - 1 }
    if tables.failures.element(index: compilerSyntaxFailureEndColumn()) < 0
        && tables.failures.update(element: end, index: compilerSyntaxFailureEndColumn()) != 0 { return 0 - 1 }
    if tables.failures.element(index: compilerSyntaxFailureRelatedColumn()) < 0
        && tables.failures.update(element: relatedRow, index: compilerSyntaxFailureRelatedColumn()) != 0 { return 0 - 1 }
    return 0
}

function compilerSyntaxTablesFailureAnnotateGlobal(tables: CompilerSyntaxTables, phase: Int, reason: Int, fileID: Int, start: Int, end: Int, relatedRow: Int): Int {
    state localStart: Int(0 - 1)
    state localEnd: Int(0 - 1)
    if fileID >= 0 && fileID < compilerSourceStoreFileCount(store: tables.sourceStore) {
        localStart: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: start)
        localEnd: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: end)
    }
    return compilerSyntaxTablesFailureAnnotate(tables: tables, phase: phase, reason: reason, fileID: fileID, start: localStart, end: localEnd, relatedRow: relatedRow)
}

function compilerSyntaxTablesPoison(tables: CompilerSyntaxTables): Int {
    return compilerSyntaxTablesFailureAppend(tables: tables, phase: compilerSyntaxFailureUnknown(), reason: compilerSyntaxFailureReasonUnknown(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 0 - 1)
}

function compilerSyntaxTablesIsValid(tables: CompilerSyntaxTables): Bool {
    if !tables.sourceStore.isValid || tables.failures.count != 0 {
        return false
    }
    state tablesAreComplete: Bool(false)
    tablesAreComplete: compilerIntTableIsComplete(table: tables.syntaxIndex)
        && compilerIntTableIsComplete(table: tables.declarations)
        && compilerIntTableIsComplete(table: tables.members)
        && compilerIntTableIsComplete(table: tables.functions)
        && tables.functionOwners.count == compilerIntTableRowCount(table: tables.functions)
        && compilerIntTableIsComplete(table: tables.parameters)
        && compilerIntTableIsComplete(table: tables.genericParameters)
        && compilerIntTableIsComplete(table: tables.typeReferences)
        && compilerIntTableIsComplete(table: tables.macroDeclarations)
        && compilerIntTableIsComplete(table: tables.macroParameters)
        && compilerIntTableIsComplete(table: tables.macroApplications)
        && compilerIntTableIsComplete(table: tables.macroEdges)
        && compilerIntTableIsComplete(table: tables.macroDiagnostics)
        && compilerIntTableIsComplete(table: tables.macroCapabilities)
        && compilerIntTableIsComplete(table: tables.macroInvocations)
        && compilerIntTableIsComplete(table: tables.macroCapabilityHandles)
        && compilerIntTableIsComplete(table: tables.macroExecutionEvents)
        && compilerIntTableIsComplete(table: tables.macroReadDependencies)
        && compilerIntTableIsComplete(table: tables.macroResults)
        && compilerIntTableIsComplete(table: tables.compilerFormulaFacts)
        && compilerIntTableIsComplete(table: tables.macroExpansionTemplates)
        && compilerIntTableIsComplete(table: tables.macroExpansionFragments)
        && compilerIntTableIsComplete(table: tables.macroExpansionBindings)
        && compilerIntTableIsComplete(table: tables.macroChildApplications)
        && compilerIntTableIsComplete(table: tables.macroExpansionArtifacts)
        && compilerIntTableIsComplete(table: tables.pendingGeneratedFunctions)
        && compilerIntTableIsComplete(table: tables.pendingGeneratedMembers)
        && compilerIntTableIsComplete(table: tables.bodyNodes)
        && compilerIntTableIsComplete(table: tables.bodyEdges)
    if !tablesAreComplete {
        return false
    }
    return compilerSyntaxTablesAreStructurallyValid(tables: tables)
}

function compilerSyntaxFailurePhaseName(phase: Int): String {
    if phase == compilerSyntaxFailurePhaseSourceStore() { return String("sourceStore") }
    if phase == compilerSyntaxFailurePhaseTopLevelCapture() { return String("topLevelCapture") }
    if phase == compilerSyntaxFailurePhaseEnumPayloadLink() { return String("enumPayloadLink") }
    if phase == compilerSyntaxFailurePhaseStructuralValidation() { return String("structuralValidation") }
    if phase == compilerSyntaxFailurePhaseMacroCapture() { return String("macroCapture") }
    return String("unknown")
}

function compilerSyntaxFailureReasonName(reason: Int): String {
    if reason == compilerSyntaxFailureReasonInvalidSourceStore() { return String("invalidSourceStore") }
    if reason == compilerSyntaxFailureReasonInvalidTopLevelDeclaration() { return String("invalidTopLevelDeclaration") }
    if reason == compilerSyntaxFailureReasonInvalidBuiltinAttribute() { return String("invalidBuiltinAttribute") }
    if reason == compilerSyntaxFailureReasonInvalidEnumPayloadType() { return String("invalidEnumPayloadType") }
    if reason == compilerSyntaxFailureReasonIncompleteTable() { return String("incompleteTable") }
    if reason == compilerSyntaxFailureReasonInvalidTableStructure() { return String("invalidTableStructure") }
    if reason == compilerSyntaxFailureReasonInvalidMacroApplication() { return String("invalidMacroApplication") }
    if reason == compilerSyntaxFailureReasonInvalidMacroTemplateShape() { return String("invalidMacroTemplateShape") }
    if reason == compilerSyntaxFailureReasonInvalidMacroTemplatePlacement() { return String("invalidMacroTemplatePlacement") }
    if reason == compilerSyntaxFailureReasonInvalidMacroTemplateTarget() { return String("invalidMacroTemplateTarget") }
    if reason == compilerSyntaxFailureReasonInvalidMacroTemplateParent() { return String("invalidMacroTemplateParent") }
    return String("unknown")
}

function compilerSyntaxTablesEnsureFailure(tables: CompilerSyntaxTables): Int {
    if tables.failures.count != 0 { return 0 }
    if !tables.sourceStore.isValid {
        return compilerSyntaxTablesFailureAppend(tables: tables, phase: compilerSyntaxFailurePhaseSourceStore(), reason: compilerSyntaxFailureReasonInvalidSourceStore(), fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 0 - 1)
    }
    let tablesAreComplete: Bool(compilerIntTableIsComplete(table: tables.syntaxIndex)
        && compilerIntTableIsComplete(table: tables.declarations)
        && compilerIntTableIsComplete(table: tables.members)
        && compilerIntTableIsComplete(table: tables.functions)
        && tables.functionOwners.count == compilerIntTableRowCount(table: tables.functions)
        && compilerIntTableIsComplete(table: tables.parameters)
        && compilerIntTableIsComplete(table: tables.genericParameters)
        && compilerIntTableIsComplete(table: tables.typeReferences)
        && compilerIntTableIsComplete(table: tables.macroDeclarations)
        && compilerIntTableIsComplete(table: tables.macroParameters)
        && compilerIntTableIsComplete(table: tables.macroApplications)
        && compilerIntTableIsComplete(table: tables.macroEdges)
        && compilerIntTableIsComplete(table: tables.macroDiagnostics)
        && compilerIntTableIsComplete(table: tables.macroCapabilities)
        && compilerIntTableIsComplete(table: tables.macroInvocations)
        && compilerIntTableIsComplete(table: tables.macroCapabilityHandles)
        && compilerIntTableIsComplete(table: tables.macroExecutionEvents)
        && compilerIntTableIsComplete(table: tables.macroReadDependencies)
        && compilerIntTableIsComplete(table: tables.macroResults)
        && compilerIntTableIsComplete(table: tables.compilerFormulaFacts)
        && compilerIntTableIsComplete(table: tables.macroExpansionTemplates)
        && compilerIntTableIsComplete(table: tables.macroExpansionFragments)
        && compilerIntTableIsComplete(table: tables.macroExpansionBindings)
        && compilerIntTableIsComplete(table: tables.macroChildApplications)
        && compilerIntTableIsComplete(table: tables.macroExpansionArtifacts)
        && compilerIntTableIsComplete(table: tables.pendingGeneratedFunctions)
        && compilerIntTableIsComplete(table: tables.pendingGeneratedMembers)
        && compilerIntTableIsComplete(table: tables.bodyNodes)
        && compilerIntTableIsComplete(table: tables.bodyEdges))
    state reason: Int(compilerSyntaxFailureReasonInvalidTableStructure())
    if !tablesAreComplete { reason: compilerSyntaxFailureReasonIncompleteTable() }
    return compilerSyntaxTablesFailureAppend(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: reason, fileID: 0 - 1, start: 0 - 1, end: 0 - 1, relatedRow: 0 - 1)
}

function compilerInvalidTypedDeclarationsDiagnostic(tables: CompilerSyntaxTables): String {
    compilerSyntaxTablesEnsureFailure(tables: tables)
    state phase: Int(compilerSyntaxFailureUnknown())
    state reason: Int(compilerSyntaxFailureReasonUnknown())
    state fileID: Int(0 - 1)
    state start: Int(0 - 1)
    state end: Int(0 - 1)
    state relatedRow: Int(0 - 1)
    if tables.failures.count == compilerSyntaxFailureColumnCount() {
        phase: tables.failures.element(index: compilerSyntaxFailurePhaseColumn())
        reason: tables.failures.element(index: compilerSyntaxFailureReasonColumn())
        fileID: tables.failures.element(index: compilerSyntaxFailureFileColumn())
        start: tables.failures.element(index: compilerSyntaxFailureStartColumn())
        end: tables.failures.element(index: compilerSyntaxFailureEndColumn())
        relatedRow: tables.failures.element(index: compilerSyntaxFailureRelatedColumn())
    }
    state roleName: String("unknown")
    state path: String("unknown")
    if fileID >= 0 && fileID < compilerSourceStoreFileCount(store: tables.sourceStore) {
        roleName: compilerSourceRoleName(role: compilerSourceStoreFileRole(store: tables.sourceStore, fileID: fileID))
        path: stringSubstring(source: tables.sourceStore.source, start: compilerSourceStoreFilePathStart(store: tables.sourceStore, fileID: fileID), end: compilerSourceStoreFilePathEnd(store: tables.sourceStore, fileID: fileID))
    }
    return "compilerError\tkind=invalidTypedDeclarations\tphase=\(compilerSyntaxFailurePhaseName(phase: phase))\treason=\(compilerSyntaxFailureReasonName(reason: reason))\trole=\(roleName)\tpath=\(path)\tstart=\(start)\tend=\(end)\trelated=\(relatedRow)\n"
}

function compilerDeclarationNameHash(name: String): Int {
    state hash: Int(17)
    state index: Int(0)
    let length: Int(stringLength(value: name))
    while index < length {
        hash: (hash * 127 + stringByteAt(source: name, index: index) + 1) % 16000057
        index: index + 1
    }
    return hash
}

function compilerDeclarationMemberHash(parentSyntaxID: Int, name: String): Int {
    return (compilerDeclarationNameHash(name: name) * 127 + parentSyntaxID + 1) % 16000057
}

function compilerDeclarationIndexOmissionBufferContains(omittedSyntaxIDs: Buffer<Int>, syntaxID: Int): Bool {
    state row: Int(0)
    while row < omittedSyntaxIDs.count {
        if omittedSyntaxIDs.element(index: row) == syntaxID { return true }
        row: row + 1
    }
    return false
}

function compilerSyntaxDeclarationIsTopLevel(tables: CompilerSyntaxTables, declarationRow: Int): Bool {
    if declarationRow < 0 || declarationRow >= compilerIntTableRowCount(table: tables.declarations) { return false }
    if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 3) != 0 - 1 { return false }
    if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindFunction() {
        let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
        if syntaxID < 0 || syntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
            || compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) != compilerSyntaxKindFunction() { return false }
        let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
        if functionRow < 0 || functionRow >= tables.functionOwners.count { return false }
        if tables.functionOwners.element(index: functionRow) >= 0 { return false }
    }
    return true
}

function compilerDeclarationIndexCreateWithOmittedSyntaxIDs(tables: CompilerSyntaxTables, omittedSyntaxIDs: Buffer<Int>, initialIsValid: Bool): CompilerDeclarationIndex {
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    let bucketCount: Int(declarationCount * 2 + 1)
    let bucketHeads: Buffer<Int>(bufferCreateInt(capacity: bucketCount))
    let nextRows: Buffer<Int>(bufferCreateInt(capacity: declarationCount))
    let nameHashes: Buffer<Int>(bufferCreateInt(capacity: declarationCount))
    let memberCount: Int(compilerIntTableRowCount(table: tables.members))
    let memberBucketCount: Int(memberCount * 2 + 1)
    let memberBucketHeads: Buffer<Int>(bufferCreateInt(capacity: memberBucketCount))
    let memberNextRows: Buffer<Int>(bufferCreateInt(capacity: memberCount))
    let memberHashes: Buffer<Int>(bufferCreateInt(capacity: memberCount))
    let indexOmittedSyntaxIDs: Buffer<Int>(bufferCreateInt(capacity: omittedSyntaxIDs.count))
    state valid: Bool(initialIsValid)
    state omissionRow: Int(0)
    while omissionRow < omittedSyntaxIDs.count {
        let omittedSyntaxID: Int(omittedSyntaxIDs.element(index: omissionRow))
        if omittedSyntaxID < 0 || omittedSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
            || compilerDeclarationIndexOmissionBufferContains(omittedSyntaxIDs: indexOmittedSyntaxIDs, syntaxID: omittedSyntaxID)
            || indexOmittedSyntaxIDs.append(element: omittedSyntaxID) != 0 { valid: false }
        omissionRow: omissionRow + 1
    }
    state bucket: Int(0)
    while bucket < bucketCount {
        if bucketHeads.append(element: 0 - 1) != 0 { valid: false }
        bucket: bucket + 1
    }
    state row: Int(0)
    while row < declarationCount {
        let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 0))
        if compilerDeclarationIndexOmissionBufferContains(omittedSyntaxIDs: indexOmittedSyntaxIDs, syntaxID: syntaxID)
            || !compilerSyntaxDeclarationIsTopLevel(tables: tables, declarationRow: row) {
            if nextRows.append(element: 0 - 1) != 0 || nameHashes.append(element: 0) != 0 { valid: false }
        } else {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
            let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)))
            let hash: Int(compilerDeclarationNameHash(name: name))
            let nameBucket: Int(hash % bucketCount)
            let priorHead: Int(bucketHeads.element(index: nameBucket))
            if nextRows.append(element: priorHead) != 0 { valid: false }
            if nameHashes.append(element: hash) != 0 { valid: false }
            if bucketHeads.update(element: row, index: nameBucket) != 0 { valid: false }
        }
        row: row + 1
    }
    bucket: 0
    while bucket < memberBucketCount {
        if memberBucketHeads.append(element: 0 - 1) != 0 { valid: false }
        bucket: bucket + 1
    }
    row: 0
    while row < memberCount {
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 2))
        let memberSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 0))
        if compilerDeclarationIndexOmissionBufferContains(omittedSyntaxIDs: indexOmittedSyntaxIDs, syntaxID: parentSyntaxID)
            || compilerDeclarationIndexOmissionBufferContains(omittedSyntaxIDs: indexOmittedSyntaxIDs, syntaxID: memberSyntaxID) {
            if memberNextRows.append(element: 0 - 1) != 0 || memberHashes.append(element: 0) != 0 { valid: false }
        } else {
            let memberFileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
            let memberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: compilerIntTableValue(table: tables.members, row: row, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: row, column: 7)))
            let memberHash: Int(compilerDeclarationMemberHash(parentSyntaxID: parentSyntaxID, name: memberName))
            let memberBucket: Int(memberHash % memberBucketCount)
            let memberPriorHead: Int(memberBucketHeads.element(index: memberBucket))
            if memberNextRows.append(element: memberPriorHead) != 0 { valid: false }
            if memberHashes.append(element: memberHash) != 0 { valid: false }
            if memberBucketHeads.update(element: row, index: memberBucket) != 0 { valid: false }
        }
        row: row + 1
    }
    if omittedSyntaxIDs.destroy() != 0 { valid: false }
    return CompilerDeclarationIndex(bucketHeads: bucketHeads, nextRows: nextRows, nameHashes: nameHashes, bucketCount: bucketCount, memberBucketHeads: memberBucketHeads, memberNextRows: memberNextRows, memberHashes: memberHashes, memberBucketCount: memberBucketCount, omittedSyntaxIDs: indexOmittedSyntaxIDs, isValid: valid)
}

function compilerDeclarationIndexCreate(tables: CompilerSyntaxTables): CompilerDeclarationIndex {
    let omittedSyntaxIDs: Buffer<Int>(bufferCreateInt(capacity: 0))
    return compilerDeclarationIndexCreateWithOmittedSyntaxIDs(tables: tables, omittedSyntaxIDs: omittedSyntaxIDs, initialIsValid: true)
}

function compilerDeclarationIndexCreateWithGraphDelta(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): CompilerDeclarationIndex {
    let omittedSyntaxIDs: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: delta.facts)))
    state valid: Bool(compilerMacroGraphDeltaIsValid(tables: tables, delta: delta))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.facts) && valid {
        if compilerIntTableValue(table: delta.facts, row: row, column: 0) != compilerGraphFactOmitted() {
            valid: false
        } else {
            let subjectNodeID: Int(compilerIntTableValue(table: delta.facts, row: row, column: 1))
            if subjectNodeID < 0 || subjectNodeID >= compilerIntTableRowCount(table: delta.nodes)
                || omittedSyntaxIDs.append(element: compilerIntTableValue(table: delta.nodes, row: subjectNodeID, column: 2)) != 0 { valid: false }
        }
        row: row + 1
    }
    return compilerDeclarationIndexCreateWithOmittedSyntaxIDs(tables: tables, omittedSyntaxIDs: omittedSyntaxIDs, initialIsValid: valid)
}

function compilerDeclarationIndexDestroy(index: CompilerDeclarationIndex): Int {
    state status: Int(0)
    if index.bucketHeads.destroy() != 0 { status: 0 - 1 }
    if index.nextRows.destroy() != 0 { status: 0 - 1 }
    if index.nameHashes.destroy() != 0 { status: 0 - 1 }
    if index.memberBucketHeads.destroy() != 0 { status: 0 - 1 }
    if index.memberNextRows.destroy() != 0 { status: 0 - 1 }
    if index.memberHashes.destroy() != 0 { status: 0 - 1 }
    if index.omittedSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerDeclarationIndexSyntaxIsOmitted(index: CompilerDeclarationIndex, syntaxID: Int): Bool {
    return compilerDeclarationIndexOmissionBufferContains(omittedSyntaxIDs: index.omittedSyntaxIDs, syntaxID: syntaxID)
}

function compilerDeclarationIndexLookup(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, name: String, kindTag: Int): Int {
    if !index.isValid || index.bucketCount <= 0 { return 0 - 1 }
    let hash: Int(compilerDeclarationNameHash(name: name))
    state row: Int(index.bucketHeads.element(index: hash % index.bucketCount))
    while row >= 0 {
        if index.nameHashes.element(index: row) == hash
            && (kindTag == 0 || compilerIntTableValue(table: tables.declarations, row: row, column: 2) == kindTag)
            && compilerSyntaxDeclarationIsTopLevel(tables: tables, declarationRow: row) {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)))
            if candidate == name { return row }
        }
        row: index.nextRows.element(index: row)
    }
    return 0 - 1
}

function compilerDeclarationIndexUniqueLookup(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, name: String, kindTag: Int): Int {
    if !index.isValid || index.bucketCount <= 0 { return 0 - 1 }
    let hash: Int(compilerDeclarationNameHash(name: name))
    state row: Int(index.bucketHeads.element(index: hash % index.bucketCount))
    state match: Int(0 - 1)
    state matchCount: Int(0)
    while row >= 0 {
        if index.nameHashes.element(index: row) == hash
            && (kindTag == 0 || compilerIntTableValue(table: tables.declarations, row: row, column: 2) == kindTag)
            && compilerSyntaxDeclarationIsTopLevel(tables: tables, declarationRow: row) {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)))
            if candidate == name {
                match: row
                matchCount: matchCount + 1
            }
        }
        row: index.nextRows.element(index: row)
    }
    if matchCount != 1 { return 0 - 1 }
    return match
}

function compilerDeclarationIndexLocalRangeSyntaxID(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, fileID: Int, start: Int, end: Int, kindTag: Int): Int {
    if fileID < 0 || start < 0 || end <= start { return 0 - 1 }
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: start, localEnd: end))
    let declarationRow: Int(compilerDeclarationIndexUniqueLookup(tables: tables, index: index, name: name, kindTag: kindTag))
    if declarationRow < 0 { return 0 - 1 }
    return compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0)
}

function compilerDeclarationIndexMemberLookup(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, parentSyntaxID: Int, name: String): Int {
    if !index.isValid || index.memberBucketCount <= 0 { return 0 - 1 }
    let hash: Int(compilerDeclarationMemberHash(parentSyntaxID: parentSyntaxID, name: name))
    state row: Int(index.memberBucketHeads.element(index: hash % index.memberBucketCount))
    while row >= 0 {
        if index.memberHashes.element(index: row) == hash
            && compilerIntTableValue(table: tables.members, row: row, column: 2) == parentSyntaxID {
            let fileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: row, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: row, column: 7)))
            if candidate == name { return row }
        }
        row: index.memberNextRows.element(index: row)
    }
    return 0 - 1
}

function compilerDeclarationIndexMemberFunctionLookup(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, parentSyntaxID: Int, name: String): Int {
    if !index.isValid { return 0 - 1 }
    state functionRow: Int(0)
    while functionRow < compilerIntTableRowCount(table: tables.functions) {
        let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
        if declarationRow >= 0 && functionRow < tables.functionOwners.count && tables.functionOwners.element(index: functionRow) == parentSyntaxID {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
            if candidate == name { return functionRow }
        }
        functionRow: functionRow + 1
    }
    return 0 - 1
}

function compilerDeclarationIndexAnyMemberFunctionLookup(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, name: String): Int {
    if !index.isValid { return 0 - 1 }
    state functionRow: Int(0)
    while functionRow < compilerIntTableRowCount(table: tables.functions) {
        let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
        if declarationRow >= 0 && functionRow < tables.functionOwners.count && tables.functionOwners.element(index: functionRow) >= 0 {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
            if candidate == name { return functionRow }
        }
        functionRow: functionRow + 1
    }
    return 0 - 1
}

function compilerFunctionSelectionCreateEmpty(functionCount: Int, valid: Bool): CompilerFunctionSelection {
    let selectedRows: Buffer<Int>(bufferCreateInt(capacity: functionCount))
    state isValid: Bool(valid)
    state functionRow: Int(0)
    while functionRow < functionCount {
        if selectedRows.append(element: 0) != 0 { isValid: false }
        functionRow: functionRow + 1
    }
    return CompilerFunctionSelection(selectedRows: selectedRows, isValid: isValid)
}

function compilerFunctionSelectionMark(selection: CompilerFunctionSelection, functionRow: Int): Int {
    if !selection.isValid || functionRow < 0 || functionRow >= selection.selectedRows.count { return 0 - 1 }
    if selection.selectedRows.element(index: functionRow) == 1 { return 0 }
    return selection.selectedRows.update(element: 1, index: functionRow)
}

function compilerFunctionSelectionCount(selection: CompilerFunctionSelection): Int {
    state count: Int(0)
    state functionRow: Int(0)
    while functionRow < selection.selectedRows.count {
        if selection.selectedRows.element(index: functionRow) == 1 { count: count + 1 }
        functionRow: functionRow + 1
    }
    return count
}

function compilerFunctionSelectionFirstDifference(left: CompilerFunctionSelection, right: CompilerFunctionSelection): Int {
    if !left.isValid || !right.isValid || left.selectedRows.count != right.selectedRows.count { return 0 }
    state functionRow: Int(0)
    while functionRow < left.selectedRows.count {
        if left.selectedRows.element(index: functionRow) != right.selectedRows.element(index: functionRow) { return functionRow }
        functionRow: functionRow + 1
    }
    return 0 - 1
}

function compilerFunctionEdgesAppend(edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>, ownerFunctionRow: Int, targetFunctionRow: Int): Int {
    if targetFunctionRow < 0 { return 0 }
    if edgeOwners.append(element: ownerFunctionRow) != 0 || edgeTargets.append(element: targetFunctionRow) != 0 { return 0 - 1 }
    return 0
}

function compilerFunctionEdgesAppendMissing(edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>, ownerFunctionRow: Int, targetFunctionRow: Int): Int {
    state edgeIndex: Int(0)
    while edgeIndex < edgeTargets.count {
        if edgeOwners.element(index: edgeIndex) == ownerFunctionRow
            && edgeTargets.element(index: edgeIndex) == targetFunctionRow { return 0 }
        edgeIndex: edgeIndex + 1
    }
    return compilerFunctionEdgesAppend(edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: ownerFunctionRow, targetFunctionRow: targetFunctionRow)
}

function compilerFunctionEdgesContain(edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>, ownerFunctionRow: Int, targetFunctionRow: Int): Bool {
    state edgeIndex: Int(0)
    while edgeIndex < edgeTargets.count {
        if edgeOwners.element(index: edgeIndex) == ownerFunctionRow
            && edgeTargets.element(index: edgeIndex) == targetFunctionRow { return true }
        edgeIndex: edgeIndex + 1
    }
    return false
}

function compilerBodyArenaAppendFunctionEdges(arena: CompilerBodyArena, edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>): Int {
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return 0 - 1 }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: row, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction() {
            if compilerFunctionEdgesAppendMissing(edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: arena.ownerFunctionRow, targetFunctionRow: compilerIntTableValue(table: arena.resolutions, row: row, column: compilerBodyResolutionTargetIDColumn())) != 0 { return 0 - 1 }
        }
        row: row + 1
    }
    return 0
}

function compilerBodyArenaResultTypeIsRepresentationSensitive(arena: CompilerBodyArena, typeKind: Int, typeID: Int): Bool {
    if (typeKind != compilerBodyTypeConstruct() && typeKind != compilerBodyTypeEnum())
        || typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return false }
    return compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: typeID, typeKind: typeKind) == compilerBodyFunctionSignatureABICategoryNone()
}

function compilerBodyArenaMarkRepresentationSensitiveTargets(arena: CompilerBodyArena, sensitiveFunctions: Buffer<Int>): Int {
    state resolutionRow: Int(0)
    while resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction()
            && (compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeConstruct()
                || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) == compilerBodyTypeEnum()) {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            let resultTypeKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()))
            let resultTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
            if targetFunctionRow < 0 || targetFunctionRow >= sensitiveFunctions.count { return 0 - 1 }
            if compilerBodyArenaResultTypeIsRepresentationSensitive(arena: arena, typeKind: resultTypeKind, typeID: resultTypeID) {
                if sensitiveFunctions.update(element: 1, index: targetFunctionRow) != 0 { return 0 - 1 }
            }
        }
        resolutionRow: resolutionRow + 1
    }
    return 0
}

function compilerBodyMIRAppendFunctionEdges(arena: CompilerBodyArena, edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>): Int {
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return 0 - 1 }
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationKindColumn()) == compilerBodyMIROperationDirectCall()
            && compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetKindColumn()) == compilerBodyMIROperationTargetFunction() {
            if compilerFunctionEdgesAppendMissing(edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: arena.ownerFunctionRow, targetFunctionRow: compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn())) != 0 { return 0 - 1 }
        }
        operationRow: operationRow + 1
    }
    return 0
}

function compilerBodyMIRMarkRepresentationSensitiveTargets(arena: CompilerBodyArena, sensitiveFunctions: Buffer<Int>): Int {
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationKindColumn()) == compilerBodyMIROperationDirectCall()
            && compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetKindColumn()) == compilerBodyMIROperationTargetFunction() {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationTargetIDColumn()))
            let resultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
            if targetFunctionRow < 0 || targetFunctionRow >= sensitiveFunctions.count
                || resultValueID < 0 || resultValueID >= compilerIntTableRowCount(table: arena.mirValues) { return 0 - 1 }
            let resultTypeKind: Int(compilerIntTableValue(table: arena.mirValues, row: resultValueID, column: compilerBodyMIRValueTypeColumn()))
            if resultTypeKind == compilerBodyTypeConstruct() || resultTypeKind == compilerBodyTypeEnum() {
                let resultTypeID: Int(compilerIntTableValue(table: arena.mirValues, row: resultValueID, column: compilerBodyMIRValueTypeIDColumn()))
                if compilerBodyArenaResultTypeIsRepresentationSensitive(arena: arena, typeKind: resultTypeKind, typeID: resultTypeID) {
                    if sensitiveFunctions.update(element: 1, index: targetFunctionRow) != 0 { return 0 - 1 }
                }
            }
        }
        operationRow: operationRow + 1
    }
    return 0
}



function compilerBodyArenaHasUnplannedRepresentationSensitiveCall(arena: CompilerBodyArena, abiPlan: CompilerModuleABIPlan): Bool {
    state resolutionRow: Int(0)
    while resolutionRow < compilerIntTableRowCount(table: arena.resolutions) {
        if compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionFunction() {
            let targetFunctionRow: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            if compilerFunctionHasRepresentationSensitiveABI(tables: arena.tables, index: arena.declarationIndex, functionRow: targetFunctionRow)
                && (!compilerBodyArenaOwnerIsParticipant(arena: arena, plan: abiPlan)
                    || !compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: targetFunctionRow)) { return true }
        }
        resolutionRow: resolutionRow + 1
    }
    return false
}

function compilerFunctionReachabilityRecordTarget(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, worklist: Buffer<Int>, edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>, ownerFunctionRow: Int, targetName: String): Int {
    if targetName == String("String") || compilerBodyRuntimeBuiltinID(name: targetName) != compilerBodyRuntimeBuiltinNone() { return 0 }
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: targetName, kindTag: compilerSyntaxKindFunction()))
    state targetFunctionRow: Int(0 - 1)
    if declarationRow >= 0 {
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 13) != 0 { return 0 }
        let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
        targetFunctionRow: compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1)
    } else {
        targetFunctionRow: compilerDeclarationIndexAnyMemberFunctionLookup(tables: tables, index: index, name: targetName)
    }
    if targetFunctionRow < 0 { return 0 }
    if edgeOwners.append(element: ownerFunctionRow) != 0 || edgeTargets.append(element: targetFunctionRow) != 0 { return 0 - 1 }
    if compilerFunctionSelectionContains(selection: selection, functionRow: targetFunctionRow) { return 0 }
    if compilerFunctionSelectionMark(selection: selection, functionRow: targetFunctionRow) != 0 { return 0 - 1 }
    return worklist.append(element: targetFunctionRow)
}

function compilerFunctionReachabilityScanRange(source: String, start: Int, end: Int, tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, worklist: Buffer<Int>, edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>, ownerFunctionRow: Int, scanInterpolations: Bool): Int {
    state cursor: Int(start)
    while cursor < end {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: cursor))
        if maybeToken == nil { return 0 }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackTokenAt(index: cursor))
        if token.start >= end { return 0 }
        if token.end <= cursor { return 0 - 1 }
        if scanInterpolations && token.kind == .stringLiteral {
            let content: String(compilerCoreStringLiteralContent(text: token.text))
            if compilerCoreStringContentHasInterpolation(content: content) && compilerFunctionReachabilityScanInterpolations(content: content, tables: tables, index: index, selection: selection, worklist: worklist, edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: ownerFunctionRow) != 0 { return 0 - 1 }
        }
        if (token.kind == .identifier || token.kind == .keyword) {
            let maybeNext: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: token.end))
            if maybeNext != nil {
                let next: RangeLexedToken(maybeNext ?? compilerFallbackTokenAt(index: token.end))
                if next.start < end && next.kind == .leftParen && compilerFunctionReachabilityRecordTarget(tables: tables, index: index, selection: selection, worklist: worklist, edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: ownerFunctionRow, targetName: token.text) != 0 { return 0 - 1 }
            }
        }
        cursor: token.end
    }
    return 0
}

function compilerFunctionReachabilityScanInterpolations(content: String, tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, worklist: Buffer<Int>, edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>, ownerFunctionRow: Int): Int {
    let contentLength: Int(stringLength(value: content))
    let backslash: String(compilerCoreSingleBackslash())
    state contentIndex: Int(0)
    while contentIndex + 1 < contentLength {
        if content.character(index: contentIndex) == backslash && content.character(index: contentIndex + 1) == String("(") {
            let expressionEnd: Int(compilerCoreInterpolatedExpressionEnd(content: content, start: contentIndex + 2))
            if expressionEnd >= contentLength { return 0 - 1 }
            if compilerFunctionReachabilityScanRange(source: content, start: contentIndex + 2, end: expressionEnd, tables: tables, index: index, selection: selection, worklist: worklist, edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: ownerFunctionRow, scanInterpolations: false) != 0 { return 0 - 1 }
            contentIndex: expressionEnd + 1
        } else {
            contentIndex: contentIndex + 1
        }
    }
    return 0
}

function compilerFunctionReachabilitySeedRoots(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, worklist: Buffer<Int>, rootNames: String): Int {
    state rootIndex: Int(0)
    while rootIndex < stringLength(value: rootNames) {
        let rootName: String(compilerCoreNameListNameAt(names: rootNames, start: rootIndex))
        let rootDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: rootName, kindTag: compilerSyntaxKindFunction()))
        if rootDeclarationRow < 0 { return 0 - 1 }
        let rootSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: rootDeclarationRow, column: 0))
        let rootFunctionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: rootSyntaxID, column: 1))
        if !compilerFunctionSelectionContains(selection: selection, functionRow: rootFunctionRow) && (compilerFunctionSelectionMark(selection: selection, functionRow: rootFunctionRow) != 0 || worklist.append(element: rootFunctionRow) != 0) { return 0 - 1 }
        rootIndex: compilerCoreNameListNextIndex(names: rootNames, start: rootIndex)
    }
    return 0
}

function compilerFunctionReachabilityExpand(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, selection: CompilerFunctionSelection, worklist: Buffer<Int>, edgeOwners: Buffer<Int>, edgeTargets: Buffer<Int>): Int {
    state workIndex: Int(0)
    while workIndex < worklist.count {
        let ownerFunctionRow: Int(worklist.element(index: workIndex))
        let fileID: Int(compilerIntTableValue(table: tables.functions, row: ownerFunctionRow, column: 1))
        let bodyStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: ownerFunctionRow, column: 8)))
        let bodyEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.functions, row: ownerFunctionRow, column: 9)))
        if bodyStart < 0 || bodyEnd < bodyStart { return 0 - 1 }
        if compilerFunctionReachabilityScanRange(source: tables.sourceStore.source, start: bodyStart, end: bodyEnd, tables: tables, index: index, selection: selection, worklist: worklist, edgeOwners: edgeOwners, edgeTargets: edgeTargets, ownerFunctionRow: ownerFunctionRow, scanInterpolations: true) != 0 { return 0 - 1 }
        workIndex: workIndex + 1
    }
    return 0
}

function compilerFunctionReachabilityCreate(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, rootNames: String): CompilerFunctionReachability {
    let functionCount: Int(compilerIntTableRowCount(table: tables.functions))
    let selection: CompilerFunctionSelection(compilerFunctionSelectionCreateEmpty(functionCount: functionCount, valid: index.isValid))
    let edgeOwners: Buffer<Int>(bufferCreateInt(capacity: functionCount))
    let edgeTargets: Buffer<Int>(bufferCreateInt(capacity: functionCount))
    let worklist: Buffer<Int>(bufferCreateInt(capacity: functionCount))
    state valid: Bool(false)
    valid: selection.isValid
    if valid && compilerFunctionReachabilitySeedRoots(tables: tables, index: index, selection: selection, worklist: worklist, rootNames: rootNames) != 0 { valid: false }
    if valid && compilerFunctionReachabilityExpand(tables: tables, index: index, selection: selection, worklist: worklist, edgeOwners: edgeOwners, edgeTargets: edgeTargets) != 0 { valid: false }
    worklist.destroy()
    return CompilerFunctionReachability(selection: selection, edgeOwners: edgeOwners, edgeTargets: edgeTargets, isValid: valid)
}

function compilerFunctionReachabilityDestroy(reachability: CompilerFunctionReachability): Int {
    state status: Int(compilerFunctionSelectionDestroy(selection: reachability.selection))
    if reachability.edgeOwners.destroy() != 0 { status: 0 - 1 }
    if reachability.edgeTargets.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerFunctionSelectionDestroy(selection: CompilerFunctionSelection): Int {
    return selection.selectedRows.destroy()
}

function compilerFunctionSelectionContains(selection: CompilerFunctionSelection, functionRow: Int): Bool {
    return selection.isValid && functionRow >= 0 && functionRow < selection.selectedRows.count
        && selection.selectedRows.element(index: functionRow) == 1
}

function compilerSyntaxTableAppend(tables: CompilerSyntaxTables, table: CompilerIntTable, value: Int): Int {
    let status: Int(compilerIntTableAppend(table: table, value: value))
    if status != 0 {
        compilerSyntaxTablesPoison(tables: tables)
    }
    return status
}

function compilerSyntaxGlobalRangeIsValid(tables: CompilerSyntaxTables, fileID: Int, start: Int, end: Int): Bool {
    if fileID < 0 || fileID >= compilerSourceStoreFileCount(store: tables.sourceStore) || end < start {
        return false
    }
    let localStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: start))
    let localEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: end))
    return localStart >= 0 && localEnd >= localStart
}

function compilerSyntaxDeclarationRangesAreValid(tables: CompilerSyntaxTables, fileID: Int, declarationStart: Int, declarationEnd: Int, nameStart: Int, nameEnd: Int, bodyStart: Int, bodyEnd: Int): Bool {
    return declarationStart <= nameStart && nameStart <= nameEnd && nameEnd <= bodyStart && bodyStart <= bodyEnd && bodyEnd <= declarationEnd
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: declarationStart, end: declarationEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: nameStart, end: nameEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: bodyStart, end: bodyEnd)
}

function compilerSyntaxDeclarationGenericRangeIsValid(tables: CompilerSyntaxTables, fileID: Int, nameEnd: Int, genericRange: CompilerSourceRange, bodyStart: Int): Bool {
    if genericRange.start < 0 && genericRange.end < 0 { return true }
    return genericRange.start >= nameEnd && genericRange.start < genericRange.end && genericRange.end <= bodyStart
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: genericRange.start, end: genericRange.end)
}

function compilerSyntaxMemberRangesAreValid(tables: CompilerSyntaxTables, fileID: Int, memberStart: Int, memberEnd: Int, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): Bool {
    return memberStart <= nameStart && nameStart <= nameEnd && nameEnd <= typeStart && typeStart <= typeEnd && typeEnd <= memberEnd
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: memberStart, end: memberEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: nameStart, end: nameEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: typeStart, end: typeEnd)
}

function compilerSyntaxFunctionRangesAreValid(tables: CompilerSyntaxTables, fileID: Int, parameterStart: Int, parameterEnd: Int, returnTypeStart: Int, returnTypeEnd: Int, bodyStart: Int, bodyEnd: Int): Bool {
    return parameterStart <= parameterEnd && parameterEnd <= returnTypeStart && returnTypeStart <= returnTypeEnd && returnTypeEnd <= bodyStart && bodyStart <= bodyEnd
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: parameterStart, end: parameterEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: returnTypeStart, end: returnTypeEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: bodyStart, end: bodyEnd)
}

function compilerSyntaxParameterRangesAreValid(tables: CompilerSyntaxTables, fileID: Int, parameterStart: Int, parameterEnd: Int, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): Bool {
    return parameterStart <= nameStart && nameStart <= nameEnd && nameEnd <= typeStart && typeStart <= typeEnd && typeEnd <= parameterEnd
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: parameterStart, end: parameterEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: nameStart, end: nameEnd)
        && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: typeStart, end: typeEnd)
}

function compilerFingerprintInitial(): CompilerFingerprint {
    return CompilerFingerprint(first: 17, second: 29)
}

function compilerFingerprintAppendInt(fingerprint: CompilerFingerprint, value: Int): CompilerFingerprint {
    let firstModulus: Int(16000057)
    let secondModulus: Int(15000017)
    let firstValue: Int(value % firstModulus)
    let secondValue: Int(value % secondModulus)
    return CompilerFingerprint(
        first: (fingerprint.first * 127 + firstValue) % firstModulus,
        second: (fingerprint.second * 131 + secondValue) % secondModulus
    )
}

function compilerFingerprintAppendRange(fingerprint: CompilerFingerprint, tag: Int, source: String, start: Int, end: Int): CompilerFingerprint {
    let tagged: CompilerFingerprint(compilerFingerprintAppendInt(fingerprint: fingerprint, value: tag))
    let framed: CompilerFingerprint(compilerFingerprintAppendInt(fingerprint: tagged, value: end - start))
    state first: Int(0)
    first: framed.first
    state second: Int(0)
    second: framed.second
    state sourceIndex: Int(start)
    state byte: Int(0)
    while sourceIndex < end {
        byte: stringByteAt(source: source, index: sourceIndex) + 1
        first: (first * 127 + byte) % 16000057
        second: (second * 131 + byte) % 15000017
        sourceIndex: sourceIndex + 1
    }
    return CompilerFingerprint(first: first, second: second)
}

function compilerFingerprintAppendText(fingerprint: CompilerFingerprint, tag: Int, text: String): CompilerFingerprint {
    return compilerFingerprintAppendRange(fingerprint: fingerprint, tag: tag, source: text, start: 0, end: stringLength(value: text))
}

function compilerSyntaxDeclarationBaseFingerprint(tables: CompilerSyntaxTables, fileID: Int, kindTag: Int, name: String): CompilerFingerprint {
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    let pathStart: Int(compilerSourceStoreFilePathStart(store: tables.sourceStore, fileID: fileID))
    let pathEnd: Int(compilerSourceStoreFilePathEnd(store: tables.sourceStore, fileID: fileID))
    if pathEnd > pathStart {
        fingerprint: compilerFingerprintAppendRange(fingerprint: fingerprint, tag: 1, source: tables.sourceStore.source, start: pathStart, end: pathEnd)
    } else {
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: 0)
    }
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerSourceStoreFileRole(store: tables.sourceStore, fileID: fileID))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: kindTag)
    return compilerFingerprintAppendText(fingerprint: fingerprint, tag: 2, text: name)
}

function compilerSyntaxAllocate(tables: CompilerSyntaxTables, kindTag: Int, facetRow: Int): Int {
    state expectedFacetRow: Int(0 - 1)
    if kindTag == compilerSyntaxKindConstruct() || kindTag == compilerSyntaxKindEnum() {
        expectedFacetRow: compilerIntTableRowCount(table: tables.declarations)
    } else if kindTag == compilerSyntaxKindFunction() {
        expectedFacetRow: compilerIntTableRowCount(table: tables.functions)
    } else if kindTag == compilerSyntaxKindMember() {
        expectedFacetRow: compilerIntTableRowCount(table: tables.members)
    } else if kindTag == compilerSyntaxKindParameter() {
        expectedFacetRow: compilerIntTableRowCount(table: tables.parameters)
    } else if kindTag >= compilerSyntaxKindEntry() && kindTag <= compilerSyntaxKindLastBody() {
        expectedFacetRow: compilerIntTableRowCount(table: tables.bodyNodes)
    }
    if facetRow < 0 || facetRow != expectedFacetRow {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }
    let syntaxID: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    if compilerSyntaxTableAppend(tables: tables, table: tables.syntaxIndex, value: kindTag) != 0 {
        return 0 - 1
    }
    if compilerSyntaxTableAppend(tables: tables, table: tables.syntaxIndex, value: facetRow) != 0 {
        return 0 - 1
    }
    return syntaxID
}

function compilerBodySyntaxLocalOffset(tables: CompilerSyntaxTables, context: CompilerBodySyntaxCaptureContext, globalOffset: Int): Int {
    if globalOffset < 0 {
        return 0 - 1
    }
    return compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: context.fileID, globalOffset: globalOffset)
}

function compilerBodySyntaxAppendNode(tables: CompilerSyntaxTables, context: CompilerBodySyntaxCaptureContext, kindTag: Int, ordinal: Int, start: Int, end: Int, firstStart: Int, firstEnd: Int, secondStart: Int, secondEnd: Int, aux: Int): Int {
    if kindTag < compilerSyntaxKindEntry() || kindTag > compilerSyntaxKindLastBody()
        || !compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: context.fileID, start: start, end: end)
        || (firstStart >= 0 && !compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: context.fileID, start: firstStart, end: firstEnd))
        || (secondStart >= 0 && !compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: context.fileID, start: secondStart, end: secondEnd)) {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }
    let bodyRow: Int(compilerIntTableRowCount(table: tables.bodyNodes))
    let syntaxID: Int(compilerSyntaxAllocate(tables: tables, kindTag: kindTag, facetRow: bodyRow))
    if syntaxID < 0 { return syntaxID }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: syntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: context.fileID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: context.ownerSyntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: ordinal) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: compilerBodySyntaxLocalOffset(tables: tables, context: context, globalOffset: start)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: compilerBodySyntaxLocalOffset(tables: tables, context: context, globalOffset: end)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: compilerBodySyntaxLocalOffset(tables: tables, context: context, globalOffset: firstStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: compilerBodySyntaxLocalOffset(tables: tables, context: context, globalOffset: firstEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: compilerBodySyntaxLocalOffset(tables: tables, context: context, globalOffset: secondStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: compilerBodySyntaxLocalOffset(tables: tables, context: context, globalOffset: secondEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyNodes, value: aux) != 0 { return 0 - 1 }
    return syntaxID
}

function compilerBodySyntaxAppendEdge(tables: CompilerSyntaxTables, ownerSyntaxID: Int, childSyntaxID: Int, roleTag: Int, ordinal: Int): Int {
    if ownerSyntaxID < 0 || childSyntaxID < 0 || roleTag < compilerSyntaxRoleStatement() || roleTag > compilerSyntaxRoleBody() {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyEdges, value: ownerSyntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyEdges, value: childSyntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.bodyEdges, value: roleTag) != 0 { return 0 - 1 }
    return compilerSyntaxTableAppend(tables: tables, table: tables.bodyEdges, value: ordinal)
}

function compilerBodySyntaxAppendBlock(tables: CompilerSyntaxTables, fileID: Int, ownerSyntaxID: Int, roleTag: Int, start: Int, end: Int): Int {
    let ownerContext: CompilerBodySyntaxCaptureContext(fileID: fileID, ownerSyntaxID: ownerSyntaxID, statementOrdinal: 0)
    let blockSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: ownerContext, kindTag: compilerSyntaxKindBlock(), ordinal: 0, start: start, end: end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if blockSyntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: ownerSyntaxID, childSyntaxID: blockSyntaxID, roleTag: roleTag, ordinal: 0) != 0 {
        return 0 - 1
    }
    return blockSyntaxID
}

function compilerBodySyntaxExpressionRecordRangeIsValid(source: String, record: String): Bool {
    if record == String("") { return false }
    let start: Int(compilerCoreExpressionRecordStart(record: record))
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    return start >= 0 && end >= start && end <= stringLength(value: source)
}

function compilerBodySyntaxFindTokenRange(source: String, start: Int, end: Int, kind: RangeTokenKind, text: String): CompilerSourceRange {
    state cursor: CompilerTokenCursor(source: $source, index: start)
    state foundStart: Int(0 - 1)
    state foundEnd: Int(0 - 1)
    while cursor.index < end && foundStart < 0 {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            cursor: CompilerTokenCursor(source: $source, index: end)
        } else {
            let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: cursor))
            if token.start >= end {
                cursor: CompilerTokenCursor(source: $source, index: end)
            } else {
                if token.kind == kind && (text == String("") || token.text == text) {
                    foundStart: token.start
                    foundEnd: token.end
                }
                cursor: compilerCursorAdvance(cursor: cursor, token: token)
            }
        }
    }
    return CompilerSourceRange(start: foundStart, end: foundEnd, next: foundEnd)
}

function compilerBodySyntaxFindDelimitedSuffix(source: String, start: Int, end: Int, leftKind: RangeTokenKind, rightKind: RangeTokenKind): CompilerSourceRange {
    let missingRange: CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
    let cursor: CompilerTokenCursor(source: $source, index: start)
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil { return missingRange }
    let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: cursor))
    if token.kind != leftKind || token.start >= end { return missingRange }
    let maybeRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: cursor, leftKind: leftKind, rightKind: rightKind))
    if maybeRange == nil { return missingRange }
    let range: CompilerSourceRange(maybeRange ?? CompilerSourceRange(start: token.end, end: token.end, next: token.end))
    if range.next != end { return missingRange }
    return range
}

function compilerBodySyntaxCaptureExpressionLeaf(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext, kindTag: Int): Int {
    let start: Int(compilerCoreExpressionRecordStart(record: record))
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))
    let cursor: CompilerTokenCursor(source: $source, index: start)
    let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
    if maybeToken == nil { return 0 - 1 }
    let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: cursor))
    state matchesSource: Bool(false)
    if kindTag == compilerSyntaxKindIntegerLiteral() || kindTag == compilerSyntaxKindDoubleLiteral() {
        matchesSource: (kindTag == compilerSyntaxKindIntegerLiteral() && token.kind == .integer || kindTag == compilerSyntaxKindDoubleLiteral() && token.kind == .double) && token.start == start && token.end == end && token.text == value
    } else if kindTag == compilerSyntaxKindIdentifier() {
        matchesSource: (token.kind == .identifier || token.kind == .keyword) && token.start == start && token.end == end && token.text == value
    }
    if !matchesSource { return 0 - 1 }
    return compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: kindTag, ordinal: 0, start: start, end: end, firstStart: start, firstEnd: end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
}

function compilerBodySyntaxCaptureTypeIdentifierRecord(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    if compilerCoreExpressionRecordKind(record: record) != String("identifier") { return 0 - 1 }
    let start: Int(compilerCoreExpressionRecordStart(record: record))
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    let cursor: CompilerTokenCursor(source: $source, index: start)
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: cursor))
    if maybeType == nil { return 0 - 1 }
    let typeReference: CompilerTypeReference(maybeType ?? CompilerTypeReference(text: String(""), start: start, end: start))
    if typeReference.start != start || typeReference.end != end || typeReference.text != compilerCoreExpressionRecordValue(record: record) {
        return 0 - 1
    }
    return compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindIdentifier(), ordinal: 0, start: start, end: end, firstStart: start, firstEnd: end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
}

function compilerBodySyntaxCaptureBindingReference(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    let start: Int(compilerCoreExpressionRecordStart(record: record))
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))
    let dollarRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: start, end: end, kind: .dollar, text: String("")))
    if dollarRange.start != start { return 0 - 1 }
    let nameRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: dollarRange.end, end: end, kind: .identifier, text: value))
    if nameRange.start < 0 || nameRange.end != end {
        return 0 - 1
    }
    return compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindBindingReference(), ordinal: 0, start: start, end: end, firstStart: nameRange.start, firstEnd: nameRange.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0)
}

function compilerBodySyntaxCaptureMemberRecord(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    let leftRecord: String(compilerCoreExpressionRecordLeft(record: record))
    if !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: leftRecord) { return 0 - 1 }
    if compilerCoreExpressionRecordKind(record: leftRecord) == String("bindingReference") { return 0 - 1 }
    let receiverSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: leftRecord, context: context))
    if receiverSyntaxID < 0 { return receiverSyntaxID }
    let leftEnd: Int(compilerCoreExpressionRecordEnd(record: leftRecord))
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    let value: String(compilerCoreExpressionRecordValue(record: record))
    let dotCursor: CompilerTokenCursor(source: $source, index: leftEnd)
    let maybeDot: Optional<RangeLexedToken>(compilerCursorPeek(cursor: dotCursor))
    if maybeDot == nil { return 0 - 1 }
    let dot: RangeLexedToken(maybeDot ?? compilerFallbackToken(cursor: dotCursor))
    if dot.kind != .dot { return 0 - 1 }
    let memberCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: dotCursor, token: dot))
    let maybeMember: Optional<RangeLexedToken>(compilerCursorPeek(cursor: memberCursor))
    if maybeMember == nil { return 0 - 1 }
    let member: RangeLexedToken(maybeMember ?? compilerFallbackToken(cursor: memberCursor))
    if (member.kind != .identifier && member.kind != .keyword) || member.text != value || member.end != end { return 0 - 1 }
    let syntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindMemberRead(), ordinal: 0, start: compilerCoreExpressionRecordStart(record: record), end: end, firstStart: member.start, firstEnd: member.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if syntaxID < 0 || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: syntaxID, childSyntaxID: receiverSyntaxID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0) != 0 {
        return 0 - 1
    }
    return syntaxID
}

function compilerBodySyntaxCaptureBinaryRecord(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    let leftRecord: String(compilerCoreExpressionRecordLeft(record: record))
    let rightRecord: String(compilerCoreExpressionRecordRight(record: record))
    if !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: leftRecord)
        || !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: rightRecord) {
        return 0 - 1
    }
    let leftSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: leftRecord, context: context))
    if leftSyntaxID < 0 { return leftSyntaxID }
    let rightSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: rightRecord, context: context))
    if rightSyntaxID < 0 { return rightSyntaxID }
    let value: String(compilerCoreExpressionRecordValue(record: record))
    if value != String("+") { return 0 - 1 }
    let operatorRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: compilerCoreExpressionRecordEnd(record: leftRecord), end: compilerCoreExpressionRecordStart(record: rightRecord), kind: .plus, text: value))
    if operatorRange.start < 0 { return 0 - 1 }
    let syntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindAddition(), ordinal: 0, start: compilerCoreExpressionRecordStart(record: record), end: compilerCoreExpressionRecordEnd(record: record), firstStart: operatorRange.start, firstEnd: operatorRange.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if syntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: syntaxID, childSyntaxID: leftSyntaxID, roleTag: compilerSyntaxRoleLeftOperand(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: syntaxID, childSyntaxID: rightSyntaxID, roleTag: compilerSyntaxRoleRightOperand(), ordinal: 0) != 0 {
        return 0 - 1
    }
    return syntaxID
}

function compilerBodySyntaxCaptureCallRecordWithTypeIdentifier(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext, allowTypeIdentifier: Bool): Int {
    let calleeRecord: String(compilerCoreExpressionRecordLeft(record: record))
    if !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: calleeRecord) { return 0 - 1 }
    if compilerCoreExpressionRecordKind(record: calleeRecord) == String("bindingReference") { return 0 - 1 }
    state calleeSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: calleeRecord, context: context))
    if calleeSyntaxID < 0 && allowTypeIdentifier && compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier") {
        calleeSyntaxID: compilerBodySyntaxCaptureTypeIdentifierRecord(source: source, tables: tables, record: calleeRecord, context: context)
    }
    if calleeSyntaxID < 0 { return calleeSyntaxID }
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    let argumentRange: CompilerSourceRange(compilerBodySyntaxFindDelimitedSuffix(source: source, start: compilerCoreExpressionRecordEnd(record: calleeRecord), end: end, leftKind: .leftParen, rightKind: .rightParen))
    if argumentRange.start < 0 || argumentRange.next != end { return 0 - 1 }
    let callSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindApplication(), ordinal: 0, start: compilerCoreExpressionRecordStart(record: record), end: end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if callSyntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: callSyntaxID, childSyntaxID: calleeSyntaxID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0) != 0
        || compilerBodySyntaxCaptureCallArgumentRecords(source: source, tables: tables, records: compilerCoreExpressionRecordArguments(record: record), start: argumentRange.start, end: argumentRange.end, context: context, callSyntaxID: callSyntaxID) != 0 {
        return 0 - 1
    }
    return callSyntaxID
}

function compilerBodySyntaxCaptureCallRecord(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    return compilerBodySyntaxCaptureCallRecordWithTypeIdentifier(source: source, tables: tables, record: record, context: context, allowTypeIdentifier: false)
}

function compilerBodySyntaxCaptureIndexRecord(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    let receiverRecord: String(compilerCoreExpressionRecordLeft(record: record))
    let indexRecord: String(compilerCoreExpressionRecordRight(record: record))
    if !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: receiverRecord)
        || !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: indexRecord) {
        return 0 - 1
    }
    if compilerCoreExpressionRecordKind(record: receiverRecord) == String("bindingReference") { return 0 - 1 }
    let end: Int(compilerCoreExpressionRecordEnd(record: record))
    let indexRange: CompilerSourceRange(compilerBodySyntaxFindDelimitedSuffix(source: source, start: compilerCoreExpressionRecordEnd(record: receiverRecord), end: end, leftKind: .leftBracket, rightKind: .rightBracket))
    if indexRange.start < 0 || indexRange.next != end { return 0 - 1 }
    let maybeIndex: Optional<CompilerExpression>(parseCompilerExpression(source: source, start: indexRange.start, limit: indexRange.end))
    if maybeIndex == nil { return 0 - 1 }
    let indexExpression: CompilerExpression(maybeIndex ?? compilerCoreMissingExpression(start: indexRange.start))
    let maybeRightBracket: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: indexExpression.end))
    if maybeRightBracket == nil { return 0 - 1 }
    let bracketCursor: CompilerTokenCursor(source: $source, index: indexExpression.end)
    let rightBracket: RangeLexedToken(maybeRightBracket ?? compilerFallbackToken(cursor: bracketCursor))
    if indexExpression.record != indexRecord || rightBracket.kind != .rightBracket
        || rightBracket.start != indexRange.end || rightBracket.end != end {
        return 0 - 1
    }
    let leftBracketRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: compilerCoreExpressionRecordEnd(record: receiverRecord), end: indexRange.start, kind: .leftBracket, text: String("")))
    if leftBracketRange.end != indexRange.start
        || compilerCoreExpressionRecordStart(record: indexRecord) < indexRange.start
        || compilerCoreExpressionRecordEnd(record: indexRecord) > indexRange.end {
        return 0 - 1
    }
    let receiverSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: receiverRecord, context: context))
    if receiverSyntaxID < 0 { return receiverSyntaxID }
    let indexSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: indexRecord, context: context))
    if indexSyntaxID < 0 { return indexSyntaxID }
    let syntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindIndex(), ordinal: 0, start: compilerCoreExpressionRecordStart(record: record), end: end, firstStart: leftBracketRange.start, firstEnd: leftBracketRange.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if syntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: syntaxID, childSyntaxID: receiverSyntaxID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: syntaxID, childSyntaxID: indexSyntaxID, roleTag: compilerSyntaxRoleIndex(), ordinal: 0) != 0 {
        return 0 - 1
    }
    return syntaxID
}

function compilerBodySyntaxCaptureExpressionRecord(source: String, tables: CompilerSyntaxTables, record: String, context: CompilerBodySyntaxCaptureContext): Int {
    if !compilerBodySyntaxExpressionRecordRangeIsValid(source: source, record: record) { return 0 - 1 }
    let kind: String(compilerCoreExpressionRecordKind(record: record))
    if kind == String("integerLiteral") {
        return compilerBodySyntaxCaptureExpressionLeaf(source: source, tables: tables, record: record, context: context, kindTag: compilerSyntaxKindIntegerLiteral())
    }
    if kind == String("identifier") {
        return compilerBodySyntaxCaptureExpressionLeaf(source: source, tables: tables, record: record, context: context, kindTag: compilerSyntaxKindIdentifier())
    }
    if kind == String("bindingReference") {
        return compilerBodySyntaxCaptureBindingReference(source: source, tables: tables, record: record, context: context)
    }
    if kind == String("member") {
        return compilerBodySyntaxCaptureMemberRecord(source: source, tables: tables, record: record, context: context)
    }
    if kind == String("binary") {
        return compilerBodySyntaxCaptureBinaryRecord(source: source, tables: tables, record: record, context: context)
    }
    if kind == String("call") {
        return compilerBodySyntaxCaptureCallRecord(source: source, tables: tables, record: record, context: context)
    }
    if kind == String("index") {
        return compilerBodySyntaxCaptureIndexRecord(source: source, tables: tables, record: record, context: context)
    }
    return 0 - 1
}

function compilerBodySyntaxCaptureCallArgumentRecords(source: String, tables: CompilerSyntaxTables, records: String, start: Int, end: Int, context: CompilerBodySyntaxCaptureContext, callSyntaxID: Int): Int {
    if callSyntaxID < 0 || start < 0 || end < start || end > stringLength(value: source) { return 0 - 1 }
    state sourceCursor: CompilerTokenCursor(source: $source, index: start)
    state recordIndex: Int(0)
    state argumentIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    while recordIndex < recordsLength {
        let argumentRecord: String(compilerCoreCallArgumentRecordAt(records: records, start: recordIndex))
        if argumentRecord == String("") { return 0 - 1 }
        state token: RangeLexedToken(compilerFallbackToken(cursor: sourceCursor))
        state foundArgumentToken: Bool(false)
        while !foundArgumentToken {
            let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: sourceCursor))
            if maybeToken == nil { return 0 - 1 }
            token: maybeToken ?? compilerFallbackToken(cursor: sourceCursor)
            if token.kind == .comma {
                sourceCursor: compilerCursorAdvance(cursor: sourceCursor, token: token)
            } else {
                foundArgumentToken: true
            }
        }
        if token.start >= end { return 0 - 1 }
        let argumentStart: Int(token.start)
        let label: String(compilerCoreCallArgumentLabel(record: argumentRecord))
        state labelStart: Int(0 - 1)
        state labelEnd: Int(0 - 1)
        state expressionStart: Int(token.start)
        if label != String("") {
            if (token.kind != .identifier && token.kind != .keyword) || token.text != label { return 0 - 1 }
            let colonCursor: CompilerTokenCursor(compilerCursorAdvance(cursor: sourceCursor, token: token))
            let maybeColon: Optional<RangeLexedToken>(compilerCursorPeek(cursor: colonCursor))
            if maybeColon == nil { return 0 - 1 }
            let colon: RangeLexedToken(maybeColon ?? compilerFallbackToken(cursor: colonCursor))
            if colon.kind != .colon || colon.start >= end { return 0 - 1 }
            labelStart: token.start
            labelEnd: token.end
            expressionStart: colon.end
        }
        let maybeExpression: Optional<CompilerExpression>(parseCompilerExpression(source: source, start: expressionStart, limit: end))
        if maybeExpression == nil { return 0 - 1 }
        let expression: CompilerExpression(maybeExpression ?? compilerCoreMissingExpression(start: expressionStart))
        let expressionRecord: String(compilerCoreCallArgumentExpressionRecord(record: argumentRecord))
        if expression.end > end || expression.record != expressionRecord { return 0 - 1 }
        let expressionSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: expressionRecord, context: context))
        if expressionSyntaxID < 0 { return 0 - 1 }
        let argumentSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindArgument(), ordinal: argumentIndex, start: argumentStart, end: expression.end, firstStart: labelStart, firstEnd: labelEnd, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
        if argumentSyntaxID < 0
            || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: callSyntaxID, childSyntaxID: argumentSyntaxID, roleTag: compilerSyntaxRoleArgument(), ordinal: argumentIndex) != 0
            || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: argumentSyntaxID, childSyntaxID: expressionSyntaxID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0) != 0 {
            return 0 - 1
        }
        argumentIndex: argumentIndex + 1
        recordIndex: compilerCoreCallArgumentRecordNextIndex(records: records, start: recordIndex)
        sourceCursor: CompilerTokenCursor(source: $source, index: expression.end)
    }
    while sourceCursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: sourceCursor))
        if maybeToken == nil { return 0 }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: sourceCursor))
        if token.start >= end { return 0 }
        if token.kind != .comma { return 0 - 1 }
        sourceCursor: compilerCursorAdvance(cursor: sourceCursor, token: token)
    }
    return 0
}

function compilerBodySyntaxCaptureReturnStatement(source: String, tables: CompilerSyntaxTables, statement: CompilerStatement, context: CompilerBodySyntaxCaptureContext): Int {
    let expressionSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: statement.expressionRecord, context: context))
    if expressionSyntaxID < 0 { return 0 - 1 }
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindReturn(), ordinal: context.statementOrdinal, start: statement.start, end: statement.end, firstStart: 0 - 1, firstEnd: 0 - 1, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if statementSyntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: statementSyntaxID, childSyntaxID: expressionSyntaxID, roleTag: compilerSyntaxRoleReturnValue(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: context.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: context.statementOrdinal) != 0 {
        return 0 - 1
    }
    return 0
}

function compilerBodySyntaxCaptureLocalBindingStatement(source: String, tables: CompilerSyntaxTables, statement: CompilerStatement, context: CompilerBodySyntaxCaptureContext): Int {
    let keywordRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: statement.start, end: statement.end, kind: .keyword, text: statement.kind))
    if keywordRange.start != statement.start { return 0 - 1 }
    let nameRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: keywordRange.end, end: statement.end, kind: .identifier, text: statement.name))
    if nameRange.start < 0 { return 0 - 1 }
    let colonRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: nameRange.end, end: statement.end, kind: .colon, text: String("")))
    if colonRange.start < 0 { return 0 - 1 }
    let typeCursor: CompilerTokenCursor(source: $source, index: colonRange.end)
    let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: typeCursor))
    if maybeType == nil { return 0 - 1 }
    let typeReference: CompilerTypeReference(maybeType ?? CompilerTypeReference(text: String(""), start: typeCursor.index, end: typeCursor.index))
    if typeReference.text != statement.typeName || typeReference.end > statement.end { return 0 - 1 }
    state expressionSyntaxID: Int(0 - 1)
    let expressionKind: String(compilerCoreExpressionRecordKind(record: statement.expressionRecord))
    state isImplicitTypeCall: Bool(false)
    if expressionKind == String("call") {
        let calleeRecord: String(compilerCoreExpressionRecordLeft(record: statement.expressionRecord))
        let implicitArgumentRange: CompilerSourceRange(compilerBodySyntaxFindDelimitedSuffix(source: source, start: typeReference.end, end: statement.end, leftKind: .leftParen, rightKind: .rightParen))
        let matchesImplicitCallee: Bool(compilerCoreExpressionRecordKind(record: calleeRecord) == String("identifier")
            && compilerCoreExpressionRecordStart(record: calleeRecord) == typeReference.start
            && compilerCoreExpressionRecordEnd(record: calleeRecord) == typeReference.end
            && compilerCoreExpressionRecordValue(record: calleeRecord) == typeReference.text)
        if matchesImplicitCallee && implicitArgumentRange.start >= 0 {
            if compilerCoreCallArgumentsStartWithLabel(source: source, start: implicitArgumentRange.start, end: implicitArgumentRange.end) {
                isImplicitTypeCall: true
            }
        }
    }
    if isImplicitTypeCall {
        expressionSyntaxID: compilerBodySyntaxCaptureCallRecordWithTypeIdentifier(source: source, tables: tables, record: statement.expressionRecord, context: context, allowTypeIdentifier: true)
    } else {
        expressionSyntaxID: compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: statement.expressionRecord, context: context)
    }
    if expressionSyntaxID < 0 { return 0 - 1 }
    state bindingKind: Int(compilerSyntaxLocalKindLet())
    if statement.kind == String("state") { bindingKind: compilerSyntaxLocalKindState() }
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindLocalBinding(), ordinal: context.statementOrdinal, start: statement.start, end: statement.end, firstStart: nameRange.start, firstEnd: nameRange.end, secondStart: typeReference.start, secondEnd: typeReference.end, aux: bindingKind))
    if statementSyntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: statementSyntaxID, childSyntaxID: expressionSyntaxID, roleTag: compilerSyntaxRoleInitializer(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: context.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: context.statementOrdinal) != 0 {
        return 0 - 1
    }
    return 0
}

function compilerBodySyntaxCaptureAssignmentStatement(source: String, tables: CompilerSyntaxTables, statement: CompilerStatement, context: CompilerBodySyntaxCaptureContext): Int {
    let targetKind: String(compilerCoreExpressionRecordKind(record: statement.targetRecord))
    if targetKind != String("identifier") && targetKind != String("member") && targetKind != String("index") { return 0 - 1 }
    let targetSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: statement.targetRecord, context: context))
    if targetSyntaxID < 0 { return 0 - 1 }
    let valueSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: statement.expressionRecord, context: context))
    if valueSyntaxID < 0 { return 0 - 1 }
    let firstRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: statement.start, end: statement.end, kind: .identifier, text: String("")))
    if firstRange.start != statement.start { return 0 - 1 }
    let statementSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindAssignment(), ordinal: context.statementOrdinal, start: statement.start, end: statement.end, firstStart: firstRange.start, firstEnd: firstRange.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if statementSyntaxID < 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: statementSyntaxID, childSyntaxID: targetSyntaxID, roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: statementSyntaxID, childSyntaxID: valueSyntaxID, roleTag: compilerSyntaxRoleAssignedValue(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: context.ownerSyntaxID, childSyntaxID: statementSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: context.statementOrdinal) != 0 {
        return 0 - 1
    }
    return 0
}

function compilerBodySyntaxCaptureIfStatement(source: String, tables: CompilerSyntaxTables, statement: CompilerStatement, context: CompilerBodySyntaxCaptureContext): Int {
    if statement.elseBodyStart != 0 || statement.elseBodyEnd != 0 { return 0 - 1 }
    let keywordRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: statement.start, end: statement.bodyStart, kind: .keyword, text: String("if")))
    if keywordRange.start != statement.start { return 0 - 1 }
    let maybeCondition: Optional<CompilerExpression>(parseCompilerExpression(source: source, start: keywordRange.end, limit: statement.bodyStart))
    if maybeCondition == nil { return 0 - 1 }
    let condition: CompilerExpression(maybeCondition ?? compilerCoreMissingExpression(start: keywordRange.end))
    if condition.record != statement.expressionRecord { return 0 - 1 }
    let braceCursor: CompilerTokenCursor(source: $source, index: condition.end)
    let maybeLeftBrace: Optional<RangeLexedToken>(compilerCursorPeek(cursor: braceCursor))
    if maybeLeftBrace == nil { return 0 - 1 }
    let leftBrace: RangeLexedToken(maybeLeftBrace ?? compilerFallbackToken(cursor: braceCursor))
    let rightBraceRange: CompilerSourceRange(compilerBodySyntaxFindTokenRange(source: source, start: statement.bodyEnd, end: statement.end, kind: .rightBrace, text: String("")))
    if leftBrace.kind != .leftBrace || leftBrace.end != statement.bodyStart
        || rightBraceRange.start != statement.bodyEnd || rightBraceRange.end != statement.end {
        return 0 - 1
    }
    let conditionSyntaxID: Int(compilerBodySyntaxCaptureExpressionRecord(source: source, tables: tables, record: statement.expressionRecord, context: context))
    if conditionSyntaxID < 0 { return 0 - 1 }
    let ifSyntaxID: Int(compilerBodySyntaxAppendNode(tables: tables, context: context, kindTag: compilerSyntaxKindIf(), ordinal: context.statementOrdinal, start: statement.start, end: statement.end, firstStart: keywordRange.start, firstEnd: keywordRange.end, secondStart: 0 - 1, secondEnd: 0 - 1, aux: 0))
    if ifSyntaxID < 0 { return 0 - 1 }
    if compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: ifSyntaxID, childSyntaxID: conditionSyntaxID, roleTag: compilerSyntaxRoleCondition(), ordinal: 0) != 0
        || compilerBodySyntaxAppendEdge(tables: tables, ownerSyntaxID: context.ownerSyntaxID, childSyntaxID: ifSyntaxID, roleTag: compilerSyntaxRoleStatement(), ordinal: context.statementOrdinal) != 0
        || compilerTypedSyntaxCaptureBlock(source: source, tables: tables, fileID: context.fileID, ownerSyntaxID: ifSyntaxID, roleTag: compilerSyntaxRoleThenRegion(), start: statement.bodyStart, end: statement.bodyEnd) != 0 {
        return 0 - 1
    }
    return 0
}

function compilerBodySyntaxCaptureStatement(source: String, tables: CompilerSyntaxTables, statement: CompilerStatement, context: CompilerBodySyntaxCaptureContext): Int {
    if statement.kind == String("return") {
        return compilerBodySyntaxCaptureReturnStatement(source: source, tables: tables, statement: statement, context: context)
    }
    if statement.kind == String("let") || statement.kind == String("state") {
        return compilerBodySyntaxCaptureLocalBindingStatement(source: source, tables: tables, statement: statement, context: context)
    }
    if statement.kind == String("assignment") {
        return compilerBodySyntaxCaptureAssignmentStatement(source: source, tables: tables, statement: statement, context: context)
    }
    if statement.kind == String("if") {
        return compilerBodySyntaxCaptureIfStatement(source: source, tables: tables, statement: statement, context: context)
    }
    return 0 - 1
}

function compilerSyntaxAppendDeclaration(tables: CompilerSyntaxTables, syntaxID: Int, fileID: Int, kindTag: Int, parentSyntaxID: Int, ordinal: Int, declarationStart: Int, declarationEnd: Int, nameStart: Int, nameEnd: Int, bodyStart: Int, bodyEnd: Int, fingerprint: CompilerFingerprint, builtinPolicy: Int): Int {
    if !compilerSyntaxDeclarationRangesAreValid(tables: tables, fileID: fileID, declarationStart: declarationStart, declarationEnd: declarationEnd, nameStart: nameStart, nameEnd: nameEnd, bodyStart: bodyStart, bodyEnd: bodyEnd) {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: syntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: fileID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: kindTag) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: parentSyntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: ordinal) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: declarationStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: declarationEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: nameStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: nameEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: bodyStart)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: bodyEnd)) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: fingerprint.first) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: fingerprint.second) != 0 { return 0 - 1 }
    return compilerSyntaxTableAppend(tables: tables, table: tables.declarations, value: builtinPolicy)
}

function compilerSyntaxAppendMemberWithStorage(tables: CompilerSyntaxTables, syntaxID: Int, fileID: Int, parentSyntaxID: Int, ordinal: Int, memberStart: Int, memberEnd: Int, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int, valueStart: Int, valueEnd: Int, fingerprint: CompilerFingerprint, memberKind: Int, storagePolicy: Int): Int {
    if !compilerSyntaxMemberRangesAreValid(tables: tables, fileID: fileID, memberStart: memberStart, memberEnd: memberEnd, nameStart: nameStart, nameEnd: nameEnd, typeStart: typeStart, typeEnd: typeEnd) {
        compilerSyntaxTablesPoison(tables: tables)
        return 0 - 1
    }
    if (valueStart < 0 || valueEnd < 0) && (valueStart != 0 - 1 || valueEnd != 0 - 1) { return 0 - 1 }
    if valueStart >= 0 && (valueStart < typeStart || valueEnd <= valueStart || valueEnd > memberEnd) { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: syntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: fileID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: parentSyntaxID) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: ordinal) != 0 { return 0 - 1 }
    if compilerSyntaxTableAppend(tables: tables, table: tables.members, value: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: memberStart)) != 0 { return 0 - 1 }
