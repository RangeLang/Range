            && compilerSyntaxFunctionRangesAreValid(tables: tables, fileID: fileID, parameterStart: parameterStart, parameterEnd: parameterEnd, returnTypeStart: returnTypeStart, returnTypeEnd: returnTypeEnd, bodyStart: bodyStart, bodyEnd: bodyEnd)
