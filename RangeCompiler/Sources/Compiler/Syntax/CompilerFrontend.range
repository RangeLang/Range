function compilerSyntaxOptionalGlobalRangeIsValid(tables: CompilerSyntaxTables, fileID: Int, start: Int, end: Int): Bool {
    if start < 0 && end < 0 { return true }
    return start >= 0 && end >= start && compilerSyntaxGlobalRangeIsValid(tables: tables, fileID: fileID, start: start, end: end)
}

function compilerMacroTargetMaskContains(mask: Int, bit: Int): Bool {
    return (mask / bit) % 2 == 1
}

function compilerMacroTargetMaskUnion(lhs: Int, rhs: Int): Int {
    state result: Int(0)
    state bit: Int(1)
    while bit <= 16 {
        if compilerMacroTargetMaskContains(mask: lhs, bit: bit) || compilerMacroTargetMaskContains(mask: rhs, bit: bit) { result: result + bit }
        bit: bit * 2
    }
    return result
}

function compilerMacroTargetMaskIntersection(lhs: Int, rhs: Int): Int {
    state result: Int(0)
    state bit: Int(1)
    while bit <= 16 {
        if compilerMacroTargetMaskContains(mask: lhs, bit: bit) && compilerMacroTargetMaskContains(mask: rhs, bit: bit) { result: result + bit }
        bit: bit * 2
    }
    return result
}

function compilerMacroTargetAtomMask(text: String): Int {
    if text == String("Construct") || text == String("@construct") { return 1 }
    if text == String("Enum") { return 16 }
    if text == String("Function") { return 2 }
    if text == String("Member") || text == String("Let") || text == String("State") || text == String("Binding") || text == String("Derived") || text == String("@field") { return 4 }
    if text == String("Parameter") { return 8 }
    if text == String("Declaration") { return 19 }
    if text == String("Syntax") || text == String("@syntax") || text == String("@block") { return 31 }
    return 0
}

function compilerMacroTargetSurfaceForMask(mask: Int): Int {
    if mask == 1 { return compilerSyntaxKindConstruct() }
    if mask == 2 { return compilerSyntaxKindFunction() }
    if mask == 4 { return compilerSyntaxKindMember() }
    if mask == 8 { return compilerSyntaxKindParameter() }
    if mask == 16 { return compilerSyntaxKindEnum() }
    if mask == 19 { return compilerMacroTargetKindDeclaration() }
    if mask == 31 { return compilerMacroTargetKindSyntax() }
    if mask > 0 { return 200 + mask }
    return compilerMacroTargetKindMissing()
}

function compilerMacroTargetMaskForText(text: String): Int {
    let maybeFirst: Optional<RangeLexedToken>(lexNextRangeToken(source: text, start: 0))
    if maybeFirst == nil { return 0 }
    let first: RangeLexedToken(maybeFirst ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $text, index: 0)))
    state result: Int(compilerMacroTargetAtomMask(text: first.text))
    state cursor: Int(first.end)
    state genericDepth: Int(0)
    while cursor < stringLength(value: text) {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: text, start: cursor))
        if maybeToken == nil { return result }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $text, index: cursor)))
        if token.kind == .less { genericDepth: genericDepth + 1 }
        if token.kind == .greater && genericDepth > 0 { genericDepth: genericDepth - 1 }
        if genericDepth == 0 && (token.kind == .ampersand || token.kind == .pipe) {
            let maybeAtom: Optional<RangeLexedToken>(lexNextRangeToken(source: text, start: token.end))
            if maybeAtom == nil { return 0 }
            let atom: RangeLexedToken(maybeAtom ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $text, index: token.end)))
            let atomMask: Int(compilerMacroTargetAtomMask(text: atom.text))
            if token.kind == .ampersand {
                result: compilerMacroTargetMaskIntersection(lhs: result, rhs: atomMask)
            } else {
                result: compilerMacroTargetMaskUnion(lhs: result, rhs: atomMask)
            }
            cursor: atom.end
        } else {
            cursor: token.end
        }
    }
    return result
}

function compilerMacroTargetKindForText(text: String): Int {
    return compilerMacroTargetSurfaceForMask(mask: compilerMacroTargetMaskForText(text: text))
}

function compilerMacroTargetKindMissing(): Int { return 0 }

function compilerMacroTargetKindName(kindTag: Int): String {
    if kindTag == compilerSyntaxKindConstruct() { return String("Construct") }
    if kindTag == compilerSyntaxKindEnum() { return String("Enum") }
    if kindTag == compilerSyntaxKindFunction() { return String("Function") }
    if kindTag == compilerSyntaxKindMember() { return String("Member") }
    if kindTag == compilerSyntaxKindParameter() { return String("Parameter") }
    if kindTag == compilerMacroTargetKindDeclaration() { return String("Declaration") }
    if kindTag == compilerMacroTargetKindSyntax() { return String("Syntax") }
    return String("Unknown")
}

function compilerMacroTargetKindAccepts(surfaceKind: Int, targetKind: Int): Bool {
    state surfaceMask: Int(0)
    if surfaceKind == compilerSyntaxKindConstruct() { surfaceMask: 1 }
    if surfaceKind == compilerSyntaxKindFunction() { surfaceMask: 2 }
    if surfaceKind == compilerSyntaxKindMember() { surfaceMask: 4 }
    if surfaceKind == compilerSyntaxKindParameter() { surfaceMask: 8 }
    if surfaceKind == compilerSyntaxKindEnum() { surfaceMask: 16 }
    if surfaceKind == compilerMacroTargetKindDeclaration() { surfaceMask: 19 }
    if surfaceKind == compilerMacroTargetKindSyntax() { surfaceMask: 31 }
    if surfaceKind > 200 && surfaceKind <= 231 { surfaceMask: surfaceKind - 200 }
    state targetBit: Int(0)
    if targetKind == compilerSyntaxKindConstruct() { targetBit: 1 }
    if targetKind == compilerSyntaxKindFunction() { targetBit: 2 }
    if targetKind == compilerSyntaxKindMember() { targetBit: 4 }
    if targetKind == compilerSyntaxKindParameter() { targetBit: 8 }
    if targetKind == compilerSyntaxKindEnum() { targetBit: 16 }
    if surfaceKind == compilerSyntaxKindConstruct() && targetKind == compilerSyntaxKindEnum() { return true }
    return targetBit > 0 && compilerMacroTargetMaskContains(mask: surfaceMask, bit: targetBit)
}

function compilerMacroNominalNameMatches(nominalName: String, declarationName: String): Bool {
    if nominalName == declarationName { return true }
    let nominalLength: Int(stringLength(value: nominalName))
    let declarationLength: Int(stringLength(value: declarationName))
    if nominalLength <= 0 || nominalLength != declarationLength { return false }
    let nominalInitial: Int(stringByteAt(source: nominalName, index: 0))
    let declarationInitial: Int(stringByteAt(source: declarationName, index: 0))
    if nominalInitial < 65 || nominalInitial > 90 || declarationInitial != nominalInitial + 32 { return false }
    return stringSubstring(source: nominalName, start: 1, end: nominalLength) == stringSubstring(source: declarationName, start: 1, end: declarationLength)
}

function compilerMacroTargetDeclarationAccepts(tables: CompilerSyntaxTables, declarationRow: Int, targetKind: Int, depth: Int): Bool {
    if declarationRow < 0 || declarationRow >= compilerIntTableRowCount(table: tables.macroDeclarations) || depth > 8 { return false }
    let fileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
    let targetStart: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 11))
    let targetEnd: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 12))
    if targetStart < 0 || targetEnd < targetStart { return false }
    let text: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: targetStart, localEnd: targetEnd))
    return compilerMacroTargetTextAccepts(tables: tables, text: text, targetKind: targetKind, depth: depth)
}

function compilerMacroTargetAtomAccepts(tables: CompilerSyntaxTables, text: String, targetKind: Int, depth: Int): Bool {
    let knownMask: Int(compilerMacroTargetAtomMask(text: text))
    state targetBit: Int(0)
    if targetKind == compilerSyntaxKindConstruct() { targetBit: 1 }
    if targetKind == compilerSyntaxKindFunction() { targetBit: 2 }
    if targetKind == compilerSyntaxKindMember() { targetBit: 4 }
    if targetKind == compilerSyntaxKindParameter() { targetBit: 8 }
    if targetKind == compilerSyntaxKindEnum() { targetBit: 16 }
    if text == String("Construct") && targetKind == compilerSyntaxKindEnum() { return true }
    if knownMask > 0 { return targetBit > 0 && compilerMacroTargetMaskContains(mask: knownMask, bit: targetBit) }
    if depth >= 8 { return false }
    state matchCount: Int(0)
    state matchedRow: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroDeclarations) {
        let fileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 1))
        let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 4), localEnd: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 5)))
        if compilerMacroNominalNameMatches(nominalName: text, declarationName: declarationName) {
            matchCount: matchCount + 1
            matchedRow: row
        }
        row: row + 1
    }
    return matchCount == 1 && compilerMacroTargetDeclarationAccepts(tables: tables, declarationRow: matchedRow, targetKind: targetKind, depth: depth + 1)
}

function compilerMacroTargetTextAccepts(tables: CompilerSyntaxTables, text: String, targetKind: Int, depth: Int): Bool {
    let maybeFirst: Optional<RangeLexedToken>(lexNextRangeToken(source: text, start: 0))
    if maybeFirst == nil { return false }
    let first: RangeLexedToken(maybeFirst ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $text, index: 0)))
    state result: Bool(compilerMacroTargetAtomAccepts(tables: tables, text: first.text, targetKind: targetKind, depth: depth))
    state cursor: Int(first.end)
    state genericDepth: Int(0)
    while cursor < stringLength(value: text) {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: text, start: cursor))
        if maybeToken == nil { return result }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $text, index: cursor)))
        if token.kind == .less { genericDepth: genericDepth + 1 }
        if token.kind == .greater && genericDepth > 0 { genericDepth: genericDepth - 1 }
        if genericDepth == 0 && (token.kind == .ampersand || token.kind == .pipe) {
            let maybeAtom: Optional<RangeLexedToken>(lexNextRangeToken(source: text, start: token.end))
            if maybeAtom == nil { return false }
            let atom: RangeLexedToken(maybeAtom ?? compilerFallbackToken(cursor: CompilerTokenCursor(source: $text, index: token.end)))
            let atomAccepts: Bool(compilerMacroTargetAtomAccepts(tables: tables, text: atom.text, targetKind: targetKind, depth: depth))
            if token.kind == .ampersand { result: result && atomAccepts } else { result: result || atomAccepts }
            cursor: atom.end
        } else {
            cursor: token.end
        }
    }
    return result
}

function compilerMacroIdentityForDeclaration(tables: CompilerSyntaxTables, fileID: Int, name: String, authoredStartLocal: Int, authoredEndLocal: Int, targetStartLocal: Int, targetEndLocal: Int, visibility: Int, ordinal: Int): CompilerFingerprint {
    state result: CompilerFingerprint(compilerSyntaxDeclarationBaseFingerprint(tables: tables, fileID: fileID, kindTag: 1000, name: name))
    result: compilerFingerprintAppendInt(fingerprint: result, value: visibility)
    result: compilerFingerprintAppendInt(fingerprint: result, value: ordinal)
    result: compilerFingerprintAppendInt(fingerprint: result, value: authoredStartLocal)
    result: compilerFingerprintAppendInt(fingerprint: result, value: authoredEndLocal)
    if targetStartLocal < 0 && targetEndLocal < 0 {
        return compilerFingerprintAppendInt(fingerprint: result, value: compilerMacroTargetKindMissing())
    }
    let targetStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: targetStartLocal))
    let targetEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: targetEndLocal))
    return compilerFingerprintAppendRange(fingerprint: result, tag: 1001, source: tables.sourceStore.source, start: targetStart, end: targetEnd)
}

function compilerMacroIdentityForApplication(tables: CompilerSyntaxTables, fileID: Int, nameStartLocal: Int, nameEndLocal: Int, authoredStartLocal: Int, authoredEndLocal: Int, targetKind: Int, ordinal: Int): CompilerFingerprint {
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStartLocal, localEnd: nameEndLocal))
    state result: CompilerFingerprint(compilerSyntaxDeclarationBaseFingerprint(tables: tables, fileID: fileID, kindTag: 1001, name: name))
    result: compilerFingerprintAppendInt(fingerprint: result, value: ordinal)
    result: compilerFingerprintAppendInt(fingerprint: result, value: authoredStartLocal)
    result: compilerFingerprintAppendInt(fingerprint: result, value: authoredEndLocal)
    return compilerFingerprintAppendInt(fingerprint: result, value: targetKind)
}

function compilerMacroCapabilityFingerprint(tables: CompilerSyntaxTables, fileID: Int, nameStart: Int, nameEnd: Int, capabilityKind: Int, capabilitySetID: Int): CompilerFingerprint {
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStart, localEnd: nameEnd))
    state result: CompilerFingerprint(compilerSyntaxDeclarationBaseFingerprint(tables: tables, fileID: fileID, kindTag: 1100 + capabilityKind, name: name))
    result: compilerFingerprintAppendInt(fingerprint: result, value: capabilitySetID)
    return compilerFingerprintAppendRange(fingerprint: result, tag: 1101 + capabilityKind, source: tables.sourceStore.source, start: compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: nameStart), end: compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: nameEnd))
}

function compilerMacroDiagnosticAppend(tables: CompilerSyntaxTables, code: Int, fileID: Int, start: Int, end: Int, relatedKind: Int, relatedRow: Int, identity: CompilerFingerprint): Int {
    if fileID < 0 || !compilerSyntaxOptionalGlobalRangeIsValid(tables: tables, fileID: fileID, start: start, end: end) {
