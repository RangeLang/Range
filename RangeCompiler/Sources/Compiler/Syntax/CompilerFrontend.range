            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 8), end: compilerIntTableValue(table: delta.generatedMembers, row: row, column: 9), optional: false)
            || macroDeclarationRow < 0 || macroDeclarationRow >= compilerIntTableRowCount(table: tables.macroDeclarations)
            || compilerIntTableValue(table: delta.generatedMembers, row: row, column: 11) < 0 || compilerIntTableValue(table: delta.generatedMembers, row: row, column: 11) >= compilerIntTableRowCount(table: tables.macroApplications)
            || templateOrdinal < 0
