                        if parameterEnd < token.end {
                            valid: false
                        } else {
                            let authored: String(stringSubstring(source: source, start: token.start, end: parameterEnd))
                            let parameterFingerprint: CompilerFingerprint(compilerTypedFingerprintAppendNamedType(fingerprint: baseFingerprint, tag: 60, ordinal: ordinal, name: token.text, typeName: authored))
                            if compilerSyntaxAppendGenericParameter(tables: tables, ownerSyntaxID: ownerSyntaxID, ownerKind: ownerKind, ordinal: ordinal, fileID: fileID, start: token.start, end: parameterEnd, nameStart: token.start, nameEnd: token.end, kind: compilerSyntaxGenericParameterTypeKind(), fingerprint: parameterFingerprint) != 0 {
                                valid: false
                            } else {
