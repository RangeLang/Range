function compilerTypedSyntaxGenericValueParameterEnd(source: String, typeEnd: Int, genericEnd: Int): Int {
    let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: typeEnd))
    if maybeToken == nil { return typeEnd }
    let token: RangeLexedToken(maybeToken ?? compilerFallbackTokenAt(index: typeEnd))
    if token.kind != .equal { return typeEnd }
    state cursor: Int(token.end)
    state parameterEnd: Int(token.end)
    while cursor < genericEnd {
        let maybeDefaultToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: cursor))
        if maybeDefaultToken == nil { return 0 - 1 }
        let defaultToken: RangeLexedToken(maybeDefaultToken ?? compilerFallbackTokenAt(index: cursor))
        if defaultToken.kind == .comma || defaultToken.kind == .greater { return parameterEnd }
        parameterEnd: defaultToken.end
        cursor: defaultToken.end
    }
    return 0 - 1
}

function compilerTypedSyntaxCaptureGenericParameters(source: String, tables: CompilerSyntaxTables, fileID: Int, ownerSyntaxID: Int, ownerKind: Int, genericRange: CompilerSourceRange, baseFingerprint: CompilerFingerprint): CompilerGenericParameterCapture {
    if genericRange.start < 0 && genericRange.end < 0 {
        return CompilerGenericParameterCapture(count: 0, fingerprint: baseFingerprint, isValid: true)
    }
    let maybeLeft: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: genericRange.start))
    if maybeLeft == nil { return CompilerGenericParameterCapture(count: 0, fingerprint: baseFingerprint, isValid: false) }
    let left: RangeLexedToken(maybeLeft ?? compilerFallbackTokenAt(index: genericRange.start))
    if left.kind != .less || left.start != genericRange.start { return CompilerGenericParameterCapture(count: 0, fingerprint: baseFingerprint, isValid: false) }
    state cursor: Int(left.end)
    state ordinal: Int(0)
    state fingerprint: CompilerFingerprint(baseFingerprint)
    state valid: Bool(true)
    state expectingName: Bool(true)
    while valid && cursor < genericRange.end {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: source, start: cursor))
