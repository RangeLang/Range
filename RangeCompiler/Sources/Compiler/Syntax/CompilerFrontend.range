            return CompilerTypedMemberCapture(count: memberOrdinal, fingerprint: declarationFingerprint)
        }
        declarationFingerprint: compilerFingerprintAppendText(fingerprint: declarationFingerprint, tag: 40 + functionOrdinal, text: compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: token.start), localEnd: compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: functionStep.nextIndex)))
        functionOrdinal: functionOrdinal + 1
        cursor: CompilerTokenCursor(source: $source, index: functionStep.nextIndex)
        } else if !macroAttributeHandled {
        let step: CompilerStoredMemberParseStep(compilerCoreParseStoredMemberToken(source: source, end: end, token: token))
        if !step.keepScanning || !step.found {
            compilerSyntaxTablesPoison(tables: tables)
            return CompilerTypedMemberCapture(count: memberOrdinal, fingerprint: declarationFingerprint)
        }
        state memberEnd: Int(step.typeReference.end)
        state valueStart: Int(0 - 1)
        state valueEnd: Int(0 - 1)
        if (step.kindTag == compilerSyntaxMemberKindLet() || step.kindTag == compilerSyntaxMemberKindState())
            && step.nextIndex > step.typeReference.end {
            memberEnd: step.nextIndex
            valueStart: step.typeReference.start
            valueEnd: step.nextIndex
        }
        if !compilerSyntaxMemberRangesAreValid(tables: tables, fileID: fileID, memberStart: token.start, memberEnd: memberEnd, nameStart: step.nameToken.start, nameEnd: step.nameToken.end, typeStart: step.typeReference.start, typeEnd: step.typeReference.end) {
            compilerSyntaxTablesPoison(tables: tables)
            return CompilerTypedMemberCapture(count: memberOrdinal, fingerprint: declarationFingerprint)
        }

        let memberFingerprintBase: CompilerFingerprint(compilerTypedFingerprintAppendNamedType(fingerprint: baseFingerprint, tag: 10, ordinal: memberOrdinal, name: step.nameToken.text, typeName: step.typeReference.text))
        state memberFingerprint: CompilerFingerprint(compilerFingerprintAppendInt(fingerprint: memberFingerprintBase, value: step.kindTag))
        state nextDeclarationFingerprint: CompilerFingerprint(compilerFingerprintAppendInt(fingerprint: compilerTypedFingerprintAppendNamedType(fingerprint: declarationFingerprint, tag: 10, ordinal: memberOrdinal, name: step.nameToken.text, typeName: step.typeReference.text), value: step.kindTag))
        if valueStart >= 0 {
            memberFingerprint: compilerFingerprintAppendRange(fingerprint: memberFingerprint, tag: 11, source: source, start: valueStart, end: valueEnd)
            nextDeclarationFingerprint: compilerFingerprintAppendRange(fingerprint: nextDeclarationFingerprint, tag: 11, source: source, start: valueStart, end: valueEnd)
        }
        declarationFingerprint: nextDeclarationFingerprint
        let memberRow: Int(compilerIntTableRowCount(table: tables.members))
        let memberSyntaxID: Int(compilerSyntaxAllocate(tables: tables, kindTag: compilerSyntaxKindMember(), facetRow: memberRow))
        if compilerSyntaxAppendMember(tables: tables, syntaxID: memberSyntaxID, fileID: fileID, parentSyntaxID: parentSyntaxID, ordinal: memberOrdinal, memberStart: token.start, memberEnd: memberEnd, nameStart: step.nameToken.start, nameEnd: step.nameToken.end, typeStart: step.typeReference.start, typeEnd: step.typeReference.end, valueStart: valueStart, valueEnd: valueEnd, fingerprint: memberFingerprint, memberKind: step.kindTag) != 0 {
            compilerSyntaxTablesPoison(tables: tables)
            return CompilerTypedMemberCapture(count: memberOrdinal, fingerprint: declarationFingerprint)
        }
        if step.kindTag == compilerSyntaxMemberKindDerived() && step.nextIndex > step.typeReference.end {
            if compilerTypedSyntaxCaptureDerivedFunction(source: source, tables: tables, fileID: fileID, parentSyntaxID: parentSyntaxID, keyword: token, step: step, captureBody: captureBodies) != 0 {
                compilerSyntaxTablesPoison(tables: tables)
                return CompilerTypedMemberCapture(count: memberOrdinal, fingerprint: declarationFingerprint)
            }
            functionOrdinal: functionOrdinal + 1
        }
        memberOrdinal: memberOrdinal + 1
        cursor: CompilerTokenCursor(source: $source, index: step.nextIndex)
        }
    }
    return CompilerTypedMemberCapture(count: memberOrdinal, fingerprint: declarationFingerprint)
}

function compilerTypedSyntaxCaptureFunction(source: String, tables: CompilerSyntaxTables, declarationOrdinal: Int, keyword: RangeLexedToken): CompilerTypedDeclarationCaptureStep {
    return compilerTypedSyntaxCaptureFunctionWithPolicy(source: source, tables: tables, declarationOrdinal: declarationOrdinal, parentSyntaxID: 0 - 1, keyword: keyword, captureBody: true, builtinPolicy: compilerBuiltinPolicyNone(), fileEnd: stringLength(value: source))
}

function compilerCoreParseBuiltinFunctionDeclarationParts(source: String, keyword: RangeLexedToken, fileEnd: Int): Optional<CompilerFunctionDeclarationParts> {
    let maybeName: Optional<RangeLexedToken>(compilerCoreParseFunctionNameAfterKeyword(source: source, keyword: keyword))
    if maybeName == nil { return nil }
    let fallbackCursor: CompilerTokenCursor(source: $source, index: keyword.end)
    let nameToken: RangeLexedToken(maybeName ?? compilerFallbackToken(cursor: fallbackCursor))
    state genericRange: CompilerSourceRange(start: compilerMacroInvalidOffset(), end: compilerMacroInvalidOffset(), next: nameToken.end)
    let maybeGeneric: Optional<CompilerSourceRange>(compilerCoreParseAngleRangeAfterName(source: source, nameToken: nameToken))
    if maybeGeneric != nil {
        genericRange: maybeGeneric ?? CompilerSourceRange(start: nameToken.end, end: nameToken.end, next: nameToken.end)
    }
    let parameterCursor: CompilerTokenCursor(source: $source, index: genericRange.next)
    let maybeParameters: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: parameterCursor, leftKind: .leftParen, rightKind: .rightParen))
    if maybeParameters == nil { return nil }
    let parameterRange: CompilerSourceRange(maybeParameters ?? CompilerSourceRange(start: genericRange.next, end: genericRange.next, next: genericRange.next))
    let maybeReturnType: Optional<CompilerTypeReference>(compilerCoreParseReturnTypeAfterParametersWithEnd(source: source, parameterRange: parameterRange, fileEnd: fileEnd))
    if maybeReturnType == nil { return nil }
    let returnType: CompilerTypeReference(maybeReturnType ?? CompilerTypeReference(text: String(""), start: parameterRange.next, end: parameterRange.next))
    let emptyBody: CompilerSourceRange(start: returnType.end, end: returnType.end, next: returnType.end)
    return CompilerFunctionDeclarationParts(nameToken: nameToken, genericRange: genericRange, parameterRange: parameterRange, returnType: returnType, bodyRange: emptyBody)
}

function compilerTypedSyntaxCaptureFunctionWithPolicy(source: String, tables: CompilerSyntaxTables, declarationOrdinal: Int, parentSyntaxID: Int, keyword: RangeLexedToken, captureBody: Bool, builtinPolicy: Int, fileEnd: Int): CompilerTypedDeclarationCaptureStep {
    let keywordStart: Int(keyword.start)
    let keywordEnd: Int(keyword.end)
    state maybeParts: Optional<CompilerFunctionDeclarationParts>(compilerCoreParseFunctionDeclarationPartsWithEnd(source: source, keyword: keyword, fileEnd: fileEnd))
    if builtinPolicy != compilerBuiltinPolicyNone() { maybeParts: compilerCoreParseBuiltinFunctionDeclarationParts(source: source, keyword: keyword, fileEnd: fileEnd) }
    if maybeParts == nil {
        compilerSyntaxTablesPoison(tables: tables)
        return CompilerTypedDeclarationCaptureStep(captured: false, nextIndex: keywordEnd)
    }

    let fallbackRange: CompilerSourceRange(start: keywordEnd, end: keywordEnd, next: keywordEnd)
    let parts: CompilerFunctionDeclarationParts(maybeParts ?? CompilerFunctionDeclarationParts(nameToken: compilerFallbackTokenAt(index: keywordEnd), genericRange: fallbackRange, parameterRange: fallbackRange, returnType: CompilerTypeReference(text: String(""), start: keywordEnd, end: keywordEnd), bodyRange: fallbackRange))
    let fileID: Int(compilerSourceStoreFileIDAtGlobalOffset(store: tables.sourceStore, globalOffset: keywordStart))
    let fileRole: Int(compilerSourceStoreFileRole(store: tables.sourceStore, fileID: fileID))
    if (parentSyntaxID < 0 && builtinPolicy == compilerBuiltinPolicyNone() && parts.bodyRange.next == parts.bodyRange.end && fileRole != compilerSourceRoleCore())
        || !compilerSyntaxDeclarationRangesAreValid(tables: tables, fileID: fileID, declarationStart: keywordStart, declarationEnd: parts.bodyRange.next, nameStart: parts.nameToken.start, nameEnd: parts.nameToken.end, bodyStart: parts.bodyRange.start, bodyEnd: parts.bodyRange.end)
        || !compilerSyntaxDeclarationGenericRangeIsValid(tables: tables, fileID: fileID, nameEnd: parts.nameToken.end, genericRange: parts.genericRange, bodyStart: parts.parameterRange.start)
        || !compilerSyntaxFunctionRangesAreValid(tables: tables, fileID: fileID, parameterStart: parts.parameterRange.start, parameterEnd: parts.parameterRange.end, returnTypeStart: parts.returnType.start, returnTypeEnd: parts.returnType.end, bodyStart: parts.bodyRange.start, bodyEnd: parts.bodyRange.end) {
        compilerSyntaxTablesPoison(tables: tables)
        return CompilerTypedDeclarationCaptureStep(captured: true, nextIndex: parts.bodyRange.next)
    }

    let functionRow: Int(compilerIntTableRowCount(table: tables.functions))
    let syntaxID: Int(compilerSyntaxAllocate(tables: tables, kindTag: compilerSyntaxKindFunction(), facetRow: functionRow))
    let declarationTableOrdinal: Int(compilerIntTableRowCount(table: tables.declarations))
    state signature: CompilerFingerprint(compilerSyntaxDeclarationBaseFingerprint(tables: tables, fileID: fileID, kindTag: compilerSyntaxKindFunction(), name: parts.nameToken.text))
    if parentSyntaxID >= 0 { signature: compilerFingerprintAppendInt(fingerprint: signature, value: parentSyntaxID) }
    let genericCapture: CompilerGenericParameterCapture(compilerTypedSyntaxCaptureGenericParameters(source: source, tables: tables, fileID: fileID, ownerSyntaxID: syntaxID, ownerKind: compilerSyntaxKindFunction(), genericRange: parts.genericRange, baseFingerprint: signature))
    if !genericCapture.isValid { return CompilerTypedDeclarationCaptureStep(captured: true, nextIndex: parts.bodyRange.next) }
    signature: genericCapture.fingerprint
    let firstParameterRow: Int(compilerIntTableRowCount(table: tables.parameters))
    let parameterCapture: CompilerTypedParameterCapture(compilerTypedSyntaxCaptureParameters(source: source, tables: tables, fileID: fileID, functionID: functionRow, start: parts.parameterRange.start, end: parts.parameterRange.end, baseFingerprint: signature))
    signature: compilerFingerprintAppendInt(fingerprint: parameterCapture.fingerprint, value: parameterCapture.count)
    signature: compilerFingerprintAppendText(fingerprint: signature, tag: 30, text: parts.returnType.text)
    if builtinPolicy != compilerBuiltinPolicyNone() { signature: compilerFingerprintAppendInt(fingerprint: signature, value: builtinPolicy) }
    if compilerSyntaxAppendFunction(tables: tables, syntaxID: syntaxID, fileID: fileID, firstParameterRow: firstParameterRow, parameterCount: parameterCapture.count, parameterStart: parts.parameterRange.start, parameterEnd: parts.parameterRange.end, returnTypeStart: parts.returnType.start, returnTypeEnd: parts.returnType.end, bodyStart: parts.bodyRange.start, bodyEnd: parts.bodyRange.end, signature: signature, isDerived: false) != 0
        || compilerSyntaxAppendFunctionOwner(tables: tables, ownerSyntaxID: parentSyntaxID) != 0
        || compilerSyntaxAppendDeclaration(tables: tables, syntaxID: syntaxID, fileID: fileID, kindTag: compilerSyntaxKindFunction(), parentSyntaxID: parentSyntaxID, ordinal: declarationTableOrdinal, declarationStart: keywordStart, declarationEnd: parts.bodyRange.next, nameStart: parts.nameToken.start, nameEnd: parts.nameToken.end, bodyStart: parts.bodyRange.start, bodyEnd: parts.bodyRange.end, fingerprint: signature, builtinPolicy: builtinPolicy) != 0 {
        compilerSyntaxTablesPoison(tables: tables)
        return CompilerTypedDeclarationCaptureStep(captured: true, nextIndex: parts.bodyRange.next)
    }
    if captureBody && builtinPolicy == compilerBuiltinPolicyNone() {
        if compilerTypedSyntaxCaptureBody(source: source, tables: tables, fileID: fileID, ownerSyntaxID: syntaxID, start: parts.bodyRange.start, end: parts.bodyRange.end) != 0 {
            compilerSyntaxTablesPoison(tables: tables)
        }
    }
    return CompilerTypedDeclarationCaptureStep(captured: true, nextIndex: parts.bodyRange.next)
}

function compilerTypedSyntaxCaptureParameters(source: String, tables: CompilerSyntaxTables, fileID: Int, functionID: Int, start: Int, end: Int, baseFingerprint: CompilerFingerprint): CompilerTypedParameterCapture {
    state cursor: CompilerTokenCursor(source: $source, index: start)
    state parameterOrdinal: Int(0)
    state signature: CompilerFingerprint(baseFingerprint)
    while cursor.index < end {
        let maybeToken: Optional<RangeLexedToken>(compilerCursorPeek(cursor: cursor))
        if maybeToken == nil {
            compilerSyntaxTablesPoison(tables: tables)
            return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
        }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackToken(cursor: cursor))
        if token.start >= end {
            return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
        }
        let macroAttributeHandled: Bool(compilerCoreTokenKindEquals(token: token, kind: .macroAttribute))
        if macroAttributeHandled {
            if token.text != String("@builtin") && token.text != String("@main") {
                let nextIndex: Int(compilerTypedSyntaxCaptureMacroApplication(source: source, tables: tables, macroToken: token))
                cursor: CompilerTokenCursor(source: $source, index: nextIndex)
            } else {
                cursor: CompilerTokenCursor(source: $source, index: token.end)
            }
        }
        if !macroAttributeHandled {
        let step: CompilerFunctionParameterTokenStep(compilerCoreParseFunctionParameterToken(source: source, end: end, token: token))
        if !step.keepScanning {
            compilerSyntaxTablesPoison(tables: tables)
            return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
        }
        if !step.found {
            if token.kind != .comma {
                compilerSyntaxTablesPoison(tables: tables)
                return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
            }
            cursor: CompilerTokenCursor(source: $source, index: step.nextIndex)
        } else {
            if !compilerSyntaxParameterRangesAreValid(tables: tables, fileID: fileID, parameterStart: token.start, parameterEnd: step.typeReference.end, nameStart: step.nameToken.start, nameEnd: step.nameToken.end, typeStart: step.typeReference.start, typeEnd: step.typeReference.end) {
                compilerSyntaxTablesPoison(tables: tables)
                return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
            }
            let parameterFingerprint: CompilerFingerprint(compilerTypedFingerprintAppendNamedType(fingerprint: baseFingerprint, tag: 20, ordinal: parameterOrdinal, name: step.nameToken.text, typeName: step.typeReference.text))
            signature: compilerTypedFingerprintAppendNamedType(fingerprint: signature, tag: 20, ordinal: parameterOrdinal, name: step.nameToken.text, typeName: step.typeReference.text)
            let parameterRow: Int(compilerIntTableRowCount(table: tables.parameters))
            let parameterSyntaxID: Int(compilerSyntaxAllocate(tables: tables, kindTag: compilerSyntaxKindParameter(), facetRow: parameterRow))
            if compilerSyntaxAppendParameter(tables: tables, syntaxID: parameterSyntaxID, fileID: fileID, functionID: functionID, ordinal: parameterOrdinal, parameterStart: token.start, parameterEnd: step.typeReference.end, nameStart: step.nameToken.start, nameEnd: step.nameToken.end, typeStart: step.typeReference.start, typeEnd: step.typeReference.end, fingerprint: parameterFingerprint) != 0 {
                compilerSyntaxTablesPoison(tables: tables)
                return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
            }
            parameterOrdinal: parameterOrdinal + 1
            cursor: CompilerTokenCursor(source: $source, index: step.nextIndex)
        }
        }
    }
    return CompilerTypedParameterCapture(count: parameterOrdinal, fingerprint: signature)
}

function compilerSyntaxDeclarationRowForSyntaxID(tables: CompilerSyntaxTables, syntaxID: Int): Int {
    state row: Int(0)
    let rowCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while row < rowCount {
        if compilerIntTableValue(table: tables.declarations, row: row, column: 0) == syntaxID {
            return row
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerSyntaxPriorChildCount(table: CompilerIntTable, row: Int, parentColumn: Int, parentSyntaxID: Int): Int {
    state priorRow: Int(0)
    state count: Int(0)
    while priorRow < row {
        if compilerIntTableValue(table: table, row: priorRow, column: parentColumn) == parentSyntaxID {
            count: count + 1
        }
        priorRow: priorRow + 1
    }
    return count
}

function compilerSyntaxFacetIsValid(tables: CompilerSyntaxTables, syntaxID: Int): Bool {
    let kindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0))
    let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
    if facetRow < 0 {
        return false
    }
    if kindTag == compilerSyntaxKindConstruct() || kindTag == compilerSyntaxKindEnum() {
        return facetRow < compilerIntTableRowCount(table: tables.declarations)
            && compilerIntTableValue(table: tables.declarations, row: facetRow, column: 0) == syntaxID
            && compilerIntTableValue(table: tables.declarations, row: facetRow, column: 2) == kindTag
    }
    if kindTag == compilerSyntaxKindFunction() {
        return facetRow < compilerIntTableRowCount(table: tables.functions)
            && compilerIntTableValue(table: tables.functions, row: facetRow, column: 0) == syntaxID
    }
    if kindTag == compilerSyntaxKindMember() {
        return facetRow < compilerIntTableRowCount(table: tables.members)
            && compilerIntTableValue(table: tables.members, row: facetRow, column: 0) == syntaxID
    }
    if kindTag == compilerSyntaxKindParameter() {
        return facetRow < compilerIntTableRowCount(table: tables.parameters)
            && compilerIntTableValue(table: tables.parameters, row: facetRow, column: 0) == syntaxID
    }
    if kindTag >= compilerSyntaxKindEntry() && kindTag <= compilerSyntaxKindLastBody() {
        return facetRow < compilerIntTableRowCount(table: tables.bodyNodes)
            && compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 0) == syntaxID
    }
    return false
}

function compilerSyntaxStructuralDeclarationFailure(tables: CompilerSyntaxTables, row: Int): Bool {
    state fileID: Int(0 - 1)
    state start: Int(0 - 1)
    state end: Int(0 - 1)
    if row >= 0 && row < compilerIntTableRowCount(table: tables.declarations) {
        fileID: compilerIntTableValue(table: tables.declarations, row: row, column: 1)
        start: compilerIntTableValue(table: tables.declarations, row: row, column: 5)
        end: compilerIntTableValue(table: tables.declarations, row: row, column: 6)
    }
    compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: compilerSyntaxFailureReasonInvalidTableStructure(), fileID: fileID, start: start, end: end, relatedRow: row)
    return false
}

function compilerSyntaxDeclarationsAreValid(tables: CompilerSyntaxTables): Bool {
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    state row: Int(0)
    while row < declarationCount {
        let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 0))
        let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
        let kindTag: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 2))
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 3))
        let ordinal: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 4))
        state parentIsValid: Bool(parentSyntaxID == 0 - 1)
        if parentSyntaxID >= 0 && parentSyntaxID < syntaxCount {
            parentIsValid: compilerIntTableValue(table: tables.syntaxIndex, row: parentSyntaxID, column: 0) == compilerSyntaxKindConstruct()
        }
        if syntaxID < 0 || syntaxID >= syntaxCount || fileID < 0 || fileID >= fileCount || !parentIsValid || ordinal != row {
            return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: row)
        }
        if kindTag != compilerSyntaxKindConstruct() && kindTag != compilerSyntaxKindFunction() && kindTag != compilerSyntaxKindEnum() {
            return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: row)
        }
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) != kindTag {
            return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: row)
        }
        if parentSyntaxID >= 0 {
            let parentDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: parentSyntaxID))
            if parentDeclarationRow < 0
                || (kindTag != compilerSyntaxKindFunction() && compilerIntTableValue(table: tables.declarations, row: parentDeclarationRow, column: 1) != fileID) { return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: row) }
        }
        let declarationBuiltinPolicy: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 13))
        if declarationBuiltinPolicy < compilerBuiltinPolicyNone() || declarationBuiltinPolicy > compilerBuiltinPolicyTarget()
            || (kindTag == compilerSyntaxKindConstruct()
                && declarationBuiltinPolicy != compilerBuiltinPolicyNone()
                && declarationBuiltinPolicy != compilerBuiltinPolicyRuntime()
                && declarationBuiltinPolicy != compilerBuiltinPolicyStorage())
            || (kindTag == compilerSyntaxKindEnum()
                && declarationBuiltinPolicy != compilerBuiltinPolicyNone()
                && declarationBuiltinPolicy != compilerBuiltinPolicyRuntime())
                || (kindTag == compilerSyntaxKindFunction() && declarationBuiltinPolicy == compilerBuiltinPolicyStorage()) { return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: row) }
        state previousRow: Int(0)
        while previousRow < row {
            state sameFirst: Bool(false)
            sameFirst: compilerIntTableValue(table: tables.declarations, row: previousRow, column: 11) == compilerIntTableValue(table: tables.declarations, row: row, column: 11)
            state sameSecond: Bool(false)
            sameSecond: compilerIntTableValue(table: tables.declarations, row: previousRow, column: 12) == compilerIntTableValue(table: tables.declarations, row: row, column: 12)
            if sameFirst && sameSecond {
                return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: row)
            }
            previousRow: previousRow + 1
        }
        row: row + 1
    }

    state candidateSyntaxID: Int(0)
    while candidateSyntaxID < syntaxCount {
        let candidateKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: candidateSyntaxID, column: 0))
        if candidateKindTag == compilerSyntaxKindConstruct() || candidateKindTag == compilerSyntaxKindFunction() || candidateKindTag == compilerSyntaxKindEnum() {
            state declarationMatches: Int(0)
            state declarationRow: Int(0)
            while declarationRow < declarationCount {
                if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0) == candidateSyntaxID {
                    declarationMatches: declarationMatches + 1
                }
                declarationRow: declarationRow + 1
            }
            if declarationMatches != 1 {
                return compilerSyntaxStructuralDeclarationFailure(tables: tables, row: 0 - 1)
            }
        }
        candidateSyntaxID: candidateSyntaxID + 1
    }
    return true
}

function compilerSyntaxMembersAreValid(tables: CompilerSyntaxTables): Bool {
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    let memberCount: Int(compilerIntTableRowCount(table: tables.members))
    state row: Int(0)
    while row < memberCount {
        let syntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 0))
        let fileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 2))
        let ordinal: Int(compilerIntTableValue(table: tables.members, row: row, column: 3))
        let memberKind: Int(compilerIntTableValue(table: tables.members, row: row, column: 12))
        let storagePolicy: Int(compilerIntTableValue(table: tables.members, row: row, column: 13))
        let typeTargetKind: Int(compilerIntTableValue(table: tables.members, row: row, column: 14))
        let typeTargetID: Int(compilerIntTableValue(table: tables.members, row: row, column: 15))
        let valueStart: Int(compilerIntTableValue(table: tables.members, row: row, column: compilerSyntaxMemberValueStartColumn()))
        let valueEnd: Int(compilerIntTableValue(table: tables.members, row: row, column: compilerSyntaxMemberValueEndColumn()))
        let hasValue: Bool(valueStart >= 0 || valueEnd >= 0)
        if syntaxID < 0 || syntaxID >= syntaxCount || fileID < 0 || fileID >= fileCount || parentSyntaxID < 0 || parentSyntaxID >= syntaxCount
            || (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState() && memberKind != compilerSyntaxMemberKindBinding() && memberKind != compilerSyntaxMemberKindEnumCase() && memberKind != compilerSyntaxMemberKindEnumCasePayload() && memberKind != compilerSyntaxMemberKindDerived()) {
            return false
        }
        let parentKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: parentSyntaxID, column: 0))
        state payloadParentIsCase: Bool(false)
        if memberKind == compilerSyntaxMemberKindEnumCasePayload() && parentKind == compilerSyntaxKindMember() {
            let parentMemberRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: parentSyntaxID, column: 1))
            payloadParentIsCase: parentMemberRow >= 0
                && parentMemberRow < memberCount
                && compilerIntTableValue(table: tables.members, row: parentMemberRow, column: 12) == compilerSyntaxMemberKindEnumCase()
                && compilerIntTableValue(table: tables.members, row: parentMemberRow, column: 1) == fileID
        }
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) != compilerSyntaxKindMember()
            || (memberKind == compilerSyntaxMemberKindEnumCase() && parentKind != compilerSyntaxKindEnum())
            || (memberKind == compilerSyntaxMemberKindEnumCasePayload() && !payloadParentIsCase)
            || (memberKind != compilerSyntaxMemberKindEnumCase() && memberKind != compilerSyntaxMemberKindEnumCasePayload() && parentKind != compilerSyntaxKindConstruct())
            || (memberKind == compilerSyntaxMemberKindEnumCasePayload() && (storagePolicy < compilerSyntaxMemberStorageDirect() || storagePolicy > compilerSyntaxMemberStorageIndirect()))
            || (memberKind != compilerSyntaxMemberKindEnumCasePayload() && storagePolicy != compilerSyntaxMemberStorageNone())
            || (compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: row) && typeTargetKind != compilerSyntaxTypeTargetReference())
            || (compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: row) && typeTargetID < 0)
            || (!compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: row) && (typeTargetKind != compilerSyntaxTypeTargetNone() || typeTargetID != 0 - 1))
            || (memberKind == compilerSyntaxMemberKindEnumCasePayload() && compilerIntTableValue(table: tables.members, row: row, column: 9) <= compilerIntTableValue(table: tables.members, row: row, column: 8))
            || (memberKind == compilerSyntaxMemberKindEnumCase() && compilerIntTableValue(table: tables.members, row: row, column: 9) != compilerIntTableValue(table: tables.members, row: row, column: 8))
            || (hasValue && (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState()))
            || (hasValue && (valueStart < compilerIntTableValue(table: tables.members, row: row, column: 8)
                || valueEnd <= valueStart
                || valueEnd > compilerIntTableValue(table: tables.members, row: row, column: 5)))
            || (!hasValue && (valueStart != 0 - 1 || valueEnd != 0 - 1))
            || ordinal != compilerSyntaxPriorChildCount(table: tables.members, row: row, parentColumn: 2, parentSyntaxID: parentSyntaxID) {
            return false
        }
        state declarationParentSyntaxID: Int(parentSyntaxID)
        if memberKind == compilerSyntaxMemberKindEnumCasePayload() {
            let parentMemberRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: parentSyntaxID, column: 1))
            declarationParentSyntaxID: compilerIntTableValue(table: tables.members, row: parentMemberRow, column: 2)
        }
        let parentDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: declarationParentSyntaxID))
        if parentDeclarationRow < 0 || compilerIntTableValue(table: tables.declarations, row: parentDeclarationRow, column: 1) != fileID {
            return false
        }
        row: row + 1
    }
    return true
}

function compilerSyntaxBuiltinTypeIDForName(name: String): Int {
    if name == String("Int") { return compilerSyntaxBuiltinTypeInt() }
    if name == String("Bool") { return compilerSyntaxBuiltinTypeBool() }
    if name == String("String") { return compilerSyntaxBuiltinTypeString() }
    if name == String("Float") { return compilerSyntaxBuiltinTypeFloat() }
    return 0 - 1
}

function compilerSyntaxDeclarationMatchCountForTypeNameInParent(tables: CompilerSyntaxTables, typeName: String, parentSyntaxID: Int): Int {
    state matchCount: Int(0)
    state declarationRow: Int(0)
    while declarationRow < compilerIntTableRowCount(table: tables.declarations) {
        let declarationKind: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2))
        if (declarationKind == compilerSyntaxKindConstruct() || declarationKind == compilerSyntaxKindEnum())
            && compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 3) == parentSyntaxID {
            let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
            let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
            if declarationName == typeName { matchCount: matchCount + 1 }
        }
        declarationRow: declarationRow + 1
    }
    return matchCount
}

function compilerSyntaxDeclarationSyntaxIDForTypeNameInParent(tables: CompilerSyntaxTables, typeName: String, parentSyntaxID: Int): Int {
    state matchSyntaxID: Int(0 - 1)
    state matchCount: Int(0)
    state declarationRow: Int(0)
    while declarationRow < compilerIntTableRowCount(table: tables.declarations) {
        let declarationKind: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2))
        if (declarationKind == compilerSyntaxKindConstruct() || declarationKind == compilerSyntaxKindEnum())
            && compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 3) == parentSyntaxID {
            let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
            let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
            if declarationName == typeName {
                matchSyntaxID: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0)
                matchCount: matchCount + 1
            }
        }
        declarationRow: declarationRow + 1
    }
    if matchCount > 1 { return 0 - 2 }
    if matchCount != 1 { return 0 - 1 }
    return matchSyntaxID
}

function compilerSyntaxDeclarationParentForSyntaxID(tables: CompilerSyntaxTables, syntaxID: Int): Int {
    let row: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
    if row < 0 { return 0 - 1 }
    return compilerIntTableValue(table: tables.declarations, row: row, column: 3)
}

function compilerSyntaxDeclarationSyntaxIDForTypeNameInScope(tables: CompilerSyntaxTables, typeName: String, scopeSyntaxID: Int): Int {
    state scope: Int(scopeSyntaxID)
    state depth: Int(0)
    while scope >= 0 && depth < 32 {
        let localMatch: Int(compilerSyntaxDeclarationSyntaxIDForTypeNameInParent(tables: tables, typeName: typeName, parentSyntaxID: scope))
        if localMatch != 0 - 1 { return localMatch }
        scope: compilerSyntaxDeclarationParentForSyntaxID(tables: tables, syntaxID: scope)
        depth: depth + 1
    }
    return compilerSyntaxDeclarationSyntaxIDForTypeNameInParent(tables: tables, typeName: typeName, parentSyntaxID: 0 - 1)
}

function compilerSyntaxDeclarationSyntaxIDForTypeName(tables: CompilerSyntaxTables, typeName: String): Int {
    return compilerSyntaxDeclarationSyntaxIDForTypeNameInScope(tables: tables, typeName: typeName, scopeSyntaxID: 0 - 1)
}

function compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
    tables: CompilerSyntaxTables,
    typeName: String,
    scopeSyntaxID: Int
): Int {
    let length: Int(stringLength(value: typeName))
    state segmentStart: Int(0)
    state segmentEnd: Int(0)
    state resolvedSyntaxID: Int(0 - 1)
    state segmentOrdinal: Int(0)
    while segmentEnd <= length {
        if segmentEnd == length || stringByteAt(source: typeName, index: segmentEnd) == 46 {
            if segmentEnd <= segmentStart { return 0 - 1 }
            let segment: String(stringSubstring(source: typeName, start: segmentStart, end: segmentEnd))
            if segmentOrdinal == 0 {
                resolvedSyntaxID: compilerSyntaxDeclarationSyntaxIDForTypeNameInScope(
                    tables: tables,
                    typeName: segment,
                    scopeSyntaxID: scopeSyntaxID
                )
            } else {
                resolvedSyntaxID: compilerSyntaxDeclarationSyntaxIDForTypeNameInParent(
                    tables: tables,
                    typeName: segment,
                    parentSyntaxID: resolvedSyntaxID
                )
            }
            if resolvedSyntaxID < 0 { return resolvedSyntaxID }
            segmentOrdinal: segmentOrdinal + 1
            segmentStart: segmentEnd + 1
        }
        segmentEnd: segmentEnd + 1
    }
    return resolvedSyntaxID
}

function compilerSyntaxTypeReferenceGenericParameterForName(tables: CompilerSyntaxTables, ownerSyntaxID: Int, name: String): Int {
    state match: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.genericParameters) {
        if compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()) == ownerSyntaxID
            && compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterKindColumn()) == compilerSyntaxGenericParameterTypeKind() {
            let fileID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameStartColumn()), localEnd: compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameEndColumn())))
            if candidate == name {
                if match >= 0 { return 0 - 1 }
                match: row
            }
        }
        row: row + 1
    }
    return match
}

function compilerSyntaxGenericParameterKindForOrdinal(tables: CompilerSyntaxTables, ownerSyntaxID: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.genericParameters) {
        if compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()) == ownerSyntaxID
            && compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()) == ordinal {
            return compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterKindColumn())
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerSyntaxTypeReferenceAppend(tables: CompilerSyntaxTables, ownerMemberRow: Int, parentNodeID: Int, ordinal: Int, kind: Int, targetKind: Int, targetID: Int, childCount: Int, depth: Int, nameStart: Int, nameEnd: Int, fingerprint: CompilerFingerprint): Int {
    let nodeID: Int(compilerIntTableRowCount(table: tables.typeReferences))
    if compilerIntTableAppend(table: tables.typeReferences, value: ownerMemberRow) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: parentNodeID) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: ordinal) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: kind) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: targetKind) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: targetID) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: fingerprint.first) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: fingerprint.second) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: childCount) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: depth) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: nameStart) != 0
        || compilerIntTableAppend(table: tables.typeReferences, value: nameEnd) != 0 { return 0 - 1 }
    return nodeID
}

function compilerSyntaxTypeReferenceBuildExpected(tables: CompilerSyntaxTables, ownerMemberRow: Int, ownerSyntaxID: Int, parentNodeID: Int, ordinal: Int, typeName: String, typeRange: CompilerSourceRange, depth: Int, expectedGenericKind: Int): Int {
    let normalized: CompilerSourceRange(compilerSemanticTrimStringRange(text: typeName, start: typeRange.start, end: typeRange.end))
    if normalized.start < 0 || normalized.end <= normalized.start || depth >= 32 { return 0 - 1 }
    state kind: Int(compilerSyntaxTypeReferenceNamed())
    state targetKind: Int(compilerSyntaxTypeReferenceTargetNone())
    state targetID: Int(0 - 1)
    state childCount: Int(0)
    state childRangeStart: Int(0 - 1)
    state childRangeEnd: Int(0 - 1)
    state nameStart: Int(normalized.start)
    state nameEnd: Int(normalized.end)
    let firstByte: Int(stringByteAt(source: typeName, index: normalized.start))
    let lastByte: Int(stringByteAt(source: typeName, index: normalized.end - 1))
    let outerRange: CompilerSourceRange(compilerSemanticGenericOuterNameRangeInText(text: typeName, typeRange: normalized))
    state name: String(typeName.substring(start: normalized.start, end: normalized.end))
    state expectedValue: Bool(expectedGenericKind == compilerSyntaxGenericParameterValueKind())
    if expectedGenericKind == 0
        && (firstByte == 34 || firstByte == 39 || firstByte == 45 || firstByte == 46
            || (firstByte >= 48 && firstByte <= 57)
            || (firstByte >= 97 && firstByte <= 122)) {
        expectedValue: true
    }
    if expectedValue {
        kind: compilerSyntaxTypeReferenceValue()
    } else if lastByte == 63 {
        kind: compilerSyntaxTypeReferenceOptional()
        childCount: 1
        childRangeStart: normalized.start
        childRangeEnd: normalized.end - 1
    } else if firstByte == 91 && lastByte == 93 {
        kind: compilerSyntaxTypeReferenceArray()
        childCount: 1
        childRangeStart: normalized.start + 1
        childRangeEnd: normalized.end - 1
    } else if outerRange.start >= 0 {
        kind: compilerSyntaxTypeReferenceApplication()
        name: typeName.substring(start: outerRange.start, end: outerRange.end)
        nameStart: outerRange.start
        nameEnd: outerRange.end
        state argumentRange: CompilerSourceRange(compilerSemanticGenericArgumentRangeInText(text: typeName, typeRange: normalized, ordinal: 0))
        while argumentRange.start >= 0 {
            childCount: childCount + 1
            argumentRange: compilerSemanticGenericArgumentRangeInText(text: typeName, typeRange: normalized, ordinal: childCount)
        }
        if childCount <= 0 { return 0 - 1 }
    }
    if kind == compilerSyntaxTypeReferenceNamed() || kind == compilerSyntaxTypeReferenceApplication() {
        let builtinTypeID: Int(compilerSyntaxBuiltinTypeIDForName(name: name))
        if builtinTypeID >= 0 {
            targetKind: compilerSyntaxTypeReferenceTargetBuiltin()
            targetID: builtinTypeID
        } else {
            let declarationSyntaxID: Int(compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(tables: tables, typeName: name, scopeSyntaxID: ownerSyntaxID))
            if declarationSyntaxID >= 0 {
                targetKind: compilerSyntaxTypeReferenceTargetDeclaration()
                targetID: declarationSyntaxID
            } else if declarationSyntaxID == 0 - 2 {
                targetKind: compilerSyntaxTypeReferenceTargetAmbiguous()
            } else {
                let genericParameterRow: Int(compilerSyntaxTypeReferenceGenericParameterForName(tables: tables, ownerSyntaxID: ownerSyntaxID, name: name))
                if genericParameterRow >= 0 && kind == compilerSyntaxTypeReferenceNamed() {
                    targetKind: compilerSyntaxTypeReferenceTargetGenericParameter()
                    targetID: genericParameterRow
                } else {
                    targetKind: compilerSyntaxTypeReferenceTargetMissing()
                }
            }
        }
    } else if kind != compilerSyntaxTypeReferenceValue() {
        state wrapperName: String("Array")
        if kind == compilerSyntaxTypeReferenceOptional() { wrapperName: String("Optional") }
        let wrapperSyntaxID: Int(compilerSyntaxDeclarationSyntaxIDForTypeName(tables: tables, typeName: wrapperName))
        if wrapperSyntaxID >= 0 {
            targetKind: compilerSyntaxTypeReferenceTargetDeclaration()
            targetID: wrapperSyntaxID
        }
    }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: kind)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: targetKind)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: targetID)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: childCount)
    fingerprint: compilerFingerprintAppendText(fingerprint: fingerprint, tag: 121, text: name)
    let nodeID: Int(compilerSyntaxTypeReferenceAppend(tables: tables, ownerMemberRow: ownerMemberRow, parentNodeID: parentNodeID, ordinal: ordinal, kind: kind, targetKind: targetKind, targetID: targetID, childCount: childCount, depth: depth, nameStart: nameStart, nameEnd: nameEnd, fingerprint: fingerprint))
    if nodeID < 0 { return 0 - 1 }
    state childOrdinal: Int(0)
    while childOrdinal < childCount {
        state nestedRange: CompilerSourceRange(start: childRangeStart, end: childRangeEnd, next: childRangeEnd)
        if kind == compilerSyntaxTypeReferenceApplication() {
            nestedRange: compilerSemanticGenericArgumentRangeInText(text: typeName, typeRange: normalized, ordinal: childOrdinal)
        }
        state childExpectedKind: Int(0)
        if targetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
            childExpectedKind: compilerSyntaxGenericParameterKindForOrdinal(tables: tables, ownerSyntaxID: targetID, ordinal: childOrdinal)
        } else if targetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
            childExpectedKind: compilerSyntaxBuiltinTypeGenericParameterKind(typeID: targetID, ordinal: childOrdinal)
        }
        if childExpectedKind < 0 { return 0 - 1 }
        let childNodeID: Int(compilerSyntaxTypeReferenceBuildExpected(tables: tables, ownerMemberRow: ownerMemberRow, ownerSyntaxID: ownerSyntaxID, parentNodeID: nodeID, ordinal: childOrdinal, typeName: typeName, typeRange: nestedRange, depth: depth + 1, expectedGenericKind: childExpectedKind))
        if childNodeID < 0 { return 0 - 1 }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.typeReferences, row: childNodeID, column: compilerSyntaxTypeReferenceFingerprintFirstColumn()))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.typeReferences, row: childNodeID, column: compilerSyntaxTypeReferenceFingerprintSecondColumn()))
        childOrdinal: childOrdinal + 1
    }
    let base: Int(nodeID * compilerSyntaxTypeReferenceColumnCount())
    if tables.typeReferences.values.update(element: fingerprint.first, index: base + compilerSyntaxTypeReferenceFingerprintFirstColumn()) != 0
        || tables.typeReferences.values.update(element: fingerprint.second, index: base + compilerSyntaxTypeReferenceFingerprintSecondColumn()) != 0 { return 0 - 1 }
    return nodeID
}

function compilerSyntaxTypeReferenceBuild(tables: CompilerSyntaxTables, ownerMemberRow: Int, ownerSyntaxID: Int, parentNodeID: Int, ordinal: Int, typeName: String, typeRange: CompilerSourceRange, depth: Int): Int {
    return compilerSyntaxTypeReferenceBuildExpected(tables: tables, ownerMemberRow: ownerMemberRow, ownerSyntaxID: ownerSyntaxID, parentNodeID: parentNodeID, ordinal: ordinal, typeName: typeName, typeRange: typeRange, depth: depth, expectedGenericKind: compilerSyntaxGenericParameterTypeKind())
}

function compilerSyntaxMemberKindHasTypeReference(kind: Int): Bool {
    return kind == compilerSyntaxMemberKindLet() || kind == compilerSyntaxMemberKindState()
        || kind == compilerSyntaxMemberKindBinding() || kind == compilerSyntaxMemberKindEnumCasePayload()
}

function compilerSyntaxMemberMacroFamilyName(tables: CompilerSyntaxTables, memberRow: Int): String {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: tables.members) { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
    let localStart: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 8))
    let localEnd: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 9))
    let start: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localStart))
    let end: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localEnd))
    if start < 0 || end <= start { return String("") }
    state attributeSearchStart: Int(start)
    state closingCharacter: String("")
    if tables.sourceStore.source.character(index: start) == String("[") {
        attributeSearchStart: start + 1
        closingCharacter: String("]")
    }
    let attributeStart: Int(compilerCoreFirstNonWhitespaceIndex(source: tables.sourceStore.source, start: attributeSearchStart, end: end))
    if attributeStart >= end || tables.sourceStore.source.character(index: attributeStart) != String("@") { return String("") }
    state attributeEnd: Int(attributeStart + 1)
    while attributeEnd < end && isRangeIdentifierPart(character: tables.sourceStore.source.character(index: attributeEnd)) {
        attributeEnd: attributeEnd + 1
    }
    if attributeEnd <= attributeStart + 1 { return String("") }
    state rightStart: Int(compilerCoreFirstNonWhitespaceIndex(source: tables.sourceStore.source, start: attributeEnd, end: end))
    if rightStart < end && tables.sourceStore.source.character(index: rightStart) == String("?") {
        rightStart: compilerCoreFirstNonWhitespaceIndex(source: tables.sourceStore.source, start: rightStart + 1, end: end)
    }
    if closingCharacter == String("") {
        if rightStart != end { return String("") }
    } else if rightStart + 1 != end || tables.sourceStore.source.character(index: rightStart) != closingCharacter {
        return String("")
    }
    return tables.sourceStore.source.substring(start: attributeStart + 1, end: attributeEnd)
}

function compilerSyntaxMemberHasTypeReference(tables: CompilerSyntaxTables, memberRow: Int): Bool {
    return memberRow >= 0 && memberRow < compilerIntTableRowCount(table: tables.members)
        && compilerSyntaxMemberKindHasTypeReference(kind: compilerIntTableValue(table: tables.members, row: memberRow, column: 12))
        && compilerSyntaxMemberMacroFamilyName(tables: tables, memberRow: memberRow) == String("")
}

function compilerSyntaxMemberTypeOwnerSyntaxID(tables: CompilerSyntaxTables, memberRow: Int): Int {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: tables.members, row: memberRow, column: 12) == compilerSyntaxMemberKindEnumCasePayload() {
        return compilerSyntaxEnumPayloadOwnerSyntaxID(tables: tables, payloadRow: memberRow)
    }
    return compilerIntTableValue(table: tables.members, row: memberRow, column: 2)
}

function compilerSyntaxLinkMemberTypeTargetAtRow(tables: CompilerSyntaxTables, memberRow: Int): Int {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: tables.members)
        || !compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: memberRow)
        || compilerIntTableValue(table: tables.members, row: memberRow, column: 14) != compilerSyntaxTypeTargetNone()
        || compilerIntTableValue(table: tables.members, row: memberRow, column: 15) != 0 - 1 { return 0 - 1 }
    let fileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
    let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 9)))
    let ownerSyntaxID: Int(compilerSyntaxMemberTypeOwnerSyntaxID(tables: tables, memberRow: memberRow))
    let targetID: Int(compilerSyntaxTypeReferenceBuild(tables: tables, ownerMemberRow: memberRow, ownerSyntaxID: ownerSyntaxID, parentNodeID: 0 - 1, ordinal: 0, typeName: typeName, typeRange: CompilerSourceRange(start: 0, end: stringLength(value: typeName), next: stringLength(value: typeName)), depth: 0))
    if targetID < 0 {
        let typeStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.members, row: memberRow, column: 8)))
        let typeEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: compilerIntTableValue(table: tables.members, row: memberRow, column: 9)))
        compilerSyntaxTablesFailureAnnotateGlobal(tables: tables, phase: compilerSyntaxFailurePhaseEnumPayloadLink(), reason: compilerSyntaxFailureReasonInvalidEnumPayloadType(), fileID: fileID, start: typeStart, end: typeEnd, relatedRow: memberRow)
        return 0 - 1
    }
    let base: Int(memberRow * compilerSyntaxMemberColumnCount())
    if tables.members.values.update(element: compilerSyntaxTypeTargetReference(), index: base + 14) != 0
        || tables.members.values.update(element: targetID, index: base + 15) != 0 { return 0 - 1 }
    return 0
}

function compilerSyntaxLinkMemberTypeTargets(tables: CompilerSyntaxTables): Int {
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        if compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: memberRow) {
            if compilerSyntaxLinkMemberTypeTargetAtRow(tables: tables, memberRow: memberRow) != 0 { return 0 - 1 }
        }
        memberRow: memberRow + 1
    }
    return 0
}

function compilerSyntaxRejectMissingTypeReferences(tables: CompilerSyntaxTables): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.typeReferences) {
        let targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetKindColumn()))
        if targetKind == compilerSyntaxTypeReferenceTargetMissing() || targetKind == compilerSyntaxTypeReferenceTargetAmbiguous() {
            let ownerMemberRow: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOwnerColumn()))
            if ownerMemberRow < 0 || ownerMemberRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
            let fileID: Int(compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 1))
            let typeStart: Int(compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 8))
            let localStart: Int(typeStart + compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameStartColumn()))
            let localEnd: Int(typeStart + compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameEndColumn()))
            let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localStart))
            let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localEnd))
            compilerSyntaxTablesFailureAnnotateGlobal(tables: tables, phase: compilerSyntaxFailurePhaseEnumPayloadLink(), reason: compilerSyntaxFailureReasonInvalidEnumPayloadType(), fileID: fileID, start: globalStart, end: globalEnd, relatedRow: ownerMemberRow)
            return 0 - 1
        }
        row: row + 1
    }
    return 0
}

function compilerSyntaxEnumPayloadOwnerSyntaxID(tables: CompilerSyntaxTables, payloadRow: Int): Int {
    if payloadRow < 0 || payloadRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: tables.members, row: payloadRow, column: 12) != compilerSyntaxMemberKindEnumCasePayload() { return 0 - 1 }
    let caseSyntaxID: Int(compilerIntTableValue(table: tables.members, row: payloadRow, column: 2))
    if caseSyntaxID < 0 || caseSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return 0 - 1 }
    if compilerIntTableValue(table: tables.syntaxIndex, row: caseSyntaxID, column: 0) != compilerSyntaxKindMember() { return 0 - 1 }
    let caseRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: caseSyntaxID, column: 1))
    if caseRow < 0 || caseRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: tables.members, row: caseRow, column: 12) != compilerSyntaxMemberKindEnumCase() { return 0 - 1 }
    let ownerSyntaxID: Int(compilerIntTableValue(table: tables.members, row: caseRow, column: 2))
    if ownerSyntaxID < 0 || ownerSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return 0 - 1 }
    if compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 0) != compilerSyntaxKindEnum() { return 0 - 1 }
    return ownerSyntaxID
}

function compilerSyntaxEnumHasPayloads(tables: CompilerSyntaxTables, enumSyntaxID: Int): Bool {
    let enumDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: enumSyntaxID))
    if enumDeclarationRow < 0
        || compilerIntTableValue(table: tables.declarations, row: enumDeclarationRow, column: 2) != compilerSyntaxKindEnum() { return false }
    state payloadRow: Int(0)
    while payloadRow < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: payloadRow, column: 12) == compilerSyntaxMemberKindEnumCasePayload()
            && compilerSyntaxEnumPayloadOwnerSyntaxID(tables: tables, payloadRow: payloadRow) == enumSyntaxID { return true }
        payloadRow: payloadRow + 1
    }
    return false
}

function compilerSyntaxEnumPayloadTypesAreValid(tables: CompilerSyntaxTables): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.members) {
        if compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: row) {
            let targetKind: Int(compilerIntTableValue(table: tables.members, row: row, column: 14))
            let targetID: Int(compilerIntTableValue(table: tables.members, row: row, column: 15))
            if targetKind != compilerSyntaxTypeTargetReference() || targetID < 0
                || targetID >= compilerIntTableRowCount(table: tables.typeReferences)
                || compilerIntTableValue(table: tables.typeReferences, row: targetID, column: compilerSyntaxTypeReferenceOwnerColumn()) != row
                || compilerIntTableValue(table: tables.typeReferences, row: targetID, column: compilerSyntaxTypeReferenceParentColumn()) != 0 - 1 { return false }
        }
        row: row + 1
    }
    return true
}

function compilerSyntaxTypeReferencesAreValid(tables: CompilerSyntaxTables): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.typeReferences) {
        let ownerMemberRow: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOwnerColumn()))
        let parentNodeID: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceParentColumn()))
        let ordinal: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOrdinalColumn()))
        let kind: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceKindColumn()))
        let targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetKindColumn()))
        let targetID: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetIDColumn()))
        let childCount: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceChildCountColumn()))
        let depth: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceDepthColumn()))
        let nameStart: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameStartColumn()))
        let nameEnd: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameEndColumn()))
        if ownerMemberRow < 0 || ownerMemberRow >= compilerIntTableRowCount(table: tables.members) { return false }
        let ownerTypeLength: Int(compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 9) - compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 8))
        if !compilerSyntaxMemberHasTypeReference(tables: tables, memberRow: ownerMemberRow)
            || kind < compilerSyntaxTypeReferenceNamed() || kind > compilerSyntaxTypeReferenceValue()
            || depth < 0 || depth >= 32
            || (parentNodeID < 0 && (ordinal != 0 || depth != 0))
            || (parentNodeID >= 0 && (parentNodeID >= row || compilerIntTableValue(table: tables.typeReferences, row: parentNodeID, column: compilerSyntaxTypeReferenceOwnerColumn()) != ownerMemberRow || depth != compilerIntTableValue(table: tables.typeReferences, row: parentNodeID, column: compilerSyntaxTypeReferenceDepthColumn()) + 1))
            || childCount < 0
            || (kind == compilerSyntaxTypeReferenceNamed() && childCount != 0)
            || (kind == compilerSyntaxTypeReferenceValue() && childCount != 0)
            || ((kind == compilerSyntaxTypeReferenceArray() || kind == compilerSyntaxTypeReferenceOptional()) && childCount != 1)
            || (kind == compilerSyntaxTypeReferenceApplication() && childCount <= 0)
            || targetKind < compilerSyntaxTypeReferenceTargetNone() || targetKind > compilerSyntaxTypeReferenceTargetAmbiguous()
            || (targetKind == compilerSyntaxTypeReferenceTargetBuiltin() && (targetID < compilerSyntaxBuiltinTypeInt() || targetID > compilerSyntaxBuiltinTypeFloat()))
            || (targetKind == compilerSyntaxTypeReferenceTargetDeclaration() && (targetID < 0 || targetID >= compilerIntTableRowCount(table: tables.syntaxIndex)))
            || (targetKind == compilerSyntaxTypeReferenceTargetGenericParameter() && (targetID < 0 || targetID >= compilerIntTableRowCount(table: tables.genericParameters)))
            || (targetKind == compilerSyntaxTypeReferenceTargetMissing() && (targetID != 0 - 1 || (kind != compilerSyntaxTypeReferenceNamed() && kind != compilerSyntaxTypeReferenceApplication())))
            || (targetKind == compilerSyntaxTypeReferenceTargetAmbiguous() && (targetID != 0 - 1 || (kind != compilerSyntaxTypeReferenceNamed() && kind != compilerSyntaxTypeReferenceApplication())))
            || (targetKind == compilerSyntaxTypeReferenceTargetNone() && kind != compilerSyntaxTypeReferenceArray() && kind != compilerSyntaxTypeReferenceOptional() && kind != compilerSyntaxTypeReferenceValue())
            || nameStart < 0 || nameEnd <= nameStart || nameEnd > ownerTypeLength
            || (compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceFingerprintFirstColumn()) == 0 && compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceFingerprintSecondColumn()) == 0) { return false }
        if targetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
            let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: targetID))
            if declarationRow < 0 { return false }
            let declarationKind: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2))
            if declarationKind != compilerSyntaxKindConstruct() && declarationKind != compilerSyntaxKindEnum() { return false }
            let genericArity: Int(compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: targetID))
            let requiredGenericArity: Int(compilerSyntaxGenericParameterRequiredCountForOwner(tables: tables, ownerSyntaxID: targetID))
            if kind == compilerSyntaxTypeReferenceNamed() && requiredGenericArity != 0 { return false }
            if (kind == compilerSyntaxTypeReferenceApplication() || kind == compilerSyntaxTypeReferenceArray() || kind == compilerSyntaxTypeReferenceOptional())
                && (childCount < requiredGenericArity || childCount > genericArity) { return false }
        }
        if targetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
            let builtinGenericArity: Int(compilerSyntaxBuiltinTypeGenericArity(typeID: targetID))
            if kind == compilerSyntaxTypeReferenceNamed() && childCount != 0 { return false }
            if kind == compilerSyntaxTypeReferenceApplication()
                && childCount != builtinGenericArity
                && !(targetID == compilerSyntaxBuiltinTypeInt() && childCount == 1) { return false }
            if kind != compilerSyntaxTypeReferenceNamed() && kind != compilerSyntaxTypeReferenceApplication() { return false }
        }
        if parentNodeID >= 0 {
            let parentKind: Int(compilerIntTableValue(table: tables.typeReferences, row: parentNodeID, column: compilerSyntaxTypeReferenceKindColumn()))
            let parentTargetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: parentNodeID, column: compilerSyntaxTypeReferenceTargetKindColumn()))
            let parentTargetID: Int(compilerIntTableValue(table: tables.typeReferences, row: parentNodeID, column: compilerSyntaxTypeReferenceTargetIDColumn()))
            if parentKind == compilerSyntaxTypeReferenceApplication() && parentTargetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
                let expectedKind: Int(compilerSyntaxGenericParameterKindForOrdinal(tables: tables, ownerSyntaxID: parentTargetID, ordinal: ordinal))
                if expectedKind == compilerSyntaxGenericParameterTypeKind() && kind == compilerSyntaxTypeReferenceValue() { return false }
                if expectedKind == compilerSyntaxGenericParameterValueKind() && kind != compilerSyntaxTypeReferenceValue() { return false }
            }
            if parentKind == compilerSyntaxTypeReferenceApplication() && parentTargetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
                let expectedKind: Int(compilerSyntaxBuiltinTypeGenericParameterKind(typeID: parentTargetID, ordinal: ordinal))
                if expectedKind == compilerSyntaxGenericParameterTypeKind() && kind == compilerSyntaxTypeReferenceValue() { return false }
                if expectedKind == compilerSyntaxGenericParameterValueKind() && kind != compilerSyntaxTypeReferenceValue() { return false }
            }
        }
        state actualChildCount: Int(0)
        state childRow: Int(row + 1)
        while childRow < compilerIntTableRowCount(table: tables.typeReferences) {
            if compilerIntTableValue(table: tables.typeReferences, row: childRow, column: compilerSyntaxTypeReferenceParentColumn()) == row {
                if compilerIntTableValue(table: tables.typeReferences, row: childRow, column: compilerSyntaxTypeReferenceOrdinalColumn()) != actualChildCount { return false }
                actualChildCount: actualChildCount + 1
            }
            childRow: childRow + 1
        }
        if actualChildCount != childCount { return false }
        row: row + 1
    }
    return true
}

function compilerSyntaxEnumDirectPayloadCyclesAreAbsent(tables: CompilerSyntaxTables): Bool {
    let declarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let resolvedBySyntaxID: Buffer<Int>(bufferCreateInt(capacity: syntaxCount))
    state valid: Bool(true)
    state syntaxID: Int(0)
    while syntaxID < syntaxCount {
        state initial: Int(1)
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) == compilerSyntaxKindEnum() { initial: 0 }
        if resolvedBySyntaxID.append(element: initial) != 0 { valid: false }
        syntaxID: syntaxID + 1
    }
    state declarationRow: Int(0)
    while declarationRow < declarationCount {
        let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
        if declarationSyntaxID < 0 || declarationSyntaxID >= syntaxCount { valid: false }
        declarationRow: declarationRow + 1
    }
    state changed: Bool(true)
    state pass: Int(0)
    while valid && changed && pass <= declarationCount {
        changed: false
        declarationRow: 0
        while declarationRow < declarationCount {
            let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
            if resolvedBySyntaxID.element(index: declarationSyntaxID) == 0 {
                state blocked: Bool(false)
                state payloadRow: Int(0)
                while payloadRow < compilerIntTableRowCount(table: tables.members) {
                    if compilerIntTableValue(table: tables.members, row: payloadRow, column: 12) == compilerSyntaxMemberKindEnumCasePayload()
                        && compilerIntTableValue(table: tables.members, row: payloadRow, column: 13) == compilerSyntaxMemberStorageDirect()
                        && compilerSyntaxEnumPayloadOwnerSyntaxID(tables: tables, payloadRow: payloadRow) == declarationSyntaxID {
                        let typeReferenceID: Int(compilerIntTableValue(table: tables.members, row: payloadRow, column: 15))
                        let targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetKindColumn()))
                        let targetSyntaxID: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetIDColumn()))
                        if targetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
                            if targetSyntaxID < 0 || targetSyntaxID >= syntaxCount {
                                valid: false
                            } else if compilerIntTableValue(table: tables.syntaxIndex, row: targetSyntaxID, column: 0) == compilerSyntaxKindEnum()
                                && resolvedBySyntaxID.element(index: targetSyntaxID) == 0 { blocked: true }
                        } else if targetKind != compilerSyntaxTypeReferenceTargetBuiltin()
                            && targetKind != compilerSyntaxTypeReferenceTargetGenericParameter()
                            && targetKind != compilerSyntaxTypeReferenceTargetMissing()
                            && targetKind != compilerSyntaxTypeReferenceTargetAmbiguous() {
                            valid: false
                        }
                    }
                    payloadRow: payloadRow + 1
                }
                if valid && !blocked {
                    if resolvedBySyntaxID.update(element: 1, index: declarationSyntaxID) != 0 {
                        valid: false
                    } else {
                        changed: true
                    }
                }
            }
            declarationRow: declarationRow + 1
        }
        pass: pass + 1
    }
    declarationRow: 0
    while valid && declarationRow < declarationCount {
        let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
        if resolvedBySyntaxID.element(index: declarationSyntaxID) == 0 { valid: false }
        declarationRow: declarationRow + 1
    }
    if resolvedBySyntaxID.destroy() != 0 { valid: false }
    return valid
}

function compilerSyntaxDerivedFunctionHasMatchingMember(tables: CompilerSyntaxTables, functionRow: Int, ownerSyntaxID: Int): Bool {
    let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: functionSyntaxID))
    if declarationRow < 0 { return false }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    state matches: Int(0)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: memberRow, column: 2) == ownerSyntaxID
            && compilerIntTableValue(table: tables.members, row: memberRow, column: 12) == compilerSyntaxMemberKindDerived() {
            let memberFileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
            let memberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: memberFileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 7)))
            if memberName == name { matches: matches + 1 }
        }
        memberRow: memberRow + 1
    }
    return matches == 1
}

function compilerSyntaxFunctionsAreValid(tables: CompilerSyntaxTables): Bool {
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    let functionCount: Int(compilerIntTableRowCount(table: tables.functions))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
    let genericParameterCount: Int(compilerIntTableRowCount(table: tables.genericParameters))
    state row: Int(0)
    while row < functionCount {
        let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 0))
        let fileID: Int(compilerIntTableValue(table: tables.functions, row: row, column: 1))
        let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: row, column: 2))
        let childCount: Int(compilerIntTableValue(table: tables.functions, row: row, column: 3))
        let isDerived: Int(compilerIntTableValue(table: tables.functions, row: row, column: compilerSyntaxFunctionDerivedColumn()))
        let ownerSyntaxID: Int(tables.functionOwners.element(index: row))
        if syntaxID < 0 || syntaxID >= syntaxCount || fileID < 0 || fileID >= fileCount || firstParameterRow < 0 || childCount < 0 || firstParameterRow + childCount > parameterCount
            || (ownerSyntaxID >= 0 && (ownerSyntaxID >= syntaxCount || compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 0) != compilerSyntaxKindConstruct()))
            || (isDerived != 0 && isDerived != 1)
            || (isDerived == 1 && (ownerSyntaxID < 0 || childCount != 0 || !compilerSyntaxDerivedFunctionHasMatchingMember(tables: tables, functionRow: row, ownerSyntaxID: ownerSyntaxID))) {
            return false
        }
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) != compilerSyntaxKindFunction() {
            return false
        }
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1) != row {
            return false
        }
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
        if declarationRow < 0 || compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1) != fileID {
            return false
        }
        state childOrdinal: Int(0)
        while childOrdinal < childCount {
            let parameterRow: Int(firstParameterRow + childOrdinal)
            if compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 2) != row
                || compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 3) != childOrdinal {
                return false
            }
            childOrdinal: childOrdinal + 1
        }
        row: row + 1
    }
    return true
}

function compilerSyntaxParametersAreValid(tables: CompilerSyntaxTables): Bool {
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    let functionCount: Int(compilerIntTableRowCount(table: tables.functions))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
    state row: Int(0)
    while row < parameterCount {
        let syntaxID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 0))
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 1))
        let functionID: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 2))
        let ordinal: Int(compilerIntTableValue(table: tables.parameters, row: row, column: 3))
        if syntaxID < 0 || syntaxID >= syntaxCount || fileID < 0 || fileID >= fileCount || functionID < 0 || functionID >= functionCount {
            return false
        }
        let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionID, column: 0))
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) != compilerSyntaxKindParameter()
            || functionSyntaxID < 0 || functionSyntaxID >= syntaxCount
            || compilerIntTableValue(table: tables.syntaxIndex, row: functionSyntaxID, column: 0) != compilerSyntaxKindFunction()
            || ordinal != compilerSyntaxPriorChildCount(table: tables.parameters, row: row, parentColumn: 2, parentSyntaxID: functionID) {
            return false
        }
        if compilerIntTableValue(table: tables.functions, row: functionID, column: 1) != fileID {
            return false
        }
        let ownFirstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionID, column: 2))
        let ownChildCount: Int(compilerIntTableValue(table: tables.functions, row: functionID, column: 3))
        if row < ownFirstParameterRow || row >= ownFirstParameterRow + ownChildCount {
            return false
        }
        state coveringFunctions: Int(0)
        state candidateFunctionRow: Int(0)
        while candidateFunctionRow < compilerIntTableRowCount(table: tables.functions) {
            let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: candidateFunctionRow, column: 2))
            let childCount: Int(compilerIntTableValue(table: tables.functions, row: candidateFunctionRow, column: 3))
            if row >= firstParameterRow && row < firstParameterRow + childCount {
                coveringFunctions: coveringFunctions + 1
            }
            candidateFunctionRow: candidateFunctionRow + 1
        }
        if coveringFunctions != 1 {
            return false
        }
        row: row + 1
    }
    return true
}

function compilerSyntaxGenericParametersAreValid(tables: CompilerSyntaxTables): Bool {
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.genericParameters) {
        let ownerSyntaxID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()))
        let ownerKind: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerKindColumn()))
        let ordinal: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()))
        let fileID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()))
        let start: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterStartColumn()))
        let end: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterEndColumn()))
        let nameStart: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameStartColumn()))
        let nameEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameEndColumn()))
        let kind: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterKindColumn()))
        if ownerSyntaxID < 0 || ownerSyntaxID >= syntaxCount
            || (ownerKind != compilerSyntaxKindConstruct() && ownerKind != compilerSyntaxKindFunction() && ownerKind != compilerSyntaxKindEnum())
            || compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 0) != ownerKind
            || ordinal != compilerSyntaxPriorChildCount(table: tables.genericParameters, row: row, parentColumn: compilerSyntaxGenericParameterOwnerColumn(), parentSyntaxID: ownerSyntaxID)
            || fileID < 0 || fileID >= fileCount
            || (kind != compilerSyntaxGenericParameterTypeKind() && kind != compilerSyntaxGenericParameterValueKind())
            || start < 0 || end <= start || nameStart < start || nameEnd <= nameStart || nameEnd > end
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: start) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: end) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: nameStart) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: nameEnd) < 0
            || (compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFingerprintFirstColumn()) == 0
                && compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFingerprintSecondColumn()) == 0) { return false }
        let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: ownerSyntaxID))
        if ownerDeclarationRow < 0 || compilerIntTableValue(table: tables.declarations, row: ownerDeclarationRow, column: 1) != fileID { return false }
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: tables.genericParameters, row: priorRow, column: compilerSyntaxGenericParameterOwnerColumn()) == ownerSyntaxID
                && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: fileID, firstStart: nameStart, firstEnd: nameEnd, secondFileID: compilerIntTableValue(table: tables.genericParameters, row: priorRow, column: compilerSyntaxGenericParameterFileColumn()), secondStart: compilerIntTableValue(table: tables.genericParameters, row: priorRow, column: compilerSyntaxGenericParameterNameStartColumn()), secondEnd: compilerIntTableValue(table: tables.genericParameters, row: priorRow, column: compilerSyntaxGenericParameterNameEndColumn())) { return false }
            priorRow: priorRow + 1
        }
        row: row + 1
    }
    return true
}

function compilerSyntaxGenericParameterCountForOwner(tables: CompilerSyntaxTables, ownerSyntaxID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.genericParameters) {
        if compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()) == ownerSyntaxID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerSyntaxGenericParameterRowForOwnerOrdinal(tables: CompilerSyntaxTables, ownerSyntaxID: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.genericParameters) {
        if compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()) == ownerSyntaxID
            && compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()) == ordinal { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerSyntaxGenericParameterDefaultRange(tables: CompilerSyntaxTables, parameterRow: Int): CompilerSourceRange {
    let invalid: CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
    if parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: tables.genericParameters) { return invalid }
    let fileID: Int(compilerIntTableValue(table: tables.genericParameters, row: parameterRow, column: compilerSyntaxGenericParameterFileColumn()))
    let nameEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: parameterRow, column: compilerSyntaxGenericParameterNameEndColumn()))
    let parameterEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: parameterRow, column: compilerSyntaxGenericParameterEndColumn()))
    let globalNameEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: nameEnd))
    let globalParameterEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: parameterEnd))
    if globalNameEnd < 0 || globalParameterEnd <= globalNameEnd { return invalid }
    let maybeEqual: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: globalNameEnd))
    if maybeEqual == nil { return invalid }
    let equal: RangeLexedToken(maybeEqual ?? compilerFallbackTokenAt(index: globalNameEnd))
    if equal.kind != .equal || equal.end >= globalParameterEnd { return invalid }
    let maybeDefault: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: equal.end))
    if maybeDefault == nil { return invalid }
    let first: RangeLexedToken(maybeDefault ?? compilerFallbackTokenAt(index: equal.end))
    if first.start < equal.end || first.end > globalParameterEnd { return invalid }
    let localStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: first.start))
    if localStart < 0 { return invalid }
    return CompilerSourceRange(start: localStart, end: parameterEnd, next: parameterEnd)
}

function compilerSyntaxGenericParameterHasDefault(tables: CompilerSyntaxTables, parameterRow: Int): Bool {
    let defaultRange: CompilerSourceRange(compilerSyntaxGenericParameterDefaultRange(tables: tables, parameterRow: parameterRow))
    return defaultRange.start >= 0
}

function compilerSyntaxGenericParameterRequiredCountForOwner(tables: CompilerSyntaxTables, ownerSyntaxID: Int): Int {
    let count: Int(compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: ownerSyntaxID))
    state required: Int(count)
    state ordinal: Int(count - 1)
    while ordinal >= 0 {
        let parameterRow: Int(compilerSyntaxGenericParameterRowForOwnerOrdinal(tables: tables, ownerSyntaxID: ownerSyntaxID, ordinal: ordinal))
        if parameterRow < 0 || !compilerSyntaxGenericParameterHasDefault(tables: tables, parameterRow: parameterRow) { return required }
        required: ordinal
        ordinal: ordinal - 1
    }
    return required
}

function compilerSyntaxBodyEdgeCount(tables: CompilerSyntaxTables, syntaxID: Int, roleTag: Int, asOwner: Bool): Int {
    state bodyEdgeRow: Int(0)
    state bodyEdgeMatches: Int(0)
    let bodyEdgeCount: Int(compilerIntTableRowCount(table: tables.bodyEdges))
    while bodyEdgeRow < bodyEdgeCount {
        state candidateSyntaxID: Int(compilerIntTableValue(table: tables.bodyEdges, row: bodyEdgeRow, column: 1))
        if asOwner { candidateSyntaxID: compilerIntTableValue(table: tables.bodyEdges, row: bodyEdgeRow, column: 0) }
        let candidateRole: Int(compilerIntTableValue(table: tables.bodyEdges, row: bodyEdgeRow, column: 2))
        if candidateSyntaxID == syntaxID && (roleTag < 0 || candidateRole == roleTag) {
            bodyEdgeMatches: bodyEdgeMatches + 1
        }
        bodyEdgeRow: bodyEdgeRow + 1
    }
    return bodyEdgeMatches
}

function compilerSyntaxBodyNodeShapeIsValid(tables: CompilerSyntaxTables, syntaxID: Int, kindTag: Int): Bool {
    if kindTag == compilerSyntaxKindEntry() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleAppliesTo(), asOwner: false) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleBody(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1
    }
    if kindTag == compilerSyntaxKindMainAnnotation() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: false) == 0
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleAppliesTo(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1
    }
    if compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: false) != 1 {
        return false
    }
    if kindTag == compilerSyntaxKindLocalBinding() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleInitializer(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1
    }
    if kindTag == compilerSyntaxKindReturn() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleReturnValue(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1
    }
    if kindTag == compilerSyntaxKindAssignment() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleAssignmentTarget(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleAssignedValue(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 2
    }
    if kindTag == compilerSyntaxKindIf() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleCondition(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleThenRegion(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 2
    }
    if kindTag == compilerSyntaxKindBlock() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleStatement(), asOwner: true)
    }
    if kindTag == compilerSyntaxKindBindingReference() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 0
    }
    if kindTag == compilerSyntaxKindApplication() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleCallee(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1 + compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleArgument(), asOwner: true)
    }
    if kindTag == compilerSyntaxKindMemberRead() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleReceiver(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1
    }
    if kindTag == compilerSyntaxKindIndex() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleReceiver(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleIndex(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 2
    }
    if kindTag == compilerSyntaxKindAddition() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleLeftOperand(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleRightOperand(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 2
    }
    if kindTag == compilerSyntaxKindArgument() {
        return compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: compilerSyntaxRoleArgumentValue(), asOwner: true) == 1
            && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 1
    }
    return (kindTag == compilerSyntaxKindIdentifier() || kindTag == compilerSyntaxKindIntegerLiteral() || kindTag == compilerSyntaxKindDoubleLiteral())
        && compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: syntaxID, roleTag: 0 - 1, asOwner: true) == 0
}

function compilerSyntaxKindIsBodyExpression(kindTag: Int): Bool {
    return kindTag == compilerSyntaxKindIdentifier()
        || kindTag == compilerSyntaxKindApplication()
        || kindTag == compilerSyntaxKindMemberRead()
        || kindTag == compilerSyntaxKindIntegerLiteral()
        || kindTag == compilerSyntaxKindDoubleLiteral()
        || kindTag == compilerSyntaxKindAddition()
        || kindTag == compilerSyntaxKindIndex()
        || kindTag == compilerSyntaxKindBindingReference()
}

function compilerSyntaxPriorBodyRoleCount(tables: CompilerSyntaxTables, edgeRow: Int, ownerSyntaxID: Int, roleTag: Int): Int {
    state priorBodyEdgeRow: Int(0)
    state priorBodyRoleCount: Int(0)
    while priorBodyEdgeRow < edgeRow {
        if compilerIntTableValue(table: tables.bodyEdges, row: priorBodyEdgeRow, column: 0) == ownerSyntaxID
            && compilerIntTableValue(table: tables.bodyEdges, row: priorBodyEdgeRow, column: 2) == roleTag {
            priorBodyRoleCount: priorBodyRoleCount + 1
        }
        priorBodyEdgeRow: priorBodyEdgeRow + 1
    }
    return priorBodyRoleCount
}

function compilerSyntaxBodyEdgeKindsAreValid(tables: CompilerSyntaxTables, edgeRow: Int, ownerSyntaxID: Int, childSyntaxID: Int, roleTag: Int, ordinal: Int): Bool {
    let ownerKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 0))
    let childKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: childSyntaxID, column: 0))
    if roleTag == compilerSyntaxRoleStatement() {
        if ownerKindTag != compilerSyntaxKindBlock() { return false }
        if childKindTag != compilerSyntaxKindLocalBinding() && childKindTag != compilerSyntaxKindReturn() && childKindTag != compilerSyntaxKindAssignment() && childKindTag != compilerSyntaxKindIf() && childKindTag != compilerSyntaxKindApplication() { return false }
        let statementFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: childSyntaxID, column: 1))
        if compilerIntTableValue(table: tables.bodyNodes, row: statementFacetRow, column: 2) != ownerSyntaxID
            || compilerIntTableValue(table: tables.bodyNodes, row: statementFacetRow, column: 3) != ordinal
            || ordinal != compilerSyntaxPriorBodyRoleCount(tables: tables, edgeRow: edgeRow, ownerSyntaxID: ownerSyntaxID, roleTag: roleTag) { return false }
        if childKindTag == compilerSyntaxKindReturn() {
            return ordinal + 1 == compilerSyntaxBodyEdgeCount(tables: tables, syntaxID: ownerSyntaxID, roleTag: compilerSyntaxRoleStatement(), asOwner: true)
        }
        return true
    }
    if roleTag == compilerSyntaxRoleAppliesTo() {
        return ownerKindTag == compilerSyntaxKindMainAnnotation() && childKindTag == compilerSyntaxKindEntry() && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleBody() {
        return (ownerKindTag == compilerSyntaxKindFunction() || ownerKindTag == compilerSyntaxKindEntry())
            && childKindTag == compilerSyntaxKindBlock() && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleThenRegion() {
        return ownerKindTag == compilerSyntaxKindIf() && childKindTag == compilerSyntaxKindBlock() && ordinal == 0
    }
    if ownerKindTag < compilerSyntaxKindEntry() || ownerKindTag > compilerSyntaxKindLastBody() { return false }
    let edgeOwnerFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 1))
    let edgeChildFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: childSyntaxID, column: 1))
    if compilerIntTableValue(table: tables.bodyNodes, row: edgeOwnerFacetRow, column: 2)
        != compilerIntTableValue(table: tables.bodyNodes, row: edgeChildFacetRow, column: 2) { return false }
    if roleTag == compilerSyntaxRoleInitializer() {
        return ownerKindTag == compilerSyntaxKindLocalBinding() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleReturnValue() {
        return ownerKindTag == compilerSyntaxKindReturn() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleAssignmentTarget() {
        return ownerKindTag == compilerSyntaxKindAssignment()
            && (childKindTag == compilerSyntaxKindIdentifier() || childKindTag == compilerSyntaxKindMemberRead() || childKindTag == compilerSyntaxKindIndex()) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleAssignedValue() {
        return ownerKindTag == compilerSyntaxKindAssignment() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleCondition() {
        return ownerKindTag == compilerSyntaxKindIf() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleCallee() {
        return ownerKindTag == compilerSyntaxKindApplication()
            && (childKindTag == compilerSyntaxKindIdentifier() || childKindTag == compilerSyntaxKindMemberRead()) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleArgument() {
        if ownerKindTag != compilerSyntaxKindApplication() || childKindTag != compilerSyntaxKindArgument() { return false }
        let argumentFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: childSyntaxID, column: 1))
        return compilerIntTableValue(table: tables.bodyNodes, row: argumentFacetRow, column: 3) == ordinal
            && ordinal == compilerSyntaxPriorBodyRoleCount(tables: tables, edgeRow: edgeRow, ownerSyntaxID: ownerSyntaxID, roleTag: roleTag)
    }
    if roleTag == compilerSyntaxRoleArgumentValue() {
        return ownerKindTag == compilerSyntaxKindArgument() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleReceiver() {
        return (ownerKindTag == compilerSyntaxKindMemberRead() || ownerKindTag == compilerSyntaxKindIndex()) && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleIndex() {
        return ownerKindTag == compilerSyntaxKindIndex() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    if roleTag == compilerSyntaxRoleLeftOperand() {
        return ownerKindTag == compilerSyntaxKindAddition() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
    }
    return roleTag == compilerSyntaxRoleRightOperand()
        && ownerKindTag == compilerSyntaxKindAddition() && compilerSyntaxKindIsBodyExpression(kindTag: childKindTag) && ordinal == 0
}

function compilerSyntaxBodyNodesAreValid(tables: CompilerSyntaxTables): Bool {
    let bodySyntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let bodyFileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    let bodyNodeCount: Int(compilerIntTableRowCount(table: tables.bodyNodes))
    state bodyNodeRow: Int(0)
    while bodyNodeRow < bodyNodeCount {
        let bodySyntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyNodeRow, column: 0))
        let bodyFileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyNodeRow, column: 1))
        let bodyOwnerSyntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyNodeRow, column: 2))
        let bodyOrdinal: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyNodeRow, column: 3))
        if bodySyntaxID < 0 || bodySyntaxID >= bodySyntaxCount || bodyFileID < 0 || bodyFileID >= bodyFileCount || bodyOrdinal < 0 {
            return false
        }
        let bodyKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: bodySyntaxID, column: 0))
    if bodyKindTag < compilerSyntaxKindEntry() || bodyKindTag > compilerSyntaxKindLastBody()
            || compilerIntTableValue(table: tables.syntaxIndex, row: bodySyntaxID, column: 1) != bodyNodeRow {
            return false
        }
        if bodyKindTag == compilerSyntaxKindEntry() || bodyKindTag == compilerSyntaxKindMainAnnotation() {
            if bodyOwnerSyntaxID != 0 - 1 { return false }
        } else {
            if bodyOwnerSyntaxID < 0 || bodyOwnerSyntaxID >= bodySyntaxCount { return false }
            let bodyOwnerKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: bodyOwnerSyntaxID, column: 0))
            if bodyKindTag == compilerSyntaxKindBlock() {
                if bodyOwnerKind != compilerSyntaxKindFunction() && bodyOwnerKind != compilerSyntaxKindEntry() && bodyOwnerKind != compilerSyntaxKindIf() { return false }
            } else if bodyOwnerKind != compilerSyntaxKindBlock() { return false }
        }
        let bodyStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyNodeRow, column: 4))
        let bodyEnd: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyNodeRow, column: 5))
        let bodyGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: bodyFileID, localOffset: bodyStart))
        let bodyGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: bodyFileID, localOffset: bodyEnd))
        if bodyGlobalStart < 0 || bodyGlobalEnd < bodyGlobalStart { return false }
        if !compilerSyntaxBodyNodeShapeIsValid(tables: tables, syntaxID: bodySyntaxID, kindTag: bodyKindTag) { return false }
        bodyNodeRow: bodyNodeRow + 1
    }
    return true
}

function compilerSyntaxBodyEdgesAreValid(tables: CompilerSyntaxTables): Bool {
    let bodyEdgeSyntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    state bodyValidationEdgeRow: Int(0)
    let bodyValidationEdgeCount: Int(compilerIntTableRowCount(table: tables.bodyEdges))
    while bodyValidationEdgeRow < bodyValidationEdgeCount {
        let bodyEdgeOwner: Int(compilerIntTableValue(table: tables.bodyEdges, row: bodyValidationEdgeRow, column: 0))
        let bodyEdgeChild: Int(compilerIntTableValue(table: tables.bodyEdges, row: bodyValidationEdgeRow, column: 1))
        let bodyEdgeRole: Int(compilerIntTableValue(table: tables.bodyEdges, row: bodyValidationEdgeRow, column: 2))
        let bodyEdgeOrdinal: Int(compilerIntTableValue(table: tables.bodyEdges, row: bodyValidationEdgeRow, column: 3))
        if bodyEdgeOwner < 0 || bodyEdgeOwner >= bodyEdgeSyntaxCount || bodyEdgeChild < 0 || bodyEdgeChild >= bodyEdgeSyntaxCount
            || bodyEdgeRole < compilerSyntaxRoleStatement() || bodyEdgeRole > compilerSyntaxRoleBody() || bodyEdgeOrdinal < 0 {
            return false
        }
        let bodyEdgeChildKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: bodyEdgeChild, column: 0))
        if bodyEdgeChildKind < compilerSyntaxKindEntry() || bodyEdgeChildKind > compilerSyntaxKindLastBody() { return false }
        if !compilerSyntaxBodyEdgeKindsAreValid(tables: tables, edgeRow: bodyValidationEdgeRow, ownerSyntaxID: bodyEdgeOwner, childSyntaxID: bodyEdgeChild, roleTag: bodyEdgeRole, ordinal: bodyEdgeOrdinal) { return false }
        bodyValidationEdgeRow: bodyValidationEdgeRow + 1
    }
    return true
}

function compilerMacroLocalRangeIsValid(tables: CompilerSyntaxTables, fileID: Int, start: Int, end: Int, optional: Bool): Bool {
    if optional && start < 0 && end < 0 { return true }
    if start < 0 || end < start { return false }
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: start))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: end))
    return globalStart >= 0 && globalEnd >= globalStart
}

function compilerMacroDeclarationsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    let parameterCount: Int(compilerIntTableRowCount(table: tables.macroParameters))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    state row: Int(0)
    while row < declarationCount {
        if compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 0) != row { return false }
        let fileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 1))
        let visibility: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 6))
        let ordinal: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 22))
        let acceptedTargetKind: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 17))
        let firstParameterRow: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 23))
        let parameterCountForRow: Int(compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 24))
        state expectedOrdinal: Int(0)
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: tables.macroDeclarations, row: priorRow, column: 1) == fileID { expectedOrdinal: expectedOrdinal + 1 }
            priorRow: priorRow + 1
        }
        if fileID < 0 || fileID >= fileCount || visibility < 0 || visibility > compilerSyntaxMacroVisibilityClosed() || ordinal != expectedOrdinal || acceptedTargetKind < 0
            || firstParameterRow < 0 || parameterCountForRow < 0 || firstParameterRow + parameterCountForRow > parameterCount { return false }
        if !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 2), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 3), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 4), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 5), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 7), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 8), optional: true)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 9), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 10), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 11), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 12), optional: true)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 13), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 14), optional: true)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 15), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 16), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 25), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 26), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 27), end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 28), optional: false)
            || compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 29) < compilerMacroCapabilitySetInvalid() { return false }
        row: row + 1
    }
    return true
}

function compilerMacroCapabilitiesAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let capabilityCount: Int(compilerIntTableRowCount(table: tables.macroCapabilities))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    state row: Int(0)
    while row < capabilityCount {
        let declarationRow: Int(compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 1))
        let ordinal: Int(compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 2))
        let kind: Int(compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 3))
        let fileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
        if compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 0) != row
            || declarationRow < 0 || declarationRow >= declarationCount || ordinal < 0
            || kind < compilerMacroCapabilityTarget() || kind > compilerMacroCapabilityGraph()
            || (kind == compilerMacroCapabilityTarget() && compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 6) != compilerMacroCapabilityAuthorityExpandTarget())
            || (kind == compilerMacroCapabilityDiagnostics() && compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 6) != compilerMacroCapabilityAuthorityAppendDiagnostic())
            || (kind == compilerMacroCapabilityGraph() && compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 6) != compilerMacroCapabilityAuthorityQueryDeclarations())
            || compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 7) <= 0
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 4), end: compilerIntTableValue(table: tables.macroCapabilities, row: row, column: 5), optional: false) { return false }
        state expectedOrdinal: Int(0)
        state prior: Int(0)
        while prior < row {
            if compilerIntTableValue(table: tables.macroCapabilities, row: prior, column: 1) == declarationRow { expectedOrdinal: expectedOrdinal + 1 }
            prior: prior + 1
        }
        if ordinal != expectedOrdinal { return false }
        row: row + 1
    }
    return true
}

function compilerMacroParametersAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let parameterCount: Int(compilerIntTableRowCount(table: tables.macroParameters))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    state row: Int(0)
    while row < parameterCount {
        if compilerIntTableValue(table: tables.macroParameters, row: row, column: 0) != row { return false }
        let declarationRow: Int(compilerIntTableValue(table: tables.macroParameters, row: row, column: 1))
        let ordinal: Int(compilerIntTableValue(table: tables.macroParameters, row: row, column: 2))
        if declarationRow < 0 || declarationRow >= declarationCount || ordinal < 0 { return false }
        let fileID: Int(compilerIntTableValue(table: tables.macroDeclarations, row: declarationRow, column: 1))
        if !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroParameters, row: row, column: 3), end: compilerIntTableValue(table: tables.macroParameters, row: row, column: 4), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroParameters, row: row, column: 5), end: compilerIntTableValue(table: tables.macroParameters, row: row, column: 6), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroParameters, row: row, column: 7), end: compilerIntTableValue(table: tables.macroParameters, row: row, column: 8), optional: false) { return false }
        state expectedOrdinal: Int(0)
        state prior: Int(0)
        while prior < row {
            if compilerIntTableValue(table: tables.macroParameters, row: prior, column: 1) == declarationRow { expectedOrdinal: expectedOrdinal + 1 }
            prior: prior + 1
        }
        if ordinal != expectedOrdinal { return false }
        row: row + 1
    }
    return true
}

function compilerMacroApplicationsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    state row: Int(0)
    while row < applicationCount {
        let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 1))
        let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 12))
        let targetKind: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 13))
        if compilerIntTableValue(table: tables.macroApplications, row: row, column: 0) != row || fileID < 0 || fileID >= fileCount
            || targetSyntaxID < 0 - 1 || targetSyntaxID >= syntaxCount || targetKind < 0 || targetKind > compilerSyntaxKindParameter() { return false }
        if !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroApplications, row: row, column: 2), end: compilerIntTableValue(table: tables.macroApplications, row: row, column: 3), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroApplications, row: row, column: 4), end: compilerIntTableValue(table: tables.macroApplications, row: row, column: 5), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroApplications, row: row, column: 6), end: compilerIntTableValue(table: tables.macroApplications, row: row, column: 7), optional: true)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroApplications, row: row, column: 8), end: compilerIntTableValue(table: tables.macroApplications, row: row, column: 9), optional: true)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroApplications, row: row, column: 10), end: compilerIntTableValue(table: tables.macroApplications, row: row, column: 11), optional: true) { return false }
        row: row + 1
    }
    return true
}

function compilerMacroEdgesAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let edgeCount: Int(compilerIntTableRowCount(table: tables.macroEdges))
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    state row: Int(0)
    while row < edgeCount {
        let edgeKind: Int(compilerIntTableValue(table: tables.macroEdges, row: row, column: 1))
        let applicationRow: Int(compilerIntTableValue(table: tables.macroEdges, row: row, column: 2))
        let objectID: Int(compilerIntTableValue(table: tables.macroEdges, row: row, column: 3))
        if compilerIntTableValue(table: tables.macroEdges, row: row, column: 0) != row || applicationRow < 0 || applicationRow >= applicationCount
            || (edgeKind != compilerMacroEdgeAppliesTo() && edgeKind != compilerMacroEdgeResolvedBy()) || objectID < 0 { return false }
        if edgeKind == compilerMacroEdgeResolvedBy() && objectID >= declarationCount { return false }
        if edgeKind == compilerMacroEdgeAppliesTo() && objectID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return false }
        row: row + 1
    }
    return true
}

function compilerMacroDiagnosticsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let diagnosticCount: Int(compilerIntTableRowCount(table: tables.macroDiagnostics))
    let fileCount: Int(compilerSourceStoreFileCount(store: tables.sourceStore))
    state row: Int(0)
    while row < diagnosticCount {
        let fileID: Int(compilerIntTableValue(table: tables.macroDiagnostics, row: row, column: 1))
        if compilerIntTableValue(table: tables.macroDiagnostics, row: row, column: 0) <= 0 || fileID < 0 || fileID >= fileCount
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroDiagnostics, row: row, column: 2), end: compilerIntTableValue(table: tables.macroDiagnostics, row: row, column: 3), optional: false) { return false }
        row: row + 1
    }
    return true
}

function compilerMacroExecutionTablesAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let invocationCount: Int(compilerIntTableRowCount(table: tables.macroInvocations))
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let declarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    if !compilerIntTableIsComplete(table: tables.macroInvocations)
        || !compilerIntTableIsComplete(table: tables.macroCapabilityHandles)
        || !compilerIntTableIsComplete(table: tables.macroExecutionEvents)
        || !compilerIntTableIsComplete(table: tables.macroReadDependencies)
        || !compilerIntTableIsComplete(table: tables.macroResults) { return false }
    state row: Int(0)
    while row < invocationCount {
        if compilerIntTableValue(table: tables.macroInvocations, row: row, column: 0) != row
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 1) < 0
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 1) >= applicationCount
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 2) < 0
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 2) >= declarationCount
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 5) != compilerMacroPhaseApplication()
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 8) <= 0
            || (compilerIntTableValue(table: tables.macroInvocations, row: row, column: 9) != compilerMacroInvocationSuccess()
                && compilerIntTableValue(table: tables.macroInvocations, row: row, column: 9) != compilerMacroInvocationFailed())
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 33) < 0
            || compilerIntTableValue(table: tables.macroInvocations, row: row, column: 33) > 6 { return false }
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroCapabilityHandles) {
        if compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 0) != row
            || compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 1) < 0
            || compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 1) >= invocationCount
            || compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 3) < compilerMacroCapabilityTarget()
            || compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 3) > compilerMacroCapabilityGraph()
            || compilerIntTableValue(table: tables.macroCapabilityHandles, row: row, column: 4) < compilerMacroCapabilityAuthorityNone() { return false }
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroExecutionEvents) {
        if compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 0) != row
            || compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 1) < 0
            || compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 1) >= invocationCount
            || compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 2) < compilerMacroSeverityInformation()
            || compilerIntTableValue(table: tables.macroExecutionEvents, row: row, column: 2) > compilerMacroSeverityError() { return false }
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroReadDependencies) {
        let dependencyInvocationRow: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 1))
        let dependencyOperation: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 2))
        let dependencyKind: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 3))
        let dependencyFileID: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 4))
        let dependencyApplicationIdentityFirst: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 10))
        let dependencyApplicationIdentitySecond: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 11))
        let dependencyTargetIdentityFirst: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 12))
        let dependencyTargetIdentitySecond: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 13))
        let dependencyQueryIdentityFirst: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 14))
        let dependencyQueryIdentitySecond: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 15))
        let dependencyObservationFirst: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 16))
        let dependencyObservationSecond: Int(compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 17))
        if compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 0) != row
            || dependencyInvocationRow < 0 || dependencyInvocationRow >= invocationCount
            || (dependencyOperation != compilerMacroGraphOperationDeclarationCount() && dependencyOperation != compilerMacroTargetOperationMemberCount())
            || (dependencyOperation == compilerMacroGraphOperationDeclarationCount() && dependencyKind != compilerSyntaxKindConstruct() && dependencyKind != compilerSyntaxKindFunction())
            || (dependencyOperation == compilerMacroTargetOperationMemberCount() && dependencyKind != compilerSyntaxKindConstruct())
            || dependencyFileID < 0 || dependencyFileID >= compilerSourceStoreFileCount(store: tables.sourceStore)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: dependencyFileID, start: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 5), end: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 6), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: dependencyFileID, start: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 7), end: compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 8), optional: false)
            || compilerIntTableValue(table: tables.macroReadDependencies, row: row, column: 9) < 0
            || (dependencyApplicationIdentityFirst == 0 && dependencyApplicationIdentitySecond == 0)
            || (dependencyTargetIdentityFirst == 0 && dependencyTargetIdentitySecond == 0)
            || (dependencyQueryIdentityFirst == 0 && dependencyQueryIdentitySecond == 0)
            || (dependencyObservationFirst == 0 && dependencyObservationSecond == 0) { return false }
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroResults) {
        let resultInvocationRow: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 1))
        let resultApplicationRow: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 2))
        let resultDeclarationRow: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 3))
        let resultTargetSyntaxID: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 4))
        let resultKind: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 5))
        let resultNominalSyntaxID: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 7))
        let parentResultRow: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 10))
        let childOrdinal: Int(compilerIntTableValue(table: tables.macroResults, row: row, column: 11))
        if compilerIntTableValue(table: tables.macroResults, row: row, column: 0) != row
            || resultInvocationRow < 0 || resultInvocationRow >= invocationCount
            || resultApplicationRow < 0 || resultApplicationRow >= applicationCount
            || resultDeclarationRow < 0 || resultDeclarationRow >= declarationCount
            || resultTargetSyntaxID < 0 || resultTargetSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
            || resultKind < compilerMacroValueKindScalar() || resultKind > compilerMacroValueKindEnvironment()
            || resultNominalSyntaxID < 0 - 1 || resultNominalSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
            || compilerIntTableValue(table: tables.macroResults, row: row, column: 9) < 0
            || parentResultRow < 0 - 1 || parentResultRow >= row
            || childOrdinal < 0
            || (parentResultRow < 0 && childOrdinal != 0)
            || (parentResultRow >= 0
                && (compilerIntTableValue(table: tables.macroResults, row: parentResultRow, column: 1) != resultInvocationRow
                    || compilerIntTableValue(table: tables.macroResults, row: parentResultRow, column: 2) != resultApplicationRow
                    || compilerIntTableValue(table: tables.macroResults, row: parentResultRow, column: 3) != resultDeclarationRow
                    || childOrdinal >= compilerIntTableValue(table: tables.macroResults, row: parentResultRow, column: 9)))
            || compilerIntTableValue(table: tables.macroInvocations, row: resultInvocationRow, column: 1) != resultApplicationRow
            || compilerIntTableValue(table: tables.macroInvocations, row: resultInvocationRow, column: 2) != resultDeclarationRow
            || compilerIntTableValue(table: tables.macroInvocations, row: resultInvocationRow, column: 3) != resultTargetSyntaxID
            || compilerIntTableValue(table: tables.macroInvocations, row: resultInvocationRow, column: 9) != compilerMacroInvocationSuccess() { return false }
        row: row + 1
    }
    return true
}

function compilerFormulaFactsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    if !compilerIntTableIsComplete(table: tables.compilerFormulaFacts) { return false }
    let invocationCount: Int(compilerIntTableRowCount(table: tables.macroInvocations))
    let applicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
    let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.compilerFormulaFacts) {
        let kind: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 1))
        let invocationRow: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 2))
        let applicationRow: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 3))
        let targetSyntaxID: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 4))
        let category: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 5))
        if compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 0) != row
            || (kind != compilerFormulaFactStorage() && kind != compilerFormulaFactLiteral())
            || invocationRow < 0 || invocationRow >= invocationCount
            || applicationRow < 0 || applicationRow >= applicationCount
            || targetSyntaxID < 0 || targetSyntaxID >= syntaxCount
            || compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 1) != applicationRow
            || compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 12) != targetSyntaxID
            || category < 0 - 1 { return false }
        if category >= 0 && kind == compilerFormulaFactStorage()
            && category != compilerFormulaStorageInferred()
            && category != compilerFormulaStorageText() { return false }
        if category >= 0 && kind == compilerFormulaFactLiteral()
            && category != compilerFormulaLiteralNumeric()
            && category != compilerFormulaLiteralDecimal()
            && category != compilerFormulaLiteralText() { return false }
        row: row + 1
    }
    return true
}

function compilerMacroExpansionFragmentPriorSiblingCount(tables: CompilerSyntaxTables, row: Int, templateRow: Int, parentFragmentRow: Int): Int {
    state prior: Int(0)
    state count: Int(0)
    while prior < row {
        if compilerIntTableValue(table: tables.macroExpansionFragments, row: prior, column: 1) == templateRow
            && compilerIntTableValue(table: tables.macroExpansionFragments, row: prior, column: 2) == parentFragmentRow {
            count: count + 1
        }
        prior: prior + 1
    }
    return count
}

function compilerMacroExpansionTemplateFragmentsCoverBody(tables: CompilerSyntaxTables, templateRow: Int): Bool {
    let kind: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18))
    if kind != compilerGraphGeneratedKindFunction() { return true }
    let bodyStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 13))
    let bodyEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 14))
    state expectedStart: Int(bodyStart)
    state ordinal: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExpansionFragments) {
        if compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 1) == templateRow
            && compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 2) == 0 - 1 {
            if compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 3) != ordinal
                || compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 6) != expectedStart {
                return false
            }
            expectedStart: compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 7)
            ordinal: ordinal + 1
        }
        row: row + 1
    }
    return expectedStart == bodyEnd
}

function compilerMacroExpansionFragmentIdentityIsValid(tables: CompilerSyntaxTables, row: Int, templateCount: Int): Bool {
    let templateRow: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 1))
    let parentFragmentRow: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 2))
    let kind: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 4))
    if compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 0) != row
        || templateRow < 0 || templateRow >= templateCount
        || parentFragmentRow < 0 - 1 || parentFragmentRow >= row
        || compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 3) != compilerMacroExpansionFragmentPriorSiblingCount(tables: tables, row: row, templateRow: templateRow, parentFragmentRow: parentFragmentRow)
        || (kind != compilerMacroExpansionFragmentAuthored() && kind != compilerMacroExpansionFragmentBoundary() && kind != compilerMacroExpansionFragmentChildMacro()) {
        return false
    }
    return true
}

function compilerMacroExpansionFragmentRangeIsValid(tables: CompilerSyntaxTables, row: Int): Bool {
    let templateRow: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 1))
    let parentFragmentRow: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 2))
    let kind: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 4))
    let fileID: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 5))
    let start: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 6))
    let end: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 7))
    let nameStart: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 8))
    let nameEnd: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 9))
    if fileID != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 2)
        || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: start, end: end, optional: false)
        || start < compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 13)
        || end > compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 14) {
        return false
    }
    if kind == compilerMacroExpansionFragmentAuthored() {
        return parentFragmentRow < 0 && nameStart == 0 - 1 && nameEnd == 0 - 1
    }
    return compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: nameStart, end: nameEnd, optional: false)
}

function compilerMacroExpansionFragmentParentIsValid(tables: CompilerSyntaxTables, row: Int): Bool {
    let parentFragmentRow: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 2))
    let kind: Int(compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 4))
    if parentFragmentRow < 0 { return kind != compilerMacroExpansionFragmentChildMacro() || parentFragmentRow == 0 - 1 }
    return kind == compilerMacroExpansionFragmentBoundary()
        && compilerIntTableValue(table: tables.macroExpansionFragments, row: parentFragmentRow, column: 1) == compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 1)
        && compilerIntTableValue(table: tables.macroExpansionFragments, row: parentFragmentRow, column: 4) == compilerMacroExpansionFragmentChildMacro()
        && compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 6) >= compilerIntTableValue(table: tables.macroExpansionFragments, row: parentFragmentRow, column: 6)
        && compilerIntTableValue(table: tables.macroExpansionFragments, row: row, column: 7) <= compilerIntTableValue(table: tables.macroExpansionFragments, row: parentFragmentRow, column: 7)
}

function compilerMacroExpansionFragmentRowsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let templateCount: Int(compilerIntTableRowCount(table: tables.macroExpansionTemplates))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExpansionFragments) {
        if !compilerMacroExpansionFragmentIdentityIsValid(tables: tables, row: row, templateCount: templateCount)
            || !compilerMacroExpansionFragmentRangeIsValid(tables: tables, row: row)
            || !compilerMacroExpansionFragmentParentIsValid(tables: tables, row: row) { return false }
        row: row + 1
    }
    return true
}

function compilerMacroExpansionFragmentsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    if !compilerIntTableIsComplete(table: tables.macroExpansionFragments)
        || !compilerMacroExpansionFragmentRowsAreStructurallyValid(tables: tables) { return false }
    let templateCount: Int(compilerIntTableRowCount(table: tables.macroExpansionTemplates))
    state templateRow: Int(0)
    while templateRow < templateCount {
        if !compilerMacroExpansionTemplateFragmentsCoverBody(tables: tables, templateRow: templateRow) { return false }
        templateRow: templateRow + 1
    }
    return true
}

function compilerMacroExpansionArtifactsAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    if !compilerIntTableIsComplete(table: tables.macroExpansionArtifacts) { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroExpansionArtifacts) {
        let invocationRow: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 1))
        let applicationRow: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 2))
        let templateRow: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 3))
        let fileID: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 4))
        let start: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 5))
        let end: Int(compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 6))
        state expectedOrdinal: Int(0)
        state priorRow: Int(0)
        while priorRow < row {
            if compilerIntTableValue(table: tables.macroExpansionArtifacts, row: priorRow, column: 1) == invocationRow {
                expectedOrdinal: expectedOrdinal + 1
            }
            priorRow: priorRow + 1
        }
        if compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 0) != row
            || invocationRow < 0 || invocationRow >= compilerIntTableRowCount(table: tables.macroInvocations)
            || applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications)
            || templateRow < 0 || templateRow >= compilerIntTableRowCount(table: tables.macroExpansionTemplates)
            || compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 18) != compilerMacroExpansionTemplateKindOpaqueSyntax()
            || compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 1) != applicationRow
            || fileID != compilerIntTableValue(table: tables.macroExpansionTemplates, row: templateRow, column: 2)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: start, end: end, optional: false)
            || compilerIntTableValue(table: tables.macroExpansionArtifacts, row: row, column: 7) != expectedOrdinal {
            return false
        }
        row: row + 1
    }
    return true
}

function compilerMacroTablesAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    return compilerMacroDeclarationsAreStructurallyValid(tables: tables)
        && compilerMacroParametersAreStructurallyValid(tables: tables)
        && compilerMacroApplicationsAreStructurallyValid(tables: tables)
        && compilerMacroEdgesAreStructurallyValid(tables: tables)
        && compilerMacroDiagnosticsAreStructurallyValid(tables: tables)
        && compilerMacroCapabilitiesAreStructurallyValid(tables: tables)
        && compilerMacroExpansionTemplatesAreStructurallyValid(tables: tables)
        && compilerMacroExpansionFragmentsAreStructurallyValid(tables: tables)
        && compilerMacroExpansionArtifactsAreStructurallyValid(tables: tables)
        && compilerMacroExecutionTablesAreStructurallyValid(tables: tables)
        && compilerFormulaFactsAreStructurallyValid(tables: tables)
}

function compilerMacroExpansionTemplateStructuralFailure(tables: CompilerSyntaxTables, row: Int, reason: Int): Bool {
    state fileID: Int(0 - 1)
    state start: Int(0 - 1)
    state end: Int(0 - 1)
    if row >= 0 && row < compilerIntTableRowCount(table: tables.macroExpansionTemplates) {
        fileID: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 2)
        start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 5)
        end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 6)
    }
    compilerSyntaxTablesFailureAnnotate(tables: tables, phase: compilerSyntaxFailurePhaseStructuralValidation(), reason: reason, fileID: fileID, start: start, end: end, relatedRow: row)
    return false
}

function compilerMacroExpansionTemplatesAreStructurallyValid(tables: CompilerSyntaxTables): Bool {
    let rowCount: Int(compilerIntTableRowCount(table: tables.macroExpansionTemplates))
    state row: Int(0)
    while row < rowCount {
        let macroRow: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 1))
        let fileID: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 2))
        let ordinal: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 15))
        let kindTag: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 18))
        let placement: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 19))
        let lexicalParent: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 20))
        let targetSpliceStart: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 21))
        let targetSpliceEnd: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 22))
        let targetSpliceFingerprintFirst: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 23))
        let targetSpliceFingerprintSecond: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 24))
        let lexicalParentOrdinal: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 25))
        let memberKind: Int(compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 26))
        state rangesValid: Bool(false)
        if kindTag == compilerGraphGeneratedKindFunction() || kindTag == compilerMacroExpansionTemplateKindExtension() {
            rangesValid: compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 9), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 10), optional: false)
                && compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 11), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 12), optional: false)
                && compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 13), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 14), optional: false)
                && memberKind == 0 - 1
        } else if kindTag == compilerMacroExpansionTemplateKindMember() {
            rangesValid: compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 9), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 10), optional: true)
                && compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 11), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 12), optional: false)
                && compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 13), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 14), optional: true)
                && (memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState())
        } else if kindTag == compilerMacroExpansionTemplateKindOpaqueSyntax() {
            rangesValid: compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 9), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 10), optional: true)
                && compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 11), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 12), optional: true)
                && compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 13), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 14), optional: true)
                && memberKind == 0
        }
        if compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 0) != row
            || macroRow < 0 || macroRow >= compilerIntTableRowCount(table: tables.macroDeclarations)
            || fileID < 0 || fileID >= compilerSourceStoreFileCount(store: tables.sourceStore)
            || (kindTag != compilerGraphGeneratedKindFunction() && kindTag != compilerMacroExpansionTemplateKindExtension() && kindTag != compilerMacroExpansionTemplateKindMember() && kindTag != compilerMacroExpansionTemplateKindOpaqueSyntax())
            || (placement != compilerMacroExpansionTemplatePlacementRoot() && placement != compilerMacroExpansionTemplatePlacementMember())
            || ordinal != compilerMacroExpansionTemplatePriorCount(tables: tables, row: row, macroDeclarationRow: macroRow)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 3), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 4), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 5), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 6), optional: false)
            || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 7), end: compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 8), optional: false)
            || !rangesValid
            || (compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 16) == 0 && compilerIntTableValue(table: tables.macroExpansionTemplates, row: row, column: 17) == 0) {
            return compilerMacroExpansionTemplateStructuralFailure(tables: tables, row: row, reason: compilerSyntaxFailureReasonInvalidMacroTemplateShape())
        }
        if kindTag == compilerMacroExpansionTemplateKindExtension() {
            if placement != compilerMacroExpansionTemplatePlacementMember()
                || lexicalParent != 0 - 1
                || lexicalParentOrdinal != 0 - 1
                || !compilerMacroLocalRangeIsValid(tables: tables, fileID: fileID, start: targetSpliceStart, end: targetSpliceEnd, optional: false)
                || (targetSpliceFingerprintFirst == 0 && targetSpliceFingerprintSecond == 0) {
                return compilerMacroExpansionTemplateStructuralFailure(tables: tables, row: row, reason: compilerSyntaxFailureReasonInvalidMacroTemplatePlacement())
            }
            let targetSpliceGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: targetSpliceStart))
            let maybeTargetSplice: Optional<CompilerSourceRange>(compilerMacroExpansionTargetSplice(source: tables.sourceStore.source, start: targetSpliceGlobalStart))
            if maybeTargetSplice == nil { return compilerMacroExpansionTemplateStructuralFailure(tables: tables, row: row, reason: compilerSyntaxFailureReasonInvalidMacroTemplateTarget()) }
            let targetSplice: CompilerSourceRange(maybeTargetSplice ?? CompilerSourceRange(start: targetSpliceGlobalStart, end: targetSpliceGlobalStart, next: targetSpliceGlobalStart))
            if compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: targetSplice.start) != targetSpliceStart
                || compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: targetSplice.end) != targetSpliceEnd { return compilerMacroExpansionTemplateStructuralFailure(tables: tables, row: row, reason: compilerSyntaxFailureReasonInvalidMacroTemplateTarget()) }
        } else if placement == compilerMacroExpansionTemplatePlacementRoot() {
            if lexicalParent != 0 - 1 || targetSpliceStart != 0 - 1 || targetSpliceEnd != 0 - 1
                || targetSpliceFingerprintFirst != 0 || targetSpliceFingerprintSecond != 0
                || lexicalParentOrdinal != 0 - 1 { return compilerMacroExpansionTemplateStructuralFailure(tables: tables, row: row, reason: compilerSyntaxFailureReasonInvalidMacroTemplateParent()) }
        } else {
            if lexicalParent < 0 || lexicalParent >= row
                || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 18) != compilerMacroExpansionTemplateKindExtension()
                || compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 1) != macroRow
                || lexicalParentOrdinal != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 15)
                || targetSpliceStart != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 21)
                || targetSpliceEnd != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 22)
                || targetSpliceFingerprintFirst != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 23)
                || targetSpliceFingerprintSecond != compilerIntTableValue(table: tables.macroExpansionTemplates, row: lexicalParent, column: 24) { return compilerMacroExpansionTemplateStructuralFailure(tables: tables, row: row, reason: compilerSyntaxFailureReasonInvalidMacroTemplateParent()) }
        }
        row: row + 1
    }
    return true
}

function compilerMacroExpansionTemplatePriorCount(tables: CompilerSyntaxTables, row: Int, macroDeclarationRow: Int): Int {
    state priorRow: Int(0)
    state count: Int(0)
    while priorRow < row {
        if compilerIntTableValue(table: tables.macroExpansionTemplates, row: priorRow, column: 1) == macroDeclarationRow { count: count + 1 }
        priorRow: priorRow + 1
    }
    return count
}

function compilerMacroSyntaxNodeFileID(tables: CompilerSyntaxTables, syntaxID: Int): Int {
    let kindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0))
