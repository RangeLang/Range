        if token.kind == .leftBrace {
            let maybeRange: Optional<CompilerSourceRange>(compilerCoreParseBalancedRange(cursor: CompilerTokenCursor(source: $source, index: token.start), leftKind: .leftBrace, rightKind: .rightBrace))
