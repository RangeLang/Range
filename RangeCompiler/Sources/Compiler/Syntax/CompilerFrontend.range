        let prefixResultValueID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationResultColumn()))
        let prefixOperandCount: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()))
        state prefixScalarResult: Int(0)
        if prefixOperandCount != 1 || operandValueID < 0 || operandValueID >= evaluationValues.count {
