                                || syntaxMemberKind == compilerSyntaxMemberKindBinding()
                                || syntaxMemberKind == compilerSyntaxMemberKindDerived()) {
                            let syntaxMemberStoreValueID: Int(compilerMacroValueStoreAppend(
                                store: store,
                                kind: compilerMacroValueKindSyntax(),
                                typeKind: compilerBodyTypeMacroTarget(),
                                typeID: 0 - 1,
                                scalar: compilerIntTableValue(table: arena.tables.members, row: syntaxMemberRow, column: 0),
                                firstChild: store.children.count,
