}

function compilerBodyLLVMBranchTarget(arena: CompilerBodyArena, blockID: Int): Int {
    let fallthroughTarget: Int(compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeFallthrough()))
    if fallthroughTarget >= 0 { return fallthroughTarget }
    return compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeBackedge())
}

function compilerBodyMIROperationOperandValueID(arena: CompilerBodyArena, operationID: Int, ordinal: Int): Int {
