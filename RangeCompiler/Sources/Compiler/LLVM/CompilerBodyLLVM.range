function compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: CompilerBodyLLVMEmitter, blockID: Int, visited: RawBuffer): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: emitter.arena.mirBlocks) { return 0 - 1 }
    if rawBufferLoadInt(buffer: visited, index: blockID) == 1 { return 0 }
    if blockID != 0 && !compilerBodyLLVMAllForwardPredecessorsVisited(arena: emitter.arena, blockID: blockID, visited: visited) { return 0 }
    if rawBufferStoreInt(buffer: visited, index: blockID, value: 1) != 0 { return 0 - 1 }
    let firstOperation: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: blockID, column: compilerBodyMIRBlockFirstOperationColumn()))
    let operationCount: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: blockID, column: compilerBodyMIRBlockOperationCountColumn()))
    state operationOffset: Int(0)
    while operationOffset + 1 < operationCount {
        if compilerBodyLLVMEmitterPlanOperation(emitter: emitter, operationID: firstOperation + operationOffset) != 0 { return 0 - 1 }
        operationOffset: operationOffset + 1
    }
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: firstOperation + operationCount - 1, column: compilerBodyMIROperationKindColumn()))
    if terminatorKind == compilerBodyMIROperationCondBranch() {
        let trueBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: blockID, outcome: compilerBodyControlOutcomeTrue()))
        let falseBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: blockID, outcome: compilerBodyControlOutcomeFalse()))
        if compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: trueBlockID, visited: visited) != 0 { return 0 - 1 }
        return compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: falseBlockID, visited: visited)
    }
    if terminatorKind == compilerBodyMIROperationBranch() {
        return compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: blockID), visited: visited)
    }
    return 0
}

function compilerBodyLLVMEmitterProcessOperation(emitter: CompilerBodyLLVMEmitter, operationID: Int): Int {
