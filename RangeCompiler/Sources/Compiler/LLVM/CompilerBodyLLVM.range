        let rightValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1))
        let leftValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: leftValueID))
        let rightValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: rightValueID))
        let comparesOptionalNil: Bool(compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: leftValueID, operationKind: compilerBodyMIROperationOptionalNone()) || compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: rightValueID, operationKind: compilerBodyMIROperationOptionalNone()))
        if comparesOptionalNil {
