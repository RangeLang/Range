function compilerBodyArenaEntryReturnsInt(arena: CompilerBodyArena): Bool {
    if !compilerBodyArenaIsEntry(arena: arena) { return false }
    state returnCount: Int(0)
    state operationRow: Int(0)
    while operationRow < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationKindColumn()) == compilerBodyMIROperationReturn() {
            let returnValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: operationRow, ordinal: 0))
            if returnValueID < 0 || returnValueID >= compilerIntTableRowCount(table: arena.mirValues) { return false }
            let returnTypeKind: Int(compilerIntTableValue(table: arena.mirValues, row: returnValueID, column: compilerBodyMIRValueTypeColumn()))
            if returnTypeKind != compilerBodyTypeInt() && returnTypeKind != compilerBodyTypeBool() { return false }
            returnCount: returnCount + 1
        }
        operationRow: operationRow + 1
    }
    return returnCount > 0
}

function compilerCoreLLVMLowerEntryTyped(context: CompilerLLVMLoweringContext, reachability: CompilerReachableLLVMState, initialTemporaryIndex: Int, abiPlan: CompilerModuleABIPlan): CompilerTypedBodyLowering {
    let arena: CompilerBodyArena(compilerBodyArenaParseFunction(arena: compilerBodyArenaCreateEntry(tables: context.tables, index: context.declarationIndex)))
    let failureBlock: CompilerLLVMLoweredBlock(compilerCoreLLVMTypedEntryFailureBlock(arena: arena, initialTemporaryIndex: initialTemporaryIndex))
    state valid: Bool(compilerBodyArenaIsValid(arena: arena))
    state failureStage: Int(1)
    if valid {
        if compilerBodyArenaBuildSymbolsAndResolutions(arena: arena, index: context.declarationIndex) != 0 { valid: false } else { failureStage: 2 }
    }
    if valid {
        if !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena) { valid: false } else { failureStage: 3 }
    }
    if valid {
        if compilerReachableLLVMStateBindPlannedFunctionInstancesForArena(typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, arena: arena) != 0 { valid: false } else { failureStage: 9 }
    }
    if valid {
        if compilerBodyArenaHasUnplannedRepresentationSensitiveCall(arena: arena, abiPlan: abiPlan) { valid: false } else { failureStage: 4 }
    }
    if valid {
        if compilerBodyArenaBuildCFG(arena: arena) != 0 { valid: false } else { failureStage: 5 }
    }
    if valid {
        if !compilerBodyArenaCFGIsValid(arena: arena) { valid: false } else { failureStage: 6 }
    }
    if valid {
        let memoryStatus: Int(compilerBodyMemoryBuildAndFreeze(arena: arena, abiPlan: abiPlan, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, effects: reachability.functionInstanceEffects, effectPaths: reachability.functionInstanceEffectPaths, returnSummaries: reachability.functionInstanceReturnSummaries, returnLeaves: reachability.functionInstanceReturnLeaves, applyInstanceEffects: true, recordOwnedFacts: true))
        if memoryStatus != 0 {
            failureStage: 6000 + memoryStatus
            valid: false
        } else { failureStage: 7 }
    }
    if valid {
        let mirBuildStatus: Int(compilerBodyMIRBuild(arena: arena))
        if mirBuildStatus != 0 {
            failureStage: 7000000 + (0 - mirBuildStatus)
            valid: false
        } else { failureStage: 8 }
    }
    if valid {
        let validationCode: Int(compilerBodyMIRValidationCode(arena: arena, abiPlan: abiPlan))
        if validationCode != 0 {
            failureStage: 9000 + validationCode
            valid: false
        } else { failureStage: 9 }
    }
    if valid {
        if !compilerBodyArenaEntryReturnsInt(arena: arena) {
            failureStage: 10
            valid: false
        }
    }
    state emission: CompilerBodyLLVMEmissionResult(block: failureBlock, renderedGlobals: String(""), runtimeRequirements: 0, isValid: false)
    if valid { emission: compilerBodyLLVMEmit(arena: arena, initialTemporary: initialTemporaryIndex, initialBranch: 0, abiPlan: abiPlan, typeKeys: reachability.typeKeys, typeKeyArguments: reachability.typeKeyArguments, functionInstances: reachability.functionInstances, functionInstanceSignatures: reachability.functionInstanceSignatures, functionInstanceSignatureParameters: reachability.functionInstanceSignatureParameters) }
    if valid && !emission.isValid {
        failureStage: 11
        valid: false
    }
    state loweredBlock: CompilerLLVMLoweredBlock(failureBlock)
    state renderedGlobals: String("")
    state runtimeRequirements: Int(0)
    if valid {
        loweredBlock: emission.block
        renderedGlobals: emission.renderedGlobals
        runtimeRequirements: emission.runtimeRequirements
    }
    let destroyStatus: Int(compilerBodyArenaDestroy(arena: arena))
    if destroyStatus != 0 {
        valid: false
        failureStage: 12
    }
    if !valid {
        return CompilerTypedBodyLowering(block: failureBlock, renderedGlobals: String(""), runtimeRequirements: 0, telemetry: CompilerBodyTelemetry(supportedCount: 0, typedParseAttempts: 1, typedParseSuccesses: 0, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: 1), failureStage: failureStage, functionName: String(""), returnLLVMType: String(""), parameterText: String(""), isValid: false)
    }
    return CompilerTypedBodyLowering(block: loweredBlock, renderedGlobals: renderedGlobals, runtimeRequirements: runtimeRequirements, telemetry: CompilerBodyTelemetry(supportedCount: 1, typedParseAttempts: 1, typedParseSuccesses: 1, legacyParses: 0, arenaCreates: 1, arenaDestroys: 1, recordBytes: 0, committedFailures: 0), failureStage: 0, functionName: String(""), returnLLVMType: String(""), parameterText: String(""), isValid: true)
}

