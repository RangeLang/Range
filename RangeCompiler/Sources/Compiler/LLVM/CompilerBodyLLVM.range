        } else if leftValue.typeName == String("ptr") && rightValue.typeName == String("ptr") {
            resultTemporary: plannedTemporary + 1
            consumedTemporaryCount: 2
            if rawBufferLoadInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements()) < compilerBodyLLVMRuntimeStringEqual()
                && rawBufferStoreInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements(), value: compilerBodyLLVMRuntimeStringEqual()) != 0 { return 0 - 1 }
