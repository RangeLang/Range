function compilerBodyLLVMEmitterCreate(arena: CompilerBodyArena, initialTemporary: Int, initialBranch: Int, abiPlan: CompilerModuleABIPlan, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, functionInstances: CompilerIntTable, functionInstanceSignatures: CompilerIntTable, functionInstanceSignatureParameters: CompilerIntTable): CompilerBodyLLVMEmitter {
    let emitterState: RawBuffer(rawBufferCreate(capacity: compilerBodyLLVMEmitterStateCount(), stride: 4))
    rawBufferAppendInt(buffer: emitterState, value: initialTemporary)
    rawBufferAppendInt(buffer: emitterState, value: initialBranch)
    rawBufferAppendInt(buffer: emitterState, value: 1)
    rawBufferAppendInt(buffer: emitterState, value: 0)
    rawBufferAppendInt(buffer: emitterState, value: 0)
    let valueAssignments: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyLLVMValueAssignmentColumnCount(), estimatedRowCount: 128))
    let blockLabels: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyLLVMBlockLabelColumnCount(), estimatedRowCount: 32))
    let globalDescriptors: CompilerIntTable(compilerIntTableCreate(columnCount: compilerBodyLLVMGlobalDescriptorColumnCount(), estimatedRowCount: 16))
    let renderedBlocks: RawBuffer(rawBufferCreate(capacity: 4096, stride: 1))
    let created: CompilerBodyLLVMEmitter(arena: $arena, abiPlan: $abiPlan, typeKeys: $typeKeys, typeKeyArguments: $typeKeyArguments, functionInstances: $functionInstances, functionInstanceSignatures: $functionInstanceSignatures, functionInstanceSignatureParameters: $functionInstanceSignatureParameters, valueAssignments: valueAssignments, blockLabels: blockLabels, runtimeState: emitterState, globalDescriptors: globalDescriptors, renderedBlocks: renderedBlocks)
    return created
}

function compilerBodyLLVMEmitterDestroy(emitter: CompilerBodyLLVMEmitter): Int {
    let assignmentStatus: Int(compilerIntTableDestroy(table: emitter.valueAssignments))
    let labelStatus: Int(compilerIntTableDestroy(table: emitter.blockLabels))
    let stateStatus: Int(rawBufferDestroy(buffer: emitter.runtimeState))
    let globalStatus: Int(compilerIntTableDestroy(table: emitter.globalDescriptors))
    let blockStatus: Int(rawBufferDestroy(buffer: emitter.renderedBlocks))
    if assignmentStatus != 0 || labelStatus != 0 || stateStatus != 0 || globalStatus != 0 || blockStatus != 0 { return 0 - 1 }
    return 0
}

function compilerBodyLLVMAllForwardPredecessorsVisited(arena: CompilerBodyArena, blockID: Int, visited: RawBuffer): Bool {
    state ordinal: Int(0)
    let count: Int(compilerBodyMIRForwardPredecessorCount(arena: arena, blockID: blockID))
    while ordinal < count {
        let predecessorBlockID: Int(compilerBodyMIRForwardPredecessorAt(arena: arena, blockID: blockID, ordinal: ordinal))
        if predecessorBlockID < 0 || rawBufferLoadInt(buffer: visited, index: predecessorBlockID) != 1 { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyLLVMAppendValueAssignment(emitter: CompilerBodyLLVMEmitter, valueID: Int, kind: Int, number: Int, aux: Int): Int {
    if compilerIntTableAppend(table: emitter.valueAssignments, value: valueID) != 0
        || compilerIntTableAppend(table: emitter.valueAssignments, value: kind) != 0
        || compilerIntTableAppend(table: emitter.valueAssignments, value: number) != 0
        || compilerIntTableAppend(table: emitter.valueAssignments, value: aux) != 0 { return 0 - 1 }
    return 0
}

function compilerBodyLLVMValueAssignmentRow(emitter: CompilerBodyLLVMEmitter, valueID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: emitter.valueAssignments) {
        if compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentValueColumn()) == valueID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyLLVMTypeName(typeKind: Int): String {
    if typeKind == compilerBodyTypeInt() { return String("i32") }
    if typeKind == compilerBodyTypeUnsigned8() { return String("i8") }
    if typeKind == compilerBodyTypeBool() { return String("i1") }
    if typeKind == compilerBodyTypeFloat() { return String("double") }
    if typeKind == compilerBodyTypeFloat32() { return String("float") }
    if typeKind == compilerBodyTypeString() { return String("ptr") }
    if typeKind == compilerBodyTypeEnum() { return String("i32") }
    return String("ptr")
}

function compilerBodyLLVMTypeNameForTypeID(arena: CompilerBodyArena, typeID: Int): String {
    let typeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: typeID))
    if typeKind == compilerBodyTypeConstruct() || typeKind == compilerBodyTypeEnum() {
        let nominalName: String(compilerBodyLLVMNominalTypeNameForTypeID(arena: arena, typeID: typeID))
        if nominalName != String("") { return nominalName }
    }
    if typeKind == compilerBodyTypeUnknown() { return String("") }
    return compilerBodyLLVMTypeName(typeKind: typeKind)
}

function compilerBodyLLVMNominalTypeNameForTypeID(arena: CompilerBodyArena, typeID: Int): String {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return String("") }
    if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: typeID) { return String("%Range.Array") }
    let typeFileID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceFileColumn()))
    let typeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: typeFileID, localStart: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceStartColumn()), localEnd: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceEndColumn())))
    let optionalTypeName: String(compilerSpecializedOptionalLLVMTypeName(tables: arena.tables, index: arena.declarationIndex, typeName: typeName))
    if optionalTypeName != String("") { return optionalTypeName }
    let syntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: syntaxID))
    if declarationRow < 0 { return String("") }
    if compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindEnum() {
        return compilerEnumLLVMTypeName(tables: arena.tables, declarationRow: declarationRow)
    }
    return compilerNominalLLVMTypeName(tables: arena.tables, declarationRow: declarationRow)
}

function compilerBodyLLVMStorageTypeName(arena: CompilerBodyArena, storageID: Int): String {
    if storageID < 0 || storageID >= compilerIntTableRowCount(table: arena.storages) { return String("") }
    return compilerBodyLLVMNominalTypeNameForTypeID(arena: arena, typeID: compilerIntTableValue(table: arena.storages, row: storageID, column: compilerBodyStorageTypeIDColumn()))
}

function compilerBodyLLVMValueTypeName(arena: CompilerBodyArena, valueID: Int): String {
    if compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueKindColumn()) == compilerBodyMIRValueReceiverAddress() { return String("ptr") }
    let typeKind: Int(compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeColumn()))
    let payloadProducerOperationID: Int(compilerBodyMIRValueProducerOperation(arena: arena, valueID: valueID, operationKind: compilerBodyMIROperationEnumPayload()))
    if payloadProducerOperationID >= 0 {
        let payloadRow: Int(compilerIntTableValue(table: arena.mirOperations, row: payloadProducerOperationID, column: compilerBodyMIROperationTargetIDColumn()))
        if payloadRow >= 0 && payloadRow < compilerIntTableRowCount(table: arena.tables.members) {
            let storagePolicy: Int(compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 13))
            if storagePolicy == compilerSyntaxMemberStorageBinding() || storagePolicy == compilerSyntaxMemberStorageIndirect() { return String("ptr") }
        }
    }
    if typeKind == compilerBodyTypeConstruct() || typeKind == compilerBodyTypeEnum() {
        let nominalName: String(compilerBodyLLVMNominalTypeNameForTypeID(arena: arena, typeID: compilerIntTableValue(table: arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeIDColumn())))
        if nominalName != String("") { return nominalName }
    }
    return compilerBodyLLVMTypeName(typeKind: typeKind)
}

function compilerBodyLLVMValue(emitter: CompilerBodyLLVMEmitter, valueID: Int): CompilerLLVMValue {
    let row: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: valueID))
    if row < 0 { return CompilerLLVMValue(text: String(""), typeName: String("")) }
    let kind: Int(compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentKindColumn()))
    let number: Int(compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentNumberColumn()))
    let aux: Int(compilerIntTableValue(table: emitter.valueAssignments, row: row, column: compilerBodyLLVMValueAssignmentAuxColumn()))
    state typeName: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: valueID))
    if kind == compilerBodyLLVMValueParameter()
        && !compilerBodyArenaOwnerIsParticipant(arena: emitter.arena, plan: emitter.abiPlan) {
        typeName: compilerBodyLLVMTypeName(typeKind: compilerIntTableValue(table: emitter.arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeColumn()))
    }
    if kind == compilerBodyLLVMValueReceiverPointer() || kind == compilerBodyLLVMValueStoragePointer() {
        typeName: String("ptr")
    }
    if kind == compilerBodyLLVMValueImmediate() {
        let sourceNodeID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueID, column: compilerBodyMIRValueSourceColumn()))
        state sourceIsEnumCase: Bool(false)
        if sourceNodeID >= 0 && sourceNodeID < compilerIntTableRowCount(table: emitter.arena.nodes) {
            sourceIsEnumCase: compilerIntTableValue(table: emitter.arena.nodes, row: sourceNodeID, column: 1) == compilerSyntaxKindEnumCaseValue()
        }
        if sourceIsEnumCase {
            let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: emitter.arena, sourceNodeID: sourceNodeID))
            if resolutionRow < 0 { return CompilerLLVMValue(text: String(""), typeName: String("")) }
            let memberRow: Int(compilerIntTableValue(table: emitter.arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
            if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: emitter.arena.tables.members) { return CompilerLLVMValue(text: String(""), typeName: String("")) }
            return CompilerLLVMValue(text: "\(compilerIntTableValue(table: emitter.arena.tables.members, row: memberRow, column: 3))", typeName: typeName)
        }
        return CompilerLLVMValue(text: compilerBodyArenaNodeText(arena: emitter.arena, nodeID: sourceNodeID), typeName: typeName)
    }
    if kind == compilerBodyLLVMValueParameter() {
        let symbolID: Int(aux)
        let name: String(compilerBodyArenaSymbolName(arena: emitter.arena, symbolID: symbolID))
        if compilerIntTableValue(table: emitter.arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolReceiver() {
            return CompilerLLVMValue(text: String("%self"), typeName: String("ptr"))
        }
        return CompilerLLVMValue(text: "%\(name)", typeName: typeName)
    }
    if kind == compilerBodyLLVMValueReceiverPointer() { return CompilerLLVMValue(text: String("%self"), typeName: String("ptr")) }
    if kind == compilerBodyLLVMValueStoragePointer() { return CompilerLLVMValue(text: "%storage\(aux)", typeName: String("ptr")) }
    if kind == compilerBodyLLVMValueTemporary() { return CompilerLLVMValue(text: "%r\(number)", typeName: typeName) }
    if kind == compilerBodyLLVMValueGlobalString() { return CompilerLLVMValue(text: "getelementptr inbounds ([\(aux) x i8], ptr @.str.\(number), i32 0, i32 0)", typeName: String("ptr")) }
    if kind == compilerBodyLLVMValueAlias() { return compilerBodyLLVMValue(emitter: emitter, valueID: aux) }
    return CompilerLLVMValue(text: String(""), typeName: String(""))
}

function compilerBodyLLVMEmitterAppendInstruction(emitter: CompilerBodyLLVMEmitter, instruction: CompilerLLVMInstruction): Int {
    state rendered: String("")
    if instruction.operation == String("call") {
        rendered: "\(instruction.result) = call \(instruction.typeName) @\(instruction.left)(\(instruction.right))"
    } else if instruction.operation == String("puts") {
        rendered: "\(instruction.result) = call i32 @puts(ptr \(instruction.left))"
    } else if instruction.operation == String("phi") {
        rendered: "\(instruction.result) = phi \(instruction.typeName) \(instruction.left), \(instruction.right)"
    } else {
        rendered: "\(instruction.result) = \(instruction.operation) \(instruction.typeName) \(instruction.left), \(instruction.right)"
    }
    return rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  \(rendered)\n")
}

function compilerBodyArenaTypeStructuralFingerprint(arena: CompilerBodyArena, typeID: Int): CompilerFingerprint {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return CompilerFingerprint(first: 0, second: 0) }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    let typeKind: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: typeKind)
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if nominalSyntaxID == compilerBodyBuiltinArraySyntaxID() {
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: nominalSyntaxID)
    } else if nominalSyntaxID >= 0 {
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: nominalSyntaxID))
        if declarationRow < 0 { return CompilerFingerprint(first: 0, second: 0) }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 11))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 12))
    }
    let argumentCount: Int(compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentCount)
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let argumentTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: typeID, ordinal: ordinal))
        let argumentFingerprint: CompilerFingerprint(compilerBodyArenaTypeStructuralFingerprint(arena: arena, typeID: argumentTypeID))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentFingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentFingerprint.second)
        ordinal: ordinal + 1
    }
    return fingerprint
}

function compilerBodyLLVMFunctionName(arena: CompilerBodyArena, functionID: Int): String {
    let syntaxID: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: syntaxID))
    let fileID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 1))
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 8))
}

function compilerBodyLLVMFunctionNameForReceiver(arena: CompilerBodyArena, functionID: Int, receiverTypeID: Int): String {
    let baseName: String(compilerBodyLLVMFunctionName(arena: arena, functionID: functionID))
    if functionID < 0 || functionID >= rawBufferCount(buffer: arena.tables.functionOwners) || receiverTypeID < 0 { return baseName }
    let ownerSyntaxID: Int(rawBufferLoadInt(buffer: arena.tables.functionOwners, index: functionID))
    if ownerSyntaxID < 0 || compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: ownerSyntaxID) <= 0 { return baseName }
    let fingerprint: CompilerFingerprint(compilerBodyArenaTypeStructuralFingerprint(arena: arena, typeID: receiverTypeID))
    return "\(baseName)__ri\(fingerprint.first)_\(fingerprint.second)"
}

function compilerBodyLLVMFunctionNameForInstance(arena: CompilerBodyArena, functionID: Int, instanceID: Int, functionInstances: CompilerIntTable): String {
    let baseName: String(compilerBodyLLVMFunctionName(arena: arena, functionID: functionID))
    if functionID < 0 || instanceID < 0 || instanceID >= compilerIntTableRowCount(table: functionInstances) { return baseName }
    if compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn()) != functionID { return String("") }
    let receiverKeyID: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceReceiverKeyColumn()))
    if receiverKeyID < 0 { return baseName }
    let first: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFingerprintFirstColumn()))
    let second: Int(compilerIntTableValue(table: functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFingerprintSecondColumn()))
    return "\(baseName)__ri\(first)_\(second)"
}

function compilerBodyLLVMCallReceiverTypeID(arena: CompilerBodyArena, operationID: Int, targetFunctionID: Int): Int {
    if operationID < 0 || operationID >= compilerIntTableRowCount(table: arena.mirOperations) || targetFunctionID < 0 || targetFunctionID >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - 1 }
    let sourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationSourceColumn()))
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    if calleeNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    let receiverResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: receiverNodeID))
    if receiverResolutionRow < 0 || compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTypeKindColumn()) != compilerBodyTypeConstruct() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: receiverResolutionRow, column: compilerBodyResolutionTypeIDColumn())
}

function compilerBodyLLVMCallResolutionTypeID(arena: CompilerBodyArena, operationID: Int): Int {
    if operationID < 0 || operationID >= compilerIntTableRowCount(table: arena.mirOperations) { return 0 - 1 }
    let sourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationSourceColumn()))
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    if calleeNodeID < 0 { return 0 - 1 }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionFunction() { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())
}

function compilerBodyLLVMCallTargetInstanceIsValid(emitter: CompilerBodyLLVMEmitter, operationID: Int, targetFunctionID: Int, resultValueID: Int): Bool {
    if operationID < 0 || operationID >= compilerIntTableRowCount(table: emitter.arena.mirOperations) || targetFunctionID < 0 || targetFunctionID >= compilerIntTableRowCount(table: emitter.arena.tables.functions) { return false }
    let ownerSyntaxID: Int(rawBufferLoadInt(buffer: emitter.arena.tables.functionOwners, index: targetFunctionID))
    let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: emitter.arena.tables, ownerSyntaxID: ownerSyntaxID))
    let receiverTypeID: Int(compilerBodyLLVMCallReceiverTypeID(arena: emitter.arena, operationID: operationID, targetFunctionID: targetFunctionID))
    let calleeNodeID: Int(compilerBodyArenaChild(arena: emitter.arena, ownerNodeID: compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationSourceColumn()), role: compilerSyntaxRoleCallee(), ordinal: 0))
    let isMemberCall: Bool(calleeNodeID >= 0 && compilerIntTableValue(table: emitter.arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindMemberRead())
    if (ownerSyntaxID >= 0 && !isMemberCall) || (ownerSyntaxID < 0 && isMemberCall) { return false }
    state instanceID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationInstanceIDColumn()))
    state receiverKeyID: Int(0 - 1)
    if genericCount > 0 {
        if receiverTypeID < 0 || instanceID < 0 { return false }
        receiverKeyID: compilerReachableTypeKeyFindFromArena(typeKeys: emitter.typeKeys, typeKeyArguments: emitter.typeKeyArguments, arena: emitter.arena, typeID: receiverTypeID)
        if receiverKeyID < 0 || instanceID >= compilerIntTableRowCount(table: emitter.functionInstances)
            || compilerIntTableValue(table: emitter.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceFunctionColumn()) != targetFunctionID
            || compilerIntTableValue(table: emitter.functionInstances, row: instanceID, column: compilerReachableFunctionInstanceReceiverKeyColumn()) != receiverKeyID { return false }
    } else {
        let plannedInstanceID: Int(compilerReachablePlannedFunctionInstance(functionInstances: emitter.functionInstances, functionRow: targetFunctionID, receiverTypeKeyID: 0 - 1))
        if plannedInstanceID < 0 || instanceID != plannedInstanceID { return false }
        instanceID: plannedInstanceID
    }
    let signatureRow: Int(compilerReachableFunctionInstanceSignatureRow(signatures: emitter.functionInstanceSignatures, instanceID: instanceID))
    if signatureRow < 0 { return false }
    let expectedParameterCount: Int(compilerIntTableValue(table: emitter.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterCountColumn()))
    let operationOperandCount: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationOperandCountColumn()))
    state explicitOperandStart: Int(0)
    if isMemberCall { explicitOperandStart: 1 }
    if operationOperandCount - explicitOperandStart != expectedParameterCount { return false }
    state operandOrdinal: Int(0)
    while operandOrdinal < expectedParameterCount {
        let valueID: Int(compilerBodyMIROperationOperandValue(arena: emitter.arena, operationID: operationID, ordinal: explicitOperandStart + operandOrdinal))
        let storedParameterRow: Int(compilerIntTableValue(table: emitter.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterFirstRowColumn()) + operandOrdinal)
        if valueID < 0 || valueID >= compilerIntTableRowCount(table: emitter.arena.mirValues) || storedParameterRow < 0 || storedParameterRow >= compilerIntTableRowCount(table: emitter.functionInstanceSignatureParameters) { return false }
        let expectedKind: Int(compilerIntTableValue(table: emitter.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterTypeKindColumn()))
        let expectedCategory: Int(compilerIntTableValue(table: emitter.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterABICategoryColumn()))
        let actualKind: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeColumn()))
        let actualTypeID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueID, column: compilerBodyMIRValueTypeIDColumn()))
        if actualKind != expectedKind || compilerBodyArenaFunctionSignatureABICategory(arena: emitter.arena, typeID: actualTypeID, typeKind: actualKind) != expectedCategory { return false }
        if expectedKind == compilerBodyTypeConstruct() || expectedKind == compilerBodyTypeEnum() {
            let actualKeyID: Int(compilerReachableTypeKeyFindFromArena(typeKeys: emitter.typeKeys, typeKeyArguments: emitter.typeKeyArguments, arena: emitter.arena, typeID: actualTypeID))
            if actualKeyID < 0 || actualKeyID != compilerIntTableValue(table: emitter.functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterTypeKeyColumn()) { return false }
        }
        operandOrdinal: operandOrdinal + 1
    }
    let expectedReturnKind: Int(compilerIntTableValue(table: emitter.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKindColumn()))
    let expectedReturnCategory: Int(compilerIntTableValue(table: emitter.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnABICategoryColumn()))
    let actualReturnKind: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: resultValueID, column: compilerBodyMIRValueTypeColumn()))
    let actualReturnTypeID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: resultValueID, column: compilerBodyMIRValueTypeIDColumn()))
    if actualReturnKind != expectedReturnKind || compilerBodyArenaFunctionSignatureABICategory(arena: emitter.arena, typeID: actualReturnTypeID, typeKind: actualReturnKind) != expectedReturnCategory { return false }
    if expectedReturnKind == compilerBodyTypeConstruct() {
        let actualReturnKeyID: Int(compilerReachableTypeKeyFindFromArena(typeKeys: emitter.typeKeys, typeKeyArguments: emitter.typeKeyArguments, arena: emitter.arena, typeID: actualReturnTypeID))
        if actualReturnKeyID < 0 || actualReturnKeyID != compilerIntTableValue(table: emitter.functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKeyColumn()) { return false }
    }
    if expectedReturnKind == compilerBodyTypeEnum()
        && actualReturnTypeID != compilerBodyLLVMCallResolutionTypeID(arena: emitter.arena, operationID: operationID) { return false }
    return true
}

function compilerBodyArenaSpecializedLLVMTypeName(arena: CompilerBodyArena, typeKind: Int, typeID: Int, fileID: Int, start: Int, end: Int): String {
    if typeKind == compilerBodyTypeInt() || typeKind == compilerBodyTypeUnsigned8() || typeKind == compilerBodyTypeBool() || typeKind == compilerBodyTypeString() || typeKind == compilerBodyTypeFloat() || typeKind == compilerBodyTypeFloat32() { return compilerBodyLLVMTypeName(typeKind: typeKind) }
    if typeKind == compilerBodyTypeEnum() {
        let enumTypeName: String(compilerBodyLLVMNominalTypeNameForTypeID(arena: arena, typeID: typeID))
        if enumTypeName != String("") { return enumTypeName }
        return compilerBodyLLVMTypeName(typeKind: typeKind)
    }
    if typeKind == compilerBodyTypeConstruct() && typeID >= 0 && typeID < compilerIntTableRowCount(table: arena.typeInstances) {
        let specializedTypeName: String(compilerBodyArenaTypeNameForTypeID(arena: arena, typeID: typeID))
        if specializedTypeName != String("") && compilerBodyRuntimeABITypeIsOpaque(tables: arena.tables, typeName: specializedTypeName) { return String("ptr") }
        let specializedNominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
        let specializedDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: arena.tables, syntaxID: specializedNominalSyntaxID))
        if specializedDeclarationRow >= 0 && compilerIntTableValue(table: arena.tables.declarations, row: specializedDeclarationRow, column: 13) == compilerBuiltinPolicyStorage() { return String("ptr") }
    }
    return String("")
}

function compilerBodyArenaSpecializedFunctionParameterText(arena: CompilerBodyArena): String {
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    let receiverTypeID: Int(compilerBodyArenaReceiverTypeID(arena: arena))
    if arena.ownerFunctionRow < 0 || (ownerSyntaxID >= 0 && receiverTypeID < 0) { return String("") }
    let output: RawBuffer(rawBufferCreate(capacity: 256, stride: 1))
    state hasParameter: Bool(false)
    if ownerSyntaxID >= 0 {
        rawBufferAppendText(buffer: output, text: String("ptr %self"))
        hasParameter: true
    }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 3))
    state parameterOrdinal: Int(0)
    state valid: Bool(true)
    while parameterOrdinal < parameterCount && valid {
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterStart: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8))
        let parameterEnd: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9))
        let parameterTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: parameterStart, end: parameterEnd))
        let parameterTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: parameterTypeID))
        let parameterLLVMType: String(compilerBodyArenaSpecializedLLVMTypeName(arena: arena, typeKind: parameterTypeKind, typeID: parameterTypeID, fileID: parameterFileID, start: parameterStart, end: parameterEnd))
        let parameterName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: parameterFileID, localStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 7)))
        if parameterLLVMType == String("") || parameterName == String("") {
            valid: false
        } else {
            if hasParameter { rawBufferAppendText(buffer: output, text: String(", ")) }
            rawBufferAppendText(buffer: output, text: "\(parameterLLVMType) %\(parameterName)")
            hasParameter: true
        }
        parameterOrdinal: parameterOrdinal + 1
    }
    if !valid {
        rawBufferDestroy(buffer: output)
        return String("")
    }
    let result: String(rawBufferMaterializeText(buffer: output))
    rawBufferDestroy(buffer: output)
    return result
}

function compilerBodyArenaSpecializedFunctionReturnLLVMType(arena: CompilerBodyArena): String {
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    let receiverTypeID: Int(compilerBodyArenaReceiverTypeID(arena: arena))
    if arena.ownerFunctionRow < 0 || (ownerSyntaxID >= 0 && receiverTypeID < 0) { return String("") }
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
    let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6))
    let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7))
    let returnTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: returnFileID, start: returnStart, end: returnEnd))
    return compilerBodyArenaSpecializedLLVMTypeName(arena: arena, typeKind: compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID), typeID: returnTypeID, fileID: returnFileID, start: returnStart, end: returnEnd)
}

function compilerBodyArenaFunctionSignatureTypeID(arena: CompilerBodyArena, receiverTypeID: Int, ownerSyntaxID: Int, fileID: Int, start: Int, end: Int): Int {
    if receiverTypeID >= 0 && ownerSyntaxID >= 0 { return compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: fileID, start: start, end: end) }
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: fileID, start: start, end: end)
}

function compilerBodyArenaFunctionSignatureABICategory(arena: CompilerBodyArena, typeID: Int, typeKind: Int): Int {
    if typeKind == compilerBodyTypeInt() { return compilerBodyFunctionSignatureABICategoryInt() }
    if typeKind == compilerBodyTypeUnsigned8() { return compilerBodyFunctionSignatureABICategoryUnsigned8() }
    if typeKind == compilerBodyTypeFloat() { return compilerBodyFunctionSignatureABICategoryFloat() }
    if typeKind == compilerBodyTypeFloat32() { return compilerBodyFunctionSignatureABICategoryFloat32() }
    if typeKind == compilerBodyTypeEnum() {
        if compilerBodyArenaTypeIDHasNativeNominalLayout(arena: arena, typeID: typeID) { return compilerBodyFunctionSignatureABICategoryNone() }
        return compilerBodyFunctionSignatureABICategoryInt()
    }
    if typeKind == compilerBodyTypeBool() { return compilerBodyFunctionSignatureABICategoryBool() }
    if typeKind == compilerBodyTypeString() { return compilerBodyFunctionSignatureABICategoryPointer() }
    if typeKind == compilerBodyTypeConstruct() && compilerBodyArenaSpecializedLLVMTypeName(arena: arena, typeKind: typeKind, typeID: typeID, fileID: 0 - 1, start: 0 - 1, end: 0 - 1) == String("ptr") { return compilerBodyFunctionSignatureABICategoryPointer() }
    return compilerBodyFunctionSignatureABICategoryNone()
}

function compilerBodyArenaFunctionSignatureUsesDirectLLVMTypes(arena: CompilerBodyArena): Bool {
    if arena.ownerFunctionRow < 0 { return false }
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    let receiverTypeID: Int(compilerBodyArenaReceiverTypeID(arena: arena))
    if ownerSyntaxID >= 0 && receiverTypeID < 0 { return false }
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
    let returnTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: returnFileID, start: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6), end: compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7)))
    if returnTypeID < 0
        || compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: returnTypeID, typeKind: compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID)) == compilerBodyFunctionSignatureABICategoryNone() { return false }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 3))
    state parameterOrdinal: Int(0)
    while parameterOrdinal < parameterCount {
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8), end: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9)))
        if parameterTypeID < 0
            || compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: parameterTypeID, typeKind: compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: parameterTypeID)) == compilerBodyFunctionSignatureABICategoryNone() { return false }
        parameterOrdinal: parameterOrdinal + 1
    }
    return true
}

function compilerBodyArenaFunctionSignatureContractIsValid(functionInstanceSignatures: CompilerIntTable, functionInstanceSignatureParameters: CompilerIntTable, instanceID: Int, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, arena: CompilerBodyArena): Bool {
    if instanceID < 0 || arena.ownerFunctionRow < 0 { return false }
    state signatureRow: Int(0 - 1)
    state signatureScanRow: Int(0)
    while signatureScanRow < compilerIntTableRowCount(table: functionInstanceSignatures) {
        if compilerIntTableValue(table: functionInstanceSignatures, row: signatureScanRow, column: compilerReachableFunctionInstanceSignatureIDColumn()) == instanceID { signatureRow: signatureScanRow }
        signatureScanRow: signatureScanRow + 1
    }
    if signatureRow < 0 { return false }
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    let receiverTypeID: Int(compilerBodyArenaReceiverTypeID(arena: arena))
    let functionRow: Int(arena.ownerFunctionRow)
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 1))
    let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 6))
    let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 7))
    let returnTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: returnFileID, start: returnStart, end: returnEnd))
    let returnTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID))
    let returnTypeKeyID: Int(compilerReachableTypeKeyFindFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: returnTypeID))
    if returnTypeID < 0 || returnTypeKeyID < 0
        || compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKeyColumn()) != returnTypeKeyID
        || compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnTypeKindColumn()) != returnTypeKind
        || compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureReturnABICategoryColumn()) != compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: returnTypeID, typeKind: returnTypeKind) { return false }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: functionRow, column: 3))
    let storedParameterCount: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterCountColumn()))
    let storedParameterStart: Int(compilerIntTableValue(table: functionInstanceSignatures, row: signatureRow, column: compilerReachableFunctionInstanceSignatureParameterFirstRowColumn()))
    if parameterCount != storedParameterCount || firstParameterRow < 0 || parameterCount < 0 || firstParameterRow + parameterCount > compilerIntTableRowCount(table: arena.tables.parameters) { return false }
    state parameterOrdinal: Int(0)
    while parameterOrdinal < parameterCount {
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterStart: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8))
        let parameterEnd: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9))
        let parameterTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: parameterStart, end: parameterEnd))
        let parameterTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: parameterTypeID))
        let parameterTypeKeyID: Int(compilerReachableTypeKeyFindFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: parameterTypeID))
        let storedParameterRow: Int(storedParameterStart + parameterOrdinal)
        if parameterTypeID < 0 || parameterTypeKeyID < 0 || storedParameterRow < 0 || storedParameterRow >= compilerIntTableRowCount(table: functionInstanceSignatureParameters)
            || compilerIntTableValue(table: functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterInstanceColumn()) != instanceID
            || compilerIntTableValue(table: functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterOrdinalColumn()) != parameterOrdinal
            || compilerIntTableValue(table: functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterTypeKeyColumn()) != parameterTypeKeyID
            || compilerIntTableValue(table: functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterTypeKindColumn()) != parameterTypeKind
            || compilerIntTableValue(table: functionInstanceSignatureParameters, row: storedParameterRow, column: compilerReachableFunctionInstanceSignatureParameterABICategoryColumn()) != compilerBodyArenaFunctionSignatureABICategory(arena: arena, typeID: parameterTypeID, typeKind: parameterTypeKind) { return false }
        parameterOrdinal: parameterOrdinal + 1
    }
    return true
}

function compilerBodyArenaFunctionSignatureTypeKeyID(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, arena: CompilerBodyArena, typeID: Int, allowIntern: Bool): Int {
    if allowIntern { return compilerReachableTypeKeyInternFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: typeID) }
    return compilerReachableTypeKeyFindFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: typeID)
}

function compilerBodyArenaFunctionSignatureFingerprint(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, arena: CompilerBodyArena, allowIntern: Bool): CompilerFingerprint {
    if arena.ownerKind != compilerBodyArenaOwnerFunction()
        || arena.ownerFunctionRow < 0
        || arena.ownerFunctionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return CompilerFingerprint(first: 0, second: 0) }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    state ownerKindMarker: Int(0)
    if ownerSyntaxID >= 0 { ownerKindMarker: 1 }
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: ownerKindMarker)
    if arena.ownerReceiverTypeID >= 0 {
        let receiverKeyID: Int(compilerBodyArenaFunctionSignatureTypeKeyID(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: arena.ownerReceiverTypeID, allowIntern: allowIntern))
        if receiverKeyID < 0 { return CompilerFingerprint(first: 0, second: 0) }
        let receiverFingerprint: CompilerFingerprint(compilerReachableTypeKeyFingerprint(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, tables: arena.tables, typeKeyID: receiverKeyID))
        if receiverFingerprint.first == 0 && receiverFingerprint.second == 0 { return CompilerFingerprint(first: 0, second: 0) }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: receiverFingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: receiverFingerprint.second)
    }
    let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
    let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6))
    let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7))
    state returnTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: returnFileID, start: returnStart, end: returnEnd))
    let returnTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: returnTypeID))
    if returnTypeID < 0 || returnTypeKind == compilerBodyTypeUnknown() { return CompilerFingerprint(first: 0, second: 0) }
    let returnKeyID: Int(compilerBodyArenaFunctionSignatureTypeKeyID(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: returnTypeID, allowIntern: allowIntern))
    if returnKeyID < 0 { return CompilerFingerprint(first: 0, second: 0) }
    let returnFingerprint: CompilerFingerprint(compilerReachableTypeKeyFingerprint(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, tables: arena.tables, typeKeyID: returnKeyID))
    if returnFingerprint.first == 0 && returnFingerprint.second == 0 { return CompilerFingerprint(first: 0, second: 0) }
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: returnTypeKind)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: returnFingerprint.first)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: returnFingerprint.second)
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 3))
    if firstParameterRow < 0 || parameterCount < 0 || firstParameterRow + parameterCount > compilerIntTableRowCount(table: arena.tables.parameters) { return CompilerFingerprint(first: 0, second: 0) }
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: parameterCount)
    state parameterOrdinal: Int(0)
    while parameterOrdinal < parameterCount {
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterStart: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8))
        let parameterEnd: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9))
        state parameterTypeID: Int(compilerBodyArenaFunctionSignatureTypeID(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: parameterStart, end: parameterEnd))
        let parameterTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: parameterTypeID))
        if parameterTypeID < 0 || parameterTypeKind == compilerBodyTypeUnknown() { return CompilerFingerprint(first: 0, second: 0) }
        let parameterKeyID: Int(compilerBodyArenaFunctionSignatureTypeKeyID(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: parameterTypeID, allowIntern: allowIntern))
        if parameterKeyID < 0 { return CompilerFingerprint(first: 0, second: 0) }
        let parameterFingerprint: CompilerFingerprint(compilerReachableTypeKeyFingerprint(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, tables: arena.tables, typeKeyID: parameterKeyID))
        if parameterFingerprint.first == 0 && parameterFingerprint.second == 0 { return CompilerFingerprint(first: 0, second: 0) }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: parameterTypeKind)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: parameterFingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: parameterFingerprint.second)
        parameterOrdinal: parameterOrdinal + 1
    }
    return fingerprint
}

function compilerBodyLLVMEmitterSeedParameters(emitter: CompilerBodyLLVMEmitter): Int {
    state valueRow: Int(0)
    while valueRow < compilerIntTableRowCount(table: emitter.arena.mirValues) {
        let valueKind: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueRow, column: compilerBodyMIRValueKindColumn()))
        if valueKind == compilerBodyMIRValueParameter() {
            if compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: valueRow, kind: compilerBodyLLVMValueParameter(), number: 0 - 1, aux: compilerIntTableValue(table: emitter.arena.mirValues, row: valueRow, column: compilerBodyMIRValueProvenanceIDColumn())) != 0 { return 0 - 1 }
        }
        if valueKind == compilerBodyMIRValueReceiverAddress()
            && !compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: valueRow, operationKind: compilerBodyMIROperationMemberAssign())
            && !compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: valueRow, operationKind: compilerBodyMIROperationMemberAddress()) {
            let provenanceKind: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueRow, column: compilerBodyMIRValueProvenanceKindColumn()))
            let provenanceID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: valueRow, column: compilerBodyMIRValueProvenanceIDColumn()))
            if provenanceKind == compilerBodyMemorySubjectSymbol() {
                let symbolID: Int(provenanceID)
                let symbolKind: Int(compilerIntTableValue(table: emitter.arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
                state assignmentKind: Int(compilerBodyLLVMValueStoragePointer())
                state assignmentAux: Int(compilerBodyStorageForSymbol(arena: emitter.arena, symbolID: symbolID))
                if symbolKind == compilerBodySymbolReceiver() {
                    assignmentKind: compilerBodyLLVMValueReceiverPointer()
                    assignmentAux: symbolID
                }
                if assignmentAux < 0 || compilerBodyLLVMAppendValueAssignment(emitter: emitter, valueID: valueRow, kind: assignmentKind, number: 0 - 1, aux: assignmentAux) != 0 { return 0 - 1 }
            } else { return 0 - 1 }
        }
        valueRow: valueRow + 1
    }
    return 0
}

function compilerBodyLLVMConditionContinuationBlock(arena: CompilerBodyArena, blockID: Int): Int {
    let regionNodeID: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockRegionColumn()))
    let continuationOrdinal: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockFirstStatementColumn())
        + compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockStatementCountColumn()))
    state candidateBlockID: Int(0)
    while candidateBlockID < compilerIntTableRowCount(table: arena.cfgBlocks) {
        if compilerIntTableValue(table: arena.cfgBlocks, row: candidateBlockID, column: compilerBodyCFGBlockRegionColumn()) == regionNodeID
            && compilerIntTableValue(table: arena.cfgBlocks, row: candidateBlockID, column: compilerBodyCFGBlockFirstStatementColumn()) == continuationOrdinal { return candidateBlockID }
        candidateBlockID: candidateBlockID + 1
    }
    return 0 - 1
}

function compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: CompilerBodyLLVMEmitter, blockID: Int, visited: RawBuffer): Int {
    if blockID < 0 || blockID >= compilerIntTableRowCount(table: emitter.arena.cfgBlocks) { return 0 - 1 }
    if rawBufferLoadInt(buffer: visited, index: blockID) == 1 { return 0 }
    if blockID != 0 && !compilerBodyLLVMAllForwardPredecessorsVisited(arena: emitter.arena, blockID: blockID, visited: visited) { return 0 }
    if rawBufferStoreInt(buffer: visited, index: blockID, value: 1) != 0 { return 0 - 1 }
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorKindColumn()))
    if terminatorKind == compilerBodyCFGTerminatorCondition() {
        let branchNumber: Int(rawBufferLoadInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextBranch()))
        let trueBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: blockID, outcome: compilerBodyControlOutcomeTrue()))
        let falseBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: blockID, outcome: compilerBodyControlOutcomeFalse()))
        state isWhileHeader: Bool(false)
        state incomingEdgeRow: Int(0)
        while incomingEdgeRow < compilerIntTableRowCount(table: emitter.arena.cfgEdges) {
            if compilerIntTableValue(table: emitter.arena.cfgEdges, row: incomingEdgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
                && compilerIntTableValue(table: emitter.arena.cfgEdges, row: incomingEdgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge() { isWhileHeader: true }
            incomingEdgeRow: incomingEdgeRow + 1
        }
        state trueLabelKind: Int(compilerBodyLLVMBlockLabelThen())
        state falseLabelKind: Int(compilerBodyLLVMBlockLabelAfter())
        let hasExplicitElse: Bool(compilerIntTableValue(table: emitter.arena.cfgBlocks, row: falseBlockID, column: compilerBodyCFGBlockRegionColumn())
            != compilerIntTableValue(table: emitter.arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockRegionColumn()))
        if hasExplicitElse {
            falseLabelKind: compilerBodyLLVMBlockLabelElse()
            let continuationBlockID: Int(compilerBodyLLVMConditionMergeTarget(arena: emitter.arena, blockID: blockID))
            if continuationBlockID >= 0
                && compilerIntTableValue(table: emitter.blockLabels, row: continuationBlockID, column: compilerBodyLLVMBlockLabelKindColumn()) == 0 {
                if emitter.blockLabels.values.update(element: compilerBodyLLVMBlockLabelAfter(), index: continuationBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn()) != 0
                    || emitter.blockLabels.values.update(element: branchNumber, index: continuationBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn()) != 0 { return 0 - 1 }
            }
        }
        if isWhileHeader {
            trueLabelKind: compilerBodyLLVMBlockLabelWhileBody()
            falseLabelKind: compilerBodyLLVMBlockLabelAfterWhile()
            if emitter.blockLabels.values.update(element: compilerBodyLLVMBlockLabelWhile(), index: blockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn()) != 0
                || emitter.blockLabels.values.update(element: branchNumber, index: blockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn()) != 0 { return 0 - 1 }
        }
        if emitter.blockLabels.values.update(element: trueLabelKind, index: trueBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn()) != 0
            || emitter.blockLabels.values.update(element: branchNumber, index: trueBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn()) != 0
            || emitter.blockLabels.values.update(element: falseLabelKind, index: falseBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelKindColumn()) != 0
            || emitter.blockLabels.values.update(element: branchNumber, index: falseBlockID * compilerBodyLLVMBlockLabelColumnCount() + compilerBodyLLVMBlockLabelNumberColumn()) != 0
            || rawBufferStoreInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextBranch(), value: branchNumber + 1) != 0 { return 0 - 1 }
        if compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: emitter, blockID: trueBlockID, visited: visited) != 0 { return 0 - 1 }
        return compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: emitter, blockID: falseBlockID, visited: visited)
    }
    if terminatorKind == compilerBodyCFGTerminatorFallthrough() {
        let targetBlockID: Int(compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: blockID))
        return compilerBodyLLVMEmitterInitializeLabelsDepthFirst(emitter: emitter, blockID: targetBlockID, visited: visited)
    }
    return 0
}

function compilerBodyLLVMEmitterInitializeLabels(emitter: CompilerBodyLLVMEmitter): Int {
    state blockRow: Int(0)
    let blockCount: Int(compilerIntTableRowCount(table: emitter.arena.cfgBlocks))
    while blockRow < blockCount {
        if compilerIntTableAppend(table: emitter.blockLabels, value: blockRow) != 0
            || compilerIntTableAppend(table: emitter.blockLabels, value: compilerBodyLLVMBlockLabelAfter()) != 0
            || compilerIntTableAppend(table: emitter.blockLabels, value: blockRow) != 0 { return 0 - 1 }
        blockRow: blockRow + 1
    }
    if emitter.blockLabels.values.update(element: compilerBodyLLVMBlockLabelEntry(), index: compilerBodyLLVMBlockLabelKindColumn()) != 0 { return 0 - 1 }
    return 0
}

function compilerBodyLLVMBlockLabel(emitter: CompilerBodyLLVMEmitter, blockID: Int): String {
    if blockID == 0 { return String("entry") }
    return "bb\(blockID)"
}

function compilerBodyLLVMControlDecisionForOperation(arena: CompilerBodyArena, operationID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.controlDecisions) {
        if compilerIntTableValue(table: arena.controlDecisions, row: row, column: compilerBodyControlDecisionOperationColumn()) == operationID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyLLVMConditionalRegionForBlock(arena: CompilerBodyArena, blockID: Int): Int {
    state regionRow: Int(0)
    state match: Int(0 - 1)
    while regionRow < compilerIntTableRowCount(table: arena.controlRegions) {
        if compilerIntTableValue(table: arena.controlRegions, row: regionRow, column: compilerBodyControlRegionKindColumn()) == compilerBodyControlRegionConditional()
            && compilerIntTableValue(table: arena.controlRegions, row: regionRow, column: compilerBodyControlRegionBlockColumn()) == blockID {
            if match >= 0 { return 0 - 1 }
            match: regionRow
        }
        regionRow: regionRow + 1
    }
    return match
}

function compilerBodyLLVMConditionTarget(arena: CompilerBodyArena, blockID: Int, outcome: Int): Int {
    let regionID: Int(compilerBodyLLVMConditionalRegionForBlock(arena: arena, blockID: blockID))
    if regionID >= 0 {
        if outcome == compilerBodyControlOutcomeTrue() {
            return compilerIntTableValue(table: arena.controlRegions, row: regionID, column: compilerBodyControlRegionTrueTargetColumn())
        }
        if outcome == compilerBodyControlOutcomeFalse() {
            return compilerIntTableValue(table: arena.controlRegions, row: regionID, column: compilerBodyControlRegionFalseTargetColumn())
        }
        return 0 - 1
    }
    if outcome == compilerBodyControlOutcomeTrue() { return compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeTrue()) }
    if outcome == compilerBodyControlOutcomeFalse() { return compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: blockID, role: compilerBodyCFGEdgeFalse()) }
    return 0 - 1
}

function compilerBodyLLVMConditionMergeTarget(arena: CompilerBodyArena, blockID: Int): Int {
    let regionID: Int(compilerBodyLLVMConditionalRegionForBlock(arena: arena, blockID: blockID))
    if regionID >= 0 { return compilerIntTableValue(table: arena.controlRegions, row: regionID, column: compilerBodyControlRegionMergeTargetColumn()) }
    return compilerBodyLLVMConditionContinuationBlock(arena: arena, blockID: blockID)
}

function compilerBodyLLVMControlDecisionLabel(decisionID: Int, outcome: Int): String {
    if outcome == compilerBodyControlOutcomeContinue() { return "control.decision.\(decisionID).success" }
    return "control.decision.\(decisionID).failure"
}

function compilerBodyLLVMEffectivePredecessorLabel(emitter: CompilerBodyLLVMEmitter, blockID: Int): String {
    state decisionRow: Int(0)
    state lastDecisionID: Int(0 - 1)
    state lastOperationID: Int(0 - 1)
    while decisionRow < compilerIntTableRowCount(table: emitter.arena.controlDecisions) {
        let operationID: Int(compilerIntTableValue(table: emitter.arena.controlDecisions, row: decisionRow, column: compilerBodyControlDecisionOperationColumn()))
        if compilerIntTableValue(table: emitter.arena.controlDecisions, row: decisionRow, column: compilerBodyControlDecisionBlockColumn()) == blockID
            && operationID > lastOperationID {
            lastDecisionID: decisionRow
            lastOperationID: operationID
        }
        decisionRow: decisionRow + 1
    }
    if lastDecisionID >= 0 { return compilerBodyLLVMControlDecisionLabel(decisionID: lastDecisionID, outcome: compilerBodyControlOutcomeContinue()) }
    return compilerBodyLLVMBlockLabel(emitter: emitter, blockID: blockID)
}

function compilerBodyLLVMFirstCFGTarget(arena: CompilerBodyArena, blockID: Int, role: Int): Int {
    state edgeRow: Int(0)
