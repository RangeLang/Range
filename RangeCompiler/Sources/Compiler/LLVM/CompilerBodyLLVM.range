function compilerCoreRenderLLVMHelperFunctionTyped(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, declarationRow: Int, functionRow: Int, functionName: String, returnLLVMType: String, parameterText: String, block: CompilerLLVMLoweredBlock, abiPlan: CompilerModuleABIPlan): String {
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    let functionBlock: CompilerLLVMBasicBlock(compilerCoreMainLLVMBasicBlock(block: block))
    state renderedName: String(declarationName)
    state llvmReturnType: String(compilerCoreLLVMTypeNameForRangeType(typeName: returnType))
    state renderedParameterText: String("")
    if functionName != String("") {
        renderedName: functionName
        llvmReturnType: returnLLVMType
        renderedParameterText: parameterText
    } else {
        if compilerModuleABIPlanIsParticipant(plan: abiPlan, functionRow: functionRow) {
            llvmReturnType: compilerCoreLLVMNativeABITypeName(tables: tables, index: index, typeName: returnType)
        }
        renderedParameterText: compilerCoreLLVMFunctionParameterTextPlanned(tables: tables, index: index, functionRow: functionRow, abiPlan: abiPlan)
    }
    if functionName == String("") && compilerModuleABIPlanReturnMode(plan: abiPlan, tables: tables, index: index, functionRow: functionRow) == compilerFunctionReturnABIIndirect() {
        llvmReturnType: String("void")
        if renderedParameterText == String("") { renderedParameterText: String("ptr %returnDestination") } else { renderedParameterText: "ptr %returnDestination, \(renderedParameterText)" }
    }
    let llvmFunction: CompilerLLVMFunction(name: renderedName, returnType: llvmReturnType, parameterText: renderedParameterText, renderedBlocks: block.renderedBlocks, block: functionBlock)
    return compilerCoreRenderLLVMFunction(llvmFunction: llvmFunction)
}

function compilerCoreLLVMDefaultReturnValue(typeName: String): String {
    if typeName == String("ptr") {
        return String("null")
    }

    if typeName == String("i1") {
        return String("false")
    }

    return String("0")
}

function compilerCoreMainLLVMBasicBlock(block: CompilerLLVMLoweredBlock): CompilerLLVMBasicBlock {
    state instructionRecords: String("")
    instructionRecords: block.instructionRecords
    state terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    if block.returnLLVMType == String("i1") && block.returnLLVMValue != String("") {
        instructionRecords: "\(instructionRecords)  %entry_result = zext i1 \(block.returnLLVMValue) to i32\n"
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: String("i32"), value: String("%entry_result"), trueLabel: String(""), falseLabel: String(""))
    }
    if block.hasEntryBranch {
        terminal: CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: block.entryBranchCondition, trueLabel: block.entryBranchThenLabel, falseLabel: block.entryBranchElseLabel)
    } else if block.hasReturn {
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    }

    if !block.hasReturn && !block.hasEntryBranch {
        terminal: CompilerLLVMTerminator(kind: String("return"), typeName: block.returnLLVMType, value: block.returnLLVMValue, trueLabel: String(""), falseLabel: String(""))
    }

    return CompilerLLVMBasicBlock(
        name: String("entry"),
        instructionRecords: instructionRecords,
        terminal: terminal
    )
}

function compilerCoreRenderLLVMFunction(llvmFunction: CompilerLLVMFunction): String {
    if llvmFunction.renderedBlocks != String("") {
        return "define \(llvmFunction.returnType) @\(llvmFunction.name)(\(llvmFunction.parameterText)) {\n\(llvmFunction.renderedBlocks)}\n"
    }

    let blockText: String(compilerCoreRenderLLVMBasicBlock(block: llvmFunction.block))
    return "define \(llvmFunction.returnType) @\(llvmFunction.name)(\(llvmFunction.parameterText)) {\n\(blockText)}\n"
}

function compilerCoreRenderLLVMBasicBlock(block: CompilerLLVMBasicBlock): String {
    let instructionsText: String(compilerCoreRenderLLVMInstructionRecords(records: block.instructionRecords))
    let terminalText: String(compilerCoreRenderLLVMTerminator(terminal: block.terminal))
    return "\(block.name):\n\(instructionsText)  \(terminalText)\n"
}

function compilerCoreRenderLLVMInstructionRecords(records: String): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 1024, stride: 1))
    state sourceIndex: Int(0)
    state recordsLength: Int(0)
    recordsLength: stringLength(value: records)

    while sourceIndex < recordsLength {
        state lineEnd: Int(0)
        lineEnd: sourceIndex
        while lineEnd < recordsLength && records.substring(start: lineEnd, end: lineEnd + 1) != String(";") {
            lineEnd: lineEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: lineEnd))
        if record != String("") {
            let rendered: String(compilerCoreRenderLLVMInstructionRecord(record: record))
            if rendered != String("") {
                rawBufferAppendText(buffer: outputBuffer, text: "  \(rendered)\n")
            }
        }

        sourceIndex: lineEnd + 1
    }

    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRenderLLVMInstructionRecord(record: String): String {
    if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
        return String("")
    }
    if hasRangePrefix(source: record, start: 0, prefix: String("llvmPlaceholder|")) {
        let encodedReason: String(compilerCoreRecordField(record: record, prefix: String("reason=")))
        let reason: String(compilerCoreStatementRecordDecodeValue(value: encodedReason))
        return "; RANGE_LOWERING_PLACEHOLDER \(reason)"
    }

    let result: String(compilerCoreRecordField(record: record, prefix: String("result=")))
    let operation: String(compilerCoreRecordField(record: record, prefix: String("op=")))
    let typeName: String(compilerCoreRecordField(record: record, prefix: String("type=")))
    let left: String(compilerCoreRecordField(record: record, prefix: String("left=")))
    let right: String(compilerCoreRecordField(record: record, prefix: String("right=")))
    if result == String("") && operation == String("") {
        return String("")
    }

    if operation == String("call") {
        return "\(result) = call \(typeName) @\(left)(\(right))"
    }

    if operation == String("puts") {
        return "\(result) = call i32 @puts(ptr \(left))"
    }

    if operation == String("phi") {
        return "\(result) = phi \(typeName) \(left), \(right)"
    }

    return "\(result) = \(operation) \(typeName) \(left), \(right)"
}

function compilerCoreRenderLLVMGlobalRecords(records: String): String {
    let outputBuffer: RawBuffer(rawBufferCreate(capacity: 65536, stride: 1))
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))

    while sourceIndex < recordsLength {
        state recordEnd: Int(0)
        recordEnd: sourceIndex
        while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
            recordEnd: recordEnd + 1
        }

        let record: String(records.substring(start: sourceIndex, end: recordEnd))
        if hasRangePrefix(source: record, start: 0, prefix: String("llvmGlobalString|")) {
            let name: String(compilerCoreRecordField(record: record, prefix: String("name=")))
            let byteCount: String(compilerCoreRecordField(record: record, prefix: String("bytes=")))
            let text: String(compilerCoreRecordField(record: record, prefix: String("text=")))
            let renderedText: String(compilerCoreLLVMGlobalStringRenderedText(text: text))
            rawBufferAppendText(buffer: outputBuffer, text: "@\(name) = private unnamed_addr constant [\(byteCount) x i8] c\"\(renderedText)\\00\"\n")
        }

        sourceIndex: recordEnd + 1
    }

    return compilerCoreRawBufferMaterializeAndDestroy(buffer: outputBuffer)
}

function compilerCoreRawBufferMaterializeAndDestroy(buffer: RawBuffer): String {
    let text: String(rawBufferMaterializeText(buffer: buffer))
    rawBufferDestroy(buffer: buffer)
    return text
}

function compilerCoreRenderLLVMRuntimeDeclarations(records: String, renderedFunctions: String): String {
    let baseDeclarations: String("declare i32 @puts(ptr)\ndeclare i32 @stringLength(ptr)\ndeclare i32 @stringIndexOf(ptr, ptr, i32)\ndeclare i32 @stringEqual(ptr, ptr)\ndeclare i32 @stringCompare(ptr, ptr)\ndeclare i1 @stringHasPrefix(ptr, i32, ptr)\ndeclare i32 @stringFindFrom(ptr, i32, ptr)\ndeclare i32 @stringFindFirstOf(ptr, i32, ptr)\ndeclare ptr @stringViewFrom(ptr, i32)\ndeclare ptr @stringSliceUnchecked(ptr, i32, i32)\ndeclare ptr @stringCharacterAt(ptr, i32)\ndeclare i32 @stringByteAt(ptr, i32)\ndeclare i32 @stringFindByteOf(ptr, i32, i32, i32, i32)\ndeclare i32 @stringTransientRegionMark()\ndeclare i32 @stringTransientRegionReset(i32)\ndeclare ptr @commandLineArgument(i32)\ndeclare i32 @commandLineArgumentCount()\ndeclare ptr @readFile(ptr)\ndeclare i32 @writeFile(ptr, ptr)\ndeclare i32 @runProcess(ptr, ptr)\ndeclare i32 @runProcessBatch(ptr, i32)\ndeclare ptr @stringCharacter(ptr, i32)\ndeclare ptr @stringSubstring(ptr, i32, i32)\ndeclare ptr @stringConcat(ptr, ptr)\ndeclare ptr @stringOwnedCopy(ptr)\ndeclare ptr @stringAppendOwned(ptr, ptr)\ndeclare ptr @stringFromInt(i32)\ndeclare ptr @stringFromBool(i1)\ndeclare ptr @bufferCreateInt(i32)\ndeclare ptr @bufferCreateUnsigned8(i32)\ndeclare ptr @rawBufferCreate(i32, i32)\ndeclare i32 @rawBufferAppendInt(ptr, i32)\ndeclare i32 @rawBufferAppendRandomBytes(ptr, i32)\ndeclare i32 @rawBufferAppendUnsigned8(ptr, i8)\ndeclare i8 @rawBufferLoadUnsigned8(ptr, i32)\ndeclare i32 @rawBufferStoreUnsigned8(ptr, i32, i8)\ndeclare i32 @rawBufferCount(ptr)\ndeclare i32 @rawBufferLoadInt(ptr, i32)\ndeclare i32 @rawBufferStoreInt(ptr, i32, i32)\ndeclare i32 @rawBufferAppendText(ptr, ptr)\ndeclare i32 @rawBufferAppendTextInt(ptr, i32)\ndeclare i32 @rawBufferAppendTextCharacter(ptr, ptr, i32)\ndeclare ptr @rawBufferMaterializeText(ptr)\ndeclare i32 @rawBufferDestroy(ptr)\n")
    state trapDeclaration: String("")
    if compilerCoreRecordContains(record: renderedFunctions, text: String("@llvm.trap()"))
        || compilerCoreRecordContains(record: records, text: String("@llvm.trap()")) {
        trapDeclaration: String("declare void @llvm.trap()\n")
    }
    let dynamicConstructDeclarations: String(compilerCoreRenderLLVMDynamicConstructDeclarations(records: records, renderedFunctions: renderedFunctions))
    let metricsDeclarations: String(compilerCoreLLVMRuntimeMetricsDeclarations(records: records, renderedFunctions: renderedFunctions))
    return "\(trapDeclaration)\(baseDeclarations)\(dynamicConstructDeclarations)\(metricsDeclarations)\n"
}

function compilerCoreRenderLLVMDynamicConstructDeclarations(records: String, renderedFunctions: String): String {
    if compilerCoreRecordContains(record: renderedFunctions, text: String("@rangeConstruct"))
        || compilerCoreRecordContains(record: records, text: String("rangeConstruct")) {
        return String("declare ptr @rangeConstructCreate(ptr)\ndeclare ptr @rangeConstructSetPtr(ptr, ptr, ptr)\ndeclare ptr @rangeConstructSetInt(ptr, ptr, i32)\ndeclare ptr @rangeConstructSetBool(ptr, ptr, i1)\ndeclare ptr @rangeConstructGetPtr(ptr, ptr)\ndeclare i32 @rangeConstructGetInt(ptr, ptr)\ndeclare i1 @rangeConstructGetBool(ptr, ptr)\n")
    }
    return String("")
}

function compilerCoreRenderLLVMRuntimeDeclarationsTyped(records: String, renderedFunctions: String, runtimeRequirements: Int): String {
    if runtimeRequirements < 0 || runtimeRequirements > compilerBodyLLVMRuntimeStringCompare() { return String("") }
    return compilerCoreRenderLLVMRuntimeDeclarations(records: records, renderedFunctions: renderedFunctions)
}

function compilerCoreLLVMRuntimeMetricsDeclarations(records: String, renderedFunctions: String): String {
    if !compilerCoreRecordContains(record: renderedFunctions, text: String("@compilerMetrics"))
        && !compilerCoreRecordContains(record: records, text: String("@compilerMetrics")) { return String("") }
    return "declare i32 @compilerMetricsReset()\ndeclare i32 @compilerMetricsSetEnabled(i1)\ndeclare i32 @compilerMetricsFunctionBegin(i32, ptr)\ndeclare i32 @compilerMetricsFunctionEnd(i32, i32)\ndeclare ptr @compilerMetricsReport()\n"
}

function compilerCoreLLVMRecordsContainOperation(records: String, operation: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    let operationField: String("op=\(operation)")

    while sourceIndex < recordsLength {
        if hasRangePrefix(source: records, start: sourceIndex, prefix: operationField) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreLLVMRecordsContainCall(records: String, name: String): Bool {
    state sourceIndex: Int(0)
    let recordsLength: Int(stringLength(value: records))
    let callField: String("op=call|type=")
    let nameField: String("|left=\(name)|")

    while sourceIndex < recordsLength {
        if hasRangePrefix(source: records, start: sourceIndex, prefix: callField) {
            state recordEnd: Int(0)
            recordEnd: sourceIndex
            while recordEnd < recordsLength && records.substring(start: recordEnd, end: recordEnd + 1) != String(";") {
                recordEnd: recordEnd + 1
            }
            let record: String(records.substring(start: sourceIndex, end: recordEnd))
            if compilerCoreRecordContains(record: record, text: nameField) {
                return true
            }
            sourceIndex: recordEnd
        } else {
            sourceIndex: sourceIndex + 1
        }
    }

    return false
}

function compilerCoreRecordContains(record: String, text: String): Bool {
    state sourceIndex: Int(0)
    let recordLength: Int(stringLength(value: record))

    while sourceIndex < recordLength {
        if hasRangePrefix(source: record, start: sourceIndex, prefix: text) {
            return true
        }
        sourceIndex: sourceIndex + 1
    }

    return false
}

function compilerCoreRenderLLVMTerminator(terminal: CompilerLLVMTerminator): String {
    if terminal.kind == String("return") {
        if terminal.typeName == String("void") && terminal.value == String("") {
            return "ret void"
        }
        return "ret \(terminal.typeName) \(terminal.value)"
    }

    if terminal.kind == String("branch") {
        return "br \(terminal.typeName) \(terminal.value), label %\(terminal.trueLabel), label %\(terminal.falseLabel)"
    }

    if terminal.kind == String("jump") {
        return "br label %\(terminal.trueLabel)"
    }

    return String("ret i32 0")
}
