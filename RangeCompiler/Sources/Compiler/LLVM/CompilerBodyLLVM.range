            return rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  %r\(memberCallTemporary) = extractvalue \(memberReceiverValue.typeName) \(memberReceiverValue.text), \(nativeMemberOrdinal)\n")
        }
        let memberReceiverValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        if compilerIntTableValue(table: emitter.arena.mirValues, row: memberReceiverValueID, column: compilerBodyMIRValueTypeColumn()) == compilerBodyTypeConstruct() {
            let memberReceiverTypeID: Int(compilerIntTableValue(table: emitter.arena.mirValues, row: memberReceiverValueID, column: compilerBodyMIRValueTypeIDColumn()))
            let memberReceiverAggregateType: String(compilerBodyLLVMNominalTypeNameForTypeID(arena: emitter.arena, typeID: memberReceiverTypeID))
            let nativeMemberRow: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationTargetIDColumn()))
            let nativeMemberOrdinal: Int(compilerBodyArenaStoredMemberOrdinal(arena: emitter.arena, memberRow: nativeMemberRow))
            let memberLoadTemporary: Int(memberCallTemporary - 1)
            if memberReceiverAggregateType == String("") || nativeMemberRow < 0 || nativeMemberOrdinal < 0
                || rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  %r\(memberLoadTemporary) = load \(memberReceiverAggregateType), ptr \(memberReceiverValue.text)\n") != 0
                || rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  %r\(memberCallTemporary) = extractvalue \(memberReceiverAggregateType) %r\(memberLoadTemporary), \(nativeMemberOrdinal)\n") != 0 { return 0 - 1 }
            return 0
        }
        let memberGlobalTemporary: Int(memberCallTemporary - 1)
        let memberNodeID: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: operationID, column: compilerBodyMIROperationSourceColumn()))
        let memberNameText: String(compilerBodyArenaNodeText(arena: emitter.arena, nodeID: memberNodeID))
        let emittedMemberNameLength: Int(stringLength(value: memberNameText))
        let emittedMemberByteCount: Int(emittedMemberNameLength + 1)
        let memberTypeName: String(compilerBodyLLVMTypeName(typeKind: compilerIntTableValue(table: emitter.arena.mirValues, row: resultValueID, column: compilerBodyMIRValueTypeColumn())))
        state memberGetterName: String("rangeConstructGetPtr")
        if memberTypeName == String("i32") { memberGetterName: String("rangeConstructGetInt") }
        if memberTypeName == String("i1") { memberGetterName: String("rangeConstructGetBool") }
        let memberArguments: String("ptr \(memberReceiverValue.text), ptr getelementptr inbounds ([\(emittedMemberByteCount) x i8], ptr @.str.\(memberGlobalTemporary), i32 0, i32 0)")
        let memberInstruction: CompilerLLVMInstruction(result: "%r\(memberCallTemporary)", operation: String("call"), typeName: memberTypeName, left: memberGetterName, right: memberArguments)
        return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: memberInstruction)
    }
    if operationKind == compilerBodyMIROperationPrefixNot() || operationKind == compilerBodyMIROperationPrefixNegate() {
        let prefixAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        let prefixOperandValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0)))
        if prefixAssignmentRow < 0 || prefixOperandValue.text == String("") { return 0 - 1 }
        let prefixTemporary: Int(compilerIntTableValue(table: emitter.valueAssignments, row: prefixAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn()))
        state prefixInstructionName: String("xor")
        state prefixLeft: String("")
        state prefixRight: String("true")
        prefixLeft: prefixOperandValue.text
        if operationKind == compilerBodyMIROperationPrefixNegate() {
            prefixInstructionName: String("sub")
            if prefixOperandValue.typeName == String("double") || prefixOperandValue.typeName == String("float") { prefixInstructionName: String("fsub") }
            prefixLeft: String("0")
            prefixRight: prefixOperandValue.text
        }
        let prefixInstruction: CompilerLLVMInstruction(result: "%r\(prefixTemporary)", operation: prefixInstructionName, typeName: prefixOperandValue.typeName, left: prefixLeft, right: prefixRight)
        return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: prefixInstruction)
    }
    if (operationKind >= compilerBodyMIROperationEqual() && operationKind <= compilerBodyMIROperationOr())
        || (operationKind >= compilerBodyMIROperationAdd() && operationKind <= compilerBodyMIROperationGreaterEqual())
        || operationKind == compilerBodyMIROperationDivide() || operationKind == compilerBodyMIROperationRemainder() {
        let leftValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 0))
        let rightValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: operationID, ordinal: 1))
        let leftValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: leftValueID))
        let rightValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: rightValueID))
        let binaryAssignmentRow: Int(compilerBodyLLVMValueAssignmentRow(emitter: emitter, valueID: resultValueID))
        if binaryAssignmentRow < 0 { return 0 - 1 }
        state binaryTemporary: Int(0)
        binaryTemporary: compilerIntTableValue(table: emitter.valueAssignments, row: binaryAssignmentRow, column: compilerBodyLLVMValueAssignmentNumberColumn())
        let leftIsOptionalNone: Bool(compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: leftValueID, operationKind: compilerBodyMIROperationOptionalNone()))
        let rightIsOptionalNone: Bool(compilerBodyMIRValueIsProducedBy(arena: emitter.arena, valueID: rightValueID, operationKind: compilerBodyMIROperationOptionalNone()))
        if (operationKind == compilerBodyMIROperationEqual() || operationKind == compilerBodyMIROperationNotEqual()) && (leftIsOptionalNone || rightIsOptionalNone) {
            state comparedOptionalValueID: Int(leftValueID)
            state comparedOptionalValue: CompilerLLVMValue(leftValue)
            if leftIsOptionalNone {
                comparedOptionalValueID: rightValueID
                comparedOptionalValue: rightValue
            }
            let comparedOptionalType: String(compilerBodyLLVMValueTypeName(arena: emitter.arena, valueID: comparedOptionalValueID))
            let optionalTagTemporary: Int(binaryTemporary - 1)
            if comparedOptionalType == String("") || comparedOptionalValue.text == String("") { return 0 - 1 }
            if rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  %r\(optionalTagTemporary) = extractvalue \(comparedOptionalType) \(comparedOptionalValue.text), 0\n") != 0 { return 0 - 1 }
            state optionalComparisonName: String("icmp eq")
            if operationKind == compilerBodyMIROperationNotEqual() { optionalComparisonName: String("icmp ne") }
            let optionalComparisonInstruction: CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: optionalComparisonName, typeName: String("i1"), left: "%r\(optionalTagTemporary)", right: String("false"))
            return compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: optionalComparisonInstruction)
        }
        if (operationKind == compilerBodyMIROperationEqual() || operationKind == compilerBodyMIROperationNotEqual()) && leftValue.typeName == String("ptr") && rightValue.typeName == String("ptr") {
            let stringEqualTemporary: Int(binaryTemporary - 1)
            let equalInstruction: CompilerLLVMInstruction(result: "%r\(stringEqualTemporary)", operation: String("call"), typeName: String("i32"), left: String("stringEqual"), right: "ptr \(leftValue.text), ptr \(rightValue.text)")
            state comparisonOperation: String("icmp ne")
            if operationKind == compilerBodyMIROperationNotEqual() { comparisonOperation: String("icmp eq") }
            let comparisonInstruction: CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: comparisonOperation, typeName: String("i32"), left: "%r\(stringEqualTemporary)", right: String("0"))
            if compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: equalInstruction) != 0
                || compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: comparisonInstruction) != 0 { return 0 - 1 }
            return 0
        }
        if operationKind >= compilerBodyMIROperationLessThan() && operationKind <= compilerBodyMIROperationGreaterEqual()
            && leftValue.typeName == String("ptr") && rightValue.typeName == String("ptr") {
            let stringCompareTemporary: Int(binaryTemporary - 1)
            let compareInstruction: CompilerLLVMInstruction(result: "%r\(stringCompareTemporary)", operation: String("call"), typeName: String("i32"), left: String("stringCompare"), right: "ptr \(leftValue.text), ptr \(rightValue.text)")
            state orderedComparisonOperation: String("icmp slt")
            if operationKind == compilerBodyMIROperationLessEqual() { orderedComparisonOperation: String("icmp sle") }
            if operationKind == compilerBodyMIROperationGreaterThan() { orderedComparisonOperation: String("icmp sgt") }
            if operationKind == compilerBodyMIROperationGreaterEqual() { orderedComparisonOperation: String("icmp sge") }
            let orderedComparisonInstruction: CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: orderedComparisonOperation, typeName: String("i32"), left: "%r\(stringCompareTemporary)", right: String("0"))
            if compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: compareInstruction) != 0
                || compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: orderedComparisonInstruction) != 0 { return 0 - 1 }
            return 0
        }
        state instructionName: String("icmp eq")
        let isFloatBinary: Bool(leftValue.typeName == String("double") || leftValue.typeName == String("float"))
        if operationKind == compilerBodyMIROperationNotEqual() { instructionName: String("icmp ne") }
        if operationKind == compilerBodyMIROperationAnd() { instructionName: String("and") }
        if operationKind == compilerBodyMIROperationOr() { instructionName: String("or") }
        if operationKind == compilerBodyMIROperationAdd() {
            instructionName: "add"
            if isFloatBinary { instructionName: "fadd" }
        }
        if operationKind == compilerBodyMIROperationSubtract() {
            instructionName: "sub"
            if isFloatBinary { instructionName: "fsub" }
        }
        if operationKind == compilerBodyMIROperationMultiply() {
            instructionName: "mul"
            if isFloatBinary { instructionName: "fmul" }
        }
        if operationKind == compilerBodyMIROperationDivide() {
            instructionName: "sdiv"
            if isFloatBinary { instructionName: "fdiv" }
        }
        if operationKind == compilerBodyMIROperationRemainder() {
            instructionName: "srem"
            if isFloatBinary { instructionName: "frem" }
        }
        if operationKind == compilerBodyMIROperationLessThan() {
            instructionName: "icmp slt"
            if isFloatBinary { instructionName: "fcmp olt" }
        }
        if operationKind == compilerBodyMIROperationLessEqual() {
            instructionName: "icmp sle"
            if isFloatBinary { instructionName: "fcmp ole" }
        }
        if operationKind == compilerBodyMIROperationGreaterThan() {
            instructionName: "icmp sgt"
            if isFloatBinary { instructionName: "fcmp ogt" }
        }
        if operationKind == compilerBodyMIROperationGreaterEqual() {
            instructionName: "icmp sge"
            if isFloatBinary { instructionName: "fcmp oge" }
        }
        if isFloatBinary && operationKind == compilerBodyMIROperationEqual() { instructionName: "fcmp oeq" }
        if isFloatBinary && operationKind == compilerBodyMIROperationNotEqual() { instructionName: "fcmp one" }
        let binaryInstruction: CompilerLLVMInstruction(result: "%r\(binaryTemporary)", operation: instructionName, typeName: leftValue.typeName, left: leftValue.text, right: rightValue.text)
        if compilerBodyLLVMEmitterAppendInstruction(emitter: emitter, instruction: binaryInstruction) != 0 { return 0 - 1 }
        return 0
    }
    return 0 - 1
}

function compilerBodyLLVMEmitterRenderBlock(emitter: CompilerBodyLLVMEmitter, mirBlockID: Int): Int {
    let cfgBlockID: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockCFGColumn()))
    let firstOperation: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
    let operationCount: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
    let terminatorOperationID: Int(firstOperation + operationCount - 1)
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: terminatorOperationID, column: compilerBodyMIROperationKindColumn()))
    let initialTerminal: CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: String(""), falseLabel: String(""))
    state terminal: CompilerLLVMTerminator(initialTerminal)
    if terminatorKind == compilerBodyMIROperationCondBranch() {
        let conditionValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: terminatorOperationID, ordinal: 0))
        let conditionValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: conditionValueID))
        let trueBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: cfgBlockID, outcome: compilerBodyControlOutcomeTrue()))
        let falseBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: cfgBlockID, outcome: compilerBodyControlOutcomeFalse()))
        terminal: CompilerLLVMTerminator(kind: String("branch"), typeName: String("i1"), value: conditionValue.text, trueLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: trueBlockID), falseLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: falseBlockID))
    }
    if terminatorKind == compilerBodyMIROperationReturn() {
        let returnValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: emitter.arena, operationID: terminatorOperationID, ordinal: 0))
        let returnValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: returnValueID))
        if compilerBodyArenaOwnerReturnMode(arena: emitter.arena, plan: emitter.abiPlan) == compilerFunctionReturnABIIndirect() {
            if rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  store \(returnValue.typeName) \(returnValue.text), ptr %returnDestination\n") != 0 { return 0 - 1 }
            terminal: CompilerLLVMTerminator(kind: String("return"), typeName: String("void"), value: String(""), trueLabel: String(""), falseLabel: String(""))
        } else {
            if compilerBodyArenaIsEntry(arena: emitter.arena) && returnValue.typeName == String("i1") {
                if rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  %entry_result = zext i1 \(returnValue.text) to i32\n") != 0 { return 0 - 1 }
                terminal: CompilerLLVMTerminator(kind: String("return"), typeName: String("i32"), value: String("%entry_result"), trueLabel: String(""), falseLabel: String(""))
            } else {
                terminal: CompilerLLVMTerminator(kind: String("return"), typeName: returnValue.typeName, value: returnValue.text, trueLabel: String(""), falseLabel: String(""))
            }
        }
    }
    if terminatorKind == compilerBodyMIROperationBranch() {
        let targetBlockID: Int(compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: cfgBlockID))
        terminal: CompilerLLVMTerminator(kind: String("jump"), typeName: String(""), value: String(""), trueLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: targetBlockID), falseLabel: String(""))
    }
    return rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  \(compilerCoreRenderLLVMTerminator(terminal: terminal))\n")
}

function compilerBodyLLVMEmitterRenderCFGDepthFirst(emitter: CompilerBodyLLVMEmitter, mirBlockID: Int, visited: RawBuffer): Int {
    if mirBlockID < 0 || mirBlockID >= compilerIntTableRowCount(table: emitter.arena.mirBlocks) { return 0 - 1 }
    if rawBufferLoadInt(buffer: visited, index: mirBlockID) == 1 { return 0 }
    if mirBlockID != 0 && !compilerBodyLLVMAllForwardPredecessorsVisited(arena: emitter.arena, blockID: mirBlockID, visited: visited) { return 0 }
    if rawBufferStoreInt(buffer: visited, index: mirBlockID, value: 1) != 0 { return 0 - 1 }
    let firstOperation: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
    let operationCount: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
    state valid: Bool(operationCount > 0)
    let cfgBlockID: Int(compilerIntTableValue(table: emitter.arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockCFGColumn()))
    if rawBufferAppendText(buffer: emitter.renderedBlocks, text: "\(compilerBodyLLVMBlockLabel(emitter: emitter, blockID: cfgBlockID)):\n") != 0 { valid: false }
    if valid && cfgBlockID == 0 {
        state callerStorageID: Int(0)
        while callerStorageID < compilerIntTableRowCount(table: emitter.arena.storages) {
            if compilerIntTableValue(table: emitter.arena.storages, row: callerStorageID, column: compilerBodyStoragePlacementColumn()) == compilerBodyStorageCaller() {
                let callerStorageType: String(compilerBodyLLVMStorageTypeName(arena: emitter.arena, storageID: callerStorageID))
                if callerStorageType == String("") || rawBufferAppendText(buffer: emitter.renderedBlocks, text: "  %storage\(callerStorageID) = alloca \(callerStorageType)\n") != 0 { valid: false }
            }
            callerStorageID: callerStorageID + 1
        }
    }
    state operationOffset: Int(0)
    while valid && operationOffset + 1 < operationCount {
        if compilerBodyLLVMEmitterProcessOperation(emitter: emitter, operationID: firstOperation + operationOffset) != 0 { valid: false }
        operationOffset: operationOffset + 1
    }
    if valid && compilerBodyLLVMEmitterRenderBlock(emitter: emitter, mirBlockID: mirBlockID) != 0 { valid: false }
    if valid && rawBufferStoreInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterLastBlock(), value: mirBlockID) != 0 { valid: false }
    if !valid { return 0 - 1 }
    let terminatorOperationID: Int(firstOperation + operationCount - 1)
    let terminatorKind: Int(compilerIntTableValue(table: emitter.arena.mirOperations, row: terminatorOperationID, column: compilerBodyMIROperationKindColumn()))
    if terminatorKind == compilerBodyMIROperationCondBranch() {
        let trueBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: cfgBlockID, outcome: compilerBodyControlOutcomeTrue()))
        let falseBlockID: Int(compilerBodyLLVMConditionTarget(arena: emitter.arena, blockID: cfgBlockID, outcome: compilerBodyControlOutcomeFalse()))
        if compilerBodyLLVMEmitterRenderCFGDepthFirst(emitter: emitter, mirBlockID: trueBlockID, visited: visited) != 0 { return 0 - 1 }
        return compilerBodyLLVMEmitterRenderCFGDepthFirst(emitter: emitter, mirBlockID: falseBlockID, visited: visited)
    }
    if terminatorKind == compilerBodyMIROperationBranch() {
        let targetBlockID: Int(compilerBodyLLVMBranchTarget(arena: emitter.arena, blockID: cfgBlockID))
        return compilerBodyLLVMEmitterRenderCFGDepthFirst(emitter: emitter, mirBlockID: targetBlockID, visited: visited)
    }
    return 0
}

function compilerBodyArenaCFGHasFallthrough(arena: CompilerBodyArena): Bool {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeFallthrough() { return true }
        edgeRow: edgeRow + 1
    }
    return false
}

function compilerBodyLLVMEmitterRenderGlobals(emitter: CompilerBodyLLVMEmitter): String {
    let output: RawBuffer(rawBufferCreate(capacity: 1024, stride: 1))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: emitter.globalDescriptors) {
        let temporary: Int(compilerIntTableValue(table: emitter.globalDescriptors, row: row, column: compilerBodyLLVMGlobalDescriptorTemporaryColumn()))
        let sourceNodeID: Int(compilerIntTableValue(table: emitter.globalDescriptors, row: row, column: compilerBodyLLVMGlobalDescriptorSourceColumn()))
        let byteCount: Int(compilerIntTableValue(table: emitter.globalDescriptors, row: row, column: compilerBodyLLVMGlobalDescriptorByteCountColumn()))
        let descriptorKind: Int(compilerIntTableValue(table: emitter.globalDescriptors, row: row, column: compilerBodyLLVMGlobalDescriptorKindColumn()))
        let descriptorText: String(compilerBodyArenaNodeText(arena: emitter.arena, nodeID: sourceNodeID))
        state descriptorContent: String(descriptorText)
        if descriptorKind == compilerBodyLLVMGlobalDescriptorStringLiteral() { descriptorContent: compilerCoreStringLiteralContent(text: descriptorText) }
        if descriptorKind == compilerBodyLLVMGlobalDescriptorStringSegment() { descriptorContent: compilerCoreDecodeStringLiteralContent(content: descriptorText) }
        let renderedText: String(compilerCoreLLVMGlobalStringRenderedText(text: compilerCoreStatementRecordEncodeValue(value: descriptorContent)))
        rawBufferAppendText(buffer: output, text: "@.str.\(temporary) = private unnamed_addr constant [\(byteCount) x i8] c\"\(renderedText)\\00\"\n")
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: output)
}

function compilerBodyLLVMEmit(arena: CompilerBodyArena, initialTemporary: Int, initialBranch: Int, abiPlan: CompilerModuleABIPlan, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, functionInstances: CompilerIntTable, functionInstanceSignatures: CompilerIntTable, functionInstanceSignatureParameters: CompilerIntTable): CompilerBodyLLVMEmissionResult {
    state bodyStart: Int(0)
    bodyStart: arena.bodyStart
    state bodyEnd: Int(0)
    bodyEnd: arena.bodyEnd
    let emptyBlock: CompilerLLVMLoweredBlock(block: CompilerBlock(start: bodyStart, end: bodyEnd), declarationRecords: String(""), renderedBlocks: String(""), instructionRecords: String(""), localValues: String(""), nextTemporary: initialTemporary, nextBranchIndex: initialBranch, exitLabel: String("entry"), hasEntryBranch: false, entryBranchCondition: String(""), entryBranchThenLabel: String(""), entryBranchElseLabel: String(""), hasReturn: false, returnLLVMType: String(""), returnLLVMValue: String(""))
    if !compilerBodyMIRIsValid(arena: arena, abiPlan: abiPlan) || !compilerBodyMemoryIsFrozenAndValid(arena: arena) { return CompilerBodyLLVMEmissionResult(block: emptyBlock, renderedGlobals: String(""), runtimeRequirements: 0, isValid: false) }
    let emitter: CompilerBodyLLVMEmitter(compilerBodyLLVMEmitterCreate(arena: arena, initialTemporary: initialTemporary, initialBranch: initialBranch, abiPlan: abiPlan, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, functionInstances: functionInstances, functionInstanceSignatures: functionInstanceSignatures, functionInstanceSignatureParameters: functionInstanceSignatureParameters))
    state valid: Bool(true)
    if compilerBodyLLVMEmitterSeedParameters(emitter: emitter) != 0 || compilerBodyLLVMEmitterInitializeLabels(emitter: emitter) != 0 { valid: false }
    let planningVisited: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.mirBlocks), stride: 4))
    while rawBufferCount(buffer: planningVisited) < compilerIntTableRowCount(table: arena.mirBlocks) { rawBufferAppendInt(buffer: planningVisited, value: 0) }
    if valid && compilerBodyLLVMEmitterPlanCFGDepthFirst(emitter: emitter, blockID: 0, visited: planningVisited) != 0 { valid: false }
    rawBufferDestroy(buffer: planningVisited)
    state mirBlockID: Int(0)
    state hasEntryBranch: Bool(false)
    state entryBranchCondition: String("")
    state entryBranchThenLabel: String("")
    state entryBranchElseLabel: String("")
    state hasReturn: Bool(false)
    state returnLLVMType: String("")
    state returnLLVMValue: String("")
    state exitLabel: String("entry")
    let visited: RawBuffer(rawBufferCreate(capacity: compilerIntTableRowCount(table: arena.mirBlocks), stride: 4))
    while rawBufferCount(buffer: visited) < compilerIntTableRowCount(table: arena.mirBlocks) { rawBufferAppendInt(buffer: visited, value: 0) }
    if valid && compilerBodyLLVMEmitterRenderCFGDepthFirst(emitter: emitter, mirBlockID: 0, visited: visited) != 0 { valid: false }
    rawBufferDestroy(buffer: visited)
    while valid && mirBlockID < compilerIntTableRowCount(table: arena.mirBlocks) {
        let firstOperation: Int(compilerIntTableValue(table: arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
        let operationCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
        if valid {
            let terminatorOperationID: Int(firstOperation + operationCount - 1)
            let terminatorKind: Int(compilerIntTableValue(table: arena.mirOperations, row: terminatorOperationID, column: compilerBodyMIROperationKindColumn()))
            if terminatorKind == compilerBodyMIROperationCondBranch() {
                let conditionValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: arena, operationID: terminatorOperationID, ordinal: 0))
                let conditionValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: conditionValueID))
                if !hasEntryBranch {
                    let cfgBlockID: Int(compilerIntTableValue(table: arena.mirBlocks, row: mirBlockID, column: compilerBodyMIRBlockCFGColumn()))
                    hasEntryBranch: true
                    entryBranchCondition: conditionValue.text
                    entryBranchThenLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: cfgBlockID, role: compilerBodyCFGEdgeTrue()))
                    entryBranchElseLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: compilerBodyLLVMFirstCFGTarget(arena: arena, blockID: cfgBlockID, role: compilerBodyCFGEdgeFalse()))
                }
            }
            if terminatorKind == compilerBodyMIROperationReturn() {
                let metadataReturnValueID: Int(compilerBodyLLVMOperationOperandValueID(arena: arena, operationID: terminatorOperationID, ordinal: 0))
                let metadataReturnValue: CompilerLLVMValue(compilerBodyLLVMValue(emitter: emitter, valueID: metadataReturnValueID))
                hasReturn: true
                returnLLVMType: metadataReturnValue.typeName
                returnLLVMValue: metadataReturnValue.text
            }
        }
        mirBlockID: mirBlockID + 1
    }
    let lastBlockID: Int(rawBufferLoadInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterLastBlock()))
    exitLabel: compilerBodyLLVMBlockLabel(emitter: emitter, blockID: lastBlockID)
    if hasReturn && compilerBodyArenaCFGHasFallthrough(arena: arena) { returnLLVMValue: compilerCoreLLVMDefaultReturnValue(typeName: returnLLVMType) }
    let renderedBlocks: String(rawBufferMaterializeText(buffer: emitter.renderedBlocks))
    let renderedGlobals: String(compilerBodyLLVMEmitterRenderGlobals(emitter: emitter))
    let runtimeRequirements: Int(rawBufferLoadInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterRuntimeRequirements()))
    let nextTemporary: Int(rawBufferLoadInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextTemporary()))
    let nextBranch: Int(rawBufferLoadInt(buffer: emitter.runtimeState, index: compilerBodyLLVMEmitterNextBranch()))
    if compilerBodyLLVMEmitterDestroy(emitter: emitter) != 0 { valid: false }
    let loweredBlock: CompilerLLVMLoweredBlock(block: CompilerBlock(start: bodyStart, end: bodyEnd), declarationRecords: String(""), renderedBlocks: renderedBlocks, instructionRecords: String(""), localValues: String(""), nextTemporary: nextTemporary, nextBranchIndex: nextBranch, exitLabel: exitLabel, hasEntryBranch: hasEntryBranch, entryBranchCondition: entryBranchCondition, entryBranchThenLabel: entryBranchThenLabel, entryBranchElseLabel: entryBranchElseLabel, hasReturn: hasReturn, returnLLVMType: returnLLVMType, returnLLVMValue: returnLLVMValue)
    return CompilerBodyLLVMEmissionResult(block: loweredBlock, renderedGlobals: renderedGlobals, runtimeRequirements: runtimeRequirements, isValid: valid)
}

function compilerBodyArenaValidationCode(arena: CompilerBodyArena): Int {
    if arena.ownerKind == compilerBodyArenaOwnerFunction() {
        if arena.ownerFunctionRow < 0 || arena.ownerFunctionRow >= compilerIntTableRowCount(table: arena.tables.functions) { return 1 }
