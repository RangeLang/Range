function compilerFunctionArtifactDirectivePath(source: String, name: String): String {
    let marker: String("\n// \(name) ")
    let markerStart: Int(stringIndexOf(source: source, needle: marker, start: 0))
    if markerStart < 0 { return String("") }
    let valueStart: Int(markerStart + stringLength(value: marker))
    state valueEnd: Int(stringIndexOf(source: source, needle: String("\n"), start: valueStart))
    if valueEnd < 0 { valueEnd: stringLength(value: source) }
    if valueEnd <= valueStart { return String("") }
    return source.substring(start: valueStart, end: valueEnd)
}

function compilerFunctionArtifactSourceIdentityPart(source: String, part: Int): Int {
    state identity: CompilerFingerprint(compilerFingerprintInitial())
    let sourceLength: Int(stringLength(value: source))
    state lineStart: Int(0)
    while lineStart < sourceLength {
        state lineEnd: Int(stringIndexOf(source: source, needle: String("\n"), start: lineStart))
        if lineEnd < lineStart { lineEnd: sourceLength }
        let line: String(source.substring(start: lineStart, end: lineEnd))
        let isDirective: Bool(
            stringHasPrefix(source: line, start: 0, prefix: String("// range-function-artifact-input "))
                || stringHasPrefix(source: line, start: 0, prefix: String("// range-function-artifact-output "))
        )
        if !isDirective {
            identity: compilerFingerprintAppendRange(fingerprint: identity, tag: 9100, source: source, start: lineStart, end: lineEnd)
            identity: compilerFingerprintAppendInt(fingerprint: identity, value: 10)
        }
        if lineEnd >= sourceLength {
            lineStart: sourceLength
        } else {
            lineStart: lineEnd + 1
        }
    }
    if part == 0 { return identity.first }
    return identity.second
}

function compilerFunctionArtifactRootIntegrityPart(inputFirst: Int, inputSecond: Int, outputFirst: Int, outputSecond: Int, closureFirst: Int, closureSecond: Int, moduleText: String, part: Int): Int {
    state integrity: CompilerFingerprint(compilerFingerprintInitial())
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: 9201)
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: inputFirst)
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: inputSecond)
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: outputFirst)
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: outputSecond)
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: closureFirst)
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: closureSecond)
    integrity: compilerFingerprintAppendText(fingerprint: integrity, tag: 9202, text: moduleText)
    if part == 0 { return integrity.first }
    return integrity.second
}

function compilerFunctionArtifactRecordsIntegrityPart(artifacts: CompilerIntTable, artifactText: String, part: Int): Int {
    state integrity: CompilerFingerprint(compilerFingerprintInitial())
    integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: 9301)
    let rowCount: Int(compilerIntTableRowCount(table: artifacts))
    let columnCount: Int(artifacts.columnCount)
    state row: Int(0)
    while row < rowCount {
        integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: row)
        state column: Int(0)
        while column < columnCount {
            state value: Int(compilerIntTableValue(table: artifacts, row: row, column: column))
            if column == compilerFunctionArtifactFunctionStartColumn()
                || column == compilerFunctionArtifactGlobalsStartColumn()
                || column == compilerFunctionArtifactEdgeStartColumn()
                || column == compilerFunctionArtifactEdgeCountColumn()
                || column == compilerFunctionArtifactReuseColumn() { value: 0 }
            integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: value)
            column: column + 1
        }
        let functionStart: Int(compilerIntTableValue(table: artifacts, row: row, column: compilerFunctionArtifactFunctionStartColumn()))
        let functionLength: Int(compilerIntTableValue(table: artifacts, row: row, column: compilerFunctionArtifactFunctionLengthColumn()))
        let globalsStart: Int(compilerIntTableValue(table: artifacts, row: row, column: compilerFunctionArtifactGlobalsStartColumn()))
        let globalsLength: Int(compilerIntTableValue(table: artifacts, row: row, column: compilerFunctionArtifactGlobalsLengthColumn()))
        if functionStart >= 0 && functionLength >= 0 && functionStart + functionLength <= stringLength(value: artifactText) {
            integrity: compilerFingerprintAppendRange(fingerprint: integrity, tag: 9302, source: artifactText, start: functionStart, end: functionStart + functionLength)
        } else {
            integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: 0 - 1)
        }
        if globalsStart >= 0 && globalsLength >= 0 && globalsStart + globalsLength <= stringLength(value: artifactText) {
            integrity: compilerFingerprintAppendRange(fingerprint: integrity, tag: 9303, source: artifactText, start: globalsStart, end: globalsStart + globalsLength)
        } else {
            integrity: compilerFingerprintAppendInt(fingerprint: integrity, value: 0 - 1)
        }
        row: row + 1
    }
    if part == 0 { return integrity.first }
    return integrity.second
}

function compilerFunctionArtifactCacheEmpty(valid: Bool): CompilerFunctionArtifactCache {
    return CompilerFunctionArtifactCache(
        artifacts: compilerIntTableCreate(columnCount: compilerFunctionArtifactColumnCount(), estimatedRowCount: 16),
        rowsByInstance: bufferCreateInt(capacity: 16),
        rootBehavior: bufferCreateInt(capacity: 14),
        text: String(""),
        isValid: valid
    )
}

function compilerFunctionArtifactCacheAppendRecord(artifacts: CompilerIntTable, rowsByInstance: Buffer<Int>, record: String, functionStart: Int, globalsStart: Int): Int {
    let functionTextLength: String(compilerCoreRecordField(record: record, prefix: String("functionLength=")))
    let globalsTextLength: String(compilerCoreRecordField(record: record, prefix: String("globalsLength=")))
    if compilerCoreRecordField(record: record, prefix: String("function=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("instance=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("identityFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("identitySecond=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("dependencyFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("dependencySecond=")) == String("")
        || functionTextLength == String("")
        || globalsTextLength == String("")
        || compilerCoreRecordField(record: record, prefix: String("runtimeRequirements=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("nextTemporary=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("edgeFingerprintFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("edgeFingerprintSecond=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("behaviorInputFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("behaviorInputSecond=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("behaviorOutputFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("behaviorOutputSecond=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("behaviorClosureFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("behaviorClosureSecond=")) == String("") { return 0 - 1 }
    let functionLength: Int(compilerCoreParseDecimalInt(value: functionTextLength))
    let globalsLength: Int(compilerCoreParseDecimalInt(value: globalsTextLength))
    let instanceID: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("instance="))))
    if functionLength < 0 || globalsLength < 0 { return 0 - 1 }
    while rowsByInstance.count <= instanceID {
        if rowsByInstance.append(element: 0 - 1) != 0 { return 0 - 1 }
    }
    if rowsByInstance.element(index: instanceID) >= 0
        || rowsByInstance.update(element: compilerIntTableRowCount(table: artifacts), index: instanceID) != 0 { return 0 - 1 }
    if compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("function=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: instanceID) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("identityFirst=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("identitySecond=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("dependencyFirst=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("dependencySecond=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: functionStart) != 0
        || compilerIntTableAppend(table: artifacts, value: functionLength) != 0
        || compilerIntTableAppend(table: artifacts, value: globalsStart) != 0
        || compilerIntTableAppend(table: artifacts, value: globalsLength) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("runtimeRequirements=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("nextTemporary=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: 0) != 0
        || compilerIntTableAppend(table: artifacts, value: 0) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("edgeFingerprintFirst=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("edgeFingerprintSecond=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("behaviorInputFirst=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("behaviorInputSecond=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("behaviorOutputFirst=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("behaviorOutputSecond=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("behaviorClosureFirst=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("behaviorClosureSecond=")))) != 0
        || compilerIntTableAppend(table: artifacts, value: 1) != 0 { return 0 - 1 }
    return 0
}

function compilerFunctionArtifactCacheAppendRootBehavior(rootBehavior: Buffer<Int>, record: String, cacheText: String, moduleStart: Int, moduleLength: Int, includeSourceIdentity: Bool, includeIntegrity: Bool, includeArtifactIntegrity: Bool): Int {
    if rootBehavior.count != 0
        || compilerCoreRecordField(record: record, prefix: String("inputFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("inputSecond=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("outputFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("outputSecond=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("closureFirst=")) == String("")
        || compilerCoreRecordField(record: record, prefix: String("closureSecond=")) == String("")
        || moduleStart < 0 || moduleLength < 0 { return 0 - 1 }
    if rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("inputFirst=")))) != 0
        || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("inputSecond=")))) != 0
        || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("outputFirst=")))) != 0
        || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("outputSecond=")))) != 0
        || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("closureFirst=")))) != 0
        || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("closureSecond=")))) != 0
        || rootBehavior.append(element: moduleStart) != 0
        || rootBehavior.append(element: moduleLength) != 0 { return 0 - 1 }
    if includeSourceIdentity {
        if compilerCoreRecordField(record: record, prefix: String("sourceFirst=")) == String("")
            || compilerCoreRecordField(record: record, prefix: String("sourceSecond=")) == String("")
            || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("sourceFirst=")))) != 0
            || rootBehavior.append(element: compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("sourceSecond=")))) != 0 { return 0 - 1 }
    }
    if includeIntegrity {
        let inputFirst: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("inputFirst="))))
        let inputSecond: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("inputSecond="))))
        let outputFirst: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("outputFirst="))))
        let outputSecond: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("outputSecond="))))
        let closureFirst: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("closureFirst="))))
        let closureSecond: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("closureSecond="))))
        let moduleText: String(stringSliceUnchecked(source: cacheText, start: moduleStart, end: moduleStart + moduleLength))
        let expectedFirst: Int(compilerFunctionArtifactRootIntegrityPart(inputFirst: inputFirst, inputSecond: inputSecond, outputFirst: outputFirst, outputSecond: outputSecond, closureFirst: closureFirst, closureSecond: closureSecond, moduleText: moduleText, part: 0))
        let expectedSecond: Int(compilerFunctionArtifactRootIntegrityPart(inputFirst: inputFirst, inputSecond: inputSecond, outputFirst: outputFirst, outputSecond: outputSecond, closureFirst: closureFirst, closureSecond: closureSecond, moduleText: moduleText, part: 1))
        let integrityFirstText: String(compilerCoreRecordField(record: record, prefix: String("integrityFirst=")))
        let integritySecondText: String(compilerCoreRecordField(record: record, prefix: String("integritySecond=")))
        if integrityFirstText == String("") || integritySecondText == String("")
            || compilerCoreParseDecimalInt(value: integrityFirstText) != expectedFirst
            || compilerCoreParseDecimalInt(value: integritySecondText) != expectedSecond
            || rootBehavior.append(element: expectedFirst) != 0
            || rootBehavior.append(element: expectedSecond) != 0 { return 0 - 1 }
    }
    if includeArtifactIntegrity {
        let recordsFirstText: String(compilerCoreRecordField(record: record, prefix: String("recordsFirst=")))
        let recordsSecondText: String(compilerCoreRecordField(record: record, prefix: String("recordsSecond=")))
        if recordsFirstText == String("") || recordsSecondText == String("")
            || rootBehavior.append(element: compilerCoreParseDecimalInt(value: recordsFirstText)) != 0
            || rootBehavior.append(element: compilerCoreParseDecimalInt(value: recordsSecondText)) != 0 { return 0 - 1 }
    }
    return 0
}

function compilerFunctionArtifactCacheParseInto(text: String, artifacts: CompilerIntTable, rowsByInstance: Buffer<Int>, rootBehavior: Buffer<Int>): Bool {
    let currentHeader: String("rangeFunctionArtifacts|version=8\n")
    let rootIntegrityHeader: String("rangeFunctionArtifacts|version=7\n")
    let sourceIdentityHeader: String("rangeFunctionArtifacts|version=6\n")
    let header: String("rangeFunctionArtifacts|version=5\n")
    let legacyHeaderV4: String("rangeFunctionArtifacts|version=4\n")
    let legacyHeaderV3: String("rangeFunctionArtifacts|version=3\n")
    let legacyHeaderV2: String("rangeFunctionArtifacts|version=2\n")
    let legacyHeaderV1: String("rangeFunctionArtifacts|version=1\n")
    if stringLength(value: text) == 0 { return true }
    if stringHasPrefix(source: text, start: 0, prefix: legacyHeaderV4)
        || stringHasPrefix(source: text, start: 0, prefix: legacyHeaderV3)
        || stringHasPrefix(source: text, start: 0, prefix: legacyHeaderV2)
        || stringHasPrefix(source: text, start: 0, prefix: legacyHeaderV1) { return true }
    state includeSourceIdentity: Bool(false)
    state includeIntegrity: Bool(false)
    state includeArtifactIntegrity: Bool(false)
    state cursor: Int(0)
    if stringHasPrefix(source: text, start: 0, prefix: currentHeader) {
        includeSourceIdentity: true
        includeIntegrity: true
        includeArtifactIntegrity: true
        cursor: stringLength(value: currentHeader)
    } else if stringHasPrefix(source: text, start: 0, prefix: rootIntegrityHeader) {
        includeSourceIdentity: true
        includeIntegrity: true
        cursor: stringLength(value: rootIntegrityHeader)
    } else if stringHasPrefix(source: text, start: 0, prefix: sourceIdentityHeader) {
        includeSourceIdentity: true
        cursor: stringLength(value: sourceIdentityHeader)
    } else if stringHasPrefix(source: text, start: 0, prefix: header) {
        cursor: stringLength(value: header)
    } else {
        return false
    }
    state valid: Bool(true)
    let rootLineEnd: Int(stringIndexOf(source: text, needle: String("\n"), start: cursor))
    if rootLineEnd < cursor {
        valid: false
    } else {
        let rootRecord: String(text.substring(start: cursor, end: rootLineEnd))
        let moduleLengthText: String(compilerCoreRecordField(record: rootRecord, prefix: String("moduleLength=")))
        let moduleLength: Int(compilerCoreParseDecimalInt(value: moduleLengthText))
        let moduleStart: Int(rootLineEnd + 1)
        let moduleEnd: Int(moduleStart + moduleLength)
        if !stringHasPrefix(source: rootRecord, start: 0, prefix: String("root|"))
            || moduleLengthText == String("") || moduleLength < 0 || moduleEnd >= stringLength(value: text)
            || text.substring(start: moduleEnd, end: moduleEnd + 1) != String("\n")
            || compilerFunctionArtifactCacheAppendRootBehavior(rootBehavior: rootBehavior, record: rootRecord, cacheText: text, moduleStart: moduleStart, moduleLength: moduleLength, includeSourceIdentity: includeSourceIdentity, includeIntegrity: includeIntegrity, includeArtifactIntegrity: includeArtifactIntegrity) != 0 {
            valid: false
        } else {
            cursor: moduleEnd + 1
        }
    }
    while valid && cursor < stringLength(value: text) {
        let lineEnd: Int(stringIndexOf(source: text, needle: String("\n"), start: cursor))
        if lineEnd < cursor {
            valid: false
        } else {
            let record: String(text.substring(start: cursor, end: lineEnd))
            if !stringHasPrefix(source: record, start: 0, prefix: String("artifact|")) {
                valid: false
            } else {
                let functionLength: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("functionLength="))))
                let globalsLength: Int(compilerCoreParseDecimalInt(value: compilerCoreRecordField(record: record, prefix: String("globalsLength="))))
                let functionStart: Int(lineEnd + 1)
                let globalsStart: Int(functionStart + functionLength)
                let nextRecord: Int(globalsStart + globalsLength)
                if functionLength < 0 || globalsLength < 0 || nextRecord >= stringLength(value: text)
                    || text.substring(start: nextRecord, end: nextRecord + 1) != String("\n")
                    || compilerFunctionArtifactCacheAppendRecord(
                        artifacts: artifacts,
                        rowsByInstance: rowsByInstance,
                        record: record,
                        functionStart: functionStart,
                        globalsStart: globalsStart
                    ) != 0 {
                    valid: false
                } else {
                    cursor: nextRecord + 1
                }
            }
        }
    }
    state artifactIntegrityValid: Bool(true)
    if valid && includeArtifactIntegrity {
        let expectedFirst: Int(compilerFunctionArtifactRecordsIntegrityPart(artifacts: artifacts, artifactText: text, part: 0))
        let expectedSecond: Int(compilerFunctionArtifactRecordsIntegrityPart(artifacts: artifacts, artifactText: text, part: 1))
        artifactIntegrityValid: rootBehavior.count == 14
            && rootBehavior.element(index: 12) == expectedFirst
            && rootBehavior.element(index: 13) == expectedSecond
    }
    return valid
        && ((includeArtifactIntegrity && rootBehavior.count == 14) || (includeIntegrity && !includeArtifactIntegrity && rootBehavior.count == 12) || (includeSourceIdentity && !includeIntegrity && rootBehavior.count == 10) || (!includeSourceIdentity && rootBehavior.count == 8))
        && artifactIntegrityValid
        && compilerIntTableIsComplete(table: artifacts)
}

function compilerFunctionArtifactCacheLoad(source: String): CompilerFunctionArtifactCache {
    let path: String(compilerFunctionArtifactDirectivePath(source: source, name: String("range-function-artifact-input")))
    if path == String("") { return compilerFunctionArtifactCacheEmpty(valid: true) }
    let text: String(readFile(path: path))
    let artifacts: CompilerIntTable(compilerIntTableCreate(columnCount: compilerFunctionArtifactColumnCount(), estimatedRowCount: 1029))
    let rowsByInstance: Buffer<Int>(bufferCreateInt(capacity: 4096))
    let rootBehavior: Buffer<Int>(bufferCreateInt(capacity: 14))
    let isValid: Bool(compilerFunctionArtifactCacheParseInto(text: text, artifacts: artifacts, rowsByInstance: rowsByInstance, rootBehavior: rootBehavior))
    if !isValid {
        compilerIntTableDestroy(table: artifacts)
        rowsByInstance.destroy()
        rootBehavior.destroy()
        return compilerFunctionArtifactCacheEmpty(valid: true)
    }
    return CompilerFunctionArtifactCache(artifacts: artifacts, rowsByInstance: rowsByInstance, rootBehavior: rootBehavior, text: text, isValid: isValid)
}

function compilerFunctionArtifactCacheFindBehaviorCandidate(cache: CompilerFunctionArtifactCache, functionRow: Int, instanceID: Int, behaviorInput: CompilerFingerprint, edges: CompilerFingerprint): Int {
    if !cache.isValid || instanceID < 0 || instanceID >= cache.rowsByInstance.count { return 0 - 1 }
    let row: Int(cache.rowsByInstance.element(index: instanceID))
    if row >= 0 && row < compilerIntTableRowCount(table: cache.artifacts)
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactFunctionColumn()) == functionRow
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactInstanceColumn()) == instanceID
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorInputFirstColumn()) == behaviorInput.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorInputSecondColumn()) == behaviorInput.second
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactEdgeFingerprintFirstColumn()) == edges.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactEdgeFingerprintSecondColumn()) == edges.second { return row }
    return 0 - 1
}

function compilerFunctionArtifactCacheFind(cache: CompilerFunctionArtifactCache, candidateRow: Int, functionRow: Int, instanceID: Int, identity: CompilerFingerprint, dependencies: CompilerFingerprint, edges: CompilerFingerprint, behaviorInput: CompilerFingerprint, behaviorOutput: CompilerFingerprint, behaviorClosure: CompilerFingerprint): Int {
    if !cache.isValid || candidateRow < 0 || candidateRow >= compilerIntTableRowCount(table: cache.artifacts) { return 0 - 1 }
    let row: Int(candidateRow)
    if compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactFunctionColumn()) == functionRow
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactInstanceColumn()) == instanceID
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactIdentityFirstColumn()) == identity.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactIdentitySecondColumn()) == identity.second
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactDependencyFirstColumn()) == dependencies.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactDependencySecondColumn()) == dependencies.second
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactEdgeFingerprintFirstColumn()) == edges.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactEdgeFingerprintSecondColumn()) == edges.second
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorInputFirstColumn()) == behaviorInput.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorInputSecondColumn()) == behaviorInput.second
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorOutputFirstColumn()) == behaviorOutput.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorOutputSecondColumn()) == behaviorOutput.second
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorClosureFirstColumn()) == behaviorClosure.first
        && compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactBehaviorClosureSecondColumn()) == behaviorClosure.second { return row }
    return 0 - 1
}

function compilerFunctionArtifactEmptySelected(): CompilerTypedLLVMHelpers {
    return CompilerTypedLLVMHelpers(
        helpers: CompilerLLVMHelperFunctions(renderedFunctions: String(""), instructionRecords: String(""), nextTemporary: 0),
        renderedGlobals: String(""),
        runtimeRequirements: 0,
        telemetry: compilerBodyTelemetryEmpty()
    )
}

function compilerFunctionArtifactCacheSelected(cache: CompilerFunctionArtifactCache, row: Int): CompilerTypedLLVMHelpers {
    let functionStart: Int(compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactFunctionStartColumn()))
    let functionLength: Int(compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactFunctionLengthColumn()))
    let globalsStart: Int(compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactGlobalsStartColumn()))
    let globalsLength: Int(compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactGlobalsLengthColumn()))
    return CompilerTypedLLVMHelpers(
        helpers: CompilerLLVMHelperFunctions(
            renderedFunctions: stringSliceUnchecked(source: cache.text, start: functionStart, end: functionStart + functionLength),
            instructionRecords: String(""),
            nextTemporary: compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactNextTemporaryColumn())
        ),
        renderedGlobals: stringSliceUnchecked(source: cache.text, start: globalsStart, end: globalsStart + globalsLength),
        runtimeRequirements: compilerIntTableValue(table: cache.artifacts, row: row, column: compilerFunctionArtifactRuntimeRequirementsColumn()),
        telemetry: CompilerBodyTelemetry(supportedCount: 1, typedParseAttempts: 1, typedParseSuccesses: 1, legacyParses: 0, arenaCreates: 0, arenaDestroys: 0, recordBytes: 0, committedFailures: 0)
    )
}

function compilerFunctionArtifactCacheModuleText(cache: CompilerFunctionArtifactCache): String {
    if !cache.isValid || cache.rootBehavior.count < 8 { return String("") }
    let moduleStart: Int(cache.rootBehavior.element(index: 6))
    let moduleLength: Int(cache.rootBehavior.element(index: 7))
    if moduleStart < 0 || moduleLength <= 0 || moduleStart + moduleLength > stringLength(value: cache.text) { return String("") }
    return stringSliceUnchecked(source: cache.text, start: moduleStart, end: moduleStart + moduleLength)
}

function compilerFunctionArtifactCacheSourceMatches(cache: CompilerFunctionArtifactCache, source: String): Bool {
    if !cache.isValid || cache.rootBehavior.count != 14 { return false }
    let currentFirst: Int(compilerFunctionArtifactSourceIdentityPart(source: source, part: 0))
    let currentSecond: Int(compilerFunctionArtifactSourceIdentityPart(source: source, part: 1))
    return cache.rootBehavior.element(index: 8) == currentFirst
        && cache.rootBehavior.element(index: 9) == currentSecond
}

function compilerReachableLLVMStateSerializeFunctionArtifacts(reachability: CompilerReachableLLVMState, moduleText: String): String {
    let text: String(rawBufferMaterializeText(buffer: reachability.functionArtifactText))
    let output: RawBuffer(rawBufferCreate(capacity: stringLength(value: text) + 65536, stride: 1))
    rawBufferAppendText(buffer: output, text: String("rangeFunctionArtifacts|version=8\n"))
    if reachability.mainBehavior.count == 6 {
        let inputFirst: Int(reachability.mainBehavior.element(index: 0))
        let inputSecond: Int(reachability.mainBehavior.element(index: 1))
        let outputFirst: Int(reachability.mainBehavior.element(index: 2))
        let outputSecond: Int(reachability.mainBehavior.element(index: 3))
        let closureFirst: Int(reachability.mainBehavior.element(index: 4))
        let closureSecond: Int(reachability.mainBehavior.element(index: 5))
        let sourceFirst: Int(compilerFunctionArtifactSourceIdentityPart(source: reachability.context.program.source, part: 0))
        let sourceSecond: Int(compilerFunctionArtifactSourceIdentityPart(source: reachability.context.program.source, part: 1))
        let integrityFirst: Int(compilerFunctionArtifactRootIntegrityPart(inputFirst: inputFirst, inputSecond: inputSecond, outputFirst: outputFirst, outputSecond: outputSecond, closureFirst: closureFirst, closureSecond: closureSecond, moduleText: moduleText, part: 0))
        let integritySecond: Int(compilerFunctionArtifactRootIntegrityPart(inputFirst: inputFirst, inputSecond: inputSecond, outputFirst: outputFirst, outputSecond: outputSecond, closureFirst: closureFirst, closureSecond: closureSecond, moduleText: moduleText, part: 1))
        let recordsFirst: Int(compilerFunctionArtifactRecordsIntegrityPart(artifacts: reachability.functionArtifacts, artifactText: text, part: 0))
        let recordsSecond: Int(compilerFunctionArtifactRecordsIntegrityPart(artifacts: reachability.functionArtifacts, artifactText: text, part: 1))
        rawBufferAppendText(buffer: output, text: "root|inputFirst=\(inputFirst)|inputSecond=\(inputSecond)|outputFirst=\(outputFirst)|outputSecond=\(outputSecond)|closureFirst=\(closureFirst)|closureSecond=\(closureSecond)|sourceFirst=\(sourceFirst)|sourceSecond=\(sourceSecond)|integrityFirst=\(integrityFirst)|integritySecond=\(integritySecond)|recordsFirst=\(recordsFirst)|recordsSecond=\(recordsSecond)|moduleLength=\(stringLength(value: moduleText))\n")
        rawBufferAppendText(buffer: output, text: moduleText)
        rawBufferAppendText(buffer: output, text: String("\n"))
    }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: reachability.functionArtifacts) {
        let functionStart: Int(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactFunctionStartColumn()))
        let functionLength: Int(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactFunctionLengthColumn()))
        let globalsStart: Int(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactGlobalsStartColumn()))
        let globalsLength: Int(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactGlobalsLengthColumn()))
        rawBufferAppendText(buffer: output, text: "artifact|function=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactFunctionColumn()))|instance=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactInstanceColumn()))|identityFirst=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactIdentityFirstColumn()))|identitySecond=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactIdentitySecondColumn()))|dependencyFirst=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactDependencyFirstColumn()))|dependencySecond=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactDependencySecondColumn()))|functionLength=\(functionLength)|globalsLength=\(globalsLength)|runtimeRequirements=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactRuntimeRequirementsColumn()))|nextTemporary=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactNextTemporaryColumn()))|edgeFingerprintFirst=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactEdgeFingerprintFirstColumn()))|edgeFingerprintSecond=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactEdgeFingerprintSecondColumn()))|behaviorInputFirst=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactBehaviorInputFirstColumn()))|behaviorInputSecond=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactBehaviorInputSecondColumn()))|behaviorOutputFirst=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactBehaviorOutputFirstColumn()))|behaviorOutputSecond=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactBehaviorOutputSecondColumn()))|behaviorClosureFirst=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactBehaviorClosureFirstColumn()))|behaviorClosureSecond=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactBehaviorClosureSecondColumn()))|reused=\(compilerIntTableValue(table: reachability.functionArtifacts, row: row, column: compilerFunctionArtifactReuseColumn()))\n")
        rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: text, start: functionStart, end: functionStart + functionLength))
        rawBufferAppendText(buffer: output, text: stringSliceUnchecked(source: text, start: globalsStart, end: globalsStart + globalsLength))
        rawBufferAppendText(buffer: output, text: String("\n"))
        row: row + 1
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: output)
}

function compilerReachableLLVMStateWriteFunctionArtifacts(reachability: CompilerReachableLLVMState, moduleText: String): Int {
    let path: String(compilerFunctionArtifactDirectivePath(source: reachability.context.program.source, name: String("range-function-artifact-output")))
    if path == String("") { return 0 }
    if reachability.counters.element(index: compilerReachableLLVMBehaviorGraphClosed()) == 1 { return 0 }
    if reachability.mainBehavior.count != 6 { return 0 - 1 }
    return writeFile(path: path, text: compilerReachableLLVMStateSerializeFunctionArtifacts(reachability: reachability, moduleText: moduleText))
}

function compilerFunctionArtifactCacheDestroy(cache: CompilerFunctionArtifactCache): Int {
    state status: Int(compilerIntTableDestroy(table: cache.artifacts))
    if cache.rowsByInstance.destroy() != 0 { status: 0 - 1 }
    if cache.rootBehavior.destroy() != 0 { status: 0 - 1 }
    return status
}
