    }
    return opaqueDestroyCount
}

function compilerMemoryOpaqueDestroyApplicationForLocal(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, localNodeID: Int): Int {
    if compilerMemoryOpaqueDestroyApplicationCount(tables: tables, delta: delta, semantics: semantics, localNodeID: localNodeID) != 1 { return 0 - 1 }
