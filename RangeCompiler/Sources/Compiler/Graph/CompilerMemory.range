}

function compilerMemoryBuildLayouts(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    state memoryLayoutNodeID: Int(0)
    let memoryLayoutNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryLayoutNodeID < memoryLayoutNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: memoryLayoutNodeID, column: 1) == compilerSyntaxKindConstruct() {
            let memoryFieldCount: Int(compilerMemoryConstructFieldCount(tables: tables, semantics: semantics, constructNodeID: memoryLayoutNodeID))
            if memoryFieldCount != 0 || compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryLayoutNodeID) != compilerRuntimeABIOpaqueStorage() {
            if memoryFieldCount <= 0 {
                compilerMemoryGraphPoison(memory: memory)
                return 0 - 1
            }
            if compilerMemoryAppendLayout(memory: memory, typeNodeID: memoryLayoutNodeID, fieldCount: memoryFieldCount, byteSize: memoryFieldCount * 4, alignment: 4) != 0 {
