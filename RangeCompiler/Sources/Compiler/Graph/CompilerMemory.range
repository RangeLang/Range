    let opaqueDestroyNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while opaqueDestroyNodeID < opaqueDestroyNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: opaqueDestroyNodeID, column: 1) == compilerSyntaxKindApplication()
            && compilerSemanticResolutionKind(semantics: semantics, useNodeID: opaqueDestroyNodeID) == compilerSemanticResolutionFunction()
            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: opaqueDestroyNodeID)) == compilerRuntimeABIFunctionDestroy() {
