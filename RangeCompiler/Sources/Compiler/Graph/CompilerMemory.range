function compilerRuntimeABINone(): Int { return 0 }
function compilerRuntimeABIOpaqueStorage(): Int { return 1 }
function compilerRuntimeABIFunctionNone(): Int { return 0 }
function compilerRuntimeABIFunctionCreate(): Int { return 1 }
function compilerRuntimeABIFunctionDestroy(): Int { return 2 }
function compilerRuntimeABIFunctionSharedRead(): Int { return 3 }
function compilerRuntimeABIFunctionUniqueWrite(): Int { return 4 }

function compilerRuntimeABIConstructKind(tables: CompilerSyntaxTables, constructNodeID: Int): Int {
    let runtimeConstructRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: constructNodeID))
    if runtimeConstructRow < 0
        || compilerIntTableValue(table: tables.declarations, row: runtimeConstructRow, column: 2) != compilerSyntaxKindConstruct()
        || compilerIntTableValue(table: tables.declarations, row: runtimeConstructRow, column: 13) != compilerBuiltinPolicyStorage() { return compilerRuntimeABINone() }
    state runtimeMemberRow: Int(0)
    let runtimeMemberCount: Int(compilerIntTableRowCount(table: tables.members))
    while runtimeMemberRow < runtimeMemberCount {
        if compilerIntTableValue(table: tables.members, row: runtimeMemberRow, column: 2) == constructNodeID {
            let runtimeMemberKind: Int(compilerIntTableValue(table: tables.members, row: runtimeMemberRow, column: 12))
            if runtimeMemberKind == compilerSyntaxMemberKindLet()
                || runtimeMemberKind == compilerSyntaxMemberKindState()
                || runtimeMemberKind == compilerSyntaxMemberKindBinding() { return compilerRuntimeABINone() }
        }
        runtimeMemberRow: runtimeMemberRow + 1
    }
    return compilerRuntimeABIOpaqueStorage()
}

function compilerRuntimeABIStorageTypeNodeID(tables: CompilerSyntaxTables, fileID: Int, start: Int, end: Int): Int {
    let runtimeType: CompilerSemanticType(compilerSemanticTypeFromSpan(tables: tables, fileID: fileID, typeStart: start, typeEnd: end))
    if compilerSemanticTypeKind(type: runtimeType) != compilerSemanticTypeConstruct()
        || compilerRuntimeABIConstructKind(tables: tables, constructNodeID: compilerSemanticTypeDeclaration(type: runtimeType)) != compilerRuntimeABIOpaqueStorage() { return 0 - 1 }
    return compilerSemanticTypeDeclaration(type: runtimeType)
}

function compilerRuntimeABIFunctionRole(tables: CompilerSyntaxTables, functionNodeID: Int): Int {
    let runtimeFunctionDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: functionNodeID))
    let runtimeFunctionRow: Int(compilerSemanticFunctionRowForSyntaxID(tables: tables, functionSyntaxID: functionNodeID))
    if runtimeFunctionDeclarationRow < 0 || runtimeFunctionRow < 0 { return compilerRuntimeABIFunctionNone() }
    let runtimePolicy: Int(compilerIntTableValue(table: tables.declarations, row: runtimeFunctionDeclarationRow, column: 13))
    let runtimeFunctionFileID: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 1))
    let runtimeReturnStart: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 6))
    let runtimeReturnEnd: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 7))
    if runtimePolicy == compilerBuiltinPolicyCreate() {
        if compilerRuntimeABIStorageTypeNodeID(tables: tables, fileID: runtimeFunctionFileID, start: runtimeReturnStart, end: runtimeReturnEnd) >= 0 { return compilerRuntimeABIFunctionCreate() }
        return compilerRuntimeABIFunctionNone()
    }
    if runtimePolicy != compilerBuiltinPolicyRead()
        && runtimePolicy != compilerBuiltinPolicyWrite()
        && runtimePolicy != compilerBuiltinPolicyDestroy() { return compilerRuntimeABIFunctionNone() }
    let runtimeParameterCount: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 3))
    if runtimeParameterCount < 1 { return compilerRuntimeABIFunctionNone() }
    let runtimeParameterRow: Int(compilerIntTableValue(table: tables.functions, row: runtimeFunctionRow, column: 2))
    let runtimeParameterFileID: Int(compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 1))
    if compilerRuntimeABIStorageTypeNodeID(tables: tables, fileID: runtimeParameterFileID, start: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 8), end: compilerIntTableValue(table: tables.parameters, row: runtimeParameterRow, column: 9)) < 0 { return compilerRuntimeABIFunctionNone() }
    if runtimePolicy == compilerBuiltinPolicyRead() { return compilerRuntimeABIFunctionSharedRead() }
    if runtimePolicy == compilerBuiltinPolicyWrite() { return compilerRuntimeABIFunctionUniqueWrite() }
    if runtimeParameterCount == 1
        && compilerSemanticLocalRangeEqualsText(tables: tables, fileID: runtimeFunctionFileID, start: runtimeReturnStart, end: runtimeReturnEnd, text: String("Int")) { return compilerRuntimeABIFunctionDestroy() }
    return compilerRuntimeABIFunctionNone()
}

function compilerMemoryOpaqueDestroyApplicationCount(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, localNodeID: Int): Int {
    state opaqueDestroyCount: Int(0)
