        } else {
            if valueID < 0 || valueID >= valueCount
                || partitionID != compilerIntTableValue(table: memory.runtimeValues, row: valueID, column: 2)
                || compilerIntTableValue(table: memory.representationChanges, row: row, column: 5) != compilerIntTableValue(table: memory.runtimeValues, row: valueID, column: 4)
                || compilerIntTableValue(table: memory.representationChanges, row: row, column: 6) != compilerIntTableValue(table: memory.runtimeValues, row: valueID, column: 5)
                || compilerIntTableValue(table: memory.representationChanges, row: row, column: 11) != compilerIntTableValue(table: memory.runtimeValues, row: valueID, column: 10) + 1 { return false }
        }
        row: row + 1
    }
    return true
}

