            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: opaqueDestroyNodeID)) == compilerRuntimeABIFunctionDestroy() {
            let opaqueDestroyArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: opaqueDestroyNodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: 0))
            let opaqueDestroyValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: opaqueDestroyArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if compilerSemanticResolutionKind(semantics: semantics, useNodeID: opaqueDestroyValueNodeID) == compilerSemanticResolutionLocal()
                && compilerSemanticResolutionTarget(semantics: semantics, useNodeID: opaqueDestroyValueNodeID) == localNodeID { return opaqueDestroyNodeID }
