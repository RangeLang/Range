}

function compilerMemoryOpaqueHandleHasUseAfterDestroy(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, localNodeID: Int, destroyNodeID: Int): Bool {
    let opaqueDestroyEnd: Int(compilerMemoryNodeEnd(tables: tables, delta: delta, nodeID: destroyNodeID))
