            let opaqueDestroyValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: opaqueDestroyArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if compilerSemanticResolutionKind(semantics: semantics, useNodeID: opaqueDestroyValueNodeID) == compilerSemanticResolutionLocal()
                && compilerSemanticResolutionTarget(semantics: semantics, useNodeID: opaqueDestroyValueNodeID) == localNodeID { opaqueDestroyCount: opaqueDestroyCount + 1 }
