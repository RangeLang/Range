                if !memoryLocalBindingAliasUse {
                    let memoryLocalEffectRow: Int(compilerMemoryEffectRowForParameter(semantics: semantics, parameterNodeID: memoryLocalParameterNodeID))
                    if memoryLocalEffectRow < 0 || compilerIntTableValue(table: semantics.parameterEffects, row: memoryLocalEffectRow, column: 4) != 0 { return true }
                }
            }
        }
        memoryLocalUseRow: memoryLocalUseRow + 1
    }
    return false
}

function compilerMemoryBuildStorages(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph): Int {
    state memoryLocalNodeID: Int(0)
    let memoryLocalNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while memoryLocalNodeID < memoryLocalNodeCount {
        let memoryLocalTypeKind: Int(compilerIntTableValue(table: semantics.nodeTypes, row: memoryLocalNodeID, column: 1))
        if compilerIntTableValue(table: delta.nodes, row: memoryLocalNodeID, column: 1) == compilerSyntaxKindLocalBinding()
            && (memoryLocalTypeKind == compilerSemanticTypeConstruct() || memoryLocalTypeKind == compilerSemanticTypeInt()) {
            let memoryLocalTypeNodeID: Int(compilerIntTableValue(table: semantics.nodeTypes, row: memoryLocalNodeID, column: 2))
            let memoryLocalFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: memoryLocalNodeID, column: 1))
            let memoryLocalRegionNodeID: Int(compilerIntTableValue(table: tables.bodyNodes, row: memoryLocalFacetRow, column: 2))
            if (memoryLocalTypeKind == compilerSemanticTypeConstruct()
                    && (compilerMemoryLocalEscapes(tables: tables, delta: delta, semantics: semantics, localNodeID: memoryLocalNodeID)
                        || (compilerMemoryLayoutRowForType(memory: memory, typeNodeID: memoryLocalTypeNodeID) < 0
                            && compilerRuntimeABIConstructKind(tables: tables, constructNodeID: memoryLocalTypeNodeID) != compilerRuntimeABIOpaqueStorage())))
                || (memoryLocalTypeKind == compilerSemanticTypeInt() && memoryLocalTypeNodeID != 0 - 1)
                || compilerMemoryAppendStorage(memory: memory, localNodeID: memoryLocalNodeID, typeNodeID: memoryLocalTypeNodeID, regionNodeID: memoryLocalRegionNodeID) < 0 {
                compilerMemoryGraphPoison(memory: memory)
                return 0 - 1
            }
        }
        memoryLocalNodeID: memoryLocalNodeID + 1
    }
    return 0
}

function compilerMemoryBuildLayoutDecisions(memory: CompilerMemoryGraph): Int {
