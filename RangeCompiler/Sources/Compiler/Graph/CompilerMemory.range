}

function compilerMemoryLocalEscapes(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, localNodeID: Int): Bool {
    state memoryLocalUseRow: Int(0)
    let memoryLocalUseCount: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while memoryLocalUseRow < memoryLocalUseCount {
        if compilerIntTableValue(table: semantics.resolutions, row: memoryLocalUseRow, column: 1) == localNodeID
            && compilerIntTableValue(table: semantics.resolutions, row: memoryLocalUseRow, column: 2) == compilerSemanticResolutionLocal() {
            let memoryLocalUseNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: memoryLocalUseRow, column: 0))
            if compilerSemanticGraphParent(delta: delta, objectNodeID: memoryLocalUseNodeID, roleTag: compilerSyntaxRoleReturnValue()) >= 0 { return true }
            let memoryLocalArgumentNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: memoryLocalUseNodeID, roleTag: compilerSyntaxRoleArgumentValue()))
            if memoryLocalArgumentNodeID >= 0 {
                let memoryLocalParameterNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memoryLocalArgumentNodeID))
                state memoryLocalBindingAliasUse: Bool(false)
                if compilerIntTableValue(table: delta.nodes, row: memoryLocalParameterNodeID, column: 1) == compilerSyntaxKindMember() {
                    let memoryLocalMemberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: memoryLocalParameterNodeID, column: 1))
                    if compilerIntTableValue(table: tables.members, row: memoryLocalMemberFacetRow, column: 12) == compilerSyntaxMemberKindBinding() {
                        memoryLocalBindingAliasUse: true
                    }
