        let changeKind: Int(compilerIntTableValue(table: memory.representationChanges, row: row, column: 2))
        let partitionID: Int(compilerIntTableValue(table: memory.representationChanges, row: row, column: 3))
        let valueID: Int(compilerIntTableValue(table: memory.representationChanges, row: row, column: 4))
        if compilerIntTableValue(table: memory.representationChanges, row: row, column: 0) != row
            || representationID < 0 || representationID >= representationCount
            || partitionID < 0 || partitionID >= partitionCount
            || compilerIntTableValue(table: memory.runtimePartitions, row: partitionID, column: 1) != representationID
            || (changeKind != compilerMemoryRepresentationChangePartitionAdded() && changeKind != compilerMemoryRepresentationChangeValueInserted())
