    }
    return 0
}

function compilerMemoryBuildPlacementDecisions(memory: CompilerMemoryGraph): Int {
    state memoryPlacementRow: Int(0)
    let memoryPlacementCount: Int(compilerIntTableRowCount(table: memory.storages))
    while memoryPlacementRow < memoryPlacementCount {
        let memoryPlacementStorageID: Int(compilerIntTableValue(table: memory.storages, row: memoryPlacementRow, column: 0))
        let memoryPlacementLocalNodeID: Int(compilerIntTableValue(table: memory.storages, row: memoryPlacementRow, column: 1))
