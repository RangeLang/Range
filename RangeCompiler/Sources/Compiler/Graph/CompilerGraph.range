function compilerGraphNodeColumnCount(): Int { return 8 }
function compilerGraphFactColumnCount(): Int { return 5 }
function compilerGraphIdentityNodeColumnCount(): Int { return 8 }
function compilerGraphPlottedRelationshipColumnCount(): Int { return 13 }
function compilerGraphNominalColumnCount(): Int { return 10 }
function compilerGraphNominalReferenceColumnCount(): Int { return 14 }
function compilerGraphGeneratedFunctionColumnCount(): Int { return 25 }
function compilerGraphGeneratedMemberColumnCount(): Int { return 24 }
function compilerGraphGeneratedMemberRowColumn(): Int { return 0 }
function compilerGraphGeneratedMemberKindColumn(): Int { return 1 }
function compilerGraphGeneratedMemberOwnerColumn(): Int { return 2 }
function compilerGraphGeneratedMemberFileColumn(): Int { return 3 }
function compilerGraphGeneratedMemberStartColumn(): Int { return 4 }
function compilerGraphGeneratedMemberEndColumn(): Int { return 5 }
function compilerGraphGeneratedMemberNameStartColumn(): Int { return 6 }
function compilerGraphGeneratedMemberNameEndColumn(): Int { return 7 }
function compilerGraphGeneratedMemberTypeStartColumn(): Int { return 8 }
function compilerGraphGeneratedMemberTypeEndColumn(): Int { return 9 }
function compilerGraphGeneratedMemberMacroDeclarationColumn(): Int { return 10 }
function compilerGraphGeneratedMemberApplicationColumn(): Int { return 11 }
function compilerGraphGeneratedMemberTemplateOrdinalColumn(): Int { return 12 }
function compilerGraphGeneratedMemberApplicationIdentityFirstColumn(): Int { return 13 }
function compilerGraphGeneratedMemberApplicationIdentitySecondColumn(): Int { return 14 }
function compilerGraphGeneratedMemberTargetIdentityFirstColumn(): Int { return 15 }
function compilerGraphGeneratedMemberTargetIdentitySecondColumn(): Int { return 16 }
function compilerGraphGeneratedMemberStableIdentityFirstColumn(): Int { return 17 }
function compilerGraphGeneratedMemberStableIdentitySecondColumn(): Int { return 18 }
function compilerGraphGeneratedMemberPlacementColumn(): Int { return 19 }
function compilerGraphGeneratedMemberLexicalParentOrdinalColumn(): Int { return 20 }
function compilerGraphGeneratedMemberParentIdentityFirstColumn(): Int { return 21 }
function compilerGraphGeneratedMemberParentIdentitySecondColumn(): Int { return 22 }
function compilerGraphGeneratedMemberMemberKindColumn(): Int { return 23 }
function compilerGraphGeneratedKindFunction(): Int { return 1 }
function compilerGraphGeneratedKindMember(): Int { return 2 }
function compilerGraphGeneratedKindEnum(): Int { return 5 }
function compilerGraphFactOwns(): Int { return 1 }
function compilerGraphFactAppliesTo(): Int { return 2 }
function compilerGraphFactOmitted(): Int { return 3 }
function compilerGraphRoleMember(): Int { return 10 }
function compilerGraphRoleParameter(): Int { return 11 }
function compilerGraphRoleExpansion(): Int { return 22 }
function compilerGraphFacetDeclaration(): Int { return 1 }
function compilerGraphFacetMember(): Int { return 2 }
function compilerGraphFacetParameter(): Int { return 3 }
function compilerGraphFacetEntry(): Int { return 4 }
function compilerGraphFacetStatement(): Int { return 5 }
function compilerGraphFacetExpression(): Int { return 6 }
function compilerGraphFacetArgument(): Int { return 7 }
function compilerGraphFacetMainAnnotation(): Int { return 8 }
function compilerGraphFacetApplication(): Int { return 9 }
function compilerGraphFacetRegion(): Int { return 10 }
function compilerGraphFacetMacroDeclaration(): Int { return 11 }
function compilerGraphFacetMacroApplication(): Int { return 12 }
function compilerGraphFacetSlot(): Int { return 13 }
function compilerGraphNominalRoleMemberType(): Int { return 1 }
function compilerGraphNominalRoleParameterType(): Int { return 2 }
function compilerGraphNominalRoleFunctionReturn(): Int { return 3 }
function compilerGraphNominalRoleLocalType(): Int { return 4 }
function compilerGraphNominalRoleGenericConstraint(): Int { return 5 }
function compilerGraphNominalRoleMacroApplication(): Int { return 6 }
function compilerGraphNominalTargetMismatch(): Int { return 6 }
function compilerGraphNominalMissingTarget(): Int { return 7 }
function compilerGraphNominalKindConstruct(): Int { return 1 }
function compilerGraphNominalKindEnum(): Int { return 2 }
function compilerGraphNominalKindFunction(): Int { return 3 }
function compilerGraphNominalKindMacro(): Int { return 4 }
function compilerGraphNominalKindLet(): Int { return 5 }
function compilerGraphNominalKindState(): Int { return 6 }
function compilerGraphNominalKindBinding(): Int { return 7 }
function compilerGraphNominalKindDerived(): Int { return 8 }
function compilerGraphNominalKindCase(): Int { return 9 }

function compilerGraphDeltaCreate(): CompilerGraphDelta {
    return CompilerGraphDelta(
        nodes: compilerIntTableCreate(columnCount: compilerGraphNodeColumnCount(), estimatedRowCount: 256),
        facts: compilerIntTableCreate(columnCount: compilerGraphFactColumnCount(), estimatedRowCount: 256),
        identities: compilerIntTableCreate(columnCount: compilerGraphIdentityNodeColumnCount(), estimatedRowCount: 256),
        relationships: compilerIntTableCreate(columnCount: compilerGraphPlottedRelationshipColumnCount(), estimatedRowCount: 256),
        nominals: compilerIntTableCreate(columnCount: compilerGraphNominalColumnCount(), estimatedRowCount: 128),
        nominalReferences: compilerIntTableCreate(columnCount: compilerGraphNominalReferenceColumnCount(), estimatedRowCount: 128),
        generatedFunctions: compilerIntTableCreate(columnCount: compilerGraphGeneratedFunctionColumnCount(), estimatedRowCount: 32),
        generatedMembers: compilerIntTableCreate(columnCount: compilerGraphGeneratedMemberColumnCount(), estimatedRowCount: 32),
        failures: bufferCreateInt(capacity: 1)
    )
}

function compilerGraphDeltaDestroy(delta: CompilerGraphDelta): Int {
    state graphDestroyStatus: Int(0)
    if compilerIntTableDestroy(table: delta.nodes) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.facts) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.identities) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.relationships) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.nominals) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.nominalReferences) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.generatedFunctions) != 0 { graphDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: delta.generatedMembers) != 0 { graphDestroyStatus: 0 - 1 }
    if delta.failures.destroy() != 0 { graphDestroyStatus: 0 - 1 }
    return graphDestroyStatus
}

function compilerGraphDeltaPoison(delta: CompilerGraphDelta): Int {
    return delta.failures.append(element: 1)
}

function compilerGraphDeltaAppend(delta: CompilerGraphDelta, table: CompilerIntTable, value: Int): Int {
    let graphAppendStatus: Int(compilerIntTableAppend(table: table, value: value))
    if graphAppendStatus != 0 { compilerGraphDeltaPoison(delta: delta) }
    return graphAppendStatus
}

function compilerGraphDeltaAppendGeneratedMember(delta: CompilerGraphDelta, change: CompilerGeneratedMemberDelta): Int {
    let row: Int(compilerIntTableRowCount(table: delta.generatedMembers))
    if compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: row) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: compilerGraphGeneratedKindMember()) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.ownerSyntaxID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.fileID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.memberStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.memberEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.nameStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.nameEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.typeStart) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.typeEnd) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.macroDeclarationRow) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.applicationRow) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.templateOrdinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.applicationIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.applicationIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.targetIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.targetIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.stableIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.stableIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.placement) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.lexicalParentOrdinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.parentIdentity.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.parentIdentity.second) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.generatedMembers, value: change.memberKind) != 0 {
        return 0 - 1
    }
    return row
}

function compilerGraphGeneratedMemberDelta(table: CompilerIntTable, row: Int): CompilerGeneratedMemberDelta {
    return CompilerGeneratedMemberDelta(
        ownerSyntaxID: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberOwnerColumn()),
        fileID: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberFileColumn()),
        memberStart: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberStartColumn()),
        memberEnd: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberEndColumn()),
        nameStart: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberNameStartColumn()),
        nameEnd: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberNameEndColumn()),
        typeStart: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberTypeStartColumn()),
        typeEnd: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberTypeEndColumn()),
        macroDeclarationRow: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberMacroDeclarationColumn()),
        applicationRow: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberApplicationColumn()),
        templateOrdinal: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberTemplateOrdinalColumn()),
        applicationIdentity: CompilerFingerprint(
            first: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberApplicationIdentityFirstColumn()),
            second: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberApplicationIdentitySecondColumn())
        ),
        targetIdentity: CompilerFingerprint(
            first: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberTargetIdentityFirstColumn()),
            second: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberTargetIdentitySecondColumn())
        ),
        stableIdentity: CompilerFingerprint(
            first: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberStableIdentityFirstColumn()),
            second: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberStableIdentitySecondColumn())
        ),
        placement: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberPlacementColumn()),
        lexicalParentOrdinal: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberLexicalParentOrdinalColumn()),
        parentIdentity: CompilerFingerprint(
            first: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberParentIdentityFirstColumn()),
            second: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberParentIdentitySecondColumn())
        ),
        memberKind: compilerIntTableValue(table: table, row: row, column: compilerGraphGeneratedMemberMemberKindColumn())
    )
}

function compilerGraphDeltaMergeIdentityTable(delta: CompilerGraphDelta, destination: CompilerIntTable, source: CompilerIntTable): Int {
    if destination.columnCount != source.columnCount || !compilerIntTableIsComplete(table: source) { return 0 - 1 }
    let rowBase: Int(compilerIntTableRowCount(table: destination))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: source) {
        state column: Int(0)
        while column < source.columnCount {
            state value: Int(compilerIntTableValue(table: source, row: row, column: column))
            if column == 0 { value: value + rowBase }
            if compilerGraphDeltaAppend(delta: delta, table: destination, value: value) != 0 { return 0 - 1 }
            column: column + 1
        }
        row: row + 1
    }
    return 0
}

function compilerGraphDeltaMergeFacts(delta: CompilerGraphDelta, destination: CompilerIntTable, source: CompilerIntTable, nodeBase: Int): Int {
    if destination.columnCount != source.columnCount || source.columnCount != compilerGraphFactColumnCount()
        || !compilerIntTableIsComplete(table: source) { return 0 - 1 }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: source) {
        state column: Int(0)
        while column < source.columnCount {
            state value: Int(compilerIntTableValue(table: source, row: row, column: column))
            if column == 1 || column == 2 || column == 4 { value: value + nodeBase }
            if compilerGraphDeltaAppend(delta: delta, table: destination, value: value) != 0 { return 0 - 1 }
            column: column + 1
        }
        row: row + 1
    }
    return 0
}

function compilerGraphDeltaMerge(delta: CompilerGraphDelta, source: CompilerGraphDelta): Int {
    if source.failures.count != 0 || delta.failures.count != 0
        || compilerIntTableRowCount(table: source.identities) != 0
        || compilerIntTableRowCount(table: source.relationships) != 0
        || compilerIntTableRowCount(table: delta.identities) != 0
        || compilerIntTableRowCount(table: delta.relationships) != 0
        || compilerIntTableRowCount(table: source.nominals) != 0
        || compilerIntTableRowCount(table: source.nominalReferences) != 0 { return 0 - 1 }
    let nodeBase: Int(compilerIntTableRowCount(table: delta.nodes))
    if compilerGraphDeltaMergeIdentityTable(delta: delta, destination: delta.nodes, source: source.nodes) != 0
        || compilerGraphDeltaMergeFacts(delta: delta, destination: delta.facts, source: source.facts, nodeBase: nodeBase) != 0
        || compilerGraphDeltaMergeIdentityTable(delta: delta, destination: delta.generatedFunctions, source: source.generatedFunctions) != 0
        || compilerGraphDeltaMergeIdentityTable(delta: delta, destination: delta.generatedMembers, source: source.generatedMembers) != 0 {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    return 0
}

function compilerGraphDeltaAppendNode(delta: CompilerGraphDelta, kindTag: Int, syntaxID: Int, declarationSyntaxID: Int, fileID: Int, start: Int, end: Int, facetKind: Int): Int {
    let nodeID: Int(compilerIntTableRowCount(table: delta.nodes))
    if syntaxID < 0 || fileID < 0 || start < 0 || end < start || facetKind <= 0 {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: nodeID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: kindTag) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: syntaxID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: declarationSyntaxID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: fileID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: start) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: end) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nodes, value: facetKind) != 0 { return 0 - 1 }
    return nodeID
}

function compilerGraphDeltaAppendFact(delta: CompilerGraphDelta, factKind: Int, subjectNodeID: Int, objectNodeID: Int, roleTag: Int, ordinal: Int): Int {
    if subjectNodeID < 0 || objectNodeID < 0 || roleTag <= 0 || ordinal < 0 {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    if compilerGraphDeltaAppend(delta: delta, table: delta.facts, value: factKind) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.facts, value: subjectNodeID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.facts, value: objectNodeID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.facts, value: roleTag) != 0 { return 0 - 1 }
    return compilerGraphDeltaAppend(delta: delta, table: delta.facts, value: ordinal)
}

function compilerGraphDeltaAppendIdentity(delta: CompilerGraphDelta, identityKind: Int, identityID: Int, kindTag: Int, fileID: Int, start: Int, end: Int, facetKind: Int): Int {
    let identityNodeID: Int(compilerIntTableRowCount(table: delta.identities))
    if (identityKind != compilerGraphIdentitySyntax()
        && identityKind != compilerGraphIdentityMacroDeclaration()
        && identityKind != compilerGraphIdentityMacroApplication()
        && identityKind != compilerGraphIdentitySlot())
        || identityID < 0 || kindTag < 0 || fileID < 0 || start < 0 || end < start || facetKind <= 0 {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: identityNodeID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: identityKind) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: identityID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: kindTag) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: fileID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: start) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: end) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.identities, value: facetKind) != 0 { return 0 - 1 }
    return identityNodeID
}

function compilerGraphDeltaAppendRelationship(delta: CompilerGraphDelta, role: Int, originNodeID: Int, destinationNodeID: Int, ordinal: Int, minimum: Int, maximumKind: Int, maximum: Int, ordering: Int, separatorKind: Int, separatorID: Int, enclosureKind: Int, enclosureID: Int): Int {
    let relationshipID: Int(compilerIntTableRowCount(table: delta.relationships))
    if role <= 0 || originNodeID < 0 || destinationNodeID < 0 || ordinal < 0 || minimum < 0
        || (maximumKind != compilerGraphBoundFinite() && maximumKind != compilerGraphBoundUnbounded())
        || (maximumKind == compilerGraphBoundFinite() && maximum < minimum)
        || (maximumKind == compilerGraphBoundUnbounded() && maximum != 0 - 1)
        || (ordering != compilerGraphOrderingUnordered() && ordering != compilerGraphOrderingOrdered())
        || !compilerGraphSeparatorKindIsValid(kind: separatorKind)
        || (separatorKind == compilerGraphSeparatorNone() && separatorID != 0 - 1)
        || (separatorKind != compilerGraphSeparatorNone() && separatorID < 0)
        || !compilerGraphEnclosureKindIsValid(kind: enclosureKind)
        || (enclosureKind == compilerGraphEnclosureNone() && enclosureID != 0 - 1)
        || (enclosureKind != compilerGraphEnclosureNone() && enclosureID < 0) {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: relationshipID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: role) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: originNodeID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: destinationNodeID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: ordinal) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: minimum) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: maximumKind) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: maximum) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: ordering) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: separatorKind) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: separatorID) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: enclosureKind) != 0 { return 0 - 1 }
    if compilerGraphDeltaAppend(delta: delta, table: delta.relationships, value: enclosureID) != 0 { return 0 - 1 }
    return relationshipID
}

function compilerPlotterFunctionSyntaxID(tables: CompilerSyntaxTables, functionID: Int): Int {
    if functionID < 0 || functionID >= compilerIntTableRowCount(table: tables.functions) { return 0 - 1 }
    return compilerIntTableValue(table: tables.functions, row: functionID, column: 0)
}

function compilerPlotterFacetKind(kindTag: Int): Int {
    if kindTag == compilerSyntaxKindConstruct() || kindTag == compilerSyntaxKindFunction() || kindTag == compilerSyntaxKindEnum() { return compilerGraphFacetDeclaration() }
    if kindTag == compilerSyntaxKindMember() { return compilerGraphFacetMember() }
    if kindTag == compilerSyntaxKindParameter() { return compilerGraphFacetParameter() }
    if kindTag == compilerSyntaxKindEntry() { return compilerGraphFacetEntry() }
    if kindTag == compilerSyntaxKindMainAnnotation() { return compilerGraphFacetMainAnnotation() }
    if kindTag == compilerSyntaxKindLocalBinding() || kindTag == compilerSyntaxKindReturn() || kindTag == compilerSyntaxKindAssignment() || kindTag == compilerSyntaxKindIf() { return compilerGraphFacetStatement() }
    if kindTag == compilerSyntaxKindLexicalRegion() { return compilerGraphFacetRegion() }
    if kindTag == compilerSyntaxKindArgument() { return compilerGraphFacetArgument() }
    if kindTag == compilerSyntaxKindApplication() { return compilerGraphFacetApplication() }
    return compilerGraphFacetExpression()
}

function compilerPlotterAppendSyntaxNode(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, syntaxID: Int): Int {
    let plotKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0))
    let plotFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
    state plotDeclarationSyntaxID: Int(0 - 1)
    state plotFileID: Int(0 - 1)
    state plotStart: Int(0 - 1)
    state plotEnd: Int(0 - 1)
    if plotKindTag == compilerSyntaxKindConstruct() || plotKindTag == compilerSyntaxKindFunction() || plotKindTag == compilerSyntaxKindEnum() {
        let plotDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
        if plotDeclarationRow < 0 {
            compilerGraphDeltaPoison(delta: delta)
            return 0 - 1
        }
        plotDeclarationSyntaxID: syntaxID
        plotFileID: compilerIntTableValue(table: tables.declarations, row: plotDeclarationRow, column: 1)
        plotStart: compilerIntTableValue(table: tables.declarations, row: plotDeclarationRow, column: 5)
        plotEnd: compilerIntTableValue(table: tables.declarations, row: plotDeclarationRow, column: 6)
    } else if plotKindTag == compilerSyntaxKindMember() {
        plotDeclarationSyntaxID: compilerIntTableValue(table: tables.members, row: plotFacetRow, column: 2)
        plotFileID: compilerIntTableValue(table: tables.members, row: plotFacetRow, column: 1)
        plotStart: compilerIntTableValue(table: tables.members, row: plotFacetRow, column: 4)
        plotEnd: compilerIntTableValue(table: tables.members, row: plotFacetRow, column: 5)
    } else if plotKindTag == compilerSyntaxKindParameter() {
        let plotFunctionID: Int(compilerIntTableValue(table: tables.parameters, row: plotFacetRow, column: 2))
        plotDeclarationSyntaxID: compilerPlotterFunctionSyntaxID(tables: tables, functionID: plotFunctionID)
        plotFileID: compilerIntTableValue(table: tables.parameters, row: plotFacetRow, column: 1)
        plotStart: compilerIntTableValue(table: tables.parameters, row: plotFacetRow, column: 4)
        plotEnd: compilerIntTableValue(table: tables.parameters, row: plotFacetRow, column: 5)
    } else {
        let plotOwnerSyntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: plotFacetRow, column: 2))
        if plotOwnerSyntaxID >= 0 && compilerIntTableValue(table: tables.syntaxIndex, row: plotOwnerSyntaxID, column: 0) == compilerSyntaxKindFunction() {
            plotDeclarationSyntaxID: plotOwnerSyntaxID
        }
        plotFileID: compilerIntTableValue(table: tables.bodyNodes, row: plotFacetRow, column: 1)
        plotStart: compilerIntTableValue(table: tables.bodyNodes, row: plotFacetRow, column: 4)
        plotEnd: compilerIntTableValue(table: tables.bodyNodes, row: plotFacetRow, column: 5)
    }
    return compilerGraphDeltaAppendNode(delta: delta, kindTag: plotKindTag, syntaxID: syntaxID, declarationSyntaxID: plotDeclarationSyntaxID, fileID: plotFileID, start: plotStart, end: plotEnd, facetKind: compilerPlotterFacetKind(kindTag: plotKindTag))
}

function compilerPlotterNodeIDForSyntaxID(delta: CompilerGraphDelta, syntaxID: Int): Int {
    if syntaxID >= 0 && syntaxID < compilerIntTableRowCount(table: delta.nodes)
        && compilerIntTableValue(table: delta.nodes, row: syntaxID, column: 2) == syntaxID { return syntaxID }
    return 0 - 1
}

function compilerGraphIdentityNodeIDFor(delta: CompilerGraphDelta, identityKind: Int, identityID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.identities) {
        if compilerIntTableValue(table: delta.identities, row: row, column: 1) == identityKind
            && compilerIntTableValue(table: delta.identities, row: row, column: 2) == identityID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerPlotterAppendSyntaxIdentity(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, syntaxID: Int): Int {
    let syntaxNodeID: Int(compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: syntaxID))
    if syntaxNodeID < 0 { return 0 - 1 }
    return compilerGraphDeltaAppendIdentity(
        delta: delta,
        identityKind: compilerGraphIdentitySyntax(),
        identityID: syntaxID,
        kindTag: compilerIntTableValue(table: delta.nodes, row: syntaxNodeID, column: 1),
        fileID: compilerIntTableValue(table: delta.nodes, row: syntaxNodeID, column: 4),
        start: compilerIntTableValue(table: delta.nodes, row: syntaxNodeID, column: 5),
        end: compilerIntTableValue(table: delta.nodes, row: syntaxNodeID, column: 6),
        facetKind: compilerIntTableValue(table: delta.nodes, row: syntaxNodeID, column: 7)
    )
}

function compilerPlotterAppendMacroDeclarationIdentity(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, macroDeclarationRow: Int): Int {
    return compilerGraphDeltaAppendIdentity(
        delta: delta,
        identityKind: compilerGraphIdentityMacroDeclaration(),
        identityID: macroDeclarationRow,
        kindTag: compilerGraphNominalKindMacro(),
        fileID: compilerIntTableValue(table: tables.macroDeclarations, row: macroDeclarationRow, column: 1),
        start: compilerIntTableValue(table: tables.macroDeclarations, row: macroDeclarationRow, column: 2),
        end: compilerIntTableValue(table: tables.macroDeclarations, row: macroDeclarationRow, column: 3),
        facetKind: compilerGraphFacetMacroDeclaration()
    )
}

function compilerPlotterAppendMacroApplicationIdentity(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, macroApplicationRow: Int): Int {
    return compilerGraphDeltaAppendIdentity(
        delta: delta,
        identityKind: compilerGraphIdentityMacroApplication(),
        identityID: macroApplicationRow,
        kindTag: compilerIntTableValue(table: tables.macroApplications, row: macroApplicationRow, column: 13),
        fileID: compilerIntTableValue(table: tables.macroApplications, row: macroApplicationRow, column: 1),
        start: compilerIntTableValue(table: tables.macroApplications, row: macroApplicationRow, column: 2),
        end: compilerIntTableValue(table: tables.macroApplications, row: macroApplicationRow, column: 3),
        facetKind: compilerGraphFacetMacroApplication()
    )
}

function compilerPlotterAppendSlotIdentity(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, slotID: Int): Int {
    let ownerKind: Int(compilerIntTableValue(table: tables.slots, row: slotID, column: 1))
    let ownerSyntaxID: Int(compilerIntTableValue(table: tables.slots, row: slotID, column: 2))
    if ownerKind != compilerGraphIdentitySyntax() { return 0 - 1 }
    return compilerGraphDeltaAppendIdentity(
        delta: delta,
        identityKind: compilerGraphIdentitySlot(),
        identityID: slotID,
        kindTag: compilerIntTableValue(table: tables.slots, row: slotID, column: 3),
        fileID: compilerMacroSyntaxNodeFileID(tables: tables, syntaxID: ownerSyntaxID),
        start: compilerMacroSyntaxNodeStart(tables: tables, syntaxID: ownerSyntaxID),
        end: compilerMacroSyntaxNodeEnd(tables: tables, syntaxID: ownerSyntaxID),
        facetKind: compilerGraphFacetSlot()
    )
}

function compilerPlotterAppendIdentityNodes(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state syntaxID: Int(0)
    while syntaxID < compilerIntTableRowCount(table: tables.syntaxIndex) {
        if compilerPlotterAppendSyntaxIdentity(tables: tables, delta: delta, syntaxID: syntaxID) != syntaxID { return 0 - 1 }
        syntaxID: syntaxID + 1
    }
    state macroDeclarationRow: Int(0)
    while macroDeclarationRow < compilerIntTableRowCount(table: tables.macroDeclarations) {
        let identityNodeID: Int(compilerPlotterAppendMacroDeclarationIdentity(tables: tables, delta: delta, macroDeclarationRow: macroDeclarationRow))
        if identityNodeID < 0 { return 0 - 1 }
        macroDeclarationRow: macroDeclarationRow + 1
    }
    state macroApplicationRow: Int(0)
    while macroApplicationRow < compilerIntTableRowCount(table: tables.macroApplications) {
        let identityNodeID: Int(compilerPlotterAppendMacroApplicationIdentity(tables: tables, delta: delta, macroApplicationRow: macroApplicationRow))
        if identityNodeID < 0 { return 0 - 1 }
        macroApplicationRow: macroApplicationRow + 1
    }
    state slotID: Int(0)
    while slotID < compilerIntTableRowCount(table: tables.slots) {
        let identityNodeID: Int(compilerPlotterAppendSlotIdentity(tables: tables, delta: delta, slotID: slotID))
        if identityNodeID < 0 { return 0 - 1 }
        slotID: slotID + 1
    }
    return 0
}

function compilerPlotterAppendRegisteredRelationships(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state relationshipRow: Int(0)
    while relationshipRow < compilerIntTableRowCount(table: tables.relationships) {
        let originNodeID: Int(compilerGraphIdentityNodeIDFor(
            delta: delta,
            identityKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 2),
            identityID: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 3)
        ))
        let destinationNodeID: Int(compilerGraphIdentityNodeIDFor(
            delta: delta,
            identityKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 4),
            identityID: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 5)
        ))
        if compilerGraphDeltaAppendRelationship(
            delta: delta,
            role: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 1),
            originNodeID: originNodeID,
            destinationNodeID: destinationNodeID,
            ordinal: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 6),
            minimum: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 7),
            maximumKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 8),
            maximum: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 9),
            ordering: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 10),
            separatorKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 11),
            separatorID: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 12),
            enclosureKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 13),
            enclosureID: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 14)
        ) != relationshipRow { return 0 - 1 }
        relationshipRow: relationshipRow + 1
    }
    return 0
}

function compilerPlotterAppendSlotRelationships(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state slotID: Int(0)
    while slotID < compilerIntTableRowCount(table: tables.slots) {
        let ownerNodeID: Int(compilerGraphIdentityNodeIDFor(
            delta: delta,
            identityKind: compilerIntTableValue(table: tables.slots, row: slotID, column: 1),
            identityID: compilerIntTableValue(table: tables.slots, row: slotID, column: 2)
        ))
        let slotNodeID: Int(compilerGraphIdentityNodeIDFor(delta: delta, identityKind: compilerGraphIdentitySlot(), identityID: slotID))
        if compilerGraphDeltaAppendRelationship(
            delta: delta,
            role: compilerGraphRelationshipSlot(),
            originNodeID: ownerNodeID,
            destinationNodeID: slotNodeID,
            ordinal: compilerIntTableValue(table: tables.slots, row: slotID, column: 4),
            minimum: compilerIntTableValue(table: tables.slots, row: slotID, column: 5),
            maximumKind: compilerIntTableValue(table: tables.slots, row: slotID, column: 6),
            maximum: compilerIntTableValue(table: tables.slots, row: slotID, column: 7),
            ordering: compilerIntTableValue(table: tables.slots, row: slotID, column: 8),
            separatorKind: compilerIntTableValue(table: tables.slots, row: slotID, column: 9),
            separatorID: compilerIntTableValue(table: tables.slots, row: slotID, column: 10),
            enclosureKind: compilerIntTableValue(table: tables.slots, row: slotID, column: 11),
            enclosureID: compilerIntTableValue(table: tables.slots, row: slotID, column: 12)
        ) < 0 { return 0 - 1 }
        slotID: slotID + 1
    }
    state occurrenceID: Int(0)
    while occurrenceID < compilerIntTableRowCount(table: tables.slotOccurrences) {
        let slotID: Int(compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceID, column: 1))
        let slotNodeID: Int(compilerGraphIdentityNodeIDFor(delta: delta, identityKind: compilerGraphIdentitySlot(), identityID: slotID))
        let targetNodeID: Int(compilerGraphIdentityNodeIDFor(
            delta: delta,
            identityKind: compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceID, column: 2),
            identityID: compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceID, column: 3)
        ))
        if compilerGraphDeltaAppendRelationship(
            delta: delta,
            role: compilerGraphRelationshipSlotOccurrence(),
            originNodeID: slotNodeID,
            destinationNodeID: targetNodeID,
            ordinal: compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceID, column: 4),
            minimum: 1,
            maximumKind: compilerGraphBoundFinite(),
            maximum: 1,
            ordering: compilerGraphOrderingOrdered(),
            separatorKind: compilerGraphSeparatorNone(),
            separatorID: 0 - 1,
            enclosureKind: compilerGraphEnclosureNone(),
            enclosureID: 0 - 1
        ) < 0 { return 0 - 1 }
        occurrenceID: occurrenceID + 1
    }
    return 0
}

function compilerPlotterAppendMemberFacts(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, subjectSyntaxID: Int): Int {
    state relationshipRow: Int(0)
    while relationshipRow < compilerIntTableRowCount(table: tables.relationships) {
        if compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 1) == compilerGraphRelationshipMember()
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 2) == compilerGraphIdentitySyntax()
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 3) == subjectSyntaxID
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 4) == compilerGraphIdentitySyntax() {
            let memberSyntaxID: Int(compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 5))
            let memberOrdinal: Int(compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 6))
            if compilerGraphDeltaAppendFact(delta: delta, factKind: compilerGraphFactOwns(), subjectNodeID: compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: subjectSyntaxID), objectNodeID: compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: memberSyntaxID), roleTag: compilerGraphRoleMember(), ordinal: memberOrdinal) != 0 { return 0 - 1 }
        }
        relationshipRow: relationshipRow + 1
    }
    return 0
}

function compilerPlotterMemberRelationshipCount(tables: CompilerSyntaxTables): Int {
    state count: Int(0)
    state relationshipRow: Int(0)
    while relationshipRow < compilerIntTableRowCount(table: tables.relationships) {
        if compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 1) == compilerGraphRelationshipMember()
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 2) == compilerGraphIdentitySyntax()
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 4) == compilerGraphIdentitySyntax() {
            count: count + 1
        }
        relationshipRow: relationshipRow + 1
    }
    return count
}

function compilerPlotterAppendParameterFacts(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, subjectSyntaxID: Int): Int {
    state relationshipRow: Int(0)
    while relationshipRow < compilerIntTableRowCount(table: tables.relationships) {
        if compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 1) == compilerGraphRelationshipParameter()
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 2) == compilerGraphIdentitySyntax()
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 3) == subjectSyntaxID
            && compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 4) == compilerGraphIdentitySyntax() {
            let parameterSyntaxID: Int(compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 5))
            let parameterOrdinal: Int(compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 6))
            if compilerGraphDeltaAppendFact(delta: delta, factKind: compilerGraphFactOwns(), subjectNodeID: compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: subjectSyntaxID), objectNodeID: compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: parameterSyntaxID), roleTag: compilerGraphRoleParameter(), ordinal: parameterOrdinal) != 0 { return 0 - 1 }
        }
        relationshipRow: relationshipRow + 1
    }
    return 0
}

function compilerPlotterAppendBodyFacts(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, subjectSyntaxID: Int, roleTag: Int): Int {
    state plotBodyEdgeRow: Int(0)
    let plotBodyEdgeCount: Int(compilerIntTableRowCount(table: tables.bodyEdges))
    while plotBodyEdgeRow < plotBodyEdgeCount {
        if compilerIntTableValue(table: tables.bodyEdges, row: plotBodyEdgeRow, column: 0) == subjectSyntaxID
            && compilerIntTableValue(table: tables.bodyEdges, row: plotBodyEdgeRow, column: 2) == roleTag {
            let plotBodyChildSyntaxID: Int(compilerIntTableValue(table: tables.bodyEdges, row: plotBodyEdgeRow, column: 1))
            let plotBodyOrdinal: Int(compilerIntTableValue(table: tables.bodyEdges, row: plotBodyEdgeRow, column: 3))
            state plotBodyFactKind: Int(compilerGraphFactOwns())
            if roleTag == compilerSyntaxRoleAppliesTo() { plotBodyFactKind: compilerGraphFactAppliesTo() }
            if compilerGraphDeltaAppendFact(delta: delta, factKind: plotBodyFactKind, subjectNodeID: compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: subjectSyntaxID), objectNodeID: compilerPlotterNodeIDForSyntaxID(delta: delta, syntaxID: plotBodyChildSyntaxID), roleTag: roleTag, ordinal: plotBodyOrdinal) != 0 { return 0 - 1 }
        }
        plotBodyEdgeRow: plotBodyEdgeRow + 1
    }
    return 0
}

function compilerGraphNominalIDForSyntaxID(delta: CompilerGraphDelta, syntaxID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nominals) {
        if compilerIntTableValue(table: delta.nominals, row: row, column: 2) == syntaxID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerGraphDeltaAppendNominal(delta: CompilerGraphDelta, kind: Int, syntaxID: Int, sourceRow: Int, parentNominalID: Int, fileID: Int, start: Int, end: Int, fingerprint: CompilerFingerprint): Int {
    let nominalID: Int(compilerIntTableRowCount(table: delta.nominals))
    if kind < compilerGraphNominalKindConstruct() || kind > compilerGraphNominalKindCase()
        || syntaxID < 0 - 1 || sourceRow < 0 || parentNominalID < 0 - 1 || parentNominalID >= nominalID
        || fileID < 0 || start < 0 || end <= start
        || (fingerprint.first == 0 && fingerprint.second == 0) {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: nominalID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: kind) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: syntaxID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: sourceRow) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: parentNominalID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: fileID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: start) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: end) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: fingerprint.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominals, value: fingerprint.second) != 0 { return 0 - 1 }
    return nominalID
}

function compilerGraphNominalKindForDeclaration(tables: CompilerSyntaxTables, declarationRow: Int): Int {
    let kind: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2))
    if kind == compilerSyntaxKindConstruct() { return compilerGraphNominalKindConstruct() }
    if kind == compilerSyntaxKindEnum() { return compilerGraphNominalKindEnum() }
    if kind == compilerSyntaxKindFunction() {
        let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
        let functionRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
        if functionRow >= 0 && functionRow < compilerIntTableRowCount(table: tables.functions)
            && compilerIntTableValue(table: tables.functions, row: functionRow, column: compilerSyntaxFunctionDerivedColumn()) == 0 {
            return compilerGraphNominalKindFunction()
        }
    }
    return 0 - 1
}

function compilerGraphNominalKindForMember(memberKind: Int): Int {
    if memberKind == compilerSyntaxMemberKindLet() { return compilerGraphNominalKindLet() }
    if memberKind == compilerSyntaxMemberKindState() { return compilerGraphNominalKindState() }
    if memberKind == compilerSyntaxMemberKindBinding() { return compilerGraphNominalKindBinding() }
    if memberKind == compilerSyntaxMemberKindDerived() { return compilerGraphNominalKindDerived() }
    if memberKind == compilerSyntaxMemberKindEnumCase() { return compilerGraphNominalKindCase() }
    return 0 - 1
}

function compilerGraphNominalKindForLocalBinding(localKind: Int): Int {
    if localKind == compilerSyntaxLocalKindLet() { return compilerGraphNominalKindLet() }
    if localKind == compilerSyntaxLocalKindState() { return compilerGraphNominalKindState() }
    return 0 - 1
}

function compilerPlotterAppendDeclarationNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.declarations) {
        let nominalKind: Int(compilerGraphNominalKindForDeclaration(tables: tables, declarationRow: row))
        if nominalKind >= 0 {
            let parentSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 3))
            state parentNominalID: Int(0 - 1)
            if parentSyntaxID >= 0 { parentNominalID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: parentSyntaxID) }
            let fingerprint: CompilerFingerprint(
                first: compilerIntTableValue(table: tables.declarations, row: row, column: 11),
                second: compilerIntTableValue(table: tables.declarations, row: row, column: 12)
            )
            if compilerGraphDeltaAppendNominal(
                delta: delta,
                kind: nominalKind,
                syntaxID: compilerIntTableValue(table: tables.declarations, row: row, column: 0),
                sourceRow: row,
                parentNominalID: parentNominalID,
                fileID: compilerIntTableValue(table: tables.declarations, row: row, column: 1),
                start: compilerIntTableValue(table: tables.declarations, row: row, column: 7),
                end: compilerIntTableValue(table: tables.declarations, row: row, column: 8),
                fingerprint: fingerprint
            ) < 0 { return 0 - 1 }
        }
        row: row + 1
    }
    return 0
}

function compilerPlotterAppendMemberNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.members) {
        let memberKind: Int(compilerIntTableValue(table: tables.members, row: row, column: 12))
        let nominalKind: Int(compilerGraphNominalKindForMember(memberKind: memberKind))
        if nominalKind >= 0 {
            let parentSyntaxID: Int(compilerIntTableValue(table: tables.members, row: row, column: 2))
            let parentNominalID: Int(compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: parentSyntaxID))
            if parentNominalID < 0 { return 0 - 1 }
            let fingerprint: CompilerFingerprint(
                first: compilerIntTableValue(table: tables.members, row: row, column: 10),
                second: compilerIntTableValue(table: tables.members, row: row, column: 11)
            )
            if compilerGraphDeltaAppendNominal(
                delta: delta,
                kind: nominalKind,
                syntaxID: compilerIntTableValue(table: tables.members, row: row, column: 0),
                sourceRow: row,
                parentNominalID: parentNominalID,
                fileID: compilerIntTableValue(table: tables.members, row: row, column: 1),
                start: compilerIntTableValue(table: tables.members, row: row, column: 6),
                end: compilerIntTableValue(table: tables.members, row: row, column: 7),
                fingerprint: fingerprint
            ) < 0 { return 0 - 1 }
        } else if memberKind != compilerSyntaxMemberKindEnumCasePayload() {
            return 0 - 1
        }
        row: row + 1
    }
    return 0
}

function compilerPlotterAppendLocalNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.bodyNodes) {
        let syntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: row, column: 0))
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) == compilerSyntaxKindLocalBinding() {
            let localKind: Int(compilerIntTableValue(table: tables.bodyNodes, row: row, column: 10))
            let nominalKind: Int(compilerGraphNominalKindForLocalBinding(localKind: localKind))
            if nominalKind < 0 { return 0 - 1 }
            let fileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: row, column: 1))
            let nameStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: row, column: 6))
            let nameEnd: Int(compilerIntTableValue(table: tables.bodyNodes, row: row, column: 7))
            let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: nameStart, localEnd: nameEnd))
            state fingerprint: CompilerFingerprint(compilerSyntaxDeclarationBaseFingerprint(tables: tables, fileID: fileID, kindTag: compilerSyntaxKindLocalBinding(), name: name))
            fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: localKind)
            fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.bodyNodes, row: row, column: 2))
            fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.bodyNodes, row: row, column: 3))
            fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.bodyNodes, row: row, column: 4))
            let scopeSyntaxID: Int(compilerPlotterNominalScopeForBodyNode(tables: tables, bodyRow: row))
            state parentNominalID: Int(0 - 1)
            if scopeSyntaxID >= 0 { parentNominalID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: scopeSyntaxID) }
            if compilerGraphDeltaAppendNominal(
                delta: delta,
                kind: nominalKind,
                syntaxID: syntaxID,
                sourceRow: row,
                parentNominalID: parentNominalID,
                fileID: fileID,
                start: nameStart,
                end: nameEnd,
                fingerprint: fingerprint
            ) < 0 { return 0 - 1 }
        }
        row: row + 1
    }
    return 0
}

function compilerPlotterAppendMacroNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroDeclarations) {
        let fingerprint: CompilerFingerprint(
            first: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 20),
            second: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 21)
        )
        if compilerGraphDeltaAppendNominal(
            delta: delta,
            kind: compilerGraphNominalKindMacro(),
            syntaxID: 0 - 1,
            sourceRow: row,
            parentNominalID: 0 - 1,
            fileID: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 1),
            start: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 4),
            end: compilerIntTableValue(table: tables.macroDeclarations, row: row, column: 5),
            fingerprint: fingerprint
        ) < 0 { return 0 - 1 }
        row: row + 1
    }
    return 0
}

function compilerPlotterAppendNominalDeclarations(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    if compilerPlotterAppendDeclarationNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendMemberNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendLocalNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    return compilerPlotterAppendMacroNominals(tables: tables, delta: delta)
}

function compilerGraphDeltaNominalPriorCount(delta: CompilerGraphDelta, ownerNodeID: Int, role: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nominalReferences) {
        if compilerIntTableValue(table: delta.nominalReferences, row: row, column: 1) == ownerNodeID
            && compilerIntTableValue(table: delta.nominalReferences, row: row, column: 2) == role { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerGraphDeltaNominalPriorCountBefore(delta: CompilerGraphDelta, row: Int, ownerNodeID: Int, role: Int): Int {
    state count: Int(0)
    state priorRow: Int(0)
    while priorRow < row {
        if compilerIntTableValue(table: delta.nominalReferences, row: priorRow, column: 1) == ownerNodeID
            && compilerIntTableValue(table: delta.nominalReferences, row: priorRow, column: 2) == role { count: count + 1 }
        priorRow: priorRow + 1
    }
    return count
}

function compilerGraphDeltaAppendNominalReference(delta: CompilerGraphDelta, ownerNodeID: Int, role: Int, sourceReferenceID: Int, parentSourceReferenceID: Int, kind: Int, targetKind: Int, targetID: Int, fileID: Int, start: Int, end: Int, fingerprint: CompilerFingerprint): Int {
    let nominalID: Int(compilerIntTableRowCount(table: delta.nominalReferences))
    let ordinal: Int(compilerGraphDeltaNominalPriorCount(delta: delta, ownerNodeID: ownerNodeID, role: role))
    if ownerNodeID < 0 - 1 || ownerNodeID >= compilerIntTableRowCount(table: delta.nodes)
        || (ownerNodeID < 0 && role != compilerGraphNominalRoleMacroApplication())
        || role < compilerGraphNominalRoleMemberType() || role > compilerGraphNominalRoleMacroApplication()
        || sourceReferenceID < 0 - 1 || parentSourceReferenceID < 0 - 1
        || kind != compilerSyntaxTypeReferenceNamed() && kind != compilerSyntaxTypeReferenceApplication()
        || targetKind < compilerSyntaxTypeReferenceTargetBuiltin() || targetKind > compilerGraphNominalMissingTarget()
        || (targetKind == compilerSyntaxTypeReferenceTargetMissing() && targetID != 0 - 1)
        || (targetKind == compilerSyntaxTypeReferenceTargetAmbiguous() && targetID != 0 - 1)
        || ((targetKind == compilerGraphNominalTargetMismatch() || targetKind == compilerGraphNominalMissingTarget())
            && (targetID < 0 - 1 || targetID >= compilerIntTableRowCount(table: delta.nominals)))
        || fileID < 0 || start < 0 || end <= start || ordinal < 0
        || (fingerprint.first == 0 && fingerprint.second == 0) {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    if compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: nominalID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: ownerNodeID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: role) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: ordinal) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: sourceReferenceID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: parentSourceReferenceID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: kind) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: targetKind) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: targetID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: fileID) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: start) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: end) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: fingerprint.first) != 0
        || compilerGraphDeltaAppend(delta: delta, table: delta.nominalReferences, value: fingerprint.second) != 0 { return 0 - 1 }
    return nominalID
}

function compilerPlotterAppendMemberTypeNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.typeReferences) {
        if compilerPlotterTypeReferenceIsNominal(tables: tables, row: row) {
            let ownerMemberRow: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOwnerColumn()))
            if ownerMemberRow < 0 || ownerMemberRow >= compilerIntTableRowCount(table: tables.members) { return 0 - 1 }
            let fileID: Int(compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 1))
            let ownerNodeID: Int(compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 0))
            let typeStart: Int(compilerIntTableValue(table: tables.members, row: ownerMemberRow, column: 8))
            let start: Int(typeStart + compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameStartColumn()))
            let end: Int(typeStart + compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceNameEndColumn()))
            let fingerprint: CompilerFingerprint(
                first: compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceFingerprintFirstColumn()),
                second: compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceFingerprintSecondColumn())
            )
            state targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetKindColumn()))
            state targetID: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetIDColumn()))
            if targetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
                targetID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: targetID)
                if targetID < 0 { return 0 - 1 }
            } else if targetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
                let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: start, localEnd: end))
                let declarationSyntaxID: Int(compilerSyntaxDeclarationSyntaxIDForTypeNameInScope(tables: tables, typeName: name, scopeSyntaxID: compilerSyntaxMemberTypeOwnerSyntaxID(tables: tables, memberRow: ownerMemberRow)))
                if declarationSyntaxID >= 0 {
                    targetKind: compilerSyntaxTypeReferenceTargetDeclaration()
                    targetID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: declarationSyntaxID)
                    if targetID < 0 { return 0 - 1 }
                }
            }
            if compilerGraphDeltaAppendNominalReference(
                delta: delta,
                ownerNodeID: ownerNodeID,
                role: compilerGraphNominalRoleMemberType(),
                sourceReferenceID: row,
                parentSourceReferenceID: compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceParentColumn()),
                kind: compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceKindColumn()),
                targetKind: targetKind,
                targetID: targetID,
                fileID: fileID,
                start: start,
                end: end,
                fingerprint: fingerprint
            ) < 0 { return 0 - 1 }
        }
        row: row + 1
    }
    return 0
}

function compilerPlotterNominalScopeForBodyNode(tables: CompilerSyntaxTables, bodyRow: Int): Int {
    if bodyRow < 0 || bodyRow >= compilerIntTableRowCount(table: tables.bodyNodes) { return 0 - 1 }
    state ownerSyntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyRow, column: 2))
    state depth: Int(0)
    while ownerSyntaxID >= 0 && ownerSyntaxID < compilerIntTableRowCount(table: tables.syntaxIndex) && depth < 32 {
        let ownerKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 0))
        if ownerKind == compilerSyntaxKindFunction() { return ownerSyntaxID }
        if ownerKind == compilerSyntaxKindEntry() || ownerKind == compilerSyntaxKindMainAnnotation() { return 0 - 1 }
        if ownerKind < compilerSyntaxKindEntry() || ownerKind > compilerSyntaxKindLastBody() { return 0 - 1 }
        let ownerBodyRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: ownerSyntaxID, column: 1))
        ownerSyntaxID: compilerIntTableValue(table: tables.bodyNodes, row: ownerBodyRow, column: 2)
        depth: depth + 1
    }
    return 0 - 1
}

function compilerPlotterAppendScannedNominal(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, ownerNodeID: Int, scopeSyntaxID: Int, role: Int, fileID: Int, start: Int, end: Int, name: String, application: Bool): Int {
    state kind: Int(compilerSyntaxTypeReferenceNamed())
    if application { kind: compilerSyntaxTypeReferenceApplication() }
    state targetKind: Int(compilerSyntaxTypeReferenceTargetMissing())
    state targetID: Int(0 - 1)
    let declarationID: Int(compilerSyntaxDeclarationSyntaxIDForTypeNameInScope(tables: tables, typeName: name, scopeSyntaxID: scopeSyntaxID))
    if declarationID >= 0 {
        targetKind: compilerSyntaxTypeReferenceTargetDeclaration()
        targetID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: declarationID)
        if targetID < 0 { return 0 - 1 }
    } else if declarationID == 0 - 2 {
        targetKind: compilerSyntaxTypeReferenceTargetAmbiguous()
    } else {
        let builtinID: Int(compilerSyntaxBuiltinTypeIDForName(name: name))
        if builtinID >= 0 {
            targetKind: compilerSyntaxTypeReferenceTargetBuiltin()
            targetID: builtinID
        } else {
            let genericParameterRow: Int(compilerSyntaxTypeReferenceGenericParameterForName(tables: tables, ownerSyntaxID: scopeSyntaxID, name: name))
            if genericParameterRow >= 0 {
                targetKind: compilerSyntaxTypeReferenceTargetGenericParameter()
                targetID: genericParameterRow
            }
        }
    }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: ownerNodeID)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: role)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: kind)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: targetKind)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: targetID)
    fingerprint: compilerFingerprintAppendText(fingerprint: fingerprint, tag: 141, text: name)
    if compilerGraphDeltaAppendNominalReference(delta: delta, ownerNodeID: ownerNodeID, role: role, sourceReferenceID: 0 - 1, parentSourceReferenceID: 0 - 1, kind: kind, targetKind: targetKind, targetID: targetID, fileID: fileID, start: start, end: end, fingerprint: fingerprint) < 0 { return 0 - 1 }
    return 0
}

function compilerPlotterAppendNominalsInTypeRange(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, ownerNodeID: Int, scopeSyntaxID: Int, role: Int, fileID: Int, localStart: Int, localEnd: Int): Int {
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localStart))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: localEnd))
    if globalStart < 0 || globalEnd <= globalStart { return 0 - 1 }
    state cursor: Int(globalStart)
    state previousWasDot: Bool(false)
    while cursor < globalEnd {
        let maybeToken: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: cursor))
        if maybeToken == nil { return 0 - 1 }
        let token: RangeLexedToken(maybeToken ?? compilerFallbackTokenAt(index: cursor))
        if token.start >= globalEnd {
            cursor: globalEnd
        } else {
            if token.kind == .identifier && !previousWasDot {
                let maybeFollowing: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: token.end))
                state followedByColon: Bool(false)
                state application: Bool(false)
                if maybeFollowing != nil {
                    let following: RangeLexedToken(maybeFollowing ?? compilerFallbackTokenAt(index: token.end))
                    followedByColon: following.start < globalEnd && following.kind == .colon
                    application: following.start < globalEnd && following.kind == .less
                }
                if !followedByColon {
                    let localNameStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: token.start))
                    let localNameEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: token.end))
                    if compilerPlotterAppendScannedNominal(tables: tables, delta: delta, ownerNodeID: ownerNodeID, scopeSyntaxID: scopeSyntaxID, role: role, fileID: fileID, start: localNameStart, end: localNameEnd, name: token.text, application: application) != 0 { return 0 - 1 }
                }
            }
            previousWasDot: token.kind == .dot
            cursor: token.end
        }
    }
    return 0
}

function compilerPlotterAppendSignatureNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state parameterRow: Int(0)
    while parameterRow < compilerIntTableRowCount(table: tables.parameters) {
        let parameterFunctionRow: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 2))
        let ownerNodeID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 0))
        let scopeSyntaxID: Int(compilerPlotterFunctionSyntaxID(tables: tables, functionID: parameterFunctionRow))
        if compilerPlotterAppendNominalsInTypeRange(tables: tables, delta: delta, ownerNodeID: ownerNodeID, scopeSyntaxID: scopeSyntaxID, role: compilerGraphNominalRoleParameterType(), fileID: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1), localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)) != 0 { return 0 - 1 }
        parameterRow: parameterRow + 1
    }
    state returnFunctionRow: Int(0)
    while returnFunctionRow < compilerIntTableRowCount(table: tables.functions) {
        let returnStart: Int(compilerIntTableValue(table: tables.functions, row: returnFunctionRow, column: 6))
        let returnEnd: Int(compilerIntTableValue(table: tables.functions, row: returnFunctionRow, column: 7))
        if returnEnd > returnStart {
            let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: returnFunctionRow, column: 0))
            if compilerPlotterAppendNominalsInTypeRange(tables: tables, delta: delta, ownerNodeID: functionSyntaxID, scopeSyntaxID: functionSyntaxID, role: compilerGraphNominalRoleFunctionReturn(), fileID: compilerIntTableValue(table: tables.functions, row: returnFunctionRow, column: 1), localStart: returnStart, localEnd: returnEnd) != 0 { return 0 - 1 }
        }
        returnFunctionRow: returnFunctionRow + 1
    }
    return 0
}

function compilerPlotterAppendLocalTypeNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state bodyRow: Int(0)
    while bodyRow < compilerIntTableRowCount(table: tables.bodyNodes) {
        let syntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyRow, column: 0))
        let kind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0))
        let typeStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyRow, column: 8))
        let typeEnd: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyRow, column: 9))
        if kind == compilerSyntaxKindLocalBinding() && typeEnd > typeStart {
            if compilerPlotterAppendNominalsInTypeRange(tables: tables, delta: delta, ownerNodeID: syntaxID, scopeSyntaxID: compilerPlotterNominalScopeForBodyNode(tables: tables, bodyRow: bodyRow), role: compilerGraphNominalRoleLocalType(), fileID: compilerIntTableValue(table: tables.bodyNodes, row: bodyRow, column: 1), localStart: typeStart, localEnd: typeEnd) != 0 { return 0 - 1 }
        }
        bodyRow: bodyRow + 1
    }
    return 0
}

function compilerPlotterAppendGenericConstraintNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.genericParameters) {
        if compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterKindColumn()) == compilerSyntaxGenericParameterValueKind() {
            let ownerSyntaxID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()))
            let fileID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()))
            let nameEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameEndColumn()))
            let parameterEnd: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterEndColumn()))
            let globalNameEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: nameEnd))
            let globalParameterEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: parameterEnd))
            let maybeColon: Optional<RangeLexedToken>(lexNextRangeToken(source: tables.sourceStore.source, start: globalNameEnd))
            if maybeColon == nil { return 0 - 1 }
            let colon: RangeLexedToken(maybeColon ?? compilerFallbackTokenAt(index: globalNameEnd))
            if colon.kind != .colon { return 0 - 1 }
            let maybeType: Optional<CompilerTypeReference>(compilerCoreParseTypeReferenceWithEnd(cursor: CompilerTokenCursor(source: $tables.sourceStore.source, index: colon.end), end: globalParameterEnd))
            if maybeType == nil { return 0 - 1 }
            let type: CompilerTypeReference(maybeType ?? CompilerTypeReference(text: String(""), start: colon.end, end: colon.end))
            let localTypeStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: type.start))
            let localTypeEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: tables.sourceStore, fileID: fileID, globalOffset: type.end))
            if compilerPlotterAppendNominalsInTypeRange(tables: tables, delta: delta, ownerNodeID: ownerSyntaxID, scopeSyntaxID: ownerSyntaxID, role: compilerGraphNominalRoleGenericConstraint(), fileID: fileID, localStart: localTypeStart, localEnd: localTypeEnd) != 0 { return 0 - 1 }
        }
        row: row + 1
    }
    return 0
}

function compilerGraphNominalIDForMacroRow(delta: CompilerGraphDelta, macroRow: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nominals) {
        if compilerIntTableValue(table: delta.nominals, row: row, column: 1) == compilerGraphNominalKindMacro()
            && compilerIntTableValue(table: delta.nominals, row: row, column: 3) == macroRow { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerPlotterMacroApplicationOwnerNodeID(tables: CompilerSyntaxTables, applicationRow: Int): Int {
    if applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications) { return 0 - 1 }
    return compilerGraphApplicationRelationshipDestination(tables: tables, applicationRow: applicationRow, role: compilerGraphRelationshipAppliesTo(), destinationKind: compilerGraphIdentitySyntax(), ordinal: 0)
}

function compilerPlotterAppendMacroApplicationNominals(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    state applicationRow: Int(0)
    while applicationRow < compilerIntTableRowCount(table: tables.macroApplications) {
        let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
        let start: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 4))
        let end: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 5))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: start, localEnd: end))
        let ownerNodeID: Int(compilerPlotterMacroApplicationOwnerNodeID(tables: tables, applicationRow: applicationRow))
        let resolvedMacroRow: Int(compilerGraphApplicationRelationshipDestination(tables: tables, applicationRow: applicationRow, role: compilerGraphRelationshipResolvedBy(), destinationKind: compilerGraphIdentityMacroDeclaration(), ordinal: 0))
        let referenceCount: Int(compilerGraphApplicationRelationshipDestinationCount(tables: tables, applicationRow: applicationRow, role: compilerGraphRelationshipReferences(), destinationKind: compilerGraphIdentityMacroDeclaration()))
        let diagnosticCode: Int(compilerMacroDiagnosticCodeForApplication(tables: tables, applicationRow: applicationRow))
        state targetKind: Int(compilerSyntaxTypeReferenceTargetMissing())
        state targetID: Int(0 - 1)
        if resolvedMacroRow >= 0 {
            targetKind: compilerSyntaxTypeReferenceTargetDeclaration()
            targetID: compilerGraphNominalIDForMacroRow(delta: delta, macroRow: resolvedMacroRow)
            if targetID < 0 { return 0 - 1 }
        } else if diagnosticCode == compilerMacroDiagnosticAmbiguous() {
            targetKind: compilerSyntaxTypeReferenceTargetAmbiguous()
        } else if diagnosticCode == compilerMacroDiagnosticTargetMismatch() {
            targetKind: compilerGraphNominalTargetMismatch()
            if referenceCount == 1 {
                let referencedMacroRow: Int(compilerGraphApplicationRelationshipDestination(tables: tables, applicationRow: applicationRow, role: compilerGraphRelationshipReferences(), destinationKind: compilerGraphIdentityMacroDeclaration(), ordinal: 0))
                targetID: compilerGraphNominalIDForMacroRow(delta: delta, macroRow: referencedMacroRow)
                if targetID < 0 { return 0 - 1 }
            }
        } else if diagnosticCode == compilerMacroDiagnosticMissingTarget() {
            targetKind: compilerGraphNominalMissingTarget()
        }
        state fingerprint: CompilerFingerprint(
            first: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 17),
            second: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 18)
        )
        if fingerprint.first == 0 && fingerprint.second == 0 {
            fingerprint: compilerFingerprintAppendText(fingerprint: compilerFingerprintInitial(), tag: 151, text: name)
        }
        if compilerGraphDeltaAppendNominalReference(
            delta: delta,
            ownerNodeID: ownerNodeID,
            role: compilerGraphNominalRoleMacroApplication(),
            sourceReferenceID: applicationRow,
            parentSourceReferenceID: 0 - 1,
            kind: compilerSyntaxTypeReferenceNamed(),
            targetKind: targetKind,
            targetID: targetID,
            fileID: fileID,
            start: start,
            end: end,
            fingerprint: fingerprint
        ) < 0 { return 0 - 1 }
        applicationRow: applicationRow + 1
    }
    return 0
}

function compilerPlotterAppendNominalReferences(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    if compilerPlotterAppendMemberTypeNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendSignatureNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendLocalTypeNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendGenericConstraintNominals(tables: tables, delta: delta) != 0 { return 0 - 1 }
    return compilerPlotterAppendMacroApplicationNominals(tables: tables, delta: delta)
}

function compilerPlotterBuild(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Int {
    if compilerGraphRegisterSlotRelationships(tables: tables) != 0 { return 0 - 1 }
    if !compilerSyntaxTablesIsValid(tables: tables) {
        compilerGraphDeltaPoison(delta: delta)
        return 0 - 1
    }
    state plotSyntaxID: Int(0)
    let plotSyntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
    while plotSyntaxID < plotSyntaxCount {
        if compilerPlotterAppendSyntaxNode(tables: tables, delta: delta, syntaxID: plotSyntaxID) != plotSyntaxID { return 0 - 1 }
        plotSyntaxID: plotSyntaxID + 1
    }
    if compilerPlotterAppendIdentityNodes(tables: tables, delta: delta) != 0 { return 0 - 1 }
    state plotSubjectSyntaxID: Int(0)
    while plotSubjectSyntaxID < plotSyntaxCount {
        state plotRoleTag: Int(compilerSyntaxRoleStatement())
        while plotRoleTag <= compilerSyntaxRoleBody() {
            if plotRoleTag == compilerGraphRoleMember() {
                if compilerPlotterAppendMemberFacts(tables: tables, delta: delta, subjectSyntaxID: plotSubjectSyntaxID) != 0 { return 0 - 1 }
            } else if plotRoleTag == compilerGraphRoleParameter() {
                if compilerPlotterAppendParameterFacts(tables: tables, delta: delta, subjectSyntaxID: plotSubjectSyntaxID) != 0 { return 0 - 1 }
            } else {
                if compilerPlotterAppendBodyFacts(tables: tables, delta: delta, subjectSyntaxID: plotSubjectSyntaxID, roleTag: plotRoleTag) != 0 { return 0 - 1 }
            }
            plotRoleTag: plotRoleTag + 1
        }
        plotSubjectSyntaxID: plotSubjectSyntaxID + 1
    }
    if compilerPlotterAppendRegisteredRelationships(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendSlotRelationships(tables: tables, delta: delta) != 0 { return 0 - 1 }
    if compilerPlotterAppendNominalDeclarations(tables: tables, delta: delta) != 0 { return 0 - 1 }
    return compilerPlotterAppendNominalReferences(tables: tables, delta: delta)
}

function compilerPlotterExpectedNominalCount(tables: CompilerSyntaxTables): Int {
    state count: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
    state declarationRow: Int(0)
    while declarationRow < compilerIntTableRowCount(table: tables.declarations) {
        if compilerGraphNominalKindForDeclaration(tables: tables, declarationRow: declarationRow) >= 0 { count: count + 1 }
        declarationRow: declarationRow + 1
    }
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        if compilerGraphNominalKindForMember(memberKind: compilerIntTableValue(table: tables.members, row: memberRow, column: 12)) >= 0 { count: count + 1 }
        memberRow: memberRow + 1
    }
    state bodyRow: Int(0)
    while bodyRow < compilerIntTableRowCount(table: tables.bodyNodes) {
        let syntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: bodyRow, column: 0))
        if compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 0) == compilerSyntaxKindLocalBinding() { count: count + 1 }
        bodyRow: bodyRow + 1
    }
    return count
}

function compilerPlotterNominalSourceIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, nominalRow: Int): Bool {
    let nominalKind: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 1))
    let nominalSyntaxID: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 2))
    let sourceRow: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 3))
    let parentNominalID: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 4))
    let fileID: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 5))
    let start: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 6))
    let end: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 7))
    if nominalKind == compilerGraphNominalKindMacro() {
        return nominalSyntaxID == 0 - 1 && sourceRow >= 0 && sourceRow < compilerIntTableRowCount(table: tables.macroDeclarations)
            && parentNominalID == 0 - 1
            && fileID == compilerIntTableValue(table: tables.macroDeclarations, row: sourceRow, column: 1)
            && start == compilerIntTableValue(table: tables.macroDeclarations, row: sourceRow, column: 4)
            && end == compilerIntTableValue(table: tables.macroDeclarations, row: sourceRow, column: 5)
    }
    if nominalSyntaxID < 0 || nominalSyntaxID >= compilerIntTableRowCount(table: tables.syntaxIndex)
        || compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: nominalSyntaxID) != nominalRow { return false }
    let syntaxKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nominalSyntaxID, column: 0))
    if syntaxKind == compilerSyntaxKindConstruct() || syntaxKind == compilerSyntaxKindFunction() || syntaxKind == compilerSyntaxKindEnum() {
        if sourceRow < 0 || sourceRow >= compilerIntTableRowCount(table: tables.declarations)
            || compilerIntTableValue(table: tables.declarations, row: sourceRow, column: 0) != nominalSyntaxID
            || compilerGraphNominalKindForDeclaration(tables: tables, declarationRow: sourceRow) != nominalKind
            || fileID != compilerIntTableValue(table: tables.declarations, row: sourceRow, column: 1)
            || start != compilerIntTableValue(table: tables.declarations, row: sourceRow, column: 7)
            || end != compilerIntTableValue(table: tables.declarations, row: sourceRow, column: 8) { return false }
        let parentSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: sourceRow, column: 3))
        state expectedParentNominalID: Int(0 - 1)
        if parentSyntaxID >= 0 { expectedParentNominalID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: parentSyntaxID) }
        return parentNominalID == expectedParentNominalID
    }
    if syntaxKind == compilerSyntaxKindMember() {
        if sourceRow < 0 || sourceRow >= compilerIntTableRowCount(table: tables.members)
            || compilerIntTableValue(table: tables.members, row: sourceRow, column: 0) != nominalSyntaxID
            || compilerGraphNominalKindForMember(memberKind: compilerIntTableValue(table: tables.members, row: sourceRow, column: 12)) != nominalKind
            || fileID != compilerIntTableValue(table: tables.members, row: sourceRow, column: 1)
            || start != compilerIntTableValue(table: tables.members, row: sourceRow, column: 6)
            || end != compilerIntTableValue(table: tables.members, row: sourceRow, column: 7) { return false }
        return parentNominalID == compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: compilerIntTableValue(table: tables.members, row: sourceRow, column: 2))
    }
    if syntaxKind == compilerSyntaxKindLocalBinding() {
        if sourceRow < 0 || sourceRow >= compilerIntTableRowCount(table: tables.bodyNodes)
            || compilerIntTableValue(table: tables.bodyNodes, row: sourceRow, column: 0) != nominalSyntaxID
            || compilerGraphNominalKindForLocalBinding(localKind: compilerIntTableValue(table: tables.bodyNodes, row: sourceRow, column: 10)) != nominalKind
            || fileID != compilerIntTableValue(table: tables.bodyNodes, row: sourceRow, column: 1)
            || start != compilerIntTableValue(table: tables.bodyNodes, row: sourceRow, column: 6)
            || end != compilerIntTableValue(table: tables.bodyNodes, row: sourceRow, column: 7) { return false }
        let scopeSyntaxID: Int(compilerPlotterNominalScopeForBodyNode(tables: tables, bodyRow: sourceRow))
        state expectedParentNominalID: Int(0 - 1)
        if scopeSyntaxID >= 0 { expectedParentNominalID: compilerGraphNominalIDForSyntaxID(delta: delta, syntaxID: scopeSyntaxID) }
        return parentNominalID == expectedParentNominalID
    }
    return false
}

function compilerGraphIdentityNodeIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, identityNodeID: Int): Bool {
    let identityKind: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 1))
    let identityID: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 2))
    let kindTag: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 3))
    let fileID: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 4))
    let start: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 5))
    let end: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 6))
    let facetKind: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 7))
    if compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 0) != identityNodeID
        || identityID < 0 || kindTag < 0 || fileID < 0 || start < 0 || end < start || facetKind <= 0
        || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: start) < 0
        || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: end) < 0 { return false }
    if identityKind == compilerGraphIdentitySyntax() {
        if identityID >= compilerIntTableRowCount(table: tables.syntaxIndex) || identityNodeID != identityID { return false }
        return kindTag == compilerIntTableValue(table: delta.nodes, row: identityID, column: 1)
            && fileID == compilerIntTableValue(table: delta.nodes, row: identityID, column: 4)
            && start == compilerIntTableValue(table: delta.nodes, row: identityID, column: 5)
            && end == compilerIntTableValue(table: delta.nodes, row: identityID, column: 6)
            && facetKind == compilerIntTableValue(table: delta.nodes, row: identityID, column: 7)
    }
    if identityKind == compilerGraphIdentityMacroDeclaration() {
        let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
        if identityID >= compilerIntTableRowCount(table: tables.macroDeclarations) || identityNodeID != syntaxCount + identityID { return false }
        return kindTag == compilerGraphNominalKindMacro()
            && fileID == compilerIntTableValue(table: tables.macroDeclarations, row: identityID, column: 1)
            && start == compilerIntTableValue(table: tables.macroDeclarations, row: identityID, column: 2)
            && end == compilerIntTableValue(table: tables.macroDeclarations, row: identityID, column: 3)
            && facetKind == compilerGraphFacetMacroDeclaration()
    }
    if identityKind == compilerGraphIdentityMacroApplication() {
        let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
        let macroDeclarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
        if identityID >= compilerIntTableRowCount(table: tables.macroApplications)
            || identityNodeID != syntaxCount + macroDeclarationCount + identityID { return false }
        return kindTag == compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 13)
            && fileID == compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 1)
            && start == compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 2)
            && end == compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 3)
            && facetKind == compilerGraphFacetMacroApplication()
    }
    if identityKind == compilerGraphIdentitySlot() {
        let syntaxCount: Int(compilerIntTableRowCount(table: tables.syntaxIndex))
        let macroDeclarationCount: Int(compilerIntTableRowCount(table: tables.macroDeclarations))
        let macroApplicationCount: Int(compilerIntTableRowCount(table: tables.macroApplications))
        if identityID >= compilerIntTableRowCount(table: tables.slots)
            || identityNodeID != syntaxCount + macroDeclarationCount + macroApplicationCount + identityID { return false }
        let ownerKind: Int(compilerIntTableValue(table: tables.slots, row: identityID, column: 1))
        let ownerSyntaxID: Int(compilerIntTableValue(table: tables.slots, row: identityID, column: 2))
        return ownerKind == compilerGraphIdentitySyntax()
            && kindTag == compilerIntTableValue(table: tables.slots, row: identityID, column: 3)
            && fileID == compilerMacroSyntaxNodeFileID(tables: tables, syntaxID: ownerSyntaxID)
            && start == compilerMacroSyntaxNodeStart(tables: tables, syntaxID: ownerSyntaxID)
            && end == compilerMacroSyntaxNodeEnd(tables: tables, syntaxID: ownerSyntaxID)
            && facetKind == compilerGraphFacetSlot()
    }
    return false
}

function compilerGraphRegisteredRelationshipIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, relationshipRow: Int): Bool {
    let originNodeID: Int(compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 2))
    let destinationNodeID: Int(compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 3))
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 0) != relationshipRow
        || originNodeID < 0 || originNodeID >= compilerIntTableRowCount(table: delta.identities)
        || destinationNodeID < 0 || destinationNodeID >= compilerIntTableRowCount(table: delta.identities) { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 1) != compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 1)
        || originNodeID != compilerGraphIdentityNodeIDFor(
            delta: delta,
            identityKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 2),
            identityID: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 3)
        )
        || destinationNodeID != compilerGraphIdentityNodeIDFor(
            delta: delta,
            identityKind: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 4),
            identityID: compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: 5)
        ) { return false }
    state column: Int(4)
    while column < compilerGraphPlottedRelationshipColumnCount() {
        if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: column)
            != compilerIntTableValue(table: tables.relationships, row: relationshipRow, column: column + 2) { return false }
        column: column + 1
    }
    return true
}

function compilerGraphSlotRelationshipIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, relationshipRow: Int, slotID: Int): Bool {
    if slotID < 0 || slotID >= compilerIntTableRowCount(table: tables.slots) { return false }
    let ownerNodeID: Int(compilerGraphIdentityNodeIDFor(
        delta: delta,
        identityKind: compilerIntTableValue(table: tables.slots, row: slotID, column: 1),
        identityID: compilerIntTableValue(table: tables.slots, row: slotID, column: 2)
    ))
    let slotNodeID: Int(compilerGraphIdentityNodeIDFor(
        delta: delta,
        identityKind: compilerGraphIdentitySlot(),
        identityID: slotID
    ))
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 0) != relationshipRow { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 1) != compilerGraphRelationshipSlot() { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 2) != ownerNodeID { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 3) != slotNodeID { return false }
    state column: Int(4)
    while column < compilerGraphPlottedRelationshipColumnCount() {
        if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: column)
            != compilerIntTableValue(table: tables.slots, row: slotID, column: column) { return false }
        column: column + 1
    }
    return true
}

function compilerGraphSlotOccurrenceRelationshipIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, relationshipRow: Int, occurrenceRow: Int): Bool {
    if occurrenceRow < 0 || occurrenceRow >= compilerIntTableRowCount(table: tables.slotOccurrences) { return false }
    let slotID: Int(compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceRow, column: 1))
    let slotNodeID: Int(compilerGraphIdentityNodeIDFor(
        delta: delta,
        identityKind: compilerGraphIdentitySlot(),
        identityID: slotID
    ))
    let targetNodeID: Int(compilerGraphIdentityNodeIDFor(
        delta: delta,
        identityKind: compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceRow, column: 2),
        identityID: compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceRow, column: 3)
    ))
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 0) != relationshipRow { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 1) != compilerGraphRelationshipSlotOccurrence() { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 2) != slotNodeID { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 3) != targetNodeID { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 4)
        != compilerIntTableValue(table: tables.slotOccurrences, row: occurrenceRow, column: 4) { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 5) != 1 { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 6) != compilerGraphBoundFinite() { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 7) != 1 { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 8) != compilerGraphOrderingOrdered() { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 9) != compilerGraphSeparatorNone() { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 10) != 0 - 1 { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 11) != compilerGraphEnclosureNone() { return false }
    if compilerIntTableValue(table: delta.relationships, row: relationshipRow, column: 12) != 0 - 1 { return false }
    return true
}

function compilerGraphPlottedRelationshipIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, relationshipRow: Int): Bool {
    let registeredRelationshipCount: Int(compilerIntTableRowCount(table: tables.relationships))
    if relationshipRow < registeredRelationshipCount {
        return compilerGraphRegisteredRelationshipIsValid(tables: tables, delta: delta, relationshipRow: relationshipRow)
    }
    let slotRelationshipRow: Int(relationshipRow - registeredRelationshipCount)
    let slotCount: Int(compilerIntTableRowCount(table: tables.slots))
    if slotRelationshipRow < slotCount {
        return compilerGraphSlotRelationshipIsValid(tables: tables, delta: delta, relationshipRow: relationshipRow, slotID: slotRelationshipRow)
    }
    return compilerGraphSlotOccurrenceRelationshipIsValid(
        tables: tables,
        delta: delta,
        relationshipRow: relationshipRow,
        occurrenceRow: slotRelationshipRow - slotCount
    )
}

function compilerGraphDeltaIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): Bool {
    if delta.failures.count != 0 || !compilerIntTableIsComplete(table: delta.nodes) || !compilerIntTableIsComplete(table: delta.facts)
        || !compilerIntTableIsComplete(table: delta.identities) || !compilerIntTableIsComplete(table: delta.relationships)
        || !compilerIntTableIsComplete(table: delta.nominals) || !compilerIntTableIsComplete(table: delta.nominalReferences)
        || !compilerIntTableIsComplete(table: delta.generatedFunctions)
        || !compilerIntTableIsComplete(table: delta.generatedMembers) { return false }
    let graphNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    if graphNodeCount != compilerIntTableRowCount(table: tables.syntaxIndex) { return false }
    let expectedIdentityNodeCount: Int(graphNodeCount + compilerIntTableRowCount(table: tables.macroDeclarations) + compilerIntTableRowCount(table: tables.macroApplications) + compilerIntTableRowCount(table: tables.slots))
    let expectedRelationshipCount: Int(compilerIntTableRowCount(table: tables.relationships) + compilerIntTableRowCount(table: tables.slots) + compilerIntTableRowCount(table: tables.slotOccurrences))
    if compilerIntTableRowCount(table: delta.identities) != expectedIdentityNodeCount
        || compilerIntTableRowCount(table: delta.relationships) != expectedRelationshipCount { return false }
    if compilerIntTableRowCount(table: delta.nominals) != compilerPlotterExpectedNominalCount(tables: tables) { return false }
    let expectedGraphFactCount: Int(compilerPlotterMemberRelationshipCount(tables: tables) + compilerIntTableRowCount(table: tables.parameters) + compilerIntTableRowCount(table: tables.bodyEdges))
    if compilerIntTableRowCount(table: delta.facts) != expectedGraphFactCount { return false }
    state graphNodeRow: Int(0)
    while graphNodeRow < graphNodeCount {
        let graphNodeID: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 0))
        let graphNodeSyntaxID: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 2))
        let graphNodeFileID: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 4))
        let graphNodeStart: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 5))
        let graphNodeEnd: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 6))
        let graphNodeKindTag: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 1))
        let graphNodeFacetKind: Int(compilerIntTableValue(table: delta.nodes, row: graphNodeRow, column: 7))
        if graphNodeID != graphNodeRow || graphNodeSyntaxID != graphNodeRow
            || graphNodeKindTag != compilerIntTableValue(table: tables.syntaxIndex, row: graphNodeSyntaxID, column: 0)
            || graphNodeFacetKind != compilerPlotterFacetKind(kindTag: graphNodeKindTag)
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: graphNodeFileID, localOffset: graphNodeStart) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: graphNodeFileID, localOffset: graphNodeEnd) < 0 { return false }
        state graphIncomingCount: Int(0)
        state graphIncomingFactRow: Int(0)
        while graphIncomingFactRow < compilerIntTableRowCount(table: delta.facts) {
            if compilerIntTableValue(table: delta.facts, row: graphIncomingFactRow, column: 2) == graphNodeID { graphIncomingCount: graphIncomingCount + 1 }
            graphIncomingFactRow: graphIncomingFactRow + 1
        }
        state expectedIncomingCount: Int(1)
        if graphNodeKindTag == compilerSyntaxKindConstruct() || graphNodeKindTag == compilerSyntaxKindFunction() || graphNodeKindTag == compilerSyntaxKindEnum() {
            let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: graphNodeSyntaxID))
            if declarationRow < 0 { return false }
            if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 3) < 0 { expectedIncomingCount: 0 }
        } else if graphNodeKindTag == compilerSyntaxKindMainAnnotation() {
            expectedIncomingCount: 0
        }
        if graphIncomingCount != expectedIncomingCount {
            return false
        }
        graphNodeRow: graphNodeRow + 1
    }
    state graphFactRow: Int(0)
    let graphFactCount: Int(compilerIntTableRowCount(table: delta.facts))
    state previousGraphSubject: Int(0 - 1)
    state previousGraphRole: Int(0 - 1)
    state previousGraphOrdinal: Int(0 - 1)
    while graphFactRow < graphFactCount {
        let graphFactKind: Int(compilerIntTableValue(table: delta.facts, row: graphFactRow, column: 0))
        let graphFactSubject: Int(compilerIntTableValue(table: delta.facts, row: graphFactRow, column: 1))
        let graphFactObject: Int(compilerIntTableValue(table: delta.facts, row: graphFactRow, column: 2))
        let graphFactRole: Int(compilerIntTableValue(table: delta.facts, row: graphFactRow, column: 3))
        let graphFactOrdinal: Int(compilerIntTableValue(table: delta.facts, row: graphFactRow, column: 4))
        if (graphFactKind != compilerGraphFactOwns() && graphFactKind != compilerGraphFactAppliesTo())
            || graphFactSubject < 0 || graphFactSubject >= graphNodeCount || graphFactObject < 0 || graphFactObject >= graphNodeCount { return false }
        if graphFactKind == compilerGraphFactAppliesTo() && graphFactRole != compilerSyntaxRoleAppliesTo() { return false }
        if graphFactKind == compilerGraphFactOwns() && graphFactRole == compilerSyntaxRoleAppliesTo() { return false }
        if graphFactSubject < previousGraphSubject
            || (graphFactSubject == previousGraphSubject && graphFactRole < previousGraphRole)
            || (graphFactSubject == previousGraphSubject && graphFactRole == previousGraphRole && graphFactOrdinal <= previousGraphOrdinal) { return false }
        previousGraphSubject: graphFactSubject
        previousGraphRole: graphFactRole
        previousGraphOrdinal: graphFactOrdinal
        graphFactRow: graphFactRow + 1
    }
    state identityNodeRow: Int(0)
    while identityNodeRow < compilerIntTableRowCount(table: delta.identities) {
        if !compilerGraphIdentityNodeIsValid(tables: tables, delta: delta, identityNodeID: identityNodeRow) { return false }
        identityNodeRow: identityNodeRow + 1
    }
    state plottedRelationshipRow: Int(0)
    while plottedRelationshipRow < compilerIntTableRowCount(table: delta.relationships) {
        if !compilerGraphPlottedRelationshipIsValid(tables: tables, delta: delta, relationshipRow: plottedRelationshipRow) { return false }
        plottedRelationshipRow: plottedRelationshipRow + 1
    }
    state nominalRow: Int(0)
    while nominalRow < compilerIntTableRowCount(table: delta.nominals) {
        let nominalKind: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 1))
        let nominalSyntaxID: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 2))
        let nominalSourceRow: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 3))
        let nominalParentID: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 4))
        let nominalFileID: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 5))
        let nominalStart: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 6))
        let nominalEnd: Int(compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 7))
        if compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 0) != nominalRow
            || nominalKind < compilerGraphNominalKindConstruct() || nominalKind > compilerGraphNominalKindCase()
            || nominalParentID < 0 - 1 || nominalParentID >= nominalRow
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: nominalFileID, localOffset: nominalStart) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: nominalFileID, localOffset: nominalEnd) < 0
            || nominalEnd <= nominalStart
            || (compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 8) == 0
                && compilerIntTableValue(table: delta.nominals, row: nominalRow, column: 9) == 0) { return false }
        if !compilerPlotterNominalSourceIsValid(tables: tables, delta: delta, nominalRow: nominalRow) { return false }
        nominalRow: nominalRow + 1
    }
    state referenceRow: Int(0)
    while referenceRow < compilerIntTableRowCount(table: delta.nominalReferences) {
        let ownerNodeID: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 1))
        let role: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 2))
        let ordinal: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 3))
        let sourceReferenceID: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 4))
        let parentSourceReferenceID: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 5))
        let referenceKind: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 6))
        let targetKind: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 7))
        let targetID: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 8))
        let fileID: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 9))
        let start: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 10))
        let end: Int(compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 11))
        if compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 0) != referenceRow
            || ownerNodeID < 0 - 1 || ownerNodeID >= graphNodeCount
            || (ownerNodeID < 0 && role != compilerGraphNominalRoleMacroApplication())
            || role < compilerGraphNominalRoleMemberType() || role > compilerGraphNominalRoleMacroApplication()
            || ordinal != compilerGraphDeltaNominalPriorCountBefore(delta: delta, row: referenceRow, ownerNodeID: ownerNodeID, role: role)
            || (referenceKind != compilerSyntaxTypeReferenceNamed() && referenceKind != compilerSyntaxTypeReferenceApplication())
            || targetKind < compilerSyntaxTypeReferenceTargetBuiltin() || targetKind > compilerGraphNominalMissingTarget()
            || (targetKind == compilerSyntaxTypeReferenceTargetDeclaration() && (targetID < 0 || targetID >= compilerIntTableRowCount(table: delta.nominals)))
            || (targetKind == compilerSyntaxTypeReferenceTargetBuiltin() && (targetID < compilerSyntaxBuiltinTypeInt() || targetID > compilerSyntaxBuiltinTypeFloat()))
            || (targetKind == compilerSyntaxTypeReferenceTargetGenericParameter() && (targetID < 0 || targetID >= compilerIntTableRowCount(table: tables.genericParameters)))
            || ((targetKind == compilerSyntaxTypeReferenceTargetMissing() || targetKind == compilerSyntaxTypeReferenceTargetAmbiguous()) && targetID != 0 - 1)
            || ((targetKind == compilerGraphNominalTargetMismatch() || targetKind == compilerGraphNominalMissingTarget())
                && (targetID < 0 - 1 || targetID >= compilerIntTableRowCount(table: delta.nominals)))
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: start) < 0
            || compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: end) < 0
            || end <= start
            || (compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 12) == 0
                && compilerIntTableValue(table: delta.nominalReferences, row: referenceRow, column: 13) == 0) { return false }
        if role == compilerGraphNominalRoleMacroApplication() {
            if sourceReferenceID < 0 || sourceReferenceID >= compilerIntTableRowCount(table: tables.macroApplications)
                || parentSourceReferenceID != 0 - 1
                || fileID != compilerIntTableValue(table: tables.macroApplications, row: sourceReferenceID, column: 1)
                || start != compilerIntTableValue(table: tables.macroApplications, row: sourceReferenceID, column: 4)
                || end != compilerIntTableValue(table: tables.macroApplications, row: sourceReferenceID, column: 5) { return false }
        } else if sourceReferenceID >= 0 {
            if sourceReferenceID >= compilerIntTableRowCount(table: tables.typeReferences)
                || parentSourceReferenceID < 0 - 1 || parentSourceReferenceID >= compilerIntTableRowCount(table: tables.typeReferences) { return false }
        } else if parentSourceReferenceID != 0 - 1 {
            return false
        }
        if (targetKind == compilerGraphNominalTargetMismatch() || targetKind == compilerGraphNominalMissingTarget())
            && targetID >= 0
            && compilerIntTableValue(table: delta.nominals, row: targetID, column: 1) != compilerGraphNominalKindMacro() { return false }
        referenceRow: referenceRow + 1
    }
    return true
}

function compilerPlotterTypeReferenceIsNominal(tables: CompilerSyntaxTables, row: Int): Bool {
    if row < 0 || row >= compilerIntTableRowCount(table: tables.typeReferences) { return false }
    let kind: Int(compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceKindColumn()))
    return kind == compilerSyntaxTypeReferenceNamed() || kind == compilerSyntaxTypeReferenceApplication()
}

function compilerGraphNominalKindName(kind: Int): String {
    if kind == compilerGraphNominalKindConstruct() { return String("construct") }
    if kind == compilerGraphNominalKindEnum() { return String("enum") }
    if kind == compilerGraphNominalKindFunction() { return String("function") }
    if kind == compilerGraphNominalKindMacro() { return String("macro") }
    if kind == compilerGraphNominalKindLet() { return String("let") }
    if kind == compilerGraphNominalKindState() { return String("state") }
    if kind == compilerGraphNominalKindBinding() { return String("binding") }
    if kind == compilerGraphNominalKindDerived() { return String("derived") }
    if kind == compilerGraphNominalKindCase() { return String("case") }
    return String("unknown")
}

function compilerGraphNominalRoleName(role: Int): String {
    if role == compilerGraphNominalRoleMemberType() { return String("memberType") }
    if role == compilerGraphNominalRoleParameterType() { return String("parameterType") }
    if role == compilerGraphNominalRoleFunctionReturn() { return String("functionReturn") }
    if role == compilerGraphNominalRoleLocalType() { return String("localType") }
    if role == compilerGraphNominalRoleGenericConstraint() { return String("genericConstraint") }
    if role == compilerGraphNominalRoleMacroApplication() { return String("macroApplication") }
    return String("unknown")
}

function compilerGraphNominalTargetName(kind: Int): String {
    if kind == compilerGraphNominalTargetMismatch() { return String("targetMismatch") }
    if kind == compilerGraphNominalMissingTarget() { return String("missingTarget") }
    return compilerSyntaxTypeReferenceTargetName(kind: kind)
}

function compilerGraphIdentityKindName(kind: Int): String {
    if kind == compilerGraphIdentitySyntax() { return String("syntax") }
    if kind == compilerGraphIdentityMacroDeclaration() { return String("macroDeclaration") }
    if kind == compilerGraphIdentityMacroApplication() { return String("macroApplication") }
    if kind == compilerGraphIdentitySlot() { return String("slot") }
    return String("unknown")
}

function compilerGraphRelationshipRoleName(role: Int): String {
    if role == compilerGraphRelationshipAppliesTo() { return String("appliesTo") }
    if role == compilerGraphRelationshipResolvedBy() { return String("resolvedBy") }
    if role == compilerGraphRelationshipReferences() { return String("references") }
    if role == compilerGraphRelationshipMember() { return String("member") }
    if role == compilerGraphRelationshipParameter() { return String("parameter") }
    if role == compilerGraphRelationshipSlot() { return String("slot") }
    if role == compilerGraphRelationshipSlotOccurrence() { return String("slotOccurrence") }
    return String("unknown")
}

function compilerGraphBoundName(kind: Int): String {
    if kind == compilerGraphBoundFinite() { return String("finite") }
    if kind == compilerGraphBoundUnbounded() { return String("unbounded") }
    return String("unknown")
}

function compilerGraphOrderingName(ordering: Int): String {
    if ordering == compilerGraphOrderingUnordered() { return String("unordered") }
    if ordering == compilerGraphOrderingOrdered() { return String("ordered") }
    return String("unknown")
}

function compilerGraphIdentityName(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, identityNodeID: Int): String {
    let identityKind: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 1))
    let identityID: Int(compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 2))
    if identityKind == compilerGraphIdentityMacroDeclaration() {
        return compilerTypedSyntaxLocalText(
            tables: tables,
            fileID: compilerIntTableValue(table: tables.macroDeclarations, row: identityID, column: 1),
            localStart: compilerIntTableValue(table: tables.macroDeclarations, row: identityID, column: 4),
            localEnd: compilerIntTableValue(table: tables.macroDeclarations, row: identityID, column: 5)
        )
    }
    if identityKind == compilerGraphIdentityMacroApplication() {
        return compilerTypedSyntaxLocalText(
            tables: tables,
            fileID: compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 1),
            localStart: compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 4),
            localEnd: compilerIntTableValue(table: tables.macroApplications, row: identityID, column: 5)
        )
    }
    if identityKind == compilerGraphIdentitySlot() {
        return compilerSyntaxSlotName(kind: compilerIntTableValue(table: delta.identities, row: identityNodeID, column: 3))
    }
    return String("")
}

function compilerPlotterRenderIdentities(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): String {
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state output: String("")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.identities) {
        let identityKind: Int(compilerIntTableValue(table: delta.identities, row: row, column: 1))
        let kindTag: Int(compilerIntTableValue(table: delta.identities, row: row, column: 3))
        state kindName: String("macro")
        if identityKind == compilerGraphIdentitySyntax() { kindName: compilerSyntaxKindName(kindTag: kindTag) }
        if identityKind == compilerGraphIdentityMacroApplication() { kindName: compilerSyntaxKindName(kindTag: kindTag) }
        if identityKind == compilerGraphIdentitySlot() { kindName: compilerSyntaxSlotName(kind: kindTag) }
        output: "\(output)graphIdentity\(tab)id=\(row)\(tab)kind=\(compilerGraphIdentityKindName(kind: identityKind))\(tab)identityID=\(compilerIntTableValue(table: delta.identities, row: row, column: 2))\(tab)syntaxKind=\(kindName)\(tab)name=\(compilerGraphIdentityName(tables: tables, delta: delta, identityNodeID: row))\(tab)fileID=\(compilerIntTableValue(table: delta.identities, row: row, column: 4))\(tab)start=\(compilerIntTableValue(table: delta.identities, row: row, column: 5))\(tab)end=\(compilerIntTableValue(table: delta.identities, row: row, column: 6))\(tab)facet=\(compilerIntTableValue(table: delta.identities, row: row, column: 7))\(newline)"
        row: row + 1
    }
    return output
}

function compilerPlotterRenderRelationships(delta: CompilerGraphDelta): String {
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state output: String("")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.relationships) {
        let originNodeID: Int(compilerIntTableValue(table: delta.relationships, row: row, column: 2))
        let destinationNodeID: Int(compilerIntTableValue(table: delta.relationships, row: row, column: 3))
        output: "\(output)graphRelationship\(tab)id=\(row)\(tab)role=\(compilerGraphRelationshipRoleName(role: compilerIntTableValue(table: delta.relationships, row: row, column: 1)))\(tab)originNodeID=\(originNodeID)\(tab)originKind=\(compilerGraphIdentityKindName(kind: compilerIntTableValue(table: delta.identities, row: originNodeID, column: 1)))\(tab)originID=\(compilerIntTableValue(table: delta.identities, row: originNodeID, column: 2))\(tab)destinationNodeID=\(destinationNodeID)\(tab)destinationKind=\(compilerGraphIdentityKindName(kind: compilerIntTableValue(table: delta.identities, row: destinationNodeID, column: 1)))\(tab)destinationID=\(compilerIntTableValue(table: delta.identities, row: destinationNodeID, column: 2))\(tab)ordinal=\(compilerIntTableValue(table: delta.relationships, row: row, column: 4))\(tab)minimum=\(compilerIntTableValue(table: delta.relationships, row: row, column: 5))\(tab)maximumKind=\(compilerGraphBoundName(kind: compilerIntTableValue(table: delta.relationships, row: row, column: 6)))\(tab)maximum=\(compilerIntTableValue(table: delta.relationships, row: row, column: 7))\(tab)ordering=\(compilerGraphOrderingName(ordering: compilerIntTableValue(table: delta.relationships, row: row, column: 8)))\(tab)separatorKind=\(compilerIntTableValue(table: delta.relationships, row: row, column: 9))\(tab)separatorID=\(compilerIntTableValue(table: delta.relationships, row: row, column: 10))\(tab)enclosureKind=\(compilerIntTableValue(table: delta.relationships, row: row, column: 11))\(tab)enclosureID=\(compilerIntTableValue(table: delta.relationships, row: row, column: 12))\(newline)"
        row: row + 1
    }
    return output
}

function compilerPlotterNominalWarningCount(delta: CompilerGraphDelta): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nominalReferences) {
        let targetKind: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 7))
        if targetKind == compilerSyntaxTypeReferenceTargetMissing() || targetKind == compilerSyntaxTypeReferenceTargetAmbiguous()
            || targetKind == compilerGraphNominalTargetMismatch() || targetKind == compilerGraphNominalMissingTarget() {
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function compilerPlotterRenderNominalDeclarations(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): String {
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state output: String("")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nominals) {
        let kind: Int(compilerIntTableValue(table: delta.nominals, row: row, column: 1))
        let fileID: Int(compilerIntTableValue(table: delta.nominals, row: row, column: 5))
        let start: Int(compilerIntTableValue(table: delta.nominals, row: row, column: 6))
        let end: Int(compilerIntTableValue(table: delta.nominals, row: row, column: 7))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: start, localEnd: end))
        let path: String(stringSubstring(source: tables.sourceStore.source, start: compilerSourceStoreFilePathStart(store: tables.sourceStore, fileID: fileID), end: compilerSourceStoreFilePathEnd(store: tables.sourceStore, fileID: fileID)))
        output: "\(output)graphNominal\(tab)id=\(row)\(tab)keyword=\(compilerGraphNominalKindName(kind: kind))\(tab)name=\(name)\(tab)syntaxID=\(compilerIntTableValue(table: delta.nominals, row: row, column: 2))\(tab)parentNominalID=\(compilerIntTableValue(table: delta.nominals, row: row, column: 4))\(tab)fileID=\(fileID)\(tab)path=\(path)\(tab)start=\(start)\(tab)end=\(end)\(newline)"
        row: row + 1
    }
    return output
}

function compilerPlotterRenderNominalReferences(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): String {
    let tab: String(compilerCoreTabCharacter())
    let newline: String(compilerCoreNewlineCharacter())
    state output: String("")
    state row: Int(0)
    while row < compilerIntTableRowCount(table: delta.nominalReferences) {
        let targetKind: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 7))
        let targetID: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 8))
        let fileID: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 9))
        let start: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 10))
        let end: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 11))
        let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: start, localEnd: end))
        let path: String(stringSubstring(source: tables.sourceStore.source, start: compilerSourceStoreFilePathStart(store: tables.sourceStore, fileID: fileID), end: compilerSourceStoreFilePathEnd(store: tables.sourceStore, fileID: fileID)))
        state declared: Bool(true)
        state applicable: Bool(true)
        state targetNominalID: Int(0 - 1)
        if targetKind == compilerSyntaxTypeReferenceTargetMissing() { declared: false }
        if targetKind == compilerSyntaxTypeReferenceTargetMissing() || targetKind == compilerSyntaxTypeReferenceTargetAmbiguous()
            || targetKind == compilerGraphNominalTargetMismatch() || targetKind == compilerGraphNominalMissingTarget() { applicable: false }
        if targetKind == compilerSyntaxTypeReferenceTargetDeclaration()
            || ((targetKind == compilerGraphNominalTargetMismatch() || targetKind == compilerGraphNominalMissingTarget()) && targetID >= 0) { targetNominalID: targetID }
        let role: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 2))
        state expectedKinds: String("construct,enum")
        if role == compilerGraphNominalRoleMacroApplication() { expectedKinds: String("macro") }
        let sourceReferenceID: Int(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 4))
        state sourceKind: String("signatureRange")
        if role == compilerGraphNominalRoleMacroApplication() { sourceKind: String("macroApplication") }
        if role != compilerGraphNominalRoleMacroApplication() && sourceReferenceID >= 0 { sourceKind: String("typeReference") }
        output: "\(output)graphNominalReference\(tab)id=\(row)\(tab)ownerNodeID=\(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 1))\(tab)role=\(compilerGraphNominalRoleName(role: role))\(tab)expectedKinds=\(expectedKinds)\(tab)name=\(name)\(tab)targetKind=\(compilerGraphNominalTargetName(kind: targetKind))\(tab)targetID=\(targetID)\(tab)targetNominalID=\(targetNominalID)\(tab)declared=\(declared)\(tab)applicable=\(applicable)\(tab)fileID=\(fileID)\(tab)path=\(path)\(tab)start=\(start)\(tab)end=\(end)\(tab)sourceKind=\(sourceKind)\(tab)sourceReferenceID=\(sourceReferenceID)\(tab)parentSourceReferenceID=\(compilerIntTableValue(table: delta.nominalReferences, row: row, column: 5))\(newline)"
        if !applicable {
            state warningKind: String("missingNominal")
            if targetKind == compilerSyntaxTypeReferenceTargetAmbiguous() { warningKind: String("ambiguousNominal") }
            if targetKind == compilerGraphNominalTargetMismatch() { warningKind: String("nominalTargetMismatch") }
            if targetKind == compilerGraphNominalMissingTarget() { warningKind: String("nominalMissingTarget") }
            output: "\(output)graphWarning\(tab)severity=warning\(tab)kind=\(warningKind)\(tab)referenceID=\(row)\(tab)expectedKinds=\(expectedKinds)\(tab)name=\(name)\(tab)fileID=\(fileID)\(tab)path=\(path)\(tab)start=\(start)\(tab)end=\(end)\(newline)"
        }
        row: row + 1
    }
    return output
}

function compilerPlotterRenderSnapshot(tables: CompilerSyntaxTables, delta: CompilerGraphDelta): String {
    let plotterTab: String(compilerCoreTabCharacter())
    let plotterNewline: String(compilerCoreNewlineCharacter())
    let plotterNodes: String(compilerTypedSyntaxRenderRawTable(name: String("graphNode"), table: delta.nodes))
    let plotterFacts: String(compilerTypedSyntaxRenderRawTable(name: String("graphFact"), table: delta.facts))
    let plotterIdentityRows: String(compilerTypedSyntaxRenderRawTable(name: String("graphIdentityRow"), table: delta.identities))
    let plotterRelationshipRows: String(compilerTypedSyntaxRenderRawTable(name: String("graphRelationshipRow"), table: delta.relationships))
    let plotterNominalTable: String(compilerTypedSyntaxRenderRawTable(name: String("graphNominal"), table: delta.nominals))
    let plotterNominalReferenceTable: String(compilerTypedSyntaxRenderRawTable(name: String("graphNominalReference"), table: delta.nominalReferences))
    let plotterGenerated: String(compilerTypedSyntaxRenderRawTable(name: String("generatedFunction"), table: delta.generatedFunctions))
    let plotterGeneratedMembers: String(compilerTypedSyntaxRenderRawTable(name: String("generatedMember"), table: delta.generatedMembers))
    let plotterNominals: String(compilerPlotterRenderNominalDeclarations(tables: tables, delta: delta))
    let plotterReferences: String(compilerPlotterRenderNominalReferences(tables: tables, delta: delta))
    let plotterIdentities: String(compilerPlotterRenderIdentities(tables: tables, delta: delta))
    let plotterRelationships: String(compilerPlotterRenderRelationships(delta: delta))
    return "graphDelta\(plotterTab)valid=true\(plotterTab)nodeCount=\(compilerIntTableRowCount(table: delta.nodes))\(plotterTab)factCount=\(compilerIntTableRowCount(table: delta.facts))\(plotterTab)generatedFunctionCount=\(compilerIntTableRowCount(table: delta.generatedFunctions))\(plotterTab)nominalCount=\(compilerIntTableRowCount(table: delta.nominals))\(plotterTab)nominalReferenceCount=\(compilerIntTableRowCount(table: delta.nominalReferences))\(plotterTab)warningCount=\(compilerPlotterNominalWarningCount(delta: delta))\(plotterTab)generatedMemberCount=\(compilerIntTableRowCount(table: delta.generatedMembers))\(plotterTab)identityCount=\(compilerIntTableRowCount(table: delta.identities))\(plotterTab)relationshipCount=\(compilerIntTableRowCount(table: delta.relationships))\(plotterNewline)\(plotterNodes)\(plotterFacts)\(plotterIdentityRows)\(plotterRelationshipRows)\(plotterNominalTable)\(plotterNominalReferenceTable)\(plotterGenerated)\(plotterGeneratedMembers)\(plotterIdentities)\(plotterRelationships)\(plotterNominals)\(plotterReferences)"
}

function compilerPlotterSummary(source: String): String {
    let plotterTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let plotterCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: plotterTables))
    state plotterLinkStatus: Int(0)
    if plotterCaptureStatus == 0 { plotterLinkStatus: compilerMacroLink(tables: plotterTables) }
    let plotterDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    state plotterSummary: String("")
    if plotterCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: plotterTables) {
        plotterSummary: compilerInvalidTypedDeclarationsDiagnostic(tables: plotterTables)
    } else if plotterLinkStatus != 0 && compilerIntTableRowCount(table: plotterTables.macroDiagnostics) == 0 {
        plotterSummary: String("compilerError\tkind=invalidGraphRelationships\n")
    } else {
        let plotterBuildStatus: Int(compilerPlotterBuild(tables: plotterTables, delta: plotterDelta))
        if plotterBuildStatus != 0 || !compilerGraphDeltaIsValid(tables: plotterTables, delta: plotterDelta) {
            plotterSummary: String("compilerError\tkind=invalidGraphDelta\n")
        } else {
            plotterSummary: compilerPlotterRenderSnapshot(tables: plotterTables, delta: plotterDelta)
        }
    }
    let plotterDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: plotterDelta))
    let plotterTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: plotterTables))
    if plotterDeltaDestroyStatus != 0 || plotterTablesDestroyStatus != 0 { return String("compilerError\tkind=plotterOwnershipFailure\n") }
    return plotterSummary
}

function compilerMacroGraphRelationshipSlotsSnapshot(tables: CompilerSyntaxTables): String {
    state output: String("")
    state slotID: Int(0)
    while slotID < compilerIntTableRowCount(table: tables.slots) {
        if compilerIntTableValue(table: tables.slots, row: slotID, column: 3) == compilerSyntaxSlotRelationshipValues() {
            output: "\(output)macroGraphRelationshipSlot\trow=\(slotID)\ttargetMemberSyntaxID=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 2))\tminimum=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 5))\tmaximumKind=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 6))\tmaximum=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 7))\tordering=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 8))\tseparatorKind=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 9))\tenclosureKind=\(compilerIntTableValue(table: tables.slots, row: slotID, column: 11))\tadmission=\(compilerIntTableValue(table: tables.slots, row: slotID, column: compilerSyntaxSlotAdmissionEnvironmentColumn()))\n"
        }
        slotID: slotID + 1
    }
    return output
}

function compilerMacroGraphSummary(source: String): String {
    let tables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let captureStatus: Int(compilerTypedDeclarationsCapture(source: source, tables: tables))
    let baseDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    state output: String("")
    if captureStatus != 0 || !compilerSyntaxTablesIsValid(tables: tables) {
        output: compilerInvalidTypedDeclarationsDiagnostic(tables: tables)
    } else {
        let linkStatus: Int(compilerMacroLink(tables: tables))
        if linkStatus != 0 || compilerIntTableRowCount(table: tables.macroDiagnostics) != 0 {
            output: compilerMacroRenderDiagnostics(tables: tables)
        } else {
            let index: CompilerDeclarationIndex(compilerDeclarationIndexCreate(tables: tables))
            if !index.isValid {
                output: String("compilerError\tkind=invalidDeclarationIndex\n")
            } else {
                let execution: CompilerMacroExecutionResult(compilerMacroExecution(tables: tables, index: index))
                if execution.status != 0 {
                    output: compilerMacroRenderExecutionError(tables: tables, result: execution)
                } else {
                    let slotRegistrationStatus: Int(compilerGraphRegisterSlotRelationships(tables: tables))
                    state baseBuildStatus: Int(0 - 1)
                    state baseDeltaValid: Bool(false)
                    if slotRegistrationStatus == 0 {
                        baseBuildStatus: compilerPlotterBuild(tables: tables, delta: baseDelta)
                        if baseBuildStatus == 0 {
                            baseDeltaValid: compilerGraphDeltaIsValid(tables: tables, delta: baseDelta)
                        }
                    }
                    output: "\(compilerMacroRenderExecutionSnapshot(tables: tables, result: execution))macroGraphExecution\tvalid=true\tslotRegistrationStatus=\(slotRegistrationStatus)\ttablesValid=\(compilerSyntaxTablesIsValid(tables: tables))\tbaseBuildStatus=\(baseBuildStatus)\tbaseDeltaValid=\(baseDeltaValid)\tsyntaxCount=\(compilerIntTableRowCount(table: tables.syntaxIndex))\trelationshipRegistrationCount=\(compilerIntTableRowCount(table: tables.relationshipRegistrations))\tslotCount=\(compilerIntTableRowCount(table: tables.slots))\tregisteredRelationshipCount=\(compilerIntTableRowCount(table: tables.relationships))\tbaseIdentityCount=\(compilerIntTableRowCount(table: baseDelta.identities))\tbaseRelationshipCount=\(compilerIntTableRowCount(table: baseDelta.relationships))\n\(compilerMacroGraphRelationshipSlotsSnapshot(tables: tables))"
                }
                if compilerGraphDeltaDestroy(delta: execution.graphDelta) != 0 {
                    output: String("compilerError\tkind=macroGraphOwnershipFailure\n")
                }
            }
            if compilerDeclarationIndexDestroy(index: index) != 0 {
                output: String("compilerError\tkind=macroGraphOwnershipFailure\n")
            }
        }
    }
    let baseDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: baseDelta))
    let tablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: tables))
    if baseDeltaDestroyStatus != 0 || tablesDestroyStatus != 0 { return String("compilerError\tkind=macroGraphOwnershipFailure\n") }
    return output
}



function compilerSemanticResolutionColumnCount(): Int { return 3 }
function compilerSemanticNodeTypeColumnCount(): Int { return 3 }
function compilerSemanticSpecializationColumnCount(): Int { return 5 }
function compilerSemanticParameterEffectColumnCount(): Int { return 5 }
function compilerSemanticAccessEffectColumnCount(): Int { return 5 }
function compilerSemanticAccessWrite(): Int { return 1 }
function compilerSemanticAccessUnique(): Int { return 1 }
function compilerSemanticResolutionConstruct(): Int { return 1 }
function compilerSemanticResolutionFunction(): Int { return 2 }
function compilerSemanticResolutionLocal(): Int { return 3 }
function compilerSemanticResolutionParameter(): Int { return 4 }
function compilerSemanticResolutionMember(): Int { return 5 }
function compilerSemanticResolutionArgumentMember(): Int { return 6 }
function compilerSemanticResolutionArgumentParameter(): Int { return 7 }
function compilerSemanticTypeNone(): Int { return 0 }
function compilerSemanticTypeInt(): Int { return 1 }
function compilerSemanticTypeFloat(): Int { return 3 }
function compilerSemanticTypeConstruct(): Int { return 2 }

function compilerSemanticGraphCreate(): CompilerSemanticGraph {
    return CompilerSemanticGraph(
        resolutions: compilerIntTableCreate(columnCount: compilerSemanticResolutionColumnCount(), estimatedRowCount: 128),
        nodeTypes: compilerIntTableCreate(columnCount: compilerSemanticNodeTypeColumnCount(), estimatedRowCount: 256),
        specializations: compilerIntTableCreate(columnCount: compilerSemanticSpecializationColumnCount(), estimatedRowCount: 64),
        parameterEffects: compilerIntTableCreate(columnCount: compilerSemanticParameterEffectColumnCount(), estimatedRowCount: 64),
        accessEffects: compilerIntTableCreate(columnCount: compilerSemanticAccessEffectColumnCount(), estimatedRowCount: 64),
        failures: bufferCreateInt(capacity: 1)
    )
}

function compilerSemanticGraphDestroy(semantics: CompilerSemanticGraph): Int {
    state semanticDestroyStatus: Int(0)
    if compilerIntTableDestroy(table: semantics.resolutions) != 0 { semanticDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: semantics.nodeTypes) != 0 { semanticDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: semantics.specializations) != 0 { semanticDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: semantics.parameterEffects) != 0 { semanticDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: semantics.accessEffects) != 0 { semanticDestroyStatus: 0 - 1 }
    if semantics.failures.destroy() != 0 { semanticDestroyStatus: 0 - 1 }
    return semanticDestroyStatus
}

function compilerSemanticGraphPoison(semantics: CompilerSemanticGraph): Int {
    return semantics.failures.append(element: 1)
}

function compilerSemanticAppend(semantics: CompilerSemanticGraph, table: CompilerIntTable, value: Int): Int {
    let semanticAppendStatus: Int(compilerIntTableAppend(table: table, value: value))
    if semanticAppendStatus != 0 { compilerSemanticGraphPoison(semantics: semantics) }
    return semanticAppendStatus
}

function compilerSemanticAppendResolution(semantics: CompilerSemanticGraph, useNodeID: Int, targetNodeID: Int, resolutionKind: Int): Int {
    if useNodeID < 0 || targetNodeID < 0 || resolutionKind < compilerSemanticResolutionConstruct() || resolutionKind > compilerSemanticResolutionArgumentParameter() {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    if compilerSemanticAppend(semantics: semantics, table: semantics.resolutions, value: useNodeID) != 0 { return 0 - 1 }
    if compilerSemanticAppend(semantics: semantics, table: semantics.resolutions, value: targetNodeID) != 0 { return 0 - 1 }
    return compilerSemanticAppend(semantics: semantics, table: semantics.resolutions, value: resolutionKind)
}

function compilerSemanticResolutionTarget(semantics: CompilerSemanticGraph, useNodeID: Int): Int {
    state semanticResolutionRow: Int(0)
    let semanticResolutionCount: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while semanticResolutionRow < semanticResolutionCount {
        if compilerIntTableValue(table: semantics.resolutions, row: semanticResolutionRow, column: 0) == useNodeID {
            return compilerIntTableValue(table: semantics.resolutions, row: semanticResolutionRow, column: 1)
        }
        semanticResolutionRow: semanticResolutionRow + 1
    }
    return 0 - 1
}

function compilerSemanticResolutionKind(semantics: CompilerSemanticGraph, useNodeID: Int): Int {
    state semanticResolutionKindRow: Int(0)
    let semanticResolutionKindCount: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while semanticResolutionKindRow < semanticResolutionKindCount {
        if compilerIntTableValue(table: semantics.resolutions, row: semanticResolutionKindRow, column: 0) == useNodeID {
            return compilerIntTableValue(table: semantics.resolutions, row: semanticResolutionKindRow, column: 2)
        }
        semanticResolutionKindRow: semanticResolutionKindRow + 1
    }
    return 0 - 1
}

function compilerSemanticGraphChild(delta: CompilerGraphDelta, subjectNodeID: Int, roleTag: Int, ordinal: Int): Int {
    state semanticGraphFactRow: Int(0)
    let semanticGraphFactCount: Int(compilerIntTableRowCount(table: delta.facts))
    while semanticGraphFactRow < semanticGraphFactCount {
        if compilerIntTableValue(table: delta.facts, row: semanticGraphFactRow, column: 1) == subjectNodeID
            && compilerIntTableValue(table: delta.facts, row: semanticGraphFactRow, column: 3) == roleTag
            && compilerIntTableValue(table: delta.facts, row: semanticGraphFactRow, column: 4) == ordinal {
            return compilerIntTableValue(table: delta.facts, row: semanticGraphFactRow, column: 2)
        }
        semanticGraphFactRow: semanticGraphFactRow + 1
    }
    return 0 - 1
}

function compilerSemanticGraphParent(delta: CompilerGraphDelta, objectNodeID: Int, roleTag: Int): Int {
    state semanticParentFactRow: Int(0)
    let semanticParentFactCount: Int(compilerIntTableRowCount(table: delta.facts))
    while semanticParentFactRow < semanticParentFactCount {
        if compilerIntTableValue(table: delta.facts, row: semanticParentFactRow, column: 2) == objectNodeID
            && compilerIntTableValue(table: delta.facts, row: semanticParentFactRow, column: 3) == roleTag {
            return compilerIntTableValue(table: delta.facts, row: semanticParentFactRow, column: 1)
        }
        semanticParentFactRow: semanticParentFactRow + 1
    }
    return 0 - 1
}

function compilerSemanticLocalRangesEqual(tables: CompilerSyntaxTables, firstFileID: Int, firstStart: Int, firstEnd: Int, secondFileID: Int, secondStart: Int, secondEnd: Int): Bool {
    if firstStart < 0 || secondStart < 0 || firstEnd - firstStart != secondEnd - secondStart { return false }
    let firstGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: firstFileID, localOffset: firstStart))
    let secondGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: secondFileID, localOffset: secondStart))
    if firstGlobalStart < 0 || secondGlobalStart < 0 { return false }
    state semanticRangeOffset: Int(0)
    let semanticRangeLength: Int(firstEnd - firstStart)
    while semanticRangeOffset < semanticRangeLength {
        if stringByteAt(source: tables.sourceStore.source, index: firstGlobalStart + semanticRangeOffset)
            != stringByteAt(source: tables.sourceStore.source, index: secondGlobalStart + semanticRangeOffset) { return false }
        semanticRangeOffset: semanticRangeOffset + 1
    }
    return true
}

function compilerSemanticLocalRangeEqualsText(tables: CompilerSyntaxTables, fileID: Int, start: Int, end: Int, text: String): Bool {
    if start < 0 || end - start != stringLength(value: text) { return false }
    let semanticTextGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: start))
    if semanticTextGlobalStart < 0 { return false }
    state semanticTextOffset: Int(0)
    while semanticTextOffset < stringLength(value: text) {
        if stringByteAt(source: tables.sourceStore.source, index: semanticTextGlobalStart + semanticTextOffset)
            != stringByteAt(source: text, index: semanticTextOffset) { return false }
        semanticTextOffset: semanticTextOffset + 1
    }
    return true
}

function compilerSemanticFunctionRowForSyntaxID(tables: CompilerSyntaxTables, functionSyntaxID: Int): Int {
    state semanticFunctionRow: Int(0)
    let semanticFunctionCount: Int(compilerIntTableRowCount(table: tables.functions))
    while semanticFunctionRow < semanticFunctionCount {
        if compilerIntTableValue(table: tables.functions, row: semanticFunctionRow, column: 0) == functionSyntaxID { return semanticFunctionRow }
        semanticFunctionRow: semanticFunctionRow + 1
    }
    return 0 - 1
}

function compilerSemanticNamedDeclaration(tables: CompilerSyntaxTables, fileID: Int, nameStart: Int, nameEnd: Int, requiredKind: Int): Int {
    state semanticDeclarationRow: Int(0)
    state semanticDeclarationMatch: Int(0 - 1)
    state semanticDeclarationMatches: Int(0)
    let semanticDeclarationCount: Int(compilerIntTableRowCount(table: tables.declarations))
    while semanticDeclarationRow < semanticDeclarationCount {
        let semanticDeclarationKind: Int(compilerIntTableValue(table: tables.declarations, row: semanticDeclarationRow, column: 2))
        let semanticDeclarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: semanticDeclarationRow, column: 1))
        if (requiredKind < 0 || semanticDeclarationKind == requiredKind)
            && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: fileID, firstStart: nameStart, firstEnd: nameEnd, secondFileID: semanticDeclarationFileID, secondStart: compilerIntTableValue(table: tables.declarations, row: semanticDeclarationRow, column: 7), secondEnd: compilerIntTableValue(table: tables.declarations, row: semanticDeclarationRow, column: 8)) {
            semanticDeclarationMatch: compilerIntTableValue(table: tables.declarations, row: semanticDeclarationRow, column: 0)
            semanticDeclarationMatches: semanticDeclarationMatches + 1
        }
        semanticDeclarationRow: semanticDeclarationRow + 1
    }
    if semanticDeclarationMatches != 1 { return 0 - 1 }
    return semanticDeclarationMatch
}

function compilerSemanticNamedDeclarationByText(tables: CompilerSyntaxTables, name: String, requiredKind: Int): Int {
    state row: Int(0)
    state match: Int(0 - 1)
    state matches: Int(0)
    while row < compilerIntTableRowCount(table: tables.declarations) {
        let kind: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 2))
        let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
        if (requiredKind < 0 || kind == requiredKind)
            && compilerSemanticLocalRangeEqualsText(tables: tables, fileID: fileID, start: compilerIntTableValue(table: tables.declarations, row: row, column: 7), end: compilerIntTableValue(table: tables.declarations, row: row, column: 8), text: name) {
            match: compilerIntTableValue(table: tables.declarations, row: row, column: 0)
            matches: matches + 1
        }
        row: row + 1
    }
    if matches != 1 { return 0 - 1 }
    return match
}

function compilerSemanticStringRangeEqualsText(text: String, start: Int, end: Int, literal: String): Bool {
    if start < 0 || end < start || end - start != stringLength(value: literal) { return false }
    state offset: Int(0)
    while offset < end - start {
        if stringByteAt(source: text, index: start + offset) != stringByteAt(source: literal, index: offset) { return false }
        offset: offset + 1
    }
    return true
}

function compilerSemanticTextRangeEqualsDeclarationName(tables: CompilerSyntaxTables, text: String, textStart: Int, textEnd: Int, declarationFileID: Int, declarationStart: Int, declarationEnd: Int): Bool {
    if textStart < 0 || textEnd < textStart || declarationStart < 0 || declarationEnd < declarationStart
        || textEnd - textStart != declarationEnd - declarationStart { return false }
    let declarationGlobalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: declarationFileID, localOffset: declarationStart))
    if declarationGlobalStart < 0 { return false }
    state offset: Int(0)
    while offset < textEnd - textStart {
        if stringByteAt(source: text, index: textStart + offset) != stringByteAt(source: tables.sourceStore.source, index: declarationGlobalStart + offset) { return false }
        offset: offset + 1
    }
    return true
}

function compilerSemanticNamedDeclarationByTextRange(tables: CompilerSyntaxTables, text: String, nameStart: Int, nameEnd: Int, requiredKind: Int): Int {
    state row: Int(0)
    state match: Int(0 - 1)
    state matches: Int(0)
    while row < compilerIntTableRowCount(table: tables.declarations) {
        let kind: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 2))
        let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
        if (requiredKind < 0 || kind == requiredKind)
            && compilerSemanticTextRangeEqualsDeclarationName(
                tables: tables,
                text: text,
                textStart: nameStart,
                textEnd: nameEnd,
                declarationFileID: fileID,
                declarationStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7),
                declarationEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)) {
            match: compilerIntTableValue(table: tables.declarations, row: row, column: 0)
            matches: matches + 1
        }
        row: row + 1
    }
    if matches != 1 { return 0 - 1 }
    return match
}

function compilerSemanticResolveIdentifier(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, identifierNodeID: Int): Int {
    let identifierSyntaxID: Int(compilerIntTableValue(table: delta.nodes, row: identifierNodeID, column: 2))
    let identifierBodyRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: identifierSyntaxID, column: 1))
    let identifierFileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: identifierBodyRow, column: 1))
    let identifierOwnerSyntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: identifierBodyRow, column: 2))
    let identifierStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: identifierBodyRow, column: 4))
    let identifierNameStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: identifierBodyRow, column: 6))
    let identifierNameEnd: Int(compilerIntTableValue(table: tables.bodyNodes, row: identifierBodyRow, column: 7))
    if compilerSemanticGraphParent(delta: delta, objectNodeID: identifierNodeID, roleTag: compilerSyntaxRoleCallee()) >= 0 {
        let calleeDeclarationNodeID: Int(compilerSemanticNamedDeclaration(tables: tables, fileID: identifierFileID, nameStart: identifierNameStart, nameEnd: identifierNameEnd, requiredKind: 0 - 1))
        if calleeDeclarationNodeID < 0 {
            compilerSemanticGraphPoison(semantics: semantics)
            return 0 - 1
        }
        let calleeDeclarationKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: calleeDeclarationNodeID, column: 0))
        state calleeResolutionKind: Int(compilerSemanticResolutionConstruct())
        if calleeDeclarationKind == compilerSyntaxKindFunction() { calleeResolutionKind: compilerSemanticResolutionFunction() }
        if calleeDeclarationKind != compilerSyntaxKindConstruct() && calleeDeclarationKind != compilerSyntaxKindFunction() {
            compilerSemanticGraphPoison(semantics: semantics)
            return 0 - 1
        }
        return compilerSemanticAppendResolution(semantics: semantics, useNodeID: identifierNodeID, targetNodeID: calleeDeclarationNodeID, resolutionKind: calleeResolutionKind)
    }

    state localMatchNodeID: Int(0 - 1)
    state localMatchStart: Int(0 - 1)
    state localBodyRow: Int(0)
    let localBodyCount: Int(compilerIntTableRowCount(table: tables.bodyNodes))
    while localBodyRow < localBodyCount {
        let localSyntaxID: Int(compilerIntTableValue(table: tables.bodyNodes, row: localBodyRow, column: 0))
        let localKindTag: Int(compilerIntTableValue(table: tables.syntaxIndex, row: localSyntaxID, column: 0))
        let localStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: localBodyRow, column: 4))
        if localKindTag == compilerSyntaxKindLocalBinding()
            && compilerIntTableValue(table: tables.bodyNodes, row: localBodyRow, column: 2) == identifierOwnerSyntaxID
            && localStart < identifierStart
            && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: identifierFileID, firstStart: identifierNameStart, firstEnd: identifierNameEnd, secondFileID: compilerIntTableValue(table: tables.bodyNodes, row: localBodyRow, column: 1), secondStart: compilerIntTableValue(table: tables.bodyNodes, row: localBodyRow, column: 6), secondEnd: compilerIntTableValue(table: tables.bodyNodes, row: localBodyRow, column: 7))
            && localStart > localMatchStart {
            localMatchNodeID: localSyntaxID
            localMatchStart: localStart
        }
        localBodyRow: localBodyRow + 1
    }
    if localMatchNodeID >= 0 {
        return compilerSemanticAppendResolution(semantics: semantics, useNodeID: identifierNodeID, targetNodeID: localMatchNodeID, resolutionKind: compilerSemanticResolutionLocal())
    }

    let identifierFunctionRow: Int(compilerSemanticFunctionRowForSyntaxID(tables: tables, functionSyntaxID: identifierOwnerSyntaxID))
    if identifierFunctionRow >= 0 {
        state identifierParameterRow: Int(0)
        state identifierParameterMatch: Int(0 - 1)
        state identifierParameterMatches: Int(0)
        let identifierParameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
        while identifierParameterRow < identifierParameterCount {
            if compilerIntTableValue(table: tables.parameters, row: identifierParameterRow, column: 2) == identifierFunctionRow
                && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: identifierFileID, firstStart: identifierNameStart, firstEnd: identifierNameEnd, secondFileID: compilerIntTableValue(table: tables.parameters, row: identifierParameterRow, column: 1), secondStart: compilerIntTableValue(table: tables.parameters, row: identifierParameterRow, column: 6), secondEnd: compilerIntTableValue(table: tables.parameters, row: identifierParameterRow, column: 7)) {
                identifierParameterMatch: compilerIntTableValue(table: tables.parameters, row: identifierParameterRow, column: 0)
                identifierParameterMatches: identifierParameterMatches + 1
            }
            identifierParameterRow: identifierParameterRow + 1
        }
        if identifierParameterMatches == 1 {
            return compilerSemanticAppendResolution(semantics: semantics, useNodeID: identifierNodeID, targetNodeID: identifierParameterMatch, resolutionKind: compilerSemanticResolutionParameter())
        }
    }
    compilerSemanticGraphPoison(semantics: semantics)
    return 0 - 1
}

function compilerSemanticTypeKind(type: CompilerSemanticType): Int { return type.kindTag }
function compilerSemanticTypeDeclaration(type: CompilerSemanticType): Int { return type.declarationNodeID }

function compilerSemanticTrimTypeName(typeName: String): String {
    let length: Int(stringLength(value: typeName))
    state start: Int(0)
    while start < length && isRangeLexerWhitespace(character: typeName.character(index: start)) {
        start: start + 1
    }
    state end: Int(length)
    while end > start && isRangeLexerWhitespace(character: typeName.character(index: end - 1)) {
        end: end - 1
    }
    return typeName.substring(start: start, end: end)
}

function compilerSemanticTypeFromSpan(tables: CompilerSyntaxTables, fileID: Int, typeStart: Int, typeEnd: Int): CompilerSemanticType {
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: typeStart))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: tables.sourceStore, fileID: fileID, localOffset: typeEnd))
    if globalStart < 0 || globalEnd < globalStart {
        return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
    }
    state trimmedStart: Int(typeStart)
    state trimmedEnd: Int(typeEnd)
    while trimmedStart < trimmedEnd
        && isRangeLexerWhitespace(character: stringCharacterAt(source: tables.sourceStore.source, index: globalStart + trimmedStart - typeStart)) {
        trimmedStart: trimmedStart + 1
    }
    while trimmedEnd > trimmedStart
        && isRangeLexerWhitespace(character: stringCharacterAt(source: tables.sourceStore.source, index: globalStart + trimmedEnd - 1 - typeStart)) {
        trimmedEnd: trimmedEnd - 1
    }
    if compilerSemanticLocalRangeEqualsText(tables: tables, fileID: fileID, start: trimmedStart, end: trimmedEnd, text: String("Int")) {
        return CompilerSemanticType(kindTag: compilerSemanticTypeInt(), declarationNodeID: 0 - 1)
    }
    let authoredTypeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: trimmedStart, localEnd: trimmedEnd))
    if compilerIntegerTypeIsUnsigned8(typeName: authoredTypeName) {
        return CompilerSemanticType(kindTag: compilerSemanticTypeInt(), declarationNodeID: 0 - 1)
    }
    if authoredTypeName == String("Float") || compilerFloatTypeIs32(typeName: authoredTypeName) || compilerFloatTypeIs64(typeName: authoredTypeName) {
        return CompilerSemanticType(kindTag: compilerSemanticTypeFloat(), declarationNodeID: 0 - 1)
    }
    state genericStart: Int(0 - 1)
    state scanOffset: Int(trimmedStart)
    while scanOffset < trimmedEnd && genericStart < 0 {
        if stringByteAt(source: tables.sourceStore.source, index: globalStart + scanOffset - typeStart) == 60 {
            genericStart: scanOffset
        }
        scanOffset: scanOffset + 1
    }
    state nameEnd: Int(trimmedEnd)
    if genericStart >= 0 {
        nameEnd: genericStart
        while nameEnd > trimmedStart
            && isRangeLexerWhitespace(character: stringCharacterAt(source: tables.sourceStore.source, index: globalStart + nameEnd - 1 - typeStart)) {
            nameEnd: nameEnd - 1
        }
    }
    let declarationNodeID: Int(compilerSemanticNamedDeclaration(tables: tables, fileID: fileID, nameStart: trimmedStart, nameEnd: nameEnd, requiredKind: compilerSyntaxKindConstruct()))
    if declarationNodeID < 0 {
        return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
    }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: declarationNodeID))
    let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: declarationNodeID))
    if genericCount > 0 {
        if genericStart < 0 {
            return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
        }
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: trimmedStart, localEnd: trimmedEnd))
        if compilerBodyArenaGenericArgumentCount(typeName: typeName) != genericCount {
            return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
        }
    } else if genericStart >= 0 {
        return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
    }
    if declarationRow < 0 { return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1) }
    return CompilerSemanticType(kindTag: compilerSemanticTypeConstruct(), declarationNodeID: declarationNodeID)
}

function compilerSemanticDeclaredNodeType(tables: CompilerSyntaxTables, nodeID: Int): CompilerSemanticType {
    let declaredNodeKind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 0))
    let declaredNodeFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    if declaredNodeKind == compilerSyntaxKindConstruct() {
        return CompilerSemanticType(kindTag: compilerSemanticTypeConstruct(), declarationNodeID: nodeID)
    }
    if declaredNodeKind == compilerSyntaxKindMember() {
        return compilerSemanticTypeFromSpan(tables: tables, fileID: compilerIntTableValue(table: tables.members, row: declaredNodeFacetRow, column: 1), typeStart: compilerIntTableValue(table: tables.members, row: declaredNodeFacetRow, column: 8), typeEnd: compilerIntTableValue(table: tables.members, row: declaredNodeFacetRow, column: 9))
    }
    if declaredNodeKind == compilerSyntaxKindParameter() {
        return compilerSemanticTypeFromSpan(tables: tables, fileID: compilerIntTableValue(table: tables.parameters, row: declaredNodeFacetRow, column: 1), typeStart: compilerIntTableValue(table: tables.parameters, row: declaredNodeFacetRow, column: 8), typeEnd: compilerIntTableValue(table: tables.parameters, row: declaredNodeFacetRow, column: 9))
    }
    if declaredNodeKind == compilerSyntaxKindLocalBinding() {
        return compilerSemanticTypeFromSpan(tables: tables, fileID: compilerIntTableValue(table: tables.bodyNodes, row: declaredNodeFacetRow, column: 1), typeStart: compilerIntTableValue(table: tables.bodyNodes, row: declaredNodeFacetRow, column: 8), typeEnd: compilerIntTableValue(table: tables.bodyNodes, row: declaredNodeFacetRow, column: 9))
    }
    if declaredNodeKind == compilerSyntaxKindFunction() {
        let declaredFunctionRow: Int(compilerSemanticFunctionRowForSyntaxID(tables: tables, functionSyntaxID: nodeID))
        if declaredFunctionRow >= 0 {
            return compilerSemanticTypeFromSpan(tables: tables, fileID: compilerIntTableValue(table: tables.functions, row: declaredFunctionRow, column: 1), typeStart: compilerIntTableValue(table: tables.functions, row: declaredFunctionRow, column: 6), typeEnd: compilerIntTableValue(table: tables.functions, row: declaredFunctionRow, column: 7))
        }
    }
    return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
}

function compilerSemanticDeclaredTypeName(tables: CompilerSyntaxTables, nodeID: Int): String {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return String("") }
    let kind: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 0))
    let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    if kind == compilerSyntaxKindMember() {
        let fileID: Int(compilerIntTableValue(table: tables.members, row: facetRow, column: 1))
        return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: facetRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: facetRow, column: 9))
    }
    if kind == compilerSyntaxKindParameter() {
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: facetRow, column: 1))
        return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: facetRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: facetRow, column: 9))
    }
    if kind == compilerSyntaxKindLocalBinding() {
        let fileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 1))
        return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 8), localEnd: compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 9))
    }
    if kind == compilerSyntaxKindFunction() {
        let functionRow: Int(compilerSemanticFunctionRowForSyntaxID(tables: tables, functionSyntaxID: nodeID))
        if functionRow >= 0 {
            let fileID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 1))
            return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7))
        }
    }
    return String("")
}

function compilerSemanticSpecializationDeclarationForTypeName(tables: CompilerSyntaxTables, typeName: String): Int {
    let typeLength: Int(stringLength(value: typeName))
    let outerRange: CompilerSourceRange(compilerSemanticGenericOuterNameRangeInText(
        text: typeName,
        typeRange: CompilerSourceRange(start: 0, end: typeLength, next: typeLength)))
    if outerRange.start < 0 || outerRange.end <= outerRange.start { return 0 - 1 }
    return compilerSemanticNamedDeclarationByTextRange(
        tables: tables,
        text: typeName,
        nameStart: outerRange.start,
        nameEnd: outerRange.end,
        requiredKind: compilerSyntaxKindConstruct())
}

function compilerSemanticDeclarationFingerprintForNode(tables: CompilerSyntaxTables, declarationNodeID: Int): CompilerFingerprint {
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: declarationNodeID))
    if declarationRow < 0 { return CompilerFingerprint(first: 0, second: 0) }
    return CompilerFingerprint(
        first: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 11),
        second: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 12)
    )
}

function compilerSemanticTrimStringRange(text: String, start: Int, end: Int): CompilerSourceRange {
    state trimmedStart: Int(start)
    state trimmedEnd: Int(end)
    while trimmedStart < trimmedEnd && isRangeLexerWhitespace(character: stringCharacterAt(source: text, index: trimmedStart)) {
        trimmedStart: trimmedStart + 1
    }
    while trimmedEnd > trimmedStart && isRangeLexerWhitespace(character: stringCharacterAt(source: text, index: trimmedEnd - 1)) {
        trimmedEnd: trimmedEnd - 1
    }
    return CompilerSourceRange(start: trimmedStart, end: trimmedEnd, next: trimmedEnd)
}

function compilerSemanticGenericOuterNameRangeInText(text: String, typeRange: CompilerSourceRange): CompilerSourceRange {
    let invalidRange: CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
    let normalizedRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: typeRange.start, end: typeRange.end))
    if normalizedRange.start < 0 || normalizedRange.end <= normalizedRange.start { return invalidRange }
    state genericStart: Int(0 - 1)
    state scanOffset: Int(normalizedRange.start)
    while scanOffset < normalizedRange.end && genericStart < 0 {
        if stringByteAt(source: text, index: scanOffset) == 60 { genericStart: scanOffset }
        scanOffset: scanOffset + 1
    }
    if genericStart < 0 { return invalidRange }
    let outerRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: normalizedRange.start, end: genericStart))
    if outerRange.end <= outerRange.start { return invalidRange }
    return CompilerSourceRange(start: outerRange.start, end: outerRange.end, next: genericStart)
}

function compilerSemanticGenericArgumentRangeInText(text: String, typeRange: CompilerSourceRange, ordinal: Int): CompilerSourceRange {
    let invalidRange: CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
    if ordinal < 0 || typeRange.start < 0 || typeRange.end < typeRange.start { return invalidRange }
    let normalizedRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: typeRange.start, end: typeRange.end))
    if normalizedRange.start < 0 || normalizedRange.end <= normalizedRange.start { return invalidRange }
    state genericStart: Int(0 - 1)
    state scanOffset: Int(normalizedRange.start)
    while scanOffset < normalizedRange.end && genericStart < 0 {
        if stringByteAt(source: text, index: scanOffset) == 60 { genericStart: scanOffset }
        scanOffset: scanOffset + 1
    }
    if genericStart < 0 { return invalidRange }
    state depth: Int(0)
    state argumentOrdinal: Int(0)
    state argumentStart: Int(genericStart + 1)
    state resultStart: Int(0 - 1)
    state resultEnd: Int(0 - 1)
    state sawClosing: Bool(false)
    state validStructure: Bool(true)
    state index: Int(genericStart + 1)
    while index < normalizedRange.end && !sawClosing && validStructure {
        let byte: Int(stringByteAt(source: text, index: index))
        if byte == 60 {
            depth: depth + 1
        } else if byte == 62 {
            if depth == 0 {
                if index != normalizedRange.end - 1 {
                    validStructure: false
                } else {
                    let argumentRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: argumentStart, end: index))
                    if argumentRange.end <= argumentRange.start {
                        validStructure: false
                    } else {
                        if argumentOrdinal == ordinal {
                            resultStart: argumentRange.start
                            resultEnd: argumentRange.end
                        }
                        sawClosing: true
                    }
                }
            }
            if depth > 0 { depth: depth - 1 }
        } else if byte == 44 && depth == 0 {
            let argumentRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: argumentStart, end: index))
            if argumentRange.end <= argumentRange.start {
                validStructure: false
            } else {
                if argumentOrdinal == ordinal {
                    resultStart: argumentRange.start
                    resultEnd: argumentRange.end
                }
                argumentOrdinal: argumentOrdinal + 1
                argumentStart: index + 1
            }
        }
        index: index + 1
    }
    if !validStructure || !sawClosing || depth != 0 || resultStart < 0 { return invalidRange }
    return CompilerSourceRange(start: resultStart, end: resultEnd, next: resultEnd)
}

function compilerSemanticResolvedTypeIdentityFromTextRange(tables: CompilerSyntaxTables, text: String, typeRange: CompilerSourceRange): CompilerSemanticTypeIdentity {
    let normalizedRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: typeRange.start, end: typeRange.end))
    if normalizedRange.start < 0 || normalizedRange.end <= normalizedRange.start { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
    if compilerSemanticStringRangeEqualsText(text: text, start: normalizedRange.start, end: normalizedRange.end, literal: String("Int")) {
        state intFingerprint: CompilerFingerprint(compilerFingerprintInitial())
        intFingerprint: compilerFingerprintAppendInt(fingerprint: intFingerprint, value: compilerSemanticTypeInt())
        intFingerprint: compilerFingerprintAppendInt(fingerprint: intFingerprint, value: 0 - 1)
        intFingerprint: compilerFingerprintAppendInt(fingerprint: intFingerprint, value: 0)
        return CompilerSemanticTypeIdentity(fingerprint: intFingerprint, isValid: true)
    }
    let authoredTypeName: String(text.substring(start: normalizedRange.start, end: normalizedRange.end))
    if compilerIntegerTypeIsUnsigned8(typeName: authoredTypeName) {
        state intFingerprint: CompilerFingerprint(compilerFingerprintInitial())
        intFingerprint: compilerFingerprintAppendInt(fingerprint: intFingerprint, value: compilerSemanticTypeInt())
        intFingerprint: compilerFingerprintAppendInt(fingerprint: intFingerprint, value: 8)
        intFingerprint: compilerFingerprintAppendText(fingerprint: intFingerprint, tag: 86, text: String("unsigned"))
        return CompilerSemanticTypeIdentity(fingerprint: intFingerprint, isValid: true)
    }
    if authoredTypeName == String("Float") || compilerFloatTypeIs32(typeName: authoredTypeName) || compilerFloatTypeIs64(typeName: authoredTypeName) {
        state floatFingerprint: CompilerFingerprint(compilerFingerprintInitial())
        floatFingerprint: compilerFingerprintAppendInt(fingerprint: floatFingerprint, value: compilerSemanticTypeFloat())
        state floatBits: Int(64)
        if compilerFloatTypeIs32(typeName: authoredTypeName) { floatBits: 32 }
        floatFingerprint: compilerFingerprintAppendInt(fingerprint: floatFingerprint, value: floatBits)
        return CompilerSemanticTypeIdentity(fingerprint: floatFingerprint, isValid: true)
    }
    let outerRange: CompilerSourceRange(compilerSemanticGenericOuterNameRangeInText(text: text, typeRange: normalizedRange))
    let genericStart: Int(outerRange.next)
    state nameEnd: Int(normalizedRange.end)
    if genericStart >= 0 {
        nameEnd: outerRange.end
    }
    let declarationNodeID: Int(compilerSemanticNamedDeclarationByTextRange(tables: tables, text: text, nameStart: normalizedRange.start, nameEnd: nameEnd, requiredKind: compilerSyntaxKindConstruct()))
    if declarationNodeID < 0 { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
    let declarationFingerprint: CompilerFingerprint(compilerSemanticDeclarationFingerprintForNode(tables: tables, declarationNodeID: declarationNodeID))
    if declarationFingerprint.first == 0 && declarationFingerprint.second == 0 { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
    let genericArity: Int(compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: declarationNodeID))
    if genericArity == 0 && genericStart >= 0 { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerSemanticTypeConstruct())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: declarationFingerprint.first)
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: declarationFingerprint.second)
    state argumentCount: Int(0)
    state argumentRange: CompilerSourceRange(compilerSemanticGenericArgumentRangeInText(text: text, typeRange: normalizedRange, ordinal: 0))
    while argumentRange.start >= 0 {
        argumentCount: argumentCount + 1
        argumentRange: compilerSemanticGenericArgumentRangeInText(text: text, typeRange: normalizedRange, ordinal: argumentCount)
    }
    if argumentCount != genericArity { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: genericArity)
    state ordinal: Int(0)
    while ordinal < genericArity {
        let argumentIdentityRange: CompilerSourceRange(compilerSemanticGenericArgumentRangeInText(text: text, typeRange: normalizedRange, ordinal: ordinal))
        if argumentIdentityRange.start < 0 { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
        let argumentIdentity: CompilerSemanticTypeIdentity(compilerSemanticResolvedTypeIdentityFromTextRange(tables: tables, text: text, typeRange: argumentIdentityRange))
        if !argumentIdentity.isValid { return CompilerSemanticTypeIdentity(fingerprint: CompilerFingerprint(first: 0, second: 0), isValid: false) }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: ordinal)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentIdentity.fingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentIdentity.fingerprint.second)
        ordinal: ordinal + 1
    }
    return CompilerSemanticTypeIdentity(fingerprint: fingerprint, isValid: true)
}

function compilerSemanticResolvedTypeIdentity(tables: CompilerSyntaxTables, typeName: String): CompilerSemanticTypeIdentity {
    return compilerSemanticResolvedTypeIdentityFromTextRange(
        tables: tables,
        text: typeName,
        typeRange: CompilerSourceRange(start: 0, end: stringLength(value: typeName), next: stringLength(value: typeName)))
}

function compilerSemanticSpecializationFingerprintForNode(tables: CompilerSyntaxTables, nodeID: Int): CompilerFingerprint {
    let typeName: String(compilerSemanticDeclaredTypeName(tables: tables, nodeID: nodeID))
    let declarationNodeID: Int(compilerSemanticSpecializationDeclarationForTypeName(tables: tables, typeName: typeName))
    if declarationNodeID < 0 { return CompilerFingerprint(first: 0, second: 0) }
    let genericArity: Int(compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: declarationNodeID))
    if genericArity <= 0 { return CompilerFingerprint(first: 0, second: 0) }
    let identity: CompilerSemanticTypeIdentity(compilerSemanticResolvedTypeIdentity(tables: tables, typeName: typeName))
    if !identity.isValid { return CompilerFingerprint(first: 0, second: 0) }
    return identity.fingerprint
}

function compilerSemanticNodeRequiresSpecializationIdentity(tables: CompilerSyntaxTables, nodeID: Int): Bool {
    let typeName: String(compilerSemanticDeclaredTypeName(tables: tables, nodeID: nodeID))
    let declarationNodeID: Int(compilerSemanticSpecializationDeclarationForTypeName(tables: tables, typeName: typeName))
    if declarationNodeID < 0 { return false }
    return compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: declarationNodeID) > 0
}

function compilerSemanticSpecializationArityForNode(tables: CompilerSyntaxTables, nodeID: Int): Int {
    let typeName: String(compilerSemanticDeclaredTypeName(tables: tables, nodeID: nodeID))
    let declarationNodeID: Int(compilerSemanticSpecializationDeclarationForTypeName(tables: tables, typeName: typeName))
    if declarationNodeID < 0 { return 0 }
    return compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: declarationNodeID)
}

function compilerSemanticResolveIndex(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, indexNodeID: Int): Int {
    compilerSemanticGraphPoison(semantics: semantics)
    return 0 - 1
}

function compilerSemanticResolveApplication(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, applicationNodeID: Int): Int {
    let semanticCalleeNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: applicationNodeID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0))
    let semanticCalleeTarget: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: semanticCalleeNodeID))
    let semanticCalleeKind: Int(compilerSemanticResolutionKind(semantics: semantics, useNodeID: semanticCalleeNodeID))
    if semanticCalleeTarget < 0 || (semanticCalleeKind != compilerSemanticResolutionConstruct() && semanticCalleeKind != compilerSemanticResolutionFunction()) {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    return compilerSemanticAppendResolution(semantics: semantics, useNodeID: applicationNodeID, targetNodeID: semanticCalleeTarget, resolutionKind: semanticCalleeKind)
}

function compilerSemanticResolveMember(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memberNodeID: Int): Int {
    let memberReceiverNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: memberNodeID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0))
    let memberReceiverTargetNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memberReceiverNodeID))
    if memberReceiverTargetNodeID < 0 {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    let memberReceiverType: CompilerSemanticType(compilerSemanticDeclaredNodeType(tables: tables, nodeID: memberReceiverTargetNodeID))
    let memberConstructNodeID: Int(compilerSemanticTypeDeclaration(type: memberReceiverType))
    if compilerSemanticTypeKind(type: memberReceiverType) != compilerSemanticTypeConstruct() || memberConstructNodeID < 0 {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    let memberSyntaxID: Int(compilerIntTableValue(table: delta.nodes, row: memberNodeID, column: 2))
    let memberBodyRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: memberSyntaxID, column: 1))
    let memberUseFileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: memberBodyRow, column: 1))
    let memberUseNameStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: memberBodyRow, column: 6))
    let memberUseNameEnd: Int(compilerIntTableValue(table: tables.bodyNodes, row: memberBodyRow, column: 7))
    state memberDeclarationRow: Int(0)
    state memberDeclarationMatch: Int(0 - 1)
    state memberDeclarationMatches: Int(0)
    let memberDeclarationCount: Int(compilerIntTableRowCount(table: tables.members))
    while memberDeclarationRow < memberDeclarationCount {
        if compilerIntTableValue(table: tables.members, row: memberDeclarationRow, column: 2) == memberConstructNodeID
            && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: memberUseFileID, firstStart: memberUseNameStart, firstEnd: memberUseNameEnd, secondFileID: compilerIntTableValue(table: tables.members, row: memberDeclarationRow, column: 1), secondStart: compilerIntTableValue(table: tables.members, row: memberDeclarationRow, column: 6), secondEnd: compilerIntTableValue(table: tables.members, row: memberDeclarationRow, column: 7)) {
            memberDeclarationMatch: compilerIntTableValue(table: tables.members, row: memberDeclarationRow, column: 0)
            memberDeclarationMatches: memberDeclarationMatches + 1
        }
        memberDeclarationRow: memberDeclarationRow + 1
    }
    if memberDeclarationMatches != 1 {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    return compilerSemanticAppendResolution(semantics: semantics, useNodeID: memberNodeID, targetNodeID: memberDeclarationMatch, resolutionKind: compilerSemanticResolutionMember())
}

function compilerSemanticResolveArgument(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, argumentNodeID: Int): Int {
    let argumentApplicationNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: argumentNodeID, roleTag: compilerSyntaxRoleArgument()))
    let argumentApplicationTarget: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: argumentApplicationNodeID))
    let argumentApplicationKind: Int(compilerSemanticResolutionKind(semantics: semantics, useNodeID: argumentApplicationNodeID))
    if argumentApplicationTarget < 0 {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    let argumentSyntaxID: Int(compilerIntTableValue(table: delta.nodes, row: argumentNodeID, column: 2))
    let argumentBodyRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: argumentSyntaxID, column: 1))
    let argumentFileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: argumentBodyRow, column: 1))
    let argumentOrdinal: Int(compilerIntTableValue(table: tables.bodyNodes, row: argumentBodyRow, column: 3))
    let argumentLabelStart: Int(compilerIntTableValue(table: tables.bodyNodes, row: argumentBodyRow, column: 6))
    let argumentLabelEnd: Int(compilerIntTableValue(table: tables.bodyNodes, row: argumentBodyRow, column: 7))
    state argumentTargetNodeID: Int(0 - 1)
    state argumentTargetMatches: Int(0)
    state argumentResolutionKind: Int(0 - 1)
    if argumentApplicationKind == compilerSemanticResolutionConstruct() {
        state argumentMemberRow: Int(0)
        let argumentMemberCount: Int(compilerIntTableRowCount(table: tables.members))
        while argumentMemberRow < argumentMemberCount {
            if compilerIntTableValue(table: tables.members, row: argumentMemberRow, column: 2) == argumentApplicationTarget
                && ((argumentLabelStart >= 0 && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: argumentFileID, firstStart: argumentLabelStart, firstEnd: argumentLabelEnd, secondFileID: compilerIntTableValue(table: tables.members, row: argumentMemberRow, column: 1), secondStart: compilerIntTableValue(table: tables.members, row: argumentMemberRow, column: 6), secondEnd: compilerIntTableValue(table: tables.members, row: argumentMemberRow, column: 7)))
                    || (argumentLabelStart < 0 && compilerIntTableValue(table: tables.members, row: argumentMemberRow, column: 3) == argumentOrdinal)) {
                argumentTargetNodeID: compilerIntTableValue(table: tables.members, row: argumentMemberRow, column: 0)
                argumentTargetMatches: argumentTargetMatches + 1
            }
            argumentMemberRow: argumentMemberRow + 1
        }
        argumentResolutionKind: compilerSemanticResolutionArgumentMember()
    } else if argumentApplicationKind == compilerSemanticResolutionFunction() {
        let argumentFunctionRow: Int(compilerSemanticFunctionRowForSyntaxID(tables: tables, functionSyntaxID: argumentApplicationTarget))
        state argumentParameterRow: Int(0)
        let argumentParameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
        while argumentParameterRow < argumentParameterCount {
            if compilerIntTableValue(table: tables.parameters, row: argumentParameterRow, column: 2) == argumentFunctionRow
                && ((argumentLabelStart >= 0 && compilerSemanticLocalRangesEqual(tables: tables, firstFileID: argumentFileID, firstStart: argumentLabelStart, firstEnd: argumentLabelEnd, secondFileID: compilerIntTableValue(table: tables.parameters, row: argumentParameterRow, column: 1), secondStart: compilerIntTableValue(table: tables.parameters, row: argumentParameterRow, column: 6), secondEnd: compilerIntTableValue(table: tables.parameters, row: argumentParameterRow, column: 7)))
                    || (argumentLabelStart < 0 && compilerIntTableValue(table: tables.parameters, row: argumentParameterRow, column: 3) == argumentOrdinal)) {
                argumentTargetNodeID: compilerIntTableValue(table: tables.parameters, row: argumentParameterRow, column: 0)
                argumentTargetMatches: argumentTargetMatches + 1
            }
            argumentParameterRow: argumentParameterRow + 1
        }
        argumentResolutionKind: compilerSemanticResolutionArgumentParameter()
    }
    if argumentTargetMatches != 1 || argumentResolutionKind < 0 {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    return compilerSemanticAppendResolution(semantics: semantics, useNodeID: argumentNodeID, targetNodeID: argumentTargetNodeID, resolutionKind: argumentResolutionKind)
}

function compilerSemanticStoredNodeType(semantics: CompilerSemanticGraph, nodeID: Int): CompilerSemanticType {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: semantics.nodeTypes) {
        return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
    }
    return CompilerSemanticType(
        kindTag: compilerIntTableValue(table: semantics.nodeTypes, row: nodeID, column: 1),
        declarationNodeID: compilerIntTableValue(table: semantics.nodeTypes, row: nodeID, column: 2)
    )
}

function compilerSemanticTypeForNode(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, nodeID: Int): CompilerSemanticType {
    let semanticNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: nodeID, column: 1))
    if semanticNodeKind == compilerSyntaxKindConstruct() || semanticNodeKind == compilerSyntaxKindMember()
        || semanticNodeKind == compilerSyntaxKindParameter() || semanticNodeKind == compilerSyntaxKindLocalBinding()
        || semanticNodeKind == compilerSyntaxKindFunction() {
        return compilerSemanticDeclaredNodeType(tables: tables, nodeID: nodeID)
    }
    if semanticNodeKind == compilerSyntaxKindIntegerLiteral() || semanticNodeKind == compilerSyntaxKindAddition() {
        return CompilerSemanticType(kindTag: compilerSemanticTypeInt(), declarationNodeID: 0 - 1)
    }
    if semanticNodeKind == compilerSyntaxKindDoubleLiteral() { return CompilerSemanticType(kindTag: compilerSemanticTypeFloat(), declarationNodeID: 0 - 1) }
    if semanticNodeKind == compilerSyntaxKindIdentifier() || semanticNodeKind == compilerSyntaxKindBindingReference() {
        let semanticIdentifierResolutionKind: Int(compilerSemanticResolutionKind(semantics: semantics, useNodeID: nodeID))
        if semanticIdentifierResolutionKind == compilerSemanticResolutionLocal() || semanticIdentifierResolutionKind == compilerSemanticResolutionParameter() {
            return compilerSemanticDeclaredNodeType(tables: tables, nodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID))
        }
        return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
    }
    if semanticNodeKind == compilerSyntaxKindApplication() {
        let semanticCalleeNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0))
        if semanticCalleeNodeID >= 0 {
            let semanticCalleeFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: semanticCalleeNodeID, column: 1))
            let semanticCalleeFileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: semanticCalleeFacetRow, column: 1))
            let semanticCalleeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: semanticCalleeFileID, localStart: compilerIntTableValue(table: tables.bodyNodes, row: semanticCalleeFacetRow, column: 6), localEnd: compilerIntTableValue(table: tables.bodyNodes, row: semanticCalleeFacetRow, column: 7)))
            if semanticCalleeName == String("Float") { return CompilerSemanticType(kindTag: compilerSemanticTypeFloat(), declarationNodeID: 0 - 1) }
        }
        let semanticApplicationResolutionKind: Int(compilerSemanticResolutionKind(semantics: semantics, useNodeID: nodeID))
        let semanticApplicationTarget: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID))
        if semanticApplicationResolutionKind == compilerSemanticResolutionConstruct() {
            return CompilerSemanticType(kindTag: compilerSemanticTypeConstruct(), declarationNodeID: semanticApplicationTarget)
        }
        if semanticApplicationResolutionKind == compilerSemanticResolutionFunction() {
            return compilerSemanticDeclaredNodeType(tables: tables, nodeID: semanticApplicationTarget)
        }
    }
    if semanticNodeKind == compilerSyntaxKindMemberRead() {
        return compilerSemanticDeclaredNodeType(tables: tables, nodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID))
    }
    if semanticNodeKind == compilerSyntaxKindArgument() {
        let semanticArgumentValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
        return compilerSemanticStoredNodeType(semantics: semantics, nodeID: semanticArgumentValueNodeID)
    }
    if semanticNodeKind == compilerSyntaxKindReturn() {
        let semanticReturnValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleReturnValue(), ordinal: 0))
        return compilerSemanticStoredNodeType(semantics: semantics, nodeID: semanticReturnValueNodeID)
    }
    if semanticNodeKind == compilerSyntaxKindAssignment() {
        let semanticAssignedValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleAssignedValue(), ordinal: 0))
        return compilerSemanticStoredNodeType(semantics: semantics, nodeID: semanticAssignedValueNodeID)
    }
    return CompilerSemanticType(kindTag: compilerSemanticTypeNone(), declarationNodeID: 0 - 1)
}

function compilerSemanticAppendNodeType(semantics: CompilerSemanticGraph, nodeID: Int, type: CompilerSemanticType): Int {
    if nodeID != compilerIntTableRowCount(table: semantics.nodeTypes) {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    if compilerSemanticAppend(semantics: semantics, table: semantics.nodeTypes, value: nodeID) != 0 { return 0 - 1 }
    if compilerSemanticAppend(semantics: semantics, table: semantics.nodeTypes, value: compilerSemanticTypeKind(type: type)) != 0 { return 0 - 1 }
    return compilerSemanticAppend(semantics: semantics, table: semantics.nodeTypes, value: compilerSemanticTypeDeclaration(type: type))
}

function compilerSemanticAppendSpecializations(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state semanticSpecializationNodeID: Int(0)
    let semanticSpecializationNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while semanticSpecializationNodeID < semanticSpecializationNodeCount {
        let fingerprint: CompilerFingerprint(compilerSemanticSpecializationFingerprintForNode(tables: tables, nodeID: semanticSpecializationNodeID))
        if compilerSemanticNodeRequiresSpecializationIdentity(tables: tables, nodeID: semanticSpecializationNodeID)
            && fingerprint.first == 0 && fingerprint.second == 0 {
            compilerSemanticGraphPoison(semantics: semantics)
            return 0 - 1
        }
        if fingerprint.first != 0 || fingerprint.second != 0 {
            let typeName: String(compilerSemanticDeclaredTypeName(tables: tables, nodeID: semanticSpecializationNodeID))
            let declarationNodeID: Int(compilerSemanticSpecializationDeclarationForTypeName(tables: tables, typeName: typeName))
            let genericArity: Int(compilerSemanticSpecializationArityForNode(tables: tables, nodeID: semanticSpecializationNodeID))
            if declarationNodeID < 0 || genericArity <= 0
                || compilerSemanticAppend(semantics: semantics, table: semantics.specializations, value: semanticSpecializationNodeID) != 0
                || compilerSemanticAppend(semantics: semantics, table: semantics.specializations, value: declarationNodeID) != 0
                || compilerSemanticAppend(semantics: semantics, table: semantics.specializations, value: genericArity) != 0
                || compilerSemanticAppend(semantics: semantics, table: semantics.specializations, value: fingerprint.first) != 0
                || compilerSemanticAppend(semantics: semantics, table: semantics.specializations, value: fingerprint.second) != 0 { return 0 - 1 }
        }
        semanticSpecializationNodeID: semanticSpecializationNodeID + 1
    }
    return 0
}

function compilerSemanticParameterIsRead(semantics: CompilerSemanticGraph, parameterNodeID: Int): Bool {
    state parameterReadResolutionRow: Int(0)
    let parameterReadResolutionCount: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while parameterReadResolutionRow < parameterReadResolutionCount {
        if compilerIntTableValue(table: semantics.resolutions, row: parameterReadResolutionRow, column: 1) == parameterNodeID
            && compilerIntTableValue(table: semantics.resolutions, row: parameterReadResolutionRow, column: 2) == compilerSemanticResolutionParameter() { return true }
        parameterReadResolutionRow: parameterReadResolutionRow + 1
    }
    return false
}

function compilerSemanticParameterEscapes(delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, parameterNodeID: Int): Bool {
    state parameterEscapeResolutionRow: Int(0)
    let parameterEscapeResolutionCount: Int(compilerIntTableRowCount(table: semantics.resolutions))
    while parameterEscapeResolutionRow < parameterEscapeResolutionCount {
        if compilerIntTableValue(table: semantics.resolutions, row: parameterEscapeResolutionRow, column: 1) == parameterNodeID
            && compilerIntTableValue(table: semantics.resolutions, row: parameterEscapeResolutionRow, column: 2) == compilerSemanticResolutionParameter() {
            let parameterUseNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: parameterEscapeResolutionRow, column: 0))
            if compilerSemanticGraphParent(delta: delta, objectNodeID: parameterUseNodeID, roleTag: compilerSyntaxRoleReturnValue()) >= 0
                || compilerSemanticGraphParent(delta: delta, objectNodeID: parameterUseNodeID, roleTag: compilerSyntaxRoleArgumentValue()) >= 0 { return true }
        }
        parameterEscapeResolutionRow: parameterEscapeResolutionRow + 1
    }
    return false
}

function compilerSemanticAppendParameterEffects(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state semanticEffectParameterRow: Int(0)
    let semanticEffectParameterCount: Int(compilerIntTableRowCount(table: tables.parameters))
    while semanticEffectParameterRow < semanticEffectParameterCount {
        let semanticEffectParameterNodeID: Int(compilerIntTableValue(table: tables.parameters, row: semanticEffectParameterRow, column: 0))
        let semanticEffectFunctionID: Int(compilerIntTableValue(table: tables.parameters, row: semanticEffectParameterRow, column: 2))
        let semanticEffectFunctionNodeID: Int(compilerPlotterFunctionSyntaxID(tables: tables, functionID: semanticEffectFunctionID))
        let semanticEffectFunctionRole: Int(compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: semanticEffectFunctionNodeID))
        let semanticEffectIsStorageParameter: Bool(semanticEffectParameterRow == compilerIntTableValue(table: tables.functions, row: semanticEffectFunctionID, column: 2)
            && (semanticEffectFunctionRole == compilerRuntimeABIFunctionSharedRead() || semanticEffectFunctionRole == compilerRuntimeABIFunctionUniqueWrite()))
        state semanticEffectRead: Int(0)
        if compilerSemanticParameterIsRead(semantics: semantics, parameterNodeID: semanticEffectParameterNodeID) { semanticEffectRead: 1 }
        if semanticEffectIsStorageParameter { semanticEffectRead: 1 }
        state semanticEffectWrite: Int(0)
        if semanticEffectIsStorageParameter && semanticEffectFunctionRole == compilerRuntimeABIFunctionUniqueWrite() { semanticEffectWrite: 1 }
        state semanticEffectEscape: Int(0)
        if compilerSemanticParameterEscapes(delta: delta, semantics: semantics, parameterNodeID: semanticEffectParameterNodeID) { semanticEffectEscape: 1 }
        if compilerSemanticAppend(semantics: semantics, table: semantics.parameterEffects, value: semanticEffectFunctionNodeID) != 0 { return 0 - 1 }
        if compilerSemanticAppend(semantics: semantics, table: semantics.parameterEffects, value: semanticEffectParameterNodeID) != 0 { return 0 - 1 }
        if compilerSemanticAppend(semantics: semantics, table: semantics.parameterEffects, value: semanticEffectRead) != 0 { return 0 - 1 }
        if compilerSemanticAppend(semantics: semantics, table: semantics.parameterEffects, value: semanticEffectWrite) != 0 { return 0 - 1 }
        if compilerSemanticAppend(semantics: semantics, table: semantics.parameterEffects, value: semanticEffectEscape) != 0 { return 0 - 1 }
        semanticEffectParameterRow: semanticEffectParameterRow + 1
    }
    return 0
}

function compilerSemanticBindingSourceLocalForMemberAccess(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memberAccessNodeID: Int): Int {
    if compilerIntTableValue(table: delta.nodes, row: memberAccessNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let bindingMemberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: memberAccessNodeID))
    if bindingMemberNodeID < 0 { return 0 - 1 }
    let bindingMemberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: bindingMemberNodeID, column: 1))
    if compilerIntTableValue(table: tables.members, row: bindingMemberFacetRow, column: 12) != compilerSyntaxMemberKindBinding() { return 0 - 1 }
    let bindingReceiverNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: memberAccessNodeID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0))
    if compilerSemanticResolutionKind(semantics: semantics, useNodeID: bindingReceiverNodeID) != compilerSemanticResolutionLocal() { return 0 - 1 }
    let bindingOwnerLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: bindingReceiverNodeID))
    let bindingInitializerNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: bindingOwnerLocalNodeID, roleTag: compilerSyntaxRoleInitializer(), ordinal: 0))
    if compilerSemanticResolutionKind(semantics: semantics, useNodeID: bindingInitializerNodeID) != compilerSemanticResolutionConstruct() { return 0 - 1 }
    state bindingArgumentOrdinal: Int(0)
    state bindingSourceLocalNodeID: Int(0 - 1)
    state bindingSourceMatchCount: Int(0)
    state bindingArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: bindingInitializerNodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: bindingArgumentOrdinal))
    while bindingArgumentNodeID >= 0 {
        if compilerSemanticResolutionTarget(semantics: semantics, useNodeID: bindingArgumentNodeID) == bindingMemberNodeID {
            let bindingValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: bindingArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if compilerIntTableValue(table: delta.nodes, row: bindingValueNodeID, column: 1) == compilerSyntaxKindBindingReference()
                && compilerSemanticResolutionKind(semantics: semantics, useNodeID: bindingValueNodeID) == compilerSemanticResolutionLocal() {
                bindingSourceLocalNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: bindingValueNodeID)
                bindingSourceMatchCount: bindingSourceMatchCount + 1
            }
        }
        bindingArgumentOrdinal: bindingArgumentOrdinal + 1
        bindingArgumentNodeID: compilerSemanticGraphChild(delta: delta, subjectNodeID: bindingInitializerNodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: bindingArgumentOrdinal)
    }
    if bindingSourceMatchCount != 1 { return 0 - 1 }
    return bindingSourceLocalNodeID
}

function compilerSemanticAppendAccessEffects(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    state semanticAccessNodeID: Int(0)
    let semanticAccessNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while semanticAccessNodeID < semanticAccessNodeCount {
        let semanticAccessNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticAccessNodeID, column: 1))
        if semanticAccessNodeKind == compilerSyntaxKindAssignment() {
            let semanticAccessTargetNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: semanticAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
            state semanticAccessLocalNodeID: Int(0 - 1)
            let semanticAccessTargetKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticAccessTargetNodeID, column: 1))
            if semanticAccessTargetKind == compilerSyntaxKindIdentifier()
                && compilerSemanticResolutionKind(semantics: semantics, useNodeID: semanticAccessTargetNodeID) == compilerSemanticResolutionLocal() {
                semanticAccessLocalNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: semanticAccessTargetNodeID)
            } else if semanticAccessTargetKind == compilerSyntaxKindMemberRead() {
                semanticAccessLocalNodeID: compilerSemanticBindingSourceLocalForMemberAccess(tables: tables, delta: delta, semantics: semantics, memberAccessNodeID: semanticAccessTargetNodeID)
            }
            if semanticAccessTargetNodeID < 0 || semanticAccessLocalNodeID < 0 { return 0 - 1 }
            if compilerSemanticAppend(semantics: semantics, table: semantics.accessEffects, value: semanticAccessNodeID) != 0 { return 0 - 1 }
            if compilerSemanticAppend(semantics: semantics, table: semantics.accessEffects, value: semanticAccessTargetNodeID) != 0 { return 0 - 1 }
            if compilerSemanticAppend(semantics: semantics, table: semantics.accessEffects, value: semanticAccessLocalNodeID) != 0 { return 0 - 1 }
            if compilerSemanticAppend(semantics: semantics, table: semantics.accessEffects, value: compilerSemanticAccessWrite()) != 0 { return 0 - 1 }
            if compilerSemanticAppend(semantics: semantics, table: semantics.accessEffects, value: compilerSemanticAccessUnique()) != 0 { return 0 - 1 }
        }
        semanticAccessNodeID: semanticAccessNodeID + 1
    }
    return 0
}

function compilerSemanticAccessEffectRowForAssignment(semantics: CompilerSemanticGraph, assignmentNodeID: Int): Int {
    state semanticAccessLookupRow: Int(0)
    let semanticAccessLookupCount: Int(compilerIntTableRowCount(table: semantics.accessEffects))
    while semanticAccessLookupRow < semanticAccessLookupCount {
        if compilerIntTableValue(table: semantics.accessEffects, row: semanticAccessLookupRow, column: 0) == assignmentNodeID { return semanticAccessLookupRow }
        semanticAccessLookupRow: semanticAccessLookupRow + 1
    }
    return 0 - 1
}

function compilerSemanticBuild(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Int {
    if !compilerGraphDeltaIsValid(tables: tables, delta: delta) {
        compilerSemanticGraphPoison(semantics: semantics)
        return 0 - 1
    }
    state semanticBuildNodeID: Int(0)
    let semanticBuildNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while semanticBuildNodeID < semanticBuildNodeCount {
        let semanticBuildKindTag: Int(compilerIntTableValue(table: delta.nodes, row: semanticBuildNodeID, column: 1))
        state semanticResolutionStatus: Int(0)
        if semanticBuildKindTag == compilerSyntaxKindIdentifier() || semanticBuildKindTag == compilerSyntaxKindBindingReference() {
            semanticResolutionStatus: compilerSemanticResolveIdentifier(tables: tables, delta: delta, semantics: semantics, identifierNodeID: semanticBuildNodeID)
        } else if semanticBuildKindTag == compilerSyntaxKindApplication() {
            semanticResolutionStatus: compilerSemanticResolveApplication(tables: tables, delta: delta, semantics: semantics, applicationNodeID: semanticBuildNodeID)
        } else if semanticBuildKindTag == compilerSyntaxKindMemberRead() {
            semanticResolutionStatus: compilerSemanticResolveMember(tables: tables, delta: delta, semantics: semantics, memberNodeID: semanticBuildNodeID)
        } else if semanticBuildKindTag == compilerSyntaxKindArgument() {
            semanticResolutionStatus: compilerSemanticResolveArgument(tables: tables, delta: delta, semantics: semantics, argumentNodeID: semanticBuildNodeID)
        } else if semanticBuildKindTag == compilerSyntaxKindIndex() {
            semanticResolutionStatus: compilerSemanticResolveIndex(tables: tables, delta: delta, semantics: semantics, indexNodeID: semanticBuildNodeID)
        }
        if semanticResolutionStatus != 0 { return 0 - 1 }
        semanticBuildNodeID: semanticBuildNodeID + 1
    }
    semanticBuildNodeID: 0
    while semanticBuildNodeID < semanticBuildNodeCount {
        let semanticBuiltType: CompilerSemanticType(compilerSemanticTypeForNode(tables: tables, delta: delta, semantics: semantics, nodeID: semanticBuildNodeID))
        if compilerSemanticAppendNodeType(semantics: semantics, nodeID: semanticBuildNodeID, type: semanticBuiltType) != 0 { return 0 - 1 }
        semanticBuildNodeID: semanticBuildNodeID + 1
    }
    if compilerSemanticAppendSpecializations(tables: tables, delta: delta, semantics: semantics) != 0 { return 0 - 1 }
    if compilerSemanticAppendParameterEffects(tables: tables, delta: delta, semantics: semantics) != 0 { return 0 - 1 }
    return compilerSemanticAppendAccessEffects(tables: tables, delta: delta, semantics: semantics)
}

function compilerSemanticGraphIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Bool {
    if semantics.failures.count != 0
        || !compilerIntTableIsComplete(table: semantics.resolutions)
        || !compilerIntTableIsComplete(table: semantics.nodeTypes)
        || !compilerIntTableIsComplete(table: semantics.specializations)
        || !compilerIntTableIsComplete(table: semantics.parameterEffects)
        || !compilerIntTableIsComplete(table: semantics.accessEffects) { return false }
    let semanticValidationNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    state semanticExpectedResolutionCount: Int(0)
    state semanticValidationNodeID: Int(0)
    while semanticValidationNodeID < semanticValidationNodeCount {
        let semanticValidationKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticValidationNodeID, column: 1))
        if semanticValidationKind == compilerSyntaxKindIdentifier() || semanticValidationKind == compilerSyntaxKindBindingReference() || semanticValidationKind == compilerSyntaxKindApplication()
            || semanticValidationKind == compilerSyntaxKindMemberRead() || semanticValidationKind == compilerSyntaxKindArgument() {
            semanticExpectedResolutionCount: semanticExpectedResolutionCount + 1
        }
        semanticValidationNodeID: semanticValidationNodeID + 1
    }
    if compilerIntTableRowCount(table: semantics.resolutions) != semanticExpectedResolutionCount
        || compilerIntTableRowCount(table: semantics.nodeTypes) != semanticValidationNodeCount
        || compilerIntTableRowCount(table: semantics.parameterEffects) != compilerIntTableRowCount(table: tables.parameters) { return false }

    state semanticValidationResolutionRow: Int(0)
    state previousSemanticUseNodeID: Int(0 - 1)
    while semanticValidationResolutionRow < compilerIntTableRowCount(table: semantics.resolutions) {
        let semanticUseNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: semanticValidationResolutionRow, column: 0))
        let semanticTargetNodeID: Int(compilerIntTableValue(table: semantics.resolutions, row: semanticValidationResolutionRow, column: 1))
        let semanticResolutionKindTag: Int(compilerIntTableValue(table: semantics.resolutions, row: semanticValidationResolutionRow, column: 2))
        if semanticUseNodeID <= previousSemanticUseNodeID || semanticUseNodeID < 0 || semanticUseNodeID >= semanticValidationNodeCount
            || semanticTargetNodeID < 0 || semanticTargetNodeID >= semanticValidationNodeCount
            || semanticResolutionKindTag < compilerSemanticResolutionConstruct() || semanticResolutionKindTag > compilerSemanticResolutionArgumentParameter() { return false }
        let semanticTargetKindTag: Int(compilerIntTableValue(table: delta.nodes, row: semanticTargetNodeID, column: 1))
        if semanticResolutionKindTag == compilerSemanticResolutionConstruct() && semanticTargetKindTag != compilerSyntaxKindConstruct() { return false }
        if semanticResolutionKindTag == compilerSemanticResolutionFunction() && semanticTargetKindTag != compilerSyntaxKindFunction() { return false }
        if semanticResolutionKindTag == compilerSemanticResolutionLocal() && semanticTargetKindTag != compilerSyntaxKindLocalBinding() { return false }
        if semanticResolutionKindTag == compilerSemanticResolutionParameter() && semanticTargetKindTag != compilerSyntaxKindParameter() { return false }
        if (semanticResolutionKindTag == compilerSemanticResolutionMember() || semanticResolutionKindTag == compilerSemanticResolutionArgumentMember()) && semanticTargetKindTag != compilerSyntaxKindMember() { return false }
        if semanticResolutionKindTag == compilerSemanticResolutionArgumentParameter() && semanticTargetKindTag != compilerSyntaxKindParameter() { return false }
        previousSemanticUseNodeID: semanticUseNodeID
        semanticValidationResolutionRow: semanticValidationResolutionRow + 1
    }

    semanticValidationNodeID: 0
    while semanticValidationNodeID < semanticValidationNodeCount {
        if compilerIntTableValue(table: semantics.nodeTypes, row: semanticValidationNodeID, column: 0) != semanticValidationNodeID { return false }
        let semanticNodeTypeKind: Int(compilerIntTableValue(table: semantics.nodeTypes, row: semanticValidationNodeID, column: 1))
        let semanticNodeTypeDeclaration: Int(compilerIntTableValue(table: semantics.nodeTypes, row: semanticValidationNodeID, column: 2))
        if semanticNodeTypeKind < compilerSemanticTypeNone() || semanticNodeTypeKind > compilerSemanticTypeConstruct() { return false }
        if semanticNodeTypeKind == compilerSemanticTypeConstruct() {
            if semanticNodeTypeDeclaration < 0 || semanticNodeTypeDeclaration >= semanticValidationNodeCount
                || compilerIntTableValue(table: delta.nodes, row: semanticNodeTypeDeclaration, column: 1) != compilerSyntaxKindConstruct() { return false }
        } else if semanticNodeTypeDeclaration != 0 - 1 { return false }
        let semanticTypedNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticValidationNodeID, column: 1))
        if (semanticTypedNodeKind == compilerSyntaxKindMember() || semanticTypedNodeKind == compilerSyntaxKindParameter()
            || semanticTypedNodeKind == compilerSyntaxKindLocalBinding() || semanticTypedNodeKind == compilerSyntaxKindApplication()
            || semanticTypedNodeKind == compilerSyntaxKindMemberRead() || semanticTypedNodeKind == compilerSyntaxKindIntegerLiteral()
            || semanticTypedNodeKind == compilerSyntaxKindAddition() || semanticTypedNodeKind == compilerSyntaxKindArgument()
            || semanticTypedNodeKind == compilerSyntaxKindReturn() || semanticTypedNodeKind == compilerSyntaxKindFunction()
            || semanticTypedNodeKind == compilerSyntaxKindBindingReference()
            || semanticTypedNodeKind == compilerSyntaxKindAssignment())
            && semanticNodeTypeKind == compilerSemanticTypeNone() { return false }
        semanticValidationNodeID: semanticValidationNodeID + 1
    }

    state semanticEffectRow: Int(0)
    while semanticEffectRow < compilerIntTableRowCount(table: semantics.parameterEffects) {
        let semanticEffectFunctionNode: Int(compilerIntTableValue(table: semantics.parameterEffects, row: semanticEffectRow, column: 0))
        let semanticEffectParameterNode: Int(compilerIntTableValue(table: semantics.parameterEffects, row: semanticEffectRow, column: 1))
        if compilerIntTableValue(table: delta.nodes, row: semanticEffectFunctionNode, column: 1) != compilerSyntaxKindFunction()
            || compilerIntTableValue(table: delta.nodes, row: semanticEffectParameterNode, column: 1) != compilerSyntaxKindParameter() { return false }
        semanticEffectRow: semanticEffectRow + 1
    }
    state semanticAccessEffectRow: Int(0)
    state semanticExpectedAccessEffects: Int(0)
    semanticValidationNodeID: 0
    while semanticValidationNodeID < semanticValidationNodeCount {
        let semanticValidationAccessKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticValidationNodeID, column: 1))
        if semanticValidationAccessKind == compilerSyntaxKindAssignment() {
            semanticExpectedAccessEffects: semanticExpectedAccessEffects + 1
        }
        semanticValidationNodeID: semanticValidationNodeID + 1
    }
    if compilerIntTableRowCount(table: semantics.accessEffects) != semanticExpectedAccessEffects { return false }
    state previousSemanticAccessNodeID: Int(0 - 1)
    while semanticAccessEffectRow < compilerIntTableRowCount(table: semantics.accessEffects) {
        let semanticAccessNodeID: Int(compilerIntTableValue(table: semantics.accessEffects, row: semanticAccessEffectRow, column: 0))
        let semanticAccessTargetNodeID: Int(compilerIntTableValue(table: semantics.accessEffects, row: semanticAccessEffectRow, column: 1))
        let semanticAccessLocalNodeID: Int(compilerIntTableValue(table: semantics.accessEffects, row: semanticAccessEffectRow, column: 2))
        if semanticAccessNodeID <= previousSemanticAccessNodeID
            || semanticAccessNodeID < 0 || semanticAccessNodeID >= semanticValidationNodeCount
            || semanticAccessTargetNodeID < 0 || semanticAccessTargetNodeID >= semanticValidationNodeCount
            || semanticAccessLocalNodeID < 0 || semanticAccessLocalNodeID >= semanticValidationNodeCount { return false }
        let semanticAccessNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticAccessNodeID, column: 1))
        let semanticAccessTargetKind: Int(compilerIntTableValue(table: delta.nodes, row: semanticAccessTargetNodeID, column: 1))
        let semanticAccessKind: Int(compilerIntTableValue(table: semantics.accessEffects, row: semanticAccessEffectRow, column: 3))
        let semanticAccessMode: Int(compilerIntTableValue(table: semantics.accessEffects, row: semanticAccessEffectRow, column: 4))
        if semanticAccessKind == compilerSemanticAccessWrite() {
            state semanticAccessExpectedLocalNodeID: Int(0 - 1)
            if semanticAccessTargetKind == compilerSyntaxKindIdentifier() {
                semanticAccessExpectedLocalNodeID: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: semanticAccessTargetNodeID)
            } else if semanticAccessTargetKind == compilerSyntaxKindMemberRead() {
                semanticAccessExpectedLocalNodeID: compilerSemanticBindingSourceLocalForMemberAccess(tables: tables, delta: delta, semantics: semantics, memberAccessNodeID: semanticAccessTargetNodeID)
            }
            if semanticAccessNodeKind != compilerSyntaxKindAssignment()
                || compilerSemanticGraphChild(delta: delta, subjectNodeID: semanticAccessNodeID, roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0) != semanticAccessTargetNodeID
                || semanticAccessExpectedLocalNodeID != semanticAccessLocalNodeID
                || semanticAccessMode != compilerSemanticAccessUnique() { return false }
        } else {
            return false
        }
        previousSemanticAccessNodeID: semanticAccessNodeID
        semanticAccessEffectRow: semanticAccessEffectRow + 1
    }
    state semanticExpectedSpecializationCount: Int(0)
    semanticValidationNodeID: 0
    while semanticValidationNodeID < semanticValidationNodeCount {
        let expectedSpecializationFingerprint: CompilerFingerprint(compilerSemanticSpecializationFingerprintForNode(tables: tables, nodeID: semanticValidationNodeID))
        if compilerSemanticNodeRequiresSpecializationIdentity(tables: tables, nodeID: semanticValidationNodeID)
            && expectedSpecializationFingerprint.first == 0 && expectedSpecializationFingerprint.second == 0 { return false }
        if expectedSpecializationFingerprint.first != 0 || expectedSpecializationFingerprint.second != 0 {
            semanticExpectedSpecializationCount: semanticExpectedSpecializationCount + 1
        }
        semanticValidationNodeID: semanticValidationNodeID + 1
    }
    if compilerIntTableRowCount(table: semantics.specializations) != semanticExpectedSpecializationCount { return false }
    state semanticSpecializationValidationRow: Int(0)
    state previousSpecializationNodeID: Int(0 - 1)
    while semanticSpecializationValidationRow < compilerIntTableRowCount(table: semantics.specializations) {
        let specializationNodeID: Int(compilerIntTableValue(table: semantics.specializations, row: semanticSpecializationValidationRow, column: 0))
        let specializationDeclarationNodeID: Int(compilerIntTableValue(table: semantics.specializations, row: semanticSpecializationValidationRow, column: 1))
        let specializationArity: Int(compilerIntTableValue(table: semantics.specializations, row: semanticSpecializationValidationRow, column: 2))
        let specializationFingerprint: CompilerFingerprint(
            first: compilerIntTableValue(table: semantics.specializations, row: semanticSpecializationValidationRow, column: 3),
            second: compilerIntTableValue(table: semantics.specializations, row: semanticSpecializationValidationRow, column: 4)
        )
        let expectedSpecializationFingerprint: CompilerFingerprint(compilerSemanticSpecializationFingerprintForNode(tables: tables, nodeID: specializationNodeID))
        let expectedSpecializationDeclarationNodeID: Int(compilerSemanticSpecializationDeclarationForTypeName(tables: tables, typeName: compilerSemanticDeclaredTypeName(tables: tables, nodeID: specializationNodeID)))
        if specializationNodeID <= previousSpecializationNodeID
            || specializationNodeID < 0 || specializationNodeID >= semanticValidationNodeCount
            || specializationDeclarationNodeID != expectedSpecializationDeclarationNodeID
            || specializationDeclarationNodeID < 0
            || compilerIntTableValue(table: delta.nodes, row: specializationDeclarationNodeID, column: 1) != compilerSyntaxKindConstruct()
            || specializationArity != compilerSemanticSpecializationArityForNode(tables: tables, nodeID: specializationNodeID)
            || specializationFingerprint.first != expectedSpecializationFingerprint.first
            || specializationFingerprint.second != expectedSpecializationFingerprint.second
            || (specializationFingerprint.first == 0 && specializationFingerprint.second == 0) { return false }
        previousSpecializationNodeID: specializationNodeID
        semanticSpecializationValidationRow: semanticSpecializationValidationRow + 1
    }
    return true
}

function compilerSemanticRenderSnapshot(semantics: CompilerSemanticGraph): String {
    let semanticTab: String(compilerCoreTabCharacter())
    let semanticNewline: String(compilerCoreNewlineCharacter())
    let semanticResolutionSnapshot: String(compilerTypedSyntaxRenderRawTable(name: String("semanticResolution"), table: semantics.resolutions))
    let semanticTypeSnapshot: String(compilerTypedSyntaxRenderRawTable(name: String("semanticType"), table: semantics.nodeTypes))
    let semanticEffectSnapshot: String(compilerTypedSyntaxRenderRawTable(name: String("semanticEffect"), table: semantics.parameterEffects))
    let semanticAccessEffectSnapshot: String(compilerTypedSyntaxRenderRawTable(name: String("semanticAccessEffect"), table: semantics.accessEffects))
    let semanticSpecializationSnapshot: String(compilerTypedSyntaxRenderRawTable(name: String("semanticSpecialization"), table: semantics.specializations))
    return "semanticGraph\(semanticTab)valid=true\(semanticTab)resolutionCount=\(compilerIntTableRowCount(table: semantics.resolutions))\(semanticTab)typeCount=\(compilerIntTableRowCount(table: semantics.nodeTypes))\(semanticTab)effectCount=\(compilerIntTableRowCount(table: semantics.parameterEffects))\(semanticTab)accessEffectCount=\(compilerIntTableRowCount(table: semantics.accessEffects))\(semanticNewline)\(semanticResolutionSnapshot)\(semanticTypeSnapshot)\(semanticEffectSnapshot)\(semanticAccessEffectSnapshot)\(semanticSpecializationSnapshot)"
}

function compilerSemanticSummary(source: String): String {
    let semanticTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let semanticCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: semanticTables))
    let semanticDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let semanticGraph: CompilerSemanticGraph(compilerSemanticGraphCreate())
    state semanticSummary: String("")
    if semanticCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: semanticTables) {
        semanticSummary: String("compilerError\tkind=invalidTypedSyntaxSnapshot\n")
    } else if compilerPlotterBuild(tables: semanticTables, delta: semanticDelta) != 0 || !compilerGraphDeltaIsValid(tables: semanticTables, delta: semanticDelta) {
        semanticSummary: String("compilerError\tkind=invalidGraphDelta\n")
    } else if compilerSemanticBuild(tables: semanticTables, delta: semanticDelta, semantics: semanticGraph) != 0 || !compilerSemanticGraphIsValid(tables: semanticTables, delta: semanticDelta, semantics: semanticGraph) {
        semanticSummary: String("compilerError\tkind=invalidSemanticGraph\n")
    } else {
        semanticSummary: compilerSemanticRenderSnapshot(semantics: semanticGraph)
    }
    let semanticGraphDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: semanticGraph))
    let semanticDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: semanticDelta))
    let semanticTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: semanticTables))
    if semanticGraphDestroyStatus != 0 || semanticDeltaDestroyStatus != 0 || semanticTablesDestroyStatus != 0 { return String("compilerError\tkind=semanticOwnershipFailure\n") }
    return semanticSummary
}
