            && compilerSemanticLocalRangesEqual(tables: arena.tables, firstFileID: fileID, firstStart: normalizedRange.start, firstEnd: normalizedRange.end, secondFileID: compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()), secondStart: compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameStartColumn()), secondEnd: compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterNameEndColumn())) { return compilerIntTableValue(table: arena.tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()) }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaSpecializedTypeIDForSpan(arena: CompilerBodyArena, receiverTypeID: Int, ownerSyntaxID: Int, fileID: Int, start: Int, end: Int): Int {
    let parameterOrdinal: Int(compilerBodyArenaGenericParameterOrdinal(arena: arena, ownerSyntaxID: ownerSyntaxID, fileID: fileID, start: start, end: end))
    if parameterOrdinal >= 0 {
        if receiverTypeID < 0 || receiverTypeID >= compilerIntTableRowCount(table: arena.typeInstances)
            || compilerIntTableValue(table: arena.typeInstances, row: receiverTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()) != ownerSyntaxID { return 0 - 1 }
