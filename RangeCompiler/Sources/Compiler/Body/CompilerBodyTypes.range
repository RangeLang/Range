    if compilerIntTableAppend(table: typeKeys, value: typeKind) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeKeys, value: nominalSyntaxID) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeKeys, value: firstArgumentRow) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeKeys, value: argumentCount) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeKeys, value: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceFileColumn())) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeKeys, value: compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceStartColumn())) != 0 {
