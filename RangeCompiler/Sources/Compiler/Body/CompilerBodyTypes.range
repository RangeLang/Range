        || compilerIntTableValue(table: arena.resolutions, row: bindingValueResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    let sourceSymbolID: Int(compilerIntTableValue(table: arena.resolutions, row: bindingValueResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if sourceSymbolID < 0 || sourceSymbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: sourceSymbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolState()
        || compilerBodyArenaSymbolTypeID(arena: arena, symbolID: sourceSymbolID) != compilerBodyArenaExpressionTypeID(arena: arena, nodeID: memberAccessNodeID) { return 0 - 1 }
    return sourceSymbolID
}

function compilerBodyArenaMutableArraySymbolForTarget(arena: CompilerBodyArena, targetNodeID: Int): Int {
    if targetNodeID < 0 || targetNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: targetNodeID, column: 1) != compilerSyntaxKindIndex() { return 0 - 1 }
    let arrayNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: targetNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    if arrayNodeID < 0
        || !compilerBodyArenaTypeIDIsArray(arena: arena, typeID: compilerBodyArenaExpressionTypeID(arena: arena, nodeID: arrayNodeID)) { return 0 - 1 }
    state ownerNodeID: Int(arrayNodeID)
    state targetMemberResolved: Bool(false)
    while ownerNodeID >= 0 && compilerIntTableValue(table: arena.nodes, row: ownerNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerNodeID))
        if memberResolutionRow < 0
            || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
        let memberRow: Int(compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
        if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
        let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
        if !targetMemberResolved {
            if memberKind == compilerSyntaxMemberKindBinding() {
                return compilerBodyArenaBindingSourceSymbolForMemberAccess(arena: arena, memberAccessNodeID: ownerNodeID)
            }
            if memberKind != compilerSyntaxMemberKindState() { return 0 - 1 }
            targetMemberResolved: true
        } else {
            if (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState())
                || compilerMemoryMemberRepresentation(tables: arena.tables, memberRow: memberRow) != compilerMemoryMemberRepresentationIdentity() { return 0 - 1 }
        }
        ownerNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
    }
    if ownerNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: ownerNodeID, column: 1) != compilerSyntaxKindIdentifier() { return 0 - 1 }
    let ownerResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerNodeID))
    if ownerResolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    let symbolID: Int(compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if targetMemberResolved {
        if symbolKind != compilerBodySymbolLet() && symbolKind != compilerBodySymbolState() { return 0 - 1 }
    } else if symbolKind != compilerBodySymbolState() { return 0 - 1 }
    return symbolID
}

function compilerBodyArenaMutableMemberSymbolForTarget(arena: CompilerBodyArena, targetNodeID: Int): Int {
    if targetNodeID < 0 || targetNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: targetNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let targetResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: targetNodeID))
    if targetResolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: targetResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
    let targetMemberRow: Int(compilerIntTableValue(table: arena.resolutions, row: targetResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if targetMemberRow < 0 || targetMemberRow >= compilerIntTableRowCount(table: arena.tables.members)
        || compilerIntTableValue(table: arena.tables.members, row: targetMemberRow, column: 12) != compilerSyntaxMemberKindState() { return 0 - 1 }
    state ownerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: targetNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    while ownerNodeID >= 0 && compilerIntTableValue(table: arena.nodes, row: ownerNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerNodeID))
        if memberResolutionRow < 0
            || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
        let memberRow: Int(compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
        if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
        let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
        if (memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState())
            || compilerMemoryMemberRepresentation(tables: arena.tables, memberRow: memberRow) != compilerMemoryMemberRepresentationIdentity() { return 0 - 1 }
        ownerNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
    }
    if ownerNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: ownerNodeID, column: 1) != compilerSyntaxKindIdentifier() { return 0 - 1 }
    let ownerResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerNodeID))
    if ownerResolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    let symbolID: Int(compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind != compilerBodySymbolLet() && symbolKind != compilerBodySymbolState() && symbolKind != compilerBodySymbolReceiver() { return 0 - 1 }
    return symbolID
}

function compilerBodyArenaIdentityPathRootSymbol(arena: CompilerBodyArena, nodeID: Int): Int {
    state ownerNodeID: Int(nodeID)
    while ownerNodeID >= 0 && compilerIntTableValue(table: arena.nodes, row: ownerNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerNodeID))
        if memberResolutionRow < 0
            || compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
        let memberRow: Int(compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
        if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members)
            || compilerMemoryMemberRepresentation(tables: arena.tables, memberRow: memberRow) != compilerMemoryMemberRepresentationIdentity() { return 0 - 1 }
        ownerNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: ownerNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
    }
    if ownerNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: ownerNodeID, column: 1) != compilerSyntaxKindIdentifier() { return 0 - 1 }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerNodeID))
    if resolutionRow < 0
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionLocalSymbol() { return 0 - 1 }
    let symbolID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    return symbolID
}

function compilerBodyArenaSymbolHasMemberWrite(arena: CompilerBodyArena, symbolID: Int): Bool {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return false }
    state factRow: Int(0)
    while factRow < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactKindColumn()) == compilerBodyMemoryFactMemberWrite() {
            let targetNodeID: Int(compilerIntTableValue(table: arena.memoryFacts, row: factRow, column: compilerBodyMemoryFactSourceColumn()))
            if compilerBodyArenaMutableMemberSymbolForTarget(arena: arena, targetNodeID: targetNodeID) == symbolID { return true }
        }
        factRow: factRow + 1
    }
    return false
}

function compilerBodyArenaEnumCaseCount(arena: CompilerBodyArena, enumSyntaxID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: row, column: 2) == enumSyntaxID
            && compilerIntTableValue(table: arena.tables.members, row: row, column: 12) == compilerSyntaxMemberKindEnumCase() { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyArenaResolveEnumPayloadPatternBinding(arena: CompilerBodyArena, enumTypeID: Int, caseMemberRow: Int, argumentNodeID: Int, caseRegionNodeID: Int): Int {
    let bindingNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
    let payloadRow: Int(compilerBodyArenaEnumPayloadRowForArgument(arena: arena, caseMemberRow: caseMemberRow, argumentNodeID: argumentNodeID, allowUnlabeled: true))
    if bindingNodeID < 0 || payloadRow < 0 { return 0 - 1 }
    if compilerIntTableValue(table: arena.nodes, row: bindingNodeID, column: 1) != compilerSyntaxKindIdentifier()
        || compilerIntTableValue(table: arena.nodes, row: bindingNodeID, column: 10) != compilerBodyEnumPatternBindingAux() { return 0 - 1 }
    let payloadTypeID: Int(compilerBodyArenaEnumPayloadTypeID(arena: arena, enumTypeID: enumTypeID, payloadRow: payloadRow))
    let payloadTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: payloadTypeID))
    let storagePolicy: Int(compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 13))
    if payloadTypeID < 0 || payloadTypeKind == compilerBodyTypeUnknown()
        || storagePolicy == compilerSyntaxMemberStorageIndirect() { return 0 - 1 }
    if compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: bindingNodeID, targetKind: compilerBodyResolutionMember(), targetID: payloadRow, typeKind: payloadTypeKind, typeID: payloadTypeID, regionNodeID: caseRegionNodeID) != 0 { return 0 - 1 }
    if compilerBodyArenaAppendSymbol(arena: arena, kind: compilerBodySymbolEnumPayloadBinding(), declarationRef: bindingNodeID, regionNodeID: caseRegionNodeID, nameStart: compilerIntTableValue(table: arena.nodes, row: bindingNodeID, column: 6), nameEnd: compilerIntTableValue(table: arena.nodes, row: bindingNodeID, column: 7), typeStart: compilerIntTableValue(table: arena.nodes, row: bindingNodeID, column: 6), typeEnd: compilerIntTableValue(table: arena.nodes, row: bindingNodeID, column: 7)) < 0 { return 0 - 1 }
    return 0
}

function compilerBodyArenaResolveAppliedEnumCasePattern(arena: CompilerBodyArena, index: CompilerDeclarationIndex, patternNodeID: Int, enumTypeID: Int, parentRegionNodeID: Int, caseRegionNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: patternNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    if calleeNodeID < 0 { return 0 - 1 }
    if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindEnumCaseValue()
        || compilerBodyArenaResolveEnumCaseValue(arena: arena, index: index, nodeID: calleeNodeID, enumTypeID: enumTypeID, regionNodeID: parentRegionNodeID) != 0 { return 0 - 1 }
    let caseResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if caseResolutionRow < 0 { return 0 - 1 }
    let caseMemberRow: Int(compilerIntTableValue(table: arena.resolutions, row: caseResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    let payloadCount: Int(compilerBodyArenaEnumCasePayloadCount(arena: arena, caseMemberRow: caseMemberRow))
    let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: patternNodeID))
    if payloadCount <= 0 || argumentCount != payloadCount { return 0 - 1 }
    state argumentOrdinal: Int(0)
    while argumentOrdinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: patternNodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
        if argumentNodeID < 0
            || compilerBodyArenaResolveEnumPayloadPatternBinding(arena: arena, enumTypeID: enumTypeID, caseMemberRow: caseMemberRow, argumentNodeID: argumentNodeID, caseRegionNodeID: caseRegionNodeID) != 0 { return 0 - 1 }
        argumentOrdinal: argumentOrdinal + 1
    }
    return caseMemberRow
}

function compilerBodyArenaResolveEnumCasePattern(arena: CompilerBodyArena, index: CompilerDeclarationIndex, patternNodeID: Int, enumTypeID: Int, parentRegionNodeID: Int, caseRegionNodeID: Int): Int {
    if patternNodeID < 0 || patternNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let patternKind: Int(compilerIntTableValue(table: arena.nodes, row: patternNodeID, column: 1))
    if patternKind == compilerSyntaxKindApplication() {
        return compilerBodyArenaResolveAppliedEnumCasePattern(arena: arena, index: index, patternNodeID: patternNodeID, enumTypeID: enumTypeID, parentRegionNodeID: parentRegionNodeID, caseRegionNodeID: caseRegionNodeID)
    }
    if patternKind != compilerSyntaxKindEnumCaseValue()
        || compilerBodyArenaResolveEnumCaseValue(arena: arena, index: index, nodeID: patternNodeID, enumTypeID: enumTypeID, regionNodeID: parentRegionNodeID) != 0 { return 0 - 1 }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: patternNodeID))
    if resolutionRow < 0 { return 0 - 1 }
    let caseMemberRow: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if compilerBodyArenaEnumCasePayloadCount(arena: arena, caseMemberRow: caseMemberRow) != 0 { return 0 - 1 }
    return caseMemberRow
}

function compilerBodyArenaRecordFailureNode(arena: CompilerBodyArena, nodeID: Int): Int {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let localStart: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 4))
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: localStart))
    if globalStart < 0 { return 0 - 1 }
    return arena.failures.append(element: globalStart)
}

function compilerBodyArenaResolveExpressionRecordingFailure(arena: CompilerBodyArena, index: CompilerDeclarationIndex, nodeID: Int, regionNodeID: Int): Int {
    if nodeID < 0 { return 0 - 1 }
    let resolutionStatus: Int(compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: nodeID, regionNodeID: regionNodeID))
    if resolutionStatus != 0 {
        compilerBodyArenaRecordFailureNode(arena: arena, nodeID: nodeID)
        arena.failures.append(element: 0 - resolutionStatus)
        return 0 - 1
    }
    return 0
}

function compilerBodyArenaBuildRegionSymbols(arena: CompilerBodyArena, index: CompilerDeclarationIndex, regionNodeID: Int): Int {
    state ordinal: Int(0)
    state keepScanning: Bool(true)
    while keepScanning {
        let statementNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: regionNodeID, role: compilerSyntaxRoleStatement(), ordinal: ordinal))
        if statementNodeID < 0 { keepScanning: false } else {
            let kind: Int(compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 1))
            if kind == compilerSyntaxKindLocalBinding() {
                let initializerNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0))
                if initializerNodeID < 0 { return 0 - 1 }
                if compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: initializerNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                state symbolKind: Int(compilerBodySymbolLet())
                if compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 10) == compilerSyntaxLocalKindState() { symbolKind: compilerBodySymbolState() }
                if compilerBodyArenaAppendSymbol(arena: arena, kind: symbolKind, declarationRef: statementNodeID, regionNodeID: regionNodeID, nameStart: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 6), nameEnd: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 7), typeStart: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 8), typeEnd: compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 9)) < 0 { return 0 - 1 }
            } else if kind == compilerSyntaxKindIf() {
                let conditionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleCondition(), ordinal: 0))
                let thenRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleThenRegion(), ordinal: 0))
                if conditionNodeID < 0 || thenRegionNodeID < 0 || compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: conditionNodeID, regionNodeID: regionNodeID) != 0 || compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: thenRegionNodeID) != 0 { return 0 - 1 }
                let elseRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleElseRegion(), ordinal: 0))
                if elseRegionNodeID >= 0 {
                    if compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: elseRegionNodeID) != 0 { return 0 - 1 }
                }
            } else if kind == compilerSyntaxKindWhile() {
                let whileConditionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleCondition(), ordinal: 0))
                let whileBodyRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleWhileBody(), ordinal: 0))
                if whileConditionNodeID < 0 || whileBodyRegionNodeID < 0
                    || compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: whileConditionNodeID, regionNodeID: regionNodeID) != 0
                    || compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: whileBodyRegionNodeID) != 0 { return 0 - 1 }
            } else if kind == compilerSyntaxKindSwitch() {
                let subjectNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleSwitchSubject(), ordinal: 0))
                if subjectNodeID < 0 { return 0 - 1 }
                if compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: subjectNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                if !compilerBodyArenaSwitchSubjectIsStorage(arena: arena, subjectNodeID: subjectNodeID) { return 0 - 1 }
                let subjectTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: subjectNodeID))
                let subjectTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: subjectNodeID))
                if !compilerBodyArenaSwitchTypeHasMatcher(arena: arena, typeKind: subjectTypeKind, typeID: subjectTypeID) { return 0 - 1 }
                state enumSyntaxID: Int(0 - 1)
                state enumCaseCount: Int(0)
                if subjectTypeKind == compilerBodyTypeEnum() {
                    enumSyntaxID: compilerBodyArenaEnumSyntaxIDForTypeID(arena: arena, typeID: subjectTypeID)
                    enumCaseCount: compilerBodyArenaEnumCaseCount(arena: arena, enumSyntaxID: enumSyntaxID)
                    if enumSyntaxID < 0 || enumCaseCount <= 0 { return 0 - 1 }
                }
                let seenEnumCases: Buffer<Int>(bufferCreateInt(capacity: enumCaseCount))
                state seenInitialization: Int(0)
                while seenInitialization < enumCaseCount {
                    if seenEnumCases.append(element: 0) != 0 {
                        seenEnumCases.destroy()
                        return 0 - 1
                    }
                    seenInitialization: seenInitialization + 1
                }
                state caseOrdinal: Int(0)
                state defaultCount: Int(0)
                state seenEnumCaseCount: Int(0)
                state keepResolvingCases: Bool(true)
                while keepResolvingCases {
                    let caseNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleSwitchCase(), ordinal: caseOrdinal))
                    if caseNodeID < 0 {
                        keepResolvingCases: false
                    } else {
                        let caseRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: caseNodeID, role: compilerSyntaxRoleSwitchBody(), ordinal: 0))
                        if caseRegionNodeID < 0 {
                            seenEnumCases.destroy()
                            return 0 - 1
                        }
                        if compilerIntTableValue(table: arena.nodes, row: caseNodeID, column: 10) == 0 {
                            let patternNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: caseNodeID, role: compilerSyntaxRoleSwitchPattern(), ordinal: 0))
                            if patternNodeID < 0 {
                                seenEnumCases.destroy()
                                return 0 - 1
                            }
                            if subjectTypeKind == compilerBodyTypeEnum() {
                                let enumMemberRow: Int(compilerBodyArenaResolveEnumCasePattern(arena: arena, index: index, patternNodeID: patternNodeID, enumTypeID: subjectTypeID, parentRegionNodeID: regionNodeID, caseRegionNodeID: caseRegionNodeID))
                                if enumMemberRow < 0 || enumMemberRow >= compilerIntTableRowCount(table: arena.tables.members) {
                                    seenEnumCases.destroy()
                                    return 0 - 1
                                }
                                let enumCaseOrdinal: Int(compilerIntTableValue(table: arena.tables.members, row: enumMemberRow, column: 3))
                                if enumCaseOrdinal < 0 || enumCaseOrdinal >= enumCaseCount {
                                    seenEnumCases.destroy()
                                    return 0 - 1
                                }
                                if seenEnumCases.element(index: enumCaseOrdinal) != 0 {
                                    seenEnumCases.destroy()
                                    return 0 - 1
                                }
                                if seenEnumCases.update(element: 1, index: enumCaseOrdinal) != 0 {
                                    seenEnumCases.destroy()
                                    return 0 - 1
                                }
                                seenEnumCaseCount: seenEnumCaseCount + 1
                            } else if compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: patternNodeID, regionNodeID: regionNodeID) != 0 {
                                seenEnumCases.destroy()
                                return 0 - 1
                            }
                            let patternTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: patternNodeID))
                            let patternTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: patternNodeID))
                            if patternTypeKind != subjectTypeKind
                                || ((subjectTypeKind == compilerBodyTypeConstruct() || subjectTypeKind == compilerBodyTypeEnum()) && patternTypeID != subjectTypeID) {
                                seenEnumCases.destroy()
                                return 0 - 1
                            }
                        } else {
                            defaultCount: defaultCount + 1
                        }
                        if compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: caseRegionNodeID) != 0 {
                            seenEnumCases.destroy()
                            return 0 - 1
                        }
                        caseOrdinal: caseOrdinal + 1
                    }
                }
                state switchCasesValid: Bool(caseOrdinal > 0 && defaultCount <= 1)
                if subjectTypeKind == compilerBodyTypeEnum() {
                    if defaultCount == 0 && seenEnumCaseCount != enumCaseCount { switchCasesValid: false }
                } else if defaultCount != 1 {
                    switchCasesValid: false
                }
                if seenEnumCases.destroy() != 0 || !switchCasesValid { return 0 - 1 }
            } else if kind == compilerSyntaxKindAssignment() {
                let targetNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
                let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleAssignedValue(), ordinal: 0))
                if targetNodeID < 0 || valueNodeID < 0
                    || compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: targetNodeID, regionNodeID: regionNodeID) != 0
                    || compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: valueNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                state writableSymbolID: Int(0 - 1)
                let targetKind: Int(compilerIntTableValue(table: arena.nodes, row: targetNodeID, column: 1))
                if targetKind == compilerSyntaxKindIdentifier() {
                    writableSymbolID: compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: targetNodeID)
                } else if targetKind == compilerSyntaxKindIndex() {
                    writableSymbolID: compilerBodyArenaMutableArraySymbolForTarget(arena: arena, targetNodeID: targetNodeID)
                    if writableSymbolID < 0 || !compilerBodyArenaExpressionTypesMatch(arena: arena, leftNodeID: targetNodeID, rightNodeID: valueNodeID) { return 0 - 1 }
                } else if targetKind == compilerSyntaxKindMemberRead() {
                    writableSymbolID: compilerBodyArenaMutableMemberSymbolForTarget(arena: arena, targetNodeID: targetNodeID)
                    if writableSymbolID < 0 || !compilerBodyArenaExpressionTypesMatch(arena: arena, leftNodeID: targetNodeID, rightNodeID: valueNodeID) { return 0 - 1 }
                }
                if targetKind == compilerSyntaxKindIdentifier() {
                    if writableSymbolID < 0 || compilerIntTableValue(table: arena.symbols, row: writableSymbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolState() { return 0 - 1 }
                } else if writableSymbolID < 0 { return 0 - 1 }
            } else if kind == compilerSyntaxKindReturn() {
                let returnNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
                if returnNodeID < 0 || compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: returnNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: compilerBodyArenaExpressionTypeID(arena: arena, nodeID: returnNodeID)) { return 0 - 1 }
            } else if kind == compilerSyntaxKindApplication() {
                if compilerBodyArenaResolveExpressionRecordingFailure(arena: arena, index: index, nodeID: statementNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
            } else { return 0 - 1 }
            ordinal: ordinal + 1
        }
    }
    return 0
}

function compilerBodyArenaBuildSymbolsAndResolutions(arena: CompilerBodyArena, index: CompilerDeclarationIndex): Int {
    if compilerBodyArenaSeedParameterSymbols(arena: arena) != 0 { return 0 - 1 }
    return compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: arena.rootNodeID)
}
