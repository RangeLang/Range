}

function compilerBodyArenaNestedConstructSyntaxID(arena: CompilerBodyArena, parentSyntaxID: Int, memberNodeID: Int): Int {
    let name: String(compilerBodyArenaNodeText(arena: arena, nodeID: memberNodeID))
    state match: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.declarations) {
        if compilerIntTableValue(table: arena.tables.declarations, row: row, column: 2) == compilerSyntaxKindConstruct()
            && compilerIntTableValue(table: arena.tables.declarations, row: row, column: 3) == parentSyntaxID {
            let fileID: Int(compilerIntTableValue(table: arena.tables.declarations, row: row, column: 1))
            let nestedName: String(compilerTypedSyntaxLocalText(
                tables: arena.tables,
                fileID: fileID,
                localStart: compilerIntTableValue(table: arena.tables.declarations, row: row, column: 7),
                localEnd: compilerIntTableValue(table: arena.tables.declarations, row: row, column: 8)
            ))
            if nestedName == name {
                if match >= 0 { return 0 - 2 }
                match: compilerIntTableValue(table: arena.tables.declarations, row: row, column: 0)
            }
        }
        row: row + 1
    }
    return match
}

