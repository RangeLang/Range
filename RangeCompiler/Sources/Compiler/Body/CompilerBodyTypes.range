function compilerBodyArenaSymbolTypeKind(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return compilerBodyTypeUnknown() }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind == compilerBodySymbolReceiver() {
        return compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: compilerBodyArenaReceiverTypeID(arena: arena))
    }
    if symbolKind == compilerBodySymbolEnumPayloadBinding() || symbolKind == compilerBodySymbolClosureParameter() {
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: declarationNodeID))
        if resolutionRow < 0 { return compilerBodyTypeUnknown() }
        return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn())
    }
    if compilerBodyArenaSymbolArrayInitializer(arena: arena, symbolID: symbolID) >= 0 { return compilerBodyTypeConstruct() }
