function compilerReachableTypeKeyArgumentValueColumn(): Int { return 2 }

function compilerReachableTypeKeyArgumentCount(typeKeyArguments: CompilerIntTable, typeKeyID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeKeyArguments) {
        if compilerIntTableValue(table: typeKeyArguments, row: row, column: compilerReachableTypeKeyArgumentOwnerColumn()) == typeKeyID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerReachableTypeKeyArgumentValue(typeKeyArguments: CompilerIntTable, typeKeyID: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeKeyArguments) {
        if compilerIntTableValue(table: typeKeyArguments, row: row, column: compilerReachableTypeKeyArgumentOwnerColumn()) == typeKeyID
            && compilerIntTableValue(table: typeKeyArguments, row: row, column: compilerReachableTypeKeyArgumentOrdinalColumn()) == ordinal {
            return compilerIntTableValue(table: typeKeyArguments, row: row, column: compilerReachableTypeKeyArgumentValueColumn())
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerReachableTypeKeyArgumentsMatch(typeKeyArguments: CompilerIntTable, typeKeyID: Int, argumentCount: Int, argumentIDs: Buffer<Int>): Bool {
    if compilerReachableTypeKeyArgumentCount(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID) != argumentCount { return false }
    state ordinal: Int(0)
    while ordinal < argumentCount {
        if compilerReachableTypeKeyArgumentValue(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID, ordinal: ordinal) != argumentIDs.element(index: ordinal) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerReachableTypeKeyFind(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, typeKind: Int, nominalSyntaxID: Int, argumentCount: Int, argumentIDs: Buffer<Int>): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeKeys) {
        if compilerIntTableValue(table: typeKeys, row: row, column: compilerReachableTypeKeyKindColumn()) == typeKind
            && compilerIntTableValue(table: typeKeys, row: row, column: compilerReachableTypeKeyNominalColumn()) == nominalSyntaxID
            && compilerIntTableValue(table: typeKeys, row: row, column: compilerReachableTypeKeyArgumentCountColumn()) == argumentCount
            && compilerReachableTypeKeyArgumentsMatch(typeKeyArguments: typeKeyArguments, typeKeyID: row, argumentCount: argumentCount, argumentIDs: argumentIDs) { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerReachableTypeKeyFindFromArena(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    let typeKind: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()))
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    let argumentCount: Int(compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID))
    if argumentCount < 0 { return 0 - 1 }
