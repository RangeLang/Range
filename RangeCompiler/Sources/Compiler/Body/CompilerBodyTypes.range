function compilerReachableTypeKeyFingerprint(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, tables: CompilerSyntaxTables, typeKeyID: Int): CompilerFingerprint {
    if typeKeyID < 0 || typeKeyID >= compilerIntTableRowCount(table: typeKeys) { return CompilerFingerprint(first: 0, second: 0) }
    state fingerprint: CompilerFingerprint(compilerFingerprintInitial())
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyKindColumn()))
    let nominalSyntaxID: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyNominalColumn()))
    if nominalSyntaxID >= 0 {
        let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: nominalSyntaxID))
        if declarationRow < 0 { return CompilerFingerprint(first: 0, second: 0) }
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 11))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 12))
    }
    let argumentCount: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyArgumentCountColumn()))
    fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentCount)
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let argumentKeyID: Int(compilerReachableTypeKeyArgumentValue(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID, ordinal: ordinal))
        let argumentFingerprint: CompilerFingerprint(compilerReachableTypeKeyFingerprint(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, tables: tables, typeKeyID: argumentKeyID))
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentFingerprint.first)
        fingerprint: compilerFingerprintAppendInt(fingerprint: fingerprint, value: argumentFingerprint.second)
        ordinal: ordinal + 1
    }
    return fingerprint
}

function compilerReachableTypeKeysAreValid(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, tables: CompilerSyntaxTables): Bool {
    if !compilerIntTableIsComplete(table: typeKeys) || !compilerIntTableIsComplete(table: typeKeyArguments) { return false }
    let keyCount: Int(compilerIntTableRowCount(table: typeKeys))
    state keyID: Int(0)
    while keyID < keyCount {
        let argumentCount: Int(compilerIntTableValue(table: typeKeys, row: keyID, column: compilerReachableTypeKeyArgumentCountColumn()))
        if compilerIntTableValue(table: typeKeys, row: keyID, column: compilerReachableTypeKeyIDColumn()) != keyID
            || argumentCount < 0
            || compilerReachableTypeKeyArgumentCount(typeKeyArguments: typeKeyArguments, typeKeyID: keyID) != argumentCount { return false }
        keyID: keyID + 1
    }
    let argumentRowCount: Int(compilerIntTableRowCount(table: typeKeyArguments))
    state argumentRow: Int(0)
    state priorOwner: Int(0 - 1)
    state priorOrdinal: Int(0 - 1)
    while argumentRow < argumentRowCount {
        let owner: Int(compilerIntTableValue(table: typeKeyArguments, row: argumentRow, column: compilerReachableTypeKeyArgumentOwnerColumn()))
        let ordinal: Int(compilerIntTableValue(table: typeKeyArguments, row: argumentRow, column: compilerReachableTypeKeyArgumentOrdinalColumn()))
        let argument: Int(compilerIntTableValue(table: typeKeyArguments, row: argumentRow, column: compilerReachableTypeKeyArgumentValueColumn()))
        if owner < 0 || owner >= keyCount { return false }
        let expectedCount: Int(compilerIntTableValue(table: typeKeys, row: owner, column: compilerReachableTypeKeyArgumentCountColumn()))
        let firstArgumentRow: Int(compilerIntTableValue(table: typeKeys, row: owner, column: compilerReachableTypeKeyFirstArgumentColumn()))
        if argument < 0 || argument >= owner || ordinal < 0 || ordinal >= expectedCount
            || firstArgumentRow < 0 || firstArgumentRow + ordinal != argumentRow
            || owner < priorOwner || (owner == priorOwner && ordinal != priorOrdinal + 1) { return false }
        priorOwner: owner
        priorOrdinal: ordinal
        argumentRow: argumentRow + 1
    }
    return true
}

function compilerBodyArenaTypeInstanceFindInTables(typeInstances: CompilerIntTable, typeArguments: CompilerIntTable, typeKind: Int, nominalSyntaxID: Int, argumentCount: Int, argumentIDs: Buffer<Int>): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeInstances) {
        if compilerIntTableValue(table: typeInstances, row: row, column: compilerBodyTypeInstanceKindColumn()) == typeKind
            && compilerIntTableValue(table: typeInstances, row: row, column: compilerBodyTypeInstanceNominalSyntaxColumn()) == nominalSyntaxID
            && compilerBodyArenaTypeArgumentCountForTypeIDTables(typeArguments: typeArguments, typeID: row) == argumentCount {
            state ordinal: Int(0)
            state matches: Bool(true)
            while ordinal < argumentCount {
                if compilerBodyArenaTypeArgumentValueForTypeIDTables(typeArguments: typeArguments, typeID: row, ordinal: ordinal) != argumentIDs.element(index: ordinal) { matches: false }
                ordinal: ordinal + 1
            }
            if matches { return row }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeArgumentCountForTypeIDTables(typeArguments: CompilerIntTable, typeID: Int): Int {
    state count: Int(0)
