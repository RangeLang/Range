}

function compilerMacroApplicationArgumentText(tables: CompilerSyntaxTables, applicationRow: Int): String {
    if applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications) { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    let start: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 8))
    let end: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 9))
    if start < 0 || end < start { return String("") }
    let text: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: start, localEnd: end))
    let trimmed: CompilerSourceRange(compilerSemanticTrimStringRange(text: text, start: 0, end: stringLength(value: text)))
    if trimmed.start < 0 { return String("") }
    return text.substring(start: trimmed.start, end: trimmed.end)
}

function compilerStorageApplicationCountForTarget(tables: CompilerSyntaxTables, targetSyntaxID: Int): Int {
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroApplications) {
        if compilerMacroApplicationName(tables: tables, applicationRow: row) == String("storage")
            && compilerIntTableValue(table: tables.macroApplications, row: row, column: 12) == targetSyntaxID {
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function compilerStorageTargetMemberCount(tables: CompilerSyntaxTables, targetSyntaxID: Int): Int {
    state count: Int(0)
