        arena: arena,
        fileID: fileID,
        start: start,
        end: end,
        scopeSyntaxID: 0 - 1
    )
}

function compilerBodyArenaTypeInstanceInternInScope(
    arena: CompilerBodyArena,
    fileID: Int,
    start: Int,
    end: Int,
    scopeSyntaxID: Int
): Int {
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return 0 - 1 }
    let normalizedTypeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: normalizedRange.start, localEnd: normalizedRange.end))
    if compilerBodyArenaTypeOuterName(typeName: normalizedTypeName) == String("Array")
        && compilerBodyArenaTypeArgumentCountForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end) == 1 {
        let canonicalElementRange: CompilerSourceRange(compilerBodyArenaTypeArgumentRangeForSpan(
            arena: arena,
            fileID: fileID,
            start: normalizedRange.start,
            end: normalizedRange.end,
            ordinal: 0
        ))
        if canonicalElementRange.start >= 0 {
            let canonicalElementName: String(compilerTypedSyntaxLocalText(
                tables: arena.tables,
                fileID: fileID,
                localStart: canonicalElementRange.start,
                localEnd: canonicalElementRange.end
            ))
            state canonicalElementTypeID: Int(0 - 1)
            if compilerBodyArenaIsCompileTime(arena: arena)
                && stringLength(value: canonicalElementName) > 1
                && canonicalElementName.substring(start: 0, end: 1) == String("@") {
                let noTypeArguments: Buffer<Int>(bufferCreateInt(capacity: 0))
                canonicalElementTypeID: compilerBodyArenaTypeInstanceInternStructuralAtSpan(
                    arena: arena,
                    typeKind: compilerBodyTypeMacroTarget(),
                    nominalSyntaxID: 0 - 1,
                    fileID: fileID,
                    start: canonicalElementRange.start,
                    end: canonicalElementRange.end,
                    argumentIDs: noTypeArguments
                )
                noTypeArguments.destroy()
            } else {
                canonicalElementTypeID: compilerBodyArenaTypeInstanceInternInScope(
                    arena: arena,
                    fileID: fileID,
                    start: canonicalElementRange.start,
                    end: canonicalElementRange.end,
                    scopeSyntaxID: scopeSyntaxID
                )
            }
            if canonicalElementTypeID < 0 { return 0 - 1 }
            let canonicalArrayArguments: Buffer<Int>(bufferCreateInt(capacity: 1))
            if canonicalArrayArguments.append(element: canonicalElementTypeID) != 0 {
                canonicalArrayArguments.destroy()
                return 0 - 1
            }
            let canonicalArrayTypeID: Int(compilerBodyArenaTypeInstanceInternStructuralAtSpan(
                arena: arena,
                typeKind: compilerBodyTypeConstruct(),
                nominalSyntaxID: compilerBodyArenaArrayDeclarationSyntaxID(arena: arena),
                fileID: fileID,
                start: normalizedRange.start,
                end: normalizedRange.end,
                argumentIDs: canonicalArrayArguments
            ))
            canonicalArrayArguments.destroy()
            return canonicalArrayTypeID
        }
    }
    let outerRange: CompilerSourceRange(compilerBodyArenaTypeOuterRangeForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end))
    state scopedOuterSyntaxID: Int(0 - 1)
    if outerRange.start >= 0 && scopeSyntaxID >= 0 {
        scopedOuterSyntaxID: compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
            tables: arena.tables,
            typeName: compilerTypedSyntaxLocalText(
                tables: arena.tables,
                fileID: fileID,
                localStart: outerRange.start,
                localEnd: outerRange.end
            ),
            scopeSyntaxID: scopeSyntaxID
        )
    }
    state typeKind: Int(compilerBodyArenaTypeKindForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end))
    if typeKind == compilerBodyTypeUnknown()
        && scopedOuterSyntaxID >= 0
        && scopedOuterSyntaxID < compilerIntTableRowCount(table: arena.tables.syntaxIndex) {
        let scopedKind: Int(compilerIntTableValue(table: arena.tables.syntaxIndex, row: scopedOuterSyntaxID, column: 0))
        if scopedKind == compilerSyntaxKindConstruct() { typeKind: compilerBodyTypeConstruct() }
        if scopedKind == compilerSyntaxKindEnum() { typeKind: compilerBodyTypeEnum() }
    }
    if typeKind == compilerBodyTypeUnknown() { return 0 - 1 }
    state nominalSyntaxID: Int(0 - 1)
    state expectedArgumentCount: Int(0)
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    let isOptional: Bool(compilerBodyArenaTypeOuterName(typeName: normalizedTypeName) == String("Optional"))
    if typeKind == compilerBodyTypeConstruct() {
        if outerRange.start < 0 { return 0 - 1 }
        state declarationSyntaxID: Int(compilerDeclarationIndexLocalRangeSyntaxID(tables: arena.tables, index: arena.declarationIndex, fileID: fileID, start: outerRange.start, end: outerRange.end, kindTag: compilerSyntaxKindConstruct()))
        if declarationSyntaxID < 0
            && scopedOuterSyntaxID >= 0
            && scopedOuterSyntaxID < compilerIntTableRowCount(table: arena.tables.syntaxIndex)
            && compilerIntTableValue(table: arena.tables.syntaxIndex, row: scopedOuterSyntaxID, column: 0) == compilerSyntaxKindConstruct() {
            declarationSyntaxID: scopedOuterSyntaxID
        }
        if declarationSyntaxID < 0 {
            declarationSyntaxID: compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
                tables: arena.tables,
                typeName: compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: outerRange.start, localEnd: outerRange.end),
                scopeSyntaxID: scopeSyntaxID
            )
            if declarationSyntaxID >= 0
                && (declarationSyntaxID >= compilerIntTableRowCount(table: arena.tables.syntaxIndex)
                    || compilerIntTableValue(table: arena.tables.syntaxIndex, row: declarationSyntaxID, column: 0) != compilerSyntaxKindConstruct()) {
                declarationSyntaxID: 0 - 1
            }
        }
        if isOptional {
            expectedArgumentCount: 1
            let typeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: normalizedRange.start, localEnd: normalizedRange.end))
            let payloadName: String(compilerOptionalPayloadTypeName(typeName: typeName))
            let payloadDeclarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: payloadName, kindTag: compilerSyntaxKindConstruct()))
            if payloadDeclarationRow >= 0 && compilerNominalLLVMTypeName(tables: arena.tables, declarationRow: payloadDeclarationRow) != String("") {
                nominalSyntaxID: compilerIntTableValue(table: arena.tables.declarations, row: payloadDeclarationRow, column: 0)
            }
        } else {
            if declarationSyntaxID < 0 { return 0 - 1 }
            nominalSyntaxID: declarationSyntaxID
            expectedArgumentCount: compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: declarationSyntaxID)
        }
    } else if typeKind == compilerBodyTypeEnum() {
        if outerRange.start < 0 { return 0 - 1 }
        if isOptional && genericStartGlobal < 0 {
            let optionalDeclarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: String("Optional"), kindTag: compilerSyntaxKindEnum()))
            if optionalDeclarationRow >= 0 {
                nominalSyntaxID: compilerIntTableValue(table: arena.tables.declarations, row: optionalDeclarationRow, column: 0)
            }
        } else {
            nominalSyntaxID: compilerDeclarationIndexLocalRangeSyntaxID(tables: arena.tables, index: arena.declarationIndex, fileID: fileID, start: outerRange.start, end: outerRange.end, kindTag: compilerSyntaxKindEnum())
            if nominalSyntaxID < 0
                && scopedOuterSyntaxID >= 0
                && scopedOuterSyntaxID < compilerIntTableRowCount(table: arena.tables.syntaxIndex)
                && compilerIntTableValue(table: arena.tables.syntaxIndex, row: scopedOuterSyntaxID, column: 0) == compilerSyntaxKindEnum() {
                nominalSyntaxID: scopedOuterSyntaxID
            }
            if nominalSyntaxID < 0 {
                nominalSyntaxID: compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
                    tables: arena.tables,
                    typeName: compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: outerRange.start, localEnd: outerRange.end),
                    scopeSyntaxID: scopeSyntaxID
                )
                if nominalSyntaxID >= 0
                    && (nominalSyntaxID >= compilerIntTableRowCount(table: arena.tables.syntaxIndex)
                        || compilerIntTableValue(table: arena.tables.syntaxIndex, row: nominalSyntaxID, column: 0) != compilerSyntaxKindEnum()) {
                    nominalSyntaxID: 0 - 1
                }
            }
        }
        if nominalSyntaxID < 0 { return 0 - 1 }
        expectedArgumentCount: compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: nominalSyntaxID)
    } else if typeKind == compilerBodyTypeUnsigned8() || (typeKind == compilerBodyTypeInt() && compilerIntegerTypeIsSigned(typeName: normalizedTypeName)) {
        expectedArgumentCount: 2
    } else if typeKind == compilerBodyTypeFloat32() || compilerFloatTypeIs64(typeName: normalizedTypeName) {
        expectedArgumentCount: 1
    } else if genericStartGlobal >= 0 {
        return 0 - 1
    }
    let actualArgumentCount: Int(compilerBodyArenaTypeArgumentCountForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end))
    if actualArgumentCount < 0 || actualArgumentCount > expectedArgumentCount { return 0 - 1 }
    state requiredArgumentCount: Int(expectedArgumentCount)
    if nominalSyntaxID >= 0 {
        requiredArgumentCount: compilerSyntaxGenericParameterRequiredCountForOwner(tables: arena.tables, ownerSyntaxID: nominalSyntaxID)
    }
    if actualArgumentCount < requiredArgumentCount { return 0 - 1 }
    let argumentIDs: Buffer<Int>(bufferCreateInt(capacity: actualArgumentCount + 1))
    state argumentOrdinal: Int(0)
    if typeKind == compilerBodyTypeUnsigned8()
        || (typeKind == compilerBodyTypeInt() && compilerIntegerTypeIsSigned(typeName: normalizedTypeName))
        || typeKind == compilerBodyTypeFloat32()
        || compilerFloatTypeIs64(typeName: normalizedTypeName) { argumentOrdinal: actualArgumentCount }
    while argumentOrdinal < actualArgumentCount {
        let argumentRange: CompilerSourceRange(compilerBodyArenaTypeArgumentRangeForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, ordinal: argumentOrdinal))
        let argumentTypeID: Int(compilerBodyArenaTypeInstanceInternInScope(
            arena: arena,
            fileID: fileID,
            start: argumentRange.start,
            end: argumentRange.end,
            scopeSyntaxID: scopeSyntaxID
        ))
        if argumentRange.start < 0 || argumentTypeID < 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        if argumentIDs.append(element: argumentTypeID) != 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        argumentOrdinal: argumentOrdinal + 1
    }
    if !(isOptional && typeKind == compilerBodyTypeConstruct())
        && compilerBodyArenaAppendDefaultTypeArguments(arena: arena, nominalSyntaxID: nominalSyntaxID, argumentIDs: argumentIDs) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    let internedArgumentCount: Int(argumentIDs.count)
    let existing: Int(compilerBodyArenaTypeInstanceFind(arena: arena, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: internedArgumentCount, argumentIDs: argumentIDs))
    if existing >= 0 {
        argumentIDs.destroy()
        return existing
    }
    let typeID: Int(compilerIntTableRowCount(table: arena.typeInstances))
    if compilerIntTableAppend(table: arena.typeInstances, value: typeID) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: arena.typeInstances, value: fileID) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: arena.typeInstances, value: normalizedRange.start) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: arena.typeInstances, value: normalizedRange.end) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: arena.typeInstances, value: typeKind) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: arena.typeInstances, value: nominalSyntaxID) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerBodyArenaAppendTypeArguments(arena: arena, typeID: typeID, argumentIDs: argumentIDs) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    argumentIDs.destroy()
    return typeID
}

function compilerReachableTypeKeyColumnCount(): Int { return 8 }
