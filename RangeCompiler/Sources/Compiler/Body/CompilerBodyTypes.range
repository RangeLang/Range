    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: compilerIntTableValue(table: arena.nodes, row: nodeID, column: 6), localEnd: compilerIntTableValue(table: arena.nodes, row: nodeID, column: 7))
}

function compilerBodyArenaExpressionTypeKind(arena: CompilerBodyArena, nodeID: Int): Int {
    let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if kind == compilerSyntaxKindIntegerLiteral() { return compilerBodyTypeInt() }
    if kind == compilerSyntaxKindDoubleLiteral() { return compilerBodyTypeFloat() }
    if kind == compilerSyntaxKindStringLiteral() || kind == compilerSyntaxKindStringSegment() || kind == compilerSyntaxKindInterpolatedString() { return compilerBodyTypeString() }
    if kind == compilerSyntaxKindBoolLiteral() { return compilerBodyTypeBool() }
    if kind == compilerSyntaxKindGrouping() {
        let groupedNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        if groupedNodeID < 0 { return compilerBodyTypeUnknown() }
        return compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: groupedNodeID)
    }
    if kind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        let callResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
        if callResolutionRow < 0 { return compilerBodyTypeUnknown() }
        return compilerIntTableValue(table: arena.resolutions, row: callResolutionRow, column: compilerBodyResolutionTypeKindColumn())
    }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: nodeID))
    if resolutionRow < 0 { return compilerBodyTypeUnknown() }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn())
}

function compilerBodyArenaExpressionTypeID(arena: CompilerBodyArena, nodeID: Int): Int {
    let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if kind == compilerSyntaxKindGrouping() {
        let groupedNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleGroupedValue(), ordinal: 0))
        if groupedNodeID < 0 { return 0 - 1 }
        return compilerBodyArenaExpressionTypeID(arena: arena, nodeID: groupedNodeID)
    }
    if kind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        let callResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
        if callResolutionRow < 0 { return 0 - 1 }
        return compilerIntTableValue(table: arena.resolutions, row: callResolutionRow, column: compilerBodyResolutionTypeIDColumn())
    }
    let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: nodeID))
    if resolutionRow < 0 { return 0 - 1 }
    return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())
}

function compilerBodyArenaExpectedApplicationArgumentTypeID(arena: CompilerBodyArena, applicationNodeID: Int, argumentNodeID: Int): Int {
    if applicationNodeID < 0 || applicationNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || argumentNodeID < 0 || argumentNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    let calleeResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if calleeNodeID < 0 || calleeResolutionRow < 0 { return 0 - 1 }
    let targetKind: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTargetKindColumn()))
    let targetID: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    if targetKind == compilerBodyResolutionEnum() {
        return compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTypeIDColumn())
    }
    if targetKind == compilerBodyResolutionEnumCase() {
        let enumTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTypeIDColumn()))
        let payloadRow: Int(
            compilerBodyArenaEnumPayloadRowForArgument(
                arena: arena,
                caseMemberRow: targetID,
                argumentNodeID: argumentNodeID,
                allowUnlabeled: false
            )
        )
        if enumTypeID < 0 || payloadRow < 0 { return 0 - 1 }
        return compilerBodyArenaEnumPayloadTypeID(
            arena: arena,
            enumTypeID: enumTypeID,
            payloadRow: payloadRow
        )
    }
    if targetKind == compilerBodyResolutionConstruct() {
        let memberRow: Int(compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: targetID, argumentNodeID: argumentNodeID))
        let receiverTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: calleeResolutionRow, column: compilerBodyResolutionTypeIDColumn()))
        if memberRow < 0 || receiverTypeID < 0 { return 0 - 1 }
        return compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: receiverTypeID, memberRow: memberRow)
    }
    if targetKind == compilerBodyResolutionFunction() {
        if targetID < 0 || targetID >= compilerIntTableRowCount(table: arena.tables.functions) { return 0 - 1 }
        let parameterOrdinal: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 3))
        let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: targetID, column: 2))
        let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: targetID, column: 3))
        let parameterRow: Int(firstParameterRow + parameterOrdinal)
        if parameterOrdinal < 0 || parameterOrdinal >= parameterCount
            || parameterRow < 0 || parameterRow >= compilerIntTableRowCount(table: arena.tables.parameters) { return 0 - 1 }
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterStart: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 8))
        let parameterEnd: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 9))
        if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindMemberRead() {
            let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
            let receiverTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: receiverNodeID))
            let ownerSyntaxID: Int(compilerBodyArenaFunctionOwnerSyntaxID(arena: arena, functionID: targetID))
            if receiverNodeID < 0 || receiverTypeID < 0 || ownerSyntaxID < 0 { return 0 - 1 }
            return compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: parameterFileID, start: parameterStart, end: parameterEnd)
        }
        return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: parameterFileID, start: parameterStart, end: parameterEnd)
    }
    return 0 - 1
}

function compilerBodyArenaTypeIDForSpanInCurrentScope(
    arena: CompilerBodyArena,
    fileID: Int,
    start: Int,
    end: Int
): Int {
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    if ownerSyntaxID >= 0 {
        return compilerBodyArenaSpecializedTypeIDForSpan(
            arena: arena,
            receiverTypeID: compilerBodyArenaReceiverTypeID(arena: arena),
            ownerSyntaxID: ownerSyntaxID,
            fileID: fileID,
            start: start,
            end: end
        )
    }
    return compilerBodyArenaTypeIDForSpan(
        arena: arena,
        fileID: fileID,
        start: start,
        end: end
    )
}

function compilerBodyArenaExpectedTypeIDForExpression(arena: CompilerBodyArena, expressionNodeID: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == expressionNodeID {
            let declarationNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0))
            let role: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2))
            if role == compilerSyntaxRoleInitializer() && declarationNodeID >= 0
                && declarationNodeID < compilerIntTableRowCount(table: arena.nodes)
                && compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 1) == compilerSyntaxKindLocalBinding() {
                let typeStart: Int(compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 8))
                let typeEnd: Int(compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 9))
                if typeStart >= 0 && typeEnd > typeStart {
                    return compilerBodyArenaTypeIDForSpanInCurrentScope(
                        arena: arena,
                        fileID: arena.fileID,
                        start: typeStart,
                        end: typeEnd
                    )
                }
            }
            if role == compilerSyntaxRoleArrayElement() {
                let arrayResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: declarationNodeID))
                if arrayResolutionRow >= 0 {
                    let arrayTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: arrayResolutionRow, column: compilerBodyResolutionTypeIDColumn()))
                    if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: arrayTypeID) {
                        return compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: arrayTypeID, ordinal: 0)
                    }
                }
            }
            if role == compilerSyntaxRoleAssignedValue() {
                let targetNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
                let targetResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: targetNodeID))
                if targetNodeID >= 0 && targetResolutionRow >= 0 {
                    return compilerIntTableValue(table: arena.resolutions, row: targetResolutionRow, column: compilerBodyResolutionTypeIDColumn())
                }
            }
            if role == compilerSyntaxRoleReturnValue() && arena.ownerFunctionRow >= 0 {
                let returnFileID: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 1))
                let returnStart: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 6))
                let returnEnd: Int(compilerIntTableValue(table: arena.tables.functions, row: arena.ownerFunctionRow, column: 7))
                return compilerBodyArenaTypeIDForSpanInCurrentScope(
                    arena: arena,
                    fileID: returnFileID,
                    start: returnStart,
                    end: returnEnd
                )
            }
            if role == compilerSyntaxRoleArgumentValue() {
                state argumentOwnerNodeID: Int(0 - 1)
                state argumentEdgeRow: Int(0)
                while argumentEdgeRow < compilerIntTableRowCount(table: arena.edges) {
                    if compilerIntTableValue(table: arena.edges, row: argumentEdgeRow, column: 1) == declarationNodeID
                        && compilerIntTableValue(table: arena.edges, row: argumentEdgeRow, column: 2) == compilerSyntaxRoleArgument() {
                        argumentOwnerNodeID: compilerIntTableValue(table: arena.edges, row: argumentEdgeRow, column: 0)
                    }
                    argumentEdgeRow: argumentEdgeRow + 1
                }
                if argumentOwnerNodeID >= 0 {
                    let expectedArgumentTypeID: Int(compilerBodyArenaExpectedApplicationArgumentTypeID(arena: arena, applicationNodeID: argumentOwnerNodeID, argumentNodeID: declarationNodeID))
                    if expectedArgumentTypeID >= 0 { return expectedArgumentTypeID }
                    let ownerCalleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentOwnerNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
                    let ownerResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: ownerCalleeNodeID))
                    if ownerResolutionRow >= 0
                        && compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionEnum() {
                        return compilerIntTableValue(table: arena.resolutions, row: ownerResolutionRow, column: compilerBodyResolutionTypeIDColumn())
                    }
                }
            }
        }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaRegionContainsNode(arena: CompilerBodyArena, regionNodeID: Int, nodeID: Int): Bool {
    let regionStart: Int(compilerIntTableValue(table: arena.nodes, row: regionNodeID, column: 4))
    let regionEnd: Int(compilerIntTableValue(table: arena.nodes, row: regionNodeID, column: 5))
    let nodeStart: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 4))
    return nodeStart >= regionStart && nodeStart < regionEnd
}

function compilerBodyArenaLexicalParentRegion(arena: CompilerBodyArena, regionNodeID: Int): Int {
    if regionNodeID < 0 || regionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: regionNodeID, column: 1) != compilerSyntaxKindLexicalRegion() { return 0 - 2 }
    if regionNodeID == arena.rootNodeID { return 0 - 1 }
    if arena.parentNodes.count != compilerIntTableRowCount(table: arena.nodes)
        || arena.parentRoles.count != compilerIntTableRowCount(table: arena.nodes) { return 0 - 2 }
    state ownerStatementNodeID: Int(arena.parentNodes.element(index: regionNodeID))
    let ownerRole: Int(arena.parentRoles.element(index: regionNodeID))
    if ownerRole == compilerSyntaxRoleClosureBody() {
        state currentNodeID: Int(ownerStatementNodeID)
        state step: Int(0)
        let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
        while step < maximumSteps {
            if currentNodeID < 0 || currentNodeID >= arena.parentNodes.count { return 0 - 2 }
            if arena.parentRoles.element(index: currentNodeID) == compilerSyntaxRoleStatement() {
                if arena.parentNodes.element(index: currentNodeID) < 0
                    || arena.parentNodes.element(index: currentNodeID) >= compilerIntTableRowCount(table: arena.nodes)
                    || compilerIntTableValue(table: arena.nodes, row: arena.parentNodes.element(index: currentNodeID), column: 1) != compilerSyntaxKindLexicalRegion() { return 0 - 2 }
                return arena.parentNodes.element(index: currentNodeID)
            } else {
                currentNodeID: arena.parentNodes.element(index: currentNodeID)
            }
            step: step + 1
        }
        return 0 - 2
    }
    if ownerRole == compilerSyntaxRoleSwitchBody() {
        let caseNodeID: Int(ownerStatementNodeID)
        if caseNodeID < 0 || caseNodeID >= arena.parentNodes.count
            || arena.parentRoles.element(index: caseNodeID) != compilerSyntaxRoleSwitchCase() { return 0 - 2 }
        ownerStatementNodeID: arena.parentNodes.element(index: caseNodeID)
    } else if ownerRole != compilerSyntaxRoleThenRegion() && ownerRole != compilerSyntaxRoleElseRegion() && ownerRole != compilerSyntaxRoleWhileBody() {
        return 0 - 2
    }
    if ownerStatementNodeID < 0 || ownerStatementNodeID >= arena.parentNodes.count
        || arena.parentRoles.element(index: ownerStatementNodeID) != compilerSyntaxRoleStatement() { return 0 - 2 }
    let parentRegionNodeID: Int(arena.parentNodes.element(index: ownerStatementNodeID))
    if parentRegionNodeID < 0 || parentRegionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: parentRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion() { return 0 - 2 }
    return parentRegionNodeID
}

function compilerBodyArenaLexicalRegionContainsRegion(arena: CompilerBodyArena, ancestorRegionNodeID: Int, candidateRegionNodeID: Int): Bool {
    if ancestorRegionNodeID < 0 || ancestorRegionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || candidateRegionNodeID < 0 || candidateRegionNodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: ancestorRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion()
        || compilerIntTableValue(table: arena.nodes, row: candidateRegionNodeID, column: 1) != compilerSyntaxKindLexicalRegion() { return false }
    state currentRegionNodeID: Int(candidateRegionNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        if currentRegionNodeID == ancestorRegionNodeID { return true }
        let parentRegionNodeID: Int(compilerBodyArenaLexicalParentRegion(arena: arena, regionNodeID: currentRegionNodeID))
        if parentRegionNodeID == 0 - 1 { return false }
        if parentRegionNodeID < 0 || parentRegionNodeID == currentRegionNodeID { return false }
        currentRegionNodeID: parentRegionNodeID
        step: step + 1
    }
    return false
}

function compilerBodyArenaSymbolName(arena: CompilerBodyArena, symbolID: Int): String {
    if symbolID >= 0 && symbolID < compilerIntTableRowCount(table: arena.symbols)
        && compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolReceiver() { return String("self") }
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameStartColumn()), localEnd: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameEndColumn()))
}

function compilerBodyArenaSymbolForIdentifier(arena: CompilerBodyArena, identifierNodeID: Int): Int {
    let name: String(compilerBodyArenaNodeText(arena: arena, nodeID: identifierNodeID))
    state symbolRow: Int(compilerIntTableRowCount(table: arena.symbols) - 1)
    while symbolRow >= 0 {
        let regionNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolRow, column: compilerBodySymbolRegionColumn()))
        if compilerBodyArenaRegionContainsNode(arena: arena, regionNodeID: regionNodeID, nodeID: identifierNodeID) {
            let candidate: String(compilerBodyArenaSymbolName(arena: arena, symbolID: symbolRow))
            if candidate == name { return symbolRow }
        }
        symbolRow: symbolRow - 1
    }
    return 0 - 1
}

function compilerBodyArenaNodeIsReturnValue(arena: CompilerBodyArena, nodeID: Int): Bool {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == nodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleReturnValue() { return true }
        edgeRow: edgeRow + 1
    }
    return false
}

function compilerBodyArenaAppendNilResolution(arena: CompilerBodyArena, nodeID: Int, typeKind: Int, typeID: Int, regionNodeID: Int): Int {
    if typeID < 0 || typeKind != compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: typeID)
        || !compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: typeID) { return 0 - 1 }
    return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionBuiltin(), targetID: compilerBodyBuiltinNil(), typeKind: typeKind, typeID: typeID, regionNodeID: regionNodeID)
}

function compilerBodyArenaApplicationArgumentCount(arena: CompilerBodyArena, applicationNodeID: Int): Int {
    state count: Int(0)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0) == applicationNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleArgument() { count: count + 1 }
        edgeRow: edgeRow + 1
    }
    return count
}

function compilerBodyArenaCallLabelsMatchFunction(arena: CompilerBodyArena, applicationNodeID: Int, functionID: Int): Bool {
    let parameterCount: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 3))
    if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != parameterCount { return false }
    let firstParameterRow: Int(compilerIntTableValue(table: arena.tables.functions, row: functionID, column: 2))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if argumentNodeID < 0 { return false }
        let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
        let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
        if labelStart < 0 || labelEnd < labelStart { return false }
        let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
        let parameterRow: Int(firstParameterRow + ordinal)
        let parameterFileID: Int(compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 1))
        let parameterName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: parameterFileID, localStart: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 6), localEnd: compilerIntTableValue(table: arena.tables.parameters, row: parameterRow, column: 7)))
        if label != parameterName { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaCallLabelsMatchMemberRuntimeBuiltin(arena: CompilerBodyArena, applicationNodeID: Int, builtinID: Int): Bool {
    let argumentCount: Int(compilerBodyMemberRuntimeBuiltinArgumentCount(id: builtinID))
    if argumentCount < 0 || compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != argumentCount { return false }
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        if argumentNodeID < 0 { return false }
        let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
        let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
        if labelStart < 0 || labelEnd <= labelStart { return false }
        let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
        if label != compilerBodyMemberRuntimeBuiltinArgumentLabel(id: builtinID, ordinal: ordinal) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaMacroSelectorDeclarationRow(arena: CompilerBodyArena, name: String): Int {
    state match: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.macroDeclarations) {
        let fileID: Int(compilerIntTableValue(table: arena.tables.macroDeclarations, row: row, column: 1))
        let candidate: String(compilerTypedSyntaxLocalText(
            tables: arena.tables,
            fileID: fileID,
            localStart: compilerIntTableValue(table: arena.tables.macroDeclarations, row: row, column: 4),
            localEnd: compilerIntTableValue(table: arena.tables.macroDeclarations, row: row, column: 5)
        ))
        if candidate == name {
            if match >= 0 { return 0 - 1 }
            match: row
        }
        row: row + 1
    }
    return match
}

function compilerBodyArenaMacroSyntaxFilterKind(arena: CompilerBodyArena, index: CompilerDeclarationIndex, applicationNodeID: Int, calleeNodeID: Int): Int {
    if compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID) != String("filter")
        || compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != 1 { return 0 - 1 }
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
    if argumentNodeID < 0 { return 0 - 1 }
    let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
    let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
    let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
    if valueNodeID < 0 || labelStart < 0 || labelEnd <= labelStart
        || compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd) != String("all")
        || compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) != compilerSyntaxKindIdentifier() { return 0 - 1 }
    let nominalName: String(compilerBodyArenaNodeText(arena: arena, nodeID: valueNodeID))
    if stringLength(value: nominalName) > 1 && nominalName.substring(start: 0, end: 1) == String("@") {
        let macroDeclarationRow: Int(compilerBodyArenaMacroSelectorDeclarationRow(
            arena: arena,
            name: nominalName.substring(start: 1, end: stringLength(value: nominalName))
        ))
        if macroDeclarationRow >= 0 {
            return compilerBodyMacroSyntaxFilterFamilyBase() + macroDeclarationRow
        }
        return 0 - 1
    }
    if compilerDeclarationIndexLookup(tables: arena.tables, index: index, name: nominalName, kindTag: compilerSyntaxKindConstruct()) >= 0 {
        if nominalName == String("Let") { return compilerSyntaxMemberKindLet() }
        if nominalName == String("State") { return compilerSyntaxMemberKindState() }
        if nominalName == String("Binding") { return compilerSyntaxMemberKindBinding() }
        if nominalName == String("Derived") { return compilerSyntaxMemberKindDerived() }
    }
    return 0 - 1
}

function compilerBodyArenaMacroSyntaxFilterResultTypeID(arena: CompilerBodyArena, index: CompilerDeclarationIndex, applicationNodeID: Int, calleeNodeID: Int): Int {
    let selector: Int(compilerBodyArenaMacroSyntaxFilterKind(arena: arena, index: index, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID))
    if selector < 0 { return 0 - 1 }
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
    let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
    if valueNodeID < 0 { return 0 - 1 }
    let noArguments: Buffer<Int>(bufferCreateInt(capacity: 0))
    state elementTypeKind: Int(compilerBodyTypeMacroTarget())
    state elementNominalSyntaxID: Int(0 - 1)
    if selector < compilerBodyMacroSyntaxFilterFamilyBase() {
        let declarationRow: Int(compilerDeclarationIndexLookup(
            tables: arena.tables,
            index: index,
            name: compilerBodyArenaNodeText(arena: arena, nodeID: valueNodeID),
            kindTag: compilerSyntaxKindConstruct()
        ))
        if declarationRow < 0 {
            noArguments.destroy()
            return 0 - 1
        }
        elementTypeKind: compilerBodyTypeConstruct()
        elementNominalSyntaxID: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0)
    }
    let elementTypeID: Int(compilerBodyArenaTypeInstanceInternStructuralAtSpan(
        arena: arena,
        typeKind: elementTypeKind,
        nominalSyntaxID: elementNominalSyntaxID,
        fileID: arena.fileID,
        start: compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 6),
        end: compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 7),
        argumentIDs: noArguments
    ))
    noArguments.destroy()
    if elementTypeID < 0 { return 0 - 1 }
    return compilerBodyArenaArrayTypeID(arena: arena, sourceNodeID: applicationNodeID, elementTypeID: elementTypeID)
}

function compilerBodyArenaCollectionTransformKind(arena: CompilerBodyArena, applicationNodeID: Int, calleeNodeID: Int): Int {
    if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != 0 { return 0 - 1 }
    let closureNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleTrailingClosure(), ordinal: 0))
    if closureNodeID < 0
        || compilerIntTableValue(table: arena.nodes, row: closureNodeID, column: 1) != compilerSyntaxKindClosure()
        || compilerBodyArenaChild(arena: arena, ownerNodeID: closureNodeID, role: compilerSyntaxRoleClosureParameter(), ordinal: 0) < 0
        || compilerBodyArenaChild(arena: arena, ownerNodeID: closureNodeID, role: compilerSyntaxRoleClosureParameter(), ordinal: 1) >= 0 { return 0 - 1 }
    let name: String(compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID))
    if name == String("filter") { return compilerBodyCollectionTransformFilter() }
    if name == String("map") { return compilerBodyCollectionTransformMap() }
    return 0 - 1
}

function compilerBodyArenaEnclosingClosure(arena: CompilerBodyArena, nodeID: Int): Int {
    if nodeID < 0 || nodeID >= arena.parentNodes.count { return 0 - 1 }
    state currentNodeID: Int(nodeID)
    state step: Int(0)
    let maximumSteps: Int(arena.parentNodes.count + 1)
    while step < maximumSteps {
        let parentNodeID: Int(arena.parentNodes.element(index: currentNodeID))
        if parentNodeID < 0 || parentNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
        if compilerIntTableValue(table: arena.nodes, row: parentNodeID, column: 1) == compilerSyntaxKindClosure() { return parentNodeID }
        currentNodeID: parentNodeID
        step: step + 1
    }
    return 0 - 1
}

function compilerBodyArenaSeedClosureParameterMemberResolutions(
    arena: CompilerBodyArena,
    index: CompilerDeclarationIndex,
    closureNodeID: Int,
    parameterNodeID: Int,
    parameterSymbolID: Int,
    elementTypeID: Int,
    queriedElementSyntaxID: Int,
    bodyRegionNodeID: Int
): Int {
    if elementTypeID < 0 || elementTypeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 201 }
    state elementSyntaxID: Int(queriedElementSyntaxID)
    if elementSyntaxID < 0 {
        elementSyntaxID: compilerIntTableValue(table: arena.typeInstances, row: elementTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn())
    }
    if elementSyntaxID < 0 {
        let elementName: String(compilerBodyArenaTypeOuterName(typeName: compilerBodyArenaTypeNameForTypeID(arena: arena, typeID: elementTypeID)))
        let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: index, name: elementName, kindTag: compilerSyntaxKindConstruct()))
        if declarationRow >= 0 { elementSyntaxID: compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0) }
    }
    if elementSyntaxID < 0 { return 0 - 202 }
    let parameterName: String(compilerBodyArenaNodeText(arena: arena, nodeID: parameterNodeID))
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1) == compilerSyntaxKindMemberRead()
            && compilerBodyArenaRegionContainsNode(arena: arena, regionNodeID: bodyRegionNodeID, nodeID: nodeRow) {
            let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleReceiver(), ordinal: 0))
            if receiverNodeID >= 0
                && compilerIntTableValue(table: arena.nodes, row: receiverNodeID, column: 1) == compilerSyntaxKindIdentifier()
                && compilerBodyArenaNodeText(arena: arena, nodeID: receiverNodeID) == parameterName {
                if compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: receiverNodeID) < 0
                    && compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: receiverNodeID, targetKind: compilerBodyResolutionLocalSymbol(), targetID: parameterSymbolID, typeKind: compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: elementTypeID), typeID: elementTypeID, regionNodeID: bodyRegionNodeID) != 0 { return 0 - 203 }
                let memberRow: Int(compilerDeclarationIndexMemberLookup(
                    tables: arena.tables,
                    index: index,
                    parentSyntaxID: elementSyntaxID,
                    name: compilerBodyArenaNodeText(arena: arena, nodeID: nodeRow)
                ))
                let memberTypeID: Int(compilerBodyArenaTypeIDForMemberRow(arena: arena, receiverTypeID: elementTypeID, memberRow: memberRow))
                let memberTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: memberTypeID))
                if memberRow < 0 { return 0 - 204 }
                if memberTypeID < 0 || memberTypeKind == compilerBodyTypeUnknown() { return 0 - 205 }
                if compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeRow, targetKind: compilerBodyResolutionMember(), targetID: memberRow, typeKind: memberTypeKind, typeID: memberTypeID, regionNodeID: bodyRegionNodeID) != 0 { return 0 - 206 }
            }
        }
        nodeRow: nodeRow + 1
    }
    return 0
}

function compilerBodyArenaQueriedCollectionElementSyntaxID(arena: CompilerBodyArena, index: CompilerDeclarationIndex, receiverNodeID: Int): Int {
    if receiverNodeID < 0 || receiverNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    state sourceNodeID: Int(receiverNodeID)
    state step: Int(0)
    let maximumSteps: Int(compilerIntTableRowCount(table: arena.nodes) + 1)
    while step < maximumSteps {
        if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
        let sourceKind: Int(compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 1))
        if sourceKind == compilerSyntaxKindMemberRead() {
            let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: sourceNodeID))
            if resolutionRow < 0
                || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) != compilerBodyResolutionMember() { return 0 - 1 }
            let collectionTypeID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()))
            if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: collectionTypeID) {
                let elementTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: collectionTypeID, ordinal: 0))
                if elementTypeID >= 0 && elementTypeID < compilerIntTableRowCount(table: arena.typeInstances) {
                    let elementSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: elementTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
                    if elementSyntaxID >= 0 { return elementSyntaxID }
                }
            }
            return 0 - 1
        } else if sourceKind == compilerSyntaxKindIdentifier() {
            let symbolID: Int(compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: sourceNodeID))
            if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
            let symbolTypeID: Int(compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolID))
            if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: symbolTypeID) {
                let declaredElementTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: symbolTypeID, ordinal: 0))
                if declaredElementTypeID >= 0 && declaredElementTypeID < compilerIntTableRowCount(table: arena.typeInstances) {
                    let declaredElementSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: declaredElementTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
                    if declaredElementSyntaxID >= 0 { return declaredElementSyntaxID }
                }
            }
            let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
            if declarationNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: declarationNodeID, column: 1) != compilerSyntaxKindLocalBinding() { return 0 - 1 }
            sourceNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: declarationNodeID, role: compilerSyntaxRoleInitializer(), ordinal: 0)
            step: step + 1
        } else if sourceKind == compilerSyntaxKindApplication() {
            let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
            if calleeNodeID < 0 || compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID) != String("filter") { return 0 - 1 }
            let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: sourceNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
            let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if argumentNodeID >= 0 && valueNodeID >= 0
                && compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 1) == compilerSyntaxKindIdentifier() {
                let declarationRow: Int(compilerDeclarationIndexLookup(
                    tables: arena.tables,
                    index: index,
                    name: compilerBodyArenaNodeText(arena: arena, nodeID: valueNodeID),
                    kindTag: compilerSyntaxKindConstruct()
                ))
                if declarationRow < 0 { return 0 - 1 }
                return compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0)
            }
            sourceNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0)
            step: step + 1
        } else {
            return 0 - 1
        }
    }
    return 0 - 1
}

function compilerBodyArenaQueriedCollectionElementTypeID(arena: CompilerBodyArena, queriedElementSyntaxID: Int, physicalElementTypeID: Int, sourceNodeID: Int): Int {
    if queriedElementSyntaxID < 0 { return physicalElementTypeID }
    let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: queriedElementSyntaxID))
    if genericCount < 0 { return 0 - 1 }
    let arguments: Buffer<Int>(bufferCreateInt(capacity: genericCount))
    state ordinal: Int(0)
    state valid: Bool(true)
    while ordinal < genericCount && valid {
        if arguments.append(element: physicalElementTypeID) != 0 { valid: false }
        ordinal: ordinal + 1
    }
    state semanticTypeID: Int(0 - 1)
    if valid {
        semanticTypeID: compilerBodyArenaTypeInstanceInternStructural(
            arena: arena,
            typeKind: compilerBodyTypeConstruct(),
            nominalSyntaxID: queriedElementSyntaxID,
            sourceNodeID: sourceNodeID,
            argumentIDs: arguments
        )
    }
    arguments.destroy()
    return semanticTypeID
}

function compilerBodyArenaResolveCollectionTransform(arena: CompilerBodyArena, index: CompilerDeclarationIndex, applicationNodeID: Int, calleeNodeID: Int, receiverTypeID: Int, regionNodeID: Int): Int {
    let transformKind: Int(compilerBodyArenaCollectionTransformKind(arena: arena, applicationNodeID: applicationNodeID, calleeNodeID: calleeNodeID))
    if transformKind < 0 || !compilerBodyArenaTypeIDIsArray(arena: arena, typeID: receiverTypeID) { return 0 - 1 }
    let closureNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleTrailingClosure(), ordinal: 0))
    let parameterNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: closureNodeID, role: compilerSyntaxRoleClosureParameter(), ordinal: 0))
    let bodyRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: closureNodeID, role: compilerSyntaxRoleClosureBody(), ordinal: 0))
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    let elementTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: receiverTypeID, ordinal: 0))
    let queriedElementSyntaxID: Int(compilerBodyArenaQueriedCollectionElementSyntaxID(arena: arena, index: index, receiverNodeID: receiverNodeID))
    let closureElementTypeID: Int(compilerBodyArenaQueriedCollectionElementTypeID(arena: arena, queriedElementSyntaxID: queriedElementSyntaxID, physicalElementTypeID: elementTypeID, sourceNodeID: parameterNodeID))
    let elementTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: closureElementTypeID))
    if parameterNodeID < 0 || bodyRegionNodeID < 0 || elementTypeID < 0 || elementTypeKind == compilerBodyTypeUnknown() { return 0 - 1 }
    let parameterSymbolID: Int(compilerBodyArenaAppendSymbol(
        arena: arena,
        kind: compilerBodySymbolClosureParameter(),
        declarationRef: parameterNodeID,
        regionNodeID: bodyRegionNodeID,
        nameStart: compilerIntTableValue(table: arena.nodes, row: parameterNodeID, column: 6),
        nameEnd: compilerIntTableValue(table: arena.nodes, row: parameterNodeID, column: 7),
        typeStart: compilerIntTableValue(table: arena.nodes, row: parameterNodeID, column: 6),
        typeEnd: compilerIntTableValue(table: arena.nodes, row: parameterNodeID, column: 7)
    ))
    if parameterSymbolID < 0
        || compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: parameterNodeID, targetKind: compilerBodyResolutionLocalSymbol(), targetID: parameterSymbolID, typeKind: elementTypeKind, typeID: closureElementTypeID, regionNodeID: bodyRegionNodeID) != 0 { return 0 - 1 }
    if transformKind == compilerBodyCollectionTransformMap()
        && compilerBodyArenaCollectionTransformIsExpansionSyntaxMap(arena: arena, applicationNodeID: applicationNodeID) {
        let noArguments: Buffer<Int>(bufferCreateInt(capacity: 0))
        let syntaxElementTypeID: Int(compilerBodyArenaTypeInstanceInternStructuralAtSpan(
            arena: arena,
            typeKind: compilerBodyTypeMacroTarget(),
            nominalSyntaxID: 0 - 1,
            fileID: arena.fileID,
            start: compilerIntTableValue(table: arena.nodes, row: bodyRegionNodeID, column: 4),
            end: compilerIntTableValue(table: arena.nodes, row: bodyRegionNodeID, column: 5),
            argumentIDs: noArguments
        ))
        noArguments.destroy()
        if syntaxElementTypeID < 0 { return 0 - 214 }
        let syntaxArrayTypeID: Int(compilerBodyArenaArrayTypeID(arena: arena, sourceNodeID: applicationNodeID, elementTypeID: syntaxElementTypeID))
        if !compilerBodyArenaTypeIDIsArray(arena: arena, typeID: syntaxArrayTypeID) { return 0 - 215 }
        return compilerBodyArenaAppendResolution(
            arena: arena,
            sourceNodeID: calleeNodeID,
            targetKind: compilerBodyResolutionMacroCollectionTransform(),
            targetID: transformKind,
            typeKind: compilerBodyTypeConstruct(),
            typeID: syntaxArrayTypeID,
            regionNodeID: regionNodeID
        )
    }
    let memberSeedStatus: Int(compilerBodyArenaSeedClosureParameterMemberResolutions(arena: arena, index: index, closureNodeID: closureNodeID, parameterNodeID: parameterNodeID, parameterSymbolID: parameterSymbolID, elementTypeID: closureElementTypeID, queriedElementSyntaxID: queriedElementSyntaxID, bodyRegionNodeID: bodyRegionNodeID))
    if memberSeedStatus != 0 { return memberSeedStatus }
    let failureCountBeforeClosureBody: Int(arena.failures.count)
    if compilerBodyArenaBuildRegionSymbols(arena: arena, index: index, regionNodeID: bodyRegionNodeID) != 0 {
        if arena.failures.count > failureCountBeforeClosureBody + 1 {
            return 0 - arena.failures.element(index: arena.failures.count - 1)
        }
        return 0 - 207
    }
    state returnTypeKind: Int(compilerBodyTypeUnknown())
    state returnTypeID: Int(0 - 1)
    state returnCount: Int(0)
    state nodeRow: Int(0)
    while nodeRow < compilerIntTableRowCount(table: arena.nodes) {
        if compilerIntTableValue(table: arena.nodes, row: nodeRow, column: 1) == compilerSyntaxKindReturn()
            && compilerBodyArenaEnclosingClosure(arena: arena, nodeID: nodeRow) == closureNodeID {
            let returnValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeRow, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
            let candidateTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: returnValueNodeID))
            let candidateTypeID: Int(compilerBodyArenaExpressionConcreteTypeID(arena: arena, nodeID: returnValueNodeID))
            if returnValueNodeID < 0 { return 0 - 208 }
            if candidateTypeKind == compilerBodyTypeUnknown() { return 0 - 209 }
            if (returnCount > 0 && candidateTypeKind != returnTypeKind)
                || (returnCount > 0
                    && (candidateTypeKind == compilerBodyTypeConstruct() || candidateTypeKind == compilerBodyTypeEnum())
                    && candidateTypeID != returnTypeID) { return 0 - 210 }
            returnTypeKind: candidateTypeKind
            returnTypeID: candidateTypeID
            returnCount: returnCount + 1
        }
        nodeRow: nodeRow + 1
    }
    if returnCount == 0 { return 0 - 211 }
    state resultTypeID: Int(receiverTypeID)
    if transformKind == compilerBodyCollectionTransformFilter() {
        if returnTypeKind != compilerBodyTypeBool() { return 0 - 212 }
    } else {
        resultTypeID: compilerBodyArenaArrayTypeID(arena: arena, sourceNodeID: applicationNodeID, elementTypeID: returnTypeID)
        if !compilerBodyArenaTypeIDIsArray(arena: arena, typeID: resultTypeID) { return 0 - 213 }
    }
    return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: calleeNodeID, targetKind: compilerBodyResolutionMacroCollectionTransform(), targetID: transformKind, typeKind: compilerBodyTypeConstruct(), typeID: resultTypeID, regionNodeID: regionNodeID)
}

function compilerBodyArenaConstructMemberRowAtOrdinal(arena: CompilerBodyArena, constructSyntaxID: Int, ordinal: Int): Int {
    state storedOrdinal: Int(0)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == constructSyntaxID {
            let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
            if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() || memberKind == compilerSyntaxMemberKindBinding() {
                if storedOrdinal == ordinal { return memberRow }
                storedOrdinal: storedOrdinal + 1
            }
        }
        memberRow: memberRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaStoredMemberOrdinal(arena: CompilerBodyArena, memberRow: Int): Int {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    let parentSyntaxID: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2))
    state ordinal: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: row, column: 2) == parentSyntaxID {
            let kind: Int(compilerIntTableValue(table: arena.tables.members, row: row, column: 12))
            if kind == compilerSyntaxMemberKindLet() || kind == compilerSyntaxMemberKindState() || kind == compilerSyntaxMemberKindBinding() {
                if row == memberRow { return ordinal }
                ordinal: ordinal + 1
            }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaConstructMemberCount(arena: CompilerBodyArena, constructSyntaxID: Int): Int {
    state count: Int(0)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 2) == constructSyntaxID {
            let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
            if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() || memberKind == compilerSyntaxMemberKindBinding() { count: count + 1 }
        }
        memberRow: memberRow + 1
    }
    return count
}

function compilerBodyArenaConstructMemberRowForArgument(arena: CompilerBodyArena, constructSyntaxID: Int, argumentNodeID: Int): Int {
    if argumentNodeID < 0 || argumentNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
    let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
    if labelStart < 0 || labelEnd <= labelStart { return 0 - 1 }
    let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
    let memberRow: Int(compilerDeclarationIndexMemberLookup(tables: arena.tables, index: arena.declarationIndex, parentSyntaxID: constructSyntaxID, name: label))
    if memberRow < 0 { return 0 - 1 }
    let memberKind: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12))
    if memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState() && memberKind != compilerSyntaxMemberKindBinding() { return 0 - 1 }
    return memberRow
}

function compilerBodyArenaConstructArgumentOrdinalForMemberOrdinal(arena: CompilerBodyArena, applicationNodeID: Int, constructSyntaxID: Int, memberOrdinal: Int): Int {
    let memberRow: Int(compilerBodyArenaConstructMemberRowAtOrdinal(arena: arena, constructSyntaxID: constructSyntaxID, ordinal: memberOrdinal))
    if memberRow < 0 { return 0 - 1 }
    state argumentOrdinal: Int(0)
    let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID))
    while argumentOrdinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
        if compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: argumentNodeID) == memberRow { return argumentOrdinal }
        argumentOrdinal: argumentOrdinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaMacroCapabilityRootNode(arena: CompilerBodyArena, nodeID: Int): Int {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    state currentNodeID: Int(nodeID)
    if compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1) == compilerSyntaxKindApplication() {
        currentNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0)
    }
    state keepWalking: Bool(currentNodeID >= 0)
    while keepWalking && compilerIntTableValue(table: arena.nodes, row: currentNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: currentNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if receiverNodeID < 0 {
            keepWalking: false
            currentNodeID: 0 - 1
        } else {
            currentNodeID: receiverNodeID
        }
    }
    return currentNodeID
}

function compilerBodyArenaSymbolMacroCapabilityKind(arena: CompilerBodyArena, symbolID: Int): Int {
    if arena.ownerKind != compilerBodyArenaOwnerMacro() || symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolParameter() { return 0 }
    let declarationRef: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
    if declarationRef < 0 || declarationRef >= compilerIntTableRowCount(table: arena.tables.macroCapabilities)
        || compilerIntTableValue(table: arena.tables.macroCapabilities, row: declarationRef, column: 1) != arena.ownerDeclarationSyntaxID
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameStartColumn()) != compilerIntTableValue(table: arena.tables.macroCapabilities, row: declarationRef, column: 4)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolNameEndColumn()) != compilerIntTableValue(table: arena.tables.macroCapabilities, row: declarationRef, column: 5) { return 0 }
    return compilerIntTableValue(table: arena.tables.macroCapabilities, row: declarationRef, column: 3)
}

function compilerBodyArenaExpressionUsesMacroCapability(arena: CompilerBodyArena, nodeID: Int): Bool {
    if arena.ownerKind != compilerBodyArenaOwnerMacro() || nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes) { return false }
    let expressionKind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if expressionKind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        if calleeNodeID >= 0 && compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindIdentifier()
            && compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID) == String("#environment") { return true }
    }
    let rootNodeID: Int(compilerBodyArenaMacroCapabilityRootNode(arena: arena, nodeID: nodeID))
    if rootNodeID < 0 { return false }
    let rootKind: Int(compilerIntTableValue(table: arena.nodes, row: rootNodeID, column: 1))
    if rootKind != compilerSyntaxKindIdentifier() && rootKind != compilerSyntaxKindBindingReference() { return false }
    let symbolID: Int(compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: rootNodeID))
    if symbolID < 0 { return false }
    let capabilityKind: Int(compilerBodyArenaSymbolMacroCapabilityKind(arena: arena, symbolID: symbolID))
    if capabilityKind == compilerMacroCapabilityDiagnostics() || capabilityKind == compilerMacroCapabilityGraph() { return true }
    if capabilityKind != compilerMacroCapabilityTarget() { return false }
    state operationNodeID: Int(nodeID)
    if compilerIntTableValue(table: arena.nodes, row: operationNodeID, column: 1) == compilerSyntaxKindApplication() {
        operationNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: operationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0)
    }
    if operationNodeID < 0 { return false }
    if expressionKind == compilerSyntaxKindApplication()
        && compilerIntTableValue(table: arena.nodes, row: operationNodeID, column: 1) == compilerSyntaxKindMemberRead() {
        let directReceiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: operationNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if directReceiverNodeID >= 0
            && compilerIntTableValue(table: arena.nodes, row: directReceiverNodeID, column: 1) == compilerSyntaxKindMemberRead()
            && compilerBodyArenaChild(arena: arena, ownerNodeID: directReceiverNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0) == rootNodeID {
            let directReceiverName: String(compilerBodyArenaNodeText(arena: arena, nodeID: directReceiverNodeID))
            if directReceiverName == String("target")
                || directReceiverName == String("diagnostics")
                || directReceiverName == String("graph") { return true }
        }
    }
    let operationName: String(compilerBodyArenaNodeText(arena: arena, nodeID: operationNodeID))
    return operationName == String("target")
        || operationName == String("diagnostics")
        || operationName == String("graph")
        || operationName == String("omit")
        || operationName == String("memberCount")
        || compilerMacroDiagnosticsOperationForName(name: operationName) > 0
        || compilerMacroGraphOperationForName(name: operationName) > 0
}

function compilerBodyArenaCallLabelsMatchConstruct(arena: CompilerBodyArena, applicationNodeID: Int, constructSyntaxID: Int): Bool {
    let memberCount: Int(compilerBodyArenaConstructMemberCount(arena: arena, constructSyntaxID: constructSyntaxID))
    if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != memberCount { return false }
    state ordinal: Int(0)
    while ordinal < memberCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: ordinal))
        let memberRow: Int(compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: argumentNodeID))
        if argumentNodeID < 0 || memberRow < 0 { return false }
        state priorOrdinal: Int(0)
        while priorOrdinal < ordinal {
            let priorArgumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: priorOrdinal))
            if compilerBodyArenaConstructMemberRowForArgument(arena: arena, constructSyntaxID: constructSyntaxID, argumentNodeID: priorArgumentNodeID) == memberRow { return false }
            priorOrdinal: priorOrdinal + 1
        }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaCallLabelsMatchCanonicalBufferCreate(arena: CompilerBodyArena, applicationNodeID: Int): Bool {
    if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID) != 1 { return false }
    let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: 0))
    if argumentNodeID < 0 { return false }
    let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
    let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
    if labelStart < 0 || labelEnd <= labelStart { return false }
    return compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd) == String("capacity")
}

function compilerBodyArenaResolveCapabilityExpression(arena: CompilerBodyArena, index: CompilerDeclarationIndex, nodeID: Int, regionNodeID: Int): Int {
    let kind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if kind == compilerSyntaxKindMemberRead() {
        let memberReceiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if memberReceiverNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: memberReceiverNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
        let memberRootNodeID: Int(compilerBodyArenaMacroCapabilityRootNode(arena: arena, nodeID: nodeID))
        let memberRootSymbolID: Int(compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: memberRootNodeID))
        let memberCapabilityKind: Int(compilerBodyArenaSymbolMacroCapabilityKind(arena: arena, symbolID: memberRootSymbolID))
        if memberCapabilityKind <= 0 { return 0 - 1 }
        let memberName: String(compilerBodyArenaNodeText(arena: arena, nodeID: nodeID))
        if memberCapabilityKind == compilerMacroCapabilityTarget() && memberName == String("target") {
            let targetTypeID: Int(compilerBodyArenaTypeIDForSpan(
                arena: arena,
                fileID: arena.fileID,
                start: compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 11),
                end: compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 12)
            ))
            let targetTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: targetTypeID))
            if targetTypeID < 0 || targetTypeKind == compilerBodyTypeUnknown() {
                return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroEnvironmentProjection(), targetID: compilerMacroEnvironmentProjectionTarget(), typeKind: compilerBodyTypeMacroTarget(), typeID: 0 - 1, regionNodeID: regionNodeID)
            }
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroEnvironmentProjection(), targetID: compilerMacroEnvironmentProjectionTarget(), typeKind: targetTypeKind, typeID: targetTypeID, regionNodeID: regionNodeID)
        }
        if memberCapabilityKind == compilerMacroCapabilityTarget() && memberName == String("diagnostics") {
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroEnvironmentProjection(), targetID: compilerMacroEnvironmentProjectionDiagnostics(), typeKind: compilerBodyTypeMacroDiagnostics(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        if memberCapabilityKind == compilerMacroCapabilityTarget() && memberName == String("graph") {
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroEnvironmentProjection(), targetID: compilerMacroEnvironmentProjectionGraph(), typeKind: compilerBodyTypeMacroGraph(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        let memberOperation: Int(compilerMacroDiagnosticsOperationForName(name: memberName))
        if memberOperation > 0 {
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroCapability(), targetID: memberOperation, typeKind: compilerBodyTypeVoid(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        let targetOperation: Int(compilerMacroTargetOperationForName(name: memberName))
        if memberCapabilityKind == compilerMacroCapabilityTarget() && targetOperation > 0 {
            state targetTypeKind: Int(compilerBodyTypeVoid())
            if targetOperation == compilerMacroTargetOperationMemberCount() { targetTypeKind: compilerBodyTypeInt() }
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroTargetOperation(), targetID: targetOperation, typeKind: targetTypeKind, typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        let graphOperation: Int(compilerMacroGraphOperationForName(name: memberName))
        if graphOperation > 0 {
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroGraphQuery(), targetID: graphOperation, typeKind: compilerBodyTypeInt(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionMacroCapabilityDenied(), targetID: 0, typeKind: compilerBodyTypeVoid(), typeID: 0 - 1, regionNodeID: regionNodeID)
    }
    if kind == compilerSyntaxKindApplication() {
        let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
        if calleeNodeID < 0 { return 0 - 1 }
        if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) == compilerSyntaxKindIdentifier()
            && compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID) == String("#environment") {
            if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 0 { return 0 - 1 }
            state boundaryOrdinal: Int(0)
            state boundaryNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleExpansionValue(), ordinal: boundaryOrdinal))
            while boundaryNodeID >= 0 {
                if compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: boundaryNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
                boundaryOrdinal: boundaryOrdinal + 1
                boundaryNodeID: compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleExpansionValue(), ordinal: boundaryOrdinal)
            }
            state targetCapabilityFound: Bool(false)
            state capabilityRow: Int(0)
            while capabilityRow < compilerIntTableRowCount(table: arena.tables.macroCapabilities) {
                if compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 1) == arena.ownerDeclarationSyntaxID
                    && compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 3) == compilerMacroCapabilityTarget() { targetCapabilityFound: true }
                capabilityRow: capabilityRow + 1
            }
            if !targetCapabilityFound { return 0 - 1 }
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: calleeNodeID, targetKind: compilerBodyResolutionMacroTargetOperation(), targetID: compilerMacroTargetOperationExpand(), typeKind: compilerBodyTypeVoid(), typeID: 0 - 1, regionNodeID: regionNodeID)
        }
        if compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
        let applicationReceiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: calleeNodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
        if applicationReceiverNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: applicationReceiverNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
        let syntaxFilterKind: Int(compilerBodyArenaMacroSyntaxFilterKind(arena: arena, index: index, applicationNodeID: nodeID, calleeNodeID: calleeNodeID))
        if syntaxFilterKind > 0 {
            let filteredTypeID: Int(compilerBodyArenaMacroSyntaxFilterResultTypeID(arena: arena, index: index, applicationNodeID: nodeID, calleeNodeID: calleeNodeID))
            if !compilerBodyArenaTypeIDIsArray(arena: arena, typeID: filteredTypeID) { return 0 - 1 }
            return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: calleeNodeID, targetKind: compilerBodyResolutionMacroSyntaxFilter(), targetID: syntaxFilterKind, typeKind: compilerBodyTypeConstruct(), typeID: filteredTypeID, regionNodeID: regionNodeID)
        }
        let collectionTransformKind: Int(compilerBodyArenaCollectionTransformKind(arena: arena, applicationNodeID: nodeID, calleeNodeID: calleeNodeID))
        if collectionTransformKind > 0 {
            return compilerBodyArenaResolveCollectionTransform(arena: arena, index: index, applicationNodeID: nodeID, calleeNodeID: calleeNodeID, receiverTypeID: compilerBodyArenaExpressionTypeID(arena: arena, nodeID: applicationReceiverNodeID), regionNodeID: regionNodeID)
        }
        let applicationRootNodeID: Int(compilerBodyArenaMacroCapabilityRootNode(arena: arena, nodeID: nodeID))
        let applicationRootSymbolID: Int(compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: applicationRootNodeID))
        let applicationCapabilityKind: Int(compilerBodyArenaSymbolMacroCapabilityKind(arena: arena, symbolID: applicationRootSymbolID))
        if applicationCapabilityKind <= 0 { return 0 - 1 }
        let applicationOperation: Int(compilerMacroDiagnosticsOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID)))
        let applicationGraphOperation: Int(compilerMacroGraphOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID)))
        let applicationTargetOperation: Int(compilerMacroTargetOperationForName(name: compilerBodyArenaNodeText(arena: arena, nodeID: calleeNodeID)))
        state targetKind: Int(compilerBodyResolutionMacroCapabilityDenied())
        state targetID: Int(0)
        state resultTypeKind: Int(compilerBodyTypeVoid())
        state invalidTargetQuery: Bool(false)
        if applicationOperation > 0 {
            targetKind: compilerBodyResolutionMacroCapability()
            targetID: applicationOperation
            if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 1 { return 0 - 1 }
        } else if applicationCapabilityKind == compilerMacroCapabilityTarget() && applicationTargetOperation > 0 {
            targetKind: compilerBodyResolutionMacroTargetOperation()
            targetID: applicationTargetOperation
            if applicationTargetOperation == compilerMacroTargetOperationOmit()
                && compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 0 { return 0 - 1 }
            if applicationTargetOperation == compilerMacroTargetOperationMemberCount() {
                resultTypeKind: compilerBodyTypeInt()
                if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 1 { invalidTargetQuery: true }
            }
        } else if applicationGraphOperation > 0 {
            targetKind: compilerBodyResolutionMacroGraphQuery()
            targetID: applicationGraphOperation
            resultTypeKind: compilerBodyTypeInt()
            if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 2 { return 0 - 1 }
        } else if compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID) != 0 { return 0 - 1 }
        let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: nodeID))
        state argumentOrdinal: Int(0)
        while argumentOrdinal < argumentCount {
            let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
            let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if argumentNodeID < 0 || valueNodeID < 0 || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: valueNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
            if (targetKind == compilerBodyResolutionMacroCapability() || targetKind == compilerBodyResolutionMacroGraphQuery())
                && compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID) != compilerBodyTypeString() { return 0 - 1 }
            if applicationTargetOperation == compilerMacroTargetOperationMemberCount()
                && compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID) != compilerBodyTypeString() { invalidTargetQuery: true }
            argumentOrdinal: argumentOrdinal + 1
        }
        if invalidTargetQuery { targetKind: compilerBodyResolutionMacroTargetQueryInvalid() }
        return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: calleeNodeID, targetKind: targetKind, targetID: targetID, typeKind: resultTypeKind, typeID: 0 - 1, regionNodeID: regionNodeID)
    }
    return 0 - 1
}

function compilerBodyArenaEnumSyntaxIDForTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances)
        || compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()) != compilerBodyTypeEnum() { return 0 - 1 }
    let syntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if syntaxID < 0 || syntaxID >= compilerIntTableRowCount(table: arena.tables.syntaxIndex)
        || compilerIntTableValue(table: arena.tables.syntaxIndex, row: syntaxID, column: 0) != compilerSyntaxKindEnum() { return 0 - 1 }
    return syntaxID
}

function compilerBodyArenaResolveEnumCaseValue(arena: CompilerBodyArena, index: CompilerDeclarationIndex, nodeID: Int, enumTypeID: Int, regionNodeID: Int): Int {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1) != compilerSyntaxKindEnumCaseValue() { return 0 - 1 }
    let enumSyntaxID: Int(compilerBodyArenaEnumSyntaxIDForTypeID(arena: arena, typeID: enumTypeID))
    if enumSyntaxID < 0 { return 0 - 1 }
    let memberRow: Int(compilerDeclarationIndexMemberLookup(tables: arena.tables, index: index, parentSyntaxID: enumSyntaxID, name: compilerBodyArenaNodeText(arena: arena, nodeID: nodeID)))
    if memberRow < 0
        || compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 12) != compilerSyntaxMemberKindEnumCase() { return 0 - 1 }
    return compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionEnumCase(), targetID: memberRow, typeKind: compilerBodyTypeEnum(), typeID: enumTypeID, regionNodeID: regionNodeID)
}

function compilerBodyArenaEnumCasePayloadCount(arena: CompilerBodyArena, caseMemberRow: Int): Int {
    if caseMemberRow < 0 || caseMemberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: arena.tables.members, row: caseMemberRow, column: 12) != compilerSyntaxMemberKindEnumCase() { return 0 - 1 }
    let caseSyntaxID: Int(compilerIntTableValue(table: arena.tables.members, row: caseMemberRow, column: 0))
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: row, column: 2) == caseSyntaxID
            && compilerIntTableValue(table: arena.tables.members, row: row, column: 12) == compilerSyntaxMemberKindEnumCasePayload() { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyArenaEnumCasePayloadRowAtOrdinal(arena: CompilerBodyArena, caseMemberRow: Int, ordinal: Int): Int {
    if ordinal < 0 || caseMemberRow < 0 || caseMemberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    let caseSyntaxID: Int(compilerIntTableValue(table: arena.tables.members, row: caseMemberRow, column: 0))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: row, column: 2) == caseSyntaxID
            && compilerIntTableValue(table: arena.tables.members, row: row, column: 12) == compilerSyntaxMemberKindEnumCasePayload()
            && compilerIntTableValue(table: arena.tables.members, row: row, column: 3) == ordinal { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaEnumPayloadFieldOrdinal(arena: CompilerBodyArena, payloadRow: Int): Int {
    let enumSyntaxID: Int(compilerSyntaxEnumPayloadOwnerSyntaxID(tables: arena.tables, payloadRow: payloadRow))
    if enumSyntaxID < 0 { return 0 - 1 }
    state ordinal: Int(1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.tables.members) {
        if compilerIntTableValue(table: arena.tables.members, row: row, column: 12) == compilerSyntaxMemberKindEnumCasePayload()
            && compilerSyntaxEnumPayloadOwnerSyntaxID(tables: arena.tables, payloadRow: row) == enumSyntaxID {
            if row == payloadRow { return ordinal }
            ordinal: ordinal + 1
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaEnumPayloadTypeID(arena: CompilerBodyArena, enumTypeID: Int, payloadRow: Int): Int {
    if payloadRow < 0 || payloadRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    if compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 12) != compilerSyntaxMemberKindEnumCasePayload() { return 0 - 1 }
    let ownerSyntaxID: Int(compilerSyntaxEnumPayloadOwnerSyntaxID(tables: arena.tables, payloadRow: payloadRow))
    return compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: enumTypeID, ownerSyntaxID: ownerSyntaxID, fileID: compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 1), start: compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 8), end: compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 9))
}

function compilerBodyArenaEnumPayloadRowForArgument(arena: CompilerBodyArena, caseMemberRow: Int, argumentNodeID: Int, allowUnlabeled: Bool): Int {
    if argumentNodeID < 0 || argumentNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    let argumentOrdinal: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 3))
    let labelStart: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 6))
    let labelEnd: Int(compilerIntTableValue(table: arena.nodes, row: argumentNodeID, column: 7))
    if labelStart < 0 || labelEnd <= labelStart {
        if !allowUnlabeled { return 0 - 1 }
        return compilerBodyArenaEnumCasePayloadRowAtOrdinal(arena: arena, caseMemberRow: caseMemberRow, ordinal: argumentOrdinal)
    }
    let label: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: arena.fileID, localStart: labelStart, localEnd: labelEnd))
    state ordinal: Int(0)
    let payloadCount: Int(compilerBodyArenaEnumCasePayloadCount(arena: arena, caseMemberRow: caseMemberRow))
    while ordinal < payloadCount {
        let payloadRow: Int(compilerBodyArenaEnumCasePayloadRowAtOrdinal(arena: arena, caseMemberRow: caseMemberRow, ordinal: ordinal))
        let payloadFileID: Int(compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 1))
        let payloadName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: payloadFileID, localStart: compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 6), localEnd: compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 7)))
        if payloadName == label { return payloadRow }
        ordinal: ordinal + 1
    }
    return 0 - 1
}

function compilerBodyArenaResolveEnumCaseApplication(arena: CompilerBodyArena, index: CompilerDeclarationIndex, applicationNodeID: Int, enumTypeID: Int, regionNodeID: Int): Int {
    let calleeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleCallee(), ordinal: 0))
    if calleeNodeID < 0
        || compilerIntTableValue(table: arena.nodes, row: calleeNodeID, column: 1) != compilerSyntaxKindEnumCaseValue()
        || compilerBodyArenaResolveEnumCaseValue(arena: arena, index: index, nodeID: calleeNodeID, enumTypeID: enumTypeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
    let caseResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: calleeNodeID))
    if caseResolutionRow < 0 { return 0 - 1 }
    let caseMemberRow: Int(compilerIntTableValue(table: arena.resolutions, row: caseResolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    let payloadCount: Int(compilerBodyArenaEnumCasePayloadCount(arena: arena, caseMemberRow: caseMemberRow))
    let argumentCount: Int(compilerBodyArenaApplicationArgumentCount(arena: arena, applicationNodeID: applicationNodeID))
    if payloadCount < 0 || argumentCount != payloadCount { return 0 - 1 }
    state argumentOrdinal: Int(0)
    while argumentOrdinal < argumentCount {
        let argumentNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: applicationNodeID, role: compilerSyntaxRoleArgument(), ordinal: argumentOrdinal))
        let valueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: argumentNodeID, role: compilerSyntaxRoleArgumentValue(), ordinal: 0))
        let payloadRow: Int(compilerBodyArenaEnumPayloadRowForArgument(arena: arena, caseMemberRow: caseMemberRow, argumentNodeID: argumentNodeID, allowUnlabeled: false))
        if valueNodeID < 0 || payloadRow < 0 { return 0 - 1 }
        if compilerIntTableValue(table: arena.nodes, row: valueNodeID, column: 10) == compilerBodyEnumPatternBindingAux()
            || compilerBodyArenaResolveExpression(arena: arena, index: index, nodeID: valueNodeID, regionNodeID: regionNodeID) != 0 { return 0 - 1 }
        let expectedTypeID: Int(compilerBodyArenaEnumPayloadTypeID(arena: arena, enumTypeID: enumTypeID, payloadRow: payloadRow))
        let expectedTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: expectedTypeID))
        let actualTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: valueNodeID))
        let storagePolicy: Int(compilerIntTableValue(table: arena.tables.members, row: payloadRow, column: 13))
        let carriesBindingReference: Bool(compilerBodyArenaValueCarriesBindingReference(arena: arena, valueNodeID: valueNodeID))
        if expectedTypeID < 0 || expectedTypeKind == compilerBodyTypeUnknown() || actualTypeKind != expectedTypeKind
            || ((expectedTypeKind == compilerBodyTypeConstruct() || expectedTypeKind == compilerBodyTypeEnum()) && compilerBodyArenaExpressionTypeID(arena: arena, nodeID: valueNodeID) != expectedTypeID)
            || (storagePolicy == compilerSyntaxMemberStorageBinding() && !carriesBindingReference)
            || (storagePolicy != compilerSyntaxMemberStorageBinding() && carriesBindingReference)
            || storagePolicy == compilerSyntaxMemberStorageIndirect() { return 0 - 1 }
        argumentOrdinal: argumentOrdinal + 1
    }
    return 0
}

function compilerBodyArenaExplicitArrayElementTypeID(arena: CompilerBodyArena, arrayNodeID: Int): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.edges) {
        if compilerIntTableValue(table: arena.edges, row: edgeRow, column: 1) == arrayNodeID
            && compilerIntTableValue(table: arena.edges, row: edgeRow, column: 2) == compilerSyntaxRoleInitializer() {
            let localNodeID: Int(compilerIntTableValue(table: arena.edges, row: edgeRow, column: 0))
            if localNodeID < 0 || compilerIntTableValue(table: arena.nodes, row: localNodeID, column: 1) != compilerSyntaxKindLocalBinding() { return 0 - 1 }
            let typeStart: Int(compilerIntTableValue(table: arena.nodes, row: localNodeID, column: 8))
            let typeEnd: Int(compilerIntTableValue(table: arena.nodes, row: localNodeID, column: 9))
            let typeGlobalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: typeStart))
            let typeGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: typeEnd))
            if typeGlobalStart < 0 || typeGlobalEnd <= typeGlobalStart + 2
                || stringByteAt(source: arena.tables.sourceStore.source, index: typeGlobalStart) != 91
                || stringByteAt(source: arena.tables.sourceStore.source, index: typeGlobalEnd - 1) != 93 { return 0 - 1 }
            let maybeElementType: Optional<CompilerTypeReference>(compilerCoreParseTypeReference(cursor: CompilerTokenCursor(source: $arena.tables.sourceStore.source, index: typeGlobalStart + 1)))
            if maybeElementType == nil { return 0 - 1 }
            let elementType: CompilerTypeReference(maybeElementType ?? CompilerTypeReference(text: String(""), start: typeGlobalStart + 1, end: typeGlobalStart + 1))
            if elementType.end != typeGlobalEnd - 1 { return 0 - 1 }
            let elementLocalStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: arena.fileID, globalOffset: elementType.start))
            let elementLocalEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: arena.fileID, globalOffset: elementType.end))
            return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: arena.fileID, start: elementLocalStart, end: elementLocalEnd)
        }
        edgeRow: edgeRow + 1
    }
    return 0 - 1
}

function compilerBodyArenaResolveArrayLiteral(arena: CompilerBodyArena, index: CompilerDeclarationIndex, nodeID: Int, regionNodeID: Int): Int {
    let existingResolution: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: nodeID))
    if existingResolution >= 0 { return 0 }
    state elementTypeID: Int(compilerBodyArenaExplicitArrayElementTypeID(arena: arena, arrayNodeID: nodeID))
    state arrayTypeID: Int(0 - 1)
    if elementTypeID < 0 {
        arrayTypeID: compilerBodyArenaExpectedTypeIDForExpression(arena: arena, expressionNodeID: nodeID)
        if compilerBodyArenaTypeIDIsArray(arena: arena, typeID: arrayTypeID) {
            elementTypeID: compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: arrayTypeID, ordinal: 0)
        } else {
            arrayTypeID: 0 - 1
        }
    }
    if elementTypeID >= 0 && arrayTypeID < 0 {
        arrayTypeID: compilerBodyArenaArrayTypeID(arena: arena, sourceNodeID: nodeID, elementTypeID: elementTypeID)
    }
    if arrayTypeID >= 0 {
        if compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionArrayLiteral(), targetID: compilerBodyArenaArrayDeclarationSyntaxID(arena: arena), typeKind: compilerBodyTypeConstruct(), typeID: arrayTypeID, regionNodeID: regionNodeID) != 0 { return 0 - 230 }
    }
    state ordinal: Int(0)
    state keepResolving: Bool(true)
    while keepResolving {
        let elementNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleArrayElement(), ordinal: ordinal))
        if elementNodeID < 0 {
            keepResolving: false
        } else {
            let elementResolutionStatus: Int(
                compilerBodyArenaResolveExpression(
                    arena: arena,
                    index: index,
                    nodeID: elementNodeID,
                    regionNodeID: regionNodeID
                )
            )
            if elementResolutionStatus != 0 { return elementResolutionStatus }
            let actualTypeID: Int(compilerBodyArenaExpressionConcreteTypeID(arena: arena, nodeID: elementNodeID))
            let actualTypeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: elementNodeID))
            if actualTypeID < 0 || actualTypeKind == compilerBodyTypeUnknown() { return 0 - 231 }
            if elementTypeID < 0 {
                elementTypeID: actualTypeID
            } else if compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: elementTypeID) != actualTypeKind {
                return 0 - (240
                    + compilerBodyArenaTypeKindForTypeID(
                        arena: arena,
                        typeID: elementTypeID
                    ) * 10
                    + actualTypeKind)
            } else if !compilerBodyArenaTypeIDsEquivalent(
                    arena: arena,
                    leftTypeID: elementTypeID,
                    rightTypeID: actualTypeID
                ) { return 0 - 233 }
            ordinal: ordinal + 1
        }
    }
    if ordinal == 0 && elementTypeID < 0 { return 0 - 1 }
    if arrayTypeID < 0 {
        arrayTypeID: compilerBodyArenaArrayTypeID(arena: arena, sourceNodeID: nodeID, elementTypeID: elementTypeID)
        if arrayTypeID < 0 { return 0 - 234 }
        if compilerBodyArenaAppendResolution(arena: arena, sourceNodeID: nodeID, targetKind: compilerBodyResolutionArrayLiteral(), targetID: compilerBodyArenaArrayDeclarationSyntaxID(arena: arena), typeKind: compilerBodyTypeConstruct(), typeID: arrayTypeID, regionNodeID: regionNodeID) != 0 { return 0 - 235 }
    }
    return 0
}

function compilerBodyArenaRewriteDerivedReadAsApplication(arena: CompilerBodyArena, nodeID: Int): Int {
    if nodeID < 0 || nodeID >= compilerIntTableRowCount(table: arena.nodes)
        || compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1) != compilerSyntaxKindMemberRead() { return 0 - 1 }
    let receiverNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: nodeID, role: compilerSyntaxRoleReceiver(), ordinal: 0))
    if receiverNodeID < 0 { return 0 - 1 }
    let start: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: compilerIntTableValue(table: arena.nodes, row: nodeID, column: 4)))
    let end: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: arena.fileID, localOffset: compilerIntTableValue(table: arena.nodes, row: nodeID, column: 5)))
