function compilerBodyArenaAppendSymbol(arena: CompilerBodyArena, kind: Int, declarationRef: Int, regionNodeID: Int, nameStart: Int, nameEnd: Int, typeStart: Int, typeEnd: Int): Int {
    let symbolID: Int(compilerIntTableRowCount(table: arena.symbols))
    if compilerIntTableAppend(table: arena.symbols, value: symbolID) != 0
        || compilerIntTableAppend(table: arena.symbols, value: kind) != 0
        || compilerIntTableAppend(table: arena.symbols, value: declarationRef) != 0
        || compilerIntTableAppend(table: arena.symbols, value: regionNodeID) != 0
        || compilerIntTableAppend(table: arena.symbols, value: nameStart) != 0
        || compilerIntTableAppend(table: arena.symbols, value: nameEnd) != 0
        || compilerIntTableAppend(table: arena.symbols, value: typeStart) != 0
        || compilerIntTableAppend(table: arena.symbols, value: typeEnd) != 0 { return 0 - 1 }
    return symbolID
}

function compilerBodyArenaTypeOuterName(typeName: String): String {
    let length: Int(stringLength(value: typeName))
    if length > 1 && typeName.substring(start: length - 1, end: length) == String("?") { return "\(String("Optional"))" }
    let genericStart: Int(stringIndexOf(source: typeName, needle: String("<"), start: 0))
    if genericStart < 0 { return "\(typeName)" }
    return "\(typeName.substring(start: 0, end: genericStart))"
}

function compilerBodyArenaGenericArgumentText(typeName: String, ordinal: Int): String {
    let genericStart: Int(stringIndexOf(source: typeName, needle: String("<"), start: 0))
    if genericStart < 0 || ordinal < 0 { return String("") }
    state depth: Int(0)
    state argumentOrdinal: Int(0)
    state argumentStart: Int(genericStart + 1)
    state index: Int(genericStart + 1)
    let length: Int(stringLength(value: typeName))
    while index < length {
        let character: String(stringCharacterAt(source: typeName, index: index))
        if character == String("<") {
            depth: depth + 1
        } else if character == String(">") {
            if depth == 0 {
                if argumentOrdinal == ordinal { return typeName.substring(start: argumentStart, end: index) }
                return String("")
            }
            depth: depth - 1
        } else if character == String(",") && depth == 0 {
            if argumentOrdinal == ordinal { return typeName.substring(start: argumentStart, end: index) }
            argumentOrdinal: argumentOrdinal + 1
            argumentStart: index + 1
        }
        index: index + 1
    }
    return String("")
}

function compilerBodyArenaGenericArgumentCount(typeName: String): Int {
    let genericStart: Int(stringIndexOf(source: typeName, needle: String("<"), start: 0))
    if genericStart < 0 { return 0 }
    state count: Int(0)
    while compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: count) != String("") { count: count + 1 }
    return count
}

function compilerBuiltinTargetPointerBits(): Int {
    return targetPointerBits()
}

function compilerProjectDefaultsReasonNone(): Int { return 0 }
function compilerProjectDefaultsReasonDuplicateProject(): Int { return 1 }
function compilerProjectDefaultsReasonDuplicateInteger(): Int { return 2 }
function compilerProjectDefaultsReasonIntegerMustBeState(): Int { return 3 }
function compilerProjectDefaultsReasonInvalidIntegerType(): Int { return 4 }
function compilerProjectDefaultsReasonDuplicateBool(): Int { return 5 }
function compilerProjectDefaultsReasonBoolMustBeState(): Int { return 6 }
function compilerProjectDefaultsReasonInvalidBoolType(): Int { return 7 }

function compilerProjectDefaultsReasonName(reason: Int): String {
    if reason == compilerProjectDefaultsReasonDuplicateProject() { return String("duplicateProject") }
    if reason == compilerProjectDefaultsReasonDuplicateInteger() { return String("duplicateInteger") }
    if reason == compilerProjectDefaultsReasonIntegerMustBeState() { return String("integerMustBeState") }
    if reason == compilerProjectDefaultsReasonInvalidIntegerType() { return String("invalidIntegerType") }
    if reason == compilerProjectDefaultsReasonDuplicateBool() { return String("duplicateBool") }
    if reason == compilerProjectDefaultsReasonBoolMustBeState() { return String("boolMustBeState") }
    if reason == compilerProjectDefaultsReasonInvalidBoolType() { return String("invalidBoolType") }
    return String("none")
}

function compilerMacroApplicationName(tables: CompilerSyntaxTables, applicationRow: Int): String {
    if applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications) { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 1))
    return compilerTypedSyntaxLocalText(
        tables: tables,
        fileID: fileID,
        localStart: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 4),
        localEnd: compilerIntTableValue(table: tables.macroApplications, row: applicationRow, column: 5))
}

function compilerProjectIntegerBits(typeName: String, fallbackBits: Int): Int {
    let trimmed: CompilerSourceRange(compilerSemanticTrimStringRange(text: typeName, start: 0, end: stringLength(value: typeName)))
    if trimmed.start < 0 { return 0 - 1 }
    let normalized: String(typeName.substring(start: trimmed.start, end: trimmed.end))
    if normalized == String("Int") { return fallbackBits }
    if compilerBodyArenaTypeOuterName(typeName: normalized) != String("Int") { return 0 - 1 }
    let argumentCount: Int(compilerBodyArenaGenericArgumentCount(typeName: normalized))
    if argumentCount == 1 {
        let widthText: String(compilerBodyArenaGenericArgumentText(typeName: normalized, ordinal: 0))
        let width: Int(compilerCoreParseDecimalInt(value: widthText))
        if width > 0 { return width }
        return 0 - 1
    }
    if argumentCount != 2 { return 0 - 1 }
    let firstText: String(compilerBodyArenaGenericArgumentText(typeName: normalized, ordinal: 0))
    let secondText: String(compilerBodyArenaGenericArgumentText(typeName: normalized, ordinal: 1))
    let first: CompilerSourceRange(compilerSemanticTrimStringRange(text: firstText, start: 0, end: stringLength(value: firstText)))
    let second: CompilerSourceRange(compilerSemanticTrimStringRange(text: secondText, start: 0, end: stringLength(value: secondText)))
    if first.start < 0 || second.start < 0 { return 0 - 1 }
    if compilerSemanticStringRangeEqualsText(text: firstText, start: first.start, end: first.end, literal: String(".signed")) {
        let width: Int(compilerCoreParseDecimalInt(value: secondText.substring(start: second.start, end: second.end)))
        if width > 0 { return width }
    }
    return 0 - 1
}

function compilerProjectDefaultsForTarget(tables: CompilerSyntaxTables, projectTargetSyntaxID: Int, pointerBits: Int): CompilerProjectDefaults {
    state integerBits: Int(pointerBits)
    state integerCount: Int(0)
    state integerWasOverridden: Bool(false)
    state boolCount: Int(0)
    state boolWasOverridden: Bool(false)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: memberRow, column: 2) == projectTargetSyntaxID {
            let fileID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 1))
            let memberName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 7)))
            if memberName == String("integer") {
                integerCount: integerCount + 1
                if integerCount > 1 {
                    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: pointerBits, integerWasOverridden: false, boolWasOverridden: boolWasOverridden, reason: compilerProjectDefaultsReasonDuplicateInteger(), relatedRow: memberRow, isValid: false)
                }
                if compilerIntTableValue(table: tables.members, row: memberRow, column: 12) != compilerSyntaxMemberKindState() {
                    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: pointerBits, integerWasOverridden: false, boolWasOverridden: boolWasOverridden, reason: compilerProjectDefaultsReasonIntegerMustBeState(), relatedRow: memberRow, isValid: false)
                }
                let integerType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 9)))
                integerBits: compilerProjectIntegerBits(typeName: integerType, fallbackBits: pointerBits)
                if integerBits <= 0 {
                    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: pointerBits, integerWasOverridden: false, boolWasOverridden: boolWasOverridden, reason: compilerProjectDefaultsReasonInvalidIntegerType(), relatedRow: memberRow, isValid: false)
                }
                integerWasOverridden: true
            } else if memberName == String("bool") {
                boolCount: boolCount + 1
                if boolCount > 1 {
                    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: integerBits, integerWasOverridden: integerWasOverridden, boolWasOverridden: false, reason: compilerProjectDefaultsReasonDuplicateBool(), relatedRow: memberRow, isValid: false)
                }
                if compilerIntTableValue(table: tables.members, row: memberRow, column: 12) != compilerSyntaxMemberKindState() {
                    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: integerBits, integerWasOverridden: integerWasOverridden, boolWasOverridden: false, reason: compilerProjectDefaultsReasonBoolMustBeState(), relatedRow: memberRow, isValid: false)
                }
                let boolType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: memberRow, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: memberRow, column: 9)))
                if boolType != String("Bool") {
                    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: integerBits, integerWasOverridden: integerWasOverridden, boolWasOverridden: false, reason: compilerProjectDefaultsReasonInvalidBoolType(), relatedRow: memberRow, isValid: false)
                }
                boolWasOverridden: true
            }
        }
        memberRow: memberRow + 1
    }
    return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: integerBits, integerWasOverridden: integerWasOverridden, boolWasOverridden: boolWasOverridden, reason: compilerProjectDefaultsReasonNone(), relatedRow: 0 - 1, isValid: true)
}

function compilerProjectDefaultsResolve(tables: CompilerSyntaxTables): CompilerProjectDefaults {
    let pointerBits: Int(compilerBuiltinTargetPointerBits())
    state projectTargetSyntaxID: Int(0 - 1)
    state projectResultCount: Int(0)
    state resultRow: Int(0)
    while resultRow < compilerIntTableRowCount(table: tables.macroResults) {
        let resultNominalSyntaxID: Int(compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 7))
        if compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 10) < 0
            && resultNominalSyntaxID >= 0
            && compilerDeclarationNameForSyntaxID(tables: tables, syntaxID: resultNominalSyntaxID) == String("ProjectDefaults") {
            let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroResults, row: resultRow, column: 4))
            if targetSyntaxID >= 0
                && compilerIntTableValue(table: tables.syntaxIndex, row: targetSyntaxID, column: 0) == compilerSyntaxKindConstruct() {
                projectTargetSyntaxID: targetSyntaxID
                projectResultCount: projectResultCount + 1
            }
        }
        resultRow: resultRow + 1
    }
    if projectResultCount > 1 {
        return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: pointerBits, integerWasOverridden: false, boolWasOverridden: false, reason: compilerProjectDefaultsReasonDuplicateProject(), relatedRow: 0 - 1, isValid: false)
    }
    if projectResultCount == 0 {
        return CompilerProjectDefaults(targetPointerBits: pointerBits, integerBits: 32, integerWasOverridden: false, boolWasOverridden: false, reason: compilerProjectDefaultsReasonNone(), relatedRow: 0 - 1, isValid: true)
    }
    return compilerProjectDefaultsForTarget(tables: tables, projectTargetSyntaxID: projectTargetSyntaxID, pointerBits: pointerBits)
}

function compilerProjectIntegerLLVMTypeName(tables: CompilerSyntaxTables): String {
    let defaults: CompilerProjectDefaults(compilerProjectDefaultsResolve(tables: tables))
    if !defaults.isValid || defaults.integerBits <= 0 { return String("") }
    return "i\(defaults.integerBits)"
}

function compilerStorageLiteralReasonNone(): Int { return 0 }
