        ordinal: ordinal + 1
    }
    let existing: Int(compilerReachableTypeKeyFind(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: argumentCount, argumentIDs: argumentIDs))
    if existing >= 0 {
        argumentIDs.destroy()
        return existing
    }
    let keyID: Int(compilerIntTableRowCount(table: typeKeys))
    let firstArgumentRow: Int(compilerIntTableRowCount(table: typeKeyArguments))
    if compilerIntTableAppend(table: typeKeys, value: keyID) != 0 {
        argumentIDs.destroy()
