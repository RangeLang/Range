    if arena.ownerReceiverTypeID >= 0 && ownerSyntaxID >= 0 {
        return compilerBodyArenaSpecializedTypeKindForSpan(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
    }
    return compilerBodyArenaTypeKindForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
}

function compilerBodyArenaSymbolTypeID(arena: CompilerBodyArena, symbolID: Int): Int {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols) { return 0 - 1 }
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    if symbolKind == compilerBodySymbolReceiver() { return compilerBodyArenaReceiverTypeID(arena: arena) }
    if symbolKind == compilerBodySymbolEnumPayloadBinding() || symbolKind == compilerBodySymbolClosureParameter() {
        let declarationNodeID: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: declarationNodeID))
        if resolutionRow < 0 { return 0 - 1 }
        return compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())
    }
    let arrayInitializerNodeID: Int(compilerBodyArenaSymbolArrayInitializer(arena: arena, symbolID: symbolID))
    if arrayInitializerNodeID >= 0 { return compilerBodyArenaExpressionTypeID(arena: arena, nodeID: arrayInitializerNodeID) }
    let ownerSyntaxID: Int(compilerBodyArenaReceiverConstructSyntaxID(arena: arena))
    if arena.ownerReceiverTypeID >= 0 && ownerSyntaxID >= 0 {
        return compilerBodyArenaSpecializedTypeIDForSpan(arena: arena, receiverTypeID: arena.ownerReceiverTypeID, ownerSyntaxID: ownerSyntaxID, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
    }
    return compilerBodyArenaTypeIDForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn()))
}

