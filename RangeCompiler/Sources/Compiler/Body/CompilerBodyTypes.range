}

function compilerStorageGenericParameterName(tables: CompilerSyntaxTables, row: Int): String {
    if row < 0 || row >= compilerIntTableRowCount(table: tables.genericParameters) { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()))
