        let argumentTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: typeID, ordinal: ordinal))
        let argumentKeyID: Int(compilerReachableTypeKeyFindFromArena(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, arena: arena, typeID: argumentTypeID))
        if argumentKeyID < 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        if argumentIDs.append(element: argumentKeyID) != 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        ordinal: ordinal + 1
    }
    let result: Int(compilerReachableTypeKeyFind(typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: argumentCount, argumentIDs: argumentIDs))
    argumentIDs.destroy()
    return result
}

function compilerReachableTypeKeyInternFromArena(typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    let typeKind: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()))
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    let argumentCount: Int(compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID))
