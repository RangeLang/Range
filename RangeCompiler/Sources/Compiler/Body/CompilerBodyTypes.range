        if compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOwnerColumn()) == targetSyntaxID
            && compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterOrdinalColumn()) == ordinal {
            return row
