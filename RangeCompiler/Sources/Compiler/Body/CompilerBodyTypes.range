}

function compilerStorageGenericParameterType(tables: CompilerSyntaxTables, row: Int): String {
    if row < 0 || row >= compilerIntTableRowCount(table: tables.genericParameters) { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterFileColumn()))
    let authored: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterStartColumn()), localEnd: compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterEndColumn())))
    let colon: Int(stringIndexOf(source: authored, needle: String(":"), start: 0))
    if colon < 0 { return String("") }
    let equals: Int(stringIndexOf(source: authored, needle: String("="), start: colon + 1))
    state typeEnd: Int(stringLength(value: authored))
    if equals >= 0 { typeEnd: equals }
    let trimmed: CompilerSourceRange(compilerSemanticTrimStringRange(text: authored, start: colon + 1, end: typeEnd))
    if trimmed.start < 0 { return String("") }
    return authored.substring(start: trimmed.start, end: trimmed.end)
}

function compilerStorageGenericParameterMatches(tables: CompilerSyntaxTables, targetSyntaxID: Int, ordinal: Int, name: String, typeName: String): Bool {
    let row: Int(compilerStorageGenericParameterRow(tables: tables, targetSyntaxID: targetSyntaxID, ordinal: ordinal))
    return row >= 0
        && compilerIntTableValue(table: tables.genericParameters, row: row, column: compilerSyntaxGenericParameterKindColumn()) == compilerSyntaxGenericParameterValueKind()
        && compilerStorageGenericParameterName(tables: tables, row: row) == name
        && compilerStorageGenericParameterType(tables: tables, row: row) == typeName
}

function compilerStorageNumericShapeIsValid(tables: CompilerSyntaxTables, targetSyntaxID: Int): Bool {
    return compilerStorageGenericParameterCount(tables: tables, targetSyntaxID: targetSyntaxID) == 2
        && compilerStorageGenericParameterMatches(tables: tables, targetSyntaxID: targetSyntaxID, ordinal: 0, name: String("signedness"), typeName: String("Signedness"))
        && compilerStorageGenericParameterMatches(tables: tables, targetSyntaxID: targetSyntaxID, ordinal: 1, name: String("bits"), typeName: String("Int"))
}

function compilerStorageDecimalShapeIsValid(tables: CompilerSyntaxTables, targetSyntaxID: Int): Bool {
    return compilerStorageGenericParameterCount(tables: tables, targetSyntaxID: targetSyntaxID) == 1
        && compilerStorageGenericParameterMatches(tables: tables, targetSyntaxID: targetSyntaxID, ordinal: 0, name: String("bits"), typeName: String("Int"))
}

function compilerStorageLiteralFactsResolveApplications(tables: CompilerSyntaxTables): CompilerStorageLiteralFacts {
    state storageApplicationCount: Int(0)
    state literalApplicationCount: Int(0)
    state numericTargetSyntaxID: Int(0 - 1)
    state decimalTargetSyntaxID: Int(0 - 1)
    state decimalSeparatorByte: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.macroApplications) {
        let macroName: String(compilerMacroApplicationName(tables: tables, applicationRow: row))
        if macroName == String("storage") {
            storageApplicationCount: storageApplicationCount + 1
            let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 12))
            let targetKind: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 13))
            let storageSyntax: String(compilerMacroApplicationArgumentText(tables: tables, applicationRow: row))
            if targetKind != compilerSyntaxKindConstruct() {
                return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonStorageTargetMustBeConstruct(), relatedRow: row)
            }
            if compilerStorageApplicationCountForTarget(tables: tables, targetSyntaxID: targetSyntaxID) != 1 {
                return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonDuplicateStorage(), relatedRow: row)
            }
            if storageSyntax == String("")
                && compilerStorageTargetMemberCount(tables: tables, targetSyntaxID: targetSyntaxID) != 0 {
                return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonStorageMustBeEmpty(), relatedRow: row)
            }
        }
        row: row + 1
    }
    row: 0
    while row < compilerIntTableRowCount(table: tables.macroApplications) {
        if compilerMacroApplicationName(tables: tables, applicationRow: row) == String("literal") {
            literalApplicationCount: literalApplicationCount + 1
            let targetSyntaxID: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 12))
            let targetKind: Int(compilerIntTableValue(table: tables.macroApplications, row: row, column: 13))
            if targetKind != compilerSyntaxKindConstruct() {
                return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonLiteralTargetMustBeConstruct(), relatedRow: row)
            }
            if compilerStorageApplicationCountForTarget(tables: tables, targetSyntaxID: targetSyntaxID) != 1 {
                return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonLiteralRequiresStorage(), relatedRow: row)
            }
            let literalSyntax: String(compilerMacroApplicationArgumentText(tables: tables, applicationRow: row))
            if literalSyntax == String(".numeric") {
                if numericTargetSyntaxID >= 0 {
                    return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonDuplicateNumericLiteral(), relatedRow: row)
                }
                if !compilerStorageNumericShapeIsValid(tables: tables, targetSyntaxID: targetSyntaxID) {
                    return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonInvalidNumericStorageShape(), relatedRow: row)
                }
                numericTargetSyntaxID: targetSyntaxID
            } else if literalSyntax == String(".numeric.decimal(separator: \".\")") {
                if decimalTargetSyntaxID >= 0 {
                    return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonDuplicateDecimalLiteral(), relatedRow: row)
                }
                if !compilerStorageDecimalShapeIsValid(tables: tables, targetSyntaxID: targetSyntaxID) {
                    return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonInvalidDecimalStorageShape(), relatedRow: row)
                }
                decimalTargetSyntaxID: targetSyntaxID
                decimalSeparatorByte: 46
            } else if literalSyntax == String(".text") {
            } else {
                return compilerStorageLiteralInvalid(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonUnsupportedLiteralSyntax(), relatedRow: row)
            }
        }
        row: row + 1
    }
    return CompilerStorageLiteralFacts(storageApplicationCount: storageApplicationCount, literalApplicationCount: literalApplicationCount, numericTargetSyntaxID: numericTargetSyntaxID, decimalTargetSyntaxID: decimalTargetSyntaxID, decimalSeparatorByte: decimalSeparatorByte, reason: compilerStorageLiteralReasonNone(), relatedRow: 0 - 1, isValid: true)
}

function compilerStorageLiteralFactsResolve(tables: CompilerSyntaxTables): CompilerStorageLiteralFacts {
    let applicationFacts: CompilerStorageLiteralFacts(compilerStorageLiteralFactsResolveApplications(tables: tables))
    if !applicationFacts.isValid { return applicationFacts }
    state storageFactCount: Int(0)
    state literalFactCount: Int(0)
    state numericFactTarget: Int(0 - 1)
    state decimalFactTarget: Int(0 - 1)
    state decimalSeparatorByte: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.compilerFormulaFacts) {
        let kind: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 1))
        let invocationRow: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 2))
        let applicationRow: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 3))
        let targetSyntaxID: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 4))
        let category: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 5))
        if invocationRow < 0 || invocationRow >= compilerIntTableRowCount(table: tables.macroInvocations)
            || applicationRow < 0 || applicationRow >= compilerIntTableRowCount(table: tables.macroApplications)
            || compilerIntTableValue(table: tables.macroInvocations, row: invocationRow, column: 9) != compilerMacroInvocationSuccess() {
            return compilerStorageLiteralInvalid(storageApplicationCount: applicationFacts.storageApplicationCount, literalApplicationCount: applicationFacts.literalApplicationCount, numericTargetSyntaxID: applicationFacts.numericTargetSyntaxID, decimalTargetSyntaxID: applicationFacts.decimalTargetSyntaxID, decimalSeparatorByte: applicationFacts.decimalSeparatorByte, reason: compilerStorageLiteralReasonInvalidCompilerFormulaFact(), relatedRow: row)
        }
        if kind == compilerFormulaFactStorage() {
            storageFactCount: storageFactCount + 1
            if compilerMacroApplicationName(tables: tables, applicationRow: applicationRow) != String("storage") {
                return compilerStorageLiteralInvalid(storageApplicationCount: applicationFacts.storageApplicationCount, literalApplicationCount: applicationFacts.literalApplicationCount, numericTargetSyntaxID: applicationFacts.numericTargetSyntaxID, decimalTargetSyntaxID: applicationFacts.decimalTargetSyntaxID, decimalSeparatorByte: applicationFacts.decimalSeparatorByte, reason: compilerStorageLiteralReasonInvalidCompilerFormulaFact(), relatedRow: row)
            }
        } else if kind == compilerFormulaFactLiteral() {
            literalFactCount: literalFactCount + 1
            if compilerMacroApplicationName(tables: tables, applicationRow: applicationRow) != String("literal") {
                return compilerStorageLiteralInvalid(storageApplicationCount: applicationFacts.storageApplicationCount, literalApplicationCount: applicationFacts.literalApplicationCount, numericTargetSyntaxID: applicationFacts.numericTargetSyntaxID, decimalTargetSyntaxID: applicationFacts.decimalTargetSyntaxID, decimalSeparatorByte: applicationFacts.decimalSeparatorByte, reason: compilerStorageLiteralReasonInvalidCompilerFormulaFact(), relatedRow: row)
            }
            if category == compilerFormulaLiteralNumeric() { numericFactTarget: targetSyntaxID }
            if category == compilerFormulaLiteralDecimal() {
                decimalFactTarget: targetSyntaxID
                decimalSeparatorByte: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 7)
            }
        }
        row: row + 1
    }
    if storageFactCount != applicationFacts.storageApplicationCount || literalFactCount != applicationFacts.literalApplicationCount {
        return compilerStorageLiteralInvalid(storageApplicationCount: applicationFacts.storageApplicationCount, literalApplicationCount: applicationFacts.literalApplicationCount, numericTargetSyntaxID: applicationFacts.numericTargetSyntaxID, decimalTargetSyntaxID: applicationFacts.decimalTargetSyntaxID, decimalSeparatorByte: applicationFacts.decimalSeparatorByte, reason: compilerStorageLiteralReasonMissingCompilerFormulaFact(), relatedRow: 0 - 1)
    }
    if numericFactTarget != applicationFacts.numericTargetSyntaxID
        || decimalFactTarget != applicationFacts.decimalTargetSyntaxID
        || decimalSeparatorByte != applicationFacts.decimalSeparatorByte {
        return compilerStorageLiteralInvalid(storageApplicationCount: applicationFacts.storageApplicationCount, literalApplicationCount: applicationFacts.literalApplicationCount, numericTargetSyntaxID: applicationFacts.numericTargetSyntaxID, decimalTargetSyntaxID: applicationFacts.decimalTargetSyntaxID, decimalSeparatorByte: applicationFacts.decimalSeparatorByte, reason: compilerStorageLiteralReasonInvalidCompilerFormulaFact(), relatedRow: 0 - 1)
    }
    return applicationFacts
}

function compilerTextLiteralReasonNone(): Int { return 0 }
function compilerTextLiteralReasonDuplicateTextStorage(): Int { return 1 }
function compilerTextLiteralReasonDuplicateTextLiteral(): Int { return 2 }
function compilerTextLiteralReasonTextLiteralRequiresStorage(): Int { return 3 }
function compilerTextLiteralReasonTextStorageRequiresLiteral(): Int { return 4 }
function compilerTextLiteralReasonInvalidSemanticElement(): Int { return 5 }
function compilerTextLiteralReasonInvalidEncoding(): Int { return 6 }
function compilerTextLiteralReasonInvalidCodeUnit(): Int { return 7 }
function compilerTextLiteralReasonInvalidPhysicalStorage(): Int { return 8 }

function compilerTextLiteralReasonName(reason: Int): String {
    if reason == compilerTextLiteralReasonDuplicateTextStorage() { return String("duplicateTextStorage") }
    if reason == compilerTextLiteralReasonDuplicateTextLiteral() { return String("duplicateTextLiteral") }
    if reason == compilerTextLiteralReasonTextLiteralRequiresStorage() { return String("textLiteralRequiresStorage") }
    if reason == compilerTextLiteralReasonTextStorageRequiresLiteral() { return String("textStorageRequiresLiteral") }
    if reason == compilerTextLiteralReasonInvalidSemanticElement() { return String("invalidSemanticElement") }
    if reason == compilerTextLiteralReasonInvalidEncoding() { return String("invalidEncoding") }
    if reason == compilerTextLiteralReasonInvalidCodeUnit() { return String("invalidCodeUnit") }
    if reason == compilerTextLiteralReasonInvalidPhysicalStorage() { return String("invalidPhysicalStorage") }
    return String("none")
}

function compilerTextLiteralInvalid(textTargetSyntaxID: Int, semanticElementSyntaxID: Int, encoding: Int, codeUnitBits: Int, codeUnitSignedness: Int, reason: Int, relatedRow: Int): CompilerTextLiteralFacts {
    return CompilerTextLiteralFacts(textTargetSyntaxID: textTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: codeUnitBits, codeUnitSignedness: codeUnitSignedness, reason: reason, relatedRow: relatedRow, isValid: false)
}

function compilerDeclarationNameForSyntaxID(tables: CompilerSyntaxTables, syntaxID: Int): String {
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
    if declarationRow < 0 { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    return compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8))
}

function compilerTextEncodingUTF8Exists(tables: CompilerSyntaxTables): Bool {
    let encodingSyntaxID: Int(compilerSyntaxDeclarationSyntaxIDForTypeName(tables: tables, typeName: String("TextEncoding")))
    if encodingSyntaxID < 0 || compilerIntTableValue(table: tables.syntaxIndex, row: encodingSyntaxID, column: 0) != compilerSyntaxKindEnum() { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: row, column: 2) == encodingSyntaxID
            && compilerIntTableValue(table: tables.members, row: row, column: 12) == compilerSyntaxMemberKindEnumCase() {
            let fileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
            let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: row, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: row, column: 7)))
            if name == String("utf8") { return true }
        }
        row: row + 1
    }
    return false
}

function compilerTextTargetHasUTF8ByteStorage(tables: CompilerSyntaxTables, targetSyntaxID: Int): Bool {
    state matchingStateCount: Int(0)
    state storedStateCount: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: row, column: 2) == targetSyntaxID
            && (compilerIntTableValue(table: tables.members, row: row, column: 12) == compilerSyntaxMemberKindState()
                || compilerIntTableValue(table: tables.members, row: row, column: 12) == compilerSyntaxMemberKindLet()) {
            storedStateCount: storedStateCount + 1
            let fileID: Int(compilerIntTableValue(table: tables.members, row: row, column: 1))
            let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: row, column: 6), localEnd: compilerIntTableValue(table: tables.members, row: row, column: 7)))
            let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.members, row: row, column: 8), localEnd: compilerIntTableValue(table: tables.members, row: row, column: 9)))
            if name == String("bytes") && typeName == String("Buffer<Int<.unsigned, 8>>") {
                matchingStateCount: matchingStateCount + 1
            }
        }
        row: row + 1
    }
    return storedStateCount == 1 && matchingStateCount == 1
}

function compilerTextLiteralFactsResolve(tables: CompilerSyntaxTables): CompilerTextLiteralFacts {
    state storageRow: Int(0 - 1)
    state literalRow: Int(0 - 1)
    state storageTargetSyntaxID: Int(0 - 1)
    state literalTargetSyntaxID: Int(0 - 1)
    state semanticElementSyntaxID: Int(0 - 1)
    state encoding: Int(0 - 1)
    state bits: Int(0 - 1)
    state signedness: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.compilerFormulaFacts) {
        let kind: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 1))
        let category: Int(compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 5))
        if kind == compilerFormulaFactStorage() && category == compilerFormulaStorageText() {
            if storageRow >= 0 {
                return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonDuplicateTextStorage(), relatedRow: row)
            }
            storageRow: row
            storageTargetSyntaxID: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 4)
            semanticElementSyntaxID: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 6)
            encoding: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 7)
            bits: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 8)
            signedness: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 9)
        }
        if kind == compilerFormulaFactLiteral() && category == compilerFormulaLiteralText() {
            if literalRow >= 0 {
                return compilerTextLiteralInvalid(textTargetSyntaxID: literalTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonDuplicateTextLiteral(), relatedRow: row)
            }
            literalRow: row
            literalTargetSyntaxID: compilerIntTableValue(table: tables.compilerFormulaFacts, row: row, column: 4)
        }
        row: row + 1
    }
    if literalRow >= 0 && storageRow < 0 {
        return compilerTextLiteralInvalid(textTargetSyntaxID: literalTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonTextLiteralRequiresStorage(), relatedRow: literalRow)
    }
    if storageRow >= 0 && literalRow < 0 {
        return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonTextStorageRequiresLiteral(), relatedRow: storageRow)
    }
    if storageRow < 0 && literalRow < 0 {
        return CompilerTextLiteralFacts(textTargetSyntaxID: 0 - 1, semanticElementSyntaxID: 0 - 1, encoding: 0 - 1, codeUnitBits: 0 - 1, codeUnitSignedness: 0 - 1, reason: compilerTextLiteralReasonNone(), relatedRow: 0 - 1, isValid: true)
    }
    if storageTargetSyntaxID != literalTargetSyntaxID {
        return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonTextLiteralRequiresStorage(), relatedRow: literalRow)
    }
    if compilerDeclarationNameForSyntaxID(tables: tables, syntaxID: semanticElementSyntaxID) != String("Character") {
        return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonInvalidSemanticElement(), relatedRow: storageRow)
    }
    if encoding != compilerFormulaEncodingUTF8() || !compilerTextEncodingUTF8Exists(tables: tables) {
        return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonInvalidEncoding(), relatedRow: storageRow)
    }
    if bits != 8 || signedness != compilerFormulaSignednessUnsigned() {
        return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonInvalidCodeUnit(), relatedRow: storageRow)
    }
    if !compilerTextTargetHasUTF8ByteStorage(tables: tables, targetSyntaxID: storageTargetSyntaxID) {
        return compilerTextLiteralInvalid(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonInvalidPhysicalStorage(), relatedRow: storageRow)
    }
    return CompilerTextLiteralFacts(textTargetSyntaxID: storageTargetSyntaxID, semanticElementSyntaxID: semanticElementSyntaxID, encoding: encoding, codeUnitBits: bits, codeUnitSignedness: signedness, reason: compilerTextLiteralReasonNone(), relatedRow: 0 - 1, isValid: true)
}

function compilerIntegerTypeSignedness(typeName: String): Int {
    if compilerBodyArenaTypeOuterName(typeName: typeName) != String("Int")
        || compilerBodyArenaGenericArgumentCount(typeName: typeName) != 2 { return 0 - 1 }
    let first: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 0))
    let second: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 1))
    let firstRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: first, start: 0, end: stringLength(value: first)))
    let secondRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: second, start: 0, end: stringLength(value: second)))
    if firstRange.start < 0 || secondRange.start < 0 { return 0 - 1 }
    if compilerSemanticStringRangeEqualsText(text: first, start: firstRange.start, end: firstRange.end, literal: String(".signed"))
        && compilerCoreParseDecimalInt(value: second.substring(start: secondRange.start, end: secondRange.end)) > 0 {
        return compilerFormulaSignednessSigned()
    }
    if compilerSemanticStringRangeEqualsText(text: first, start: firstRange.start, end: firstRange.end, literal: String(".unsigned"))
        && compilerCoreParseDecimalInt(value: second.substring(start: secondRange.start, end: secondRange.end)) > 0 {
        return compilerFormulaSignednessUnsigned()
    }
    return 0 - 1
}

function compilerIntegerTypeIsSigned(typeName: String): Bool {
    return compilerIntegerTypeSignedness(typeName: typeName) == compilerFormulaSignednessSigned()
}

function compilerIntegerTypeIsUnsigned8(typeName: String): Bool {
    if compilerIntegerTypeSignedness(typeName: typeName) != compilerFormulaSignednessUnsigned() { return false }
    let first: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 0))
    let second: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 1))
    let firstRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: first, start: 0, end: stringLength(value: first)))
    let secondRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: second, start: 0, end: stringLength(value: second)))
    if firstRange.start < 0 || secondRange.start < 0 { return false }
    return compilerSemanticStringRangeEqualsText(text: first, start: firstRange.start, end: firstRange.end, literal: String("8"))
        || compilerSemanticStringRangeEqualsText(text: second, start: secondRange.start, end: secondRange.end, literal: String("8"))
}

function compilerFloatTypeBitWidth(typeName: String): Int {
    if compilerBodyArenaTypeOuterName(typeName: typeName) != String("Float")
        || compilerBodyArenaGenericArgumentCount(typeName: typeName) != 1 { return 0 - 1 }
    let bits: String(compilerBodyArenaGenericArgumentText(typeName: typeName, ordinal: 0))
    let bitsRange: CompilerSourceRange(compilerSemanticTrimStringRange(text: bits, start: 0, end: stringLength(value: bits)))
    if bitsRange.start < 0 { return 0 - 1 }
    if compilerSemanticStringRangeEqualsText(text: bits, start: bitsRange.start, end: bitsRange.end, literal: String("32")) { return 32 }
    if compilerSemanticStringRangeEqualsText(text: bits, start: bitsRange.start, end: bitsRange.end, literal: String("64")) { return 64 }
    return 0 - 1
}

function compilerFloatTypeIs32(typeName: String): Bool {
    return compilerFloatTypeBitWidth(typeName: typeName) == 32
}

function compilerFloatTypeIs64(typeName: String): Bool {
    return compilerFloatTypeBitWidth(typeName: typeName) == 64
}

function compilerMacroDiagnosticsOperationForName(name: String): Int {
    if name == String("information") { return compilerMacroOperationInformation() }
    if name == String("warning") { return compilerMacroOperationWarning() }
    if name == String("hint") { return compilerMacroOperationHint() }
    if name == String("error") { return compilerMacroOperationError() }
    return 0
}

function compilerMacroGraphOperationForName(name: String): Int {
    if name == String("declarationCount") { return compilerMacroGraphOperationDeclarationCount() }
    return 0
}

function compilerMacroTargetOperationForName(name: String): Int {
    if name == String("omit") { return compilerMacroTargetOperationOmit() }
    if name == String("memberCount") { return compilerMacroTargetOperationMemberCount() }
    return 0
}

function compilerMacroDiagnosticsSeverityForOperation(operation: Int): Int {
    if operation == compilerMacroOperationInformation() { return compilerMacroSeverityInformation() }
    if operation == compilerMacroOperationWarning() { return compilerMacroSeverityWarning() }
    if operation == compilerMacroOperationHint() { return compilerMacroSeverityHint() }
    if operation == compilerMacroOperationError() { return compilerMacroSeverityError() }
    return 0
}

function compilerMacroCapabilityTypeKind(kind: Int): Int {
    if kind == compilerMacroCapabilityTarget() { return compilerBodyTypeMacroTarget() }
    if kind == compilerMacroCapabilityDiagnostics() { return compilerBodyTypeMacroDiagnostics() }
    if kind == compilerMacroCapabilityGraph() { return compilerBodyTypeMacroGraph() }
    return compilerBodyTypeUnknown()
}

function compilerMacroCapabilityKindForTypeKind(typeKind: Int): Int {
    if typeKind == compilerBodyTypeMacroTarget() { return compilerMacroCapabilityTarget() }
    if typeKind == compilerBodyTypeMacroDiagnostics() { return compilerMacroCapabilityDiagnostics() }
    if typeKind == compilerBodyTypeMacroGraph() { return compilerMacroCapabilityGraph() }
    return 0
}

function compilerBodyArenaTypeKindForName(arena: CompilerBodyArena, typeName: String): Int {
    if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        let capabilityCount: Int(compilerIntTableRowCount(table: arena.tables.macroCapabilities))
        state capabilityRow: Int(0)
        while capabilityRow < capabilityCount {
            if compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 1) == arena.ownerDeclarationSyntaxID {
                let declarationFileID: Int(compilerIntTableValue(table: arena.tables.macroDeclarations, row: arena.ownerDeclarationSyntaxID, column: 1))
                let capabilityName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: declarationFileID, localStart: compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 4), localEnd: compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 5)))
                if capabilityName == typeName { return compilerMacroCapabilityTypeKind(kind: compilerIntTableValue(table: arena.tables.macroCapabilities, row: capabilityRow, column: 3)) }
            }
            capabilityRow: capabilityRow + 1
        }
    }
    if typeName == String("Int") || compilerIntegerTypeIsSigned(typeName: typeName) { return compilerBodyTypeInt() }
    if compilerIntegerTypeIsUnsigned8(typeName: typeName) { return compilerBodyTypeUnsigned8() }
    if typeName == String("Bool") { return compilerBodyTypeBool() }
    if typeName == String("String") { return compilerBodyTypeString() }
    if compilerFloatTypeIs32(typeName: typeName) { return compilerBodyTypeFloat32() }
    if compilerFloatTypeIs64(typeName: typeName) { return compilerBodyTypeFloat() }
    if typeName == String("Float") { return compilerBodyTypeFloat() }
    if typeName == String("Void") { return compilerBodyTypeVoid() }
    if typeName == String("@syntax") { return compilerBodyTypeMacroTarget() }
    if compilerBodyRuntimeABITypeIsOpaque(tables: arena.tables, typeName: typeName) { return compilerBodyTypeConstruct() }
    let outerName: String(compilerBodyArenaTypeOuterName(typeName: typeName))
    let qualifiedSyntaxID: Int(compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
        tables: arena.tables,
        typeName: outerName,
        scopeSyntaxID: 0 - 1
    ))
    if qualifiedSyntaxID >= 0 && qualifiedSyntaxID < compilerIntTableRowCount(table: arena.tables.syntaxIndex) {
        let qualifiedKind: Int(compilerIntTableValue(table: arena.tables.syntaxIndex, row: qualifiedSyntaxID, column: 0))
        if qualifiedKind == compilerSyntaxKindConstruct() { return compilerBodyTypeConstruct() }
        if qualifiedKind == compilerSyntaxKindEnum() { return compilerBodyTypeEnum() }
    }
    if compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: outerName, kindTag: compilerSyntaxKindConstruct()) >= 0 { return compilerBodyTypeConstruct() }
    if compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: outerName, kindTag: compilerSyntaxKindEnum()) >= 0 { return compilerBodyTypeEnum() }
    if outerName == String("Optional") { return compilerBodyTypeConstruct() }
    return compilerBodyTypeUnknown()
}

function compilerBodyArenaTypeByteIsWhitespace(byte: Int): Bool {
    return byte == 9 || byte == 10 || byte == 13 || byte == 32
}

function compilerBodyArenaTypeInvalidRange(): CompilerSourceRange {
    return CompilerSourceRange(start: 0 - 1, end: 0 - 1, next: 0 - 1)
}

function compilerBodyArenaTypeRangeFromGlobal(arena: CompilerBodyArena, fileID: Int, globalStart: Int, globalEnd: Int): CompilerSourceRange {
    let localStart: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: fileID, globalOffset: globalStart))
    let localEnd: Int(compilerSourceStoreFileLocalOffsetForFileID(store: arena.tables.sourceStore, fileID: fileID, globalOffset: globalEnd))
    if localStart < 0 || localEnd <= localStart { return compilerBodyArenaTypeInvalidRange() }
    return CompilerSourceRange(start: localStart, end: localEnd, next: localEnd)
}

function compilerBodyArenaNormalizedTypeRange(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): CompilerSourceRange {
    let invalidRange: CompilerSourceRange(compilerBodyArenaTypeInvalidRange())
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: start))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: end))
    if globalStart < 0 || globalEnd <= globalStart { return invalidRange }
    state trimmedGlobalStart: Int(globalStart)
    while trimmedGlobalStart < globalEnd
        && compilerBodyArenaTypeByteIsWhitespace(byte: stringByteAt(source: arena.tables.sourceStore.source, index: trimmedGlobalStart)) {
        trimmedGlobalStart: trimmedGlobalStart + 1
    }
    state trimmedGlobalEnd: Int(globalEnd)
    while trimmedGlobalEnd > trimmedGlobalStart
        && compilerBodyArenaTypeByteIsWhitespace(byte: stringByteAt(source: arena.tables.sourceStore.source, index: trimmedGlobalEnd - 1)) {
        trimmedGlobalEnd: trimmedGlobalEnd - 1
    }
    return compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: trimmedGlobalStart, globalEnd: trimmedGlobalEnd)
}

function compilerBodyArenaTypeGenericStartGlobal(arena: CompilerBodyArena, fileID: Int, typeRange: CompilerSourceRange): Int {
    if typeRange.start < 0 || typeRange.end <= typeRange.start { return 0 - 1 }
    let globalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: typeRange.start))
    let globalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: typeRange.end))
    if globalStart < 0 || globalEnd <= globalStart { return 0 - 1 }
    state cursor: Int(globalStart)
    while cursor < globalEnd {
        if stringByteAt(source: arena.tables.sourceStore.source, index: cursor) == 60 { return cursor }
        cursor: cursor + 1
    }
    return 0 - 1
}

function compilerBodyArenaTypeOuterRangeForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): CompilerSourceRange {
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return normalizedRange }
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    if genericStartGlobal < 0 { return normalizedRange }
    let normalizedGlobalStart: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.start))
    state outerGlobalEnd: Int(genericStartGlobal)
    while outerGlobalEnd > normalizedGlobalStart
        && compilerBodyArenaTypeByteIsWhitespace(byte: stringByteAt(source: arena.tables.sourceStore.source, index: outerGlobalEnd - 1)) {
        outerGlobalEnd: outerGlobalEnd - 1
    }
    return compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: normalizedGlobalStart, globalEnd: outerGlobalEnd)
}

function compilerBodyArenaTypeArgumentCountForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return 0 - 1 }
    let normalizedGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.end))
    if normalizedGlobalEnd > 0 && stringByteAt(source: arena.tables.sourceStore.source, index: normalizedGlobalEnd - 1) == 63 { return 1 }
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    if genericStartGlobal < 0 { return 0 }
    if normalizedGlobalEnd <= genericStartGlobal + 1 { return 0 - 1 }
    state depth: Int(0)
    state argumentCount: Int(1)
    state argumentStart: Int(genericStartGlobal + 1)
    state cursor: Int(genericStartGlobal + 1)
    state sawClosing: Bool(false)
    state valid: Bool(true)
    while cursor < normalizedGlobalEnd && !sawClosing && valid {
        let byte: Int(stringByteAt(source: arena.tables.sourceStore.source, index: cursor))
        if byte == 60 {
            depth: depth + 1
        } else if byte == 62 {
            if depth > 0 {
                depth: depth - 1
            } else {
                let argumentRange: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
                if argumentRange.start < 0 || cursor + 1 != normalizedGlobalEnd { valid: false } else { sawClosing: true }
            }
        } else if byte == 44 && depth == 0 {
            let argumentRange: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
            if argumentRange.start < 0 {
                valid: false
            } else {
                argumentCount: argumentCount + 1
                argumentStart: cursor + 1
            }
        }
        cursor: cursor + 1
    }
    if !valid || !sawClosing || depth != 0 { return 0 - 1 }
    return argumentCount
}

function compilerBodyArenaTypeArgumentRangeForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int, ordinal: Int): CompilerSourceRange {
    let invalidRange: CompilerSourceRange(compilerBodyArenaTypeInvalidRange())
    if ordinal < 0 { return invalidRange }
    let argumentCount: Int(compilerBodyArenaTypeArgumentCountForSpan(arena: arena, fileID: fileID, start: start, end: end))
    if argumentCount < 0 || ordinal >= argumentCount { return invalidRange }
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    let shorthandGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.end))
    if argumentCount == 1 && ordinal == 0 && shorthandGlobalEnd > 0
        && stringByteAt(source: arena.tables.sourceStore.source, index: shorthandGlobalEnd - 1) == 63 {
        return CompilerSourceRange(start: normalizedRange.start, end: normalizedRange.end - 1, next: normalizedRange.end - 1)
    }
    let genericStartGlobal: Int(compilerBodyArenaTypeGenericStartGlobal(arena: arena, fileID: fileID, typeRange: normalizedRange))
    let normalizedGlobalEnd: Int(compilerSourceStoreGlobalOffset(store: arena.tables.sourceStore, fileID: fileID, localOffset: normalizedRange.end))
    state depth: Int(0)
    state argumentOrdinal: Int(0)
    state argumentStart: Int(genericStartGlobal + 1)
    state candidateStart: Int(0 - 1)
    state candidateEnd: Int(0 - 1)
    state cursor: Int(genericStartGlobal + 1)
    while cursor < normalizedGlobalEnd {
        let byte: Int(stringByteAt(source: arena.tables.sourceStore.source, index: cursor))
        if byte == 60 {
            depth: depth + 1
        } else if byte == 62 {
            if depth > 0 {
                depth: depth - 1
            } else {
                if argumentOrdinal == ordinal {
                    let candidate: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
                    candidateStart: candidate.start
                    candidateEnd: candidate.end
                }
                cursor: normalizedGlobalEnd
            }
        } else if byte == 44 && depth == 0 {
            if argumentOrdinal == ordinal {
                let candidate: CompilerSourceRange(compilerBodyArenaTypeRangeFromGlobal(arena: arena, fileID: fileID, globalStart: argumentStart, globalEnd: cursor))
                candidateStart: candidate.start
                candidateEnd: candidate.end
            }
            argumentOrdinal: argumentOrdinal + 1
            argumentStart: cursor + 1
        }
        cursor: cursor + 1
    }
    if candidateStart < 0 || candidateEnd <= candidateStart { return invalidRange }
    return CompilerSourceRange(start: candidateStart, end: candidateEnd, next: candidateEnd)
}

function compilerBodyArenaTypeKindForSpan(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
    if arena.ownerKind == compilerBodyArenaOwnerMacro() {
        let macroTypeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: start, localEnd: end))
        return compilerBodyArenaTypeKindForName(arena: arena, typeName: macroTypeName)
    }
    let normalizedRange: CompilerSourceRange(compilerBodyArenaNormalizedTypeRange(arena: arena, fileID: fileID, start: start, end: end))
    if normalizedRange.start < 0 { return compilerBodyTypeUnknown() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Int")) { return compilerBodyTypeInt() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Bool")) { return compilerBodyTypeBool() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("String")) { return compilerBodyTypeString() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Float")) { return compilerBodyTypeFloat() }
    if compilerSemanticLocalRangeEqualsText(tables: arena.tables, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end, text: String("Void")) { return compilerBodyTypeVoid() }
    let normalizedTypeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: normalizedRange.start, localEnd: normalizedRange.end))
    if compilerIntegerTypeIsUnsigned8(typeName: normalizedTypeName) { return compilerBodyTypeUnsigned8() }
    if compilerIntegerTypeIsSigned(typeName: normalizedTypeName) { return compilerBodyTypeInt() }
    if compilerFloatTypeIs32(typeName: normalizedTypeName) { return compilerBodyTypeFloat32() }
    if compilerFloatTypeIs64(typeName: normalizedTypeName) { return compilerBodyTypeFloat() }
    if normalizedTypeName == String("@syntax") { return compilerBodyTypeMacroTarget() }
    let outerName: String(compilerBodyArenaTypeOuterName(typeName: normalizedTypeName))
    if outerName == String("Optional") {
        let optionalEnumRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: outerName, kindTag: compilerSyntaxKindEnum()))
        if optionalEnumRow >= 0 { return compilerBodyTypeEnum() }
    }
    let outerRange: CompilerSourceRange(compilerBodyArenaTypeOuterRangeForSpan(arena: arena, fileID: fileID, start: normalizedRange.start, end: normalizedRange.end))
    if outerRange.start < 0 { return compilerBodyTypeUnknown() }
    state declarationSyntaxID: Int(compilerDeclarationIndexLocalRangeSyntaxID(tables: arena.tables, index: arena.declarationIndex, fileID: fileID, start: outerRange.start, end: outerRange.end, kindTag: compilerSyntaxKindConstruct()))
    if declarationSyntaxID < 0 {
        declarationSyntaxID: compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
            tables: arena.tables,
            typeName: compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: outerRange.start, localEnd: outerRange.end),
            scopeSyntaxID: 0 - 1
        )
        if declarationSyntaxID >= 0
            && (declarationSyntaxID >= compilerIntTableRowCount(table: arena.tables.syntaxIndex)
                || compilerIntTableValue(table: arena.tables.syntaxIndex, row: declarationSyntaxID, column: 0) != compilerSyntaxKindConstruct()) {
            declarationSyntaxID: 0 - 1
        }
    }
    if declarationSyntaxID >= 0 { return compilerBodyTypeConstruct() }
    state enumSyntaxID: Int(compilerDeclarationIndexLocalRangeSyntaxID(tables: arena.tables, index: arena.declarationIndex, fileID: fileID, start: outerRange.start, end: outerRange.end, kindTag: compilerSyntaxKindEnum()))
    if enumSyntaxID < 0 {
        enumSyntaxID: compilerSyntaxDeclarationSyntaxIDForQualifiedTypeNameInScope(
            tables: arena.tables,
            typeName: compilerTypedSyntaxLocalText(tables: arena.tables, fileID: fileID, localStart: outerRange.start, localEnd: outerRange.end),
            scopeSyntaxID: 0 - 1
        )
        if enumSyntaxID >= 0
            && (enumSyntaxID >= compilerIntTableRowCount(table: arena.tables.syntaxIndex)
                || compilerIntTableValue(table: arena.tables.syntaxIndex, row: enumSyntaxID, column: 0) != compilerSyntaxKindEnum()) {
            enumSyntaxID: 0 - 1
        }
    }
    if enumSyntaxID >= 0 { return compilerBodyTypeEnum() }
    if outerName == String("Optional") { return compilerBodyTypeConstruct() }
    return compilerBodyTypeUnknown()
}

function compilerBodyArenaTypeArgumentCountForTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    state count: Int(0)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.typeArguments) {
        if compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID { count: count + 1 }
        row: row + 1
    }
    return count
}

function compilerBodyArenaTypeArgumentValueForTypeID(arena: CompilerBodyArena, typeID: Int, ordinal: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) || ordinal < 0 { return 0 - 1 }
    state matches: Int(0)
    state value: Int(0 - 1)
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.typeArguments) {
        if compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID
            && compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentOrdinalColumn()) == ordinal {
            matches: matches + 1
            value: compilerIntTableValue(table: arena.typeArguments, row: row, column: compilerBodyTypeArgumentValueTypeInstanceColumn())
        }
        row: row + 1
    }
    if matches != 1 { return 0 - 1 }
    return value
}

function compilerBodyArenaTypeArgumentExpectedCountForTypeID(arena: CompilerBodyArena, typeID: Int): Int {
    if typeID < 0 || typeID >= compilerIntTableRowCount(table: arena.typeInstances) { return 0 - 1 }
    let nominalSyntaxID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()))
    if nominalSyntaxID == compilerBodyBuiltinArraySyntaxID() { return 1 }
    if nominalSyntaxID == compilerBodyBuiltinOptionalSyntaxID() { return 1 }
    if nominalSyntaxID >= 0 {
        let genericCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: nominalSyntaxID))
        if genericCount > 0 { return genericCount }
    }
    let typeFileID: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceFileColumn()))
    let typeStart: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceStartColumn()))
    let typeEnd: Int(compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceEndColumn()))
    let typeName: String(compilerTypedSyntaxLocalText(tables: arena.tables, fileID: typeFileID, localStart: typeStart, localEnd: typeEnd))
    if compilerBodyArenaTypeOuterName(typeName: typeName) == String("Optional") { return 1 }
    return 0
}

function compilerBodyArenaTypeInstanceArgumentsMatch(arena: CompilerBodyArena, typeID: Int, argumentCount: Int, argumentIDs: Buffer<Int>): Bool {
    if compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID) != argumentCount { return false }
    state ordinal: Int(0)
    while ordinal < argumentCount {
        if compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: typeID, ordinal: ordinal) != argumentIDs.element(index: ordinal) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaTypeIDsEquivalent(arena: CompilerBodyArena, leftTypeID: Int, rightTypeID: Int): Bool {
    if leftTypeID == rightTypeID { return leftTypeID >= 0 }
    if leftTypeID < 0 || rightTypeID < 0
        || leftTypeID >= compilerIntTableRowCount(table: arena.typeInstances)
        || rightTypeID >= compilerIntTableRowCount(table: arena.typeInstances)
        || compilerIntTableValue(table: arena.typeInstances, row: leftTypeID, column: compilerBodyTypeInstanceKindColumn())
            != compilerIntTableValue(table: arena.typeInstances, row: rightTypeID, column: compilerBodyTypeInstanceKindColumn())
        || compilerIntTableValue(table: arena.typeInstances, row: leftTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn())
            != compilerIntTableValue(table: arena.typeInstances, row: rightTypeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()) { return false }
    let leftArgumentCount: Int(compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: leftTypeID))
    let rightArgumentCount: Int(compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: rightTypeID))
    if leftArgumentCount < 0 || leftArgumentCount != rightArgumentCount { return false }
    state ordinal: Int(0)
    while ordinal < leftArgumentCount {
        if !compilerBodyArenaTypeIDsEquivalent(
            arena: arena,
            leftTypeID: compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: leftTypeID, ordinal: ordinal),
            rightTypeID: compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: rightTypeID, ordinal: ordinal)
        ) { return false }
        ordinal: ordinal + 1
    }
    return true
}

function compilerBodyArenaTypeInstanceFind(arena: CompilerBodyArena, typeKind: Int, nominalSyntaxID: Int, argumentCount: Int, argumentIDs: Buffer<Int>): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.typeInstances) {
        if compilerIntTableValue(table: arena.typeInstances, row: row, column: compilerBodyTypeInstanceKindColumn()) == typeKind
            && compilerIntTableValue(table: arena.typeInstances, row: row, column: compilerBodyTypeInstanceNominalSyntaxColumn()) == nominalSyntaxID
            && compilerBodyArenaTypeInstanceArgumentsMatch(arena: arena, typeID: row, argumentCount: argumentCount, argumentIDs: argumentIDs) { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaArrayDeclarationSyntaxID(arena: CompilerBodyArena): Int {
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: String("Array"), kindTag: compilerSyntaxKindConstruct()))
    if declarationRow < 0 { return compilerBodyBuiltinArraySyntaxID() }
    let syntaxID: Int(compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0))
    if !compilerNominalDeclarationIsArray(tables: arena.tables, declarationRow: declarationRow) { return compilerBodyBuiltinArraySyntaxID() }
    return syntaxID
}

function compilerBodyArenaStringDeclarationSyntaxID(arena: CompilerBodyArena): Int {
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: arena.tables, index: arena.declarationIndex, name: String("String"), kindTag: compilerSyntaxKindConstruct()))
    if declarationRow < 0
        || compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 13) != compilerBuiltinPolicyStorage() { return 0 - 1 }
    return compilerIntTableValue(table: arena.tables.declarations, row: declarationRow, column: 0)
}

function compilerBodyArenaTypeInstanceInternStructuralAtSpan(arena: CompilerBodyArena, typeKind: Int, nominalSyntaxID: Int, fileID: Int, start: Int, end: Int, argumentIDs: Buffer<Int>): Int {
    if typeKind <= compilerBodyTypeUnknown() || typeKind > compilerBodyTypeLast()
        || fileID < 0 || start < 0 || end < start { return 0 - 1 }
    let argumentCount: Int(argumentIDs.count)
    let existing: Int(compilerBodyArenaTypeInstanceFind(arena: arena, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: argumentCount, argumentIDs: argumentIDs))
    if existing >= 0 { return existing }
    let typeID: Int(compilerIntTableRowCount(table: arena.typeInstances))
    if compilerIntTableAppend(table: arena.typeInstances, value: typeID) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: fileID) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: start) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: end) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: typeKind) != 0
        || compilerIntTableAppend(table: arena.typeInstances, value: nominalSyntaxID) != 0
        || compilerBodyArenaAppendTypeArguments(arena: arena, typeID: typeID, argumentIDs: argumentIDs) != 0 { return 0 - 1 }
    return typeID
}

function compilerBodyArenaTypeInstanceInternStructural(arena: CompilerBodyArena, typeKind: Int, nominalSyntaxID: Int, sourceNodeID: Int, argumentIDs: Buffer<Int>): Int {
    if sourceNodeID < 0 || sourceNodeID >= compilerIntTableRowCount(table: arena.nodes) { return 0 - 1 }
    return compilerBodyArenaTypeInstanceInternStructuralAtSpan(arena: arena, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, fileID: arena.fileID, start: compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 4), end: compilerIntTableValue(table: arena.nodes, row: sourceNodeID, column: 5), argumentIDs: argumentIDs)
}

function compilerBodyArenaExpressionConcreteTypeID(arena: CompilerBodyArena, nodeID: Int): Int {
    let resolvedTypeID: Int(compilerBodyArenaExpressionTypeID(arena: arena, nodeID: nodeID))
    if resolvedTypeID >= 0 { return resolvedTypeID }
    let typeKind: Int(compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: nodeID))
    if typeKind != compilerBodyTypeInt() && typeKind != compilerBodyTypeUnsigned8() && typeKind != compilerBodyTypeBool() && typeKind != compilerBodyTypeFloat() && typeKind != compilerBodyTypeFloat32() && typeKind != compilerBodyTypeString() { return 0 - 1 }
    let noArguments: Buffer<Int>(bufferCreateInt(capacity: 0))
    let typeID: Int(compilerBodyArenaTypeInstanceInternStructural(arena: arena, typeKind: typeKind, nominalSyntaxID: 0 - 1, sourceNodeID: nodeID, argumentIDs: noArguments))
    noArguments.destroy()
    return typeID
}

function compilerBodyArenaArrayTypeID(arena: CompilerBodyArena, sourceNodeID: Int, elementTypeID: Int): Int {
    let arraySyntaxID: Int(compilerBodyArenaArrayDeclarationSyntaxID(arena: arena))
    if arraySyntaxID == 0 - 1 || elementTypeID < 0 { return 0 - 1 }
    let arguments: Buffer<Int>(bufferCreateInt(capacity: 1))
    if arguments.append(element: elementTypeID) != 0 {
        arguments.destroy()
        return 0 - 1
    }
    let typeID: Int(compilerBodyArenaTypeInstanceInternStructural(arena: arena, typeKind: compilerBodyTypeConstruct(), nominalSyntaxID: arraySyntaxID, sourceNodeID: sourceNodeID, argumentIDs: arguments))
    arguments.destroy()
    return typeID
}

function compilerBodyArenaTypeIDForMemberTypeReference(arena: CompilerBodyArena, receiverTypeID: Int, ownerSyntaxID: Int, typeReferenceID: Int, fileID: Int, start: Int, end: Int): Int {
    if typeReferenceID < 0 || typeReferenceID >= compilerIntTableRowCount(table: arena.tables.typeReferences) { return 0 - 1 }
    let referenceKind: Int(compilerIntTableValue(table: arena.tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceKindColumn()))
    let targetKind: Int(compilerIntTableValue(table: arena.tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetKindColumn()))
    let targetID: Int(compilerIntTableValue(table: arena.tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetIDColumn()))
    if targetKind == compilerSyntaxTypeReferenceTargetGenericParameter() {
        if receiverTypeID < 0 || targetID < 0 || targetID >= compilerIntTableRowCount(table: arena.tables.genericParameters)
            || compilerIntTableValue(table: arena.tables.genericParameters, row: targetID, column: compilerSyntaxGenericParameterOwnerColumn()) != ownerSyntaxID { return 0 - 1 }
        return compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: receiverTypeID, ordinal: compilerIntTableValue(table: arena.tables.genericParameters, row: targetID, column: compilerSyntaxGenericParameterOrdinalColumn()))
    }
    state typeKind: Int(compilerBodyTypeUnknown())
    state nominalSyntaxID: Int(0 - 1)
    if referenceKind == compilerSyntaxTypeReferenceOptional()
        && targetKind == compilerSyntaxTypeReferenceTargetNone() {
        typeKind: compilerBodyTypeConstruct()
        nominalSyntaxID: compilerBodyBuiltinOptionalSyntaxID()
    } else if targetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
        if targetID == compilerSyntaxBuiltinTypeInt() { typeKind: compilerBodyTypeInt() }
        if targetID == compilerSyntaxBuiltinTypeBool() { typeKind: compilerBodyTypeBool() }
        if targetID == compilerSyntaxBuiltinTypeString() { typeKind: compilerBodyTypeString() }
        if targetID == compilerSyntaxBuiltinTypeFloat() { typeKind: compilerBodyTypeFloat() }
    } else if targetKind == compilerSyntaxTypeReferenceTargetDeclaration() {
        if targetID < 0 || targetID >= compilerIntTableRowCount(table: arena.tables.syntaxIndex) { return 0 - 1 }
        nominalSyntaxID: targetID
        let declarationKind: Int(compilerIntTableValue(table: arena.tables.syntaxIndex, row: targetID, column: 0))
        if declarationKind == compilerSyntaxKindConstruct() { typeKind: compilerBodyTypeConstruct() }
        if declarationKind == compilerSyntaxKindEnum() { typeKind: compilerBodyTypeEnum() }
    }
    if typeKind == compilerBodyTypeUnknown() { return 0 - 1 }
    let argumentIDs: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableValue(table: arena.tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceChildCountColumn()) + 1))
    state childOrdinal: Int(0)
    state childRow: Int(typeReferenceID + 1)
    while childRow < compilerIntTableRowCount(table: arena.tables.typeReferences) {
        if compilerIntTableValue(table: arena.tables.typeReferences, row: childRow, column: compilerSyntaxTypeReferenceParentColumn()) == typeReferenceID {
            if compilerIntTableValue(table: arena.tables.typeReferences, row: childRow, column: compilerSyntaxTypeReferenceOrdinalColumn()) != childOrdinal
                || compilerIntTableValue(table: arena.tables.typeReferences, row: childRow, column: compilerSyntaxTypeReferenceKindColumn()) == compilerSyntaxTypeReferenceValue() {
                argumentIDs.destroy()
                return 0 - 1
            }
            let childTypeID: Int(compilerBodyArenaTypeIDForMemberTypeReference(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, typeReferenceID: childRow, fileID: fileID, start: start, end: end))
            if childTypeID < 0 || argumentIDs.append(element: childTypeID) != 0 {
                argumentIDs.destroy()
                return 0 - 1
            }
            childOrdinal: childOrdinal + 1
        }
        childRow: childRow + 1
    }
    let expectedChildCount: Int(compilerIntTableValue(table: arena.tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceChildCountColumn()))
    if childOrdinal != expectedChildCount {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerBodyArenaAppendDefaultTypeArguments(arena: arena, nominalSyntaxID: nominalSyntaxID, argumentIDs: argumentIDs) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    let typeID: Int(compilerBodyArenaTypeInstanceInternStructuralAtSpan(arena: arena, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, fileID: fileID, start: start, end: end, argumentIDs: argumentIDs))
    argumentIDs.destroy()
    return typeID
}

function compilerBodyTypeReferenceContainsGenericParameter(tables: CompilerSyntaxTables, typeReferenceID: Int): Bool {
    if typeReferenceID < 0 || typeReferenceID >= compilerIntTableRowCount(table: tables.typeReferences) { return false }
    if compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetKindColumn())
        == compilerSyntaxTypeReferenceTargetGenericParameter() { return true }
    if compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceChildCountColumn()) == 0 {
        return false
    }
    let ownerMemberRow: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceOwnerColumn()))
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.typeReferences) {
        if compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceOwnerColumn()) == ownerMemberRow
            && compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetKindColumn())
            == compilerSyntaxTypeReferenceTargetGenericParameter() { return true }
        row: row + 1
    }
    return false
}

function compilerBodyOptionalTypeReferenceHasGenericPayload(tables: CompilerSyntaxTables, typeReferenceID: Int): Bool {
    if typeReferenceID < 0 || typeReferenceID >= compilerIntTableRowCount(table: tables.typeReferences)
        || compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceKindColumn())
            != compilerSyntaxTypeReferenceOptional() { return false }
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.typeReferences) {
        if compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceParentColumn()) == typeReferenceID
            && compilerIntTableValue(table: tables.typeReferences, row: row, column: compilerSyntaxTypeReferenceTargetKindColumn())
                == compilerSyntaxTypeReferenceTargetGenericParameter() {
            return true
        }
        row: row + 1
    }
    return false
}

function compilerBodyArenaTypeIDForMemberRow(arena: CompilerBodyArena, receiverTypeID: Int, memberRow: Int): Int {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: arena.tables.members) { return 0 - 1 }
    let fileID: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 1))
    let start: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 8))
    let end: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 9))
    if arena.ownerKind == compilerBodyArenaOwnerMacro()
        && compilerSyntaxMemberMacroFamilyName(tables: arena.tables, memberRow: memberRow) != String("") {
        return compilerBodyArenaTypeIDForSpan(
            arena: arena,
            fileID: fileID,
            start: start,
            end: end
        )
    }
    if compilerBodyArenaTypeKindForSpan(arena: arena, fileID: fileID, start: start, end: end)
        == compilerBodyTypeMacroTarget() {
        return compilerBodyArenaTypeInstanceIntern(
            arena: arena,
            fileID: fileID,
            start: start,
            end: end
        )
    }
    if compilerBodyArenaIsCompileTime(arena: arena) {
        let memberTypeText: String(compilerTypedSyntaxLocalText(
            tables: arena.tables,
            fileID: fileID,
            localStart: start,
            localEnd: end
        ))
        if stringIndexOf(source: memberTypeText, needle: String("@"), start: 0) >= 0 {
            let compileTimeCollectionTypeID: Int(compilerBodyArenaTypeInstanceIntern(
                arena: arena,
                fileID: fileID,
                start: start,
                end: end
            ))
            if compileTimeCollectionTypeID >= 0 {
                return compileTimeCollectionTypeID
            }
        }
    }
    if !compilerSyntaxMemberHasTypeReference(tables: arena.tables, memberRow: memberRow)
        || compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 14) != compilerSyntaxTypeTargetReference() { return 0 - 1 }
    let typeReferenceID: Int(compilerIntTableValue(table: arena.tables.members, row: memberRow, column: 15))
    let ownerSyntaxID: Int(compilerSyntaxMemberTypeOwnerSyntaxID(tables: arena.tables, memberRow: memberRow))
    let referenceKind: Int(compilerIntTableValue(table: arena.tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceKindColumn()))
    let optionalPayloadIsOwnerGeneric: Bool(
        compilerBodyOptionalTypeReferenceHasGenericPayload(
            tables: arena.tables,
            typeReferenceID: typeReferenceID
        )
    )
    if optionalPayloadIsOwnerGeneric
        || compilerBodyTypeReferenceContainsGenericParameter(tables: arena.tables, typeReferenceID: typeReferenceID) {
        return compilerBodyArenaTypeIDForMemberTypeReference(
            arena: arena,
            receiverTypeID: receiverTypeID,
            ownerSyntaxID: ownerSyntaxID,
            typeReferenceID: typeReferenceID,
            fileID: fileID,
            start: start,
            end: end
        )
    }
    let concreteTypeID: Int(compilerBodyArenaTypeInstanceIntern(arena: arena, fileID: fileID, start: start, end: end))
    if referenceKind == compilerSyntaxTypeReferenceOptional()
        && !compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: concreteTypeID) {
        return compilerBodyArenaTypeIDForMemberTypeReference(
            arena: arena,
            receiverTypeID: receiverTypeID,
            ownerSyntaxID: ownerSyntaxID,
            typeReferenceID: typeReferenceID,
            fileID: fileID,
            start: start,
            end: end
        )
    }
    if concreteTypeID >= 0 { return concreteTypeID }
    return compilerBodyArenaTypeIDForMemberTypeReference(arena: arena, receiverTypeID: receiverTypeID, ownerSyntaxID: ownerSyntaxID, typeReferenceID: typeReferenceID, fileID: fileID, start: start, end: end)
}

function compilerBodyArenaTypeIDIsArray(arena: CompilerBodyArena, typeID: Int): Bool {
    return typeID >= 0 && typeID < compilerIntTableRowCount(table: arena.typeInstances)
        && compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceKindColumn()) == compilerBodyTypeConstruct()
        && compilerIntTableValue(table: arena.typeInstances, row: typeID, column: compilerBodyTypeInstanceNominalSyntaxColumn()) == compilerBodyArenaArrayDeclarationSyntaxID(arena: arena)
        && compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: typeID) == 1
}

function compilerBodyArenaAppendTypeArguments(arena: CompilerBodyArena, typeID: Int, argumentIDs: Buffer<Int>): Int {
    state ordinal: Int(0)
    while ordinal < argumentIDs.count {
        if compilerIntTableAppend(table: arena.typeArguments, value: typeID) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: arena.typeArguments, value: ordinal) != 0 { return 0 - 1 }
        if compilerIntTableAppend(table: arena.typeArguments, value: argumentIDs.element(index: ordinal)) != 0 { return 0 - 1 }
        ordinal: ordinal + 1
    }
    return 0
}

function compilerBodyArenaAppendDefaultTypeArguments(arena: CompilerBodyArena, nominalSyntaxID: Int, argumentIDs: Buffer<Int>): Int {
    if nominalSyntaxID < 0 { return 0 }
    let expectedCount: Int(compilerSyntaxGenericParameterCountForOwner(tables: arena.tables, ownerSyntaxID: nominalSyntaxID))
    let requiredCount: Int(compilerSyntaxGenericParameterRequiredCountForOwner(tables: arena.tables, ownerSyntaxID: nominalSyntaxID))
    if argumentIDs.count < requiredCount || argumentIDs.count > expectedCount { return 0 - 1 }
    state ordinal: Int(argumentIDs.count)
    while ordinal < expectedCount {
        let parameterRow: Int(compilerSyntaxGenericParameterRowForOwnerOrdinal(tables: arena.tables, ownerSyntaxID: nominalSyntaxID, ordinal: ordinal))
        let defaultRange: CompilerSourceRange(compilerSyntaxGenericParameterDefaultRange(tables: arena.tables, parameterRow: parameterRow))
        if parameterRow < 0 || defaultRange.start < 0 { return 0 - 1 }
        let fileID: Int(compilerIntTableValue(table: arena.tables.genericParameters, row: parameterRow, column: compilerSyntaxGenericParameterFileColumn()))
        let defaultTypeID: Int(compilerBodyArenaTypeInstanceIntern(arena: arena, fileID: fileID, start: defaultRange.start, end: defaultRange.end))
        if defaultTypeID < 0 || argumentIDs.append(element: defaultTypeID) != 0 { return 0 - 1 }
        ordinal: ordinal + 1
    }
    return 0
}

function compilerBodyArenaTypeInstanceIntern(arena: CompilerBodyArena, fileID: Int, start: Int, end: Int): Int {
