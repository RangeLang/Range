}

function compilerBodyRuntimeBuiltinForElementLayout(arena: CompilerBodyArena, builtinID: Int): Int {
    if builtinID != compilerBodyRuntimeBuiltinRawBufferAppendInt()
        && builtinID != compilerBodyRuntimeBuiltinRawBufferLoadInt()
        && builtinID != compilerBodyRuntimeBuiltinRawBufferStoreInt() { return builtinID }
    let elementTypeID: Int(compilerBodyArenaReceiverElementTypeID(arena: arena))
    if elementTypeID < 0 { return builtinID }
    let elementTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: elementTypeID))
    if compilerBodyElementLayoutByteSize(typeKind: elementTypeKind) < 0
        || compilerBodyElementLayoutAlignment(typeKind: elementTypeKind) < 0 { return compilerBodyRuntimeBuiltinNone() }
    if elementTypeKind == compilerBodyTypeInt() { return builtinID }
    if elementTypeKind == compilerBodyTypeUnsigned8() {
        if builtinID == compilerBodyRuntimeBuiltinRawBufferAppendInt() { return compilerBodyRuntimeBuiltinRawBufferAppendUnsigned8() }
        if builtinID == compilerBodyRuntimeBuiltinRawBufferLoadInt() { return compilerBodyRuntimeBuiltinRawBufferLoadUnsigned8() }
        if builtinID == compilerBodyRuntimeBuiltinRawBufferStoreInt() { return compilerBodyRuntimeBuiltinRawBufferStoreUnsigned8() }
    }
    return compilerBodyRuntimeBuiltinNone()
}

function compilerBodyRuntimeBuiltinUsesElementStorageReceiver(arena: CompilerBodyArena, builtinID: Int): Bool {
    if compilerBodyArenaReceiverElementTypeID(arena: arena) < 0 { return false }
    return builtinID == compilerBodyRuntimeBuiltinRawBufferAppendInt()
        || builtinID == compilerBodyRuntimeBuiltinRawBufferCount()
        || builtinID == compilerBodyRuntimeBuiltinRawBufferLoadInt()
        || builtinID == compilerBodyRuntimeBuiltinRawBufferStoreInt()
        || builtinID == compilerBodyRuntimeBuiltinRawBufferDestroy()
}

function compilerBodyBufferCreateBuiltinForTypeID(arena: CompilerBodyArena, bufferTypeID: Int): Int {
    if bufferTypeID < 0 || compilerBodyArenaTypeArgumentCountForTypeID(arena: arena, typeID: bufferTypeID) != 1 { return compilerBodyRuntimeBuiltinNone() }
    let elementTypeID: Int(compilerBodyArenaTypeArgumentValueForTypeID(arena: arena, typeID: bufferTypeID, ordinal: 0))
    let elementTypeKind: Int(compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: elementTypeID))
    if compilerBodyElementLayoutByteSize(typeKind: elementTypeKind) < 0
        || compilerBodyElementLayoutAlignment(typeKind: elementTypeKind) < 0 { return compilerBodyRuntimeBuiltinNone() }
    if elementTypeKind == compilerBodyTypeInt() { return compilerBodyRuntimeBuiltinBufferCreateInt() }
    if elementTypeKind == compilerBodyTypeUnsigned8() { return compilerBodyRuntimeBuiltinBufferCreateUnsigned8() }
    return compilerBodyRuntimeBuiltinNone()
}

function compilerBodyArenaGenericParameterOrdinal(arena: CompilerBodyArena, ownerSyntaxID: Int, fileID: Int, start: Int, end: Int): Int {
    if ownerSyntaxID < 0 { return 0 - 1 }
