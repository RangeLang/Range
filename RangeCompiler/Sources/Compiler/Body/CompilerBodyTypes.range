        row: row + 1
    }
    return count
}

function compilerBodyArenaTypeArgumentValueForTypeIDTables(typeArguments: CompilerIntTable, typeID: Int, ordinal: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: typeArguments) {
        if compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentTypeInstanceColumn()) == typeID
            && compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentOrdinalColumn()) == ordinal { return compilerIntTableValue(table: typeArguments, row: row, column: compilerBodyTypeArgumentValueTypeInstanceColumn()) }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyArenaImportTypeKeyIntoTables(typeInstances: CompilerIntTable, typeArguments: CompilerIntTable, typeKeys: CompilerIntTable, typeKeyArguments: CompilerIntTable, typeKeyID: Int): Int {
    if typeKeyID < 0 || typeKeyID >= compilerIntTableRowCount(table: typeKeys) { return 0 - 1 }
    let argumentCount: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyArgumentCountColumn()))
    let argumentIDs: Buffer<Int>(bufferCreateInt(capacity: argumentCount + 1))
    state ordinal: Int(0)
    while ordinal < argumentCount {
        let childKeyID: Int(compilerReachableTypeKeyArgumentValue(typeKeyArguments: typeKeyArguments, typeKeyID: typeKeyID, ordinal: ordinal))
        let childTypeID: Int(compilerBodyArenaImportTypeKeyIntoTables(typeInstances: typeInstances, typeArguments: typeArguments, typeKeys: typeKeys, typeKeyArguments: typeKeyArguments, typeKeyID: childKeyID))
        if childTypeID < 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        if argumentIDs.append(element: childTypeID) != 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        ordinal: ordinal + 1
    }
    let typeKind: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyKindColumn()))
    let nominalSyntaxID: Int(compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyNominalColumn()))
    let existing: Int(compilerBodyArenaTypeInstanceFindInTables(typeInstances: typeInstances, typeArguments: typeArguments, typeKind: typeKind, nominalSyntaxID: nominalSyntaxID, argumentCount: argumentCount, argumentIDs: argumentIDs))
    if existing >= 0 {
        argumentIDs.destroy()
        return existing
    }
    let localTypeID: Int(compilerIntTableRowCount(table: typeInstances))
    if compilerIntTableAppend(table: typeInstances, value: localTypeID) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyFileColumn())) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyStartColumn())) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: compilerIntTableValue(table: typeKeys, row: typeKeyID, column: compilerReachableTypeKeyEndColumn())) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: typeKind) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    if compilerIntTableAppend(table: typeInstances, value: nominalSyntaxID) != 0 {
        argumentIDs.destroy()
        return 0 - 1
    }
    ordinal: 0
    while ordinal < argumentCount {
        if compilerIntTableAppend(table: typeArguments, value: localTypeID) != 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        if compilerIntTableAppend(table: typeArguments, value: ordinal) != 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        if compilerIntTableAppend(table: typeArguments, value: argumentIDs.element(index: ordinal)) != 0 {
            argumentIDs.destroy()
            return 0 - 1
        }
        ordinal: ordinal + 1
    }
    argumentIDs.destroy()
    return localTypeID
}

