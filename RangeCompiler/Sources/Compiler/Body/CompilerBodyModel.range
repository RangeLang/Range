function compilerBodyCFGScheduleBlockColumn(): Int { return 1 }
function compilerBodyCFGScheduleNodeColumn(): Int { return 2 }
function compilerBodyCFGScheduleActionColumn(): Int { return 3 }
function compilerBodyCFGScheduleOrdinalColumn(): Int { return 4 }

function compilerBodyGraphZeroCFGRegionColumnCount(): Int { return 5 }
function compilerBodyGraphZeroCFGRegionIDColumn(): Int { return 0 }
function compilerBodyGraphZeroCFGRegionBlockColumn(): Int { return 1 }
function compilerBodyGraphZeroCFGRegionKindColumn(): Int { return 2 }
function compilerBodyGraphZeroCFGRegionEdgeCountColumn(): Int { return 3 }
function compilerBodyGraphZeroCFGRegionAuxColumn(): Int { return 4 }
function compilerBodyGraphZeroCFGRegionLinear(): Int { return 1 }
function compilerBodyGraphZeroCFGRegionFork(): Int { return 2 }
function compilerBodyGraphZeroCFGRegionJoin(): Int { return 3 }
function compilerBodyGraphZeroCFGRegionLoop(): Int { return 4 }
function compilerBodyCFGScheduleEvaluateNode(): Int { return 1 }
function compilerBodyCFGScheduleOptionalTag(): Int { return 2 }
function compilerBodyCFGScheduleOptionalPayload(): Int { return 3 }
function compilerBodyCFGScheduleOptionalJoin(): Int { return 4 }
function compilerBodyCFGScheduleStatementCommit(): Int { return 5 }
function compilerBodyCFGScheduleSwitchMatch(): Int { return 6 }
function compilerBodyCFGScheduleSwitchPayloadBind(): Int { return 7 }
function compilerBodyCFGScheduleOptionalFallback(): Int { return 8 }

function compilerBodyStorageColumnCount(): Int { return 6 }
function compilerBodyStorageIDColumn(): Int { return 0 }
function compilerBodyStorageOwnerNodeColumn(): Int { return 1 }
function compilerBodyStorageTypeIDColumn(): Int { return 2 }
function compilerBodyStorageRegionColumn(): Int { return 3 }
function compilerBodyStoragePlacementColumn(): Int { return 4 }
function compilerBodyStorageMutableColumn(): Int { return 5 }
function compilerBodyStorageCaller(): Int { return 1 }
function compilerBodyStorageCalleeReturn(): Int { return 2 }

function compilerFunctionReturnABINone(): Int { return 0 }
function compilerFunctionReturnABIDirect(): Int { return 1 }
function compilerFunctionReturnABIIndirect(): Int { return 2 }

function compilerModuleABIPlanReturnMode(plan: CompilerModuleABIPlan, tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int): Int {
    if !plan.isFrozen { return compilerFunctionReturnABI(tables: tables, index: index, functionRow: functionRow) }
    if functionRow < 0 || functionRow >= plan.returnModes.count { return compilerFunctionReturnABINone() }
    return plan.returnModes.element(index: functionRow)
}

function compilerModuleABIPlanIsParticipant(plan: CompilerModuleABIPlan, functionRow: Int): Bool {
    if !plan.isFrozen { return false }
    if functionRow < 0 || functionRow >= plan.participants.count { return false }
    return plan.participants.element(index: functionRow) == 1
}

function compilerBodyArenaOwnerIsParticipant(arena: CompilerBodyArena, plan: CompilerModuleABIPlan): Bool {
    if compilerBodyArenaIsEntry(arena: arena) { return plan.isFrozen }
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return false }
    return compilerModuleABIPlanIsParticipant(plan: plan, functionRow: arena.ownerFunctionRow)
}

function compilerBodyArenaOwnerReturnMode(arena: CompilerBodyArena, plan: CompilerModuleABIPlan): Int {
    if compilerBodyArenaIsEntry(arena: arena) { return compilerFunctionReturnABIDirect() }
    if arena.ownerKind == compilerBodyArenaOwnerMacro() || arena.ownerKind == compilerBodyArenaOwnerClosure() { return compilerFunctionReturnABIDirect() }
    if arena.ownerKind != compilerBodyArenaOwnerFunction() { return compilerFunctionReturnABINone() }
    return compilerModuleABIPlanReturnMode(plan: plan, tables: arena.tables, index: arena.declarationIndex, functionRow: arena.ownerFunctionRow)
}

function compilerBodyArenaOwnerAuxID(arena: CompilerBodyArena): Int {
    if compilerBodyArenaIsEntry(arena: arena) { return arena.ownerDeclarationSyntaxID }
    if arena.ownerKind == compilerBodyArenaOwnerMacro() || arena.ownerKind == compilerBodyArenaOwnerClosure() { return arena.ownerDeclarationSyntaxID }
    return arena.ownerFunctionRow
}

function compilerReachableLLVMStateABIPlan(reachability: CompilerReachableLLVMState): CompilerModuleABIPlan {
    let plan: CompilerModuleABIPlan(returnModes: $reachability.abiReturnModes, participants: $reachability.abiParticipants, isFrozen: reachability.counters.element(index: compilerReachableLLVMPlanFrozen()) == 1)
    return plan
}

function compilerNominalDeclarationRowForName(tables: CompilerSyntaxTables, name: String): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.declarations) {
        if compilerIntTableValue(table: tables.declarations, row: row, column: 2) == compilerSyntaxKindConstruct() {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)))
            if candidate == name { return row }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerNominalDeclarationIsArray(tables: CompilerSyntaxTables, declarationRow: Int): Bool {
    if declarationRow < 0 || declarationRow >= compilerIntTableRowCount(table: tables.declarations)
        || compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) != compilerSyntaxKindConstruct() { return false }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    return name == String("Array")
        && compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 13) == compilerBuiltinPolicyRuntime()
        && compilerSyntaxGenericParameterCountForOwner(tables: tables, ownerSyntaxID: syntaxID) == 1
}

function compilerCoreShouldRenderBuiltinArrayLayout(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, renderedFunctions: String): Bool {
    if !compilerCoreRecordContains(record: renderedFunctions, text: String("%Range.Array")) { return false }
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: String("Array"), kindTag: compilerSyntaxKindConstruct()))
    return declarationRow < 0 || compilerNominalDeclarationIsArray(tables: tables, declarationRow: declarationRow)
}

function compilerEnumDeclarationRowForName(tables: CompilerSyntaxTables, name: String): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: tables.declarations) {
        if compilerIntTableValue(table: tables.declarations, row: row, column: 2) == compilerSyntaxKindEnum() {
            let fileID: Int(compilerIntTableValue(table: tables.declarations, row: row, column: 1))
            let candidate: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: row, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: row, column: 8)))
            if candidate == name { return row }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerEnumPayloadLLVMFieldTypeNameAtDepth(tables: CompilerSyntaxTables, payloadRow: Int, depth: Int): String {
    if payloadRow < 0 || payloadRow >= compilerIntTableRowCount(table: tables.members) { return String("") }
    if compilerIntTableValue(table: tables.members, row: payloadRow, column: 12) != compilerSyntaxMemberKindEnumCasePayload() { return String("") }
    let storagePolicy: Int(compilerIntTableValue(table: tables.members, row: payloadRow, column: 13))
    if storagePolicy == compilerSyntaxMemberStorageBinding() || storagePolicy == compilerSyntaxMemberStorageIndirect() { return String("ptr") }
    if storagePolicy != compilerSyntaxMemberStorageDirect() || depth >= 16 { return String("") }
    let typeReferenceID: Int(compilerIntTableValue(table: tables.members, row: payloadRow, column: 15))
    if typeReferenceID < 0 || typeReferenceID >= compilerIntTableRowCount(table: tables.typeReferences) { return String("") }
    let referenceKind: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceKindColumn()))
    let targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetKindColumn()))
    let targetID: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetIDColumn()))
    if referenceKind == compilerSyntaxTypeReferenceArray() { return String("%Range.Array") }
    if targetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
        if targetID == compilerSyntaxBuiltinTypeInt() { return compilerProjectIntegerLLVMTypeName(tables: tables) }
        if targetID == compilerSyntaxBuiltinTypeBool() { return String("i1") }
        if targetID == compilerSyntaxBuiltinTypeString() { return String("ptr") }
        if targetID == compilerSyntaxBuiltinTypeFloat() { return String("double") }
        return String("")
    }
    if targetKind == compilerSyntaxTypeReferenceTargetGenericParameter() { return String("ptr") }
    if targetKind != compilerSyntaxTypeReferenceTargetDeclaration() || targetID < 0
        || targetID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return String("") }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: targetID))
    if declarationRow < 0 { return String("") }
    let declarationKind: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2))
    let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    if declarationKind == compilerSyntaxKindConstruct()
        && compilerRuntimeABIConstructKind(tables: tables, constructNodeID: targetID) == compilerRuntimeABIOpaqueStorage() { return String("ptr") }
    if declarationKind == compilerSyntaxKindConstruct()
        && compilerNominalLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: depth + 1) { return "%Range.\(declarationName)" }
    if declarationKind == compilerSyntaxKindEnum() {
        if !compilerSyntaxEnumHasPayloads(tables: tables, enumSyntaxID: targetID) { return String("i32") }
        if compilerEnumLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: depth + 1) { return "%Range.\(declarationName)" }
    }
    return String("")
}

function compilerEnumLLVMLayoutIsSupportedAtDepth(tables: CompilerSyntaxTables, declarationRow: Int, depth: Int): Bool {
    if depth >= 16 || declarationRow < 0 || declarationRow >= compilerIntTableRowCount(table: tables.declarations)
        || compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) != compilerSyntaxKindEnum() { return false }
    let enumSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    if !compilerSyntaxEnumHasPayloads(tables: tables, enumSyntaxID: enumSyntaxID) { return false }
    state payloadCount: Int(0)
    state payloadRow: Int(0)
    while payloadRow < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: payloadRow, column: 12) == compilerSyntaxMemberKindEnumCasePayload()
            && compilerSyntaxEnumPayloadOwnerSyntaxID(tables: tables, payloadRow: payloadRow) == enumSyntaxID {
            if compilerEnumPayloadLLVMFieldTypeNameAtDepth(tables: tables, payloadRow: payloadRow, depth: depth) == String("") { return false }
            payloadCount: payloadCount + 1
        }
        payloadRow: payloadRow + 1
    }
    return payloadCount > 0
}

function compilerEnumLLVMLayoutIsSupported(tables: CompilerSyntaxTables, declarationRow: Int): Bool {
    return compilerEnumLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: 0)
}

function compilerEnumLLVMTypeName(tables: CompilerSyntaxTables, declarationRow: Int): String {
    if !compilerEnumLLVMLayoutIsSupported(tables: tables, declarationRow: declarationRow) { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    return "%Range.\(name)"
}

function compilerNominalLLVMFieldTypeNameAtDepth(tables: CompilerSyntaxTables, typeName: String, depth: Int): String {
    if compilerBodyArenaTypeOuterName(typeName: typeName) == String("Int") && !compilerIntegerTypeIsUnsigned8(typeName: typeName) {
        return compilerCoreLLVMTypeNameForRangeTypeInProject(tables: tables, typeName: typeName)
    }
    if typeName == String("Bool") { return String("i1") }
    if typeName == String("String") { return String("ptr") }
    if compilerBodyRuntimeABITypeIsOpaque(tables: tables, typeName: typeName) { return String("ptr") }
    if depth >= 16 { return String("") }
    let declarationRow: Int(compilerNominalDeclarationRowForName(tables: tables, name: typeName))
    if declarationRow >= 0 && compilerNominalLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: depth + 1) { return "%Range.\(typeName)" }
    let enumDeclarationRow: Int(compilerEnumDeclarationRowForName(tables: tables, name: typeName))
    if enumDeclarationRow >= 0 {
        let enumSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: enumDeclarationRow, column: 0))
        if !compilerSyntaxEnumHasPayloads(tables: tables, enumSyntaxID: enumSyntaxID) { return String("i32") }
        if compilerEnumLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: enumDeclarationRow, depth: depth + 1) { return "%Range.\(typeName)" }
    }
    return String("")
}

function compilerNominalLLVMFieldTypeName(tables: CompilerSyntaxTables, typeName: String): String {
    return compilerNominalLLVMFieldTypeNameAtDepth(tables: tables, typeName: typeName, depth: 0)
}

function compilerNominalLLVMMemberFieldTypeNameAtDepth(tables: CompilerSyntaxTables, memberRow: Int, depth: Int): String {
    if memberRow < 0 || memberRow >= compilerIntTableRowCount(table: tables.members) { return String("") }
    let memberKind: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 12))
    if memberKind != compilerSyntaxMemberKindLet() && memberKind != compilerSyntaxMemberKindState() && memberKind != compilerSyntaxMemberKindBinding() { return String("") }
    let storagePolicy: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 13))
    if storagePolicy != compilerSyntaxMemberStorageNone() || depth >= 16 { return String("") }
    let typeReferenceID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 15))
    if typeReferenceID < 0 || typeReferenceID >= compilerIntTableRowCount(table: tables.typeReferences) { return String("") }
    let referenceKind: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceKindColumn()))
    let targetKind: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetKindColumn()))
    let targetID: Int(compilerIntTableValue(table: tables.typeReferences, row: typeReferenceID, column: compilerSyntaxTypeReferenceTargetIDColumn()))
    if referenceKind == compilerSyntaxTypeReferenceArray() { return String("%Range.Array") }
    if targetKind == compilerSyntaxTypeReferenceTargetBuiltin() {
        if targetID == compilerSyntaxBuiltinTypeInt() { return compilerProjectIntegerLLVMTypeName(tables: tables) }
        if targetID == compilerSyntaxBuiltinTypeBool() { return String("i1") }
        if targetID == compilerSyntaxBuiltinTypeString() { return String("ptr") }
        if targetID == compilerSyntaxBuiltinTypeFloat() { return String("double") }
        return String("")
    }
    if targetKind == compilerSyntaxTypeReferenceTargetGenericParameter() { return String("ptr") }
    if targetKind != compilerSyntaxTypeReferenceTargetDeclaration() || targetID < 0
        || targetID >= compilerIntTableRowCount(table: tables.syntaxIndex) { return String("") }
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: targetID))
    if declarationRow < 0 { return String("") }
    let declarationKind: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2))
    let declarationFileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let declarationName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: declarationFileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    if declarationKind == compilerSyntaxKindConstruct()
        && compilerMemoryMemberRepresentation(tables: tables, memberRow: memberRow) == compilerMemoryMemberRepresentationIdentity() { return String("ptr") }
    if declarationKind == compilerSyntaxKindConstruct()
        && compilerRuntimeABIConstructKind(tables: tables, constructNodeID: targetID) == compilerRuntimeABIOpaqueStorage() { return String("ptr") }
    if declarationKind == compilerSyntaxKindConstruct()
        && compilerNominalLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: depth + 1) { return "%Range.\(declarationName)" }
    if declarationKind == compilerSyntaxKindEnum() {
        if !compilerSyntaxEnumHasPayloads(tables: tables, enumSyntaxID: targetID) { return String("i32") }
        if compilerEnumLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: depth + 1) { return "%Range.\(declarationName)" }
    }
    return String("")
}

function compilerNominalLLVMMemberFieldTypeName(tables: CompilerSyntaxTables, memberRow: Int): String {
    return compilerNominalLLVMMemberFieldTypeNameAtDepth(tables: tables, memberRow: memberRow, depth: 0)
}

function compilerNominalLLVMLayoutIsSupportedAtDepth(tables: CompilerSyntaxTables, declarationRow: Int, depth: Int): Bool {
    if depth >= 16 { return false }
    if declarationRow < 0 || declarationRow >= compilerIntTableRowCount(table: tables.declarations)
        || compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) != compilerSyntaxKindConstruct() { return false }
    if compilerNominalDeclarationIsArray(tables: tables, declarationRow: declarationRow) { return true }
    let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    if compilerRuntimeABIConstructKind(tables: tables, constructNodeID: syntaxID) == compilerRuntimeABIOpaqueStorage() { return true }
    state memberCount: Int(0)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        if compilerIntTableValue(table: tables.members, row: memberRow, column: 2) == syntaxID {
            let memberKind: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 12))
            if memberKind == compilerSyntaxMemberKindLet() || memberKind == compilerSyntaxMemberKindState() || memberKind == compilerSyntaxMemberKindBinding() {
                if compilerNominalLLVMMemberFieldTypeNameAtDepth(tables: tables, memberRow: memberRow, depth: depth) == String("") { return false }
                memberCount: memberCount + 1
            }
        }
        memberRow: memberRow + 1
    }
    return memberCount > 0
}

function compilerNominalLLVMLayoutIsSupported(tables: CompilerSyntaxTables, declarationRow: Int): Bool {
    return compilerNominalLLVMLayoutIsSupportedAtDepth(tables: tables, declarationRow: declarationRow, depth: 0)
}

function compilerNominalLLVMTypeName(tables: CompilerSyntaxTables, declarationRow: Int): String {
    if !compilerNominalLLVMLayoutIsSupported(tables: tables, declarationRow: declarationRow) { return String("") }
    let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    if compilerRuntimeABIConstructKind(tables: tables, constructNodeID: syntaxID) == compilerRuntimeABIOpaqueStorage() { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    return "%Range.\(name)"
}

function compilerOptionalPayloadTypeName(typeName: String): String {
    let length: Int(stringLength(value: typeName))
    if length > 1 && typeName.substring(start: length - 1, end: length) == String("?") {
        return typeName.substring(start: 0, end: length - 1)
    }
    if length <= 10
        || !stringHasPrefix(source: typeName, start: 0, prefix: String("Optional<"))
        || typeName.substring(start: length - 1, end: length) != String(">") { return String("") }
    return typeName.substring(start: 9, end: length - 1)
}

function compilerSpecializedOptionalLLVMTypeName(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, typeName: String): String {
    let payloadName: String(compilerOptionalPayloadTypeName(typeName: typeName))
    if payloadName == String("") { return String("") }
    let payloadDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: payloadName, kindTag: compilerSyntaxKindConstruct()))
    if compilerNominalLLVMTypeName(tables: tables, declarationRow: payloadDeclarationRow) == String("") { return String("") }
    return "%Range.Optional.\(payloadName)"
}

function compilerNominalLLVMLayoutText(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, declarationRow: Int): String {
    let typeName: String(compilerNominalLLVMTypeName(tables: tables, declarationRow: declarationRow))
    if typeName == String("") { return String("") }
    if compilerNominalDeclarationIsArray(tables: tables, declarationRow: declarationRow) { return "\(typeName) = type { ptr, i32 }\n" }
    let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    let fields: RawBuffer(rawBufferCreate(capacity: 128, stride: 1))
    state fieldCount: Int(0)
    state memberRow: Int(0)
    while memberRow < compilerIntTableRowCount(table: tables.members) {
        let memberSyntaxID: Int(compilerIntTableValue(table: tables.members, row: memberRow, column: 0))
        if compilerIntTableValue(table: tables.members, row: memberRow, column: 2) == syntaxID
            && !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: memberSyntaxID) {
            let fieldType: String(compilerNominalLLVMMemberFieldTypeName(tables: tables, memberRow: memberRow))
            if fieldType != String("") {
                if fieldCount > 0 { rawBufferAppendText(buffer: fields, text: String(", ")) }
                rawBufferAppendText(buffer: fields, text: fieldType)
                fieldCount: fieldCount + 1
            }
        }
        memberRow: memberRow + 1
    }
    let renderedFields: String(rawBufferMaterializeText(buffer: fields))
    rawBufferDestroy(buffer: fields)
    return "\(typeName) = type { \(renderedFields) }\n"
}

function compilerEnumLLVMLayoutText(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, declarationRow: Int): String {
    let typeName: String(compilerEnumLLVMTypeName(tables: tables, declarationRow: declarationRow))
    if typeName == String("") { return String("") }
    let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    let fields: RawBuffer(rawBufferCreate(capacity: 128, stride: 1))
    rawBufferAppendText(buffer: fields, text: String("i32"))
    state payloadRow: Int(0)
    while payloadRow < compilerIntTableRowCount(table: tables.members) {
        let payloadSyntaxID: Int(compilerIntTableValue(table: tables.members, row: payloadRow, column: 0))
        if compilerIntTableValue(table: tables.members, row: payloadRow, column: 12) == compilerSyntaxMemberKindEnumCasePayload()
            && compilerSyntaxEnumPayloadOwnerSyntaxID(tables: tables, payloadRow: payloadRow) == syntaxID
            && !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: payloadSyntaxID) {
            let fieldType: String(compilerEnumPayloadLLVMFieldTypeNameAtDepth(tables: tables, payloadRow: payloadRow, depth: 0))
            if fieldType == String("") {
                rawBufferDestroy(buffer: fields)
                return String("")
            }
            rawBufferAppendText(buffer: fields, text: ", \(fieldType)")
        }
        payloadRow: payloadRow + 1
    }
    let renderedFields: String(rawBufferMaterializeText(buffer: fields))
    rawBufferDestroy(buffer: fields)
    return "\(typeName) = type { \(renderedFields) }\n"
}

function compilerCoreRenderLLVMNominalLayouts(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, includeBuiltinArray: Bool): String {
    let layouts: RawBuffer(rawBufferCreate(capacity: 4096, stride: 1))
    state layoutCount: Int(0)
    if includeBuiltinArray {
        rawBufferAppendText(buffer: layouts, text: String("%Range.Array = type { ptr, i32 }\n"))
        layoutCount: 1
    }
    state declarationRow: Int(0)
    while declarationRow < compilerIntTableRowCount(table: tables.declarations) {
        let declarationSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
        if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindConstruct()
            && !compilerNominalDeclarationIsArray(tables: tables, declarationRow: declarationRow)
            && !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: declarationSyntaxID) {
            let layout: String(compilerNominalLLVMLayoutText(tables: tables, index: index, declarationRow: declarationRow))
            if layout != String("") {
                rawBufferAppendText(buffer: layouts, text: layout)
                layoutCount: layoutCount + 1
            }
        } else if compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 2) == compilerSyntaxKindEnum()
            && !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: declarationSyntaxID) {
            let layout: String(compilerEnumLLVMLayoutText(tables: tables, index: index, declarationRow: declarationRow))
            if layout != String("") {
                rawBufferAppendText(buffer: layouts, text: layout)
                layoutCount: layoutCount + 1
            }
        }
        declarationRow: declarationRow + 1
    }
    let optionalPayloads: Buffer<Int>(bufferCreateInt(capacity: 8))
    state functionRow: Int(0)
    while functionRow < compilerIntTableRowCount(table: tables.functions) {
        let functionSyntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
        if !compilerDeclarationIndexSyntaxIsOmitted(index: index, syntaxID: functionSyntaxID) {
            let functionFileID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 1))
            let functionReturnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: functionFileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
            let payloadName: String(compilerOptionalPayloadTypeName(typeName: functionReturnType))
            if payloadName != String("") {
            let payloadDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: payloadName, kindTag: compilerSyntaxKindConstruct()))
            if payloadDeclarationRow >= 0 && compilerNominalLLVMTypeName(tables: tables, declarationRow: payloadDeclarationRow) != String("") {
                let payloadSyntaxID: Int(compilerIntTableValue(table: tables.declarations, row: payloadDeclarationRow, column: 0))
                state alreadyRendered: Bool(false)
                state payloadIndex: Int(0)
                while payloadIndex < optionalPayloads.count {
                    if optionalPayloads.element(index: payloadIndex) == payloadSyntaxID { alreadyRendered: true }
                    payloadIndex: payloadIndex + 1
                }
                if !alreadyRendered {
                    let optionalTypeName: String(compilerSpecializedOptionalLLVMTypeName(tables: tables, index: index, typeName: functionReturnType))
                    let payloadTypeName: String(compilerNominalLLVMTypeName(tables: tables, declarationRow: payloadDeclarationRow))
                    if optionalTypeName != String("") {
                        rawBufferAppendText(buffer: layouts, text: "\(optionalTypeName) = type { i1, \(payloadTypeName) }\n")
                        optionalPayloads.append(element: payloadSyntaxID)
                        layoutCount: layoutCount + 1
                    }
                }
            }
        }
        }
        functionRow: functionRow + 1
    }
    optionalPayloads.destroy()
    if layoutCount > 0 { rawBufferAppendText(buffer: layouts, text: String("\n")) }
    let rendered: String(rawBufferMaterializeText(buffer: layouts))
    rawBufferDestroy(buffer: layouts)
    return rendered
}

function compilerFunctionReturnABI(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int): Int {
    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: tables.functions) { return compilerFunctionReturnABINone() }
    let fileID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 1))
    let returnType: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.functions, row: functionRow, column: 6), localEnd: compilerIntTableValue(table: tables.functions, row: functionRow, column: 7)))
    if returnType == String("Int") || returnType == String("Bool") || returnType == String("String") || returnType == String("Float")
        || compilerIntegerTypeIsUnsigned8(typeName: returnType)
        || compilerFloatTypeIs32(typeName: returnType)
        || compilerFloatTypeIs64(typeName: returnType) { return compilerFunctionReturnABIDirect() }
    if compilerBodyRuntimeABITypeIsOpaque(tables: tables, typeName: returnType) { return compilerFunctionReturnABIDirect() }
    if compilerSpecializedOptionalLLVMTypeName(tables: tables, index: index, typeName: returnType) != String("") { return compilerFunctionReturnABIIndirect() }
    if stringIndexOf(source: returnType, needle: String("<"), start: 0) >= 0 { return compilerFunctionReturnABINone() }
    let nominalName: String(compilerBodyArenaTypeOuterName(typeName: returnType))
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindConstruct()))
    if compilerNominalLLVMTypeName(tables: tables, declarationRow: declarationRow) != String("") { return compilerFunctionReturnABIIndirect() }
    let enumDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindEnum()))
    if compilerEnumLLVMTypeName(tables: tables, declarationRow: enumDeclarationRow) != String("") { return compilerFunctionReturnABIIndirect() }
    return compilerFunctionReturnABINone()
}

function compilerFunctionOwnerConstructName(tables: CompilerSyntaxTables, functionRow: Int): String {
    if functionRow < 0 || functionRow >= tables.functionOwners.count { return String("") }
    let ownerSyntaxID: Int(tables.functionOwners.element(index: functionRow))
    if ownerSyntaxID < 0 { return String("") }
    let ownerDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: ownerSyntaxID))
    if ownerDeclarationRow < 0 || compilerIntTableValue(table: tables.declarations, row: ownerDeclarationRow, column: 2) != compilerSyntaxKindConstruct() { return String("") }
    let ownerFileID: Int(compilerIntTableValue(table: tables.declarations, row: ownerDeclarationRow, column: 1))
    return compilerTypedSyntaxLocalText(tables: tables, fileID: ownerFileID, localStart: compilerIntTableValue(table: tables.declarations, row: ownerDeclarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: ownerDeclarationRow, column: 8))
}

function compilerFunctionLLVMBaseName(tables: CompilerSyntaxTables, functionRow: Int): String {
    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: tables.functions) { return String("") }
    let syntaxID: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 0))
    let declarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: syntaxID))
    if declarationRow < 0 { return String("") }
    let fileID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 1))
    let name: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 7), localEnd: compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 8)))
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    if ownerName == String("") { return name }
    return "\(ownerName)__\(name)"
}

function compilerFunctionHasAggregateParameterABI(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int): Bool {
    if functionRow < 0 || functionRow >= compilerIntTableRowCount(table: tables.functions) { return false }
    let firstParameterRow: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 2))
    let parameterCount: Int(compilerIntTableValue(table: tables.functions, row: functionRow, column: 3))
    state ordinal: Int(0)
    while ordinal < parameterCount {
        let parameterRow: Int(firstParameterRow + ordinal)
        let fileID: Int(compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 1))
        let typeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: fileID, localStart: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 8), localEnd: compilerIntTableValue(table: tables.parameters, row: parameterRow, column: 9)))
        if compilerSpecializedOptionalLLVMTypeName(tables: tables, index: index, typeName: typeName) != String("") { return true }
        if typeName != String("Int") && typeName != String("Bool") && typeName != String("String") && typeName != String("Float")
            && !compilerIntegerTypeIsUnsigned8(typeName: typeName)
            && !compilerFloatTypeIs32(typeName: typeName)
            && !compilerFloatTypeIs64(typeName: typeName)
            && !compilerBodyRuntimeABITypeIsOpaque(tables: tables, typeName: typeName) {
            let nominalName: String(compilerBodyArenaTypeOuterName(typeName: typeName))
            let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindConstruct()))
            if compilerNominalLLVMTypeName(tables: tables, declarationRow: declarationRow) != String("") { return true }
            let enumDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: nominalName, kindTag: compilerSyntaxKindEnum()))
            if compilerEnumLLVMTypeName(tables: tables, declarationRow: enumDeclarationRow) != String("") { return true }
        }
        ordinal: ordinal + 1
    }
    let ownerName: String(compilerFunctionOwnerConstructName(tables: tables, functionRow: functionRow))
    if ownerName != String("") {
        let ownerDeclarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: ownerName, kindTag: compilerSyntaxKindConstruct()))
        if ownerDeclarationRow >= 0 && compilerNominalLLVMTypeName(tables: tables, declarationRow: ownerDeclarationRow) != String("") { return true }
    }
    return false
}

function compilerFunctionHasRepresentationSensitiveABI(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, functionRow: Int): Bool {
    return compilerFunctionReturnABI(tables: tables, index: index, functionRow: functionRow) == compilerFunctionReturnABIIndirect()
        || compilerFunctionHasAggregateParameterABI(tables: tables, index: index, functionRow: functionRow)
}

function compilerFunctionNamedReturnABI(tables: CompilerSyntaxTables, index: CompilerDeclarationIndex, name: String): Int {
    let declarationRow: Int(compilerDeclarationIndexLookup(tables: tables, index: index, name: name, kindTag: compilerSyntaxKindFunction()))
    if declarationRow < 0 { return compilerFunctionReturnABINone() }
    let syntaxID: Int(compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 0))
    return compilerFunctionReturnABI(tables: tables, index: index, functionRow: compilerIntTableValue(table: tables.syntaxIndex, row: syntaxID, column: 1))
}

