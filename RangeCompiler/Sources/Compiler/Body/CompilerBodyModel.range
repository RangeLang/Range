function compilerBodyLLVMGlobalDescriptorSourceColumn(): Int { return 1 }
function compilerBodyLLVMGlobalDescriptorByteCountColumn(): Int { return 2 }
function compilerBodyLLVMGlobalDescriptorKindColumn(): Int { return 3 }
function compilerBodyLLVMGlobalDescriptorStringLiteral(): Int { return 1 }
function compilerBodyLLVMGlobalDescriptorMemberName(): Int { return 2 }
function compilerBodyLLVMGlobalDescriptorStringSegment(): Int { return 3 }
function compilerBodyLLVMRuntimeStringEqual(): Int { return 1 }
function compilerBodyLLVMRuntimeStringCompare(): Int { return 2 }
function compilerBodyLLVMEmitterStateCount(): Int { return 5 }
function compilerBodyLLVMEmitterNextTemporary(): Int { return 0 }
function compilerBodyLLVMEmitterNextBranch(): Int { return 1 }
function compilerBodyLLVMEmitterValid(): Int { return 2 }
function compilerBodyLLVMEmitterLastBlock(): Int { return 3 }
function compilerBodyLLVMEmitterRuntimeRequirements(): Int { return 4 }

function compilerBodyTelemetryEmpty(): CompilerBodyTelemetry {
    return CompilerBodyTelemetry(supportedCount: 0, typedParseAttempts: 0, typedParseSuccesses: 0, legacyParses: 0, arenaCreates: 0, arenaDestroys: 0, recordBytes: 0, committedFailures: 0)
}

function compilerBodyTelemetryIsTypedOnly(telemetry: CompilerBodyTelemetry): Bool {
    return telemetry.legacyParses == 0
        && telemetry.recordBytes == 0
        && telemetry.typedParseAttempts == telemetry.typedParseSuccesses
        && telemetry.supportedCount == telemetry.typedParseSuccesses
        && telemetry.arenaCreates == telemetry.arenaDestroys
        && telemetry.committedFailures == 0
}

function compilerBodyTelemetryTypedOnlyFailure(telemetry: CompilerBodyTelemetry, scope: String): String {
    return "compilerError\tkind=nonTypedLowering\tscope=\(scope)\tlegacyParses=\(telemetry.legacyParses)\trecordBytes=\(telemetry.recordBytes)\ttypedParseAttempts=\(telemetry.typedParseAttempts)\ttypedParseSuccesses=\(telemetry.typedParseSuccesses)\tsupportedCount=\(telemetry.supportedCount)\tarenaCreates=\(telemetry.arenaCreates)\tarenaDestroys=\(telemetry.arenaDestroys)\tcommittedFailures=\(telemetry.committedFailures)"
}

function compilerBodyTelemetryAppending(left: CompilerBodyTelemetry, right: CompilerBodyTelemetry): CompilerBodyTelemetry {
    return CompilerBodyTelemetry(
        supportedCount: left.supportedCount + right.supportedCount,
        typedParseAttempts: left.typedParseAttempts + right.typedParseAttempts,
        typedParseSuccesses: left.typedParseSuccesses + right.typedParseSuccesses,
        legacyParses: left.legacyParses + right.legacyParses,
        arenaCreates: left.arenaCreates + right.arenaCreates,
        arenaDestroys: left.arenaDestroys + right.arenaDestroys,
        recordBytes: left.recordBytes + right.recordBytes,
        committedFailures: left.committedFailures + right.committedFailures
    )
}

function compilerTypedLLVMHelpersValue(value: CompilerTypedLLVMHelpers): CompilerLLVMHelperFunctions {
    return value.helpers
}
