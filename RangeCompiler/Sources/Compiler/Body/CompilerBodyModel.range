function compilerBodyGraphZeroIsFrozenAndValid(arena: CompilerBodyArena): Bool {
    return arena.graphZeroState.count == compilerBodyGraphZeroStateCount()
        && arena.graphZeroState.element(index: compilerBodyGraphZeroStateFrozen()) == 1
        && arena.graphZeroState.element(index: compilerBodyGraphZeroStateValid()) == 1
        && compilerIntTableIsComplete(table: arena.graphZeroCFGRegions)
        && compilerIntTableIsComplete(table: arena.graphZeroMIRDependencies)
        && compilerIntTableIsComplete(table: arena.graphZeroMIRFrontiers)
}

function compilerBodyGraphZeroMIRIsValid(arena: CompilerBodyArena): Bool {
    if !compilerBodyGraphZeroIsFrozenAndValid(arena: arena)
        || compilerIntTableRowCount(table: arena.graphZeroMIRFrontiers) != compilerIntTableRowCount(table: arena.mirOperations) { return false }
    state dependencyRow: Int(0)
    while dependencyRow < compilerIntTableRowCount(table: arena.graphZeroMIRDependencies) {
        let producer: Int(compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyProducerColumn()))
        let consumer: Int(compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyConsumerColumn()))
        let kind: Int(compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyKindColumn()))
        if compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyIDColumn()) != dependencyRow
            || producer < 0 || producer >= compilerIntTableRowCount(table: arena.mirOperations)
            || consumer < 0 || consumer >= compilerIntTableRowCount(table: arena.mirOperations)
            || kind < compilerBodyGraphZeroMIRDependencyData() || kind > compilerBodyGraphZeroMIRDependencyLoopCarried()
            || kind != compilerBodyGraphZeroMIRDependencyLoopCarried() && producer >= consumer
            || kind == compilerBodyGraphZeroMIRDependencyLoopCarried() && producer < consumer { return false }
        dependencyRow: dependencyRow + 1
    }
    state operationID: Int(0)
    while operationID < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.graphZeroMIRFrontiers, row: operationID, column: compilerBodyGraphZeroMIRFrontierIDColumn()) != operationID
            || compilerIntTableValue(table: arena.graphZeroMIRFrontiers, row: operationID, column: compilerBodyGraphZeroMIRFrontierOperationColumn()) != operationID
            || compilerIntTableValue(table: arena.graphZeroMIRFrontiers, row: operationID, column: compilerBodyGraphZeroMIRFrontierBlockColumn()) != compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationBlockColumn())
            || compilerIntTableValue(table: arena.graphZeroMIRFrontiers, row: operationID, column: compilerBodyGraphZeroMIRFrontierDepthColumn()) < 1
            || compilerIntTableValue(table: arena.graphZeroMIRFrontiers, row: operationID, column: compilerBodyGraphZeroMIRFrontierOrdinalColumn()) != operationID { return false }
        operationID: operationID + 1
    }
    return true
}

