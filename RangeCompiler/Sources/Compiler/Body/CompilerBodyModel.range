function compilerBodyRuntimeBuiltinReturnType(id: Int): String {
    if id == compilerBodyRuntimeBuiltinStringHasPrefix() { return String("i1") }
    if id == compilerBodyRuntimeBuiltinRawBufferLoadUnsigned8() { return String("i8") }
    if id == compilerBodyRuntimeBuiltinStringViewFrom()
        || id == compilerBodyRuntimeBuiltinStringSliceUnchecked()
        || id == compilerBodyRuntimeBuiltinStringCharacterAt()
        || id == compilerBodyRuntimeBuiltinRawBufferCreate()
        || id == compilerBodyRuntimeBuiltinBufferCreateInt()
        || id == compilerBodyRuntimeBuiltinBufferCreateUnsigned8()
        || id == compilerBodyRuntimeBuiltinRawBufferMaterializeText()
        || id == compilerBodyRuntimeBuiltinStringSubstring()
        || id == compilerBodyRuntimeBuiltinCommandLineArgument()
        || id == compilerBodyRuntimeBuiltinReadFile()
        || id == compilerBodyRuntimeBuiltinCompilerMetricsReport() { return String("ptr") }
    if id > compilerBodyRuntimeBuiltinNone() && id <= compilerBodyRuntimeBuiltinCount() { return String("i32") }
    return String("")
}

function compilerBodyRuntimeBuiltinParameterCount(id: Int): Int {
    if id == compilerBodyRuntimeBuiltinStringTransientRegionMark()
        || id == compilerBodyRuntimeBuiltinCommandLineArgumentCount()
        || id == compilerBodyRuntimeBuiltinCompilerMetricsReset()
        || id == compilerBodyRuntimeBuiltinCompilerMetricsReport()
        || id == compilerBodyRuntimeBuiltinTargetPointerBits() { return 0 }
    if id == compilerBodyRuntimeBuiltinStringTransientRegionReset()
        || id == compilerBodyRuntimeBuiltinRawBufferCount()
        || id == compilerBodyRuntimeBuiltinRawBufferMaterializeText()
        || id == compilerBodyRuntimeBuiltinRawBufferDestroy()
        || id == compilerBodyRuntimeBuiltinStringLength()
        || id == compilerBodyRuntimeBuiltinCommandLineArgument()
        || id == compilerBodyRuntimeBuiltinReadFile()
        || id == compilerBodyRuntimeBuiltinCompilerMetricsSetEnabled()
        || id == compilerBodyRuntimeBuiltinPrint()
        || id == compilerBodyRuntimeBuiltinStringDestroy() { return 1 }
    if id == compilerBodyRuntimeBuiltinBufferCreateInt()
        || id == compilerBodyRuntimeBuiltinBufferCreateUnsigned8() { return 1 }
    if id == compilerBodyRuntimeBuiltinStringHasPrefix()
        || id == compilerBodyRuntimeBuiltinStringFindFrom()
        || id == compilerBodyRuntimeBuiltinStringFindFirstOf()
        || id == compilerBodyRuntimeBuiltinStringSliceUnchecked()
        || id == compilerBodyRuntimeBuiltinRawBufferStoreInt()
        || id == compilerBodyRuntimeBuiltinRawBufferStoreUnsigned8()
        || id == compilerBodyRuntimeBuiltinRawBufferAppendTextCharacter()
        || id == compilerBodyRuntimeBuiltinStringIndexOf()
        || id == compilerBodyRuntimeBuiltinStringSubstring() { return 3 }
    if id == compilerBodyRuntimeBuiltinStringFindByteOf() { return 5 }
    if id == compilerBodyRuntimeBuiltinCompilerMetricsFunctionBegin()
        || id == compilerBodyRuntimeBuiltinCompilerMetricsFunctionEnd() { return 2 }
    if id == compilerBodyRuntimeBuiltinRunProcess()
        || id == compilerBodyRuntimeBuiltinRunProcessBatch() { return 2 }
    if id > compilerBodyRuntimeBuiltinNone() && id <= compilerBodyRuntimeBuiltinCount() { return 2 }
    return 0 - 1
}

function compilerBodyRuntimeBuiltinParameterType(id: Int, ordinal: Int): String {
    let count: Int(compilerBodyRuntimeBuiltinParameterCount(id: id))
    if ordinal < 0 || ordinal >= count { return String("") }
    if id == compilerBodyRuntimeBuiltinRawBufferCreate()
        || id == compilerBodyRuntimeBuiltinBufferCreateInt()
        || id == compilerBodyRuntimeBuiltinBufferCreateUnsigned8()
        || id == compilerBodyRuntimeBuiltinStringTransientRegionReset()
        || id == compilerBodyRuntimeBuiltinCommandLineArgument() { return String("i32") }
    if id == compilerBodyRuntimeBuiltinCompilerMetricsSetEnabled() { return String("i1") }
    if id == compilerBodyRuntimeBuiltinCompilerMetricsFunctionBegin() {
        if ordinal == 0 { return String("i32") }
        return String("ptr")
    }
    if id == compilerBodyRuntimeBuiltinCompilerMetricsFunctionEnd() { return String("i32") }
    if id == compilerBodyRuntimeBuiltinRawBufferAppendUnsigned8() {
        if ordinal == 0 { return String("ptr") }
        return String("i8")
    }
    if id == compilerBodyRuntimeBuiltinRawBufferLoadUnsigned8() {
        if ordinal == 0 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinRawBufferStoreUnsigned8() {
        if ordinal == 0 { return String("ptr") }
        if ordinal == 1 { return String("i32") }
        return String("i8")
    }
    if id == compilerBodyRuntimeBuiltinRunProcessBatch() {
        if ordinal == 0 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinStringHasPrefix()
        || id == compilerBodyRuntimeBuiltinStringFindFrom()
        || id == compilerBodyRuntimeBuiltinStringFindFirstOf() {
        if ordinal == 1 { return String("i32") }
        return String("ptr")
    }
    if id == compilerBodyRuntimeBuiltinStringViewFrom()
        || id == compilerBodyRuntimeBuiltinStringSliceUnchecked()
        || id == compilerBodyRuntimeBuiltinStringCharacterAt()
        || id == compilerBodyRuntimeBuiltinStringByteAt()
        || id == compilerBodyRuntimeBuiltinRawBufferAppendInt()
        || id == compilerBodyRuntimeBuiltinRawBufferAppendRandomBytes()
        || id == compilerBodyRuntimeBuiltinRawBufferLoadInt()
        || id == compilerBodyRuntimeBuiltinRawBufferStoreInt()
        || id == compilerBodyRuntimeBuiltinBufferTruncateInt()
        || id == compilerBodyRuntimeBuiltinRawBufferAppendTextInt() {
        if ordinal == 0 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinStringFindByteOf() {
        if ordinal == 0 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinRawBufferAppendText() { return String("ptr") }
    if id == compilerBodyRuntimeBuiltinRawBufferAppendTextCharacter() {
        if ordinal == 0 || ordinal == 1 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinStringIndexOf() {
        if ordinal < 2 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinStringSubstring() {
        if ordinal == 0 { return String("ptr") }
        return String("i32")
    }
    if id == compilerBodyRuntimeBuiltinStringEqual() { return String("ptr") }
    return String("ptr")
}

function compilerBodyRuntimeBuiltinTypeKind(typeName: String): Int {
    if typeName == String("i32") { return compilerBodyTypeInt() }
    if typeName == String("i8") { return compilerBodyTypeUnsigned8() }
    if typeName == String("i1") { return compilerBodyTypeBool() }
    if typeName == String("ptr") { return compilerBodyTypeConstruct() }
    return compilerBodyTypeUnknown()
}

function compilerBodyRuntimeBuiltinReturnTypeKind(id: Int): Int {
    if id == compilerBodyRuntimeBuiltinStringViewFrom()
        || id == compilerBodyRuntimeBuiltinStringSliceUnchecked()
        || id == compilerBodyRuntimeBuiltinStringCharacterAt()
        || id == compilerBodyRuntimeBuiltinRawBufferMaterializeText()
        || id == compilerBodyRuntimeBuiltinStringSubstring()
        || id == compilerBodyRuntimeBuiltinCommandLineArgument()
        || id == compilerBodyRuntimeBuiltinReadFile()
        || id == compilerBodyRuntimeBuiltinCompilerMetricsReport() { return compilerBodyTypeString() }
    return compilerBodyRuntimeBuiltinTypeKind(typeName: compilerBodyRuntimeBuiltinReturnType(id: id))
}
function compilerBodyMemberRuntimeBuiltinID(receiverTypeKind: Int, receiverTypeID: Int, memberName: String): Int {
    if receiverTypeKind == compilerBodyTypeString() {
        if memberName == String("character") { return compilerBodyRuntimeBuiltinStringCharacterAt() }
        if memberName == String("substring") { return compilerBodyRuntimeBuiltinStringSubstring() }
    }
    return compilerBodyRuntimeBuiltinNone()
}

function compilerBodyMemberRuntimeBuiltinArgumentCount(id: Int): Int {
    if id == compilerBodyRuntimeBuiltinStringCharacterAt() { return 1 }
    if id == compilerBodyRuntimeBuiltinStringSubstring() { return 2 }
    return 0 - 1
}

function compilerBodyMemberRuntimeBuiltinArgumentLabel(id: Int, ordinal: Int): String {
    if id == compilerBodyRuntimeBuiltinStringCharacterAt() && ordinal == 0 { return String("index") }
    if id == compilerBodyRuntimeBuiltinStringSubstring() {
        if ordinal == 0 { return String("start") }
        if ordinal == 1 { return String("end") }
    }
    return String("")
}

function compilerBodyRuntimeABITypeIsOpaque(tables: CompilerSyntaxTables, typeName: String): Bool {
    let declarationRow: Int(compilerNominalDeclarationRowForName(tables: tables, name: compilerBodyArenaTypeOuterName(typeName: typeName)))
    return declarationRow >= 0
        && compilerIntTableValue(table: tables.declarations, row: declarationRow, column: 13) == compilerBuiltinPolicyStorage()
}

function compilerBodyRuntimeBuiltinABIIsValid(): Bool {
    state id: Int(1)
    while id <= compilerBodyRuntimeBuiltinCount() {
        let name: String(compilerBodyRuntimeBuiltinName(id: id))
        if name == String("")
            || compilerBodyRuntimeBuiltinID(name: name) != id
            || compilerBodyRuntimeBuiltinReturnType(id: id) == String("")
            || compilerBodyRuntimeBuiltinParameterCount(id: id) < 0 { return false }
        state priorID: Int(1)
        while priorID < id {
            if compilerBodyRuntimeBuiltinName(id: priorID) == name { return false }
            priorID: priorID + 1
        }
        state ordinal: Int(0)
        while ordinal < compilerBodyRuntimeBuiltinParameterCount(id: id) {
            if compilerBodyRuntimeBuiltinParameterType(id: id, ordinal: ordinal) == String("") { return false }
            ordinal: ordinal + 1
        }
        id: id + 1
    }
    return compilerBodyRuntimeBuiltinName(id: 0) == String("")
        && compilerBodyRuntimeBuiltinName(id: compilerBodyRuntimeBuiltinCount() + 1) == String("")
        && compilerBodyRuntimeBuiltinID(name: String("notARuntimeBuiltin")) == compilerBodyRuntimeBuiltinNone()
}
