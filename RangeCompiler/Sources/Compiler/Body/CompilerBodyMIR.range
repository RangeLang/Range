}

function compilerBodyMIRAppendJoinPhis(arena: CompilerBodyArena, blockID: Int): Int {
    let predecessorCount: Int(compilerBodyMIRForwardPredecessorCount(arena: arena, blockID: blockID))
    if predecessorCount < 2 { return 0 }
    state symbolID: Int(0)
    while symbolID < compilerIntTableRowCount(table: arena.symbols) {
        if compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState() {
            state ordinal: Int(0)
            state firstIncomingValueID: Int(0 - 1)
            state allIncomingValid: Bool(true)
            state incomingDiffer: Bool(false)
            while ordinal < predecessorCount {
                let predecessorID: Int(compilerBodyMIRForwardPredecessorAt(arena: arena, blockID: blockID, ordinal: ordinal))
                let incomingValueID: Int(compilerBodyMIRValueForSymbolAtBlock(arena: arena, symbolID: symbolID, blockID: predecessorID))
                if incomingValueID < 0 { allIncomingValid: false }
                if ordinal == 0 { firstIncomingValueID: incomingValueID }
                if ordinal > 0 && incomingValueID != firstIncomingValueID { incomingDiffer: true }
                ordinal: ordinal + 1
            }
            if allIncomingValid && incomingDiffer {
                let typeKind: Int(compilerBodyArenaTypeKindForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn())))
                let typeID: Int(compilerBodyArenaMIRTypeIDForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn())))
                let phiValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValuePhi(), typeKind: typeKind, typeID: typeID, sourceNodeID: compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorSourceColumn()), provenanceKind: compilerBodyMemorySubjectSymbol(), provenanceID: symbolID))
                let operationID: Int(compilerIntTableRowCount(table: arena.mirOperations))
                let firstOperand: Int(compilerIntTableRowCount(table: arena.mirOperands))
                ordinal: 0
                while ordinal < predecessorCount {
                    let joinPredecessorID: Int(compilerBodyMIRForwardPredecessorAt(arena: arena, blockID: blockID, ordinal: ordinal))
                    let joinIncomingValueID: Int(compilerBodyMIRValueForSymbolAtBlock(arena: arena, symbolID: symbolID, blockID: joinPredecessorID))
                    if compilerBodyMIRAppendOperand(arena: arena, operationID: operationID, ordinal: ordinal, valueID: joinIncomingValueID, role: compilerBodyMIROperandPhiIncoming()) != 0 { return 0 - 1 }
                    ordinal: ordinal + 1
                }
                if phiValueID < 0
                    || compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationPhi(), resultValueID: phiValueID, sourceNodeID: 0 - 1, firstOperand: firstOperand, operandCount: predecessorCount, targetKind: compilerBodyMIROperationTargetSymbol(), targetID: symbolID) != operationID
                    || compilerBodyMIRAppendVersion(arena: arena, symbolID: symbolID, blockID: blockID, valueID: phiValueID) < 0 { return 0 - 1 }
            }
        }
        symbolID: symbolID + 1
    }
    return 0
}

function compilerBodyMIRAppendLoopPhis(arena: CompilerBodyArena, blockID: Int): Int {
    state hasBackedge: Bool(false)
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
            && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge() { hasBackedge: true }
        edgeRow: edgeRow + 1
    }
    if !hasBackedge { return 0 }
    let whileNodeID: Int(compilerIntTableValue(table: arena.cfgBlocks, row: blockID, column: compilerBodyCFGBlockTerminatorSourceColumn()))
    let bodyRegionNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: whileNodeID, role: compilerSyntaxRoleWhileBody(), ordinal: 0))
    if whileNodeID < 0 || bodyRegionNodeID < 0 { return 0 - 1 }
    state symbolID: Int(0)
    while symbolID < compilerIntTableRowCount(table: arena.symbols) {
        if compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState()
            && !compilerBodyArenaRegionContainsNode(arena: arena, regionNodeID: bodyRegionNodeID, nodeID: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolDeclarationColumn()))
            && compilerBodyMIRStateWrittenInRegion(arena: arena, symbolID: symbolID, regionNodeID: bodyRegionNodeID) {
            let incomingValueID: Int(compilerBodyMIRValueForSymbolAtBlock(arena: arena, symbolID: symbolID, blockID: blockID))
            let typeKind: Int(compilerBodyArenaTypeKindForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn())))
            let typeID: Int(compilerBodyArenaMIRTypeIDForSpan(arena: arena, fileID: arena.fileID, start: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeStartColumn()), end: compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolTypeEndColumn())))
            let phiValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValuePhi(), typeKind: typeKind, typeID: typeID, sourceNodeID: whileNodeID, provenanceKind: compilerBodyMemorySubjectSymbol(), provenanceID: symbolID))
            let operationID: Int(compilerIntTableRowCount(table: arena.mirOperations))
            let firstOperand: Int(compilerIntTableRowCount(table: arena.mirOperands))
            if incomingValueID < 0 || phiValueID < 0 { return 0 - 1 }
            if compilerBodyMIRAppendOperand(arena: arena, operationID: operationID, ordinal: 0, valueID: incomingValueID, role: compilerBodyMIROperandPhiIncoming()) != 0 { return 0 - 1 }
            if compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationPhi(), resultValueID: phiValueID, sourceNodeID: whileNodeID, firstOperand: firstOperand, operandCount: 2, targetKind: compilerBodyMIROperationTargetSymbol(), targetID: symbolID) != operationID { return 0 - 1 }
            if compilerBodyMIRAppendVersion(arena: arena, symbolID: symbolID, blockID: blockID, valueID: phiValueID) < 0 { return 0 - 1 }
        }
        symbolID: symbolID + 1
    }
    return 0
}

function compilerBodyMIRCompleteLoopPhis(arena: CompilerBodyArena): Int {
    state operationID: Int(0)
    while operationID < compilerIntTableRowCount(table: arena.mirOperations) {
        if compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationKindColumn()) == compilerBodyMIROperationPhi() {
            let blockID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationBlockColumn()))
            let symbolID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationTargetIDColumn()))
            state backedgeBlockID: Int(0 - 1)
            state edgeRow: Int(0)
            while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
                if compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()) == blockID
                    && compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeRoleColumn()) == compilerBodyCFGEdgeBackedge() { backedgeBlockID: compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()) }
                edgeRow: edgeRow + 1
            }
            if backedgeBlockID >= 0 {
                let backedgeValueID: Int(compilerBodyMIRValueForSymbolAtBlock(arena: arena, symbolID: symbolID, blockID: backedgeBlockID))
                if backedgeValueID < 0 { return 0 - 1 }
                if compilerBodyMIRAppendOperand(arena: arena, operationID: operationID, ordinal: 1, valueID: backedgeValueID, role: compilerBodyMIROperandPhiIncoming()) != 0 { return 0 - 1 }
            }
        }
        operationID: operationID + 1
    }
    return 0
}

function compilerBodyMIROperationIsTerminator(kind: Int): Bool {
    return kind == compilerBodyMIROperationCondBranch()
        || kind == compilerBodyMIROperationBranch()
        || kind == compilerBodyMIROperationReturn()
}

