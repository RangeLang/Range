        let versionValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueLocal(), typeKind: typeKind, typeID: compilerBodyMIRNominalTypeID(typeKind: typeKind, typeID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn())), sourceNodeID: statementNodeID, provenanceKind: compilerBodyMemorySubjectSymbol(), provenanceID: assignmentSymbolID))
        let assignmentOperationID: Int(compilerIntTableRowCount(table: arena.mirOperations))
        let assignmentFirstOperand: Int(compilerIntTableRowCount(table: arena.mirOperands))
        if versionValueID < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        if compilerBodyMIRAppendOperand(arena: arena, operationID: assignmentOperationID, ordinal: 0, valueID: assignedExpressionValueID, role: compilerBodyMIROperandArgument()) != 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        if compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationAssignVersion(), resultValueID: versionValueID, sourceNodeID: statementNodeID, firstOperand: assignmentFirstOperand, operandCount: 1, targetKind: compilerBodyMIROperationTargetSymbol(), targetID: assignmentSymbolID) != assignmentOperationID { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        if compilerBodyMIRAppendVersion(arena: arena, symbolID: assignmentSymbolID, blockID: blockID, valueID: versionValueID) < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        return CompilerBodyMIRValueResult(valueID: versionValueID, isValid: true)
    }
    if statementKind == compilerSyntaxKindReturn() {
        return compilerBodyMIRBuildOptionalInjection(arena: arena, sourceNodeID: expressionNodeID, blockID: blockID, payloadValueID: expressionValue.valueID)
