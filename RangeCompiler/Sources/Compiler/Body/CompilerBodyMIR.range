                if arena.ownerKind != compilerBodyArenaOwnerMacro() || returnOperandCount != 0 || validationStorageID != 0 - 1 { return 300000 + operationRow * 100 + operationKind }
            } else {
            let returnValueNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: returnSourceNodeID, role: compilerSyntaxRoleReturnValue(), ordinal: 0))
            state returnValueTypeKind: Int(compilerBodyTypeUnknown())
            if returnValueNodeID >= 0 { returnValueTypeKind: compilerBodyArenaExpressionTypeKind(arena: arena, nodeID: returnValueNodeID) }
            state returnValueTypeID: Int(0 - 1)
            if returnValueTypeKind == compilerBodyTypeConstruct() || returnValueTypeKind == compilerBodyTypeEnum() {
                returnValueTypeID: compilerBodyArenaExpressionTypeID(arena: arena, nodeID: returnValueNodeID)
            }
            state returnTrackedStatus: Int(0)
            if returnValueTypeKind == compilerBodyTypeConstruct() { returnTrackedStatus: compilerBodyArenaTypeTrackedStorageStatus(arena: arena, typeID: returnValueTypeID) }
            if returnSourceNodeID < 0 || returnValueNodeID < 0 || returnValueTypeKind == compilerBodyTypeUnknown() || returnTrackedStatus < 0 { return 300000 + operationRow * 100 + operationKind }
            if ownerReturnMode == compilerFunctionReturnABIIndirect() {
                if validationStorageID < 0 || validationStorageID >= compilerIntTableRowCount(table: arena.storages)
                    || compilerIntTableValue(table: arena.storages, row: validationStorageID, column: compilerBodyStoragePlacementColumn()) != compilerBodyStorageCalleeReturn()
                    || !compilerBodyMemoryHasFact(arena: arena, kind: compilerBodyMemoryFactReturnDestination(), sourceNodeID: arena.rootNodeID, subjectID: validationStorageID)
                    || !compilerBodyMemoryHasFact(arena: arena, kind: compilerBodyMemoryFactInitialize(), sourceNodeID: returnSourceNodeID, subjectID: validationStorageID) { return 300000 + operationRow * 100 + operationKind }
            } else if validationStorageID != 0 - 1 { return 300000 + operationRow * 100 + operationKind }
            }
        }
        if operationKind != compilerBodyMIROperationDirectCall() && operationKind != compilerBodyMIROperationReturn() && operationKind != compilerBodyMIROperationLocalValue() && validationStorageID != 0 - 1 { return 380000 + operationRow * 100 + operationKind }
        if (operationKind == compilerBodyMIROperationLocalValue() || operationKind == compilerBodyMIROperationAssignVersion()) && validationTargetKind != compilerBodyMIROperationTargetSymbol() { return 300000 + operationRow * 100 + operationKind }
        if operationKind == compilerBodyMIROperationPhi() && validationTargetKind != compilerBodyMIROperationTargetSymbol() && validationTargetKind != compilerBodyMIROperationTargetNone() { return 300000 + operationRow * 100 + operationKind }
        if operationKind == compilerBodyMIROperationPhi() && validationTargetKind == compilerBodyMIROperationTargetNone() {
            let optionalPhiSourceNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationSourceColumn()))
            if optionalPhiSourceNodeID < 0 || optionalPhiSourceNodeID >= compilerIntTableRowCount(table: arena.nodes)
                || compilerIntTableValue(table: arena.nodes, row: optionalPhiSourceNodeID, column: 1) != compilerSyntaxKindOptionalCoalescing()
                || compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationOperandCountColumn()) != 2 { return 300000 + operationRow * 100 + operationKind }
        }
        if operationKind != compilerBodyMIROperationDirectCall() && operationKind != compilerBodyMIROperationConstruct() && operationKind != compilerBodyMIROperationOptionalNone() && operationKind != compilerBodyMIROperationLocalValue() && operationKind != compilerBodyMIROperationAssignVersion() && operationKind != compilerBodyMIROperationPhi() && validationTargetKind != compilerBodyMIROperationTargetNone() { return 390000 + operationRow * 100 + operationKind }
        if operationKind == compilerBodyMIROperationAssignVersion() {
            let assignmentNodeID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationRow, column: compilerBodyMIROperationSourceColumn()))
            let targetNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: assignmentNodeID, role: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
            if !compilerBodyMemoryHasFact(arena: arena, kind: compilerBodyMemoryFactWriteUnique(), sourceNodeID: targetNodeID, subjectID: validationTargetID) { return 300000 + operationRow * 100 + operationKind }
        }
        operationRow: operationRow + 1
    }
    state operandRow: Int(0)
    while operandRow < compilerIntTableRowCount(table: arena.mirOperands) {
        let operationID: Int(compilerIntTableValue(table: arena.mirOperands, row: operandRow, column: compilerBodyMIROperandOperationColumn()))
        let valueID: Int(compilerIntTableValue(table: arena.mirOperands, row: operandRow, column: compilerBodyMIROperandValueColumn()))
        if operationID < 0 || operationID >= operationCount || valueID < 0 || valueID >= valueCount { return 4000 + operandRow }
        operandRow: operandRow + 1
    }
    state blockRow: Int(0)
    while blockRow < compilerIntTableRowCount(table: arena.mirBlocks) {
        let firstOperation: Int(compilerIntTableValue(table: arena.mirBlocks, row: blockRow, column: compilerBodyMIRBlockFirstOperationColumn()))
        let blockOperationCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: blockRow, column: compilerBodyMIRBlockOperationCountColumn()))
        if compilerIntTableValue(table: arena.mirBlocks, row: blockRow, column: compilerBodyMIRBlockIDColumn()) != blockRow
            || compilerIntTableValue(table: arena.mirBlocks, row: blockRow, column: compilerBodyMIRBlockCFGColumn()) != blockRow
            || blockOperationCount < 1 || firstOperation < 0 || firstOperation + blockOperationCount > operationCount { return 5 }
        let lastOperationKind: Int(compilerIntTableValue(table: arena.mirOperations, row: firstOperation + blockOperationCount - 1, column: compilerBodyMIROperationKindColumn()))
        if !compilerBodyMIROperationIsTerminator(kind: lastOperationKind) { return 6 }
        blockRow: blockRow + 1
    }
    state versionRow: Int(0)
    while versionRow < compilerIntTableRowCount(table: arena.mirVersions) {
        let versionSymbolID: Int(compilerIntTableValue(table: arena.mirVersions, row: versionRow, column: compilerBodyMIRVersionSymbolColumn()))
        let versionBlockID: Int(compilerIntTableValue(table: arena.mirVersions, row: versionRow, column: compilerBodyMIRVersionBlockColumn()))
        let versionValueID: Int(compilerIntTableValue(table: arena.mirVersions, row: versionRow, column: compilerBodyMIRVersionValueColumn()))
        if versionSymbolID < 0 || versionSymbolID >= compilerIntTableRowCount(table: arena.symbols)
            || versionBlockID < 0 || versionBlockID >= compilerIntTableRowCount(table: arena.cfgBlocks)
            || versionValueID < 0 || versionValueID >= valueCount { return 7 }
        versionRow: versionRow + 1
    }
    state patternSymbolID: Int(0)
    while patternSymbolID < compilerIntTableRowCount(table: arena.symbols) {
        if compilerIntTableValue(table: arena.symbols, row: patternSymbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolEnumPayloadBinding() {
            let patternValueID: Int(compilerBodyMIRUniqueVersionForSymbol(arena: arena, symbolID: patternSymbolID))
            if patternValueID < 0 || !compilerBodyMIRValueIsProducedBy(arena: arena, valueID: patternValueID, operationKind: compilerBodyMIROperationEnumPayload()) { return 8 }
        }
        patternSymbolID: patternSymbolID + 1
    }
    return 0
}

function compilerBodyMIRIsValid(arena: CompilerBodyArena, abiPlan: CompilerModuleABIPlan): Bool {
    return compilerBodyMIRValidationCode(arena: arena, abiPlan: abiPlan) == 0
}
