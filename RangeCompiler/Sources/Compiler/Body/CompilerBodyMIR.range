function compilerBodyMIRMarkStringAppendChainOwned(arena: CompilerBodyArena, valueID: Int, symbolID: Int): Bool {
    if valueID < 0 || valueID >= compilerIntTableRowCount(table: arena.mirValues)
        || symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolState() { return false }
    state cursorValueID: Int(valueID)
    state rootFound: Bool(false)
    while !rootFound {
        let producerOperationID: Int(compilerBodyMIRValueProducerOperationAny(arena: arena, valueID: cursorValueID))
        if producerOperationID < 0
            || compilerIntTableValue(table: arena.mirOperations, row: producerOperationID, column: compilerBodyMIROperationKindColumn()) != compilerBodyMIROperationStringConcat() { return false }
        let leftValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: producerOperationID, ordinal: 0))
        if leftValueID < 0 || leftValueID >= compilerIntTableRowCount(table: arena.mirValues) { return false }
        if compilerIntTableValue(table: arena.mirValues, row: leftValueID, column: compilerBodyMIRValueProvenanceKindColumn()) == compilerBodyMemorySubjectSymbol()
            && compilerIntTableValue(table: arena.mirValues, row: leftValueID, column: compilerBodyMIRValueProvenanceIDColumn()) == symbolID {
            rootFound: true
        } else {
            cursorValueID: leftValueID
        }
    }

    cursorValueID: valueID
    state markedRoot: Bool(false)
    while !markedRoot {
        let producerOperationID: Int(compilerBodyMIRValueProducerOperationAny(arena: arena, valueID: cursorValueID))
        let leftValueID: Int(compilerBodyMIROperationOperandValue(arena: arena, operationID: producerOperationID, ordinal: 0))
        if arena.mirOperations.values.update(element: compilerBodyMIROperationStringAppendOwned(), index: producerOperationID * compilerBodyMIROperationColumnCount() + compilerBodyMIROperationKindColumn()) != 0 { return false }
        if compilerIntTableValue(table: arena.mirValues, row: leftValueID, column: compilerBodyMIRValueProvenanceKindColumn()) == compilerBodyMemorySubjectSymbol()
            && compilerIntTableValue(table: arena.mirValues, row: leftValueID, column: compilerBodyMIRValueProvenanceIDColumn()) == symbolID {
            markedRoot: true
        } else {
            cursorValueID: leftValueID
        }
    }
    return true
}

function compilerBodyMIRCommitScheduledStatement(arena: CompilerBodyArena, statementNodeID: Int, blockID: Int): CompilerBodyMIRValueResult {
    let statementKind: Int(compilerIntTableValue(table: arena.nodes, row: statementNodeID, column: 1))
    let expressionNodeID: Int(compilerBodyArenaStatementExpression(arena: arena, statementNodeID: statementNodeID))
    if expressionNodeID < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
    let expressionValue: CompilerBodyMIRValueResult(compilerBodyMIRBuildExpression(arena: arena, nodeID: expressionNodeID, blockID: blockID))
    if !expressionValue.isValid { return expressionValue }
    if statementKind == compilerSyntaxKindLocalBinding() {
        let symbolID: Int(compilerBodyArenaSymbolForIdentifier(arena: arena, identifierNodeID: statementNodeID))
        if symbolID < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        let localTypeKind: Int(compilerBodyArenaSymbolTypeKind(arena: arena, symbolID: symbolID))
        let localTypeID: Int(compilerBodyMIRNominalTypeID(typeKind: localTypeKind, typeID: compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolID)))
        state localExpressionValueID: Int(expressionValue.valueID)
        if localTypeKind == compilerBodyTypeInt() && localTypeID >= 0
            && compilerIntTableValue(table: arena.mirValues, row: expressionValue.valueID, column: compilerBodyMIRValueTypeColumn()) == compilerBodyTypeInt() {
            let specializedTypeName: String(compilerBodyArenaTypeNameForTypeID(arena: arena, typeID: localTypeID))
            let literalNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: expressionValue.valueID, column: compilerBodyMIRValueSourceColumn()))
            state isNumericLiteral: Bool(false)
            if literalNodeID >= 0 && literalNodeID < compilerIntTableRowCount(table: arena.nodes) {
                let literalKind: Int(compilerIntTableValue(table: arena.nodes, row: literalNodeID, column: 1))
                if literalKind == compilerSyntaxKindIntegerLiteral() {
                    isNumericLiteral: true
                } else if literalKind == compilerSyntaxKindPrefixNegate() {
                    let magnitudeNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: literalNodeID, role: compilerSyntaxRoleOperand(), ordinal: 0))
                    if magnitudeNodeID >= 0
                        && compilerIntTableValue(table: arena.nodes, row: magnitudeNodeID, column: 1) == compilerSyntaxKindIntegerLiteral() {
                        isNumericLiteral: true
                    }
                }
            }
            if compilerIntegerTypeIsSigned(typeName: specializedTypeName) && isNumericLiteral {
                let specializedValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueConstant(), typeKind: compilerBodyTypeInt(), typeID: localTypeID, sourceNodeID: literalNodeID, provenanceKind: compilerBodyMemorySubjectNode(), provenanceID: literalNodeID))
                if specializedValueID < 0
                    || compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationConstant(), resultValueID: specializedValueID, sourceNodeID: literalNodeID, firstOperand: compilerIntTableRowCount(table: arena.mirOperands), operandCount: 0, targetKind: compilerBodyMIROperationTargetNone(), targetID: 0 - 1) < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
                localExpressionValueID: specializedValueID
            }
        }
        if localTypeKind == compilerBodyTypeUnsigned8()
            && compilerIntTableValue(table: arena.mirValues, row: expressionValue.valueID, column: compilerBodyMIRValueTypeColumn()) == compilerBodyTypeInt() {
            let literalNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: expressionValue.valueID, column: compilerBodyMIRValueSourceColumn()))
            let literalValue: Int(compilerMacroExecutionScalarValue(arena: arena, valueID: expressionValue.valueID))
            if literalNodeID < 0 || literalNodeID >= compilerIntTableRowCount(table: arena.nodes)
                || compilerIntTableValue(table: arena.nodes, row: literalNodeID, column: 1) != compilerSyntaxKindIntegerLiteral()
                || literalValue < 0 || literalValue > 255 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
            let narrowedValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueConstant(), typeKind: compilerBodyTypeUnsigned8(), typeID: 0 - 1, sourceNodeID: literalNodeID, provenanceKind: compilerBodyMemorySubjectNode(), provenanceID: literalNodeID))
            if narrowedValueID < 0
                || compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationConstant(), resultValueID: narrowedValueID, sourceNodeID: literalNodeID, firstOperand: compilerIntTableRowCount(table: arena.mirOperands), operandCount: 0, targetKind: compilerBodyMIROperationTargetNone(), targetID: 0 - 1) < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
            localExpressionValueID: narrowedValueID
        }
        if localTypeKind == compilerBodyTypeFloat32()
            && compilerIntTableValue(table: arena.mirValues, row: expressionValue.valueID, column: compilerBodyMIRValueTypeColumn()) == compilerBodyTypeFloat() {
            let literalNodeID: Int(compilerIntTableValue(table: arena.mirValues, row: expressionValue.valueID, column: compilerBodyMIRValueSourceColumn()))
            if literalNodeID < 0 || literalNodeID >= compilerIntTableRowCount(table: arena.nodes)
                || compilerIntTableValue(table: arena.nodes, row: literalNodeID, column: 1) != compilerSyntaxKindDoubleLiteral() { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
            let narrowedValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueConstant(), typeKind: compilerBodyTypeFloat32(), typeID: 0 - 1, sourceNodeID: literalNodeID, provenanceKind: compilerBodyMemorySubjectNode(), provenanceID: literalNodeID))
            if narrowedValueID < 0
                || compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationConstant(), resultValueID: narrowedValueID, sourceNodeID: literalNodeID, firstOperand: compilerIntTableRowCount(table: arena.mirOperands), operandCount: 0, targetKind: compilerBodyMIROperationTargetNone(), targetID: 0 - 1) < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
            localExpressionValueID: narrowedValueID
        }
        if localTypeKind == compilerBodyTypeString()
            && (compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) == compilerBodySymbolState()
                || compilerBodyMIRValueComesFromStringState(arena: arena, valueID: expressionValue.valueID)) {
            localExpressionValueID: compilerBodyMIRAppendStringOwnedCopy(arena: arena, sourceNodeID: statementNodeID, blockID: blockID, sourceValueID: expressionValue.valueID)
            if localExpressionValueID < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        }
        let localValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueLocal(), typeKind: localTypeKind, typeID: localTypeID, sourceNodeID: statementNodeID, provenanceKind: compilerBodyMemorySubjectSymbol(), provenanceID: symbolID))
