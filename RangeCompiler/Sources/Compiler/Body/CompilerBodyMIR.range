function compilerBodyMIRBlockExitsLexicalStringState(arena: CompilerBodyArena, symbolID: Int, blockID: Int): Bool {
    if symbolID < 0 || symbolID >= compilerIntTableRowCount(table: arena.symbols)
        || blockID < 0 || blockID >= compilerIntTableRowCount(table: arena.cfgBlocks)
        || (compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolLet()
            && compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()) != compilerBodySymbolState())
        || compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: compilerBodyArenaSymbolTypeID(arena: arena, symbolID: symbolID)) != compilerBodyTypeString() { return false }
    let rootPathID: Int(compilerBodyOwnedPathFind(paths: arena.ownedPaths, rootKind: compilerBodyOwnedPathRootSymbol(), rootID: symbolID, memberRow: 0 - 1))
    if rootPathID < 0 { return false }
