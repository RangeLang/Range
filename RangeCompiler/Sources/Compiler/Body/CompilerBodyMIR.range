    }
    if resolutionRow < 0 || targetKind != compilerBodyResolutionLocalSymbol()
        || compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()) != compilerBodyTypeConstruct() {
        memberPath.destroy()
        return 0 - 1
    }
    let symbolID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
    let symbolKind: Int(compilerIntTableValue(table: arena.symbols, row: symbolID, column: compilerBodySymbolKindColumn()))
    state storageID: Int(0 - 1)
    if symbolKind != compilerBodySymbolReceiver() { storageID: compilerBodyStorageForSymbol(arena: arena, symbolID: symbolID) }
    if symbolKind != compilerBodySymbolReceiver() && storageID < 0 {
        memberPath.destroy()
        return 0 - 1
    }
    state addressValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueReceiverAddress(), typeKind: compilerBodyTypeConstruct(), typeID: compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeIDColumn()), sourceNodeID: currentNodeID, provenanceKind: compilerBodyMemorySubjectSymbol(), provenanceID: symbolID))
    state pathIndex: Int(memberPath.count - 1)
    while addressValueID >= 0 && pathIndex >= 0 {
        let memberNodeID: Int(memberPath.element(index: pathIndex))
        let memberResolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: memberNodeID))
        if memberResolutionRow < 0 {
            addressValueID: 0 - 1
        } else {
            let baseAddressValueID: Int(addressValueID)
            let projectedAddressValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueReceiverAddress(), typeKind: compilerBodyTypeConstruct(), typeID: compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTypeIDColumn()), sourceNodeID: memberNodeID, provenanceKind: compilerBodyMemorySubjectNode(), provenanceID: baseAddressValueID))
            let operationID: Int(compilerIntTableRowCount(table: arena.mirOperations))
            let firstOperand: Int(compilerIntTableRowCount(table: arena.mirOperands))
            if projectedAddressValueID < 0
                || compilerBodyMIRAppendOperand(arena: arena, operationID: operationID, ordinal: 0, valueID: baseAddressValueID, role: compilerBodyMIROperandArgument()) != 0
                || compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationMemberAddress(), resultValueID: projectedAddressValueID, sourceNodeID: memberNodeID, firstOperand: firstOperand, operandCount: 1, targetKind: compilerBodyMIROperationTargetNone(), targetID: compilerIntTableValue(table: arena.resolutions, row: memberResolutionRow, column: compilerBodyResolutionTargetIDColumn())) != operationID {
                addressValueID: 0 - 1
            } else {
                addressValueID: projectedAddressValueID
            }
        }
        pathIndex: pathIndex - 1
    }
    if memberPath.destroy() != 0 { return 0 - 1 }
    return addressValueID
}

