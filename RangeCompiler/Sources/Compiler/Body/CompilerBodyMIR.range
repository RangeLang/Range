        if localValueID < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        if compilerBodyMIRAppendOperand(arena: arena, operationID: operationID, ordinal: 0, valueID: localExpressionValueID, role: compilerBodyMIROperandArgument()) != 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        if compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: compilerBodyMIROperationLocalValue(), resultValueID: localValueID, sourceNodeID: statementNodeID, firstOperand: firstOperand, operandCount: 1, targetKind: compilerBodyMIROperationTargetSymbol(), targetID: symbolID) != operationID { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        if compilerBodyMIRAppendVersion(arena: arena, symbolID: symbolID, blockID: blockID, valueID: localValueID) < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        return CompilerBodyMIRValueResult(valueID: localValueID, isValid: true)
    }
    if statementKind == compilerSyntaxKindAssignment() {
        let targetNodeID: Int(compilerBodyArenaChild(arena: arena, ownerNodeID: statementNodeID, role: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: targetNodeID))
        if targetNodeID < 0 || resolutionRow < 0 { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        let assignmentTargetKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()))
        let assignmentSymbolID: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetIDColumn()))
