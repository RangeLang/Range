function compilerBodyMIRValueForOwnedSymbolPathAtBlock(arena: CompilerBodyArena, pathID: Int, blockID: Int, sourceNodeID: Int): Int {
    if pathID < 0 || pathID >= compilerIntTableRowCount(table: arena.ownedPaths) { return 0 - 1 }
    let memberPath: Buffer<Int>(bufferCreateInt(capacity: 4))
    state currentPathID: Int(pathID)
    while currentPathID >= 0 && compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn()) >= 0 {
        if memberPath.append(element: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathMemberColumn())) != 0 {
            memberPath.destroy()
            return 0 - 1
        }
        currentPathID: compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathParentColumn())
    }
    if currentPathID < 0 {
        memberPath.destroy()
        return 0 - 1
    }
    let rootKind: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathRootKindColumn()))
    let rootID: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathRootIDColumn()))
    state valueID: Int(0 - 1)
    if rootKind == compilerBodyOwnedPathRootSymbol() {
        valueID: compilerBodyMIRValueForSymbolAtBlock(arena: arena, symbolID: rootID, blockID: blockID)
    } else if rootKind == compilerBodyOwnedPathRootValue() {
        valueID: compilerBodyMIRExpressionValue(arena: arena, nodeID: rootID, action: compilerBodyCFGScheduleEvaluateNode())
        if valueID < 0 { valueID: compilerBodyMIRExpressionValue(arena: arena, nodeID: rootID, action: compilerBodyCFGScheduleOptionalJoin()) }
    }
    state memberIndex: Int(memberPath.count - 1)
    while valueID >= 0 && memberIndex >= 0 {
        let memberRow: Int(memberPath.element(index: memberIndex))
        let childPathID: Int(compilerBodyOwnedPathFindChild(paths: arena.ownedPaths, parentPathID: currentPathID, memberRow: memberRow))
        state memberTypeID: Int(0 - 1)
        if childPathID >= 0 { memberTypeID: compilerIntTableValue(table: arena.ownedPaths, row: childPathID, column: compilerBodyOwnedPathTypeColumn()) }
        let memberValueID: Int(compilerBodyMIRAppendValue(arena: arena, kind: compilerBodyMIRValueLocal(), typeKind: compilerBodyArenaTypeKindForTypeID(arena: arena, typeID: memberTypeID), typeID: memberTypeID, sourceNodeID: sourceNodeID, provenanceKind: compilerBodyMemorySubjectOwnedPath(), provenanceID: pathID))
        let operationID: Int(compilerIntTableRowCount(table: arena.mirOperations))
        let firstOperand: Int(compilerIntTableRowCount(table: arena.mirOperands))
        state projectionKind: Int(compilerBodyMIROperationMemberRead())
        state projectionTargetID: Int(memberRow)
        let parentTypeID: Int(compilerIntTableValue(table: arena.ownedPaths, row: currentPathID, column: compilerBodyOwnedPathTypeColumn()))
        if memberRow == compilerBodyOwnedPathOptionalPayloadMember(arena: arena)
            && compilerBodyArenaTypeIDIsOptional(arena: arena, typeID: parentTypeID) {
            projectionKind: compilerBodyMIROperationOptionalPayload()
            projectionTargetID: 0 - 1
        }
        if memberTypeID < 0 || memberValueID < 0
            || compilerBodyMIRAppendOperand(arena: arena, operationID: operationID, ordinal: 0, valueID: valueID, role: compilerBodyMIROperandArgument()) != 0
            || compilerBodyMIRAppendOperation(arena: arena, blockID: blockID, kind: projectionKind, resultValueID: memberValueID, sourceNodeID: sourceNodeID, firstOperand: firstOperand, operandCount: 1, targetKind: compilerBodyMIROperationTargetNone(), targetID: projectionTargetID) != operationID {
            valueID: 0 - 1
        } else {
            valueID: memberValueID
            currentPathID: childPathID
        }
        memberIndex: memberIndex - 1
    }
    if memberPath.destroy() != 0 { return 0 - 1 }
    return valueID
}

