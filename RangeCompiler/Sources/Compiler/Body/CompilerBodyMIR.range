function compilerBodyGraphZeroFreezeMIR(arena: CompilerBodyArena): Int {
    if arena.graphZeroState.element(index: compilerBodyGraphZeroStateFrozen()) != 0 { return 0 - 1 }
    let operationCount: Int(compilerIntTableRowCount(table: arena.mirOperations))
    let depths: Buffer<Int>(bufferCreateInt(capacity: operationCount + 1))
    state operationID: Int(0)
    while operationID < operationCount {
        if depths.append(element: 1) != 0 {
            depths.destroy()
            return 0 - 1
        }
        operationID: operationID + 1
    }
    operationID: 0
    while operationID < operationCount {
        state depth: Int(1)
        state dependencyRow: Int(0)
        while dependencyRow < compilerIntTableRowCount(table: arena.graphZeroMIRDependencies) {
            if compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyConsumerColumn()) == operationID
                && compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyKindColumn()) != compilerBodyGraphZeroMIRDependencyLoopCarried() {
                let producer: Int(compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: dependencyRow, column: compilerBodyGraphZeroMIRDependencyProducerColumn()))
                if producer >= 0 && producer < operationID {
                    let candidate: Int(depths.element(index: producer) + 1)
                    if candidate > depth { depth: candidate }
                }
            }
            dependencyRow: dependencyRow + 1
        }
        if depths.update(element: depth, index: operationID) != 0 {
            depths.destroy()
            return 0 - 1
        }
        let blockID: Int(compilerIntTableValue(table: arena.mirOperations, row: operationID, column: compilerBodyMIROperationBlockColumn()))
        let frontierID: Int(compilerIntTableRowCount(table: arena.graphZeroMIRFrontiers))
        if frontierID != operationID
            || compilerIntTableAppend(table: arena.graphZeroMIRFrontiers, value: frontierID) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRFrontiers, value: operationID) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRFrontiers, value: blockID) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRFrontiers, value: depth) != 0
            || compilerIntTableAppend(table: arena.graphZeroMIRFrontiers, value: operationID) != 0 {
            depths.destroy()
            return 0 - 1
        }
        operationID: operationID + 1
    }
    let destroyStatus: Int(depths.destroy())
    if destroyStatus != 0
        || arena.graphZeroState.update(element: 1, index: compilerBodyGraphZeroStateValid()) != 0
        || arena.graphZeroState.update(element: 1, index: compilerBodyGraphZeroStateFrozen()) != 0 { return 0 - 1 }
    return 0
}

function compilerBodyMIRBuild(arena: CompilerBodyArena): Int {
    if !compilerBodyMemoryIsFrozenAndValid(arena: arena)
        || !compilerBodyArenaSymbolsAndResolutionsAreValid(arena: arena)
        || !compilerBodyArenaCFGIsValid(arena: arena) { return 0 - 1 }
    let blockCount: Int(compilerIntTableRowCount(table: arena.cfgBlocks))
    let scheduleStarts: Buffer<Int>(bufferCreateInt(capacity: blockCount))
    let scheduleCounts: Buffer<Int>(bufferCreateInt(capacity: blockCount))
    let scheduleRows: Buffer<Int>(bufferCreateInt(capacity: compilerIntTableRowCount(table: arena.cfgSchedule)))
    state status: Int(compilerBodyArenaCFGScheduleBuildBlockIndex(arena: arena, blockStarts: scheduleStarts, blockCounts: scheduleCounts, scheduleRows: scheduleRows))
