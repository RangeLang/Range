function compilerBodyMIRBuildMemberReceiverAddress(arena: CompilerBodyArena, receiverNodeID: Int, blockID: Int): Int {
    let memberPath: Buffer<Int>(bufferCreateInt(capacity: 4))
    state currentNodeID: Int(receiverNodeID)
