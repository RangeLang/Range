            let memberAssignmentValueID: Int(compilerBodyMIRCommitMemberAssignment(arena: arena, statementNodeID: statementNodeID, blockID: blockID, assignedValueID: expressionValue.valueID))
            return CompilerBodyMIRValueResult(valueID: memberAssignmentValueID, isValid: memberAssignmentValueID >= 0)
        }
        if assignmentTargetKind != compilerBodyResolutionLocalSymbol()
            || !compilerBodyMemoryHasFact(arena: arena, kind: compilerBodyMemoryFactWriteUnique(), sourceNodeID: targetNodeID, subjectID: assignmentSymbolID) { return CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false) }
        let typeKind: Int(compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTypeKindColumn()))
        state assignedExpressionValueID: Int(expressionValue.valueID)
        if typeKind == compilerBodyTypeString() {
