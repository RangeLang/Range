function compilerBodyGraphZeroAppendControlDependencies(arena: CompilerBodyArena): Int {
    state edgeRow: Int(0)
    while edgeRow < compilerIntTableRowCount(table: arena.cfgEdges) {
        let fromBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeFromColumn()))
        let toBlockID: Int(compilerIntTableValue(table: arena.cfgEdges, row: edgeRow, column: compilerBodyCFGEdgeToColumn()))
        if fromBlockID < 0 || fromBlockID >= compilerIntTableRowCount(table: arena.mirBlocks)
            || toBlockID < 0 || toBlockID >= compilerIntTableRowCount(table: arena.mirBlocks) { return 0 - 1 }
        let fromFirst: Int(compilerIntTableValue(table: arena.mirBlocks, row: fromBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
        let fromCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: fromBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
        let toFirst: Int(compilerIntTableValue(table: arena.mirBlocks, row: toBlockID, column: compilerBodyMIRBlockFirstOperationColumn()))
        let toCount: Int(compilerIntTableValue(table: arena.mirBlocks, row: toBlockID, column: compilerBodyMIRBlockOperationCountColumn()))
        if fromFirst < 0 || fromCount < 1 || toFirst < 0 || toCount < 1 { return 0 - 1 }
        let producer: Int(fromFirst + fromCount - 1)
        state ordinal: Int(0)
        while ordinal < toCount {
            let consumer: Int(toFirst + ordinal)
            state hasLocalProducer: Bool(false)
            state existingDependencyRow: Int(0)
            while existingDependencyRow < compilerIntTableRowCount(table: arena.graphZeroMIRDependencies) {
                if compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: existingDependencyRow, column: compilerBodyGraphZeroMIRDependencyConsumerColumn()) == consumer {
                    let existingProducer: Int(compilerIntTableValue(table: arena.graphZeroMIRDependencies, row: existingDependencyRow, column: compilerBodyGraphZeroMIRDependencyProducerColumn()))
                    if existingProducer >= toFirst && existingProducer < toFirst + toCount { hasLocalProducer: true }
                }
                existingDependencyRow: existingDependencyRow + 1
            }
            if !hasLocalProducer && producer != consumer {
                state dependencyKind: Int(compilerBodyGraphZeroMIRDependencyControl())
                if producer >= consumer { dependencyKind: compilerBodyGraphZeroMIRDependencyLoopCarried() }
                let dependencyID: Int(compilerIntTableRowCount(table: arena.graphZeroMIRDependencies))
                if compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: dependencyID) != 0
                    || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: producer) != 0
                    || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: consumer) != 0
                    || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: 0 - 1) != 0
                    || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: dependencyKind) != 0
                    || compilerIntTableAppend(table: arena.graphZeroMIRDependencies, value: ordinal) != 0 { return 0 - 1 }
            }
            ordinal: ordinal + 1
        }
        edgeRow: edgeRow + 1
    }
    return 0
