    let action: Int(compilerIntTableValue(table: arena.cfgSchedule, row: scheduleRow, column: compilerBodyCFGScheduleActionColumn()))
    state result: CompilerBodyMIRValueResult(valueID: 0 - 1, isValid: false)
    if action == compilerBodyCFGScheduleEvaluateNode() { result: compilerBodyMIRBuildExpression(arena: arena, nodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleOptionalTag() { result: compilerBodyMIRBuildScheduledOptionalTag(arena: arena, nodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleOptionalPayload() { result: compilerBodyMIRBuildScheduledOptionalPayload(arena: arena, nodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleOptionalJoin() { result: compilerBodyMIRBuildScheduledOptionalJoin(arena: arena, nodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleStatementCommit() { result: compilerBodyMIRCommitScheduledStatement(arena: arena, statementNodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleSwitchMatch() { result: compilerBodyMIRBuildScheduledSwitchMatch(arena: arena, caseNodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleSwitchPayloadBind() { result: compilerBodyMIRBuildScheduledSwitchPayloadBind(arena: arena, bindingNodeID: nodeID, blockID: blockID) }
    if action == compilerBodyCFGScheduleOptionalFallback() { result: compilerBodyMIRBuildScheduledOptionalFallback(arena: arena, nodeID: nodeID, blockID: blockID) }
    let nodeKind: Int(compilerIntTableValue(table: arena.nodes, row: nodeID, column: 1))
    if !result.isValid { return 0 - (action * 1000000 + nodeKind * 10000 + nodeID + 1) }
    if compilerBodyMIRAppendExpressionValue(arena: arena, nodeID: nodeID, action: action, valueID: result.valueID, blockID: blockID) < 0 { return 0 - (8000000 + nodeKind * 10000 + nodeID + 1) }
    return 0
}

