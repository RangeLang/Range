function compilerBodyMemoryOptionalInjectionTypeID(arena: CompilerBodyArena, sourceNodeID: Int): Int {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()) == compilerBodyMemoryFactOptionalInjection()
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()) == sourceNodeID
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectKindColumn()) == compilerBodyMemorySubjectNode()
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()) == sourceNodeID { return compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactAuxColumn()) }
        row: row + 1
    }
    return 0 - 1
}

function compilerBodyMIRStateWrittenInRegion(arena: CompilerBodyArena, symbolID: Int, regionNodeID: Int): Bool {
    state row: Int(0)
    while row < compilerIntTableRowCount(table: arena.memoryFacts) {
        let sourceNodeID: Int(compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSourceColumn()))
        let resolutionRow: Int(compilerBodyArenaResolutionForSource(arena: arena, sourceNodeID: sourceNodeID))
        if compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactKindColumn()) == compilerBodyMemoryFactWriteUnique()
            && compilerIntTableValue(table: arena.memoryFacts, row: row, column: compilerBodyMemoryFactSubjectIDColumn()) == symbolID
            && resolutionRow >= 0
            && compilerIntTableValue(table: arena.resolutions, row: resolutionRow, column: compilerBodyResolutionTargetKindColumn()) == compilerBodyResolutionLocalSymbol()
            && compilerBodyArenaRegionContainsNode(arena: arena, regionNodeID: regionNodeID, nodeID: sourceNodeID) { return true }
        row: row + 1
    }
