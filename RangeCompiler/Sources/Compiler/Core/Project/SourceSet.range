    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Macros/Many.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Macros/Print.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Macros/Integer.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Macros/Storage.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Macros/Syntax.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Macros/Type.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Int.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Byte.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Vector.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Syntax/Application.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Syntax/Construct.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Syntax/DeclarationForms.range\n")
