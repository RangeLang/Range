    paths.append(text: "RangeCompiler/Sources/Compiler/Core/Package/Project.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/System/Memory/Opaque.range\n")
    paths.append(text: "RangeCompiler/Sources/Compiler/Core/System/Output.range\n")
    return paths
}

function compilerBDiscoverProjectSourcePaths(route: String): String {
    state paths: String(compilerBDiscoverSourcePaths(route: route))
    if fileManagerPathExists(path: "\(route)/Project.range") {
        let standardPaths: String(compilerBStandardLibrarySourcePaths())
        paths.append(text: standardPaths)
    }
    return paths
}
