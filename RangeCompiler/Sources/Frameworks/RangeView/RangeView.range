construct Route {
    let _ path: String
    binding _ page: @page?(nil)
    binding _ children: () -> [Route]
}

@entry
@component
construct VStack {
    state spacing: Float
    binding _ children: () -> [@component]

    derived body: [@component] {
        children()
    }

    function emit(): Fragment {
        return Fragment(
            html: "<div class=\"range-view-v-stack\" style=\"--range-view-v-stack-spacing: \(spacing)px\">\n",
            css: ".range-view-v-stack { display: flex; flex-direction: column; gap: var(--range-view-v-stack-spacing); }\n",
            children: children()
        )
    }
}


construct Fragment {
    let html: String
    let css: String
    let children: () -> [@component]

    derived body: [@component] {
        children()
    }
}

function rangeViewVStackBegin(spacing: Int, html: String, css: String): Int {
    if html.append(text: "<div class=\"range-view-v-stack\" style=\"--range-view-v-stack-spacing: \(spacing)px\">\n") != 0 {
        return 1
    }
    return css.append(text: ".range-view-v-stack { display: flex; flex-direction: column; gap: var(--range-view-v-stack-spacing); }\n")
}

function rangeViewVStackEnd(html: String): Int {
    return html.append(text: "</div>\n")
}

function rangeViewEmit(
    path: String,
    html: String,
    css: String,
    javaScript: String
): Int {
    let htmlStatus: Int(writeFile(path: "\(path).html", text: html))
    if htmlStatus != 0 {
        return htmlStatus
    }

    let cssStatus: Int(writeFile(path: "\(path).css", text: css))
    if cssStatus != 0 {
        return cssStatus
    }

    return writeFile(path: "\(path).js", text: javaScript)
}
