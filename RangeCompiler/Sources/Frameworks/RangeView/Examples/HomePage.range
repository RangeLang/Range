@app
construct Website {
    let name: String

    derived routes: Route {
        Route("/") {
            Route("home", HomePage())
        }
    }
}

@component
construct Header {
    derived view: [@component] {}
}

function renderHeader(title: String, html: String): Int {
    return html.append(text: "<header><h1>\(title)</h1></header>\n")
}

@page
construct HomePage {
    derived body: [@component] {
        Stack(axis: .vertical, spacing: 10) {
            Header()
        }
    }
}

function renderHomePage(name: String, html: String, css: String, javaScript: String): Int {
    if html.append(text: "<!doctype html>\n<html><head><title>\(name)</title><link rel=stylesheet href=index.css></head><body>\n") != 0 {
        return 1
    }
    if renderHeader(title: name, html: html) != 0 {
        return 2
    }
    if html.append(text: "</body><script src=index.js></script></html>\n") != 0 {
        return 3
    }
    if css.append(text: "body { font-family: system-ui; }\n") != 0 {
        return 4
    }
    return javaScript.append(text: "document.documentElement.dataset.rangeView = 'ready';\n")
}

function runRangeView(path: String): Int {
    let name: String("Range")
    state html: String("")
    state css: String("")
    state javaScript: String("")

    let renderStatus: Int(renderHomePage(
        name: name,
        html: html,
        css: css,
        javaScript: javaScript))
    if renderStatus != 0 {
        return renderStatus
    }

    let emitStatus: Int(rangeViewEmit(
        path: path,
        html: html,
        css: css,
        javaScript: javaScript))

    html.destroy()
    css.destroy()
    javaScript.destroy()
    return emitStatus
}
