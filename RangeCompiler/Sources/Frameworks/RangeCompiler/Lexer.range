enum RangeCompilerTokenKind {
    case eof
    case identifier
    case declarationKeyword
    case controlKeyword
    case macroAttribute
    case integer
    case stringLiteral
    case leftBrace
    case rightBrace
    case leftParen
    case rightParen
    case punctuation
    case operator
    case comment
    case invalid
}

construct RangeCompilerToken {
    let kind: RangeCompilerTokenKind
    let start: Int
    let end: Int
    let text: String
}

function rangeCompilerTokenKindTag(kind: RangeCompilerTokenKind): Int {
    switch kind {
    case .eof: return 0
    case .identifier: return 1
    case .declarationKeyword: return 2
    case .controlKeyword: return 3
    case .macroAttribute: return 4
    case .integer: return 5
    case .stringLiteral: return 6
    case .leftBrace: return 7
    case .rightBrace: return 8
    case .leftParen: return 9
    case .rightParen: return 10
    case .punctuation: return 11
    case .operator: return 12
    case .comment: return 13
    case .invalid: return 14
    }
}

function rangeCompilerLexNext(source: String, start: Int): RangeCompilerToken {
    let cursor: Int(rangeCompilerSkipWhitespace(source: source, start: start))
    let byte: Int(stringByteAt(source: source, index: cursor))
    if byte == 0 {
        return RangeCompilerToken(kind: .eof, start: cursor, end: cursor, text: String(""))
    }
    if byte == 47 && stringByteAt(source: source, index: cursor + 1) == 47 {
        return rangeCompilerComment(source: source, start: cursor)
    }
    if rangeCompilerIsIdentifierStart(byte: byte) {
        return rangeCompilerIdentifier(source: source, start: cursor)
    }
    if byte >= 48 && byte <= 57 {
        return rangeCompilerNumber(source: source, start: cursor)
    }
    if byte == 64 {
        return rangeCompilerMacroAttribute(source: source, start: cursor)
    }
    if byte == 34 {
        return rangeCompilerString(source: source, start: cursor)
    }
    return rangeCompilerSymbol(source: source, start: cursor, byte: byte)
}

function rangeCompilerSkipWhitespace(source: String, start: Int): Int {
    state cursor: Int(start)
    while cursor < stringLength(value: source)
        && stringByteAt(source: source, index: cursor) <= 32 {
        cursor: cursor + 1
    }
    return cursor
}

function rangeCompilerIdentifier(source: String, start: Int): RangeCompilerToken {
    state end: Int(start + 1)
    while end < stringLength(value: source)
        && rangeCompilerIsIdentifierPart(byte: stringByteAt(source: source, index: end)) {
        end: end + 1
    }
    let text: String(stringSubstring(source: source, start: start, end: end))
    state kind: RangeCompilerTokenKind(.identifier)
    if rangeCompilerIsDeclarationKeyword(text: text) {
        kind: .declarationKeyword
    } else if rangeCompilerIsControlKeyword(text: text) {
        kind: .controlKeyword
    }
    return RangeCompilerToken(kind: kind, start: start, end: end, text: text)
}

function rangeCompilerNumber(source: String, start: Int): RangeCompilerToken {
    state end: Int(start + 1)
    while end < stringLength(value: source) {
        let byte: Int(stringByteAt(source: source, index: end))
        if byte < 48 || byte > 57 {
            return RangeCompilerToken(
                kind: .integer,
                start: start,
                end: end,
                text: stringSubstring(source: source, start: start, end: end))
        }
        end: end + 1
    }
    return RangeCompilerToken(
        kind: .integer,
        start: start,
        end: end,
        text: stringSubstring(source: source, start: start, end: end))
}

function rangeCompilerMacroAttribute(source: String, start: Int): RangeCompilerToken {
    state end: Int(start + 1)
    if !rangeCompilerIsIdentifierStart(byte: stringByteAt(source: source, index: end)) {
        return RangeCompilerToken(kind: .invalid, start: start, end: end, text: String("@"))
    }
    end: end + 1
    while end < stringLength(value: source)
        && rangeCompilerIsIdentifierPart(byte: stringByteAt(source: source, index: end)) {
        end: end + 1
    }
    return RangeCompilerToken(
        kind: .macroAttribute,
        start: start,
        end: end,
        text: stringSubstring(source: source, start: start, end: end))
}

function rangeCompilerString(source: String, start: Int): RangeCompilerToken {
    state end: Int(start + 1)
    state escaped: Bool(false)
    while end < stringLength(value: source) {
        let byte: Int(stringByteAt(source: source, index: end))
        if escaped {
            escaped: false
        } else if byte == 92 {
            escaped: true
        } else if byte == 34 {
            end: end + 1
            return RangeCompilerToken(
                kind: .stringLiteral,
                start: start,
                end: end,
                text: stringSubstring(source: source, start: start, end: end))
        }
        end: end + 1
    }
    return RangeCompilerToken(
        kind: .invalid,
        start: start,
        end: end,
        text: stringSubstring(source: source, start: start, end: end))
}

function rangeCompilerComment(source: String, start: Int): RangeCompilerToken {
    state end: Int(start + 2)
    while end < stringLength(value: source)
        && stringByteAt(source: source, index: end) != 10 {
        end: end + 1
    }
    return RangeCompilerToken(kind: .comment, start: start, end: end, text: String(""))
}

function rangeCompilerSymbol(source: String, start: Int, byte: Int): RangeCompilerToken {
    state kind: RangeCompilerTokenKind(.punctuation)
    state end: Int(start + 1)
    if byte == 123 {
        kind: .leftBrace
    } else if byte == 125 {
        kind: .rightBrace
    } else if byte == 40 {
        kind: .leftParen
    } else if byte == 41 {
        kind: .rightParen
    } else if byte == 45 && stringByteAt(source: source, index: start + 1) == 62 {
        kind: .operator
        end: start + 2
    } else if rangeCompilerIsOperator(byte: byte) {
        kind: .operator
        if rangeCompilerIsOperatorPair(first: byte, second: stringByteAt(source: source, index: start + 1)) {
            end: start + 2
        }
    } else if !rangeCompilerIsPunctuation(byte: byte) {
        kind: .invalid
    }
    return RangeCompilerToken(
        kind: kind,
        start: start,
        end: end,
        text: stringSubstring(source: source, start: start, end: end))
}

function rangeCompilerIsIdentifierStart(byte: Int): Bool {
    return byte == 95 || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

function rangeCompilerIsIdentifierPart(byte: Int): Bool {
    return rangeCompilerIsIdentifierStart(byte: byte) || (byte >= 48 && byte <= 57)
}

function rangeCompilerIsDeclarationKeyword(text: String): Bool {
    return text == String("construct")
        || text == String("enum")
        || text == String("extension")
        || text == String("function")
        || text == String("macro")
}

function rangeCompilerIsControlKeyword(text: String): Bool {
    return text == String("if") || text == String("while") || text == String("switch")
}

function rangeCompilerIsOperator(byte: Int): Bool {
    return byte == 33 || byte == 37 || byte == 38 || byte == 42
        || byte == 43 || byte == 45 || byte == 46 || byte == 47
        || byte == 60 || byte == 61 || byte == 62 || byte == 63 || byte == 124
}

function rangeCompilerIsOperatorPair(first: Int, second: Int): Bool {
    return (first == 33 && second == 61)
        || (first == 38 && second == 38)
        || (first == 60 && second == 61)
        || (first == 61 && second == 61)
        || (first == 62 && second == 61)
        || (first == 63 && second == 63)
        || (first == 124 && second == 124)
}

function rangeCompilerIsPunctuation(byte: Int): Bool {
    return byte == 35 || byte == 36 || byte == 44 || byte == 58
        || byte == 59 || byte == 91 || byte == 93
}
