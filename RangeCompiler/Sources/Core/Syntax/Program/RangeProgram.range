@builtin
construct RangeProgram {
    let graph: RangeGraph
}

@builtin
construct RangeGraph {
    let files: [FileTreeNode]
    let sources: [ProgramSourceFile]
    let lexedSources: [ProgramLexedSource]
    let artifacts: [ProgramArtifact]
    let topology: RangeGraphTopology
    state main: Optional<@main>
    state syntax: [@syntax]
}

@builtin
construct ProgramSourceFile {
    let path: String
    let text: String
}

@builtin
construct ProgramLexedSource {
    let path: String
    let tokens: [LexicalToken]
}

@builtin
construct ProgramArtifact {
    let path: String
    let text: String
}

@builtin
construct RangeGraphTopology {
    let nodes: [RangeGraphNode]
    let relationships: [RangeGraphRelationship]
}

@builtin
construct RangeGraphNode {
    let identifier: Identifier
    let sourcePath: String
    let labels: [String]
}

@builtin
construct RangeGraphRelationship {
    let origin: Identifier
    let destination: Identifier
    let kind: String
}

construct RangeGraphDelta {
    let origin: Identifier
    let changes: [Change]
    let dependencies: [Dependency]
    let diagnostics: [Diagnostic]

    enum Change {
        case insert(value: @syntax, parent: Identifier?, ordinal: Int)
        case replace(target: Identifier, value: @syntax)
        case remove(target: Identifier)
        case relate(relationship: RangeGraphRelationship)
    }

    construct Dependency {
        let observer: Identifier
        let observed: Identifier
        let kind: String
    }

    construct Diagnostic {
        let severity: Severity
        let message: String
        let source: @syntax?
    }

    enum Severity {
        case error
        case warning
        case information
        case hint
    }
}

@builtin
construct GraphSyntax {
    let identifier: Identifier
    let declarations: [GraphEntry]
    let applications: [GraphEntry]
}

@builtin
enum GraphRole {
    case declaration
    case application
}

@builtin
construct GraphEntry {
    let identifier: Identifier
}
