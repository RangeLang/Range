@builtin
construct RangeProgram {
    let graph: RangeGraph
}

@builtin
construct RangeGraph {
    let files: Array<FileTreeNode>
    let sources: Array<ProgramSourceFile>
    let lexedSources: Array<ProgramLexedSource>
    let artifacts: Array<ProgramArtifact>
    let topology: RangeGraphTopology
    state main: Optional<@main>
    state syntax: Array<@syntax>
}

@builtin
construct ProgramSourceFile {
    let path: String
    let text: String
}

@builtin
construct ProgramLexedSource {
    let path: String
    let tokens: Array<LexicalToken>
}

@builtin
construct ProgramArtifact {
    let path: String
    let text: String
}

@builtin
construct RangeGraphTopology {
    let nodes: Array<RangeGraphNode>
    let relationships: Array<RangeGraphRelationship>
}

@builtin
construct RangeGraphNode {
    let identity: Identity
    let sourcePath: String
    let labels: Array<String>
}

@builtin
construct RangeGraphRelationship {
    let origin: Identity
    let role: Identity
    let destination: Identity
    let registration: RelationshipRegistration
}

construct RangeGraphDelta {
    let origin: Identity
    let changes: Array<Change>
    let dependencies: Array<Dependency>
    let diagnostics: Array<Diagnostic>

    enum Change {
        case insert(value: @syntax, parent: Identity?, ordinal: Int)
        case replace(target: Identity, value: @syntax)
        case remove(target: Identity)
        case relate(relationship: RangeGraphRelationship)
    }

    construct Dependency {
        let observer: Identity
        let observed: Identity
        let kind: String
    }

    construct Diagnostic {
        let severity: Severity
        let message: String
        let source: @syntax?
    }

    enum Severity {
        case error
        case warning
        case information
        case hint
    }
}
