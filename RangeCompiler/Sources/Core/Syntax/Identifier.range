macro identifierSyntaxName(): Init { environment in
    environment.target.application.replace(with:
        environment.target.declaration.expression(arguments: [
            String(environment.target.application.arguments[0].expression)
        ])
    )
}

@syntax
@identifierSyntaxName
construct Identifier {
    let name: String
    let id: String
    let parent: Identifier?
    let source: @syntax?
}
