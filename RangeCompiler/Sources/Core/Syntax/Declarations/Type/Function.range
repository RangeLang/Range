@graph(.declaration, .application)
construct Function {
    @syntax
    @member
    construct Declaration {
        let macros: Array<Macro.Application>
        let identifier: Identifier
        let generics: Array<Parameter.Declaration>
        let parameters: Array<Parameter.Declaration>
        let returnType: TypeReference?
        let body: Block
    }

    @syntax
    construct Application {
        let identifier: Identifier
        let arguments: Array<Parameter.Application>
    }
}
