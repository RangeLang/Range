@graph(.declaration)
construct Enum {
    @syntax
    @member
    construct Declaration {
        let macros: [Macro.Application]
        let identifier: Identifier
        let generics: [Generic]
        let cases: [Case<Payload>]
    }

    @syntax
    @member
    construct Case<Value = Nil> {
        let macros: [Macro.Application]
        let identifier: Identifier
        let value: Value?
    }

    @syntax
    construct Payload {
        let fields: [Field]

        @member
        construct Field {
            let macros: [Macro.Application]
            let identifier: Identifier?
            let label: String?
            let type: TypeReference
        }
    }
}
