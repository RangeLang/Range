@graph(.declaration)
construct Enum {
    @syntax {
        $macros
        enum $identifier<$generics> {
            $cases
        }
    }
    @member
    construct Declaration {
        let macros: [Macro.Application]
        let identifier: Identifier
        let generics: [Parameter.Declaration]
        let cases: [Case<Payload>]
    }

    @syntax {
        $macros
        case $identifier$value
    }
    @member
    construct Case<Value = Nil> {
        let macros: [Macro.Application]
        let identifier: Identifier
        let value: Value?
    }

    @syntax {
        ($fields)
    }
    construct Payload {
        let fields: [Field]

        @syntax {
            $label$identifier: $type
        }
        @member
        construct Field {
            let macros: [Macro.Application]
            let identifier: Identifier?
            let label: String?
            let type: TypeReference
        }
    }
}
