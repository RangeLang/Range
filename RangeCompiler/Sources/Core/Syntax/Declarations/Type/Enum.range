@graph(.declaration)
construct Enum {
    @syntax
    @member
    construct Declaration {
        let macros: [Macro.Application]
        let identifier: Identifier
        let generics: [Generic]
        let cases: [Case]
    }

    @syntax
    @member
    construct Case {
        let macros: [Macro.Application]
        let identifier: Identifier
        let associatedValues: [AssociatedValue]
    }

    @member
    construct AssociatedValue {
        let macros: [Macro.Application]
        let identifier: Identifier?
        let label: String?
        let type: TypeReference
    }
}
