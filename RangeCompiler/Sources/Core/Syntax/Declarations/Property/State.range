@stored
@syntax($macros state $identifier: $value)
@property
@field
@member
construct State<Value> {
    let macros: [Macro.Application]
    let identifier: Identifier
    let value: Value

    function initializer(transform: (Value) -> Value)
    function getter(transform: (Value) -> Value)
    function setter(transform: (Value) -> Value)
}
