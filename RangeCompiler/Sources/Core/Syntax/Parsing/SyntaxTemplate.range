construct SyntaxTemplate {
    let closure: () -> [@syntax]
    let captures: [Capture]

    construct Capture {
        let member: Identifier
        let type: TypeReference
        let cardinality: Cardinality
    }

    enum Cardinality {
        case one
        case optional
        case many
    }

    construct Binding {
        let capture: Capture
        let values: [@syntax]
    }

    construct Match {
        let template: SyntaxTemplate
        let source: @syntax
        let bindings: [Binding]
    }

    function match(source: @syntax): Parsed<Match>
    function render(match: Match): @syntax
}
