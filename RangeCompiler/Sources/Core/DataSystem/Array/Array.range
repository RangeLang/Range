@builtin
construct Array<Element> {
    state storage: Buffer<Element>

    derived count: Int {
        storage.count
    }

    function append(element: Element): Int {
        return storage.append(element: element)
    }

    function element(index: Int): Element {
        return storage.element(index: index)
    }

    function update(element: Element, index: Int): Int {
        return storage.update(element: element, index: index)
    }

    function filter<T>(all: T): Array<T>
    function filter(named identifier: Identifier): Array<Element>

    function destroy(): Int {
        return storage.destroy()
    }
}
