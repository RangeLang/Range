@builtin(.storage)
construct String {
    state characters: Buffer<Character>

    derived count: Int {
        characters.count
    }

    function append(text: String): Int {
        state index: Int(0)
        while index < text.characters.count {
            characters.append(element: text.characters.element(index: index))
            index: index + 1
        }
        return 0
    }

    function character(index: Int): Character {
        return characters.element(index: index)
    }

    function encoded(as encoding: TextEncoding): ByteSpan {
        return encode(characters: characters, as: encoding)
    }

    function destroy(): Int {
        return characters.destroy()
    }
}

function encode(characters: Buffer<Character>, as encoding: TextEncoding): ByteSpan
