@builtin(.storage)
construct String {
    state bytes: Buffer<Int<.unsigned, 8>>

    derived count: Int {
        stringLength(value: self)
    }

    function append(text: String): Int {
        return stringAppendStorage(destination: self, text: text)
    }

    function byte(index: Int): Int {
        return stringByteAt(source: self, index: index)
    }

    function destroy(): Int {
        return stringDestroy(value: self)
    }
}

@builtin(.write)
function stringAppendStorage(destination: String, text: String): Int

@builtin(.destroy)
function stringDestroy(value: String): Int
