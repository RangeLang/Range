enum GraphRole {
    case declaration
    case application
}

@shared
macro graph(
    _ role: GraphRole,
    _ additionalRole: GraphRole?
): Construct -> Void { environment in
    environment.graph.addNode(role: role, additionalRole: additionalRole)
}

enum Sharing {
    case shared
    case private
}

macro shared(): Macro { environment in
    #environment {
        return Sharing.shared
    }
}
