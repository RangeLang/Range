@syntax
construct Macro {
    construct Environment<Target> {
        let target: Target
        let parent: @syntax?
        let children: [@syntax]
        let ancestors: [@syntax]
        let siblings: [@syntax]
        let diagnostics: MacroDiagnostics
        let graph: RangeGraph
        let source: ProgramSourceFile

        function expand(_ expansion: () -> [@syntax]): RangeGraphDelta
        function omit(): RangeGraphDelta
    }

    construct Execution<Value> {
        let value: Value
        let delta: RangeGraphDelta
    }

    construct Target {
        let kind: String
        let name: String
        let type: TypeReference?
        let elements: [Target]
        let written: WrittenSyntax
    }

    @graph(.declaration)
    construct Declaration {
        let macros: [Macro.Application]
        let identifier: Identifier
        let packageVisibility: String
        let generics: [Generic]
        let parameters: [Parameter.Declaration]
        let target: String
        let targetSyntax: Target?
        let expansionType: TypeReference?
        let writtenBody: WrittenSyntax
        let parsedBody: Parsed<Block>
        let body: String
        let syntaxBody: String
    }

    @graph(.application)
    construct Application<Value = Nil> {
        let identifier: Identifier
        let target: Identifier
        let genericArguments: [TypeReference]
        let argumentClause: String
        let arguments: [Expression]
        let rawBody: WrittenSyntax
        let declaration: Declaration?
        let packageVisibility: String
        let valueType: TypeReference
        let value: Value
    }
}
