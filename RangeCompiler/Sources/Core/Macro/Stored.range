macro stored<Value>(): Construct { environment in
    let fields: [Let](
        environment.target.declaration.members.filter(all: Let)
    )
    let identifiers: [Let<Identifier>](
        fields
            .filter(all: Let<Identifier>)
            .filter(named: Identifier("identifier"))
    )
    let values: [Let<Value>](
        fields
            .filter(all: Let<Value>)
            .filter(named: Identifier("value"))
    )

    if identifiers.count != 1 {
        environment.diagnostics.error(
            "@stored requires exactly one `let identifier: Identifier` member"
        )
    }
    if values.count != 1 {
        environment.diagnostics.error(
            "@stored requires exactly one `let value: Value` member"
        )
    }
}
