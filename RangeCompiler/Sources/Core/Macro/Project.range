construct ProjectDefaults {}

macro project(): Construct -> ProjectDefaults { environment in
    let members: Array<State>(
        environment.target.Declaration.members.filter(all: State)
    )
    let integerCount: Int(
        members.filter { member in
            return member.identity.name == "integer"
        }.count
    )
    let boolCount: Int(
        members.filter { member in
            return member.identity.name == "bool"
        }.count
    )

    if integerCount == 0 && boolCount == 0 {
        #environment {
            extension #environment.target.Declaration.identity {
                state integer: Int
                state bool: Bool
            }
        }
    }
    if integerCount == 0 && boolCount != 0 {
        #environment {
            extension #environment.target.Declaration.identity {
                state integer: Int
            }
        }
    }
    if boolCount == 0 && integerCount != 0 {
        #environment {
            extension #environment.target.Declaration.identity {
                state bool: Bool
            }
        }
    }

    return ProjectDefaults()
}
