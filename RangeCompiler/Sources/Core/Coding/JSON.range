@encoding
construct JSON {
    state root: JSONValue
}

enum JSONValue {
    case null
    case boolean(value: Bool)
    case number(value: String)
    case string(value: String)
    case array(indirect elements: [JSONValue])
    case object(indirect members: [JSONMember])
}

construct JSONMember {
    let name: String
    let value: JSONValue
}
