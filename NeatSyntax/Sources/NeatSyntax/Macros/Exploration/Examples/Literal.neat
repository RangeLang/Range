// Exploratory literal macro example.
// This file is for design iteration only.

macro literal<T>: Attached<Init> { target, result, diagnostics in
    if target.arguments.count == 1,
       target.arguments[0].type == T.self {
        result.rewrite(
            target.expression(arguments: [
                target.arguments[0]
            ])
        )
    }
}
