// Exploratory autoclosure macro example.
// This file is for design iteration only.

macro autoclosure: Attached<Parameter> { target, result, diagnostics in
    if !target.arguments.isEmpty {
        result.argument.rewrite(
            Closure(
                body: Block(
                    statements: [
                        ExpressionStatement(
                            expression: target.arguments[0].value
                        )
                    ]
                )
            )
        )
    }
}

function assert(_ condition: () -> Bool) { }

assert({count > 0})

function assert(#autoclosure _ condition: Bool) { }

assert(count > 0)
