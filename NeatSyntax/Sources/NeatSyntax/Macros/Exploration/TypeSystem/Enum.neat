// Exploratory enum macro-facing compiler surface.
// This file is for design iteration only.

primitive construct Enum: AttachedMacroTarget {
    value name: String
    value cases: [EnumCase]
    value self: TypeReference
}

primitive construct EnumCase {
    value name: String
    value associatedValues: [AssociatedValue]
    value expression: Expression
}

primitive construct AssociatedValue {
    value label: String?
    value type: TypeReference
}

//MARK: Example
macro iterable: Attached<Enum> -> ValueDeclaration { enum in
    return ValueDeclaration(
        name: "allCases",
        type: Array<enum.self>,
        initializer: enum.cases.map { $0.expression }
    )
}
