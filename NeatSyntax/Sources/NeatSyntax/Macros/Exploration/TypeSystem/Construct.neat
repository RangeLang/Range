// Exploratory construct macro-facing compiler surface.
// This file is for design iteration only.

primitive construct Construct: AttachedMacroTarget {
    value name: String
    value self: TypeReference
    value storages: [StorageDeclaration]
    value inits: [Init]
    value functions: [Function]
}

//MARK: Example
macro codable: Attached<Construct> { construct, result, diagnostics in
    result.synthesize(
        ConformanceDeclaration(
            type: construct.self,
            protocol: Codable.self
        )
    )

    result.synthesize(
        Function(
            name: "encode",
            returnType: nil
        )
    )

    result.synthesize(Init)
}
