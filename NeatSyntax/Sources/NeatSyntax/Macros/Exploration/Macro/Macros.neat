// Exploratory macro basement surface.
// This file is for design iteration only.

primitive protocol FreestandingMacroTarget
primitive protocol AttachedMacroTarget

primitive protocol SupportsRewrite<T> {
    function rewrite(_: T)
}

primitive protocol SupportsMember<T> {
    function member(_: T)
}

primitive protocol SupportsExtension<T> {
    function extension(_: T)
}

primitive protocol Freestanding<T: FreestandingMacroTarget>
primitive protocol Attached<T: AttachedMacroTarget>

primitive protocol Freestanding<Block>: SupportsRewrite<Block>
primitive protocol Freestanding<Expression>: SupportsRewrite<Expression>

primitive protocol Attached<State>: SupportsRewrite<State>, SupportsMember<Declaration>
primitive protocol Attached<Derived>: SupportsRewrite<Derived>
primitive protocol Attached<Parameter>: SupportsRewrite<Expression>
primitive protocol Attached<Construct>: SupportsMember<Declaration>, SupportsExtension<Extension>
