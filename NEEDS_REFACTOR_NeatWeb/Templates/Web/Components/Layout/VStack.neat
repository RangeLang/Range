#VStack: Component {
  value alignment: HorizontalAlignment = .center
  value spacing: Double? = nil
  derived body: Renderable
}

extension VStack {
  value web: WebNode = WebNode.element(
    tag: "div",
    classes: ["stack", "axis-vertical"],
    styles: ["--stack-gap": "\(spacing ?? 0)"],
    attributes: [
      "data-align": "\(alignment)"
    ]
  )
}
