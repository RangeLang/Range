construct ZStack : Component {
  value alignment: Alignment = .center
  derived body: Renderable
}

extension ZStack {
  value web: WebNode = WebNode.element(
    tag: "div",
    classes: ["zstack"],
    attributes: [
      "data-align-horizontal": "\(alignment.horizontal)",
      "data-align-vertical": "\(alignment.vertical)"
    ]
  )
}
