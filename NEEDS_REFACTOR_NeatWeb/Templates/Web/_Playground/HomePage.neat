#HomePage: Page {

  derived head: Head {
    Meta.title("Home Page")
    Meta.description("Home Page Description")
  }

  state welcomeMessage: String

  init() {
    welcomeMessage = getMessage()
  }

  function getMessage() {
    Logger.log("Hello, World!")
  }

  derived body: Renderable {
    Text(welcomeMessage)
  }
}
