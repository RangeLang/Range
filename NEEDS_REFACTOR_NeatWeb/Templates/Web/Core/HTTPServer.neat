construct HTTPServer {
  function start(host _: String, port _: Int, router _: HTTPRouter) {
    value listener = TCPListener(host: host, port: port)
    listener.bind()
    listener.listen()

    Logger.info("NeatWeb listening on http://\(host):\(port)")

    while true {
      value connection = listener.accept()
      handle(connection: connection, router: router)
    }
  }

  function handle(connection _: TCPConnection, router _: HTTPRouter) {
    value requestData = connection.read()
    value request = HTTPRequestParser.parse(data: requestData)
    value response = router.handle(request: request)
    value responseData = HTTPResponseSerializer.serialize(response: response)

    connection.write(data: responseData)
    connection.close()
  }
}


construct TCPListener {
  value host _: String
  value port _: Int

  function bind()

  function listen()

  function accept() -> TCPConnection
}


construct TCPConnection {
  function read() -> Data

  function write(data _: Data)

  function close()
}


construct HTTPRequestParser {
  function parse(data _: Data) -> HTTPRequest
}


construct HTTPResponseSerializer {
  function serialize(response _: HTTPResponse) -> Data
}


construct Data {}
