construct Component : Renderable {
  *RenderableBuilder
  derived body: Renderable
}

*builder RenderableBuilder {
  *expression(renderable _: Renderable) -> [Renderable] {
    return [renderable]
  }

  *block(renderables _: [Renderable]...) -> [Renderable] {
    value result: [Renderable] = []

    for group in renderables {
      result.append(contentsOf: group)
    }

    return result
  }

  *optional(renderables _: [Renderable]?) -> [Renderable] {
    if renderables == none {
      return []
    }

    return renderables ?? []
  }

  *either(first _: [Renderable]) -> [Renderable] {
    return first
  }

  *either(second _: [Renderable]) -> [Renderable] {
    return second
  }

  *array(renderables _: [[Renderable]]) -> [Renderable] {
    value result: [Renderable] = []

    for group in renderables {
      result.append(contentsOf: group)
    }

    return result
  }
}
