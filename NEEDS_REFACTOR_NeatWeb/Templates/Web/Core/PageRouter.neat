construct PageRouter {
  function register(app _: App, router _: HTTPRouter) {
    register(route: app.routes, prefix: "", router: router)
  }

  function register(route _: Route, prefix _: String, router _: HTTPRouter) {
    value path = resolvedPath(prefix: prefix, routePath: route.path)

    if route.page != none {
      router.register(
        HTTPRoute(
          .get,
          path,
          PageResponder(page: route.page ?? Page())
        )
      )
    }

    for subroute in route.subroutes {
      register(route: subroute, prefix: path, router: router)
    }
  }

  function resolvedPath(prefix _: String, routePath _: String) -> String {
    if prefix == "" {
      return normalized(path: routePath)
    }

    if routePath == "/" {
      return normalized(path: prefix)
    }

    return normalized(path: "\(prefix)/\(routePath)")
  }

  function normalized(path _: String) -> String {
    if path == "" {
      return "/"
    }

    if path.hasPrefix("/") {
      return path
    }

    return "/\(path)"
  }
}


construct PageResponder : HTTPResponder {
  value page _: Page

  function respond(request _: HTTPRequest) -> HTTPResponse {
    value html = PageRenderer.render(page: page)

    return HTTPResponse(
      200,
      ["content-type": "text/html; charset=utf-8"],
      HTTPBody.text(html)
    )
  }
}


construct PageRenderer {
  function render(page _: Page) -> String
}
