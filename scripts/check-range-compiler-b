#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPILER_B_ROOT="$REPO_ROOT/Projects/RangeCompilerB"

fail() {
    echo "range compiler b check: $*" >&2
    exit 1
}

[[ -f "$COMPILER_B_ROOT/Project.range" ]] || fail "missing Compiler B project"
[[ -f "$COMPILER_B_ROOT/CompilerCoreSources.txt" ]] || fail "missing Compiler B Core inventory"
[[ ! -d "$COMPILER_B_ROOT/Sources/Compiler" ]] || fail "copied Compiler A source tree is still present"

while IFS= read -r relative; do
    [[ -n "$relative" ]] || continue
    [[ -f "$REPO_ROOT/$relative" ]] || fail "missing inventoried source: $relative"
done < "$COMPILER_B_ROOT/CompilerCoreSources.txt"

work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-b-check.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
output="$work_root/bootstrap.out"
directory_output="$work_root/directory.out"
fixture="$REPO_ROOT/Testing/CompilerB/Pass/SyntaxNodes.range"
token_syntax_fixture="$REPO_ROOT/Testing/CompilerB/Pass/TokenDrivenSyntax.range"
token_syntax_output="$work_root/token-syntax.out"
file_manager_fixture="$REPO_ROOT/Testing/CompilerB/Pass/FileManagerOperations.range"
direct_directory_fixture="$REPO_ROOT/Testing/CompilerB/Pass/DirectDirectoryLLVM.range"
token_identity_fixture="$REPO_ROOT/Testing/CompilerB/Pass/TokenIdentityAndBytes.range"
syntax_revision_fixture="$REPO_ROOT/Testing/CompilerB/Pass/SyntaxRevisionDifference.range"
syntax_revision_output="$work_root/syntax-revision.out"
member_macro_fixture="$REPO_ROOT/Testing/CompilerB/Pass/MemberMacroTarget.range"
member_macro_output="$work_root/member-macro.out"
member_macro_mismatch_fixture="$REPO_ROOT/Testing/CompilerB/Fail/MacroMemberTargetMismatch.range"
member_macro_mismatch_output="$work_root/member-macro-mismatch.out"
generic_declaration_fixture="$REPO_ROOT/Testing/CompilerB/Fail/GenericDeclaration.range"
generic_declaration_output="$work_root/generic-declaration.out"
generic_member_fixture="$REPO_ROOT/Testing/CompilerB/Fail/GenericMemberType.range"
generic_member_output="$work_root/generic-member.out"
generic_function_type_fixture="$REPO_ROOT/Testing/CompilerB/Fail/GenericFunctionType.range"
generic_function_type_output="$work_root/generic-function-type.out"
macro_relationship_fixture="$REPO_ROOT/Testing/CompilerB/Pass/MacroApplicationRelationships.range"
macro_relationship_output="$work_root/macro-relationship.out"
macro_argument_fixture="$REPO_ROOT/Testing/CompilerB/Pass/MacroArguments.range"
macro_argument_output="$work_root/macro-argument.out"
macro_argument_missing_fixture="$REPO_ROOT/Testing/CompilerB/Fail/MissingMacroArgument.range"
macro_argument_type_fixture="$REPO_ROOT/Testing/CompilerB/Fail/InvalidMacroArgumentType.range"
macro_argument_unknown_fixture="$REPO_ROOT/Testing/CompilerB/Fail/UnknownMacroArgument.range"
macro_argument_duplicate_fixture="$REPO_ROOT/Testing/CompilerB/Fail/DuplicateMacroArgument.range"
macro_argument_failure_output="$work_root/macro-argument-failure.out"
application_execution_fixture="$REPO_ROOT/Testing/CompilerB/Pass/ApplicationExecution.range"
application_execution_output="$work_root/application-execution.out"
backend_entry_fixture="$REPO_ROOT/Testing/CompilerB/Pass/EmitIntegerLLVM.range"
backend_product_fixture="$REPO_ROOT/Testing/CompilerB/Pass/IntegerReturnProduct.range"
backend_integer_collection_fixture="$REPO_ROOT/Testing/CompilerB/Pass/IntegerLLVMCollection.range"
collection_production_fixture="$REPO_ROOT/Testing/CompilerB/Pass/CollectionProduction.range"
uuid_many_fixture="$REPO_ROOT/Testing/CompilerB/Pass/UUIDMany.range"
uuid_many_output="$work_root/uuid-many.out"
collection_production_population_fixture="$REPO_ROOT/Testing/CompilerB/Pass/CollectionProductionPopulation.range"
collection_production_population_output="$work_root/collection-production-population.ll"
collection_production_population_graph_output="$work_root/collection-production-population.out"
collection_production_mismatch_fixture="$REPO_ROOT/Testing/CompilerB/Fail/CollectionProductionResultMismatch.range"
collection_production_mismatch_output="$work_root/collection-production-mismatch.out"
backend_byte_product_fixture="$REPO_ROOT/Testing/CompilerB/Pass/ByteReturnProduct.range"
backend_int_representation_fixture="$REPO_ROOT/Testing/CompilerB/Pass/IntRepresentation.range"
backend_product_identity_fixture="$REPO_ROOT/Testing/CompilerB/Pass/MacroProductIdentity.range"
backend_macro_argument_fixture="$REPO_ROOT/Testing/CompilerB/Pass/MacroArgumentLLVM.range"
backend_returned_product_fixture="$REPO_ROOT/Testing/CompilerB/Fail/ReturnedLLVMProduct.range"
backend_rejection_fixture="$REPO_ROOT/Testing/CompilerB/Fail/UnsupportedReturnProduct.range"
backend_byte_overflow_fixture="$REPO_ROOT/Testing/CompilerB/Fail/ByteLiteralOverflow.range"
backend_missing_representation_fixture="$REPO_ROOT/Testing/CompilerB/Fail/MissingIntegerRepresentation.range"
backend_invalid_representation_fixture="$REPO_ROOT/Testing/CompilerB/Fail/InvalidIntegerRepresentation.range"
backend_missing_metadata_fixture="$REPO_ROOT/Testing/CompilerB/Fail/MissingIntegerMetadata.range"
file_manager_output="$work_root/file-manager.txt"
backend_llvm="$work_root/compiler-b-product.ll"
backend_executable="$work_root/compiler-b-product"
backend_byte_llvm="$work_root/compiler-b-byte-product.ll"
backend_byte_executable="$work_root/compiler-b-byte-product"
backend_int_source="$work_root/compiler-b-int-source.range"
backend_byte_source="$work_root/compiler-b-byte-source.range"
backend_rejection_source="$work_root/compiler-b-rejection-source.range"
backend_byte_overflow_source="$work_root/compiler-b-byte-overflow-source.range"
backend_rejection_output="$work_root/compiler-b-rejection.out"
backend_byte_overflow_output="$work_root/compiler-b-byte-overflow.out"
backend_missing_representation_output="$work_root/compiler-b-missing-representation.out"
backend_invalid_representation_source="$work_root/compiler-b-invalid-representation-source.range"
backend_invalid_representation_output="$work_root/compiler-b-invalid-representation.out"
backend_missing_metadata_source="$work_root/compiler-b-missing-metadata-source.range"
backend_missing_metadata_output="$work_root/compiler-b-missing-metadata.out"
backend_product_identity_output="$work_root/compiler-b-product-identity.ll"
backend_macro_argument_output="$work_root/compiler-b-macro-argument.ll"
backend_macro_argument_executable="$work_root/compiler-b-macro-argument"
backend_returned_product_output="$work_root/compiler-b-returned-product.out"
integer_macro_output="$work_root/compiler-b-integer-macro.out"
many_macro_output="$work_root/compiler-b-many-macro.out"
collection_production_output="$work_root/compiler-b-collection-production.out"
bool_macro_output="$work_root/compiler-b-bool-macro.out"
file_api="$COMPILER_B_ROOT/Sources/CompilerB/Core/File/File.range"
syntax_model="$COMPILER_B_ROOT/Sources/CompilerB/Core/Syntax/Declaration.range"
syntax_query_api="$COMPILER_B_ROOT/Sources/CompilerB/Core/Syntax/Query.range"
syntax_parser="$COMPILER_B_ROOT/Sources/CompilerB/Core/Syntax/Parser.range"
representation_model="$COMPILER_B_ROOT/Sources/CompilerB/Core/Representation.range"
integer_macro="$COMPILER_B_ROOT/Sources/CompilerB/Core/Macros/Integer.range"
many_macro="$COMPILER_B_ROOT/Sources/CompilerB/Core/Macros/Many.range"
member_macro="$COMPILER_B_ROOT/Sources/CompilerB/Core/Macros/Member.range"
bool_macro="$COMPILER_B_ROOT/Sources/CompilerB/Core/Macros/Bool.range"
integer_bootstrap_macro="$COMPILER_B_ROOT/Sources/CompilerB/Bootstrap/Integer.range"
backend_model="$COMPILER_B_ROOT/Sources/CompilerB/Backend.range"
byte_model="$COMPILER_B_ROOT/Sources/CompilerB/Core/Byte.range"
string_model="$COMPILER_B_ROOT/Sources/CompilerB/Core/String.range"
uuid_model="$COMPILER_B_ROOT/Sources/Core/Coding/UUID.range"
host_runtime="$COMPILER_B_ROOT/Runtime/RangeCompilerHost.c"

grep -F 'construct FileManager {' "$file_api" >/dev/null || fail "missing Range-owned FileManager"
grep -F 'function filePrimitiveOpen(path: String, mode: Int): FileHandle' "$file_api" >/dev/null || fail "missing file-open primitive"
grep -F 'function opendir(path: NativeCString): DirectoryHandle' "$file_api" >/dev/null || fail "missing direct libc opendir declaration"
grep -F 'function readdir(directory: DirectoryHandle): DirectoryEntry' "$file_api" >/dev/null || fail "missing direct libc readdir declaration"
grep -F 'function directoryPrimitiveOpen(path: String): DirectoryHandle {' "$file_api" >/dev/null || fail "directory open is not Range-owned"
grep -F 'let tokens: TokenSpan' "$syntax_model" >/dev/null || fail "common syntax node does not retain a token span"
if grep -F 'SyntaxNodeKind' "$syntax_model" >/dev/null; then
    fail "common syntax node still owns a closed syntax-kind enum"
fi
grep -F 'function compilerBFunctionDeclarationQueryExecute(' "$syntax_query_api" >/dev/null || fail "missing individual Function.Declaration query pipeline"
grep -F 'function compilerBConstructDeclarationQueryExecute(' "$syntax_query_api" >/dev/null || fail "missing individual Construct.Declaration query pipeline"
grep -F 'function compilerBMacroDeclarationQueryExecute(' "$syntax_query_api" >/dev/null || fail "missing individual Macro.Declaration query pipeline"
grep -F 'function compilerBMemberQueryExecute(' "$syntax_query_api" >/dev/null || fail "missing typed Member query pipeline"
grep -F 'function compilerBResolveMacroApplications(' "$syntax_parser" >/dev/null || fail "missing compile-time macro application resolution"
grep -F 'let parameterIdentityTokenIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "macro signatures do not retain parameter identities"
grep -F 'let afterLastTargetTypeTokenIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "macro signatures do not retain complete target alternatives"
grep -F 'let argumentValueExpressionSyntaxIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "macro applications do not retain argument expressions"
grep -F 'function compilerBMacroParameterBindingStatus(' "$syntax_query_api" >/dev/null || fail "missing typed macro parameter binding"
grep -F 'function compilerBMacroRelationshipCount(' "$syntax_query_api" >/dev/null || fail "missing identity-indexed macro relationship query"
grep -F 'function compilerBTargetMatchesMacroFamily(' "$syntax_query_api" >/dev/null || fail "macro targets cannot resolve an abstract macro family"
grep -Fx 'macro member(): Let | State | Derived | Binding -> Void {}' "$member_macro" >/dev/null || fail "@member does not connect the four concrete property forms"
if rg -n 'expected: "Member"|construct Member \{\}|: Member([[:space:]]|$)' "$COMPILER_B_ROOT/Sources/CompilerB" "$REPO_ROOT/Testing/CompilerB" >/dev/null; then
    fail "Compiler B still treats Member as a nominal compiler-known target"
fi
grep -F 'function compilerBMacroCardinalityQueryExecute(' "$syntax_query_api" >/dev/null || fail "missing identity-indexed macro cardinality query"
if grep -F 'CompilerBMacroAttachmentIndex' "$syntax_model" "$syntax_parser" "$syntax_query_api" >/dev/null; then
    fail "macro relationships are duplicated into a separate attachment index"
fi
if rg -n 'CompilerB(Generic|TypeParameter|Specialization)' "$COMPILER_B_ROOT/Sources/CompilerB" >/dev/null; then
    fail "Compiler B still contains an explicit generic syntax or specialization model"
fi
grep -F 'function compilerBParseMacroApplicationChain(' "$syntax_parser" >/dev/null || fail "syntax parser does not own macro application discovery"
grep -F 'function compilerBParseMemberFacet(' "$syntax_parser" >/dev/null || fail "syntax parser does not retain Member facets"
grep -F 'function compilerBParseFunctionFacets(' "$syntax_parser" >/dev/null || fail "syntax parser does not own function signature and return discovery"
if rg -n 'environment in|compilerBExecuteSelfMacro|CompilerBEnvironmentAccess' "$COMPILER_B_ROOT/Sources/CompilerB" "$REPO_ROOT/Testing/CompilerB" >/dev/null; then
    fail "Compiler B still contains the retired explicit environment binder or inspect executor"
fi
grep -F 'macro collectionModifier(): Macro {}' "$bool_macro" >/dev/null || fail "missing collection-modifier marker declaration"
grep -F '@collectionModifier' "$bool_macro" >/dev/null || fail "filter is not marked as a collection modifier"
grep -F 'macro filter(named: String): @many -> @any {' "$bool_macro" >/dev/null || fail "filter does not declare its cardinality transform"
grep -F 'macro map(transform: Function): @many -> @many {' "$bool_macro" >/dev/null || fail "map does not declare its cardinality-preserving transform"
grep -F 'state input: #environment.target' "$bool_macro" >/dev/null || fail "modifier does not consume its predecessor Application"
if rg -n '#environment\.target\.root\(\)|functionModifier|callRoot' "$COMPILER_B_ROOT/Sources/CompilerB" "$REPO_ROOT/Testing/CompilerB" >/dev/null; then
    fail "Compiler B still contains the retired token-root or function-modifier path"
fi
grep -F 'revision.functionDeclarations.syntaxIDs.element(index: declarationRow)' "$backend_model" >/dev/null || fail "backend does not query canonical Function identities"
grep -F 'revision.functionSignatures.returnTypeTokenIDs.element(' "$backend_model" >/dev/null || fail "backend does not query canonical function signatures"
if grep -F 'revision.returns' "$representation_model" >/dev/null; then
    fail "macro execution still consumes function Return relationships"
fi
grep -F 'revision.returns.firstValueTokenIDs.element(index: returnRow)' "$backend_model" >/dev/null || fail "backend does not query canonical Return relationships"
grep -F 'let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevision(source: source))' "$backend_model" >/dev/null || fail "backend does not enter through one canonical syntax revision"
if grep -E 'CompilerB(FunctionIndex|IRFunctionStore|IndexedProgram|IntegerLiteralStore|IntegerRepresentationStore)' "$backend_model" "$representation_model" >/dev/null; then
    fail "backend still copies graph facts into a parallel program or IR store"
fi
if rg -n 'compilerB(ParseDecimalToken|ExecuteIntegerRepresentationApplications)' "$representation_model" "$backend_model" >/dev/null; then
    fail "integer lowering still reparses tokens or copies representation facts"
fi
if rg -n 'expected: "integer"|name == "integer"|name != "integer"' "$representation_model" "$backend_model" >/dev/null; then
    fail "Compiler B still dispatches macro execution by the integer macro name"
fi
if rg -n 'compilerB(IntegerRepresentation|ExecuteIntegerRepresentation|ParseDecimalToken)' "$representation_model" "$backend_model" >/dev/null; then
    fail "integer semantics still use the retired compiler-owned representation path"
fi
grep -F 'function compilerBParseProcessFacets(' "$syntax_parser" >/dev/null || fail "functions and macros do not share one process parser"
grep -F 'construct CompilerBLocalBindingFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain local bindings"
grep -F 'construct CompilerBNoValueFallbackFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain no-value fallbacks"
grep -F 'construct CompilerBConditionalFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain conditionals"
grep -F 'construct CompilerBEnvironmentEffectFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain environment effects"
grep -F 'construct CompilerBApplicationFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain canonical Applications"
grep -F 'let predecessorSyntaxIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "Applications do not retain predecessor identity"
grep -F 'let declarationSyntaxIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "Applications do not retain resolved declarations"
grep -F 'construct CompilerBApplicationProvisionFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain Application provisions"
grep -F 'let sourceSyntaxIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "Application provisions do not retain their plural source identity"
grep -F 'construct CompilerBEnvironmentFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain macro-owned environments"
grep -F 'construct CompilerBEnvironmentNodeFacetStore {' "$syntax_model" >/dev/null || fail "environments do not retain their Range nodes"
grep -F 'let environmentApplicationSyntaxIDs: Buffer<Int>' "$syntax_model" >/dev/null || fail "Macro Applications do not carry environments"
grep -F 'construct CompilerBCollectionProductionFacetStore {' "$syntax_model" >/dev/null || fail "process graph does not retain collection production relationships"
grep -F 'function compilerBResolveCollectionProductions(' "$syntax_parser" >/dev/null || fail "collection productions are not resolved by graph identity"
grep -F 'function compilerBCollectionProductionSyntaxIDForMacroApplication(' "$syntax_query_api" >/dev/null || fail "macro execution cannot recover its collection production identity"
grep -F 'function compilerBRunCollectionProductions(' "$representation_model" >/dev/null || fail "collection productions do not have an execution runner"
grep -F 'compilerBRunCollectionProductions(' "$backend_model" >/dev/null || fail "LLVM lowering does not run authored collection productions"
grep -F 'let collectionProductionSyntaxIDs: Buffer<Int>' "$representation_model" >/dev/null || fail "macro products do not retain their output collection production"
grep -F 'function compilerBExecuteMacroApplicationInto(' "$representation_model" >/dev/null || fail "missing shared macro process executor"
grep -F 'function compilerBMacroProductRowForApplicationSyntaxID(' "$representation_model" >/dev/null || fail "macro products are not keyed by canonical Application identity"
if grep -F 'let targetSyntaxIDs: Buffer<Int>' "$representation_model" >/dev/null ||
    grep -F 'let targetIdentityTokenIDs: Buffer<Int>' "$representation_model" >/dev/null; then
    fail "macro products still copy target relationships already owned by Applications"
fi
grep -F 'macro integer(): Construct {' "$integer_macro" >/dev/null || fail "missing Range-owned Core integer macro body"
grep -F 'macro many(' "$many_macro" >/dev/null || fail "missing Range-owned Core many macro body"
grep -F 'let element: #environment.target.Declaration.type' "$many_macro" >/dev/null || fail "many macro does not read its guaranteed element type directly from the environment"
if grep -F '@diagnostic' "$many_macro" >/dev/null || grep -F 'Many member must specify an element type' "$many_macro" >/dev/null; then
    fail "many macro still treats guaranteed declaration type knowledge as a diagnostic fallback"
fi
grep -F '#environment.diagnostic(' "$many_macro" >/dev/null || fail "many macro does not emit diagnostics through its environment"
if rg -n '@diagnostic|macro diagnostic' "$COMPILER_B_ROOT/Sources/CompilerB" "$REPO_ROOT/Testing/CompilerB" >/dev/null; then
    fail "Compiler B still contains the retired diagnostic Macro convention"
fi
grep -F 'let modifiers: #environment.macros.filter(all: @collectionModifier)' "$many_macro" >/dev/null || fail "many macro does not query collection modifier macros directly from its environment"
grep -F 'extension #environment.target.Application {' "$many_macro" >/dev/null || fail "many macro does not provision its target Application"
grep -F '#modifiers' "$many_macro" >/dev/null || fail "many macro does not directly splice the filtered identity collection"
if grep -F 'modifiers.map' "$many_macro" >/dev/null; then
    fail "many macro still manually traverses a plural graph identity"
fi
if grep -F 'asAttachedMember' "$many_macro" >/dev/null; then
    fail "many macro hides direct modifier composition behind an attachment helper"
fi
grep -F 'LLVM(' "$many_macro" >/dev/null || fail "many macro is missing its LLVM emissions"
grep -F 'type: "[' "$many_macro" >/dev/null || fail "many macro is missing its LLVM type initializer"
grep -F 'value: "[' "$many_macro" >/dev/null || fail "many macro is missing its LLVM value initializer"
if grep -F 'return LLVM(' "$many_macro" >/dev/null; then
    fail "many macro still hides multiple executions in one LLVM aggregate"
fi
grep -Fx 'macro integer(): Construct -> Void {}' "$integer_bootstrap_macro" >/dev/null || fail "missing accepted-A integer bootstrap signature"
if rg -n '^macro integer\(' "$representation_model" >/dev/null; then
    fail "integer macro declaration is still embedded in representation execution"
fi
if rg -n 'LLVM\.Integer|return LLVM\(' "$representation_model" "$integer_macro" "$many_macro" "$REPO_ROOT/Testing/CompilerB/Pass/MacroProductIdentity.range" >/dev/null; then
    fail "Compiler B still contains the returned-LLVM compatibility path"
fi
grep -F 'function compilerBMacroApplicationEnvironmentExpressionSyntaxID(' "$representation_model" >/dev/null || fail "macro execution does not query application-owned environments"
if rg -n 'LLVM\.(type|value)\(' "$COMPILER_B_ROOT/Sources/CompilerB" "$REPO_ROOT/Testing/CompilerB" >/dev/null; then
    fail "Compiler B still models LLVM type/value emission as qualified helper calls"
fi
if grep -F 'compilerBCaptureMacroApplications' "$representation_model" "$backend_model" >/dev/null; then
    fail "macro applications are still rediscovered outside the syntax parser"
fi
if grep -F 'compilerBIndexRetainedFunctionsPass' "$backend_model" >/dev/null; then
    fail "backend still owns the retired retained-token function scanner"
fi
if grep -E 'expected: "(function|construct|return)"' "$backend_model" >/dev/null; then
    fail "backend still classifies structural syntax keywords"
fi
grep -F '@integer' "$byte_model" >/dev/null || fail "Byte is missing its integer representation macro"
grep -F 'let bits: Int(8)' "$byte_model" >/dev/null || fail "Byte does not own its bit width"
grep -F 'let signed: Bool(false)' "$byte_model" >/dev/null || fail "Byte does not own its signedness"
grep -F 'state bytes: Buffer<Byte>' "$string_model" >/dev/null || fail "String storage is not modeled as Buffer<Byte>"
grep -F '@many(count: 16)' "$uuid_model" >/dev/null || fail "UUID does not declare sixteen Byte values through @many"
grep -F 'let bytes: Byte' "$uuid_model" >/dev/null || fail "UUID is not backed by immutable Byte values"
if grep -F 'let bytes: String' "$uuid_model" >/dev/null; then
    fail "UUID still uses transitional String storage"
fi
if grep -Eq '^(void \*|int32_t) (readFile|writeFile|listFiles|firstRangeFile)\(' "$host_runtime"; then
    fail "host runtime still owns a high-level file operation"
fi
if grep -Eq '^(void \*|int32_t) directoryPrimitive(Open|Advance|EntryName|EntryKind|Close)\(' "$host_runtime"; then
    fail "host runtime still owns directory execution"
fi

"$REPO_ROOT/scripts/run-compiler-b-bootstrap" --entry "$direct_directory_fixture" "$REPO_ROOT/Testing/CompilerB/Pass"
direct_missing_status=0
"$REPO_ROOT/scripts/run-compiler-b-bootstrap" --entry "$direct_directory_fixture" "$work_root/missing-directory" || direct_missing_status=$?
[[ "$direct_missing_status" -eq 66 ]] || fail "direct libc opendir did not preserve missing-directory failure"

"$REPO_ROOT/scripts/run-compiler-b-bootstrap" --entry "$token_identity_fixture" "$fixture"

"$REPO_ROOT/scripts/run-compiler-b-bootstrap" --entry "$syntax_revision_fixture" "$syntax_revision_fixture" > "$syntax_revision_output"
grep -F $'observation\tchange=removed\tidentity=40\tbefore=present\tbeforeName=Old\tbeforeBody=54\tafter=absent\ttype=Construct.Declaration' "$syntax_revision_output" >/dev/null || fail "removed observation did not pair a present previous half with an absent current half"
grep -F $'observation\tchange=changed\tidentity=39\tbefore=present\tbeforeName=alpha\tbeforeBody=22\tafter=present\tafterName=alpha\tafterBody=61\ttype=Function.Declaration' "$syntax_revision_output" >/dev/null || fail "changed observation did not resolve both revision halves of the declaration"
grep -F $'observation\tchange=added\tidentity=0\tbefore=absent\tafter=present\tafterName=beta\tafterBody=21\ttype=Function.Declaration' "$syntax_revision_output" >/dev/null || fail "added observation did not pair an absent previous half with a present current half"
if grep -F $'found=false' "$syntax_revision_output" >/dev/null; then
    fail "syntax observation still renders a standalone found=false row"
fi
grep -F $'syntaxDeltaCount=3\tadded=1\tremoved=1\tchanged=1\tvalid=true' "$syntax_revision_output" >/dev/null || fail "syntax revision diff summary is incorrect"

"$REPO_ROOT/scripts/run-compiler-b-bootstrap" "$member_macro_fixture" > "$member_macro_output"
grep -E $'^syntaxNode\tmarker=member\tid=[0-9]+\tparent=[0-9]+\tkind=state\tname=count\ttype=Int\tinitializerStart=[0-9]+\tinitializerEnd=[0-9]+\tstart=[0-9]+\tend=[0-9]+$' "$member_macro_output" >/dev/null || fail "owned state Member facet is incorrect"
grep -E $'^syntaxNode\tmarker=member\tid=[0-9]+\tparent=-1\tkind=let\tname=seed\ttype=Int\tinitializerStart=[0-9]+\tinitializerEnd=[0-9]+\tstart=[0-9]+\tend=[0-9]+$' "$member_macro_output" >/dev/null || fail "top-level let Member facet is incorrect"
grep -E $'^syntaxNode\tmarker=member\tid=[0-9]+\tparent=[0-9]+\tkind=binding\tname=selected\ttype=Int\t' "$member_macro_output" >/dev/null || fail "binding property did not materialize its concrete facet"
grep -E $'^syntaxNode\tmarker=member\tid=[0-9]+\tparent=[0-9]+\tkind=derived\tname=labels\ttype=String\t' "$member_macro_output" >/dev/null || fail "derived property did not materialize its concrete facet"
[[ "$(grep -c $'^macroRelationship\tapplication=[0-9].*\tdeclaration=[0-9].*\ttarget=[0-9]' "$member_macro_output")" -eq 5 ]] || fail "abstract member fixture did not expose its five property relationships"
grep -E $'^macroTargetIndex\tdeclaration=[0-9]+\ttargets=4$' "$member_macro_output" >/dev/null || fail "@print target index does not contain all four properties"
if grep -F $'macroExecution\t' "$member_macro_output" >/dev/null; then
    fail "marker @print unexpectedly executed a macro body"
fi

"$REPO_ROOT/scripts/run-compiler-b-bootstrap" "$member_macro_mismatch_fixture" > "$member_macro_mismatch_output"
grep -F $'syntax\tvalid=false\tdiagnostic=macro target does not satisfy declared type' "$member_macro_mismatch_output" >/dev/null || fail "non-Member @print target rejected at the wrong boundary"

"$REPO_ROOT/scripts/run-compiler-b-bootstrap" "$macro_relationship_fixture" > "$macro_relationship_output"
grep -E $'^syntaxNode\tmarker=macro\tid=[0-9]+\tparent=-1\tname=extern\ttarget=Function\tresult=\tstart=[0-9]+\tend=[0-9]+$' "$macro_relationship_output" >/dev/null || fail "empty extern marker macro signature is incorrect"
