#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPILER_B_ROOT="$REPO_ROOT/Projects/RangeCompilerB"

[[ -f "$COMPILER_B_ROOT/Project.range" ]] || {
    echo "range compiler b check: missing Compiler B project" >&2
    exit 1
}
[[ -f "$COMPILER_B_ROOT/CompilerCoreSources.txt" ]] || {
    echo "range compiler b check: missing Compiler B Core inventory" >&2
    exit 1
}

RANGE_COMPILER_PROJECT_ROOT="$COMPILER_B_ROOT" \
    exec "$SCRIPT_DIR/check-range-compiler-candidate" \
        --allow-runtime-roll \
        "$COMPILER_B_ROOT/Sources/Compiler"
