#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPILER="${1:-$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/current/RangeCompiler}"
WORK_ROOT="$(mktemp -d)"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

check_fixture() {
    local name="$1"
    local relative="$2"
    local expected="$3"
    local bundle="$WORK_ROOT/$name.range"
    local llvm="$WORK_ROOT/$name.ll"
    local executable="$WORK_ROOT/$name"
    local compile_error="$WORK_ROOT/$name.compile.err"

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$bundle"
    /usr/bin/printf 'compilerSourceFile\trole=project\tpath=%s\n' "$relative" >> "$bundle"
    /bin/cat "$REPO_ROOT/$relative" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"

    local compile_status=0
    "$COMPILER" "$bundle" > "$llvm" 2> "$compile_error" || compile_status=$?
    if [[ "$compile_status" -ne 0 ]]; then
        /bin/cat "$llvm"
        /bin/cat "$compile_error" >&2
        exit 1
    fi
    clang -O2 -flto=thin -Wno-override-module "$llvm" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
        -o "$executable"

    set +e
    "$executable"
    local run_status=$?
    set -e
    [[ "$run_status" -eq "$expected" ]] || { echo "$name exited $run_status, expected $expected" >&2; exit 1; }
    /usr/bin/grep -Eq 'call i32 @[^ (]*(doubled|quadrupled)' "$llvm" || { echo "$name did not lower derived access as a call" >&2; exit 1; }
}

check_fixture Derived Testing/Members/Pass/Derived.range 6
check_fixture DerivedChain Testing/Members/Pass/DerivedChain.range 16

echo "Derived properties and current-state dependency chains verified."
