#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPILER="${1:-}"
WORK_ROOT="$(mktemp -d)"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

BUNDLE="$WORK_ROOT/ArrayIntBufferLifecycle.range"
LLVM="$WORK_ROOT/ArrayIntBufferLifecycle.ll"
EXECUTABLE="$WORK_ROOT/ArrayIntBufferLifecycle"
COMPILE_ERROR="$WORK_ROOT/ArrayIntBufferLifecycle.compile.err"

append_source() {
    local role="$1"
    local marker="$2"
    local source="$3"
    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$marker" >> "$BUNDLE"
    /bin/cat "$source" >> "$BUNDLE"
    /usr/bin/printf '\n' >> "$BUNDLE"
}

/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$BUNDLE"
append_source core RangeCompiler/Sources/Core/System/Memory/RawBuffer.range "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
append_source core RangeCompiler/Sources/Core/System/Memory/Buffer.range "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range"
append_source core RangeCompiler/Sources/Core/DataSystem/Array/Array.range "$REPO_ROOT/RangeCompiler/Sources/Core/DataSystem/Array/Array.range"
append_source project Testing/Collections/Pass/ArrayIntBufferLifecycle.range "$REPO_ROOT/Testing/Collections/Pass/ArrayIntBufferLifecycle.range"

if [[ -n "$COMPILER" ]]; then
    compile_status=0
    "$COMPILER" "$BUNDLE" > "$LLVM" 2> "$COMPILE_ERROR" || compile_status=$?
else
    compile_status=0
    RANGE_CACHE_DISABLE=1 "$REPO_ROOT/scripts/range" compiler compile "$BUNDLE" > "$LLVM" 2> "$COMPILE_ERROR" || compile_status=$?
fi
if [[ "$compile_status" -ne 0 ]]; then
    /bin/cat "$LLVM"
    /bin/cat "$COMPILE_ERROR" >&2
    exit 1
fi

clang -O2 -flto=thin -Wno-override-module "$LLVM" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
    -o "$EXECUTABLE"

set +e
"$EXECUTABLE"
run_status=$?
set -e

[[ "$run_status" -eq 9 ]] || { echo "Array<Int> over Buffer exited $run_status, expected 9" >&2; exit 1; }
/usr/bin/grep -Fq '%Range.Array = type { ptr }' "$LLVM" || { echo "Array<Int> does not lower its Buffer<Int> storage to one pointer" >&2; exit 1; }
if /usr/bin/grep -Fq '%Range.Buffer = type' "$LLVM"; then
    echo "Array<Int> emitted a redundant nested Buffer wrapper" >&2
    exit 1
fi
/usr/bin/grep -Fq 'rawBufferDestroy' "$LLVM" || { echo "Array<Int> omitted nested destruction" >&2; exit 1; }

echo "Canonical Array<Int> over flattened Buffer<Int> lifecycle verified."
