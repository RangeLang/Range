#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/range-unsigned8.XXXXXX")"
CANDIDATE_COMPILER="${1:-}"

if [[ $# -gt 1 ]]; then
    echo "Usage: scripts/check-range-unsigned8 [candidate-compiler]" >&2
    exit 64
fi

cleanup() {
    /bin/rm -rf "$BUILD_ROOT"
}
trap cleanup EXIT

clang -std=c11 -Wall -Wextra -Werror \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/Testing/Runtime/Pass/RangeRawBufferUnsigned8Tests.c" \
    -o "$BUILD_ROOT/RangeRawBufferUnsigned8Tests"
"$BUILD_ROOT/RangeRawBufferUnsigned8Tests"

if [[ -z "$CANDIDATE_COMPILER" ]]; then
    echo "Unsigned 8-bit runtime checks passed; pass a candidate compiler to prove Range lowering."
    exit 0
fi
if [[ ! -x "$CANDIDATE_COMPILER" ]]; then
    echo "Candidate compiler is not executable: $CANDIDATE_COMPILER" >&2
    exit 66
fi

RUNTIME_SOURCES=(
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c"
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c"
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c"
)
SOURCE_SET="$BUILD_ROOT/IntegerUnsigned8SourceSet.range"
LLVM="$BUILD_ROOT/IntegerUnsigned8.ll"

/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$SOURCE_SET"
/usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=project\tpath=Project/IntegerUnsigned8.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/Testing/Types/Pass/IntegerUnsigned8.range" >> "$SOURCE_SET"
/usr/bin/printf '\n' >> "$SOURCE_SET"

"$CANDIDATE_COMPILER" emit-llvm "$SOURCE_SET" "$LLVM"
/usr/bin/grep -q 'declare i32 @rawBufferAppendUnsigned8(ptr, i8)' "$LLVM"
/usr/bin/grep -q 'declare i8 @rawBufferLoadUnsigned8(ptr, i32)' "$LLVM"
if /usr/bin/grep -q '%Range.Int' "$LLVM"; then
    echo "Unsigned integer lowering emitted a nominal Int aggregate." >&2
    exit 65
fi

clang -Wno-override-module -x ir "$LLVM" -x c "${RUNTIME_SOURCES[@]}" -o "$BUILD_ROOT/IntegerUnsigned8"
set +e
"$BUILD_ROOT/IntegerUnsigned8"
range_exit=$?
set -e
if [[ "$range_exit" -ne 1 ]]; then
    echo "Range Int<8, .unsigned> round trip failed: expected 1, got $range_exit" >&2
    exit 1
fi

echo "Range Int<8, .unsigned> lowering checks passed."
