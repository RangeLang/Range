#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
adapter_root="$repo_root/Projects/RangeView/Native/GPUI"
view_source="$repo_root/Projects/RangeView/Macros/View.range"
renderer_source="$adapter_root/GPUI.range"
fixture="$repo_root/Testing/CompilerB/Pass/RangeViewGPUI.range"
fail_fixture="$repo_root/Testing/CompilerB/Fail/RangeViewRequiresViewConstruct.range"
shape_fail_fixture="$repo_root/Testing/CompilerB/Fail/RangeViewShapeRequiresOrderedPoints.range"
material_fail_fixture="$repo_root/Testing/CompilerB/Fail/RangeViewMaterialRequiresEmission.range"
entry="$repo_root/Testing/CompilerB/Pass/EmitRangeViewGPUI.range"
artifact_root="$(mktemp -d "${TMPDIR:-/tmp}/range-b-gpui-proof.XXXXXX")"
fail_root="$(mktemp -d "${TMPDIR:-/tmp}/range-b-gpui-fail.XXXXXX")"
shape_fail_root="$(mktemp -d "${TMPDIR:-/tmp}/range-b-gpui-shape-fail.XXXXXX")"
material_fail_root="$(mktemp -d "${TMPDIR:-/tmp}/range-b-gpui-material-fail.XXXXXX")"
trap 'rm -rf "$artifact_root" "$fail_root" "$shape_fail_root" "$material_fail_root"' EXIT

cargo build --release --manifest-path "$adapter_root/Cargo.toml"
cp "$fixture" "$artifact_root/RangeView.range"
cp "$view_source" "$artifact_root/RangeViewView.range"
cp "$renderer_source" "$artifact_root/RangeViewGPUI.range"
cp "$adapter_root/target/release/librange_view_gpui.a" \
    "$artifact_root/librange_view_gpui.a"

RANGE_GPUI_LINK_PROBE=1 \
    "$repo_root/scripts/run-compiler-b-bootstrap" \
    --entry "$entry" \
    "$artifact_root"

grep -F '; range-b backend=rangeview-gpui roots=1 root=RangeViewHello views=2' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F '%RangeViewPoint = type { i32, i32 }' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F '%RangeViewValue = type { i32, ptr, i64, i32, i32, i32, i32, i32, i32, ptr, i64 }' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F '@.rangeViewPoints0 = private constant [4 x %RangeViewPoint] [%RangeViewPoint { i32 120, i32 90 }, %RangeViewPoint { i32 680, i32 90 }, %RangeViewPoint { i32 680, i32 430 }, %RangeViewPoint { i32 120, i32 430 }], align 4' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F '%RangeViewValue { i32 1, ptr getelementptr inbounds ([4 x %RangeViewPoint], ptr @.rangeViewPoints0, i64 0, i64 0), i64 4, i32 4, i32 3, i32 2584305, i32 3003583, i32 135, i32 100, ptr null, i64 0 }' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F '@.rangeViewText1 = private unnamed_addr constant [28 x i8] c"Range draws ordered points.\00"' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F '%RangeViewValue { i32 2, ptr null, i64 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, ptr getelementptr inbounds ([28 x i8], ptr @.rangeViewText1, i64 0, i64 0), i64 27 }' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F 'declare i32 @rangeGPUIRun(ptr, i64, ptr, i64)' \
    "$artifact_root/RangeView.ll" >/dev/null
grep -F 'call i32 @rangeGPUIRun(ptr %title, i64 14, ptr %views, i64 2)' \
    "$artifact_root/RangeView.ll" >/dev/null
test -x "$artifact_root/RangeView"
nm -gU "$artifact_root/RangeView" | grep -F '_rangeGPUIRun' >/dev/null

cp "$fail_fixture" "$fail_root/RangeView.range"
cp "$view_source" "$fail_root/RangeViewView.range"
cp "$renderer_source" "$fail_root/RangeViewGPUI.range"
set +e
fail_output="$(
    RANGE_GPUI_LINK_PROBE=1 \
        "$repo_root/scripts/run-compiler-b-bootstrap" \
        --entry "$entry" \
        "$fail_root" 2>&1
)"
fail_status=$?
set -e
test "$fail_status" -eq 65
grep -F 'RangeView body value must resolve to an @view construct' \
    <<<"$fail_output" >/dev/null

cp "$shape_fail_fixture" "$shape_fail_root/RangeView.range"
cp "$view_source" "$shape_fail_root/RangeViewView.range"
cp "$renderer_source" "$shape_fail_root/RangeViewGPUI.range"
set +e
shape_fail_output="$(
    RANGE_GPUI_LINK_PROBE=1 \
        "$repo_root/scripts/run-compiler-b-bootstrap" \
        --entry "$entry" \
        "$shape_fail_root" 2>&1
)"
shape_fail_status=$?
set -e
test "$shape_fail_status" -eq 65
grep -F 'RangeView @shape point count must match @many count' \
    <<<"$shape_fail_output" >/dev/null

cp "$material_fail_fixture" "$material_fail_root/RangeView.range"
cp "$view_source" "$material_fail_root/RangeViewView.range"
cp "$renderer_source" "$material_fail_root/RangeViewGPUI.range"
set +e
material_fail_output="$(
    RANGE_GPUI_LINK_PROBE=1 \
        "$repo_root/scripts/run-compiler-b-bootstrap" \
        --entry "$entry" \
        "$material_fail_root" 2>&1
)"
material_fail_status=$?
set -e
test "$material_fail_status" -eq 65
grep -F 'RangeView @material requires one @shader emission output' \
    <<<"$material_fail_output" >/dev/null

printf '%s\n' 'Compiler B RangeView GPUI artifact proof passed.'
