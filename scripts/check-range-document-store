#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

fail() {
    echo "range document store proof: $*" >&2
    exit 1
}

WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-document-store.XXXXXX")"
cleanup() {
    case "$WORK_ROOT" in
        "${TMPDIR:-/tmp}"/range-document-store.*)
            /bin/rm -R "$WORK_ROOT"
            ;;
        *)
            fail "refusing to remove unexpected temporary path: $WORK_ROOT"
            ;;
    esac
}
trap cleanup EXIT

PROJECT_ROOT="$WORK_ROOT/project"
/bin/mkdir -p "$PROJECT_ROOT"
/bin/cp \
    "$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeStore/RangeStore.range" \
    "$PROJECT_ROOT/RangeStore.range"
/bin/cp \
    "$REPO_ROOT/Testing/Storage/Pass/DocumentStoreRoundTrip.range" \
    "$PROJECT_ROOT/DocumentStoreRoundTrip.range"

LLVM_PATH="$WORK_ROOT/document-store.ll"
EXECUTABLE_PATH="$WORK_ROOT/document-store"
STORE_PATH="$WORK_ROOT/documents.range-store"

"$REPO_ROOT/scripts/range" compile "$PROJECT_ROOT" > "$LLVM_PATH"
if /usr/bin/head -n 1 "$LLVM_PATH" | /usr/bin/grep -Fq 'compilerError'; then
    /bin/cat "$LLVM_PATH" >&2
    fail "Range compilation failed"
fi

/usr/bin/clang \
    "$LLVM_PATH" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
    -o "$EXECUTABLE_PATH"

set +e
"$EXECUTABLE_PATH" "$STORE_PATH"
run_status=$?
set -e
[[ "$run_status" -eq 0 ]] \
    || fail "round-trip fixture exited with status $run_status"

[[ -f "$STORE_PATH" ]] || fail "metadata log was not persisted"
[[ -f "$STORE_PATH.document.7.5" ]] || fail "restored revision body was not persisted"
[[ "$(/bin/cat "$STORE_PATH.document.7.5")" == "restored" ]] \
    || fail "restored revision body did not round-trip"

echo "range document store proof: pass"
