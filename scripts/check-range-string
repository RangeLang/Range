#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CANDIDATE_COMPILER="${1:-$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/stage2/RangeCompiler}"
BUILD_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/range-string.XXXXXX")"

cleanup() {
    if [[ "${RANGE_KEEP_STRING_BUILD_ROOT:-0}" == "1" ]]; then
        echo "String build root: $BUILD_ROOT"
    else
        /bin/rm -rf "$BUILD_ROOT"
    fi
}
trap cleanup EXIT

if [[ ! -x "$CANDIDATE_COMPILER" ]]; then
    echo "Candidate compiler is not executable: $CANDIDATE_COMPILER" >&2
    exit 66
fi

SOURCE_SET="$BUILD_ROOT/StringSourceSet.range"
LLVM="$BUILD_ROOT/StringByteStorage.ll"

/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$SOURCE_SET"
/usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/Buffer.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/String.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/String.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=project\tpath=Project/StringByteStorage.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/Testing/Strings/Pass/StringByteStorage.range" >> "$SOURCE_SET"
/usr/bin/printf '\n' >> "$SOURCE_SET"

"$CANDIDATE_COMPILER" emit-llvm "$SOURCE_SET" "$LLVM"
/usr/bin/grep -q 'call i32 @stringByteAt(ptr' "$LLVM"

clang -Wno-override-module -x ir "$LLVM" -x c \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
    -o "$BUILD_ROOT/StringByteStorage"

set +e
"$BUILD_ROOT/StringByteStorage"
range_exit=$?
set -e
if [[ "$range_exit" -ne 82 ]]; then
    echo "Authored String byte access failed: expected 82, got $range_exit" >&2
    exit 1
fi

echo "Authored String pointer-ABI byte access verified."
