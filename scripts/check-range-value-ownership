check_stored_member_defaults() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/StoredMemberDefaults.range"
    local syntax_fixture="$REPO_ROOT/Testing/Members/Pass/StoredMemberDefaults.range"
    local output="$WORK_ROOT/macro-stored-member-defaults.out"
    local error="$WORK_ROOT/macro-stored-member-defaults.err"
    local syntax_output="$WORK_ROOT/member-stored-member-defaults.out"
    local syntax_error="$WORK_ROOT/member-stored-member-defaults.err"

    "$STAGE2_EXECUTABLE" compile "$syntax_fixture" > "$syntax_output" 2> "$syntax_error" \
        || fail "stored-member default syntax did not compile"
    [[ ! -s "$syntax_error" ]] || fail "stored-member default syntax wrote stderr"
    /usr/bin/grep -Fq $'name=count\tnameStart=' "$syntax_output" \
        && /usr/bin/grep -Fq $'type=Int\ttypeStart=' "$syntax_output" \
        && /usr/bin/grep -Fq $'value=Int(3)\tvalueStart=' "$syntax_output" \
        || fail "stored let initializer was not retained as canonical written syntax"
    /usr/bin/grep -Fq $'name=enabled\tnameStart=' "$syntax_output" \
        && /usr/bin/grep -Fq $'type=Bool\ttypeStart=' "$syntax_output" \
        && /usr/bin/grep -Fq $'value=Bool(true)\tvalueStart=' "$syntax_output" \
        || fail "stored state initializer was not retained as canonical written syntax"
    /usr/bin/grep -Fq $'name=name\tnameStart=' "$syntax_output" \
        && /usr/bin/grep -Fq $'type=String\ttypeStart=' "$syntax_output" \
        && /usr/bin/grep -Fq $'value=\tvalueStart=-1\tvalueEnd=-1' "$syntax_output" \
        || fail "stored let without an initializer did not retain an absent default"
    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "stored-member defaults did not compile"
    [[ ! -s "$error" ]] || fail "stored-member defaults wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=3\tcapabilityHandleCount=3' "$output" \
        || fail "stored-member default macros did not execute"
    [[ "$(/usr/bin/grep -F -c $'kind=4\t' "$output" || true)" -ge 3 ]] \
        && /usr/bin/grep -Fq $'scalar=1\tchildCount=1\tparentRow=-1' "$output" \
        && /usr/bin/grep -Fq $'scalar=0\tchildCount=0\tparentRow=-1' "$output" \
        || fail "stored-member defaults did not persist Expression optionality"
    [[ "$(/usr/bin/grep -F -c $'kind=5\ttypeKind=6\tnominalSyntaxID=-1' "$output" || true)" -eq 2 ]] \
        || fail "stored let and state initializers did not both materialize as syntax"
    /usr/bin/grep -Fq $'kind=5\ttypeKind=6\tnominalSyntaxID=-1' "$output" \
        && /usr/bin/grep -Fq $'childCount=3\tparentRow=' "$output" \
        || fail "stored initializer did not persist its exact source-backed syntax range"
    echo "Macros stored-member-defaults: pass"
}

check_coding_core_surface() {
    local fixture="$REPO_ROOT/Testing/Coding/Pass/CoreSurface.range"
    local output="$WORK_ROOT/coding-core-surface.out"
    local error="$WORK_ROOT/coding-core-surface.err"
    local source_file

    for source_file in \
        RangeCompiler/Sources/Core/Macro/Error.range \
        RangeCompiler/Sources/Core/System/Result/Error.range \
        RangeCompiler/Sources/Core/System/Result/Result.range \
        RangeCompiler/Sources/Core/Coding/Encoding.range \
        RangeCompiler/Sources/Core/Coding/CodingError.range \
        RangeCompiler/Sources/Core/Coding/Encoder.range \
        RangeCompiler/Sources/Core/Coding/Decoder.range \
        RangeCompiler/Sources/Core/Coding/JSON.range; do
        [[ -f "$REPO_ROOT/$source_file" ]] || fail "missing Range-authored coding source: $source_file"
    done

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Range-authored coding core surface did not compile"
    [[ ! -s "$error" ]] || fail "Range-authored coding core surface wrote stderr"
    /usr/bin/grep -Fq $'typedSyntax\tvalid=true' "$output" \
        || fail "Range-authored coding core surface did not produce valid typed syntax"
    for source_file in Error Result EncodingError DecodingError Encoder KeyedEncodingContainer Decoder KeyedDecodingContainer JSON JSONValue JSONMember; do
        /usr/bin/grep -Fq $'name='"$source_file"$'\tnameStart=' "$output" \
            || fail "Range-authored coding core surface omitted $source_file"
    done
    /usr/bin/grep -Fq $'name=encode\tnameStart=' "$output" \
        && /usr/bin/grep -Fq $'name=decode\tnameStart=' "$output" \
        || fail "Range-authored keyed containers omitted encode or decode"
    [[ "$(/usr/bin/grep -F -c $'storage=indirect\t' "$output" || true)" -eq 2 ]] \
        || fail "Range-authored JSON did not preserve two recursive indirect collections"
    /usr/bin/grep -Fq 'function encode<Format>(to encoder: Encoder<Format>)' "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Codable.range" \
        && /usr/bin/grep -Fq 'container.encode(#property.identifier' "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Codable.range" \
        && /usr/bin/grep -Fq 'function decode<Format>(from decoder: Decoder<Format>)' "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Codable.range" \
        && /usr/bin/grep -Fq 'default: #property.value' "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Codable.range" \
        || fail "Range-authored Codable is not wired to the generic coding surface"
    echo "Coding Range-authored-core-surface: pass"
}

check_codable_construct_collection() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/CodableConstructCollection.range"
    local output="$WORK_ROOT/macro-codable-construct-collection.out"
    local error="$WORK_ROOT/macro-codable-construct-collection.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "construct-attached Codable collection did not compile"
    [[ ! -s "$error" ]] || fail "construct-attached Codable collection wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=3\tcapabilityHandleCount=3' "$output" \
        || fail "construct-attached Codable did not execute its parent and two retained children"
    /usr/bin/grep -Fq $'childApplicationCount=2\texpansionBindingCount=6\t' "$output" \
        || fail "construct-attached Codable did not persist two recursive #properties bindings"
    local expansion_artifact_count
    expansion_artifact_count="$(/usr/bin/grep -F -c 'macroExpansionArtifact' "$output" || true)"
    [[ "$expansion_artifact_count" -eq 2 ]] \
        || fail "construct-attached Codable produced $expansion_artifact_count syntax artifacts, expected two"
    /usr/bin/grep -Eq $'macroGraphGeneratedFunction\trow=0\tkind=function\townerSyntaxID=[0-9]+\tplacement=1.*\tname=encode\treturnType=Int' "$output" \
        || fail "construct-attached Codable did not generate encode"
    /usr/bin/grep -Eq $'macroGraphGeneratedFunction\trow=1\tkind=function\townerSyntaxID=[0-9]+\tplacement=1.*\tname=decode\treturnType=Int' "$output" \
        || fail "construct-attached Codable did not generate decode"
    local generated_function_count
    generated_function_count="$(/usr/bin/grep -F -c 'macroGraphGeneratedFunction' "$output" || true)"
    [[ "$generated_function_count" -eq 2 ]] \
        || fail "construct-attached Codable generated $generated_function_count functions, expected exactly encode and decode"
    /usr/bin/grep -Fq $'expansionFragmentCount=8\t' "$output" \
        || fail "construct-attached Codable did not retain the exact composite body fragment count"
    local authored_fragment_count child_fragment_count boundary_fragment_count
    authored_fragment_count="$(/usr/bin/grep -F -c $'kind=authored\t' "$output" || true)"
    child_fragment_count="$(/usr/bin/grep -F -c $'kind=childMacro\t' "$output" || true)"
    boundary_fragment_count="$(/usr/bin/grep -F -c $'kind=boundary\t' "$output" || true)"
    [[ "$authored_fragment_count" -eq 4 && "$child_fragment_count" -eq 2 && "$boundary_fragment_count" -eq 2 ]] \
        || fail "construct-attached Codable changed authored/child/boundary fragment partitioning"
    /usr/bin/grep -Eq $'kind=childMacro\tfileID=[0-9]+\tstart=[0-9]+\tend=[0-9]+\tname=codableEncodeBody$' "$output" \
        && /usr/bin/grep -Eq $'kind=childMacro\tfileID=[0-9]+\tstart=[0-9]+\tend=[0-9]+\tname=codableDecodeBody$' "$output" \
        || fail "construct-attached Codable did not retain both child macro fragments"
    /usr/bin/grep -Fq $'parentFragmentRow=1\tordinal=0\tkind=boundary' "$output" \
        && /usr/bin/grep -Fq $'parentFragmentRow=5\tordinal=0\tkind=boundary' "$output" \
        && [[ "$(/usr/bin/grep -F -c $'kind=boundary\t' "$output" || true)" -eq 2 ]] \
        || fail "construct-attached Codable did not retain #properties under each child fragment"
    [[ "$(/usr/bin/grep -F -c 'macroChildApplication' "$output" || true)" -eq 2 ]] \
        || fail "construct-attached Codable did not register exactly two child applications"
    [[ "$(/usr/bin/grep -F -c $'macroResult\t' "$output" || true)" -eq 2 ]] \
        && [[ "$(/usr/bin/grep -F -c $'scalar=2\tchildCount=0\tparentRow=-1' "$output" || true)" -eq 2 ]] \
        || fail "construct-attached Codable child macros did not receive both persisted Let values"
    echo "Macros Codable-construct-collection: pass"
}

check_inline_core_codable() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/InlineCodable.range"
    local bundle="$WORK_ROOT/macro-inline-core-codable.range"
    local output="$WORK_ROOT/macro-inline-core-codable.out"
    local error="$WORK_ROOT/macro-inline-core-codable.err"

    /bin/cp "$fixture" "$bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Codable.range' >> "$bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Codable.range" >> "$bundle"
    "$STAGE2_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
        || fail "actual inline Core Codable did not compile"
    [[ ! -s "$error" ]] || fail "actual inline Core Codable wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=1' "$output" \
        || fail "actual inline Core Codable did not execute as one macro program"
    [[ "$(/usr/bin/grep -F -c 'macroGraphGeneratedFunction' "$output" || true)" -eq 2 ]] \
        || fail "actual inline Core Codable did not generate exactly encode and decode"
    /usr/bin/grep -Fq $'\tname=encode\t' "$output" \
        && /usr/bin/grep -Fq $'\tname=decode\t' "$output" \
        || fail "actual inline Core Codable omitted encode or decode"
    [[ "$(/usr/bin/grep -F -c 'macroChildApplication' "$output" || true)" -eq 0 ]] \
        || fail "actual inline Core Codable unexpectedly required nested helper macros"
    echo "Macros actual-inline-Core-Codable: pass"
}

check_codable_composite_atomic_rollback() {
    local fixture="$REPO_ROOT/Testing/Macros/Fail/CodableCompositeAtomicRollback.range"
    local output="$WORK_ROOT/macro-codable-composite-atomic-rollback.out"
    local error="$WORK_ROOT/macro-codable-composite-atomic-rollback.err"

    if "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        fail "malformed second Codable body unexpectedly compiled"
    fi
    [[ ! -s "$error" ]] || fail "Codable atomic rollback wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=macroLinking\tcount=1\tdiagnosticKind=macroGraphDeltaInvalid' "$output" \
        || fail "Codable composite failure did not reject at the staged graph-delta boundary"
    if /usr/bin/grep -Fq 'macroGraphGeneratedFunction' "$output" \
        || /usr/bin/grep -Fq 'define ' "$output" \
        || /usr/bin/grep -Fq 'call ' "$output"; then
        fail "Codable composite failure exposed a partially committed declaration or LLVM"
    fi
    echo "Macros Codable-composite-atomic-rejection: pass"
}

check_typed_parameter_defaults() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/TypedParameterDefaults.range"
    local legacy_fixture="$REPO_ROOT/Testing/Macros/Fail/ExplicitOptionalNilDefault.range"
    local output="$WORK_ROOT/macro-typed-parameter-defaults.out"
    local error="$WORK_ROOT/macro-typed-parameter-defaults.err"
    local legacy_output="$WORK_ROOT/macro-explicit-optional-nil-default.out"
    local legacy_error="$WORK_ROOT/macro-explicit-optional-nil-default.err"
    local legacy_status

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "typed macro parameter defaults did not compile"
    [[ ! -s "$error" ]] || fail "typed macro parameter defaults wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=3\tcapabilityHandleCount=3' "$output" \
        || fail "typed macro parameter defaults did not execute through ordinary macro values"
    /usr/bin/grep -Fq $'name=typedParameterDefaultsWorked\tmemberKind=let\ttype=Int' "$output" \
        || fail "typed macro parameter defaults did not preserve optional String and Bool values"

    legacy_status=0
    "$STAGE2_EXECUTABLE" compile "$legacy_fixture" > "$legacy_output" 2> "$legacy_error" \
        || legacy_status=$?
    [[ "$legacy_status" -eq 65 ]] \
        || fail "explicit optional nil default exited $legacy_status instead of 65"
    [[ ! -s "$legacy_error" ]] \
        || fail "explicit optional nil default wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=malformedMacroDeclaration' "$legacy_output" \
        || fail "explicit optional nil default missed malformed macro declaration diagnostic"
    echo "Macros typed-parameter-defaults: pass (implicit optional nil, explicit ?(nil) rejection)"
}

check_graph_capabilities() {
    local pass_fixture="$REPO_ROOT/Testing/Macros/Pass/GraphCapabilities.range"
    local output="$WORK_ROOT/graph-capabilities.out"
    local error="$WORK_ROOT/graph-capabilities.err"
    local actual_status relative expected

    "$STAGE2_EXECUTABLE" compile "$pass_fixture" > "$output" 2> "$error" \
        || fail "graph capabilities did not compile"
    [[ ! -s "$error" ]] || fail "graph capabilities wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$output" \
        || fail "graph capabilities did not execute both syntax-bearing and syntaxless families"

    for relative in \
        Testing/Macros/Fail/GraphMissingDeclaration.range \
        Testing/Macros/Fail/GraphMissingApplication.range; do
        expected=graphApplicationCapabilityMissing
        if [[ "$relative" == *MissingDeclaration.range ]]; then
            expected=graphDeclarationCapabilityMissing
        fi
        if "$STAGE2_EXECUTABLE" compile "$REPO_ROOT/$relative" > "$output" 2> "$error"; then
            actual_status=0
        else
            actual_status=$?
        fi
        [[ "$actual_status" -eq 65 ]] || fail "$relative exited $actual_status instead of 65"
        [[ ! -s "$error" ]] || fail "$relative wrote stderr"
        /usr/bin/grep -Fq "diagnosticKind=$expected" "$output" \
            || fail "$relative omitted $expected"
    done
    echo "Macros graph-capabilities: pass"
}

write_command_group_bundle() {
    local output="$1"
    local header="$2"
    local fixture="$3"

    : > "$output"
    if [[ -n "$header" ]]; then
        /usr/bin/printf '%s\n' "$header" >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/CommandReflection.range' \
        '@builtin' \
        'construct Array<Element> {}' \
        '' \
        'macro member(): Declaration | Member -> Void {}' \
        'macro syntax(): Declaration -> Void {}' \
        '' \
        'construct Identifier {' \
        '    let name: String' \
        '}' \
        '' \
        'construct Construct {' \
        '    @member' \
        '    construct Declaration {' \
        '        let identifier: Identifier' \
        '        let members: Array<@member>' \
        '    }' \
        '}' \
        '' \
        'construct Function {' \
        '    @syntax' \
        '    @member' \
        '    construct Declaration {' \
        '        let identifier: Identifier' \
        '    }' \
        '}' >> "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/CommandGroup.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/CommandGroup.range" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_command_group() {
    local pass_fixture="$REPO_ROOT/Testing/CommandLine/Pass/Routes.range"
    local fail_fixture="$REPO_ROOT/Testing/CommandLine/Fail/EmptyCommandGroup.range"
    local snapshot_bundle="$WORK_ROOT/command-group.snapshot.range"
    local snapshot_output="$WORK_ROOT/command-group.snapshot.out"
    local snapshot_error="$WORK_ROOT/command-group.snapshot.err"
    local native_bundle="$WORK_ROOT/command-group.native.range"
    local native_llvm="$WORK_ROOT/command-group.native.ll"
    local native_error="$WORK_ROOT/command-group.native.err"
    local native_executable="$WORK_ROOT/command-group.native"
    local run_output="$WORK_ROOT/command-group.run.out"
    local run_error="$WORK_ROOT/command-group.run.err"
    local fail_bundle="$WORK_ROOT/command-group.empty.range"
    local fail_output="$WORK_ROOT/command-group.empty.out"
    local fail_error="$WORK_ROOT/command-group.empty.err"
    local actual_status

    write_command_group_bundle "$snapshot_bundle" compilerMacroSnapshot "$pass_fixture"
    "$STAGE2_EXECUTABLE" compile "$snapshot_bundle" > "$snapshot_output" 2> "$snapshot_error" \
        || fail "@commandGroup snapshot did not compile"
    [[ ! -s "$snapshot_error" ]] || fail "@commandGroup snapshot wrote stderr"
    /usr/bin/grep -E -q $'macroGraphGeneratedEnum\trow=[0-9]+\tkind=enum\townerSyntaxID=[0-9]+.*\tname=Command\t' "$snapshot_output" \
        || fail "@commandGroup snapshot omitted its target-owned Command enum"
    /usr/bin/grep -E -q $'macroGraphGeneratedFunction\trow=[0-9]+\tkind=function\townerSyntaxID=[0-9]+.*\tname=runCommandLine\treturnType=Int\t' "$snapshot_output" \
        || fail "@commandGroup snapshot omitted its target-owned runCommandLine function"

    write_command_group_bundle "$native_bundle" "" "$pass_fixture"
    "$STAGE2_EXECUTABLE" compile "$native_bundle" > "$native_llvm" 2> "$native_error" \
        || fail "@commandGroup ordinary program did not emit LLVM"
    [[ ! -s "$native_error" ]] || fail "@commandGroup ordinary program wrote stderr"
    validate_llvm "$native_llvm"
    link_llvm "$native_llvm" "$native_executable"
    if "$native_executable" render > "$run_output" 2> "$run_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 64 ]] || fail "@commandGroup generated fallback exited $actual_status instead of 64"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "@commandGroup render route wrote output"
    if "$native_executable" unknown > "$run_output" 2> "$run_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 64 ]] || fail "@commandGroup unknown route exited $actual_status instead of 64"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "@commandGroup unknown route wrote output"

    write_command_group_bundle "$fail_bundle" compilerMacroSnapshot "$fail_fixture"
    if "$STAGE2_EXECUTABLE" compile "$fail_bundle" > "$fail_output" 2> "$fail_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] || fail "empty @commandGroup exited $actual_status instead of 65"
    [[ ! -s "$fail_error" ]] || fail "empty @commandGroup rejection wrote stderr"
    /usr/bin/grep -Fq '@commandGroup requires at least one @command function.' "$fail_output" \
        || fail "empty @commandGroup omitted its focused diagnostic"
    if /usr/bin/grep -Fq 'define ' "$fail_output"; then
        fail "empty @commandGroup emitted LLVM before rejection"
    fi
    echo "CommandLine @commandGroup boundary: pass (generated enum/fallback snapshot, linked fallback execution, empty-group rejection)"
}

check_macro_body_capture() {
    local pass_fixture="$REPO_ROOT/Testing/Macros/Pass/CapturedBodyString.range"
    local type_fixture="$REPO_ROOT/Testing/Macros/Fail/CapturedBodyRequiresString.range"
    local body_fixture="$REPO_ROOT/Testing/Macros/Fail/CapturedBodyRequiresBody.range"
    local pass_bundle="$WORK_ROOT/macro-captured-body.pass.range"
    local pass_output="$WORK_ROOT/macro-captured-body.pass.out"
    local type_output="$WORK_ROOT/macro-captured-body.type.out"
    local body_output="$WORK_ROOT/macro-captured-body.missing.out"
    local error="$WORK_ROOT/macro-captured-body.err"
    local actual_status

    /usr/bin/printf '%s\n' compilerMacroSnapshot > "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/RawBuffer.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/Buffer.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Text/String.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/String.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${pass_fixture#"$REPO_ROOT/"}" >> "$pass_bundle"
    /bin/cat "$pass_fixture" >> "$pass_bundle"
    "$STAGE2_EXECUTABLE" compile "$pass_bundle" > "$pass_output" 2> "$error" \
        || fail "@capture body String did not compile"
    [[ ! -s "$error" ]] || fail "@capture body String wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1' "$pass_output" \
        || fail "@capture body String did not execute"
    /usr/bin/grep -Fq $'scalar=1\tchildCount=0\tparentRow=-1' "$pass_output" \
        || fail "@capture body String did not preserve the raw recipe text"

    if "$STAGE2_EXECUTABLE" compile "$type_fixture" > "$type_output" 2> "$error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] || fail "non-String @capture exited $actual_status instead of 65"
    [[ ! -s "$error" ]] || fail "non-String @capture rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=macroExecution\tdiagnosticKind=macroExecutionBodyInvalid' "$type_output" \
        || fail "non-String @capture did not fail at parameter materialization"

    if "$STAGE2_EXECUTABLE" compile "$body_fixture" > "$body_output" 2> "$error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] || fail "bodyless @capture exited $actual_status instead of 65"
    [[ ! -s "$error" ]] || fail "bodyless @capture rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=macroExecution\tdiagnosticKind=macroExecutionBodyInvalid' "$body_output" \
        || fail "bodyless @capture did not fail at parameter materialization"
    echo "Macros raw body-to-String capture: pass"
}

check_syntax_recipes() {
    local pass_fixture="$REPO_ROOT/Testing/Syntax/Pass/DeclarationRecipeCaptures.range"
    local nested_fixture="$REPO_ROOT/Testing/Syntax/Pass/NestedRecipeCapture.range"
    local fail_fixture="$REPO_ROOT/Testing/Syntax/Fail/UnknownDeclarationRecipeCapture.range"
    local pass_bundle="$WORK_ROOT/syntax-recipes.pass.range"
    local pass_output="$WORK_ROOT/syntax-recipes.pass.out"
    local pass_error="$WORK_ROOT/syntax-recipes.pass.err"
    local nested_bundle="$WORK_ROOT/syntax-recipes.nested.range"
    local nested_output="$WORK_ROOT/syntax-recipes.nested.out"
    local nested_error="$WORK_ROOT/syntax-recipes.nested.err"
    local closure_bundle="$WORK_ROOT/syntax-recipes.closure.range"
    local closure_output="$WORK_ROOT/syntax-recipes.closure.out"
    local closure_error="$WORK_ROOT/syntax-recipes.closure.err"
    local fail_bundle="$WORK_ROOT/syntax-recipes.fail.range"
    local fail_output="$WORK_ROOT/syntax-recipes.fail.out"
    local fail_error="$WORK_ROOT/syntax-recipes.fail.err"
    local actual_status

    /usr/bin/printf '%s\n' compilerSyntaxRecipes > "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'macro syntax(@capture template: String): Declaration -> Void {}' >> "$pass_bundle"
    /bin/cat "$pass_fixture" >> "$pass_bundle"
    "$STAGE2_EXECUTABLE" compile "$pass_bundle" > "$pass_output" 2> "$pass_error" \
        || fail "syntax recipe capture fixture did not compile"
    [[ ! -s "$pass_error" ]] || fail "syntax recipe capture fixture wrote stderr"
    /usr/bin/grep -Fq $'syntaxRecipes\tvalid=true\trecipeCount=1' "$pass_output" \
        || fail "syntax recipe summary omitted its collected recipe counts"
    /usr/bin/grep -Fq $'syntaxRecipeCapture\trecipeRow=0\tordinal=0\tname=attributes' "$pass_output" \
        || fail "syntax recipe did not bind attributes"
    /usr/bin/grep -Fq $'name=attributes\tmemberRow=0\ttype=Array<String>\toccurrence=many' "$pass_output" \
        || fail "syntax recipe did not derive many occurrence"
    /usr/bin/grep -Fq $'name=name\tmemberRow=1\ttype=String\toccurrence=one' "$pass_output" \
        || fail "syntax recipe did not derive one occurrence"
    /usr/bin/grep -Fq $'name=result\tmemberRow=3\ttype=String?\toccurrence=zeroOrOne' "$pass_output" \
        || fail "syntax recipe did not derive postfix zero-or-one occurrence"

    /usr/bin/printf '%s\n' compilerSyntaxRecipes > "$nested_bundle"
    /usr/bin/printf '%s\n' \
        'macro syntax(@capture template: String): Declaration -> Void {}' >> "$nested_bundle"
    /bin/cat "$nested_fixture" >> "$nested_bundle"
    "$STAGE2_EXECUTABLE" compile "$nested_bundle" > "$nested_output" 2> "$nested_error" \
        || fail "nested syntax recipe fixture did not compile"
    [[ ! -s "$nested_error" ]] || fail "nested syntax recipe fixture wrote stderr"
    /usr/bin/grep -Fq $'syntaxRecipes\tvalid=true\trecipeCount=2' "$nested_output" \
        || fail "nested syntax recipe summary omitted both recipes"
    /usr/bin/grep -E -q $'name=clause\tmemberRow=0\ttype=Clause\\?\toccurrence=zeroOrOne\tnestedTargetSyntaxID=[0-9]+\tnestedRecipeApplicationRow=1' "$nested_output" \
        || fail "zero-or-one nominal capture did not resolve its nested syntax recipe"

    /usr/bin/printf '%s\n' \
        compilerSyntaxRecipes \
        'macro stored(): Construct -> Void {}' \
        'macro value(): Member -> Void {}' \
        'construct Nil {}' \
        'construct Identifier {}' \
        'construct Parsed<Value> {}' \
        'construct TypeReference {}' \
        '@syntax' \
        'construct Expression {' \
        '    let type: TypeReference?' \
        '}' \
        'construct Parameter {' \
        '    @syntax' \
        '    construct Declaration {}' \
        '    @syntax' \
        '    construct Application {}' \
        '}' \
        'enum DelimiterPair {' \
        '    case parentheses' \
        '    case braces' \
        '    case brackets' \
        '    case angles' \
        '}' \
        '@syntax' \
        'construct Block<Value = @syntax, shape: DelimiterPair = .braces> {' \
        '    let contents: Array<Value>' \
        '}' > "$closure_bundle"
    /usr/bin/printf '%s\n' \
        'macro syntax(@capture template: String): Declaration -> Void {}' >> "$closure_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Expressions/Closure.range" >> "$closure_bundle"
    "$STAGE2_EXECUTABLE" compile "$closure_bundle" > "$closure_output" 2> "$closure_error" \
        || fail "canonical Core Closure syntax recipes did not compile"
    [[ ! -s "$closure_error" ]] || fail "canonical Core Closure syntax recipes wrote stderr"
    /usr/bin/grep -Fq $'syntaxRecipes\tvalid=true\trecipeCount=8' "$closure_output" \
        || fail "canonical Core Closure syntax recipe count changed"
    /usr/bin/grep -E -q $'name=parameters.*type=ParameterClause\\?.*nestedRecipeApplicationRow=8' "$closure_output" \
        || fail "Closure.Literal parameters did not resolve ParameterClause syntax"
    /usr/bin/grep -E -q $'name=closure.*type=Literal.*nestedRecipeApplicationRow=4' "$closure_output" \
        || fail "Closure.Application did not resolve Closure.Literal syntax"
    /usr/bin/grep -E -q $'name=closure.*type=Expression.*nestedRecipeApplicationRow=0' "$closure_output" \
        || fail "Closure.Invocation did not resolve its expression syntax"
    /usr/bin/grep -E -q $'name=arguments.*type=Array<Parameter.Application>.*nestedRecipeApplicationRow=2' "$closure_output" \
        || fail "Closure.Invocation arguments did not resolve Parameter.Application syntax"
    /usr/bin/grep -E -q $'name=declarations.*type=Array<Parameter.Declaration>.*nestedRecipeApplicationRow=1' "$closure_output" \
        || fail "Closure.ParameterClause did not resolve Parameter.Declaration syntax"

    /usr/bin/printf '%s\n' compilerSyntaxRecipes > "$fail_bundle"
    /usr/bin/printf '%s\n' \
        'macro syntax(@capture template: String): Declaration -> Void {}' >> "$fail_bundle"
    /bin/cat "$fail_fixture" >> "$fail_bundle"
    if "$STAGE2_EXECUTABLE" compile "$fail_bundle" > "$fail_output" 2> "$fail_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] || fail "unknown syntax recipe capture exited $actual_status instead of 65"
    [[ ! -s "$fail_error" ]] || fail "unknown syntax recipe capture wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=syntaxRecipeUnknownCapture' "$fail_output" \
        || fail "unknown syntax recipe capture omitted its focused diagnostic"
    /usr/bin/grep -Fq $'name=missing' "$fail_output" \
        || fail "unknown syntax recipe capture omitted its capture name"
    echo "Syntax declaration recipes: pass"
}

check_range_authored_syntax_template() {
    local pass_fixture="$REPO_ROOT/Testing/Syntax/Pass/RangeAuthoredTemplateValue.range"
    local fail_fixture="$REPO_ROOT/Testing/Syntax/Fail/RangeAuthoredUnknownCapture.range"
    local match_fixture="$REPO_ROOT/Testing/Syntax/Pass/RangeAuthoredSingleCaptureMatch.range"
    local mismatch_fixture="$REPO_ROOT/Testing/Syntax/Fail/RangeAuthoredLiteralMismatch.range"
    local pass_bundle="$WORK_ROOT/range-authored-syntax-template.pass.range"
    local fail_bundle="$WORK_ROOT/range-authored-syntax-template.fail.range"
    local match_bundle="$WORK_ROOT/range-authored-syntax-template.match.range"
    local mismatch_bundle="$WORK_ROOT/range-authored-syntax-template.mismatch.range"
    local pass_output="$WORK_ROOT/range-authored-syntax-template.pass.out"
    local fail_output="$WORK_ROOT/range-authored-syntax-template.fail.out"
    local match_output="$WORK_ROOT/range-authored-syntax-template.match.out"
    local mismatch_output="$WORK_ROOT/range-authored-syntax-template.mismatch.out"
    local pass_error="$WORK_ROOT/range-authored-syntax-template.pass.err"
    local fail_error="$WORK_ROOT/range-authored-syntax-template.fail.err"
    local match_error="$WORK_ROOT/range-authored-syntax-template.match.err"
    local mismatch_error="$WORK_ROOT/range-authored-syntax-template.mismatch.err"
    local actual_status

    /usr/bin/printf '%s\n' \
        compilerMacroSnapshot \
        'compilerSourceFile\trole=core\tpath=Core/SyntaxTemplatePrelude.range' \
        'macro member(): Declaration | Member -> Void {}' \
        'macro stored(): Construct -> Void {}' \
        'construct Nil {}' \
        'construct Identifier {' \
        '    let name: String' \
        '}' \
        'construct TypeReference {}' \
        'construct Expression {}' \
        'construct Parsed<ParsedValue> {' \
        '    let value: ParsedValue' \
        '    let diagnostics: Array<String>' \
        '}' \
        'construct Macro {' \
        '    construct Declaration {}' \
        '    construct Application<Value = Nil> {' \
        '        let identifier: Identifier' \
        '        let target: Identifier' \
        '        let genericArguments: Array<TypeReference>' \
        '        let argumentClause: String' \
        '        let arguments: Array<Expression>' \
        '        let declaration: Declaration?' \
        '        let packageVisibility: String' \
        '        let valueType: TypeReference' \
        '        let value: Value' \
        '    }' \
        '}' \
        'construct Construct {' \
        '    construct Declaration {' \
        '        let macros: Array<Macro.Application>' \
        '        let identifier: Identifier' \
        '        let members: Array<@member>' \
        '    }' \
        '}' \
        '@stored' \
        '@member' \
        'construct Let {' \
        '    let identifier: Identifier' \
        '}' > "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/RawBuffer.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/Buffer.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Text/String.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/String.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/DataSystem/Array/Array.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/DataSystem/Array/Array.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Syntax/Parsing/IdentifierRules.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Parsing/IdentifierRules.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Syntax/Parsing/SyntaxTemplate.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Parsing/SyntaxTemplate.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Syntax.range' >> "$pass_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Syntax.range" >> "$pass_bundle"
    /usr/bin/printf '\n' >> "$pass_bundle"
    /bin/cp "$pass_bundle" "$fail_bundle"
    /bin/cp "$pass_bundle" "$match_bundle"
    /bin/cp "$pass_bundle" "$mismatch_bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' \
        "${pass_fixture#"$REPO_ROOT/"}" >> "$pass_bundle"
    /bin/cat "$pass_fixture" >> "$pass_bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' \
        "${fail_fixture#"$REPO_ROOT/"}" >> "$fail_bundle"
    /bin/cat "$fail_fixture" >> "$fail_bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' \
        "${match_fixture#"$REPO_ROOT/"}" >> "$match_bundle"
    /bin/cat "$match_fixture" >> "$match_bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' \
        "${mismatch_fixture#"$REPO_ROOT/"}" >> "$mismatch_bundle"
    /bin/cat "$mismatch_fixture" >> "$mismatch_bundle"
    "$STAGE2_EXECUTABLE" compile "$pass_bundle" > "$pass_output" 2> "$pass_error" \
        || fail "Range-authored syntax template value did not compile"
    [[ ! -s "$pass_error" ]] || fail "Range-authored syntax template value wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1' "$pass_output" \
        || fail "Range-authored syntax macro did not execute"
    /usr/bin/grep -E -q $'macroResult\trow=0.*kind=3.*typeKind=4.*nominalSyntaxID=[0-9]+.*childCount=9.*parentRow=-1' "$pass_output" \
        || fail "Range-authored syntax macro did not return a typed SyntaxTemplate"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=2.*typeKind=4.*childCount=29.*parentRow=[0-9]+.*ordinal=0' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain the captured recipe String"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=2.*typeKind=4.*childCount=3.*parentRow=0.*ordinal=1' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its declaration-member many"
    [[ "$(/usr/bin/grep -E -c $'macroResult\trow=[0-9]+.*kind=5.*typeKind=6.*childCount=0.*parentRow=[0-9]+' "$pass_output")" -eq 5 ]] \
        || fail "Range-authored SyntaxTemplate did not retain its members and resolved capture handles"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=5.*typeKind=6.*scalar=[0-9]+.*childCount=0.*parentRow=0.*ordinal=2' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its first resolved capture member"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=5.*typeKind=6.*scalar=[0-9]+.*childCount=0.*parentRow=0.*ordinal=3' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its second resolved capture member"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=1.*typeKind=1.*scalar=2.*parentRow=0.*ordinal=4' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its capture count"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=1.*typeKind=1.*scalar=11.*parentRow=0.*ordinal=5' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its derived literal prefix count"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=1.*typeKind=1.*scalar=16.*parentRow=0.*ordinal=6' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its separator start"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=1.*typeKind=1.*scalar=1.*parentRow=0.*ordinal=7' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its separator count"
    /usr/bin/grep -E -q $'macroResult\trow=[0-9]+.*kind=1.*typeKind=1.*scalar=2.*parentRow=0.*ordinal=8' "$pass_output" \
        || fail "Range-authored SyntaxTemplate did not retain its derived literal suffix count"

    if "$STAGE2_EXECUTABLE" compile "$fail_bundle" > "$fail_output" 2> "$fail_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Range-authored unknown syntax capture exited $actual_status instead of 65"
    [[ ! -s "$fail_error" ]] || fail "Range-authored unknown syntax capture wrote stderr"
    /usr/bin/grep -Fq $'diagnosticKind=macroExecutionError' "$fail_output" \
        || fail "Range-authored unknown syntax capture did not fail through macro diagnostics"
    /usr/bin/grep -Fq 'Every syntax capture must name a let member of its declaration.' "$fail_output" \
        || fail "Range-authored unknown syntax capture omitted its diagnostic message"

    if ! "$STAGE2_EXECUTABLE" compile "$match_bundle" > "$match_output" 2> "$match_error"; then
        fail "Range-authored single-capture syntax match did not compile"
    fi
    [[ ! -s "$match_error" ]] \
        || fail "Range-authored single-capture syntax match wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$match_output" \
        || fail "Range-authored single-capture syntax match did not execute"
    /usr/bin/grep -E -q $'macroResult\trow=46.*invocationRow=1.*kind=3.*typeKind=4.*childCount=3.*parentRow=-1' "$match_output" \
        || fail "Range-authored single-capture syntax match did not return a populated Match"
    /usr/bin/grep -E -q $'macroResult\trow=47.*invocationRow=1.*kind=3.*typeKind=4.*childCount=9.*parentRow=46.*ordinal=0' "$match_output" \
        || fail "Range-authored single-capture syntax match did not retain its derived template"
    /usr/bin/grep -E -q $'macroResult\trow=93.*invocationRow=1.*kind=5.*typeKind=6.*parentRow=46.*ordinal=1' "$match_output" \
        || fail "Range-authored single-capture syntax match did not retain its source syntax"
    /usr/bin/grep -E -q $'macroResult\trow=94.*invocationRow=1.*kind=3.*typeKind=4.*childCount=2.*parentRow=46.*ordinal=2' "$match_output" \
        || fail "Range-authored single-capture syntax match did not retain its populated Capture"
    /usr/bin/grep -E -q $'macroResult\trow=95.*invocationRow=1.*kind=5.*typeKind=6.*scalar=[0-9]+.*childCount=0.*parentRow=94.*ordinal=0' "$match_output" \
        || fail "Range-authored single-capture syntax match did not reference its captured Let member"
    /usr/bin/grep -E -q $'macroResult\trow=96.*invocationRow=1.*kind=2.*typeKind=4.*childCount=1.*parentRow=94.*ordinal=1' "$match_output" \
        || fail "Range-authored single-capture syntax match did not retain one captured syntax value"
    /usr/bin/grep -E -q $'macroResult\trow=97.*invocationRow=1.*kind=5.*typeKind=6.*childCount=3.*parentRow=96.*ordinal=0' "$match_output" \
        || fail "Range-authored single-capture syntax match did not materialize the captured syntax slice"
    /usr/bin/grep -E -q $'macroResult\trow=99.*invocationRow=1.*kind=1.*scalar=434.*parentRow=97.*ordinal=1' "$match_output" \
        || fail "Range-authored single-capture syntax match did not start its slice at name"
    /usr/bin/grep -E -q $'macroResult\trow=100.*invocationRow=1.*kind=1.*scalar=438.*parentRow=97.*ordinal=2' "$match_output" \
        || fail "Range-authored single-capture syntax match did not end its slice after name"
    if "$STAGE2_EXECUTABLE" compile "$mismatch_bundle" > "$mismatch_output" 2> "$mismatch_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Range-authored syntax literal mismatch exited $actual_status instead of 65"
    [[ ! -s "$mismatch_error" ]] \
        || fail "Range-authored syntax literal mismatch wrote stderr"
    /usr/bin/grep -Fq $'diagnosticKind=macroExecutionError' "$mismatch_output" \
        || fail "Range-authored syntax literal mismatch did not fail through macro diagnostics"
    /usr/bin/grep -Fq 'Syntax template literal did not match source.' "$mismatch_output" \
        || fail "Range-authored syntax literal mismatch omitted its diagnostic message"
    echo "Syntax Range-authored template derivation, member matching, source text, and source slicing: pass"
}

check_legacy_bracket_collection_type_rejected() {
    local fixture="$REPO_ROOT/Testing/Collections/Fail/LegacyBracketCollectionType.range"
    local output="$WORK_ROOT/legacy-bracket-collection-type.out"
    local error="$WORK_ROOT/legacy-bracket-collection-type.err"
    local actual_status

    if "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "legacy bracket collection type exited $actual_status instead of 65"
    [[ ! -s "$error" ]] || fail "legacy bracket collection type rejection wrote stderr"
    /usr/bin/grep -Fqx $'compilerError\tkind=invalidTypedSyntaxSnapshot' "$output" \
        || fail "legacy bracket collection type did not fail typed syntax capture"
    echo "Collections legacy bracket type rejected: pass"
}

check_canonical_member_family() {
    local fixture="$REPO_ROOT/Testing/Members/Pass/CanonicalMemberFamily.range"
    local output="$WORK_ROOT/member-family-canonical.out"
    local error="$WORK_ROOT/member-family-canonical.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Canonical @member family did not compile"
    [[ ! -s "$error" ]] || fail "Canonical @member family wrote stderr"
    /usr/bin/grep -Fq $'macroFamilyMemory\tvalid=true\tfamilyCount=1\tmemberCount=4\trepresentationCount=1\tpartitionCount=1\tvalueCount=4' "$output" \
        || fail "Canonical @member family did not retain all direct representations"
    echo "Members canonical-family: pass"
}

check_canonical_declaration_envelopes() {
    local bundle="$WORK_ROOT/declaration-envelope-models.range"
    local output="$WORK_ROOT/declaration-envelope-models.out"
    local error="$WORK_ROOT/declaration-envelope-models.err"
    local relative expectation path name
    local -a model_sources=(
        RangeCompiler/Sources/Core/Macro/Graph.range
        RangeCompiler/Sources/Core/Macro/Syntax.range
        RangeCompiler/Sources/Core/Macro/Macro.range
        RangeCompiler/Sources/Core/Syntax/Program/Relationship.range
        RangeCompiler/Sources/Core/Syntax/Bodies/DelimiterPair.range
        RangeCompiler/Sources/Core/Macro/Hashable.range
        RangeCompiler/Sources/Core/Macro/Many.range
        RangeCompiler/Sources/Core/System/Memory/Buffer.range
        RangeCompiler/Sources/Core/Coding/UUID.range
        RangeCompiler/Sources/Core/Syntax/Identifier.range
        RangeCompiler/Sources/Core/Syntax/Parsing/SyntaxForm.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Construct.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Function.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Enum.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Extension.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Parameter.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/Let.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/State.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/Binding.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/Derived.range
    )
    local -a expectations=(
        'Macro.range|macros'
        'Macro.range|identifier'
        'Macro.range|target'
        'Identifier.range|name'
        'Identifier.range|id'
        'Identifier.range|parent'
        'Identifier.range|source'
        'SyntaxForm.range|introducer'
        'SyntaxForm.range|identifier'
        'SyntaxForm.range|role'
        'SyntaxForm.range|enclosure'
        'SyntaxForm.range|child'
        'SyntaxForm.range|parts'
        'Construct.range|macros'
        'Construct.range|identifier'
        'Function.range|macros'
        'Function.range|identifier'
        'Function.range|parameters'
        'Function.range|returnType'
        'Function.range|body'
        'Enum.range|macros'
        'Enum.range|identifier'
        'Extension.range|macros'
        'Extension.range|identifier'
        'Parameter.range|macros'
        'Parameter.range|identifier'
        'Let.range|macros'
        'Let.range|identifier'
        'Let.range|value'
        'State.range|macros'
        'State.range|identifier'
        'State.range|value'
        'Binding.range|macros'
        'Binding.range|identifier'
        'Binding.range|type'
        'Binding.range|getterBody'
        'Binding.range|setterBody'
        'Derived.range|macros'
        'Derived.range|identifier'
        'Derived.range|type'
        'Derived.range|body'
    )

    /usr/bin/printf '%s\n' 'compilerPlotter' > "$bundle"
    for relative in "${model_sources[@]}"; do
        /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "$relative" >> "$bundle"
        /bin/cat "$REPO_ROOT/$relative" >> "$bundle"
        /usr/bin/printf '\n' >> "$bundle"
    done
    "$STAGE2_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
        || fail "Canonical declaration-envelope models did not compile: $(/usr/bin/head -n 1 "$output")"
    [[ ! -s "$error" ]] || fail "Canonical declaration-envelope models wrote stderr"
    for expectation in "${expectations[@]}"; do
        path="${expectation%%|*}"
        name="${expectation#*|}"
        /usr/bin/grep -F $'graphNominal\t' "$output" \
            | /usr/bin/grep -F "keyword=let"$'\t'"name=$name" \
            | /usr/bin/grep -F "path=RangeCompiler/Sources/Core/" \
            | /usr/bin/grep -F "/$path" > /dev/null \
            || fail "Canonical declaration envelope omitted $path let $name"
    done
    if /usr/bin/grep -F $'graphNominal\t' "$output" \
        | /usr/bin/grep -F $'keyword=let\tname=identity\t' \
        | /usr/bin/grep -F 'path=RangeCompiler/Sources/Core/' > /dev/null; then
        fail "Canonical declaration envelopes retained a parallel identity field"
    fi
    /usr/bin/grep -F $'graphNominal\t' "$output" \
        | /usr/bin/grep -F $'keyword=let\tname=parent\t' \
        | /usr/bin/grep -F 'path=RangeCompiler/Sources/Core/Syntax/Identifier.range' \
        > /dev/null \
        || fail "Canonical Identifier omitted its direct parent relationship"
    if /usr/bin/grep -Fq 'GraphIdentity' "$bundle" || /usr/bin/grep -Fq 'RangeGraphIdentity' "$bundle"; then
        fail "Canonical declaration envelopes retained a parallel identity type"
    fi
    echo "Members declaration-envelopes: pass"
}

check_missing_nominal_graph_warning() {
    local fixture="$REPO_ROOT/Testing/Graph/Pass/MissingNominalWarning.range"
    local declarations_fixture="$REPO_ROOT/Testing/Graph/Pass/NominalDeclarationKinds.range"
    local local_declarations_fixture="$REPO_ROOT/Testing/Graph/Pass/LocalNominalDeclarations.range"
    local lowercase_fixture="$REPO_ROOT/Testing/Graph/Pass/LowercaseSignatureMissingNominal.range"
    local macro_fixture="$REPO_ROOT/Testing/Graph/Pass/MacroNominalWarning.range"
    local macro_mismatch_fixture="$REPO_ROOT/Testing/Graph/Pass/MacroNominalTargetMismatch.range"
    local ambiguous_fixture="$REPO_ROOT/Testing/Graph/Pass/AmbiguousNominalWarning.range"
    local output="$WORK_ROOT/graph-missing-nominal.out"
    local declarations_output="$WORK_ROOT/graph-nominal-declarations.out"
    local local_declarations_output="$WORK_ROOT/graph-local-nominal-declarations.out"
    local lowercase_output="$WORK_ROOT/graph-lowercase-missing-nominal.out"
    local macro_output="$WORK_ROOT/graph-macro-nominal.out"
    local macro_mismatch_output="$WORK_ROOT/graph-macro-nominal-target-mismatch.out"
    local ambiguous_output="$WORK_ROOT/graph-ambiguous-nominal.out"
    local strict_fixture="$WORK_ROOT/graph-missing-nominal-strict.range"
    local strict_output="$WORK_ROOT/graph-missing-nominal-strict.out"
    local error="$WORK_ROOT/graph-missing-nominal.err"
    local warning_count missing_record_count strict_status

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Graph missing-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph missing-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'graphDelta\tvalid=true\tnodeCount=5\tfactCount=2\tgeneratedFunctionCount=0\tnominalCount=5\tnominalReferenceCount=4\twarningCount=1' "$output" \
        || fail "Graph artifact omitted its complete nominal declaration, reference, and warning counts"
    /usr/bin/grep -Fq $'graphNominal\tid=0\tkeyword=construct\tname=Box' "$output" \
        || fail "Graph artifact omitted the construct Box nominal declaration"
    /usr/bin/grep -F $'graphNominal\t' "$output" | /usr/bin/grep -F $'keyword=state\tname=missing' > /dev/null \
        || fail "Graph artifact omitted the state missing nominal declaration"
    /usr/bin/grep -Fq $'role=memberType\texpectedKinds=construct,enum\tname=Known\ttargetKind=declaration' "$output" \
        || fail "Graph artifact omitted the declared nested nominal"
    /usr/bin/grep -Fq $'role=memberType\texpectedKinds=construct,enum\tname=Missing\ttargetKind=missing\ttargetID=-1\ttargetNominalID=-1\tdeclared=false' "$output" \
        || fail "Graph artifact omitted the unresolved nominal reference"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=missingNominal' "$output" \
        || fail "Graph artifact omitted the missing-nominal warning"
    /usr/bin/grep -Fq $'expectedKinds=construct,enum\tname=Missing\tfileID=0\tpath=Project/MissingNominalWarning.range\tstart=119\tend=126' "$output" \
        || fail "Graph artifact missing-nominal warning omitted its exact source path or span"
    warning_count="$(/usr/bin/grep -F -c $'graphWarning\tseverity=warning\tkind=missingNominal' "$output" || true)"
    missing_record_count="$(/usr/bin/grep -F -c $'role=memberType\texpectedKinds=construct,enum\tname=Missing\ttargetKind=missing\ttargetID=-1\ttargetNominalID=-1\tdeclared=false' "$output" || true)"
    [[ "$warning_count" -eq 1 && "$missing_record_count" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one missing-nominal reference and warning"
    /usr/bin/grep -v '^compilerPlotter$' "$fixture" > "$strict_fixture"
    set +e
    "$STAGE2_EXECUTABLE" compile "$strict_fixture" > "$strict_output" 2> "$error"
    strict_status=$?
    set -e
    [[ "$strict_status" -eq 65 ]] || fail "Ordinary compilation did not reject the unresolved nominal"
    [[ ! -s "$error" ]] || fail "Ordinary unresolved-nominal rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedDeclarations\tphase=enumPayloadLink\treason=invalidEnumPayloadType\trole=project\tpath=Project/MissingNominalWarning.range' "$strict_output" \
        || fail "Ordinary compilation did not preserve the strict unresolved-nominal diagnostic"
    ! /usr/bin/grep -Fq 'define ' "$strict_output" \
        || fail "Ordinary unresolved-nominal compilation emitted LLVM"

    "$STAGE2_EXECUTABLE" compile "$declarations_fixture" > "$declarations_output" 2> "$error" \
        || fail "Graph nominal-declaration fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph nominal-declaration fixture wrote stderr"
    /usr/bin/grep -Fq $'graphDelta\tvalid=true\tnodeCount=17\tfactCount=15\tgeneratedFunctionCount=0\tnominalCount=9\tnominalReferenceCount=6\twarningCount=0' "$declarations_output" \
        || fail "Graph artifact did not retain every keyword-plus-name declaration"
    /usr/bin/grep -F $'graphRelationship\t' "$declarations_output" | /usr/bin/grep -F $'role=member' | /usr/bin/grep -F $'minimum=0\tmaximumKind=unbounded\tmaximum=-1\tordering=ordered' > /dev/null \
        || fail "Graph artifact did not retain the ordered many member relationship"
    /usr/bin/grep -F $'graphRelationship\t' "$declarations_output" | /usr/bin/grep -F $'role=parameter' | /usr/bin/grep -F $'originKind=syntax' | /usr/bin/grep -F $'destinationKind=syntax' | /usr/bin/grep -F $'minimum=0\tmaximumKind=unbounded\tmaximum=-1\tordering=ordered\tseparatorKind=1\tseparatorID=' | /usr/bin/grep -F $'\tenclosureKind=1' > /dev/null \
        || fail "Graph artifact did not retain the comma-separated parenthesized parameter relationship"
    for declaration in \
        $'keyword=macro\tname=observed' \
        $'keyword=construct\tname=Model' \
        $'keyword=enum\tname=Flag' \
        $'keyword=case\tname=on' \
        $'keyword=function\tname=transform' \
        $'keyword=let\tname=fixed' \
        $'keyword=state\tname=changing' \
        $'keyword=binding\tname=shared' \
        $'keyword=derived\tname=computed'; do
        /usr/bin/grep -F $'graphNominal\t' "$declarations_output" | /usr/bin/grep -F "$declaration" > /dev/null \
            || fail "Graph artifact omitted nominal declaration $declaration"
    done

    "$STAGE2_EXECUTABLE" compile "$local_declarations_fixture" > "$local_declarations_output" 2> "$error" \
        || fail "Graph local nominal-declaration fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph local nominal-declaration fixture wrote stderr"
    /usr/bin/grep -F $'graphNominal\t' "$local_declarations_output" | /usr/bin/grep -F $'keyword=let\tname=copy' > /dev/null \
        || fail "Graph artifact omitted the local let copy nominal declaration"
    /usr/bin/grep -F $'graphNominal\t' "$local_declarations_output" | /usr/bin/grep -F $'keyword=state\tname=total' > /dev/null \
        || fail "Graph artifact omitted the local state total nominal declaration"
    [[ "$(/usr/bin/grep -F -c $'keyword=let\tname=copy' "$local_declarations_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one local let nominal declaration"
    [[ "$(/usr/bin/grep -F -c $'keyword=state\tname=total' "$local_declarations_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one local state nominal declaration"
    /usr/bin/grep -Fq $'warningCount=0' "$local_declarations_output" \
        || fail "Graph local nominal-declaration fixture emitted an unexpected warning"

    "$STAGE2_EXECUTABLE" compile "$lowercase_fixture" > "$lowercase_output" 2> "$error" \
        || fail "Graph lowercase missing-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph lowercase missing-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'role=parameterType\texpectedKinds=construct,enum\tname=missingType\ttargetKind=missing\ttargetID=-1\ttargetNominalID=-1\tdeclared=false' "$lowercase_output" \
        || fail "Graph artifact gave identifier casing semantic meaning"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=missingNominal' "$lowercase_output" \
        || fail "Graph artifact omitted the lowercase missing-nominal warning"
    [[ "$(/usr/bin/grep -F -c $'graphWarning\tseverity=warning\tkind=missingNominal' "$lowercase_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one lowercase missing-nominal warning"

    "$STAGE2_EXECUTABLE" compile "$macro_fixture" > "$macro_output" 2> "$error" \
        || fail "Graph macro-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph macro-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'graphDelta\tvalid=true\tnodeCount=1\tfactCount=0\tgeneratedFunctionCount=0\tnominalCount=2\tnominalReferenceCount=2\twarningCount=1' "$macro_output" \
        || fail "Graph artifact did not retain macro declarations and applications"
    /usr/bin/grep -Fq $'identityCount=5\trelationshipCount=5' "$macro_output" \
        || fail "Graph artifact did not project macro declarations and applications as identities"
    /usr/bin/grep -Fq $'graphIdentity\tid=1\tkind=macroDeclaration\tidentityID=0\tsyntaxKind=macro\tname=observed' "$macro_output" \
        || fail "Graph artifact did not plot the macro declaration identity"
    /usr/bin/grep -Fq $'graphIdentity\tid=2\tkind=macroApplication\tidentityID=0\tsyntaxKind=construct\tname=observed' "$macro_output" \
        || fail "Graph artifact did not plot the resolved macro application identity"
    /usr/bin/grep -Fq $'graphIdentity\tid=3\tkind=macroApplication\tidentityID=1\tsyntaxKind=construct\tname=missing' "$macro_output" \
        || fail "Graph artifact did not plot the unresolved macro application identity"
    /usr/bin/grep -Fq $'graphRelationship\tid=0\trole=appliesTo\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=0\tdestinationKind=syntax\tdestinationID=0\tordinal=0\tminimum=1\tmaximumKind=finite\tmaximum=1\tordering=unordered' "$macro_output" \
        || fail "Graph artifact did not project the macro appliesTo relationship"
    /usr/bin/grep -Fq $'graphRelationship\tid=1\trole=references\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=1\tdestinationKind=macroDeclaration\tdestinationID=0' "$macro_output" \
        || fail "Graph artifact did not project the macro references relationship"
    /usr/bin/grep -Fq $'graphRelationship\tid=2\trole=resolvedBy\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=1\tdestinationKind=macroDeclaration\tdestinationID=0' "$macro_output" \
        || fail "Graph artifact did not project the macro resolvedBy relationship"
    /usr/bin/grep -Fq $'graphRelationship\tid=3\trole=appliesTo\toriginNodeID=3\toriginKind=macroApplication\toriginID=1\tdestinationNodeID=0\tdestinationKind=syntax\tdestinationID=0\tordinal=1' "$macro_output" \
        || fail "Graph artifact did not retain the unresolved application's target relationship"
    /usr/bin/grep -Fq $'role=macroApplication\texpectedKinds=macro\tname=observed\ttargetKind=declaration' "$macro_output" \
        || fail "Graph artifact did not link the declared macro application"
    /usr/bin/grep -Fq $'sourceKind=macroApplication\tsourceReferenceID=0\tparentSourceReferenceID=-1' "$macro_output" \
        || fail "Graph artifact did not retain the macro application as its reference source"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=missingNominal' "$macro_output" \
        || fail "Graph artifact did not warn about the undeclared macro application"
    /usr/bin/grep -Fq $'expectedKinds=macro\tname=missing\tfileID=0\tpath=Project/MacroNominalWarning.range\tstart=52\tend=59' "$macro_output" \
        || fail "Graph macro warning omitted its keyword, name, source path, or span"
    [[ "$(/usr/bin/grep -F -c $'graphWarning\tseverity=warning\tkind=missingNominal' "$macro_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one missing macro warning"

    "$STAGE2_EXECUTABLE" compile "$macro_mismatch_fixture" > "$macro_mismatch_output" 2> "$error" \
        || fail "Graph macro target-mismatch fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph macro target-mismatch fixture wrote stderr"
    /usr/bin/grep -Fq $'role=macroApplication\texpectedKinds=macro\tname=observed\ttargetKind=targetMismatch\ttargetID=1\ttargetNominalID=1\tdeclared=true\tapplicable=false' "$macro_mismatch_output" \
        || fail "Graph artifact did not preserve target-aware macro resolution"
    /usr/bin/grep -Fq $'identityCount=4\trelationshipCount=3' "$macro_mismatch_output" \
        || fail "Graph artifact did not retain the mismatch application and candidate identities"
    /usr/bin/grep -Fq $'role=references\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=1\tdestinationKind=macroDeclaration\tdestinationID=0' "$macro_mismatch_output" \
        || fail "Graph artifact did not retain the mismatch candidate relationship"
    ! /usr/bin/grep -Fq $'role=resolvedBy\toriginNodeID=2\toriginKind=macroApplication\toriginID=0' "$macro_mismatch_output" \
        || fail "Graph artifact resolved a target-mismatched macro application"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=nominalTargetMismatch' "$macro_mismatch_output" \
        || fail "Graph artifact mislabeled a macro target mismatch as a missing declaration"

    "$STAGE2_EXECUTABLE" compile "$ambiguous_fixture" > "$ambiguous_output" 2> "$error" \
        || fail "Graph ambiguous-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph ambiguous-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'role=macroApplication\texpectedKinds=macro\tname=repeated\ttargetKind=ambiguous\ttargetID=-1\ttargetNominalID=-1\tdeclared=true\tapplicable=false' "$ambiguous_output" \
        || fail "Graph artifact did not separate an ambiguous declaration from applicability"
    /usr/bin/grep -Fq $'identityCount=5\trelationshipCount=4' "$ambiguous_output" \
        || fail "Graph artifact did not retain every ambiguous declaration candidate"
    [[ "$(/usr/bin/grep -F -c $'role=references\toriginNodeID=3\toriginKind=macroApplication\toriginID=0' "$ambiguous_output" || true)" -eq 2 ]] \
        || fail "Graph artifact did not retain both ambiguous declaration candidates"
    ! /usr/bin/grep -Fq $'role=resolvedBy\toriginNodeID=3\toriginKind=macroApplication\toriginID=0' "$ambiguous_output" \
        || fail "Graph artifact resolved an ambiguous macro application"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=ambiguousNominal' "$ambiguous_output" \
        || fail "Graph artifact omitted the ambiguous-nominal warning"
    echo "Graph missing-nominal-warning: pass"
}

check_slot_graph_projection() {
    local fixture="$REPO_ROOT/Testing/Graph/Pass/SlotRegistration.range"
    local output="$WORK_ROOT/graph-slot-registration.out"
    local error="$WORK_ROOT/graph-slot-registration.err"
    local member_slot_count parameter_slot_count contents_slot_count payload_slot_count slot_relationship_count occurrence_relationship_count

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Graph slot-registration fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph slot-registration fixture wrote stderr"

    member_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=members\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    parameter_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=parameters\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    contents_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=contents\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    payload_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=payloads\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    [[ "$member_slot_count" -eq 2 && "$parameter_slot_count" -eq 1 && "$contents_slot_count" -eq 1 && "$payload_slot_count" -eq 1 ]] \
        || fail "Graph slot-registration fixture did not register the expected named slot identities"

    slot_relationship_count="$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    occurrence_relationship_count="$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slotOccurrence\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    [[ "$slot_relationship_count" -eq 5 && "$occurrence_relationship_count" -eq 8 ]] \
        || fail "Graph slot-registration fixture did not retain its canonical owner-to-slot-to-occurrence edges"

    [[ "$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/grep -F $'separatorKind=0\tseparatorID=-1\tenclosureKind=2' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)" -eq 3 ]] \
        || fail "Graph slot-registration fixture did not retain brace-enclosed member and contents slots"
    [[ "$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/grep -F $'separatorKind=1\tseparatorID=' | /usr/bin/grep -F $'\tenclosureKind=1' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)" -eq 2 ]] \
        || fail "Graph slot-registration fixture did not retain comma-separated parenthesized slots"
    /usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=parameter\t' | /usr/bin/grep -F $'separatorKind=1\tseparatorID=' | /usr/bin/grep -F $'\tenclosureKind=1' > /dev/null \
        || fail "Graph slot-registration fixture did not derive the legacy parameter edge from its slot"
    /usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/grep -F $'originKind=syntax\toriginID=6\t' | /usr/bin/grep -F $'destinationKind=slot\tdestinationID=2\t' > /dev/null \
        && /usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slotOccurrence\t' | /usr/bin/grep -F $'originKind=slot\toriginID=2\t' | /usr/bin/grep -F $'destinationKind=syntax\tdestinationID=8\tordinal=0' > /dev/null \
        || fail "Graph slot-registration fixture did not retain its block contents slot and return occurrence"
    echo "Graph slot-registration: pass"
}

check_project_defaults() {
    check_project_defaults_fixture target-pointer-bits-builtin \
        Testing/ProjectDefaults/Pass/TargetPointerBitsBuiltin.range 0 \
        $'declaration\trow=0\tsyntaxID=0\tfileID=0\tkind=function'
    check_project_defaults_fixture target-integer \
        Testing/ProjectDefaults/Pass/TargetInteger.range 0 \
        $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=64\tintegerOverridden=false\tboolOverridden=true'
    check_project_defaults_fixture integer-width-override \
        Testing/ProjectDefaults/Pass/IntegerWidthOverride.range 0 \
        $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=4\tintegerOverridden=true\tboolOverridden=true'
    check_project_defaults_fixture full-signed-integer \
        Testing/ProjectDefaults/Pass/FullSignedInteger.range 0 \
        $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=64\tintegerOverridden=true\tboolOverridden=true'
    check_project_defaults_fixture duplicate-integer \
        Testing/ProjectDefaults/Fail/DuplicateInteger.range 65 \
        $'compilerError\tkind=invalidProjectDefaults\treason=duplicateInteger'
    check_project_defaults_fixture integer-must-be-state \
        Testing/ProjectDefaults/Fail/IntegerMustBeState.range 65 \
        $'compilerError\tkind=invalidProjectDefaults\treason=integerMustBeState'
    check_project_defaults_fixture invalid-integer-type \
        Testing/ProjectDefaults/Fail/InvalidIntegerType.range 65 \
        $'compilerError\tkind=invalidProjectDefaults\treason=invalidIntegerType'
    check_project_integer_lowering bare-integer-lowering \
        Testing/ProjectDefaults/Pass/BareIntegerLowering.range \
        'trunc i64 7 to i32'
    check_project_integer_lowering overridden-integer-lowering \
        Testing/ProjectDefaults/Pass/OverriddenIntegerLowering.range \
        'sext i4 7 to i32'
    check_target_pointer_bits_runtime
    check_range_native_project_macro
    check_canonical_member_family
    check_missing_nominal_graph_warning
    check_slot_graph_projection
    echo "checkpoint value-ownership:project-defaults-complete: pass"
}

check_storage_literals() {
    local core_bundle="$WORK_ROOT/storage-core-source-set.range"
    local core_output="$WORK_ROOT/storage-core-source-set.out"
    local core_error="$WORK_ROOT/storage-core-source-set.err"
    local llvm_output="$WORK_ROOT/storage-literal-invalid.ll"
    local unsigned_llvm="$WORK_ROOT/storage-signedness-first-unsigned-byte.ll"
    local signed_unary_llvm="$WORK_ROOT/storage-signed-unary-numeric-literal.ll"
    local reordered_signed_llvm="$WORK_ROOT/storage-reordered-signed-integer-arguments.ll"
    local unsigned_negation_llvm="$WORK_ROOT/storage-unsigned-negation.ll"
    local command_output="$WORK_ROOT/storage-literal-invalid.out"
    local command_error="$WORK_ROOT/storage-literal-invalid.err"
    local actual_status

    /usr/bin/printf '%s\n' 'compilerMacroSnapshot' > "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Storage.range' >> "$core_bundle"
    /usr/bin/printf '%s\n' 'macro storage(): Construct -> Void {}' >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Literal.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Literal.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Syntax/Program/RelationshipPrerequisites.range' \
        'construct Identifier {}' \
        '' \
        'enum DelimiterPair {' \
        '    case parentheses' \
        '    case braces' \
        '    case brackets' \
        '    case angles' \
        '}' >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Syntax/Program/Relationship.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Program/Relationship.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Many.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Many.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Number/Signedness.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Number/Signedness.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Number/Int.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Number/Int.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/TextEncoding.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/TextEncoding.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/Buffer.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/UnicodeScalar.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/UnicodeScalar.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/Character.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/Character.range" >> "$core_bundle"
    "$STAGE2_EXECUTABLE" compile "$core_bundle" > "$core_output" 2> "$core_error" \
        || { /bin/cat "$core_output" "$core_error" >&2; fail "Range-authored storage core sources did not compile"; }
    [[ ! -s "$core_error" ]] \
        || fail "Range-authored storage core sources wrote stderr"
    /usr/bin/awk -F '\t' '$1 == "literalStorage" && $2 == "valid=true" && $3 == "storageApplicationCount=1" && $4 == "literalApplicationCount=1" && $5 ~ /^numericTargetSyntaxID=[0-9]+$/ && $6 == "decimalTargetSyntaxID=-1" && $7 == "decimalSeparatorByte=-1" { found = 1 } END { exit(found ? 0 : 1) }' "$core_output" \
        || fail "Range-authored storage core sources omitted their numeric literal facts"
    echo "Range-authored storage core sources: pass"
    check_project_defaults_fixture annotated-value-parameters \
        Testing/Storage/Pass/AnnotatedValueParameters.range 0 \
        $'genericParameter\trow=0\townerSyntaxID=0\townerKind=construct\tordinal=0\tfileID=0\tstart=14\tend=36\tname=signedness\tnameStart=14\tnameEnd=24\tkind=value'
    check_project_defaults_fixture integer-descriptor \
        Testing/Storage/Pass/IntegerDescriptorSyntax.range 0 \
        $'literalStorage\tvalid=true\tstorageApplicationCount=1\tliteralApplicationCount=1\tnumericTargetSyntaxID=3\tdecimalTargetSyntaxID=-1\tdecimalSeparatorByte=-1'
    check_project_defaults_fixture decimal-descriptor \
        Testing/Storage/Pass/DecimalLiteralDescriptorSyntax.range 0 \
        $'literalStorage\tvalid=true\tstorageApplicationCount=1\tliteralApplicationCount=1\tnumericTargetSyntaxID=-1\tdecimalTargetSyntaxID=0\tdecimalSeparatorByte=46'
    check_project_defaults_fixture text-descriptor \
        Testing/Storage/Pass/TextLiteralDescriptorSyntax.range 0 \
        $'textLiteralStorage\tvalid=true\ttextTargetSyntaxID=7\tsemanticElementSyntaxID=5\tencoding=1\tcodeUnitBits=8\tcodeUnitSignedness=2'
    check_project_defaults_fixture literal-requires-storage \
        Testing/Storage/Fail/LiteralRequiresStorage.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=literalRequiresStorage'
    check_project_defaults_fixture invalid-numeric-shape \
        Testing/Storage/Fail/InvalidNumericStorageShape.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=invalidNumericStorageShape'
    check_project_defaults_fixture duplicate-numeric-literal \
        Testing/Storage/Fail/DuplicateNumericLiteral.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=duplicateNumericLiteral'
    check_project_defaults_fixture storage-must-be-empty \
        Testing/Storage/Fail/StorageMustBeEmpty.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=storageMustBeEmpty'
    check_project_defaults_fixture text-literal-requires-storage \
        Testing/Storage/Fail/TextLiteralRequiresStorage.range 65 \
        $'compilerError\tkind=invalidTextLiteralStorage\treason=textLiteralRequiresStorage'
    check_project_defaults_fixture text-invalid-physical-storage \
        Testing/Storage/Fail/TextStorageInvalidPhysicalStorage.range 65 \
        $'compilerError\tkind=invalidTextLiteralStorage\treason=invalidPhysicalStorage'
    if "$STAGE2_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Fail/LiteralRequiresStorage.range" \
        "$llvm_output" > "$command_output" 2> "$command_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Storage literal LLVM rejection exited $actual_status, expected 65"
    [[ ! -s "$command_error" ]] \
        || fail "Storage literal LLVM rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidLiteralStorage\treason=literalRequiresStorage' "$command_output" \
        || fail "Storage literal LLVM rejection omitted the literalRequiresStorage diagnostic"
    [[ ! -s "$llvm_output" ]] \
        || fail "Storage literal LLVM rejection emitted an LLVM artifact"
    echo "Storage literal LLVM rejection: pass"
    "$STAGE2_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Pass/SignednessFirstUnsignedByte.range" \
        "$unsigned_llvm" \
        || fail "Storage signedness-first unsigned byte did not emit LLVM"
    /usr/bin/grep -Fq 'icmp eq i8 255, 255' "$unsigned_llvm" \
        || fail "Storage signedness-first unsigned byte omitted i8 equality"
    validate_llvm "$unsigned_llvm"
    echo "Storage signedness-first unsigned byte: pass"
    "$STAGE2_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Pass/SignedUnaryNumericLiteral.range" \
        "$signed_unary_llvm" \
        || fail "Storage signed unary numeric literal did not emit LLVM"
    /usr/bin/grep -Fq 'icmp eq i8 -4, -4' "$signed_unary_llvm" \
        || fail "Storage signed unary numeric literal omitted its signed i8 value"
    validate_llvm "$signed_unary_llvm"
    echo "Storage signed unary numeric literal: pass"
    if "$STAGE2_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Fail/ReorderedSignedIntegerArguments.range" \
        "$reordered_signed_llvm" > "$command_output" 2> "$command_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Storage reordered signed integer arguments exited $actual_status, expected 65"
    [[ ! -s "$command_error" && ! -s "$reordered_signed_llvm" ]] \
        || fail "Storage reordered signed integer arguments emitted an unexpected artifact"
    echo "Storage ordered generic arguments: pass"
    if "$STAGE2_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Fail/UnsignedUnaryNegation.range" \
        "$unsigned_negation_llvm" > "$command_output" 2> "$command_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Storage unsigned unary negation exited $actual_status, expected 65"
    [[ ! -s "$command_error" ]] \
        || fail "Storage unsigned unary negation wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$command_output" \
        || fail "Storage unsigned unary negation omitted its rejection boundary"
    [[ ! -s "$unsigned_negation_llvm" ]] \
        || fail "Storage unsigned unary negation emitted an LLVM artifact"
    echo "Storage unsigned unary negation: pass"
    echo "checkpoint value-ownership:storage-literals-complete: pass"
}

check_defaulted_generic_optional() {
    local fixture relative llvm executable actual_status
    for relative in \
        Testing/Generics/Pass/DefaultedGenericEnum.range \
        Testing/Optionality/Pass/DefaultQuestionMark.range \
        Testing/Optionality/Pass/ValueBearingAbsence.range \
        Testing/Optionality/Pass/CustomAbsenceValue.range; do
        fixture="$REPO_ROOT/$relative"
        llvm="$WORK_ROOT/$(basename "$fixture" .range).ll"
        executable="$WORK_ROOT/$(basename "$fixture" .range)"
        [[ -f "$fixture" ]] || fail "missing generic Optional fixture: $relative"
        "$STAGE2_EXECUTABLE" emit-llvm "$fixture" "$llvm" \
            || fail "generic Optional fixture did not emit LLVM: $relative"
        /usr/bin/grep -Fq 'alloca { i32,' "$llvm" \
            || fail "generic Optional fixture omitted its specialized enum layout: $relative"
        validate_llvm "$llvm"
        link_llvm "$llvm" "$executable"
        if "$executable"; then actual_status=0; else actual_status=$?; fi
        [[ "$actual_status" -eq 7 ]] \
            || fail "generic Optional fixture exited $actual_status, expected 7: $relative"
        echo "Generic Optional $(basename "$fixture" .range): pass"
    done

    fixture="$REPO_ROOT/Testing/Generics/Fail/MissingRequiredGenericEnumArgument.range"
    local rejection="$WORK_ROOT/MissingRequiredGenericEnumArgument.out"
    local rejection_error="$WORK_ROOT/MissingRequiredGenericEnumArgument.err"
    if "$STAGE2_EXECUTABLE" "$fixture" > "$rejection" 2> "$rejection_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 && ! -s "$rejection_error" ]] \
        || fail "missing required generic argument rejected at the wrong boundary"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$rejection" \
        || fail "missing required generic argument omitted its exact rejection"
    echo "Generic Optional missing-required-argument: pass"
    echo "checkpoint value-ownership:generic-optional-complete: pass"
}

check_boundary_forward_mixed() {
    local bundle="$WORK_ROOT/boundary-forward-mixed.range"
    local first="$WORK_ROOT/boundary-forward-mixed.first.ll"
    local second="$WORK_ROOT/boundary-forward-mixed.repeat.ll"
    local first_error="$WORK_ROOT/boundary-forward-mixed.first.err"
    local second_error="$WORK_ROOT/boundary-forward-mixed.repeat.err"
    local linked="$WORK_ROOT/ValueOwnershipBoundaryForwardMixed"
    local run_output="$WORK_ROOT/boundary-forward-mixed.run.out"
    local run_error="$WORK_ROOT/boundary-forward-mixed.run.err"
    local actual_create_count actual_destroy_count forbidden

    write_value_ownership_bundle "$bundle" boundary-forward-mixed
    echo "checkpoint value-ownership:fixture-authored: pass"
    run_capture "$STAGE2_EXECUTABLE" "$bundle" "$first" "$first_error"
    require_successful_output "focused value ownership boundary-forward-mixed" "$first" "$first_error"
    echo "checkpoint value-ownership:first-emitted: pass"
    run_capture "$STAGE2_EXECUTABLE" "$bundle" "$second" "$second_error"
    require_successful_output "focused repeated value ownership boundary-forward-mixed" "$second" "$second_error"
    echo "checkpoint value-ownership:repeat-emitted: pass"
    /usr/bin/cmp -s "$first" "$second" \
        || fail "focused value ownership boundary-forward-mixed LLVM was not deterministic"
    echo "checkpoint value-ownership:deterministic: pass"

    /usr/bin/grep -Fq 'define void @makeRootBoundaryForwardMixedResult(ptr %returnDestination' "$first" \
        || fail "focused value ownership omitted the mixed-result definition"
    /usr/bin/grep -Fq 'call void @makeRootBoundaryForwardMixedResult(' "$first" \
        || fail "focused value ownership omitted the mixed-result call"
    /usr/bin/grep -Fq '%Range.RootBoundaryForwardMixedResult = type { ptr, ptr, ptr }' "$first" \
        || fail "focused value ownership omitted the forward/alias/local layout"
    actual_create_count="$(/usr/bin/grep -F -c 'call ptr @rawBufferCreate(' "$first" || true)"
    actual_destroy_count="$(/usr/bin/grep -F -c 'call i32 @rawBufferDestroy(ptr' "$first" || true)"
    [[ "$actual_create_count" -eq 3 ]] || fail "focused value ownership emitted $actual_create_count creates; expected 3"
    [[ "$actual_destroy_count" -eq 3 ]] || fail "focused value ownership emitted $actual_destroy_count destructions; expected 3"
    for forbidden in rangeConstruct malloc calloc realloc free; do
        ! /usr/bin/grep -Fq "$forbidden" "$first" \
            || fail "focused value ownership emitted forbidden dynamic/allocator symbol: $forbidden"
    done
    echo "checkpoint value-ownership:shape-audited: pass"

    validate_llvm "$first"
    echo "checkpoint value-ownership:llvm-validated: pass"
    link_llvm "$first" "$linked"
    echo "checkpoint value-ownership:linked: pass"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "focused value ownership executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "focused value ownership executable wrote output"
    echo "checkpoint value-ownership:executed-exit-7: pass"
    echo "checkpoint value-ownership:complete: pass"
    echo "Focused value ownership boundary-forward-mixed check succeeded."
    printf 'stage2_cache_key=%s\n' "$STAGE2_CACHE_KEY"
}

main_value_ownership() {
    local compiler_input="$DEFAULT_COMPILER_DIR"
    local compiler_directory canonical_core_source_path
    local controls=0

    if [[ "$#" -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
        usage
        return 0
    elif [[ "$#" -eq 1 && "$1" == "--controls" ]]; then
        controls=1
    elif [[ "$#" -eq 2 && "$1" == "--controls" ]]; then
        controls=1
        compiler_input="$2"
    elif [[ "$#" -eq 1 ]]; then
        compiler_input="$1"
    elif [[ "$#" -ne 0 ]]; then
        usage >&2
        return 64
    fi
    if [[ -d "$compiler_input" && "$(cd "$compiler_input" && pwd)" == "$REPO_ROOT" ]]; then
        compiler_input="$DEFAULT_COMPILER_DIR"
    fi
    [[ -d "$compiler_input" ]] || fail "missing compiler directory: $compiler_input"
    compiler_directory="$(cd "$compiler_input" && pwd)"

    verify_manifest
    echo "checkpoint value-ownership:manifest: pass"
    WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-value-ownership.XXXXXX")"
    if [[ "${RANGE_KEEP_VALUE_OWNERSHIP_WORK_ROOT:-0}" == "1" ]]; then
        echo "value-ownership work root: $WORK_ROOT"
    else
        trap '/bin/rm -rf "$WORK_ROOT"' EXIT
    fi

    canonical_core_source_path="$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
    [[ -f "$canonical_core_source_path" ]] || fail "missing canonical Core proof input: $canonical_core_source_path"
    CORE_SOURCE_MARKER_PATH="${canonical_core_source_path#"$REPO_ROOT/"}"
    CORE_SOURCE_PATH="$WORK_ROOT/RawBuffer.range"
    /bin/cp "$canonical_core_source_path" "$CORE_SOURCE_PATH"
    RUNTIME_INPUTS=()
    while IFS= read -r runtime; do
        RUNTIME_INPUTS+=("$runtime")
    done < <(runtime_inputs)

    discover_sources "$compiler_directory" "$WORK_ROOT"
    SOURCE_BUNDLE="$WORK_ROOT/RangeCompilerSourceSet.range"
    write_source_bundle "$SOURCE_BUNDLE"
    echo "checkpoint value-ownership:source-snapshot: pass"
    resolve_stage2_compiler 0
    echo "checkpoint value-ownership:stage2-cache-$STAGE2_CACHE_STATUS: pass"
    echo "checkpoint value-ownership:stage2-resolved: pass"
    check_removed_for_statement_rejected
    check_unregistered_string_reads_rejected
    check_macro_environment
    check_error_capability_registration
    check_non_generic_stored_assignment
    check_block_value_shape_identity
    check_block_source_layout
    check_postfix_zero_or_one_occurrence
    check_legacy_macro_modifiers_rejected
    check_legacy_environment_expand_rejected
    check_macro_result_values
    check_macro_generic_boundary_materialization
    check_macro_parenthesized_boundary_rejection
    check_canonical_target_members
    check_value_relationship_selection
    check_value_relationship_registration
    check_canonical_declaration_envelopes
    check_hashable_function_synthesis
    check_compiler_registration
    check_many_relationship_registration
    check_enum_parameter_materialization
    check_block_relationship_reification
    check_duplicate_block_form_rejected
    check_collection_closure_execution
    check_inline_mapped_syntax
    check_stored_member_defaults
    check_coding_core_surface
    check_codable_construct_collection
    check_inline_core_codable
    check_codable_composite_atomic_rollback
    check_typed_parameter_defaults
    check_graph_capabilities
    check_command_group
    check_macro_body_capture
    check_syntax_recipes
    check_legacy_bracket_collection_type_rejected
    check_range_authored_syntax_template
    check_project_defaults
    check_storage_literals
    check_defaulted_generic_optional
    if [[ "$controls" -eq 1 ]]; then
        audit_value_ownership Controls "$STAGE2_EXECUTABLE" "$WORK_ROOT/controls"
        echo "checkpoint value-ownership:controls-complete: pass"
    else
        check_boundary_forward_mixed
    fi
    range_stage2_mark_development_producer_validated \
        || fail "could not publish the validated development compiler producer"
    echo "checkpoint value-ownership:development-producer-validated: pass"
}

main_value_ownership "$@"
