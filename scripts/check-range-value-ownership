    /usr/bin/grep -Fq $'macroFamilyMemory\tvalid=true\tfamilyCount=1\tmemberCount=4\trepresentationCount=1\tpartitionCount=1\tvalueCount=4' "$output" \
        || fail "Canonical @member family did not retain all direct representations"
    echo "Members canonical-family: pass"
}

check_canonical_declaration_envelopes() {
    local bundle="$WORK_ROOT/declaration-envelope-models.range"
    local output="$WORK_ROOT/declaration-envelope-models.out"
    local error="$WORK_ROOT/declaration-envelope-models.err"
    local relative expectation path name
    local -a model_sources=(
        RangeCompiler/Sources/Core/Macro/Graph.range
        RangeCompiler/Sources/Core/Macro/Syntax.range
        RangeCompiler/Sources/Core/Macro/Macro.range
        RangeCompiler/Sources/Core/Syntax/Program/Relationship.range
        RangeCompiler/Sources/Core/Syntax/Bodies/DelimiterPair.range
        RangeCompiler/Sources/Core/Macro/Hashable.range
        RangeCompiler/Sources/Core/Macro/Many.range
        RangeCompiler/Sources/Core/System/Memory/Buffer.range
        RangeCompiler/Sources/Core/Coding/UUID.range
        RangeCompiler/Sources/Core/Syntax/Identity.range
        RangeCompiler/Sources/Core/Syntax/Parsing/SyntaxForm.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Construct.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Function.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Enum.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Extension.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Type/Parameter.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/Let.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/State.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/Binding.range
        RangeCompiler/Sources/Core/Syntax/Declarations/Property/Derived.range
    )
    local -a expectations=(
        'Macro.range|macros'
        'Macro.range|identity'
        'Macro.range|target'
        'Identity.range|name'
        'Identity.range|id'
        'Identity.range|parent'
        'Identity.range|source'
        'SyntaxForm.range|introducer'
        'SyntaxForm.range|identity'
        'SyntaxForm.range|role'
        'SyntaxForm.range|enclosure'
        'SyntaxForm.range|child'
        'SyntaxForm.range|parts'
        'Construct.range|macros'
        'Construct.range|identity'
        'Function.range|macros'
        'Function.range|identity'
        'Function.range|parameters'
        'Function.range|returnType'
        'Function.range|body'
        'Enum.range|macros'
        'Enum.range|identity'
        'Extension.range|macros'
        'Extension.range|identity'
        'Parameter.range|macros'
        'Parameter.range|identity'
        'Let.range|macros'
        'Let.range|identity'
        'Let.range|value'
        'State.range|macros'
        'State.range|identity'
        'State.range|value'
        'Binding.range|macros'
        'Binding.range|identity'
        'Binding.range|type'
        'Binding.range|getterBody'
        'Binding.range|setterBody'
        'Derived.range|macros'
        'Derived.range|identity'
        'Derived.range|type'
        'Derived.range|body'
    )

    /usr/bin/printf '%s\n' 'compilerPlotter' > "$bundle"
    for relative in "${model_sources[@]}"; do
        /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "$relative" >> "$bundle"
        /bin/cat "$REPO_ROOT/$relative" >> "$bundle"
        /usr/bin/printf '\n' >> "$bundle"
    done
    "$BUILD_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
        || fail "Canonical declaration-envelope models did not compile: $(/usr/bin/head -n 1 "$output")"
    [[ ! -s "$error" ]] || fail "Canonical declaration-envelope models wrote stderr"
    for expectation in "${expectations[@]}"; do
        path="${expectation%%|*}"
        name="${expectation#*|}"
        /usr/bin/grep -F $'graphNominal\t' "$output" \
            | /usr/bin/grep -F "keyword=let"$'\t'"name=$name" \
            | /usr/bin/grep -F "path=RangeCompiler/Sources/Core/" \
            | /usr/bin/grep -F "/$path" > /dev/null \
            || fail "Canonical declaration envelope omitted $path let $name"
    done
    if /usr/bin/grep -F $'graphNominal\t' "$output" \
        | /usr/bin/grep -F $'keyword=let\tname=identifier\t' \
        | /usr/bin/grep -F 'path=RangeCompiler/Sources/Core/' > /dev/null; then
        fail "Canonical declaration envelopes retained a parallel identifier field"
    fi
    /usr/bin/grep -F $'graphNominal\t' "$output" \
        | /usr/bin/grep -F $'keyword=let\tname=parent\t' \
        | /usr/bin/grep -F 'path=RangeCompiler/Sources/Core/Syntax/Identity.range' \
        > /dev/null \
        || fail "Canonical Identity omitted its direct parent relationship"
    if /usr/bin/grep -Fq 'GraphIdentity' "$bundle" || /usr/bin/grep -Fq 'RangeGraphIdentity' "$bundle"; then
        fail "Canonical declaration envelopes retained a parallel identity type"
    fi
    echo "Members declaration-envelopes: pass"
}

check_missing_nominal_graph_warning() {
    local fixture="$REPO_ROOT/Testing/Graph/Pass/MissingNominalWarning.range"
    local declarations_fixture="$REPO_ROOT/Testing/Graph/Pass/NominalDeclarationKinds.range"
    local local_declarations_fixture="$REPO_ROOT/Testing/Graph/Pass/LocalNominalDeclarations.range"
    local lowercase_fixture="$REPO_ROOT/Testing/Graph/Pass/LowercaseSignatureMissingNominal.range"
    local macro_fixture="$REPO_ROOT/Testing/Graph/Pass/MacroNominalWarning.range"
    local macro_mismatch_fixture="$REPO_ROOT/Testing/Graph/Pass/MacroNominalTargetMismatch.range"
    local ambiguous_fixture="$REPO_ROOT/Testing/Graph/Pass/AmbiguousNominalWarning.range"
    local output="$WORK_ROOT/graph-missing-nominal.out"
    local declarations_output="$WORK_ROOT/graph-nominal-declarations.out"
    local local_declarations_output="$WORK_ROOT/graph-local-nominal-declarations.out"
    local lowercase_output="$WORK_ROOT/graph-lowercase-missing-nominal.out"
    local macro_output="$WORK_ROOT/graph-macro-nominal.out"
    local macro_mismatch_output="$WORK_ROOT/graph-macro-nominal-target-mismatch.out"
    local ambiguous_output="$WORK_ROOT/graph-ambiguous-nominal.out"
    local strict_fixture="$WORK_ROOT/graph-missing-nominal-strict.range"
    local strict_output="$WORK_ROOT/graph-missing-nominal-strict.out"
    local error="$WORK_ROOT/graph-missing-nominal.err"
    local warning_count missing_record_count strict_status

    "$BUILD_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Graph missing-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph missing-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'graphDelta\tvalid=true\tnodeCount=5\tfactCount=2\tgeneratedFunctionCount=0\tnominalCount=5\tnominalReferenceCount=4\twarningCount=1' "$output" \
        || fail "Graph artifact omitted its complete nominal declaration, reference, and warning counts"
    /usr/bin/grep -Fq $'graphNominal\tid=0\tkeyword=construct\tname=Box' "$output" \
        || fail "Graph artifact omitted the construct Box nominal declaration"
    /usr/bin/grep -F $'graphNominal\t' "$output" | /usr/bin/grep -F $'keyword=state\tname=missing' > /dev/null \
        || fail "Graph artifact omitted the state missing nominal declaration"
    /usr/bin/grep -Fq $'role=memberType\texpectedKinds=construct,enum\tname=Known\ttargetKind=declaration' "$output" \
        || fail "Graph artifact omitted the declared nested nominal"
    /usr/bin/grep -Fq $'role=memberType\texpectedKinds=construct,enum\tname=Missing\ttargetKind=missing\ttargetID=-1\ttargetNominalID=-1\tdeclared=false' "$output" \
        || fail "Graph artifact omitted the unresolved nominal reference"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=missingNominal' "$output" \
        || fail "Graph artifact omitted the missing-nominal warning"
    /usr/bin/grep -Fq $'expectedKinds=construct,enum\tname=Missing\tfileID=0\tpath=Project/MissingNominalWarning.range\tstart=119\tend=126' "$output" \
        || fail "Graph artifact missing-nominal warning omitted its exact source path or span"
    warning_count="$(/usr/bin/grep -F -c $'graphWarning\tseverity=warning\tkind=missingNominal' "$output" || true)"
    missing_record_count="$(/usr/bin/grep -F -c $'role=memberType\texpectedKinds=construct,enum\tname=Missing\ttargetKind=missing\ttargetID=-1\ttargetNominalID=-1\tdeclared=false' "$output" || true)"
    [[ "$warning_count" -eq 1 && "$missing_record_count" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one missing-nominal reference and warning"
    /usr/bin/grep -v '^compilerPlotter$' "$fixture" > "$strict_fixture"
    set +e
    "$BUILD_EXECUTABLE" compile "$strict_fixture" > "$strict_output" 2> "$error"
    strict_status=$?
    set -e
    [[ "$strict_status" -eq 65 ]] || fail "Ordinary compilation did not reject the unresolved nominal"
    [[ ! -s "$error" ]] || fail "Ordinary unresolved-nominal rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedDeclarations\tphase=enumPayloadLink\treason=invalidEnumPayloadType\trole=project\tpath=Project/MissingNominalWarning.range' "$strict_output" \
        || fail "Ordinary compilation did not preserve the strict unresolved-nominal diagnostic"
    ! /usr/bin/grep -Fq 'define ' "$strict_output" \
        || fail "Ordinary unresolved-nominal compilation emitted LLVM"

    "$BUILD_EXECUTABLE" compile "$declarations_fixture" > "$declarations_output" 2> "$error" \
        || fail "Graph nominal-declaration fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph nominal-declaration fixture wrote stderr"
    /usr/bin/grep -Fq $'graphDelta\tvalid=true\tnodeCount=17\tfactCount=15\tgeneratedFunctionCount=0\tnominalCount=9\tnominalReferenceCount=6\twarningCount=0' "$declarations_output" \
        || fail "Graph artifact did not retain every keyword-plus-name declaration"
    /usr/bin/grep -F $'graphRelationship\t' "$declarations_output" | /usr/bin/grep -F $'role=member' | /usr/bin/grep -F $'minimum=0\tmaximumKind=unbounded\tmaximum=-1\tordering=ordered' > /dev/null \
        || fail "Graph artifact did not retain the ordered many member relationship"
    /usr/bin/grep -F $'graphRelationship\t' "$declarations_output" | /usr/bin/grep -F $'role=parameter' | /usr/bin/grep -F $'originKind=syntax' | /usr/bin/grep -F $'destinationKind=syntax' | /usr/bin/grep -F $'minimum=0\tmaximumKind=unbounded\tmaximum=-1\tordering=ordered\tseparatorKind=1\tseparatorID=' | /usr/bin/grep -F $'\tenclosureKind=1' > /dev/null \
        || fail "Graph artifact did not retain the comma-separated parenthesized parameter relationship"
    for declaration in \
        $'keyword=macro\tname=observed' \
        $'keyword=construct\tname=Model' \
        $'keyword=enum\tname=Flag' \
        $'keyword=case\tname=on' \
        $'keyword=function\tname=transform' \
        $'keyword=let\tname=fixed' \
        $'keyword=state\tname=changing' \
        $'keyword=binding\tname=shared' \
        $'keyword=derived\tname=computed'; do
        /usr/bin/grep -F $'graphNominal\t' "$declarations_output" | /usr/bin/grep -F "$declaration" > /dev/null \
            || fail "Graph artifact omitted nominal declaration $declaration"
    done

    "$BUILD_EXECUTABLE" compile "$local_declarations_fixture" > "$local_declarations_output" 2> "$error" \
        || fail "Graph local nominal-declaration fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph local nominal-declaration fixture wrote stderr"
    /usr/bin/grep -F $'graphNominal\t' "$local_declarations_output" | /usr/bin/grep -F $'keyword=let\tname=copy' > /dev/null \
        || fail "Graph artifact omitted the local let copy nominal declaration"
    /usr/bin/grep -F $'graphNominal\t' "$local_declarations_output" | /usr/bin/grep -F $'keyword=state\tname=total' > /dev/null \
        || fail "Graph artifact omitted the local state total nominal declaration"
    [[ "$(/usr/bin/grep -F -c $'keyword=let\tname=copy' "$local_declarations_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one local let nominal declaration"
    [[ "$(/usr/bin/grep -F -c $'keyword=state\tname=total' "$local_declarations_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one local state nominal declaration"
    /usr/bin/grep -Fq $'warningCount=0' "$local_declarations_output" \
        || fail "Graph local nominal-declaration fixture emitted an unexpected warning"

    "$BUILD_EXECUTABLE" compile "$lowercase_fixture" > "$lowercase_output" 2> "$error" \
        || fail "Graph lowercase missing-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph lowercase missing-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'role=parameterType\texpectedKinds=construct,enum\tname=missingType\ttargetKind=missing\ttargetID=-1\ttargetNominalID=-1\tdeclared=false' "$lowercase_output" \
        || fail "Graph artifact gave identifier casing semantic meaning"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=missingNominal' "$lowercase_output" \
        || fail "Graph artifact omitted the lowercase missing-nominal warning"
    [[ "$(/usr/bin/grep -F -c $'graphWarning\tseverity=warning\tkind=missingNominal' "$lowercase_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one lowercase missing-nominal warning"

    "$BUILD_EXECUTABLE" compile "$macro_fixture" > "$macro_output" 2> "$error" \
        || fail "Graph macro-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph macro-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'graphDelta\tvalid=true\tnodeCount=1\tfactCount=0\tgeneratedFunctionCount=0\tnominalCount=2\tnominalReferenceCount=2\twarningCount=1' "$macro_output" \
        || fail "Graph artifact did not retain macro declarations and applications"
    /usr/bin/grep -Fq $'identityCount=5\trelationshipCount=5' "$macro_output" \
        || fail "Graph artifact did not project macro declarations and applications as identities"
    /usr/bin/grep -Fq $'graphIdentity\tid=1\tkind=macroDeclaration\tidentityID=0\tsyntaxKind=macro\tname=observed' "$macro_output" \
        || fail "Graph artifact did not plot the macro declaration identity"
    /usr/bin/grep -Fq $'graphIdentity\tid=2\tkind=macroApplication\tidentityID=0\tsyntaxKind=construct\tname=observed' "$macro_output" \
        || fail "Graph artifact did not plot the resolved macro application identity"
    /usr/bin/grep -Fq $'graphIdentity\tid=3\tkind=macroApplication\tidentityID=1\tsyntaxKind=construct\tname=missing' "$macro_output" \
        || fail "Graph artifact did not plot the unresolved macro application identity"
    /usr/bin/grep -Fq $'graphRelationship\tid=0\trole=appliesTo\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=0\tdestinationKind=syntax\tdestinationID=0\tordinal=0\tminimum=1\tmaximumKind=finite\tmaximum=1\tordering=unordered' "$macro_output" \
        || fail "Graph artifact did not project the macro appliesTo relationship"
    /usr/bin/grep -Fq $'graphRelationship\tid=1\trole=references\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=1\tdestinationKind=macroDeclaration\tdestinationID=0' "$macro_output" \
        || fail "Graph artifact did not project the macro references relationship"
    /usr/bin/grep -Fq $'graphRelationship\tid=2\trole=resolvedBy\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=1\tdestinationKind=macroDeclaration\tdestinationID=0' "$macro_output" \
        || fail "Graph artifact did not project the macro resolvedBy relationship"
    /usr/bin/grep -Fq $'graphRelationship\tid=3\trole=appliesTo\toriginNodeID=3\toriginKind=macroApplication\toriginID=1\tdestinationNodeID=0\tdestinationKind=syntax\tdestinationID=0\tordinal=1' "$macro_output" \
        || fail "Graph artifact did not retain the unresolved application's target relationship"
    /usr/bin/grep -Fq $'role=macroApplication\texpectedKinds=macro\tname=observed\ttargetKind=declaration' "$macro_output" \
        || fail "Graph artifact did not link the declared macro application"
    /usr/bin/grep -Fq $'sourceKind=macroApplication\tsourceReferenceID=0\tparentSourceReferenceID=-1' "$macro_output" \
        || fail "Graph artifact did not retain the macro application as its reference source"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=missingNominal' "$macro_output" \
        || fail "Graph artifact did not warn about the undeclared macro application"
    /usr/bin/grep -Fq $'expectedKinds=macro\tname=missing\tfileID=0\tpath=Project/MacroNominalWarning.range\tstart=52\tend=59' "$macro_output" \
        || fail "Graph macro warning omitted its keyword, name, source path, or span"
    [[ "$(/usr/bin/grep -F -c $'graphWarning\tseverity=warning\tkind=missingNominal' "$macro_output" || true)" -eq 1 ]] \
        || fail "Graph artifact did not emit exactly one missing macro warning"

    "$BUILD_EXECUTABLE" compile "$macro_mismatch_fixture" > "$macro_mismatch_output" 2> "$error" \
        || fail "Graph macro target-mismatch fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph macro target-mismatch fixture wrote stderr"
    /usr/bin/grep -Fq $'role=macroApplication\texpectedKinds=macro\tname=observed\ttargetKind=targetMismatch\ttargetID=1\ttargetNominalID=1\tdeclared=true\tapplicable=false' "$macro_mismatch_output" \
        || fail "Graph artifact did not preserve target-aware macro resolution"
    /usr/bin/grep -Fq $'identityCount=4\trelationshipCount=3' "$macro_mismatch_output" \
        || fail "Graph artifact did not retain the mismatch application and candidate identities"
    /usr/bin/grep -Fq $'role=references\toriginNodeID=2\toriginKind=macroApplication\toriginID=0\tdestinationNodeID=1\tdestinationKind=macroDeclaration\tdestinationID=0' "$macro_mismatch_output" \
        || fail "Graph artifact did not retain the mismatch candidate relationship"
    ! /usr/bin/grep -Fq $'role=resolvedBy\toriginNodeID=2\toriginKind=macroApplication\toriginID=0' "$macro_mismatch_output" \
        || fail "Graph artifact resolved a target-mismatched macro application"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=nominalTargetMismatch' "$macro_mismatch_output" \
        || fail "Graph artifact mislabeled a macro target mismatch as a missing declaration"

    "$BUILD_EXECUTABLE" compile "$ambiguous_fixture" > "$ambiguous_output" 2> "$error" \
        || fail "Graph ambiguous-nominal fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph ambiguous-nominal fixture wrote stderr"
    /usr/bin/grep -Fq $'role=macroApplication\texpectedKinds=macro\tname=repeated\ttargetKind=ambiguous\ttargetID=-1\ttargetNominalID=-1\tdeclared=true\tapplicable=false' "$ambiguous_output" \
        || fail "Graph artifact did not separate an ambiguous declaration from applicability"
    /usr/bin/grep -Fq $'identityCount=5\trelationshipCount=4' "$ambiguous_output" \
        || fail "Graph artifact did not retain every ambiguous declaration candidate"
    [[ "$(/usr/bin/grep -F -c $'role=references\toriginNodeID=3\toriginKind=macroApplication\toriginID=0' "$ambiguous_output" || true)" -eq 2 ]] \
        || fail "Graph artifact did not retain both ambiguous declaration candidates"
    ! /usr/bin/grep -Fq $'role=resolvedBy\toriginNodeID=3\toriginKind=macroApplication\toriginID=0' "$ambiguous_output" \
        || fail "Graph artifact resolved an ambiguous macro application"
    /usr/bin/grep -Fq $'graphWarning\tseverity=warning\tkind=ambiguousNominal' "$ambiguous_output" \
        || fail "Graph artifact omitted the ambiguous-nominal warning"
    echo "Graph missing-nominal-warning: pass"
}

check_slot_graph_projection() {
    local fixture="$REPO_ROOT/Testing/Graph/Pass/SlotRegistration.range"
    local output="$WORK_ROOT/graph-slot-registration.out"
    local error="$WORK_ROOT/graph-slot-registration.err"
    local member_slot_count parameter_slot_count contents_slot_count payload_slot_count slot_relationship_count occurrence_relationship_count

    "$BUILD_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Graph slot-registration fixture did not compile"
    [[ ! -s "$error" ]] || fail "Graph slot-registration fixture wrote stderr"

    member_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=members\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    parameter_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=parameters\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    contents_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=contents\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    payload_slot_count="$(/usr/bin/grep -F $'graphIdentity\t' "$output" | /usr/bin/grep -F $'kind=slot\t' | /usr/bin/grep -F $'name=payloads\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    [[ "$member_slot_count" -eq 2 && "$parameter_slot_count" -eq 1 && "$contents_slot_count" -eq 1 && "$payload_slot_count" -eq 1 ]] \
        || fail "Graph slot-registration fixture did not register the expected named slot identities"

    slot_relationship_count="$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    occurrence_relationship_count="$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slotOccurrence\t' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)"
    [[ "$slot_relationship_count" -eq 5 && "$occurrence_relationship_count" -eq 8 ]] \
        || fail "Graph slot-registration fixture did not retain its canonical owner-to-slot-to-occurrence edges"

    [[ "$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/grep -F $'separatorKind=0\tseparatorID=-1\tenclosureKind=2' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)" -eq 3 ]] \
        || fail "Graph slot-registration fixture did not retain brace-enclosed member and contents slots"
    [[ "$(/usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/grep -F $'separatorKind=1\tseparatorID=' | /usr/bin/grep -F $'\tenclosureKind=1' | /usr/bin/wc -l | /usr/bin/tr -d ' ' || true)" -eq 2 ]] \
        || fail "Graph slot-registration fixture did not retain comma-separated parenthesized slots"
    /usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=parameter\t' | /usr/bin/grep -F $'separatorKind=1\tseparatorID=' | /usr/bin/grep -F $'\tenclosureKind=1' > /dev/null \
        || fail "Graph slot-registration fixture did not derive the legacy parameter edge from its slot"
    /usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slot\t' | /usr/bin/grep -F $'originKind=syntax\toriginID=6\t' | /usr/bin/grep -F $'destinationKind=slot\tdestinationID=2\t' > /dev/null \
        && /usr/bin/grep -F $'graphRelationship\t' "$output" | /usr/bin/grep -F $'role=slotOccurrence\t' | /usr/bin/grep -F $'originKind=slot\toriginID=2\t' | /usr/bin/grep -F $'destinationKind=syntax\tdestinationID=8\tordinal=0' > /dev/null \
        || fail "Graph slot-registration fixture did not retain its block contents slot and return occurrence"
    echo "Graph slot-registration: pass"
}

check_project_defaults() {
    check_project_defaults_fixture target-pointer-bits-builtin \
        Testing/ProjectDefaults/Pass/TargetPointerBitsBuiltin.range 0 \
        $'declaration\trow=0\tsyntaxID=0\tfileID=0\tkind=function'
    check_project_defaults_fixture target-integer \
        Testing/ProjectDefaults/Pass/TargetInteger.range 0 \
        $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=64\tintegerOverridden=false\tboolOverridden=true'
    check_project_defaults_fixture integer-width-override \
        Testing/ProjectDefaults/Pass/IntegerWidthOverride.range 0 \
        $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=4\tintegerOverridden=true\tboolOverridden=true'
    check_project_defaults_fixture full-signed-integer \
        Testing/ProjectDefaults/Pass/FullSignedInteger.range 0 \
        $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=64\tintegerOverridden=true\tboolOverridden=true'
    check_project_defaults_fixture duplicate-integer \
        Testing/ProjectDefaults/Fail/DuplicateInteger.range 65 \
        $'compilerError\tkind=invalidProjectDefaults\treason=duplicateInteger'
    check_project_defaults_fixture integer-must-be-state \
        Testing/ProjectDefaults/Fail/IntegerMustBeState.range 65 \
        $'compilerError\tkind=invalidProjectDefaults\treason=integerMustBeState'
    check_project_defaults_fixture invalid-integer-type \
        Testing/ProjectDefaults/Fail/InvalidIntegerType.range 65 \
        $'compilerError\tkind=invalidProjectDefaults\treason=invalidIntegerType'
    check_project_integer_lowering bare-integer-lowering \
        Testing/ProjectDefaults/Pass/BareIntegerLowering.range \
        'trunc i64 7 to i32'
    check_project_integer_lowering overridden-integer-lowering \
        Testing/ProjectDefaults/Pass/OverriddenIntegerLowering.range \
        'sext i4 7 to i32'
    check_target_pointer_bits_runtime
    check_range_native_project_macro
    check_canonical_member_family
    check_missing_nominal_graph_warning
    check_slot_graph_projection
    echo "checkpoint value-ownership:project-defaults-complete: pass"
}

check_storage_literals() {
    local core_bundle="$WORK_ROOT/storage-core-source-set.range"
    local core_output="$WORK_ROOT/storage-core-source-set.out"
    local core_error="$WORK_ROOT/storage-core-source-set.err"
    local llvm_output="$WORK_ROOT/storage-literal-invalid.ll"
    local unsigned_llvm="$WORK_ROOT/storage-signedness-first-unsigned-byte.ll"
    local signed_unary_llvm="$WORK_ROOT/storage-signed-unary-numeric-literal.ll"
    local reordered_signed_llvm="$WORK_ROOT/storage-reordered-signed-integer-arguments.ll"
    local unsigned_negation_llvm="$WORK_ROOT/storage-unsigned-negation.ll"
    local command_output="$WORK_ROOT/storage-literal-invalid.out"
    local command_error="$WORK_ROOT/storage-literal-invalid.err"
    local actual_status

    /usr/bin/printf '%s\n' 'compilerMacroSnapshot' > "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Storage.range' >> "$core_bundle"
    /usr/bin/printf '%s\n' 'macro storage(): Construct -> Void {}' >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Literal.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Literal.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Syntax/Program/RelationshipPrerequisites.range' \
        'construct Identity {}' \
        '' \
        'enum DelimiterPair {' \
        '    case parentheses' \
        '    case braces' \
        '    case brackets' \
        '    case angles' \
        '}' >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Syntax/Program/Relationship.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Program/Relationship.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/Macro/Many.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Many.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Number/Signedness.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Number/Signedness.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Number/Int.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Number/Int.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/TextEncoding.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/TextEncoding.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/Buffer.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/UnicodeScalar.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/UnicodeScalar.range" >> "$core_bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Text/Character.range' >> "$core_bundle"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Text/Character.range" >> "$core_bundle"
    "$BUILD_EXECUTABLE" compile "$core_bundle" > "$core_output" 2> "$core_error" \
        || { /bin/cat "$core_output" "$core_error" >&2; fail "Range-authored storage core sources did not compile"; }
    [[ ! -s "$core_error" ]] \
        || fail "Range-authored storage core sources wrote stderr"
    /usr/bin/awk -F '\t' '$1 == "literalStorage" && $2 == "valid=true" && $3 == "storageApplicationCount=1" && $4 == "literalApplicationCount=1" && $5 ~ /^numericTargetSyntaxID=[0-9]+$/ && $6 == "decimalTargetSyntaxID=-1" && $7 == "decimalSeparatorByte=-1" { found = 1 } END { exit(found ? 0 : 1) }' "$core_output" \
        || fail "Range-authored storage core sources omitted their numeric literal facts"
    echo "Range-authored storage core sources: pass"
    check_project_defaults_fixture annotated-value-parameters \
        Testing/Storage/Pass/AnnotatedValueParameters.range 0 \
        $'genericParameter\trow=0\townerSyntaxID=0\townerKind=construct\tordinal=0\tfileID=0\tstart=14\tend=36\tname=signedness\tnameStart=14\tnameEnd=24\tkind=value'
    check_project_defaults_fixture integer-descriptor \
        Testing/Storage/Pass/IntegerDescriptorSyntax.range 0 \
        $'literalStorage\tvalid=true\tstorageApplicationCount=1\tliteralApplicationCount=1\tnumericTargetSyntaxID=3\tdecimalTargetSyntaxID=-1\tdecimalSeparatorByte=-1'
    check_project_defaults_fixture decimal-descriptor \
        Testing/Storage/Pass/DecimalLiteralDescriptorSyntax.range 0 \
        $'literalStorage\tvalid=true\tstorageApplicationCount=1\tliteralApplicationCount=1\tnumericTargetSyntaxID=-1\tdecimalTargetSyntaxID=0\tdecimalSeparatorByte=46'
    check_project_defaults_fixture text-descriptor \
        Testing/Storage/Pass/TextLiteralDescriptorSyntax.range 0 \
        $'textLiteralStorage\tvalid=true\ttextTargetSyntaxID=7\tsemanticElementSyntaxID=5\tencoding=1\tcodeUnitBits=8\tcodeUnitSignedness=2'
    check_project_defaults_fixture literal-requires-storage \
        Testing/Storage/Fail/LiteralRequiresStorage.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=literalRequiresStorage'
    check_project_defaults_fixture invalid-numeric-shape \
        Testing/Storage/Fail/InvalidNumericStorageShape.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=invalidNumericStorageShape'
    check_project_defaults_fixture duplicate-numeric-literal \
        Testing/Storage/Fail/DuplicateNumericLiteral.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=duplicateNumericLiteral'
    check_project_defaults_fixture storage-must-be-empty \
        Testing/Storage/Fail/StorageMustBeEmpty.range 65 \
        $'compilerError\tkind=invalidLiteralStorage\treason=storageMustBeEmpty'
    check_project_defaults_fixture text-literal-requires-storage \
        Testing/Storage/Fail/TextLiteralRequiresStorage.range 65 \
        $'compilerError\tkind=invalidTextLiteralStorage\treason=textLiteralRequiresStorage'
    check_project_defaults_fixture text-invalid-physical-storage \
        Testing/Storage/Fail/TextStorageInvalidPhysicalStorage.range 65 \
        $'compilerError\tkind=invalidTextLiteralStorage\treason=invalidPhysicalStorage'
    if "$BUILD_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Fail/LiteralRequiresStorage.range" \
        "$llvm_output" > "$command_output" 2> "$command_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Storage literal LLVM rejection exited $actual_status, expected 65"
    [[ ! -s "$command_error" ]] \
        || fail "Storage literal LLVM rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidLiteralStorage\treason=literalRequiresStorage' "$command_output" \
        || fail "Storage literal LLVM rejection omitted the literalRequiresStorage diagnostic"
    [[ ! -s "$llvm_output" ]] \
        || fail "Storage literal LLVM rejection emitted an LLVM artifact"
    echo "Storage literal LLVM rejection: pass"
    "$BUILD_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Pass/SignednessFirstUnsignedByte.range" \
        "$unsigned_llvm" \
        || fail "Storage signedness-first unsigned byte did not emit LLVM"
    /usr/bin/grep -Fq 'icmp eq i8 255, 255' "$unsigned_llvm" \
        || fail "Storage signedness-first unsigned byte omitted i8 equality"
    validate_llvm "$unsigned_llvm"
    echo "Storage signedness-first unsigned byte: pass"
    "$BUILD_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Pass/SignedUnaryNumericLiteral.range" \
        "$signed_unary_llvm" \
        || fail "Storage signed unary numeric literal did not emit LLVM"
    /usr/bin/grep -Fq 'icmp eq i8 -4, -4' "$signed_unary_llvm" \
        || fail "Storage signed unary numeric literal omitted its signed i8 value"
    validate_llvm "$signed_unary_llvm"
    echo "Storage signed unary numeric literal: pass"
    if "$BUILD_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Fail/ReorderedSignedIntegerArguments.range" \
        "$reordered_signed_llvm" > "$command_output" 2> "$command_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Storage reordered signed integer arguments exited $actual_status, expected 65"
    [[ ! -s "$command_error" && ! -s "$reordered_signed_llvm" ]] \
        || fail "Storage reordered signed integer arguments emitted an unexpected artifact"
    echo "Storage ordered generic arguments: pass"
    if "$BUILD_EXECUTABLE" emit-llvm \
        "$REPO_ROOT/Testing/Storage/Fail/UnsignedUnaryNegation.range" \
        "$unsigned_negation_llvm" > "$command_output" 2> "$command_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 ]] \
        || fail "Storage unsigned unary negation exited $actual_status, expected 65"
    [[ ! -s "$command_error" ]] \
        || fail "Storage unsigned unary negation wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$command_output" \
        || fail "Storage unsigned unary negation omitted its rejection boundary"
    [[ ! -s "$unsigned_negation_llvm" ]] \
        || fail "Storage unsigned unary negation emitted an LLVM artifact"
    echo "Storage unsigned unary negation: pass"
    echo "checkpoint value-ownership:storage-literals-complete: pass"
}

check_defaulted_generic_optional() {
    local fixture relative llvm executable actual_status
    for relative in \
        Testing/Generics/Pass/DefaultedGenericEnum.range \
        Testing/Optionality/Pass/DefaultQuestionMark.range \
        Testing/Optionality/Pass/ValueBearingAbsence.range \
        Testing/Optionality/Pass/CustomAbsenceValue.range; do
        fixture="$REPO_ROOT/$relative"
        llvm="$WORK_ROOT/$(basename "$fixture" .range).ll"
        executable="$WORK_ROOT/$(basename "$fixture" .range)"
        [[ -f "$fixture" ]] || fail "missing generic Optional fixture: $relative"
        "$BUILD_EXECUTABLE" emit-llvm "$fixture" "$llvm" \
            || fail "generic Optional fixture did not emit LLVM: $relative"
        /usr/bin/grep -Fq 'alloca { i32,' "$llvm" \
            || fail "generic Optional fixture omitted its specialized enum layout: $relative"
        validate_llvm "$llvm"
        link_llvm "$llvm" "$executable"
        if "$executable"; then actual_status=0; else actual_status=$?; fi
        [[ "$actual_status" -eq 7 ]] \
            || fail "generic Optional fixture exited $actual_status, expected 7: $relative"
        echo "Generic Optional $(basename "$fixture" .range): pass"
    done

    fixture="$REPO_ROOT/Testing/Generics/Fail/MissingRequiredGenericEnumArgument.range"
    local rejection="$WORK_ROOT/MissingRequiredGenericEnumArgument.out"
    local rejection_error="$WORK_ROOT/MissingRequiredGenericEnumArgument.err"
    if "$BUILD_EXECUTABLE" "$fixture" > "$rejection" 2> "$rejection_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 && ! -s "$rejection_error" ]] \
        || fail "missing required generic argument rejected at the wrong boundary"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$rejection" \
        || fail "missing required generic argument omitted its exact rejection"
    echo "Generic Optional missing-required-argument: pass"
    echo "checkpoint value-ownership:generic-optional-complete: pass"
}

check_boundary_forward_mixed() {
    local bundle="$WORK_ROOT/boundary-forward-mixed.range"
    local first="$WORK_ROOT/boundary-forward-mixed.first.ll"
    local second="$WORK_ROOT/boundary-forward-mixed.repeat.ll"
    local first_error="$WORK_ROOT/boundary-forward-mixed.first.err"
    local second_error="$WORK_ROOT/boundary-forward-mixed.repeat.err"
    local linked="$WORK_ROOT/ValueOwnershipBoundaryForwardMixed"
    local run_output="$WORK_ROOT/boundary-forward-mixed.run.out"
    local run_error="$WORK_ROOT/boundary-forward-mixed.run.err"
    local actual_create_count actual_destroy_count forbidden

    write_value_ownership_bundle "$bundle" boundary-forward-mixed
    echo "checkpoint value-ownership:fixture-authored: pass"
    run_capture "$BUILD_EXECUTABLE" "$bundle" "$first" "$first_error"
    require_successful_output "focused value ownership boundary-forward-mixed" "$first" "$first_error"
    echo "checkpoint value-ownership:first-emitted: pass"
    run_capture "$BUILD_EXECUTABLE" "$bundle" "$second" "$second_error"
    require_successful_output "focused repeated value ownership boundary-forward-mixed" "$second" "$second_error"
    echo "checkpoint value-ownership:repeat-emitted: pass"
    /usr/bin/cmp -s "$first" "$second" \
        || fail "focused value ownership boundary-forward-mixed LLVM was not deterministic"
    echo "checkpoint value-ownership:deterministic: pass"

    /usr/bin/grep -Fq 'define void @makeRootBoundaryForwardMixedResult(ptr %returnDestination' "$first" \
        || fail "focused value ownership omitted the mixed-result definition"
    /usr/bin/grep -Fq 'call void @makeRootBoundaryForwardMixedResult(' "$first" \
        || fail "focused value ownership omitted the mixed-result call"
    /usr/bin/grep -Fq '%Range.RootBoundaryForwardMixedResult = type { ptr, ptr, ptr }' "$first" \
        || fail "focused value ownership omitted the forward/alias/local layout"
    actual_create_count="$(/usr/bin/grep -F -c 'call ptr @rawBufferCreate(' "$first" || true)"
    actual_destroy_count="$(/usr/bin/grep -F -c 'call i32 @rawBufferDestroy(ptr' "$first" || true)"
    [[ "$actual_create_count" -eq 3 ]] || fail "focused value ownership emitted $actual_create_count creates; expected 3"
    [[ "$actual_destroy_count" -eq 3 ]] || fail "focused value ownership emitted $actual_destroy_count destructions; expected 3"
    for forbidden in rangeConstruct malloc calloc realloc free; do
        ! /usr/bin/grep -Fq "$forbidden" "$first" \
            || fail "focused value ownership emitted forbidden dynamic/allocator symbol: $forbidden"
    done
    echo "checkpoint value-ownership:shape-audited: pass"

    validate_llvm "$first"
    echo "checkpoint value-ownership:llvm-validated: pass"
    link_llvm "$first" "$linked"
    echo "checkpoint value-ownership:linked: pass"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "focused value ownership executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "focused value ownership executable wrote output"
    echo "checkpoint value-ownership:executed-exit-7: pass"
    echo "checkpoint value-ownership:complete: pass"
    echo "Focused value ownership boundary-forward-mixed check succeeded."
    printf 'build_cache_key=%s\n' "$BUILD_CACHE_KEY"
}

main_value_ownership() {
    local compiler_input="$DEFAULT_COMPILER_DIR"
    local compiler_directory canonical_core_source_path
    local controls=0
    local extern_only=0

    if [[ "$#" -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
        usage
        return 0
    elif [[ "$#" -eq 1 && "$1" == "--controls" ]]; then
        controls=1
    elif [[ "$#" -eq 2 && "$1" == "--controls" ]]; then
        controls=1
        compiler_input="$2"
    elif [[ "$#" -eq 1 && "$1" == "--extern-only" ]]; then
        extern_only=1
    elif [[ "$#" -eq 2 && "$1" == "--extern-only" ]]; then
        extern_only=1
        compiler_input="$2"
    elif [[ "$#" -eq 1 ]]; then
        compiler_input="$1"
    elif [[ "$#" -ne 0 ]]; then
        usage >&2
        return 64
    fi
    if [[ -d "$compiler_input" && "$(cd "$compiler_input" && pwd)" == "$REPO_ROOT" ]]; then
        compiler_input="$DEFAULT_COMPILER_DIR"
    fi
    [[ -d "$compiler_input" ]] || fail "missing compiler directory: $compiler_input"
    compiler_directory="$(cd "$compiler_input" && pwd)"

    verify_manifest
    echo "checkpoint value-ownership:manifest: pass"
    WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-value-ownership.XXXXXX")"
    if [[ "${RANGE_KEEP_VALUE_OWNERSHIP_WORK_ROOT:-0}" == "1" ]]; then
        echo "value-ownership work root: $WORK_ROOT"
    else
        trap '/bin/rm -rf "$WORK_ROOT"' EXIT
    fi

    canonical_core_source_path="$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
    [[ -f "$canonical_core_source_path" ]] || fail "missing canonical Core proof input: $canonical_core_source_path"
    CORE_SOURCE_MARKER_PATH="${canonical_core_source_path#"$REPO_ROOT/"}"
    CORE_SOURCE_PATH="$WORK_ROOT/RawBuffer.range"
    /bin/cp "$canonical_core_source_path" "$CORE_SOURCE_PATH"
    RUNTIME_INPUTS=()
    while IFS= read -r runtime; do
        RUNTIME_INPUTS+=("$runtime")
    done < <(runtime_inputs)

    discover_sources "$compiler_directory" "$WORK_ROOT"
    SOURCE_BUNDLE="$WORK_ROOT/RangeCompilerSourceSet.range"
    write_source_bundle "$SOURCE_BUNDLE"
    echo "checkpoint value-ownership:source-snapshot: pass"
    resolve_compiler_build 0
    echo "checkpoint value-ownership:build-cache-$BUILD_CACHE_STATUS: pass"
    echo "checkpoint value-ownership:candidate-resolved: pass"
    if [[ "$extern_only" -eq 1 ]]; then
        check_extern_registration
        echo "checkpoint value-ownership:extern-only-complete: pass"
        return 0
    fi
    check_removed_for_statement_rejected
    check_unregistered_string_reads_rejected
    check_macro_environment
    check_error_capability_registration
    check_non_generic_stored_assignment
    check_block_value_shape_identity
    check_block_source_layout
    check_declared_applied_if_graph
    check_function_declaration_body_coverage
    check_function_declaration_cfg
    check_function_declaration_interpolation_cfg
    check_postfix_zero_or_one_occurrence
    check_legacy_macro_modifiers_rejected
    check_legacy_environment_binder_rejected
    check_legacy_bare_environment_rejected
    check_legacy_environment_expand_rejected
    check_macro_result_values
    check_macro_generic_boundary_materialization
    check_macro_parenthesized_boundary_rejection
    check_canonical_target_members
    check_value_relationship_selection
    check_value_relationship_registration
    check_canonical_declaration_envelopes
    check_hashable_function_synthesis
    check_compiler_registration
    check_extern_registration
    check_link_registration
    check_opaque_handle
    check_range_view_native_window
    check_many_relationship_registration
    check_enum_parameter_materialization
    check_block_relationship_reification
    check_duplicate_block_form_rejected
    check_collection_closure_execution
    check_inline_mapped_syntax
    check_stored_member_defaults
    check_coding_core_surface
    check_codable_construct_collection
    check_inline_core_codable
    check_codable_composite_atomic_rollback
    check_typed_parameter_defaults
    check_graph_capabilities
    check_command_group
    check_test_group
    check_macro_body_capture
    check_syntax_recipes
    check_legacy_bracket_collection_type_rejected
    check_range_authored_syntax_template
    check_project_defaults
    check_storage_literals
    check_defaulted_generic_optional
    if [[ "$controls" -eq 1 ]]; then
        audit_value_ownership Controls "$BUILD_EXECUTABLE" "$WORK_ROOT/controls"
        echo "checkpoint value-ownership:controls-complete: pass"
    else
        check_boundary_forward_mixed
    fi
    range_build_mark_development_producer_validated \
        || fail "could not publish the validated development compiler producer"
    echo "checkpoint value-ownership:development-producer-validated: pass"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main_value_ownership "$@"
fi
