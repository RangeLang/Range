check_block_relationship_reification() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/BlockRelationshipReification.range"
    local output="$WORK_ROOT/macro-block-relationship-reification.out"
    local error="$WORK_ROOT/macro-block-relationship-reification.err"

    [[ -f "$fixture" ]] \
        || fail "missing block relationship reification fixture"
    "$BUILD_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "block relationship reification fixture did not compile"
    [[ ! -s "$error" ]] \
        || fail "block relationship reification fixture wrote stderr"
    /usr/bin/grep -Fq $'typedSyntax\tvalid=true' "$output" \
        || fail "block relationship reification did not retain typed source syntax"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=0\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=ParenthesizedBlock\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=1\tdelimiterPair=0\tadmission=1$' "$output" \
        || fail "block relationship reification did not project the authored parenthesized form"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=1\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=Block\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=1\tdelimiterPair=1\tadmission=1$' "$output" \
        || fail "block relationship reification did not project the authored braced form"
    /usr/bin/grep -Eq $'^blockRegistration\trow=0\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=ParenthesizedBlock\trelationshipRow=0$' "$output" \
        || fail "block relationship reification did not bind the parenthesized source form"
    /usr/bin/grep -Eq $'^blockRegistration\trow=1\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=Block\trelationshipRow=1$' "$output" \
        || fail "block relationship reification did not bind the braced source form"
    /usr/bin/grep -Eq $'^blockContentsSlot\trow=[0-9]+\tregistrationRow=1\trelationshipRow=1\townerSyntaxID=[0-9]+\tdelimiterPair=2\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tenclosureKind=2\tadmission=1$' "$output" \
        || fail "block relationship reification did not select the braced Range relationship for a braced source slot"
    echo "Syntax authored block-relationship reification: pass"
}

check_duplicate_block_form_rejected() {
    local fixture="$REPO_ROOT/Testing/Macros/Fail/DuplicateBlockForm.range"
    local output="$WORK_ROOT/macro-duplicate-block-form.out"
    local error="$WORK_ROOT/macro-duplicate-block-form.err"
    local actual_exit

    [[ -f "$fixture" ]] \
        || fail "missing duplicate block-form fixture"
    if "$BUILD_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        actual_exit=0
    else
        actual_exit=$?
    fi
    [[ "$actual_exit" -eq 65 ]] \
        || fail "duplicate block-form fixture exited $actual_exit instead of 65"
    [[ ! -s "$error" ]] \
        || fail "duplicate block-form fixture wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=macroExecution\tdiagnosticKind=macroGraphDeltaInvalid' "$output" \
        || fail "duplicate block-form fixture did not reject the ambiguous physical delimiter registration"
    ! /usr/bin/grep -Fq 'blockContentsSlot' "$output" \
        || fail "duplicate block-form fixture materialized an ambiguous physical source slot"
    echo "Syntax duplicate block-form rejection: pass"
}

