check_value_relationship_registration() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/ValueRelationshipRegistration.range"
    local output="$WORK_ROOT/macro-value-relationship-registration.out"
    local error="$WORK_ROOT/macro-value-relationship-registration.err"

    "$BUILD_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "value relationship registration macro did not compile"
    [[ ! -s "$error" ]] || fail "value relationship registration macro wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$output" \
        || fail "value relationship registration did not execute its producer and observer"
    /usr/bin/grep -Fq $'macroResult\trow=0\tinvocationRow=0\tapplicationRow=0\tkind=3' "$output" \
        || fail "@value did not return a typed relationship registration"
    /usr/bin/grep -Fq $'scalar=1\tchildCount=0\tparentRow=1\tordinal=0' "$output" \
        || fail "@value registration did not retain its minimum multiplicity"
    /usr/bin/grep -Fq $'macroResult\trow=0\tinvocationRow=0\tapplicationRow=0\tkind=3\ttypeKind=4\tnominalSyntaxID=48\tscalar=0\tchildCount=5' "$output" \
        || fail "@value registration did not retain its admission field"
    /usr/bin/grep -Fq $'macroResult\trow=9\tinvocationRow=1\tapplicationRow=1\tkind=3' "$output" \
        || fail "the observing macro did not consume the expanded registration value"
    /usr/bin/grep -Fq $'scalar=1\tchildCount=0\tparentRow=9\tordinal=0' "$output" \
        || fail "the observing macro did not read the one-value lower bound"
    /usr/bin/grep -Eq $'^macroResult\trow=11\tinvocationRow=1\tapplicationRow=1\tkind=4\ttypeKind=9\tnominalSyntaxID=[1-9][0-9]*\tscalar=0\tchildCount=0\tparentRow=9\tordinal=1' "$output" \
        || fail "the observing macro did not preserve the relationship admission identity"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=0\tapplicationRow=0\ttargetMemberSyntaxID=[0-9]+\ttargetName=payload\townerSyntaxID=[0-9]+\townerName=ValueRelationshipTarget\tminimum=1\tmaximumKind=1\tmaximum=1\tordering=0\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=0\tdelimiterPair=-1\tadmission=0$' "$output" \
        || fail "the compiler did not project the authored one-value relationship onto its member identity"
    echo "Macros value-relationship-registration: pass"
}

write_error_capability_bundle() {
    local output="$1"
    local fixture="$2"
    local error_macro_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Error.range"
    local error_source="$REPO_ROOT/RangeCompiler/Sources/Core/System/Result/Error.range"

    [[ -f "$error_macro_source" && -f "$error_source" && -f "$fixture" ]] \
        || fail "missing Core error capability source or fixture"
    /usr/bin/printf '%s\n' \
        'compilerMacroSnapshot' \
        'compilerSourceFile\trole=core\tpath=Core/ErrorCapabilityPrelude.range' \
        '@builtin' \
        'construct Array<Element> {}' \
        '' \
        'macro member(): Declaration | Member -> Void {}' \
        'macro stored(): Construct -> Void {}' \
        '' \
        'construct Identity {' \
        '    let name: String' \
        '    let id: String' \
        '}' \
        '' \
        'construct MacroDiagnostics {' \
        '    function error(_ message: String)' \
        '}' \
        '' \
        'construct Construct {' \
        '    @member' \
        '    construct Declaration {' \
        '        let identity: Identity' \
        '        let members: Array<@member>' \
        '    }' \
        '}' \
        '' \
        '@stored' \
        '@member' \
        'construct Let {' \
        '    let identity: Identity' \
        '}' > "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Error.range' >> "$output"
    /bin/cat "$error_macro_source" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Result/Error.range' >> "$output"
    /bin/cat "$error_source" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_error_capability_registration() {
    local pass_fixture="$REPO_ROOT/Testing/Errors/Pass/ErrorMacroValidation.range"
    local missing_fixture="$REPO_ROOT/Testing/Errors/Fail/ErrorMissingMessage.range"
    local pass_bundle="$WORK_ROOT/error-capability.pass.range"
    local missing_bundle="$WORK_ROOT/error-capability.missing.range"
    local pass_output="$WORK_ROOT/error-capability.pass.out"
    local missing_output="$WORK_ROOT/error-capability.missing.out"
    local pass_error="$WORK_ROOT/error-capability.pass.err"
    local missing_error="$WORK_ROOT/error-capability.missing.err"
    local actual_status

    write_error_capability_bundle "$pass_bundle" "$pass_fixture"
    write_error_capability_bundle "$missing_bundle" "$missing_fixture"

    "$BUILD_EXECUTABLE" compile "$pass_bundle" > "$pass_output" 2> "$pass_error" \
        || fail "Core @error capability did not compile: $(/usr/bin/head -n 1 "$pass_output")"
    [[ ! -s "$pass_error" ]] || fail "Core @error capability wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$pass_output" \
        || fail "Core @error did not validate the general and user error constructs"
    [[ "$(/usr/bin/grep -Ec '^macroContribution\t' "$pass_output")" -eq 0 ]] \
        || fail "validation-only @error unexpectedly emitted a graph contribution"

    if "$BUILD_EXECUTABLE" compile "$missing_bundle" > "$missing_output" 2> "$missing_error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 65 && ! -s "$missing_error" ]] \
        || fail "@error missing-message control rejected at the wrong boundary"
    /usr/bin/grep -Fq $'diagnosticKind=macroExecutionError' "$missing_output" \
        && /usr/bin/grep -Fq '@error requires exactly one message declaration.' "$missing_output" \
        || fail "@error missing-message control omitted its typed macro diagnostic"

    echo "Errors validation-only Core @error: pass"
}

write_compiler_registration_bundle() {
    local output="$1"
    local fixture="$2"
    local compiler_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Compiler.range"

    /usr/bin/printf '%s\n' \
        'compilerMacroSnapshot' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/CompilerReflection.range' \
        '@builtin' \
        'construct Array<Element> {}' \
        '' \
        'macro member(): Declaration | Member -> Void {}' \
        'macro syntax(): Declaration -> Void {}' \
        '' \
        'construct Identity {' \
        '    let name: String' \
        '}' \
        '' \
        'construct Construct {' \
        '    @member' \
        '    construct Declaration {' \
        '        let identity: Identity' \
        '        let members: Array<@member>' \
        '    }' \
        '}' \
        '' \
        'construct Function {' \
        '    @syntax' \
        '    @member' \
        '    construct Declaration {' \
        '        let identity: Identity' \
        '    }' \
        '}' > "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Compiler.range' >> "$output"
    /bin/cat "$compiler_source" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_compiler_registration() {
    local pass_fixture="$REPO_ROOT/Testing/Macros/Pass/CompilerRegistration.range"
    local missing_fixture="$REPO_ROOT/Testing/Macros/Fail/CompilerRequiresPhase.range"
    local pass_bundle="$WORK_ROOT/compiler-registration.pass.range"
    local missing_bundle="$WORK_ROOT/compiler-registration.missing.range"
    local pass_output="$WORK_ROOT/compiler-registration.pass.out"
    local missing_output="$WORK_ROOT/compiler-registration.missing.out"
    local pass_error="$WORK_ROOT/compiler-registration.pass.err"
    local missing_error="$WORK_ROOT/compiler-registration.missing.err"
    local actual_status

    write_compiler_registration_bundle "$pass_bundle" "$pass_fixture"
    write_compiler_registration_bundle "$missing_bundle" "$missing_fixture"

    "$BUILD_EXECUTABLE" compile "$pass_bundle" > "$pass_output" 2> "$pass_error" \
        || fail "Core compiler registration did not compile: $(/usr/bin/head -n 1 "$pass_output")"
    [[ ! -s "$pass_error" ]] || fail "Core compiler registration wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=3' "$pass_output" \
        || fail "@compiler and its two @phase applications did not execute"
    /usr/bin/grep -Fq $'macroResult\trow=2\tinvocationRow=0\tapplicationRow=3\tkind=2\ttypeKind=4\tnominalSyntaxID=0\tscalar=15\tchildCount=2\tparentRow=0\tordinal=1\trelationshipRow=-1' "$pass_output" \
        || fail "@compiler did not retain exactly two ordered phase handles"
    /usr/bin/grep -Fq $'macroResult\trow=3\tinvocationRow=0\tapplicationRow=3\tkind=5\ttypeKind=6\tnominalSyntaxID=-1\tscalar=16\tchildCount=0\tparentRow=2\tordinal=0\trelationshipRow=12' "$pass_output" \
        || fail "@compiler did not retain shape as its first phase"
    /usr/bin/grep -Fq $'macroResult\trow=4\tinvocationRow=0\tapplicationRow=3\tkind=5\ttypeKind=6\tnominalSyntaxID=-1\tscalar=18\tchildCount=0\tparentRow=2\tordinal=1\trelationshipRow=15' "$pass_output" \
        || fail "@compiler did not retain usage as its second phase"
    if /usr/bin/grep -Eq $'^macroResult\t.*scalar=17(\t|$)' "$pass_output"; then
        fail "@compiler incorrectly registered the unannotated helper as a phase"
    fi
    /usr/bin/grep -Fq $'macroResult\trow=6\tinvocationRow=1\tapplicationRow=4\tkind=5\ttypeKind=6\tnominalSyntaxID=-1\tscalar=16\tchildCount=0\tparentRow=5\tordinal=0\trelationshipRow=-1' "$pass_output" \
        || fail "@phase did not return a registration containing its shape function target"
    /usr/bin/grep -Fq $'macroResult\trow=8\tinvocationRow=2\tapplicationRow=5\tkind=5\ttypeKind=6\tnominalSyntaxID=-1\tscalar=18\tchildCount=0\tparentRow=7\tordinal=0\trelationshipRow=-1' "$pass_output" \
        || fail "@phase did not return a registration containing its usage function target"

    actual_status=0
    "$BUILD_EXECUTABLE" compile "$missing_bundle" > "$missing_output" 2> "$missing_error" \
        || actual_status=$?
    [[ "$actual_status" -eq 65 && ! -s "$missing_error" ]] \
        || fail "@compiler missing-phase control rejected at the wrong boundary"
    /usr/bin/grep -Fq '@compiler requires at least one @phase function.' "$missing_output" \
        || fail "@compiler missing-phase control omitted its diagnostic"

    echo "Macros Core compiler registration: pass"
}

write_extern_bundle() {
    local output="$1"
    local header="$2"
    local fixture="$3"
    local extern_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Extern.range"

    : > "$output"
    if [[ -n "$header" ]]; then
        /usr/bin/printf '%s\n' "$header" >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/ExternReflection.range' \
        'construct Function {}' >> "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Extern.range' >> "$output"
    /bin/cat "$extern_source" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

write_process_extern_bundle() {
    local output="$1"
    local fixture="$2"
    local extern_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Extern.range"
    local process_source="$REPO_ROOT/RangeCompiler/Sources/Core/System/Process.range"

    : > "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/ExternReflection.range' \
        'construct Function {}' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Extern.range' >> "$output"
    /bin/cat "$extern_source" >> "$output"
    /usr/bin/printf '%s\n' \
        '' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Process.range' >> "$output"
    /bin/cat "$process_source" >> "$output"
    /usr/bin/printf '\ncompilerSourceFile\trole=project\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_extern_registration() {
    local runtime_builtin_model="$REPO_ROOT/RangeCompiler/Sources/Compiler/Body/CompilerBodyModel.range"
    local legacy_llvm_model="$REPO_ROOT/RangeCompiler/Sources/Compiler/LLVM/CompilerBodyLLVM.range"
    local process_source="$REPO_ROOT/RangeCompiler/Sources/Core/System/Process.range"
    local process_extern_promoted=0
    if /usr/bin/grep -Fq 'function commandLineArgument(index: Int): String' "$process_source" \
        && /usr/bin/grep -B2 -F 'function commandLineArgument(index: Int): String' "$process_source" | /usr/bin/grep -Fq '@extern'; then
        process_extern_promoted=1
    fi
    local migrated_symbol
    for migrated_symbol in \
        targetPointerBits \
        commandLineArgumentCount \
        stringTransientRegionMark \
        stringTransientRegionReset \
        compilerMetricsReset \
        compilerMetricsFunctionEnd; do
        if /usr/bin/grep -Fq "String(\"$migrated_symbol\")" "$runtime_builtin_model"; then
            fail "authored compiler extern $migrated_symbol remains name-keyed in the runtime-builtin model"
        fi
        if /usr/bin/grep -Fq "@$migrated_symbol(" "$legacy_llvm_model"; then
            fail "authored compiler extern $migrated_symbol remains in the legacy LLVM declaration prelude"
        fi
    done
    if [[ "$process_extern_promoted" -eq 1 ]]; then
        for migrated_symbol in commandLineArgument runProcess runProcessBatch; do
            if /usr/bin/grep -Fq "String(\"$migrated_symbol\")" "$runtime_builtin_model"; then
                fail "authored compiler extern $migrated_symbol remains name-keyed in the runtime-builtin model"
            fi
            if /usr/bin/grep -Fq "@$migrated_symbol(" "$legacy_llvm_model"; then
                fail "authored compiler extern $migrated_symbol remains in the legacy LLVM declaration prelude"
            fi
        done
    fi

    local pass_fixture="$REPO_ROOT/Testing/Extern/Pass/ScalarIntCall.range"
    local host_fixture="$REPO_ROOT/Testing/Extern/Pass/ScalarIntHost.c"
    local snapshot_bundle="$WORK_ROOT/extern-scalar-int.snapshot.range"
    local native_bundle="$WORK_ROOT/extern-scalar-int.native.range"
    local pass_output="$WORK_ROOT/extern-scalar-int.pass.out"
    local pass_error="$WORK_ROOT/extern-scalar-int.pass.err"
    local llvm="$WORK_ROOT/extern-scalar-int.ll"
    local executable="$WORK_ROOT/extern-scalar-int"
    local temporary="$WORK_ROOT/extern-scalar-int.tmp"
    local actual_status

    write_extern_bundle "$snapshot_bundle" compilerMacroSnapshot "$pass_fixture"
    "$BUILD_EXECUTABLE" compile "$snapshot_bundle" > "$pass_output" 2> "$pass_error" \
        || fail "Core @extern scalar registration did not compile: $(/usr/bin/head -n 1 "$pass_output")"
    [[ ! -s "$pass_error" ]] || fail "Core @extern scalar registration wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$pass_output" \
        || fail "Core @extern and its result-compatible alias did not execute"

    write_extern_bundle "$native_bundle" "" "$pass_fixture"
    "$BUILD_EXECUTABLE" compile "$native_bundle" > "$llvm" 2> "$pass_error" \
        || fail "Core @extern scalar registration did not emit LLVM"
    [[ ! -s "$pass_error" ]] || fail "Core @extern scalar LLVM emission wrote stderr"
    [[ "$(/usr/bin/grep -F -c 'declare i32 @rangeExternAdd(i32, i32)' "$llvm" || true)" -eq 1 ]] \
        || fail "Core @extern did not emit exactly one scalar declaration"
    [[ "$(/usr/bin/grep -F -c 'declare i32 @rangeNativeMultiply(i32, i32)' "$llvm" || true)" -eq 1 ]] \
        || fail "ExternRegistration-compatible macro did not emit exactly one scalar declaration"
    /usr/bin/grep -Fq 'call i32 @rangeNativeMultiply(i32 6, i32 7)' "$llvm" \
        || fail "ExternRegistration-compatible macro did not emit the scalar direct call"
    /usr/bin/grep -Eq 'call i32 @rangeExternAdd\(i32 %r[0-9]+, i32 0\)' "$llvm" \
        || fail "Core @extern did not emit the scalar direct call"
    if /usr/bin/grep -Fq 'define i32 @rangeExternAdd' "$llvm"; then
        fail "Core @extern emitted a Range definition for the foreign symbol"
    fi
    if /usr/bin/grep -Fq 'define i32 @rangeNativeMultiply' "$llvm"; then
        fail "ExternRegistration-compatible macro emitted a Range definition for the foreign symbol"
    fi
    validate_llvm "$llvm"
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$llvm" "${RUNTIME_INPUTS[@]}" "$host_fixture" -o "$temporary"
    /bin/mv "$temporary" "$executable"
    actual_status=0
    "$executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core @extern linked execution returned $actual_status, expected 42"

    local string_fixture="$REPO_ROOT/Testing/Extern/Pass/StringCall.range"
    local string_host_fixture="$REPO_ROOT/Testing/Extern/Pass/StringCallHost.c"
    local string_bundle="$WORK_ROOT/extern-string.native.range"
    local string_llvm="$WORK_ROOT/extern-string.ll"
    local string_error="$WORK_ROOT/extern-string.err"
    local string_executable="$WORK_ROOT/extern-string"
    write_extern_bundle "$string_bundle" "" "$string_fixture"
    "$BUILD_EXECUTABLE" compile "$string_bundle" > "$string_llvm" 2> "$string_error" \
        || fail "Core @extern String registration did not emit LLVM: $(/usr/bin/head -n 1 "$string_llvm")"
    [[ ! -s "$string_error" ]] || fail "Core @extern String LLVM emission wrote stderr"
    [[ "$(/usr/bin/grep -F -c 'declare ptr @rangeExternStringIdentity(ptr)' "$string_llvm" || true)" -eq 1 ]] \
        || fail "Core @extern String registration did not emit exactly one pointer declaration"
    /usr/bin/grep -Fq 'call ptr @rangeExternStringIdentity(ptr @.str.entry.0)' "$string_llvm" \
        || fail "Core @extern String registration omitted its direct pointer call"
    if /usr/bin/grep -Fq 'define ptr @rangeExternStringIdentity' "$string_llvm"; then
        fail "Core @extern String registration emitted a Range definition"
    fi
    validate_llvm "$string_llvm"
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$string_llvm" "${RUNTIME_INPUTS[@]}" "$string_host_fixture" -o "$temporary"
    /bin/mv "$temporary" "$string_executable"
    actual_status=0
    "$string_executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core @extern String linked execution returned $actual_status, expected 42"

    local role_fixture="$REPO_ROOT/Testing/Extern/Pass/BuiltinTargetRole.range"
    local role_bundle="$WORK_ROOT/extern-builtin-target-role.native.range"
    local role_llvm="$WORK_ROOT/extern-builtin-target-role.ll"
    local role_error="$WORK_ROOT/extern-builtin-target-role.err"
    local role_executable="$WORK_ROOT/extern-builtin-target-role"
    write_extern_bundle "$role_bundle" "" "$role_fixture"
    "$BUILD_EXECUTABLE" compile "$role_bundle" > "$role_llvm" 2> "$role_error" \
        || fail "Core @extern with builtin target role did not emit LLVM"
    [[ ! -s "$role_error" ]] || fail "Core @extern with builtin target role wrote stderr"
    [[ "$(/usr/bin/grep -F -c 'declare i32 @targetPointerBits()' "$role_llvm" || true)" -eq 1 ]] \
        || fail "Core @extern with builtin target role omitted its foreign declaration"
    /usr/bin/grep -Fq 'call i32 @targetPointerBits()' "$role_llvm" \
        || fail "Core @extern with builtin target role omitted its foreign call"
    validate_llvm "$role_llvm"
    link_llvm "$role_llvm" "$role_executable"
    actual_status=0
    "$role_executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core @extern with builtin target role returned $actual_status, expected 42"

    local scalar_fixture="$REPO_ROOT/Testing/Extern/Pass/CompilerScalarBridges.range"
    local scalar_bundle="$WORK_ROOT/extern-compiler-scalars.native.range"
    local scalar_llvm="$WORK_ROOT/extern-compiler-scalars.ll"
    local scalar_error="$WORK_ROOT/extern-compiler-scalars.err"
    local scalar_executable="$WORK_ROOT/extern-compiler-scalars"
    local declaration call
    write_extern_bundle "$scalar_bundle" "" "$scalar_fixture"
    "$BUILD_EXECUTABLE" compile "$scalar_bundle" > "$scalar_llvm" 2> "$scalar_error" \
        || fail "compiler scalar @extern batch did not emit LLVM"
    [[ ! -s "$scalar_error" ]] || fail "compiler scalar @extern batch wrote stderr"
    for declaration in \
        'declare i32 @targetPointerBits()' \
        'declare i32 @commandLineArgumentCount()' \
        'declare i32 @stringTransientRegionMark()' \
        'declare i32 @stringTransientRegionReset(i32)' \
        'declare i32 @compilerMetricsReset()' \
        'declare i32 @compilerMetricsFunctionEnd(i32, i32)'; do
        [[ "$(/usr/bin/grep -F -c "$declaration" "$scalar_llvm" || true)" -eq 1 ]] \
            || fail "compiler scalar @extern batch did not emit exactly one $declaration"
    done
    for call in \
        'call i32 @targetPointerBits()' \
        'call i32 @commandLineArgumentCount()' \
        'call i32 @stringTransientRegionMark()' \
        'call i32 @stringTransientRegionReset(' \
        'call i32 @compilerMetricsReset()' \
        'call i32 @compilerMetricsFunctionEnd('; do
        /usr/bin/grep -Fq "$call" "$scalar_llvm" \
            || fail "compiler scalar @extern batch omitted $call"
    done
    validate_llvm "$scalar_llvm"
    link_llvm "$scalar_llvm" "$scalar_executable"
    actual_status=0
    "$scalar_executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "compiler scalar @extern batch returned $actual_status, expected 42"

    if [[ "$process_extern_promoted" -eq 1 ]]; then
    local process_fixture="$REPO_ROOT/Testing/Extern/Pass/ProcessBridges.range"
    local process_bundle="$WORK_ROOT/extern-process.native.range"
    local process_llvm="$WORK_ROOT/extern-process.ll"
    local process_error="$WORK_ROOT/extern-process.err"
    local process_executable="$WORK_ROOT/extern-process"
    write_process_extern_bundle "$process_bundle" "$process_fixture"
    "$BUILD_EXECUTABLE" compile "$process_bundle" > "$process_llvm" 2> "$process_error" \
        || fail "Core Process @extern batch did not emit LLVM: $(/usr/bin/head -n 1 "$process_llvm")"
    [[ ! -s "$process_error" ]] || fail "Core Process @extern batch wrote stderr"
    for declaration in \
        'declare ptr @commandLineArgument(i32)' \
        'declare i32 @runProcess(ptr, ptr)' \
        'declare i32 @runProcessBatch(ptr, i32)'; do
        [[ "$(/usr/bin/grep -F -c "$declaration" "$process_llvm" || true)" -eq 1 ]] \
            || fail "Core Process @extern batch did not emit exactly one $declaration"
    done
    for call in \
        'call ptr @commandLineArgument(i32 1000000)' \
        'call i32 @runProcess(' \
        'call i32 @runProcessBatch('; do
        /usr/bin/grep -Fq "$call" "$process_llvm" \
            || fail "Core Process @extern batch omitted $call"
    done
    validate_llvm "$process_llvm"
    link_llvm "$process_llvm" "$process_executable"
    actual_status=0
    "$process_executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core Process @extern batch returned $actual_status, expected 42"
    fi

    if [[ "$controls" -eq 1 ]]; then
        local relative fixture bundle output error
        for relative in \
            Testing/Extern/Fail/BodyPresent.range \
            Testing/Extern/Fail/NonIntSignature.range \
            Testing/Extern/Fail/BodylessWithoutRegistration.range \
            Testing/Extern/Fail/GenericFunction.range \
            Testing/Extern/Fail/LookalikeRegistration.range; do
            fixture="$REPO_ROOT/$relative"
            bundle="$WORK_ROOT/$(/usr/bin/basename "$relative").bundle.range"
            output="$WORK_ROOT/$(/usr/bin/basename "$relative").out"
            error="$WORK_ROOT/$(/usr/bin/basename "$relative").err"
            write_extern_bundle "$bundle" compilerMacroSnapshot "$fixture"
            actual_status=0
            "$BUILD_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
                || actual_status=$?
            [[ "$actual_status" -eq 65 && ! -s "$error" ]] \
                || fail "$relative rejected at the wrong boundary"
            /usr/bin/grep -Fq $'compilerError\tkind=macroExecution\tdiagnosticKind=macroExecutionBodyInvalid' "$output" \
                || fail "$relative omitted its extern registration rejection"
        done
    fi

    echo "Macros Core @extern scalar/String native calls and orthogonal builtin roles: pass"
}

write_link_bundle() {
    local output="$1"
    local header="$2"
    local fixture="$3"

    : > "$output"
    if [[ -n "$header" ]]; then
        /usr/bin/printf '%s\n' "$header" >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/LinkReflection.range' \
        'construct Function {}' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Extern.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Extern.range" >> "$output"
    /usr/bin/printf '%s\n' \
        '' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Link.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Link.range" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_link_registration() {
    local pass_fixture="$REPO_ROOT/Testing/Link/Pass/SQLiteLibrary.range"
    local snapshot_bundle="$WORK_ROOT/link-sqlite.snapshot.range"
    local snapshot_output="$WORK_ROOT/link-sqlite.snapshot.out"
    local snapshot_error="$WORK_ROOT/link-sqlite.snapshot.err"
    local native_bundle="$WORK_ROOT/link-sqlite.native.range"
    local llvm="$WORK_ROOT/link-sqlite.ll"
    local native_error="$WORK_ROOT/link-sqlite.native.err"
    local executable="$WORK_ROOT/link-sqlite"
    local temporary="$WORK_ROOT/link-sqlite.tmp"
    local actual_status
    local link_arguments=()

    write_link_bundle "$snapshot_bundle" compilerMacroSnapshot "$pass_fixture"
    "$BUILD_EXECUTABLE" compile "$snapshot_bundle" > "$snapshot_output" 2> "$snapshot_error" \
        || fail "Core @link SQLite registration did not compile"
    [[ ! -s "$snapshot_error" ]] || fail "Core @link SQLite registration wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$snapshot_output" \
        || fail "Core @extern and @link did not both execute"

    write_link_bundle "$native_bundle" "" "$pass_fixture"
    "$BUILD_EXECUTABLE" compile "$native_bundle" > "$llvm" 2> "$native_error" \
        || fail "Core @link SQLite program did not emit LLVM"
    [[ ! -s "$native_error" ]] || fail "Core @link SQLite LLVM emission wrote stderr"
    [[ "$(/usr/bin/grep -Fxc '; range-link-v1 kind=library id=sqlite3' "$llvm" || true)" -eq 1 ]] \
        || fail "Core @link did not emit exactly one typed SQLite requirement"
    /usr/bin/grep -Fq 'declare i32 @sqlite3_libversion_number()' "$llvm" \
        || fail "Core @link fixture omitted its foreign declaration"
    /usr/bin/grep -Fq 'call i32 @sqlite3_libversion_number()' "$llvm" \
        || fail "Core @link fixture omitted its foreign call"
    validate_llvm "$llvm"
    if /usr/bin/grep -Fqx '; range-link-v1 kind=library id=sqlite3' "$llvm"; then
        link_arguments+=("-lsqlite3")
    fi
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$llvm" "${RUNTIME_INPUTS[@]}" "${link_arguments[@]}" -o "$temporary"
    /bin/mv "$temporary" "$executable"
    actual_status=0
    "$executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core @link SQLite execution returned $actual_status, expected 42"

    if [[ "$controls" -eq 1 ]]; then
        local relative fixture bundle output error
        for relative in \
            Testing/Link/Fail/RangeFunctionRequirement.range \
            Testing/Link/Fail/DuplicateRequirement.range; do
            fixture="$REPO_ROOT/$relative"
            bundle="$WORK_ROOT/$(/usr/bin/basename "$relative").link.bundle.range"
            output="$WORK_ROOT/$(/usr/bin/basename "$relative").link.out"
            error="$WORK_ROOT/$(/usr/bin/basename "$relative").link.err"
            write_link_bundle "$bundle" compilerMacroSnapshot "$fixture"
            actual_status=0
            "$BUILD_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
                || actual_status=$?
            [[ "$actual_status" -eq 65 && ! -s "$error" ]] \
                || fail "$relative rejected at the wrong boundary"
            /usr/bin/grep -Fq $'compilerError\tkind=macroExecution\tdiagnosticKind=macroExecutionBodyInvalid' "$output" \
                || fail "$relative omitted its typed link registration rejection"
        done
    fi

    echo "Macros Core @link native SQLite requirement: pass"
}

write_opaque_bundle() {
    local output="$1"
    local header="$2"
    local fixture="$3"

    : > "$output"
    if [[ -n "$header" ]]; then
        /usr/bin/printf '%s\n' "$header" >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/NativeReflection.range' \
        'construct Function {}' \
        'construct Construct {}' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Extern.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Extern.range" >> "$output"
    /usr/bin/printf '%s\n' \
        '' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Link.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Link.range" >> "$output"
    /usr/bin/printf '%s\n' \
        '' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Opaque.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Opaque.range" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_opaque_handle() {
    local pass_fixture="$REPO_ROOT/Testing/Extern/Pass/PthreadOpaqueHandle.range"
    local snapshot_bundle="$WORK_ROOT/opaque-pthread.snapshot.range"
    local snapshot_output="$WORK_ROOT/opaque-pthread.snapshot.out"
    local snapshot_error="$WORK_ROOT/opaque-pthread.snapshot.err"
    local native_bundle="$WORK_ROOT/opaque-pthread.native.range"
    local llvm="$WORK_ROOT/opaque-pthread.ll"
    local native_error="$WORK_ROOT/opaque-pthread.native.err"
    local executable="$WORK_ROOT/opaque-pthread"
    local temporary="$WORK_ROOT/opaque-pthread.tmp"
    local actual_status

    write_opaque_bundle "$snapshot_bundle" compilerMacroSnapshot "$pass_fixture"
    "$BUILD_EXECUTABLE" compile "$snapshot_bundle" > "$snapshot_output" 2> "$snapshot_error" \
        || fail "Core @opaque pthread registration did not compile"
    [[ ! -s "$snapshot_error" ]] || fail "Core @opaque pthread registration wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=4' "$snapshot_output" \
        || fail "Core @opaque, @extern, and @link registrations did not execute"

    write_opaque_bundle "$native_bundle" "" "$pass_fixture"
    "$BUILD_EXECUTABLE" compile "$native_bundle" > "$llvm" 2> "$native_error" \
        || fail "Core @opaque pthread program did not emit LLVM"
    [[ ! -s "$native_error" ]] || fail "Core @opaque pthread LLVM emission wrote stderr"
    [[ "$(/usr/bin/grep -Fxc '; range-link-v1 kind=library id=pthread' "$llvm" || true)" -eq 1 ]] \
        || fail "Core @opaque pthread program omitted its typed link requirement"
    /usr/bin/grep -Fq 'declare ptr @pthread_self()' "$llvm" \
        || fail "Core @opaque did not lower the foreign handle return as ptr"
    /usr/bin/grep -Fq 'declare i32 @pthread_equal(ptr, ptr)' "$llvm" \
        || fail "Core @opaque did not lower foreign handle parameters as ptr"
    /usr/bin/grep -Eq 'call ptr @pthread_self\(\)' "$llvm" \
        || fail "Core @opaque omitted the native handle-producing call"
    /usr/bin/grep -Eq 'call i32 @pthread_equal\(ptr %r[0-9]+, ptr %r[0-9]+\)' "$llvm" \
        || fail "Core @opaque omitted the native handle-consuming call"
    if /usr/bin/grep -Fq '%Range.PthreadHandle = type' "$llvm"; then
        fail "Core @opaque emitted an aggregate layout for a foreign handle"
    fi
    validate_llvm "$llvm"
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$llvm" "${RUNTIME_INPUTS[@]}" -lpthread -o "$temporary"
    /bin/mv "$temporary" "$executable"
    actual_status=0
    "$executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core @opaque pthread execution returned $actual_status, expected 42"

    local nullable_fixture="$REPO_ROOT/Testing/Extern/Pass/NullableOpaqueArgument.range"
    local nullable_bundle="$WORK_ROOT/nullable-opaque.native.range"
    local nullable_llvm="$WORK_ROOT/nullable-opaque.ll"
    local nullable_error="$WORK_ROOT/nullable-opaque.err"
    local nullable_executable="$WORK_ROOT/nullable-opaque"
    write_opaque_bundle "$nullable_bundle" "" "$nullable_fixture"
    "$BUILD_EXECUTABLE" compile "$nullable_bundle" > "$nullable_llvm" 2> "$nullable_error" \
        || fail "Core @opaque nullable argument did not emit LLVM"
    [[ ! -s "$nullable_error" ]] || fail "Core @opaque nullable argument wrote stderr"
    /usr/bin/grep -Fq 'call void @free(ptr null)' "$nullable_llvm" \
        || fail "Core @opaque nil argument did not lower as ptr null"
    validate_llvm "$nullable_llvm"
    link_llvm "$nullable_llvm" "$nullable_executable"
    actual_status=0
    "$nullable_executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core @opaque nullable execution returned $actual_status, expected 42"

    local inferred_fixture="$REPO_ROOT/Testing/Extern/Pass/InferredOpaqueCall.range"
    local inferred_host="$REPO_ROOT/Testing/Extern/Pass/InferredOpaqueCallHost.c"
    local inferred_bundle="$WORK_ROOT/inferred-opaque-call.range"
    local inferred_llvm="$WORK_ROOT/inferred-opaque-call.ll"
    local inferred_error="$WORK_ROOT/inferred-opaque-call.err"
    local inferred_executable="$WORK_ROOT/inferred-opaque-call"
    write_opaque_bundle "$inferred_bundle" "" "$inferred_fixture"
    "$BUILD_EXECUTABLE" compile "$inferred_bundle" > "$inferred_llvm" 2> "$inferred_error" \
        || fail "Core inferred opaque call binding did not emit LLVM"
    [[ ! -s "$inferred_error" ]] || fail "Core inferred opaque call binding wrote stderr"
    /usr/bin/grep -Fq 'call ptr @rangeExternOpaqueIdentity(ptr null)' "$inferred_llvm" \
        || fail "Core inferred opaque call binding omitted its nullable foreign call"
    validate_llvm "$inferred_llvm"
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$inferred_llvm" "${RUNTIME_INPUTS[@]}" "$inferred_host" -o "$inferred_executable"
    actual_status=0
    "$inferred_executable" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "Core inferred opaque call binding returned $actual_status, expected 42"

    if [[ "$controls" -eq 1 ]]; then
        local relative fixture bundle output error expected
        for relative in \
            Testing/Extern/Fail/OpaqueStoredMember.range \
            Testing/Extern/Fail/OpaqueDirectConstruction.range; do
            fixture="$REPO_ROOT/$relative"
            bundle="$WORK_ROOT/$(/usr/bin/basename "$relative").opaque.bundle.range"
            output="$WORK_ROOT/$(/usr/bin/basename "$relative").opaque.out"
            error="$WORK_ROOT/$(/usr/bin/basename "$relative").opaque.err"
            write_opaque_bundle "$bundle" "" "$fixture"
            actual_status=0
            "$BUILD_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
                || actual_status=$?
            [[ "$actual_status" -eq 65 && ! -s "$error" ]] \
                || fail "$relative rejected at the wrong boundary"
            expected=$'compilerError\tkind=macroExecution\tdiagnosticKind=macroExecutionBodyInvalid'
            if [[ "$relative" == *OpaqueDirectConstruction.range ]]; then
                expected=$'compilerError\tkind=invalidEntryReachability'
            fi
            /usr/bin/grep -Fq "$expected" "$output" \
                || fail "$relative omitted its opaque-handle rejection"
        done

        local nil_int_fixture="$REPO_ROOT/Testing/Extern/Fail/NilIntArgument.range"
        local nil_int_bundle="$WORK_ROOT/nil-int-argument.range"
        local nil_int_output="$WORK_ROOT/nil-int-argument.out"
        local nil_int_error="$WORK_ROOT/nil-int-argument.err"
        write_opaque_bundle "$nil_int_bundle" "" "$nil_int_fixture"
        actual_status=0
        "$BUILD_EXECUTABLE" compile "$nil_int_bundle" > "$nil_int_output" 2> "$nil_int_error" \
            || actual_status=$?
        [[ "$actual_status" -eq 65 && ! -s "$nil_int_error" ]] \
            || fail "Core nil Int argument rejected at the wrong boundary"
        /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$nil_int_output" \
            || fail "Core nil Int argument omitted its exact rejection"
    fi

    echo "Macros Core @opaque native pthread handle and nullable foreign argument: pass"
}

check_range_view_native_window() {
    local color_macro="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Macros/Color.range"
    local color_fixture="$REPO_ROOT/Testing/RangeView/Pass/ColorCapability.range"
    local color_fail_fixture="$REPO_ROOT/Testing/RangeView/Fail/ColorCapabilityFunction.range"
    local color_bundle="$WORK_ROOT/range-view-color-capability.range"
    local color_llvm="$WORK_ROOT/range-view-color-capability.ll"
    local color_error="$WORK_ROOT/range-view-color-capability.err"
    local color_fail_bundle="$WORK_ROOT/range-view-color-capability-function.range"
    local color_fail_output="$WORK_ROOT/range-view-color-capability-function.out"
    local color_fail_error="$WORK_ROOT/range-view-color-capability-function.err"
    local geometry="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Drawing/Geometry.range"
    local style="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Drawing/Style.range"
    local shapes="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Drawing/Shapes.range"
    local iterable="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Macros/Iterable.range"
    local framework="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Native/Window.range"
    local color_native="$REPO_ROOT/RangeCompiler/Sources/Frameworks/RangeView/Native/Color.c"
    local fixture="$REPO_ROOT/Testing/RangeView/Pass/NativeWindow.range"
    local bundle="$WORK_ROOT/range-view-native-window.range"
    local llvm="$WORK_ROOT/range-view-native-window.ll"
    local error="$WORK_ROOT/range-view-native-window.err"
    local executable="$WORK_ROOT/range-view-native-window"
    local temporary="$WORK_ROOT/range-view-native-window.tmp"
    local sdl2_prefix actual_status native_pid

    write_opaque_bundle "$color_bundle" "" "$color_macro"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${color_fixture#"$REPO_ROOT/"}" >> "$color_bundle"
    /bin/cat "$color_fixture" >> "$color_bundle"
    /usr/bin/printf '\n' >> "$color_bundle"
    "$BUILD_EXECUTABLE" compile "$color_bundle" > "$color_llvm" 2> "$color_error" \
        || fail "RangeView @color capability fixture did not emit LLVM"
    [[ ! -s "$color_error" ]] || fail "RangeView @color capability fixture wrote stderr"
    /usr/bin/grep -Fq 'ret i32 42' "$color_llvm" \
        || fail "RangeView @color capability fixture omitted its runtime result"

    write_opaque_bundle "$color_fail_bundle" "" "$color_macro"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${color_fail_fixture#"$REPO_ROOT/"}" >> "$color_fail_bundle"
    /bin/cat "$color_fail_fixture" >> "$color_fail_bundle"
    /usr/bin/printf '\n' >> "$color_fail_bundle"
    actual_status=0
    "$BUILD_EXECUTABLE" compile "$color_fail_bundle" > "$color_fail_output" 2> "$color_fail_error" \
        || actual_status=$?
    [[ "$actual_status" -eq 65 && ! -s "$color_fail_error" ]] \
        || fail "RangeView @color accepted a Function target"
    /usr/bin/grep -Fq $'compilerError\tkind=macroLinking\tcount=1\tdiagnosticKind=macroTargetSurfaceMismatch' "$color_fail_output" \
        || fail "RangeView @color Function rejection omitted its exact boundary"

    write_opaque_bundle "$bundle" "" "$geometry"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${color_macro#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$color_macro" >> "$bundle"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${style#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$style" >> "$bundle"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${shapes#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$shapes" >> "$bundle"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${iterable#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$iterable" >> "$bundle"
    /usr/bin/printf '\ncompilerSourceFile\\trole=project\\tpath=%s\n' "${framework#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$framework" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$fixture" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    "$BUILD_EXECUTABLE" compile "$bundle" > "$llvm" 2> "$error" \
        || fail "RangeView native window did not emit LLVM"
    [[ ! -s "$error" ]] || fail "RangeView native window LLVM emission wrote stderr"
    [[ "$(/usr/bin/grep -Fxc '; range-link-v1 kind=library id=sdl2' "$llvm" || true)" -eq 1 ]] \
        || fail "RangeView native window omitted its typed SDL2 link requirement"
    /usr/bin/grep -Fq '%Range.Point = type { i32, i32 }' "$llvm" \
        || fail "RangeView native window omitted its framework Point value"
    /usr/bin/grep -Fq '%Range.Size = type { i32, i32 }' "$llvm" \
        || fail "RangeView native window omitted its framework Size value"
    /usr/bin/grep -Fq '%Range.DrawingSpace = type { ptr }' "$llvm" \
        || fail "RangeView native window omitted its framework DrawingSpace value"
    /usr/bin/grep -Fq '%Range.Rectangle = type { ptr, ptr }' "$llvm" \
        || fail "RangeView native window omitted its Point-and-Size Rectangle"
    /usr/bin/grep -Fq '%Range.OKLCH = type { double, double, double, double }' "$llvm" \
        || fail "RangeView native window omitted its concrete OKLCH color value"
    /usr/bin/grep -Fq '%Range.RGBA = type { i8, i8, i8, i8 }' "$llvm" \
        || fail "RangeView native window omitted its RGBA lowering product"
    /usr/bin/grep -Fq '%Range.Shape = type { i32, %Range.Line, %Range.Rectangle, %Range.Circle, %Range.Polygon }' "$llvm" \
        || fail "RangeView native window omitted its heterogeneous Shape value"
    /usr/bin/grep -Fq 'declare ptr @SDL_CreateWindow(ptr, i32, i32, i32, i32, i32)' "$llvm" \
        || fail "RangeView native window omitted its typed window declaration"
    /usr/bin/grep -Fq 'declare ptr @SDL_CreateRenderer(ptr, i32, i32)' "$llvm" \
        || fail "RangeView native window omitted its typed renderer declaration"
    /usr/bin/grep -Fq 'call void @SDL_ShowWindow' "$llvm" \
        || fail "RangeView native window did not explicitly show its window"
    /usr/bin/grep -Fq 'call void @SDL_RaiseWindow' "$llvm" \
        || fail "RangeView native window did not raise its window"
    /usr/bin/grep -Fq 'define i1 @rangeViewWindowShouldClose(ptr %window)' "$llvm" \
        || fail "RangeView native window omitted its typed Window close-query boundary"
    /usr/bin/grep -Fq 'call i1 @rangeViewWindowShouldClose(ptr ' "$llvm" \
        || fail "RangeView native window did not route its event loop through the Window value"
    /usr/bin/grep -Fq 'declare i32 @SDL_HasEvent(i32)' "$llvm" \
        || fail "RangeView native window omitted its typed SDL event query"
    /usr/bin/grep -Fq 'call i32 @SDL_HasEvent(i32 256)' "$llvm" \
        || fail "RangeView native window did not query the SDL quit event"
    /usr/bin/grep -Fq 'declare i32 @SDL_SetRenderDrawColor(ptr, i8, i8, i8, i8)' "$llvm" \
        || fail "RangeView native window omitted its unsigned-byte color ABI"
    /usr/bin/grep -Fq 'declare i8 @rangeViewOKLCHChannel(double, double, double, double, i32)' "$llvm" \
        || fail "RangeView native window omitted its Float-backed OKLCH conversion declaration"
    /usr/bin/grep -Fq 'define i32 @rangeViewFillRectangle(ptr %renderer, %Range.Rectangle %rectangle)' "$llvm" \
        || fail "RangeView native window omitted its filled rectangle boundary"
    /usr/bin/grep -Fq 'define i32 @rangeViewFillCircle(ptr %renderer, %Range.Circle %circle)' "$llvm" \
        || fail "RangeView native window omitted its filled Circle boundary"
    /usr/bin/grep -Fq 'define i32 @rangeViewDrawPolygon(ptr %renderer, %Range.Polygon %polygon)' "$llvm" \
        || fail "RangeView native window omitted its Polygon boundary"
    /usr/bin/grep -Fq 'define i32 @rangeViewDrawShapeGallery(ptr %renderer)' "$llvm" \
        || fail "RangeView native window omitted its collection-driven shape gallery"
    /usr/bin/grep -Fq 'call void @toRGBA(ptr ' "$llvm" \
        || fail "RangeView native window did not lower Color through toRGBA"
    /usr/bin/grep -Fq 'call i32 @rangeViewDrawShapeGallery(ptr ' "$llvm" \
        || fail "RangeView native window did not draw through its shape gallery"
    /usr/bin/grep -Eq 'alloca %Range\.Shape, i32 4' "$llvm" \
        || fail "RangeView native window omitted its four-value Shape collection"
    /usr/bin/grep -Eq 'alloca %Range\.OKLCH, i32 4' "$llvm" \
        || fail "RangeView native window omitted its four-value OKLCH collection"
    /usr/bin/grep -Fq 'call void @SDL_RenderPresent' "$llvm" \
        || fail "RangeView native window omitted its Void presentation call"
    /usr/bin/grep -Fq 'declare void @SDL_PumpEvents()' "$llvm" \
        || fail "RangeView native window omitted its event-pump declaration"
    /usr/bin/grep -Fq 'call void @SDL_PumpEvents()' "$llvm" \
        || fail "RangeView native window did not service its native event queue"
    /usr/bin/grep -Fq 'declare void @SDL_Delay(i32)' "$llvm" \
        || fail "RangeView native window omitted its SDL frame-delay declaration"
    /usr/bin/grep -Fq 'call void @SDL_Delay(i32 16)' "$llvm" \
        || fail "RangeView native window omitted its event-loop frame delay"
    ! /usr/bin/grep -Fq 'i32 10000' "$llvm" \
        || fail "RangeView native window retained a time-bounded event loop"
    /usr/bin/grep -Fq 'call void @SDL_DestroyRenderer' "$llvm" \
        || fail "RangeView native window omitted renderer destruction"
    /usr/bin/grep -Fq 'call void @SDL_DestroyWindow' "$llvm" \
        || fail "RangeView native window omitted window destruction"
    /usr/bin/grep -Fq 'call void @SDL_Quit' "$llvm" \
        || fail "RangeView native window omitted SDL shutdown"
    validate_llvm "$llvm"

    command -v sdl2-config >/dev/null 2>&1 \
        || fail "RangeView native window proof requires sdl2-config"
    sdl2_prefix="$(sdl2-config --prefix)"
    [[ -d "$sdl2_prefix/lib" ]] || fail "RangeView native window could not resolve SDL2 libraries"
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$llvm" "$color_native" "${RUNTIME_INPUTS[@]}" \
        -L"$sdl2_prefix/lib" -lSDL2 -Wl,-rpath,"$sdl2_prefix/lib" -o "$temporary"
    /bin/mv "$temporary" "$executable"
    "$executable" &
    native_pid=$!
    /bin/sleep 1
    /bin/kill -0 "$native_pid" 2>/dev/null \
        || fail "RangeView native window did not remain alive for event-driven termination"
    /bin/kill "$native_pid"
    actual_status=0
    wait "$native_pid" || actual_status=$?
    [[ "$actual_status" -eq 42 ]] \
        || fail "RangeView native window termination returned $actual_status, expected graceful result 42"
    echo "RangeView native @app page window remains alive until termination and tears down gracefully: pass"
}

write_hashable_bundle() {
    local output="$1"
    local fixture="$2"
    /usr/bin/printf '%s\n' \
        'compilerMacroSnapshot' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/HashableReflection.range' \
        '@builtin' \
        'construct Array<Element> {}' \
        '' \
        'macro member(): Declaration | Member -> Void {}' \
        '' \
        'construct Identity {' \
        '    let name: String' \
        '}' \
        '' \
        'construct MacroDiagnostics {' \
        '    function error(_ message: String)' \
        '}' \
        '' \
        '@member' \
        'construct Let {' \
        '    let identity: Identity' \
        '}' \
        '' \
        'construct Construct {' \
        '    construct Declaration {' \
        '        let identity: Identity' \
        '        let members: Array<@member>' \
        '    }' \
        '}' > "$output"
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Hashable.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Hashable.range" >> "$output"
    /usr/bin/printf '\n' >> "$output"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$output"
    /bin/cat "$fixture" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

check_hashable_function_synthesis() {
    local pass_fixture="$REPO_ROOT/Testing/Macros/Pass/HashableFunctionSynthesis.range"
    local missing_fixture="$REPO_ROOT/Testing/Macros/Fail/HashableRequiresIdentity.range"
    local pass_bundle="$WORK_ROOT/hashable-function.pass.range"
    local missing_bundle="$WORK_ROOT/hashable-function.missing.range"
    local pass_output="$WORK_ROOT/hashable-function.pass.out"
    local missing_output="$WORK_ROOT/hashable-function.missing.out"
    local pass_error="$WORK_ROOT/hashable-function.pass.err"
    local missing_error="$WORK_ROOT/hashable-function.missing.err"
    local actual_status

    write_hashable_bundle "$pass_bundle" "$pass_fixture"
    write_hashable_bundle "$missing_bundle" "$missing_fixture"

    "$BUILD_EXECUTABLE" compile "$pass_bundle" > "$pass_output" 2> "$pass_error" \
        || fail "Core @hashable function synthesis did not compile: $(/usr/bin/head -n 1 "$pass_output")"
    [[ ! -s "$pass_error" ]] || fail "Core @hashable function synthesis wrote stderr"
    /usr/bin/grep -Eq $'macroGraphGeneratedFunction\trow=0\tkind=function\townerSyntaxID=[0-9]+\tplacement=1.*\tname=hash\treturnType=Int' "$pass_output" \
        || fail "@hashable did not synthesize its target-owned hash function"
    [[ "$(/usr/bin/grep -F -c 'macroGraphGeneratedFunction' "$pass_output" || true)" -eq 1 ]] \
        || fail "@hashable generated declarations other than hash"

    actual_status=0
    "$BUILD_EXECUTABLE" compile "$missing_bundle" > "$missing_output" 2> "$missing_error" \
        || actual_status=$?
    [[ "$actual_status" -eq 65 && ! -s "$missing_error" ]] \
        || fail "@hashable missing-id control rejected at the wrong boundary"
    /usr/bin/grep -Fq '@hashable requires exactly one id declaration.' "$missing_output" \
        || fail "@hashable missing-id control omitted its diagnostic"

    echo "Macros Core @hashable function synthesis: pass"
}

check_many_relationship_registration() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/ManyRelationshipRegistration.range"
    local bundle="$WORK_ROOT/macro-many-relationship-registration.range"
    local output="$WORK_ROOT/macro-many-relationship-registration.out"
    local repeat_output="$WORK_ROOT/macro-many-relationship-registration.repeat.out"
    local plotter_bundle="$WORK_ROOT/macro-many-relationship-registration.plotter.range"
    local plotter_output="$WORK_ROOT/macro-many-relationship-registration.plotter.out"
    local error="$WORK_ROOT/macro-many-relationship-registration.err"
    local repeat_error="$WORK_ROOT/macro-many-relationship-registration.repeat.err"
    local registration_identity="$WORK_ROOT/macro-many-relationship-registration.uuid"
    local repeat_registration_identity="$WORK_ROOT/macro-many-relationship-registration.repeat.uuid"
    local relationship_source="$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Program/Relationship.range"
    local many_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Many.range"
    local contents_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Contents.range"
    local block_registration_source="$REPO_ROOT/RangeCompiler/Sources/Core/Macro/Block.range"
    local block_source="$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Bodies/Block.range"

    [[ -f "$fixture" && -f "$relationship_source" && -f "$many_source" && -f "$contents_source" && -f "$block_registration_source" && -f "$block_source" ]] \
        || fail "missing Core many-relationship source or fixture"
    /usr/bin/printf '%s\n' \
        'compilerMacroSnapshot' \
        'compilerSourceFile\trole=core\tpath=Core/RelationshipRegistrationPrelude.range' \
        '@builtin' \
        'construct Array<Element> {}' \
        '' \
        'construct TypeReference {}' \
        'construct Expression {}' \
        '' \
        'construct Identity {' \
        '    let name: String' \
        '    let id: String' \
        '    let parent: Identity?' \
        '    let source: @syntax?' \
        '}' \
        '' \
        'construct Macro {' \
        '    construct Declaration {}' \
        '}' \
        '' \
        'construct MacroApplication {' \
        '    let identity: Identity' \
        '    let target: Identity' \
        '    let genericArguments: Array<TypeReference>' \
        '    let argumentClause: String' \
        '    let arguments: Array<Expression>' \
        '    let declaration: Macro.Declaration?' \
        '    let packageVisibility: String' \
        '    let valueType: TypeReference' \
        '    let value: RelationshipRegistration' \
        '}' \
        '' \
        'construct Member {' \
        '    let macros: Array<MacroApplication>' \
        '}' \
        '' \
        'construct Construct {}' \
        'macro syntax(): Construct -> Void {}' \
        '' \
        'enum DelimiterPair {' \
        '    case parentheses' \
        '    case braces' \
        '    case brackets' \
        '    case angles' \
        '}' > "$bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Syntax/Program/Relationship.range' >> "$bundle"
    /bin/cat "$relationship_source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Many.range' >> "$bundle"
    /bin/cat "$many_source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Contents.range' >> "$bundle"
    /bin/cat "$contents_source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Macro/Block.range' >> "$bundle"
    /bin/cat "$block_registration_source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/Syntax/Bodies/Block.range' >> "$bundle"
    /bin/cat "$block_source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
    /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "${fixture#"$REPO_ROOT/"}" >> "$bundle"
    /bin/cat "$fixture" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"

    "$BUILD_EXECUTABLE" compile "$bundle" > "$output" 2> "$error" \
        || fail "Core many and contents registrations did not compile: $(/usr/bin/head -n 1 "$output")"
    [[ ! -s "$error" ]] || fail "Core many and contents registrations wrote stderr"
    "$BUILD_EXECUTABLE" compile "$bundle" > "$repeat_output" 2> "$repeat_error" \
        || fail "repeated Core many and contents registrations did not compile: $(/usr/bin/head -n 1 "$repeat_output")"
    [[ ! -s "$repeat_error" ]] || fail "repeated Core many and contents registrations wrote stderr"
    /usr/bin/sed '1s/compilerMacroSnapshot/compilerMacroGraph/' "$bundle" > "$plotter_bundle"
    "$BUILD_EXECUTABLE" compile "$plotter_bundle" > "$plotter_output" 2> "$error" \
        || fail "Core relationship registrations did not project into the macro graph: $(/usr/bin/head -n 1 "$plotter_output")"
    [[ ! -s "$error" ]] || fail "Core relationship macro graph wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true' "$output" \
        || fail "Core many and contents registrations did not execute"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true' "$repeat_output" \
        || fail "repeated Core many and contents registrations did not execute"
    [[ "$(/usr/bin/grep -Ec '^macroContribution\t' "$output")" -eq 0 ]] \
        || fail "Core relationship values unexpectedly used the syntax-emission contribution path"
    /usr/bin/grep -Eq $'^macroResult\trow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\tkind=3\ttypeKind=4\t.*\tchildCount=5\tparentRow=-1\tordinal=0\trelationshipRow=-1$' "$output" \
        || fail "Core many registration did not retain all relationship dimensions"
    /usr/bin/grep -Eq $'^macroResult\trow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\tkind=4\ttypeKind=9\tnominalSyntaxID=[1-9][0-9]*\tscalar=1\tchildCount=1\tparentRow=[0-9]+\tordinal=3\trelationshipRow=-1$' "$output" \
        || fail "Core contents registration did not retain its delimited enclosure identity"
    /usr/bin/grep -Eq $'^macroResult\trow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\tkind=4\ttypeKind=9\tnominalSyntaxID=[1-9][0-9]*\tscalar=1\tchildCount=0\tparentRow=[0-9]+\tordinal=0\trelationshipRow=-1$' "$output" \
        || fail "Core contents registration did not retain its braces delimiter identity"
    /usr/bin/grep -Eq $'^macroResult\trow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\tkind=4\ttypeKind=9\tnominalSyntaxID=[1-9][0-9]*\tscalar=1\tchildCount=0\tparentRow=[0-9]+\tordinal=4\trelationshipRow=-1$' "$output" \
        || fail "Core relationship registration did not retain admission identity"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=values\townerSyntaxID=[0-9]+\townerName=RelationshipRegistrationTarget\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=0\tdelimiterPair=-1\tadmission=0$' "$output" \
        || fail "the compiler did not decode the authored @many registration onto its target member"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=scalars\townerSyntaxID=[0-9]+\townerName=Character\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=0\tdelimiterPair=-1\tadmission=0$' "$output" \
        || fail "the compiler did not decode Character.scalars as an authored ordered-many relationship"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=characters\townerSyntaxID=[0-9]+\townerName=TextModel\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=0\tdelimiterPair=-1\tadmission=0$' "$output" \
        || fail "the compiler did not decode text characters as an authored ordered-many relationship"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=bytes\townerSyntaxID=[0-9]+\townerName=UUID\tminimum=16\tmaximumKind=1\tmaximum=16\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=0\tdelimiterPair=-1\tadmission=0$' "$output" \
        || fail "the compiler did not decode UUID.bytes as an exact ordered sixteen-byte relationship"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=bytes\townerSyntaxID=[0-9]+\townerName=UUID\tminimum=16\tmaximumKind=1\tmaximum=16\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=0\tdelimiterPair=-1\tadmission=0$' "$repeat_output" \
        || fail "the repeated compiler evaluation did not decode UUID.bytes as an exact ordered sixteen-byte relationship"
    /usr/bin/grep -E $'^relationshipRegistration\t.*\ttargetName=bytes\t.*\townerName=UUID\t' "$output" > "$registration_identity"
    /usr/bin/grep -E $'^relationshipRegistration\t.*\ttargetName=bytes\t.*\townerName=UUID\t' "$repeat_output" > "$repeat_registration_identity"
    /usr/bin/cmp -s "$registration_identity" "$repeat_registration_identity" \
        || fail "Core @many(16) UUID.bytes relationship identity changed across repeated evaluation"
    echo "Macros Core @many(16) deterministic relationship registration: pass"
    /usr/bin/grep -Fq $'macroGraphExecution\tvalid=true\tslotRegistrationStatus=0\ttablesValid=true\t' "$plotter_output" \
        || fail "Core relationship macro graph did not execute and register its slot model"
    [[ "$(/usr/bin/grep -Ec $'^macroGraphRelationshipSlot\\t' "$plotter_output" || true)" -eq 4 ]] \
        || fail "Core relationship registrations did not create one reusable relationship-values slot per annotated member"
    /usr/bin/grep -Eq $'^macroGraphRelationshipSlot\\trow=[0-9]+\\ttargetMemberSyntaxID=[0-9]+\\tminimum=16\\tmaximumKind=1\\tmaximum=16\\tordering=1\\tseparatorKind=0\\tenclosureKind=0\\tadmission=0$' "$plotter_output" \
        || fail "Core @many(16) UUID.bytes did not retain its finite cardinality on a graph relationship-values slot"
    [[ "$(/usr/bin/grep -Ec $'^macroGraphRelationshipSlot\\t.*\\tminimum=0\\tmaximumKind=2\\tmaximum=-1\\tordering=1\\tseparatorKind=0\\tenclosureKind=0\\tadmission=0$' "$plotter_output" || true)" -ge 3 ]] \
        || fail "Core ordered-many registrations did not retain their graph slot cardinality"
    echo "Macros Core relationship registration slots: pass"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=RelationshipRegistrationTarget\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=1\tdelimiterPair=1\tadmission=1$' "$output" \
        || fail "the compiler did not decode the authored @contents registration onto its target member"
    /usr/bin/grep -Eq $'^relationshipRegistration\trow=[0-9]+\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=Block\tminimum=0\tmaximumKind=2\tmaximum=-1\tordering=1\tseparatorKind=0\tseparatorValueResultRow=-1\tenclosureKind=1\tdelimiterPair=1\tadmission=1$' "$output" \
        || fail "the compiler did not decode Core Block.contents as an authored enclosed relationship"
    /usr/bin/grep -Eq $'^blockRegistration\trow=0\tresultRow=[0-9]+\tinvocationRow=[0-9]+\tapplicationRow=[0-9]+\ttargetMemberSyntaxID=[0-9]+\ttargetName=contents\townerSyntaxID=[0-9]+\townerName=Block\trelationshipRow=[0-9]+$' "$output" \
        || fail "the compiler did not bind Core Block.contents to its authored block form"
    echo "Macros Core many-relationship-registration: pass"
}

