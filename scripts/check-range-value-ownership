#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Source the candidate harness so this checkpoint uses its canonical source
# discovery, value ownership fixture writer, compiler invocation, and LLVM helpers.
source "$SCRIPT_DIR/check-range-compiler-candidate"
source "$SCRIPT_DIR/resolve-range-stage2-compiler"

# Value ownership is the tight compiler-development loop. Its Stage 2 artifact is
# deliberately disposable and fast to link; optimized/LTO artifacts remain the
# responsibility of smoke, candidate, fixed-point, and promotion gates.
RANGE_STAGE2_PROFILE="development"
SEED_COMPILER_OPTIMIZATION="-O2"
SEED_COMPILER_LTO="-flto=thin"
COMPILER_OPTIMIZATION="-O0"
COMPILER_LTO="-fno-lto"

usage() {
    cat <<'USAGE'
Usage:
  scripts/check-range-value-ownership [DIR]
  scripts/check-range-value-ownership --controls [DIR]
  scripts/check-range-value-ownership --help

DIR defaults to RangeCompiler/Sources/Compiler. The command resolves a
content-addressed development Stage 2 compiler (-O0, no LTO) for the current
accepted seed, runtime, and compiler sources, then validates only the ordinary
value-ownership boundary-forward-mixed case.
The controls mode runs the complete neighboring value-ownership positive and
negative fixture set against the same cached Stage 2 compiler. Both modes first verify
the focused @project scalar-default and @storage/@literal fixtures against
that compiler.
USAGE
}

check_project_defaults_fixture() {
    local label="$1"
    local relative="$2"
    local expected_status="$3"
    local expected_text="$4"
    local fixture="$REPO_ROOT/$relative"
    local output="$WORK_ROOT/project-defaults-$label.out"
    local error="$WORK_ROOT/project-defaults-$label.err"
    local actual_status

    [[ -f "$fixture" ]] || fail "missing project-defaults fixture: $relative"
    if "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq "$expected_status" ]] \
        || fail "ProjectDefaults $label exited $actual_status, expected $expected_status"
    [[ ! -s "$error" ]] || fail "ProjectDefaults $label wrote stderr"
    /usr/bin/grep -Fq "$expected_text" "$output" \
        || fail "ProjectDefaults $label omitted expected result: $expected_text"
    echo "ProjectDefaults $label: pass"
}

check_project_integer_lowering() {
    local label="$1"
    local relative="$2"
    local expected_instruction="$3"
    local fixture="$REPO_ROOT/$relative"
    local llvm="$WORK_ROOT/project-defaults-$label.ll"

    [[ -f "$fixture" ]] || fail "missing project-defaults lowering fixture: $relative"
    "$STAGE2_EXECUTABLE" emit-llvm "$fixture" "$llvm" \
        || fail "ProjectDefaults $label did not emit LLVM"
    /usr/bin/grep -Fq "$expected_instruction" "$llvm" \
        || fail "ProjectDefaults $label omitted expected lowering: $expected_instruction"
    validate_llvm "$llvm"
    echo "ProjectDefaults $label: pass"
}

check_target_pointer_bits_runtime() {
    local fixture="$REPO_ROOT/Testing/ProjectDefaults/Pass/TargetPointerBitsRuntime.range"
    local llvm="$WORK_ROOT/project-defaults-target-pointer-bits-runtime.ll"
    local executable="$WORK_ROOT/project-defaults-target-pointer-bits-runtime"
    local actual_status

    "$STAGE2_EXECUTABLE" emit-llvm "$fixture" "$llvm" \
        || fail "ProjectDefaults target-pointer-bits-runtime did not emit LLVM"
    /usr/bin/grep -Fq 'call i32 @targetPointerBits()' "$llvm" \
        || fail "ProjectDefaults target-pointer-bits-runtime omitted the builtin call"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$executable"
    if "$executable"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 64 ]] \
        || fail "ProjectDefaults target-pointer-bits-runtime returned $actual_status, expected 64"
    echo "ProjectDefaults target-pointer-bits-runtime: pass"
}

check_unregistered_string_reads_rejected() {
    local relative fixture output error actual_status
    for relative in \
        Testing/Storage/Fail/UnregisteredStringReadBuiltin.range \
        Testing/Storage/Fail/UnregisteredStringByteReadBuiltin.range; do
        fixture="$REPO_ROOT/$relative"
        output="$WORK_ROOT/$(/usr/bin/basename "$relative").out"
        error="$WORK_ROOT/$(/usr/bin/basename "$relative").err"
        actual_status=0
        "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
            || actual_status=$?
        [[ "$actual_status" -eq 65 && ! -s "$error" ]] \
            || fail "$relative rejected at the wrong boundary"
        /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$output" \
            || fail "$relative omitted its unresolved-entry rejection"
    done
    echo "Storage unregistered string read builtin: pass"
}

check_range_native_project_macro() {
    local fixture="$REPO_ROOT/Testing/ProjectDefaults/Pass/RangeNativeProject.range"
    local override_fixture="$REPO_ROOT/Testing/ProjectDefaults/Pass/RangeNativeProjectOverride.range"
    local output="$WORK_ROOT/project-defaults-range-native.out"
    local override_output="$WORK_ROOT/project-defaults-range-native-override.out"
    local error="$WORK_ROOT/project-defaults-range-native.err"
    local integer_count bool_count override_integer_count override_bool_count

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Range-native project macro did not compile"
    [[ ! -s "$error" ]] || fail "Range-native project macro wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=1' "$output" \
        || fail "Range-native project macro did not execute through target capabilities"
    /usr/bin/grep -Fq $'name=integer\tmemberKind=state\ttype=Int' "$output" \
        || fail "Range-native project macro did not expand the integer default"
    /usr/bin/grep -Fq $'name=bool\tmemberKind=state\ttype=Bool' "$output" \
        || fail "Range-native project macro did not expand the bool default"
    /usr/bin/grep -Fq $'readDependencyCount=0' "$output" \
        || fail "Range-native project macro reported unexpected legacy graph reads"
    integer_count="$(/usr/bin/grep -F -c $'name=integer\tmemberKind=state\ttype=Int' "$output" || true)"
    bool_count="$(/usr/bin/grep -F -c $'name=bool\tmemberKind=state\ttype=Bool' "$output" || true)"
    [[ "$integer_count" -eq 1 && "$bool_count" -eq 1 ]] \
        || fail "Range-native project macro did not expand exactly one integer and one bool default"
    "$STAGE2_EXECUTABLE" compile "$override_fixture" > "$override_output" 2> "$error" \
        || fail "Range-native project override did not compile"
    [[ ! -s "$error" ]] || fail "Range-native project override wrote stderr"
    /usr/bin/grep -Fq $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=4\tintegerOverridden=true\tboolOverridden=false' "$override_output" \
        || fail "Range-native project macro did not preserve the explicit integer override"
    /usr/bin/grep -Fq $'name=bool\tmemberKind=state\ttype=Bool' "$override_output" \
        || fail "Range-native project macro did not expand the missing bool default"
    override_integer_count="$(/usr/bin/grep -F -c $'name=integer\tmemberKind=state\ttype=Int' "$override_output" || true)"
    override_bool_count="$(/usr/bin/grep -F -c $'name=bool\tmemberKind=state\ttype=Bool' "$override_output" || true)"
    [[ "$override_integer_count" -eq 0 && "$override_bool_count" -eq 1 ]] \
        || fail "Range-native project macro did not preserve one integer override and expand exactly one bool default"
    echo "ProjectDefaults range-native-project: pass"
}

check_removed_for_statement_rejected() {
    local fixture="$REPO_ROOT/Testing/ControlFlow/Fail/RemovedForStatement.range"
    local output="$WORK_ROOT/control-flow-removed-for.out"
    local error="$WORK_ROOT/control-flow-removed-for.err"
    local actual_status

    if "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        actual_status=0
    else
        actual_status=$?
    fi

    [[ "$actual_status" -eq 65 ]] \
        || fail "removed for statement exited $actual_status instead of 65"
    [[ ! -s "$error" ]] \
        || fail "removed for statement rejection wrote stderr"
    /usr/bin/grep -Fqx \
        $'compilerError\tkind=invalidEntryReachability\tstage=1093' \
        "$output" \
        || fail "removed for statement did not fail at the exact entry-body syntax boundary"
    if /usr/bin/grep -Fq 'define ' "$output"; then
        fail "removed for statement emitted LLVM"
    fi

    echo "ControlFlow removed-for-statement-rejected: pass"
}

check_macro_environment() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/Environment.range"
    local output="$WORK_ROOT/macro-environment.out"
    local error="$WORK_ROOT/macro-environment.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "single-binding macro environment did not compile"
    [[ ! -s "$error" ]] || fail "single-binding macro environment wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=1\teventCount=1' "$output" \
        || fail "single-binding macro environment did not execute through one capability handle"
    /usr/bin/grep -Fq $'readDependencyCount=1' "$output" \
        || fail "single-binding macro environment did not record its graph read"
    /usr/bin/grep -Fq $'severity=1\toperation=1\tmessage=environment observed' "$output" \
        || fail "single-binding macro environment did not emit its diagnostic"
    echo "Macros single-binding-environment: pass"
}

check_non_generic_stored_assignment() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/NonGenericStoredAssignment.range"
    local output="$WORK_ROOT/macro-non-generic-stored-assignment.out"
    local error="$WORK_ROOT/macro-non-generic-stored-assignment.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "non-generic stored Assignment did not compile"
    [[ ! -s "$error" ]] || fail "non-generic stored Assignment wrote stderr"
    /usr/bin/grep -Fq $'typedSyntax\tvalid=true\tidentityScope=pathStable,pathlessSnapshotLocal\tfileCount=1\tsyntaxCount=4\tdeclarationCount=2\tmemberCount=2\tfunctionCount=0\tparameterCount=0\tgenericParameterCount=0' "$output" \
        || fail "non-generic stored Assignment did not preserve its two-member declaration shape"
    /usr/bin/grep -Eq $'member\\trow=0\\t.*parentSyntaxID=1\\tordinal=0\\t.*name=identifier\\t.*type=Identifier\\t' "$output" \
        || fail "non-generic stored Assignment did not place identifier in key slot 0"
    /usr/bin/grep -Eq $'member\\trow=1\\t.*parentSyntaxID=1\\tordinal=1\\t.*name=value\\t.*type=@stored\\t' "$output" \
        || fail "non-generic stored Assignment did not place its @stored value in slot 1"
    echo "Macros non-generic-stored-assignment: pass"
}

check_block_value_shape_identity() {
    local fixture="$REPO_ROOT/Testing/Syntax/Pass/BlockValueShapeIdentity.range"
    local output="$WORK_ROOT/block-value-shape-identity.out"
    local error="$WORK_ROOT/block-value-shape-identity.err"
    local shape

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Block value/shape identity fixture did not compile"
    [[ ! -s "$error" ]] || fail "Block value/shape identity fixture wrote stderr"
    /usr/bin/grep -Fq $'typedSyntax\tvalid=true' "$output" \
        || fail "Block value/shape identity fixture did not produce valid typed syntax"
    [[ "$(/usr/bin/grep -Ec $'^genericParameter\t.*name=Value\t.*kind=type\t' "$output" || true)" -eq 2 ]] \
        || fail "Block and Closure.Literal did not both retain their Value type identity parameter"
    [[ "$(/usr/bin/grep -Ec $'^genericParameter\t.*name=shape\t.*kind=value\t' "$output" || true)" -eq 2 ]] \
        || fail "Block and Closure.Literal did not both retain their shape value identity parameter"
    /usr/bin/grep -Fq $'name=body\tnameStart=371\tnameEnd=375\ttype=Block<Value, shape>' "$output" \
        || fail "Closure.Literal did not forward Value and shape to Block"
    for shape in parentheses braces brackets angles; do
        /usr/bin/grep -Fq "type=Block<Int, .$shape>" "$output" \
            || fail "Block identity fixture omitted .$shape specialization"
    done
    /usr/bin/grep -Fq $'bodyNode\trow=0\tvalues=16,0,15,0,623,637,622,623,637,638,2' "$output" \
        || fail "authored brace block did not retain its opening token, closing token, and brace-pair value"
    echo "Syntax Block value/shape identity: pass"
}

check_block_source_layout() {
    local fixture="$REPO_ROOT/Testing/Syntax/Pass/BlockSourceLayout.range"
    local output="$WORK_ROOT/block-source-layout.out"
    local error="$WORK_ROOT/block-source-layout.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Block source-layout fixture did not compile"
    [[ ! -s "$error" ]] || fail "Block source-layout fixture wrote stderr"
    /usr/bin/grep -Fq $'typedSyntax\tvalid=true\tidentityScope=pathStable,pathlessSnapshotLocal\tfileCount=1\tsyntaxCount=8\tdeclarationCount=1\tmemberCount=0\tfunctionCount=1\tparameterCount=0\tgenericParameterCount=0\ttypeReferenceCount=0\tslotCount=2\tslotOccurrenceCount=3\tbodyNodeCount=7\tbodyEdgeCount=7\tsourceGapCount=4' "$output" \
        || fail "Block source-layout fixture did not register its contents slot and occurrences"
    /usr/bin/grep -Fq $'typedTable\tname=syntaxSlot\tversion=1\tcolumns=15\trows=2' "$output" \
        || fail "Block source-layout fixture did not retain its generic slot metadata"
    /usr/bin/grep -Fq $'syntaxSlot\trow=1\tvalues=1,1,1,3,0,0,2,-1,1,0,-1,2,1,0,1' "$output" \
        || fail "Block source-layout fixture did not register brace-enclosed block contents with its admission environment"
    /usr/bin/grep -Fq $'typedTable\tname=slotOccurrence\tversion=1\tcolumns=5\trows=3' "$output" \
        || fail "Block source-layout fixture did not retain ordered contents occurrences"
    /usr/bin/grep -Fq $'slotOccurrence\trow=0\tvalues=0,1,1,3,0' "$output" \
        || fail "Block source-layout fixture did not retain its first contents occurrence"
    /usr/bin/grep -Fq $'slotOccurrence\trow=1\tvalues=1,1,1,5,1' "$output" \
        || fail "Block source-layout fixture did not retain its second contents occurrence"
    /usr/bin/grep -Fq $'slotOccurrence\trow=2\tvalues=2,1,1,7,2' "$output" \
        || fail "Block source-layout fixture did not retain its third contents occurrence"
    /usr/bin/grep -Fq $'typedTable\tname=sourceGap\tversion=1\tcolumns=11\trows=4' "$output" \
        || fail "Block source-layout fixture did not retain one gap before, between, and after its contents"
    /usr/bin/grep -Eq $'^sourceGap\trow=0\tvalues=[0-9]+,0,1,[0-9]+,2,[0-9]+,[0-9]+,[0-9]+,1,4,0$' "$output" \
        || fail "Block source-layout fixture did not retain the opening newline and four-space indent"
    /usr/bin/grep -Eq $'^sourceGap\trow=1\tvalues=[0-9]+,1,2,[0-9]+,2,[0-9]+,[0-9]+,[0-9]+,2,1,1$' "$output" \
        || fail "Block source-layout fixture did not retain the blank line and mixed space-tab indent"
    /usr/bin/grep -Eq $'^sourceGap\trow=2\tvalues=[0-9]+,2,2,[0-9]+,2,[0-9]+,[0-9]+,[0-9]+,1,4,0$' "$output" \
        || fail "Block source-layout fixture did not retain the next four-space indent"
    /usr/bin/grep -Eq $'^sourceGap\trow=3\tvalues=[0-9]+,3,2,[0-9]+,3,[0-9]+,[0-9]+,[0-9]+,1,0,0$' "$output" \
        || fail "Block source-layout fixture did not retain the closing newline without indentation"
    echo "Syntax Block source-layout: pass"
}

check_postfix_zero_or_one_occurrence() {
    local fixture="$REPO_ROOT/Testing/Syntax/Pass/PostfixZeroOrOneOccurrence.range"
    local output="$WORK_ROOT/postfix-zero-or-one-occurrence.out"
    local error="$WORK_ROOT/postfix-zero-or-one-occurrence.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "postfix zero-or-one occurrence fixture did not compile"
    [[ ! -s "$error" ]] || fail "postfix zero-or-one occurrence fixture wrote stderr"
    /usr/bin/grep -Fq $'typedSyntax\tvalid=true' "$output" \
        || fail "postfix zero-or-one occurrence fixture did not produce valid typed syntax"
    /usr/bin/grep -Eq $'^typeReference\tid=0\t.*kind=zeroOrOneOccurrence\ttargetKind=none\ttargetID=-1\tchildCount=1\t' "$output" \
        || fail "postfix question mark was not recorded as a zero-or-one occurrence relationship"
    /usr/bin/grep -Eq $'^typeReference\tid=1\t.*parent=0\tordinal=0\tkind=named\ttargetKind=builtin\ttargetID=3\tchildCount=0\t' "$output" \
        || fail "postfix zero-or-one occurrence did not preserve String as its underlying identity"
    echo "Syntax postfix zero-or-one occurrence: pass"
}

check_legacy_macro_modifiers_rejected() {
    local output="$WORK_ROOT/macro-legacy-modifier.out"
    local error="$WORK_ROOT/macro-legacy-modifier.err"
    local actual_status

    for modifier in Open Closed; do
        if "$STAGE2_EXECUTABLE" compile "$REPO_ROOT/Testing/Macros/Fail/Legacy${modifier}MacroModifier.range" > "$output" 2> "$error"; then
            actual_status=0
        else
            actual_status=$?
        fi
        [[ "$actual_status" -eq 65 ]] \
            || fail "legacy ${modifier,,} macro modifier exited $actual_status instead of 65"
        [[ ! -s "$error" ]] || fail "legacy ${modifier,,} macro modifier wrote stderr"
        /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedDeclarations' "$output" \
            || fail "legacy ${modifier,,} macro modifier did not fail typed declaration validation"
    done
    echo "Macros legacy-open-closed-modifiers-rejected: pass"
}

