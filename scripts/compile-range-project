#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Reuse the compiler proof harness's canonical accepted-bootstrap verification and
# manifest helpers. Ordinary compilation runs the promoted native compiler
# directly; candidate construction remains isolated in the proof commands.
source "$SCRIPT_DIR/check-range-compiler-candidate"

compile_project_fail() {
    echo "range: $*" >&2
    exit 1
}

verify_compiler_authority() {
    [[ "$(manifest_value formatVersion)" == "1" ]] \
        || compile_project_fail "unsupported bootstrap manifest format"
    [[ "$(manifest_value target.platform)" == "macOS" ]] \
        || compile_project_fail "unsupported bootstrap target platform"
    [[ "$(manifest_value target.pointerBits)" == "64" ]] \
        || compile_project_fail "unsupported bootstrap pointer width"
    [[ "$(uname -m)" == "$(manifest_value target.architecture)" ]] \
        || compile_project_fail "bootstrap target architecture mismatch"

    local relative expected path actual expected_bytes
    relative="$(manifest_value bootstrap.path)"
    expected="$(manifest_value bootstrap.sha256)"
    expected_bytes="$(manifest_value bootstrap.bytes)"
    path="$REPO_ROOT/$relative"
    [[ -f "$path" ]] || compile_project_fail "missing checked-in bootstrap: $relative"
    actual="$(sha256 "$path")"
    [[ "$actual" == "$expected" ]] \
        || compile_project_fail "checked-in bootstrap hash mismatch"
    [[ "$(bytes "$path")" == "$expected_bytes" ]] \
        || compile_project_fail "checked-in bootstrap byte length mismatch"

    relative="$(manifest_value executable.path)"
    expected="$(manifest_value executable.sha256)"
    expected_bytes="$(manifest_value executable.bytes)"
    path="$REPO_ROOT/$relative"
    [[ -x "$path" ]] || compile_project_fail "accepted compiler is not executable: $relative"
    actual="$(sha256 "$path")"
    [[ "$actual" == "$expected" ]] \
        || compile_project_fail "accepted compiler executable hash mismatch"
    [[ "$(bytes "$path")" == "$expected_bytes" ]] \
        || compile_project_fail "accepted compiler executable byte length mismatch"
}

revision_field() {
    local source="$1"
    local key="$2"
    /usr/bin/awk -F '\t' -v key="$key" '
        {
            for (field = 2; field <= NF; field += 1) {
                if (index($field, key "=") == 1) {
                    value = $field
                    sub(/^[^=]*=/, "", value)
                    print value
                    exit
                }
            }
        }
    ' "$source"
}

revision_node_value() {
    local source="$1"
    local id="$2"
    local key="$3"
    /usr/bin/awk -F '\t' -v id="$id" -v key="$key" '
        $1 == "rangeRevisionNode" && $2 == "id=" id {
            for (field = 3; field <= NF; field += 1) {
                if (index($field, key "=") == 1) {
                    value = $field
                    sub(/^[^=]*=/, "", value)
                    print value
                    exit
                }
            }
        }
    ' "$source"
}

revision_digest() {
    local source="$1"
    local view="$2"
    /usr/bin/awk -F '\t' -v view="$view" '
        $1 == "rangeRevisionDigest" && $2 == "view=" view {
            sub(/^digest=/, "", $3)
            print $3
            exit
        }
    ' "$source"
}

graph_delta_head_matches_checkpoint() {
    local head="$1"
    local revision="$2"
    local head_identity revision_identity

    [[ -f "$head" && -f "$revision" ]] || return 1
    head_identity="$(revision_field "$head" identity)"
    revision_identity="$(revision_field "$revision" identity)"
    [[ "$head_identity" =~ ^[0-9a-f]{64}$ && "$head_identity" == "$revision_identity" ]]
}

# Persist an immutable accepted delta before atomically advancing the head.
# revision.tsv remains a compatibility checkpoint; delta-head.tsv plus the
# parent-linked records under deltas/ are the durable history.
prepare_graph_delta_commit() {
    local revision="$1"
    local previous="$2"
    local directory="$3"
    local head="$4"
    local head_candidate="$5"
    local identity parent expected_parent ordinal existing_identity record temporary

    identity="$(revision_field "$revision" identity)"
    parent="$(revision_field "$revision" parent)"
    [[ "$identity" =~ ^[0-9a-f]{64}$ ]] || compile_project_fail "candidate graph delta omitted its identity"
    [[ "$parent" == "absent" || "$parent" =~ ^[0-9a-f]{64}$ ]] \
        || compile_project_fail "candidate graph delta omitted its parent"
    /bin/mkdir -p "$directory"

    # One-time migration: seed immutable history from the accepted checkpoint
    # before appending its child.
    if [[ ! -f "$head" && -f "$previous" ]]; then
        existing_identity="$(revision_field "$previous" identity)"
        [[ "$existing_identity" =~ ^[0-9a-f]{64}$ && "$parent" == "$existing_identity" ]] \
            || compile_project_fail "graph delta migration does not extend the accepted checkpoint"
        record="$directory/$existing_identity.tsv"
        if [[ ! -f "$record" ]]; then
            temporary="$record.tmp.$$"
            /usr/bin/printf 'rangeGraphDelta\tversion=1\tidentity=%s\tparent=%s\tordinal=0\n' \
                "$existing_identity" "$(revision_field "$previous" parent)" > "$temporary"
            /bin/cat "$previous" >> "$temporary"
            /bin/mv "$temporary" "$record"
        fi
        /usr/bin/printf 'rangeGraphHead\tversion=1\tidentity=%s\tordinal=0\n' "$existing_identity" > "$head"
    fi

    if [[ -f "$head" ]]; then
        expected_parent="$(revision_field "$head" identity)"
        [[ "$parent" == "$expected_parent" ]] \
            || compile_project_fail "candidate graph delta does not extend the accepted head"
        ordinal=$(( $(revision_field "$head" ordinal) + 1 ))
    else
        [[ "$parent" == "absent" ]] || compile_project_fail "first graph delta has a non-absent parent"
        ordinal=0
    fi

    record="$directory/$identity.tsv"
    if [[ -f "$record" ]]; then
        /usr/bin/grep -Fqx $'rangeGraphDelta\tversion=1\tidentity='"$identity"$'\tparent='"$parent"$'\tordinal='"$ordinal" "$record" \
            || compile_project_fail "immutable graph delta identity collision"
    else
        temporary="$record.tmp.$$"
        /usr/bin/printf 'rangeGraphDelta\tversion=1\tidentity=%s\tparent=%s\tordinal=%s\n' \
            "$identity" "$parent" "$ordinal" > "$temporary"
        /bin/cat "$revision" >> "$temporary"
        /bin/mv "$temporary" "$record"
    fi
    /usr/bin/printf 'rangeGraphHead\tversion=1\tidentity=%s\tordinal=%s\n' "$identity" "$ordinal" > "$head_candidate"
}

syntax_artifact_matches_revision() {
    local artifact="$1"
    local revision="$2"
    local digest syntax shape

    [[ -f "$artifact" && -f "$revision" ]] || return 1
    [[ "$(revision_field "$revision" version)" == "4" ]] || return 1
    digest="$(revision_digest "$revision" syntax)"
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ "$(/usr/bin/shasum -a 256 "$artifact" | /usr/bin/awk '{print $1}')" == "$digest" ]] || return 1
    syntax="$(revision_field "$artifact" syntaxFirst):$(revision_field "$artifact" syntaxSecond)"
    shape="$(revision_field "$artifact" shapeFirst):$(revision_field "$artifact" shapeSecond)"
    [[ "$syntax" == "$(revision_node_value "$revision" syntax after)" ]] || return 1
    [[ "$shape" == "$(revision_node_value "$revision" shape after)" ]]
}

fingerprint_first() {
    /usr/bin/printf '%s' "${1%%:*}"
}

fingerprint_second() {
    /usr/bin/printf '%s' "${1#*:}"
}

write_transient_execution_from_revision() {
    local revision="$1"
    local output="$2"
    local file source syntax shape behavior compiled

    file="$(revision_field "$revision" file)"
    source="$(revision_node_value "$revision" source after)"
    syntax="$(revision_node_value "$revision" syntax after)"
    shape="$(revision_node_value "$revision" shape after)"
    behavior="$(revision_node_value "$revision" behavior after)"
    compiled="$(revision_node_value "$revision" compile after)"
    for value in "$file" "$source" "$syntax" "$shape" "$behavior" "$compiled"; do
        [[ "$value" =~ ^[0-9]+:[0-9]+$ ]] || return 1
    done
    /usr/bin/printf 'compilerV1Execution\tversion=2\tfileFirst=%s\tfileSecond=%s\tsourceFirst=%s\tsourceSecond=%s\tsyntaxFirst=%s\tsyntaxSecond=%s\tshapeFirst=%s\tshapeSecond=%s\tbehaviorFirst=%s\tbehaviorSecond=%s\tcompiledFirst=%s\tcompiledSecond=%s\n' \
        "$(fingerprint_first "$file")" "$(fingerprint_second "$file")" \
        "$(fingerprint_first "$source")" "$(fingerprint_second "$source")" \
        "$(fingerprint_first "$syntax")" "$(fingerprint_second "$syntax")" \
        "$(fingerprint_first "$shape")" "$(fingerprint_second "$shape")" \
        "$(fingerprint_first "$behavior")" "$(fingerprint_second "$behavior")" \
        "$(fingerprint_first "$compiled")" "$(fingerprint_second "$compiled")" > "$output"
}

node_changed() {
    local before="$1" after="$2"
    if [[ "$before" == "$after" ]]; then
        /usr/bin/printf '0'
    else
        /usr/bin/printf '1'
    fi
}

now_ms() {
    /usr/bin/python3 -c 'import time; print(int(time.time() * 1000))'
}

# Each pipeline phase is reported as either consumed or derived. A phase that
# leaves the prior accepted value untouched (before == after) consumed the
# persisted revision; a phase that commits a new value derived its product.
stage_flag() {
    local before="$1" after="$2"
    if [[ "$before" == "$after" ]]; then
        /usr/bin/printf 'consumed'
    else
        /usr/bin/printf 'derived'
    fi
}

# The revision record is the single Source provenance authority. Graph revisions
# also keep each phase product as a stable node carrying before/after value
# fingerprints, the phase-to-phase pipeline as cardinality-one edges, and
# content digests for each view. A failed candidate never writes a revision;
# the last accepted revision is preserved.
write_graph_revision() {
    local output="$1"
    local previous="$2"
    local status_source="$3"
    local execution_state="$4"
    local syntax_artifact="$5"
    local source_bundle="$6"
    local compiled_output="$7"
    local source_profile="$8"
    local source_input="$9"
    local source_compiler="${10}"
    local status changed
    local source_before source_after syntax_before syntax_after shape_before shape_after
    local behavior_before behavior_after compiled_before compiled_after
    local parent source_hash syntax_hash compiled_hash identity_input identity operation
    local file_first file_second file_value

    status="$(revision_field "$status_source" status)"
    changed="$(revision_field "$status_source" changed)"
    if [[ "$status" == "reused" && -f "$previous" ]]; then
        source_before="$(revision_node_value "$previous" source after)"
        source_after="$source_before"
        shape_before="$(revision_node_value "$previous" shape after)"
        shape_after="$shape_before"
        behavior_before="$(revision_node_value "$previous" behavior after)"
        behavior_after="$behavior_before"
        compiled_before="$(revision_node_value "$previous" compile after)"
        compiled_after="$compiled_before"
    else
        source_before="$(revision_field "$status_source" sourceBefore)"
        source_after="$(revision_field "$status_source" sourceAfter)"
        shape_before="$(revision_field "$status_source" shapeBefore)"
        shape_after="$(revision_field "$status_source" shapeAfter)"
        behavior_before="$(revision_field "$status_source" behaviorBefore)"
        behavior_after="$(revision_field "$status_source" behaviorAfter)"
        compiled_before="$(revision_field "$status_source" compiledBefore)"
        compiled_after="$(revision_field "$status_source" compiledAfter)"
    fi
    file_first="$(revision_field "$execution_state" fileFirst)"
    file_second="$(revision_field "$execution_state" fileSecond)"
    [[ "$file_first" =~ ^[0-9]+$ && "$file_second" =~ ^[0-9]+$ ]] \
        || compile_project_fail "transient execution omitted its File fingerprint"
    file_value="$file_first:$file_second"
    syntax_before="0:0"
    if [[ -f "$previous" ]]; then
        syntax_before="$(revision_node_value "$previous" syntax after)"
        [[ "$syntax_before" =~ ^[0-9]+:[0-9]+$ ]] || syntax_before="0:0"
    fi
    syntax_after="$(revision_field "$syntax_artifact" syntaxFirst):$(revision_field "$syntax_artifact" syntaxSecond)"
    [[ "$syntax_after" =~ ^[0-9]+:[0-9]+$ ]] \
        || compile_project_fail "syntax facts omitted their accepted fingerprint"

    parent="absent"
    if [[ -f "$previous" ]]; then
        parent="$(/usr/bin/sed -n 's/^rangeRevision\tversion=[0-9][0-9]*\tidentity=\([0-9a-f][0-9a-f]*\)\t.*/\1/p' "$previous" | /usr/bin/head -1)"
        [[ -n "$parent" ]] || parent="absent"
    fi
    source_hash="$(/usr/bin/shasum -a 256 "$source_bundle" | /usr/bin/awk '{print $1}')"
    syntax_hash="$(/usr/bin/shasum -a 256 "$syntax_artifact" | /usr/bin/awk '{print $1}')"
    compiled_hash="$(/usr/bin/shasum -a 256 "$compiled_output" | /usr/bin/awk '{print $1}')"
    identity_input="$(/usr/bin/printf 'revision=4\nparent=%s\nfile=%s\nsource=%s\nsourceProfile=%s\ninput=%s\ncompiler=%s\nsyntax=%s\nshape=%s\nbehavior=%s\ncompiled=%s\nstatus=accepted\n' \
        "$parent" "$file_value" "$source_hash" "$source_profile" "$source_input" "$source_compiler" "$syntax_after" \
        "$shape_after" "$behavior_after" "$compiled_after")"
    identity="$(/usr/bin/printf '%s' "$identity_input" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
    if [[ "$status" == "cold" ]]; then
        operation="add"
    else
        operation="replace"
    fi

    {
        /usr/bin/printf 'rangeRevision\tversion=4\tidentity=%s\tparent=%s\tfile=%s\tsource=%s\tsourceProfile=%s\tinput=%s\tcompiler=%s\tstatus=accepted\n' \
            "$identity" "$parent" "$file_value" "$source_hash" "$source_profile" "$source_input" "$source_compiler"
        /usr/bin/printf 'rangeRevisionNode\tid=source\tbefore=%s\tafter=%s\tchanged=%s\n' \
            "$source_before" "$source_after" "$(node_changed "$source_before" "$source_after")"
        /usr/bin/printf 'rangeRevisionNode\tid=syntax\tbefore=%s\tafter=%s\tchanged=%s\n' \
            "$syntax_before" "$syntax_after" "$(node_changed "$syntax_before" "$syntax_after")"
        /usr/bin/printf 'rangeRevisionNode\tid=shape\tbefore=%s\tafter=%s\tchanged=%s\n' \
            "$shape_before" "$shape_after" "$(node_changed "$shape_before" "$shape_after")"
        /usr/bin/printf 'rangeRevisionNode\tid=behavior\tbefore=%s\tafter=%s\tchanged=%s\n' \
            "$behavior_before" "$behavior_after" "$(node_changed "$behavior_before" "$behavior_after")"
        /usr/bin/printf 'rangeRevisionNode\tid=compile\tbefore=%s\tafter=%s\tchanged=%s\n' \
            "$compiled_before" "$compiled_after" "$(node_changed "$compiled_before" "$compiled_after")"
        /usr/bin/printf 'rangeRevisionEdge\tid=source-syntax\tfrom=source\tto=syntax\tcardinality=one\toperation=%s\n' "$operation"
        /usr/bin/printf 'rangeRevisionEdge\tid=syntax-shape\tfrom=syntax\tto=shape\tcardinality=one\toperation=%s\n' "$operation"
        /usr/bin/printf 'rangeRevisionEdge\tid=shape-behavior\tfrom=shape\tto=behavior\tcardinality=one\toperation=%s\n' "$operation"
        /usr/bin/printf 'rangeRevisionEdge\tid=behavior-compile\tfrom=behavior\tto=compile\tcardinality=one\toperation=%s\n' "$operation"
        /usr/bin/printf 'rangeRevisionDigest\tview=source\tdigest=%s\n' "$source_hash"
        /usr/bin/printf 'rangeRevisionDigest\tview=syntax\tdigest=%s\n' "$syntax_hash"
        /usr/bin/printf 'rangeRevisionDigest\tview=shape\tdigest=%s\n' "$shape_after"
        /usr/bin/printf 'rangeRevisionDigest\tview=behavior\tdigest=%s\n' "$behavior_after"
        /usr/bin/printf 'rangeRevisionDigest\tview=compiled\tdigest=%s\n' "$compiled_hash"
    } > "$output.tmp.$$"
    /bin/mv "$output.tmp.$$" "$output"
}

source_revision_matches() {
    local revision="$1"
    local bundle="$2"
    local profile="$3"
    local input="$4"
    local compiler="$5"
    local expected_source="$6"

    [[ -f "$revision" && -f "$bundle" ]] || return 1
    [[ "$(revision_field "$revision" version)" =~ ^(2|3|4)$ ]] || return 1
    [[ "$(revision_field "$revision" sourceProfile)" == "$profile" ]] || return 1
    [[ "$(revision_field "$revision" input)" == "$input" ]] || return 1
    [[ "$(revision_field "$revision" compiler)" == "$compiler" ]] || return 1
    [[ "$(revision_field "$revision" source)" == "$expected_source" ]] || return 1
    [[ "$(revision_field "$revision" status)" == "accepted" ]] || return 1
    [[ "$(/usr/bin/shasum -a 256 "$bundle" | /usr/bin/awk '{print $1}')" == "$expected_source" ]] || return 1
    /usr/bin/grep -Fqx "rangeRevisionDigest"$'\t'"view=source"$'\t'"digest=$expected_source" "$revision"
}

write_source_revision() {
    local output="$1"
    local previous="$2"
    local source_hash="$3"
    local source_profile="$4"
    local source_input="$5"
    local source_compiler="$6"
    local parent="absent"
    local identity_input identity

    if [[ -f "$previous" ]]; then
        parent="$(revision_field "$previous" identity)"
        [[ "$parent" =~ ^[0-9a-f]{64}$ ]] || parent="absent"
    fi
    identity_input="$(/usr/bin/printf 'revision=2\nparent=%s\nsource=%s\nsourceProfile=%s\ninput=%s\ncompiler=%s\nstatus=accepted\n' \
        "$parent" "$source_hash" "$source_profile" "$source_input" "$source_compiler")"
    identity="$(/usr/bin/printf '%s' "$identity_input" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
    {
        /usr/bin/printf 'rangeRevision\tversion=2\tidentity=%s\tparent=%s\tsource=%s\tsourceProfile=%s\tinput=%s\tcompiler=%s\tstatus=accepted\n' \
            "$identity" "$parent" "$source_hash" "$source_profile" "$source_input" "$source_compiler"
        /usr/bin/printf 'rangeRevisionDigest\tview=source\tdigest=%s\n' "$source_hash"
    } > "$output"
}

compiler_command="compile"
graph_mode=0
shape_mode=0
if [[ "${1:-}" == "--graph" ]]; then
    compiler_command="compile-v1"
    graph_mode=1
    shift
elif [[ "${1:-}" == "--shape" ]]; then
    shape_mode=1
    shift
fi

input="${1:-}"
[[ -n "$input" ]] || compile_project_fail "expected a .range file or project directory"
shift
[[ -e "$input" ]] || compile_project_fail "input does not exist: $input"

additional_inputs=()
while [[ $# -gt 0 ]]; do
    [[ "$1" == "--source" ]] || compile_project_fail "expected --source followed by a .range file or project directory"
    shift
    [[ $# -gt 0 ]] || compile_project_fail "--source requires a .range file or project directory"
    [[ -e "$1" ]] || compile_project_fail "source input does not exist: $1"
    additional_inputs+=("$1")
    shift
done

# A declared project is compiled as a separately discovered source graph by
# Compiler B. The accepted compiler first builds Compiler B, which then emits
# the ordinary project's LLVM without concatenating the application's sources.
if [[ "$graph_mode" -eq 0 && "$shape_mode" -eq 0 \
    && -d "$input" && -f "$input/Project.range" \
    && "${#additional_inputs[@]}" -eq 0 ]]; then
    exec "$SCRIPT_DIR/run-compiler-b-bootstrap" --emit-llvm "$input"
fi

if [[ -d "$input" ]]; then
    input_identity="$(cd "$input" && pwd)"
else
    input_identity="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
fi
if [[ "${#additional_inputs[@]}" -gt 0 ]]; then
    input_identity_material="$input_identity"
    for additional_input in "${additional_inputs[@]}"; do
        if [[ -d "$additional_input" ]]; then
            additional_identity="$(cd "$additional_input" && pwd)"
        else
            additional_identity="$(cd "$(dirname "$additional_input")" && pwd)/$(basename "$additional_input")"
        fi
        input_identity_material="$input_identity_material"$'\n'"$additional_identity"
    done
    input_identity="source-set:$(/usr/bin/printf '%s' "$input_identity_material" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
fi
if [[ "$shape_mode" -eq 1 ]]; then
    source_profile="shape-local"
else
    source_profile="project"
fi
source_cache_root="${RANGE_SOURCE_CACHE_DIR:-${RANGE_GRAPH_CACHE_DIR:-$REPO_ROOT/.range/Compiler/Source}}"
source_cache_key="$(/usr/bin/printf 'path=%s\nprofile=%s\n' "$input_identity" "$source_profile" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
source_cache_directory="$source_cache_root/$source_cache_key"
source_bundle_artifact="$source_cache_directory/ProjectSourceSet.range"
source_revision_artifact="$source_cache_directory/revision.tsv"

WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-compile.XXXXXX")"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

development_compiler="${RANGE_DEVELOPMENT_COMPILER:-}"
if [[ -z "$development_compiler" ]]; then
    # Ordinary source compilation consumes the accepted compiler artifacts but
    # does not compile or link the manifest's C runtime sources. Keep runtime
    # verification in the build/link and compiler fixed-point proof paths.
    verify_compiler_authority
else
    [[ -x "$development_compiler" ]] \
        || compile_project_fail "RANGE_DEVELOPMENT_COMPILER is not executable: $development_compiler"
    development_compiler="$(cd "$(dirname "$development_compiler")" && pwd)/$(basename "$development_compiler")"
    /usr/bin/printf 'range: using unpromoted development compiler %s\n' "$development_compiler" >&2
fi

accepted_compiler="$REPO_ROOT/$(manifest_value executable.path)"
if [[ -z "$development_compiler" ]]; then
    [[ -x "$accepted_compiler" ]] || compile_project_fail "accepted compiler is not executable"
fi

# Compiler V1 owns the graph and Shape lines, while ordinary compilation stays
# on the accepted bootstrap oracle. The source-set marker is an explicit
# Source artifact: it records the complete Core/project inventory rather than
# pretending that the marker text is already a canonical Shape.
compiler="$accepted_compiler"
if [[ -n "$development_compiler" ]]; then
    compiler="$development_compiler"
fi
if [[ "$graph_mode" -eq 1 || "$shape_mode" -eq 1 ]]; then
    [[ -z "$development_compiler" ]] \
        || compile_project_fail "RANGE_DEVELOPMENT_COMPILER is only supported for ordinary compile and run commands"
    # Resolve the Range-authored candidate producer, rather than using
    # the promoted bootstrap executable. This keeps the graph line on the
    # candidate source while the ordinary line remains the accepted
    # oracle.
    "$SCRIPT_DIR/range" check-compiler-smoke >/dev/null
    graph_compiler="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler"
    [[ -x "$graph_compiler" ]] || compile_project_fail "candidate graph compiler is not executable"
    compiler="$graph_compiler"
    graph_compiler_hash="$(/usr/bin/shasum -a 256 "$graph_compiler" | /usr/bin/awk '{print $1}')"
fi

project_bundle="$WORK_ROOT/ProjectSourceSet.range"
/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$project_bundle"
if [[ "$shape_mode" -eq 1 ]]; then
    /usr/bin/printf '%s\n' 'compilerSyntaxRecipes' > "$project_bundle"
elif [[ "$graph_mode" -eq 1 ]]; then
    /usr/bin/printf '%s\n' '// range-development-compiler' >> "$project_bundle"
    /usr/bin/printf '// range-compiler-authority %s\n' "$graph_compiler_hash" >> "$project_bundle"
fi

append_source() {
    local role="$1"
    local logical_path="$2"
    local source_path="$3"

    if [[ "$logical_path" == *$' '* || "$logical_path" == *$'\t'* || "$logical_path" == *$'\n'* ]]; then
        compile_project_fail "Range source paths may not contain whitespace: $logical_path"
    fi
    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$logical_path" >> "$project_bundle"
    /bin/cat "$source_path" >> "$project_bundle"
    if [[ -n "$(/usr/bin/tail -c 1 "$source_path")" ]]; then
        /usr/bin/printf '\n' >> "$project_bundle"
    fi
}

# The first Shape product is intentionally source-local: it proves Core
# @syntax recipe derivation without forcing the incomplete accepted Core
# manifest through the recipe finalizer. Source-set Shape composition is a
# later cutover once those Core syntax declarations have a complete package.
if [[ "$shape_mode" -eq 0 ]]; then
    [[ -f "$COMPILER_CORE_INVENTORY" ]] || compile_project_fail "missing compiler Core inventory: $COMPILER_CORE_INVENTORY"
    while IFS= read -r relative; do
        [[ -n "$relative" ]] || continue
        source_path="$REPO_ROOT/$relative"
        [[ -f "$source_path" ]] || compile_project_fail "missing inventoried Core source: $relative"
        append_source core "$relative" "$source_path"
    done < "$COMPILER_CORE_INVENTORY"

    # Until the declaration-reflection Core surface itself is part of the
    # accepted source manifest, give the executable Core macros the same
    # minimal typed targets used by their focused native proofs.
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro/NativeReflection.range' \
        'construct Function {}' \
        'construct Construct {}' >> "$project_bundle"

    for relative in \
        RangeCompiler/Sources/Core/Macro/Link.range \
        RangeCompiler/Sources/Core/Macro/Opaque.range \
        RangeCompiler/Sources/Core/System/Optional/Nil.range \
        RangeCompiler/Sources/Core/System/Optional/Optional.range; do
        source_path="$REPO_ROOT/$relative"
        [[ -f "$source_path" ]] || compile_project_fail "missing language Core source: $relative"
        append_source core "$relative" "$source_path"
    done
fi

append_project_input() {
    local project_input="$1"
    local logical_prefix="$2"

    if [[ -d "$project_input" ]]; then
        project_root="$(cd "$project_input" && pwd)"
        project_paths_raw="$WORK_ROOT/project-paths-$logical_prefix.raw"
        project_paths="$WORK_ROOT/project-paths-$logical_prefix"
        /usr/bin/find "$project_root" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print \
            > "$project_paths_raw"
        while IFS= read -r source_path; do
            [[ "$source_path" != *$'\n'* ]] \
                || compile_project_fail "Range source paths may not contain newlines: $source_path"
        done < "$project_paths_raw"
        LC_ALL=C /usr/bin/sort "$project_paths_raw" > "$project_paths"
        input_project_count=0
        while IFS= read -r source_path; do
            relative="${source_path#"$project_root/"}"
            if [[ -n "$logical_prefix" ]]; then
                relative="$logical_prefix/$relative"
            fi
            append_source project "$relative" "$source_path"
            input_project_count=$((input_project_count + 1))
        done < "$project_paths"
        [[ "$input_project_count" -gt 0 ]] || compile_project_fail "no .range sources found in: $project_input"
    else
        [[ "$project_input" == *.range ]] || compile_project_fail "input file must end in .range: $project_input"
        source_path="$(cd "$(dirname "$project_input")" && pwd)/$(basename "$project_input")"
        relative="$(basename "$source_path")"
        if [[ -n "$logical_prefix" ]]; then
            relative="$logical_prefix/$relative"
        fi
        append_source project "$relative" "$source_path"
    fi
}

if [[ -d "$input" ]]; then
    project_root="$(cd "$input" && pwd)"
    project_paths_raw="$WORK_ROOT/project-paths.raw"
    project_paths="$WORK_ROOT/project-paths"
    /usr/bin/find "$project_root" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print \
        > "$project_paths_raw"
    while IFS= read -r source_path; do
        [[ "$source_path" != *$'\n'* ]] \
            || compile_project_fail "Range source paths may not contain newlines: $source_path"
    done < "$project_paths_raw"
    LC_ALL=C /usr/bin/sort "$project_paths_raw" > "$project_paths"
    project_count=0
    while IFS= read -r source_path; do
        relative="${source_path#"$project_root/"}"
        append_source project "$relative" "$source_path"
        project_count=$((project_count + 1))
    done < "$project_paths"
    [[ "$project_count" -gt 0 ]] || compile_project_fail "no .range sources found in: $input"
else
    [[ "$input" == *.range ]] || compile_project_fail "input file must end in .range: $input"
    source_path="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
    append_source project "$(basename "$source_path")" "$source_path"
fi

if [[ "${#additional_inputs[@]}" -gt 0 ]]; then
    additional_index=0
    for additional_input in "${additional_inputs[@]}"; do
        append_project_input "$additional_input" "source-$additional_index"
        additional_index=$((additional_index + 1))
    done
fi

persist_source_revision() {
    local source_bundle="$1"
    local source_hash="$2"

    /bin/mkdir -p "$source_cache_directory"
    /bin/cp "$source_bundle" "$source_bundle_artifact.tmp"
    write_source_revision "$source_revision_artifact.tmp" "$source_revision_artifact" \
        "$source_hash" "$source_profile" "$input_identity" "$graph_compiler_hash"
    /bin/mv "$source_bundle_artifact.tmp" "$source_bundle_artifact"
    /bin/mv "$source_revision_artifact.tmp" "$source_revision_artifact"
    /bin/rm -f "$source_cache_directory/source.tsv"
}

if [[ "$shape_mode" -eq 1 ]]; then
    # Shape consumes the persisted File -> Source value when its provenance
    # matches this input and compiler. A changed source is evaluated from the
    # candidate bundle above, but it is not promoted until Shape succeeds.
    source_candidate_hash="$(/usr/bin/shasum -a 256 "$project_bundle" | /usr/bin/awk '{print $1}')"
    source_cache_reused=0
    if source_revision_matches "$source_revision_artifact" "$source_bundle_artifact" \
        "$source_profile" "$input_identity" "$graph_compiler_hash" "$source_candidate_hash"; then
        /bin/cp "$source_bundle_artifact" "$project_bundle"
        source_cache_reused=1
    fi
    shape_source_set_hash="$(/usr/bin/shasum -a 256 "$project_bundle" | /usr/bin/awk '{print $1}')"
    # Shape is the first durable product after Source. The payload is emitted
    # by the existing Core @syntax recipe path; this cache deliberately has no
    # LLVM output and therefore cannot be mistaken for a compiled artifact.
    shape_cache_root="${RANGE_SHAPE_CACHE_DIR:-$REPO_ROOT/.range/Compiler/Shape}"
    shape_cache_key="$(/usr/bin/printf '%s' "$input_identity" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
    shape_cache_directory="$shape_cache_root/$shape_cache_key"
    /bin/mkdir -p "$shape_cache_directory"
    shape_payload="$shape_cache_directory/shape.payload"
    shape_artifact="$shape_cache_directory/shape.tsv"
    shape_input="$shape_cache_directory/input.tsv"
    shape_payload_hash_file="$shape_cache_directory/payload.sha256"
    shape_input_candidate="$WORK_ROOT/shape.input.tsv"
    /usr/bin/printf 'rangeShapeInput\tversion=1\tsourceSet=%s\tcompiler=%s\n' \
        "$shape_source_set_hash" \
        "$graph_compiler_hash" > "$shape_input_candidate"
    shape_expected_artifact="$WORK_ROOT/shape.expected.tsv"
    shape_payload_hash=""
    if [[ -f "$shape_input" && -f "$shape_payload" && -f "$shape_artifact" && -f "$shape_payload_hash_file" ]] \
        && /usr/bin/cmp -s "$shape_input_candidate" "$shape_input"; then
        shape_payload_hash="$(/usr/bin/shasum -a 256 "$shape_payload" | /usr/bin/awk '{print $1}')"
        if [[ "$shape_payload_hash" == "$(/usr/bin/sed -n '1p' "$shape_payload_hash_file")" ]]; then
            /usr/bin/printf 'rangeShape\tversion=1\tsourceSet=%s\tcompiler=%s\tpayload=%s\n' \
                "$shape_source_set_hash" \
                "$graph_compiler_hash" "$shape_payload_hash" > "$shape_expected_artifact"
            /bin/cat "$shape_payload" >> "$shape_expected_artifact"
            if /usr/bin/cmp -s "$shape_expected_artifact" "$shape_artifact"; then
                if [[ "$source_cache_reused" -eq 0 ]]; then
                    persist_source_revision "$project_bundle" "$shape_source_set_hash"
                fi
                /usr/bin/printf 'rangeShapeExecution\tstatus=reused\tchanged=0\tpayload=%s\n' "$shape_payload_hash" >&2
                /bin/cat "$shape_artifact"
                exit 0
            fi
        fi
    fi

    shape_previous_state="cold"
    if [[ -f "$shape_artifact" || -f "$shape_payload" || -f "$shape_input" ]]; then
        shape_previous_state="updated"
    fi
    shape_payload_candidate="$WORK_ROOT/shape.payload"
    shape_status=0
    "$compiler" compile "$project_bundle" > "$shape_payload_candidate" || shape_status=$?
    if [[ "$shape_status" -ne 0 ]]; then
        /bin/cat "$shape_payload_candidate" >&2
        exit "$shape_status"
    fi
    shape_payload_hash="$(/usr/bin/shasum -a 256 "$shape_payload_candidate" | /usr/bin/awk '{print $1}')"
    /usr/bin/printf 'rangeShape\tversion=1\tsourceSet=%s\tcompiler=%s\tpayload=%s\n' \
        "$shape_source_set_hash" \
        "$graph_compiler_hash" "$shape_payload_hash" > "$shape_expected_artifact"
    /bin/cat "$shape_payload_candidate" >> "$shape_expected_artifact"
    /bin/cp "$shape_payload_candidate" "$shape_payload.tmp"
    /bin/cp "$shape_expected_artifact" "$shape_artifact.tmp"
    /usr/bin/printf '%s\n' "$shape_payload_hash" > "$shape_payload_hash_file.tmp"
    /bin/cp "$shape_input_candidate" "$shape_input.tmp"
    /bin/mv "$shape_payload.tmp" "$shape_payload"
    /bin/mv "$shape_artifact.tmp" "$shape_artifact"
    /bin/mv "$shape_payload_hash_file.tmp" "$shape_payload_hash_file"
    /bin/mv "$shape_input.tmp" "$shape_input"
    persist_source_revision "$project_bundle" "$shape_source_set_hash"
    /usr/bin/printf 'rangeShapeExecution\tstatus=%s\tchanged=1\tpayload=%s\n' \
        "$shape_previous_state" "$shape_payload_hash" >&2
    /bin/cat "$shape_artifact"
    exit 0
elif [[ "$graph_mode" -eq 1 ]]; then
    graph_input_identity="$input_identity"
    # Source and typed syntax facts are durable products. Shape is projected
    # from the accepted facts without recapturing Source in the Shape phase.
    graph_cache_directory="$source_cache_directory"
    /bin/mkdir -p "$graph_cache_directory"
    graph_bundle="$graph_cache_directory/ProjectSourceSet.range"
    graph_legacy_execution="$graph_cache_directory/execution.tsv"
    graph_output="$graph_cache_directory/compiled.ll"
    graph_revision="$graph_cache_directory/revision.tsv"
    graph_delta_directory="$graph_cache_directory/deltas"
    graph_delta_head="$graph_cache_directory/delta-head.tsv"
    graph_syntax="$graph_cache_directory/syntax-facts.tsv"
    graph_bundle_backup="$WORK_ROOT/ProjectSourceSet.previous.range"
    graph_transient_execution="$WORK_ROOT/execution.tsv"
    graph_syntax_binding="$WORK_ROOT/syntax-binding.tsv"
    graph_output_candidate="$WORK_ROOT/compiled.candidate.ll"
    graph_revision_candidate="$WORK_ROOT/revision.candidate.tsv"
    graph_delta_head_candidate="$WORK_ROOT/delta-head.candidate.tsv"
    graph_syntax_candidate="$WORK_ROOT/syntax-facts.candidate.tsv"

    if [[ -f "$graph_delta_head" ]] \
        && ! graph_delta_head_matches_checkpoint "$graph_delta_head" "$graph_revision"; then
        compile_project_fail "graph checkpoint does not materialize the accepted delta head"
    fi

    # Source stage: the candidate File -> Source bundle is consumed from the
    # persisted artifact when its revision provenance matches this input and
    # compiler, instead of being re-derived and rewritten on every run.
    metrics_source_start_ms="$(now_ms)"
    graph_source_candidate_hash="$(/usr/bin/shasum -a 256 "$project_bundle" | /usr/bin/awk '{print $1}')"
    graph_source_consumed=0
    if source_revision_matches "$graph_revision" "$graph_bundle" \
        "$source_profile" "$graph_input_identity" "$graph_compiler_hash" "$graph_source_candidate_hash" \
        && [[ "$(revision_field "$graph_revision" file)" =~ ^[0-9]+:[0-9]+$ ]]; then
        graph_source_consumed=1
    fi
    metrics_source_end_ms="$(now_ms)"
    graph_source_ms=$((metrics_source_end_ms - metrics_source_start_ms))

    graph_had_bundle=0
    if [[ "$graph_source_consumed" -eq 0 ]]; then
        if [[ -f "$graph_bundle" ]]; then
            /bin/cp "$graph_bundle" "$graph_bundle_backup"
            graph_had_bundle=1
        fi
        /bin/cp "$project_bundle" "$graph_bundle.tmp"
        /bin/mv "$graph_bundle.tmp" "$graph_bundle"
    fi

    metrics_syntax_start_ms="$(now_ms)"
    graph_syntax_consumed=0
    graph_syntax_input="$graph_syntax_candidate"
    if [[ "$graph_source_consumed" -eq 1 ]] \
        && syntax_artifact_matches_revision "$graph_syntax" "$graph_revision"; then
        graph_syntax_consumed=1
        graph_syntax_input="$graph_syntax"
    else
        graph_syntax_status=0
        "$compiler" capture-syntax-v1 "$graph_bundle" "$graph_syntax_candidate" \
            > "$WORK_ROOT/graph-syntax.out" || graph_syntax_status=$?
        if [[ "$graph_syntax_status" -ne 0 ]]; then
            if [[ "$graph_had_bundle" -eq 1 ]]; then
                /bin/cp "$graph_bundle_backup" "$graph_bundle"
            elif [[ "$graph_source_consumed" -eq 0 ]]; then
                /bin/rm -f "$graph_bundle"
            fi
            /bin/cat "$WORK_ROOT/graph-syntax.out" >&2
            exit "$graph_syntax_status"
        fi
        if [[ -f "$graph_syntax" ]] && /usr/bin/cmp -s "$graph_syntax_candidate" "$graph_syntax"; then
            graph_syntax_consumed=1
            graph_syntax_input="$graph_syntax"
            /bin/rm -f "$graph_syntax_candidate"
        fi
    fi
    metrics_syntax_end_ms="$(now_ms)"
    graph_syntax_ms=$((metrics_syntax_end_ms - metrics_syntax_start_ms))
    if [[ -s "$WORK_ROOT/graph-syntax.out" ]]; then
        graph_binding_source="$(revision_field "$WORK_ROOT/graph-syntax.out" sourceFirst):$(revision_field "$WORK_ROOT/graph-syntax.out" sourceSecond)"
    else
        graph_binding_source="$(revision_node_value "$graph_revision" source after)"
    fi
    graph_binding_syntax="$(revision_field "$graph_syntax_input" syntaxFirst):$(revision_field "$graph_syntax_input" syntaxSecond)"
    [[ "$graph_binding_source" =~ ^[0-9]+:[0-9]+$ && "$graph_binding_syntax" =~ ^[0-9]+:[0-9]+$ ]] \
        || compile_project_fail "unable to materialize the transient Source-to-syntax binding"
    /usr/bin/printf 'compilerV1SyntaxBinding\tversion=1\tsourceFirst=%s\tsourceSecond=%s\tsyntaxFirst=%s\tsyntaxSecond=%s\n' \
        "$(fingerprint_first "$graph_binding_source")" "$(fingerprint_second "$graph_binding_source")" \
        "$(fingerprint_first "$graph_binding_syntax")" "$(fingerprint_second "$graph_binding_syntax")" > "$graph_syntax_binding"

    # Load stage: materialize the resume command's transient compatibility
    # input from the accepted revision. A legacy execution record is consumed
    # once to migrate an existing v2 graph cache.
    metrics_load_start_ms="$(now_ms)"
    graph_execution_source=empty
    graph_revision_bytes=0
    if [[ -f "$graph_revision" ]] \
        && write_transient_execution_from_revision "$graph_revision" "$graph_transient_execution"; then
        graph_execution_source=revision
    elif [[ -f "$graph_legacy_execution" ]]; then
        /bin/cp "$graph_legacy_execution" "$graph_transient_execution"
        graph_execution_source=legacy
    else
        : > "$graph_transient_execution"
    fi
    graph_transient_bytes="$(/usr/bin/stat -f %z "$graph_transient_execution")"
    if [[ -f "$graph_revision" ]]; then
        graph_revision_bytes="$(/usr/bin/stat -f %z "$graph_revision")"
    fi
    if [[ -f "$graph_output" ]]; then
        /bin/cp "$graph_output" "$graph_output_candidate"
    fi
    metrics_load_end_ms="$(now_ms)"
    graph_load_ms=$((metrics_load_end_ms - metrics_load_start_ms))

    # Reducer stage: V1 updates only transient candidate state. On reuse it
    # leaves the accepted revision and output untouched.
    metrics_reducer_start_ms="$(now_ms)"
    graph_status=0
    "$compiler" resume-v1-facts "$graph_transient_execution" "$graph_syntax_binding" "$graph_syntax_input" "$graph_bundle" "$graph_output_candidate" \
        > "$WORK_ROOT/graph-execution.out" || graph_status=$?
    metrics_reducer_end_ms="$(now_ms)"
    graph_reducer_ms=$((metrics_reducer_end_ms - metrics_reducer_start_ms))
    if [[ "$graph_status" -ne 0 ]]; then
        if [[ "$graph_had_bundle" -eq 1 ]]; then
            /bin/cp "$graph_bundle_backup" "$graph_bundle"
        elif [[ "$graph_source_consumed" -eq 0 ]]; then
            /bin/rm -f "$graph_bundle"
        fi
        /bin/cat "$WORK_ROOT/graph-execution.out" >&2
        exit "$graph_status"
    fi
    /bin/cat "$WORK_ROOT/graph-execution.out" >&2

    graph_committed=0
    if /usr/bin/grep -Fq $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/graph-execution.out" \
        && [[ "$graph_source_consumed" -eq 1 && "$graph_syntax_consumed" -eq 1 && "$graph_execution_source" == "revision" ]]; then
        [[ -f "$graph_revision" ]] \
            || compile_project_fail "unchanged graph execution is missing its accepted revision artifact"
        /bin/rm -f "$graph_output_candidate" "$graph_revision_candidate" "$graph_syntax_candidate"
    else
        write_graph_revision "$graph_revision_candidate" "$graph_revision" "$WORK_ROOT/graph-execution.out" \
            "$graph_transient_execution" "$graph_syntax_input" "$graph_bundle" "$graph_output_candidate" \
            "$source_profile" "$graph_input_identity" "$graph_compiler_hash"
        if [[ "$graph_syntax_consumed" -eq 0 ]]; then
            /bin/mv "$graph_syntax_candidate" "$graph_syntax"
        fi
        /bin/mv "$graph_output_candidate" "$graph_output"
        prepare_graph_delta_commit "$graph_revision_candidate" "$graph_revision" \
            "$graph_delta_directory" "$graph_delta_head" "$graph_delta_head_candidate"
        /bin/mv "$graph_revision_candidate" "$graph_revision"
        /bin/mv "$graph_delta_head_candidate" "$graph_delta_head"
        graph_committed=1
    fi
    /bin/rm -f "$graph_cache_directory/source.tsv" "$graph_legacy_execution"

    # Query stage: read the committed revision record and report which phases
    # committed a new delta versus consumed the prior accepted value. A phase
    # whose before and after values are equal consumed the persisted revision.
    metrics_query_start_ms="$(now_ms)"
    graph_execution_status="$(revision_field "$WORK_ROOT/graph-execution.out" status)"
    graph_views_affected=0
    graph_source_flag="consumed"
    graph_syntax_flag="consumed"
    graph_shape_flag="consumed"
    graph_behavior_flag="consumed"
    graph_compile_flag="consumed"
    if [[ "$graph_execution_status" != "reused" ]]; then
        for graph_node in source shape behavior compiled; do
            graph_before="$(revision_field "$WORK_ROOT/graph-execution.out" "${graph_node}Before")"
            graph_after="$(revision_field "$WORK_ROOT/graph-execution.out" "${graph_node}After")"
            if [[ "$graph_before" == "$graph_after" ]]; then
                graph_flag="consumed"
            else
                graph_flag="derived"
                graph_views_affected=$((graph_views_affected + 1))
            fi
            case "$graph_node" in
                source) graph_source_flag="$graph_flag" ;;
                shape) graph_shape_flag="$graph_flag" ;;
                behavior) graph_behavior_flag="$graph_flag" ;;
                compiled) graph_compile_flag="$graph_flag" ;;
            esac
        done
    fi
    if [[ "$graph_committed" -eq 1 && "$(revision_node_value "$graph_revision" syntax changed)" == "1" ]]; then
        graph_syntax_flag="derived"
        graph_views_affected=$((graph_views_affected + 1))
    fi
    metrics_query_end_ms="$(now_ms)"
    graph_query_ms=$((metrics_query_end_ms - metrics_query_start_ms))

    # Materialize stage: the compiled view is emitted as the command product.
    metrics_materialize_start_ms="$(now_ms)"
    /bin/cat "$graph_output"
    /usr/bin/printf '\n'
    metrics_materialize_end_ms="$(now_ms)"
    graph_materialize_ms=$((metrics_materialize_end_ms - metrics_materialize_start_ms))

    /usr/bin/printf 'rangeGraphMetrics\tversion=1\tloadMs=%s\treducerMs=%s\tqueryMs=%s\tmaterializeMs=%s\tsourceMs=%s\tsyntaxMs=%s\tviewsAffected=%s\tsourceArtifact=%s\tsyntaxArtifact=%s\tsource=%s\tsyntax=%s\tshape=%s\tbehavior=%s\tcompile=%s\ttransientBytes=%s\trevisionBytes=%s\texecutionSource=%s\n' \
        "$graph_load_ms" "$graph_reducer_ms" "$graph_query_ms" "$graph_materialize_ms" "$graph_source_ms" "$graph_syntax_ms" "$graph_views_affected" \
        "$graph_source_consumed" "$graph_syntax_consumed" "$graph_source_flag" "$graph_syntax_flag" "$graph_shape_flag" "$graph_behavior_flag" "$graph_compile_flag" \
        "$graph_transient_bytes" "$graph_revision_bytes" "$graph_execution_source" >&2
    exit 0
fi

exec "$compiler" "$compiler_command" "$project_bundle"
