#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CANDIDATE_COMPILER="${1:-$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/current/RangeCompiler}"
BUILD_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/range-identity-arena.XXXXXX")"

cleanup() {
    if [[ "${RANGE_KEEP_IDENTITY_ARENA_BUILD_ROOT:-0}" == "1" ]]; then
        echo "Identity arena build root: $BUILD_ROOT"
    else
        /bin/rm -rf "$BUILD_ROOT"
    fi
}
trap cleanup EXIT

if [[ ! -x "$CANDIDATE_COMPILER" ]]; then
    echo "Candidate compiler is not executable: $CANDIDATE_COMPILER" >&2
    exit 66
fi

HARNESS="$BUILD_ROOT/IdentityArenaRuntime.c"
HARNESS_EXECUTABLE="$BUILD_ROOT/IdentityArenaRuntime"
LLVM="$BUILD_ROOT/IdentityArenaLifetime.ll"
EXECUTABLE="$BUILD_ROOT/IdentityArenaLifetime"

/usr/bin/printf '%s\n' \
    '#include <stddef.h>' \
    '#include <stdint.h>' \
    '#include <string.h>' \
    '' \
    'void rangeIdentityArenaBegin(void);' \
    'void rangeIdentityArenaDestroy(void);' \
    'void *rangeConstructIdentityCreate(uint64_t byteCount);' \
    'int32_t stringTransientRegionMark(void);' \
    'int32_t stringTransientRegionReset(int32_t mark);' \
    'void *stringTransientAllocate(size_t size);' \
    '' \
    'int main(void) {' \
    '    const size_t alignment = _Alignof(max_align_t);' \
    '    rangeIdentityArenaBegin();' \
    '    unsigned char *first = rangeConstructIdentityCreate(3);' \
    '    unsigned char *second = rangeConstructIdentityCreate(24);' \
    '    if ((uintptr_t)first % alignment != 0 || (uintptr_t)second % alignment != 0) return 1;' \
    '    if (second != first + alignment) return 2;' \
    '    for (size_t index = 0; index < 3; index += 1) if (first[index] != 0) return 3;' \
    '    for (size_t index = 0; index < 24; index += 1) if (second[index] != 0) return 4;' \
    '    first[0] = 17;' \
    '    second[0] = 23;' \
    '    int32_t mark = stringTransientRegionMark();' \
    '    void *scratch = stringTransientAllocate(128);' \
    '    if (!scratch) return 5;' \
    '    memset(scratch, 1, 128);' \
    '    if (stringTransientRegionReset(mark) != 0) return 6;' \
    '    if (first[0] != 17 || second[0] != 23) return 7;' \
    '    rangeIdentityArenaDestroy();' \
    '    rangeIdentityArenaBegin();' \
    '    unsigned char *third = rangeConstructIdentityCreate(8);' \
    '    for (size_t index = 0; index < 8; index += 1) if (third[index] != 0) return 8;' \
    '    rangeIdentityArenaDestroy();' \
    '    return 0;' \
    '}' > "$HARNESS"

clang -std=c11 -Wall -Wextra -Werror \
    "$HARNESS" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
    -o "$HARNESS_EXECUTABLE"
"$HARNESS_EXECUTABLE"

"$CANDIDATE_COMPILER" "$REPO_ROOT/Testing/Memory/Pass/IdentityArenaLifetime.range" > "$LLVM"
/usr/bin/grep -Fq 'call ptr @rangeConstructIdentityCreate(i64 ' "$LLVM"
[[ "$(/usr/bin/grep -F -c 'call void @rangeIdentityArenaBegin()' "$LLVM")" -eq 1 ]]
[[ "$(/usr/bin/grep -F -c 'call void @rangeIdentityArenaDestroy()' "$LLVM")" -eq 1 ]]

clang -Wno-override-module -x ir "$LLVM" -x c \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
    -o "$EXECUTABLE"

set +e
"$EXECUTABLE"
range_exit=$?
set -e
if [[ "$range_exit" -ne 7 ]]; then
    echo "Identity arena Range proof failed: expected 7, got $range_exit" >&2
    exit 1
fi

echo "Identity arena bump allocation, String-region isolation, bulk reset, and emitted main lifetime verified."
