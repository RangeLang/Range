#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PASS_FIXTURE="$REPO_ROOT/Testing/CompilerB/Pass/SourceGraphFunction.range"
FAIL_FIXTURE="$REPO_ROOT/Testing/CompilerB/Fail/UnbalancedBlock.range"

fail() {
    echo "range compiler b source-graph check: $*" >&2
    exit 1
}

pass_output="$("$REPO_ROOT/scripts/run-range-compiler-b-source-graph" "$PASS_FIXTURE")" \
    || fail "pass fixture failed"
[[ "$pass_output" == *$'rangeCompilerB\tphase=resolution\tvalid=true'* ]] \
    || fail "pass fixture did not report a valid source graph"
[[ "$pass_output" == *$'tokenCount=29\tsyntaxCount=10'* ]] \
    || fail "pass fixture token or syntax count changed"
[[ "$pass_output" == *$'relationshipCount=8\tresolutionCount=1\tretainedFactCount=48\tretainedGraphValid=true'* ]] \
    || fail "pass fixture retained graph product changed"
repeat_output="$("$REPO_ROOT/scripts/run-range-compiler-b-source-graph" "$PASS_FIXTURE")" \
    || fail "repeat pass fixture failed"
pass_product="$(/usr/bin/printf '%s\n' "$pass_output" | /usr/bin/grep '^rangeCompilerB' | /usr/bin/head -1)"
repeat_product="$(/usr/bin/printf '%s\n' "$repeat_output" | /usr/bin/grep '^rangeCompilerB' | /usr/bin/head -1)"
[[ "$pass_product" == "$repeat_product" ]] \
    || fail "pass fixture graph product is not deterministic"

failure_output=""
failure_status=0
failure_output="$("$REPO_ROOT/scripts/run-range-compiler-b-source-graph" "$FAIL_FIXTURE")" \
    || failure_status=$?
[[ "$failure_status" -eq 65 ]] \
    || fail "fail fixture exited $failure_status instead of 65"
[[ "$failure_output" == *$'valid=false'* ]] \
    || fail "fail fixture did not reject its source graph"
[[ "$failure_output" == *$'retainedGraphValid=true'* ]] \
    || fail "fail fixture corrupted the retained facts"
[[ "$failure_output" == *$'unclosedBlockCount=1'* ]] \
    || fail "fail fixture did not stop at the unclosed Block boundary"

echo "range compiler b source-graph check: pass (48 deterministic retained facts, 1 graph-derived resolution, exact unclosed-Block rejection)"
