#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RANGE_ROOT="${RANGE_ROOT:-$REPO_ROOT/RangeCompiler/Range}"
RANGE_BIN="${RANGE_BIN:-}"

usage() {
    cat >&2 <<'USAGE'
Usage:
  scripts/range check
  scripts/range run INPUT [-- ARGS...]
  scripts/range emit-llvm INPUT OUTPUT
  scripts/range check-llvm-examples [DIR]
  scripts/range check-llvm-runs [MANIFEST]
USAGE
}

range_compiler() {
    if [[ -n "$RANGE_BIN" ]]; then
        "$RANGE_BIN" "$@"
    else
        swift run --package-path "$REPO_ROOT/RangeCompiler" range "$@"
    fi
}

prepare_range_bin() {
    if [[ -n "$RANGE_BIN" ]]; then
        return
    fi

    swift build --package-path "$REPO_ROOT/RangeCompiler" --product range >/dev/null
    RANGE_BIN="$REPO_ROOT/RangeCompiler/.build/debug/range"
}

build_executable() {
    input="$1"

    range_compiler compile-executable --range-root "$RANGE_ROOT" "$input"
}

validate_run_manifest() {
    manifest="$1"
    require_full_coverage="$2"
    manifest_dir="$(cd "$(dirname "$manifest")" && pwd)"
    manifest_names_file="$(mktemp "${TMPDIR:-/tmp}/range-run-manifest-names.XXXXXX")"
    sorted_manifest_names_file="$(mktemp "${TMPDIR:-/tmp}/range-run-manifest-names-sorted.XXXXXX")"
    corpus_names_file="$(mktemp "${TMPDIR:-/tmp}/range-run-corpus-names.XXXXXX")"
    missing_names_file="$(mktemp "${TMPDIR:-/tmp}/range-run-missing-names.XXXXXX")"
    extra_names_file="$(mktemp "${TMPDIR:-/tmp}/range-run-extra-names.XXXXXX")"
    duplicate_names_file="$(mktemp "${TMPDIR:-/tmp}/range-run-duplicate-names.XXXXXX")"

    line_number=0
    manifest_entry_count=0
    while IFS=$'\t' read -r input expected_exit stdin_text args_text expected_stdout || [[ -n "${input:-}" ]]; do
        line_number=$((line_number + 1))
        if [[ -z "${input:-}" || "${input:0:1}" == "#" ]]; then
            continue
        fi
        manifest_entry_count=$((manifest_entry_count + 1))

        if [[ -z "${expected_exit:-}" || -z "${stdin_text:-}" || -z "${args_text:-}" ]]; then
            echo "Invalid manifest row $line_number in $manifest: expected at least file, exit, stdin, and args columns." >&2
            rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
            exit 1
        fi

        if ! [[ "$expected_exit" =~ ^[0-9]+$ ]] || (( expected_exit > 255 )); then
            echo "Invalid expected exit '$expected_exit' on manifest row $line_number in $manifest." >&2
            rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
            exit 1
        fi

        if [[ "$input" = /* ]]; then
            source_path="$input"
        else
            source_path="$manifest_dir/$input"
        fi
        if [[ ! -f "$source_path" ]]; then
            echo "Manifest row $line_number references missing source: $source_path" >&2
            rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
            exit 1
        fi

        basename "$source_path" >> "$manifest_names_file"
    done < "$manifest"

    if (( manifest_entry_count == 0 )); then
        echo "LLVM run manifest has no runnable entries: $manifest" >&2
        rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
        exit 1
    fi

    sort "$manifest_names_file" | uniq -d > "$duplicate_names_file"
    if [[ -s "$duplicate_names_file" ]]; then
        echo "Duplicate LLVM run manifest entries:" >&2
        sed -n '1,80p' "$duplicate_names_file" >&2
        rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
        exit 1
    fi

    if [[ "$require_full_coverage" == "true" ]]; then
        find "$manifest_dir" -maxdepth 1 -type f -name '*.range' -exec basename {} \; | sort > "$corpus_names_file"
        sort "$manifest_names_file" > "$sorted_manifest_names_file"
        comm -23 "$corpus_names_file" "$sorted_manifest_names_file" > "$missing_names_file"
        comm -13 "$corpus_names_file" "$sorted_manifest_names_file" > "$extra_names_file"

        if [[ -s "$missing_names_file" ]]; then
            echo "LLVM run manifest is missing example(s):" >&2
            sed -n '1,120p' "$missing_names_file" >&2
            rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
            exit 1
        fi
        if [[ -s "$extra_names_file" ]]; then
            echo "LLVM run manifest references non-corpus example(s):" >&2
            sed -n '1,120p' "$extra_names_file" >&2
            rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
            exit 1
        fi
    fi

    rm -f "$manifest_names_file" "$sorted_manifest_names_file" "$corpus_names_file" "$missing_names_file" "$extra_names_file" "$duplicate_names_file"
}

command="${1:-}"
if [[ -z "$command" ]]; then
    usage
    exit 1
fi
shift

case "$command" in
    check)
        if [[ $# -ne 0 ]]; then
            usage
            exit 1
        fi
        "$0" check-llvm-runs
        ;;
    emit-llvm)
        if [[ $# -ne 2 ]]; then
            usage
            exit 1
        fi
        range_compiler emit-llvm --range-root "$RANGE_ROOT" "$1" "$2"
        ;;
    check-llvm-examples)
        if [[ $# -gt 1 ]]; then
            usage
            exit 1
        fi

        examples_dir="${1:-$REPO_ROOT/RangePlayground/Examples/LLVM}"
        if [[ ! -d "$examples_dir" ]]; then
            echo "Missing LLVM examples directory: $examples_dir" >&2
            exit 1
        fi
        example_count="$(find "$examples_dir" -maxdepth 1 -type f -name '*.range' -print | wc -l | tr -d '[:space:]')"
        if [[ "$example_count" == "0" ]]; then
            echo "No LLVM examples found in: $examples_dir" >&2
            exit 1
        fi

        prepare_range_bin
        build_root="$(mktemp -d "${TMPDIR:-/tmp}/range-llvm-examples.XXXXXX")"
        trap 'rm -rf "$build_root"' EXIT

        count=0
        while IFS= read -r input; do
            count=$((count + 1))
            output="$build_root/$(basename "$input" .range).ll"
            echo "[$count] emit $(basename "$input")"
            range_compiler emit-llvm --range-root "$RANGE_ROOT" "$input" "$output"
        done < <(find "$examples_dir" -maxdepth 1 -type f -name '*.range' -print | sort)

        echo "LLVM emission succeeded for $count example(s)."
        ;;
    check-llvm-runs)
        if [[ $# -gt 1 ]]; then
            usage
            exit 1
        fi

        require_full_coverage="false"
        if [[ $# -eq 0 ]]; then
            manifest="$REPO_ROOT/RangePlayground/Examples/LLVM/run-manifest.tsv"
            require_full_coverage="true"
        else
            manifest="$1"
        fi
        if [[ ! -f "$manifest" ]]; then
            echo "Missing LLVM run manifest: $manifest" >&2
            exit 1
        fi

        validate_run_manifest "$manifest" "$require_full_coverage"
        prepare_range_bin
        manifest_dir="$(cd "$(dirname "$manifest")" && pwd)"
        count=0
        while IFS=$'\t' read -r input expected_exit stdin_text args_text expected_stdout || [[ -n "${input:-}" ]]; do
            if [[ -z "${input:-}" || "${input:0:1}" == "#" ]]; then
                continue
            fi
            if [[ -z "${expected_exit:-}" || -z "${stdin_text:-}" ]]; then
                echo "Invalid manifest row: $input" >&2
                exit 1
            fi

            if [[ "$input" = /* ]]; then
                source_path="$input"
            else
                source_path="$manifest_dir/$input"
            fi

            count=$((count + 1))
            echo "[$count] run $(basename "$source_path")"
            executable="$(build_executable "$source_path")"
            stdout_file="$(mktemp "${TMPDIR:-/tmp}/range-run-stdout.XXXXXX")"
            stderr_file="$(mktemp "${TMPDIR:-/tmp}/range-run-stderr.XXXXXX")"
            expected_stdout_file="$(mktemp "${TMPDIR:-/tmp}/range-run-expected-stdout.XXXXXX")"
            run_args=()
            if [[ -n "${args_text:-}" && "$args_text" != "-" ]]; then
                read -r -a run_args <<< "$args_text"
            fi

            set +e
            if [[ "$stdin_text" == "-" ]]; then
                if [[ ${#run_args[@]} -eq 0 ]]; then
                    "$executable" >"$stdout_file" 2>"$stderr_file"
                else
                    "$executable" "${run_args[@]}" >"$stdout_file" 2>"$stderr_file"
                fi
            else
                if [[ ${#run_args[@]} -eq 0 ]]; then
                    printf '%b' "$stdin_text" | "$executable" >"$stdout_file" 2>"$stderr_file"
                else
                    printf '%b' "$stdin_text" | "$executable" "${run_args[@]}" >"$stdout_file" 2>"$stderr_file"
                fi
            fi
            actual_exit=$?
            set -e

            if [[ "$actual_exit" != "$expected_exit" ]]; then
                echo "Expected exit $expected_exit, got $actual_exit for $source_path" >&2
                echo "--- stdout ---" >&2
                sed -n '1,80p' "$stdout_file" >&2
                echo "--- stderr ---" >&2
                sed -n '1,80p' "$stderr_file" >&2
                rm -f "$stdout_file" "$stderr_file" "$expected_stdout_file"
                exit 1
            fi

            if [[ -n "${expected_stdout:-}" && "$expected_stdout" != "-" ]]; then
                printf '%b' "$expected_stdout" >"$expected_stdout_file"
                if ! cmp -s "$expected_stdout_file" "$stdout_file"; then
                    echo "Stdout mismatch for $source_path" >&2
                    echo "--- expected stdout ---" >&2
                    sed -n '1,80p' "$expected_stdout_file" >&2
                    echo "--- actual stdout ---" >&2
                    sed -n '1,80p' "$stdout_file" >&2
                    echo "--- stderr ---" >&2
                    sed -n '1,80p' "$stderr_file" >&2
                    rm -f "$stdout_file" "$stderr_file" "$expected_stdout_file"
                    exit 1
                fi
            fi
            rm -f "$stdout_file" "$stderr_file" "$expected_stdout_file"
        done < "$manifest"

        echo "LLVM run checks succeeded for $count example(s)."
        ;;
    run)
        if [[ $# -lt 1 ]]; then
            usage
            exit 1
        fi
        input="$1"
        shift
        if [[ "${1:-}" == "--" ]]; then
            shift
        fi

        range_compiler run --range-root "$RANGE_ROOT" "$input" -- "$@"
        ;;
    *)
        usage
        exit 1
        ;;
esac
