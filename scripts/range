#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/Language/Bootstrap/Manifest.json"

usage() {
    cat >&2 <<'USAGE'
Usage:
  range version
  range compiler --emit-assembly <PROJECT>
  range run <PROJECT> [-- ARGS...]
  range check-compiler
  range check-compiler-self-host [--audit-only|--expect-boundary]
USAGE
}

command="${1:-}"
if [[ -z "$command" ]]; then usage; exit 64; fi
shift

case "$command" in
    version|--version)
        [[ $# -eq 0 ]] || { usage; exit 64; }
        name="$(/usr/bin/plutil -extract compiler.name raw -o - "$MANIFEST")"
        channel="$(/usr/bin/plutil -extract compiler.channel raw -o - "$MANIFEST")"
        hash="$(/usr/bin/plutil -extract compiler.sha256 raw -o - "$MANIFEST")"
        printf '%s (%s) %s\n' "$name" "$channel" "$hash"
        ;;
    compiler)
        [[ $# -eq 2 && "$1" == "--emit-assembly" ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/run-range-compiler" "$@"
        ;;
    run)
        [[ $# -ge 1 ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/run-range-project" "$@"
        ;;
    check-compiler)
        [[ $# -eq 0 ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/check-range-compiler"
        ;;
    check-compiler-self-host)
        [[ $# -le 1 ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/check-range-compiler-self-host" "$@"
        ;;
    *)
        usage
        exit 64
        ;;
esac
