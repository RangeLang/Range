#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerSeed.json"

usage() {
    cat >&2 <<'USAGE'
Usage:
  range version
  range compile <FILE-OR-DIR>
  range compiler next
  range compiler next --cached-only
  range compiler progression
  range compiler progression --cached-only
  range compiler COMMAND [ARGS...]
  range check-build-plan
  range check-root-value [DIR]
  range check-compiler-smoke [DIR]
  range check-compiler-candidate [DIR]
  range check-seed-integrity
  range check-stage2-compiler

The supported native surface is the self-hosted compiler kernel and its proof
commands. Broader language commands return only after their implementations are
Range-owned and covered by the native proof boundary.
USAGE
}

command="${1:-}"
if [[ -z "$command" ]]; then
    usage
    exit 1
fi
shift

case "$command" in
    version|--version)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        compiler_name="$(/usr/bin/plutil -extract compiler.name raw -o - "$MANIFEST")"
        compiler_version="$(/usr/bin/plutil -extract compiler.version raw -o - "$MANIFEST")"
        compiler_channel="$(/usr/bin/plutil -extract compiler.channel raw -o - "$MANIFEST")"
        seed_hash="$(/usr/bin/plutil -extract seed.sha256 raw -o - "$MANIFEST")"
        /usr/bin/printf '%s %s (%s) %s\n' \
            "$compiler_name" "$compiler_version" "$compiler_channel" "$seed_hash"
        ;;
    compile)
        if [[ $# -ne 1 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/compile-range-project" "$1"
        ;;
    compiler)
        compiler_command="${1:-}"
        if [[ -z "$compiler_command" ]]; then usage; exit 1; fi
        shift
        case "$compiler_command" in
            next)
                if [[ $# -eq 0 ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-next
                elif [[ $# -eq 1 && "$1" == "--cached-only" ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-next-cached
                else
                    usage
                    exit 1
                fi
                ;;
            progression)
                if [[ $# -eq 0 ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-progression
                elif [[ $# -eq 1 && "$1" == "--cached-only" ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-progression-cached
                else
                    usage
                    exit 1
                fi
                ;;
            *)
                "$REPO_ROOT/scripts/range-native" compiler-command "$compiler_command" "$@"
                ;;
        esac
        ;;
    check-build-plan)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/check-range-build-plan"
        ;;
    check-root-value)
        if [[ $# -gt 2 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/check-range-root-value" "$@"
        ;;
    check-compiler-smoke)
        if [[ $# -gt 1 ]]; then usage; exit 1; fi
        if [[ $# -eq 1 ]]; then
            "$REPO_ROOT/scripts/check-range-compiler-candidate" --checkpoint stage2-plan "$1"
        else
            "$REPO_ROOT/scripts/check-range-compiler-candidate" --checkpoint stage2-plan
        fi
        ;;
    check-compiler-candidate)
        if [[ $# -gt 1 ]]; then usage; exit 1; fi
        compiler_dir="${1:-$REPO_ROOT/RangeCompiler/Sources/Compiler}"
        "$REPO_ROOT/scripts/check-range-compiler-candidate" "$compiler_dir"
        ;;
    check-stage2-compiler)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/verify-range-compiler-seed"
        ;;
    check-seed-integrity)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/verify-range-compiler-seed" --integrity-only
        ;;
    *)
        usage
        exit 1
        ;;
esac
