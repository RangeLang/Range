#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
    cat >&2 <<'USAGE'
Usage:
  scripts/range compiler next
  scripts/range compiler next --cached-only
  scripts/range compiler progression
  scripts/range compiler progression --cached-only
  scripts/range compiler COMMAND [ARGS...]
  scripts/range check-build-plan
  scripts/range check-compiler-smoke [DIR]
  scripts/range check-compiler-candidate [DIR]
  scripts/range check-seed-integrity
  scripts/range check-stage2-compiler

The supported native surface is the self-hosted compiler kernel and its proof
commands. Broader language commands return only after their implementations are
Range-owned and covered by the native proof boundary.
USAGE
}

command="${1:-}"
if [[ -z "$command" ]]; then
    usage
    exit 1
fi
shift

case "$command" in
    compiler)
        compiler_command="${1:-}"
        if [[ -z "$compiler_command" ]]; then usage; exit 1; fi
        shift
        case "$compiler_command" in
            next)
                if [[ $# -eq 0 ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-next
                elif [[ $# -eq 1 && "$1" == "--cached-only" ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-next-cached
                else
                    usage
                    exit 1
                fi
                ;;
            progression)
                if [[ $# -eq 0 ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-progression
                elif [[ $# -eq 1 && "$1" == "--cached-only" ]]; then
                    "$REPO_ROOT/scripts/range-native" compiler-progression-cached
                else
                    usage
                    exit 1
                fi
                ;;
            *)
                "$REPO_ROOT/scripts/range-native" compiler-command "$compiler_command" "$@"
                ;;
        esac
        ;;
    check-build-plan)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/check-range-build-plan"
        ;;
    check-compiler-smoke)
        if [[ $# -gt 1 ]]; then usage; exit 1; fi
        if [[ $# -eq 1 ]]; then
            "$REPO_ROOT/scripts/check-range-compiler-candidate" --checkpoint stage2-plan "$1"
        else
            "$REPO_ROOT/scripts/check-range-compiler-candidate" --checkpoint stage2-plan
        fi
        ;;
    check-compiler-candidate)
        if [[ $# -gt 1 ]]; then usage; exit 1; fi
        compiler_dir="${1:-$REPO_ROOT/RangeCompiler/Range/Programs/Compiler}"
        "$REPO_ROOT/scripts/check-range-compiler-candidate" "$compiler_dir"
        ;;
    check-stage2-compiler)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/verify-range-compiler-seed"
        ;;
    check-seed-integrity)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        "$REPO_ROOT/scripts/verify-range-compiler-seed" --integrity-only
        ;;
    *)
        usage
        exit 1
        ;;
esac
