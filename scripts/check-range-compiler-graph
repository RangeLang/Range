#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerBootstrap.json"
FIXTURE="$REPO_ROOT/Testing/Basics/Pass/ReturnInteger.range"
WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-compiler-graph.XXXXXX")"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

fail() {
    echo "Range compiler graph check failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

"$REPO_ROOT/scripts/range" check-compiler-smoke > "$WORK_ROOT/candidate.out"
compiler="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler"
[[ -x "$compiler" ]] || fail "candidate graph compiler is not executable"
[[ -f "$FIXTURE" ]] || fail "missing graph fixture"

# Compare the real project commands: the graph line consumes the same
# Core/project source-set inventory as the legacy line, with its explicit V1
# development marker carried in the source artifact.
"$REPO_ROOT/scripts/range" compile "$FIXTURE" > "$WORK_ROOT/oracle.ll"
RANGE_GRAPH_CACHE_DIR="$WORK_ROOT/graph-cache" \
    "$REPO_ROOT/scripts/range" compile-graph "$FIXTURE" \
    > "$WORK_ROOT/graph.ll" 2> "$WORK_ROOT/graph-cold.out"
/usr/bin/cmp -s "$WORK_ROOT/oracle.ll" "$WORK_ROOT/graph.ll" \
    || fail "graph compiler output differs from the legacy oracle"
/usr/bin/grep -Eq $'^compilerV1Execution\tstatus=cold\tchanged=1\t' "$WORK_ROOT/graph-cold.out" \
    || fail "graph project compile did not persist a cold File -> Source generation"
[[ -z "$(/usr/bin/find "$WORK_ROOT/graph-cache" -type f -name source.tsv -print -quit)" ]] \
    || fail "graph project compile persisted the superseded source.tsv authority"
[[ -z "$(/usr/bin/find "$WORK_ROOT/graph-cache" -type f -name execution.tsv -print -quit)" ]] \
    || fail "graph project compile persisted transient execution state"
RANGE_GRAPH_CACHE_DIR="$WORK_ROOT/graph-cache" \
    "$REPO_ROOT/scripts/range" compile-graph "$FIXTURE" \
    > "$WORK_ROOT/graph-warm.ll" 2> "$WORK_ROOT/graph-warm.out"
/usr/bin/cmp -s "$WORK_ROOT/graph.ll" "$WORK_ROOT/graph-warm.ll" \
    || fail "warm graph project compile changed its compiled artifact"
/usr/bin/grep -Fqx $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/graph-warm.out" \
    || fail "warm graph project compile did not reuse File -> Source"
[[ -z "$(/usr/bin/find "$WORK_ROOT/graph-cache" -type f -name execution.tsv -print -quit)" ]] \
    || fail "warm graph project compile recreated execution.tsv"

/bin/mkdir -p "$WORK_ROOT/failed-project"
/bin/cp "$FIXTURE" "$WORK_ROOT/failed-project/ReturnInteger.range"
RANGE_GRAPH_CACHE_DIR="$WORK_ROOT/failure-cache" \
    "$REPO_ROOT/scripts/range" compile-graph "$WORK_ROOT/failed-project" \
    > "$WORK_ROOT/failure-cold.ll" 2> "$WORK_ROOT/failure-cold.out"
/usr/bin/perl -0pi -e 's/return 7/return missingValue/' "$WORK_ROOT/failed-project/ReturnInteger.range"
failed_status=0
RANGE_GRAPH_CACHE_DIR="$WORK_ROOT/failure-cache" \
    "$REPO_ROOT/scripts/range" compile-graph "$WORK_ROOT/failed-project" \
    > "$WORK_ROOT/failure-candidate.ll" 2> "$WORK_ROOT/failure-candidate.out" \
    || failed_status=$?
[[ "$failed_status" -eq 65 ]] \
    || fail "failed graph candidate exited $failed_status instead of 65"
/usr/bin/grep -Fq $'compilerError\t' "$WORK_ROOT/failure-candidate.out" \
    || fail "failed graph candidate omitted its typed compiler error"
/usr/bin/perl -0pi -e 's/return missingValue/return 7/' "$WORK_ROOT/failed-project/ReturnInteger.range"
RANGE_GRAPH_CACHE_DIR="$WORK_ROOT/failure-cache" \
    "$REPO_ROOT/scripts/range" compile-graph "$WORK_ROOT/failed-project" \
    > "$WORK_ROOT/failure-recovered.ll" 2> "$WORK_ROOT/failure-recovered.out"
/usr/bin/cmp -s "$WORK_ROOT/failure-cold.ll" "$WORK_ROOT/failure-recovered.ll" \
    || fail "failed graph candidate damaged the last-known-good artifact"
/usr/bin/grep -Fqx $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/failure-recovered.out" \
    || fail "failed graph candidate did not restore the accepted File -> Source"
[[ -z "$(/usr/bin/find "$WORK_ROOT/failure-cache" -type f -name execution.tsv -print -quit)" ]] \
    || fail "failed graph lifecycle persisted transient execution state"

"$compiler" compile-v1 "$FIXTURE" > "$WORK_ROOT/direct-graph.ll"

"$compiler" inspect-v1 "$FIXTURE" > "$WORK_ROOT/inspect.out"
for phase in source shape behavior compile; do
    /usr/bin/grep -Fq $'compilerV1Delta\tphase='"$phase"$'\t' "$WORK_ROOT/inspect.out" \
        || fail "inspect-v1 omitted the $phase delta"
done

/bin/cp "$FIXTURE" "$WORK_ROOT/Persistent.range"
"$compiler" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" \
    > "$WORK_ROOT/cold.out"
/usr/bin/grep -Eq $'^compilerV1Execution\tstatus=cold\tchanged=1\t' "$WORK_ROOT/cold.out" \
    || fail "graph execution did not insert a cold generation"
/bin/cp "$WORK_ROOT/persistent.ll" "$WORK_ROOT/persistent-with-newline.ll"
/usr/bin/printf '\n' >> "$WORK_ROOT/persistent-with-newline.ll"
/usr/bin/cmp -s "$WORK_ROOT/direct-graph.ll" "$WORK_ROOT/persistent-with-newline.ll" \
    || fail "cold graph execution changed the compiled artifact"

execution_hash="$(/usr/bin/shasum -a 256 "$WORK_ROOT/execution.tsv" | /usr/bin/awk '{print $1}')"
output_hash="$(/usr/bin/shasum -a 256 "$WORK_ROOT/persistent.ll" | /usr/bin/awk '{print $1}')"
"$compiler" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" \
    > "$WORK_ROOT/warm.out"
/usr/bin/grep -Fqx $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/warm.out" \
    || fail "unchanged graph execution did not reuse its compiled artifact"
[[ "$execution_hash" == "$(/usr/bin/shasum -a 256 "$WORK_ROOT/execution.tsv" | /usr/bin/awk '{print $1}')" ]] \
    || fail "unchanged graph execution rewrote its persistent state"
[[ "$output_hash" == "$(/usr/bin/shasum -a 256 "$WORK_ROOT/persistent.ll" | /usr/bin/awk '{print $1}')" ]] \
    || fail "unchanged graph execution rewrote its compiled artifact"

/usr/bin/perl -0pi -e 's/return 7/return 8/' "$WORK_ROOT/Persistent.range"
"$compiler" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" \
    > "$WORK_ROOT/updated.out"
/usr/bin/grep -Eq $'^compilerV1Execution\tstatus=updated\tchanged=1\t' "$WORK_ROOT/updated.out" \
    || fail "edited graph execution did not produce a replacement generation"
if /usr/bin/cmp -s "$WORK_ROOT/direct-graph.ll" "$WORK_ROOT/persistent.ll"; then
    fail "edited graph execution retained the stale compiled artifact"
fi

echo "Range compiler graph: pass (project source-set parity, durable File -> Source cold insertion/warm reuse, artifact inspection, edited replacement, failed-candidate recovery)"
