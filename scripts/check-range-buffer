#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPILER="${1:-}"
WORK_ROOT="$(mktemp -d)"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

append_source() {
    local bundle="$1"
    local role="$2"
    local marker="$3"
    local source="$4"
    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$marker" >> "$bundle"
    /bin/cat "$source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
}

check_case() {
    local name="$1"
    local fixture="$2"
    local expected_exit="$3"
    local expected_type="$4"
    local create_symbol="$5"
    local append_symbol="$6"
    local load_symbol="$7"
    local store_symbol="$8"
    local bundle="$WORK_ROOT/$name.range"
    local llvm="$WORK_ROOT/$name.ll"
    local executable="$WORK_ROOT/$name"
    local run_output="$WORK_ROOT/$name.out"
    local run_error="$WORK_ROOT/$name.err"
    local compile_error="$WORK_ROOT/$name.compile.err"

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$bundle"
    append_source "$bundle" core RangeCompiler/Sources/Core/System/Memory/RawBuffer.range "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
    append_source "$bundle" core RangeCompiler/Sources/Core/System/Memory/Buffer.range "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range"
    append_source "$bundle" project "$fixture" "$REPO_ROOT/$fixture"

    local compile_status=0
    if [[ -n "$COMPILER" ]]; then
        "$COMPILER" "$bundle" > "$llvm" 2> "$compile_error" || compile_status=$?
    else
        RANGE_CACHE_DISABLE=1 "$REPO_ROOT/scripts/range" compiler compile "$bundle" > "$llvm" 2> "$compile_error" || compile_status=$?
    fi
    if [[ "$compile_status" -ne 0 ]]; then
        /bin/cat "$llvm"
        /bin/cat "$compile_error" >&2
        local failure_offset
        failure_offset="$(/usr/bin/grep -Eo 'failureCode=[0-9]+' "$llvm" | /usr/bin/cut -d= -f2 || true)"
        if [[ -n "$failure_offset" ]]; then
            /usr/bin/printf 'failure source offset %s:\n' "$failure_offset" >&2
            /bin/dd if="$bundle" bs=1 skip="$failure_offset" count=160 2>/dev/null >&2
            /usr/bin/printf '\n' >&2
        fi
        exit 1
    fi
    if ! clang -O2 -flto=thin -Wno-override-module "$llvm" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeString.c" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
        "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
        -o "$executable"; then
        /usr/bin/grep -E '^%.* = type' "$llvm" >&2 || true
        exit 1
    fi

    set +e
    "$executable" > "$run_output" 2> "$run_error"
    local run_status=$?
    set -e

    [[ "$run_status" -eq "$expected_exit" ]] || { echo "$name exited $run_status, expected $expected_exit" >&2; exit 1; }
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || { echo "$name wrote output" >&2; exit 1; }
    /usr/bin/grep -Fq "$expected_type" "$llvm" || { echo "$name omitted $expected_type element lowering" >&2; exit 1; }
    /usr/bin/grep -Fq "call ptr @$create_symbol(i32 1)" "$llvm" || { echo "$name omitted $create_symbol" >&2; exit 1; }
    if /usr/bin/grep -Fq 'call ptr @rawBufferCreate' "$llvm"; then
        echo "$name exposed rawBufferCreate instead of canonical Buffer creation" >&2
        exit 1
    fi
    /usr/bin/grep -Fq "call i32 @$append_symbol(" "$llvm" || { echo "$name omitted $append_symbol" >&2; exit 1; }
    /usr/bin/grep -Fq "@$load_symbol(" "$llvm" || { echo "$name omitted $load_symbol" >&2; exit 1; }
    /usr/bin/grep -Fq "call i32 @$store_symbol(" "$llvm" || { echo "$name omitted $store_symbol" >&2; exit 1; }
    /usr/bin/grep -Fq 'rawBufferDestroy' "$llvm" || { echo "$name omitted destruction" >&2; exit 1; }
}

check_unsupported_layout() {
    local bundle="$WORK_ROOT/BufferUnsupportedFloatLayout.range"
    local output="$WORK_ROOT/BufferUnsupportedFloatLayout.out"
    local error="$WORK_ROOT/BufferUnsupportedFloatLayout.err"

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$bundle"
    append_source "$bundle" core RangeCompiler/Sources/Core/System/Memory/RawBuffer.range "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
    append_source "$bundle" core RangeCompiler/Sources/Core/System/Memory/Buffer.range "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range"
    append_source "$bundle" project Testing/Collections/Fail/BufferUnsupportedFloatLayout.range "$REPO_ROOT/Testing/Collections/Fail/BufferUnsupportedFloatLayout.range"

    local status=0
    if [[ -n "$COMPILER" ]]; then
        "$COMPILER" "$bundle" > "$output" 2> "$error" || status=$?
    else
        RANGE_CACHE_DISABLE=1 "$REPO_ROOT/scripts/range" compiler compile "$bundle" > "$output" 2> "$error" || status=$?
    fi
    [[ "$status" -eq 65 ]] || { echo "unsupported Buffer<Float> layout exited $status, expected 65" >&2; exit 1; }
    [[ ! -s "$error" ]] || { echo "unsupported Buffer<Float> layout wrote stderr" >&2; exit 1; }
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$output" \
        || { /bin/cat "$output" >&2; echo "unsupported Buffer<Float> layout omitted its typed diagnostic" >&2; exit 1; }
    if /usr/bin/grep -Fq 'define ' "$output"; then
        echo "unsupported Buffer<Float> layout emitted LLVM" >&2
        exit 1
    fi
}

check_case BufferIntLifecycle Testing/Collections/Pass/BufferIntLifecycle.range 7 'i32' bufferCreateInt rawBufferAppendInt rawBufferLoadInt rawBufferStoreInt
check_case BufferUnsigned8Lifecycle Testing/Collections/Pass/BufferUnsigned8Lifecycle.range 1 'i8' bufferCreateUnsigned8 rawBufferAppendUnsigned8 rawBufferLoadUnsigned8 rawBufferStoreUnsigned8
check_unsupported_layout

echo "Canonical Buffer integer layouts verified."
