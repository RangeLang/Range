#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerSeed.json"

usage() {
    cat >&2 <<'USAGE'
Usage:
  scripts/range-native source-graph INPUT OUTPUT
  scripts/range-native compiler-command COMMAND [ARGS...]
  scripts/range-native compiler-next
  scripts/range-native compiler-next-cached
  scripts/range-native compiler-progression
  scripts/range-native compiler-progression-cached

This is the internal native self-hosting surface. source-graph remains exposed
for candidate verification; ordinary project compilation is not yet supported.
USAGE
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

sha256() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

verify_manifest_file() {
    local key="$1"
    local path expected actual
    path="$(manifest_value "$key.path")"
    expected="$(manifest_value "$key.sha256")"
    if [[ ! -f "$REPO_ROOT/$path" ]]; then
        echo "Missing native compiler input: $path" >&2
        exit 1
    fi
    actual="$(sha256 "$REPO_ROOT/$path")"
    if [[ "$actual" != "$expected" ]]; then
        echo "Native compiler input hash mismatch: $path" >&2
        echo "For compiler-source changes, run scripts/range check-compiler-candidate; repair or intentionally roll the seed for seed/runtime mismatches." >&2
        exit 1
    fi
}

verify_manifest_inputs() {
    if [[ "$(manifest_value formatVersion)" != "1" ]]; then
        echo "Unsupported Range compiler seed manifest." >&2
        exit 1
    fi
    if [[ "$(uname -m)" != "$(manifest_value target.architecture)" ]]; then
        echo "Native compiler seed target architecture mismatch." >&2
        exit 1
    fi
    verify_manifest_file seed
    local index runtime_count
    runtime_count="$(manifest_value runtimeSources)"
    for ((index = 0; index < runtime_count; index += 1)); do
        verify_manifest_file "runtimeSources.$index"
    done
}

runtime_inputs() {
    local index runtime_count
    runtime_count="$(manifest_value runtimeSources)"
    for ((index = 0; index < runtime_count; index += 1)); do
        /usr/bin/printf '%s\n' "$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")"
    done
}

compiler_project_file() {
    local project candidate
    candidate=""
    while IFS= read -r project; do
        if /usr/bin/grep -Eq '^[[:space:]]*@compiler[[:space:]]*$' "$project"; then
            if [[ -n "$candidate" ]]; then
                echo "Multiple @compiler projects are declared: $candidate and $project" >&2
                return 65
            fi
            candidate="$project"
        fi
    done < <(/usr/bin/find "$REPO_ROOT" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name Project.range -print | LC_ALL=C /usr/bin/sort)
    if [[ -z "$candidate" ]]; then
        echo "No @compiler project is declared." >&2
        return 66
    fi
    /usr/bin/printf '%s\n' "$candidate"
}

project_command_line_source() {
    local project project_root declaration relative source canonical
    project="$1"
    project_root="$(cd "$(dirname "$project")" && pwd)"
    declaration="$(/usr/bin/sed -n 's/^[[:space:]]*let[[:space:]]*commandLine:[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p' "$project")"
    if [[ -z "$declaration" || "$declaration" == *$'\n'* ]]; then
        echo "The project must declare exactly one commandLine source." >&2
        return 65
    fi
    relative="$(dirname "${project#"$REPO_ROOT/"}")/$declaration"
    source="$REPO_ROOT/$relative"
    if [[ ! -f "$source" && ! -d "$source" ]]; then
        echo "Missing project commandLine source: $relative" >&2
        return 66
    fi
    if [[ -d "$source" ]]; then
        canonical="$(cd "$source" && pwd)"
    else
        canonical="$(cd "$(dirname "$source")" && pwd)/$(basename "$source")"
    fi
    if [[ "$canonical" != "$project_root" && "$canonical" != "$project_root/"* ]]; then
        echo "Project commandLine source escapes its project root: $relative" >&2
        return 65
    fi
    /usr/bin/printf '%s\n' "$canonical"
}

compiler_project_command() {
    local compiler project command_line_source
    project="$(compiler_project_file)"
    command_line_source="$(project_command_line_source "$project")"
    if [[ ! -d "$command_line_source" && ! -f "$command_line_source" ]]; then return 66; fi
    compiler="$(ensure_seed_compiler)"
    compiler_cached_command "$compiler" "$@"
}

compiler_cache_trace() {
    if [[ "${RANGE_CACHE_TRACE:-0}" == "1" ]]; then
        /usr/bin/printf 'range-cache\t%s\n' "$1" >&2
    fi
}

compiler_cache_root() {
    /usr/bin/printf '%s\n' "${RANGE_COMPILER_CACHE_DIR:-$REPO_ROOT/.range/Compiler/Artifacts}"
}

compiler_cache_source_key() {
    local compiler="$1"
    local command="$2"
    local input="$3"
    local canonical
    canonical="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
    {
        /usr/bin/printf 'format=1\n'
        /usr/bin/printf 'compiler=%s\n' "$(sha256 "$compiler")"
        /usr/bin/printf 'command=%s\n' "$command"
        /usr/bin/printf 'path=%s\n' "$canonical"
        /usr/bin/printf 'source=%s\n' "$(sha256 "$canonical")"
    } | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
}

compiler_cache_metadata_value() {
    local metadata="$1"
    local key="$2"
    /usr/bin/sed -n "s/^${key}=//p" "$metadata"
}

compiler_cache_entry_is_valid() {
    local metadata="$1"
    local artifact="$2"
    local compiler="$3"
    local command="$4"
    local input="$5"
    local key="$6"
    local canonical
    [[ -f "$metadata" && -f "$artifact" ]] || return 1
    canonical="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
    [[ "$(compiler_cache_metadata_value "$metadata" format)" == "1"
        && "$(compiler_cache_metadata_value "$metadata" key)" == "$key"
        && "$(compiler_cache_metadata_value "$metadata" compiler)" == "$(sha256 "$compiler")"
        && "$(compiler_cache_metadata_value "$metadata" command)" == "$command"
        && "$(compiler_cache_metadata_value "$metadata" path)" == "$canonical"
        && "$(compiler_cache_metadata_value "$metadata" source)" == "$(sha256 "$canonical")"
        && "$(compiler_cache_metadata_value "$metadata" artifactHash)" == "$(sha256 "$artifact")"
        && "$(compiler_cache_metadata_value "$metadata" artifactBytes)" == "$(/usr/bin/stat -f %z "$artifact")" ]]
}

compiler_cache_publish() {
    local temporary="$1"
    local cache_root="$2"
    /bin/mv "$temporary/Artifact" "$cache_root/Artifact"
    /bin/mv "$temporary/Metadata.txt" "$cache_root/Metadata.txt"
    /bin/rmdir "$temporary"
}

compiler_cache_write_metadata() {
    local metadata="$1"
    local artifact="$2"
    local compiler="$3"
    local command="$4"
    local input="$5"
    local key="$6"
    local canonical
    canonical="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
    {
        /usr/bin/printf 'format=1\n'
        /usr/bin/printf 'key=%s\n' "$key"
        /usr/bin/printf 'compiler=%s\n' "$(sha256 "$compiler")"
        /usr/bin/printf 'command=%s\n' "$command"
        /usr/bin/printf 'path=%s\n' "$canonical"
        /usr/bin/printf 'source=%s\n' "$(sha256 "$canonical")"
        /usr/bin/printf 'artifactHash=%s\n' "$(sha256 "$artifact")"
        /usr/bin/printf 'artifactBytes=%s\n' "$(/usr/bin/stat -f %z "$artifact")"
    } > "$metadata"
}

compiler_cached_text_command() {
    local compiler="$1"
    local command="$2"
    local input="$3"
    local key cache_root artifact metadata temporary error status
    require_source_input "$input"
    if [[ "${RANGE_CACHE_DISABLE:-0}" == "1" ]]; then
        compiler_cache_trace "bypass command=$command"
        "$compiler" "$command" "$input"
        return $?
    fi
    key="$(compiler_cache_source_key "$compiler" "$command" "$input")"
    cache_root="$(compiler_cache_root)/$key"
    artifact="$cache_root/Artifact"
    metadata="$cache_root/Metadata.txt"
    if compiler_cache_entry_is_valid "$metadata" "$artifact" "$compiler" "$command" "$input" "$key"; then
        compiler_cache_trace "hit command=$command key=$key"
        /bin/cat "$artifact"
        return 0
    fi
    compiler_cache_trace "miss command=$command key=$key"
    /bin/mkdir -p "$cache_root"
    temporary="$cache_root/.build.$$"
    /bin/mkdir -p "$temporary"
    error="$temporary/Error.txt"
    if "$compiler" "$command" "$input" > "$temporary/Artifact" 2> "$error"; then status=0; else status=$?; fi
    if [[ -s "$error" ]]; then /bin/cat "$error" >&2; fi
    if [[ "$status" -ne 0 || -s "$error" ]]; then
        /bin/cat "$temporary/Artifact"
        /bin/rm -f "$temporary/Artifact" "$error"
        /bin/rmdir "$temporary"
        return "$status"
    fi
    /bin/rm -f "$error"
    compiler_cache_write_metadata "$temporary/Metadata.txt" "$temporary/Artifact" "$compiler" "$command" "$input" "$key"
    /bin/cat "$temporary/Artifact"
    compiler_cache_publish "$temporary" "$cache_root"
}

compiler_cached_emit_llvm() {
    local compiler="$1"
    local input="$2"
    local output="$3"
    local key cache_root artifact metadata temporary error status output_temporary
    require_source_input "$input"
    if [[ "${RANGE_CACHE_DISABLE:-0}" == "1" ]]; then
        compiler_cache_trace "bypass command=emit-llvm"
        "$compiler" emit-llvm "$input" "$output"
        return $?
    fi
    key="$(compiler_cache_source_key "$compiler" emit-llvm "$input")"
    cache_root="$(compiler_cache_root)/$key"
    artifact="$cache_root/Artifact"
    metadata="$cache_root/Metadata.txt"
    if ! compiler_cache_entry_is_valid "$metadata" "$artifact" "$compiler" emit-llvm "$input" "$key"; then
        compiler_cache_trace "miss command=emit-llvm key=$key"
        /bin/mkdir -p "$cache_root"
        temporary="$cache_root/.build.$$"
        /bin/mkdir -p "$temporary"
        error="$temporary/Error.txt"
        if "$compiler" emit-llvm "$input" "$temporary/Artifact" > "$temporary/Output.txt" 2> "$error"; then status=0; else status=$?; fi
        if [[ -s "$temporary/Output.txt" ]]; then /bin/cat "$temporary/Output.txt"; fi
        if [[ -s "$error" ]]; then /bin/cat "$error" >&2; fi
        if [[ "$status" -eq 0 && ( -s "$error" || -s "$temporary/Output.txt" || ! -f "$temporary/Artifact" ) ]]; then status=65; fi
        if [[ "$status" -ne 0 || -s "$error" || -s "$temporary/Output.txt" || ! -f "$temporary/Artifact" ]]; then
            /bin/rm -f "$temporary/Artifact" "$temporary/Output.txt" "$error"
            /bin/rmdir "$temporary"
            return "$status"
        fi
        /bin/rm -f "$temporary/Output.txt" "$error"
        compiler_cache_write_metadata "$temporary/Metadata.txt" "$temporary/Artifact" "$compiler" emit-llvm "$input" "$key"
        compiler_cache_publish "$temporary" "$cache_root"
    else
        compiler_cache_trace "hit command=emit-llvm key=$key"
    fi
    output_temporary="$output.tmp.$$"
    /bin/cp "$artifact" "$output_temporary"
    /bin/mv "$output_temporary" "$output"
}

compiler_cached_command() {
    local compiler="$1"
    local command="${2:-}"
    shift 2
    case "$command" in
        compile|check)
            if [[ $# -ne 1 ]]; then "$compiler" "$command" "$@"; return $?; fi
            compiler_cached_text_command "$compiler" "$command" "$1"
            ;;
        emit-llvm)
            if [[ $# -ne 2 ]]; then "$compiler" "$command" "$@"; return $?; fi
            compiler_cached_emit_llvm "$compiler" "$1" "$2"
            ;;
        *)
            "$compiler" "$command" "$@"
            ;;
    esac
}

ensure_seed_compiler() {
    verify_manifest_inputs
    local seed_hash manifest_hash cache_root executable seed runtime
    local -a runtimes
    seed_hash="$(manifest_value seed.sha256)"
    manifest_hash="$(sha256 "$MANIFEST")"
    cache_root="$REPO_ROOT/.range/NativeSeed/$seed_hash-$manifest_hash"
    executable="$cache_root/RangeCompiler"
    seed="$REPO_ROOT/$(manifest_value seed.path)"
    if [[ ! -x "$executable" ]]; then
        /bin/mkdir -p "$cache_root"
        runtimes=()
        while IFS= read -r runtime; do
            runtimes+=("$runtime")
        done < <(runtime_inputs)
        clang -Wno-override-module -x ir "$seed" -x c "${runtimes[@]}" -o "$executable.tmp"
        /bin/mv "$executable.tmp" "$executable"
    fi
    /usr/bin/printf '%s\n' "$executable"
}

require_source_input() {
    local input="$1"
    if [[ ! -f "$input" && ! -d "$input" ]]; then
        echo "Missing native Range input: $input" >&2
        exit 1
    fi
    if [[ -f "$input" && "${input##*.}" != "range" ]]; then
        echo "Native Range driver requires a .range source file: $input" >&2
        exit 1
    fi
}

source_graph_append_file() {
    local role="$1"
    local marker_path="$2"
    local source="$3"
    local bundle="$4"
    if [[ "$marker_path" == *$'\t'* || "$marker_path" == *$'\n'* || "$marker_path" == *' '* ]]; then
        echo "Range SourceGraph paths may not contain whitespace: $marker_path" >&2
        return 64
    fi
    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$marker_path" >> "$bundle"
    /bin/cat "$source" >> "$bundle"
    if [[ -n "$(/usr/bin/tail -c 1 "$source")" ]]; then
        /usr/bin/printf '\n' >> "$bundle"
    fi
}

source_graph_append_tree() {
    local role="$1"
    local marker_root="$2"
    local directory="$3"
    local bundle="$4"
    local absolute relative count
    directory="$(cd "$directory" && pwd)"
    count=0
    while IFS= read -r absolute; do
        relative="${absolute#"$directory/"}"
        source_graph_append_file "$role" "$marker_root/$relative" "$absolute" "$bundle" || return $?
        count=$((count + 1))
    done < <(/usr/bin/find "$directory" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print | LC_ALL=C /usr/bin/sort)
    if [[ "$count" -eq 0 ]]; then
        echo "No .range source files found in SourceGraph root: $directory" >&2
        return 66
    fi
}

source_graph_bundle() {
    local input="$1"
    local bundle="$2"
    local input_root absolute relative count
    require_source_input "$input"
    : > "$bundle"
    source_graph_append_tree core Core "$REPO_ROOT/RangeCompiler/Range/Core" "$bundle"
    source_graph_append_tree foundation Foundation "$REPO_ROOT/RangeCompiler/Range/Foundation" "$bundle"
    if [[ -f "$input" ]]; then
        absolute="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
        source_graph_append_file project "Project/$(basename "$absolute")" "$absolute" "$bundle"
        return
    fi
    input_root="$(cd "$input" && pwd)"
    count=0
    while IFS= read -r absolute; do
        relative="${absolute#"$input_root/"}"
        source_graph_append_file project "Project/$relative" "$absolute" "$bundle" || return $?
        count=$((count + 1))
    done < <(/usr/bin/find "$input_root" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print | LC_ALL=C /usr/bin/sort)
    if [[ "$count" -eq 0 ]]; then
        echo "No project .range source files found in: $input_root" >&2
        return 66
    fi
}

write_source_graph() {
    local input="$1"
    local output="$2"
    local output_dir
    output_dir="$(dirname "$output")"
    /bin/mkdir -p "$output_dir"
    output_dir="$(cd "$output_dir" && pwd)"
    source_graph_bundle "$input" "$output_dir/$(basename "$output")"
}

compiler_next() {
    local cache_only="${1:-false}"
    local compiler compiler_project command_line_source compiler_directory project_source project_relative core_source core_relative
    local runtime source_key cache_root bundle llvm executable metadata temporary
    local compiler_exit_code fixed_point llvm_hash llvm_bytes executable_hash
    local cached_project cached_command cached_previous cached_source cached_llvm cached_bytes
    local cached_fixed_point cached_executable cached_executable_path expected_fixed_point
    local -a core_sources project_sources runtimes

    compiler="$(ensure_seed_compiler)"
    compiler_project="$(compiler_project_file)"
    command_line_source="$(project_command_line_source "$compiler_project")"
    compiler_directory=""
    core_sources=()
    project_sources=()
    runtimes=()

    local compiler_source_count index role relative
    compiler_source_count="$(manifest_value compilerSources)"
    for ((index = 0; index < compiler_source_count; index += 1)); do
        role="$(manifest_value "compilerSources.$index.role")"
        relative="$(manifest_value "compilerSources.$index.path")"
        if [[ "$role" == "core" ]]; then
            core_sources+=("$REPO_ROOT/$relative")
        elif [[ -z "$compiler_directory" ]]; then
            compiler_directory="$(dirname "$REPO_ROOT/$relative")"
        elif [[ "$(dirname "$REPO_ROOT/$relative")" != "$compiler_directory" ]]; then
            echo "Compiler project sources span multiple directories; project command metadata must make this explicit." >&2
            return 65
        fi
    done
    if [[ -z "$compiler_directory" || ! -d "$compiler_directory" ]]; then
        echo "Unable to resolve the Compiler project source directory." >&2
        return 66
    fi
    if [[ "$(cd "$command_line_source" && pwd)" != "$(cd "$compiler_directory" && pwd)" ]]; then
        echo "The @compiler project commandLine source differs from the manifested compiler source directory." >&2
        return 65
    fi

    while IFS= read -r project_source; do
        project_sources+=("$project_source")
    done < <(/usr/bin/find "$compiler_directory" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print | LC_ALL=C /usr/bin/sort)
    if [[ "${#project_sources[@]}" -eq 0 ]]; then
        echo "The Compiler project has no Range sources." >&2
        return 66
    fi

    while IFS= read -r runtime; do
        runtimes+=("$runtime")
    done < <(runtime_inputs)

    source_key="$({
        /usr/bin/printf 'previous=%s\n' "$(manifest_value seed.sha256)"
        for core_source in "${core_sources[@]}"; do
            core_relative="${core_source#"$REPO_ROOT/"}"
            /usr/bin/printf 'core\t%s\t%s\n' "$core_relative" "$(sha256 "$core_source")"
        done
        for project_source in "${project_sources[@]}"; do
            project_relative="${project_source#"$compiler_directory/"}"
            /usr/bin/printf 'project\t%s\t%s\n' "$project_relative" "$(sha256 "$project_source")"
        done
        for runtime in "${runtimes[@]}"; do
            /usr/bin/printf 'runtime\t%s\t%s\n' "${runtime#"$REPO_ROOT/"}" "$(sha256 "$runtime")"
        done
        clang --version | /usr/bin/head -1
    } | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"

    cache_root="$REPO_ROOT/.range/Compiler/Next/$source_key"
    bundle="$cache_root/CompilerSourceSet.range"
    llvm="$cache_root/RangeCompiler.ll"
    executable="$cache_root/RangeCompiler"
    metadata="$cache_root/Next.txt"
    if [[ -x "$executable" && -f "$bundle" && -f "$llvm" && -f "$metadata" ]]; then
        cached_project="$(/usr/bin/sed -n 's/^project=//p' "$metadata")"
        cached_command="$(/usr/bin/sed -n 's/^command=//p' "$metadata")"
        cached_previous="$(/usr/bin/sed -n 's/^previous=//p' "$metadata")"
        cached_source="$(/usr/bin/sed -n 's/^source=//p' "$metadata")"
        cached_llvm="$(/usr/bin/sed -n 's/^llvm=//p' "$metadata")"
        cached_bytes="$(/usr/bin/sed -n 's/^bytes=//p' "$metadata")"
        cached_fixed_point="$(/usr/bin/sed -n 's/^fixedPoint=//p' "$metadata")"
        cached_executable="$(/usr/bin/sed -n 's/^executableHash=//p' "$metadata")"
        cached_executable_path="$(/usr/bin/sed -n 's/^executable=//p' "$metadata")"
        expected_fixed_point=false
        if /usr/bin/cmp -s "$REPO_ROOT/$(manifest_value seed.path)" "$llvm"; then expected_fixed_point=true; fi
        if [[ "$cached_project" == "compiler"
            && "$cached_command" == "next"
            && "$cached_previous" == "$(manifest_value seed.sha256)"
            && "$cached_source" == "$source_key"
            && "$cached_llvm" == "$(sha256 "$llvm")"
            && "$cached_bytes" == "$(/usr/bin/stat -f %z "$llvm")"
            && "$cached_fixed_point" == "$expected_fixed_point"
            && -n "$cached_executable"
            && "$cached_executable" == "$(sha256 "$executable")"
            && "$cached_executable_path" == "$executable" ]]; then
            /bin/cat "$metadata"
            return 0
        fi
    fi

    if [[ "$cache_only" == true ]]; then
        echo "No validated next-compiler cache entry exists for the current seed and sources." >&2
        echo "Run 'scripts/range compiler next' only when an uncached compiler build is intentional." >&2
        return 75
    fi

    /bin/mkdir -p "$cache_root"
    temporary="$cache_root/.build.$$"
    /bin/mkdir -p "$temporary"
    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$temporary/CompilerSourceSet.range"
    for core_source in "${core_sources[@]}"; do
        core_relative="${core_source#"$REPO_ROOT/"}"
        /usr/bin/printf 'compilerSourceFile\\trole=core\\tpath=%s\n' "$core_relative" >> "$temporary/CompilerSourceSet.range"
        /bin/cat "$core_source" >> "$temporary/CompilerSourceSet.range"
        /usr/bin/printf '\n' >> "$temporary/CompilerSourceSet.range"
    done
    for project_source in "${project_sources[@]}"; do
        project_relative="${project_source#"$compiler_directory/"}"
        /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "$project_relative" >> "$temporary/CompilerSourceSet.range"
        /bin/cat "$project_source" >> "$temporary/CompilerSourceSet.range"
        /usr/bin/printf '\n' >> "$temporary/CompilerSourceSet.range"
    done

    if "$compiler" emit-llvm "$temporary/CompilerSourceSet.range" "$temporary/RangeCompiler.ll"; then
        compiler_exit_code=0
    else
        compiler_exit_code=$?
    fi
    if [[ "$compiler_exit_code" -ne 0 ]]; then
        /bin/rm -rf "$temporary"
        return "$compiler_exit_code"
    fi
    if ! clang -Wno-override-module -x ir -c "$temporary/RangeCompiler.ll" -o /dev/null; then
        /bin/rm -rf "$temporary"
        return 65
    fi
    if ! clang -Wno-override-module "$temporary/RangeCompiler.ll" "${runtimes[@]}" -o "$temporary/RangeCompiler"; then
        /bin/rm -rf "$temporary"
        return 65
    fi

    fixed_point=false
    if /usr/bin/cmp -s "$REPO_ROOT/$(manifest_value seed.path)" "$temporary/RangeCompiler.ll"; then
        fixed_point=true
    fi
    llvm_hash="$(sha256 "$temporary/RangeCompiler.ll")"
    llvm_bytes="$(/usr/bin/stat -f %z "$temporary/RangeCompiler.ll")"
    executable_hash="$(sha256 "$temporary/RangeCompiler")"
    {
        /usr/bin/printf 'project=compiler\n'
        /usr/bin/printf 'command=next\n'
        /usr/bin/printf 'previous=%s\n' "$(manifest_value seed.sha256)"
        /usr/bin/printf 'source=%s\n' "$source_key"
        /usr/bin/printf 'llvm=%s\n' "$llvm_hash"
        /usr/bin/printf 'bytes=%s\n' "$llvm_bytes"
        /usr/bin/printf 'fixedPoint=%s\n' "$fixed_point"
        /usr/bin/printf 'executableHash=%s\n' "$executable_hash"
        /usr/bin/printf 'executable=%s\n' "$executable"
    } > "$temporary/Next.txt"

    /bin/mv "$temporary/CompilerSourceSet.range" "$bundle"
    /bin/mv "$temporary/RangeCompiler.ll" "$llvm"
    /bin/mv "$temporary/RangeCompiler" "$executable"
    /bin/mv "$temporary/Next.txt" "$metadata"
    /bin/rmdir "$temporary"
    /bin/cat "$metadata"
}

compiler_progression() {
    local cache_only="${1:-false}"
    local next_metadata source_key seed_llvm seed_executable previous_llvm previous_executable bundle
    local progression_key cache_root current_llvm current_executable metadata temporary diagnostic
    local seed_llvm_hash seed_llvm_bytes seed_executable_hash seed_executable_bytes
    local previous_llvm_hash previous_llvm_bytes previous_executable_hash previous_executable_bytes
    local current_llvm_hash current_llvm_bytes current_executable_hash current_executable_bytes
    local seed_to_previous_llvm_bytes previous_to_current_llvm_bytes
    local seed_to_previous_executable_bytes previous_to_current_executable_bytes
    local llvm_fixed_point executable_fixed_point fixed_point compiler_exit_code
    local cached_source cached_seed_llvm cached_previous_llvm cached_current_llvm
    local cached_current_llvm_hash cached_current_llvm_bytes cached_current_executable_hash cached_current_executable_bytes
    local cached_llvm_fixed_point cached_executable_fixed_point cached_fixed_point
    local runtime
    local -a runtimes

    # First the accepted seed builds `previous`; then `previous` builds
    # `current` from the exact source bundle retained by compiler-next.
    next_metadata="$(compiler_next "$cache_only")"
    source_key="$(/usr/bin/printf '%s\n' "$next_metadata" | /usr/bin/sed -n 's/^source=//p')"
    previous_executable="$(/usr/bin/printf '%s\n' "$next_metadata" | /usr/bin/sed -n 's/^executable=//p')"
    if [[ -z "$source_key" || -z "$previous_executable" || ! -x "$previous_executable" ]]; then
        echo "Compiler progression could not resolve the previous compiler candidate." >&2
        return 65
    fi

    previous_llvm="$(dirname "$previous_executable")/RangeCompiler.ll"
    bundle="$(dirname "$previous_executable")/CompilerSourceSet.range"
    seed_llvm="$REPO_ROOT/$(manifest_value seed.path)"
    seed_executable="$(ensure_seed_compiler)"
    if [[ ! -f "$previous_llvm" || ! -f "$bundle" ]]; then
        echo "Compiler progression candidate is incomplete." >&2
        return 65
    fi

    runtimes=()
    while IFS= read -r runtime; do
        runtimes+=("$runtime")
    done < <(runtime_inputs)

    seed_llvm_hash="$(sha256 "$seed_llvm")"
    seed_llvm_bytes="$(/usr/bin/stat -f %z "$seed_llvm")"
    seed_executable_hash="$(sha256 "$seed_executable")"
    seed_executable_bytes="$(/usr/bin/stat -f %z "$seed_executable")"
    previous_llvm_hash="$(sha256 "$previous_llvm")"
    previous_llvm_bytes="$(/usr/bin/stat -f %z "$previous_llvm")"
    previous_executable_hash="$(sha256 "$previous_executable")"
    previous_executable_bytes="$(/usr/bin/stat -f %z "$previous_executable")"

    progression_key="$({
        /usr/bin/printf 'source=%s\n' "$source_key"
        /usr/bin/printf 'previousLLVM=%s\n' "$previous_llvm_hash"
        /usr/bin/printf 'previousExecutable=%s\n' "$previous_executable_hash"
        /usr/bin/printf 'bundle=%s\n' "$(sha256 "$bundle")"
        for runtime in "${runtimes[@]}"; do
            /usr/bin/printf 'runtime\t%s\t%s\n' "${runtime#"$REPO_ROOT/"}" "$(sha256 "$runtime")"
        done
        clang --version | /usr/bin/head -1
    } | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"

    cache_root="$REPO_ROOT/.range/Compiler/Progression/$progression_key"
    current_llvm="$cache_root/RangeCompiler.ll"
    current_executable="$cache_root/RangeCompiler"
    metadata="$cache_root/Progression.txt"

    if [[ -x "$current_executable" && -f "$current_llvm" && -f "$metadata" ]]; then
        cached_source="$(/usr/bin/sed -n 's/^source=//p' "$metadata")"
        cached_seed_llvm="$(/usr/bin/sed -n 's/^seedLLVMHash=//p' "$metadata")"
        cached_previous_llvm="$(/usr/bin/sed -n 's/^previousLLVMHash=//p' "$metadata")"
        cached_current_llvm="$(/usr/bin/sed -n 's/^currentLLVM=//p' "$metadata")"
        cached_current_llvm_hash="$(/usr/bin/sed -n 's/^currentLLVMHash=//p' "$metadata")"
        cached_current_llvm_bytes="$(/usr/bin/sed -n 's/^currentLLVMBytes=//p' "$metadata")"
        cached_current_executable_hash="$(/usr/bin/sed -n 's/^currentExecutableHash=//p' "$metadata")"
        cached_current_executable_bytes="$(/usr/bin/sed -n 's/^currentExecutableBytes=//p' "$metadata")"
        cached_llvm_fixed_point="$(/usr/bin/sed -n 's/^llvmFixedPoint=//p' "$metadata")"
        cached_executable_fixed_point="$(/usr/bin/sed -n 's/^executableFixedPoint=//p' "$metadata")"
        cached_fixed_point="$(/usr/bin/sed -n 's/^fixedPoint=//p' "$metadata")"
        llvm_fixed_point=false
        executable_fixed_point=false
        if /usr/bin/cmp -s "$previous_llvm" "$current_llvm"; then llvm_fixed_point=true; fi
        if /usr/bin/cmp -s "$previous_executable" "$current_executable"; then executable_fixed_point=true; fi
        fixed_point=false
        if [[ "$llvm_fixed_point" == true && "$executable_fixed_point" == true ]]; then fixed_point=true; fi
        if [[ "$cached_source" == "$source_key"
            && "$cached_seed_llvm" == "$seed_llvm_hash"
            && "$cached_previous_llvm" == "$previous_llvm_hash"
            && "$cached_current_llvm" == "$current_llvm"
            && "$cached_current_llvm_hash" == "$(sha256 "$current_llvm")"
            && "$cached_current_llvm_bytes" == "$(/usr/bin/stat -f %z "$current_llvm")"
            && "$cached_current_executable_hash" == "$(sha256 "$current_executable")"
            && "$cached_current_executable_bytes" == "$(/usr/bin/stat -f %z "$current_executable")"
            && "$cached_llvm_fixed_point" == "$llvm_fixed_point"
            && "$cached_executable_fixed_point" == "$executable_fixed_point"
            && "$cached_fixed_point" == "$fixed_point" ]]; then
            /bin/cat "$metadata"
            if [[ "$fixed_point" != true ]]; then return 65; fi
            return 0
        fi
    fi

    if [[ "$cache_only" == true ]]; then
        echo "No validated compiler-progression cache entry exists for the current compiler candidate." >&2
        echo "Run 'scripts/range compiler progression' only when an uncached fixed-point proof is intentional." >&2
        return 75
    fi

    /bin/mkdir -p "$cache_root"
    temporary="$cache_root/.build.$$"
    diagnostic="$temporary/diagnostic.txt"
    /bin/mkdir -p "$temporary"
    if "$previous_executable" emit-llvm "$bundle" "$temporary/RangeCompiler.ll" > "$diagnostic"; then
        compiler_exit_code=0
    else
        compiler_exit_code=$?
    fi
    if [[ "$compiler_exit_code" -ne 0 || -s "$diagnostic" ]]; then
        if [[ -s "$diagnostic" ]]; then /bin/cat "$diagnostic" >&2; fi
        /bin/rm -rf "$temporary"
        if [[ "$compiler_exit_code" -eq 0 ]]; then return 65; fi
        return "$compiler_exit_code"
    fi
    if ! clang -Wno-override-module -x ir -c "$temporary/RangeCompiler.ll" -o /dev/null; then
        /bin/rm -rf "$temporary"
        return 65
    fi
    if ! clang -Wno-override-module "$temporary/RangeCompiler.ll" "${runtimes[@]}" -o "$temporary/RangeCompiler"; then
        /bin/rm -rf "$temporary"
        return 65
    fi

    current_llvm_hash="$(sha256 "$temporary/RangeCompiler.ll")"
    current_llvm_bytes="$(/usr/bin/stat -f %z "$temporary/RangeCompiler.ll")"
    current_executable_hash="$(sha256 "$temporary/RangeCompiler")"
    current_executable_bytes="$(/usr/bin/stat -f %z "$temporary/RangeCompiler")"
    seed_to_previous_llvm_bytes=$((previous_llvm_bytes - seed_llvm_bytes))
    previous_to_current_llvm_bytes=$((current_llvm_bytes - previous_llvm_bytes))
    seed_to_previous_executable_bytes=$((previous_executable_bytes - seed_executable_bytes))
    previous_to_current_executable_bytes=$((current_executable_bytes - previous_executable_bytes))
    llvm_fixed_point=false
    executable_fixed_point=false
    if /usr/bin/cmp -s "$previous_llvm" "$temporary/RangeCompiler.ll"; then llvm_fixed_point=true; fi
    if /usr/bin/cmp -s "$previous_executable" "$temporary/RangeCompiler"; then executable_fixed_point=true; fi
    fixed_point=false
    if [[ "$llvm_fixed_point" == true && "$executable_fixed_point" == true ]]; then fixed_point=true; fi

    {
        /usr/bin/printf 'project=compiler\n'
        /usr/bin/printf 'test=progression\n'
        /usr/bin/printf 'source=%s\n' "$source_key"
        /usr/bin/printf 'seedLLVM=%s\n' "$seed_llvm"
        /usr/bin/printf 'seedLLVMHash=%s\n' "$seed_llvm_hash"
        /usr/bin/printf 'seedLLVMBytes=%s\n' "$seed_llvm_bytes"
        /usr/bin/printf 'seedExecutable=%s\n' "$seed_executable"
        /usr/bin/printf 'seedExecutableHash=%s\n' "$seed_executable_hash"
        /usr/bin/printf 'seedExecutableBytes=%s\n' "$seed_executable_bytes"
        /usr/bin/printf 'previousLLVM=%s\n' "$previous_llvm"
        /usr/bin/printf 'previousLLVMHash=%s\n' "$previous_llvm_hash"
        /usr/bin/printf 'previousLLVMBytes=%s\n' "$previous_llvm_bytes"
        /usr/bin/printf 'previousExecutable=%s\n' "$previous_executable"
        /usr/bin/printf 'previousExecutableHash=%s\n' "$previous_executable_hash"
        /usr/bin/printf 'previousExecutableBytes=%s\n' "$previous_executable_bytes"
        /usr/bin/printf 'currentLLVM=%s\n' "$current_llvm"
        /usr/bin/printf 'currentLLVMHash=%s\n' "$current_llvm_hash"
        /usr/bin/printf 'currentLLVMBytes=%s\n' "$current_llvm_bytes"
        /usr/bin/printf 'currentExecutable=%s\n' "$current_executable"
        /usr/bin/printf 'currentExecutableHash=%s\n' "$current_executable_hash"
        /usr/bin/printf 'currentExecutableBytes=%s\n' "$current_executable_bytes"
        /usr/bin/printf 'seedToPreviousLLVMBytes=%+d\n' "$seed_to_previous_llvm_bytes"
        /usr/bin/printf 'previousToCurrentLLVMBytes=%+d\n' "$previous_to_current_llvm_bytes"
        /usr/bin/printf 'seedToPreviousExecutableBytes=%+d\n' "$seed_to_previous_executable_bytes"
        /usr/bin/printf 'previousToCurrentExecutableBytes=%+d\n' "$previous_to_current_executable_bytes"
        /usr/bin/printf 'llvmFixedPoint=%s\n' "$llvm_fixed_point"
        /usr/bin/printf 'executableFixedPoint=%s\n' "$executable_fixed_point"
        /usr/bin/printf 'fixedPoint=%s\n' "$fixed_point"
    } > "$temporary/Progression.txt"

    /bin/mv "$temporary/RangeCompiler.ll" "$current_llvm"
    /bin/mv "$temporary/RangeCompiler" "$current_executable"
    /bin/mv "$temporary/Progression.txt" "$metadata"
    /bin/rm -f "$diagnostic"
    /bin/rmdir "$temporary"
    /bin/cat "$metadata"
    if [[ "$fixed_point" != true ]]; then
        echo "Compiler progression failed: previous and current artifacts differ." >&2
        return 65
    fi
}

command="${1:-}"
if [[ -z "$command" ]]; then
    usage
    exit 1
fi
shift

case "$command" in
    source-graph)
        if [[ $# -ne 2 ]]; then usage; exit 1; fi
        write_source_graph "$1" "$2"
        ;;
    compiler-next)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        compiler_next
        ;;
    compiler-next-cached)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        compiler_next true
        ;;
    compiler-progression)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        compiler_progression
        ;;
    compiler-progression-cached)
        if [[ $# -ne 0 ]]; then usage; exit 1; fi
        compiler_progression true
        ;;
    compiler-command)
        if [[ $# -lt 1 ]]; then usage; exit 1; fi
        compiler_project_command "$@"
        ;;
    *)
        usage
        exit 1
        ;;
esac
