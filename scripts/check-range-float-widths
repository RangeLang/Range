#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CANDIDATE_COMPILER="${1:-}"

if [[ $# -gt 1 ]]; then
    echo "Usage: scripts/check-range-float-widths [candidate-compiler]" >&2
    exit 64
fi

if [[ -z "$CANDIDATE_COMPILER" ]]; then
    echo "Float width fixture is present; pass a candidate compiler to prove Float<32> and Float<64> lowering."
    exit 0
fi
if [[ ! -x "$CANDIDATE_COMPILER" ]]; then
    echo "Candidate compiler is not executable: $CANDIDATE_COMPILER" >&2
    exit 66
fi

BUILD_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/range-float-widths.XXXXXX")"
cleanup() {
    /bin/rm -rf "$BUILD_ROOT"
}
trap cleanup EXIT

RUNTIME_SOURCES=(
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c"
    "$REPO_ROOT/RangeCompiler/Runtime/RangeString.c"
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c"
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c"
)
SOURCE_SET="$BUILD_ROOT/FloatWidthsSourceSet.range"
LLVM="$BUILD_ROOT/FloatWidths.ll"

/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$SOURCE_SET"
/usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Range/Core/System/Memory/RawBuffer.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=project\tpath=Project/FloatWidths.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Tests/RangeEmissionTests/FloatWidths.range" >> "$SOURCE_SET"
/usr/bin/printf '\n' >> "$SOURCE_SET"

"$CANDIDATE_COMPILER" emit-llvm "$SOURCE_SET" "$LLVM"
/usr/bin/grep -q 'define float @float32Identity(float %value)' "$LLVM"
/usr/bin/grep -q 'define double @float64Identity(double %value)' "$LLVM"
if /usr/bin/grep -q '%Range.Float' "$LLVM"; then
    echo "Parameterized Float lowering emitted a nominal Float aggregate." >&2
    exit 65
fi

clang -Wno-override-module -x ir "$LLVM" -x c "${RUNTIME_SOURCES[@]}" -o "$BUILD_ROOT/FloatWidths"
set +e
"$BUILD_ROOT/FloatWidths"
range_exit=$?
set -e
if [[ "$range_exit" -ne 1 ]]; then
    echo "Range Float width round trip failed: expected 1, got $range_exit" >&2
    exit 1
fi

echo "Range Float<32> and Float<64> lowering checks passed."
