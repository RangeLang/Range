#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/Language/Bootstrap/Manifest.json"
DEFAULT_COMPILER="$REPO_ROOT/Language/Bootstrap/range"

if [[ ! -f "$MANIFEST" ]]; then
    echo "range compiler: missing bootstrap manifest" >&2
    exit 66
fi

compiler="${RANGE_COMPILER_EXECUTABLE:-$DEFAULT_COMPILER}"
if [[ ! -x "$compiler" ]]; then
    echo "range compiler: executable is not runnable: $compiler" >&2
    exit 66
fi

if [[ "$compiler" == "$DEFAULT_COMPILER" ]]; then
    expected="$(/usr/bin/plutil -extract compiler.sha256 raw -o - "$MANIFEST")"
    actual="$(/usr/bin/shasum -a 256 "$compiler" | /usr/bin/awk '{print $1}')"
    if [[ "$actual" != "$expected" ]]; then
        echo "range compiler: bootstrap hash mismatch" >&2
        exit 65
    fi

    if [[ $# -eq 1 ]]; then
        mode=""
        route="$1"
    elif [[ $# -eq 2 && "$1" == "--emit-assembly" ]]; then
        mode="$1"
        route="$2"
    else
        echo "usage: run-range-compiler [--emit-assembly] <route>" >&2
        exit 64
    fi
    if [[ "$route" != /* ]]; then route="$REPO_ROOT/$route"; fi

    # The frozen seed predates the canonical directory name. Stage only a
    # temporary path alias; canonical sources remain single-owned in the repo.
    stage_root="$(mktemp -d "${TMPDIR:-/tmp}/range-seed-path.XXXXXX")"
    legacy_compiler="$stage_root/Projects/RangeCompilerB/Sources/CompilerB"
    legacy_core="$legacy_compiler/Core"
    mkdir -p "$legacy_core"
    for core_entry in "$REPO_ROOT/Language/Core"/*; do
        ln -s "$core_entry" "$legacy_core/$(basename "$core_entry")"
    done
    for type_name in Bool Byte Int String Vector; do
        ln -s "$REPO_ROOT/Language/Core/DataTypes/$type_name.range" \
            "$legacy_core/$type_name.range"
    done
    ln -s "$REPO_ROOT/Language/Compiler/Lexer.range" \
        "$legacy_compiler/Lexer.range"
    ln -s "$REPO_ROOT/Language/Compiler/Main.range" \
        "$legacy_compiler/Main.range"
    cleanup() { rm -rf "$stage_root"; }
    trap cleanup EXIT
    cd "$stage_root"
    if [[ -n "$mode" ]]; then "$compiler" "$mode" "$route"; else "$compiler" "$route"; fi
    exit $?
fi

exec "$compiler" "$@"
