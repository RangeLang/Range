#!/usr/bin/env bash

# Shared accepted-bootstrap current build artifact resolver.
#
# Callers must initialize the candidate harness globals and helpers before
# calling resolve_compiler_build:
#   REPO_ROOT, MANIFEST, WORK_ROOT, SOURCE_BUNDLE
#   RUNTIME_INPUTS, SOURCE_FILES, SOURCE_ROLES, SOURCE_ROOTS,
#   SOURCE_RELATIVE_PATHS, COMPILER_OPTIMIZATION, COMPILER_LTO
#   manifest_value, sha256, sha256_text, bytes, emit_candidate_llvm,
#   validate_llvm, link_llvm, fail
#
# resolve_compiler_build 0 may reuse the executable-only cache written by the
# former value-ownership-local resolver. resolve_compiler_build 1 requires the
# current shared entry containing both immutable LLVM and executable artifacts.

RANGE_BUILD_CACHE_SCHEMA=2
RANGE_BUILD_CACHE_ROOT="${RANGE_BUILD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/Library/Caches}/Range/compiler-build}"
RANGE_BUILD_PROFILE="${RANGE_BUILD_PROFILE:-optimized}"
BOOTSTRAP_COMPILER_OPTIMIZATION="${BOOTSTRAP_COMPILER_OPTIMIZATION:-$COMPILER_OPTIMIZATION}"
BOOTSTRAP_COMPILER_LTO="${BOOTSTRAP_COMPILER_LTO:-$COMPILER_LTO}"
RANGE_BUILD_VALIDATED_DEVELOPMENT_PRODUCER="$RANGE_BUILD_CACHE_ROOT/ValidatedDevelopmentProducer.txt"
RANGE_BUILD_PRODUCER_KIND="accepted-bootstrap"
RANGE_BUILD_PRODUCER_PATH=""
RANGE_BUILD_PRODUCER_CAPABILITY=""

range_build_select_producer() {
    local bootstrap_relative validated_key validated_capability validated_directory

    bootstrap_relative="$(manifest_value bootstrap.path)"
    RANGE_BUILD_PRODUCER_KIND="accepted-bootstrap"
    RANGE_BUILD_PRODUCER_PATH="$REPO_ROOT/$bootstrap_relative"
    RANGE_BUILD_PRODUCER_CAPABILITY=""
    if [[ "$RANGE_BUILD_PROFILE" != "development"
        || ! -f "$RANGE_BUILD_VALIDATED_DEVELOPMENT_PRODUCER" ]]; then
        return 0
    fi
    validated_key="$(/usr/bin/sed -n '1p' "$RANGE_BUILD_VALIDATED_DEVELOPMENT_PRODUCER" 2>/dev/null || true)"
    validated_capability="$(/usr/bin/sed -n '2p' "$RANGE_BUILD_VALIDATED_DEVELOPMENT_PRODUCER" 2>/dev/null || true)"
    [[ "$validated_key" =~ ^[0-9a-f]{64}$ ]] || return 0
    [[ "$validated_capability" == "developmentEffectValidation=per-function-artifacts-v1" ]] || return 0
    validated_directory="$RANGE_BUILD_CACHE_ROOT/$validated_key"
    if range_build_validated_producer_is_valid "$validated_directory" "$validated_key" "${validated_capability#developmentEffectValidation=}"; then
        RANGE_BUILD_PRODUCER_KIND="validated-development"
        RANGE_BUILD_PRODUCER_PATH="$validated_directory/RangeCompilerProducer"
        RANGE_BUILD_PRODUCER_CAPABILITY="${validated_capability#developmentEffectValidation=}"
    fi
}

range_build_mark_development_producer_validated() {
    local temporary producer temporary_producer producer_metadata
    local saved_optimization saved_lto

    [[ "$RANGE_BUILD_PROFILE" == "development" ]] || return 0
    [[ -n "${BUILD_CACHE_KEY:-}" && -n "${BUILD_CACHE_DIRECTORY:-}" ]] || return 1
    range_build_cache_entry_is_valid "$BUILD_CACHE_DIRECTORY" "$BUILD_CACHE_KEY" || return 1
    if [[ "${RANGE_BUILD_ADVANCE_DEVELOPMENT_PRODUCER:-0}" != "1" ]]; then
        range_build_select_producer
        if [[ "$RANGE_BUILD_PRODUCER_KIND" == "validated-development" ]]; then
            return 0
        fi
    fi
    producer="$BUILD_CACHE_DIRECTORY/RangeCompilerProducer"
    producer_metadata="$BUILD_CACHE_DIRECTORY/ProducerMetadata.txt"
    if [[ ! -x "$producer" ]]; then
        temporary_producer="$WORK_ROOT/RangeCompilerProducer"
        saved_optimization="$COMPILER_OPTIMIZATION"
        saved_lto="$COMPILER_LTO"
        COMPILER_OPTIMIZATION="-O2"
        COMPILER_LTO="-flto=thin"
        link_llvm "$BUILD_LLVM" "$temporary_producer" || {
            COMPILER_OPTIMIZATION="$saved_optimization"
            COMPILER_LTO="$saved_lto"
            return 1
        }
        COMPILER_OPTIMIZATION="$saved_optimization"
        COMPILER_LTO="$saved_lto"
        /bin/mv "$temporary_producer" "$producer"
    fi
    /usr/bin/printf 'sourceCacheKey=%s\ncapability=per-function-artifacts-v1\nexecutableHash=%s\nexecutableBytes=%s\n' \
        "$BUILD_CACHE_KEY" "$(sha256 "$producer")" "$(bytes "$producer")" > "$producer_metadata"
    /bin/mkdir -p "$RANGE_BUILD_CACHE_ROOT"
    temporary="$RANGE_BUILD_VALIDATED_DEVELOPMENT_PRODUCER.$$"
    /usr/bin/printf '%s\ndevelopmentEffectValidation=per-function-artifacts-v1\n' "$BUILD_CACHE_KEY" > "$temporary"
    /bin/mv "$temporary" "$RANGE_BUILD_VALIDATED_DEVELOPMENT_PRODUCER"
}

range_build_write_cache_key_material() {
    local output="$1"
    local bootstrap_relative bootstrap clang_path linker_path sdk_path sdk_settings sdk_version index

    bootstrap_relative="$(manifest_value bootstrap.path)"
    bootstrap="$REPO_ROOT/$bootstrap_relative"
    clang_path="$(command -v clang)"
    linker_path="$(clang -print-prog-name=ld 2>/dev/null || command -v ld)"
    if [[ "$linker_path" != /* ]]; then
        linker_path="$(command -v "$linker_path")"
    fi
    sdk_path="${SDKROOT:-}"
    sdk_version=""
    if command -v xcrun >/dev/null 2>&1; then
        if [[ -z "$sdk_path" ]]; then
            sdk_path="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
        fi
        sdk_version="$(xcrun --sdk macosx --show-sdk-version 2>/dev/null || true)"
    fi
    sdk_settings="$sdk_path/SDKSettings.json"
    if [[ ! -f "$sdk_settings" ]]; then
        sdk_settings="$sdk_path/SDKSettings.plist"
    fi

    /usr/bin/printf 'schema=%s\n' "$RANGE_BUILD_CACHE_SCHEMA" > "$output"
    /usr/bin/printf 'pipeline=accepted-bootstrap-current\n' >> "$output"
    /usr/bin/printf 'profile=%s\n' "$RANGE_BUILD_PROFILE" >> "$output"
    /usr/bin/printf 'targetPlatform=%s\n' "$(manifest_value target.platform)" >> "$output"
    /usr/bin/printf 'targetArchitecture=%s\n' "$(manifest_value target.architecture)" >> "$output"
    /usr/bin/printf 'targetPointerBits=%s\n' "$(manifest_value target.pointerBits)" >> "$output"
    /usr/bin/printf 'targetMinimumOS=%s\n' "$(manifest_value target.minimumOS)" >> "$output"
    /usr/bin/printf 'runtimeABI=%s\n' "$(manifest_value runtimeABI)" >> "$output"
    /usr/bin/printf 'clangPath=%s\nclangHash=%s\nclangVersionHash=%s\n' \
        "$clang_path" "$(sha256 "$clang_path")" "$(sha256_text "$(clang --version)")" >> "$output"
    /usr/bin/printf 'linkerPath=%s\nlinkerHash=%s\nsdkPath=%s\nsdkVersion=%s\n' \
        "$linker_path" "$(sha256 "$linker_path")" "$sdk_path" "$sdk_version" >> "$output"
    if [[ -f "$sdk_settings" ]]; then
        /usr/bin/printf 'sdkSettingsPath=%s\nsdkSettingsHash=%s\nsdkSettingsBytes=%s\n' \
            "$sdk_settings" "$(sha256 "$sdk_settings")" "$(bytes "$sdk_settings")" >> "$output"
    else
        /usr/bin/printf 'sdkSettingsPath=\nsdkSettingsHash=\nsdkSettingsBytes=0\n' >> "$output"
    fi
    /usr/bin/printf 'environmentSDKROOT=%s\nenvironmentDeploymentTarget=%s\nenvironmentDeveloperDirectory=%s\n' \
        "${SDKROOT:-}" "${MACOSX_DEPLOYMENT_TARGET:-}" "${DEVELOPER_DIR:-}" >> "$output"
    /usr/bin/printf 'bootstrapLinkArgv=%s|%s|-Wno-override-module|-x|ir|bootstrap|-x|c|runtime-set|-o|output\n' \
        "$BOOTSTRAP_COMPILER_OPTIMIZATION" "$BOOTSTRAP_COMPILER_LTO" >> "$output"
    /usr/bin/printf 'compilerEmitArgv=bootstrap-executable|source-bundle\n' >> "$output"
    /usr/bin/printf 'compilerEmitProducerKind=%s\ncompilerEmitProducerHash=%s\ncompilerEmitProducerBytes=%s\n' \
        "$RANGE_BUILD_PRODUCER_KIND" \
        "$(sha256 "$RANGE_BUILD_PRODUCER_PATH")" "$(bytes "$RANGE_BUILD_PRODUCER_PATH")" >> "$output"
    /usr/bin/printf 'llvmValidateArgv=-Wno-override-module|-x|ir|-c|current-llvm|-o|object\n' >> "$output"
    /usr/bin/printf 'currentLinkArgv=%s|%s|-Wno-override-module|current-llvm|runtime-set|-o|output\n' \
        "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" >> "$output"
    /usr/bin/printf 'bootstrapPath=%s\nbootstrapHash=%s\nbootstrapBytes=%s\n' \
        "$bootstrap_relative" "$(sha256 "$bootstrap")" "$(bytes "$bootstrap")" >> "$output"
    for index in "${!RUNTIME_INPUTS[@]}"; do
        /usr/bin/printf 'runtime=%s\tpath=%s\tsha256=%s\tbytes=%s\n' \
            "$index" "${RUNTIME_INPUTS[$index]#"$REPO_ROOT/"}" \
            "$(sha256 "${RUNTIME_INPUTS[$index]}")" "$(bytes "${RUNTIME_INPUTS[$index]}")" >> "$output"
    done
    /usr/bin/printf 'sourceBundleHash=%s\nsourceBundleBytes=%s\n' \
        "$(sha256 "$SOURCE_BUNDLE")" "$(bytes "$SOURCE_BUNDLE")" >> "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'source=%s\trole=%s\troot=%s\tpath=%s\tsha256=%s\tbytes=%s\n' \
            "$index" "${SOURCE_ROLES[$index]}" "${SOURCE_ROOTS[$index]}" \
            "${SOURCE_RELATIVE_PATHS[$index]}" "$(sha256 "${SOURCE_FILES[$index]}")" \
            "$(bytes "${SOURCE_FILES[$index]}")" >> "$output"
    done
}

range_build_write_legacy_cache_key_material() {
    local output="$1"
    local bootstrap_relative bootstrap index

    bootstrap_relative="$(manifest_value bootstrap.path)"
    bootstrap="$REPO_ROOT/$bootstrap_relative"
    /usr/bin/printf 'schema=1\n' > "$output"
    /usr/bin/printf 'compilerOptimization=%s\n' "$COMPILER_OPTIMIZATION" >> "$output"
    /usr/bin/printf 'compilerLTO=%s\n' "$COMPILER_LTO" >> "$output"
    /usr/bin/printf 'clang=%s\n' "$(clang --version | /usr/bin/head -1)" >> "$output"
    /usr/bin/printf 'bootstrapPath=%s\nbootstrapHash=%s\nbootstrapBytes=%s\n' \
        "$bootstrap_relative" "$(sha256 "$bootstrap")" "$(bytes "$bootstrap")" >> "$output"
    for index in "${!RUNTIME_INPUTS[@]}"; do
        /usr/bin/printf 'runtime=%s\tpath=%s\tsha256=%s\tbytes=%s\n' \
            "$index" "${RUNTIME_INPUTS[$index]#"$REPO_ROOT/"}" \
            "$(sha256 "${RUNTIME_INPUTS[$index]}")" "$(bytes "${RUNTIME_INPUTS[$index]}")" >> "$output"
    done
    /usr/bin/printf 'sourceBundleHash=%s\nsourceBundleBytes=%s\n' \
        "$(sha256 "$SOURCE_BUNDLE")" "$(bytes "$SOURCE_BUNDLE")" >> "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'source=%s\trole=%s\troot=%s\tpath=%s\tsha256=%s\tbytes=%s\n' \
            "$index" "${SOURCE_ROLES[$index]}" "${SOURCE_ROOTS[$index]}" \
            "${SOURCE_RELATIVE_PATHS[$index]}" "$(sha256 "${SOURCE_FILES[$index]}")" \
            "$(bytes "${SOURCE_FILES[$index]}")" >> "$output"
    done
}

range_build_cache_entry_is_valid() {
    local directory="$1"
    local expected_key="$2"
    local llvm="$directory/RangeCompiler.ll"
    local executable="$directory/RangeCompiler"
    local metadata="$directory/Metadata.txt"
    local key_material="$directory/KeyMaterial.txt"
    local expected_key_material_hash expected_llvm_hash expected_llvm_bytes
    local expected_executable_hash expected_executable_bytes

    [[ -f "$llvm" && -x "$executable" && -f "$metadata" && -f "$key_material" ]] || return 1
    /usr/bin/grep -Fxq "schema=$RANGE_BUILD_CACHE_SCHEMA" "$metadata" || return 1
    /usr/bin/grep -Fxq "cacheKey=$expected_key" "$metadata" || return 1
    expected_key_material_hash="$(/usr/bin/awk -F= '$1 == "keyMaterialHash" { print $2 }' "$metadata")"
    expected_llvm_hash="$(/usr/bin/awk -F= '$1 == "llvmHash" { print $2 }' "$metadata")"
    expected_llvm_bytes="$(/usr/bin/awk -F= '$1 == "llvmBytes" { print $2 }' "$metadata")"
    expected_executable_hash="$(/usr/bin/awk -F= '$1 == "executableHash" { print $2 }' "$metadata")"
    expected_executable_bytes="$(/usr/bin/awk -F= '$1 == "executableBytes" { print $2 }' "$metadata")"
    [[ -n "$expected_key_material_hash" && -n "$expected_llvm_hash" && -n "$expected_llvm_bytes"
        && -n "$expected_executable_hash" && -n "$expected_executable_bytes" ]] || return 1
    [[ "$expected_key_material_hash" == "$expected_key" ]] || return 1
    [[ "$(sha256 "$key_material")" == "$expected_key" ]] || return 1
    [[ "$(sha256 "$llvm")" == "$expected_llvm_hash" ]] || return 1
    [[ "$(bytes "$llvm")" == "$expected_llvm_bytes" ]] || return 1
    [[ "$(sha256 "$executable")" == "$expected_executable_hash" ]] || return 1
    [[ "$(bytes "$executable")" == "$expected_executable_bytes" ]] || return 1
}

range_build_validated_producer_is_valid() {
    local directory="$1"
    local expected_key="$2"
    local expected_capability="${3:-per-function-artifacts-v1}"
    local producer="$directory/RangeCompilerProducer"
    local metadata="$directory/ProducerMetadata.txt"
    local expected_hash expected_bytes

    range_build_cache_entry_is_valid "$directory" "$expected_key" || return 1
    [[ -x "$producer" && -f "$metadata" ]] || return 1
    /usr/bin/grep -Fxq "sourceCacheKey=$expected_key" "$metadata" || return 1
    /usr/bin/grep -Fxq "capability=$expected_capability" "$metadata" || return 1
    expected_hash="$(/usr/bin/awk -F= '$1 == "executableHash" { print $2 }' "$metadata")"
    expected_bytes="$(/usr/bin/awk -F= '$1 == "executableBytes" { print $2 }' "$metadata")"
    [[ -n "$expected_hash" && -n "$expected_bytes" ]] || return 1
    [[ "$(sha256 "$producer")" == "$expected_hash" ]] || return 1
    [[ "$(bytes "$producer")" == "$expected_bytes" ]] || return 1
}

range_build_legacy_cache_entry_is_valid() {
    local directory="$1"
    local expected_key="$2"
    local executable="$directory/RangeCompiler"
    local metadata="$directory/Metadata.txt"
    local expected_hash expected_bytes

    [[ -x "$executable" && -f "$metadata" ]] || return 1
    /usr/bin/grep -Fxq 'schema=1' "$metadata" || return 1
    /usr/bin/grep -Fxq "cacheKey=$expected_key" "$metadata" || return 1
    expected_hash="$(/usr/bin/awk -F= '$1 == "executableHash" { print $2 }' "$metadata")"
    expected_bytes="$(/usr/bin/awk -F= '$1 == "executableBytes" { print $2 }' "$metadata")"
    [[ -n "$expected_hash" && -n "$expected_bytes" ]] || return 1
    [[ "$(sha256 "$executable")" == "$expected_hash" ]] || return 1
    [[ "$(bytes "$executable")" == "$expected_bytes" ]] || return 1
}

range_build_acquire_cache_lock() {
    local lock_directory="$1"
    local cache_directory="$2"
    local expected_key="$3"
    local attempts=0
    local owner_pid=""

    while ! /bin/mkdir "$lock_directory" 2>/dev/null; do
        if range_build_cache_entry_is_valid "$cache_directory" "$expected_key"; then
            return 2
        fi
        if [[ -f "$lock_directory/OwnerPID" ]]; then
            owner_pid="$(/bin/cat "$lock_directory/OwnerPID" 2>/dev/null || true)"
            if [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
                /bin/rm -f "$lock_directory/OwnerPID"
                /bin/rmdir "$lock_directory" 2>/dev/null || true
            elif [[ ! "$owner_pid" =~ ^[0-9]+$ ]] && (( attempts > 40 )); then
                /bin/rm -f "$lock_directory/OwnerPID"
                /bin/rmdir "$lock_directory" 2>/dev/null || true
            fi
        elif (( attempts > 40 )); then
            /bin/rmdir "$lock_directory" 2>/dev/null || true
        fi
        attempts=$((attempts + 1))
        if (( attempts > 4800 )); then
            return 1
        fi
        sleep 0.25
    done
    /usr/bin/printf '%s\n' "$$" > "$lock_directory/OwnerPID"
    return 0
}

range_build_release_cache_lock() {
    local lock_directory="$1"

    [[ -n "$lock_directory" && -d "$lock_directory" ]] || return 0
    /bin/rm -f "$lock_directory/OwnerPID"
    /bin/rmdir "$lock_directory" 2>/dev/null || true
}

resolve_compiler_build() {
    local require_llvm="${1:-0}"
    local key_material="$WORK_ROOT/build-cache-key"
    local legacy_key_material="$WORK_ROOT/build-cache-key.legacy"
    local cache_key cache_directory
    local legacy_cache_key legacy_cache_directory
    local build_directory bootstrap bootstrap_executable current_source_bundle current_llvm current_executable
    local lock_directory publish_directory invalid_directory
    local function_artifact_directory function_artifact_cache function_artifact_next function_artifact_source_key
    local lock_status build_status publish_status
    local range_build_phase_started range_build_build_started

    [[ "$require_llvm" == "0" || "$require_llvm" == "1" ]] \
        || fail "shared current build resolver expected require_llvm 0 or 1"

    range_build_select_producer
    range_build_write_cache_key_material "$key_material"
    cache_key="$(sha256 "$key_material")"
    cache_directory="$RANGE_BUILD_CACHE_ROOT/$cache_key"
    if range_build_cache_entry_is_valid "$cache_directory" "$cache_key"; then
        BUILD_CACHE_KEY="$cache_key"
        BUILD_CACHE_STATUS="hit"
        BUILD_CACHE_DIRECTORY="$cache_directory"
        BUILD_LLVM="$cache_directory/RangeCompiler.ll"
        BUILD_EXECUTABLE="$cache_directory/RangeCompiler"
        return 0
    fi

    if [[ "$require_llvm" == "0" && "$RANGE_BUILD_PROFILE" == "optimized" ]]; then
        range_build_write_legacy_cache_key_material "$legacy_key_material"
        legacy_cache_key="$(sha256 "$legacy_key_material")"
        legacy_cache_directory="$RANGE_BUILD_CACHE_ROOT/$legacy_cache_key"
        if range_build_legacy_cache_entry_is_valid "$legacy_cache_directory" "$legacy_cache_key"; then
            BUILD_CACHE_KEY="$legacy_cache_key"
            BUILD_CACHE_STATUS="legacy-hit"
            BUILD_CACHE_DIRECTORY="$legacy_cache_directory"
            BUILD_LLVM=""
            BUILD_EXECUTABLE="$legacy_cache_directory/RangeCompiler"
            return 0
        fi
    fi

    /bin/mkdir -p "$RANGE_BUILD_CACHE_ROOT"
    lock_directory="$RANGE_BUILD_CACHE_ROOT/$cache_key.lock"
    if range_build_acquire_cache_lock "$lock_directory" "$cache_directory" "$cache_key"; then
        lock_status=0
    else
        lock_status=$?
    fi
    if [[ "$lock_status" -eq 2 ]]; then
        BUILD_CACHE_KEY="$cache_key"
        BUILD_CACHE_STATUS="hit"
        BUILD_CACHE_DIRECTORY="$cache_directory"
        BUILD_LLVM="$cache_directory/RangeCompiler.ll"
        BUILD_EXECUTABLE="$cache_directory/RangeCompiler"
        return 0
    fi
    [[ "$lock_status" -eq 0 ]] || fail "timed out waiting for shared current build cache key $cache_key"
    if range_build_cache_entry_is_valid "$cache_directory" "$cache_key"; then
        range_build_release_cache_lock "$lock_directory"
        BUILD_CACHE_KEY="$cache_key"
        BUILD_CACHE_STATUS="hit"
        BUILD_CACHE_DIRECTORY="$cache_directory"
        BUILD_LLVM="$cache_directory/RangeCompiler.ll"
        BUILD_EXECUTABLE="$cache_directory/RangeCompiler"
        return 0
    fi

    build_directory="$WORK_ROOT/build-cache-entry"
    if ! /bin/mkdir -p "$build_directory"; then
        range_build_release_cache_lock "$lock_directory"
        fail "could not create shared current-build directory"
    fi
    bootstrap="$REPO_ROOT/$(manifest_value bootstrap.path)"
    bootstrap_executable="$WORK_ROOT/RangeCompilerBootstrap"
    current_source_bundle="$SOURCE_BUNDLE"
    current_llvm="$build_directory/RangeCompiler.ll"
    current_executable="$build_directory/RangeCompiler"
    if [[ "$RANGE_BUILD_PROFILE" == "development" ]]; then
        current_source_bundle="$build_directory/RangeCompilerDevelopmentSourceSet.range"
        # Artifact edges still carry positional function IDs. Keep cross-run
        # reuse for an identical source graph, but never apply those edges to
        # a declaration inventory whose rows may have shifted.
        function_artifact_source_key="$(sha256 "$SOURCE_BUNDLE")"
        function_artifact_directory="$RANGE_BUILD_CACHE_ROOT/function-artifacts/$RANGE_BUILD_PRODUCER_CAPABILITY/$function_artifact_source_key"
        function_artifact_cache="$function_artifact_directory/FunctionArtifacts.cache"
        function_artifact_next="$build_directory/FunctionArtifacts.next"
        /bin/mkdir -p "$function_artifact_directory"
        {
            /usr/bin/head -n 1 "$SOURCE_BUNDLE"
            /usr/bin/printf '%s\n' '// range-development-compiler'
            if [[ "$RANGE_BUILD_PRODUCER_CAPABILITY" == "per-function-artifacts-v1" ]]; then
                if [[ -f "$function_artifact_cache" ]]; then
                    /usr/bin/printf '// range-function-artifact-input %s\n' "$function_artifact_cache"
                fi
                /usr/bin/printf '// range-function-artifact-output %s\n' "$function_artifact_next"
            fi
            /usr/bin/tail -n +2 "$SOURCE_BUNDLE"
        } > "$current_source_bundle"
    fi
    range_build_build_started="$(date +%s)"
    set +e
    (
        set -e
        range_build_phase_started="$(date +%s)"
        if [[ "$RANGE_BUILD_PRODUCER_KIND" == "validated-development" ]]; then
            bootstrap_executable="$RANGE_BUILD_PRODUCER_PATH"
        else
            clang "$BOOTSTRAP_COMPILER_OPTIMIZATION" "$BOOTSTRAP_COMPILER_LTO" -Wno-override-module \
                -x ir "$bootstrap" -x c "${RUNTIME_INPUTS[@]}" -o "$bootstrap_executable"
        fi
        echo "buildTiming profile=$RANGE_BUILD_PROFILE phase=bootstrap-link seconds=$(($(date +%s) - range_build_phase_started))"
        range_build_phase_started="$(date +%s)"
        emit_candidate_llvm "$bootstrap_executable" "$current_source_bundle" "$current_llvm" shared-current
        echo "buildTiming profile=$RANGE_BUILD_PROFILE phase=llvm-emission seconds=$(($(date +%s) - range_build_phase_started))"
        range_build_phase_started="$(date +%s)"
        validate_llvm "$current_llvm"
        if [[ "$RANGE_BUILD_PRODUCER_CAPABILITY" == "per-function-artifacts-v1" ]]; then
            [[ -f "$function_artifact_next" ]]
            echo "currentArtifacts reused=$(/usr/bin/grep -ac '|reused=1$' "$function_artifact_next") rebuilt=$(/usr/bin/grep -ac '|reused=0$' "$function_artifact_next")"
            /bin/mv "$function_artifact_next" "$function_artifact_cache"
        fi
        echo "buildTiming profile=$RANGE_BUILD_PROFILE phase=llvm-validation seconds=$(($(date +%s) - range_build_phase_started))"
        range_build_phase_started="$(date +%s)"
        link_llvm "$current_llvm" "$current_executable"
        echo "buildTiming profile=$RANGE_BUILD_PROFILE phase=current-link seconds=$(($(date +%s) - range_build_phase_started))"
    )
    build_status=$?
    set -e
    if [[ "$build_status" -ne 0 ]]; then
        range_build_release_cache_lock "$lock_directory"
        fail "shared current build artifact build failed"
    fi
    echo "buildTiming profile=$RANGE_BUILD_PROFILE phase=total seconds=$(($(date +%s) - range_build_build_started))"

    if ! publish_directory="$(/usr/bin/mktemp -d "$RANGE_BUILD_CACHE_ROOT/.build-publish.XXXXXX")"; then
        range_build_release_cache_lock "$lock_directory"
        fail "could not create shared current build publication directory"
    fi
    set +e
    (
        set -e
        /bin/cp "$current_llvm" "$publish_directory/RangeCompiler.ll"
        /bin/cp "$current_executable" "$publish_directory/RangeCompiler"
        /bin/chmod +x "$publish_directory/RangeCompiler"
        /bin/cp "$key_material" "$publish_directory/KeyMaterial.txt"
        /usr/bin/printf 'schema=%s\ncacheKey=%s\nkeyMaterialHash=%s\nllvmHash=%s\nllvmBytes=%s\nexecutableHash=%s\nexecutableBytes=%s\n' \
            "$RANGE_BUILD_CACHE_SCHEMA" "$cache_key" "$(sha256 "$key_material")" \
            "$(sha256 "$current_llvm")" "$(bytes "$current_llvm")" \
            "$(sha256 "$current_executable")" "$(bytes "$current_executable")" \
            > "$publish_directory/Metadata.txt"
        if [[ -e "$cache_directory" ]]; then
            invalid_directory="$RANGE_BUILD_CACHE_ROOT/.build-invalid.$cache_key.$$"
            /bin/mv "$cache_directory" "$invalid_directory"
        fi
        /bin/mv "$publish_directory" "$cache_directory"
        range_build_cache_entry_is_valid "$cache_directory" "$cache_key"
    )
    publish_status=$?
    set -e
    range_build_release_cache_lock "$lock_directory"
    if [[ "$publish_status" -ne 0 ]]; then
        fail "shared current build artifact publication failed integrity validation"
    fi

    BUILD_CACHE_KEY="$cache_key"
    BUILD_CACHE_STATUS="miss"
    BUILD_CACHE_DIRECTORY="$cache_directory"
    BUILD_LLVM="$cache_directory/RangeCompiler.ll"
    BUILD_EXECUTABLE="$cache_directory/RangeCompiler"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    echo "resolve-range-compiler-build is a shared sourced helper" >&2
    exit 64
fi
