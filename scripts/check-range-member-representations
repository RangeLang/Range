#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CANDIDATE_COMPILER="${1:-$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/stage2/RangeCompiler}"
BUILD_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/range-member-representations.XXXXXX")"

cleanup() {
    if [[ "${RANGE_KEEP_MEMBER_REPRESENTATION_BUILD_ROOT:-0}" == "1" ]]; then
        echo "Member representation build root: $BUILD_ROOT"
    else
        /bin/rm -rf "$BUILD_ROOT"
    fi
}
trap cleanup EXIT

if [[ ! -x "$CANDIDATE_COMPILER" ]]; then
    echo "Candidate compiler is not executable: $CANDIDATE_COMPILER" >&2
    exit 66
fi

SOURCE_SET="$BUILD_ROOT/MemberRepresentationSourceSet.range"
REPRESENTATIONS_SOURCE="$BUILD_ROOT/MemberRepresentations.snapshot.range"
REPRESENTATIONS_OUTPUT="$BUILD_ROOT/MemberRepresentations.snapshot.out"
LLVM="$BUILD_ROOT/MemberRepresentations.ll"

/usr/bin/printf '%s\n' 'compilerMemberRepresentations' > "$REPRESENTATIONS_SOURCE"
/usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$REPRESENTATIONS_SOURCE"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$REPRESENTATIONS_SOURCE"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/Buffer.range' >> "$REPRESENTATIONS_SOURCE"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$REPRESENTATIONS_SOURCE"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/MemberRepresentations.range' >> "$REPRESENTATIONS_SOURCE"
/bin/cat "$REPO_ROOT/Testing/Types/Pass/MemberRepresentations.range" >> "$REPRESENTATIONS_SOURCE"
/usr/bin/printf '\n' >> "$REPRESENTATIONS_SOURCE"

"$CANDIDATE_COMPILER" compile "$REPRESENTATIONS_SOURCE" > "$REPRESENTATIONS_OUTPUT"
/usr/bin/grep -Fq $'memberRepresentation\towner=ByteStorageView\tmember=bytes\tkind=transparent' "$REPRESENTATIONS_OUTPUT"
/usr/bin/grep -Fq $'memberRepresentation\towner=InlineNumber\tmember=value\tkind=inline' "$REPRESENTATIONS_OUTPUT"
/usr/bin/grep -Fq $'memberRepresentation\towner=IdentityOwner\tmember=leaf\tkind=identity' "$REPRESENTATIONS_OUTPUT"

/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$SOURCE_SET"
/usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/RawBuffer.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/Buffer.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range" >> "$SOURCE_SET"
/usr/bin/printf '\n%s\n' 'compilerSourceFile\trole=core\tpath=Core/System/Memory/MemberRepresentations.range' >> "$SOURCE_SET"
/bin/cat "$REPO_ROOT/Testing/Types/Pass/MemberRepresentations.range" >> "$SOURCE_SET"
/usr/bin/printf '\n' >> "$SOURCE_SET"

"$CANDIDATE_COMPILER" emit-llvm "$SOURCE_SET" "$LLVM"

/usr/bin/grep -q 'call i32 @Buffer__count' "$LLVM"
if /usr/bin/grep -Fq 'call ptr @rangeConstructGetPtr' "$LLVM"; then
    echo "Transparent storage projection used an identity lookup." >&2
    exit 1
fi

/usr/bin/grep -Eq '%Range\.InlineNumber = type \{ i32 \}' "$LLVM"
/usr/bin/grep -Eq 'extractvalue %Range\.InlineNumber .* 0' "$LLVM"
/usr/bin/grep -Eq '%Range\.IdentityOwner = type \{ ptr \}' "$LLVM"
/usr/bin/grep -Fq 'call ptr @rangeConstructIdentityCreate(i64 ' "$LLVM"
/usr/bin/grep -Eq 'store %Range\.IdentityLeaf .* ptr %r' "$LLVM"
/usr/bin/grep -Eq 'load %Range\.IdentityLeaf, ptr %r' "$LLVM"
if /usr/bin/grep -Fq '%Range.IdentityOwner = type { %Range.IdentityLeaf }' "$LLVM"; then
    echo "Identity-bearing member remained recursively embedded." >&2
    exit 1
fi
if /usr/bin/grep -Fq '%Range.ByteStorageView = type' "$LLVM"; then
    echo "Transparent storage wrapper emitted a physical aggregate." >&2
    exit 1
fi

clang -Wno-override-module -x ir "$LLVM" -x c \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" \
    -o "$BUILD_ROOT/MemberRepresentations"

set +e
"$BUILD_ROOT/MemberRepresentations"
range_exit=$?
set -e
if [[ "$range_exit" -ne 12 ]]; then
    echo "Member representation runtime proof failed: expected 12, got $range_exit" >&2
    exit 1
fi

echo "Inline values, direct identity links, and transparent storage verified."
