#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Source the candidate harness so this checkpoint uses its canonical source
# discovery, RootValue fixture writer, compiler invocation, and LLVM helpers.
source "$SCRIPT_DIR/check-range-compiler-candidate"
source "$SCRIPT_DIR/resolve-range-stage2-compiler"

# Root-value is the tight compiler-development loop. Its Stage 2 artifact is
# deliberately disposable and fast to link; optimized/LTO artifacts remain the
# responsibility of smoke, candidate, fixed-point, and promotion gates.
RANGE_STAGE2_PROFILE="development"
SEED_COMPILER_OPTIMIZATION="-O2"
SEED_COMPILER_LTO="-flto=thin"
COMPILER_OPTIMIZATION="-O0"
COMPILER_LTO="-fno-lto"

usage() {
    cat <<'USAGE'
Usage:
  scripts/check-range-root-value [DIR]
  scripts/check-range-root-value --controls [DIR]
  scripts/check-range-root-value --help

DIR defaults to RangeCompiler/Sources/Compiler. The command resolves a
content-addressed development Stage 2 compiler (-O0, no LTO) for the current
accepted seed, runtime, and compiler sources, then validates only RootValue
boundary-forward-mixed.
The controls mode runs the complete neighboring RootValue positive and negative
fixture set against the same cached Stage 2 compiler. Both modes first verify
the focused @project scalar-default and @storage/@literal fixtures against
that compiler.
USAGE
}

check_project_defaults_fixture() {
    local label="$1"
    local relative="$2"
    local expected_status="$3"
    local expected_text="$4"
    local fixture="$REPO_ROOT/$relative"
    local output="$WORK_ROOT/project-defaults-$label.out"
    local error="$WORK_ROOT/project-defaults-$label.err"
    local actual_status

    [[ -f "$fixture" ]] || fail "missing project-defaults fixture: $relative"
    if "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq "$expected_status" ]] \
        || fail "ProjectDefaults $label exited $actual_status, expected $expected_status"
    [[ ! -s "$error" ]] || fail "ProjectDefaults $label wrote stderr"
    /usr/bin/grep -Fq "$expected_text" "$output" \
        || fail "ProjectDefaults $label omitted expected result: $expected_text"
    echo "ProjectDefaults $label: pass"
}

check_project_integer_lowering() {
    local label="$1"
    local relative="$2"
    local expected_instruction="$3"
    local fixture="$REPO_ROOT/$relative"
    local llvm="$WORK_ROOT/project-defaults-$label.ll"

    [[ -f "$fixture" ]] || fail "missing project-defaults lowering fixture: $relative"
    "$STAGE2_EXECUTABLE" emit-llvm "$fixture" "$llvm" \
        || fail "ProjectDefaults $label did not emit LLVM"
    /usr/bin/grep -Fq "$expected_instruction" "$llvm" \
        || fail "ProjectDefaults $label omitted expected lowering: $expected_instruction"
    validate_llvm "$llvm"
    echo "ProjectDefaults $label: pass"
}

check_target_pointer_bits_runtime() {
    local fixture="$REPO_ROOT/Testing/ProjectDefaults/Pass/TargetPointerBitsRuntime.range"
    local llvm="$WORK_ROOT/project-defaults-target-pointer-bits-runtime.ll"
    local executable="$WORK_ROOT/project-defaults-target-pointer-bits-runtime"
    local actual_status

    "$STAGE2_EXECUTABLE" emit-llvm "$fixture" "$llvm" \
        || fail "ProjectDefaults target-pointer-bits-runtime did not emit LLVM"
    /usr/bin/grep -Fq 'call i32 @targetPointerBits()' "$llvm" \
        || fail "ProjectDefaults target-pointer-bits-runtime omitted the builtin call"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$executable"
    if "$executable"; then
        actual_status=0
    else
        actual_status=$?
    fi
    [[ "$actual_status" -eq 64 ]] \
        || fail "ProjectDefaults target-pointer-bits-runtime returned $actual_status, expected 64"
    echo "ProjectDefaults target-pointer-bits-runtime: pass"
}

check_range_native_project_macro() {
    local fixture="$REPO_ROOT/Testing/ProjectDefaults/Pass/RangeNativeProject.range"
    local override_fixture="$REPO_ROOT/Testing/ProjectDefaults/Pass/RangeNativeProjectOverride.range"
    local output="$WORK_ROOT/project-defaults-range-native.out"
    local override_output="$WORK_ROOT/project-defaults-range-native-override.out"
    local error="$WORK_ROOT/project-defaults-range-native.err"
    local integer_count bool_count override_integer_count override_bool_count

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "Range-native project macro did not compile"
    [[ ! -s "$error" ]] || fail "Range-native project macro wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=1' "$output" \
        || fail "Range-native project macro did not execute through target capabilities"
    /usr/bin/grep -Fq $'name=integer\tmemberKind=state\ttype=Int' "$output" \
        || fail "Range-native project macro did not expand the integer default"
    /usr/bin/grep -Fq $'name=bool\tmemberKind=state\ttype=Bool' "$output" \
        || fail "Range-native project macro did not expand the bool default"
    /usr/bin/grep -Fq $'readDependencyCount=2' "$output" \
        || fail "Range-native project macro did not record both member reads"
    integer_count="$(/usr/bin/grep -F -c $'name=integer\tmemberKind=state\ttype=Int' "$output" || true)"
    bool_count="$(/usr/bin/grep -F -c $'name=bool\tmemberKind=state\ttype=Bool' "$output" || true)"
    [[ "$integer_count" -eq 1 && "$bool_count" -eq 1 ]] \
        || fail "Range-native project macro did not expand exactly one integer and one bool default"
    "$STAGE2_EXECUTABLE" compile "$override_fixture" > "$override_output" 2> "$error" \
        || fail "Range-native project override did not compile"
    [[ ! -s "$error" ]] || fail "Range-native project override wrote stderr"
    /usr/bin/grep -Fq $'projectDefaults\tvalid=true\ttargetPointerBits=64\tintegerBits=4\tintegerOverridden=true\tboolOverridden=false' "$override_output" \
        || fail "Range-native project macro did not preserve the explicit integer override"
    /usr/bin/grep -Fq $'name=bool\tmemberKind=state\ttype=Bool' "$override_output" \
        || fail "Range-native project macro did not expand the missing bool default"
    override_integer_count="$(/usr/bin/grep -F -c $'name=integer\tmemberKind=state\ttype=Int' "$override_output" || true)"
    override_bool_count="$(/usr/bin/grep -F -c $'name=bool\tmemberKind=state\ttype=Bool' "$override_output" || true)"
    [[ "$override_integer_count" -eq 0 && "$override_bool_count" -eq 1 ]] \
        || fail "Range-native project macro did not preserve one integer override and expand exactly one bool default"
    echo "ProjectDefaults range-native-project: pass"
}

check_macro_environment() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/Environment.range"
    local output="$WORK_ROOT/macro-environment.out"
    local error="$WORK_ROOT/macro-environment.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "single-binding macro environment did not compile"
    [[ ! -s "$error" ]] || fail "single-binding macro environment wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=1\teventCount=1' "$output" \
        || fail "single-binding macro environment did not execute through one capability handle"
    /usr/bin/grep -Fq $'readDependencyCount=1' "$output" \
        || fail "single-binding macro environment did not record its graph read"
    /usr/bin/grep -Fq $'severity=1\toperation=1\tmessage=environment observed' "$output" \
        || fail "single-binding macro environment did not emit its diagnostic"
    echo "Macros single-binding-environment: pass"
}

check_macro_result_values() {
    local recursive_fixture="$REPO_ROOT/Testing/Macros/Pass/RecursiveResultValue.range"
    local branch_fixture="$REPO_ROOT/Testing/Macros/Pass/BranchJoinReturn.range"
    local application_fixture="$REPO_ROOT/Testing/Macros/Pass/ApplicationValue.range"
    local recursive_output="$WORK_ROOT/macro-recursive-result.out"
    local branch_output="$WORK_ROOT/macro-branch-join-result.out"
    local application_output="$WORK_ROOT/macro-application-value.out"
    local error="$WORK_ROOT/macro-result.err"

    "$STAGE2_EXECUTABLE" compile "$recursive_fixture" > "$recursive_output" 2> "$error" \
        || fail "recursive macro result did not compile"
    [[ ! -s "$error" ]] || fail "recursive macro result wrote stderr"
    /usr/bin/grep -Fq $'macroResult\trow=0\tinvocationRow=0\tapplicationRow=0\tkind=3' "$recursive_output" \
        || fail "recursive macro result omitted its construct root"
    /usr/bin/grep -Fq $'childCount=2\tparentRow=-1\tordinal=0' "$recursive_output" \
        || fail "recursive macro result root omitted its ordered children"
    /usr/bin/grep -Fq $'macroResult\trow=2\tinvocationRow=0\tapplicationRow=0\tkind=3' "$recursive_output" \
        || fail "recursive macro result omitted its nested construct"
    /usr/bin/grep -Fq $'childCount=1\tparentRow=0\tordinal=1' "$recursive_output" \
        || fail "recursive macro result lost its nested construct position"
    /usr/bin/grep -Fq $'macroResult\trow=3\tinvocationRow=0\tapplicationRow=0\tkind=1' "$recursive_output" \
        || fail "recursive macro result omitted its nested scalar leaf"
    /usr/bin/grep -Fq $'childCount=0\tparentRow=2\tordinal=0' "$recursive_output" \
        || fail "recursive macro result lost its scalar leaf position"

    "$STAGE2_EXECUTABLE" compile "$branch_fixture" > "$branch_output" 2> "$error" \
        || fail "branch-join macro result did not compile"
    [[ ! -s "$error" ]] || fail "branch-join macro result wrote stderr"
    /usr/bin/grep -Fq $'macroGraphGeneratedMember\trow=0\tkind=member' "$branch_output" \
        || fail "branch-join macro did not preserve its expansion"
    /usr/bin/grep -Fq $'macroResult\trow=0\tinvocationRow=0\tapplicationRow=0\tkind=3' "$branch_output" \
        || fail "branch-join macro did not pass its result through the function boundary"

    "$STAGE2_EXECUTABLE" compile "$application_fixture" > "$application_output" 2> "$error" \
        || fail "Macro.Application.value fixture did not compile"
    [[ ! -s "$error" ]] || fail "Macro.Application.value fixture wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2' "$application_output" \
        || fail "Macro.Application.value fixture did not execute both member macros"
    /usr/bin/grep -Fq $'macroResult\trow=3\tinvocationRow=1\tapplicationRow=1\tkind=1' "$application_output" \
        || fail "Macro.Application.value did not feed the first macro result into the second"
    /usr/bin/grep -Fq $'scalar=7\tchildCount=0\tparentRow=2\tordinal=0' "$application_output" \
        || fail "Macro.Application.value changed the persisted generic payload"
    echo "Macros recursive-and-branch-join-results: pass"
}

check_macro_generic_boundary_materialization() {
    local fixture="$REPO_ROOT/Testing/Macros/Pass/GenericBoundaryMaterialization.range"
    local output="$WORK_ROOT/macro-generic-boundary-materialization.out"
    local error="$WORK_ROOT/macro-generic-boundary-materialization.err"

    "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error" \
        || fail "generic compile-time boundary materialization did not compile"
    [[ ! -s "$error" ]] || fail "generic compile-time boundary materialization wrote stderr"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=1' "$output" \
        || fail "generic compile-time boundary materialization did not execute through the macro environment"
    [[ "$(/usr/bin/grep -F -c $'childApplicationRow=-1' "$output" || true)" -eq 5 ]] \
        || fail "generic compile-time boundary materialization did not persist three root values and two array children"
    /usr/bin/grep -Eq $'macroGraphGeneratedFunction\trow=0\tkind=function.*\tname=generatedCount\treturnType=Int' "$output" \
        && /usr/bin/grep -Eq $'macroGraphGeneratedFunction\trow=1\tkind=function.*\tname=generatedValues\treturnType=\\[Int\\]' "$output" \
        && /usr/bin/grep -Eq $'macroGraphGeneratedFunction\trow=2\tkind=function.*\tname=generatedEnabled\treturnType=Bool' "$output" \
        || fail "generic compile-time boundary materialization did not commit all generated functions"
    echo "Macros generic-boundary-materialization: pass"
}

check_macro_parenthesized_boundary_rejection() {
    local fixture="$REPO_ROOT/Testing/Macros/Fail/ParenthesizedBoundaryValue.range"
    local output="$WORK_ROOT/macro-parenthesized-boundary-value.out"
    local error="$WORK_ROOT/macro-parenthesized-boundary-value.err"

    if "$STAGE2_EXECUTABLE" compile "$fixture" > "$output" 2> "$error"; then
        fail "parenthesized compile-time boundary value unexpectedly compiled"
    fi
    [[ ! -s "$error" ]] || fail "parenthesized compile-time boundary rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedDeclarations\tphase=structuralValidation\treason=invalidTableStructure' "$output" \
        || fail "parenthesized compile-time boundary value did not fail structural validation"
    echo "Macros parenthesized-boundary-rejection: pass"
}

