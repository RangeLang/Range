#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerBootstrap.json"
COMPILER_DIRECTORY="${1:-$REPO_ROOT/RangeCompiler/Sources/Compiler}"

fail() {
    echo "Range compiler profile failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

profile_keep="${RANGE_COMPILER_PROFILE_KEEP:-0}"
profile_verbose_phases="${RANGE_COMPILER_PROFILE_VERBOSE_PHASES:-0}"
profile_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-profile.XXXXXX")"
cleanup() {
    if [[ "$profile_keep" != 1 ]]; then
        /bin/rm -rf "$profile_root"
    fi
}
trap cleanup EXIT

[[ -d "$COMPILER_DIRECTORY" ]] || fail "missing compiler directory: $COMPILER_DIRECTORY"
COMPILER_DIRECTORY="$(cd "$COMPILER_DIRECTORY" && pwd)"

profiled_compiler="$profile_root/RangeCompilerProfiled"
profile_clock="$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerProfileClock.c"
source_bundle="$profile_root/CompilerSourceSet.range"
llvm_output="$profile_root/Compiler.ll"
trace_output="$profile_root/Trace.tsv"
resource_output="$profile_root/Resources.txt"
compiler_llvm="${RANGE_COMPILER_PROFILE_LLVM:-$REPO_ROOT/$(manifest_value bootstrap.path)}"
provided_source_bundle="${RANGE_COMPILER_PROFILE_SOURCE_BUNDLE:-}"
profile_artifact_input="${RANGE_COMPILER_PROFILE_ARTIFACT_INPUT:-}"
profile_artifact_output="${RANGE_COMPILER_PROFILE_ARTIFACT_OUTPUT:-$profile_root/FunctionArtifacts.next}"
profile_development="${RANGE_COMPILER_PROFILE_DEVELOPMENT:-0}"
[[ -f "$compiler_llvm" ]] || fail "missing compiler LLVM: $compiler_llvm"

write_artifact_directives() {
    if [[ -n "$profile_artifact_input" ]]; then
        [[ -f "$profile_artifact_input" ]] || fail "missing function artifact input: $profile_artifact_input"
        /usr/bin/printf '// range-function-artifact-input %s\n' "$profile_artifact_input"
    fi
    /usr/bin/printf '// range-function-artifact-output %s\n' "$profile_artifact_output"
}

runtime_inputs=()
runtime_count="$(manifest_value runtimeSources)"
for ((index = 0; index < runtime_count; index += 1)); do
    runtime_inputs+=("$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")")
done

profile_objects=()
clang -O2 -flto=thin -Wno-override-module -c "$compiler_llvm" -o "$profile_root/Compiler.o"
profile_objects+=("$profile_root/Compiler.o")
for ((index = 0; index < runtime_count; index += 1)); do
    runtime_source="${runtime_inputs[$index]}"
    runtime_object="$profile_root/Runtime-$index.o"
    if [[ "$runtime_source" == "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerMetrics.c" ]]; then
        clang -O2 -flto=thin \
            -DcompilerMetricsFunctionBegin=compilerMetricsFunctionBeginBase \
            -DcompilerMetricsFunctionEnd=compilerMetricsFunctionEndBase \
            -DcompilerTelemetryProbeBegin=compilerTelemetryProbeBeginBase \
            -DcompilerTelemetryProbeEnd=compilerTelemetryProbeEndBase \
            -DcompilerMetricsObserveRawBufferAppend=compilerMetricsObserveRawBufferAppendBase \
            -DcompilerMetricsObserveRawBufferMaterialize=compilerMetricsObserveRawBufferMaterializeBase \
            -DcompilerMetricsObserveRawBufferReallocation=compilerMetricsObserveRawBufferReallocationBase \
            -DcompilerMetricsObserveStringConcat=compilerMetricsObserveStringConcatBase \
            -DcompilerMetricsObserveStringSubstring=compilerMetricsObserveStringSubstringBase \
            -DcompilerMetricsObserveConstructObject=compilerMetricsObserveConstructObjectBase \
            -DcompilerMetricsObserveConstructField=compilerMetricsObserveConstructFieldBase \
            -DcompilerMetricsObserveConstructLookupProbe=compilerMetricsObserveConstructLookupProbeBase \
            -DcompilerMetricsObserveRawBufferLiveBytes=compilerMetricsObserveRawBufferLiveBytesBase \
            -DcompilerMetricsObserveTransientLiveBytes=compilerMetricsObserveTransientLiveBytesBase \
            -c "$runtime_source" -o "$runtime_object"
    elif [[ "$runtime_source" == "$REPO_ROOT/RangeCompiler/Runtime/RangeCompilerHost.c" ]]; then
        clang -O2 -flto=thin -DRANGE_IDENTITY_ENABLE_STATS \
            -c "$runtime_source" -o "$runtime_object"
    else
        clang -O2 -flto=thin -c "$runtime_source" -o "$runtime_object"
    fi
    profile_objects+=("$runtime_object")
done
clang -O2 -flto=thin -c "$profile_clock" -o "$profile_root/ProfileClock.o"
profile_objects+=("$profile_root/ProfileClock.o")
clang -O2 -flto=thin "${profile_objects[@]}" -o "$profiled_compiler"

if [[ -n "$provided_source_bundle" ]]; then
    [[ -f "$provided_source_bundle" ]] || fail "missing provided source bundle: $provided_source_bundle"
    if [[ "$(/usr/bin/sed -n '1p' "$provided_source_bundle")" == "compilerNativeSourceSetLLVMText" ]]; then
        /usr/bin/sed -n '1p' "$provided_source_bundle" > "$source_bundle"
        write_artifact_directives >> "$source_bundle"
        /usr/bin/sed -n '2,$p' "$provided_source_bundle" >> "$source_bundle"
    else
        write_artifact_directives > "$source_bundle"
        /bin/cat "$provided_source_bundle" >> "$source_bundle"
    fi
else
    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$source_bundle"
    if [[ "$profile_development" == 1 ]]; then
        /usr/bin/printf '%s\n' '// range-development-compiler' >> "$source_bundle"
    fi
    write_artifact_directives >> "$source_bundle"
    compiler_source_count="$(manifest_value compilerSources)"
    for ((index = 0; index < compiler_source_count; index += 1)); do
        role="$(manifest_value "compilerSources.$index.role")"
        [[ "$role" == core ]] || continue
        relative="$(manifest_value "compilerSources.$index.path")"
        source="$REPO_ROOT/$relative"
        [[ -f "$source" ]] || fail "missing compiler Core source: $relative"
        /usr/bin/printf 'compilerSourceFile\\trole=core\\tpath=%s\n' "$relative" >> "$source_bundle"
        /bin/cat "$source" >> "$source_bundle"
        [[ -z "$(/usr/bin/tail -c 1 "$source")" ]] || /usr/bin/printf '\n' >> "$source_bundle"
    done

    while IFS= read -r source; do
        relative="${source#"$COMPILER_DIRECTORY/"}"
        /usr/bin/printf 'compilerSourceFile\\trole=project\\tpath=%s\n' "$relative" >> "$source_bundle"
        /bin/cat "$source" >> "$source_bundle"
        [[ -z "$(/usr/bin/tail -c 1 "$source")" ]] || /usr/bin/printf '\n' >> "$source_bundle"
    done < <(/usr/bin/find "$COMPILER_DIRECTORY" -path '*/.range' -prune -o -type f -name '*.range' -print | LC_ALL=C /usr/bin/sort)
fi

set +e
RANGE_COMPILER_PHASE_TRACE=1 RANGE_COMPILER_FUNCTION_TRACE=1 \
    /usr/bin/time -l -o "$resource_output" \
    "$profiled_compiler" "$source_bundle" > "$llvm_output" 2> "$trace_output"
profile_status=$?
set -e

/usr/bin/printf 'compilerProfile\tstatus=%s\tllvmBytes=%s\tfunctionCount=%s\n' \
    "$profile_status" "$(/usr/bin/stat -f %z "$llvm_output")" \
    "$(/usr/bin/grep -c $'^compilerFunctionEnd\t' "$trace_output" || true)"
if [[ -s "$profile_artifact_output" ]]; then
    /usr/bin/printf 'compilerArtifact\tstatus=written\tpath=%s\tbytes=%s\tsha256=%s\n' \
        "$profile_artifact_output" \
        "$(/usr/bin/stat -f %z "$profile_artifact_output")" \
        "$(/usr/bin/shasum -a 256 "$profile_artifact_output" | /usr/bin/awk '{print $1}')"
elif [[ -n "$profile_artifact_input" && "$profile_status" -eq 0 ]]; then
    /usr/bin/printf 'compilerArtifact\tstatus=reused\tpath=%s\n' "$profile_artifact_input"
else
    /usr/bin/printf 'compilerArtifact\tstatus=absent\tpath=%s\n' "$profile_artifact_output"
fi
/usr/bin/awk '
    /maximum resident set size/ { maximum = $1 }
    /peak memory footprint/ { peak = $1 }
    END { printf "compilerResources\tmaximumResidentBytes=%s\tpeakFootprintBytes=%s\n", maximum, peak }
' "$resource_output"
if [[ "$profile_verbose_phases" == 1 ]]; then
    /usr/bin/grep $'^compilerPhase\t' "$trace_output" || true
    /usr/bin/grep $'^compilerPhaseMemory\t' "$trace_output" || true
else
    /usr/bin/awk -F '\t' '
        $1 == "compilerPhase" || $1 == "compilerPhaseMemory" {
            name = $2
            sub(/^name=/, "", name)
            if (name == "sourceSet.begin" || name == "declarationCapture.end" || name == "macroLink.end" || name == "macroExecution.begin" || name == "reachabilityDiscovery.end" || name == "functionArtifactCandidates.end" || name == "behaviorGraphClosure.end" || name == "functionEmission.end" || name == "llvmPipeline.end" || name == "sourceSet.end") print
        }
    ' "$trace_output"
fi
if [[ "$profile_keep" == 1 ]]; then
    /usr/bin/printf 'compilerProbeTrace\tpath=%s\n' "$trace_output"
fi
/usr/bin/awk -F '\t' '
    BEGIN { openDepth = 0 }
    function value(fieldName,    field, result) {
        for (field = 1; field <= NF; field += 1) {
            if ($field ~ ("^" fieldName "=")) {
                result = $field
                sub("^" fieldName "=", "", result)
                return result
            }
        }
        return ""
    }
    $1 == "compilerProbeBegin" {
        probeID = value("probeID")
        depth = value("depth") + 0
        if (depth != openDepth) malformed += 1
        stack[openDepth] = probeID
        openDepth += 1
        begins += 1
    }
    $1 == "compilerProbeEnd" {
        probeID = value("probeID")
        depth = value("depth") + 0
        if (openDepth < 1 || depth != openDepth - 1 || stack[depth] != probeID) malformed += 1
        if (openDepth > 0) {
            openDepth -= 1
            delete stack[openDepth]
        }
        ends += 1
        name = value("name")
        duration = value("durationNanoseconds") + 0
        status = value("status") + 0
        count[name] += 1
        durationTotal[name] += duration
        if (status != 0) failures[name] += 1
        appendCalls[name] += value("appendCalls")
        appendBytes[name] += value("appendBytes")
        materializeCalls[name] += value("materializeCalls")
        materializeBytes[name] += value("materializeBytes")
        reallocations[name] += value("reallocations")
        reallocationBytes[name] += value("reallocationBytes")
        stringConcatCalls[name] += value("stringConcatCalls")
        stringConcatBytes[name] += value("stringConcatBytes")
        substringCalls[name] += value("stringSubstringCalls")
        substringSourceBytes[name] += value("stringSubstringSourceBytes")
        substringResultBytes[name] += value("stringSubstringResultBytes")
        constructObjects[name] += value("constructObjects")
        constructFields[name] += value("constructFields")
        constructNameBytes[name] += value("constructNameBytes")
        constructLookupProbes[name] += value("constructLookupProbes")
        rawPeakDelta = value("localPeakRawBufferDeltaBytes") + 0
        transientPeakDelta = value("localPeakTransientDeltaBytes") + 0
        if (duration > maximumDuration[name]) {
            maximumDuration[name] = duration
            maximumFunctionID[name] = value("functionID")
            maximumInstanceID[name] = value("instanceID")
            maximumBlockID[name] = value("blockID")
            maximumNodeID[name] = value("nodeID")
            maximumOrdinal[name] = value("ordinal")
            maximumItemCount[name] = value("itemCount")
            maximumProbeID[name] = probeID
        }
        if (rawPeakDelta > maximumRawPeakDelta[name]) maximumRawPeakDelta[name] = rawPeakDelta
        if (transientPeakDelta > maximumTransientPeakDelta[name]) maximumTransientPeakDelta[name] = transientPeakDelta
    }
    END {
        balanced = malformed == 0 && begins == ends && openDepth == 0
        printf "compilerProbeIntegrity\tbegins=%d\tends=%d\topen=%d\tmalformed=%d\tbalanced=%d\n", begins, ends, openDepth, malformed, balanced
        for (name in count) {
            printf "compilerProbeSummary\tname=%s\tcount=%.0f\tfailures=%.0f\tdurationNanoseconds=%.0f\tmaximumDurationNanoseconds=%.0f\tmaximumProbeID=%s\tmaximumFunctionID=%s\tmaximumInstanceID=%s\tmaximumBlockID=%s\tmaximumNodeID=%s\tmaximumOrdinal=%s\tmaximumItemCount=%s\tappendCalls=%.0f\tappendBytes=%.0f\tmaterializeCalls=%.0f\tmaterializeBytes=%.0f\treallocations=%.0f\treallocationBytes=%.0f\tstringConcatCalls=%.0f\tstringConcatBytes=%.0f\tstringSubstringCalls=%.0f\tstringSubstringSourceBytes=%.0f\tstringSubstringResultBytes=%.0f\tconstructObjects=%.0f\tconstructFields=%.0f\tconstructNameBytes=%.0f\tconstructLookupProbes=%.0f\tmaximumLocalRawBufferDeltaBytes=%.0f\tmaximumLocalTransientDeltaBytes=%.0f\n", name, count[name], failures[name], durationTotal[name], maximumDuration[name], maximumProbeID[name], maximumFunctionID[name], maximumInstanceID[name], maximumBlockID[name], maximumNodeID[name], maximumOrdinal[name], maximumItemCount[name], appendCalls[name], appendBytes[name], materializeCalls[name], materializeBytes[name], reallocations[name], reallocationBytes[name], stringConcatCalls[name], stringConcatBytes[name], substringCalls[name], substringSourceBytes[name], substringResultBytes[name], constructObjects[name], constructFields[name], constructNameBytes[name], constructLookupProbes[name], maximumRawPeakDelta[name], maximumTransientPeakDelta[name]
        }
        if (!balanced) exit 2
    }
' "$trace_output" | LC_ALL=C /usr/bin/sort
/usr/bin/grep $'^compilerFunctionMemoryPeak\t' "$trace_output" || true
/usr/bin/grep $'^compilerFunctionTransientPeak\t' "$trace_output" || true
/usr/bin/grep $'^compilerEmitterStagePeak\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            name = ""
            bytes = 0
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ /^name=/) { name = $field; sub(/^name=/, "", name) }
                if ($field ~ /^bytes=/) { bytes = $field; sub(/^bytes=/, "", bytes) }
            }
            if (bytes > maximum[name]) maximum[name] = bytes
        }
        END {
            for (name in maximum) printf "compilerEmitterStageSummary\tname=%s\tmaximumBytes=%d\n", name, maximum[name]
        }
    ' || true
/usr/bin/grep $'^compilerLoweringStagePeak\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            name = $2
            sub(/^name=/, "", name)
            bytes = $3
            sub(/^bytes=/, "", bytes)
            if (bytes > maximum[name]) maximum[name] = bytes
        }
        END {
            for (name in maximum) printf "compilerLoweringStageSummary\tname=%s\tmaximumBytes=%d\n", name, maximum[name]
        }
    ' || true
/usr/bin/grep $'^compilerLoweringStageBuffer\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        function value(fieldName,    field, result) {
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ ("^" fieldName "=")) {
                    result = $field
                    sub("^" fieldName "=", "", result)
                    return result
                }
            }
            return 0
        }
        {
            name = value("name")
            sub(/^loweringStage.end./, "", name)
            stageDuration = value("durationMicroseconds")
            stageTransient = value("liveTransientDeltaBytes")
            count[name] += 1
            duration[name] += stageDuration
            appendCalls[name] += value("appendCalls")
            appendBytes[name] += value("appendBytes")
            materializeCalls[name] += value("materializeCalls")
            materializeBytes[name] += value("materializeBytes")
            reallocations[name] += value("reallocations")
            reallocationBytes[name] += value("reallocationBytes")
            rawDelta[name] += value("liveRawBufferDeltaBytes")
            transientDelta[name] += stageTransient
            if (stageDuration > maximumDuration[name]) {
                maximumDuration[name] = stageDuration
                durationFunctionID[name] = value("functionID")
                durationFunctionName[name] = value("functionName")
            }
            if (stageTransient > maximumTransient[name]) {
                maximumTransient[name] = stageTransient
                transientFunctionID[name] = value("functionID")
                transientFunctionName[name] = value("functionName")
            }
        }
        END {
            split("parse memory mir mirValidate emit edges destroy result", order, " ")
            for (ordinal = 1; ordinal <= 8; ordinal += 1) {
                name = order[ordinal]
                printf "compilerLoweringBufferStage\tname=%s\tcount=%.0f\tdurationMicroseconds=%.0f\tappendCalls=%.0f\tappendBytes=%.0f\tmaterializeCalls=%.0f\tmaterializeBytes=%.0f\treallocations=%.0f\treallocationBytes=%.0f\tliveRawBufferDeltaBytes=%.0f\tliveTransientDeltaBytes=%.0f\n", name, count[name], duration[name], appendCalls[name], appendBytes[name], materializeCalls[name], materializeBytes[name], reallocations[name], reallocationBytes[name], rawDelta[name], transientDelta[name]
                printf "compilerLoweringBufferHotspot\tname=%s\tmaximumDurationMicroseconds=%.0f\tdurationFunctionID=%s\tdurationFunctionName=%s\tmaximumTransientDeltaBytes=%.0f\ttransientFunctionID=%s\ttransientFunctionName=%s\n", name, maximumDuration[name], durationFunctionID[name], durationFunctionName[name], maximumTransient[name], transientFunctionID[name], transientFunctionName[name]
            }
        }
    ' || true
/usr/bin/grep $'^compilerEmitterStageBuffer\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        function value(fieldName,    field, result) {
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ ("^" fieldName "=")) {
                    result = $field
                    sub("^" fieldName "=", "", result)
                    return result
                }
            }
            return 0
        }
        {
            name = value("name")
            sub(/^emitterStage.end./, "", name)
            count[name] += 1
            duration[name] += value("durationMicroseconds")
            appendCalls[name] += value("appendCalls")
            appendBytes[name] += value("appendBytes")
            materializeCalls[name] += value("materializeCalls")
            materializeBytes[name] += value("materializeBytes")
            reallocations[name] += value("reallocations")
            reallocationBytes[name] += value("reallocationBytes")
            rawDelta[name] += value("liveRawBufferDeltaBytes")
            transientDelta[name] += value("liveTransientDeltaBytes")
        }
        END {
            split("seed plan render materialize globals destroy", order, " ")
            for (ordinal = 1; ordinal <= 6; ordinal += 1) {
                name = order[ordinal]
                printf "compilerEmitterBufferStage\tname=%s\tcount=%.0f\tdurationMicroseconds=%.0f\tappendCalls=%.0f\tappendBytes=%.0f\tmaterializeCalls=%.0f\tmaterializeBytes=%.0f\treallocations=%.0f\treallocationBytes=%.0f\tliveRawBufferDeltaBytes=%.0f\tliveTransientDeltaBytes=%.0f\n", name, count[name], duration[name], appendCalls[name], appendBytes[name], materializeCalls[name], materializeBytes[name], reallocations[name], reallocationBytes[name], rawDelta[name], transientDelta[name]
            }
        }
    ' || true
/usr/bin/grep $'^compilerMemoryStagePeak\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            name = $2
            sub(/^name=/, "", name)
            bytes = $3
            sub(/^bytes=/, "", bytes)
            if (bytes > maximum[name]) maximum[name] = bytes
        }
        END {
            for (name in maximum) printf "compilerMemoryStageSummary\tname=%s\tmaximumBytes=%d\n", name, maximum[name]
        }
    ' || true
/usr/bin/grep $'^compilerTransientWorkItemPeak\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            name = ""
            bytes = 0
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ /^name=/) { name = $field; sub(/^name=/, "", name) }
                if ($field ~ /^bytes=/) { bytes = $field; sub(/^bytes=/, "", bytes) }
            }
            count += 1
            if (bytes > maximum) { maximum = bytes; maximumName = name }
        }
        END { printf "compilerTransientWorkItemSummary\tcount=%d\tmaximumBytes=%d\tmaximumName=%s\n", count, maximum, maximumName }
    ' || true
/usr/bin/grep $'^rangeIdentityAllocator ' "$trace_output" || true
/usr/bin/grep $'^compilerFunctionEnd\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            name = ""
            duration = 0
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ /^name=abi\./) {
                    name = $field
                    sub(/^name=abi\./, "", name)
                    sub(/\..*$/, "", name)
                } else if ($field ~ /^durationMicroseconds=/) {
                    split($field, pair, "=")
                    duration = pair[2]
                }
            }
            if (name != "") {
                count[name] += 1
                microseconds[name] += duration
            }
        }
        END {
            split("parse resolve cfg ownership mir validate emit cleanup", order, " ")
            for (ordinal = 1; ordinal <= 8; ordinal += 1) {
                name = order[ordinal]
                printf "compilerABIStage\tname=%s\tcount=%d\tdurationMicroseconds=%d\n", name, count[name], microseconds[name]
            }
        }
    ' || true
/usr/bin/grep $'^compilerFunctionEnd\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            functionID = ""
            name = ""
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ /^functionID=/) {
                    functionID = $field
                    sub(/^functionID=/, "", functionID)
                } else if ($field ~ /^name=/) {
                    name = $field
                    sub(/^name=/, "", name)
                }
            }
            if (name ~ /^abi\.parse\./) {
                probePasses += 1
                probeByFunction[functionID] += 1
                if (!(functionID in probeNames)) {
                    probeName = name
                    sub(/^abi\.parse\./, "", probeName)
                    probeNames[functionID] = probeName
                    probedFunctions += 1
                }
            } else if (name == "bodyProduct.directEffects") {
                discoveryPasses += 1
            } else if (name !~ /^abi\./) {
                emissionPasses += 1
                emittedByFunction[functionID] += 1
            }
        }
        END {
            extraProbePasses = probePasses - emissionPasses
            if (extraProbePasses < 0) extraProbePasses = 0
            ratioMilli = emissionPasses > 0 ? int((probePasses * 1000) / emissionPasses) : 0
            repeatedFunctions = 0
            maxProbePasses = 0
            maxFunctionID = ""
            for (functionID in probeByFunction) {
                if (probeByFunction[functionID] > 1) repeatedFunctions += 1
                if (probeByFunction[functionID] > maxProbePasses) {
                    maxProbePasses = probeByFunction[functionID]
                    maxFunctionID = functionID
                }
            }
            maxFunctionName = maxFunctionID in probeNames ? probeNames[maxFunctionID] : ""
            printf "compilerABIReconstruction\tprobePasses=%d\temissionPasses=%d\textraProbePasses=%d\tprobedFunctions=%d\trepeatedFunctions=%d\tprobeToEmissionMilli=%d\tmaxProbePasses=%d\tmaxFunctionID=%s\tmaxFunctionName=%s\n", probePasses, emissionPasses, extraProbePasses, probedFunctions, repeatedFunctions, ratioMilli, maxProbePasses, maxFunctionID, maxFunctionName
            typedPasses = discoveryPasses + emissionPasses
            discoveryToEmissionMilli = emissionPasses > 0 ? int((discoveryPasses * 1000) / emissionPasses) : 0
            printf "compilerTypedFunctionPasses\tdiscoveryPasses=%d\temissionPasses=%d\ttotalPasses=%d\tdiscoveryToEmissionMilli=%d\n", discoveryPasses, emissionPasses, typedPasses, discoveryToEmissionMilli
        }
    ' || true
/usr/bin/grep $'^compilerFunctionEnd\t' "$trace_output" \
    | /usr/bin/awk -F '\t' '
        {
            duration = 0
            for (field = 1; field <= NF; field += 1) {
                if ($field ~ /^durationMicroseconds=/) {
                    split($field, pair, "=")
                    duration = pair[2]
                }
            }
            print duration "\t" $0
        }
    ' \
    | LC_ALL=C /usr/bin/sort -nr \
    | /usr/bin/sed -n '1,50p' \
    | /usr/bin/cut -f 2- || true

if [[ "$profile_status" -ne 0 ]]; then
    /usr/bin/tail -n 20 "$llvm_output" >&2
    /usr/bin/tail -n 40 "$trace_output" >&2
fi
exit "$profile_status"
