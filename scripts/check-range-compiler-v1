#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerBootstrap.json"
COMPILER="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler"
FIXTURE="$REPO_ROOT/Testing/Basics/Pass/ReturnInteger.range"
LLVM_PLAN="$REPO_ROOT/RangeCompiler/Sources/Compiler/LLVM/CompilerLLVMPlan.range"
FUNCTION_ARTIFACTS="$REPO_ROOT/RangeCompiler/Sources/Compiler/LLVM/CompilerFunctionArtifacts.range"
COMPILER_V1="$REPO_ROOT/RangeCompiler/Sources/Compiler/Driver/CompilerV1.range"
COMPILER_V1_GRAPH="$REPO_ROOT/RangeCompiler/Sources/Compiler/Driver/CompilerV1Graph.range"
COMPILER_CORE="$REPO_ROOT/RangeCompiler/Sources/Compiler/Driver/CompilerCore.range"
WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-compiler-v1.XXXXXX")"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

fail() {
    echo "Range Compiler V1 check failed: $*" >&2
    exit 1
}

/usr/bin/grep -Fq 'construct CompilerValueFingerprint {' "$COMPILER_CORE" \
    || fail "Compiler V1 has no distinct changing-value representation"
/usr/bin/grep -Fq 'return CompilerIdentity(first: 0, second: 0)' "$COMPILER_V1_GRAPH" \
    || fail "Compiler V1 changed the absent identity wire sentinel"
if /usr/bin/grep -Eq 'let (before|after|input): CompilerFingerprint' "$COMPILER_V1" "$COMPILER_V1_GRAPH" \
    || /usr/bin/grep -Eq 'let (source|shape|behavior|compiled): CompilerFingerprint' "$COMPILER_V1_GRAPH"; then
    fail "Compiler V1 still types a changing phase value as an identity hash key"
fi

/usr/bin/grep -Fq 'function compilerV1SyntaxFactsCapture(source: CompilerV1SourceDelta)' "$COMPILER_V1" \
    || fail "V1 does not expose typed syntax capture as its own product"
/usr/bin/grep -Fq 'compilerTypedDeclarationsCapture(source: source.value.source, tables: tables)' "$COMPILER_V1" \
    || fail "V1 syntax facts do not own declaration capture"
/usr/bin/grep -Fq 'compilerTypedSyntaxCaptureMainRoot(source: source.value.source, tables: tables)' "$COMPILER_V1" \
    || fail "V1 syntax facts do not retain main in their declaration graph"
if /usr/bin/grep -Fq 'compilerTypedSyntaxCapture(source: source.value.source, tables: tables)' "$COMPILER_V1"; then
    fail "V1 Shape still eagerly captures every function body"
fi
/usr/bin/grep -Fq 'snapshot: compilerV1NativeBehaviorSnapshot(identity: source.identity, output: compiledOutput)' "$COMPILER_V1" \
    || fail "V1 Behavior is not derived from successful reachable lowering"
if /usr/bin/grep -Fq 'compilerSemanticBuild(tables: tables, delta: delta, semantics: semantics)' "$COMPILER_V1"; then
    fail "V1 still treats the incomplete whole-program SemanticGraph as Behavior authority"
fi
if /usr/bin/grep -Fq 'compilerTypedSyntaxSummary(source: source.value.source)' "$COMPILER_V1" \
    || /usr/bin/grep -Fq 'compilerSemanticSummary(source: source)' "$COMPILER_V1"; then
    fail "V1 still rebuilds Shape or Behavior through independent source summaries"
fi
/usr/bin/grep -Fq 'function compilerV1Shape(facts: CompilerV1SyntaxFacts, before: CompilerValueFingerprint)' "$COMPILER_V1" \
    || fail "V1 Shape does not consume frozen syntax facts"
/usr/bin/grep -Fq 'snapshot: compilerV1SyntaxFactsSnapshot(facts: facts)' "$COMPILER_V1" \
    || fail "V1 Shape does not project its snapshot from syntax facts"
/usr/bin/grep -Fq 'function compilerV1Behavior(source: CompilerV1SourceDelta, shape: CompilerV1ShapeDelta, before: CompilerValueFingerprint)' "$COMPILER_V1" \
    || fail "V1 Behavior does not own the transitional downstream recapture"
/usr/bin/grep -Fq 'compiledOutput: compilerNativeSourceSetLLVMTextForLinkedTables(source: source.value.source, declarationTables: tables)' "$COMPILER_V1" \
    || fail "V1 Behavior does not retain reachable lowering"
/usr/bin/grep -Fq 'function compilerV1Compile(shape: CompilerV1ShapeDelta, behavior: CompilerV1BehaviorDelta, before: CompilerValueFingerprint)' "$COMPILER_V1" \
    || fail "V1 Compiled still accepts source instead of frozen Shape and Behavior products"
/usr/bin/grep -Fq 'let output: String("\(behavior.compiledOutput)")' "$COMPILER_V1" \
    || fail "V1 Compiled does not consume Behavior's retained lowering product"
if /usr/bin/grep -Fq 'compileRangeNativeProgramOutput(source: source)' "$COMPILER_V1"; then
    fail "V1 Compiled still invokes the source-based native program entry"
fi
if /usr/bin/grep -Fq 'name: String("abi.emit")' "$LLVM_PLAN"; then
    fail "the ABI capability probe still emits a disposable LLVM function"
fi
/usr/bin/grep -Fq 'reachability.abiCapabilities.update(element: 1, index: functionRow)' "$LLVM_PLAN" \
    || fail "function discovery does not publish its Shape-derived ABI capability"
if /usr/bin/grep -Fq 'compilerReachableLLVMStateProbeReachableInstancesForFunction(reachability: reachability' "$LLVM_PLAN"; then
    fail "ABI component planning still reconstructs a discovered function body"
fi

write_behavior_cache_fixture() {
    local output="$1"
    local input_artifact="$2"
    local output_artifact="$3"
    local main_result="$4"

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$output"
    if [[ -n "$input_artifact" ]]; then
        /usr/bin/printf '// range-function-artifact-input %s\n' "$input_artifact" >> "$output"
    fi
    /usr/bin/printf '// range-function-artifact-output %s\n' "$output_artifact" >> "$output"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=project\tpath=BehaviorCache.range' >> "$output"
    /usr/bin/printf '%s\n' \
        'function cachedBehaviorValue(): Int {' \
        '    return 7' \
        '}' \
        '' \
        '@main {' \
        "    return $main_result" \
        '}' >> "$output"
}

write_profile_behavior_fixture() {
    local output="$1"

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$output"
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=project\tpath=BehaviorProfile.range' >> "$output"
    /usr/bin/printf '%s\n' \
        'function cachedBehaviorValue(): Int {' \
        '    return 7' \
        '}' \
        '' \
        '@main {' \
        '    return cachedBehaviorValue()' \
        '}' >> "$output"
}

/usr/bin/grep -Fq 'function compilerReachableLLVMStateFunctionBehaviorInput' "$LLVM_PLAN" \
    || fail "function artifacts omit the pre-lowering Behavior input identity"
/usr/bin/grep -Fq 'function compilerFunctionArtifactBehaviorOutput' "$LLVM_PLAN" \
    || fail "function artifacts omit the proven Behavior output identity"
/usr/bin/grep -Fq 'function compilerReachableLLVMStateFindFunctionArtifactCandidates' "$LLVM_PLAN" \
    || fail "function artifact lookup does not begin at the pre-reconstruction Behavior boundary"
/usr/bin/grep -Fq 'functionArtifactCandidates.end' "$LLVM_PLAN" \
    || fail "pre-reconstruction Behavior lookup is not independently measurable"
/usr/bin/grep -Fq 'function compilerReachableLLVMStateCollectDirectEffectProductForArena' "$REPO_ROOT/RangeCompiler/Sources/Compiler/Body/CompilerBodyOwnership.range" \
    || fail "direct effect product is not owned by the typed discovery arena"
/usr/bin/grep -Fq 'compilerReachableLLVMStateCollectDirectEffectProductForArena(reachability: reachability, arena: arena, instanceID: instanceID)' "$LLVM_PLAN" \
    || fail "discovery does not retain its direct effect product"
if /usr/bin/grep -Fq 'function compilerReachableLLVMStateClassifyReturnAndCollectDirectEffectsForWorkItem' "$REPO_ROOT/RangeCompiler/Sources/Compiler/Body/CompilerBodyOwnership.range"; then
    fail "effect construction still reparses each discovered function"
fi
candidate_lookup_line="$(/usr/bin/grep -n -F 'if compilerReachableLLVMStateFindFunctionArtifactCandidates(reachability: reachability)' "$LLVM_PLAN" | /usr/bin/cut -d: -f1)"
effect_build_line="$(/usr/bin/grep -n -F 'let effectBuildStatus: Int(compilerReachableLLVMStateBuildFunctionInstanceEffects' "$LLVM_PLAN" | /usr/bin/cut -d: -f1)"
[[ -n "$candidate_lookup_line" && -n "$effect_build_line" && "$candidate_lookup_line" -lt "$effect_build_line" ]] \
    || fail "Behavior candidate lookup does not precede effect reconstruction"
/usr/bin/grep -Fq 'function compilerReachableLLVMStateBehaviorCandidateGraphIsClosed' "$LLVM_PLAN" \
    || fail "function artifact candidates are not closed over instance dependencies"
/usr/bin/grep -Fq 'behaviorGraphClosure.end' "$LLVM_PLAN" \
    || fail "Behavior graph closure is not independently measurable"
/usr/bin/grep -Fq 'compilerSyntaxCollectedMainBlock(tables: reachability.context.tables)' "$LLVM_PLAN" \
    || fail "V1 does not collect main from the captured syntax graph"
/usr/bin/grep -Fq 'function compilerReachableLLVMStateEvaluateMainBehaviorRoot' "$LLVM_PLAN" \
    || fail "main is not evaluated as the first Behavior root"
/usr/bin/grep -Fq 'function compilerReachableLLVMStateBuildMainBehavior' "$LLVM_PLAN" \
    || fail "main Behavior input, output, and closure are not persisted"
/usr/bin/grep -Fq 'function compilerReachableLLVMStateCachedMainBehaviorClosure' "$LLVM_PLAN" \
    || fail "cached graph closure does not begin at main"
if /usr/bin/grep -Fq 'compilerCoreParseMainBlock(source: reachability.context.tables.sourceStore.source)' "$LLVM_PLAN"; then
    fail "V1 reparses source text while discovering main"
fi
/usr/bin/grep -Fq 'rangeFunctionArtifacts|version=8' "$FUNCTION_ARTIFACTS" \
    || fail "function artifact schema was not advanced for complete module integrity"
/usr/bin/grep -Fq 'function compilerFunctionArtifactCacheModuleText' "$FUNCTION_ARTIFACTS" \
    || fail "closed Behavior artifacts do not retain the complete emitted module"
/usr/bin/grep -Fq 'return 2' "$LLVM_PLAN" \
    || fail "closed Behavior graphs do not bypass reconstruction"
for field in inputFirst inputSecond outputFirst outputSecond closureFirst closureSecond; do
    /usr/bin/grep -Fq "${field}=" "$FUNCTION_ARTIFACTS" \
        || fail "main Behavior serialization omits $field"
done
for field in behaviorInputFirst behaviorInputSecond behaviorOutputFirst behaviorOutputSecond behaviorClosureFirst behaviorClosureSecond; do
    /usr/bin/grep -Fq "${field}=" "$FUNCTION_ARTIFACTS" \
        || fail "function artifact serialization omits $field"
done
/usr/bin/grep -Fq 'sourceFirst=' "$FUNCTION_ARTIFACTS" \
    || fail "closed module artifact omits sourceFirst"
/usr/bin/grep -Fq 'sourceSecond=' "$FUNCTION_ARTIFACTS" \
    || fail "closed module artifact omits sourceSecond"
for field in integrityFirst integritySecond; do
    /usr/bin/grep -Fq "${field}=" "$FUNCTION_ARTIFACTS" \
        || fail "closed module artifact omits $field"
done
for field in recordsFirst recordsSecond; do
    /usr/bin/grep -Fq "${field}=" "$FUNCTION_ARTIFACTS" \
        || fail "closed module artifact omits $field"
done

"$REPO_ROOT/scripts/range" check-compiler-smoke
[[ -x "$COMPILER" ]] || fail "missing resolved candidate compiler"

"$COMPILER" compile "$FIXTURE" > "$WORK_ROOT/legacy.ll"
"$COMPILER" compile-v1 "$FIXTURE" > "$WORK_ROOT/v1.ll"
/usr/bin/cmp -s "$WORK_ROOT/legacy.ll" "$WORK_ROOT/v1.ll" \
    || fail "V1 plot artifact differs from the legacy compiler output"

/bin/cp "$FIXTURE" "$WORK_ROOT/Bound.range"
"$COMPILER" capture-syntax-v1 "$WORK_ROOT/Bound.range" "$WORK_ROOT/bound-facts.tsv" > "$WORK_ROOT/bound-binding.tsv"
"$COMPILER" resume-v1-facts "$WORK_ROOT/bound-execution.tsv" "$WORK_ROOT/bound-binding.tsv" \
    "$WORK_ROOT/bound-facts.tsv" "$WORK_ROOT/Bound.range" "$WORK_ROOT/bound.ll" > "$WORK_ROOT/bound-cold.out"
/usr/bin/perl -0pi -e 's/@main/construct Added {\n    let value: Int\n}\n\n@main/' "$WORK_ROOT/Bound.range"
stale_facts_status=0
"$COMPILER" resume-v1-facts "$WORK_ROOT/bound-execution.tsv" "$WORK_ROOT/bound-binding.tsv" \
    "$WORK_ROOT/bound-facts.tsv" "$WORK_ROOT/Bound.range" "$WORK_ROOT/bound-stale.ll" > "$WORK_ROOT/bound-stale.out" \
    || stale_facts_status=$?
[[ "$stale_facts_status" -eq 65 ]] \
    || fail "stale same-path syntax facts exited $stale_facts_status instead of 65"
/usr/bin/grep -Fq $'compilerError\tkind=compilerV1SyntaxFactsSourceMismatch' "$WORK_ROOT/bound-stale.out" \
    || fail "stale same-path syntax facts omitted their binding error"

/bin/cp "$FIXTURE" "$WORK_ROOT/Persistent.range"
"$COMPILER" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" > "$WORK_ROOT/persistent-cold.out"
/usr/bin/grep -Eq $'^compilerV1Execution\tstatus=cold\tchanged=1\tsourceBefore=0:0\tsourceAfter=[0-9]+:[0-9]+\tshapeBefore=0:0\tshapeAfter=[0-9]+:[0-9]+\tbehaviorBefore=0:0\tbehaviorAfter=[0-9]+:[0-9]+\tcompiledBefore=0:0\tcompiledAfter=[0-9]+:[0-9]+$' "$WORK_ROOT/persistent-cold.out" \
    || fail "cold persistent execution did not insert every phase value"
/usr/bin/grep -Eq $'^compilerV1Execution\tversion=1\tfileFirst=[0-9]+\tfileSecond=[0-9]+\tsourceFirst=[0-9]+\tsourceSecond=[0-9]+\tshapeFirst=[0-9]+\tshapeSecond=[0-9]+\tbehaviorFirst=[0-9]+\tbehaviorSecond=[0-9]+\tcompiledFirst=[0-9]+\tcompiledSecond=[0-9]+$' "$WORK_ROOT/execution.tsv" \
    || fail "cold persistent execution omitted its Range-owned state"
/bin/cp "$WORK_ROOT/persistent.ll" "$WORK_ROOT/persistent-stdout.ll"
/usr/bin/printf '\n' >> "$WORK_ROOT/persistent-stdout.ll"
/usr/bin/cmp -s "$WORK_ROOT/v1.ll" "$WORK_ROOT/persistent-stdout.ll" \
    || fail "cold persistent execution changed V1 LLVM beyond the CLI print newline"
cold_execution_hash="$(/usr/bin/shasum -a 256 "$WORK_ROOT/execution.tsv" | /usr/bin/awk '{print $1}')"
cold_llvm_hash="$(/usr/bin/shasum -a 256 "$WORK_ROOT/persistent.ll" | /usr/bin/awk '{print $1}')"
cold_source_after="$(/usr/bin/sed -n 's/^compilerV1Execution.*sourceAfter=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-cold.out")"
cold_shape_after="$(/usr/bin/sed -n 's/^compilerV1Execution.*shapeAfter=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-cold.out")"
cold_behavior_after="$(/usr/bin/sed -n 's/^compilerV1Execution.*behaviorAfter=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-cold.out")"
cold_compiled_after="$(/usr/bin/sed -n 's/^compilerV1Execution.*compiledAfter=\([^[:space:]]*\)$/\1/p' "$WORK_ROOT/persistent-cold.out")"

"$COMPILER" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" > "$WORK_ROOT/persistent-unchanged.out"
/usr/bin/grep -Fqx $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/persistent-unchanged.out" \
    || fail "unchanged persistent execution did not reuse its compiled value"
[[ "$cold_execution_hash" == "$(/usr/bin/shasum -a 256 "$WORK_ROOT/execution.tsv" | /usr/bin/awk '{print $1}')" ]] \
    || fail "unchanged persistent execution rewrote its state"
[[ "$cold_llvm_hash" == "$(/usr/bin/shasum -a 256 "$WORK_ROOT/persistent.ll" | /usr/bin/awk '{print $1}')" ]] \
    || fail "unchanged persistent execution rewrote its LLVM"

/usr/bin/perl -0pi -e 's/return 7/return missingValue/' "$WORK_ROOT/Persistent.range"
failed_candidate_status=0
"$COMPILER" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" > "$WORK_ROOT/persistent-failed-candidate.out" \
    || failed_candidate_status=$?
[[ "$failed_candidate_status" -eq 65 ]] \
    || fail "failed persistent candidate exited $failed_candidate_status instead of 65"
/usr/bin/grep -Fq $'compilerError\t' "$WORK_ROOT/persistent-failed-candidate.out" \
    || fail "failed persistent candidate omitted its typed compiler error"
[[ "$cold_execution_hash" == "$(/usr/bin/shasum -a 256 "$WORK_ROOT/execution.tsv" | /usr/bin/awk '{print $1}')" ]] \
    || fail "failed persistent candidate mutated the accepted execution graph"
[[ "$cold_llvm_hash" == "$(/usr/bin/shasum -a 256 "$WORK_ROOT/persistent.ll" | /usr/bin/awk '{print $1}')" ]] \
    || fail "failed persistent candidate mutated the last-known-good LLVM"
/usr/bin/perl -0pi -e 's/return missingValue/return 7/' "$WORK_ROOT/Persistent.range"

/usr/bin/perl -0pi -e 's/return 7/return 8/' "$WORK_ROOT/Persistent.range"
"$COMPILER" resume-v1 "$WORK_ROOT/execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/persistent.ll" > "$WORK_ROOT/persistent-updated.out"
/usr/bin/grep -Eq $'^compilerV1Execution\tstatus=updated\tchanged=1\tsourceBefore=[0-9]+:[0-9]+\tsourceAfter=[0-9]+:[0-9]+\tshapeBefore=[0-9]+:[0-9]+\tshapeAfter=[0-9]+:[0-9]+\tbehaviorBefore=[0-9]+:[0-9]+\tbehaviorAfter=[0-9]+:[0-9]+\tcompiledBefore=[0-9]+:[0-9]+\tcompiledAfter=[0-9]+:[0-9]+$' "$WORK_ROOT/persistent-updated.out" \
    || fail "updated persistent execution did not carry phase value replacements"
updated_source_before="$(/usr/bin/sed -n 's/^compilerV1Execution.*sourceBefore=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-updated.out")"
updated_shape_before="$(/usr/bin/sed -n 's/^compilerV1Execution.*shapeBefore=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-updated.out")"
updated_behavior_before="$(/usr/bin/sed -n 's/^compilerV1Execution.*behaviorBefore=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-updated.out")"
updated_compiled_before="$(/usr/bin/sed -n 's/^compilerV1Execution.*compiledBefore=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/persistent-updated.out")"
[[ "$updated_source_before" == "$cold_source_after" \
    && "$updated_shape_before" == "$cold_shape_after" \
    && "$updated_behavior_before" == "$cold_behavior_after" \
    && "$updated_compiled_before" == "$cold_compiled_after" ]] \
    || fail "updated persistent execution did not load exact prior phase values"
if /usr/bin/cmp -s "$WORK_ROOT/v1.ll" "$WORK_ROOT/persistent.ll"; then
    fail "updated persistent execution reused stale LLVM"
fi

/bin/cp "$WORK_ROOT/execution.tsv" "$WORK_ROOT/other-execution.tsv"
/bin/cp "$WORK_ROOT/Persistent.range" "$WORK_ROOT/OtherIdentity.range"
other_identity_status=0
"$COMPILER" resume-v1 "$WORK_ROOT/other-execution.tsv" "$WORK_ROOT/OtherIdentity.range" "$WORK_ROOT/other.ll" > "$WORK_ROOT/other-identity.out" \
    || other_identity_status=$?
[[ "$other_identity_status" -eq 65 ]] \
    || fail "persistent execution accepted a different File identity"
/usr/bin/grep -Fq 'Compiler V1 execution belongs to a different File identity' "$WORK_ROOT/other-identity.out" \
    || fail "persistent execution identity rejection omitted its typed error"

/usr/bin/printf '%s\n' 'not-an-execution' > "$WORK_ROOT/invalid-execution.tsv"
"$COMPILER" resume-v1 "$WORK_ROOT/invalid-execution.tsv" "$WORK_ROOT/Persistent.range" "$WORK_ROOT/invalid.ll" > "$WORK_ROOT/invalid-execution.out"
/usr/bin/grep -Eq $'^compilerV1Execution\tstatus=cold\tchanged=1\t' "$WORK_ROOT/invalid-execution.out" \
    || fail "malformed stored state was not treated as an absent cache value"
/usr/bin/grep -Eq $'^compilerV1Execution\tversion=1\tfileFirst=[0-9]+\tfileSecond=[0-9]+\t' "$WORK_ROOT/invalid-execution.tsv" \
    || fail "malformed stored state was not replaced with valid Range-owned state"

behavior_cache="$WORK_ROOT/behavior.cache"
write_behavior_cache_fixture "$WORK_ROOT/behavior-cold.range" "" "$behavior_cache" 'cachedBehaviorValue()'
RANGE_COMPILER_PHASE_TRACE=1 RANGE_COMPILER_FUNCTION_TRACE=1 \
    "$COMPILER" compile "$WORK_ROOT/behavior-cold.range" > "$WORK_ROOT/behavior-cold.ll" 2> "$WORK_ROOT/behavior-cold.trace"
[[ -s "$behavior_cache" ]] || fail "cold Behavior compilation omitted its artifact"
/usr/bin/grep -Fq 'rangeFunctionArtifacts|version=8' "$behavior_cache" \
    || fail "cold Behavior compilation did not write schema v8"
/usr/bin/grep -Fq $'compilerPhase\tname=functionEffects.end' "$WORK_ROOT/behavior-cold.trace" \
    || fail "cold Behavior compilation skipped effect reconstruction unexpectedly"
/usr/bin/grep -Fq $'compilerPhase\tname=abiComponents.end' "$WORK_ROOT/behavior-cold.trace" \
    || fail "cold Behavior compilation skipped ABI construction unexpectedly"
/usr/bin/grep -Fq $'compilerPhase\tname=functionEmission.end' "$WORK_ROOT/behavior-cold.trace" \
    || fail "cold Behavior compilation skipped LLVM function emission unexpectedly"
/usr/bin/grep -Fq 'name=bodyProduct.directEffects' "$WORK_ROOT/behavior-cold.trace" \
    || fail "cold Behavior compilation did not retain the direct effect product on its discovery arena"

write_behavior_cache_fixture "$WORK_ROOT/behavior-hit.range" "$behavior_cache" "$WORK_ROOT/behavior-hit.cache" 'cachedBehaviorValue()'
RANGE_COMPILER_PHASE_TRACE=1 \
    "$COMPILER" compile "$WORK_ROOT/behavior-hit.range" > "$WORK_ROOT/behavior-hit.ll" 2> "$WORK_ROOT/behavior-hit.trace"
/usr/bin/cmp -s "$WORK_ROOT/behavior-cold.ll" "$WORK_ROOT/behavior-hit.ll" \
    || fail "closed Behavior cache changed emitted LLVM"
[[ ! -e "$WORK_ROOT/behavior-hit.cache" ]] \
    || fail "closed Behavior graph rebuilt and rewrote its artifact"
if /usr/bin/grep -Fq 'rangeFunctionArtifacts|version=5' "$behavior_cache"; then
    /usr/bin/grep -Fq $'compilerPhase\tname=functionArtifactCandidates.end' "$WORK_ROOT/behavior-hit.trace" \
        || fail "v5 closed Behavior compilation did not inspect its artifact candidates"
fi
if /usr/bin/grep -Fq $'compilerPhase\tname=reachabilityDiscovery.end' "$WORK_ROOT/behavior-hit.trace" \
    || /usr/bin/grep -Fq $'compilerPhase\tname=functionArtifactCandidates.end' "$WORK_ROOT/behavior-hit.trace" \
    || /usr/bin/grep -Fq $'compilerPhase\tname=functionEffects.end' "$WORK_ROOT/behavior-hit.trace" \
    || /usr/bin/grep -Fq $'compilerPhase\tname=abiComponents.end' "$WORK_ROOT/behavior-hit.trace" \
    || /usr/bin/grep -Fq $'compilerPhase\tname=functionEmission.end' "$WORK_ROOT/behavior-hit.trace"; then
    fail "closed Behavior module cache did not bypass discovery, candidates, effects, ABI, and LLVM emission work"
fi

profile_source="$WORK_ROOT/behavior-profile.range"
profile_artifact="$WORK_ROOT/behavior-profile.artifact"
profile_next_artifact="$WORK_ROOT/behavior-profile.next.artifact"
write_profile_behavior_fixture "$profile_source"
RANGE_COMPILER_PROFILE_SOURCE_BUNDLE="$profile_source" \
    RANGE_COMPILER_PROFILE_LLVM="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler.ll" \
    RANGE_COMPILER_PROFILE_ARTIFACT_OUTPUT="$profile_artifact" \
    "$REPO_ROOT/scripts/profile-range-compiler" > "$WORK_ROOT/behavior-profile-cold.out"
[[ -s "$profile_artifact" ]] || fail "profiled cold Behavior compilation omitted its artifact"
/usr/bin/grep -Fq $'compilerArtifact\tstatus=written' "$WORK_ROOT/behavior-profile-cold.out" \
    || fail "profiled cold Behavior compilation did not report its artifact"
/usr/bin/grep -Fq $'compilerPhase\tname=functionEmission.end' "$WORK_ROOT/behavior-profile-cold.out" \
    || fail "profiled cold Behavior compilation did not report LLVM emission"
RANGE_COMPILER_PROFILE_SOURCE_BUNDLE="$profile_source" \
    RANGE_COMPILER_PROFILE_LLVM="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler.ll" \
    RANGE_COMPILER_PROFILE_ARTIFACT_INPUT="$profile_artifact" \
    RANGE_COMPILER_PROFILE_ARTIFACT_OUTPUT="$profile_next_artifact" \
    "$REPO_ROOT/scripts/profile-range-compiler" > "$WORK_ROOT/behavior-profile-hit.out"
[[ ! -e "$profile_next_artifact" ]] || fail "profiled closed Behavior graph rewrote an artifact"
/usr/bin/grep -Fq $'compilerArtifact\tstatus=reused' "$WORK_ROOT/behavior-profile-hit.out" \
    || fail "profiled closed Behavior compilation did not report artifact reuse"
if /usr/bin/grep -Fq $'compilerPhase\tname=functionEffects.end' "$WORK_ROOT/behavior-profile-hit.out" \
    || /usr/bin/grep -Fq $'compilerPhase\tname=abiComponents.end' "$WORK_ROOT/behavior-profile-hit.out" \
    || /usr/bin/grep -Fq $'compilerPhase\tname=functionEmission.end' "$WORK_ROOT/behavior-profile-hit.out"; then
    fail "profiled closed Behavior cache did not bypass effect, ABI, and LLVM emission work"
fi
if /usr/bin/grep -Fq $'compilerPhase\tname=reachabilityDiscovery.end' "$WORK_ROOT/behavior-profile-hit.out"; then
    fail "source-identity module cache still reconstructed reachable function bodies"
fi

write_behavior_cache_fixture "$WORK_ROOT/behavior-main-change.range" "$behavior_cache" "$WORK_ROOT/behavior-main-change.cache" 'cachedBehaviorValue() + 1'
"$COMPILER" compile "$WORK_ROOT/behavior-main-change.range" > "$WORK_ROOT/behavior-main-change.ll"
[[ -s "$WORK_ROOT/behavior-main-change.cache" ]] \
    || fail "changed main body incorrectly reused the closed Behavior module"

/bin/cp "$behavior_cache" "$WORK_ROOT/behavior-root-edge-input.cache"
/usr/bin/perl -0pi -e 's/outputFirst=([0-9]+)/"outputFirst=" . ($1 + 1)/e' "$WORK_ROOT/behavior-root-edge-input.cache"
write_behavior_cache_fixture "$WORK_ROOT/behavior-root-edge.range" "$WORK_ROOT/behavior-root-edge-input.cache" "$WORK_ROOT/behavior-root-edge.cache" 'cachedBehaviorValue()'
"$COMPILER" compile "$WORK_ROOT/behavior-root-edge.range" > "$WORK_ROOT/behavior-root-edge.ll"
[[ -s "$WORK_ROOT/behavior-root-edge.cache" ]] \
    || fail "changed root Behavior output incorrectly reused the cached module"

/bin/cp "$behavior_cache" "$WORK_ROOT/behavior-callee-output-input.cache"
/usr/bin/perl -0pi -e 's/behaviorOutputFirst=([0-9]+)/"behaviorOutputFirst=" . ($1 + 1)/e' "$WORK_ROOT/behavior-callee-output-input.cache"
write_behavior_cache_fixture "$WORK_ROOT/behavior-callee-output.range" "$WORK_ROOT/behavior-callee-output-input.cache" "$WORK_ROOT/behavior-callee-output.cache" 'cachedBehaviorValue()'
"$COMPILER" compile "$WORK_ROOT/behavior-callee-output.range" > "$WORK_ROOT/behavior-callee-output.ll"
[[ -s "$WORK_ROOT/behavior-callee-output.cache" ]] \
    || fail "changed callee Behavior output incorrectly reused the cached module"

"$COMPILER" inspect-v1 "$FIXTURE" > "$WORK_ROOT/inspect.txt"
/usr/bin/grep -Fq $'compilerV1\tversion=1' "$WORK_ROOT/inspect.txt" \
    || fail "V1 inspection omitted the compiler identity"
/usr/bin/grep -Eq $'^compilerV1Delta\tphase=source\tidentity=[0-9]+:[0-9]+\tbefore=0:0\tafter=[0-9]+:[0-9]+\tvalue=File\tpath=.+\tbytes=[1-9][0-9]*$' "$WORK_ROOT/inspect.txt" \
    || fail "V1 inspection omitted the loaded Identity : FileValue Delta"

/bin/cp "$FIXTURE" "$WORK_ROOT/IdentityValue.range"
"$COMPILER" inspect-v1 "$WORK_ROOT/IdentityValue.range" > "$WORK_ROOT/identity-before.txt"
/usr/bin/printf '\n' >> "$WORK_ROOT/IdentityValue.range"
"$COMPILER" inspect-v1 "$WORK_ROOT/IdentityValue.range" > "$WORK_ROOT/identity-after.txt"
before_identity="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=source[[:space:]]identity=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/identity-before.txt")"
after_identity="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=source[[:space:]]identity=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/identity-after.txt")"
before_value="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=source.*[[:space:]]after=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/identity-before.txt")"
after_value="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=source.*[[:space:]]after=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/identity-after.txt")"
before_bytes="$(/usr/bin/sed -n 's/^compilerV1Delta.*bytes=\([0-9][0-9]*\)$/\1/p' "$WORK_ROOT/identity-before.txt")"
after_bytes="$(/usr/bin/sed -n 's/^compilerV1Delta.*bytes=\([0-9][0-9]*\)$/\1/p' "$WORK_ROOT/identity-after.txt")"
[[ -n "$before_identity" && "$before_identity" == "$after_identity" ]] \
    || fail "V1 File identity changed when only its value changed"
[[ -n "$before_value" && -n "$after_value" && "$before_value" != "$after_value" ]] \
    || fail "V1 File Delta did not change its value fingerprint"
[[ -n "$before_bytes" && -n "$after_bytes" && "$before_bytes" -ne "$after_bytes" ]] \
    || fail "V1 File value did not change with its source contents"
/usr/bin/grep -Eq $'^compilerV1Delta\tphase=shape\tidentity=[0-9]+:[0-9]+\tbefore=0:0\tafter=[0-9]+:[0-9]+$' "$WORK_ROOT/inspect.txt" \
    || fail "V1 inspection omitted the Shape Delta"
/usr/bin/grep -Fq $'typedSyntax\tvalid=true' "$WORK_ROOT/inspect.txt" \
    || fail "V1 shape artifact is not valid typed syntax"
/usr/bin/grep -Eq $'^compilerV1Delta\tphase=behavior\tidentity=[0-9]+:[0-9]+\tinput=[0-9]+:[0-9]+\tbefore=0:0\tafter=[0-9]+:[0-9]+$' "$WORK_ROOT/inspect.txt" \
    || fail "V1 inspection omitted the Behavior Delta"
shape_output="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=shape.*[[:space:]]after=\([^[:space:]]*\)$/\1/p' "$WORK_ROOT/inspect.txt")"
behavior_input="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=behavior.*[[:space:]]input=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/inspect.txt")"
behavior_output="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=behavior.*[[:space:]]after=\([^[:space:]]*\)$/\1/p' "$WORK_ROOT/inspect.txt")"
[[ -n "$shape_output" && "$shape_output" == "$behavior_input" ]] \
    || fail "V1 Behavior Delta does not consume the Shape value fingerprint"
/usr/bin/grep -Eq $'^compilerV1Behavior\tvalid=true\tproduct=[0-9]+:[0-9]+$' "$WORK_ROOT/inspect.txt" \
    || fail "V1 behavior artifact is not tied to successful reachable lowering"
/usr/bin/grep -Eq $'^compilerV1Delta\tphase=compile\tidentity=[0-9]+:[0-9]+\tinput=[0-9]+:[0-9]+\tbefore=0:0\tafter=[0-9]+:[0-9]+$' "$WORK_ROOT/inspect.txt" \
    || fail "V1 inspection omitted the Compiled Delta"
compile_input="$(/usr/bin/sed -n 's/^compilerV1Delta[[:space:]]phase=compile.*[[:space:]]input=\([^[:space:]]*\).*$/\1/p' "$WORK_ROOT/inspect.txt")"
[[ -n "$behavior_output" && "$behavior_output" == "$compile_input" ]] \
    || fail "V1 Compiled Delta does not consume the Behavior value fingerprint"

runtime_inputs=()
runtime_count="$(/usr/bin/plutil -extract runtimeSources raw -o - "$MANIFEST")"
for ((index = 0; index < runtime_count; index += 1)); do
    runtime_relative="$(/usr/bin/plutil -extract "runtimeSources.$index.path" raw -o - "$MANIFEST")"
    runtime_inputs+=("$REPO_ROOT/$runtime_relative")
done
clang -O0 -fno-lto -Wno-override-module \
    "$WORK_ROOT/v1.ll" "${runtime_inputs[@]}" -o "$WORK_ROOT/program"
actual_status=0
"$WORK_ROOT/program" || actual_status=$?
[[ "$actual_status" -eq 7 ]] \
    || fail "V1-linked ordinary program exited $actual_status instead of 7"

clang -O0 -fno-lto -Wno-override-module \
    "$WORK_ROOT/persistent.ll" "${runtime_inputs[@]}" -o "$WORK_ROOT/persistent-program"
persistent_status=0
"$WORK_ROOT/persistent-program" || persistent_status=$?
[[ "$persistent_status" -eq 8 ]] \
    || fail "updated persistent execution exited $persistent_status instead of 8"

missing_status=0
"$COMPILER" compile-v1 "$WORK_ROOT/Missing.range" > "$WORK_ROOT/missing.out" \
    || missing_status=$?
[[ "$missing_status" -eq 65 ]] \
    || fail "V1 missing-input control exited $missing_status instead of 65"
/usr/bin/grep -Fq 'range: unable to read non-empty input at' "$WORK_ROOT/missing.out" \
    || fail "V1 missing-input control omitted its typed error message"

echo "Compiler V1: pass (persistent Range-owned execution, cold insert, unchanged LLVM reuse, failed-candidate isolation, exact prior phase values on update, File-identity rejection, malformed-cache repair, linked exits 7/8)"
