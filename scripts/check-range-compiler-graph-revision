#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
FIXTURE="$REPO_ROOT/Testing/Basics/Pass/ReturnInteger.range"
WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-compiler-graph-revision.XXXXXX")"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

fail() {
    echo "Range compiler graph revision check failed: $*" >&2
    exit 1
}

header_value() {
    local file="$1"
    local key="$2"
    /usr/bin/awk -F '\t' -v key="$key" '
        NR == 1 {
            for (field = 2; field <= NF; field += 1) {
                if (index($field, key "=") == 1) {
                    value = $field
                    sub(/^[^=]*=/, "", value)
                    print value
                    exit
                }
            }
        }
    ' "$file"
}

node_value() {
    local file="$1"
    local id="$2"
    local key="$3"
    /usr/bin/awk -F '\t' -v id="$id" -v key="$key" '
        $1 == "rangeRevisionNode" && $2 == "id=" id {
            for (field = 3; field <= NF; field += 1) {
                if (index($field, key "=") == 1) {
                    value = $field
                    sub(/^[^=]*=/, "", value)
                    print value
                    exit
                }
            }
        }
    ' "$file"
}

field_value() {
    local file="$1"
    local key="$2"
    /usr/bin/awk -F '\t' -v key="$key" '
        {
            for (field = 2; field <= NF; field += 1) {
                if (index($field, key "=") == 1) {
                    value = $field
                    sub(/^[^=]*=/, "", value)
                    print value
                    exit
                }
            }
        }
    ' "$file"
}

revision_identity() {
    header_value "$1" identity
}

revision_parent() {
    header_value "$1" parent
}

compile_graph() {
    local cache="$1"
    local input="$2"
    local stdout="$3"
    local stderr="$4"
    local status=0
    RANGE_GRAPH_CACHE_DIR="$cache" \
        "$REPO_ROOT/scripts/range" compile-graph "$input" > "$stdout" 2> "$stderr" || status=$?
    return "$status"
}

find_revision() {
    /usr/bin/find "$1" -type f -name revision.tsv -print -quit
}

node_changed_count() {
    /usr/bin/awk -F '\t' '$1 == "rangeRevisionNode" && $5 == "changed=1" { count += 1 } END { print count + 0 }' "$1"
}

[[ -f "$FIXTURE" ]] || fail "missing graph revision fixture"

cold_cache="$WORK_ROOT/cold-a"
compile_graph "$cold_cache" "$FIXTURE" "$WORK_ROOT/cold-a.ll" "$WORK_ROOT/cold-a.out"
/usr/bin/grep -Fq $'compilerV1Execution\tstatus=cold\tchanged=1\t' "$WORK_ROOT/cold-a.out" \
    || fail "cold graph execution did not insert a revision"
cold_revision="$(find_revision "$cold_cache")"
[[ -n "$cold_revision" && -f "$cold_revision" ]] || fail "cold graph execution omitted its revision artifact"

cold_identity="$(revision_identity "$cold_revision")"
[[ "$cold_identity" =~ ^[0-9a-f]{64}$ ]] || fail "cold revision identity is not a 64-character hash: $cold_identity"
[[ "$(header_value "$cold_revision" version)" == "3" ]] \
    || fail "cold revision does not use the transient-execution schema"
[[ "$(header_value "$cold_revision" file)" =~ ^[0-9]+:[0-9]+$ ]] \
    || fail "cold revision omitted the accepted File fingerprint"
[[ "$(revision_parent "$cold_revision")" == "absent" ]] \
    || fail "cold revision parent is not absent"
[[ "$(header_value "$cold_revision" status)" == "accepted" ]] \
    || fail "cold revision phase status is not accepted"
[[ "$(header_value "$cold_revision" sourceProfile)" == "project" ]] \
    || fail "cold revision source profile is not project"
fixture_identity="$(cd "$(dirname "$FIXTURE")" && pwd)/$(basename "$FIXTURE")"
[[ "$(header_value "$cold_revision" input)" == "$fixture_identity" ]] \
    || fail "cold revision does not own the canonical Source input identity"
graph_compiler="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler"
graph_compiler_hash="$(/usr/bin/shasum -a 256 "$graph_compiler" | /usr/bin/awk '{print $1}')"
[[ "$(header_value "$cold_revision" compiler)" == "$graph_compiler_hash" ]] \
    || fail "cold revision does not own the Source compiler provenance"
[[ "$(node_value "$cold_revision" source before)" == "0:0" ]] \
    || fail "cold source node did not begin from an absent value"
[[ "$(node_changed_count "$cold_revision")" -eq 4 ]] \
    || fail "cold revision did not mark every node changed"
[[ "$(/usr/bin/grep -c $'^rangeRevisionNode\t' "$cold_revision")" -eq 4 ]] \
    || fail "cold revision node index count is not 4"
[[ "$(/usr/bin/grep -c $'^rangeRevisionEdge\t' "$cold_revision")" -eq 3 ]] \
    || fail "cold revision edge-delta stream count is not 3"
[[ "$(/usr/bin/grep -c $'^rangeRevisionDigest\t' "$cold_revision")" -eq 4 ]] \
    || fail "cold revision view digest count is not 4"
[[ "$(/usr/bin/grep -Fc $'\tcardinality=one\toperation=add' "$cold_revision")" -eq 3 ]] \
    || fail "cold revision pipeline edges are not all add operations"

cold_source_bundle="$(/usr/bin/find "$cold_cache" -type f -name ProjectSourceSet.range -print -quit)"
cold_compiled="$WORK_ROOT/cold-a.ll"
cold_source_digest="$(/usr/bin/shasum -a 256 "$cold_source_bundle" | /usr/bin/awk '{print $1}')"
cold_compiled_digest="$(/usr/bin/shasum -a 256 "$cold_compiled" | /usr/bin/awk '{print $1}')"
[[ "$(header_value "$cold_revision" source)" == "$cold_source_digest" ]] \
    || fail "cold revision source digest does not match the persisted Source artifact"
[[ "$(/usr/bin/sed -n 's/^rangeRevisionDigest\tview=source\tdigest=\([0-9a-f]*\)$/\1/p' "$cold_revision")" == "$cold_source_digest" ]] \
    || fail "cold revision source view digest disagrees with the persisted Source artifact"
[[ -z "$(/usr/bin/find "$cold_cache" -type f -name source.tsv -print -quit)" ]] \
    || fail "cold graph cache retained the superseded source.tsv authority"
[[ -z "$(/usr/bin/find "$cold_cache" -type f -name execution.tsv -print -quit)" ]] \
    || fail "cold graph cache persisted transient execution state"

# Every phase of a cold generation derives a new value, so the revision reports
# all four nodes derived and a full four-view invalidation frontier.
/usr/bin/grep -Fq $'rangeGraphMetrics\t' "$WORK_ROOT/cold-a.out" \
    || fail "cold graph execution omitted its stage metrics report"
for metric in loadMs reducerMs queryMs materializeMs sourceMs; do
    [[ "$(field_value "$WORK_ROOT/cold-a.out" "$metric")" =~ ^[0-9]+$ ]] \
        || fail "cold graph metrics omitted the $metric cost"
done
[[ "$(field_value "$WORK_ROOT/cold-a.out" viewsAffected)" == "4" ]] \
    || fail "cold graph execution did not report a full invalidation frontier"
[[ "$(field_value "$WORK_ROOT/cold-a.out" sourceArtifact)" == "0" ]] \
    || fail "cold graph execution did not report a derived Source artifact"
for node in source shape behavior compile; do
    [[ "$(field_value "$WORK_ROOT/cold-a.out" "$node")" == "derived" ]] \
        || fail "cold graph execution did not report a derived $node phase"
done

# A repeated cold run over the same input and location must reproduce the same
# revision artifact. The V1 File identity derives from the source bundle path,
# so the revision record is deterministic per location; content-addressed node
# identity is a later Range-owned cutover and remains documented as such.
/bin/cp "$cold_revision" "$WORK_ROOT/cold-a.revision.tsv"
/bin/rm -rf "$cold_cache"
compile_graph "$cold_cache" "$FIXTURE" "$WORK_ROOT/cold-a-rederived.ll" "$WORK_ROOT/cold-a-rederived.out"
rederived_revision="$(find_revision "$cold_cache")"
[[ -n "$rederived_revision" && -f "$rederived_revision" ]] \
    || fail "rederived cold graph execution omitted its revision artifact"
/usr/bin/cmp -s "$WORK_ROOT/cold-a.revision.tsv" "$rederived_revision" \
    || fail "repeated cold run changed the revision artifact"
cold_revision="$rederived_revision"

# A v2 cache migrates through its legacy execution record once. The accepted
# phase values and File fingerprint move into v3, and the parallel record is
# removed after the successful reuse.
legacy_execution="$(dirname "$cold_revision")/execution.tsv"
legacy_file="$(header_value "$cold_revision" file)"
legacy_source="$(node_value "$cold_revision" source after)"
legacy_shape="$(node_value "$cold_revision" shape after)"
legacy_behavior="$(node_value "$cold_revision" behavior after)"
legacy_compiled="$(node_value "$cold_revision" compile after)"
/usr/bin/printf 'compilerV1Execution\tversion=1\tfileFirst=%s\tfileSecond=%s\tsourceFirst=%s\tsourceSecond=%s\tshapeFirst=%s\tshapeSecond=%s\tbehaviorFirst=%s\tbehaviorSecond=%s\tcompiledFirst=%s\tcompiledSecond=%s\n' \
    "${legacy_file%%:*}" "${legacy_file#*:}" \
    "${legacy_source%%:*}" "${legacy_source#*:}" \
    "${legacy_shape%%:*}" "${legacy_shape#*:}" \
    "${legacy_behavior%%:*}" "${legacy_behavior#*:}" \
    "${legacy_compiled%%:*}" "${legacy_compiled#*:}" > "$legacy_execution"
/usr/bin/perl -0pi -e 's/rangeRevision\tversion=3/rangeRevision\tversion=2/; s/\tfile=[^\t]*//' "$cold_revision"
compile_graph "$cold_cache" "$FIXTURE" "$WORK_ROOT/cold-a-migrated.ll" "$WORK_ROOT/cold-a-migrated.out"
/usr/bin/grep -Fq $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/cold-a-migrated.out" \
    || fail "legacy graph cache migration did not reuse its accepted artifact"
[[ "$(field_value "$WORK_ROOT/cold-a-migrated.out" executionSource)" == "legacy" ]] \
    || fail "legacy graph cache migration did not consume execution.tsv"
[[ "$(header_value "$cold_revision" version)" == "3" ]] \
    || fail "legacy graph cache migration did not write revision schema v3"
[[ "$(header_value "$cold_revision" file)" == "$legacy_file" ]] \
    || fail "legacy graph cache migration lost the accepted File fingerprint"
[[ ! -e "$legacy_execution" ]] \
    || fail "legacy graph cache migration retained execution.tsv"

source_bundle_path="$(/usr/bin/find "$cold_cache" -type f -name ProjectSourceSet.range -print -quit)"
revision_inode="$(/usr/bin/stat -f %i "$cold_revision")"
source_bundle_inode="$(/usr/bin/stat -f %i "$source_bundle_path")"

# Unchanged input must reuse the accepted artifact without rewriting the
# revision record.
compile_graph "$cold_cache" "$FIXTURE" "$WORK_ROOT/cold-a-warm.ll" "$WORK_ROOT/cold-a-warm.out"
/usr/bin/grep -Fq $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/cold-a-warm.out" \
    || fail "unchanged graph execution did not reuse its accepted artifact"
/usr/bin/cmp -s "$cold_revision" "$(find_revision "$cold_cache")" \
    || fail "unchanged graph execution rewrote its revision artifact"

# The warm run consumes the persisted Source artifact and every phase leaves
# the accepted value untouched: zero invalidation, no re-derived source, and
# no rewrite of the persisted Source artifact.
[[ "$(field_value "$WORK_ROOT/cold-a-warm.out" viewsAffected)" == "0" ]] \
    || fail "warm graph execution reported a non-empty invalidation frontier"
[[ "$(field_value "$WORK_ROOT/cold-a-warm.out" sourceArtifact)" == "1" ]] \
    || fail "warm graph execution did not consume the persisted Source artifact"
for node in source shape behavior compile; do
    [[ "$(field_value "$WORK_ROOT/cold-a-warm.out" "$node")" == "consumed" ]] \
        || fail "warm graph execution did not report a consumed $node phase"
done
[[ "$(field_value "$WORK_ROOT/cold-a-warm.out" transientBytes)" -gt 0 ]] \
    || fail "warm graph execution did not materialize transient execution state"
[[ "$(field_value "$WORK_ROOT/cold-a-warm.out" executionSource)" == "revision" ]] \
    || fail "warm graph execution did not derive transient state from the revision"
[[ "$(field_value "$WORK_ROOT/cold-a-warm.out" revisionBytes)" -gt 0 ]] \
    || fail "warm graph execution did not load its persisted revision record"
[[ "$revision_inode" == "$(/usr/bin/stat -f %i "$(find_revision "$cold_cache")")" ]] \
    || fail "warm graph execution rewrote the revision-owned Source metadata"
[[ "$source_bundle_inode" == "$(/usr/bin/stat -f %i "$(find "$cold_cache" -name ProjectSourceSet.range -print -quit)")" ]] \
    || fail "warm graph execution rewrote the persisted Source bundle"
[[ -z "$(/usr/bin/find "$cold_cache" -type f -name source.tsv -print -quit)" ]] \
    || fail "warm graph execution recreated source.tsv"
[[ -z "$(/usr/bin/find "$cold_cache" -type f -name execution.tsv -print -quit)" ]] \
    || fail "warm graph execution persisted transient execution state"

# The revision's shape value is a faithful projection of the persisted Source
# artifact: an independent V1 derivation over the same bundle must reproduce
# the exact shape node value, and that shape product contains no LLVM.
compiler="$REPO_ROOT/RangeCompiler/Sources/Compiler/.range/Build/candidate/RangeCompiler"
[[ -x "$compiler" ]] || fail "candidate graph compiler is not executable"
"$compiler" inspect-v1 "$source_bundle_path" > "$WORK_ROOT/inspect.out"
shape_delta_after="$(/usr/bin/sed -n 's/^compilerV1Delta\tphase=shape\t.*\tafter=\([0-9]*:[0-9]*\)$/\1/p' "$WORK_ROOT/inspect.out" | /usr/bin/head -1)"
[[ -n "$shape_delta_after" ]] || fail "inspect-v1 omitted the shape delta over the persisted Source artifact"
[[ "$shape_delta_after" == "$(node_value "$cold_revision" shape after)" ]] \
    || fail "revision shape value disagrees with the V1 shape projection over the persisted Source artifact"
if /usr/bin/sed -n '/phase=shape/,/phase=behavior/p' "$WORK_ROOT/inspect.out" \
    | /usr/bin/grep -Ev '^compilerV1Delta\tphase=(shape|behavior)' \
    | /usr/bin/grep -Eq '^(define |declare |target triple|@)'; then
    fail "shape projection over the persisted Source artifact leaked LLVM"
fi

# The shape reducer emits only the shape delta it owns: a compile-shape pass
# over the persisted Source artifact reproduces the exact shape node value and
# byte-identical snapshot without any behavior or compiled product.
"$compiler" compile-shape "$source_bundle_path" > "$WORK_ROOT/shape-only.out"
/usr/bin/grep -Eq $'^compilerV1Shape\tversion=1\tidentity=[0-9]+:[0-9]+\tbefore=0:0\tafter=[0-9]+:[0-9]+$' "$WORK_ROOT/shape-only.out" \
    || fail "shape reducer omitted its versioned delta header"
[[ "$(/usr/bin/sed -n 's/^compilerV1Shape\tversion=1\t.*\tafter=\([0-9]*:[0-9]*\)$/\1/p' "$WORK_ROOT/shape-only.out")" == "$(node_value "$cold_revision" shape after)" ]] \
    || fail "shape reducer value disagrees with the revision shape node"
/usr/bin/tail -n +2 "$WORK_ROOT/shape-only.out" > "$WORK_ROOT/shape-only.payload"
/usr/bin/sed -n '/phase=shape/,/phase=behavior/p' "$WORK_ROOT/inspect.out" \
    | /usr/bin/grep -Ev '^compilerV1Delta\tphase=(shape|behavior)' > "$WORK_ROOT/inspect.shape"
/usr/bin/cmp -s "$WORK_ROOT/shape-only.payload" "$WORK_ROOT/inspect.shape" \
    || fail "shape reducer snapshot differs from the full pipeline shape projection"
if /usr/bin/grep -Eq '^(define |declare |target triple|@)' "$WORK_ROOT/shape-only.out"; then
    fail "shape reducer leaked a compiled or behavior product"
fi
if /usr/bin/grep -Fq $'phase=behavior' "$WORK_ROOT/shape-only.out" \
    || /usr/bin/grep -Fq $'phase=compile' "$WORK_ROOT/shape-only.out"; then
    fail "shape reducer emitted a downstream phase delta"
fi

# A literal-value edit changes source, behavior, and compile products while
# leaving the shape product reusable: the revision records the bounded
# invalidation frontier rather than rewriting every node.
project="$WORK_ROOT/project"
/bin/mkdir -p "$project"
/bin/cp "$FIXTURE" "$project/ReturnInteger.range"
project_cache="$WORK_ROOT/project-cache"
compile_graph "$project_cache" "$project" "$WORK_ROOT/project-cold.ll" "$WORK_ROOT/project-cold.out"
project_cold_revision="$(find_revision "$project_cache")"
[[ -n "$project_cold_revision" && -f "$project_cold_revision" ]] \
    || fail "project cold graph execution omitted its revision artifact"
project_cold_identity="$(revision_identity "$project_cold_revision")"
/bin/cp "$project_cold_revision" "$WORK_ROOT/revision.project-cold.tsv"
project_cold_revision="$WORK_ROOT/revision.project-cold.tsv"

/usr/bin/perl -0pi -e 's/return 7/return 8/' "$project/ReturnInteger.range"
compile_graph "$project_cache" "$project" "$WORK_ROOT/project-updated.ll" "$WORK_ROOT/project-updated.out"
/usr/bin/grep -Fq $'compilerV1Execution\tstatus=updated\tchanged=1\t' "$WORK_ROOT/project-updated.out" \
    || fail "edited graph execution did not produce a replacement generation"
project_updated_revision="$(find_revision "$project_cache")"
[[ "$(revision_identity "$project_updated_revision")" == "$project_cold_identity" ]] \
    && fail "edited graph execution reused the prior revision identity"
[[ "$(revision_parent "$project_updated_revision")" == "$project_cold_identity" ]] \
    || fail "updated revision parent is not the prior accepted revision"
for node in source shape behavior compile; do
    before="$(node_value "$project_updated_revision" "$node" before)"
    cold_after="$(node_value "$project_cold_revision" "$node" after)"
    [[ "$before" == "$cold_after" ]] \
        || fail "updated $node before value does not chain to the prior accepted after value"
done
[[ "$(node_value "$project_updated_revision" shape changed)" == "0" ]] \
    || fail "literal-value edit invalidated the reusable shape node"
[[ "$(node_changed_count "$project_updated_revision")" -eq 3 ]] \
    || fail "literal-value edit produced an unexpected affected-view count"
/usr/bin/cmp -s "$WORK_ROOT/project-cold.ll" "$WORK_ROOT/project-updated.ll" \
    && fail "edited graph execution retained the stale compiled artifact"

# On the literal edit the source stage derives a new value, the behavior and
# compile stages derive new values, and the shape stage alone consumes the
# persisted revision: its value is unchanged and no shape delta is emitted.
[[ "$(field_value "$WORK_ROOT/project-updated.out" viewsAffected)" == "3" ]] \
    || fail "edited graph execution reported an unexpected affected-view count"
[[ "$(field_value "$WORK_ROOT/project-updated.out" source)" == "derived" ]] \
    || fail "edited graph execution did not derive the source phase"
[[ "$(field_value "$WORK_ROOT/project-updated.out" shape)" == "consumed" ]] \
    || fail "edited graph execution did not consume the persisted shape value"
[[ "$(field_value "$WORK_ROOT/project-updated.out" behavior)" == "derived" ]] \
    || fail "edited graph execution did not derive the behavior phase"
[[ "$(field_value "$WORK_ROOT/project-updated.out" compile)" == "derived" ]] \
    || fail "edited graph execution did not derive the compile phase"

# A failed candidate must preserve the last accepted revision.
/usr/bin/perl -0pi -e 's/return 8/return missingValue/' "$project/ReturnInteger.range"
/bin/cp "$project_updated_revision" "$WORK_ROOT/revision.last-known-good.tsv"
fail_status=0
compile_graph "$project_cache" "$project" "$WORK_ROOT/project-failed.ll" "$WORK_ROOT/project-failed.out" \
    || fail_status=$?
[[ "$fail_status" -eq 65 ]] \
    || fail "failed graph candidate exited $fail_status instead of 65"
/usr/bin/grep -Fq $'compilerError\t' "$WORK_ROOT/project-failed.out" \
    || fail "failed graph candidate omitted its typed compiler error"
/usr/bin/cmp -s "$project_updated_revision" "$WORK_ROOT/revision.last-known-good.tsv" \
    || fail "failed graph candidate damaged the last accepted revision"

# Recovery to the last-known-good input must reuse the accepted artifact.
/usr/bin/perl -0pi -e 's/return missingValue/return 8/' "$project/ReturnInteger.range"
compile_graph "$project_cache" "$project" "$WORK_ROOT/project-recovered.ll" "$WORK_ROOT/project-recovered.out"
/usr/bin/grep -Fq $'compilerV1Execution\tstatus=reused\tchanged=0' "$WORK_ROOT/project-recovered.out" \
    || fail "recovered graph execution did not restore the accepted artifact"
/usr/bin/cmp -s "$project_updated_revision" "$(find_revision "$project_cache")" \
    || fail "recovered graph execution rewrote the accepted revision"
[[ "$(field_value "$WORK_ROOT/project-recovered.out" viewsAffected)" == "0" ]] \
    || fail "recovered graph execution reported a non-empty invalidation frontier"
for node in source shape behavior compile; do
    [[ "$(field_value "$WORK_ROOT/project-recovered.out" "$node")" == "consumed" ]] \
        || fail "recovered graph execution did not consume the persisted $node phase"
done
[[ -z "$(/usr/bin/find "$project_cache" -type f -name execution.tsv -print -quit)" ]] \
    || fail "graph revision lifecycle persisted transient execution state"

affected_views="$(node_changed_count "$project_updated_revision")"
echo "Range compiler graph revision: pass (revision-owned Source and execution provenance, transient resume state, deterministic revision identity, parent chaining, node/edge/digest record, cold/warm reuse, measured stage costs, Shape consumes the persisted Source artifact, shape-only reducer parity, bounded literal-edit invalidation with $affected_views affected views, failed-candidate last-known-good preservation, recovery)"
