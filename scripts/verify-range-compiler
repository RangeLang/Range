#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerBootstrap.json"

mode="${1:-}"
if [[ $# -gt 1 || ( -n "$mode" && "$mode" != "--integrity-only" ) ]]; then
    echo "Usage: scripts/verify-range-compiler [--integrity-only]" >&2
    exit 64
fi

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

sha256() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

verify_file() {
    local key="$1"
    local path expected actual
    path="$(manifest_value "$key.path")"
    expected="$(manifest_value "$key.sha256")"
    if [[ ! -f "$REPO_ROOT/$path" ]]; then
        echo "Missing bootstrap input: $path" >&2
        exit 1
    fi
    actual="$(sha256 "$REPO_ROOT/$path")"
    if [[ "$actual" != "$expected" ]]; then
        echo "Bootstrap input hash mismatch: $path" >&2
        echo "expected $expected" >&2
        echo "actual   $actual" >&2
        exit 1
    fi
}

if [[ "$(manifest_value formatVersion)" != "1" ]]; then
    echo "Unsupported Range compiler bootstrap manifest." >&2
    exit 1
fi
if [[ "$(manifest_value compiler.name)" != "range"
    || "$(manifest_value compiler.channel)" != "latest"
    || -z "$(manifest_value compiler.version)" ]]; then
    echo "Invalid Range compiler identity." >&2
    exit 1
fi

if [[ "$(uname -m)" != "$(manifest_value target.architecture)" ]]; then
    echo "Bootstrap target architecture mismatch." >&2
    exit 1
fi

verify_file bootstrap
verify_file executable
compiler_source_count="$(manifest_value compilerSources)"
for ((index = 0; index < compiler_source_count; index += 1)); do
    verify_file "compilerSources.$index"
done
runtime_source_count="$(manifest_value runtimeSources)"
for ((index = 0; index < runtime_source_count; index += 1)); do
    verify_file "runtimeSources.$index"
done

bootstrap_relative="$(manifest_value bootstrap.path)"
bootstrap="$REPO_ROOT/$bootstrap_relative"
bootstrap_bytes="$(/usr/bin/stat -f %z "$bootstrap")"
if [[ "$bootstrap_bytes" != "$(manifest_value bootstrap.bytes)" ]]; then
    echo "Bootstrap byte length mismatch: $bootstrap_relative" >&2
    exit 1
fi
executable_relative="$(manifest_value executable.path)"
accepted_executable="$REPO_ROOT/$executable_relative"
executable_bytes="$(/usr/bin/stat -f %z "$accepted_executable")"
if [[ "$executable_bytes" != "$(manifest_value executable.bytes)" || ! -x "$accepted_executable" ]]; then
    echo "Accepted compiler executable is invalid: $executable_relative" >&2
    exit 1
fi

if [[ "$mode" == "--integrity-only" ]]; then
    echo "Range compiler accepted-bootstrap integrity verified."
    echo "sha256=$(sha256 "$bootstrap")"
    echo "bytes=$bootstrap_bytes"
    echo "executable=$executable_relative"
    echo "executable_sha256=$(sha256 "$accepted_executable")"
    echo "executable_bytes=$executable_bytes"
    exit 0
fi

build_root="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-bootstrap-verify.XXXXXX")"
trap '/bin/rm -rf "$build_root"' EXIT
bundle="$build_root/RangeCompilerSourceSet.range"
reproduction="$build_root/RangeCompilerReproduction.ll"

/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$bundle"
for ((index = 0; index < compiler_source_count; index += 1)); do
    source_relative="$(manifest_value "compilerSources.$index.path")"
    source_role="$(manifest_value "compilerSources.$index.role")"
    source_path="$REPO_ROOT/$source_relative"
    source_marker_path="${source_relative#RangeCompiler/Sources/Compiler/}"
    if [[ "$source_role" == "core" ]]; then source_marker_path="$source_relative"; fi
    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$source_role" "$source_marker_path" >> "$bundle"
    /bin/cat "$source_path" >> "$bundle"
    if [[ -n "$(/usr/bin/tail -c 1 "$source_path")" ]]; then
        /usr/bin/printf '\n' >> "$bundle"
    fi
done

"$accepted_executable" "$bundle" > "$reproduction"

if ! /usr/bin/cmp -s "$bootstrap" "$reproduction"; then
    echo "Bootstrap fixed-point verification failed: reproduction LLVM differs." >&2
    /usr/bin/cmp -l "$bootstrap" "$reproduction" | /usr/bin/head -1 >&2 || true
    exit 1
fi

reproduction_hash="$(sha256 "$reproduction")"
reproduction_bytes="$(/usr/bin/stat -f %z "$reproduction")"
if [[ "$reproduction_hash" != "$(manifest_value reproductionLLVM.sha256)"
    || "$reproduction_bytes" != "$(manifest_value reproductionLLVM.bytes)" ]]; then
    echo "Verified reproduction does not match its manifest result." >&2
    exit 1
fi

echo "Range compiler bootstrap verified."
echo "sha256=$reproduction_hash"
echo "bytes=$reproduction_bytes"
echo "producer_clang=$(manifest_value producer.clang)"
echo "compiler_executable_sha256=$(sha256 "$accepted_executable")"
