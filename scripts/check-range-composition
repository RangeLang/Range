#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerBootstrap.json"
COMPOSITION="$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Program/Composition.range"
COMPOSITION_INDEX="$REPO_ROOT/RangeCompiler/Sources/Compiler/Graph/CompilerCompositionExactIndex.range"
RAW_BUFFER="$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
BUFFER="$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range"
RANGE_PROGRAM="$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Program/RangeProgram.range"
FIXTURE="$REPO_ROOT/Testing/Composition/Pass/OrderedIdentityComposition.range"
INDEX_FIXTURE="$REPO_ROOT/Testing/Composition/Pass/ExactSequenceIndex.range"
WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-composition.XXXXXX")"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

fail() {
    echo "Range Composition check failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

append_source() {
    local bundle="$1"
    local role="$2"
    local relative="$3"
    local source="$4"

    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$relative" >> "$bundle"
    /bin/cat "$source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
}

[[ -f "$MANIFEST" ]] || fail "missing accepted compiler manifest"
for source in "$COMPOSITION" "$COMPOSITION_INDEX" "$RAW_BUFFER" "$BUFFER" "$RANGE_PROGRAM" "$FIXTURE" "$INDEX_FIXTURE"; do
    [[ -f "$source" ]] || fail "missing source: ${source#"$REPO_ROOT/"}"
done
/usr/bin/grep -Fq 'let compositions: Array<Composition>' "$RANGE_PROGRAM" \
    || fail "RangeGraphTopology does not expose its Composition compatibility view"

compiler="$REPO_ROOT/$(manifest_value executable.path)"
[[ -x "$compiler" ]] || fail "missing accepted compiler executable"

bundle="$WORK_ROOT/CompositionSourceSet.range"
llvm="$WORK_ROOT/Composition.ll"
diagnostic="$WORK_ROOT/Composition.err"
executable="$WORK_ROOT/Composition"
/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$bundle"
append_source "$bundle" core RangeCompiler/Sources/Core/Syntax/Program/Composition.range "$COMPOSITION"
append_source "$bundle" project Testing/Composition/Pass/OrderedIdentityComposition.range "$FIXTURE"

compile_status=0
"$compiler" "$bundle" > "$llvm" 2> "$diagnostic" || compile_status=$?
if [[ "$compile_status" -ne 0 || -s "$diagnostic" ]]; then
    [[ ! -s "$llvm" ]] || /bin/cat "$llvm"
    [[ ! -s "$diagnostic" ]] || /bin/cat "$diagnostic" >&2
    fail "accepted compiler rejected ordered identity Composition"
fi
/usr/bin/grep -Fq 'define i32 @main' "$llvm" \
    || fail "Composition fixture omitted native main"

runtimes=()
runtime_count="$(manifest_value runtimeSources)"
for ((index = 0; index < runtime_count; index += 1)); do
    runtime="$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")"
    [[ -f "$runtime" ]] || fail "missing runtime input: ${runtime#"$REPO_ROOT/"}"
    runtimes+=("$runtime")
done

clang -O0 -fno-lto -Wno-override-module "$llvm" "${runtimes[@]}" -o "$executable"
run_status=0
"$executable" || run_status=$?
[[ "$run_status" -eq 7 ]] \
    || fail "ordered identity Composition exited $run_status instead of 7"

index_bundle="$WORK_ROOT/CompilerCompositionExactIndexSourceSet.range"
index_llvm="$WORK_ROOT/CompilerCompositionExactIndex.ll"
index_diagnostic="$WORK_ROOT/CompilerCompositionExactIndex.err"
index_executable="$WORK_ROOT/CompilerCompositionExactIndex"
/usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$index_bundle"
append_source "$index_bundle" core RangeCompiler/Sources/Core/System/Memory/RawBuffer.range "$RAW_BUFFER"
append_source "$index_bundle" core RangeCompiler/Sources/Core/System/Memory/Buffer.range "$BUFFER"
append_source "$index_bundle" core RangeCompiler/Sources/Core/Syntax/Program/Composition.range "$COMPOSITION"
append_source "$index_bundle" project RangeCompiler/Sources/Compiler/Graph/CompilerCompositionExactIndex.range "$COMPOSITION_INDEX"
append_source "$index_bundle" project Testing/Composition/Pass/ExactSequenceIndex.range "$INDEX_FIXTURE"

compile_status=0
"$compiler" "$index_bundle" > "$index_llvm" 2> "$index_diagnostic" || compile_status=$?
if [[ "$compile_status" -ne 0 || -s "$index_diagnostic" ]]; then
    [[ ! -s "$index_llvm" ]] || /bin/cat "$index_llvm"
    [[ ! -s "$index_diagnostic" ]] || /bin/cat "$index_diagnostic" >&2
    fail "accepted compiler rejected exact-sequence Composition index"
fi
/usr/bin/grep -Fq 'define i32 @main' "$index_llvm" \
    || fail "exact-sequence Composition index fixture omitted native main"
clang -O0 -fno-lto -Wno-override-module "$index_llvm" "${runtimes[@]}" -o "$index_executable"
index_run_status=0
"$index_executable" || index_run_status=$?
[[ "$index_run_status" -eq 7 ]] \
    || fail "exact-sequence Composition index exited $index_run_status instead of 7"

echo "Range Composition: pass (ordered identity components, identity-distinct equal structure, recursive anchor composition, exact-sequence order/duplicates/miss/rebuild, linked exits 7)"
