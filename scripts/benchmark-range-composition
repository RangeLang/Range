#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerBootstrap.json"
COMPOSITION="$REPO_ROOT/RangeCompiler/Sources/Core/Syntax/Program/Composition.range"
COMPOSITION_INDEX="$REPO_ROOT/RangeCompiler/Sources/Compiler/Graph/CompilerCompositionExactIndex.range"
RAW_BUFFER="$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/RawBuffer.range"
BUFFER="$REPO_ROOT/RangeCompiler/Sources/Core/System/Memory/Buffer.range"
FIELD_FIXTURE="$REPO_ROOT/Testing/Composition/Pass/RelationshipFieldQueryBenchmark.range"
COMPOSITION_FIXTURE="$REPO_ROOT/Testing/Composition/Pass/CompositionPathQueryBenchmark.range"
GRAPH_QUERY_FIXTURE="$REPO_ROOT/Testing/Composition/Pass/ExactSequenceGraphQueryBenchmark.range"
WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-composition-benchmark.XXXXXX")"
trap '/bin/rm -rf "$WORK_ROOT"' EXIT

fail() {
    echo "Range Composition benchmark failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

append_source() {
    local bundle="$1"
    local role="$2"
    local relative="$3"
    local source="$4"

    /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$relative" >> "$bundle"
    /bin/cat "$source" >> "$bundle"
    /usr/bin/printf '\n' >> "$bundle"
}

compile_fixture() {
    local name="$1"
    local fixture="$2"
    local include_composition="$3"
    local bundle="$WORK_ROOT/$name.range"
    local llvm="$WORK_ROOT/$name.ll"
    local diagnostic="$WORK_ROOT/$name.err"
    local executable="$WORK_ROOT/$name"

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$bundle"
    if [[ "$include_composition" == "1" ]]; then
        append_source "$bundle" core RangeCompiler/Sources/Core/Syntax/Program/Composition.range "$COMPOSITION"
    elif [[ "$include_composition" == "2" ]]; then
        append_source "$bundle" core RangeCompiler/Sources/Core/System/Memory/RawBuffer.range "$RAW_BUFFER"
        append_source "$bundle" core RangeCompiler/Sources/Core/System/Memory/Buffer.range "$BUFFER"
        append_source "$bundle" core RangeCompiler/Sources/Core/Syntax/Program/Composition.range "$COMPOSITION"
        append_source "$bundle" project RangeCompiler/Sources/Compiler/Graph/CompilerCompositionExactIndex.range "$COMPOSITION_INDEX"
    fi
    append_source "$bundle" project "Testing/Composition/Pass/$(basename "$fixture")" "$fixture"

    compile_status=0
    "$compiler" "$bundle" > "$llvm" 2> "$diagnostic" || compile_status=$?
    if [[ "$compile_status" -ne 0 || -s "$diagnostic" ]]; then
        [[ ! -s "$llvm" ]] || /bin/cat "$llvm"
        [[ ! -s "$diagnostic" ]] || /bin/cat "$diagnostic" >&2
        fail "accepted compiler rejected $name"
    fi
    clang -O0 -fno-lto -Wno-override-module "$llvm" "${runtimes[@]}" -o "$executable"
}

measure_once() {
    local executable="$1"
    /usr/bin/python3 -c 'import subprocess, sys, time
start = time.monotonic_ns()
result = subprocess.run([sys.argv[1], "benchmark"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
elapsed = time.monotonic_ns() - start
if result.returncode != 7:
    raise SystemExit(f"{sys.argv[1]} exited {result.returncode} instead of 7")
print(f"{elapsed / 1_000_000_000:.6f}")' "$executable"
}

measure_mode_once() {
    local executable="$1"
    local mode="$2"
    /usr/bin/python3 -c 'import subprocess, sys, time
start = time.monotonic_ns()
result = subprocess.run([sys.argv[1], sys.argv[2]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
elapsed = time.monotonic_ns() - start
if result.returncode != 7:
    raise SystemExit(f"{sys.argv[1]} {sys.argv[2]} exited {result.returncode} instead of 7")
print(f"{elapsed / 1_000_000_000:.6f}")' "$executable" "$mode"
}

median_file() {
    local input="$1"
    /usr/bin/sort -n "$input" | /usr/bin/awk 'NR == 3 { print; exit }'
}

[[ -f "$MANIFEST" ]] || fail "missing accepted compiler manifest"
for source in "$COMPOSITION" "$COMPOSITION_INDEX" "$RAW_BUFFER" "$BUFFER" "$FIELD_FIXTURE" "$COMPOSITION_FIXTURE" "$GRAPH_QUERY_FIXTURE"; do
    [[ -f "$source" ]] || fail "missing source: ${source#"$REPO_ROOT/"}"
done
compiler="$REPO_ROOT/$(manifest_value executable.path)"
[[ -x "$compiler" ]] || fail "missing accepted compiler executable"

runtimes=()
runtime_count="$(manifest_value runtimeSources)"
for ((index = 0; index < runtime_count; index += 1)); do
    runtime="$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")"
    [[ -f "$runtime" ]] || fail "missing runtime input: ${runtime#"$REPO_ROOT/"}"
    runtimes+=("$runtime")
done

compile_fixture relationship-fields "$FIELD_FIXTURE" 0
compile_fixture composition-path "$COMPOSITION_FIXTURE" 1
compile_fixture composition-graph-query "$GRAPH_QUERY_FIXTURE" 2

# Warm both executables before taking five alternating-process medians.
"$WORK_ROOT/relationship-fields" benchmark >/dev/null || [[ "$?" -eq 7 ]]
"$WORK_ROOT/composition-path" benchmark >/dev/null || [[ "$?" -eq 7 ]]
field_times="$WORK_ROOT/relationship-fields.times"
composition_times="$WORK_ROOT/composition-path.times"
: > "$field_times"
: > "$composition_times"
for ((sample = 0; sample < 5; sample += 1)); do
    if ((sample % 2 == 0)); then
        measure_once "$WORK_ROOT/relationship-fields" >> "$field_times"
        measure_once "$WORK_ROOT/composition-path" >> "$composition_times"
    else
        measure_once "$WORK_ROOT/composition-path" >> "$composition_times"
        measure_once "$WORK_ROOT/relationship-fields" >> "$field_times"
    fi
done
field_seconds="$(median_file "$field_times")"
composition_seconds="$(median_file "$composition_times")"
ratio="$(/usr/bin/awk -v composition="$composition_seconds" -v fields="$field_seconds" 'BEGIN { printf "%.3f", composition / fields }')"
classification="$(/usr/bin/awk -v ratio="$ratio" 'BEGIN { if (ratio < 0.95) print "improved"; else if (ratio > 1.05) print "regressed"; else print "equivalent" }')"

echo "Range Composition path access benchmark: $classification"
echo "relationshipFieldsMedianSeconds=$field_seconds"
echo "compositionPathMedianSeconds=$composition_seconds"
echo "compositionToFieldsRatio=$ratio"
echo "iterations=20000000 samples=5 optimization=O0"
echo "scope=unindexed-runtime-query-baseline performance-gate=none"

graph_executable="$WORK_ROOT/composition-graph-query"
"$graph_executable" direct >/dev/null || [[ "$?" -eq 7 ]]
"$graph_executable" composition >/dev/null || [[ "$?" -eq 7 ]]
"$graph_executable" indexed >/dev/null || [[ "$?" -eq 7 ]]
direct_scan_times="$WORK_ROOT/direct-scan.times"
composition_scan_times="$WORK_ROOT/composition-scan.times"
indexed_times="$WORK_ROOT/indexed.times"
: > "$direct_scan_times"
: > "$composition_scan_times"
: > "$indexed_times"
for ((sample = 0; sample < 5; sample += 1)); do
    if ((sample % 2 == 0)); then
        measure_mode_once "$graph_executable" direct >> "$direct_scan_times"
        measure_mode_once "$graph_executable" composition >> "$composition_scan_times"
        measure_mode_once "$graph_executable" indexed >> "$indexed_times"
    else
        measure_mode_once "$graph_executable" indexed >> "$indexed_times"
        measure_mode_once "$graph_executable" composition >> "$composition_scan_times"
        measure_mode_once "$graph_executable" direct >> "$direct_scan_times"
    fi
done
direct_scan_seconds="$(median_file "$direct_scan_times")"
composition_scan_seconds="$(median_file "$composition_scan_times")"
indexed_seconds="$(median_file "$indexed_times")"
indexed_to_direct_ratio="$(/usr/bin/awk -v indexed="$indexed_seconds" -v direct="$direct_scan_seconds" 'BEGIN { printf "%.3f", indexed / direct }')"
indexed_to_composition_scan_ratio="$(/usr/bin/awk -v indexed="$indexed_seconds" -v scan="$composition_scan_seconds" 'BEGIN { printf "%.3f", indexed / scan }')"
graph_classification="$(/usr/bin/awk -v direct="$indexed_to_direct_ratio" -v scan="$indexed_to_composition_scan_ratio" 'BEGIN { if (direct < 0.95 && scan < 0.95) print "improved"; else print "not-improved" }')"

echo "Range Composition exact graph query benchmark: $graph_classification"
echo "directRelationshipScanMedianSeconds=$direct_scan_seconds"
echo "unindexedCompositionScanMedianSeconds=$composition_scan_seconds"
echo "indexedCompositionLookupMedianSeconds=$indexed_seconds"
echo "indexedToDirectScanRatio=$indexed_to_direct_ratio"
echo "indexedToCompositionScanRatio=$indexed_to_composition_scan_ratio"
echo "graphSize=64 lookups=500000 samples=5 optimization=O0"
