#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerSeed.json"

usage() {
    cat >&2 <<'USAGE'
Usage:
  scripts/promote-range-compiler-seed \
    --llvm FIRST_LLVM --reproduced-llvm SECOND_LLVM \
    --executable FIRST_EXECUTABLE --reproduced-executable SECOND_EXECUTABLE

Promotes only byte-identical fixed-point LLVM and executable pairs, then
updates the accepted-seed manifest from the exact current source/runtime set.
USAGE
}

sha256() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

bytes() {
    /usr/bin/stat -f %z "$1"
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

first_llvm=""
second_llvm=""
first_executable=""
second_executable=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --llvm)
            [[ $# -ge 2 ]] || { usage; exit 64; }
            first_llvm="$2"
            shift 2
            ;;
        --reproduced-llvm)
            [[ $# -ge 2 ]] || { usage; exit 64; }
            second_llvm="$2"
            shift 2
            ;;
        --executable)
            [[ $# -ge 2 ]] || { usage; exit 64; }
            first_executable="$2"
            shift 2
            ;;
        --reproduced-executable)
            [[ $# -ge 2 ]] || { usage; exit 64; }
            second_executable="$2"
            shift 2
            ;;
        *)
            usage
            exit 64
            ;;
    esac
done

[[ -f "$first_llvm" && -f "$second_llvm" ]] || {
    echo "Promotion requires both fixed-point LLVM artifacts." >&2
    exit 66
}
[[ -x "$first_executable" && -x "$second_executable" ]] || {
    echo "Promotion requires both fixed-point executables." >&2
    exit 66
}
/usr/bin/cmp -s "$first_llvm" "$second_llvm" || {
    echo "Refusing promotion: LLVM artifacts are not byte-identical." >&2
    exit 65
}
/usr/bin/cmp -s "$first_executable" "$second_executable" || {
    echo "Refusing promotion: executables are not byte-identical." >&2
    exit 65
}

promotion_root="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-seed-promotion.XXXXXX")"
trap '/bin/rm -rf "$promotion_root"' EXIT
next_manifest="$promotion_root/RangeCompilerSeed.json"
next_seed="$promotion_root/RangeCompilerSeed.ll"
next_executable="$promotion_root/range"
/bin/cp "$MANIFEST" "$next_manifest"
/bin/cp "$first_llvm" "$next_seed"
/bin/cp "$first_executable" "$next_executable"
/bin/chmod +x "$next_executable"

seed_hash="$(sha256 "$next_seed")"
seed_bytes="$(bytes "$next_seed")"
executable_hash="$(sha256 "$next_executable")"
executable_bytes="$(bytes "$next_executable")"
compiler_version="bootstrap-${seed_hash:0:12}"

/usr/bin/plutil -replace compiler.version -string "$compiler_version" "$next_manifest"
/usr/bin/plutil -replace seed.bytes -integer "$seed_bytes" "$next_manifest"
/usr/bin/plutil -replace seed.sha256 -string "$seed_hash" "$next_manifest"
/usr/bin/plutil -replace expectedStage3LLVM.bytes -integer "$seed_bytes" "$next_manifest"
/usr/bin/plutil -replace expectedStage3LLVM.sha256 -string "$seed_hash" "$next_manifest"
/usr/bin/plutil -replace executable.bytes -integer "$executable_bytes" "$next_manifest"
/usr/bin/plutil -replace executable.sha256 -string "$executable_hash" "$next_manifest"
/usr/bin/plutil -replace producer.clang -string "$(clang --version | /usr/bin/head -1)" "$next_manifest"

compiler_source_count="$(manifest_value compilerSources)"
for ((source_index = 0; source_index < compiler_source_count; source_index += 1)); do
    source_relative="$(/usr/bin/plutil -extract "compilerSources.$source_index.path" raw -o - "$next_manifest")"
    source_path="$REPO_ROOT/$source_relative"
    [[ -f "$source_path" ]] || {
        echo "Missing compiler source during promotion: $source_relative" >&2
        exit 66
    }
    /usr/bin/plutil -replace "compilerSources.$source_index.sha256" -string "$(sha256 "$source_path")" "$next_manifest"
done

runtime_source_count="$(manifest_value runtimeSources)"
for ((runtime_index = 0; runtime_index < runtime_source_count; runtime_index += 1)); do
    runtime_relative="$(/usr/bin/plutil -extract "runtimeSources.$runtime_index.path" raw -o - "$next_manifest")"
    runtime_path="$REPO_ROOT/$runtime_relative"
    [[ -f "$runtime_path" ]] || {
        echo "Missing runtime source during promotion: $runtime_relative" >&2
        exit 66
    }
    /usr/bin/plutil -replace "runtimeSources.$runtime_index.sha256" -string "$(sha256 "$runtime_path")" "$next_manifest"
done

/usr/bin/plutil -p "$next_manifest" >/dev/null
/bin/mv "$next_seed" "$REPO_ROOT/$(manifest_value seed.path)"
/bin/mv "$next_executable" "$REPO_ROOT/$(manifest_value executable.path)"
/bin/chmod +x "$REPO_ROOT/$(manifest_value executable.path)"
/bin/mv "$next_manifest" "$MANIFEST"

echo "Range compiler seed promoted."
echo "version=$compiler_version"
echo "seed_sha256=$seed_hash"
echo "seed_bytes=$seed_bytes"
echo "executable_sha256=$executable_hash"
echo "executable_bytes=$executable_bytes"
