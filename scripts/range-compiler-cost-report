#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPILER_DIR="$REPO_ROOT/RangeCompiler/Range/Programs/Compiler"
BUNDLE="${TMPDIR:-/tmp}/range-compiler-cost.$$.range"

cleanup() {
    /bin/rm -f "$BUNDLE"
}
trap cleanup EXIT

/usr/bin/printf '%s\n' 'compilerNativeSourceSetCostStats' > "$BUNDLE"
while IFS= read -r source; do
    /usr/bin/printf 'compilerSourceFile\\t%s\n' "$(basename "$source")" >> "$BUNDLE"
    /bin/cat "$source" >> "$BUNDLE"
    if [[ -n "$(/usr/bin/tail -c 1 "$source")" ]]; then
        /usr/bin/printf '\n' >> "$BUNDLE"
    fi
done < <(/usr/bin/find "$COMPILER_DIR" -maxdepth 1 -type f -name '*.range' -print | LC_ALL=C /usr/bin/sort)

RANGE_DRIVER=swift "$REPO_ROOT/scripts/range" run "$COMPILER_DIR" -- "$BUNDLE"
