write_root_value_bundle() {
    local output="$1"
    local kind="$2"

    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/RawBuffer.range' > "$output"
    /bin/cat "$CORE_SOURCE_PATH" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$CORE_SOURCE_PATH")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=project\tpath=RootValue.range' >> "$output"

    case "$kind" in
        opaque-return)
            /bin/cat >> "$output" <<'RANGE'
function makeRootBuffer(): RawBuffer {
    return rawBufferCreate(capacity: 1, stride: 4)
}

@main {
    let buffer: RawBuffer(makeRootBuffer())
    rawBufferAppendInt(buffer: buffer, value: 7)
    let value: Int(rawBufferLoadInt(buffer: buffer, index: 0))
    rawBufferDestroy(buffer: buffer)
    return value
}
RANGE
            ;;
        boundary-forward-direct)
            /bin/cat >> "$output" <<'RANGE'
function forwardRootBuffer(buffer: RawBuffer): RawBuffer {
    return buffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let forwarded: RawBuffer(forwardRootBuffer(buffer: source))
    let value: Int(rawBufferLoadInt(buffer: forwarded, index: 0))
    rawBufferDestroy(buffer: forwarded)
    return value
}
RANGE
            ;;
        boundary-forward-transitive)
            /bin/cat >> "$output" <<'RANGE'
function baseForwardRootBuffer(buffer: RawBuffer): RawBuffer {
    return buffer
}

function forwardRootBufferTransitively(buffer: RawBuffer): RawBuffer {
    let forwarded: RawBuffer(baseForwardRootBuffer(buffer: buffer))
    return forwarded
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let forwarded: RawBuffer(forwardRootBufferTransitively(buffer: source))
    let value: Int(rawBufferLoadInt(buffer: forwarded, index: 0))
    rawBufferDestroy(buffer: forwarded)
    return value
}
RANGE
            ;;
        boundary-forward-two-owned-inputs)
            /bin/cat >> "$output" <<'RANGE'
construct RootBoundaryForwardPair {
    let first: RawBuffer
    let second: RawBuffer
}

function forwardRootBufferPair(first: RawBuffer, second: RawBuffer): RootBoundaryForwardPair {
    return RootBoundaryForwardPair(first: first, second: second)
}

@main {
    let first: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: first, value: 3)
    let second: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: second, value: 4)
    let result: RootBoundaryForwardPair(forwardRootBufferPair(first: first, second: second))
    let firstValue: Int(rawBufferLoadInt(buffer: result.first, index: 0))
    let secondValue: Int(rawBufferLoadInt(buffer: result.second, index: 0))
    rawBufferDestroy(buffer: result.first)
    rawBufferDestroy(buffer: result.second)
    return firstValue + secondValue
}
RANGE
            ;;
        boundary-forward-mixed)
            /bin/cat >> "$output" <<'RANGE'
construct RootBoundaryForwardMixedResult {
    let forwarded: RawBuffer
    binding borrowed: RawBuffer
    let created: RawBuffer
}

function makeRootBoundaryForwardMixedResult(forwardedSource: RawBuffer, borrowedSource: RawBuffer): RootBoundaryForwardMixedResult {
    let created: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: created, value: 3)
    let result: RootBoundaryForwardMixedResult(forwarded: forwardedSource, borrowed: $borrowedSource, created: created)
    return result
}

@main {
    let forwardedSource: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: forwardedSource, value: 2)
    let borrowedSource: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: borrowedSource, value: 2)
    let result: RootBoundaryForwardMixedResult(makeRootBoundaryForwardMixedResult(forwardedSource: forwardedSource, borrowedSource: borrowedSource))
    let forwardedValue: Int(rawBufferLoadInt(buffer: result.forwarded, index: 0))
    let borrowedValue: Int(rawBufferLoadInt(buffer: result.borrowed, index: 0))
    let createdValue: Int(rawBufferLoadInt(buffer: result.created, index: 0))
    rawBufferDestroy(buffer: result.forwarded)
    rawBufferDestroy(buffer: result.created)
    rawBufferDestroy(buffer: borrowedSource)
    return forwardedValue + borrowedValue + createdValue
}
RANGE
            ;;
        direct-holder)
            /bin/cat >> "$output" <<'RANGE'
construct RootDirectHolder {
    let storage: RawBuffer
