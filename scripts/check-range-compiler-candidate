    let view: MixedBufferView(makeMixedBufferView(buffer: source))
    let ownedValue: Int(rawBufferLoadInt(buffer: view.owned, index: 0))
    let borrowedValue: Int(rawBufferLoadInt(buffer: view.borrowed, index: 0))
    rawBufferDestroy(buffer: view.owned)
    rawBufferDestroy(buffer: source)
