#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerSeed.json"
DEFAULT_COMPILER_DIR="$REPO_ROOT/RangeCompiler/Range/Programs/Compiler"

usage() {
    cat >&2 <<'USAGE'
Usage:
  scripts/check-range-compiler-candidate [DIR]

DIR defaults to RangeCompiler/Range/Programs/Compiler.
USAGE
}

fail() {
    echo "Range compiler candidate check failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

sha256() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

bytes() {
    /usr/bin/stat -f %z "$1"
}

verify_manifest_file() {
    local key="$1"
    local label="$2"
    local relative expected actual path

    relative="$(manifest_value "$key.path")"
    expected="$(manifest_value "$key.sha256")"
    path="$REPO_ROOT/$relative"
    [[ -f "$path" ]] || fail "missing $label: $relative"
    actual="$(sha256 "$path")"
    [[ "$actual" == "$expected" ]] || fail "$label hash mismatch: $relative"
}

verify_manifest() {
    [[ "$(manifest_value formatVersion)" == "1" ]] || fail "unsupported seed manifest format"
    [[ "$(manifest_value target.platform)" == "macOS" ]] || fail "unsupported seed target platform"
    [[ "$(manifest_value target.pointerBits)" == "64" ]] || fail "unsupported seed pointer width"
    [[ "$(uname -m)" == "$(manifest_value target.architecture)" ]] || fail "seed target architecture mismatch"

    local seed_relative seed_expected seed_path seed_actual seed_bytes expected_bytes
    seed_relative="$(manifest_value seed.path)"
    seed_expected="$(manifest_value seed.sha256)"
    seed_path="$REPO_ROOT/$seed_relative"
    [[ -f "$seed_path" ]] || fail "missing checked-in seed: $seed_relative"
    seed_actual="$(sha256 "$seed_path")"
    [[ "$seed_actual" == "$seed_expected" ]] || fail "checked-in seed hash mismatch"
    seed_bytes="$(bytes "$seed_path")"
    expected_bytes="$(manifest_value seed.bytes)"
    [[ "$seed_bytes" == "$expected_bytes" ]] || fail "checked-in seed byte length mismatch"

    local clang_identity expected_clang
    clang_identity="$(clang --version | /usr/bin/head -1)"
    expected_clang="$(manifest_value producer.clang)"
    [[ "$clang_identity" == "$expected_clang"* ]] || fail "seed verifier clang mismatch: $clang_identity"

    local index
    for index in 0 1 2 3 4; do
        verify_manifest_file "runtimeSources.$index" "runtime input $index"
    done
}

runtime_inputs() {
    local index
    for index in 0 1 2 3 4; do
        /usr/bin/printf '%s\n' "$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")"
    done
}

SOURCE_FILES=()
SOURCE_RELATIVE_PATHS=()

discover_sources() {
    local directory="$1"
    local work_root="$2"
    local raw_list="$work_root/source-paths.raw"
    local sorted_list="$work_root/source-paths.sorted"
    local absolute relative

    [[ -d "$directory" ]] || fail "missing compiler directory: $directory"
    directory="$(cd "$directory" && pwd)"
    SOURCE_FILES=()
    SOURCE_RELATIVE_PATHS=()

    /usr/bin/find "$directory" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print0 > "$raw_list"
    : > "$sorted_list"
    while IFS= read -r -d '' absolute; do
        relative="${absolute#"$directory/"}"
        if [[ "$relative" == *$' '* || "$relative" == *$'\t'* || "$relative" == *$'\n'* ]]; then
            fail "Range source paths may not contain whitespace: $relative"
        fi
        /usr/bin/printf '%s\n' "$absolute" >> "$sorted_list"
    done < "$raw_list"

    while IFS= read -r absolute; do
        [[ -n "$absolute" ]] || continue
        SOURCE_FILES+=("$absolute")
        SOURCE_RELATIVE_PATHS+=("${absolute#"$directory/"}")
    done < <(LC_ALL=C /usr/bin/sort "$sorted_list")

    [[ "${#SOURCE_FILES[@]}" -gt 0 ]] || fail "no .range source files found in: $directory"
}

write_source_bundle() {
    local output="$1"
    local index source

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        source="${SOURCE_FILES[$index]}"
        /usr/bin/printf 'compilerSourceFile\\t%s\n' "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
        /bin/cat "$source" >> "$output"
        if [[ -n "$(/usr/bin/tail -c 1 "$source")" ]]; then
            /usr/bin/printf '\n' >> "$output"
        fi
    done
}

write_inventory_bundle() {
    local output="$1"
    local index

    /usr/bin/printf '%s\n' 'compilerSourceInventory' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'compilerSourceFile\\t%s\n' "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
    done
}

write_expected_inventory() {
    local output="$1"
    local index

    /usr/bin/printf 'sourceInventory\\tprogram\\n' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'sourceFile\\tindex=%s\\trole=project\\tpath=%s\\n' "$index" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
    done
    /usr/bin/printf 'sourceFileCount\\t%s\\n' "${#SOURCE_FILES[@]}" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

run_capture() {
    local executable="$1"
    local input="$2"
    local output="$3"
    local error="$4"
    local status

    if "$executable" "$input" > "$output" 2> "$error"; then
        status=0
    else
        status=$?
    fi
    RUN_STATUS="$status"
}

require_successful_output() {
    local label="$1"
    local output="$2"
    local error="$3"

    [[ "$RUN_STATUS" -eq 0 ]] || fail "$label exited $RUN_STATUS: $(/usr/bin/head -c 240 "$output")"
    [[ ! -s "$error" ]] || fail "$label wrote stderr: $(/usr/bin/head -c 240 "$error")"
    if /usr/bin/head -1 "$output" | /usr/bin/grep -Fq 'compilerError'; then
        fail "$label emitted compilerError: $(/usr/bin/head -c 400 "$output")"
    fi
    [[ -s "$output" ]] || fail "$label emitted empty output"
}

emit_candidate_llvm() {
    local executable="$1"
    local bundle="$2"
    local output="$3"
    local label="$4"
    local captured="$WORK_ROOT/$label.llvm"
    local error="$WORK_ROOT/$label.stderr"

    run_capture "$executable" "$bundle" "$captured" "$error"
    require_successful_output "$label" "$captured" "$error"
    /bin/mkdir -p "$(dirname "$output")"
    /bin/mv "$captured" "$output"
}

validate_llvm() {
    local llvm="$1"
    local object="$WORK_ROOT/$(basename "$llvm").o"
    clang -Wno-override-module -x ir -c "$llvm" -o "$object"
    /bin/rm -f "$object"
}

link_llvm() {
    local llvm="$1"
    local executable="$2"
    local temporary="$WORK_ROOT/$(basename "$executable").tmp"

    clang -Wno-override-module "$llvm" "${RUNTIME_INPUTS[@]}" -o "$temporary"
    /bin/mkdir -p "$(dirname "$executable")"
    /bin/mv "$temporary" "$executable"
}

audit_inventory() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.inventory.out"
    local error="$WORK_ROOT/$stage_label.inventory.err"

    run_capture "$executable" "$INVENTORY_BUNDLE" "$output" "$error"
    require_successful_output "$stage_label inventory" "$output" "$error"
    /usr/bin/cmp -s "$output" "$EXPECTED_INVENTORY" || fail "$stage_label inventory differs from discovered source order"
    echo "$stage_label inventory: pass (${#SOURCE_FILES[@]} files)"
}

assert_smoke_shape() {
    local llvm="$1"
    local define_count call_count

    for marker in \
        '%Range.NativeSmokePair = type { i32, i32 }' \
        'define i32 @main() {' \
        'define void @nativeSmokeFirst(ptr %returnDestination)' \
        'define void @nativeSmokeSecond(ptr %returnDestination)' \
        '%storage0 = alloca' \
        '%storage1 = alloca' \
        'insertvalue %Range.NativeSmokePair' \
        'extractvalue'; do
        /usr/bin/grep -Fq "$marker" "$llvm" || fail "normal smoke missing LLVM marker: $marker"
    done

    define_count="$(/usr/bin/grep -F -c 'define void @nativeSmoke' "$llvm")"
    call_count="$(/usr/bin/grep -F -c 'call void @nativeSmoke' "$llvm")"
    [[ "$define_count" -eq 2 ]] || fail "normal smoke emitted $define_count native aggregate definitions"
    [[ "$call_count" -eq 2 ]] || fail "normal smoke emitted $call_count native aggregate calls"

    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$llvm"; then
            fail "normal smoke emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done
    if /usr/bin/grep -Fq '\n' "$llvm"; then
        fail "normal smoke emitted an escaped newline marker"
    fi
    if /usr/bin/grep -Fq 'call %Range.NativeSmokePair' "$llvm"; then
        fail "normal smoke used aggregate-return calls instead of caller-owned storage"
    fi
}

audit_smoke() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.smoke.first.ll"
    local second="$WORK_ROOT/$stage_label.smoke.second.ll"
    local first_error="$WORK_ROOT/$stage_label.smoke.first.err"
    local second_error="$WORK_ROOT/$stage_label.smoke.second.err"
    local smoke_llvm="$stage_directory/Smoke.ll"
    local smoke_executable="$stage_directory/Smoke"
    local run_output="$WORK_ROOT/$stage_label.smoke.run.out"
    local run_error="$WORK_ROOT/$stage_label.smoke.run.err"

    run_capture "$executable" "$SMOKE_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label normal smoke" "$first" "$first_error"
    run_capture "$executable" "$SMOKE_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated normal smoke" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label normal smoke was not deterministic"
    assert_smoke_shape "$first"

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$smoke_llvm"
    validate_llvm "$smoke_llvm"
    link_llvm "$smoke_llvm" "$smoke_executable"

    if "$smoke_executable" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label normal smoke executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label normal smoke executable wrote output"
    echo "$stage_label deterministic aggregate smoke: pass (exit 7)"
}

audit_mixed_abi() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.mixed-abi.out"
    local error="$WORK_ROOT/$stage_label.mixed-abi.err"

    run_capture "$executable" "$MIXED_ABI_SOURCE" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label mixed aggregate ABI check exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label mixed aggregate ABI check wrote stderr"
    /usr/bin/grep -Fq 'compilerError' "$output" \
        && /usr/bin/grep -Fq 'kind=representationSensitiveABICapabilityBlocked' "$output" \
        || fail "$stage_label mixed aggregate ABI check missed capability diagnostic"
    if /usr/bin/grep -Fq 'define ' "$output" || /usr/bin/grep -Fq 'call ' "$output"; then
        fail "$stage_label mixed aggregate ABI check emitted LLVM before rejection"
    fi
    echo "$stage_label mixed aggregate ABI rejection: pass (exit 65, pre-emission)"
}

write_role_bundle() {
    local output="$1"
    local directive="$2"

    /usr/bin/printf '%s\n' \
        "$directive" \
        'compilerSourceFile\trole=core\tpath=Core.range' \
        'construct RoleCore {}' \
        'compilerSourceFile\trole=foundation\tpath=Foundation.range' \
        'construct RoleFoundation {}' \
        'compilerSourceFile\trole=generated\tpath=Generated.range' \
        'construct RoleGenerated {}' \
        'compilerSourceFile\trole=project\tpath=Project.range' \
        'construct RoleProject {}' \
        'compilerSourceFile\tLegacy.range' \
        'construct RoleLegacy {}' > "$output"
}

write_fingerprint_bundle() {
    local output="$1"
    local role="$2"

    /usr/bin/printf '%s\n' \
        'compilerTypedSyntax' \
        "compilerSourceFile\\trole=$role\\tpath=Fingerprint.range" \
        'construct FingerprintRole {}' > "$output"
}

write_invalid_role_bundle() {
    local output="$1"
    local marker="$2"

    /usr/bin/printf '%s\n' \
        'compilerSourceInventory' \
        "$marker" \
        'construct InvalidRole {}' > "$output"
}

write_core_bundle() {
    local output="$1"
    local directive="$2"

    if [[ -n "$directive" ]]; then
        /usr/bin/printf '%s\n' "$directive" > "$output"
    else
        /usr/bin/printf '%s' '' > "$output"
    fi
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Range/Core/System/Memory/IntBuffer.range' >> "$output"
    /bin/cat "$CORE_SOURCE_PATH" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$CORE_SOURCE_PATH")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=project\tpath=CoreUse.range' \
        'function MainTextDecoy(): Int { return stringLength(value: " @main ") }' \
        '@main {' \
        '    let buffer: IntBuffer(intBufferCreate(capacity: 0))' \
        '    return intBufferDestroy(buffer: buffer) + 7' \
        '}' >> "$output"
}

assert_role_identity() {
    local output="$1"

    for expected in \
        $'sourceFile\tid=0\trole=core\tpath=Core.range' \
        $'sourceFile\tid=1\trole=foundation\tpath=Foundation.range' \
        $'sourceFile\tid=2\trole=generated\tpath=Generated.range' \
        $'sourceFile\tid=3\trole=project\tpath=Project.range' \
        $'sourceFile\tid=4\trole=project\tpath=Legacy.range'; do
        /usr/bin/grep -Fq "$expected" "$output" || fail "role identity missing: $expected"
    done
}

audit_role_markers() {
    local stage_label="$1"
    local executable="$2"
    local identity_bundle="$WORK_ROOT/$stage_label.roles.identity.range"
    local identity_output="$WORK_ROOT/$stage_label.roles.identity.out"
    local identity_error="$WORK_ROOT/$stage_label.roles.identity.err"
    local inventory_bundle="$WORK_ROOT/$stage_label.roles.inventory.range"
    local inventory_output="$WORK_ROOT/$stage_label.roles.inventory.out"
    local inventory_error="$WORK_ROOT/$stage_label.roles.inventory.err"
    local expected_inventory="$WORK_ROOT/$stage_label.roles.inventory.expected"
    local malformed_bundle="$WORK_ROOT/$stage_label.roles.malformed.range"
    local malformed_output="$WORK_ROOT/$stage_label.roles.malformed.out"
    local malformed_error="$WORK_ROOT/$stage_label.roles.malformed.err"
    local malformed_expected="$WORK_ROOT/$stage_label.roles.malformed.expected"
    local fingerprint_project_bundle="$WORK_ROOT/$stage_label.roles.fingerprint.project.range"
    local fingerprint_project_first="$WORK_ROOT/$stage_label.roles.fingerprint.project.first.out"
    local fingerprint_project_second="$WORK_ROOT/$stage_label.roles.fingerprint.project.second.out"
    local fingerprint_project_error="$WORK_ROOT/$stage_label.roles.fingerprint.project.err"
    local fingerprint_core_bundle="$WORK_ROOT/$stage_label.roles.fingerprint.core.range"
    local fingerprint_core_output="$WORK_ROOT/$stage_label.roles.fingerprint.core.out"
    local fingerprint_core_error="$WORK_ROOT/$stage_label.roles.fingerprint.core.err"

    write_role_bundle "$identity_bundle" compilerSourceIdentity
    run_capture "$executable" "$identity_bundle" "$identity_output" "$identity_error"
    require_successful_output "$stage_label role identity" "$identity_output" "$identity_error"
    assert_role_identity "$identity_output"
    run_capture "$executable" "$identity_bundle" "$WORK_ROOT/$stage_label.roles.identity.repeat.out" "$WORK_ROOT/$stage_label.roles.identity.repeat.err"
    require_successful_output "$stage_label repeated role identity" "$WORK_ROOT/$stage_label.roles.identity.repeat.out" "$WORK_ROOT/$stage_label.roles.identity.repeat.err"
    /usr/bin/cmp -s "$identity_output" "$WORK_ROOT/$stage_label.roles.identity.repeat.out" || fail "$stage_label role identity was not deterministic"

    write_role_bundle "$inventory_bundle" compilerSourceInventory
    /usr/bin/printf 'sourceInventory\\tprogram\\n' > "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=0\\trole=core\\tpath=Core.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=1\\trole=foundation\\tpath=Foundation.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=2\\trole=generated\\tpath=Generated.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=3\\trole=project\\tpath=Project.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=4\\trole=project\\tpath=Legacy.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFileCount\\t5\\n' >> "$expected_inventory"
    /usr/bin/printf '\n' >> "$expected_inventory"
    run_capture "$executable" "$inventory_bundle" "$inventory_output" "$inventory_error"
    require_successful_output "$stage_label role inventory" "$inventory_output" "$inventory_error"
    /usr/bin/cmp -s "$inventory_output" "$expected_inventory" || fail "$stage_label role inventory differs from expected roles"

    write_invalid_role_bundle "$malformed_bundle" 'compilerSourceFile\trole=unknown\tpath=Bad.range'
    run_capture "$executable" "$malformed_bundle" "$malformed_output" "$malformed_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label malformed role exited $RUN_STATUS"
    [[ ! -s "$malformed_error" ]] || fail "$stage_label malformed role wrote stderr"
    /usr/bin/printf 'compilerError\tkind=invalidSourceFileTable\n\n' > "$malformed_expected"
    /usr/bin/cmp -s "$malformed_output" "$malformed_expected" \
        || fail "$stage_label malformed role diagnostic changed: $(/usr/bin/head -c 240 "$malformed_output")"

    write_fingerprint_bundle "$fingerprint_project_bundle" project
    run_capture "$executable" "$fingerprint_project_bundle" "$fingerprint_project_first" "$fingerprint_project_error"
    require_successful_output "$stage_label project fingerprint" "$fingerprint_project_first" "$fingerprint_project_error"
    run_capture "$executable" "$fingerprint_project_bundle" "$fingerprint_project_second" "$WORK_ROOT/$stage_label.roles.fingerprint.project.repeat.err"
    require_successful_output "$stage_label repeated project fingerprint" "$fingerprint_project_second" "$WORK_ROOT/$stage_label.roles.fingerprint.project.repeat.err"
    /usr/bin/cmp -s "$fingerprint_project_first" "$fingerprint_project_second" || fail "$stage_label project fingerprint was not deterministic"
    /usr/bin/grep -Fq $'declaration\trow=0' "$fingerprint_project_first" || fail "$stage_label project fingerprint omitted declaration output"

    write_fingerprint_bundle "$fingerprint_core_bundle" core
    run_capture "$executable" "$fingerprint_core_bundle" "$fingerprint_core_output" "$fingerprint_core_error"
    require_successful_output "$stage_label core fingerprint" "$fingerprint_core_output" "$fingerprint_core_error"
    /usr/bin/cmp -s "$fingerprint_project_first" "$fingerprint_core_output" && fail "$stage_label role-only fingerprint change was not observed"
    echo "$stage_label roles: pass (four explicit roles, legacy project, malformed rejection, deterministic role-sensitive fingerprint)"
}

audit_canonical_core() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local identity_bundle="$WORK_ROOT/$stage_label.canonical-core.identity.range"
    local identity_output="$WORK_ROOT/$stage_label.canonical-core.identity.out"
    local identity_error="$WORK_ROOT/$stage_label.canonical-core.identity.err"
    local core_bundle="$WORK_ROOT/$stage_label.canonical-core.range"
    local core_output="$stage_directory/CanonicalCore.ll"
    local core_error="$WORK_ROOT/$stage_label.canonical-core.err"
    local core_executable="$stage_directory/CanonicalCore"
    local run_output="$WORK_ROOT/$stage_label.canonical-core.run.out"
    local run_error="$WORK_ROOT/$stage_label.canonical-core.run.err"

    write_core_bundle "$identity_bundle" compilerSourceIdentity
    run_capture "$executable" "$identity_bundle" "$identity_output" "$identity_error"
    require_successful_output "$stage_label canonical Core identity" "$identity_output" "$identity_error"
    /usr/bin/grep -Fq $'sourceFile\tid=0\trole=core\tpath=RangeCompiler/Range/Core/System/Memory/IntBuffer.range' "$identity_output" \
        || fail "$stage_label canonical Core was not stored as role=core"
    /usr/bin/grep -Fq $'sourceFile\tid=1\trole=project\tpath=CoreUse.range' "$identity_output" \
        || fail "$stage_label canonical Core project file was not stored as role=project"

    write_core_bundle "$core_bundle" ''
    emit_candidate_llvm "$executable" "$core_bundle" "$core_output" "$stage_label.canonical-core"
    for marker in \
        'define i32 @main() {' \
        'declare ptr @intBufferCreate(i32)' \
        'declare i32 @intBufferDestroy(ptr)' \
        'call ptr @intBufferCreate(i32 0)' \
        'call i32 @intBufferDestroy(ptr'; do
        /usr/bin/grep -Fq "$marker" "$core_output" || fail "$stage_label canonical Core LLVM missing: $marker"
    done
    validate_llvm "$core_output"
    link_llvm "$core_output" "$core_executable"
    if "$core_executable" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label canonical Core executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label canonical Core executable wrote output"
    echo "$stage_label canonical Core: pass (ordinary @main token scan ignores decoy string, actual IntBuffer.range role=core, validate/link, exit 7)"
}

write_macro_positive_bundle() {
    local output="$1"
    local order="${2:-normal}"

    : > "$output"
    /usr/bin/printf '%s\n' \
        'compilerMacroSnapshot' >> "$output"
    if [[ "$order" == "reordered" ]]; then
        /usr/bin/printf '%s\n' \
            'compilerSourceFile\trole=foundation\tpath=Foundation/Unrelated.range' \
            'construct Unrelated {}' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro.range' \
        'open macro CrossConstruct(): Construct -> Void {}' \
        'macro CrossFunction(): Function -> Void {}' \
        'macro CrossMember(): Member -> Void {}' \
        'macro CrossParameter(value: Int): Parameter -> Void {}' >> "$output"
    if [[ "$order" != "reordered" ]]; then
        /usr/bin/printf '%s\n' \
            'compilerSourceFile\trole=foundation\tpath=Foundation/Unrelated.range' \
            'construct Unrelated {}' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=project\tpath=Project/MacroUse.range' \
        '@CrossConstruct' \
        'construct First {' \
        '    @CrossMember' \
        '    let value: Int' \
        '}' \
        '@CrossConstruct' \
        'construct Second {}' \
        '@CrossFunction' \
        'function target(@CrossParameter value: Int): Int { return 1 }' >> "$output"
}

write_macro_negative_bundle() {
    local output="$1"
    local kind="$2"

    case "$kind" in
        unresolved)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Known.range' \
                'macro Known(): Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/Missing.range' \
                '@Missing' \
                'construct Target {}' > "$output"
            ;;
        duplicate)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/First.range' \
                'macro Dup(): Construct -> Void {}' \
                'compilerSourceFile\trole=foundation\tpath=Foundation/Second.range' \
                'macro Dup(): Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/Duplicate.range' \
                '@Dup' \
                'construct Target {}' > "$output"
            ;;
        malformed-declaration)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Broken.range' \
                'macro Broken(: Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/BrokenUse.range' \
                'construct Target {}' > "$output"
            ;;
        malformed-application)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Known.range' \
                'macro Known(): Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/BrokenApplication.range' \
                '@Known(' \
                'construct Target {}' > "$output"
            ;;
        mismatch)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/FunctionOnly.range' \
                'macro FunctionOnly(): Function -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/WrongTarget.range' \
                '@FunctionOnly' \
                'construct Target {}' > "$output"
            ;;
        *)
            fail "unknown macro negative fixture: $kind"
            ;;
    esac
}

audit_macro_linking() {
    local stage_label="$1"
    local executable="$2"
    local positive_bundle="$WORK_ROOT/$stage_label.macro.positive.range"
    local first="$WORK_ROOT/$stage_label.macro.positive.first.out"
    local second="$WORK_ROOT/$stage_label.macro.positive.second.out"
    local first_error="$WORK_ROOT/$stage_label.macro.positive.first.err"
    local second_error="$WORK_ROOT/$stage_label.macro.positive.second.err"
    local reordered_bundle="$WORK_ROOT/$stage_label.macro.positive.reordered.range"
    local reordered_output="$WORK_ROOT/$stage_label.macro.positive.reordered.out"
    local reordered_error="$WORK_ROOT/$stage_label.macro.positive.reordered.err"
    local first_projection="$WORK_ROOT/$stage_label.macro.positive.projection.out"
    local reordered_projection="$WORK_ROOT/$stage_label.macro.positive.reordered.projection.out"

    write_macro_positive_bundle "$positive_bundle"
    run_capture "$executable" "$positive_bundle" "$first" "$first_error"
    require_successful_output "$stage_label macro positive" "$first" "$first_error"
    run_capture "$executable" "$positive_bundle" "$second" "$second_error"
    require_successful_output "$stage_label repeated macro positive" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label macro snapshot was not deterministic"
    /usr/bin/grep -Fq $'macroGraph\tvalid=true\tdeclarationCount=4\tparameterCount=1\tapplicationCount=5\tedgeCount=10\tappliesToCount=5\tresolvedByCount=5\tdigest=' "$first" || fail "$stage_label macro positive counts/digest changed"
    for expected in \
        $'macroGraph\tvalid=true' \
        $'declarationCount=4' \
        $'parameterCount=1' \
        $'applicationCount=5' \
        $'edgeCount=10' \
        $'appliesToCount=5' \
        $'resolvedByCount=5' \
        $'digest='; do
        /usr/bin/grep -Fq "$expected" "$first" || fail "$stage_label macro positive missing: $expected"
    done
    /usr/bin/grep -Fq $'macroStableProjection\tidentityDigest=' "$first" || fail "$stage_label macro positive missing stable identity projection"

    write_macro_positive_bundle "$reordered_bundle" reordered
    run_capture "$executable" "$reordered_bundle" "$reordered_output" "$reordered_error"
    require_successful_output "$stage_label reordered macro positive" "$reordered_output" "$reordered_error"
    /usr/bin/grep -F 'macroStableProjection' "$first" > "$first_projection" || fail "$stage_label missing first stable projection"
    /usr/bin/grep -F 'macroStableProjection' "$reordered_output" > "$reordered_projection" || fail "$stage_label missing reordered stable projection"
    /usr/bin/cmp -s "$first_projection" "$reordered_projection" || fail "$stage_label reordered macro identity projection changed"

    local kind negative_bundle negative_output negative_error expected
    for kind in unresolved duplicate malformed-declaration malformed-application mismatch; do
        negative_bundle="$WORK_ROOT/$stage_label.macro.$kind.range"
        negative_output="$WORK_ROOT/$stage_label.macro.$kind.out"
        negative_error="$WORK_ROOT/$stage_label.macro.$kind.err"
        write_macro_negative_bundle "$negative_bundle" "$kind"
        run_capture "$executable" "$negative_bundle" "$negative_output" "$negative_error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label macro $kind exited $RUN_STATUS"
        [[ ! -s "$negative_error" ]] || fail "$stage_label macro $kind wrote stderr"
        case "$kind" in
            unresolved) expected='diagnosticKind=unresolvedMacro' ;;
            duplicate) expected='diagnosticKind=ambiguousMacroDeclaration' ;;
            malformed-declaration) expected='diagnosticKind=malformedMacroDeclaration' ;;
            malformed-application) expected='diagnosticKind=malformedMacroApplication' ;;
            mismatch) expected='diagnosticKind=macroTargetSurfaceMismatch' ;;
        esac
        /usr/bin/grep -Fq "$expected" "$negative_output" || fail "$stage_label macro $kind missed diagnostic $expected"
        if /usr/bin/grep -Fq 'define ' "$negative_output" || /usr/bin/grep -Fq 'call ' "$negative_output"; then
            fail "$stage_label macro $kind emitted LLVM before rejection"
        fi
    done
    echo "$stage_label macro linking: pass (cross-role positive, deterministic identities/ordinals, unresolved/ambiguous/malformed/mismatch rejection)"
}

write_macro_execution_bundle() {
    local output="$1"
    local kind="$2"

    case "$kind" in
        positive)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Diagnostic.range' \
                'macro Signal(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.information("checked")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DiagnosticUse.range' \
                '@Signal' \
                'construct Target {}' > "$output"
            ;;
        multiple)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Diagnostics.range' \
                'macro Signal(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.information("checked")' \
                '}' \
                'macro Notice(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.warning("noticed")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DiagnosticsUse.range' \
                '@Signal' \
                'construct Target {}' \
                '@Notice' \
                'construct Other {}' > "$output"
            ;;
        query)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQuery.range' \
                'macro Observe(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Observed")' \
                '    return diagnostics.information("observed")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryUse.range' \
                '@Observe' \
                'construct Target {}' \
                'construct Observed {}' > "$output"
            ;;
        query-reordered)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=foundation\tpath=Foundation/Unrelated.range' \
                'construct Unrelated {}' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQuery.range' \
                'macro Observe(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Observed")' \
                '    return diagnostics.information("observed")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryUse.range' \
                '@Observe' \
                'construct Target {}' \
                'construct Observed {}' > "$output"
            ;;
        query-zero)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQueryZero.range' \
                'macro ObserveMissing(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Missing")' \
                '    return diagnostics.information("observed zero")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryZeroUse.range' \
                '@ObserveMissing' \
                'construct Target {}' > "$output"
            ;;
        member-present)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQuery.range' \
                'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return diagnostics.error("missing required member")' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryUse.range' \
                '@RequireMember' \
                'construct Target {' \
                '    let required: Int' \
                '}' > "$output"
            ;;
        member-present-reordered)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=foundation\tpath=Foundation/UnrelatedMemberQuery.range' \
                'construct Unrelated {}' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQuery.range' \
                'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return diagnostics.error("missing required member")' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryUse.range' \
                '@RequireMember' \
                'construct Target {' \
                '    let required: Int' \
                '}' > "$output"
            ;;
        member-missing)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryMissing.range' \
                'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return diagnostics.error("missing required member")' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryMissingUse.range' \
                '@RequireMember' \
                'construct Target {}' > "$output"
            ;;
        member-path)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryPath.range' \
                'macro RequireMemberPath(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return target.replace()' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryPathUse.range' \
                '@RequireMemberPath' \
                'construct Target {' \
                '    let required: Int' \
                '}' > "$output"
            ;;
        member-invalid)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryInvalid.range' \
                'macro RequireMemberInvalid(): Construct -> Void { target, diagnostics, graph in' \
                '    target.memberCount()' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryInvalidUse.range' \
                '@RequireMemberInvalid' \
                'construct Target {}' > "$output"
            ;;
        member-invalid-type)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryInvalidType.range' \
                'macro RequireMemberInvalidType(): Construct -> Void { target, diagnostics, graph in' \
                '    target.memberCount(1)' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryInvalidTypeUse.range' \
                '@RequireMemberInvalidType' \
                'construct Target {}' > "$output"
            ;;
        member-nonconstruct)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryNonConstruct.range' \
                'macro RequireMemberNonConstruct(): Function -> Void { target, diagnostics, graph in' \
                '    target.memberCount("required")' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryNonConstructUse.range' \
                '@RequireMemberNonConstruct' \
                'function Target(): Int { return 7 }' > "$output"
            ;;
        query-invalid)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQueryInvalid.range' \
                'macro ObserveInvalid(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Unknown", "Missing")' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryInvalidUse.range' \
                '@ObserveInvalid' \
                'construct Target {}' > "$output"
            ;;
        expansion)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Expansion.range' \
                'macro OmitObserved(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Observed")' \
                '    target.omit()' \
                '    return diagnostics.information("omitted")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/ExpansionUse.range' \
                '@OmitObserved' \
                'construct Target {}' \
                'construct Observed {}' > "$output"
            ;;
        expansion-duplicate)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/DuplicateExpansion.range' \
                'macro OmitTwice(): Construct -> Void { target, diagnostics, graph in' \
                '    target.omit()' \
                '    target.omit()' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DuplicateExpansionUse.range' \
                '@OmitTwice' \
                'construct Target {}' > "$output"
            ;;
        target-denied)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/TargetDenied.range' \
                'macro ReplaceDenied(): Construct -> Void { target, diagnostics, graph in' \
                '    return target.replace()' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/TargetDeniedUse.range' \
                '@ReplaceDenied' \
                'construct Target {}' > "$output"
            ;;
        error)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Reject.range' \
                'macro Reject(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.error("rejected")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/RejectUse.range' \
                '@Reject' \
                'construct Target {}' > "$output"
            ;;
        denied)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Denied.range' \
                'macro Probe(): Construct -> Void { target, diagnostics, graph in' \
                '    return graph.macros()' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DeniedUse.range' \
                '@Probe' \
                'construct Target {}' > "$output"
            ;;
        fuel)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Fuel.range' \
                'macro Exhaust(): Construct -> Void { target, diagnostics, graph in' > "$output"
            local index=0
            while [[ "$index" -lt 70 ]]; do
                /usr/bin/printf '    diagnostics.information("step%s")\n' "$index" >> "$output"
                index=$((index + 1))
            done
            /usr/bin/printf '%b\n' \
                '    return diagnostics.information("tail")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/FuelUse.range' \
                '@Exhaust' \
                'construct Target {}' >> "$output"
            ;;
        malformed-header)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MalformedHeader.range' \
                'macro Broken(): Construct -> Void { target, diagnostics in' \
                '    return diagnostics.information("bad")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MalformedHeaderUse.range' \
                '@Broken' \
                'construct Target {}' > "$output"
            ;;
        duplicate-header)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/DuplicateHeader.range' \
                'macro Duplicate(): Construct -> Void { target, target, graph in' \
                '    return diagnostics.information("bad")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DuplicateHeaderUse.range' \
                '@Duplicate' \
                'construct Target {}' > "$output"
            ;;
        *)
            fail "unknown macro execution fixture: $kind"
            ;;
    esac
}

write_macro_execution_llvm_bundle() {
    local output="$1"
    local kind="$2"
    local temporary="$output.tmp"

    write_macro_execution_bundle "$output" "$kind"
    /usr/bin/sed '1s/^compilerMacroSnapshot$/compilerNativeSourceSetLLVMText/' "$output" > "$temporary"
    /bin/mv "$temporary" "$output"
}

write_macro_execution_native_integration_bundle() {
    local output="$1"

    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/DiagnosticNative.range' \
        'macro Signal(): Construct -> Void { target, diagnostics, graph in' \
        '    graph.declarationCount("Construct", "Target")' \
        '    return diagnostics.information("checked")' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/DiagnosticNativeUse.range' \
        '@Signal' \
        'construct Target {}' \
        '' \
        '@main {' \
        '    return 7' \
        '}' > "$output"
}

write_macro_execution_native_member_bundle() {
    local output="$1"
    local kind="$2"

    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/MemberQueryNative.range' \
        'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
        '    if target.memberCount("required") == 0 {' \
        '        return diagnostics.error("missing required member")' \
        '    }' \
        '    return diagnostics.information("validated")' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/MemberQueryNativeUse.range' \
        '@RequireMember' \
        'construct Target {' > "$output"
    if [[ "$kind" == present ]]; then
        /usr/bin/printf '%b\n' \
            '    let required: Int' \
            '}' \
            '' \
            '@main {' \
            '    return 7' \
            '}' >> "$output"
    else
        /usr/bin/printf '%b\n' \
            '}' \
            '' \
            '@main {' \
            '    return 7' \
            '}' >> "$output"
    fi
}

write_macro_expansion_commit_bundle() {
    local output="$1"

    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/ExpansionCommit.range' \
        'macro OmitConstruct(): Construct -> Void { target, diagnostics, graph in' \
        '    graph.declarationCount("Construct", "Hidden")' \
        '    target.omit()' \
        '    return diagnostics.information("omitted construct")' \
        '}' \
        'macro OmitMember(): Member -> Void { target, diagnostics, graph in' \
        '    target.omit()' \
        '    return diagnostics.information("omitted member")' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/ExpansionCommitUse.range' \
        '@OmitConstruct' \
        'construct Hidden {' \
        '    let value: Int' \
        '}' \
        'construct Retained {' \
        '    @OmitMember' \
        '    let removed: Int' \
        '    let value: Int' \
        '}' \
        '' \
        '@main {' \
        '    return 7' \
        '}' > "$output"
}

audit_macro_execution() {
    local stage_label="$1"
    local executable="$2"
    local bundle output repeat_output error repeat_error llvm_bundle llvm_output llvm_error

    bundle="$WORK_ROOT/$stage_label.macro.execution-positive.range"
    output="$WORK_ROOT/$stage_label.macro.execution-positive.out"
    error="$WORK_ROOT/$stage_label.macro.execution-positive.err"
    repeat_output="$WORK_ROOT/$stage_label.macro.execution-positive.repeat.out"
    repeat_error="$WORK_ROOT/$stage_label.macro.execution-positive.repeat.err"
    write_macro_execution_bundle "$bundle" positive
    run_capture "$executable" "$bundle" "$output" "$error"
    require_successful_output "$stage_label macro execution positive" "$output" "$error"
    run_capture "$executable" "$bundle" "$repeat_output" "$repeat_error"
    require_successful_output "$stage_label repeated macro execution positive" "$repeat_output" "$repeat_error"
    /usr/bin/cmp -s "$output" "$repeat_output" || fail "$stage_label macro execution positive was not deterministic"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=1\tcapabilityHandleCount=3\teventCount=1\tgraphDeltaNodeCount=0\tgraphDeltaFactCount=0\treadDependencyCount=0' "$output" || fail "$stage_label macro execution positive counts changed"
    /usr/bin/grep -Fq $'macroInvocation\trow=0\tapplicationRow=0\tdeclarationRow=0\ttargetSyntaxID=' "$output" || fail "$stage_label macro execution omitted invocation provenance"
    /usr/bin/grep -Fq $'macroExecutionEvent\trow=0\tinvocationRow=0\tseverity=1\toperation=1\tmessage=checked' "$output" || fail "$stage_label macro execution omitted information event"

    local query_bundle="$WORK_ROOT/$stage_label.macro.execution-query.range"
    local query_output="$WORK_ROOT/$stage_label.macro.execution-query.out"
    local query_repeat_output="$WORK_ROOT/$stage_label.macro.execution-query.repeat.out"
    local query_error="$WORK_ROOT/$stage_label.macro.execution-query.err"
    local query_repeat_error="$WORK_ROOT/$stage_label.macro.execution-query.repeat.err"
    local query_reordered_bundle="$WORK_ROOT/$stage_label.macro.execution-query-reordered.range"
    local query_reordered_output="$WORK_ROOT/$stage_label.macro.execution-query-reordered.out"
    local query_reordered_error="$WORK_ROOT/$stage_label.macro.execution-query-reordered.err"
    local query_zero_bundle="$WORK_ROOT/$stage_label.macro.execution-query-zero.range"
    local query_zero_output="$WORK_ROOT/$stage_label.macro.execution-query-zero.out"
    local query_zero_error="$WORK_ROOT/$stage_label.macro.execution-query-zero.err"
    local query_digest="$WORK_ROOT/$stage_label.macro.execution-query.digest"
    local query_reordered_digest="$WORK_ROOT/$stage_label.macro.execution-query-reordered.digest"
    local query_dependency="$WORK_ROOT/$stage_label.macro.execution-query.dependency"
    local query_reordered_dependency="$WORK_ROOT/$stage_label.macro.execution-query-reordered.dependency"
    local query_zero_digest="$WORK_ROOT/$stage_label.macro.execution-query-zero.digest"
    write_macro_execution_bundle "$query_bundle" query
    run_capture "$executable" "$query_bundle" "$query_output" "$query_error"
    require_successful_output "$stage_label macro graph query" "$query_output" "$query_error"
    run_capture "$executable" "$query_bundle" "$query_repeat_output" "$query_repeat_error"
    require_successful_output "$stage_label repeated macro graph query" "$query_repeat_output" "$query_repeat_error"
    /usr/bin/cmp -s "$query_output" "$query_repeat_output" || fail "$stage_label macro graph query was not deterministic"
    /usr/bin/grep -Fq $'eventCount=1\tgraphDeltaNodeCount=0\tgraphDeltaFactCount=0\treadDependencyCount=1' "$query_output" || fail "$stage_label macro graph query counts changed"
    /usr/bin/grep -Fq $'macroReadDependency\trow=0\tinvocationRow=0\toperation=1\tkind=Construct\tname=Observed\tobservedCount=1' "$query_output" || fail "$stage_label macro graph query omitted its exact observed bucket"
    /usr/bin/grep -Fq $'\tapplicationIdentity=' "$query_output" || fail "$stage_label macro graph query omitted explicit application identity"
    /usr/bin/grep -Fq $'\ttargetIdentity=' "$query_output" || fail "$stage_label macro graph query omitted explicit target identity"
    /usr/bin/sed -n 's/.*readDependencyDigest=\([^[:space:]]*\).*/\1/p' "$query_output" > "$query_digest"
    [[ -s "$query_digest" ]] || fail "$stage_label macro graph query omitted dependency digest"

    write_macro_execution_bundle "$query_reordered_bundle" query-reordered
    run_capture "$executable" "$query_reordered_bundle" "$query_reordered_output" "$query_reordered_error"
    require_successful_output "$stage_label reordered macro graph query" "$query_reordered_output" "$query_reordered_error"
    /usr/bin/sed -n 's/.*readDependencyDigest=\([^[:space:]]*\).*/\1/p' "$query_reordered_output" > "$query_reordered_digest"
    /usr/bin/grep -F 'macroReadDependency' "$query_output" > "$query_dependency" || fail "$stage_label macro graph query omitted dependency row"
    /usr/bin/grep -F 'macroReadDependency' "$query_reordered_output" > "$query_reordered_dependency" || fail "$stage_label reordered macro graph query omitted dependency row"
    /usr/bin/cmp -s "$query_dependency" "$query_reordered_dependency" || fail "$stage_label exact macro read dependency row changed under unrelated source reorder"
    /usr/bin/cmp -s "$query_digest" "$query_reordered_digest" || fail "$stage_label unrelated source reorder changed macro read dependency digest"

    write_macro_execution_bundle "$query_zero_bundle" query-zero
    run_capture "$executable" "$query_zero_bundle" "$query_zero_output" "$query_zero_error"
    require_successful_output "$stage_label zero-result macro graph query" "$query_zero_output" "$query_zero_error"
    /usr/bin/grep -Fq $'macroReadDependency\trow=0\tinvocationRow=0\toperation=1\tkind=Construct\tname=Missing\tobservedCount=0' "$query_zero_output" || fail "$stage_label zero-result macro graph query did not record its bucket"
    /usr/bin/sed -n 's/.*readDependencyDigest=\([^[:space:]]*\).*/\1/p' "$query_zero_output" > "$query_zero_digest"
    if /usr/bin/cmp -s "$query_digest" "$query_zero_digest"; then
        fail "$stage_label changed macro graph observation did not change dependency digest"
    fi

    local member_present_bundle="$WORK_ROOT/$stage_label.macro.execution-member-present.range"
    local member_present_output="$WORK_ROOT/$stage_label.macro.execution-member-present.out"
    local member_present_repeat_output="$WORK_ROOT/$stage_label.macro.execution-member-present.repeat.out"
    local member_present_error="$WORK_ROOT/$stage_label.macro.execution-member-present.err"
    local member_present_repeat_error="$WORK_ROOT/$stage_label.macro.execution-member-present.repeat.err"
    local member_present_reordered_bundle="$WORK_ROOT/$stage_label.macro.execution-member-present-reordered.range"
    local member_present_reordered_output="$WORK_ROOT/$stage_label.macro.execution-member-present-reordered.out"
    local member_present_reordered_error="$WORK_ROOT/$stage_label.macro.execution-member-present-reordered.err"
    local member_present_dependency="$WORK_ROOT/$stage_label.macro.execution-member-present.dependency"
    local member_present_reordered_dependency="$WORK_ROOT/$stage_label.macro.execution-member-present-reordered.dependency"
    write_macro_execution_bundle "$member_present_bundle" member-present
    run_capture "$executable" "$member_present_bundle" "$member_present_output" "$member_present_error"
    require_successful_output "$stage_label present member query" "$member_present_output" "$member_present_error"
    run_capture "$executable" "$member_present_bundle" "$member_present_repeat_output" "$member_present_repeat_error"
    require_successful_output "$stage_label repeated present member query" "$member_present_repeat_output" "$member_present_repeat_error"
    /usr/bin/cmp -s "$member_present_output" "$member_present_repeat_output" || fail "$stage_label present member query was not deterministic"
    /usr/bin/grep -Fq $'eventCount=1\tgraphDeltaNodeCount=0\tgraphDeltaFactCount=0\treadDependencyCount=1' "$member_present_output" || fail "$stage_label present member query counts changed"
    /usr/bin/grep -Fq $'macroExecutionEvent\trow=0\tinvocationRow=0\tseverity=1\toperation=1\tmessage=validated' "$member_present_output" || fail "$stage_label present member query executed the wrong branch"
    /usr/bin/grep -Fq $'macroReadDependency\trow=0\tinvocationRow=0\toperation=2\tkind=Construct\tname=required\tobservedCount=1' "$member_present_output" || fail "$stage_label present member query omitted its positive dependency"
    /usr/bin/grep -F 'macroReadDependency' "$member_present_output" > "$member_present_dependency"
    /usr/bin/grep -Fq $'\tapplicationIdentity=' "$member_present_dependency" || fail "$stage_label present member dependency omitted explicit application identity"
    /usr/bin/grep -Fq $'\ttargetIdentity=' "$member_present_dependency" || fail "$stage_label present member dependency omitted explicit target identity"

    write_macro_execution_bundle "$member_present_reordered_bundle" member-present-reordered
    run_capture "$executable" "$member_present_reordered_bundle" "$member_present_reordered_output" "$member_present_reordered_error"
    require_successful_output "$stage_label reordered present member query" "$member_present_reordered_output" "$member_present_reordered_error"
    /usr/bin/grep -F 'macroReadDependency' "$member_present_reordered_output" > "$member_present_reordered_dependency" || fail "$stage_label reordered present member query omitted dependency row"
    /usr/bin/cmp -s "$member_present_dependency" "$member_present_reordered_dependency" || fail "$stage_label present member dependency identity changed under unrelated source reorder"

    local member_missing_bundle="$WORK_ROOT/$stage_label.macro.execution-member-missing.range"
    local member_missing_output="$WORK_ROOT/$stage_label.macro.execution-member-missing.out"
    local member_missing_repeat_output="$WORK_ROOT/$stage_label.macro.execution-member-missing.repeat.out"
    local member_missing_error="$WORK_ROOT/$stage_label.macro.execution-member-missing.err"
    local member_missing_repeat_error="$WORK_ROOT/$stage_label.macro.execution-member-missing.repeat.err"
    write_macro_execution_bundle "$member_missing_bundle" member-missing
    run_capture "$executable" "$member_missing_bundle" "$member_missing_output" "$member_missing_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label missing member query exited $RUN_STATUS"
    [[ ! -s "$member_missing_error" ]] || fail "$stage_label missing member query wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroExecutionError' "$member_missing_output" || fail "$stage_label missing member query missed error diagnostic"
    /usr/bin/grep -Fq 'message=missing required member' "$member_missing_output" || fail "$stage_label missing member query missed error message"
    /usr/bin/grep -Fq $'readDependencyCount=1' "$member_missing_output" || fail "$stage_label missing member query omitted dependency count"
    /usr/bin/grep -Fq $'macroReadDependency\trow=0\tinvocationRow=0\toperation=2\tkind=Construct\tname=required\tobservedCount=0' "$member_missing_output" || fail "$stage_label missing member query omitted its zero dependency"
    if /usr/bin/grep -Fq 'define ' "$member_missing_output" || /usr/bin/grep -Fq 'call ' "$member_missing_output"; then
        fail "$stage_label missing member query emitted LLVM before rejection"
    fi
    run_capture "$executable" "$member_missing_bundle" "$member_missing_repeat_output" "$member_missing_repeat_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label repeated missing member query exited $RUN_STATUS"
    /usr/bin/cmp -s "$member_missing_output" "$member_missing_repeat_output" || fail "$stage_label missing member query was not deterministic"

    local member_path_bundle="$WORK_ROOT/$stage_label.macro.execution-member-path.range"
    local member_path_output="$WORK_ROOT/$stage_label.macro.execution-member-path.out"
    local member_path_repeat_output="$WORK_ROOT/$stage_label.macro.execution-member-path.repeat.out"
    local member_path_error="$WORK_ROOT/$stage_label.macro.execution-member-path.err"
    local member_path_repeat_error="$WORK_ROOT/$stage_label.macro.execution-member-path.repeat.err"
    write_macro_execution_bundle "$member_path_bundle" member-path
    run_capture "$executable" "$member_path_bundle" "$member_path_output" "$member_path_error"
    require_successful_output "$stage_label path-sensitive member query" "$member_path_output" "$member_path_error"
    /usr/bin/grep -Fq 'message=validated' "$member_path_output" || fail "$stage_label path-sensitive member query did not take success path"
    /usr/bin/grep -Fq $'macroReadDependency\trow=0\tinvocationRow=0\toperation=2\tkind=Construct\tname=required\tobservedCount=1' "$member_path_output" || fail "$stage_label path-sensitive member query omitted dependency"
    if /usr/bin/grep -Fq 'macroCapabilityDenied' "$member_path_output"; then
        fail "$stage_label path-sensitive member query executed the untaken denied operation"
    fi
    run_capture "$executable" "$member_path_bundle" "$member_path_repeat_output" "$member_path_repeat_error"
    require_successful_output "$stage_label repeated path-sensitive member query" "$member_path_repeat_output" "$member_path_repeat_error"
    /usr/bin/cmp -s "$member_path_output" "$member_path_repeat_output" || fail "$stage_label path-sensitive member query was not deterministic"

    local member_invalid_bundle="$WORK_ROOT/$stage_label.macro.execution-member-invalid.range"
    local member_invalid_output="$WORK_ROOT/$stage_label.macro.execution-member-invalid.out"
    local member_invalid_repeat_output="$WORK_ROOT/$stage_label.macro.execution-member-invalid.repeat.out"
    local member_invalid_error="$WORK_ROOT/$stage_label.macro.execution-member-invalid.err"
    local member_invalid_repeat_error="$WORK_ROOT/$stage_label.macro.execution-member-invalid.repeat.err"
    write_macro_execution_bundle "$member_invalid_bundle" member-invalid
    run_capture "$executable" "$member_invalid_bundle" "$member_invalid_output" "$member_invalid_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label malformed member query exited $RUN_STATUS"
    [[ ! -s "$member_invalid_error" ]] || fail "$stage_label malformed member query wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroGraphQueryInvalid' "$member_invalid_output" || fail "$stage_label malformed member query missed focused query diagnostic"
    /usr/bin/grep -Fq $'readDependencyCount=0' "$member_invalid_output" || fail "$stage_label malformed member query recorded a dependency"
    if /usr/bin/grep -Fq 'macroReadDependency' "$member_invalid_output" \
        || /usr/bin/grep -Fq 'define ' "$member_invalid_output" \
        || /usr/bin/grep -Fq 'call ' "$member_invalid_output"; then
        fail "$stage_label malformed member query emitted a dependency or LLVM before rejection"
    fi
    run_capture "$executable" "$member_invalid_bundle" "$member_invalid_repeat_output" "$member_invalid_repeat_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label repeated malformed member query exited $RUN_STATUS"
    /usr/bin/cmp -s "$member_invalid_output" "$member_invalid_repeat_output" || fail "$stage_label malformed member query was not deterministic"

    local member_invalid_type_bundle="$WORK_ROOT/$stage_label.macro.execution-member-invalid-type.range"
    local member_invalid_type_output="$WORK_ROOT/$stage_label.macro.execution-member-invalid-type.out"
    local member_invalid_type_repeat_output="$WORK_ROOT/$stage_label.macro.execution-member-invalid-type.repeat.out"
    local member_invalid_type_error="$WORK_ROOT/$stage_label.macro.execution-member-invalid-type.err"
    local member_invalid_type_repeat_error="$WORK_ROOT/$stage_label.macro.execution-member-invalid-type.repeat.err"
    write_macro_execution_bundle "$member_invalid_type_bundle" member-invalid-type
    run_capture "$executable" "$member_invalid_type_bundle" "$member_invalid_type_output" "$member_invalid_type_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label non-String member query exited $RUN_STATUS"
    [[ ! -s "$member_invalid_type_error" ]] || fail "$stage_label non-String member query wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroGraphQueryInvalid' "$member_invalid_type_output" || fail "$stage_label non-String member query missed focused query diagnostic"
    /usr/bin/grep -Fq $'readDependencyCount=0' "$member_invalid_type_output" || fail "$stage_label non-String member query recorded a dependency"
    if /usr/bin/grep -Fq 'macroReadDependency' "$member_invalid_type_output" \
        || /usr/bin/grep -Fq 'define ' "$member_invalid_type_output" \
        || /usr/bin/grep -Fq 'call ' "$member_invalid_type_output"; then
        fail "$stage_label non-String member query emitted a dependency or LLVM before rejection"
    fi
    run_capture "$executable" "$member_invalid_type_bundle" "$member_invalid_type_repeat_output" "$member_invalid_type_repeat_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label repeated non-String member query exited $RUN_STATUS"
    /usr/bin/cmp -s "$member_invalid_type_output" "$member_invalid_type_repeat_output" || fail "$stage_label non-String member query was not deterministic"

    local member_nonconstruct_bundle="$WORK_ROOT/$stage_label.macro.execution-member-nonconstruct.range"
    local member_nonconstruct_output="$WORK_ROOT/$stage_label.macro.execution-member-nonconstruct.out"
    local member_nonconstruct_repeat_output="$WORK_ROOT/$stage_label.macro.execution-member-nonconstruct.repeat.out"
    local member_nonconstruct_error="$WORK_ROOT/$stage_label.macro.execution-member-nonconstruct.err"
    local member_nonconstruct_repeat_error="$WORK_ROOT/$stage_label.macro.execution-member-nonconstruct.repeat.err"
    write_macro_execution_bundle "$member_nonconstruct_bundle" member-nonconstruct
    run_capture "$executable" "$member_nonconstruct_bundle" "$member_nonconstruct_output" "$member_nonconstruct_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label non-construct member query exited $RUN_STATUS"
    [[ ! -s "$member_nonconstruct_error" ]] || fail "$stage_label non-construct member query wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroGraphQueryInvalid' "$member_nonconstruct_output" || fail "$stage_label non-construct member query missed focused query diagnostic"
    /usr/bin/grep -Fq $'readDependencyCount=0' "$member_nonconstruct_output" || fail "$stage_label non-construct member query recorded a dependency"
    if /usr/bin/grep -Fq 'macroReadDependency' "$member_nonconstruct_output" \
        || /usr/bin/grep -Fq 'define ' "$member_nonconstruct_output" \
        || /usr/bin/grep -Fq 'call ' "$member_nonconstruct_output"; then
        fail "$stage_label non-construct member query emitted a dependency or LLVM before rejection"
    fi
    run_capture "$executable" "$member_nonconstruct_bundle" "$member_nonconstruct_repeat_output" "$member_nonconstruct_repeat_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label repeated non-construct member query exited $RUN_STATUS"
    /usr/bin/cmp -s "$member_nonconstruct_output" "$member_nonconstruct_repeat_output" || fail "$stage_label non-construct member query was not deterministic"

    local expansion_bundle="$WORK_ROOT/$stage_label.macro.execution-expansion.range"
    local expansion_output="$WORK_ROOT/$stage_label.macro.execution-expansion.out"
    local expansion_repeat_output="$WORK_ROOT/$stage_label.macro.execution-expansion.repeat.out"
    local expansion_error="$WORK_ROOT/$stage_label.macro.execution-expansion.err"
    local expansion_repeat_error="$WORK_ROOT/$stage_label.macro.execution-expansion.repeat.err"
    write_macro_execution_bundle "$expansion_bundle" expansion
    run_capture "$executable" "$expansion_bundle" "$expansion_output" "$expansion_error"
    require_successful_output "$stage_label macro graph expansion" "$expansion_output" "$expansion_error"
    run_capture "$executable" "$expansion_bundle" "$expansion_repeat_output" "$expansion_repeat_error"
    require_successful_output "$stage_label repeated macro graph expansion" "$expansion_repeat_output" "$expansion_repeat_error"
    /usr/bin/cmp -s "$expansion_output" "$expansion_repeat_output" || fail "$stage_label macro graph expansion was not deterministic"
    /usr/bin/grep -Fq $'eventCount=1\tgraphDeltaNodeCount=1\tgraphDeltaFactCount=1\treadDependencyCount=1' "$expansion_output" || fail "$stage_label macro graph expansion counts changed"
    /usr/bin/grep -Fq $'macroReadDependency\trow=0\tinvocationRow=0\toperation=1\tkind=Construct\tname=Observed\tobservedCount=1' "$expansion_output" || fail "$stage_label macro graph expansion omitted its read dependency"
    /usr/bin/grep -Fq $'macroGraphDeltaNode\trow=0\tkind=construct\ttargetSyntaxID=' "$expansion_output" || fail "$stage_label macro graph expansion omitted target provenance"
    /usr/bin/grep -Fq $'macroGraphDeltaFact\trow=0\toperation=omit\tsubjectNodeID=0\tobjectNodeID=0\trole=22\tordinal=0' "$expansion_output" || fail "$stage_label macro graph expansion omitted its typed omission fact"

    bundle="$WORK_ROOT/$stage_label.macro.execution-multiple.range"
    output="$WORK_ROOT/$stage_label.macro.execution-multiple.out"
    error="$WORK_ROOT/$stage_label.macro.execution-multiple.err"
    write_macro_execution_bundle "$bundle" multiple
    run_capture "$executable" "$bundle" "$output" "$error"
    require_successful_output "$stage_label multiple macro execution" "$output" "$error"
    /usr/bin/grep -Fq $'macroExecution\tvalid=true\tinvocationCount=2\tcapabilityHandleCount=6\teventCount=2' "$output" || fail "$stage_label multiple macro execution counts changed"
    /usr/bin/grep -Fq $'message=checked' "$output" || fail "$stage_label multiple macro execution omitted first arbitrary macro"
    /usr/bin/grep -Fq $'message=noticed' "$output" || fail "$stage_label multiple macro execution omitted second arbitrary macro"

    bundle="$WORK_ROOT/$stage_label.macro.execution-error.range"
    output="$WORK_ROOT/$stage_label.macro.execution-error.out"
    error="$WORK_ROOT/$stage_label.macro.execution-error.err"
    write_macro_execution_bundle "$bundle" error
    run_capture "$executable" "$bundle" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label macro execution error exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label macro execution error wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroExecutionError' "$output" || fail "$stage_label macro execution error missed severity diagnostic"
    /usr/bin/grep -Fq 'message=rejected' "$output" || fail "$stage_label macro execution error missed message"
    for expected in applicationFileID= targetFileID= macroDeclarationFileID= macroBodyStart= eventSourceStart=; do
        /usr/bin/grep -Fq "$expected" "$output" || fail "$stage_label macro execution error missed provenance $expected"
    done
    if /usr/bin/grep -Fq 'define ' "$output" || /usr/bin/grep -Fq 'call ' "$output"; then
        fail "$stage_label macro execution error emitted LLVM before rejection"
    fi

    llvm_bundle="$WORK_ROOT/$stage_label.macro.execution-error-llvm.range"
    llvm_output="$WORK_ROOT/$stage_label.macro.execution-error-llvm.out"
    llvm_error="$WORK_ROOT/$stage_label.macro.execution-error-llvm.err"
    write_macro_execution_llvm_bundle "$llvm_bundle" error
    run_capture "$executable" "$llvm_bundle" "$llvm_output" "$llvm_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label native LLVM macro error exited $RUN_STATUS"
    [[ ! -s "$llvm_error" ]] || fail "$stage_label native LLVM macro error wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroExecutionError' "$llvm_output" || fail "$stage_label native LLVM macro error missed diagnostic"
    if /usr/bin/grep -Fq 'define ' "$llvm_output" || /usr/bin/grep -Fq 'call ' "$llvm_output"; then
        fail "$stage_label native LLVM macro error emitted LLVM before rejection"
    fi

    bundle="$WORK_ROOT/$stage_label.macro.execution-denied.range"
    output="$WORK_ROOT/$stage_label.macro.execution-denied.out"
    error="$WORK_ROOT/$stage_label.macro.execution-denied.err"
    write_macro_execution_bundle "$bundle" denied
    run_capture "$executable" "$bundle" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label macro capability denial exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label macro capability denial wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroCapabilityDenied' "$output" || fail "$stage_label macro capability denial missed diagnostic"
    /usr/bin/grep -Fq $'graphDeltaNodeCount=0\tgraphDeltaFactCount=0' "$output" || fail "$stage_label macro capability denial committed a non-empty graph delta"
    if /usr/bin/grep -Fq 'define ' "$output"; then
        fail "$stage_label macro capability denial committed graph or emitted LLVM"
    fi

    bundle="$WORK_ROOT/$stage_label.macro.execution-query-invalid.range"
    output="$WORK_ROOT/$stage_label.macro.execution-query-invalid.out"
    error="$WORK_ROOT/$stage_label.macro.execution-query-invalid.err"
    write_macro_execution_bundle "$bundle" query-invalid
    run_capture "$executable" "$bundle" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label invalid macro graph query exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label invalid macro graph query wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroGraphQueryInvalid' "$output" || fail "$stage_label invalid macro graph query missed diagnostic"
    if /usr/bin/grep -Fq 'define ' "$output" || /usr/bin/grep -Fq 'call ' "$output"; then
        fail "$stage_label invalid macro graph query emitted LLVM before rejection"
    fi

    bundle="$WORK_ROOT/$stage_label.macro.execution-expansion-duplicate.range"
    output="$WORK_ROOT/$stage_label.macro.execution-expansion-duplicate.out"
    error="$WORK_ROOT/$stage_label.macro.execution-expansion-duplicate.err"
    write_macro_execution_bundle "$bundle" expansion-duplicate
    run_capture "$executable" "$bundle" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label duplicate macro graph expansion exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label duplicate macro graph expansion wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroGraphDeltaInvalid' "$output" || fail "$stage_label duplicate macro graph expansion missed diagnostic"
    /usr/bin/grep -Fq $'graphDeltaNodeCount=0\tgraphDeltaFactCount=0' "$output" || fail "$stage_label duplicate macro graph expansion returned a partial delta"

    bundle="$WORK_ROOT/$stage_label.macro.execution-target-denied.range"
    output="$WORK_ROOT/$stage_label.macro.execution-target-denied.out"
    error="$WORK_ROOT/$stage_label.macro.execution-target-denied.err"
    write_macro_execution_bundle "$bundle" target-denied
    run_capture "$executable" "$bundle" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label denied macro target operation exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label denied macro target operation wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroCapabilityDenied' "$output" || fail "$stage_label denied macro target operation missed diagnostic"
    /usr/bin/grep -Fq $'graphDeltaNodeCount=0\tgraphDeltaFactCount=0' "$output" || fail "$stage_label denied macro target operation returned a graph delta"

    bundle="$WORK_ROOT/$stage_label.macro.execution-fuel.range"
    output="$WORK_ROOT/$stage_label.macro.execution-fuel.out"
    error="$WORK_ROOT/$stage_label.macro.execution-fuel.err"
    write_macro_execution_bundle "$bundle" fuel
    run_capture "$executable" "$bundle" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label macro execution fuel fixture exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label macro execution fuel fixture wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroExecutionFuelExhausted' "$output" || fail "$stage_label macro execution fuel fixture missed diagnostic"

    local kind expected
    for kind in malformed-header duplicate-header; do
        bundle="$WORK_ROOT/$stage_label.macro.execution-$kind.range"
        output="$WORK_ROOT/$stage_label.macro.execution-$kind.out"
        error="$WORK_ROOT/$stage_label.macro.execution-$kind.err"
        write_macro_execution_bundle "$bundle" "$kind"
        run_capture "$executable" "$bundle" "$output" "$error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label macro $kind exited $RUN_STATUS"
        [[ ! -s "$error" ]] || fail "$stage_label macro $kind wrote stderr"
        expected='diagnosticKind=macroCapabilityHeaderMalformed'
        if [[ "$kind" == duplicate-header ]]; then expected='diagnosticKind=macroCapabilityBindingDuplicate'; fi
        /usr/bin/grep -Fq "$expected" "$output" || fail "$stage_label macro $kind missed diagnostic $expected"
    done
    echo "$stage_label macro execution: pass (shared BodyArena/MIR, diagnostics, deterministic queries/dependencies, transactional typed omission delta, denial, fuel, header validation)"
}

audit_macro_native_integration() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local bundle="$WORK_ROOT/$stage_label.macro.execution-native.range"
    local first="$WORK_ROOT/$stage_label.macro.execution-native.first.ll"
    local second="$WORK_ROOT/$stage_label.macro.execution-native.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.macro.execution-native.first.err"
    local second_error="$WORK_ROOT/$stage_label.macro.execution-native.repeat.err"
    local llvm="$stage_directory/MacroExecution.ll"
    local linked="$stage_directory/MacroExecution"
    local run_output="$WORK_ROOT/$stage_label.macro.execution-native.run.out"
    local run_error="$WORK_ROOT/$stage_label.macro.execution-native.run.err"

    write_macro_execution_native_integration_bundle "$bundle"
    run_capture "$executable" "$bundle" "$first" "$first_error"
    require_successful_output "$stage_label native macro execution integration" "$first" "$first_error"
    run_capture "$executable" "$bundle" "$second" "$second_error"
    require_successful_output "$stage_label repeated native macro execution integration" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label native macro execution integration was not deterministic"
    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$llvm"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label native macro execution integration exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label native macro execution integration wrote output"
    echo "$stage_label native macro execution integration: pass (ordinary query plus LLVM validation/link, exit 7, deterministic)"

    local member_bundle="$WORK_ROOT/$stage_label.macro.execution-member-native.range"
    local member_first="$WORK_ROOT/$stage_label.macro.execution-member-native.first.ll"
    local member_second="$WORK_ROOT/$stage_label.macro.execution-member-native.repeat.ll"
    local member_first_error="$WORK_ROOT/$stage_label.macro.execution-member-native.first.err"
    local member_second_error="$WORK_ROOT/$stage_label.macro.execution-member-native.repeat.err"
    local member_llvm="$stage_directory/MemberQueryNative.ll"
    local member_linked="$stage_directory/MemberQueryNative"
    local member_run_output="$WORK_ROOT/$stage_label.macro.execution-member-native.run.out"
    local member_run_error="$WORK_ROOT/$stage_label.macro.execution-member-native.run.err"
    write_macro_execution_native_member_bundle "$member_bundle" present
    run_capture "$executable" "$member_bundle" "$member_first" "$member_first_error"
    require_successful_output "$stage_label native present member query" "$member_first" "$member_first_error"
    run_capture "$executable" "$member_bundle" "$member_second" "$member_second_error"
    require_successful_output "$stage_label repeated native present member query" "$member_second" "$member_second_error"
    /usr/bin/cmp -s "$member_first" "$member_second" || fail "$stage_label native present member query LLVM was not deterministic"
    /bin/mkdir -p "$stage_directory"
    /bin/cp "$member_first" "$member_llvm"
    validate_llvm "$member_llvm"
    link_llvm "$member_llvm" "$member_linked"
    if "$member_linked" > "$member_run_output" 2> "$member_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label native present member query exited $RUN_STATUS"
    [[ ! -s "$member_run_output" && ! -s "$member_run_error" ]] || fail "$stage_label native present member query wrote output"

    local member_missing_native_bundle="$WORK_ROOT/$stage_label.macro.execution-member-missing-native.range"
    local member_missing_native_output="$WORK_ROOT/$stage_label.macro.execution-member-missing-native.out"
    local member_missing_native_error="$WORK_ROOT/$stage_label.macro.execution-member-missing-native.err"
    write_macro_execution_native_member_bundle "$member_missing_native_bundle" missing
    run_capture "$executable" "$member_missing_native_bundle" "$member_missing_native_output" "$member_missing_native_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label native missing member query exited $RUN_STATUS"
    [[ ! -s "$member_missing_native_error" ]] || fail "$stage_label native missing member query wrote stderr"
    /usr/bin/grep -Fq 'diagnosticKind=macroExecutionError' "$member_missing_native_output" || fail "$stage_label native missing member query missed diagnostic"
    /usr/bin/grep -Fq $'observedCount=0' "$member_missing_native_output" || fail "$stage_label native missing member query omitted zero dependency"
    if /usr/bin/grep -Fq 'define ' "$member_missing_native_output" || /usr/bin/grep -Fq 'call ' "$member_missing_native_output"; then
        fail "$stage_label native missing member query emitted LLVM before rejection"
    fi
    echo "$stage_label native member-count query: pass (positive/zero, LLVM validate/link, exit 7/65, deterministic)"
}

audit_macro_expansion_commit() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local bundle="$WORK_ROOT/$stage_label.macro.expansion-commit.range"
    local first="$WORK_ROOT/$stage_label.macro.expansion-commit.first.ll"
    local second="$WORK_ROOT/$stage_label.macro.expansion-commit.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.macro.expansion-commit.first.err"
    local second_error="$WORK_ROOT/$stage_label.macro.expansion-commit.repeat.err"
    local llvm="$stage_directory/MacroExpansion.ll"
    local linked="$stage_directory/MacroExpansion"
    local run_output="$WORK_ROOT/$stage_label.macro.expansion-commit.run.out"
    local run_error="$WORK_ROOT/$stage_label.macro.expansion-commit.run.err"

    write_macro_expansion_commit_bundle "$bundle"
    run_capture "$executable" "$bundle" "$first" "$first_error"
    require_successful_output "$stage_label committed macro expansion" "$first" "$first_error"
    run_capture "$executable" "$bundle" "$second" "$second_error"
    require_successful_output "$stage_label repeated committed macro expansion" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label committed macro expansion was not deterministic"
    if /usr/bin/grep -Fq '%Range.Hidden = type' "$first"; then
        fail "$stage_label committed macro expansion retained the omitted construct layout"
    fi
    /usr/bin/grep -Fq '%Range.Retained = type { i32 }' "$first" || fail "$stage_label committed macro expansion did not remove exactly one member"
    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$llvm"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label committed macro expansion exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label committed macro expansion wrote output"
    echo "$stage_label committed macro expansion: pass (immutable omission overlay removes construct/member layouts, validate/link, exit 7, deterministic)"
}

audit_stage() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"

    audit_inventory "$stage_label" "$executable"
    audit_role_markers "$stage_label" "$executable"
    audit_canonical_core "$stage_label" "$executable" "$stage_directory"
    audit_macro_linking "$stage_label" "$executable"
    audit_macro_execution "$stage_label" "$executable"
    audit_macro_native_integration "$stage_label" "$executable" "$stage_directory"
    audit_macro_expansion_commit "$stage_label" "$executable" "$stage_directory"
    audit_smoke "$stage_label" "$executable" "$stage_directory"
    audit_mixed_abi "$stage_label" "$executable"
}

report_artifact() {
    local label="$1"
    local path="$2"
    printf '%s_path=%s\n' "$label" "$path"
    printf '%s_sha256=%s\n' "$label" "$(sha256 "$path")"
    printf '%s_bytes=%s\n' "$label" "$(bytes "$path")"
}

main() {
    [[ "$#" -le 1 ]] || { usage; exit 64; }
    local compiler_input="${1:-$DEFAULT_COMPILER_DIR}"
    [[ -d "$compiler_input" ]] || fail "missing compiler directory: $compiler_input"
    local compiler_directory
    compiler_directory="$(cd "$compiler_input" && pwd)"

    verify_manifest

    WORK_ROOT="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/range-compiler-candidate.XXXXXX")"
    trap '/bin/rm -rf "$WORK_ROOT"' EXIT
    CORE_SOURCE_PATH="$REPO_ROOT/RangeCompiler/Range/Core/System/Memory/IntBuffer.range"
    [[ -f "$CORE_SOURCE_PATH" ]] || fail "missing canonical Core proof input: $CORE_SOURCE_PATH"

    RUNTIME_INPUTS=()
    while IFS= read -r runtime; do
        RUNTIME_INPUTS+=("$runtime")
    done < <(runtime_inputs)

    discover_sources "$compiler_directory" "$WORK_ROOT"
    SOURCE_BUNDLE="$WORK_ROOT/RangeCompilerSourceSet.range"
    INVENTORY_BUNDLE="$WORK_ROOT/RangeCompilerInventory.range"
    EXPECTED_INVENTORY="$WORK_ROOT/RangeCompilerInventory.expected"
    write_source_bundle "$SOURCE_BUNDLE"
    write_inventory_bundle "$INVENTORY_BUNDLE"
    write_expected_inventory "$EXPECTED_INVENTORY"

    SMOKE_SOURCE="$WORK_ROOT/NativeSmoke.range"
    /usr/bin/printf '%s\n' \
        'construct NativeSmokePair {' \
        '    let first: Int' \
        '    let second: Int' \
        '}' \
        '' \
        'function nativeSmokeFirst(): NativeSmokePair {' \
        '    return NativeSmokePair(second: 2, first: 1)' \
        '}' \
        '' \
        'function nativeSmokeSecond(): NativeSmokePair {' \
        '    return NativeSmokePair(first: 3, second: 6)' \
        '}' \
        '' \
        '@main {' \
        '    let first: NativeSmokePair(nativeSmokeFirst())' \
        '    state second: NativeSmokePair(nativeSmokeSecond())' \
        '    second: NativeSmokePair(first: 3, second: 6)' \
        '    return first.first + second.second' \
        '}' > "$SMOKE_SOURCE"

    MIXED_ABI_SOURCE="$WORK_ROOT/MixedABINegative.range"
    /usr/bin/printf '%s\n' \
        'construct ABIPair {' \
        '    let first: Int' \
        '    let second: Int' \
        '}' \
        '' \
        'function brokenPair(): ABIPair {' \
        '    return 1' \
        '}' \
        '' \
        '@main {' \
        '    let value: ABIPair(brokenPair())' \
        '    return value.first' \
        '}' > "$MIXED_ABI_SOURCE"

    local seed seed_executable
    seed="$REPO_ROOT/$(manifest_value seed.path)"
    seed_executable="$WORK_ROOT/RangeCompilerSeed"
    clang -Wno-override-module -x ir "$seed" -x c "${RUNTIME_INPUTS[@]}" -o "$seed_executable"
    echo "bootstrap seed link: pass"

    local build_root stage2_directory stage3_directory
    local stage2_llvm stage2_executable stage3_llvm stage3_executable
    build_root="$compiler_directory/.range/Build"
    stage2_directory="$build_root/stage2"
    stage3_directory="$build_root/stage3"
    stage2_llvm="$stage2_directory/RangeCompiler.ll"
    stage2_executable="$stage2_directory/RangeCompiler"
    stage3_llvm="$stage3_directory/RangeCompiler.ll"
    stage3_executable="$stage3_directory/RangeCompiler"

    emit_candidate_llvm "$seed_executable" "$SOURCE_BUNDLE" "$stage2_llvm" stage2
    validate_llvm "$stage2_llvm"
    link_llvm "$stage2_llvm" "$stage2_executable"
    echo "Stage 2 candidate validate/link: pass"
    audit_stage Stage2 "$stage2_executable" "$stage2_directory"

    emit_candidate_llvm "$stage2_executable" "$SOURCE_BUNDLE" "$stage3_llvm" stage3
    validate_llvm "$stage3_llvm"
    link_llvm "$stage3_llvm" "$stage3_executable"
    /usr/bin/cmp -s "$stage2_llvm" "$stage3_llvm" || fail "Stage 2 and Stage 3 LLVM are not byte-identical"
    /usr/bin/cmp -s "$stage2_executable" "$stage3_executable" || fail "Stage 2 and Stage 3 executables are not byte-identical"
    echo "Stage 3 candidate validate/link and fixed point: pass"
    audit_stage Stage3 "$stage3_executable" "$stage3_directory"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-native.first.ll" "$WORK_ROOT/Stage3.macro.execution-native.first.ll" \
        || fail "Stage 2 and Stage 3 native macro integration LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-native.repeat.ll" "$WORK_ROOT/Stage3.macro.execution-native.repeat.ll" \
        || fail "Stage 2 and Stage 3 repeated native macro integration LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/MacroExecution.ll" "$stage3_directory/MacroExecution.ll" \
        || fail "Stage 2 and Stage 3 native macro integration artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MacroExecution" "$stage3_directory/MacroExecution" \
        || fail "Stage 2 and Stage 3 native macro integration executables differ"
    echo "Stage 2/Stage 3 native macro integration: byte-identical LLVM/executable"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-member-native.first.ll" "$WORK_ROOT/Stage3.macro.execution-member-native.first.ll" \
        || fail "Stage 2 and Stage 3 present member query LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-member-native.repeat.ll" "$WORK_ROOT/Stage3.macro.execution-member-native.repeat.ll" \
        || fail "Stage 2 and Stage 3 repeated present member query LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/MemberQueryNative.ll" "$stage3_directory/MemberQueryNative.ll" \
        || fail "Stage 2 and Stage 3 present member query artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MemberQueryNative" "$stage3_directory/MemberQueryNative" \
        || fail "Stage 2 and Stage 3 present member query executables differ"
    echo "Stage 2/Stage 3 present member query: byte-identical LLVM/executable"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.expansion-commit.first.ll" "$WORK_ROOT/Stage3.macro.expansion-commit.first.ll" \
        || fail "Stage 2 and Stage 3 committed macro expansion LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.expansion-commit.repeat.ll" "$WORK_ROOT/Stage3.macro.expansion-commit.repeat.ll" \
        || fail "Stage 2 and Stage 3 repeated committed macro expansion LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/MacroExpansion.ll" "$stage3_directory/MacroExpansion.ll" \
        || fail "Stage 2 and Stage 3 committed macro expansion artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MacroExpansion" "$stage3_directory/MacroExpansion" \
        || fail "Stage 2 and Stage 3 committed macro expansion executables differ"
    echo "Stage 2/Stage 3 committed macro expansion: byte-identical LLVM/executable"

    local macro_snapshot_suffix
    for macro_snapshot_suffix in positive.first.out positive.reordered.out unresolved.out duplicate.out malformed-declaration.out malformed-application.out mismatch.out execution-positive.out execution-positive.repeat.out execution-query.out execution-query.repeat.out execution-query-reordered.out execution-query-zero.out execution-member-present.out execution-member-present.repeat.out execution-member-present-reordered.out execution-member-missing.out execution-member-missing.repeat.out execution-member-path.out execution-member-path.repeat.out execution-member-invalid.out execution-member-invalid.repeat.out execution-member-invalid-type.out execution-member-invalid-type.repeat.out execution-member-nonconstruct.out execution-member-nonconstruct.repeat.out execution-member-native.first.ll execution-member-native.repeat.ll execution-member-missing-native.out execution-expansion.out execution-expansion.repeat.out execution-multiple.out execution-error.out execution-denied.out execution-query-invalid.out execution-expansion-duplicate.out execution-target-denied.out execution-fuel.out execution-malformed-header.out execution-duplicate-header.out; do
        /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.$macro_snapshot_suffix" "$WORK_ROOT/Stage3.macro.$macro_snapshot_suffix" \
            || fail "Stage 2 and Stage 3 macro snapshot differs: $macro_snapshot_suffix"
    done
    echo "Stage 2/Stage 3 focused macro snapshots: byte-identical"

    echo "Range compiler candidate check succeeded."
    printf 'compiler_directory=%s\n' "$compiler_directory"
    printf 'source_inventory_count=%s\n' "${#SOURCE_FILES[@]}"
    local index
    for index in "${!SOURCE_RELATIVE_PATHS[@]}"; do
        printf 'source_inventory_path_%s=%s\n' "$index" "${SOURCE_RELATIVE_PATHS[$index]}"
    done
    report_artifact stage2_llvm "$stage2_llvm"
    report_artifact stage3_llvm "$stage3_llvm"
    report_artifact stage2_executable "$stage2_executable"
    report_artifact stage3_executable "$stage3_executable"
    report_artifact stage2_macro_execution_llvm "$stage2_directory/MacroExecution.ll"
    report_artifact stage3_macro_execution_llvm "$stage3_directory/MacroExecution.ll"
    report_artifact stage2_macro_execution_executable "$stage2_directory/MacroExecution"
    report_artifact stage3_macro_execution_executable "$stage3_directory/MacroExecution"
    report_artifact stage2_member_query_native_llvm "$stage2_directory/MemberQueryNative.ll"
    report_artifact stage3_member_query_native_llvm "$stage3_directory/MemberQueryNative.ll"
    report_artifact stage2_member_query_native_executable "$stage2_directory/MemberQueryNative"
    report_artifact stage3_member_query_native_executable "$stage3_directory/MemberQueryNative"
    report_artifact stage2_macro_expansion_llvm "$stage2_directory/MacroExpansion.ll"
    report_artifact stage3_macro_expansion_llvm "$stage3_directory/MacroExpansion.ll"
    report_artifact stage2_macro_expansion_executable "$stage2_directory/MacroExpansion"
    report_artifact stage3_macro_expansion_executable "$stage3_directory/MacroExpansion"
    echo "stage2_stage3_llvm=byte-identical"
    echo "stage2_stage3_executable=byte-identical"
    echo "swift_invocation=none"
    echo "candidate_fixed_point=pass"
}

main "$@"
