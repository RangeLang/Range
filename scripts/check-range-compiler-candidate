    RECURSIVE_ENUM_SNAPSHOT_SOURCE="$WORK_ROOT/RecursiveEnumSnapshot.range"
    /usr/bin/printf '%s\n' \
        'compilerTypedSyntax' \
        'enum BindingList {' \
        '    case end' \
