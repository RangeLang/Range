function chooseSameBufferView(buffer: RawBuffer, flag: Bool): SameBranchBufferView {
    let first: SameBranchBufferView(SameBranchBufferView(storage: $buffer))
    let second: SameBranchBufferView(SameBranchBufferView(storage: $buffer))
    if flag {
        return first
    } else {
        return second
    }
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let view: SameBranchBufferView(chooseSameBufferView(buffer: source, flag: true))
