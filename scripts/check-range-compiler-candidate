    let owners: ArenaEmitterAliasOwners(ArenaEmitterAliasOwners(first: firstAlias, second: secondAlias))
    let result: ArenaEmitterResult(makeArenaEmitterResult(owners: owners))
    let firstOwnedValue: Int(rawBufferLoadInt(buffer: result.firstOwned, index: 0))
    let secondOwnedValue: Int(rawBufferLoadInt(buffer: result.secondOwned, index: 0))
    let firstAliasValue: Int(rawBufferLoadInt(buffer: result.firstAlias, index: 0))
    let secondAliasValue: Int(rawBufferLoadInt(buffer: result.secondAlias, index: 0))
    rawBufferDestroy(buffer: result.firstOwned)
    rawBufferDestroy(buffer: result.secondOwned)
    rawBufferDestroy(buffer: owners.first)
    rawBufferDestroy(buffer: owners.second)
    return firstOwnedValue + secondOwnedValue + firstAliasValue + secondAliasValue
