    let buffer: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    state index: Int(0)
    while index < 1 {
        let count: Int(rawBufferCount(buffer: buffer))
        rawBufferAppendInt(buffer: buffer, value: 7 + count)
