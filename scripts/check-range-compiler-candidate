function forwardRootBufferForSourceUse(buffer: RawBuffer): RawBuffer {
    return buffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let forwarded: RawBuffer(forwardRootBufferForSourceUse(buffer: source))
    rawBufferCount(buffer: source)
    rawBufferDestroy(buffer: forwarded)
    return 0
}
RANGE
            ;;
        boundary-forward-transitive-source-use)
            /bin/cat >> "$output" <<'RANGE'
function baseForwardRootBufferForSourceUse(buffer: RawBuffer): RawBuffer {
    return buffer
}

function transitivelyForwardRootBufferForSourceUse(buffer: RawBuffer): RawBuffer {
    let forwarded: RawBuffer(baseForwardRootBufferForSourceUse(buffer: buffer))
    return forwarded
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let forwarded: RawBuffer(transitivelyForwardRootBufferForSourceUse(buffer: source))
    rawBufferCount(buffer: source)
    rawBufferDestroy(buffer: forwarded)
    return 0
}
RANGE
            ;;
        boundary-forward-destroy)
            /bin/cat >> "$output" <<'RANGE'
function baseForwardRootBufferForDestroy(buffer: RawBuffer): RawBuffer {
    return buffer
}

function destroyForwardOnlyRootBuffer(buffer: RawBuffer): Int {
    let forwarded: RawBuffer(baseForwardRootBufferForDestroy(buffer: buffer))
    return rawBufferDestroy(buffer: forwarded)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    return destroyForwardOnlyRootBuffer(buffer: source)
}
RANGE
            ;;
        boundary-forward-alias-actual)
            /bin/cat >> "$output" <<'RANGE'
function forwardRootBufferFromOwnedActual(buffer: RawBuffer): RawBuffer {
    return buffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let forwarded: RawBuffer(forwardRootBufferFromOwnedActual(buffer: $source))
    rawBufferDestroy(buffer: forwarded)
    rawBufferDestroy(buffer: source)
    return 0
}
RANGE
            ;;
        boundary-forward-branch-ordinal)
            /bin/cat >> "$output" <<'RANGE'
function chooseForwardedRootBuffer(left: RawBuffer, right: RawBuffer, flag: Bool): RawBuffer {
    if flag {
        return left
    } else {
        return right
    }
}

@main {
    let left: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let right: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let forwarded: RawBuffer(chooseForwardedRootBuffer(left: left, right: right, flag: true))
    rawBufferDestroy(buffer: forwarded)
    rawBufferDestroy(buffer: right)
    return 0
}
RANGE
            ;;
        boundary-forward-branch-mode)
            /bin/cat >> "$output" <<'RANGE'
function chooseForwardedOrLocalRootBuffer(buffer: RawBuffer, flag: Bool): RawBuffer {
    let local: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    if flag {
        rawBufferDestroy(buffer: local)
        return buffer
    } else {
        return local
    }
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let result: RawBuffer(chooseForwardedOrLocalRootBuffer(buffer: source, flag: true))
    rawBufferDestroy(buffer: result)
    return 0
}
RANGE
            ;;
        boundary-forward-duplicate)
            /bin/cat >> "$output" <<'RANGE'
construct RootBoundaryForwardDuplicate {
    let first: RawBuffer
    let second: RawBuffer
}

function duplicateBoundaryForwardRootBuffer(buffer: RawBuffer): RootBoundaryForwardDuplicate {
    return RootBoundaryForwardDuplicate(first: buffer, second: buffer)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let result: RootBoundaryForwardDuplicate(duplicateBoundaryForwardRootBuffer(buffer: source))
    rawBufferDestroy(buffer: result.first)
    rawBufferDestroy(buffer: result.second)
    return 0
}
RANGE
            ;;
        boundary-forward-alias-conflict)
            /bin/cat >> "$output" <<'RANGE'
construct RootBoundaryForwardAliasConflict {
    binding borrowed: RawBuffer
    let forwarded: RawBuffer
}

function makeRootBoundaryForwardAliasConflict(buffer: RawBuffer): RootBoundaryForwardAliasConflict {
    return RootBoundaryForwardAliasConflict(borrowed: $buffer, forwarded: buffer)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let result: RootBoundaryForwardAliasConflict(makeRootBoundaryForwardAliasConflict(buffer: source))
    let value: Int(rawBufferLoadInt(buffer: result.borrowed, index: 0))
    rawBufferDestroy(buffer: result.forwarded)
    return value
}
RANGE
            ;;
        discarded-create)
            /bin/cat >> "$output" <<'RANGE'
@main {
    rawBufferCreate(capacity: 1, stride: 4)
    return 0
}
RANGE
            ;;
        duplicate-move)
            /bin/cat >> "$output" <<'RANGE'
construct RootDuplicateHolder {
    let first: RawBuffer
    let second: RawBuffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let holder: RootDuplicateHolder(first: source, second: source)
    return 0
}
RANGE
            ;;
        missing-destroy)
            /bin/cat >> "$output" <<'RANGE'
@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    return 0
}
RANGE
            ;;
        use-after-move)
            /bin/cat >> "$output" <<'RANGE'
construct RootMovedHolder {
    let storage: RawBuffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let holder: RootMovedHolder(storage: source)
    rawBufferAppendInt(buffer: source, value: 7)
    rawBufferDestroy(buffer: holder.storage)
    return 0
}
RANGE
            ;;
        binding-as-ownership)
            /bin/cat >> "$output" <<'RANGE'
construct RootOwnedHolder {
    let storage: RawBuffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let holder: RootOwnedHolder(storage: $source)
    rawBufferDestroy(buffer: source)
    return 0
}
RANGE
            ;;
        partial-whole-move)
            /bin/cat >> "$output" <<'RANGE'
construct RootPartialMoveOwner {
    let first: RawBuffer
    let second: RawBuffer
}

@main {
    let first: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let second: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let owner: RootPartialMoveOwner(first: first, second: second)
    rawBufferDestroy(buffer: owner.first)
    let moved: RootPartialMoveOwner(owner)
    rawBufferDestroy(buffer: moved.second)
    return 0
}
RANGE
            ;;
        partial-double-destroy)
            /bin/cat >> "$output" <<'RANGE'
construct RootPartialDoubleDestroyOwner {
    let first: RawBuffer
    let second: RawBuffer
}

@main {
    let first: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let second: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let owner: RootPartialDoubleDestroyOwner(first: first, second: second)
    rawBufferDestroy(buffer: owner.first)
    rawBufferDestroy(buffer: owner.first)
    rawBufferDestroy(buffer: owner.second)
    return 0
}
RANGE
            ;;
        partial-use-after-destroy)
            /bin/cat >> "$output" <<'RANGE'
construct RootPartialUseAfterDestroyOwner {
    let first: RawBuffer
    let second: RawBuffer
}

@main {
    let first: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let second: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let owner: RootPartialUseAfterDestroyOwner(first: first, second: second)
    rawBufferDestroy(buffer: owner.first)
    rawBufferCount(buffer: owner.first)
    rawBufferDestroy(buffer: owner.second)
    return 0
}
RANGE
            ;;
        absent-branch-live-exit)
            /bin/cat >> "$output" <<'RANGE'
@main {
    if true {
        let branchOwner: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    }
    return 0
}
RANGE
            ;;
        absent-conditional-live)
            /bin/cat >> "$output" <<'RANGE'
function rejectAbsentOrLiveTerminal(flag: Bool): Int {
    if flag {
        return 0
    }
    let later: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    return 0
}

@main {
    return rejectAbsentOrLiveTerminal(flag: true)
}
RANGE
            ;;
        absent-loop-live)
            /bin/cat >> "$output" <<'RANGE'
@main {
    state index: Int(0)
    while index < 2 {
        let loopOwner: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
        index: index + 1
    }
    return 0
}
RANGE
            ;;
        loop-ownership-change)
            /bin/cat >> "$output" <<'RANGE'
function rejectOwnershipChangingBackedge(): RawBuffer {
    let loopBuffer: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let returnedBuffer: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    state index: Int(0)
    while index < 1 {
        rawBufferDestroy(buffer: loopBuffer)
        index: index + 1
    }
    rawBufferDestroy(buffer: loopBuffer)
    return returnedBuffer
}

@main {
    let returnedBuffer: RawBuffer(rejectOwnershipChangingBackedge())
    rawBufferDestroy(buffer: returnedBuffer)
    return 0
}
RANGE
            ;;
        *)
            fail "unknown RootValue fixture: $kind"
            ;;
    esac
}

assert_role_identity() {
    local output="$1"

    for expected in \
        $'sourceFile\tid=0\trole=core\tpath=Core.range' \
        $'sourceFile\tid=1\trole=foundation\tpath=Foundation.range' \
        $'sourceFile\tid=2\trole=framework\tpath=Framework.range' \
        $'sourceFile\tid=3\trole=generated\tpath=Generated.range' \
        $'sourceFile\tid=4\trole=project\tpath=Project.range' \
        $'sourceFile\tid=5\trole=project\tpath=Legacy.range'; do
        /usr/bin/grep -Fq "$expected" "$output" || fail "role identity missing: $expected"
    done
}

audit_role_markers() {
    local stage_label="$1"
    local executable="$2"
    local identity_bundle="$WORK_ROOT/$stage_label.roles.identity.range"
    local identity_output="$WORK_ROOT/$stage_label.roles.identity.out"
    local identity_error="$WORK_ROOT/$stage_label.roles.identity.err"
    local inventory_bundle="$WORK_ROOT/$stage_label.roles.inventory.range"
    local inventory_output="$WORK_ROOT/$stage_label.roles.inventory.out"
    local inventory_error="$WORK_ROOT/$stage_label.roles.inventory.err"
    local expected_inventory="$WORK_ROOT/$stage_label.roles.inventory.expected"
    local malformed_bundle="$WORK_ROOT/$stage_label.roles.malformed.range"
    local malformed_output="$WORK_ROOT/$stage_label.roles.malformed.out"
    local malformed_error="$WORK_ROOT/$stage_label.roles.malformed.err"
    local malformed_expected="$WORK_ROOT/$stage_label.roles.malformed.expected"
    local fingerprint_project_bundle="$WORK_ROOT/$stage_label.roles.fingerprint.project.range"
    local fingerprint_project_first="$WORK_ROOT/$stage_label.roles.fingerprint.project.first.out"
    local fingerprint_project_second="$WORK_ROOT/$stage_label.roles.fingerprint.project.second.out"
    local fingerprint_project_error="$WORK_ROOT/$stage_label.roles.fingerprint.project.err"
    local fingerprint_core_bundle="$WORK_ROOT/$stage_label.roles.fingerprint.core.range"
    local fingerprint_core_output="$WORK_ROOT/$stage_label.roles.fingerprint.core.out"
    local fingerprint_core_error="$WORK_ROOT/$stage_label.roles.fingerprint.core.err"

    write_role_bundle "$identity_bundle" compilerSourceIdentity
    run_capture "$executable" "$identity_bundle" "$identity_output" "$identity_error"
    require_successful_output "$stage_label role identity" "$identity_output" "$identity_error"
    assert_role_identity "$identity_output"
    run_capture "$executable" "$identity_bundle" "$WORK_ROOT/$stage_label.roles.identity.repeat.out" "$WORK_ROOT/$stage_label.roles.identity.repeat.err"
    require_successful_output "$stage_label repeated role identity" "$WORK_ROOT/$stage_label.roles.identity.repeat.out" "$WORK_ROOT/$stage_label.roles.identity.repeat.err"
    /usr/bin/cmp -s "$identity_output" "$WORK_ROOT/$stage_label.roles.identity.repeat.out" || fail "$stage_label role identity was not deterministic"

    write_role_bundle "$inventory_bundle" compilerSourceInventory
    /usr/bin/printf 'sourceInventory\\tprogram\\n' > "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=0\\trole=core\\tpath=Core.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=1\\trole=foundation\\tpath=Foundation.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=2\\trole=framework\\tpath=Framework.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=3\\trole=generated\\tpath=Generated.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=4\\trole=project\\tpath=Project.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFile\\tindex=5\\trole=project\\tpath=Legacy.range\\n' >> "$expected_inventory"
    /usr/bin/printf 'sourceFileCount\\t6\\n' >> "$expected_inventory"
    /usr/bin/printf '\n' >> "$expected_inventory"
    run_capture "$executable" "$inventory_bundle" "$inventory_output" "$inventory_error"
    require_successful_output "$stage_label role inventory" "$inventory_output" "$inventory_error"
    /usr/bin/cmp -s "$inventory_output" "$expected_inventory" || fail "$stage_label role inventory differs from expected roles"

    write_invalid_role_bundle "$malformed_bundle" 'compilerSourceFile\trole=unknown\tpath=Bad.range'
    run_capture "$executable" "$malformed_bundle" "$malformed_output" "$malformed_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label malformed role exited $RUN_STATUS"
    [[ ! -s "$malformed_error" ]] || fail "$stage_label malformed role wrote stderr"
    /usr/bin/printf 'compilerError\tkind=invalidSourceFileTable\n\n' > "$malformed_expected"
    /usr/bin/cmp -s "$malformed_output" "$malformed_expected" \
        || fail "$stage_label malformed role diagnostic changed: $(/usr/bin/head -c 240 "$malformed_output")"

    write_fingerprint_bundle "$fingerprint_project_bundle" project
    run_capture "$executable" "$fingerprint_project_bundle" "$fingerprint_project_first" "$fingerprint_project_error"
    require_successful_output "$stage_label project fingerprint" "$fingerprint_project_first" "$fingerprint_project_error"
    run_capture "$executable" "$fingerprint_project_bundle" "$fingerprint_project_second" "$WORK_ROOT/$stage_label.roles.fingerprint.project.repeat.err"
    require_successful_output "$stage_label repeated project fingerprint" "$fingerprint_project_second" "$WORK_ROOT/$stage_label.roles.fingerprint.project.repeat.err"
    /usr/bin/cmp -s "$fingerprint_project_first" "$fingerprint_project_second" || fail "$stage_label project fingerprint was not deterministic"
    /usr/bin/grep -Fq $'declaration\trow=0' "$fingerprint_project_first" || fail "$stage_label project fingerprint omitted declaration output"

    write_fingerprint_bundle "$fingerprint_core_bundle" core
    run_capture "$executable" "$fingerprint_core_bundle" "$fingerprint_core_output" "$fingerprint_core_error"
    require_successful_output "$stage_label core fingerprint" "$fingerprint_core_output" "$fingerprint_core_error"
    /usr/bin/cmp -s "$fingerprint_project_first" "$fingerprint_core_output" && fail "$stage_label role-only fingerprint change was not observed"
    echo "$stage_label roles: pass (five explicit roles, legacy project, malformed rejection, deterministic role-sensitive fingerprint)"
}

audit_driver_source_graph() {
    local stage_label="$1"
    local executable="$2"
    local source="$REPO_ROOT/Testing/Basics/Pass/ReturnInteger.range"
    local graph="$WORK_ROOT/$stage_label.source-graph.range"
    local repeated="$WORK_ROOT/$stage_label.source-graph.repeat.range"
    local inventory="$WORK_ROOT/$stage_label.source-graph.inventory.range"
    local output="$WORK_ROOT/$stage_label.source-graph.inventory.out"
    local decoded="$WORK_ROOT/$stage_label.source-graph.inventory.decoded"
    local error="$WORK_ROOT/$stage_label.source-graph.inventory.err"
    local role expected_count actual_count

    "$REPO_ROOT/scripts/range-native" source-graph "$source" "$graph"
    "$REPO_ROOT/scripts/range-native" source-graph "$source" "$repeated"
    /usr/bin/cmp -s "$graph" "$repeated" || fail "$stage_label driver SourceGraph was not deterministic"
    {
        /usr/bin/printf '%s\n' 'compilerSourceInventory'
        /bin/cat "$graph"
    } > "$inventory"
    run_capture "$executable" "$inventory" "$output" "$error"
    require_successful_output "$stage_label driver SourceGraph inventory" "$output" "$error"
    /usr/bin/perl -pe 's/\\t/\t/g; s/\\n/\n/g' "$output" > "$decoded"
    for role in core foundation framework project; do
        expected_count="$(/usr/bin/grep -Fc "compilerSourceFile\\trole=$role\\t" "$graph" || true)"
        actual_count="$(/usr/bin/grep -Fc "role=$role" "$decoded" || true)"
        [[ "$actual_count" -eq "$expected_count" ]] \
            || fail "$stage_label driver SourceGraph $role count $actual_count; expected $expected_count"
    done
    /usr/bin/awk -F '\t' '
        BEGIN { last = -1 }
        $1 == "sourceFile" {
            split($3, field, "=")
            role = field[2]
            rank = role == "core" ? 0 : role == "foundation" ? 1 : role == "framework" ? 2 : role == "project" ? 3 : -1
            if (rank < last || rank < 0) { exit 1 }
            last = rank
        }
        END { if (last != 3) exit 1 }
    ' "$decoded" || fail "$stage_label driver SourceGraph role order changed"
    echo "$stage_label driver SourceGraph: pass (deterministic ordered role inventory, including empty roles)"
}

audit_canonical_core() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local identity_bundle="$WORK_ROOT/$stage_label.canonical-core.identity.range"
    local identity_output="$WORK_ROOT/$stage_label.canonical-core.identity.out"
    local identity_error="$WORK_ROOT/$stage_label.canonical-core.identity.err"
    local core_bundle="$WORK_ROOT/$stage_label.canonical-core.range"
    local core_output="$stage_directory/CanonicalCore.ll"
    local core_error="$WORK_ROOT/$stage_label.canonical-core.err"
    local core_executable="$stage_directory/CanonicalCore"
    local run_output="$WORK_ROOT/$stage_label.canonical-core.run.out"
    local run_error="$WORK_ROOT/$stage_label.canonical-core.run.err"

    write_core_bundle "$identity_bundle" compilerSourceIdentity
    run_capture "$executable" "$identity_bundle" "$identity_output" "$identity_error"
    require_successful_output "$stage_label canonical Core identity" "$identity_output" "$identity_error"
    /usr/bin/grep -Fq $'sourceFile\tid=0\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/RawBuffer.range' "$identity_output" \
        || fail "$stage_label canonical Core was not stored as role=core"
    /usr/bin/grep -Fq $'sourceFile\tid=1\trole=project\tpath=CoreUse.range' "$identity_output" \
        || fail "$stage_label canonical Core project file was not stored as role=project"

    write_core_bundle "$core_bundle" ''
    emit_candidate_llvm "$executable" "$core_bundle" "$core_output" "$stage_label.canonical-core"
    for marker in \
        'define i32 @main() {' \
        'declare ptr @rawBufferCreate(i32, i32)' \
        'declare i32 @rawBufferDestroy(ptr)' \
        'call ptr @rawBufferCreate(i32 0, i32 4)' \
        'call i32 @rawBufferDestroy(ptr'; do
        /usr/bin/grep -Fq "$marker" "$core_output" || fail "$stage_label canonical Core LLVM missing: $marker"
    done
    validate_llvm "$core_output"
    link_llvm "$core_output" "$core_executable"
    if "$core_executable" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label canonical Core executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label canonical Core executable wrote output"
    echo "$stage_label canonical Core: pass (ordinary @main token scan ignores decoy string, actual RawBuffer.range role=core, validate/link, exit 7)"
}

audit_binding_reference_positive() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local kind="$4"
    local artifact definition_marker call_marker expected_destroy_count

    case "$kind" in
        local)
            artifact=BindingLocal
            definition_marker='define i32 @bindingReadCount('
            call_marker='call i32 @bindingReadCount('
            expected_destroy_count=1
            ;;
        member)
            artifact=BindingMember
            definition_marker='define i32 @bindingReadFirst('
            call_marker='call i32 @bindingReadFirst('
            expected_destroy_count=1
            ;;
        binding-return)
            artifact=BindingReturn
            definition_marker='define void @returnBufferView(ptr %returnDestination'
            call_marker='call void @returnBufferView('
            expected_destroy_count=1
            ;;
        multi-alias-return)
            artifact=BindingMultiAlias
            definition_marker='define void @returnBoundaryBufferView(ptr %returnDestination'
            call_marker='call void @returnBoundaryBufferView('
            expected_destroy_count=2
            ;;
        branch-same)
            artifact=BindingBranchSame
            definition_marker='define void @chooseSameBufferView(ptr %returnDestination'
            call_marker='call void @chooseSameBufferView('
            expected_destroy_count=1
            ;;
        alias-forward)
            artifact=BindingForward
            definition_marker='define void @forwardBufferView(ptr %returnDestination'
            call_marker='call void @forwardBufferView('
            expected_destroy_count=1
            ;;
        mixed-return)
            artifact=BindingMixedReturn
            definition_marker='define void @makeMixedBufferView(ptr %returnDestination'
            call_marker='call void @makeMixedBufferView('
            expected_destroy_count=2
            ;;
        multi-mixed-return)
            artifact=BindingMultiMixedReturn
            definition_marker='define void @makeArenaEmitterResult(ptr %returnDestination'
            call_marker='call void @makeArenaEmitterResult('
            expected_destroy_count=4
            ;;
        nested-binding)
            artifact=BindingNested
            definition_marker='define void @returnNestedBufferView(ptr %returnDestination'
            call_marker='call void @returnNestedBufferView('
            expected_destroy_count=1
            ;;
        *)
            fail "unknown positive binding-reference audit: $kind"
            ;;
    esac

    local bundle="$WORK_ROOT/$stage_label.binding.$kind.range"
    local first="$WORK_ROOT/$stage_label.binding.$kind.first.ll"
    local second="$WORK_ROOT/$stage_label.binding.$kind.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.binding.$kind.first.err"
    local second_error="$WORK_ROOT/$stage_label.binding.$kind.repeat.err"
    local llvm="$stage_directory/$artifact.ll"
    local linked="$stage_directory/$artifact"
    local run_output="$WORK_ROOT/$stage_label.binding.$kind.run.out"
    local run_error="$WORK_ROOT/$stage_label.binding.$kind.run.err"

    write_binding_reference_bundle "$bundle" "$kind"
    run_capture "$executable" "$bundle" "$first" "$first_error"
    require_successful_output "$stage_label binding $kind" "$first" "$first_error"
    run_capture "$executable" "$bundle" "$second" "$second_error"
    require_successful_output "$stage_label repeated binding $kind" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label binding $kind LLVM was not deterministic"

    /usr/bin/grep -Fq "$definition_marker" "$first" \
        || fail "$stage_label binding $kind omitted native definition: $definition_marker"
    /usr/bin/grep -Fq "$call_marker" "$first" \
        || fail "$stage_label binding $kind omitted native call: $call_marker"
    local actual_destroy_count
    actual_destroy_count="$(/usr/bin/grep -F -c 'call i32 @rawBufferDestroy(ptr' "$first" || true)"
    [[ "$actual_destroy_count" -eq "$expected_destroy_count" ]] \
        || fail "$stage_label binding $kind emitted $actual_destroy_count owner destructions; expected $expected_destroy_count"
    if [[ "$kind" == local ]]; then
        /usr/bin/grep -Fq '%Range.LocalBufferView = type { ptr }' "$first" \
            || fail "$stage_label local binding omitted its native pointer slot"
        /usr/bin/grep -Fq 'insertvalue %Range.LocalBufferView poison, ptr' "$first" \
            || fail "$stage_label local binding omitted native pointer insertion"
        /usr/bin/grep -Fq 'extractvalue %Range.LocalBufferView' "$first" \
            || fail "$stage_label local binding omitted native pointer extraction"
    fi
    if [[ "$kind" == binding-return ]]; then
        /usr/bin/grep -Fq '%Range.ReturnedBufferView = type { ptr }' "$first" \
            || fail "$stage_label binding return omitted its native pointer slot"
        /usr/bin/grep -Fq 'insertvalue %Range.ReturnedBufferView poison, ptr' "$first" \
            || fail "$stage_label binding return omitted native alias insertion"
        /usr/bin/grep -Fq 'extractvalue %Range.ReturnedBufferView' "$first" \
            || fail "$stage_label binding return omitted native alias extraction"
    fi
    if [[ "$kind" == multi-alias-return ]]; then
        /usr/bin/grep -Fq '%Range.BoundaryBufferOwners = type { ptr, ptr }' "$first" \
            || fail "$stage_label multi-alias return omitted its boundary owner layout"
        /usr/bin/grep -Fq '%Range.BoundaryBufferView = type { ptr, ptr }' "$first" \
            || fail "$stage_label multi-alias return omitted its two-alias layout"
    fi
    if [[ "$kind" == alias-forward ]]; then
        /usr/bin/grep -Fq 'define void @baseBufferView(ptr %returnDestination' "$first" \
            || fail "$stage_label alias forwarding omitted its base definition"
        /usr/bin/grep -Fq 'call void @baseBufferView(' "$first" \
            || fail "$stage_label alias forwarding omitted its transitive call"
    fi
    if [[ "$kind" == mixed-return ]]; then
        /usr/bin/grep -Fq '%Range.MixedBufferView = type { ptr, ptr }' "$first" \
            || fail "$stage_label mixed binding return omitted its owned/alias pointer layout"
    fi
    if [[ "$kind" == multi-mixed-return ]]; then
        /usr/bin/grep -Fq '%Range.ArenaEmitterAliasOwners = type { ptr, ptr }' "$first" \
            || fail "$stage_label multi-mixed return omitted its boundary owner layout"
        /usr/bin/grep -Fq '%Range.ArenaEmitterResult = type { ptr, ptr, ptr, ptr }' "$first" \
            || fail "$stage_label multi-mixed return omitted its four-leaf layout"
    fi
    if [[ "$kind" == nested-binding ]]; then
        /usr/bin/grep -Fq '%Range.NestedLeafBufferView = type { ptr }' "$first" \
            || fail "$stage_label nested binding omitted its leaf pointer layout"
        /usr/bin/grep -Fq '%Range.NestedDirectBufferView = type { %Range.NestedLeafBufferView }' "$first" \
            || fail "$stage_label nested binding omitted its explicit binding subtree layout"
    fi
    local forbidden
    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$first"; then
            fail "$stage_label binding $kind emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$llvm"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label binding $kind executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label binding $kind executable wrote output"
    echo "$stage_label binding $kind: pass (ordinary native LLVM, helper effect, validate/link, exit 7, deterministic)"
}

audit_binding_reference_negative() {
    local stage_label="$1"
    local executable="$2"
    local kind="$3"
    local bundle="$WORK_ROOT/$stage_label.binding.$kind.range"
    local first="$WORK_ROOT/$stage_label.binding.$kind.first.out"
    local second="$WORK_ROOT/$stage_label.binding.$kind.repeat.out"
    local first_error="$WORK_ROOT/$stage_label.binding.$kind.first.err"
    local second_error="$WORK_ROOT/$stage_label.binding.$kind.repeat.err"

    write_binding_reference_bundle "$bundle" "$kind"
    run_capture "$executable" "$bundle" "$first" "$first_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label binding $kind exited $RUN_STATUS"
    [[ ! -s "$first_error" ]] || fail "$stage_label binding $kind wrote stderr"
    /usr/bin/grep -Fq $'compilerError\t' "$first" || fail "$stage_label binding $kind omitted compilerError"
    if [[ "$kind" == recursive-return ]]; then
        /usr/bin/grep -Fq 'kind=invalidOwnedReturnSummary' "$first" \
            || fail "$stage_label recursive binding return omitted invalidOwnedReturnSummary"
        /usr/bin/grep -Fq 'failureKind=unresolved' "$first" \
            || fail "$stage_label recursive binding return omitted unresolved failure kind"
    fi
    if /usr/bin/grep -Fq 'define ' "$first" || /usr/bin/grep -Fq 'call ' "$first"; then
        fail "$stage_label binding $kind emitted LLVM before rejection"
    fi

    run_capture "$executable" "$bundle" "$second" "$second_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label repeated binding $kind exited $RUN_STATUS"
    [[ ! -s "$second_error" ]] || fail "$stage_label repeated binding $kind wrote stderr"
    /usr/bin/grep -Fq $'compilerError\t' "$second" || fail "$stage_label repeated binding $kind omitted compilerError"
    if [[ "$kind" == recursive-return ]]; then
        /usr/bin/grep -Fq 'kind=invalidOwnedReturnSummary' "$second" \
            || fail "$stage_label repeated recursive binding return omitted invalidOwnedReturnSummary"
        /usr/bin/grep -Fq 'failureKind=unresolved' "$second" \
            || fail "$stage_label repeated recursive binding return omitted unresolved failure kind"
    fi
    if /usr/bin/grep -Fq 'define ' "$second" || /usr/bin/grep -Fq 'call ' "$second"; then
        fail "$stage_label repeated binding $kind emitted LLVM before rejection"
    fi
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label binding $kind diagnostic was not deterministic"
    echo "$stage_label binding $kind: pass (deterministic pre-emission rejection)"
}

audit_binding_references() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"

    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" local
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" member
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" binding-return
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" multi-alias-return
    audit_binding_reference_negative "$stage_label" "$executable" local-alias-escape
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" branch-same
    audit_binding_reference_negative "$stage_label" "$executable" branch-different
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" alias-forward
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" mixed-return
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" multi-mixed-return
    audit_binding_reference_negative "$stage_label" "$executable" consumed-owner-return
    audit_binding_reference_negative "$stage_label" "$executable" use-after-returned-alias
    audit_binding_reference_negative "$stage_label" "$executable" recursive-return
    audit_binding_reference_positive "$stage_label" "$executable" "$stage_directory" nested-binding
    audit_binding_reference_negative "$stage_label" "$executable" nested-wrapper
    audit_binding_reference_negative "$stage_label" "$executable" missing-dollar
    audit_binding_reference_negative "$stage_label" "$executable" alias-destroy
    audit_binding_reference_negative "$stage_label" "$executable" direct-destroy
    audit_binding_reference_negative "$stage_label" "$executable" helper-destroy
    audit_binding_reference_negative "$stage_label" "$executable" alias-move
    echo "$stage_label binding references: pass (local/member aliases, alias returns/forwarding/mixed transfer, branch provenance, owner lifetime, fail-closed topology)"
}

compare_binding_reference_stages() {
    local left_label="$1"
    local left_directory="$2"
    local right_label="$3"
    local right_directory="$4"
    local specification kind artifact

    for specification in \
        local:BindingLocal \
        member:BindingMember \
        binding-return:BindingReturn \
        multi-alias-return:BindingMultiAlias \
        branch-same:BindingBranchSame \
        alias-forward:BindingForward \
        mixed-return:BindingMixedReturn \
        multi-mixed-return:BindingMultiMixedReturn \
        nested-binding:BindingNested; do
        kind="${specification%%:*}"
        artifact="${specification#*:}"
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.binding.$kind.first.ll" "$WORK_ROOT/$right_label.binding.$kind.first.ll" \
            || fail "$left_label and $right_label binding $kind LLVM differs"
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.binding.$kind.repeat.ll" "$WORK_ROOT/$right_label.binding.$kind.repeat.ll" \
            || fail "$left_label and $right_label repeated binding $kind LLVM differs"
        /usr/bin/cmp -s "$left_directory/$artifact.ll" "$right_directory/$artifact.ll" \
            || fail "$left_label and $right_label binding $kind artifacts differ"
        /usr/bin/cmp -s "$left_directory/$artifact" "$right_directory/$artifact" \
            || fail "$left_label and $right_label binding $kind executables differ"
    done

    for kind in \
        local-alias-escape \
        branch-different \
        consumed-owner-return \
        use-after-returned-alias \
        recursive-return \
        nested-wrapper \
        missing-dollar \
        alias-destroy \
        direct-destroy \
        helper-destroy \
        alias-move; do
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.binding.$kind.first.out" "$WORK_ROOT/$right_label.binding.$kind.first.out" \
            || fail "$left_label and $right_label binding $kind diagnostics differ"
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.binding.$kind.repeat.out" "$WORK_ROOT/$right_label.binding.$kind.repeat.out" \
            || fail "$left_label and $right_label repeated binding $kind diagnostics differ"
    done
    echo "$left_label/$right_label binding references: byte-identical LLVM/executables/diagnostics"
}

audit_root_value_positive() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local kind="$4"
    local artifact definition_marker call_marker expected_create_count expected_destroy_count

    case "$kind" in
        opaque-return)
            artifact=RootValueOpaqueReturn
            definition_marker='define ptr @makeRootBuffer()'
            call_marker='call ptr @makeRootBuffer()'
            expected_create_count=1
            expected_destroy_count=1
            ;;
        boundary-forward-direct)
            artifact=RootValueBoundaryForwardDirect
            definition_marker='define ptr @forwardRootBuffer(ptr'
            call_marker='call ptr @forwardRootBuffer(ptr'
            expected_create_count=1
            expected_destroy_count=1
            ;;
        boundary-forward-transitive)
            artifact=RootValueBoundaryForwardTransitive
            definition_marker='define ptr @forwardRootBufferTransitively(ptr'
            call_marker='call ptr @forwardRootBufferTransitively(ptr'
            expected_create_count=1
            expected_destroy_count=1
            ;;
        boundary-forward-two-owned-inputs)
            artifact=RootValueBoundaryForwardPair
            definition_marker='define void @forwardRootBufferPair(ptr %returnDestination'
            call_marker='call void @forwardRootBufferPair('
            expected_create_count=2
            expected_destroy_count=2
            ;;
        boundary-forward-mixed)
            artifact=RootValueBoundaryForwardMixed
            definition_marker='define void @makeRootBoundaryForwardMixedResult(ptr %returnDestination'
            call_marker='call void @makeRootBoundaryForwardMixedResult('
            expected_create_count=3
            expected_destroy_count=3
            ;;
        direct-holder)
            artifact=RootValueDirectHolder
            definition_marker='define void @makeRootDirectHolder(ptr %returnDestination'
            call_marker='call void @makeRootDirectHolder('
            expected_create_count=1
            expected_destroy_count=1
            ;;
        nested-inline)
            artifact=RootValueNestedInline
            definition_marker='define void @makeRootNestedOuter(ptr %returnDestination'
            call_marker='call void @makeRootNestedOuter('
            expected_create_count=1
            expected_destroy_count=1
            ;;
        inline-local-return)
            artifact=RootValueInlineLocalReturn
            definition_marker='define void @makeRootLocalHolder(ptr %returnDestination'
            call_marker='call void @makeRootLocalHolder('
            expected_create_count=1
            expected_destroy_count=1
            ;;
        two-owned-leaves)
            artifact=RootValueTwoOwnedLeaves
            definition_marker='define void @makeRootTwinHolder(ptr %returnDestination'
            call_marker='call void @makeRootTwinHolder('
            expected_create_count=2
            expected_destroy_count=2
            ;;
        partial-sibling)
            artifact=RootValuePartialSibling
            definition_marker='define i32 @main()'
            call_marker='call i32 @rawBufferAppendInt('
            expected_create_count=2
            expected_destroy_count=2
            ;;
        loop-invariant)
            artifact=RootValueLoopInvariant
            definition_marker='define i32 @main()'
            call_marker='call i32 @rawBufferAppendInt('
            expected_create_count=1
            expected_destroy_count=1
            ;;
        absent-early-return)
            artifact=RootValueAbsentEarlyReturn
            definition_marker='define i32 @absentEarlyReturn(i1'
            call_marker='call i32 @absentEarlyReturn(i1'
            expected_create_count=1
            expected_destroy_count=1
            ;;
        absent-branch-scope)
            artifact=RootValueAbsentBranchScope
            definition_marker='define i32 @absentBranchScope(ptr'
            call_marker='call i32 @absentBranchScope(ptr'
            expected_create_count=2
            expected_destroy_count=2
            ;;
        absent-loop-reevaluation)
            artifact=RootValueAbsentLoopReevaluation
            definition_marker='define i32 @absentLoopReevaluation()'
            call_marker='call i32 @absentLoopReevaluation()'
            expected_create_count=1
            expected_destroy_count=1
            ;;
        absent-returned-alias)
            artifact=RootValueAbsentReturnedAlias
            definition_marker='define void @absentForwardAlias(ptr %returnDestination'
            call_marker='call void @absentForwardAlias('
            expected_create_count=1
            expected_destroy_count=1
            ;;
        boundary-consume)
            artifact=RootValueBoundaryConsume
            definition_marker='define i32 @destroyRootBufferInCallee(ptr'
            call_marker='call i32 @destroyRootBufferInCallee(ptr'
            expected_create_count=1
            expected_destroy_count=1
            ;;
        *)
            fail "unknown positive RootValue audit: $kind"
            ;;
    esac

    local bundle="$WORK_ROOT/$stage_label.root-value.$kind.range"
    local first="$WORK_ROOT/$stage_label.root-value.$kind.first.ll"
    local second="$WORK_ROOT/$stage_label.root-value.$kind.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.root-value.$kind.first.err"
    local second_error="$WORK_ROOT/$stage_label.root-value.$kind.repeat.err"
    local llvm="$stage_directory/$artifact.ll"
    local linked="$stage_directory/$artifact"
    local run_output="$WORK_ROOT/$stage_label.root-value.$kind.run.out"
    local run_error="$WORK_ROOT/$stage_label.root-value.$kind.run.err"

    write_root_value_bundle "$bundle" "$kind"
    run_capture "$executable" "$bundle" "$first" "$first_error"
    require_successful_output "$stage_label RootValue $kind" "$first" "$first_error"
    run_capture "$executable" "$bundle" "$second" "$second_error"
    require_successful_output "$stage_label repeated RootValue $kind" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label RootValue $kind LLVM was not deterministic"

    /usr/bin/grep -Fq "$definition_marker" "$first" \
        || fail "$stage_label RootValue $kind omitted native definition: $definition_marker"
    /usr/bin/grep -Fq "$call_marker" "$first" \
        || fail "$stage_label RootValue $kind omitted native call: $call_marker"
    if [[ "$kind" == loop-invariant ]]; then
        /usr/bin/grep -Fq 'call i32 @rawBufferCount(ptr' "$first" \
            || fail "$stage_label RootValue loop invariant omitted its shared read"
    fi
    if [[ "$kind" == absent-branch-scope ]]; then
        /usr/bin/grep -Fq '%Range.AbsentBranchAliasView = type { ptr }' "$first" \
            || fail "$stage_label Absent branch scope omitted its alias layout"
    fi
    if [[ "$kind" == absent-returned-alias ]]; then
        /usr/bin/grep -Fq '%Range.AbsentReturnedAliasView = type { ptr }' "$first" \
            || fail "$stage_label Absent returned alias omitted its pointer layout"
        /usr/bin/grep -Fq 'define void @absentChooseAlias(ptr %returnDestination' "$first" \
            || fail "$stage_label Absent returned alias omitted its branch-local producer"
        /usr/bin/grep -Fq 'call void @absentChooseAlias(' "$first" \
            || fail "$stage_label Absent returned alias omitted its transitive forward call"
    fi
    if [[ "$kind" == boundary-forward-transitive ]]; then
        /usr/bin/grep -Fq 'define ptr @baseForwardRootBuffer(ptr' "$first" \
            || fail "$stage_label transitive boundary forward omitted its base definition"
        /usr/bin/grep -Fq 'call ptr @baseForwardRootBuffer(ptr' "$first" \
            || fail "$stage_label transitive boundary forward omitted its base call"
    fi
    if [[ "$kind" == boundary-consume ]]; then
        local consume_definition_count consume_call_count
        consume_definition_count="$(/usr/bin/grep -F -c 'define i32 @destroyRootBufferInCallee(ptr' "$first" || true)"
        consume_call_count="$(/usr/bin/grep -F -c 'call i32 @destroyRootBufferInCallee(ptr' "$first" || true)"
        [[ "$consume_definition_count" -eq 1 ]] \
            || fail "$stage_label RootValue boundary consume emitted $consume_definition_count helper definitions; expected 1"
        [[ "$consume_call_count" -eq 1 ]] \
            || fail "$stage_label RootValue boundary consume emitted $consume_call_count helper calls; expected 1"
    fi
    local actual_create_count actual_destroy_count
    actual_create_count="$(/usr/bin/grep -F -c 'call ptr @rawBufferCreate(' "$first" || true)"
    actual_destroy_count="$(/usr/bin/grep -F -c 'call i32 @rawBufferDestroy(ptr' "$first" || true)"
    [[ "$actual_create_count" -eq "$expected_create_count" ]] \
        || fail "$stage_label RootValue $kind emitted $actual_create_count creates; expected $expected_create_count"
    [[ "$actual_destroy_count" -eq "$expected_destroy_count" ]] \
        || fail "$stage_label RootValue $kind emitted $actual_destroy_count destructions; expected $expected_destroy_count"

    if [[ "$kind" == direct-holder ]]; then
        /usr/bin/grep -Fq '%Range.RootDirectHolder = type { ptr }' "$first" \
            || fail "$stage_label direct RootValue holder omitted its pointer layout"
    fi
    if [[ "$kind" == nested-inline ]]; then
        /usr/bin/grep -Fq '%Range.RootNestedInner = type { ptr }' "$first" \
            || fail "$stage_label nested RootValue omitted its inner layout"
        /usr/bin/grep -Fq '%Range.RootNestedOuter = type { %Range.RootNestedInner }' "$first" \
            || fail "$stage_label nested RootValue omitted its outer layout"
    fi
    if [[ "$kind" == inline-local-return ]]; then
        /usr/bin/grep -Fq '%Range.RootLocalHolder = type { ptr }' "$first" \
            || fail "$stage_label local RootValue return omitted its pointer layout"
    fi
    if [[ "$kind" == two-owned-leaves ]]; then
        /usr/bin/grep -Fq '%Range.RootTwinHolder = type { ptr, ptr }' "$first" \
            || fail "$stage_label two-leaf RootValue return omitted its exact layout"
    fi
    if [[ "$kind" == partial-sibling ]]; then
        /usr/bin/grep -Fq '%Range.RootPartialOwner = type { ptr, ptr }' "$first" \
            || fail "$stage_label partial aggregate omitted its exact two-leaf layout"
    fi
    if [[ "$kind" == boundary-forward-mixed ]]; then
        /usr/bin/grep -Fq '%Range.RootBoundaryForwardMixedResult = type { ptr, ptr, ptr }' "$first" \
            || fail "$stage_label mixed boundary forward omitted its forward/alias/local layout"
    fi
    if [[ "$kind" == boundary-forward-two-owned-inputs ]]; then
        /usr/bin/grep -Fq '%Range.RootBoundaryForwardPair = type { ptr, ptr }' "$first" \
            || fail "$stage_label two-input boundary forward omitted its exact pair layout"
    fi
    local forbidden
    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$first"; then
            fail "$stage_label RootValue $kind emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$llvm"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label RootValue $kind executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label RootValue $kind executable wrote output"
    echo "$stage_label RootValue $kind: pass (deterministic native ownership, validate/link, exit 7)"
}

audit_root_value_negative() {
    local stage_label="$1"
    local executable="$2"
    local kind="$3"
    local bundle="$WORK_ROOT/$stage_label.root-value.$kind.range"
    local first="$WORK_ROOT/$stage_label.root-value.$kind.first.out"
    local second="$WORK_ROOT/$stage_label.root-value.$kind.repeat.out"
    local first_error="$WORK_ROOT/$stage_label.root-value.$kind.first.err"
    local second_error="$WORK_ROOT/$stage_label.root-value.$kind.repeat.err"

    write_root_value_bundle "$bundle" "$kind"
    run_capture "$executable" "$bundle" "$first" "$first_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label RootValue $kind exited $RUN_STATUS"
    [[ ! -s "$first_error" ]] || fail "$stage_label RootValue $kind wrote stderr"
    /usr/bin/grep -Fq $'compilerError\t' "$first" || fail "$stage_label RootValue $kind omitted compilerError"
    if [[ "$kind" == loop-ownership-change ]]; then
        /usr/bin/grep -Fq 'kind=invalidOwnedReturnSummary' "$first" \
            || fail "$stage_label RootValue ownership-changing loop omitted invalidOwnedReturnSummary"
        /usr/bin/grep -Fq 'failureKind=proof' "$first" \
            || fail "$stage_label RootValue ownership-changing loop was not rejected by ownership proof"
        /usr/bin/grep -Fq 'detail=6' "$first" \
            || fail "$stage_label RootValue ownership-changing loop omitted proof detail 6"
    fi
    if [[ "$kind" == absent-branch-live-exit ]]; then
        /usr/bin/grep -Fq 'kind=invalidEntryOwnedPaths' "$first" \
            || fail "$stage_label RootValue $kind omitted its entry ownership diagnostic"
        /usr/bin/grep -Fq 'detail=6011' "$first" \
            || fail "$stage_label RootValue $kind omitted entry edge-projection detail 6011"
    fi
    if [[ "$kind" == absent-conditional-live ]]; then
        /usr/bin/grep -Fq 'kind=invalidFunctionReachability' "$first" \
            || fail "$stage_label RootValue $kind omitted its function ownership diagnostic"
        /usr/bin/grep -Fq 'function=rejectAbsentOrLiveTerminal' "$first" \
            || fail "$stage_label RootValue $kind omitted its failing function identity"
        /usr/bin/grep -Fq 'ownedPathStage=14' "$first" \
            || fail "$stage_label RootValue $kind omitted terminal ownership stage 14"
    fi
    if [[ "$kind" == absent-loop-live ]]; then
        /usr/bin/grep -Fq 'kind=invalidEntryOwnedPaths' "$first" \
            || fail "$stage_label RootValue $kind omitted its entry ownership diagnostic"
        /usr/bin/grep -Fq 'detail=6016' "$first" \
            || fail "$stage_label RootValue $kind omitted backedge ownership detail 6016"
    fi
    if /usr/bin/grep -Fq 'define ' "$first" || /usr/bin/grep -Fq 'call ' "$first"; then
        fail "$stage_label RootValue $kind emitted LLVM before rejection"
    fi

    run_capture "$executable" "$bundle" "$second" "$second_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label repeated RootValue $kind exited $RUN_STATUS"
    [[ ! -s "$second_error" ]] || fail "$stage_label repeated RootValue $kind wrote stderr"
    /usr/bin/grep -Fq $'compilerError\t' "$second" || fail "$stage_label repeated RootValue $kind omitted compilerError"
    if [[ "$kind" == loop-ownership-change ]]; then
        /usr/bin/grep -Fq 'kind=invalidOwnedReturnSummary' "$second" \
            || fail "$stage_label repeated RootValue ownership-changing loop omitted invalidOwnedReturnSummary"
        /usr/bin/grep -Fq 'failureKind=proof' "$second" \
            || fail "$stage_label repeated RootValue ownership-changing loop was not rejected by ownership proof"
        /usr/bin/grep -Fq 'detail=6' "$second" \
            || fail "$stage_label repeated RootValue ownership-changing loop omitted proof detail 6"
    fi
    if [[ "$kind" == absent-branch-live-exit ]]; then
        /usr/bin/grep -Fq 'kind=invalidEntryOwnedPaths' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted its entry ownership diagnostic"
        /usr/bin/grep -Fq 'detail=6011' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted entry edge-projection detail 6011"
    fi
    if [[ "$kind" == absent-conditional-live ]]; then
        /usr/bin/grep -Fq 'kind=invalidFunctionReachability' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted its function ownership diagnostic"
        /usr/bin/grep -Fq 'function=rejectAbsentOrLiveTerminal' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted its failing function identity"
        /usr/bin/grep -Fq 'ownedPathStage=14' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted terminal ownership stage 14"
    fi
    if [[ "$kind" == absent-loop-live ]]; then
        /usr/bin/grep -Fq 'kind=invalidEntryOwnedPaths' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted its entry ownership diagnostic"
        /usr/bin/grep -Fq 'detail=6016' "$second" \
            || fail "$stage_label repeated RootValue $kind omitted backedge ownership detail 6016"
    fi
    if /usr/bin/grep -Fq 'define ' "$second" || /usr/bin/grep -Fq 'call ' "$second"; then
        fail "$stage_label repeated RootValue $kind emitted LLVM before rejection"
    fi
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label RootValue $kind diagnostic was not deterministic"
    echo "$stage_label RootValue $kind: pass (deterministic pre-emission rejection)"
}

audit_root_values() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"

    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" opaque-return
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" boundary-forward-direct
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" boundary-forward-transitive
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" boundary-forward-two-owned-inputs
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" boundary-forward-mixed
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" direct-holder
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" nested-inline
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" inline-local-return
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" two-owned-leaves
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" partial-sibling
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" loop-invariant
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" absent-early-return
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" absent-branch-scope
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" absent-loop-reevaluation
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" absent-returned-alias
    audit_root_value_positive "$stage_label" "$executable" "$stage_directory" boundary-consume
    # Lexical scope makes a projected-Absent symbol unnameable. Legal loop
    # reactivation and live loop re-entry therefore cover activation exactness;
    # duplicate-move and partial-double-destroy cover the spellable repeated
    # move/destroy transitions before a symbol leaves its activation region.
    # A tracked Optional fallback/join is also intentionally absent here: the
    # ordinary source surface cannot yet supply a reachable Optional-owned
    # boundary value without failing earlier at nil/injection ownership. Do not
    # disguise that gap with a retyped builtin, special root, or proof directive.
    audit_root_value_negative "$stage_label" "$executable" discarded-create
    audit_root_value_negative "$stage_label" "$executable" duplicate-move
    audit_root_value_negative "$stage_label" "$executable" missing-destroy
    audit_root_value_negative "$stage_label" "$executable" use-after-move
    audit_root_value_negative "$stage_label" "$executable" binding-as-ownership
    audit_root_value_negative "$stage_label" "$executable" partial-whole-move
    audit_root_value_negative "$stage_label" "$executable" partial-double-destroy
    audit_root_value_negative "$stage_label" "$executable" partial-use-after-destroy
    audit_root_value_negative "$stage_label" "$executable" absent-branch-live-exit
    audit_root_value_negative "$stage_label" "$executable" absent-conditional-live
    audit_root_value_negative "$stage_label" "$executable" absent-loop-live
    audit_root_value_negative "$stage_label" "$executable" loop-ownership-change
    audit_root_value_negative "$stage_label" "$executable" boundary-consume-source-destroy
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-direct-source-use
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-transitive-source-use
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-destroy
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-alias-actual
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-branch-ordinal
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-branch-mode
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-duplicate
    audit_root_value_negative "$stage_label" "$executable" boundary-forward-alias-conflict
    echo "$stage_label RootValue ownership: pass (opaque/direct/nested/local/forwarded/mixed returns, boundary consume, partial siblings, explicit Absent activation/scope/re-evaluation, branch provenance, loop invariance, fail-closed lifecycle)"
}

compare_root_value_stages() {
    local left_label="$1"
    local left_directory="$2"
    local right_label="$3"
    local right_directory="$4"
    local specification kind artifact

    for specification in \
        opaque-return:RootValueOpaqueReturn \
        boundary-forward-direct:RootValueBoundaryForwardDirect \
        boundary-forward-transitive:RootValueBoundaryForwardTransitive \
        boundary-forward-two-owned-inputs:RootValueBoundaryForwardPair \
        boundary-forward-mixed:RootValueBoundaryForwardMixed \
        direct-holder:RootValueDirectHolder \
        nested-inline:RootValueNestedInline \
        inline-local-return:RootValueInlineLocalReturn \
        two-owned-leaves:RootValueTwoOwnedLeaves \
        partial-sibling:RootValuePartialSibling \
        loop-invariant:RootValueLoopInvariant \
        absent-early-return:RootValueAbsentEarlyReturn \
        absent-branch-scope:RootValueAbsentBranchScope \
        absent-loop-reevaluation:RootValueAbsentLoopReevaluation \
        absent-returned-alias:RootValueAbsentReturnedAlias \
        boundary-consume:RootValueBoundaryConsume; do
        kind="${specification%%:*}"
        artifact="${specification#*:}"
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.root-value.$kind.first.ll" "$WORK_ROOT/$right_label.root-value.$kind.first.ll" \
            || fail "$left_label and $right_label RootValue $kind LLVM differs"
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.root-value.$kind.repeat.ll" "$WORK_ROOT/$right_label.root-value.$kind.repeat.ll" \
            || fail "$left_label and $right_label repeated RootValue $kind LLVM differs"
        /usr/bin/cmp -s "$left_directory/$artifact.ll" "$right_directory/$artifact.ll" \
            || fail "$left_label and $right_label RootValue $kind artifacts differ"
        /usr/bin/cmp -s "$left_directory/$artifact" "$right_directory/$artifact" \
            || fail "$left_label and $right_label RootValue $kind executables differ"
    done

    for kind in \
        discarded-create \
        duplicate-move \
        missing-destroy \
        use-after-move \
        binding-as-ownership \
        partial-whole-move \
        partial-double-destroy \
        partial-use-after-destroy \
        absent-branch-live-exit \
        absent-conditional-live \
        absent-loop-live \
        loop-ownership-change \
        boundary-consume-source-destroy \
        boundary-forward-direct-source-use \
        boundary-forward-transitive-source-use \
        boundary-forward-destroy \
        boundary-forward-alias-actual \
        boundary-forward-branch-ordinal \
        boundary-forward-branch-mode \
        boundary-forward-duplicate \
        boundary-forward-alias-conflict; do
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.root-value.$kind.first.out" "$WORK_ROOT/$right_label.root-value.$kind.first.out" \
            || fail "$left_label and $right_label RootValue $kind diagnostics differ"
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.root-value.$kind.repeat.out" "$WORK_ROOT/$right_label.root-value.$kind.repeat.out" \
            || fail "$left_label and $right_label repeated RootValue $kind diagnostics differ"
    done
    echo "$left_label/$right_label RootValue ownership: byte-identical LLVM/executables/diagnostics"
}

write_macro_positive_bundle() {
    local output="$1"
    local order="${2:-normal}"

    : > "$output"
    /usr/bin/printf '%s\n' \
        'compilerMacroSnapshot' >> "$output"
    if [[ "$order" == "reordered" ]]; then
        /usr/bin/printf '%s\n' \
            'compilerSourceFile\trole=foundation\tpath=Foundation/Unrelated.range' \
            'construct Unrelated {}' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=core\tpath=Core/Macro.range' \
        'open macro CrossConstruct(): Construct -> Void {}' \
        'macro CrossFunction(): Function -> Void {}' \
        'macro CrossMember(): Member -> Void {}' \
        'macro CrossParameter(value: Int): Parameter -> Void {}' >> "$output"
    if [[ "$order" != "reordered" ]]; then
        /usr/bin/printf '%s\n' \
            'compilerSourceFile\trole=foundation\tpath=Foundation/Unrelated.range' \
            'construct Unrelated {}' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=project\tpath=Project/MacroUse.range' \
        '@CrossConstruct' \
        'construct First {' \
        '    @CrossMember' \
        '    let value: Int' \
        '}' \
        '@CrossConstruct' \
        'construct Second {}' \
        '@CrossFunction' \
        'function target(@CrossParameter value: Int): Int { return 1 }' >> "$output"
}

write_macro_negative_bundle() {
    local output="$1"
    local kind="$2"

    case "$kind" in
        unresolved)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Known.range' \
                'macro Known(): Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/Missing.range' \
                '@Missing' \
                'construct Target {}' > "$output"
            ;;
        duplicate)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/First.range' \
                'macro Dup(): Construct -> Void {}' \
                'compilerSourceFile\trole=foundation\tpath=Foundation/Second.range' \
                'macro Dup(): Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/Duplicate.range' \
                '@Dup' \
                'construct Target {}' > "$output"
            ;;
        malformed-declaration)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Broken.range' \
                'macro Broken(: Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/BrokenUse.range' \
                'construct Target {}' > "$output"
            ;;
        malformed-application)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Known.range' \
                'macro Known(): Construct -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/BrokenApplication.range' \
                '@Known(' \
                'construct Target {}' > "$output"
            ;;
        mismatch)
            /usr/bin/printf '%s\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/FunctionOnly.range' \
                'macro FunctionOnly(): Function -> Void {}' \
                'compilerSourceFile\trole=project\tpath=Project/WrongTarget.range' \
                '@FunctionOnly' \
                'construct Target {}' > "$output"
            ;;
        *)
            fail "unknown macro negative fixture: $kind"
            ;;
    esac
}

audit_macro_linking() {
    local stage_label="$1"
    local executable="$2"
    local positive_bundle="$WORK_ROOT/$stage_label.macro.positive.range"
    local first="$WORK_ROOT/$stage_label.macro.positive.first.out"
    local second="$WORK_ROOT/$stage_label.macro.positive.second.out"
    local first_error="$WORK_ROOT/$stage_label.macro.positive.first.err"
    local second_error="$WORK_ROOT/$stage_label.macro.positive.second.err"
    local reordered_bundle="$WORK_ROOT/$stage_label.macro.positive.reordered.range"
    local reordered_output="$WORK_ROOT/$stage_label.macro.positive.reordered.out"
    local reordered_error="$WORK_ROOT/$stage_label.macro.positive.reordered.err"
    local first_projection="$WORK_ROOT/$stage_label.macro.positive.projection.out"
    local reordered_projection="$WORK_ROOT/$stage_label.macro.positive.reordered.projection.out"

    write_macro_positive_bundle "$positive_bundle"
    run_capture "$executable" "$positive_bundle" "$first" "$first_error"
    require_successful_output "$stage_label macro positive" "$first" "$first_error"
    run_capture "$executable" "$positive_bundle" "$second" "$second_error"
    require_successful_output "$stage_label repeated macro positive" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label macro snapshot was not deterministic"
    /usr/bin/grep -Fq $'macroGraph\tvalid=true\tdeclarationCount=4\tparameterCount=1\tapplicationCount=5\tedgeCount=10\tappliesToCount=5\tresolvedByCount=5\tdigest=' "$first" || fail "$stage_label macro positive counts/digest changed"
    for expected in \
        $'macroGraph\tvalid=true' \
        $'declarationCount=4' \
        $'parameterCount=1' \
        $'applicationCount=5' \
        $'edgeCount=10' \
        $'appliesToCount=5' \
        $'resolvedByCount=5' \
        $'digest='; do
        /usr/bin/grep -Fq "$expected" "$first" || fail "$stage_label macro positive missing: $expected"
    done
    /usr/bin/grep -Fq $'macroStableProjection\tidentityDigest=' "$first" || fail "$stage_label macro positive missing stable identity projection"

    write_macro_positive_bundle "$reordered_bundle" reordered
    run_capture "$executable" "$reordered_bundle" "$reordered_output" "$reordered_error"
    require_successful_output "$stage_label reordered macro positive" "$reordered_output" "$reordered_error"
    /usr/bin/grep -F 'macroStableProjection' "$first" > "$first_projection" || fail "$stage_label missing first stable projection"
    /usr/bin/grep -F 'macroStableProjection' "$reordered_output" > "$reordered_projection" || fail "$stage_label missing reordered stable projection"
    /usr/bin/cmp -s "$first_projection" "$reordered_projection" || fail "$stage_label reordered macro identity projection changed"

    local kind negative_bundle negative_output negative_error expected
    for kind in unresolved duplicate malformed-declaration malformed-application mismatch; do
        negative_bundle="$WORK_ROOT/$stage_label.macro.$kind.range"
        negative_output="$WORK_ROOT/$stage_label.macro.$kind.out"
        negative_error="$WORK_ROOT/$stage_label.macro.$kind.err"
        write_macro_negative_bundle "$negative_bundle" "$kind"
        run_capture "$executable" "$negative_bundle" "$negative_output" "$negative_error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label macro $kind exited $RUN_STATUS"
        [[ ! -s "$negative_error" ]] || fail "$stage_label macro $kind wrote stderr"
        case "$kind" in
            unresolved) expected='diagnosticKind=unresolvedMacro' ;;
            duplicate) expected='diagnosticKind=ambiguousMacroDeclaration' ;;
            malformed-declaration) expected='diagnosticKind=malformedMacroDeclaration' ;;
            malformed-application) expected='diagnosticKind=malformedMacroApplication' ;;
            mismatch) expected='diagnosticKind=macroTargetSurfaceMismatch' ;;
        esac
        /usr/bin/grep -Fq "$expected" "$negative_output" || fail "$stage_label macro $kind missed diagnostic $expected"
        if /usr/bin/grep -Fq 'define ' "$negative_output" || /usr/bin/grep -Fq 'call ' "$negative_output"; then
            fail "$stage_label macro $kind emitted LLVM before rejection"
        fi
    done
    echo "$stage_label macro linking: pass (cross-role positive, deterministic identities/ordinals, unresolved/ambiguous/malformed/mismatch rejection)"
}

write_macro_execution_bundle() {
    local output="$1"
    local kind="$2"

    case "$kind" in
        positive)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Diagnostic.range' \
                'macro Signal(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.information("checked")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DiagnosticUse.range' \
                '@Signal' \
                'construct Target {}' > "$output"
            ;;
        multiple)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Diagnostics.range' \
                'macro Signal(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.information("checked")' \
                '}' \
                'macro Notice(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.warning("noticed")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DiagnosticsUse.range' \
                '@Signal' \
                'construct Target {}' \
                '@Notice' \
                'construct Other {}' > "$output"
            ;;
        query)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQuery.range' \
                'macro Observe(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Observed")' \
                '    return diagnostics.information("observed")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryUse.range' \
                '@Observe' \
                'construct Target {}' \
                'construct Observed {}' > "$output"
            ;;
        query-reordered)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=foundation\tpath=Foundation/Unrelated.range' \
                'construct Unrelated {}' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQuery.range' \
                'macro Observe(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Observed")' \
                '    return diagnostics.information("observed")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryUse.range' \
                '@Observe' \
                'construct Target {}' \
                'construct Observed {}' > "$output"
            ;;
        query-zero)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQueryZero.range' \
                'macro ObserveMissing(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Missing")' \
                '    return diagnostics.information("observed zero")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryZeroUse.range' \
                '@ObserveMissing' \
                'construct Target {}' > "$output"
            ;;
        member-present)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQuery.range' \
                'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return diagnostics.error("missing required member")' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryUse.range' \
                '@RequireMember' \
                'construct Target {' \
                '    let required: Int' \
                '}' > "$output"
            ;;
        member-present-reordered)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=foundation\tpath=Foundation/UnrelatedMemberQuery.range' \
                'construct Unrelated {}' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQuery.range' \
                'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return diagnostics.error("missing required member")' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryUse.range' \
                '@RequireMember' \
                'construct Target {' \
                '    let required: Int' \
                '}' > "$output"
            ;;
        member-missing)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryMissing.range' \
                'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return diagnostics.error("missing required member")' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryMissingUse.range' \
                '@RequireMember' \
                'construct Target {}' > "$output"
            ;;
        member-path)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryPath.range' \
                'macro RequireMemberPath(): Construct -> Void { target, diagnostics, graph in' \
                '    if target.memberCount("required") == 0 {' \
                '        return target.replace()' \
                '    }' \
                '    return diagnostics.information("validated")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryPathUse.range' \
                '@RequireMemberPath' \
                'construct Target {' \
                '    let required: Int' \
                '}' > "$output"
            ;;
        member-invalid)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryInvalid.range' \
                'macro RequireMemberInvalid(): Construct -> Void { target, diagnostics, graph in' \
                '    target.memberCount()' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryInvalidUse.range' \
                '@RequireMemberInvalid' \
                'construct Target {}' > "$output"
            ;;
        member-invalid-type)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryInvalidType.range' \
                'macro RequireMemberInvalidType(): Construct -> Void { target, diagnostics, graph in' \
                '    target.memberCount(1)' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryInvalidTypeUse.range' \
                '@RequireMemberInvalidType' \
                'construct Target {}' > "$output"
            ;;
        member-nonconstruct)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MemberQueryNonConstruct.range' \
                'macro RequireMemberNonConstruct(): Function -> Void { target, diagnostics, graph in' \
                '    target.memberCount("required")' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MemberQueryNonConstructUse.range' \
                '@RequireMemberNonConstruct' \
                'function Target(): Int { return 7 }' > "$output"
            ;;
        query-invalid)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/GraphQueryInvalid.range' \
                'macro ObserveInvalid(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Unknown", "Missing")' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/GraphQueryInvalidUse.range' \
                '@ObserveInvalid' \
                'construct Target {}' > "$output"
            ;;
        expansion)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Expansion.range' \
                'macro OmitObserved(): Construct -> Void { target, diagnostics, graph in' \
                '    graph.declarationCount("Construct", "Observed")' \
                '    target.omit()' \
                '    return diagnostics.information("omitted")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/ExpansionUse.range' \
                '@OmitObserved' \
                'construct Target {}' \
                'construct Observed {}' > "$output"
            ;;
        expansion-duplicate)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/DuplicateExpansion.range' \
                'macro OmitTwice(): Construct -> Void { target, diagnostics, graph in' \
                '    target.omit()' \
                '    target.omit()' \
                '    return diagnostics.information("unreachable")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DuplicateExpansionUse.range' \
                '@OmitTwice' \
                'construct Target {}' > "$output"
            ;;
        target-denied)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/TargetDenied.range' \
                'macro ReplaceDenied(): Construct -> Void { target, diagnostics, graph in' \
                '    return target.replace()' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/TargetDeniedUse.range' \
                '@ReplaceDenied' \
                'construct Target {}' > "$output"
            ;;
        error)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Reject.range' \
                'macro Reject(): Construct -> Void { target, diagnostics, graph in' \
                '    return diagnostics.error("rejected")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/RejectUse.range' \
                '@Reject' \
                'construct Target {}' > "$output"
            ;;
        denied)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Denied.range' \
                'macro Probe(): Construct -> Void { target, diagnostics, graph in' \
                '    return graph.macros()' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DeniedUse.range' \
                '@Probe' \
                'construct Target {}' > "$output"
            ;;
        fuel)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/Fuel.range' \
                'macro Exhaust(): Construct -> Void { target, diagnostics, graph in' > "$output"
            local index=0
            while [[ "$index" -lt 70 ]]; do
                /usr/bin/printf '    diagnostics.information("step%s")\n' "$index" >> "$output"
                index=$((index + 1))
            done
            /usr/bin/printf '%b\n' \
                '    return diagnostics.information("tail")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/FuelUse.range' \
                '@Exhaust' \
                'construct Target {}' >> "$output"
            ;;
        malformed-header)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/MalformedHeader.range' \
                'macro Broken(): Construct -> Void { target in' \
                '    return diagnostics.information("bad")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/MalformedHeaderUse.range' \
                '@Broken' \
                'construct Target {}' > "$output"
            ;;
        duplicate-header)
            /usr/bin/printf '%b\n' \
                'compilerMacroSnapshot' \
                'compilerSourceFile\trole=core\tpath=Core/DuplicateHeader.range' \
                'macro Duplicate(): Construct -> Void { target, target, graph in' \
                '    return diagnostics.information("bad")' \
                '}' \
                'compilerSourceFile\trole=project\tpath=Project/DuplicateHeaderUse.range' \
                '@Duplicate' \
                'construct Target {}' > "$output"
            ;;
        *)
            fail "unknown macro execution fixture: $kind"
            ;;
    esac
}

write_macro_execution_llvm_bundle() {
    local output="$1"
    local kind="$2"
    local temporary="$output.tmp"

    write_macro_execution_bundle "$output" "$kind"
    /usr/bin/sed '1s/^compilerMacroSnapshot$/compilerNativeSourceSetLLVMText/' "$output" > "$temporary"
    /bin/mv "$temporary" "$output"
}

write_macro_execution_native_integration_bundle() {
    local output="$1"

    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/DiagnosticNative.range' \
        'macro Signal(): Construct -> Void { target, diagnostics, graph in' \
        '    graph.declarationCount("Construct", "Target")' \
        '    return diagnostics.information("checked")' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/DiagnosticNativeUse.range' \
        '@Signal' \
        'construct Target {}' \
        '' \
        '@main {' \
        '    return 7' \
        '}' > "$output"
}

write_macro_execution_native_member_bundle() {
    local output="$1"
    local kind="$2"

    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/MemberQueryNative.range' \
        'macro RequireMember(): Construct -> Void { target, diagnostics, graph in' \
        '    if target.memberCount("required") == 0 {' \
        '        return diagnostics.error("missing required member")' \
        '    }' \
        '    return diagnostics.information("validated")' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/MemberQueryNativeUse.range' \
        '@RequireMember' \
        'construct Target {' > "$output"
    if [[ "$kind" == present ]]; then
        /usr/bin/printf '%b\n' \
            '    let required: Int' \
            '}' \
            '' \
            '@main {' \
            '    return 7' \
            '}' >> "$output"
    else
        /usr/bin/printf '%b\n' \
            '}' \
            '' \
            '@main {' \
            '    return 7' \
            '}' >> "$output"
    fi
}

write_macro_expansion_commit_bundle() {
    local output="$1"

    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/ExpansionCommit.range' \
        'macro OmitConstruct(): Construct -> Void { target, diagnostics, graph in' \
        '    graph.declarationCount("Construct", "Hidden")' \
        '    target.omit()' \
        '    return diagnostics.information("omitted construct")' \
        '}' \
        'macro OmitMember(): Member -> Void { target, diagnostics, graph in' \
        '    target.omit()' \
        '    return diagnostics.information("omitted member")' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/ExpansionCommitUse.range' \
        '@OmitConstruct' \
        'construct Hidden {' \
        '    let value: Int' \
        '}' \
        'construct Retained {' \
        '    @OmitMember' \
        '    let removed: Int' \
        '    let value: Int' \
        '}' \
        '' \
        '@main {' \
        '    return 7' \
        '}' > "$output"
}

write_macro_generated_function_bundle() {
    local output="$1"
    local kind="${2:-positive}"
    local header="${3-compilerMacroSnapshot}"
    local order="${4:-normal}"

    : > "$output"
    if [[ -n "$header" ]]; then
        /usr/bin/printf '%s\n' "$header" > "$output"
    fi
    if [[ "$order" == reordered ]]; then
        /usr/bin/printf '%b\n' \
            'compilerSourceFile\trole=foundation\tpath=Foundation/UnrelatedGenerated.range' \
            'macro unrelatedGenerated(): Construct { target, diagnostics in' \
            '    @expand {' \
            '        function unrelatedFunction(): Int {' \
            '            return 11' \
            '        }' \
            '    }' \
            '}' \
            '' \
            'construct UnrelatedGenerated {}' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=core\tpath=Core/Registrable.range' \
        'macro registrable(): Construct { target, diagnostics in' \
        '    @expand {' \
        '        function globalFunction(input: Int): Int {' \
        '            let adjusted: Int(input + 2)' \
        '            return adjusted + 1' \
        '        }' \
        '    }' \
        '    @expand {' \
        '        extension #(target.declaration.self) {' \
        '            function memberFunction(delta: Int): Int {' \
        '                return delta + 3' \
        '            }' \
        '        }' \
        '    }' \
        '}' >> "$output"
    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=project\tpath=Project/RegistrableUse.range' >> "$output"
    /usr/bin/printf '%b\n' \
        '@registrable' \
        'construct User {' >> "$output"
    /usr/bin/printf '%b\n' \
        '    let seed: Int' >> "$output"
    if [[ "$kind" == member-collision ]]; then
        /usr/bin/printf '%b\n' \
            '    function memberFunction(): Int {' \
            '        return 99' \
            '    }' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        '}' \
        '' >> "$output"
    if [[ "$kind" == root-collision ]]; then
        /usr/bin/printf '%b\n' \
            'function globalFunction(): Int {' \
            '    return 99' \
            '}' \
            '' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        '@main {' \
        '    let user: User(seed: 0)' >> "$output"
    if [[ "$kind" == positive ]]; then
        /usr/bin/printf '%b\n' \
            '    return globalFunction(input: 4) + user.memberFunction(delta: 0)' >> "$output"
    elif [[ "$kind" == bare ]]; then
        /usr/bin/printf '%b\n' \
            '    return memberFunction()' >> "$output"
    elif [[ "$kind" == user-global ]]; then
        /usr/bin/printf '%b\n' \
            '    return user.globalFunction()' >> "$output"
    else
        /usr/bin/printf '%b\n' \
            '    return 0' >> "$output"
    fi
    /usr/bin/printf '%b\n' '}' >> "$output"
}

write_macro_registrable_bundle() {
    local output="$1"
    local kind="${2:-positive}"
    local header="${3-compilerMacroSnapshot}"
    local order="${4:-normal}"

    : > "$output"
    if [[ -n "$header" ]]; then
        /usr/bin/printf '%s\n' "$header" > "$output"
    fi
    if [[ "$order" == reordered ]]; then
        /usr/bin/printf '%b\n' \
            'compilerSourceFile\trole=foundation\tpath=Foundation/UnrelatedRegistrable.range' \
            'macro unrelatedRegistrable(): Construct { target, diagnostics in' \
            '    @expand {' \
            '        function unrelatedRegistrableFunction(): Int {' \
            '            return 11' \
            '        }' \
            '    }' \
            '}' \
            '' \
            'construct UnrelatedRegistrable {}' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=foundation\tpath=Foundation/Macros/Registrable.range' >> "$output"
    /bin/cat "$REPO_ROOT/RangeCompiler/Sources/Foundation/Macros/Registrable.range" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$REPO_ROOT/RangeCompiler/Sources/Foundation/Macros/Registrable.range")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        'compilerSourceFile\trole=project\tpath=Project/RegistrableUse.range' \
        '' >> "$output"
    if [[ "$kind" == generated-field-collision ]]; then
        /usr/bin/printf '%b\n' '@registrable' '@registrable' >> "$output"
    else
        /usr/bin/printf '%b\n' '@registrable' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        'construct User {' \
        '    let name: Int' >> "$output"
    if [[ "$kind" == authored-field-collision ]]; then
        /usr/bin/printf '%b\n' '    let registrationSeed: Int' >> "$output"
    fi
    if [[ "$kind" == immutable-field-mutation ]]; then
        /usr/bin/printf '%b\n' \
            '    function mutate(): Int {' \
            '        self.registrationSeed: 4' \
            '        return 0' \
            '    }' >> "$output"
    fi
    /usr/bin/printf '%b\n' \
        '}' \
        '' \
        '@main {' \
        '    let user: User(name: 1, registrationSeed: 3, registrationCount: 2)' >> "$output"
    if [[ "$kind" == positive ]]; then
        /usr/bin/printf '%b\n' \
            '    user.register(delta: 1)' \
            '    return user.register(delta: 1)' >> "$output"
    elif [[ "$kind" == immutable-field-mutation ]]; then
        /usr/bin/printf '%b\n' '    return user.mutate()' >> "$output"
    else
        /usr/bin/printf '%b\n' '    return 0' >> "$output"
    fi
    /usr/bin/printf '%b\n' '}' >> "$output"
}

write_macro_registrable_root_storage_bundle() {
    local output="$1"
    /usr/bin/printf '%b\n' \
        'compilerMacroSnapshot' \
        'compilerSourceFile\trole=core\tpath=Core/RootStorage.range' \
        'macro rootStorage(): Construct { target, diagnostics in' \
        '    @expand {' \
        '        let rootValue: Int' \
        '    }' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/RootStorageUse.range' \
        '@rootStorage' \
        'construct User {}' \
        '' \
        '@main {' \
        '    return 0' \
        '}' > "$output"
}

write_macro_registrable_malformed_splice_bundle() {
    local output="$1"
    /usr/bin/printf '%b\n' \
        'compilerMacroSnapshot' \
        'compilerSourceFile\trole=core\tpath=Core/MalformedMemberSplice.range' \
        'macro malformedMember(): Construct { target, diagnostics in' \
        '    @expand {' \
        '        extension #(target.declaration.bad) {' \
        '            let registrationSeed: Int' \
        '        }' \
        '    }' \
        '}' \
        'compilerSourceFile\trole=project\tpath=Project/MalformedMemberSpliceUse.range' \
        '@malformedMember' \
        'construct User {}' \
        '' \
        '@main {' \
        '    return 0' \
        '}' > "$output"
}

audit_macro_registrable() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local snapshot_bundle="$WORK_ROOT/$stage_label.macro.registrable.snapshot.range"
    local snapshot_output="$WORK_ROOT/$stage_label.macro.registrable.snapshot.out"
    local snapshot_error="$WORK_ROOT/$stage_label.macro.registrable.snapshot.err"
    local reordered_bundle="$WORK_ROOT/$stage_label.macro.registrable.reordered.range"
    local reordered_output="$WORK_ROOT/$stage_label.macro.registrable.reordered.out"
    local reordered_error="$WORK_ROOT/$stage_label.macro.registrable.reordered.err"
    local snapshot_projection="$WORK_ROOT/$stage_label.macro.registrable.snapshot.projection"
    local reordered_projection="$WORK_ROOT/$stage_label.macro.registrable.reordered.projection"

    write_macro_registrable_bundle "$snapshot_bundle" positive compilerMacroSnapshot normal
    run_capture "$executable" "$snapshot_bundle" "$snapshot_output" "$snapshot_error"
    require_successful_output "$stage_label actual registrable snapshot" "$snapshot_output" "$snapshot_error"
    [[ "$(/usr/bin/grep -F 'macroGraphGeneratedMember' "$snapshot_output" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" -eq 2 ]] || fail "$stage_label actual registrable did not emit exactly two generated members"
    /usr/bin/grep -Fq $'macroGraphGeneratedMember\trow=0\tkind=member\townerSyntaxID=' "$snapshot_output" || fail "$stage_label generated member row 0 was not target-owned"
    /usr/bin/grep -Fq $'name=registrationSeed\tmemberKind=let\ttype=Int' "$snapshot_output" || fail "$stage_label generated immutable registrationSeed was not rendered"
    /usr/bin/grep -Fq $'name=registrationCount\tmemberKind=state\ttype=Int' "$snapshot_output" || fail "$stage_label generated mutable registrationCount was not rendered"
    /usr/bin/grep -Fq $'macroGraphGeneratedFunction\trow=0\tkind=function\townerSyntaxID=' "$snapshot_output" || fail "$stage_label generated register function was not rendered"
    /usr/bin/grep -Fq $'name=register\treturnType=Int' "$snapshot_output" || fail "$stage_label generated register function type was not rendered"
    /usr/bin/grep -E 'macroGraphGeneratedMember|macroGraphGeneratedFunction' "$snapshot_output" \
        | /usr/bin/sed -E 's/\t(row|ownerSyntaxID|macroDeclarationRow|applicationRow)=[^[:space:]]+//g' > "$snapshot_projection"

    write_macro_registrable_bundle "$reordered_bundle" positive compilerMacroSnapshot reordered
    run_capture "$executable" "$reordered_bundle" "$reordered_output" "$reordered_error"
    require_successful_output "$stage_label reordered actual registrable snapshot" "$reordered_output" "$reordered_error"
    /usr/bin/grep -E 'macroGraphGeneratedMember|macroGraphGeneratedFunction' "$reordered_output" \
        | /usr/bin/sed -E 's/\t(row|ownerSyntaxID|macroDeclarationRow|applicationRow)=[^[:space:]]+//g' > "$reordered_projection"
    /usr/bin/cmp -s "$snapshot_projection" "$reordered_projection" || fail "$stage_label actual registrable stable identities changed under unrelated source insertion"

    local native_bundle="$WORK_ROOT/$stage_label.macro.registrable.native.range"
    local native_output="$WORK_ROOT/$stage_label.macro.registrable.native.ll"
    local native_error="$WORK_ROOT/$stage_label.macro.registrable.native.err"
    local native_executable="$stage_directory/Registrable"
    local native_run_output="$WORK_ROOT/$stage_label.macro.registrable.run.out"
    local native_run_error="$WORK_ROOT/$stage_label.macro.registrable.run.err"
    write_macro_registrable_bundle "$native_bundle" positive "" normal
    run_capture "$executable" "$native_bundle" "$native_output" "$native_error"
    require_successful_output "$stage_label actual registrable native emission" "$native_output" "$native_error"
    /usr/bin/grep -Fq 'rangeConstruct' "$native_output" && fail "$stage_label actual registrable static aggregate path called rangeConstruct"
    /usr/bin/grep -E -q 'call.*@(malloc|calloc|realloc|free)' "$native_output" && fail "$stage_label actual registrable static aggregate path called an allocator"
    /bin/mkdir -p "$stage_directory"
    /bin/cp "$native_output" "$stage_directory/Registrable.ll"
    validate_llvm "$stage_directory/Registrable.ll"
    link_llvm "$stage_directory/Registrable.ll" "$native_executable"
    if "$native_executable" > "$native_run_output" 2> "$native_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label actual registrable exited $RUN_STATUS"
    [[ ! -s "$native_run_output" && ! -s "$native_run_error" ]] || fail "$stage_label actual registrable wrote output"

    local collision_kind collision_bundle collision_output collision_error
    local negative_bundle negative_output negative_error
    for collision_kind in authored-field-collision generated-field-collision; do
        collision_bundle="$WORK_ROOT/$stage_label.macro.registrable.$collision_kind.range"
        collision_output="$WORK_ROOT/$stage_label.macro.registrable.$collision_kind.out"
        collision_error="$WORK_ROOT/$stage_label.macro.registrable.$collision_kind.err"
        write_macro_registrable_bundle "$collision_bundle" "$collision_kind" "" normal
        run_capture "$executable" "$collision_bundle" "$collision_output" "$collision_error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label $collision_kind exited $RUN_STATUS"
        [[ ! -s "$collision_error" ]] || fail "$stage_label $collision_kind wrote stderr"
        /usr/bin/grep -Fq 'diagnosticKind=generatedMemberCollision' "$collision_output" || fail "$stage_label $collision_kind missed generated-member collision diagnostic"
        if /usr/bin/grep -Fq 'define ' "$collision_output" || /usr/bin/grep -Fq 'call ' "$collision_output"; then
            fail "$stage_label $collision_kind emitted LLVM before rejection"
        fi
    done

    negative_bundle="$WORK_ROOT/$stage_label.macro.registrable.immutable-field-mutation.range"
    negative_output="$WORK_ROOT/$stage_label.macro.registrable.immutable-field-mutation.out"
    negative_error="$WORK_ROOT/$stage_label.macro.registrable.immutable-field-mutation.err"
    write_macro_registrable_bundle "$negative_bundle" immutable-field-mutation "" normal
    run_capture "$executable" "$negative_bundle" "$negative_output" "$negative_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label generated let mutation exited $RUN_STATUS"
    [[ ! -s "$negative_error" ]] || fail "$stage_label generated let mutation wrote stderr"
    /usr/bin/grep -Fq 'function=mutate' "$negative_output" || fail "$stage_label generated let mutation did not identify the rejecting member function"
    if /usr/bin/grep -Fq 'define ' "$negative_output" || /usr/bin/grep -Fq 'call ' "$negative_output"; then
        fail "$stage_label generated let mutation emitted LLVM before rejection"
    fi

    negative_bundle="$WORK_ROOT/$stage_label.macro.registrable.root-storage.range"
    negative_output="$WORK_ROOT/$stage_label.macro.registrable.root-storage.out"
    negative_error="$WORK_ROOT/$stage_label.macro.registrable.root-storage.err"
    write_macro_registrable_root_storage_bundle "$negative_bundle"
    run_capture "$executable" "$negative_bundle" "$negative_output" "$negative_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label root generated storage exited $RUN_STATUS"
    [[ ! -s "$negative_error" ]] || fail "$stage_label root generated storage wrote stderr"
    if /usr/bin/grep -Fq 'define ' "$negative_output" || /usr/bin/grep -Fq 'call ' "$negative_output"; then
        fail "$stage_label root generated storage emitted LLVM before rejection"
    fi

    negative_bundle="$WORK_ROOT/$stage_label.macro.registrable.malformed-splice.range"
    negative_output="$WORK_ROOT/$stage_label.macro.registrable.malformed-splice.out"
    negative_error="$WORK_ROOT/$stage_label.macro.registrable.malformed-splice.err"
    write_macro_registrable_malformed_splice_bundle "$negative_bundle"
    run_capture "$executable" "$negative_bundle" "$negative_output" "$negative_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label malformed generated member splice exited $RUN_STATUS"
    [[ ! -s "$negative_error" ]] || fail "$stage_label malformed generated member splice wrote stderr"
    if /usr/bin/grep -Fq 'define ' "$negative_output" || /usr/bin/grep -Fq 'call ' "$negative_output"; then
        fail "$stage_label malformed generated member splice emitted LLVM before rejection"
    fi
    echo "$stage_label actual registrable macro: pass (Foundation source, let/state members, state mutation, deterministic identities, static aggregate emission, transactional collisions and rejection matrix)"
}

write_macro_expand_outside_bundle() {
    local output="$1"
    local header="${2:-compilerNativeSourceSetLLVMText}"

    /usr/bin/printf '%b\n' \
        "$header" \
        'compilerSourceFile\trole=project\tpath=Project/ExpandOutside.range' \
        'function outside(): Int {' \
        '    @expand {' \
        '        function create(): Int {' \
        '            return 7' \
        '        }' \
        '    }' \
        '    return 0' \
        '}' \
        '' \
        '@main {' \
        '    return outside()' > "$output"
}

