#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerSeed.json"
DEFAULT_COMPILER_DIR="$REPO_ROOT/RangeCompiler/Range/Programs/Compiler"

usage() {
    cat <<'USAGE'
Usage:
  scripts/check-range-compiler-candidate [DIR]
  scripts/check-range-compiler-candidate --bootstrap-bridge-source PHASE1_DIR FINAL_DIR
  scripts/check-range-compiler-candidate --help

DIR defaults to RangeCompiler/Range/Programs/Compiler.

The bootstrap bridge mode uses the manifested seed to compile an immutable
old-syntax Phase1 source bundle, audits that one-shot bridge, and uses it only
to produce the final Stage 2 candidate. It never modifies or accepts the seed.
USAGE
}

fail() {
    echo "Range compiler candidate check failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

sha256() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

bytes() {
    /usr/bin/stat -f %z "$1"
}

verify_manifest_file() {
    local key="$1"
    local label="$2"
    local relative expected actual path

    relative="$(manifest_value "$key.path")"
    expected="$(manifest_value "$key.sha256")"
    path="$REPO_ROOT/$relative"
    [[ -f "$path" ]] || fail "missing $label: $relative"
    actual="$(sha256 "$path")"
    [[ "$actual" == "$expected" ]] || fail "$label hash mismatch: $relative"
}

verify_manifest() {
    [[ "$(manifest_value formatVersion)" == "1" ]] || fail "unsupported seed manifest format"
    [[ "$(manifest_value target.platform)" == "macOS" ]] || fail "unsupported seed target platform"
    [[ "$(manifest_value target.pointerBits)" == "64" ]] || fail "unsupported seed pointer width"
    [[ "$(manifest_value runtimeABI)" == "2" ]] || fail "unsupported native runtime ABI"
    [[ "$(uname -m)" == "$(manifest_value target.architecture)" ]] || fail "seed target architecture mismatch"

    local seed_relative seed_expected seed_path seed_actual seed_bytes expected_bytes
    seed_relative="$(manifest_value seed.path)"
    seed_expected="$(manifest_value seed.sha256)"
    seed_path="$REPO_ROOT/$seed_relative"
    [[ -f "$seed_path" ]] || fail "missing checked-in seed: $seed_relative"
    seed_actual="$(sha256 "$seed_path")"
    [[ "$seed_actual" == "$seed_expected" ]] || fail "checked-in seed hash mismatch"
    seed_bytes="$(bytes "$seed_path")"
    expected_bytes="$(manifest_value seed.bytes)"
    [[ "$seed_bytes" == "$expected_bytes" ]] || fail "checked-in seed byte length mismatch"

    local clang_identity expected_clang
    clang_identity="$(clang --version | /usr/bin/head -1)"
    expected_clang="$(manifest_value producer.clang)"
    [[ "$clang_identity" == "$expected_clang"* ]] || fail "seed verifier clang mismatch: $clang_identity"

    # compilerSources hashes describe the accepted seed's provenance.
    # Candidate sources are discovered below and may differ until rollover.
    local index runtime_count
    runtime_count="$(manifest_value runtimeSources)"
    for ((index = 0; index < runtime_count; index += 1)); do
        verify_manifest_file "runtimeSources.$index" "runtime input $index"
    done
}

runtime_inputs() {
    local index runtime_count
    runtime_count="$(manifest_value runtimeSources)"
    for ((index = 0; index < runtime_count; index += 1)); do
        /usr/bin/printf '%s\n' "$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")"
    done
}

SOURCE_FILES=()
SOURCE_RELATIVE_PATHS=()
SOURCE_ROLES=()

discover_sources() {
    local directory="$1"
    local work_root="$2"
    local raw_list="$work_root/source-paths.raw"
    local sorted_list="$work_root/source-paths.sorted"
    local absolute relative

    [[ -d "$directory" ]] || fail "missing compiler directory: $directory"
    directory="$(cd "$directory" && pwd)"
    SOURCE_FILES=()
    SOURCE_RELATIVE_PATHS=()
    SOURCE_ROLES=()

    [[ -f "$CORE_SOURCE_PATH" ]] || fail "missing compiler Core source: $CORE_SOURCE_PATH"
    SOURCE_FILES+=("$CORE_SOURCE_PATH")
    SOURCE_RELATIVE_PATHS+=("$CORE_SOURCE_MARKER_PATH")
    SOURCE_ROLES+=("core")

    /usr/bin/find "$directory" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print0 > "$raw_list"
    : > "$sorted_list"
    while IFS= read -r -d '' absolute; do
        relative="${absolute#"$directory/"}"
        if [[ "$relative" == *$' '* || "$relative" == *$'\t'* || "$relative" == *$'\n'* ]]; then
            fail "Range source paths may not contain whitespace: $relative"
        fi
        /usr/bin/printf '%s\n' "$absolute" >> "$sorted_list"
    done < "$raw_list"

    while IFS= read -r absolute; do
        [[ -n "$absolute" ]] || continue
        SOURCE_FILES+=("$absolute")
        SOURCE_RELATIVE_PATHS+=("${absolute#"$directory/"}")
        SOURCE_ROLES+=("project")
    done < <(LC_ALL=C /usr/bin/sort "$sorted_list")

    [[ "${#SOURCE_FILES[@]}" -gt 0 ]] || fail "no .range source files found in: $directory"
}

write_source_bundle() {
    local output="$1"
    local index source

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        source="${SOURCE_FILES[$index]}"
        /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "${SOURCE_ROLES[$index]}" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
        /bin/cat "$source" >> "$output"
        if [[ -n "$(/usr/bin/tail -c 1 "$source")" ]]; then
            /usr/bin/printf '\n' >> "$output"
        fi
    done
}

write_inventory_bundle() {
    local output="$1"
    local index

    /usr/bin/printf '%s\n' 'compilerSourceInventory' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "${SOURCE_ROLES[$index]}" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
    done
}

write_expected_inventory() {
    local output="$1"
    local index

    /usr/bin/printf 'sourceInventory\\tprogram\\n' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'sourceFile\\tindex=%s\\trole=%s\\tpath=%s\\n' "$index" "${SOURCE_ROLES[$index]}" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
    done
    /usr/bin/printf 'sourceFileCount\\t%s\\n' "${#SOURCE_FILES[@]}" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}
run_capture() {
    local executable="$1"
    local input="$2"
    local output="$3"
    local error="$4"
    local status

    if "$executable" "$input" > "$output" 2> "$error"; then
        status=0
    else
        status=$?
    fi
    RUN_STATUS="$status"
}

require_successful_output() {
    local label="$1"
    local output="$2"
    local error="$3"

    [[ "$RUN_STATUS" -eq 0 ]] || fail "$label exited $RUN_STATUS: $(/usr/bin/head -c 240 "$output")"
    [[ ! -s "$error" ]] || fail "$label wrote stderr: $(/usr/bin/head -c 240 "$error")"
    if /usr/bin/head -1 "$output" | /usr/bin/grep -Fq 'compilerError'; then
        fail "$label emitted compilerError: $(/usr/bin/head -c 400 "$output")"
    fi
    [[ -s "$output" ]] || fail "$label emitted empty output"
}

emit_candidate_llvm() {
    local executable="$1"
    local bundle="$2"
    local output="$3"
    local label="$4"
    local captured="$WORK_ROOT/$label.llvm"
    local error="$WORK_ROOT/$label.stderr"

    run_capture "$executable" "$bundle" "$captured" "$error"
    require_successful_output "$label" "$captured" "$error"
    /bin/mkdir -p "$(dirname "$output")"
    /bin/mv "$captured" "$output"
}

validate_llvm() {
    local llvm="$1"
    local object="$WORK_ROOT/$(basename "$llvm").o"
    clang -Wno-override-module -x ir -c "$llvm" -o "$object"
    /bin/rm -f "$object"
}

link_llvm() {
    local llvm="$1"
    local executable="$2"
    local temporary="$WORK_ROOT/$(basename "$executable").tmp"

    clang -Wno-override-module "$llvm" "${RUNTIME_INPUTS[@]}" -o "$temporary"
    /bin/mkdir -p "$(dirname "$executable")"
    /bin/mv "$temporary" "$executable"
}

audit_inventory() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.inventory.out"
    local error="$WORK_ROOT/$stage_label.inventory.err"

    run_capture "$executable" "$INVENTORY_BUNDLE" "$output" "$error"
    require_successful_output "$stage_label inventory" "$output" "$error"
    /usr/bin/cmp -s "$output" "$EXPECTED_INVENTORY" || fail "$stage_label inventory differs from discovered source order"
    echo "$stage_label inventory: pass (${#SOURCE_FILES[@]} files)"
}

assert_smoke_shape() {
    local llvm="$1"
    local define_count call_count

    for marker in \
        '%Range.NativeSmokePair = type { i32, i32 }' \
        'define i32 @main() {' \
        'define void @nativeSmokeFirst(ptr %returnDestination)' \
        'define void @nativeSmokeSecond(ptr %returnDestination)' \
        '%storage0 = alloca' \
        '%storage1 = alloca' \
        'insertvalue %Range.NativeSmokePair' \
        'extractvalue'; do
        /usr/bin/grep -Fq "$marker" "$llvm" || fail "normal smoke missing LLVM marker: $marker"
    done

    define_count="$(/usr/bin/grep -F -c 'define void @nativeSmoke' "$llvm")"
    call_count="$(/usr/bin/grep -F -c 'call void @nativeSmoke' "$llvm")"
    [[ "$define_count" -eq 2 ]] || fail "normal smoke emitted $define_count native aggregate definitions"
    [[ "$call_count" -eq 2 ]] || fail "normal smoke emitted $call_count native aggregate calls"

    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$llvm"; then
            fail "normal smoke emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done
    if /usr/bin/grep -Fq '\n' "$llvm"; then
        fail "normal smoke emitted an escaped newline marker"
    fi
    if /usr/bin/grep -Fq 'call %Range.NativeSmokePair' "$llvm"; then
        fail "normal smoke used aggregate-return calls instead of caller-owned storage"
    fi
}

audit_smoke() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.smoke.first.ll"
    local second="$WORK_ROOT/$stage_label.smoke.second.ll"
    local first_error="$WORK_ROOT/$stage_label.smoke.first.err"
    local second_error="$WORK_ROOT/$stage_label.smoke.second.err"
    local smoke_llvm="$stage_directory/Smoke.ll"
    local smoke_executable="$stage_directory/Smoke"
    local run_output="$WORK_ROOT/$stage_label.smoke.run.out"
    local run_error="$WORK_ROOT/$stage_label.smoke.run.err"

    run_capture "$executable" "$SMOKE_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label normal smoke" "$first" "$first_error"
    run_capture "$executable" "$SMOKE_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated normal smoke" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label normal smoke was not deterministic"
    assert_smoke_shape "$first"

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$smoke_llvm"
    validate_llvm "$smoke_llvm"
    link_llvm "$smoke_llvm" "$smoke_executable"

    if "$smoke_executable" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label normal smoke executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label normal smoke executable wrote output"
    echo "$stage_label deterministic aggregate smoke: pass (exit 7)"
}

audit_placement_symbol_guard() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.placement-symbol-guard.first.ll"
    local second="$WORK_ROOT/$stage_label.placement-symbol-guard.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.placement-symbol-guard.first.err"
    local second_error="$WORK_ROOT/$stage_label.placement-symbol-guard.repeat.err"
    local llvm="$stage_directory/PlacementSymbolGuard.ll"
    local linked="$stage_directory/PlacementSymbolGuard"
    local run_output="$WORK_ROOT/$stage_label.placement-symbol-guard.run.out"
    local run_error="$WORK_ROOT/$stage_label.placement-symbol-guard.run.err"

    run_capture "$executable" "$PLACEMENT_GUARD_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label placement symbol guard" "$first" "$first_error"
    run_capture "$executable" "$PLACEMENT_GUARD_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated placement symbol guard" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" \
        || fail "$stage_label placement symbol guard LLVM was not deterministic"

    for marker in \
        '%Range.PlacementGuardPair = type { i32, i32 }' \
        'define void @placementGuardAggregate(ptr %returnDestination' \
        'call void @placementGuardAggregate('; do
        /usr/bin/grep -Fq "$marker" "$first" \
            || fail "$stage_label placement symbol guard omitted native marker: $marker"
    done
    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$first"; then
            fail "$stage_label placement symbol guard emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$llvm"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label placement symbol guard executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] \
        || fail "$stage_label placement symbol guard executable wrote output"
    echo "$stage_label placement symbol guard: pass (parameter declaration rows cannot become placement node IDs)"
}

compare_placement_symbol_guard_stages() {
    local left_label="$1"
    local left_directory="$2"
    local right_label="$3"
    local right_directory="$4"

    /usr/bin/cmp -s "$WORK_ROOT/$left_label.placement-symbol-guard.first.ll" "$WORK_ROOT/$right_label.placement-symbol-guard.first.ll" \
        || fail "$left_label and $right_label placement symbol guard LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/$left_label.placement-symbol-guard.repeat.ll" "$WORK_ROOT/$right_label.placement-symbol-guard.repeat.ll" \
        || fail "$left_label and $right_label repeated placement symbol guard LLVM differs"
    /usr/bin/cmp -s "$left_directory/PlacementSymbolGuard.ll" "$right_directory/PlacementSymbolGuard.ll" \
        || fail "$left_label and $right_label placement symbol guard artifacts differ"
    /usr/bin/cmp -s "$left_directory/PlacementSymbolGuard" "$right_directory/PlacementSymbolGuard" \
        || fail "$left_label and $right_label placement symbol guard executables differ"
    echo "$left_label/$right_label placement symbol guard: byte-identical LLVM/executable"
}

audit_mixed_abi() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.mixed-abi.out"
    local error="$WORK_ROOT/$stage_label.mixed-abi.err"

    run_capture "$executable" "$MIXED_ABI_SOURCE" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label mixed aggregate ABI check exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label mixed aggregate ABI check wrote stderr"
    /usr/bin/grep -Fq 'compilerError' "$output" \
        && /usr/bin/grep -Fq 'kind=representationSensitiveABICapabilityBlocked' "$output" \
        || fail "$stage_label mixed aggregate ABI check missed capability diagnostic"
    if /usr/bin/grep -Fq 'define ' "$output" || /usr/bin/grep -Fq 'call ' "$output"; then
        fail "$stage_label mixed aggregate ABI check emitted LLVM before rejection"
    fi
    echo "$stage_label mixed aggregate ABI rejection: pass (exit 65, pre-emission)"
}

body_syntax_typed_kind_count() {
    local output="$1"
    local kind="$2"

    /usr/bin/awk -F '\t' -v expected="kind=$kind" '
        $1 == "syntax" {
            for (column = 2; column <= NF; column += 1) {
                if ($column == expected) { count += 1 }
            }
        }
        END { print count + 0 }
    ' "$output"
}

body_syntax_typed_edge_role_count() {
    local output="$1"
    local role="$2"

    /usr/bin/awk -F '[=,\t]' -v expected="$role" '
        $1 == "bodyEdge" && $7 == expected { count += 1 }
        END { print count + 0 }
    ' "$output"
}

audit_body_syntax_split() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local typed_bundle="$WORK_ROOT/$stage_label.body-syntax.typed.range"
    local typed_first="$WORK_ROOT/$stage_label.body-syntax.typed.first.out"
    local typed_second="$WORK_ROOT/$stage_label.body-syntax.typed.repeat.out"
    local typed_first_error="$WORK_ROOT/$stage_label.body-syntax.typed.first.err"
    local typed_second_error="$WORK_ROOT/$stage_label.body-syntax.typed.repeat.err"
    local detached_bundle="$WORK_ROOT/$stage_label.body-syntax.detached.range"
    local detached_first="$WORK_ROOT/$stage_label.body-syntax.detached.first.ll"
    local detached_second="$WORK_ROOT/$stage_label.body-syntax.detached.repeat.ll"
    local detached_first_error="$WORK_ROOT/$stage_label.body-syntax.detached.first.err"
    local detached_second_error="$WORK_ROOT/$stage_label.body-syntax.detached.repeat.err"
    local detached_llvm="$stage_directory/BodySyntaxDetachedOffset.ll"
    local detached_executable="$stage_directory/BodySyntaxDetachedOffset"
    local detached_run_output="$WORK_ROOT/$stage_label.body-syntax.detached.run.out"
    local detached_run_error="$WORK_ROOT/$stage_label.body-syntax.detached.run.err"

    write_body_syntax_typed_replay_bundle "$typed_bundle"
    run_capture "$executable" "$typed_bundle" "$typed_first" "$typed_first_error"
    require_successful_output "$stage_label typed body syntax" "$typed_first" "$typed_first_error"
    run_capture "$executable" "$typed_bundle" "$typed_second" "$typed_second_error"
    require_successful_output "$stage_label repeated typed body syntax" "$typed_second" "$typed_second_error"
    /usr/bin/cmp -s "$typed_first" "$typed_second" || fail "$stage_label typed body syntax was not deterministic"

    /usr/bin/grep -Fq $'bodyNodeCount=13\tbodyEdgeCount=12' "$typed_first" \
        || fail "$stage_label typed body syntax changed its canonical node/edge counts"
    /usr/bin/grep -Fq $'typedTable\tname=bodyNode\tversion=1\tcolumns=11\trows=13' "$typed_first" \
        || fail "$stage_label typed body syntax omitted its canonical body-node table"
    /usr/bin/grep -Fq $'typedTable\tname=bodyEdge\tversion=1\tcolumns=4\trows=12' "$typed_first" \
        || fail "$stage_label typed body syntax omitted its canonical body-edge table"

    local specification kind expected actual
    for specification in \
        entry:1 \
        local:1 \
        return:2 \
        identifier:4 \
        application:1 \
        integerLiteral:1 \
        addition:1 \
        argument:1 \
        mainAnnotation:1; do
        kind="${specification%%:*}"
        expected="${specification#*:}"
        actual="$(body_syntax_typed_kind_count "$typed_first" "$kind")"
        [[ "$actual" -eq "$expected" ]] \
            || fail "$stage_label typed body syntax emitted $actual $kind nodes; expected $expected"
    done

    for specification in 1:3 2:1 3:2 4:1 5:1 6:1 8:1 9:1 12:1; do
        kind="${specification%%:*}"
        expected="${specification#*:}"
        actual="$(body_syntax_typed_edge_role_count "$typed_first" "$kind")"
        [[ "$actual" -eq "$expected" ]] \
            || fail "$stage_label typed body syntax emitted $actual role-$kind edges; expected $expected"
    done

    write_body_syntax_detached_interpolation_bundle "$detached_bundle"
    run_capture "$executable" "$detached_bundle" "$detached_first" "$detached_first_error"
    require_successful_output "$stage_label detached interpolation" "$detached_first" "$detached_first_error"
    run_capture "$executable" "$detached_bundle" "$detached_second" "$detached_second_error"
    require_successful_output "$stage_label repeated detached interpolation" "$detached_second" "$detached_second_error"
    /usr/bin/cmp -s "$detached_first" "$detached_second" || fail "$stage_label detached interpolation LLVM was not deterministic"
    for marker in \
        'define i32 @detachedInterpolationValue' \
        'define ptr @detachedInterpolationText' \
        'call i32 @detachedInterpolationValue' \
        'call ptr @stringFromInt' \
        'call ptr @stringConcat' \
        'call i32 @stringEqual'; do
        /usr/bin/grep -Fq "$marker" "$detached_first" \
            || fail "$stage_label detached interpolation omitted LLVM marker: $marker"
    done
    if /usr/bin/grep -Fq 'RANGE_LOWERING_PLACEHOLDER' "$detached_first"; then
        fail "$stage_label detached interpolation used a lowering placeholder"
    fi

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$detached_first" "$detached_llvm"
    validate_llvm "$detached_llvm"
    link_llvm "$detached_llvm" "$detached_executable"
    if "$detached_executable" > "$detached_run_output" 2> "$detached_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label detached interpolation executable exited $RUN_STATUS"
    [[ ! -s "$detached_run_output" && ! -s "$detached_run_error" ]] \
        || fail "$stage_label detached interpolation executable wrote output"
    echo "$stage_label body syntax replay: pass (typed nodes+edges exact; detached offset validate/link, exit 7, deterministic)"
}

compare_body_syntax_split_stages() {
    local left_label="$1"
    local left_directory="$2"
    local right_label="$3"
    local right_directory="$4"
    local suffix

    for suffix in \
        typed.first.out \
        typed.repeat.out \
        detached.first.ll \
        detached.repeat.ll; do
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.body-syntax.$suffix" "$WORK_ROOT/$right_label.body-syntax.$suffix" \
            || fail "$left_label and $right_label body syntax output differs: $suffix"
    done
    /usr/bin/cmp -s "$left_directory/BodySyntaxDetachedOffset.ll" "$right_directory/BodySyntaxDetachedOffset.ll" \
        || fail "$left_label and $right_label detached interpolation artifacts differ"
    /usr/bin/cmp -s "$left_directory/BodySyntaxDetachedOffset" "$right_directory/BodySyntaxDetachedOffset" \
        || fail "$left_label and $right_label detached interpolation executables differ"
    echo "$left_label/$right_label body syntax replay: byte-identical typed snapshots/LLVM/executable"
}

audit_builtin_marker() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.builtin.legacy.out"
    local error="$WORK_ROOT/$stage_label.builtin.legacy.err"

    run_capture "$executable" "$LEGACY_LANGUAGE_SOURCE" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label legacy language marker exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label legacy language marker wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedSyntaxSnapshot' "$output" \
        || fail "$stage_label legacy language marker granted builtin provenance"
    echo "$stage_label builtin marker: pass (legacy spelling rejected)"
}

write_role_bundle() {
    local output="$1"
    local directive="$2"

    /usr/bin/printf '%s\n' \
        "$directive" \
        'compilerSourceFile\trole=core\tpath=Core.range' \
        'construct RoleCore {}' \
        'compilerSourceFile\trole=foundation\tpath=Foundation.range' \
        'construct RoleFoundation {}' \
        'compilerSourceFile\trole=generated\tpath=Generated.range' \
        'construct RoleGenerated {}' \
        'compilerSourceFile\trole=project\tpath=Project.range' \
        'construct RoleProject {}' \
        'compilerSourceFile\tLegacy.range' \
        'construct RoleLegacy {}' > "$output"
}

write_fingerprint_bundle() {
    local output="$1"
    local role="$2"

    /usr/bin/printf '%s\n' \
        'compilerTypedSyntax' \
        "compilerSourceFile\\trole=$role\\tpath=Fingerprint.range" \
        'construct FingerprintRole {}' > "$output"
}

write_invalid_role_bundle() {
    local output="$1"
    local marker="$2"

    /usr/bin/printf '%s\n' \
        'compilerSourceInventory' \
        "$marker" \
        'construct InvalidRole {}' > "$output"
}

write_core_bundle() {
    local output="$1"
    local directive="$2"

    if [[ -n "$directive" ]]; then
        /usr/bin/printf '%s\n' "$directive" > "$output"
    else
        /usr/bin/printf '%s' '' > "$output"
    fi
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Range/Core/System/Memory/RawBuffer.range' >> "$output"
    /bin/cat "$CORE_SOURCE_PATH" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$CORE_SOURCE_PATH")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=project\tpath=CoreUse.range' \
        'function MainTextDecoy(): Int { return stringLength(value: " @main ") }' \
        '@main {' \
        '    let buffer: RawBuffer(rawBufferCreate(capacity: 0, stride: 4))' \
        '    return rawBufferDestroy(buffer: buffer) + 7' \
        '}' >> "$output"
}

write_body_syntax_typed_replay_bundle() {
    local output="$1"

    /usr/bin/printf '%s\n' 'compilerTypedSyntax' > "$output"
    /bin/cat >> "$output" <<'RANGE'
function bodySyntaxParityValue(value: Int): Int {
    let doubled: Int(value + value)
    return doubled
}

@main {
    return bodySyntaxParityValue(value: 7)
}
RANGE
}

write_body_syntax_detached_interpolation_bundle() {
    local output="$1"

    /bin/cat > "$output" <<'RANGE'
function detachedInterpolationValue(): Int {
    return 6
}

function detachedInterpolationText(): String {
    return "detached-offset-prefix \(detachedInterpolationValue() + 1)"
}

@main {
    let rendered: String(detachedInterpolationText())
    if rendered == "detached-offset-prefix 7" {
        return 7
    }
    return 1
}
RANGE
}

write_binding_reference_bundle() {
    local output="$1"
    local kind="$2"

    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Range/Core/System/Memory/RawBuffer.range' > "$output"
    /bin/cat "$CORE_SOURCE_PATH" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$CORE_SOURCE_PATH")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=project\tpath=BindingReference.range' >> "$output"

    case "$kind" in
        local)
            /bin/cat >> "$output" <<'RANGE'
construct LocalBufferView {
    binding storage: RawBuffer
}

function bindingReadCount(buffer: RawBuffer): Int {
    return rawBufferCount(buffer: buffer)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let view: LocalBufferView(LocalBufferView(storage: $source))
    let count: Int(bindingReadCount(buffer: view.storage))
    let value: Int(rawBufferLoadInt(buffer: source, index: 0))
    rawBufferDestroy(buffer: source)
    return value + count - 1
}
RANGE
            ;;
        member)
            /bin/cat >> "$output" <<'RANGE'
construct BufferHolder {
    let storage: RawBuffer
}

construct MemberBufferView {
    binding storage: RawBuffer
}

function bindingReadFirst(buffer: RawBuffer): Int {
    return rawBufferLoadInt(buffer: buffer, index: 0)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let holder: BufferHolder(BufferHolder(storage: source))
    let view: MemberBufferView(MemberBufferView(storage: $holder.storage))
    let value: Int(bindingReadFirst(buffer: view.storage))
    rawBufferDestroy(buffer: holder.storage)
    return value
}
RANGE
            ;;
        missing-dollar)
            /bin/cat >> "$output" <<'RANGE'
construct MissingDollarView {
    binding storage: RawBuffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let view: MissingDollarView(MissingDollarView(storage: source))
    return 0
}
RANGE
            ;;
        alias-destroy)
            /bin/cat >> "$output" <<'RANGE'
construct DestroyAliasView {
    binding storage: RawBuffer
}

