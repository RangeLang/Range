        '    case .red:' \
        '        return 1' \
        '    case .yellow:' \
        '        return 2' \
        '    case .blue:' \
        '        return 3' \
        '    }' \
        '}' > "$SWITCH_ENUM_UNKNOWN_SOURCE"
    ENUM_DUPLICATE_DECLARATION_SOURCE="$WORK_ROOT/EnumDuplicateDeclarationNegative.range"
    /usr/bin/printf '%s\n' \
        'enum TrafficLight {' \
        '    case red' \
