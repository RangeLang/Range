RANGE
            ;;
        multi-alias-return)
            /bin/cat >> "$output" <<'RANGE'
construct BoundaryBufferOwners {
    let first: RawBuffer
    let second: RawBuffer
}

construct BoundaryBufferView {
    binding first: RawBuffer
    binding second: RawBuffer
}

function returnBoundaryBufferView(owners: BoundaryBufferOwners): BoundaryBufferView {
    let view: BoundaryBufferView(BoundaryBufferView(first: $owners.first, second: $owners.second))
    return view
