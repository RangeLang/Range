RANGE
            ;;
        absent-branch-scope)
            /bin/cat >> "$output" <<'RANGE'
construct AbsentBranchAliasView {
    binding storage: RawBuffer
}

function absentBranchScope(buffer: RawBuffer, flag: Bool): Int {
    state result: Int(7)
    if flag {
        let branchOwner: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
        rawBufferAppendInt(buffer: branchOwner, value: 7)
        result: rawBufferLoadInt(buffer: branchOwner, index: 0)
        rawBufferDestroy(buffer: branchOwner)
    } else {
        let branchAlias: AbsentBranchAliasView(storage: $buffer)
        result: rawBufferLoadInt(buffer: branchAlias.storage, index: 0)
    }
    return result
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let ownedBranch: Int(absentBranchScope(buffer: source, flag: true))
    let aliasBranch: Int(absentBranchScope(buffer: source, flag: false))
    rawBufferDestroy(buffer: source)
    return ownedBranch + aliasBranch - 7
}
RANGE
            ;;
        absent-loop-reevaluation)
            /bin/cat >> "$output" <<'RANGE'
function absentLoopReevaluation(): Int {
    state index: Int(0)
    state total: Int(0)
    while index < 2 {
        let iteration: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
        rawBufferAppendInt(buffer: iteration, value: 3 + index)
        total: total + rawBufferLoadInt(buffer: iteration, index: 0)
        rawBufferDestroy(buffer: iteration)
        index: index + 1
    }
    return total
}

@main {
    return absentLoopReevaluation()
