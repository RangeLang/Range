#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$REPO_ROOT/RangeCompiler/Bootstrap/RangeCompilerSeed.json"
DEFAULT_COMPILER_DIR="$REPO_ROOT/RangeCompiler/Sources/Compiler"
COMPILER_OPTIMIZATION="-O2"
COMPILER_LTO="-flto=thin"

usage() {
    cat <<'USAGE'
Usage:
  scripts/check-range-compiler-candidate [DIR]
  scripts/check-range-compiler-candidate --checkpoint stage2-plan [DIR]
  scripts/check-range-compiler-candidate --bootstrap-bridge-source PHASE1_DIR FINAL_DIR
  scripts/check-range-compiler-candidate --help

DIR defaults to RangeCompiler/Sources/Compiler. The stage2-plan checkpoint
stops after the manifested seed has emitted, validated, and linked Stage 2 and
Stage 2 has read the canonical candidate build plan.

The bootstrap bridge mode uses the manifested seed to compile an immutable
old-syntax Phase1 source bundle, audits that one-shot bridge, and uses it only
to produce the final Stage 2 candidate. It never modifies or accepts the seed.
USAGE
}

fail() {
    echo "Range compiler candidate check failed: $*" >&2
    exit 1
}

manifest_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$MANIFEST"
}

sha256() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

bytes() {
    /usr/bin/stat -f %z "$1"
}

sha256_text() {
    /usr/bin/printf '%s' "$1" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
}

bytes_text() {
    /usr/bin/printf '%s' "$1" | /usr/bin/wc -c | /usr/bin/tr -d ' '
}

verify_manifest_file() {
    local key="$1"
    local label="$2"
    local relative expected actual path

    relative="$(manifest_value "$key.path")"
    expected="$(manifest_value "$key.sha256")"
    path="$REPO_ROOT/$relative"
    [[ -f "$path" ]] || fail "missing $label: $relative"
    actual="$(sha256 "$path")"
    [[ "$actual" == "$expected" ]] || fail "$label hash mismatch: $relative"
}

verify_manifest() {
    [[ "$(manifest_value formatVersion)" == "1" ]] || fail "unsupported seed manifest format"
    [[ "$(manifest_value target.platform)" == "macOS" ]] || fail "unsupported seed target platform"
    [[ "$(manifest_value target.pointerBits)" == "64" ]] || fail "unsupported seed pointer width"
    [[ "$(manifest_value runtimeABI)" == "2" ]] || fail "unsupported native runtime ABI"
    [[ "$(uname -m)" == "$(manifest_value target.architecture)" ]] || fail "seed target architecture mismatch"

    local seed_relative seed_expected seed_path seed_actual seed_bytes expected_bytes
    seed_relative="$(manifest_value seed.path)"
    seed_expected="$(manifest_value seed.sha256)"
    seed_path="$REPO_ROOT/$seed_relative"
    [[ -f "$seed_path" ]] || fail "missing checked-in seed: $seed_relative"
    seed_actual="$(sha256 "$seed_path")"
    [[ "$seed_actual" == "$seed_expected" ]] || fail "checked-in seed hash mismatch"
    seed_bytes="$(bytes "$seed_path")"
    expected_bytes="$(manifest_value seed.bytes)"
    [[ "$seed_bytes" == "$expected_bytes" ]] || fail "checked-in seed byte length mismatch"

    local clang_identity expected_clang
    clang_identity="$(clang --version | /usr/bin/head -1)"
    expected_clang="$(manifest_value producer.clang)"
    [[ "$clang_identity" == "$expected_clang"* ]] || fail "seed verifier clang mismatch: $clang_identity"

    # compilerSources hashes describe the accepted seed's provenance.
    # Candidate sources are discovered below and may differ until rollover.
    local index runtime_count
    runtime_count="$(manifest_value runtimeSources)"
    for ((index = 0; index < runtime_count; index += 1)); do
        verify_manifest_file "runtimeSources.$index" "runtime input $index"
    done
}

runtime_inputs() {
    local index runtime_count
    runtime_count="$(manifest_value runtimeSources)"
    for ((index = 0; index < runtime_count; index += 1)); do
        /usr/bin/printf '%s\n' "$REPO_ROOT/$(manifest_value "runtimeSources.$index.path")"
    done
}

SOURCE_FILES=()
SOURCE_RELATIVE_PATHS=()
SOURCE_ROLES=()
SOURCE_ROOTS=()
SOURCE_MARKERS=()

discover_sources() {
    local directory="$1"
    local work_root="$2"
    local core_mode="${3:-manifest}"
    local raw_list="$work_root/source-paths.raw"
    local sorted_list="$work_root/source-paths.sorted"
    local absolute relative index compiler_source_count role

    [[ -d "$directory" ]] || fail "missing compiler directory: $directory"
    directory="$(cd "$directory" && pwd)"
    SOURCE_FILES=()
    SOURCE_RELATIVE_PATHS=()
    SOURCE_ROLES=()
    SOURCE_ROOTS=()
    SOURCE_MARKERS=()

    if [[ "$core_mode" == compatibility ]]; then
        [[ -f "$CORE_SOURCE_PATH" ]] || fail "missing compiler Core source: $CORE_SOURCE_PATH"
        SOURCE_FILES+=("$CORE_SOURCE_PATH")
        SOURCE_RELATIVE_PATHS+=("$CORE_SOURCE_MARKER_PATH")
        SOURCE_ROLES+=("core")
        SOURCE_ROOTS+=("repo")
        SOURCE_MARKERS+=("compilerSourceFile")
    else
        [[ "$core_mode" == manifest ]] || fail "unsupported source discovery core mode: $core_mode"
        compiler_source_count="$(manifest_value compilerSources)"
        for ((index = 0; index < compiler_source_count; index += 1)); do
            role="$(manifest_value "compilerSources.$index.role")"
            [[ "$role" == core ]] || continue
            relative="$(manifest_value "compilerSources.$index.path")"
            absolute="$REPO_ROOT/$relative"
            [[ -f "$absolute" ]] || fail "missing manifested compiler Core source: $relative"
            SOURCE_FILES+=("$absolute")
            SOURCE_RELATIVE_PATHS+=("$relative")
            SOURCE_ROLES+=("core")
            SOURCE_ROOTS+=("repo")
            SOURCE_MARKERS+=("compilerSourceFile")
        done
    fi

    /usr/bin/find "$directory" -type d \( -name .git -o -name .range -o -name .build \) -prune -o -type f -name '*.range' -print0 > "$raw_list"
    : > "$sorted_list"
    while IFS= read -r -d '' absolute; do
        relative="${absolute#"$directory/"}"
        if [[ "$relative" == *$' '* || "$relative" == *$'\t'* || "$relative" == *$'\n'* ]]; then
            fail "Range source paths may not contain whitespace: $relative"
        fi
        /usr/bin/printf '%s\n' "$absolute" >> "$sorted_list"
    done < "$raw_list"

    while IFS= read -r absolute; do
        [[ -n "$absolute" ]] || continue
        SOURCE_FILES+=("$absolute")
        SOURCE_RELATIVE_PATHS+=("${absolute#"$directory/"}")
        SOURCE_ROLES+=("project")
        SOURCE_ROOTS+=("candidate")
        SOURCE_MARKERS+=("compilerSourceFile")
    done < <(LC_ALL=C /usr/bin/sort "$sorted_list")

    [[ "${#SOURCE_FILES[@]}" -gt 0 ]] || fail "no .range source files found in: $directory"
}

write_source_bundle() {
    local output="$1"
    local index source

    /usr/bin/printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        source="${SOURCE_FILES[$index]}"
        /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "${SOURCE_ROLES[$index]}" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
        /bin/cat "$source" >> "$output"
        if [[ -n "$(/usr/bin/tail -c 1 "$source")" ]]; then
            /usr/bin/printf '\n' >> "$output"
        fi
    done
}

write_inventory_bundle() {
    local output="$1"
    local index

    /usr/bin/printf '%s\n' 'compilerSourceInventory' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "${SOURCE_ROLES[$index]}" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
    done
}

write_expected_inventory() {
    local output="$1"
    local index

    /usr/bin/printf 'sourceInventory\\tprogram\\n' > "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'sourceFile\\tindex=%s\\trole=%s\\tpath=%s\\n' "$index" "${SOURCE_ROLES[$index]}" "${SOURCE_RELATIVE_PATHS[$index]}" >> "$output"
    done
    /usr/bin/printf 'sourceFileCount\\t%s\\n' "${#SOURCE_FILES[@]}" >> "$output"
    /usr/bin/printf '\n' >> "$output"
}

write_candidate_build_plan() {
    local output="$1"
    local stage2_producer_id="$2"
    local seed_relative seed_path runtime_count index path identity logical_path

    seed_relative="$(manifest_value seed.path)"
    seed_path="$REPO_ROOT/$seed_relative"
    runtime_count="$(manifest_value runtimeSources)"
    identity="$(manifest_value producer.clang) $COMPILER_OPTIMIZATION $COMPILER_LTO"

    /usr/bin/printf 'rangeBuildPlan\tversion=1\n' > "$output"
    /usr/bin/printf 'target\tplatform=%s\tarchitecture=%s\tpointerBits=%s\truntimeABI=%s\n' \
        "$(manifest_value target.platform)" "$(manifest_value target.architecture)" \
        "$(manifest_value target.pointerBits)" "$(manifest_value runtimeABI)" >> "$output"
    /usr/bin/printf 'tool\tid=clang\tpath=repo/tool/clang\tsha256=%s\tbytes=%s\n' \
        "$(sha256_text "$identity")" "$(bytes_text "$identity")" >> "$output"
    /usr/bin/printf 'input\tid=accepted-seed\tpath=repo/%s\tsha256=%s\tbytes=%s\n' \
        "$seed_relative" "$(sha256 "$seed_path")" "$(bytes "$seed_path")" >> "$output"
    for ((index = 0; index < runtime_count; index += 1)); do
        path="$(manifest_value "runtimeSources.$index.path")"
        /usr/bin/printf 'runtime\tindex=%s\tid=runtime-%s\tpath=repo/%s\tsha256=%s\tbytes=%s\n' \
            "$index" "$index" "$path" "$(sha256 "$REPO_ROOT/$path")" "$(bytes "$REPO_ROOT/$path")" >> "$output"
    done
    /usr/bin/printf 'sourceSet\tid=candidate-sources\tpath=candidate/RangeCompilerSourceSet.range\tsha256=%s\tbytes=%s\n' \
        "$(sha256 "$SOURCE_BUNDLE")" "$(bytes "$SOURCE_BUNDLE")" >> "$output"
    for index in "${!SOURCE_FILES[@]}"; do
        /usr/bin/printf 'source\tindex=%s\tid=source-%s\tsourceSet=candidate-sources\trole=%s\troot=%s\tpath=%s\tsha256=%s\tbytes=%s\n' \
            "$index" "$index" "${SOURCE_ROLES[$index]}" "${SOURCE_ROOTS[$index]}" \
            "${SOURCE_RELATIVE_PATHS[$index]}" "$(sha256 "${SOURCE_FILES[$index]}")" \
            "$(bytes "${SOURCE_FILES[$index]}")" >> "$output"
    done
    for logical_path in \
        candidate/.range/Build/stage2/RangeCompiler.ll \
        candidate/.range/Build/stage2/RangeCompiler \
        candidate/.range/Build/stage3/RangeCompiler.ll \
        candidate/.range/Build/stage3/RangeCompiler; do
        case "$logical_path" in
            *stage2/RangeCompiler.ll) identity=stage2-llvm ;;
            *stage2/RangeCompiler) identity=stage2-executable ;;
            *stage3/RangeCompiler.ll) identity=stage3-llvm ;;
            *) identity=stage3-executable ;;
        esac
        /usr/bin/printf 'artifact\tid=%s\tpath=%s\tsha256=%s\tbytes=%s\n' \
            "$identity" "$logical_path" "$(sha256_text "$logical_path")" "$(bytes_text "$logical_path")" >> "$output"
    done
    /usr/bin/printf 'application\tindex=0\tid=stage2\tkind=compile\tinput=%s\tartifact=stage2-llvm\n' "$stage2_producer_id" >> "$output"
    /usr/bin/printf '%s\n' \
        $'application\tindex=1\tid=stage3\tkind=compile\tinput=stage2-executable\tartifact=stage3-llvm' >> "$output"
    /usr/bin/printf 'gate\tid=stage2-producer-dependency\tkind=dependency\tleft=stage2\tright=%s\n' "$stage2_producer_id" >> "$output"
    /usr/bin/printf '%s\n' \
        $'gate\tid=stage2-source-dependency\tkind=dependency\tleft=stage2\tright=candidate-sources' \
        $'gate\tid=stage2-runtime-dependency\tkind=dependency\tleft=stage2\tright=runtime-set' \
        $'gate\tid=stage2-validate\tkind=llvm-validate\tleft=stage2\tright=stage2-llvm' \
        $'gate\tid=stage2-link\tkind=link\tleft=stage2-llvm\tright=stage2-executable' \
        $'gate\tid=stage3-source-dependency\tkind=dependency\tleft=stage3\tright=candidate-sources' \
        $'gate\tid=stage3-runtime-dependency\tkind=dependency\tleft=stage3\tright=runtime-set' \
        $'gate\tid=stage3-validate\tkind=llvm-validate\tleft=stage3\tright=stage3-llvm' \
        $'gate\tid=stage3-link\tkind=link\tleft=stage3-llvm\tright=stage3-executable' \
        $'assert\tid=llvm-byte-identity\tkind=byte-identical\tsubject=stage2-llvm\texpected=stage3-llvm' \
        $'assert\tid=executable-byte-identity\tkind=byte-identical\tsubject=stage2-executable\texpected=stage3-executable' >> "$output"
}

validate_candidate_build_plan() {
    local plan="$1"
    local stage2_producer_id="$2"
    local runtime_count index path expected actual_count final_byte identity artifact_id

    [[ -s "$plan" ]] || fail "candidate build plan is empty"
    [[ "$(/usr/bin/head -1 "$plan")" == $'rangeBuildPlan\tversion=1' ]] || fail "candidate build plan header is invalid"
    ! LC_ALL=C /usr/bin/grep -q $'\r' "$plan" || fail "candidate build plan contains CR bytes"
    final_byte="$(/usr/bin/tail -c 1 "$plan" | /usr/bin/od -An -t u1 | /usr/bin/tr -d ' ')"
    [[ "$final_byte" == 10 ]] || fail "candidate build plan is not LF-terminated"
    /usr/bin/awk -F '\t' '
        {
            for (field = 2; field <= NF; field += 1) {
                value = $field
                sub(/^[^=]*=/, "", value)
                if (value ~ /^\// || value ~ /(^|\/)\.\.($|\/)/) exit 1
            }
        }
    ' "$plan" || fail "candidate build plan contains an absolute or parent-relative value"

    [[ "$(/usr/bin/grep -c $'^target\t' "$plan")" -eq 1 ]] || fail "candidate build plan target count is invalid"
    [[ "$(/usr/bin/grep -c $'^tool\t' "$plan")" -eq 1 ]] || fail "candidate build plan tool count is invalid"
    [[ "$(/usr/bin/grep -c $'^input\t' "$plan")" -eq 1 ]] || fail "candidate build plan seed input count is invalid"
    expected="$(/usr/bin/printf 'target\tplatform=%s\tarchitecture=%s\tpointerBits=%s\truntimeABI=%s' \
        "$(manifest_value target.platform)" "$(manifest_value target.architecture)" \
        "$(manifest_value target.pointerBits)" "$(manifest_value runtimeABI)")"
    /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan target is invalid"
    identity="$(manifest_value producer.clang) $COMPILER_OPTIMIZATION $COMPILER_LTO"
    expected="$(/usr/bin/printf 'tool\tid=clang\tpath=repo/tool/clang\tsha256=%s\tbytes=%s' \
        "$(sha256_text "$identity")" "$(bytes_text "$identity")")"
    /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan tool is invalid"
    path="$(manifest_value seed.path)"
    expected="$(/usr/bin/printf 'input\tid=accepted-seed\tpath=repo/%s\tsha256=%s\tbytes=%s' \
        "$path" "$(sha256 "$REPO_ROOT/$path")" "$(bytes "$REPO_ROOT/$path")")"
    /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan accepted seed is missing or stale"
    runtime_count="$(manifest_value runtimeSources)"
    actual_count="$(/usr/bin/grep -c $'^runtime\t' "$plan")"
    [[ "$actual_count" -eq "$runtime_count" ]] || fail "candidate build plan runtime count is $actual_count, expected $runtime_count"
    for ((index = 0; index < runtime_count; index += 1)); do
        path="$(manifest_value "runtimeSources.$index.path")"
        expected="$(/usr/bin/printf 'runtime\tindex=%s\tid=runtime-%s\tpath=repo/%s\tsha256=%s\tbytes=%s' \
            "$index" "$index" "$path" "$(sha256 "$REPO_ROOT/$path")" "$(bytes "$REPO_ROOT/$path")")"
        /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan runtime $index is missing or stale"
    done
    expected="$(/usr/bin/printf 'sourceSet\tid=candidate-sources\tpath=candidate/RangeCompilerSourceSet.range\tsha256=%s\tbytes=%s' \
        "$(sha256 "$SOURCE_BUNDLE")" "$(bytes "$SOURCE_BUNDLE")")"
    /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan sourceSet is missing or stale"
    actual_count="$(/usr/bin/grep -c $'^source\t' "$plan")"
    [[ "$actual_count" -eq "${#SOURCE_FILES[@]}" ]] || fail "candidate build plan source count is $actual_count, expected ${#SOURCE_FILES[@]}"
    for index in "${!SOURCE_FILES[@]}"; do
        expected="$(/usr/bin/printf 'source\tindex=%s\tid=source-%s\tsourceSet=candidate-sources\trole=%s\troot=%s\tpath=%s\tsha256=%s\tbytes=%s' \
            "$index" "$index" "${SOURCE_ROLES[$index]}" "${SOURCE_ROOTS[$index]}" \
            "${SOURCE_RELATIVE_PATHS[$index]}" "$(sha256 "${SOURCE_FILES[$index]}")" "$(bytes "${SOURCE_FILES[$index]}")")"
        /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan source $index role/root/path/marker/hash/bytes are missing or stale"
    done
    [[ "$(/usr/bin/grep -c $'^artifact\t' "$plan")" -eq 4 ]] || fail "candidate build plan must contain four artifacts"
    [[ "$(/usr/bin/grep -c $'^application\t' "$plan")" -eq 2 ]] || fail "candidate build plan must contain Stage2 and Stage3 applications"
    [[ "$(/usr/bin/grep -c $'^gate\t' "$plan")" -eq 9 ]] || fail "candidate build plan gate/dependency count is invalid"
    [[ "$(/usr/bin/grep -c $'^assert\t' "$plan")" -eq 2 ]] || fail "candidate build plan fixed-point assertion count is invalid"
    /usr/bin/grep -Fqx "application"$'\t'"index=0"$'\t'"id=stage2"$'\t'"kind=compile"$'\t'"input=$stage2_producer_id"$'\t'"artifact=stage2-llvm" "$plan" \
        || fail "candidate build plan Stage2 application is invalid"
    for expected in \
        $'application\tindex=1\tid=stage3\tkind=compile\tinput=stage2-executable\tartifact=stage3-llvm' \
        $'gate\tid=stage2-source-dependency\tkind=dependency\tleft=stage2\tright=candidate-sources' \
        $'gate\tid=stage2-runtime-dependency\tkind=dependency\tleft=stage2\tright=runtime-set' \
        $'gate\tid=stage2-validate\tkind=llvm-validate\tleft=stage2\tright=stage2-llvm' \
        $'gate\tid=stage2-link\tkind=link\tleft=stage2-llvm\tright=stage2-executable' \
        $'gate\tid=stage3-source-dependency\tkind=dependency\tleft=stage3\tright=candidate-sources' \
        $'gate\tid=stage3-runtime-dependency\tkind=dependency\tleft=stage3\tright=runtime-set' \
        $'gate\tid=stage3-validate\tkind=llvm-validate\tleft=stage3\tright=stage3-llvm' \
        $'gate\tid=stage3-link\tkind=link\tleft=stage3-llvm\tright=stage3-executable' \
        $'assert\tid=llvm-byte-identity\tkind=byte-identical\tsubject=stage2-llvm\texpected=stage3-llvm' \
        $'assert\tid=executable-byte-identity\tkind=byte-identical\tsubject=stage2-executable\texpected=stage3-executable'; do
        /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan is missing required record: $expected"
    done
    /usr/bin/grep -Fqx "gate"$'\t'"id=stage2-producer-dependency"$'\t'"kind=dependency"$'\t'"left=stage2"$'\t'"right=$stage2_producer_id" "$plan" \
        || fail "candidate build plan Stage2 producer dependency is invalid"
    for artifact_id in stage2-llvm stage2-executable stage3-llvm stage3-executable; do
        case "$artifact_id" in
            stage2-llvm) path=candidate/.range/Build/stage2/RangeCompiler.ll ;;
            stage2-executable) path=candidate/.range/Build/stage2/RangeCompiler ;;
            stage3-llvm) path=candidate/.range/Build/stage3/RangeCompiler.ll ;;
            *) path=candidate/.range/Build/stage3/RangeCompiler ;;
        esac
        expected="$(/usr/bin/printf 'artifact\tid=%s\tpath=%s\tsha256=%s\tbytes=%s' \
            "$artifact_id" "$path" "$(sha256_text "$path")" "$(bytes_text "$path")")"
        /usr/bin/grep -Fqx "$expected" "$plan" || fail "candidate build plan artifact $artifact_id is invalid"
    done
}

assert_candidate_build_plan_unchanged() {
    [[ -n "${CANDIDATE_BUILD_PLAN:-}" && -n "${CANDIDATE_BUILD_PLAN_SHA256:-}" ]] || return 0
    [[ -f "$CANDIDATE_BUILD_PLAN" ]] || fail "candidate build plan disappeared during execution"
    [[ "$(sha256 "$CANDIDATE_BUILD_PLAN")" == "$CANDIDATE_BUILD_PLAN_SHA256" ]] \
        || fail "candidate build plan changed during execution"
}

validate_build_plan_snapshot() {
    local label="$1"
    local snapshot="$2"
    local runtime_count="$(manifest_value runtimeSources)"
    local expected_header

    expected_header="buildPlan"$'\t'"version=1"$'\t'"valid=true"$'\t'"targetCount=1"$'\t'"toolCount=1"$'\t'"inputCount=1"$'\t'"runtimeCount=$runtime_count"$'\t'"sourceSetCount=1"$'\t'"sourceCount=${#SOURCE_FILES[@]}"$'\t'"artifactCount=4"$'\t'"applicationCount=2"$'\t'"gateCount=9"$'\t'"assertCount=2"
    /usr/bin/grep -Fqx "$expected_header" "$snapshot" \
        || fail "$label build plan snapshot header or record counts are invalid"
    ! LC_ALL=C /usr/bin/grep -Eq '(timestamp|generatedAt|duration|elapsed|processID|pid|temporaryPath|absolutePath)=' "$snapshot" \
        || fail "$label build plan snapshot contains nondeterministic fields"
    ! /usr/bin/grep -Eq '(^|[=[:space:]])/|(^|/)\.\.($|/)' "$snapshot" \
        || fail "$label build plan snapshot contains an absolute or parent-relative path"
    [[ "$(/usr/bin/grep -c $'^runtime\t' "$snapshot")" -eq "$runtime_count" ]] \
        || fail "$label build plan snapshot runtime records are incomplete"
    [[ "$(/usr/bin/grep -c $'^source\t' "$snapshot")" -eq "${#SOURCE_FILES[@]}" ]] \
        || fail "$label build plan snapshot source records are incomplete"
    [[ "$(/usr/bin/grep -c $'^application\t' "$snapshot")" -eq 2 ]] \
        || fail "$label build plan snapshot application records are incomplete"
    [[ "$(/usr/bin/grep -c $'^artifact\t' "$snapshot")" -eq 4 ]] \
        || fail "$label build plan snapshot artifact records are incomplete"
}

audit_candidate_build_plan_snapshot() {
    local stage_label="$1"
    local executable="$2"
    local first="$WORK_ROOT/$stage_label.build-plan.first.snapshot"
    local second="$WORK_ROOT/$stage_label.build-plan.repeat.snapshot"
    local first_error="$WORK_ROOT/$stage_label.build-plan.first.err"
    local second_error="$WORK_ROOT/$stage_label.build-plan.repeat.err"
    local unsupported="$WORK_ROOT/$stage_label.build-plan.unsupported.tsv"
    local unsupported_output="$WORK_ROOT/$stage_label.build-plan.unsupported.out"
    local unsupported_error="$WORK_ROOT/$stage_label.build-plan.unsupported.err"
    local duplicate="$WORK_ROOT/$stage_label.build-plan.duplicate.tsv"
    local duplicate_output="$WORK_ROOT/$stage_label.build-plan.duplicate.out"
    local duplicate_error="$WORK_ROOT/$stage_label.build-plan.duplicate.err"

    run_capture "$executable" "$CANDIDATE_BUILD_PLAN" "$first" "$first_error"
    require_successful_output "$stage_label build plan snapshot" "$first" "$first_error"
    run_capture "$executable" "$CANDIDATE_BUILD_PLAN" "$second" "$second_error"
    require_successful_output "$stage_label repeated build plan snapshot" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label build plan snapshot was not deterministic"
    validate_build_plan_snapshot "$stage_label" "$first"

    /usr/bin/printf 'rangeBuildPlan\tversion=2\n' > "$unsupported"
    run_capture "$executable" "$unsupported" "$unsupported_output" "$unsupported_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label unsupported build plan version exited $RUN_STATUS"
    [[ ! -s "$unsupported_error" ]] || fail "$stage_label unsupported build plan version wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidBuildPlan\treason=unsupportedVersion\tline=1' "$unsupported_output" \
        || fail "$stage_label unsupported build plan version diagnostic changed"

    /usr/bin/awk -F '\t' 'BEGIN { duplicated = 0 } { print; if (!duplicated && $1 == "artifact") { print; duplicated = 1 } }' "$CANDIDATE_BUILD_PLAN" > "$duplicate"
    run_capture "$executable" "$duplicate" "$duplicate_output" "$duplicate_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label duplicate build plan ID exited $RUN_STATUS"
    [[ ! -s "$duplicate_error" ]] || fail "$stage_label duplicate build plan ID wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidBuildPlan\treason=duplicateLogicalID' "$duplicate_output" \
        || fail "$stage_label duplicate build plan ID diagnostic changed"

    assert_candidate_build_plan_unchanged
}

materialize_candidate_source_bundle() {
    local stage_label="$1"
    local executable="$2"
    local output_bundle="$3"
    local command_output="$WORK_ROOT/$stage_label.source-load.out"
    local command_error="$WORK_ROOT/$stage_label.source-load.err"

    run_capture_arguments "$command_output" "$command_error" \
        "$executable" load-plan-sources "$CANDIDATE_BUILD_PLAN" "$REPO_ROOT" "$compiler_directory" "$output_bundle"
    [[ "$RUN_STATUS" -eq 0 ]] || fail "$stage_label source load exited $RUN_STATUS: $(/usr/bin/head -c 240 "$command_output")"
    [[ ! -s "$command_output" ]] || fail "$stage_label source load wrote stdout: $(/usr/bin/head -c 240 "$command_output")"
    [[ ! -s "$command_error" ]] || fail "$stage_label source load wrote stderr: $(/usr/bin/head -c 240 "$command_error")"
    [[ -s "$output_bundle" ]] || fail "$stage_label source load produced an empty bundle"
    /usr/bin/cmp -s "$SOURCE_BUNDLE" "$output_bundle" \
        || fail "$stage_label Range-loaded source bundle differs from the shell-authored bundle"
    echo "$stage_label Range-loaded source bundle: byte-identical to shell-authored bundle"
}
run_capture() {
    local executable="$1"
    local input="$2"
    local output="$3"
    local error="$4"
    local status

    if "$executable" "$input" > "$output" 2> "$error"; then
        status=0
    else
        status=$?
    fi
    RUN_STATUS="$status"
}

run_capture_arguments() {
    local output="$1"
    local error="$2"
    shift 2
    local status

    if "$@" > "$output" 2> "$error"; then
        status=0
    else
        status=$?
    fi
    RUN_STATUS="$status"
}

require_successful_output() {
    local label="$1"
    local output="$2"
    local error="$3"

    [[ "$RUN_STATUS" -eq 0 ]] || fail "$label exited $RUN_STATUS: $(/usr/bin/head -c 240 "$output")"
    [[ ! -s "$error" ]] || fail "$label wrote stderr: $(/usr/bin/head -c 240 "$error")"
    if /usr/bin/head -1 "$output" | /usr/bin/grep -Fq 'compilerError'; then
        fail "$label emitted compilerError: $(/usr/bin/head -c 400 "$output")"
    fi
    [[ -s "$output" ]] || fail "$label emitted empty output"
}

emit_candidate_llvm() {
    local executable="$1"
    local bundle="$2"
    local output="$3"
    local label="$4"
    local captured="$WORK_ROOT/$label.llvm"
    local error="$WORK_ROOT/$label.stderr"

    run_capture "$executable" "$bundle" "$captured" "$error"
    require_successful_output "$label" "$captured" "$error"
    /bin/mkdir -p "$(dirname "$output")"
    /bin/mv "$captured" "$output"
}

validate_llvm() {
    local llvm="$1"
    local object="$WORK_ROOT/$(basename "$llvm").o"
    clang -Wno-override-module -x ir -c "$llvm" -o "$object"
    /bin/rm -f "$object"
}

link_llvm() {
    local llvm="$1"
    local executable="$2"
    local temporary="$WORK_ROOT/$(basename "$executable").tmp"

    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module "$llvm" "${RUNTIME_INPUTS[@]}" -o "$temporary"
    /bin/mkdir -p "$(dirname "$executable")"
    /bin/mv "$temporary" "$executable"
}

audit_inventory() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.inventory.out"
    local error="$WORK_ROOT/$stage_label.inventory.err"

    run_capture "$executable" "$INVENTORY_BUNDLE" "$output" "$error"
    require_successful_output "$stage_label inventory" "$output" "$error"
    /usr/bin/cmp -s "$output" "$EXPECTED_INVENTORY" || fail "$stage_label inventory differs from discovered source order"
    echo "$stage_label inventory: pass (${#SOURCE_FILES[@]} files)"
}

assert_smoke_shape() {
    local llvm="$1"
    local define_count call_count

    for marker in \
        '%Range.NativeSmokePair = type { i32, i32 }' \
        'define i32 @main() {' \
        'define void @nativeSmokeFirst(ptr %returnDestination)' \
        'define void @nativeSmokeSecond(ptr %returnDestination)' \
        '%storage0 = alloca' \
        '%storage1 = alloca' \
        'insertvalue %Range.NativeSmokePair' \
        'extractvalue'; do
        /usr/bin/grep -Fq "$marker" "$llvm" || fail "normal smoke missing LLVM marker: $marker"
    done

    define_count="$(/usr/bin/grep -F -c 'define void @nativeSmoke' "$llvm")"
    call_count="$(/usr/bin/grep -F -c 'call void @nativeSmoke' "$llvm")"
    [[ "$define_count" -eq 2 ]] || fail "normal smoke emitted $define_count native aggregate definitions"
    [[ "$call_count" -eq 2 ]] || fail "normal smoke emitted $call_count native aggregate calls"

    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$llvm"; then
            fail "normal smoke emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done
    if /usr/bin/grep -Fq '\n' "$llvm"; then
        fail "normal smoke emitted an escaped newline marker"
    fi
    if /usr/bin/grep -Fq 'call %Range.NativeSmokePair' "$llvm"; then
        fail "normal smoke used aggregate-return calls instead of caller-owned storage"
    fi
}

audit_smoke() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.smoke.first.ll"
    local second="$WORK_ROOT/$stage_label.smoke.second.ll"
    local first_error="$WORK_ROOT/$stage_label.smoke.first.err"
    local second_error="$WORK_ROOT/$stage_label.smoke.second.err"
    local smoke_llvm="$stage_directory/Smoke.ll"
    local smoke_executable="$stage_directory/Smoke"
    local run_output="$WORK_ROOT/$stage_label.smoke.run.out"
    local run_error="$WORK_ROOT/$stage_label.smoke.run.err"

    run_capture "$executable" "$SMOKE_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label normal smoke" "$first" "$first_error"
    run_capture "$executable" "$SMOKE_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated normal smoke" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label normal smoke was not deterministic"
    assert_smoke_shape "$first"

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$smoke_llvm"
    validate_llvm "$smoke_llvm"
    link_llvm "$smoke_llvm" "$smoke_executable"

    if "$smoke_executable" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label normal smoke executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label normal smoke executable wrote output"
    echo "$stage_label deterministic aggregate smoke: pass (exit 7)"
}

audit_native_arrays() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local kind source expected first second first_error second_error llvm linked run_output run_error

    for kind in index count enum-payload argument binding-read mutation-int mutation-enum mutation-member mutation-nested-member mutation-binding; do
        source="$ARRAY_INDEX_SOURCE"
        expected=2
        if [[ "$kind" == count ]]; then
            source="$ARRAY_COUNT_SOURCE"
            expected=3
        elif [[ "$kind" == enum-payload ]]; then
            source="$ARRAY_ENUM_PAYLOAD_SOURCE"
            expected=6
        elif [[ "$kind" == argument ]]; then
            source="$ARRAY_ARGUMENT_SOURCE"
            expected=2
        elif [[ "$kind" == binding-read ]]; then
            source="$ARRAY_BINDING_READ_SOURCE"
            expected=2
        elif [[ "$kind" == mutation-int ]]; then
            source="$ARRAY_MUTATION_SOURCE"
            expected=7
        elif [[ "$kind" == mutation-enum ]]; then
            source="$ARRAY_ENUM_MUTATION_SOURCE"
            expected=7
        elif [[ "$kind" == mutation-member ]]; then
            source="$ARRAY_MEMBER_MUTATION_SOURCE"
            expected=7
        elif [[ "$kind" == mutation-nested-member ]]; then
            source="$ARRAY_NESTED_MEMBER_MUTATION_SOURCE"
            expected=7
        elif [[ "$kind" == mutation-binding ]]; then
            source="$ARRAY_BINDING_MUTATION_SOURCE"
            expected=7
        fi
        first="$WORK_ROOT/$stage_label.array.$kind.first.ll"
        second="$WORK_ROOT/$stage_label.array.$kind.repeat.ll"
        first_error="$WORK_ROOT/$stage_label.array.$kind.first.err"
        second_error="$WORK_ROOT/$stage_label.array.$kind.repeat.err"
        llvm="$stage_directory/Array-$kind.ll"
        linked="$stage_directory/Array-$kind"
        run_output="$WORK_ROOT/$stage_label.array.$kind.run.out"
        run_error="$WORK_ROOT/$stage_label.array.$kind.run.err"

        run_capture "$executable" "$source" "$first" "$first_error"
        require_successful_output "$stage_label native Array $kind" "$first" "$first_error"
        run_capture "$executable" "$source" "$second" "$second_error"
        require_successful_output "$stage_label repeated native Array $kind" "$second" "$second_error"
        /usr/bin/cmp -s "$first" "$second" || fail "$stage_label native Array $kind was not deterministic"
        /usr/bin/grep -Fq '%Range.Array = type { ptr, i32 }' "$first" \
            || fail "$stage_label native Array $kind omitted the generic pointer/count layout"
        /usr/bin/grep -Eq 'alloca (i32|%Range\.(NumberToken|MutableNumberToken)), i32 [1-9][0-9]*' "$first" \
            || fail "$stage_label native Array $kind omitted typed lexical backing storage"
        if /usr/bin/grep -Eq 'call .*@(rangeConstruct|rawBufferCreate|malloc|calloc|realloc)' "$first"; then
            fail "$stage_label native Array $kind introduced dynamic-record or allocator calls"
        fi
        if [[ "$kind" == count ]]; then
            /usr/bin/grep -Eq 'extractvalue %Range\.Array .* 1' "$first" \
                || fail "$stage_label native Array count did not read the native count field"
        else
            /usr/bin/grep -Fq 'icmp ult i32' "$first" \
                || fail "$stage_label native Array $kind omitted the unsigned bounds proof"
            /usr/bin/grep -Fq 'call void @llvm.trap()' "$first" \
                || fail "$stage_label native Array $kind omitted the out-of-bounds trap"
            /usr/bin/grep -Fq 'getelementptr inbounds' "$first" \
                || fail "$stage_label native Array $kind omitted typed element addressing"
        fi
        if [[ "$kind" == enum-payload || "$kind" == mutation-enum ]]; then
            /usr/bin/grep -Eq 'alloca %Range\.(NumberToken|MutableNumberToken)' "$first" \
                || fail "$stage_label native enum Array did not specialize backing storage to its element layout"
        fi
        if [[ "$kind" == mutation-int || "$kind" == mutation-enum || "$kind" == mutation-member || "$kind" == mutation-nested-member || "$kind" == mutation-binding ]]; then
            /usr/bin/grep -Fq 'array.store.' "$first" \
                || fail "$stage_label native Array $kind omitted the indexed store operation"
            /usr/bin/grep -Eq 'store (i32|%Range\.MutableNumberToken) .*ptr %array\.store\.' "$first" \
                || fail "$stage_label native Array $kind omitted its typed element store"
        fi
        if [[ "$kind" == argument ]]; then
            /usr/bin/grep -Fq 'define i32 @selected(%Range.Array' "$first" \
                || fail "$stage_label native Array argument omitted its frozen parameter signature"
            /usr/bin/grep -Fq 'call i32 @selected(%Range.Array' "$first" \
                || fail "$stage_label native Array argument call disagreed with its frozen parameter signature"
        fi

        /bin/cp "$first" "$llvm"
        validate_llvm "$llvm"
        link_llvm "$llvm" "$linked"
        if "$linked" > "$run_output" 2> "$run_error"; then
            RUN_STATUS=0
        else
            RUN_STATUS=$?
        fi
        [[ "$RUN_STATUS" -eq "$expected" ]] || fail "$stage_label native Array $kind exited $RUN_STATUS"
        [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label native Array $kind wrote output"
    done

    local immutable_binding_output="$WORK_ROOT/$stage_label.array.immutable-binding-source.out"
    local immutable_binding_error="$WORK_ROOT/$stage_label.array.immutable-binding-source.err"
    run_capture "$executable" "$ARRAY_IMMUTABLE_BINDING_SOURCE" "$immutable_binding_output" "$immutable_binding_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label immutable binding Array source mutation exited $RUN_STATUS"
    [[ ! -s "$immutable_binding_error" ]] || fail "$stage_label immutable binding Array source mutation wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$immutable_binding_output" \
        || fail "$stage_label immutable binding Array source mutation missed the semantic diagnostic"
    if /usr/bin/grep -Fq 'define ' "$immutable_binding_output"; then
        fail "$stage_label immutable binding Array source mutation emitted LLVM"
    fi

    local oob_first="$WORK_ROOT/$stage_label.array.out-of-bounds.first.ll"
    local oob_second="$WORK_ROOT/$stage_label.array.out-of-bounds.repeat.ll"
    local oob_error="$WORK_ROOT/$stage_label.array.out-of-bounds.err"
    local oob_linked="$stage_directory/Array-out-of-bounds"
    local oob_run_output="$WORK_ROOT/$stage_label.array.out-of-bounds.run.out"
    local oob_run_error="$WORK_ROOT/$stage_label.array.out-of-bounds.run.err"
    run_capture "$executable" "$ARRAY_OUT_OF_BOUNDS_SOURCE" "$oob_first" "$oob_error"
    require_successful_output "$stage_label native Array out-of-bounds" "$oob_first" "$oob_error"
    run_capture "$executable" "$ARRAY_OUT_OF_BOUNDS_SOURCE" "$oob_second" "$oob_error"
    require_successful_output "$stage_label repeated native Array out-of-bounds" "$oob_second" "$oob_error"
    /usr/bin/cmp -s "$oob_first" "$oob_second" || fail "$stage_label native Array out-of-bounds was not deterministic"
    /usr/bin/grep -Fq 'icmp ult i32' "$oob_first" || fail "$stage_label native Array out-of-bounds omitted its bounds comparison"
    /usr/bin/grep -Fq 'call void @llvm.trap()' "$oob_first" || fail "$stage_label native Array out-of-bounds omitted its trap"
    validate_llvm "$oob_first"
    link_llvm "$oob_first" "$oob_linked"
    if "$oob_linked" > "$oob_run_output" 2> "$oob_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -ne 0 ]] || fail "$stage_label native Array out-of-bounds unexpectedly succeeded"
    [[ ! -s "$oob_run_output" && ! -s "$oob_run_error" ]] || fail "$stage_label native Array out-of-bounds wrote output"

    local write_oob_llvm="$WORK_ROOT/$stage_label.array.write-out-of-bounds.ll"
    local write_oob_error="$WORK_ROOT/$stage_label.array.write-out-of-bounds.err"
    local write_oob_linked="$stage_directory/Array-write-out-of-bounds"
    local write_oob_run_output="$WORK_ROOT/$stage_label.array.write-out-of-bounds.run.out"
    local write_oob_run_error="$WORK_ROOT/$stage_label.array.write-out-of-bounds.run.err"
    run_capture "$executable" "$ARRAY_WRITE_OUT_OF_BOUNDS_SOURCE" "$write_oob_llvm" "$write_oob_error"
    require_successful_output "$stage_label native Array write out-of-bounds" "$write_oob_llvm" "$write_oob_error"
    /usr/bin/grep -Fq 'array.store.' "$write_oob_llvm" || fail "$stage_label native Array write out-of-bounds omitted its indexed store"
    /usr/bin/grep -Fq 'call void @llvm.trap()' "$write_oob_llvm" || fail "$stage_label native Array write out-of-bounds omitted its trap"
    validate_llvm "$write_oob_llvm"
    link_llvm "$write_oob_llvm" "$write_oob_linked"
    if "$write_oob_linked" > "$write_oob_run_output" 2> "$write_oob_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -ne 0 ]] || fail "$stage_label native Array write out-of-bounds unexpectedly succeeded"
    [[ ! -s "$write_oob_run_output" && ! -s "$write_oob_run_error" ]] || fail "$stage_label native Array write out-of-bounds wrote output"

    local immutable_output="$WORK_ROOT/$stage_label.array.immutable-write.out"
    local immutable_error="$WORK_ROOT/$stage_label.array.immutable-write.err"
    run_capture "$executable" "$ARRAY_IMMUTABLE_MUTATION_SOURCE" "$immutable_output" "$immutable_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label immutable Array mutation exited $RUN_STATUS"
    [[ ! -s "$immutable_error" ]] || fail "$stage_label immutable Array mutation wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$immutable_output" \
        || fail "$stage_label immutable Array mutation missed the semantic diagnostic"
    if /usr/bin/grep -Fq 'define ' "$immutable_output"; then
        fail "$stage_label immutable Array mutation emitted LLVM"
    fi

    local immutable_member_kind immutable_member_source immutable_member_output immutable_member_error
    for immutable_member_kind in field owner intermediate; do
        immutable_member_source="$ARRAY_IMMUTABLE_MEMBER_SOURCE"
        if [[ "$immutable_member_kind" == owner ]]; then
            immutable_member_source="$ARRAY_IMMUTABLE_MEMBER_OWNER_SOURCE"
        elif [[ "$immutable_member_kind" == intermediate ]]; then
            immutable_member_source="$ARRAY_IMMUTABLE_MEMBER_INTERMEDIATE_SOURCE"
        fi
        immutable_member_output="$WORK_ROOT/$stage_label.array.immutable-member-$immutable_member_kind.out"
        immutable_member_error="$WORK_ROOT/$stage_label.array.immutable-member-$immutable_member_kind.err"
        run_capture "$executable" "$immutable_member_source" "$immutable_member_output" "$immutable_member_error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label immutable Array member $immutable_member_kind mutation exited $RUN_STATUS"
        [[ ! -s "$immutable_member_error" ]] || fail "$stage_label immutable Array member $immutable_member_kind mutation wrote stderr"
        /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$immutable_member_output" \
            || fail "$stage_label immutable Array member $immutable_member_kind mutation missed the semantic diagnostic"
        if /usr/bin/grep -Fq 'define ' "$immutable_member_output"; then
            fail "$stage_label immutable Array member $immutable_member_kind mutation emitted LLVM"
        fi
    done

    local escape_output="$WORK_ROOT/$stage_label.array.return-escape.out"
    local escape_error="$WORK_ROOT/$stage_label.array.return-escape.err"
    run_capture "$executable" "$ARRAY_RETURN_ESCAPE_SOURCE" "$escape_output" "$escape_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label native Array return escape exited $RUN_STATUS"
    [[ ! -s "$escape_error" ]] || fail "$stage_label native Array return escape wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidFunctionDiscovery\tfunctionRow=0\tfunction=escaped\tfailureCode=2' "$escape_output" \
        || fail "$stage_label native Array return escape missed the semantic diagnostic"
    if /usr/bin/grep -Fq 'define ' "$escape_output"; then
        fail "$stage_label native Array return escape emitted LLVM"
    fi
    echo "$stage_label native Array: pass (generic pointer/count value, typed lexical storage, count/index/store, enum payload, arbitrary-depth mutable-member and direct binding-source mutation, executable read/write bounds traps, immutable field/intermediate/owner/binding-source and return-escape rejection, deterministic)"
}

audit_storage_switches() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local kind source expected first second first_error second_error llvm linked run_output run_error

    for kind in integer string bool state member enum enum-state enum-function; do
        expected=0
        source="$SWITCH_INTEGER_SOURCE"
        if [[ "$kind" == string ]]; then
            source="$SWITCH_STRING_SOURCE"
            expected=2
        elif [[ "$kind" == bool ]]; then
            source="$SWITCH_BOOL_SOURCE"
            expected=7
        elif [[ "$kind" == state ]]; then
            source="$SWITCH_STATE_SOURCE"
            expected=7
        elif [[ "$kind" == member ]]; then
            source="$SWITCH_MEMBER_SOURCE"
            expected=7
        elif [[ "$kind" == enum ]]; then
            source="$SWITCH_ENUM_SOURCE"
            expected=3
        elif [[ "$kind" == enum-state ]]; then
            source="$SWITCH_ENUM_STATE_SOURCE"
            expected=3
        elif [[ "$kind" == enum-function ]]; then
            source="$SWITCH_ENUM_FUNCTION_SOURCE"
            expected=2
        else
            expected=20
        fi
        first="$WORK_ROOT/$stage_label.switch.$kind.first.ll"
        second="$WORK_ROOT/$stage_label.switch.$kind.repeat.ll"
        first_error="$WORK_ROOT/$stage_label.switch.$kind.first.err"
        second_error="$WORK_ROOT/$stage_label.switch.$kind.repeat.err"
        llvm="$stage_directory/Switch-$kind.ll"
        linked="$stage_directory/Switch-$kind"
        run_output="$WORK_ROOT/$stage_label.switch.$kind.run.out"
        run_error="$WORK_ROOT/$stage_label.switch.$kind.run.err"

        run_capture "$executable" "$source" "$first" "$first_error"
        require_successful_output "$stage_label $kind storage switch" "$first" "$first_error"
        run_capture "$executable" "$source" "$second" "$second_error"
        require_successful_output "$stage_label repeated $kind storage switch" "$second" "$second_error"
        /usr/bin/cmp -s "$first" "$second" || fail "$stage_label $kind storage switch was not deterministic"
        /bin/cp "$first" "$llvm"
        validate_llvm "$llvm"
        link_llvm "$llvm" "$linked"
        if "$linked" > "$run_output" 2> "$run_error"; then
            RUN_STATUS=0
        else
            RUN_STATUS=$?
        fi
        [[ "$RUN_STATUS" -eq "$expected" ]] || fail "$stage_label $kind storage switch exited $RUN_STATUS"
        [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label $kind storage switch wrote output"
        if [[ "$kind" == enum || "$kind" == enum-state || "$kind" == enum-function ]]; then
            /usr/bin/grep -Fq 'icmp eq i32' "$llvm" || fail "$stage_label enum switch did not lower through scalar tag comparisons"
            if /usr/bin/grep -Eq 'rangeConstruct|malloc|calloc|realloc' "$llvm"; then
                fail "$stage_label enum switch introduced dynamic record or allocator calls"
            fi
        fi
    done

    local negative_kind negative_source negative_output negative_error
    for negative_kind in nonstorage mismatch enum-missing enum-duplicate enum-unknown; do
        negative_source="$SWITCH_NONSTORAGE_SOURCE"
        if [[ "$negative_kind" == mismatch ]]; then
            negative_source="$SWITCH_MISMATCH_SOURCE"
        elif [[ "$negative_kind" == enum-missing ]]; then
            negative_source="$SWITCH_ENUM_MISSING_SOURCE"
        elif [[ "$negative_kind" == enum-duplicate ]]; then
            negative_source="$SWITCH_ENUM_DUPLICATE_SOURCE"
        elif [[ "$negative_kind" == enum-unknown ]]; then
            negative_source="$SWITCH_ENUM_UNKNOWN_SOURCE"
        fi
        negative_output="$WORK_ROOT/$stage_label.switch.$negative_kind.out"
        negative_error="$WORK_ROOT/$stage_label.switch.$negative_kind.err"
        run_capture "$executable" "$negative_source" "$negative_output" "$negative_error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label $negative_kind switch rejection exited $RUN_STATUS"
        [[ ! -s "$negative_error" ]] || fail "$stage_label $negative_kind switch rejection wrote stderr"
        /usr/bin/grep -Fq $'compilerError\tkind=invalidEntryReachability\tstage=2' "$negative_output" \
            || fail "$stage_label $negative_kind switch rejection missed the semantic diagnostic"
        if /usr/bin/grep -Fq 'define ' "$negative_output"; then
            fail "$stage_label $negative_kind switch rejection emitted LLVM"
        fi
    done
    local enum_declaration_output="$WORK_ROOT/$stage_label.enum.duplicate-declaration.out"
    local enum_declaration_error="$WORK_ROOT/$stage_label.enum.duplicate-declaration.err"
    run_capture "$executable" "$ENUM_DUPLICATE_DECLARATION_SOURCE" "$enum_declaration_output" "$enum_declaration_error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label duplicate enum declaration rejection exited $RUN_STATUS"
    [[ ! -s "$enum_declaration_error" ]] || fail "$stage_label duplicate enum declaration rejection wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedDeclarations' "$enum_declaration_output" \
        || fail "$stage_label duplicate enum declaration missed the typed declaration diagnostic"
    if /usr/bin/grep -Fq 'define ' "$enum_declaration_output"; then
        fail "$stage_label duplicate enum declaration emitted LLVM"
    fi
    echo "$stage_label storage switch: pass (let/state/member, Int/String/Bool/enum, enum state and call boundaries, exhaustive tags, deterministic, typed rejection matrix)"
}

audit_recursive_enum_declarations() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.recursive-enum.first.ll"
    local second="$WORK_ROOT/$stage_label.recursive-enum.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.recursive-enum.first.err"
    local second_error="$WORK_ROOT/$stage_label.recursive-enum.repeat.err"
    local linked="$stage_directory/RecursiveEnumDeclaration"
    local run_output="$WORK_ROOT/$stage_label.recursive-enum.run.out"
    local run_error="$WORK_ROOT/$stage_label.recursive-enum.run.err"

    run_capture "$executable" "$RECURSIVE_ENUM_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label recursive enum declaration" "$first" "$first_error"
    run_capture "$executable" "$RECURSIVE_ENUM_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated recursive enum declaration" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" || fail "$stage_label recursive enum declaration was not deterministic"
    validate_llvm "$first"
    link_llvm "$first" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label recursive enum declaration executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] || fail "$stage_label recursive enum declaration executable wrote output"

    local snapshot="$WORK_ROOT/$stage_label.recursive-enum.snapshot"
    local snapshot_error="$WORK_ROOT/$stage_label.recursive-enum.snapshot.err"
    run_capture "$executable" "$RECURSIVE_ENUM_SNAPSHOT_SOURCE" "$snapshot" "$snapshot_error"
    [[ "$RUN_STATUS" -eq 0 ]] || fail "$stage_label recursive enum typed snapshot exited $RUN_STATUS"
    [[ ! -s "$snapshot_error" ]] || fail "$stage_label recursive enum typed snapshot wrote stderr"
    /usr/bin/grep -Fq $'kind=casePayload\tstorage=binding' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted binding payload policy"
    /usr/bin/grep -Fq $'kind=casePayload\tstorage=indirect' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted indirect payload policy"
    /usr/bin/grep -Fq $'kind=casePayload\tstorage=direct' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted direct payload policy"
    /usr/bin/grep -Eq $'name=value.*type=BindingList.*kind=casePayload\tstorage=binding\ttypeTargetKind=typeReference\ttypeTargetID=0' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted the BindingList payload type-reference edge"
    /usr/bin/grep -Eq $'typeReference\tid=0\townerMemberRow=.*kind=named\ttargetKind=declaration\ttargetID=0\tchildCount=0\tdepth=0' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted the BindingList nominal type node"
    /usr/bin/grep -Eq $'name=value.*type=IndirectList.*kind=casePayload\tstorage=indirect\ttypeTargetKind=typeReference\ttypeTargetID=1' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted the IndirectList payload type-reference edge"
    /usr/bin/grep -Eq $'typeReference\tid=1\townerMemberRow=.*kind=named\ttargetKind=declaration\ttargetID=4\tchildCount=0\tdepth=0' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted the IndirectList nominal type node"
    /usr/bin/grep -Eq $'name=value.*type=Int.*kind=casePayload\tstorage=direct\ttypeTargetKind=typeReference\ttypeTargetID=2' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted the Int payload type-reference edge"
    /usr/bin/grep -Eq $'typeReference\tid=2\townerMemberRow=.*kind=named\ttargetKind=builtin\ttargetID=1\tchildCount=0\tdepth=0' "$snapshot" \
        || fail "$stage_label recursive enum typed snapshot omitted the Int builtin type node"

    local negative_kind negative_source negative_output negative_error
    for negative_kind in direct-self direct-mutual unknown duplicate-payload; do
        negative_source="$RECURSIVE_ENUM_DIRECT_SELF_SOURCE"
        if [[ "$negative_kind" == direct-mutual ]]; then
            negative_source="$RECURSIVE_ENUM_DIRECT_MUTUAL_SOURCE"
        elif [[ "$negative_kind" == unknown ]]; then
            negative_source="$RECURSIVE_ENUM_UNKNOWN_TYPE_SOURCE"
        elif [[ "$negative_kind" == duplicate-payload ]]; then
            negative_source="$RECURSIVE_ENUM_DUPLICATE_PAYLOAD_SOURCE"
        fi
        negative_output="$WORK_ROOT/$stage_label.recursive-enum.$negative_kind.out"
        negative_error="$WORK_ROOT/$stage_label.recursive-enum.$negative_kind.err"
        run_capture "$executable" "$negative_source" "$negative_output" "$negative_error"
        [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label recursive enum $negative_kind rejection exited $RUN_STATUS"
        [[ ! -s "$negative_error" ]] || fail "$stage_label recursive enum $negative_kind rejection wrote stderr"
        /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedDeclarations' "$negative_output" \
            || fail "$stage_label recursive enum $negative_kind missed the typed declaration diagnostic"
        if /usr/bin/grep -Fq 'define ' "$negative_output"; then
            fail "$stage_label recursive enum $negative_kind emitted LLVM"
        fi
    done
    local body_use_first="$WORK_ROOT/$stage_label.recursive-enum.body-use.first.ll"
    local body_use_second="$WORK_ROOT/$stage_label.recursive-enum.body-use.repeat.ll"
    local body_use_first_error="$WORK_ROOT/$stage_label.recursive-enum.body-use.first.err"
    local body_use_second_error="$WORK_ROOT/$stage_label.recursive-enum.body-use.repeat.err"
    local body_use_linked="$stage_directory/RecursiveBindingEnumSwitch"
    local body_use_run_output="$WORK_ROOT/$stage_label.recursive-enum.body-use.run.out"
    local body_use_run_error="$WORK_ROOT/$stage_label.recursive-enum.body-use.run.err"
    run_capture "$executable" "$RECURSIVE_ENUM_BODY_USE_SOURCE" "$body_use_first" "$body_use_first_error"
    require_successful_output "$stage_label recursive binding enum switch" "$body_use_first" "$body_use_first_error"
    run_capture "$executable" "$RECURSIVE_ENUM_BODY_USE_SOURCE" "$body_use_second" "$body_use_second_error"
    require_successful_output "$stage_label repeated recursive binding enum switch" "$body_use_second" "$body_use_second_error"
    /usr/bin/cmp -s "$body_use_first" "$body_use_second" \
        || fail "$stage_label recursive binding enum switch was not deterministic"
    /usr/bin/grep -Fq '%Range.List = type { i32, ptr }' "$body_use_first" \
        || fail "$stage_label recursive binding enum switch omitted native tag/pointer layout"
    /usr/bin/grep -Eq 'insertvalue %Range\.List .* ptr %storage[0-9]+, 1' "$body_use_first" \
        || fail "$stage_label recursive binding enum switch omitted the ID-selected binding address"
    /usr/bin/grep -Eq 'extractvalue %Range\.List .* 1' "$body_use_first" \
        || fail "$stage_label recursive binding enum switch omitted payload extraction"
    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$body_use_first"; then
            fail "$stage_label recursive binding enum switch emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done
    validate_llvm "$body_use_first"
    link_llvm "$body_use_first" "$body_use_linked"
    if "$body_use_linked" > "$body_use_run_output" 2> "$body_use_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label recursive binding enum switch executable exited $RUN_STATUS"
    [[ ! -s "$body_use_run_output" && ! -s "$body_use_run_error" ]] \
        || fail "$stage_label recursive binding enum switch executable wrote output"
    echo "$stage_label recursive enums: pass (ID-linked payload types, payload graph policies, binding/indirect cycle breaks, direct-cycle rejection, allocator-free native binding construction/switch, deterministic declaration proof)"
}

audit_native_payload_enum_abi() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.native-payload-enum-abi.first.ll"
    local second="$WORK_ROOT/$stage_label.native-payload-enum-abi.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.native-payload-enum-abi.first.err"
    local second_error="$WORK_ROOT/$stage_label.native-payload-enum-abi.repeat.err"
    local linked="$stage_directory/AssociatedEnumFunctionBoundary"
    local run_output="$WORK_ROOT/$stage_label.native-payload-enum-abi.run.out"
    local run_error="$WORK_ROOT/$stage_label.native-payload-enum-abi.run.err"

    run_capture "$executable" "$NATIVE_PAYLOAD_ENUM_ABI_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label native payload enum ABI" "$first" "$first_error"
    run_capture "$executable" "$NATIVE_PAYLOAD_ENUM_ABI_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated native payload enum ABI" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" \
        || fail "$stage_label native payload enum ABI was not deterministic"
    /usr/bin/grep -Fq '%Range.CompilerStep = type { i32, i32 }' "$first" \
        || fail "$stage_label native payload enum ABI omitted the aggregate enum layout"
    /usr/bin/grep -Fq 'define void @makeStep(ptr %returnDestination, i32 %value)' "$first" \
        || fail "$stage_label native payload enum ABI did not use an indirect aggregate return"
    /usr/bin/grep -Eq 'call void @makeStep\(ptr %storage[0-9]+, i32 7\)' "$first" \
        || fail "$stage_label native payload enum ABI caller did not provide enum return storage"
    /usr/bin/grep -Fq 'define i32 @readStep(%Range.CompilerStep %step)' "$first" \
        || fail "$stage_label native payload enum ABI did not preserve the enum parameter type"
    /usr/bin/grep -Eq 'call i32 @readStep\(%Range\.CompilerStep %r[0-9]+\)' "$first" \
        || fail "$stage_label native payload enum ABI call did not preserve the enum parameter type"
    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$first"; then
            fail "$stage_label native payload enum ABI emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done
    validate_llvm "$first"
    link_llvm "$first" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label native payload enum ABI executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] \
        || fail "$stage_label native payload enum ABI executable wrote output"
    echo "$stage_label native payload enum ABI: pass (frozen indirect return, native by-value parameter, deterministic, allocator-free)"
}

audit_placement_symbol_guard() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local first="$WORK_ROOT/$stage_label.placement-symbol-guard.first.ll"
    local second="$WORK_ROOT/$stage_label.placement-symbol-guard.repeat.ll"
    local first_error="$WORK_ROOT/$stage_label.placement-symbol-guard.first.err"
    local second_error="$WORK_ROOT/$stage_label.placement-symbol-guard.repeat.err"
    local llvm="$stage_directory/PlacementSymbolGuard.ll"
    local linked="$stage_directory/PlacementSymbolGuard"
    local run_output="$WORK_ROOT/$stage_label.placement-symbol-guard.run.out"
    local run_error="$WORK_ROOT/$stage_label.placement-symbol-guard.run.err"

    run_capture "$executable" "$PLACEMENT_GUARD_SOURCE" "$first" "$first_error"
    require_successful_output "$stage_label placement symbol guard" "$first" "$first_error"
    run_capture "$executable" "$PLACEMENT_GUARD_SOURCE" "$second" "$second_error"
    require_successful_output "$stage_label repeated placement symbol guard" "$second" "$second_error"
    /usr/bin/cmp -s "$first" "$second" \
        || fail "$stage_label placement symbol guard LLVM was not deterministic"

    for marker in \
        '%Range.PlacementGuardPair = type { i32, i32 }' \
        'define void @placementGuardAggregate(ptr %returnDestination' \
        'call void @placementGuardAggregate('; do
        /usr/bin/grep -Fq "$marker" "$first" \
            || fail "$stage_label placement symbol guard omitted native marker: $marker"
    done
    for forbidden in rangeConstruct malloc calloc realloc free; do
        if /usr/bin/grep -Fq "$forbidden" "$first"; then
            fail "$stage_label placement symbol guard emitted forbidden dynamic/allocator symbol: $forbidden"
        fi
    done

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$first" "$llvm"
    validate_llvm "$llvm"
    link_llvm "$llvm" "$linked"
    if "$linked" > "$run_output" 2> "$run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label placement symbol guard executable exited $RUN_STATUS"
    [[ ! -s "$run_output" && ! -s "$run_error" ]] \
        || fail "$stage_label placement symbol guard executable wrote output"
    echo "$stage_label placement symbol guard: pass (parameter declaration rows cannot become placement node IDs)"
}

compare_placement_symbol_guard_stages() {
    local left_label="$1"
    local left_directory="$2"
    local right_label="$3"
    local right_directory="$4"

    /usr/bin/cmp -s "$WORK_ROOT/$left_label.placement-symbol-guard.first.ll" "$WORK_ROOT/$right_label.placement-symbol-guard.first.ll" \
        || fail "$left_label and $right_label placement symbol guard LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/$left_label.placement-symbol-guard.repeat.ll" "$WORK_ROOT/$right_label.placement-symbol-guard.repeat.ll" \
        || fail "$left_label and $right_label repeated placement symbol guard LLVM differs"
    /usr/bin/cmp -s "$left_directory/PlacementSymbolGuard.ll" "$right_directory/PlacementSymbolGuard.ll" \
        || fail "$left_label and $right_label placement symbol guard artifacts differ"
    /usr/bin/cmp -s "$left_directory/PlacementSymbolGuard" "$right_directory/PlacementSymbolGuard" \
        || fail "$left_label and $right_label placement symbol guard executables differ"
    echo "$left_label/$right_label placement symbol guard: byte-identical LLVM/executable"
}

audit_mixed_abi() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.mixed-abi.out"
    local error="$WORK_ROOT/$stage_label.mixed-abi.err"

    run_capture "$executable" "$MIXED_ABI_SOURCE" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label mixed aggregate ABI check exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label mixed aggregate ABI check wrote stderr"
    /usr/bin/grep -Fq 'compilerError' "$output" \
        && /usr/bin/grep -Fq 'kind=representationSensitiveABICapabilityBlocked' "$output" \
        || fail "$stage_label mixed aggregate ABI check missed capability diagnostic"
    if /usr/bin/grep -Fq 'define ' "$output" || /usr/bin/grep -Fq 'call ' "$output"; then
        fail "$stage_label mixed aggregate ABI check emitted LLVM before rejection"
    fi
    echo "$stage_label mixed aggregate ABI rejection: pass (exit 65, pre-emission)"
}

body_syntax_typed_kind_count() {
    local output="$1"
    local kind="$2"

    /usr/bin/awk -F '\t' -v expected="kind=$kind" '
        $1 == "syntax" {
            for (column = 2; column <= NF; column += 1) {
                if ($column == expected) { count += 1 }
            }
        }
        END { print count + 0 }
    ' "$output"
}

body_syntax_typed_edge_role_count() {
    local output="$1"
    local role="$2"

    /usr/bin/awk -F '[=,\t]' -v expected="$role" '
        $1 == "bodyEdge" && $7 == expected { count += 1 }
        END { print count + 0 }
    ' "$output"
}

audit_body_syntax_split() {
    local stage_label="$1"
    local executable="$2"
    local stage_directory="$3"
    local typed_bundle="$WORK_ROOT/$stage_label.body-syntax.typed.range"
    local typed_first="$WORK_ROOT/$stage_label.body-syntax.typed.first.out"
    local typed_second="$WORK_ROOT/$stage_label.body-syntax.typed.repeat.out"
    local typed_first_error="$WORK_ROOT/$stage_label.body-syntax.typed.first.err"
    local typed_second_error="$WORK_ROOT/$stage_label.body-syntax.typed.repeat.err"
    local detached_bundle="$WORK_ROOT/$stage_label.body-syntax.detached.range"
    local detached_first="$WORK_ROOT/$stage_label.body-syntax.detached.first.ll"
    local detached_second="$WORK_ROOT/$stage_label.body-syntax.detached.repeat.ll"
    local detached_first_error="$WORK_ROOT/$stage_label.body-syntax.detached.first.err"
    local detached_second_error="$WORK_ROOT/$stage_label.body-syntax.detached.repeat.err"
    local detached_llvm="$stage_directory/BodySyntaxDetachedOffset.ll"
    local detached_executable="$stage_directory/BodySyntaxDetachedOffset"
    local detached_run_output="$WORK_ROOT/$stage_label.body-syntax.detached.run.out"
    local detached_run_error="$WORK_ROOT/$stage_label.body-syntax.detached.run.err"

    write_body_syntax_typed_replay_bundle "$typed_bundle"
    run_capture "$executable" "$typed_bundle" "$typed_first" "$typed_first_error"
    require_successful_output "$stage_label typed body syntax" "$typed_first" "$typed_first_error"
    run_capture "$executable" "$typed_bundle" "$typed_second" "$typed_second_error"
    require_successful_output "$stage_label repeated typed body syntax" "$typed_second" "$typed_second_error"
    /usr/bin/cmp -s "$typed_first" "$typed_second" || fail "$stage_label typed body syntax was not deterministic"

    /usr/bin/grep -Fq $'bodyNodeCount=13\tbodyEdgeCount=12' "$typed_first" \
        || fail "$stage_label typed body syntax changed its canonical node/edge counts"
    /usr/bin/grep -Fq $'typedTable\tname=bodyNode\tversion=1\tcolumns=11\trows=13' "$typed_first" \
        || fail "$stage_label typed body syntax omitted its canonical body-node table"
    /usr/bin/grep -Fq $'typedTable\tname=bodyEdge\tversion=1\tcolumns=4\trows=12' "$typed_first" \
        || fail "$stage_label typed body syntax omitted its canonical body-edge table"

    local specification kind expected actual
    for specification in \
        entry:1 \
        local:1 \
        return:2 \
        identifier:4 \
        application:1 \
        integerLiteral:1 \
        addition:1 \
        argument:1 \
        mainAnnotation:1; do
        kind="${specification%%:*}"
        expected="${specification#*:}"
        actual="$(body_syntax_typed_kind_count "$typed_first" "$kind")"
        [[ "$actual" -eq "$expected" ]] \
            || fail "$stage_label typed body syntax emitted $actual $kind nodes; expected $expected"
    done

    for specification in 1:3 2:1 3:2 4:1 5:1 6:1 8:1 9:1 12:1; do
        kind="${specification%%:*}"
        expected="${specification#*:}"
        actual="$(body_syntax_typed_edge_role_count "$typed_first" "$kind")"
        [[ "$actual" -eq "$expected" ]] \
            || fail "$stage_label typed body syntax emitted $actual role-$kind edges; expected $expected"
    done

    write_body_syntax_detached_interpolation_bundle "$detached_bundle"
    run_capture "$executable" "$detached_bundle" "$detached_first" "$detached_first_error"
    require_successful_output "$stage_label detached interpolation" "$detached_first" "$detached_first_error"
    run_capture "$executable" "$detached_bundle" "$detached_second" "$detached_second_error"
    require_successful_output "$stage_label repeated detached interpolation" "$detached_second" "$detached_second_error"
    /usr/bin/cmp -s "$detached_first" "$detached_second" || fail "$stage_label detached interpolation LLVM was not deterministic"
    for marker in \
        'define i32 @detachedInterpolationValue' \
        'define ptr @detachedInterpolationText' \
        'call i32 @detachedInterpolationValue' \
        'call ptr @stringFromInt' \
        'call ptr @stringConcat' \
        'call i32 @stringEqual'; do
        /usr/bin/grep -Fq "$marker" "$detached_first" \
            || fail "$stage_label detached interpolation omitted LLVM marker: $marker"
    done
    if /usr/bin/grep -Fq 'RANGE_LOWERING_PLACEHOLDER' "$detached_first"; then
        fail "$stage_label detached interpolation used a lowering placeholder"
    fi

    /bin/mkdir -p "$stage_directory"
    /bin/cp "$detached_first" "$detached_llvm"
    validate_llvm "$detached_llvm"
    link_llvm "$detached_llvm" "$detached_executable"
    if "$detached_executable" > "$detached_run_output" 2> "$detached_run_error"; then
        RUN_STATUS=0
    else
        RUN_STATUS=$?
    fi
    [[ "$RUN_STATUS" -eq 7 ]] || fail "$stage_label detached interpolation executable exited $RUN_STATUS"
    [[ ! -s "$detached_run_output" && ! -s "$detached_run_error" ]] \
        || fail "$stage_label detached interpolation executable wrote output"
    echo "$stage_label body syntax replay: pass (typed nodes+edges exact; detached offset validate/link, exit 7, deterministic)"
}

compare_body_syntax_split_stages() {
    local left_label="$1"
    local left_directory="$2"
    local right_label="$3"
    local right_directory="$4"
    local suffix

    for suffix in \
        typed.first.out \
        typed.repeat.out \
        detached.first.ll \
        detached.repeat.ll; do
        /usr/bin/cmp -s "$WORK_ROOT/$left_label.body-syntax.$suffix" "$WORK_ROOT/$right_label.body-syntax.$suffix" \
            || fail "$left_label and $right_label body syntax output differs: $suffix"
    done
    /usr/bin/cmp -s "$left_directory/BodySyntaxDetachedOffset.ll" "$right_directory/BodySyntaxDetachedOffset.ll" \
        || fail "$left_label and $right_label detached interpolation artifacts differ"
    /usr/bin/cmp -s "$left_directory/BodySyntaxDetachedOffset" "$right_directory/BodySyntaxDetachedOffset" \
        || fail "$left_label and $right_label detached interpolation executables differ"
    echo "$left_label/$right_label body syntax replay: byte-identical typed snapshots/LLVM/executable"
}

audit_builtin_marker() {
    local stage_label="$1"
    local executable="$2"
    local output="$WORK_ROOT/$stage_label.builtin.legacy.out"
    local error="$WORK_ROOT/$stage_label.builtin.legacy.err"

    run_capture "$executable" "$LEGACY_LANGUAGE_SOURCE" "$output" "$error"
    [[ "$RUN_STATUS" -eq 65 ]] || fail "$stage_label legacy language marker exited $RUN_STATUS"
    [[ ! -s "$error" ]] || fail "$stage_label legacy language marker wrote stderr"
    /usr/bin/grep -Fq $'compilerError\tkind=invalidTypedSyntaxSnapshot' "$output" \
        || fail "$stage_label legacy language marker granted builtin provenance"
    echo "$stage_label builtin marker: pass (legacy spelling rejected)"
}

write_role_bundle() {
    local output="$1"
    local directive="$2"

    /usr/bin/printf '%s\n' \
        "$directive" \
        'compilerSourceFile\trole=core\tpath=Core.range' \
        'construct RoleCore {}' \
        'compilerSourceFile\trole=foundation\tpath=Foundation.range' \
        'construct RoleFoundation {}' \
        'compilerSourceFile\trole=framework\tpath=Framework.range' \
        'construct RoleFramework {}' \
        'compilerSourceFile\trole=generated\tpath=Generated.range' \
        'construct RoleGenerated {}' \
        'compilerSourceFile\trole=project\tpath=Project.range' \
        'construct RoleProject {}' \
        'compilerSourceFile\tLegacy.range' \
        'construct RoleLegacy {}' > "$output"
}

write_fingerprint_bundle() {
    local output="$1"
    local role="$2"

    /usr/bin/printf '%s\n' \
        'compilerTypedSyntax' \
        "compilerSourceFile\\trole=$role\\tpath=Fingerprint.range" \
        'construct FingerprintRole {}' > "$output"
}

write_invalid_role_bundle() {
    local output="$1"
    local marker="$2"

    /usr/bin/printf '%s\n' \
        'compilerSourceInventory' \
        "$marker" \
        'construct InvalidRole {}' > "$output"
}

write_core_bundle() {
    local output="$1"
    local directive="$2"

    if [[ -n "$directive" ]]; then
        /usr/bin/printf '%s\n' "$directive" > "$output"
    else
        /usr/bin/printf '%s' '' > "$output"
    fi
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/RawBuffer.range' >> "$output"
    /bin/cat "$CORE_SOURCE_PATH" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$CORE_SOURCE_PATH")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%s\n' \
        'compilerSourceFile\trole=project\tpath=CoreUse.range' \
        'function MainTextDecoy(): Int { return stringLength(value: " @main ") }' \
        '@main {' \
        '    let buffer: RawBuffer(rawBufferCreate(capacity: 0, stride: 4))' \
        '    return rawBufferDestroy(buffer: buffer) + 7' \
        '}' >> "$output"
}

write_body_syntax_typed_replay_bundle() {
    local output="$1"

    /usr/bin/printf '%s\n' 'compilerTypedSyntax' > "$output"
    /bin/cat >> "$output" <<'RANGE'
function bodySyntaxParityValue(value: Int): Int {
    let doubled: Int(value + value)
    return doubled
}

@main {
    return bodySyntaxParityValue(value: 7)
}
RANGE
}

write_body_syntax_detached_interpolation_bundle() {
    local output="$1"

    /bin/cat > "$output" <<'RANGE'
function detachedInterpolationValue(): Int {
    return 6
}

function detachedInterpolationText(): String {
    return "detached-offset-prefix \(detachedInterpolationValue() + 1)"
}

@main {
    let rendered: String(detachedInterpolationText())
    if rendered == "detached-offset-prefix 7" {
        return 7
    }
    return 1
}
RANGE
}

write_binding_reference_bundle() {
    local output="$1"
    local kind="$2"

    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=core\tpath=RangeCompiler/Sources/Core/System/Memory/RawBuffer.range' > "$output"
    /bin/cat "$CORE_SOURCE_PATH" >> "$output"
    if [[ -n "$(/usr/bin/tail -c 1 "$CORE_SOURCE_PATH")" ]]; then
        /usr/bin/printf '\n' >> "$output"
    fi
    /usr/bin/printf '%s\n' 'compilerSourceFile\trole=project\tpath=BindingReference.range' >> "$output"

    case "$kind" in
        local)
            /bin/cat >> "$output" <<'RANGE'
construct LocalBufferView {
    binding storage: RawBuffer
}

function bindingReadCount(buffer: RawBuffer): Int {
    return rawBufferCount(buffer: buffer)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let view: LocalBufferView(storage: $source)
    let count: Int(bindingReadCount(buffer: view.storage))
    let value: Int(rawBufferLoadInt(buffer: source, index: 0))
    rawBufferDestroy(buffer: source)
    return value + count - 1
}
RANGE
            ;;
        member)
            /bin/cat >> "$output" <<'RANGE'
construct BufferHolder {
    let storage: RawBuffer
}

construct MemberBufferView {
    binding storage: RawBuffer
}

function bindingReadFirst(buffer: RawBuffer): Int {
    return rawBufferLoadInt(buffer: buffer, index: 0)
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: source, value: 7)
    let holder: BufferHolder(storage: source)
    let view: MemberBufferView(storage: $holder.storage)
    let value: Int(bindingReadFirst(buffer: view.storage))
    rawBufferDestroy(buffer: holder.storage)
    return value
}
RANGE
            ;;
        missing-dollar)
            /bin/cat >> "$output" <<'RANGE'
construct MissingDollarView {
    binding storage: RawBuffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let view: MissingDollarView(storage: source)
    return 0
}
RANGE
            ;;
        alias-destroy)
            /bin/cat >> "$output" <<'RANGE'
construct DestroyAliasView {
    binding storage: RawBuffer
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let view: DestroyAliasView(storage: $source)
    rawBufferDestroy(buffer: view.storage)
    return 0
}
RANGE
            ;;
        direct-destroy)
            /bin/cat >> "$output" <<'RANGE'
@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferDestroy(buffer: $source)
    return 0
}
RANGE
            ;;
        helper-destroy)
            /bin/cat >> "$output" <<'RANGE'
