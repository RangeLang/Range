function makeArenaEmitterResult(owners: ArenaEmitterAliasOwners): ArenaEmitterResult {
    let firstOwned: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: firstOwned, value: 1)
    let secondOwned: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: secondOwned, value: 2)
    let result: ArenaEmitterResult(ArenaEmitterResult(firstOwned: firstOwned, secondOwned: secondOwned, firstAlias: $owners.first, secondAlias: $owners.second))
    return result
}

@main {
    let firstAlias: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: firstAlias, value: 1)
    let secondAlias: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
