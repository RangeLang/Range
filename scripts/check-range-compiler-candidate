    RECURSIVE_ENUM_BODY_USE_SOURCE="$REPO_ROOT/Testing/Enums/Pass/ReturnRecursiveBindingEnumSwitch.range"
    NATIVE_PAYLOAD_ENUM_ABI_SOURCE="$REPO_ROOT/Testing/Enums/Pass/ReturnAssociatedEnumFunctionBoundary.range"

    PLACEMENT_GUARD_SOURCE="$WORK_ROOT/PlacementSymbolGuard.range"
    /usr/bin/printf '%s\n' \
        'construct PlacementGuardPair {' \
        '    let first: Int' \
        '    let second: Int' \
        '}' \
        '' \
        'function placementGuardPadding(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int): Int {' \
        '    return 0' \
        '}' \
        '' \
        'function placementGuardAggregate(value: Int): PlacementGuardPair {' \
        '    let result: PlacementGuardPair(first: value, second: 7)' \
        '    return result' \
        '}' \
        '' \
        '@main {' \
        '    let result: PlacementGuardPair(placementGuardAggregate(value: 0))' \
        '    return result.second' \
        '}' > "$PLACEMENT_GUARD_SOURCE"

    MIXED_ABI_SOURCE="$WORK_ROOT/MixedABINegative.range"
    /usr/bin/printf '%s\n' \
        'construct ABIPair {' \
        '    let first: Int' \
        '    let second: Int' \
        '}' \
        '' \
        'function brokenPair(): ABIPair {' \
        '    return 1' \
        '}' \
        '' \
        '@main {' \
        '    let value: ABIPair(brokenPair())' \
        '    return value.first' \
        '}' > "$MIXED_ABI_SOURCE"

    LEGACY_LANGUAGE_SOURCE="$WORK_ROOT/LegacyLanguageMarker.range"
    local legacy_language_marker="@""language"
    /usr/bin/printf '%s\n' \
        'compilerTypedSyntax' \
        "$legacy_language_marker" \
        'function legacyExternal(): Int' \
        '@main {' \
        '    return 0' \
        '}' > "$LEGACY_LANGUAGE_SOURCE"

    local build_root stage2_directory stage3_directory
    local stage2_llvm stage2_executable stage3_llvm stage3_executable
    build_root="$compiler_directory/.range/Build"
    stage2_directory="$build_root/stage2"
    stage3_directory="$build_root/stage3"
    stage2_llvm="$stage2_directory/RangeCompiler.ll"
    stage2_executable="$stage2_directory/RangeCompiler"
    stage3_llvm="$stage3_directory/RangeCompiler.ll"
    stage3_executable="$stage3_directory/RangeCompiler"

    if [[ -d "$build_root" ]]; then
        /bin/chmod -R u+w "$build_root"
    fi
    /bin/rm -rf "$build_root"
    /bin/mkdir -p "$build_root"
    CANDIDATE_BUILD_PLAN="$build_root/RangeCompiler.build-plan.tsv"
    local stage2_producer_id=accepted-seed
    if [[ -n "$bootstrap_bridge_source_directory" ]]; then
        stage2_producer_id=bootstrap-bridge
    fi
    write_candidate_build_plan "$CANDIDATE_BUILD_PLAN" "$stage2_producer_id"
    validate_candidate_build_plan "$CANDIDATE_BUILD_PLAN" "$stage2_producer_id"
    CANDIDATE_BUILD_PLAN_SHA256="$(sha256 "$CANDIDATE_BUILD_PLAN")"
    echo "checkpoint compiler-candidate:plan-authored: pass"
    echo "candidate build plan: pass (version 1, deterministic logical paths)"

    local seed seed_executable
    seed="$REPO_ROOT/$(manifest_value seed.path)"
    seed_executable="$WORK_ROOT/RangeCompilerSeed"
    clang "$COMPILER_OPTIMIZATION" "$COMPILER_LTO" -Wno-override-module -x ir "$seed" -x c "${RUNTIME_INPUTS[@]}" -o "$seed_executable"
    echo "checkpoint compiler-candidate:seed-linked: pass"
    echo "bootstrap seed link: pass"

    local stage2_producer="$seed_executable"
    local bootstrap_bridge_artifact_directory=""
    local bootstrap_bridge_first_llvm=""
    local bootstrap_bridge_second_llvm=""
    local bootstrap_bridge_executable=""
    if [[ -n "$bootstrap_bridge_source_directory" ]]; then
        bootstrap_bridge_artifact_directory="$WORK_ROOT/bootstrap-bridge"
        bootstrap_bridge_first_llvm="$bootstrap_bridge_artifact_directory/RangeCompilerBridge.first.ll"
        bootstrap_bridge_second_llvm="$bootstrap_bridge_artifact_directory/RangeCompilerBridge.second.ll"
        bootstrap_bridge_executable="$bootstrap_bridge_artifact_directory/RangeCompilerBridge"
        /bin/mkdir -p "$bootstrap_bridge_artifact_directory"

        emit_candidate_llvm "$seed_executable" "$bootstrap_bridge_source_bundle" "$bootstrap_bridge_first_llvm" bootstrap-bridge-first
        emit_candidate_llvm "$seed_executable" "$bootstrap_bridge_source_bundle" "$bootstrap_bridge_second_llvm" bootstrap-bridge-second
        /usr/bin/cmp -s "$bootstrap_bridge_first_llvm" "$bootstrap_bridge_second_llvm" \
            || fail "bootstrap bridge LLVM was not deterministic"
        validate_llvm "$bootstrap_bridge_first_llvm"
        validate_llvm "$bootstrap_bridge_second_llvm"
        link_llvm "$bootstrap_bridge_first_llvm" "$bootstrap_bridge_executable"
        echo "bootstrap bridge deterministic validate/link: pass"

        audit_binding_references BootstrapBridge "$bootstrap_bridge_executable" "$bootstrap_bridge_artifact_directory"
        audit_root_values BootstrapBridge "$bootstrap_bridge_executable" "$bootstrap_bridge_artifact_directory"
        audit_placement_symbol_guard BootstrapBridge "$bootstrap_bridge_executable" "$bootstrap_bridge_artifact_directory"
        stage2_producer="$bootstrap_bridge_executable"
        echo "bootstrap bridge ownership capability: pass (binding aliases, RootValue, placement guard, one-shot producer only)"
    fi

    emit_candidate_llvm "$stage2_producer" "$SOURCE_BUNDLE" "$stage2_llvm" stage2
    echo "checkpoint compiler-candidate:stage2-emitted: pass"
    assert_candidate_build_plan_unchanged
    validate_llvm "$stage2_llvm"
    echo "checkpoint compiler-candidate:stage2-validated: pass"
    link_llvm "$stage2_llvm" "$stage2_executable"
    echo "checkpoint compiler-candidate:stage2-linked: pass"
    echo "Stage 2 candidate validate/link: pass"
    audit_candidate_build_plan_snapshot Stage2 "$stage2_executable"
    echo "checkpoint compiler-candidate:stage2-plan-read: pass"
    echo "Stage 2 build plan snapshot: deterministic"
    local stage2_loaded_source_bundle="$WORK_ROOT/Stage2.RangeLoadedSourceSet.range"
    materialize_candidate_source_bundle Stage2 "$stage2_executable" "$stage2_loaded_source_bundle"
    echo "checkpoint compiler-candidate:stage2-source-loaded: pass"
    if [[ "$checkpoint_mode" == stage2-plan ]]; then
        echo "Range compiler Stage 2 plan checkpoint succeeded."
        printf 'compiler_directory=%s\n' "$compiler_directory"
        printf 'source_inventory_count=%s\n' "${#SOURCE_FILES[@]}"
        report_artifact candidate_build_plan "$CANDIDATE_BUILD_PLAN"
        report_artifact stage2_llvm "$stage2_llvm"
        report_artifact stage2_executable "$stage2_executable"
        echo "checkpoint compiler-candidate:stage2-plan-complete: pass"
        return 0
    fi
    audit_stage Stage2 "$stage2_executable" "$stage2_directory"
    echo "checkpoint compiler-candidate:stage2-audited: pass"
    assert_candidate_build_plan_unchanged

    emit_candidate_llvm "$stage2_executable" "$stage2_loaded_source_bundle" "$stage3_llvm" stage3
    echo "checkpoint compiler-candidate:stage3-emitted: pass"
    validate_llvm "$stage3_llvm"
    echo "checkpoint compiler-candidate:stage3-validated: pass"
    link_llvm "$stage3_llvm" "$stage3_executable"
    echo "checkpoint compiler-candidate:stage3-linked: pass"
    local stage3_loaded_source_bundle="$WORK_ROOT/Stage3.RangeLoadedSourceSet.range"
    materialize_candidate_source_bundle Stage3 "$stage3_executable" "$stage3_loaded_source_bundle"
    /usr/bin/cmp -s "$stage2_loaded_source_bundle" "$stage3_loaded_source_bundle" \
        || fail "Stage 2 and Stage 3 Range-loaded source bundles differ"
    echo "checkpoint compiler-candidate:stage3-source-loaded: pass"
    /usr/bin/cmp -s "$stage2_llvm" "$stage3_llvm" || fail "Stage 2 and Stage 3 LLVM are not byte-identical"
    /usr/bin/cmp -s "$stage2_executable" "$stage3_executable" || fail "Stage 2 and Stage 3 executables are not byte-identical"
    echo "checkpoint compiler-candidate:stage3-fixed-point: pass"
    echo "Stage 3 candidate validate/link and fixed point: pass"
    assert_candidate_build_plan_unchanged
    audit_candidate_build_plan_snapshot Stage3 "$stage3_executable"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.build-plan.first.snapshot" "$WORK_ROOT/Stage3.build-plan.first.snapshot" \
        || fail "Stage 2 and Stage 3 build plan snapshots differ"
    echo "checkpoint compiler-candidate:stage3-plan-read: pass"
    echo "Stage 2/Stage 3 build plan snapshot: deterministic and byte-identical"
    audit_stage Stage3 "$stage3_executable" "$stage3_directory"
    echo "checkpoint compiler-candidate:stage3-audited: pass"
    assert_candidate_build_plan_unchanged

    compare_binding_reference_stages Stage2 "$stage2_directory" Stage3 "$stage3_directory"
    compare_root_value_stages Stage2 "$stage2_directory" Stage3 "$stage3_directory"
    compare_body_syntax_split_stages Stage2 "$stage2_directory" Stage3 "$stage3_directory"
    compare_placement_symbol_guard_stages Stage2 "$stage2_directory" Stage3 "$stage3_directory"
    if [[ -n "$bootstrap_bridge_source_directory" ]]; then
        compare_binding_reference_stages BootstrapBridge "$bootstrap_bridge_artifact_directory" Stage2 "$stage2_directory"
        compare_root_value_stages BootstrapBridge "$bootstrap_bridge_artifact_directory" Stage2 "$stage2_directory"
        compare_placement_symbol_guard_stages BootstrapBridge "$bootstrap_bridge_artifact_directory" Stage2 "$stage2_directory"
    fi

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-native.first.ll" "$WORK_ROOT/Stage3.macro.execution-native.first.ll" \
        || fail "Stage 2 and Stage 3 native macro integration LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-native.repeat.ll" "$WORK_ROOT/Stage3.macro.execution-native.repeat.ll" \
        || fail "Stage 2 and Stage 3 repeated native macro integration LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/MacroExecution.ll" "$stage3_directory/MacroExecution.ll" \
        || fail "Stage 2 and Stage 3 native macro integration artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MacroExecution" "$stage3_directory/MacroExecution" \
        || fail "Stage 2 and Stage 3 native macro integration executables differ"
    echo "Stage 2/Stage 3 native macro integration: byte-identical LLVM/executable"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-member-native.first.ll" "$WORK_ROOT/Stage3.macro.execution-member-native.first.ll" \
        || fail "Stage 2 and Stage 3 present member query LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.execution-member-native.repeat.ll" "$WORK_ROOT/Stage3.macro.execution-member-native.repeat.ll" \
        || fail "Stage 2 and Stage 3 repeated present member query LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/MemberQueryNative.ll" "$stage3_directory/MemberQueryNative.ll" \
        || fail "Stage 2 and Stage 3 present member query artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MemberQueryNative" "$stage3_directory/MemberQueryNative" \
        || fail "Stage 2 and Stage 3 present member query executables differ"
    echo "Stage 2/Stage 3 present member query: byte-identical LLVM/executable"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.expansion-commit.first.ll" "$WORK_ROOT/Stage3.macro.expansion-commit.first.ll" \
        || fail "Stage 2 and Stage 3 committed macro expansion LLVM differs"
    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.expansion-commit.repeat.ll" "$WORK_ROOT/Stage3.macro.expansion-commit.repeat.ll" \
        || fail "Stage 2 and Stage 3 repeated committed macro expansion LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/MacroExpansion.ll" "$stage3_directory/MacroExpansion.ll" \
        || fail "Stage 2 and Stage 3 committed macro expansion artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MacroExpansion" "$stage3_directory/MacroExpansion" \
        || fail "Stage 2 and Stage 3 committed macro expansion executables differ"
    echo "Stage 2/Stage 3 committed macro expansion: byte-identical LLVM/executable"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.registrable.native.ll" "$WORK_ROOT/Stage3.macro.registrable.native.ll" \
        || fail "Stage 2 and Stage 3 actual registrable LLVM differs"
    /usr/bin/cmp -s "$stage2_directory/Registrable.ll" "$stage3_directory/Registrable.ll" \
        || fail "Stage 2 and Stage 3 actual registrable artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/Registrable" "$stage3_directory/Registrable" \
        || fail "Stage 2 and Stage 3 actual registrable executables differ"
    echo "Stage 2/Stage 3 actual registrable macro: byte-identical LLVM/executable"

    local macro_snapshot_suffix
    for macro_snapshot_suffix in positive.first.out positive.reordered.out generated.snapshot.out generated.snapshot.repeat.out generated.reordered.out generated.native.first.ll generated.native.repeat.ll generated.bare.out generated.user-global.out generated.root-collision.out generated.member-collision.out generated.malformed-extension.out generated.outside.out registrable.snapshot.out registrable.reordered.out registrable.native.ll registrable.authored-field-collision.out registrable.generated-field-collision.out registrable.root-storage.out registrable.malformed-splice.out registrable.immutable-field-mutation.out unresolved.out duplicate.out malformed-declaration.out malformed-application.out mismatch.out execution-positive.out execution-positive.repeat.out execution-query.out execution-query.repeat.out execution-query-reordered.out execution-query-zero.out execution-member-present.out execution-member-present.repeat.out execution-member-present-reordered.out execution-member-missing.out execution-member-missing.repeat.out execution-member-path.out execution-member-path.repeat.out execution-member-invalid.out execution-member-invalid.repeat.out execution-member-invalid-type.out execution-member-invalid-type.repeat.out execution-member-nonconstruct.out execution-member-native.first.ll execution-member-native.repeat.ll execution-member-missing-native.out execution-expansion.out execution-expansion.repeat.out execution-multiple.out execution-error.out execution-denied.out execution-query-invalid.out execution-expansion-duplicate.out execution-target-denied.out execution-fuel.out execution-malformed-header.out execution-duplicate-header.out; do
        /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro.$macro_snapshot_suffix" "$WORK_ROOT/Stage3.macro.$macro_snapshot_suffix" \
            || fail "Stage 2 and Stage 3 macro snapshot differs: $macro_snapshot_suffix"
    done
    echo "Stage 2/Stage 3 focused macro snapshots: byte-identical"

    local macro_family_suffix
    for macro_family_suffix in positive.out positive.repeat.out reordered.out unknown.out typed.out general.out positive.runtime reordered.runtime ordinary.first.ll ordinary.repeat.ll; do
        /usr/bin/cmp -s "$WORK_ROOT/Stage2.macro-family.$macro_family_suffix" "$WORK_ROOT/Stage3.macro-family.$macro_family_suffix" \
            || fail "Stage 2 and Stage 3 macro-family MemoryGraph differs: $macro_family_suffix"
    done
    /usr/bin/cmp -s "$stage2_directory/MacroFamily.ll" "$stage3_directory/MacroFamily.ll" \
        || fail "Stage 2 and Stage 3 macro-family LLVM artifacts differ"
    /usr/bin/cmp -s "$stage2_directory/MacroFamily" "$stage3_directory/MacroFamily" \
        || fail "Stage 2 and Stage 3 macro-family executables differ"
    echo "Stage 2/Stage 3 macro-family MemoryGraph: byte-identical"

    /usr/bin/cmp -s "$WORK_ROOT/Stage2.builtin.legacy.out" "$WORK_ROOT/Stage3.builtin.legacy.out" \
        || fail "Stage 2 and Stage 3 legacy builtin-marker rejection differs"
    echo "Stage 2/Stage 3 builtin marker rejection: byte-identical"
    assert_candidate_build_plan_unchanged
    validate_candidate_build_plan "$CANDIDATE_BUILD_PLAN" "$stage2_producer_id"

    echo "checkpoint compiler-candidate:complete: pass"
    echo "Range compiler candidate check succeeded."
    printf 'compiler_directory=%s\n' "$compiler_directory"
    if [[ -n "$bootstrap_bridge_source_directory" ]]; then
        printf 'bootstrap_bridge_source_directory=%s\n' "$bootstrap_bridge_source_directory"
        printf 'bootstrap_bridge_source_inventory_count=%s\n' "$bootstrap_bridge_source_inventory_count"
        local bootstrap_bridge_source_index
        for bootstrap_bridge_source_index in "${!bootstrap_bridge_source_relative_paths[@]}"; do
            printf 'bootstrap_bridge_source_inventory_path_%s=%s\n' "$bootstrap_bridge_source_index" "${bootstrap_bridge_source_relative_paths[$bootstrap_bridge_source_index]}"
        done
        report_ephemeral_artifact bootstrap_bridge_source_bundle "$bootstrap_bridge_source_bundle"
        report_ephemeral_artifact bootstrap_bridge_first_llvm "$bootstrap_bridge_first_llvm"
        report_ephemeral_artifact bootstrap_bridge_second_llvm "$bootstrap_bridge_second_llvm"
        report_ephemeral_artifact bootstrap_bridge_executable "$bootstrap_bridge_executable"
        echo "bootstrap_bridge_artifacts=ephemeral-cleaned-on-exit"
        echo "bootstrap_bridge_fixed_point=not-claimed"
    fi
    printf 'source_inventory_count=%s\n' "${#SOURCE_FILES[@]}"
    local index
    for index in "${!SOURCE_RELATIVE_PATHS[@]}"; do
        printf 'source_inventory_path_%s=%s\n' "$index" "${SOURCE_RELATIVE_PATHS[$index]}"
    done
    report_artifact candidate_build_plan "$CANDIDATE_BUILD_PLAN"
    report_artifact stage2_llvm "$stage2_llvm"
    report_artifact stage3_llvm "$stage3_llvm"
    report_artifact stage2_executable "$stage2_executable"
    report_artifact stage3_executable "$stage3_executable"
    report_artifact stage2_macro_execution_llvm "$stage2_directory/MacroExecution.ll"
    report_artifact stage3_macro_execution_llvm "$stage3_directory/MacroExecution.ll"
    report_artifact stage2_macro_execution_executable "$stage2_directory/MacroExecution"
    report_artifact stage3_macro_execution_executable "$stage3_directory/MacroExecution"
    report_artifact stage2_member_query_native_llvm "$stage2_directory/MemberQueryNative.ll"
    report_artifact stage3_member_query_native_llvm "$stage3_directory/MemberQueryNative.ll"
    report_artifact stage2_member_query_native_executable "$stage2_directory/MemberQueryNative"
    report_artifact stage3_member_query_native_executable "$stage3_directory/MemberQueryNative"
    report_artifact stage2_macro_expansion_llvm "$stage2_directory/MacroExpansion.ll"
    report_artifact stage3_macro_expansion_llvm "$stage3_directory/MacroExpansion.ll"
    report_artifact stage2_macro_expansion_executable "$stage2_directory/MacroExpansion"
    report_artifact stage3_macro_expansion_executable "$stage3_directory/MacroExpansion"
    echo "stage2_stage3_llvm=byte-identical"
    echo "stage2_stage3_executable=byte-identical"
    echo "typed_only_lowering=pass"
    echo "candidate_fixed_point=pass"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
