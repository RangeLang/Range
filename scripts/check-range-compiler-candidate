construct BufferViewWrapper {
    let view: NestedBufferView
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let view: NestedBufferView(storage: $source)
    let wrapper: BufferViewWrapper(view: view)
    return 0
