RANGE
            ;;
        multi-mixed-return)
            /bin/cat >> "$output" <<'RANGE'
construct ArenaEmitterAliasOwners {
    let first: RawBuffer
    let second: RawBuffer
}

construct ArenaEmitterResult {
    let firstOwned: RawBuffer
    let secondOwned: RawBuffer
    binding firstAlias: RawBuffer
    binding secondAlias: RawBuffer
}

function makeArenaEmitterResult(owners: ArenaEmitterAliasOwners): ArenaEmitterResult {
    let firstOwned: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: firstOwned, value: 1)
    let secondOwned: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: secondOwned, value: 2)
    let result: ArenaEmitterResult(firstOwned: firstOwned, secondOwned: secondOwned, firstAlias: $owners.first, secondAlias: $owners.second)
    return result
}

@main {
    let firstAlias: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: firstAlias, value: 1)
    let secondAlias: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: secondAlias, value: 3)
    let owners: ArenaEmitterAliasOwners(first: firstAlias, second: secondAlias)
    let result: ArenaEmitterResult(makeArenaEmitterResult(owners: owners))
    let firstOwnedValue: Int(rawBufferLoadInt(buffer: result.firstOwned, index: 0))
    let secondOwnedValue: Int(rawBufferLoadInt(buffer: result.secondOwned, index: 0))
    let firstAliasValue: Int(rawBufferLoadInt(buffer: result.firstAlias, index: 0))
    let secondAliasValue: Int(rawBufferLoadInt(buffer: result.secondAlias, index: 0))
    rawBufferDestroy(buffer: result.firstOwned)
    rawBufferDestroy(buffer: result.secondOwned)
    rawBufferDestroy(buffer: owners.first)
    rawBufferDestroy(buffer: owners.second)
    return firstOwnedValue + secondOwnedValue + firstAliasValue + secondAliasValue
