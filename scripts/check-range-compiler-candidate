@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    destroyThroughHelper(buffer: $source)
    return 0
}
RANGE
            ;;
        nested-wrapper)
            /bin/cat >> "$output" <<'RANGE'
construct NestedBufferView {
    binding storage: RawBuffer
}

construct BufferViewWrapper {
    let view: NestedBufferView
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    let view: NestedBufferView(NestedBufferView(storage: $source))
    let wrapper: BufferViewWrapper(BufferViewWrapper(view: view))
    return 0
}
RANGE
            ;;
        binding-return)
            /bin/cat >> "$output" <<'RANGE'
construct ReturnedBufferView {
    binding storage: RawBuffer
