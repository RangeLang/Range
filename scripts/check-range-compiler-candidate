            ;;
        absent-early-return)
            /bin/cat >> "$output" <<'RANGE'
function absentEarlyReturn(flag: Bool): Int {
    if flag {
        return 7
    }
    let later: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferDestroy(buffer: later)
    return 7
}

@main {
    return absentEarlyReturn(flag: true)
