function chooseSameBufferView(buffer: RawBuffer, flag: Bool): SameBranchBufferView {
    let first: SameBranchBufferView(storage: $buffer)
    let second: SameBranchBufferView(storage: $buffer)
    if flag {
        return first
    } else {
        return second
    }
}

@main {
    let source: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
