@main {
    let first: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: first, value: 3)
    let second: RawBuffer(rawBufferCreate(capacity: 1, stride: 4))
    rawBufferAppendInt(buffer: second, value: 4)
    let owners: BoundaryBufferOwners(BoundaryBufferOwners(first: first, second: second))
    let view: BoundaryBufferView(returnBoundaryBufferView(owners: owners))
    let firstValue: Int(rawBufferLoadInt(buffer: view.first, index: 0))
    let secondValue: Int(rawBufferLoadInt(buffer: view.second, index: 0))
    rawBufferDestroy(buffer: owners.first)
    rawBufferDestroy(buffer: owners.second)
    return firstValue + secondValue
