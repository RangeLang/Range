construct NestedAddress {
    let city: String
}

extension NestedAddress {
    init(decoder: Decoder) -> Result<Self, DecodingError> {
        let container: decoder.keyedContainer()

        switch container.decode(String.self, key: "city") {
        case .success(let city):
            state self.city: city
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

construct NestedDecodedUser {
    let id: Int
    let address: NestedAddress
}

extension NestedDecodedUser {
    init(decoder: Decoder) -> Result<Self, DecodingError> {
        let container: decoder.keyedContainer()

        switch container.decode(Int.self, key: "id") {
        case .success(let id):
            state self.id: id
        case .failure(let error):
            return .failure(cause: error)
        }

        switch container.decode(NestedAddress.self, key: "address") {
        case .success(let address):
            state self.address: address
        case .failure(let error):
            return .failure(cause: error)
        }

        return .success(result: self)
    }
}

function decodeNestedUser(): Result<NestedDecodedUser, DecodingError> {
    let addressFields: [
        JSONField(key: "city", value: .string(value: "Tbilisi")),
    ]
    let fields: [
        JSONField(key: "id", value: .int(value: 42)),
        JSONField(key: "address", value: .object(fields: addressFields)),
    ]
    let decoder: JSONDecoder(value: .object(fields: fields))
    return NestedDecodedUser.decode(value: decoder)
}

@main {
    switch decodeNestedUser() {
    case .success(let user):
        Logger.info(user.address.city)
    case .failure:
        Logger.error("decoding failed")
    }
}
