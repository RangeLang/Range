construct User {
    let id: Int
    let name: String
}

extension User {
    function encode(encoder: Encoder): Result<Void, EncodingError> {
        state container: encoder.keyedContainer()
        container.encode(id, key: "id")
        return container.encode(name, key: "name")
    }
}

function encodeUser(): Result<String, EncodingError> {
    state encoder: JSONEncoder()
    let user: User(id: 1, name: "George")
    return encoder.encode(user)
}

@main {
    switch encodeUser() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }
}
