function decodeStringValue(): Result<String, DecodingError> {
    let decoder: JSONDecoder(value: .string(value: "George"))
    return String.decode(value: decoder)
}

function decodeBoolValue(): Result<Bool, DecodingError> {
    let decoder: JSONDecoder(value: .bool(value: true))
    return Bool.decode(value: decoder)
}

@main {
}
