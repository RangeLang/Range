construct Address {
    let city: String
    let zip: Int
}

extension Address {
    function encode(encoder: Encoder): Result<Void, EncodingError> {
        state container: encoder.keyedContainer()

        switch container.encode(city, key: "city") {
        case .success:
            return container.encode(zip, key: "zip")
        case .failure(let error):
            return .failure(cause: error)
        }

        return .failure(cause: .failed)
    }
}

construct User {
    let name: String
    let address: Address
    let scores: [Int]
}

extension User {
    function encode(encoder: Encoder): Result<Void, EncodingError> {
        state container: encoder.keyedContainer()

        switch container.encode(name, key: "name") {
        case .success:
            switch container.encode(address, key: "address") {
            case .success:
                return container.encode(scores, key: "scores")
            case .failure(let error):
                return .failure(cause: error)
            }
        case .failure(let error):
            return .failure(cause: error)
        }

        return .failure(cause: .failed)
    }
}

function encodeNested(): Result<String, EncodingError> {
    let encoder: JSONEncoder()
    let address: Address(city: "Tbilisi", zip: 1000)
    let user: User(name: "George", address: address, scores: [1, 2, 3])
    return encoder.encode(user)
}

@main {
    switch encodeNested() {
    case .success(let json):
        Logger.info(json)
    case .failure:
        Logger.error("encoding failed")
    }
}
