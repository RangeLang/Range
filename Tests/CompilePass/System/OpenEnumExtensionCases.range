open enum EncodingFormat {
    case json
}

extension EncodingFormat {
    case binary
    case urlForm
}

function defaultEncodingFormat(): EncodingFormat {
    return .binary
}

function describeEncodingFormat(format: EncodingFormat): String {
    switch format {
    case .json:
        return "json"
    case .binary:
        return "binary"
    case .urlForm:
        return "url-form"
    }
}

