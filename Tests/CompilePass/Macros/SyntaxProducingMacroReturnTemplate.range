macro returnTrueStatement() -> Statement {
    return true
}

macro emitReturnTemplate(): Construct { target, diagnostics in
    target.declaration.expand {
        extension #(target.declaration.self) {
            function generated(): Bool {
                @returnTrueStatement()
            }
        }
    }
}

@emitReturnTemplate
construct SyntaxProducingMacroReturnTemplateFixture {
}
