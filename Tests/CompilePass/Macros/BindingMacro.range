macro offset(amount: Int): Binding<Int> { target, diagnostics in
    target.getter { value in
        value + amount
    }

    target.setter { value in
        value + amount
    }
}

construct Box {
    state age: Int(10)

    @offset(amount: 1)
    binding score: Int {
        get {
            return age
        }

        set {
            state age: newValue
        }
    }

    function current(): Int {
        return score
    }

    function update(value: Int) {
        state score: value
        state score: score + value
    }
}
