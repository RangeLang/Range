function maybeNumber(value: Int): Optional<Int> {
    return value
}

function duplicate(value: Int): Array<Int> {
    return [value, value]
}

@main {
    let values: [1, 2, 3]
    let doubled: values.map { value in value * 2 }
    let compacted: values.compactMap(maybeNumber)
    let duplicated: values.flatMap(duplicate)

    Logger.log(doubled.count)
    Logger.log(compacted.count)
    Logger.log(duplicated.count)
    values.forEach { value in Logger.log(value) }
}
