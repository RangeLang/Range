construct Route {
    let _ path: String
    binding _ page: @page?
    binding _ children: () -> [Route]
}

enum Axis {
    case horizontal
    case vertical
}

@entry
@component
construct Stack {
    state axis: Axis
    state spacing: Float
    state alignment: LayoutAlignment
    derived view: @view {
        // The component body is the view field.
    }
}


construct Fragment {
    let html: String
    let css: String
    let children: () -> @view

    derived body: @view {
        children()
    }
}

function rangeViewEmit(
    path: String,
    html: String,
    css: String,
    javaScript: String
): Int {
    let htmlStatus: Int(writeFile(path: "\(path).html", text: html))
    if htmlStatus != 0 {
        return htmlStatus
    }

    let cssStatus: Int(writeFile(path: "\(path).css", text: css))
    if cssStatus != 0 {
        return cssStatus
    }

    return writeFile(path: "\(path).js", text: javaScript)
}
