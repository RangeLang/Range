macro app(): Construct -> Void {
    let namedRoutes: [Derived](
        #environment.target.Declaration.members.filter(all: Derived) { property in
            property.identifier.name == "routes"
        }
    )
    let routeTrees: [Derived<Route>](
        #environment.target.Declaration.members.filter(all: Derived<Route>) { property in
            property.identifier.name == "routes"
        }
    )

    if namedRoutes.count == 0 {
        #environment.error("@app requires one derived routes declaration.")
    }
    if namedRoutes.count > 1 {
        #environment.error("@app routes declaration must not be duplicated.")
    }
    if namedRoutes.count == 1 && routeTrees.count != 1 {
        #environment.error("@app routes must have type Route.")
    }

    #environment {
        @main {
            return rangeViewRunApplication()
        }
    }
}


macro component(): Construct -> Void {
    @requireView(owner: "component")

    #environment {
        extension #environment.target.Declaration.identity {
            @view

            @many
            let modifiers: @modifier
        }
    }
}

macro page(): Construct -> Void {
    @requireBody(owner: "page")
}


macro requireView(owner: String): Construct {
    let namedViews: [Derived](
        #environment.target.Declaration.members.filter(all: Derived) { property in
            property.identifier.name == "view"
        }
    )
    let drawableViews: [Derived<[@view]>](
        #environment.target.Declaration.members.filter(all: Derived<[@view]>) { property in
            property.identifier.name == "view"
        }
    )

    if namedViews.count != 1 {
        #environment.error("@\(owner) requires exactly one derived view.")
    }
    if namedViews.count == 1 && drawableViews.count != 1 {
        #environment.error("@\(owner) view must have type @view.")
    }
}


macro requireBody(owner: String): Construct {
    let namedBodies: [Derived](
        #environment.target.Declaration.members.filter(all: Derived) { property in
            property.identifier.name == "body"
        }
    )
    let drawableBodies: [Derived<[@view]>](
        #environment.target.Declaration.members.filter(all: Derived<[@view]>) { property in
            property.identifier.name == "body"
        }
    )

    if namedBodies.count != 1 {
        #environment.error("@\(owner) requires exactly one derived body.")
    }
    if namedBodies.count == 1 && drawableBodies.count != 1 {
        #environment.error("@\(owner) body must have type @view.")
    }
}
