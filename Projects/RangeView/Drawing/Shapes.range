construct Line {
    let start: Point
    let end: Point
}

construct Rectangle {
    let origin: Point
    let size: Size
}

construct Circle {
    let center: Point
    let radius: Int
}

construct Polygon {
    let first: Point
    let second: Point
    let third: Point
    let fourth: Point
    let fifth: Point
}

enum Shape {
    case line(value: Line)
    case rectangle(value: Rectangle)
    case circle(value: Circle)
    case polygon(value: Polygon)
}
