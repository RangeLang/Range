enum StyleTransform {
    case fill(color: @color)
    case line(color: @color, width: Int)
}

@modifier(.style)
function fill(_ color: @color): StyleTransform {
    return StyleTransform(.fill(color: color))
}

@modifier(.style)
function line(_ color: @color, width: Int): StyleTransform {
    return StyleTransform(.line(color: color, width: width))
}
