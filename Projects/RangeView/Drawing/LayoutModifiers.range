@modifier(.layout)
function alignment(_ vertical: VerticalAlignment, _ horizontal: HorizontalAlignment): LayoutTransform {
    return LayoutTransform(.alignment(value: LayoutAlignment(vertical: vertical, horizontal: horizontal)))
}

@modifier(.layout)
function position(x: Int, y: Int): LayoutTransform {
    return LayoutTransform(.position(value: Point(x: x, y: y)))
}

@modifier(.layout)
function offset(x: Int, y: Int): LayoutTransform {
    return LayoutTransform(.offset(value: Point(x: x, y: y)))
}
