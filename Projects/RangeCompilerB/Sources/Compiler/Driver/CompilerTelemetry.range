function compilerProbeBegin(kind: Int, functionID: Int, instanceID: Int, blockID: Int, nodeID: Int, ordinal: Int, itemCount: Int): CompilerProbe {
    return CompilerProbe(id: compilerTelemetryProbeBegin(kind: kind, functionID: functionID, instanceID: instanceID, blockID: blockID, nodeID: nodeID, ordinal: ordinal, itemCount: itemCount))
}

function compilerProbeEnd(probe: CompilerProbe, status: Int, resultCount: Int): Int {
    return compilerTelemetryProbeEnd(probeID: probe.id, status: status, resultCount: resultCount)
}
