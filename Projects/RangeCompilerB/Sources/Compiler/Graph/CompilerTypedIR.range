function compilerTypedIRFunctionColumnCount(): Int { return 7 }
function compilerTypedIROperationColumnCount(): Int { return 8 }
function compilerTypedIROperationConstruct(): Int { return 1 }
function compilerTypedIROperationMemberRead(): Int { return 2 }
function compilerTypedIROperationAddition(): Int { return 3 }
function compilerTypedIROperationCall(): Int { return 4 }
function compilerTypedIROperationReturn(): Int { return 5 }
function compilerTypedIROperationDestroy(): Int { return 6 }
function compilerTypedIROperationLocal(): Int { return 7 }
function compilerTypedIROperationInteger(): Int { return 8 }
function compilerTypedIROperationInsertField(): Int { return 9 }
function compilerTypedIROperationNoEscape(): Int { return 10 }
function compilerTypedIROperationConstructValue(): Int { return 11 }
function compilerTypedIROperationTransfer(): Int { return 12 }
function compilerTypedIROperationCallReceive(): Int { return 13 }
function compilerTypedIROperationStoragePolicy(): Int { return 14 }
function compilerTypedIROperationStore(): Int { return 15 }
function compilerTypedIROperationFloatLiteral(): Int { return 16 }
function compilerTypedIROperationFloatDivide(): Int { return 17 }

function compilerTypedIRCreate(): CompilerTypedIR {
    return CompilerTypedIR(
        functions: compilerIntTableCreate(columnCount: compilerTypedIRFunctionColumnCount(), estimatedRowCount: 16),
        operations: compilerIntTableCreate(columnCount: compilerTypedIROperationColumnCount(), estimatedRowCount: 64),
        failures: bufferCreateInt(capacity: 1)
    )
}

function compilerTypedIRDestroy(ir: CompilerTypedIR): Int {
    state typedIRDestroyStatus: Int(0)
    if compilerIntTableDestroy(table: ir.functions) != 0 { typedIRDestroyStatus: 0 - 1 }
    if compilerIntTableDestroy(table: ir.operations) != 0 { typedIRDestroyStatus: 0 - 1 }
    if ir.failures.destroy() != 0 { typedIRDestroyStatus: 0 - 1 }
    return typedIRDestroyStatus
}

function compilerTypedIRPoison(ir: CompilerTypedIR): Int {
    return ir.failures.append(element: 1)
}

function compilerTypedIRAppend(ir: CompilerTypedIR, table: CompilerIntTable, value: Int): Int {
    let typedIRAppendStatus: Int(compilerIntTableAppend(table: table, value: value))
    if typedIRAppendStatus != 0 { compilerTypedIRPoison(ir: ir) }
    return typedIRAppendStatus
}

function compilerTypedIRAppendFunction(ir: CompilerTypedIR, ownerNodeID: Int, identityFirst: Int, identitySecond: Int, parameterNodeID: Int, typeNodeID: Int, memoryDecisionRow: Int, isEntry: Int): Int {
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: ownerNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: identityFirst) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: identitySecond) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: parameterNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.functions, value: memoryDecisionRow) != 0 { return 0 - 1 }
    return compilerTypedIRAppend(ir: ir, table: ir.functions, value: isEntry)
}

function compilerTypedIRAppendOperation(ir: CompilerTypedIR, nodeID: Int, regionNodeID: Int, operationKind: Int, typeNodeID: Int, storageID: Int, first: Int, second: Int, memoryDecisionRow: Int): Int {
    if nodeID < 0 || regionNodeID < 0 || operationKind < compilerTypedIROperationConstruct() || operationKind > compilerTypedIROperationStore() {
        compilerTypedIRPoison(ir: ir)
        return 0 - 1
    }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: nodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: regionNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: operationKind) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: typeNodeID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: storageID) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: first) != 0 { return 0 - 1 }
    if compilerTypedIRAppend(ir: ir, table: ir.operations, value: second) != 0 { return 0 - 1 }
    return compilerTypedIRAppend(ir: ir, table: ir.operations, value: memoryDecisionRow)
}

function compilerTypedIRMemoryDecisionRow(memory: CompilerMemoryGraph, decisionKind: Int, nodeID: Int, storageID: Int): Int {
    state typedIRDecisionRow: Int(0)
    let typedIRDecisionCount: Int(compilerIntTableRowCount(table: memory.decisions))
    while typedIRDecisionRow < typedIRDecisionCount {
        if compilerIntTableValue(table: memory.decisions, row: typedIRDecisionRow, column: 0) == decisionKind
            && compilerIntTableValue(table: memory.decisions, row: typedIRDecisionRow, column: 1) == nodeID
            && compilerIntTableValue(table: memory.decisions, row: typedIRDecisionRow, column: 2) == storageID { return typedIRDecisionRow }
        typedIRDecisionRow: typedIRDecisionRow + 1
    }
    return 0 - 1
}

function compilerTypedIRNodeRegion(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, nodeID: Int): Int {
    let typedIRNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: nodeID, column: 1))
    if typedIRNodeKind == compilerSyntaxKindFunction() || typedIRNodeKind == compilerSyntaxKindEntry() { return nodeID }
    if typedIRNodeKind < compilerSyntaxKindEntry() { return 0 - 1 }
    let typedIRNodeFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    return compilerIntTableValue(table: tables.bodyNodes, row: typedIRNodeFacetRow, column: 2)
}

function compilerTypedIRIntegerValue(tables: CompilerSyntaxTables, nodeID: Int): Int {
    let typedIRIntegerFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    let typedIRIntegerText: String(compilerTypedSyntaxLocalText(tables: tables, fileID: compilerIntTableValue(table: tables.bodyNodes, row: typedIRIntegerFacetRow, column: 1), localStart: compilerIntTableValue(table: tables.bodyNodes, row: typedIRIntegerFacetRow, column: 6), localEnd: compilerIntTableValue(table: tables.bodyNodes, row: typedIRIntegerFacetRow, column: 7)))
    return compilerCoreParseDecimalInt(value: typedIRIntegerText)
}

function compilerTypedIRFloatText(tables: CompilerSyntaxTables, nodeID: Int): String {
    let facetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: nodeID, column: 1))
    return compilerTypedSyntaxLocalText(tables: tables, fileID: compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 1), localStart: compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 6), localEnd: compilerIntTableValue(table: tables.bodyNodes, row: facetRow, column: 7))
}

function compilerTypedIRArgumentIntegerForMember(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, applicationNodeID: Int, memberOrdinal: Int): Int {
    state typedIRArgumentOrdinal: Int(0)
    while true {
        let typedIRArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: applicationNodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: typedIRArgumentOrdinal))
        if typedIRArgumentNodeID < 0 { return 0 - 1 }
        let typedIRArgumentMemberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: typedIRArgumentNodeID))
        let typedIRArgumentMemberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: typedIRArgumentMemberNodeID, column: 1))
        if compilerIntTableValue(table: tables.members, row: typedIRArgumentMemberFacetRow, column: 3) == memberOrdinal {
            let typedIRArgumentValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if compilerIntTableValue(table: delta.nodes, row: typedIRArgumentValueNodeID, column: 1) != compilerSyntaxKindIntegerLiteral() { return 0 - 1 }
            return compilerTypedIRIntegerValue(tables: tables, nodeID: typedIRArgumentValueNodeID)
        }
        typedIRArgumentOrdinal: typedIRArgumentOrdinal + 1
    }
    return 0 - 1
}

function compilerTypedIRAppendConstructFields(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR, applicationNodeID: Int, regionNodeID: Int, typeNodeID: Int, storageID: Int, layoutDecisionRow: Int): Int {
    let typedIRConstructLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typeNodeID))
    if typedIRConstructLayoutRow < 0 { return 0 - 1 }
    let typedIRConstructFieldCount: Int(compilerIntTableValue(table: memory.layouts, row: typedIRConstructLayoutRow, column: 1))
    state typedIRConstructFieldOrdinal: Int(0)
    while typedIRConstructFieldOrdinal < typedIRConstructFieldCount {
        let typedIRConstructFieldValue: Int(compilerTypedIRArgumentIntegerForMember(tables: tables, delta: delta, semantics: semantics, applicationNodeID: applicationNodeID, memberOrdinal: typedIRConstructFieldOrdinal))
        if typedIRConstructFieldValue < 0
            || compilerTypedIRAppendOperation(ir: ir, nodeID: applicationNodeID, regionNodeID: regionNodeID, operationKind: compilerTypedIROperationInsertField(), typeNodeID: typeNodeID, storageID: storageID, first: typedIRConstructFieldOrdinal, second: typedIRConstructFieldValue, memoryDecisionRow: layoutDecisionRow) != 0 { return 0 - 1 }
        typedIRConstructFieldOrdinal: typedIRConstructFieldOrdinal + 1
    }
    return typedIRConstructFieldCount
}

function compilerTypedIRBuildFunctions(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR): Int {
    state typedIRFunctionEffectRow: Int(0)
    let typedIRFunctionEffectCount: Int(compilerIntTableRowCount(table: semantics.parameterEffects))
    while typedIRFunctionEffectRow < typedIRFunctionEffectCount {
        let typedIRFunctionNodeID: Int(compilerIntTableValue(table: semantics.parameterEffects, row: typedIRFunctionEffectRow, column: 0))
        let typedIRParameterNodeID: Int(compilerIntTableValue(table: semantics.parameterEffects, row: typedIRFunctionEffectRow, column: 1))
        if compilerIntTableValue(table: semantics.nodeTypes, row: typedIRParameterNodeID, column: 1) == compilerSemanticTypeConstruct()
            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: typedIRFunctionNodeID) == compilerRuntimeABIFunctionNone() {
            let typedIRParameterTypeNodeID: Int(compilerIntTableValue(table: semantics.nodeTypes, row: typedIRParameterNodeID, column: 2))
            let typedIRPassDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionPassMode(), nodeID: typedIRParameterNodeID, storageID: 0 - 1))
            let typedIRFunctionFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: typedIRFunctionNodeID, column: 1))
            let typedIRFunctionDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: typedIRFunctionNodeID))
            if typedIRPassDecisionRow < 0 || typedIRFunctionFacetRow < 0 || typedIRFunctionDeclarationRow < 0
                || compilerTypedIRAppendFunction(ir: ir, ownerNodeID: typedIRFunctionNodeID, identityFirst: compilerIntTableValue(table: tables.declarations, row: typedIRFunctionDeclarationRow, column: 11), identitySecond: compilerIntTableValue(table: tables.declarations, row: typedIRFunctionDeclarationRow, column: 12), parameterNodeID: typedIRParameterNodeID, typeNodeID: typedIRParameterTypeNodeID, memoryDecisionRow: typedIRPassDecisionRow, isEntry: 0) != 0 { return 0 - 1 }
        }
        typedIRFunctionEffectRow: typedIRFunctionEffectRow + 1
    }
    state typedIRReturnedFunctionNodeID: Int(0)
    let typedIRReturnedFunctionNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while typedIRReturnedFunctionNodeID < typedIRReturnedFunctionNodeCount {
        if compilerIntTableValue(table: delta.nodes, row: typedIRReturnedFunctionNodeID, column: 1) == compilerSyntaxKindFunction()
            && compilerIntTableValue(table: semantics.nodeTypes, row: typedIRReturnedFunctionNodeID, column: 1) == compilerSemanticTypeConstruct()
            && compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: typedIRReturnedFunctionNodeID) == compilerRuntimeABIFunctionNone() {
            let typedIRReturnedTypeNodeID: Int(compilerIntTableValue(table: semantics.nodeTypes, row: typedIRReturnedFunctionNodeID, column: 2))
            let typedIRReturnModeDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionReturnMode(), nodeID: typedIRReturnedFunctionNodeID, storageID: 0 - 1))
            let typedIRReturnedDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: typedIRReturnedFunctionNodeID))
            if typedIRReturnModeDecisionRow < 0 || typedIRReturnedDeclarationRow < 0
                || compilerTypedIRAppendFunction(ir: ir, ownerNodeID: typedIRReturnedFunctionNodeID, identityFirst: compilerIntTableValue(table: tables.declarations, row: typedIRReturnedDeclarationRow, column: 11), identitySecond: compilerIntTableValue(table: tables.declarations, row: typedIRReturnedDeclarationRow, column: 12), parameterNodeID: 0 - 1, typeNodeID: typedIRReturnedTypeNodeID, memoryDecisionRow: typedIRReturnModeDecisionRow, isEntry: 0) != 0 { return 0 - 1 }
        }
        typedIRReturnedFunctionNodeID: typedIRReturnedFunctionNodeID + 1
    }
    let typedIREntryStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    if typedIREntryStorageCount > 0 {
        let typedIREntryNodeID: Int(compilerIntTableValue(table: memory.storages, row: 0, column: 3))
        let typedIREntryTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: 0, column: 2))
        if compilerTypedIRAppendFunction(ir: ir, ownerNodeID: typedIREntryNodeID, identityFirst: 0, identitySecond: 0, parameterNodeID: 0 - 1, typeNodeID: typedIREntryTypeNodeID, memoryDecisionRow: 0 - 1, isEntry: 1) != 0 { return 0 - 1 }
    }
    return 0
}

function compilerTypedIRBuildNode(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR, nodeID: Int): Int {
    let typedIRNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: nodeID, column: 1))
    let typedIRRegionNodeID: Int(compilerTypedIRNodeRegion(tables: tables, delta: delta, nodeID: nodeID))
    if typedIRRegionNodeID < 0 { return 0 }
    if typedIRNodeKind == compilerSyntaxKindIntegerLiteral() {
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationInteger(), typeNodeID: 0 - 1, storageID: 0 - 1, first: compilerTypedIRIntegerValue(tables: tables, nodeID: nodeID), second: 0, memoryDecisionRow: 0 - 1)
    }
    if typedIRNodeKind == compilerSyntaxKindDoubleLiteral() {
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationFloatLiteral(), typeNodeID: compilerSemanticTypeFloat(), storageID: 0 - 1, first: nodeID, second: 0, memoryDecisionRow: 0 - 1)
    }
    if typedIRNodeKind == compilerSyntaxKindMemberRead() {
        if compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleAssignmentTarget()) >= 0 { return 0 }
        let typedIRMemberNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID))
        let typedIRMemberFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: typedIRMemberNodeID, column: 1))
        let typedIRMemberReceiverNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleReceiver(), ordinal: 0))
        state typedIRMemberStorageID: Int(0 - 1)
        state typedIRMemberDecisionRow: Int(0 - 1)
        if compilerSemanticResolutionKind(semantics: semantics, useNodeID: typedIRMemberReceiverNodeID) == compilerSemanticResolutionLocal() {
            let typedIRMemberLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: typedIRMemberReceiverNodeID))
            typedIRMemberStorageID: compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRMemberLocalNodeID)
            typedIRMemberDecisionRow: compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionAccess(), nodeID: nodeID, storageID: typedIRMemberStorageID)
            if typedIRMemberStorageID < 0 || typedIRMemberDecisionRow < 0 { return 0 - 1 }
        }
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationMemberRead(), typeNodeID: compilerIntTableValue(table: tables.members, row: typedIRMemberFacetRow, column: 2), storageID: typedIRMemberStorageID, first: typedIRMemberReceiverNodeID, second: compilerIntTableValue(table: tables.members, row: typedIRMemberFacetRow, column: 3), memoryDecisionRow: typedIRMemberDecisionRow)
    }
    if typedIRNodeKind == compilerSyntaxKindAddition() {
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationAddition(), typeNodeID: 0 - 1, storageID: 0 - 1, first: compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleLeftOperand(), ordinal: 0), second: compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleRightOperand(), ordinal: 0), memoryDecisionRow: 0 - 1)
    }
    if typedIRNodeKind == compilerSyntaxKindDivision() {
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationFloatDivide(), typeNodeID: compilerSemanticTypeFloat(), storageID: 0 - 1, first: compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleLeftOperand(), ordinal: 0), second: compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleRightOperand(), ordinal: 0), memoryDecisionRow: 0 - 1)
    }
    if typedIRNodeKind == compilerSyntaxKindLocalBinding() {
        let typedIRLocalStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: nodeID))
        let typedIRPlacementDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionPlacement(), nodeID: nodeID, storageID: typedIRLocalStorageID))
        let typedIRPolicyDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionStoragePolicy(), nodeID: nodeID, storageID: typedIRLocalStorageID))
        let typedIREscapeDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionEscape(), nodeID: nodeID, storageID: typedIRLocalStorageID))
        if typedIRLocalStorageID < 0 || typedIRPlacementDecisionRow < 0 || typedIRPolicyDecisionRow < 0 || typedIREscapeDecisionRow < 0 { return 0 - 1 }
        if compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationLocal(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRLocalStorageID, column: 2), storageID: typedIRLocalStorageID, first: compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleInitializer(), ordinal: 0), second: 0, memoryDecisionRow: typedIRPlacementDecisionRow) != 0 { return 0 - 1 }
        if compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationStoragePolicy(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRLocalStorageID, column: 2), storageID: typedIRLocalStorageID, first: compilerIntTableValue(table: memory.decisions, row: typedIRPolicyDecisionRow, column: 4), second: 0, memoryDecisionRow: typedIRPolicyDecisionRow) != 0 { return 0 - 1 }
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationNoEscape(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRLocalStorageID, column: 2), storageID: typedIRLocalStorageID, first: nodeID, second: 0, memoryDecisionRow: typedIREscapeDecisionRow)
    }
    if typedIRNodeKind == compilerSyntaxKindApplication() {
        let typedIRApplicationSemanticType: CompilerSemanticType(compilerSemanticTypeForNode(tables: tables, delta: delta, semantics: semantics, nodeID: nodeID))
        if compilerSemanticTypeKind(type: typedIRApplicationSemanticType) == compilerSemanticTypeFloat() {
            let typedIRFloatArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: 0))
            let typedIRFloatValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRFloatArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            if typedIRFloatValueNodeID < 0 { return 0 - 1 }
            return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationFloatLiteral(), typeNodeID: compilerSemanticTypeFloat(), storageID: 0 - 1, first: typedIRFloatValueNodeID, second: 0, memoryDecisionRow: 0 - 1)
        }
        let typedIRCalleeNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleCallee(), ordinal: 0))
        if typedIRCalleeNodeID >= 0 {
            let typedIRCalleeFacetRow: Int(compilerIntTableValue(table: tables.syntaxIndex, row: typedIRCalleeNodeID, column: 1))
            let typedIRCalleeFileID: Int(compilerIntTableValue(table: tables.bodyNodes, row: typedIRCalleeFacetRow, column: 1))
            let typedIRCalleeName: String(compilerTypedSyntaxLocalText(tables: tables, fileID: typedIRCalleeFileID, localStart: compilerIntTableValue(table: tables.bodyNodes, row: typedIRCalleeFacetRow, column: 6), localEnd: compilerIntTableValue(table: tables.bodyNodes, row: typedIRCalleeFacetRow, column: 7)))
            if typedIRCalleeName == String("Float") {
                let typedIRFloatArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: 0))
                let typedIRFloatValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRFloatArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
                if typedIRFloatValueNodeID < 0 { return 0 - 1 }
                return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationFloatLiteral(), typeNodeID: compilerSemanticTypeFloat(), storageID: 0 - 1, first: typedIRFloatValueNodeID, second: 0, memoryDecisionRow: 0 - 1)
            }
        }
        let typedIRApplicationKind: Int(compilerSemanticResolutionKind(semantics: semantics, useNodeID: nodeID))
        if typedIRApplicationKind == compilerSemanticResolutionConstruct() {
            let typedIRApplicationLocalNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleInitializer()))
            let typedIRApplicationStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRApplicationLocalNodeID))
            let typedIRApplicationTypeNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID))
            let typedIRLayoutDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionLayout(), nodeID: typedIRApplicationTypeNodeID, storageID: 0 - 1))
            if typedIRLayoutDecisionRow < 0 { return 0 - 1 }
            if typedIRApplicationStorageID < 0 {
                let typedIRAssignmentNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleAssignedValue()))
                if typedIRAssignmentNodeID >= 0 {
                    let typedIRAssignmentTargetNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRAssignmentNodeID, roleTag: compilerSyntaxRoleAssignmentTarget(), ordinal: 0))
                    let typedIRAssignmentEffectRow: Int(compilerSemanticAccessEffectRowForAssignment(semantics: semantics, assignmentNodeID: typedIRAssignmentNodeID))
                    state typedIRAssignmentLocalNodeID: Int(0 - 1)
                    if typedIRAssignmentEffectRow >= 0 { typedIRAssignmentLocalNodeID: compilerIntTableValue(table: semantics.accessEffects, row: typedIRAssignmentEffectRow, column: 2) }
                    let typedIRAssignmentStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRAssignmentLocalNodeID))
                    let typedIRAssignmentDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionAccess(), nodeID: typedIRAssignmentNodeID, storageID: typedIRAssignmentStorageID))
                    if typedIRAssignmentTargetNodeID < 0 || typedIRAssignmentLocalNodeID < 0 || typedIRAssignmentStorageID < 0 || typedIRAssignmentDecisionRow < 0
                        || compilerIntTableValue(table: memory.decisions, row: typedIRAssignmentDecisionRow, column: 4) != compilerMemoryAccessWriteUnique() { return 0 - 1 }
                    let typedIRAssignedFieldCount: Int(compilerTypedIRAppendConstructFields(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir, applicationNodeID: nodeID, regionNodeID: typedIRRegionNodeID, typeNodeID: typedIRApplicationTypeNodeID, storageID: typedIRAssignmentStorageID, layoutDecisionRow: typedIRLayoutDecisionRow))
                    if typedIRAssignedFieldCount <= 0 { return 0 - 1 }
                    return compilerTypedIRAppendOperation(ir: ir, nodeID: typedIRAssignmentNodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationStore(), typeNodeID: typedIRApplicationTypeNodeID, storageID: typedIRAssignmentStorageID, first: nodeID, second: typedIRAssignmentTargetNodeID, memoryDecisionRow: typedIRAssignmentDecisionRow)
                }
                let typedIRTransferReturnNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleReturnValue()))
                if typedIRTransferReturnNodeID < 0 { return 0 - 1 }
                let typedIRReturnedFieldCount: Int(compilerTypedIRAppendConstructFields(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir, applicationNodeID: nodeID, regionNodeID: typedIRRegionNodeID, typeNodeID: typedIRApplicationTypeNodeID, storageID: 0 - 1, layoutDecisionRow: typedIRLayoutDecisionRow))
                if typedIRReturnedFieldCount <= 0 { return 0 - 1 }
                return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationConstructValue(), typeNodeID: typedIRApplicationTypeNodeID, storageID: 0 - 1, first: typedIRReturnedFieldCount, second: 0, memoryDecisionRow: typedIRLayoutDecisionRow)
            }
            let typedIRInitializeDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionInitialize(), nodeID: nodeID, storageID: typedIRApplicationStorageID))
            if typedIRInitializeDecisionRow < 0 { return 0 - 1 }
            let typedIRLocalFieldCount: Int(compilerTypedIRAppendConstructFields(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir, applicationNodeID: nodeID, regionNodeID: typedIRRegionNodeID, typeNodeID: typedIRApplicationTypeNodeID, storageID: typedIRApplicationStorageID, layoutDecisionRow: typedIRLayoutDecisionRow))
            if typedIRLocalFieldCount <= 0 { return 0 - 1 }
            return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationConstruct(), typeNodeID: typedIRApplicationTypeNodeID, storageID: typedIRApplicationStorageID, first: typedIRLocalFieldCount, second: 0, memoryDecisionRow: typedIRInitializeDecisionRow)
        }
        if typedIRApplicationKind == compilerSemanticResolutionFunction() {
            let typedIRRuntimeFunctionNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID))
            let typedIRRuntimeFunctionRole: Int(compilerRuntimeABIFunctionRole(tables: tables, functionNodeID: typedIRRuntimeFunctionNodeID))
            if typedIRRuntimeFunctionRole == compilerRuntimeABIFunctionCreate() {
                let typedIRRuntimeCreateLocalNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleInitializer()))
                let typedIRRuntimeCreateStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRRuntimeCreateLocalNodeID))
                let typedIRRuntimeCreateInitializeRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionInitialize(), nodeID: nodeID, storageID: typedIRRuntimeCreateStorageID))
                if typedIRRuntimeCreateLocalNodeID < 0 || typedIRRuntimeCreateStorageID < 0 || typedIRRuntimeCreateInitializeRow < 0 { return 0 - 1 }
                return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationCallReceive(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRRuntimeCreateStorageID, column: 2), storageID: typedIRRuntimeCreateStorageID, first: typedIRRuntimeFunctionNodeID, second: typedIRRuntimeCreateLocalNodeID, memoryDecisionRow: typedIRRuntimeCreateInitializeRow)
            }
            if typedIRRuntimeFunctionRole == compilerRuntimeABIFunctionDestroy() {
                let typedIRRuntimeDestroyArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: 0))
                let typedIRRuntimeDestroyValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRRuntimeDestroyArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
                let typedIRRuntimeDestroyLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: typedIRRuntimeDestroyValueNodeID))
                let typedIRRuntimeDestroyStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRRuntimeDestroyLocalNodeID))
                let typedIRRuntimeDestroyDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionDestroy(), nodeID: nodeID, storageID: typedIRRuntimeDestroyStorageID))
                if typedIRRuntimeDestroyArgumentNodeID < 0 || typedIRRuntimeDestroyLocalNodeID < 0 || typedIRRuntimeDestroyStorageID < 0 || typedIRRuntimeDestroyDecisionRow < 0 { return 0 - 1 }
                return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationDestroy(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRRuntimeDestroyStorageID, column: 2), storageID: typedIRRuntimeDestroyStorageID, first: typedIRRuntimeDestroyLocalNodeID, second: typedIRRuntimeFunctionNodeID, memoryDecisionRow: typedIRRuntimeDestroyDecisionRow)
            }
            let typedIRCallArgumentNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleArgument(), ordinal: 0))
            if typedIRCallArgumentNodeID < 0 {
                let typedIRReceiveLocalNodeID: Int(compilerSemanticGraphParent(delta: delta, objectNodeID: nodeID, roleTag: compilerSyntaxRoleInitializer()))
                let typedIRReceiveStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRReceiveLocalNodeID))
                let typedIRCallInitializeDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionInitialize(), nodeID: nodeID, storageID: typedIRReceiveStorageID))
                let typedIRCallTransferDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionTransfer(), nodeID: nodeID, storageID: typedIRReceiveStorageID))
                if typedIRReceiveLocalNodeID < 0 || typedIRReceiveStorageID < 0 || typedIRCallInitializeDecisionRow < 0 || typedIRCallTransferDecisionRow < 0 { return 0 - 1 }
                if compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationCallReceive(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRReceiveStorageID, column: 2), storageID: typedIRReceiveStorageID, first: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID), second: typedIRReceiveLocalNodeID, memoryDecisionRow: typedIRCallInitializeDecisionRow) != 0 { return 0 - 1 }
                return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationTransfer(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRReceiveStorageID, column: 2), storageID: typedIRReceiveStorageID, first: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID), second: typedIRReceiveLocalNodeID, memoryDecisionRow: typedIRCallTransferDecisionRow)
            }
            let typedIRCallValueNodeID: Int(compilerSemanticGraphChild(delta: delta, subjectNodeID: typedIRCallArgumentNodeID, roleTag: compilerSyntaxRoleArgumentValue(), ordinal: 0))
            let typedIRCallLocalNodeID: Int(compilerSemanticResolutionTarget(semantics: semantics, useNodeID: typedIRCallValueNodeID))
            let typedIRCallStorageID: Int(compilerMemoryStorageForLocal(memory: memory, localNodeID: typedIRCallLocalNodeID))
            let typedIRBorrowDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionBorrow(), nodeID: typedIRCallArgumentNodeID, storageID: typedIRCallStorageID))
            if typedIRCallStorageID < 0 || typedIRBorrowDecisionRow < 0 { return 0 - 1 }
            return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationCall(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRCallStorageID, column: 2), storageID: typedIRCallStorageID, first: compilerSemanticResolutionTarget(semantics: semantics, useNodeID: nodeID), second: typedIRCallLocalNodeID, memoryDecisionRow: typedIRBorrowDecisionRow)
        }
    }
    if typedIRNodeKind == compilerSyntaxKindReturn() {
        state typedIRReturnStorageRow: Int(0)
        let typedIRReturnStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
        while typedIRReturnStorageRow < typedIRReturnStorageCount {
            if compilerIntTableValue(table: memory.storages, row: typedIRReturnStorageRow, column: 3) == typedIRRegionNodeID
                && compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionDestroy(), nodeID: nodeID, storageID: typedIRReturnStorageRow) >= 0 {
                let typedIRDestroyDecisionRow: Int(compilerTypedIRMemoryDecisionRow(memory: memory, decisionKind: compilerMemoryDecisionDestroy(), nodeID: nodeID, storageID: typedIRReturnStorageRow))
                if compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationDestroy(), typeNodeID: compilerIntTableValue(table: memory.storages, row: typedIRReturnStorageRow, column: 2), storageID: typedIRReturnStorageRow, first: compilerIntTableValue(table: memory.storages, row: typedIRReturnStorageRow, column: 1), second: 0, memoryDecisionRow: typedIRDestroyDecisionRow) != 0 { return 0 - 1 }
            }
            typedIRReturnStorageRow: typedIRReturnStorageRow + 1
        }
        return compilerTypedIRAppendOperation(ir: ir, nodeID: nodeID, regionNodeID: typedIRRegionNodeID, operationKind: compilerTypedIROperationReturn(), typeNodeID: 0 - 1, storageID: 0 - 1, first: compilerSemanticGraphChild(delta: delta, subjectNodeID: nodeID, roleTag: compilerSyntaxRoleReturnValue(), ordinal: 0), second: 0, memoryDecisionRow: 0 - 1)
    }
    return 0
}

function compilerTypedIRBuild(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR): Int {
    if !compilerMemoryGraphIsValid(tables: tables, delta: delta, semantics: semantics, memory: memory) {
        compilerTypedIRPoison(ir: ir)
        return 0 - 1
    }
    if compilerTypedIRBuildFunctions(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir) != 0 { return 0 - 1 }
    state typedIRBuildNodeID: Int(0)
    let typedIRBuildNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while typedIRBuildNodeID < typedIRBuildNodeCount {
        if compilerTypedIRBuildNode(tables: tables, delta: delta, semantics: semantics, memory: memory, ir: ir, nodeID: typedIRBuildNodeID) != 0 {
            compilerTypedIRPoison(ir: ir)
            return 0 - 1
        }
        typedIRBuildNodeID: typedIRBuildNodeID + 1
    }
    return 0
}

function compilerTypedIRDecisionKindForOperation(operationKind: Int): Int {
    if operationKind == compilerTypedIROperationConstruct() { return compilerMemoryDecisionInitialize() }
    if operationKind == compilerTypedIROperationCall() { return compilerMemoryDecisionBorrow() }
    if operationKind == compilerTypedIROperationDestroy() { return compilerMemoryDecisionDestroy() }
    if operationKind == compilerTypedIROperationLocal() { return compilerMemoryDecisionPlacement() }
    if operationKind == compilerTypedIROperationInsertField() { return compilerMemoryDecisionLayout() }
    if operationKind == compilerTypedIROperationNoEscape() { return compilerMemoryDecisionEscape() }
    if operationKind == compilerTypedIROperationConstructValue() { return compilerMemoryDecisionLayout() }
    if operationKind == compilerTypedIROperationTransfer() { return compilerMemoryDecisionTransfer() }
    if operationKind == compilerTypedIROperationCallReceive() { return compilerMemoryDecisionInitialize() }
    if operationKind == compilerTypedIROperationStoragePolicy() { return compilerMemoryDecisionStoragePolicy() }
    if operationKind == compilerTypedIROperationStore() { return compilerMemoryDecisionAccess() }
    return 0 - 1
}

function compilerTypedIRInsertFieldsAreValid(memory: CompilerMemoryGraph, ir: CompilerTypedIR): Bool {
    state typedIRConstructOperationRow: Int(0)
    let typedIRConstructOperationCount: Int(compilerIntTableRowCount(table: ir.operations))
    while typedIRConstructOperationRow < typedIRConstructOperationCount {
        let typedIRConstructOperationKind: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 2))
        if typedIRConstructOperationKind == compilerTypedIROperationConstruct() || typedIRConstructOperationKind == compilerTypedIROperationConstructValue() {
            let typedIRConstructNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 0))
            let typedIRConstructTypeNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 3))
            let typedIRConstructStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 4))
            let typedIRConstructLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIRConstructTypeNodeID))
            if typedIRConstructLayoutRow < 0 { return false }
            let typedIRConstructExpectedFields: Int(compilerIntTableValue(table: memory.layouts, row: typedIRConstructLayoutRow, column: 1))
            state typedIRConstructFieldOrdinal: Int(0)
            while typedIRConstructFieldOrdinal < typedIRConstructExpectedFields {
                state typedIRConstructFieldMatches: Int(0)
                state typedIRConstructCandidateRow: Int(0)
                while typedIRConstructCandidateRow < typedIRConstructOperationCount {
                    if compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 0) == typedIRConstructNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 2) == compilerTypedIROperationInsertField()
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 3) == typedIRConstructTypeNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 4) == typedIRConstructStorageID
                        && compilerIntTableValue(table: ir.operations, row: typedIRConstructCandidateRow, column: 5) == typedIRConstructFieldOrdinal { typedIRConstructFieldMatches: typedIRConstructFieldMatches + 1 }
                    typedIRConstructCandidateRow: typedIRConstructCandidateRow + 1
                }
                if typedIRConstructFieldMatches != 1 { return false }
                typedIRConstructFieldOrdinal: typedIRConstructFieldOrdinal + 1
            }
            if compilerIntTableValue(table: ir.operations, row: typedIRConstructOperationRow, column: 5) != typedIRConstructExpectedFields { return false }
        }
        typedIRConstructOperationRow: typedIRConstructOperationRow + 1
    }
    state typedIRStoreOperationRow: Int(0)
    while typedIRStoreOperationRow < typedIRConstructOperationCount {
        if compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 2) == compilerTypedIROperationStore() {
            let typedIRStoreValueNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 5))
            let typedIRStoreTypeNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 3))
            let typedIRStoreStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRStoreOperationRow, column: 4))
            let typedIRStoreLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIRStoreTypeNodeID))
            if typedIRStoreLayoutRow < 0 { return false }
            let typedIRStoreExpectedFields: Int(compilerIntTableValue(table: memory.layouts, row: typedIRStoreLayoutRow, column: 1))
            state typedIRStoreFieldOrdinal: Int(0)
            while typedIRStoreFieldOrdinal < typedIRStoreExpectedFields {
                state typedIRStoreFieldMatches: Int(0)
                state typedIRStoreCandidateRow: Int(0)
                while typedIRStoreCandidateRow < typedIRConstructOperationCount {
                    if compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 0) == typedIRStoreValueNodeID
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 2) == compilerTypedIROperationInsertField()
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 4) == typedIRStoreStorageID
                        && compilerIntTableValue(table: ir.operations, row: typedIRStoreCandidateRow, column: 5) == typedIRStoreFieldOrdinal { typedIRStoreFieldMatches: typedIRStoreFieldMatches + 1 }
                    typedIRStoreCandidateRow: typedIRStoreCandidateRow + 1
                }
                if typedIRStoreFieldMatches != 1 { return false }
                typedIRStoreFieldOrdinal: typedIRStoreFieldOrdinal + 1
            }
        }
        typedIRStoreOperationRow: typedIRStoreOperationRow + 1
    }
    return true
}

function compilerTypedIRIsValid(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph, memory: CompilerMemoryGraph, ir: CompilerTypedIR): Bool {
    if ir.failures.count != 0
        || !compilerIntTableIsComplete(table: ir.functions)
        || !compilerIntTableIsComplete(table: ir.operations) { return false }
    if compilerIntTableRowCount(table: ir.functions) < 1 { return false }
    state typedIRValidationFunctionRow: Int(0)
    state typedIREntryCount: Int(0)
    while typedIRValidationFunctionRow < compilerIntTableRowCount(table: ir.functions) {
        let typedIRValidationOwnerNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 0))
        let typedIRValidationParameterNodeID: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 3))
        let typedIRValidationDecisionRow: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 5))
        let typedIRValidationIsEntry: Int(compilerIntTableValue(table: ir.functions, row: typedIRValidationFunctionRow, column: 6))
        if typedIRValidationIsEntry == 1 {
            typedIREntryCount: typedIREntryCount + 1
            if compilerIntTableValue(table: delta.nodes, row: typedIRValidationOwnerNodeID, column: 1) != compilerSyntaxKindEntry()
                || typedIRValidationParameterNodeID != 0 - 1 || typedIRValidationDecisionRow != 0 - 1 { return false }
        } else {
            if compilerIntTableValue(table: delta.nodes, row: typedIRValidationOwnerNodeID, column: 1) != compilerSyntaxKindFunction() || typedIRValidationDecisionRow < 0 { return false }
            if typedIRValidationParameterNodeID >= 0 {
                if compilerIntTableValue(table: delta.nodes, row: typedIRValidationParameterNodeID, column: 1) != compilerSyntaxKindParameter()
                    || compilerIntTableValue(table: memory.decisions, row: typedIRValidationDecisionRow, column: 0) != compilerMemoryDecisionPassMode() { return false }
            } else if compilerIntTableValue(table: memory.decisions, row: typedIRValidationDecisionRow, column: 0) != compilerMemoryDecisionReturnMode() { return false }
        }
        typedIRValidationFunctionRow: typedIRValidationFunctionRow + 1
    }
    if typedIREntryCount != 1 { return false }

    state typedIRValidationOperationRow: Int(0)
    state typedIRTerminatorCount: Int(0)
    while typedIRValidationOperationRow < compilerIntTableRowCount(table: ir.operations) {
        let typedIRValidationNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 0))
        let typedIRValidationRegionNodeID: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 1))
        let typedIRValidationOperationKind: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 2))
        let typedIRValidationStorageID: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 4))
        let typedIRValidationOperationDecisionRow: Int(compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 7))
        if typedIRValidationNodeID < 0 || typedIRValidationNodeID >= compilerIntTableRowCount(table: delta.nodes)
            || typedIRValidationRegionNodeID < 0 || typedIRValidationRegionNodeID >= compilerIntTableRowCount(table: delta.nodes) { return false }
        let typedIRRequiredDecisionKind: Int(compilerTypedIRDecisionKindForOperation(operationKind: typedIRValidationOperationKind))
        if typedIRValidationOperationKind == compilerTypedIROperationMemberRead() && typedIRValidationStorageID >= 0 {
            if typedIRValidationOperationDecisionRow < 0
                || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 0) != compilerMemoryDecisionAccess()
                || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 2) != typedIRValidationStorageID { return false }
        } else if typedIRRequiredDecisionKind >= 0 {
            if typedIRValidationOperationDecisionRow < 0
                || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 0) != typedIRRequiredDecisionKind { return false }
            if typedIRRequiredDecisionKind != compilerMemoryDecisionLayout()
                && compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 2) != typedIRValidationStorageID { return false }
            if typedIRValidationOperationKind == compilerTypedIROperationStoragePolicy()
                && compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 5) != compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 4) { return false }
            if typedIRValidationOperationKind == compilerTypedIROperationStore()
                && (compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 1) != typedIRValidationNodeID
                    || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 4) != compilerMemoryAccessWriteUnique()
                    || compilerIntTableValue(table: memory.decisions, row: typedIRValidationOperationDecisionRow, column: 5) != compilerIntTableValue(table: ir.operations, row: typedIRValidationOperationRow, column: 6)) { return false }
        } else if typedIRValidationOperationDecisionRow != 0 - 1 { return false }
        if typedIRValidationOperationKind == compilerTypedIROperationReturn() { typedIRTerminatorCount: typedIRTerminatorCount + 1 }
        typedIRValidationOperationRow: typedIRValidationOperationRow + 1
    }
    return typedIRTerminatorCount == compilerIntTableRowCount(table: ir.functions) && compilerTypedIRInsertFieldsAreValid(memory: memory, ir: ir)
}

function compilerTypedIRRenderSnapshot(ir: CompilerTypedIR): String {
    let typedIRTab: String(compilerCoreTabCharacter())
    let typedIRNewline: String(compilerCoreNewlineCharacter())
    let typedIRFunctions: String(compilerTypedSyntaxRenderRawTable(name: String("typedIRFunction"), table: ir.functions))
    let typedIROperations: String(compilerTypedSyntaxRenderRawTable(name: String("typedIROperation"), table: ir.operations))
    return "typedIR\(typedIRTab)valid=true\(typedIRTab)functionCount=\(compilerIntTableRowCount(table: ir.functions))\(typedIRTab)operationCount=\(compilerIntTableRowCount(table: ir.operations))\(typedIRNewline)\(typedIRFunctions)\(typedIROperations)"
}

function compilerTypedIRSummary(source: String): String {
    let typedIRTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let typedIRCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: typedIRTables))
    let typedIRDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let typedIRSemantics: CompilerSemanticGraph(compilerSemanticGraphCreate())
    let typedIRMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    let typedIRGraph: CompilerTypedIR(compilerTypedIRCreate())
    state typedIRSummaryText: String("")
    if typedIRCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: typedIRTables) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidTypedSyntaxSnapshot"))
    } else if compilerPlotterBuild(tables: typedIRTables, delta: typedIRDelta) != 0 || !compilerGraphDeltaIsValid(tables: typedIRTables, delta: typedIRDelta) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidGraphDelta"))
    } else if compilerSemanticBuild(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics) != 0 || !compilerSemanticGraphIsValid(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidSemanticGraph"))
    } else if compilerMemoryBuild(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory) != 0 || !compilerMemoryGraphIsValid(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidMemoryGraph"))
    } else if compilerTypedIRBuild(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory, ir: typedIRGraph) != 0 {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidTypedIRBuild"))
    } else if !compilerTypedIRIsValid(tables: typedIRTables, delta: typedIRDelta, semantics: typedIRSemantics, memory: typedIRMemory, ir: typedIRGraph) {
        typedIRSummaryText: compilerNativeDiagnostic(kind: String("invalidTypedIR"))
    } else {
        typedIRSummaryText: compilerTypedIRRenderSnapshot(ir: typedIRGraph)
    }
    let typedIRGraphDestroyStatus: Int(compilerTypedIRDestroy(ir: typedIRGraph))
    let typedIRMemoryDestroyStatus: Int(compilerMemoryGraphDestroy(memory: typedIRMemory))
    let typedIRSemanticsDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: typedIRSemantics))
    let typedIRDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: typedIRDelta))
    let typedIRTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: typedIRTables))
    if typedIRGraphDestroyStatus != 0 || typedIRMemoryDestroyStatus != 0 || typedIRSemanticsDestroyStatus != 0 || typedIRDeltaDestroyStatus != 0 || typedIRTablesDestroyStatus != 0 {
        return compilerNativeDiagnostic(kind: String("typedIROwnershipFailure"))
    }
    return typedIRSummaryText
}

function compilerTypedIROperationRow(ir: CompilerTypedIR, regionNodeID: Int, operationKind: Int, occurrence: Int): Int {
    state typedIRLookupRow: Int(0)
    state typedIRLookupOccurrence: Int(0)
    let typedIRLookupCount: Int(compilerIntTableRowCount(table: ir.operations))
    while typedIRLookupRow < typedIRLookupCount {
        if compilerIntTableValue(table: ir.operations, row: typedIRLookupRow, column: 1) == regionNodeID
            && compilerIntTableValue(table: ir.operations, row: typedIRLookupRow, column: 2) == operationKind {
            if typedIRLookupOccurrence == occurrence { return typedIRLookupRow }
            typedIRLookupOccurrence: typedIRLookupOccurrence + 1
        }
        typedIRLookupRow: typedIRLookupRow + 1
    }
    return 0 - 1
}

function compilerTypedIRIdentityText(value: Int): String {
    if value < 0 { return "n\(0 - value)" }
    return "p\(value)"
}

function compilerTypedIRLLVMAppend(buffer: RawBuffer, text: String): Bool {
    return rawBufferAppendText(buffer: buffer, text: text) == 0
}

function compilerTypedIRLLVMFixedAggregateType(memory: CompilerMemoryGraph, layoutRow: Int): String {
    let typedIRTypeBuffer: RawBuffer(rawBufferCreate(capacity: 128, stride: 1))
    if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String("{ ")) {
        rawBufferDestroy(buffer: typedIRTypeBuffer)
        return String("")
    }
    state typedIRTypeFieldOrdinal: Int(0)
    let typedIRTypeFieldCount: Int(compilerIntTableValue(table: memory.layouts, row: layoutRow, column: 1))
    while typedIRTypeFieldOrdinal < typedIRTypeFieldCount {
        if typedIRTypeFieldOrdinal > 0 {
            if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String(", ")) {
                rawBufferDestroy(buffer: typedIRTypeBuffer)
                return String("")
            }
        }
        if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String("i32")) {
            rawBufferDestroy(buffer: typedIRTypeBuffer)
            return String("")
        }
        typedIRTypeFieldOrdinal: typedIRTypeFieldOrdinal + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIRTypeBuffer, text: String(" }")) {
        rawBufferDestroy(buffer: typedIRTypeBuffer)
        return String("")
    }
    return compilerCoreRawBufferMaterializeAndDestroy(buffer: typedIRTypeBuffer)
}

function compilerTypedIRLLVMTypeName(tables: CompilerSyntaxTables, typeNodeID: Int): String {
    let typedIRTypeDeclarationRow: Int(compilerSyntaxDeclarationRowForSyntaxID(tables: tables, syntaxID: typeNodeID))
    if typedIRTypeDeclarationRow < 0 { return String("") }
    let typedIRTypeIdentityFirst: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 11))
    let typedIRTypeIdentitySecond: Int(compilerIntTableValue(table: tables.declarations, row: typedIRTypeDeclarationRow, column: 12))
    return "%Range.Fixed.\(compilerTypedIRIdentityText(value: typedIRTypeIdentityFirst)).\(compilerTypedIRIdentityText(value: typedIRTypeIdentitySecond))"
}

function compilerTypedIRFixedLLVMRenderEntry(tables: CompilerSyntaxTables, memory: CompilerMemoryGraph, ir: CompilerTypedIR, entryNodeID: Int): String {
    let typedIREntryNewline: String(compilerCoreNewlineCharacter())
    let typedIREntryBuffer: RawBuffer(rawBufferCreate(capacity: 8192, stride: 1))
    state typedIREntryLayoutRow: Int(0)
    let typedIREntryLayoutCount: Int(compilerIntTableRowCount(table: memory.layouts))
    while typedIREntryLayoutRow < typedIREntryLayoutCount {
        let typedIREntryTypeNodeID: Int(compilerIntTableValue(table: memory.layouts, row: typedIREntryLayoutRow, column: 0))
        let typedIREntryTypeName: String(compilerTypedIRLLVMTypeName(tables: tables, typeNodeID: typedIREntryTypeNodeID))
        if typedIREntryTypeName == String("")
            || !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "\(typedIREntryTypeName) = type \(compilerTypedIRLLVMFixedAggregateType(memory: memory, layoutRow: typedIREntryLayoutRow))\(typedIREntryNewline)") {
            rawBufferDestroy(buffer: typedIREntryBuffer)
            return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMType"))
        }
        typedIREntryLayoutRow: typedIREntryLayoutRow + 1
    }
    if !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "\(typedIREntryNewline)define i32 @main() {\(typedIREntryNewline)entry:\(typedIREntryNewline)") {
        rawBufferDestroy(buffer: typedIREntryBuffer)
        return compilerNativeDiagnostic(kind: String("typedIRLLVMAppendFailure"))
    }
    state typedIREntryStorageRow: Int(0)
    let typedIREntryStorageCount: Int(compilerIntTableRowCount(table: memory.storages))
    while typedIREntryStorageRow < typedIREntryStorageCount {
        let typedIREntryStorageTypeNodeID: Int(compilerIntTableValue(table: memory.storages, row: typedIREntryStorageRow, column: 2))
        let typedIREntryStorageLayoutRow: Int(compilerMemoryLayoutRowForType(memory: memory, typeNodeID: typedIREntryStorageTypeNodeID))
        let typedIREntryStorageTypeName: String(compilerTypedIRLLVMTypeName(tables: tables, typeNodeID: typedIREntryStorageTypeNodeID))
        if typedIREntryStorageLayoutRow < 0 || typedIREntryStorageTypeName == String("")
            || !compilerTypedIRLLVMAppend(buffer: typedIREntryBuffer, text: "  %storage\(typedIREntryStorageRow) = alloca \(typedIREntryStorageTypeName), align \(compilerIntTableValue(table: memory.layouts, row: typedIREntryStorageLayoutRow, column: 3))\(typedIREntryNewline)") {
            rawBufferDestroy(buffer: typedIREntryBuffer)
            return compilerNativeDiagnostic(kind: String("invalidTypedIRLLVMStorage"))
        }
        typedIREntryStorageRow: typedIREntryStorageRow + 1
    }
    state typedIREntryOperationRow: Int(0)
