    let typedIRAlignment: Int(compilerIntTableValue(table: memory.layouts, row: typedIRLayoutRow, column: 3))
    let typedIRLLVMNewline: String(compilerCoreNewlineCharacter())
    return "\(typedIRTypeName) = type { i32, i32 }\(typedIRLLVMNewline)\(typedIRLLVMNewline)define i32 \(typedIRFunctionName)(\(typedIRTypeName) %argument) {\(typedIRLLVMNewline)entry:\(typedIRLLVMNewline)  %value\(typedIRFirstReadNodeID) = extractvalue \(typedIRTypeName) %argument, \(typedIRFirstFieldOrdinal)\(typedIRLLVMNewline)  %value\(typedIRSecondReadNodeID) = extractvalue \(typedIRTypeName) %argument, \(typedIRSecondFieldOrdinal)\(typedIRLLVMNewline)  %value\(typedIRAddNodeID) = add i32 %value\(typedIRFirstReadNodeID), %value\(typedIRSecondReadNodeID)\(typedIRLLVMNewline)  ret i32 %value\(typedIRAddNodeID)\(typedIRLLVMNewline)}\(typedIRLLVMNewline)\(typedIRLLVMNewline)define i32 @main() {\(typedIRLLVMNewline)entry:\(typedIRLLVMNewline)  %storage0 = alloca \(typedIRTypeName), align \(typedIRAlignment)\(typedIRLLVMNewline)  %aggregate0 = insertvalue \(typedIRTypeName) poison, i32 \(typedIRFirstInsertValue), \(typedIRFirstInsertOrdinal)\(typedIRLLVMNewline)  %aggregate1 = insertvalue \(typedIRTypeName) %aggregate0, i32 \(typedIRSecondInsertValue), \(typedIRSecondInsertOrdinal)\(typedIRLLVMNewline)  store \(typedIRTypeName) %aggregate1, ptr %storage0, align \(typedIRAlignment)\(typedIRLLVMNewline)  %borrow0 = load \(typedIRTypeName), ptr %storage0, align \(typedIRAlignment)\(typedIRLLVMNewline)  %value\(typedIRCallNodeID) = call i32 \(typedIRFunctionName)(\(typedIRTypeName) %borrow0)\(typedIRLLVMNewline)  ret i32 %value\(typedIRCallNodeID)\(typedIRLLVMNewline)}\(typedIRLLVMNewline)"
}

function compilerTypedIRProofCandidate(tables: CompilerSyntaxTables, delta: CompilerGraphDelta, semantics: CompilerSemanticGraph): Bool {
    state typedIRCandidateConstructCount: Int(0)
    state typedIRCandidateNodeID: Int(0)
    let typedIRCandidateNodeCount: Int(compilerIntTableRowCount(table: delta.nodes))
    while typedIRCandidateNodeID < typedIRCandidateNodeCount {
        let typedIRCandidateNodeKind: Int(compilerIntTableValue(table: delta.nodes, row: typedIRCandidateNodeID, column: 1))
        if typedIRCandidateNodeKind == compilerSyntaxKindConstruct() { typedIRCandidateConstructCount: typedIRCandidateConstructCount + 1 }
        typedIRCandidateNodeID: typedIRCandidateNodeID + 1
    }
    return typedIRCandidateConstructCount > 0
}

function compilerTypedIRFixedLLVMTextWithPolicy(source: String, unsupportedIsEmpty: Bool): String {
    let typedIRLLVMTables: CompilerSyntaxTables(compilerSyntaxTablesCreate(source: source))
    let typedIRLLVMCaptureStatus: Int(compilerTypedSyntaxCapture(source: source, tables: typedIRLLVMTables))
    let typedIRLLVMDelta: CompilerGraphDelta(compilerGraphDeltaCreate())
    let typedIRLLVMSemantics: CompilerSemanticGraph(compilerSemanticGraphCreate())
    let typedIRLLVMMemory: CompilerMemoryGraph(compilerMemoryGraphCreate())
    let typedIRLLVMGraph: CompilerTypedIR(compilerTypedIRCreate())
    state typedIRLLVMText: String("")
    if typedIRLLVMCaptureStatus != 0 || !compilerSyntaxTablesIsValid(tables: typedIRLLVMTables) {
        if unsupportedIsEmpty {
            typedIRLLVMText: String("")
        } else {
            typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidTypedSyntaxSnapshot"))
        }
    } else if compilerPlotterBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta) != 0 || !compilerGraphDeltaIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidGraphDelta"))
    } else if compilerSemanticBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) != 0 || !compilerSemanticGraphIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) {
        if unsupportedIsEmpty {
            typedIRLLVMText: String("")
        } else {
            typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidSemanticGraph"))
        }
    } else if unsupportedIsEmpty && !compilerTypedIRProofCandidate(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics) {
        typedIRLLVMText: String("")
    } else if compilerMemoryBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory) != 0 || !compilerMemoryGraphIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidMemoryGraph"))
    } else if compilerTypedIRBuild(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph) != 0 || !compilerTypedIRIsValid(tables: typedIRLLVMTables, delta: typedIRLLVMDelta, semantics: typedIRLLVMSemantics, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph) {
        typedIRLLVMText: compilerNativeDiagnostic(kind: String("invalidTypedIR"))
    } else {
        typedIRLLVMText: compilerTypedIRFixedLLVMRender(tables: typedIRLLVMTables, memory: typedIRLLVMMemory, ir: typedIRLLVMGraph)
    }
    let typedIRLLVMGraphDestroyStatus: Int(compilerTypedIRDestroy(ir: typedIRLLVMGraph))
    let typedIRLLVMMemoryDestroyStatus: Int(compilerMemoryGraphDestroy(memory: typedIRLLVMMemory))
    let typedIRLLVMSemanticsDestroyStatus: Int(compilerSemanticGraphDestroy(semantics: typedIRLLVMSemantics))
    let typedIRLLVMDeltaDestroyStatus: Int(compilerGraphDeltaDestroy(delta: typedIRLLVMDelta))
    let typedIRLLVMTablesDestroyStatus: Int(compilerSyntaxTablesDestroy(tables: typedIRLLVMTables))
    if typedIRLLVMGraphDestroyStatus != 0 || typedIRLLVMMemoryDestroyStatus != 0 || typedIRLLVMSemanticsDestroyStatus != 0 || typedIRLLVMDeltaDestroyStatus != 0 || typedIRLLVMTablesDestroyStatus != 0 {
        return compilerNativeDiagnostic(kind: String("typedIRLLVMOwnershipFailure"))
    }
    return typedIRLLVMText
}

function compilerTypedIRFixedLLVMText(source: String): String {
    return compilerTypedIRFixedLLVMTextWithPolicy(source: source, unsupportedIsEmpty: false)
}

function compilerTypedIRFixedLLVMIfSupported(source: String): String {
    return compilerTypedIRFixedLLVMTextWithPolicy(source: source, unsupportedIsEmpty: true)
}
