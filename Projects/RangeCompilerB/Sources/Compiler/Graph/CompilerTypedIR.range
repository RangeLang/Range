    let typedIRFirstInsertRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationInsertField(), occurrence: 0))
    let typedIRSecondInsertRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationInsertField(), occurrence: 1))
    let typedIRCallRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationCall(), occurrence: 0))
    let typedIRDestroyRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIREntryNodeID, operationKind: compilerTypedIROperationDestroy(), occurrence: 0))
    if typedIRFirstReadRow < 0 || typedIRSecondReadRow < 0 || typedIRAddRow < 0 || typedIRFirstInsertRow < 0 || typedIRSecondInsertRow < 0 || typedIRCallRow < 0 || typedIRDestroyRow < 0 {
