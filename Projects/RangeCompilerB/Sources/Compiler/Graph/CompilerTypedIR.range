    let typedIRFirstReadRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRHelperNodeID, operationKind: compilerTypedIROperationMemberRead(), occurrence: 0))
    let typedIRSecondReadRow: Int(compilerTypedIROperationRow(ir: ir, regionNodeID: typedIRHelperNodeID, operationKind: compilerTypedIROperationMemberRead(), occurrence: 1))
