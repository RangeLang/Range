            questionTokenIDs: bufferCreateInt(capacity: capacity),
            firstTargetTokenIDs: bufferCreateInt(capacity: capacity),
            afterLastTargetTokenIDs: bufferCreateInt(capacity: capacity),
            firstRHSTokenIDs: bufferCreateInt(capacity: capacity),
