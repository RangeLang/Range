macro floating(): Construct {
  let bits: #environment.target.Declaration.members.filter(named: "bits").first

  if !bits.isTarget {
    @diagnostic(
      "Floating construct must specify bits"
    )
  }

  switch bits {
  case 32:
    #environment {
      extension #environment.target.Declaration {
        LLVM(
          type: "%Range.\(#environment.target.identity) = type { float }"
        )
      }

      extension #environment.target.Application {
        LLVM(
          value: "%Range.\(#environment.target.identity) { float \(#environment.target.Application.value) }"
        )
      }
    }

  case 64:
    #environment {
      extension #environment.target.Declaration {
        LLVM(
          type: "%Range.\(#environment.target.identity) = type { double }"
        )
      }

      extension #environment.target.Application {
        LLVM(
          value: "%Range.\(#environment.target.identity) { double \(#environment.target.Application.value) }"
        )
      }
    }

  default:
    @diagnostic(
      "Floating bits must be 32 or 64"
    )
  }
}
