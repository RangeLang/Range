@extern
function listFiles(path: String): String

@extern
function firstRangeFile(path: String): String

@main {
    let argumentCount: Int(commandLineArgumentCount())
    if argumentCount != 1 {
        print(value: "usage: compiler-b <route>")
        return 64
    }

    let route: String(commandLineArgument(index: 0))
    let files: String(listFiles(path: route))
    let sourcePath: String(firstRangeFile(path: route))
    let source: String(readFile(path: sourcePath))
    print(value: "route=\(route)\nsource=\(sourcePath)\n\(files)\n\(compilerBLexSummary(source: source))")
    return 0
}
