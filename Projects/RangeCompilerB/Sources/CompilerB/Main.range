function compilerBProjectModeGraph(): Int { return 1 }
function compilerBProjectModeLLVM(): Int { return 2 }
function compilerBProjectModeAssembly(): Int { return 3 }

function compilerBInspectSourceFile(route: String): Int {
    let source: String(fileManagerReadFile(path: route))
    state output: String("route=\(route)\n")
    state diagnostic: String("")
    state status: Int(0)
    if compilerBLex(source: source, output: output) != 0 { status: 65 }
    if compilerBParse(
        source: source,
        rendered: output,
        diagnostic: diagnostic
    ) != 0 { status: 65 }
    if output != "" { print(value: output) }
    if diagnostic != "" {
        print(value: "compilerBSyntaxError\t\(diagnostic)")
    }
    return status
}

function compilerBEntry(): Int {
    let argumentCount: Int(commandLineArgumentCount())
    if argumentCount != 1 && argumentCount != 2 {
        print(value: "usage: compiler-b [--emit-llvm|--emit-assembly] <route>")
        return 64
    }

    state routeArgumentIndex: Int(0)
    state emitLLVM: Bool(false)
    state emitAssembly: Bool(false)
    if argumentCount == 2 {
        if commandLineArgument(index: 0) == String("--emit-llvm") {
            emitLLVM: true
        } else if commandLineArgument(index: 0) == String("--emit-assembly") {
            emitAssembly: true
        } else {
            return 64
        }
        routeArgumentIndex: 1
    }
    let route: String(commandLineArgument(index: routeArgumentIndex))
    if !fileManagerPathExists(path: route) {
        print(value: "compiler-b: route does not exist: \(route)")
        return 66
    }
    let routeKind: Int(filePrimitivePathKind(path: route))
    if routeKind == 1 && !emitLLVM && !emitAssembly {
        return compilerBInspectSourceFile(route: route)
    }
    if routeKind != 2 {
        print(value: "compiler-b: route must be a project directory")
        return 66
    }
    state mode: Int(compilerBProjectModeGraph())
    if emitLLVM { mode: compilerBProjectModeLLVM() }
    if emitAssembly { mode: compilerBProjectModeAssembly() }
    state output: String("")
    state diagnostic: String("")
    let sourcePaths: String(compilerBDiscoverProjectSourcePaths(route: route))
    let sourceCount: Int(compilerBSourceSetLineCount(lines: sourcePaths))
    state failures: Int(0)
    let revision: CompilerBProjectRevision(
        sourcePaths: sourcePaths,
        sourceCount: sourceCount,
        declarations: compilerBProjectDeclarationStoreCreate(
            capacity: sourceCount * 32
        ),
        macroApplications: compilerBProjectMacroApplicationStoreCreate(
            capacity: sourceCount * 32
        ),
        emittedMacroBlocks: compilerBProjectEmittedMacroBlockStoreCreate(
            capacity: sourceCount * 4
        ),
        syntaxGraph: compilerBSyntaxGraphCreate(capacity: sourceCount * 8),
        syntaxCaptureValues: compilerBSyntaxCaptureValueGraphCreate(
            captureCapacity: sourceCount * 64,
            valueCapacity: sourceCount * 256
        )
    )
    failures: compilerBPopulateProjectRevision(
        sourcePaths: revision.sourcePaths,
        declarations: revision.declarations,
        applications: revision.macroApplications,
        emittedMacroBlocks: revision.emittedMacroBlocks,
        syntaxGraph: revision.syntaxGraph
    )
    if compilerBDeriveSyntaxCaptureValues(
        graph: revision.syntaxGraph,
        applications: revision.macroApplications,
        values: revision.syntaxCaptureValues
    ) != 0 { failures: failures + 1 }
    if compilerBValidateSyntaxCaptureCardinalities(
        graph: revision.syntaxGraph,
        values: revision.syntaxCaptureValues
    ) != 0 { failures: failures + 1 }
    if compilerBValidateSyntaxCaptureIdentities(
        graph: revision.syntaxGraph,
        values: revision.syntaxCaptureValues,
        sourcePaths: revision.sourcePaths,
        declarations: revision.declarations
    ) != 0 { failures: failures + 1 }
    failures: failures + compilerBValidateCountedConstructions(
        sourcePaths: revision.sourcePaths,
        declarations: revision.declarations,
        renderFacts: mode == compilerBProjectModeGraph()
    )
    if failures != 0 {
        compilerBProjectReportSyntaxDiagnostics(
            sourcePaths: revision.sourcePaths
        )
        compilerBProjectReportResolutionDiagnostics(
            sourcePaths: revision.sourcePaths,
            declarations: revision.declarations
        )
    }
    state result: Int(0)
    if mode == compilerBProjectModeGraph() {
        output.append(text: compilerBRenderProjectRevision(
            revision: revision,
            diagnosticCount: failures
        ))
        if failures != 0 {
            diagnostic.append(text: compilerBProjectRevisionDiagnostic(
                diagnosticCount: failures
            ))
            result: 65
        }
    } else if mode == compilerBProjectModeLLVM() {
        if failures != 0 {
            diagnostic.append(text: compilerBProjectRevisionDiagnostic(
                diagnosticCount: failures
            ))
            result: 65
        } else if compilerBEmitProjectLLVM(
            project: revision,
            output: output,
            diagnostic: diagnostic
        ) != 0 { result: 65 }
    } else {
        if failures != 0 {
            diagnostic.append(text: compilerBProjectRevisionDiagnostic(
                diagnosticCount: failures
            ))
            result: 65
        } else if compilerBEmitProjectAssembly(
            project: revision,
            output: output,
            diagnostic: diagnostic
        ) != 0 { result: 65 }
    }
    if output != "" { print(value: output) }
    if diagnostic != "" { print(value: "compilerBProjectError\t\(diagnostic)") }
    if compilerBProjectRevisionDestroy(revision: revision) != 0 { result: 70 }
    return result
}

macro compilerEntry(): Construct -> Void {
    #environment {
        @main {
            compilerBEntry()
        }
    }
}

@compilerEntry
construct CompilerBEntry {}
