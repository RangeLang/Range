@builtin(.storage)
construct CompilerBSeedIntManyTransport {
    state storage: RawBuffer

    derived count: Int {
        rawBufferCount(buffer: self.storage)
    }

    function append(element: Int): Int {
        return rawBufferAppendInt(buffer: self.storage, value: element)
    }

    function element(index: Int): Int {
        return rawBufferLoadInt(buffer: self.storage, index: index)
    }

    function update(element: Int, index: Int): Int {
        return rawBufferStoreInt(buffer: self.storage, index: index, value: element)
    }

    function destroy(): Int {
        return rawBufferDestroy(buffer: self.storage)
    }
}

@builtin(.storage)
construct CompilerBSeedByteManyTransport {
    state storage: RawBuffer

    derived count: Int {
        rawBufferCount(buffer: self.storage)
    }

    function append(element: Byte): Int {
        return rawBufferAppendInt(buffer: self.storage, value: element)
    }

    function element(index: Int): Byte {
        return rawBufferLoadInt(buffer: self.storage, index: index)
    }

    function update(element: Byte, index: Int): Int {
        return rawBufferStoreInt(buffer: self.storage, index: index, value: element)
    }

    function destroy(): Int {
        return rawBufferDestroy(buffer: self.storage)
    }
}

@builtin(.create)
function bufferCreateInt(capacity: Int): CompilerBSeedIntManyTransport

@builtin(.create)
function bufferCreateUnsigned8(capacity: Int): CompilerBSeedByteManyTransport

@builtin(.write)
function bufferTruncateInt(
    buffer: CompilerBSeedIntManyTransport,
    count: Int
): Int

function compilerBFacetRowForSyntaxID(
    syntaxIDs: CompilerBSeedIntManyTransport,
    syntaxID: Int
): Int {
    state index: Int(0)
    while index < syntaxIDs.count {
        if syntaxIDs.element(index: index) == syntaxID { return index }
        index: index + 1
    }
    return 0 - 1
}
